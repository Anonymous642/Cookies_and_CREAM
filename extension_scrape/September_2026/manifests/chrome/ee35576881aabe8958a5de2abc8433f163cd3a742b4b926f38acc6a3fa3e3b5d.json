{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Formatim \u2014 Readable Transcripts for YouTube", "version": "1.0.0", "description": "Turn YouTube captions into a readable document \u2014 every word the speaker said, with the headings and paragraphs speech never had.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["telemetry.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "host_permissions": ["https://www.youtube.com/*", "https://formatim.app/*"], "externally_connectable": {"matches": ["https://formatim.app/*"]}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://www.youtube.com/*"]}], "permissions": ["identity", "storage", "alarms"]}