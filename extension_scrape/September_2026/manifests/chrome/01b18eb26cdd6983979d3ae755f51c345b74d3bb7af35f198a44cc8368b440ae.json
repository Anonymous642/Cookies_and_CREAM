{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NeutralAI: PII Masking for ChatGPT & AI", "version": "0.1.7", "description": "Masks personal data (PII) in prompts and uploads before they leave your browser - on ChatGPT, Claude, Gemini, Copilot and more.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "alarms", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://claude.ai/*", "https://www.claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://www.copilot.microsoft.com/*", "https://chat.deepseek.com/*", "https://app.neutralai.co.uk/*", "https://api.neutralai.co.uk/*"], "background": {"service_worker": "background/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://claude.ai/*", "https://www.claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://www.copilot.microsoft.com/*", "https://chat.deepseek.com/*"], "js": ["content/document_scan_policy.js", "content/interceptor.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "action": {"default_title": "NeutralAI", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["content/perplexity_page_bridge.js"], "matches": ["https://perplexity.ai/*", "https://www.perplexity.ai/*"]}]}