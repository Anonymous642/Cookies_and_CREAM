{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shiori", "description": "A calm new-tab workspace for organizing tabs, bookmarks, notes, tasks, and focused work.", "version": "2.0.0", "icons": {"16": "icon/16wxt.png", "32": "icon/32wxt.png", "48": "icon/48wxt.png", "96": "icon/96wxt.png", "128": "icon/128wxt.png"}, "minimum_chrome_version": "102", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "permissions": ["storage", "unlimitedStorage", "tabs", "tabGroups", "activeTab", "windows", "contextMenus", "scripting", "identity", "webNavigation", "clipboardRead", "sessions", "bookmarks", "favicon", "alarms", "notifications", "declarativeNetRequestWithHostAccess", "sidePanel"], "commands": {"switch-to-shiori": {"description": "Switch to the last open Shiori tab"}, "open-focused-shiori": {"description": "Open Shiori focused (browser)", "suggested_key": {"default": "Ctrl+S", "windows": "Ctrl+S", "mac": "Command+S"}}}, "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["satoshi-web/fonts/*.woff2", "geist/fonts/*.woff2"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "Shiori Popup", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://localhost/shared/*", "https://shiori-website.vercel.app/shared/*"], "js": ["content-scripts/shared-page.js"]}, {"matches": ["<all_urls>"], "js": ["content-scripts/tab-switcher.js"]}]}