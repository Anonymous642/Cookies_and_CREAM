{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FLOWer Recruit \u2014 Import jobs and your profile", "version": "0.3.5", "description": "Import public job descriptions or visible sections of your own LinkedIn profile into FLOWer.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.flowerrecruit.com/*", "https://api.flowerrecruit.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "content_scripts": [{"matches": ["https://www.flowerrecruit.com/*"], "js": ["appBridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "FLOWer Recruit \u2014 Import jobs and your profile", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"import-to-flower": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Import this job description to FLOWer"}}, "background": {"service_worker": "background.js", "type": "module"}}