{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Word Counter", "version": "1.0.0", "description": "Dark-themed word & char counter, with optional Twitter limit & custom shortcuts setup.", "manifest_version": 3, "permissions": ["activeTab", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Toggle extension on/off"}, "count-words": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Count words/characters at cursor. If you want to highlight the text without using the mouse"}, "close-popups": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Forcibly close all pop-up"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "settings.html", "open_in_tab": false}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}