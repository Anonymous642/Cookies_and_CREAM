{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Hover Summary", "version": "1.0", "description": "Get instant video summaries by hovering over YouTube thumbnails", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://hover-sum.fly.dev/*", "https://www.googleapis.com/*", "https://accounts.google.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["modules/*", "tailwind.css"], "matches": ["https://www.youtube.com/*"]}], "action": {"default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}