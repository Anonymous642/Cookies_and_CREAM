{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HDVideoDL Helper", "version": "0.1.2", "description": "Starts browser downloads from HDVideoDL direct links with supported request headers.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "HDVideoDL Helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://hdvideodl.com/*"], "js": ["content-script.js"], "run_at": "document_start"}]}