{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Website Time Tracker", "version": "1.0.0", "description": "A private, offline dashboard for understanding your browsing time.", "permissions": ["tabs", "windows", "storage", "alarms", "idle", "notifications", "unlimitedStorage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Website Time Tracker", "default_popup": "popup.html"}, "options_page": "settings.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Open Website Time Tracker"}}, "web_accessible_resources": [{"resources": ["vendor/chart.umd.js"], "matches": ["<all_urls>"]}]}