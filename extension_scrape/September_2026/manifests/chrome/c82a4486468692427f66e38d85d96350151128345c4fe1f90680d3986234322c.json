{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Playwright Trace Viewer", "version": "1.0.0", "description": "For trace files in emails, jira, confluence, etc. No need to run `npx playwright show-trace`, just click it and view it.", "permissions": ["tabs", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Open trace.zip\u2026"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "playwright_csp", "enabled": true, "path": "rules/playwright-csp.json"}]}, "web_accessible_resources": [{"resources": ["pwtv/*"], "matches": ["<all_urls>"]}]}