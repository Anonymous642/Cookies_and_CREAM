{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoFlow \u2014 Batch for Google Flow", "version": "1.1.0", "description": "Queue Google Flow prompts, build private storyboards, and monitor generation progress inside a focused side panel.", "author": "AutoFlow", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open AutoFlow"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["storage", "alarms", "scripting", "sidePanel", "downloads", "debugger"], "host_permissions": ["https://autoflow-billing.autoflow-billing-worker.workers.dev/*", "https://labs.google/fx/*", "https://labs.google.com/fx/*", "https://flow.google.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"}, "commands": {"open-sidepanel": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open AutoFlow side panel"}, "toggle-run": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or pause the queue"}}}