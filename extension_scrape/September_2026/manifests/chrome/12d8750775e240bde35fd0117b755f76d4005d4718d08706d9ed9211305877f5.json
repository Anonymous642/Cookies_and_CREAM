{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tab Group Switcher", "description": "Command palette for quick switching between Chrome tab groups.", "version": "1.2.0", "author": "Christopher X Gerber", "manifest_version": 3, "permissions": ["tabs", "tabGroups", "sidePanel"], "background": {"service_worker": "background.js"}, "icons": {"16": "tab-group-switcher-icon.png", "48": "tab-group-switcher-icon.png", "128": "tab-group-switcher-icon.png"}, "action": {"default_title": "Tab Group Switcher", "default_icon": "tab-group-switcher-icon.png"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-overlay": {"suggested_key": {"mac": "Command+Shift+K", "default": "Ctrl+Shift+K"}, "description": "Show Tab Group Switcher"}}}