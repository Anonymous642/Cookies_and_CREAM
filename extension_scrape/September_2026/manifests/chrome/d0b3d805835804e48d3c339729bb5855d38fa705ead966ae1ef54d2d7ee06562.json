{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Watermark by SoniX", "version": "2.1.0", "description": "Capture any webpage area and apply a customizable repeating logo watermark and footer text before download or copy.", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "Easy Watermark"}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "contextMenus"], "web_accessible_resources": [{"resources": ["assets/icon48.png", "pdf/pdf.worker.min.mjs"], "matches": ["<all_urls>"]}], "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture Select Area or Visible Area (based on popup shortcut setting)"}}, "options_page": "settings/settings.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}