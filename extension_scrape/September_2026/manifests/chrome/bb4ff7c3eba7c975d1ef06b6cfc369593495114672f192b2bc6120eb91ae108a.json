{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Figleaf", "version": "0.1.0", "description": "Blur your words before sending. Figleaf re-encodes what you type \u2014 different words, similar meaning \u2014 with a verifiable receipt.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://figleaf.pro/*", "https://accounts.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Figleaf", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"encode-text": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Re-encode text in focused field"}, "enclave-post": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Post directly \u2014 the AI chooses the words, not you"}}}