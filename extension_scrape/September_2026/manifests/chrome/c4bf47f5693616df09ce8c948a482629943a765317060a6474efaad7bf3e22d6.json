{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pixora \u2013 Screenshot Tool & AI Assistant", "version": "3.0.0", "description": "Capture screenshots, automatically save them, and ask AI questions about anything on your screen.", "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads", "notifications"], "host_permissions": ["<all_urls>", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*", "https://api.openai.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"start-capture": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Start screenshot capture mode"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["pixora-logo.png"], "matches": ["<all_urls>"]}]}