{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Timemachine", "version": "0.1.0", "description": "Record display and visit history for X posts in local browser storage.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png"}, "default_title": "X Timemachine"}, "options_page": "src/history/history.html", "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}