{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Better Youtube Pop-out", "version": "0.4.0", "description": "Keep one YouTube player on another display and automatically sync newly opened videos to it.", "permissions": ["storage", "system.display", "webNavigation"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Better Youtube Pop-out", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}, "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "css": ["content.css"], "js": ["url-utils.js", "autoplay-utils.js", "content.js"], "run_at": "document_start"}]}