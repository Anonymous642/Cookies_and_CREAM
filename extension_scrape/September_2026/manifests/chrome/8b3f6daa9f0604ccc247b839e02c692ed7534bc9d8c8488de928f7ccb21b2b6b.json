{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AudioMatch: YouTube Audio Language Detector and Dub Filter", "short_name": "AudioMatch", "version": "1.3.2", "description": "See the real spoken language of every YouTube video before you click. Flags AI dubs and translated titles. By Sorami.", "author": "Sorami Consulting Pty Ltd", "homepage_url": "https://sorami.com.au/products/audiomatch/", "minimum_chrome_version": "110", "permissions": ["storage", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "AudioMatch by Sorami", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["lib/core.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}