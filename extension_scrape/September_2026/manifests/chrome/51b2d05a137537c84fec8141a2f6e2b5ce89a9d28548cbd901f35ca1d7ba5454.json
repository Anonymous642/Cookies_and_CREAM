{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inkbox", "description": "Send any web article to your e-reader in one click. Download any web page to PDF or EPUB.", "version": "1.0.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "cookies", "scripting"], "host_permissions": ["http://localhost:3000/*", "https://useinkbox.app/*", "https://*.useinkbox.app/*", "https://*.clerk.accounts.dev/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*", "https://*/*", "http://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_title": "Inkbox", "default_icon": {"16": "icon-16.png", "48": "icon-48.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "extension@useinkbox.app", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}