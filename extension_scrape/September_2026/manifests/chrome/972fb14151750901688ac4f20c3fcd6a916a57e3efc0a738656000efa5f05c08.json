{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AJI LinkedIn Bridge", "version": "1.0.0", "description": "Connects AJI bot to LinkedIn for automated actions", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://*.railway.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}