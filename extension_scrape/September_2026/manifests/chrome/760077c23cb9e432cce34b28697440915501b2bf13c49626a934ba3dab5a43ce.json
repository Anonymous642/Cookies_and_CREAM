{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vivya PDF", "version": "1.0.8", "description": "Open PDF links directly in Vivya PDF desktop app instead of the browser viewer.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "webNavigation", "downloads", "storage", "nativeMessaging"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http: file:;"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["viewer.html", "viewer.js", "viewer.css", "lib/*"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "Open in Vivya PDF", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}