{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dippd - Price Drop Alerts", "version": "1.0.0", "description": "Track product prices on Amazon and get instant alerts when they drop. Never overpay again.", "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"], "host_permissions": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.uk/*", "https://www.walmart.com/*", "https://www.ebay.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.uk/*", "https://www.walmart.com/*", "https://www.ebay.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Dippd - Track This Price"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}