{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Helpfish - A Chess helper", "version": "1.1", "description": "An extension to provide chess help on popular chess websites.", "permissions": ["sidePanel", "storage", "activeTab", "tabs"], "host_permissions": ["*://*.chess.com/*", "*://lichess.org/*"], "icons": {"128": "helpfish.png"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Open helpfish", "default_icon": {"128": "helpfish.png"}}, "content_scripts": [{"matches": ["*://*.chess.com/*", "*://lichess.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["martin.png", "helpfish.png"], "matches": ["*://*.chess.com/*", "*://lichess.org/*"]}]}