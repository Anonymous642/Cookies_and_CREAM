{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SAOB Abbreviation Explainer", "version": "1.0.0", "description": "What's an fsax? SAOB uses over 600 abbreviations, and with this plugin you can hover them to show a tooltip with the expanded word.", "permissions": ["storage"], "action": {"default_title": "SAOB Abbreviation Explainer", "default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}}, "icons": {"128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.saob.se/artikel/*", "https://svenska.se/saob/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dictionary.json"], "matches": ["<all_urls>"]}]}