{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptDNA: Image To Prompt", "version": "1.0.11", "description": "Right-click images to generate structured AI image prompts.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/loader.js"], "run_at": "document_idle"}], "permissions": ["contextMenus", "storage", "activeTab", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "PromptDNA"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["content/*", "assets/*", "icons/*"], "matches": ["http://*/*", "https://*/*"]}]}