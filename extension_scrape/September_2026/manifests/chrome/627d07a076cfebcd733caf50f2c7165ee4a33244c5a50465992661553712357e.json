{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TresPrompt: AI Prompt Optimizer for ChatGPT, Claude & Gemini", "version": "1.0.9", "description": "Search, organize, and optimize your AI conversations across ChatGPT, Claude, and Gemini. Folders, full-text search, prompt tools.", "manifest_version": 3, "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://tresprompt.com/*", "https://www.tresprompt.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["jspdf.umd.min.js", "tier.js", "content.js", "folders.js", "templates-data.js", "templates.js"], "run_at": "document_idle"}, {"matches": ["https://chat.openai.com/*"], "js": ["jspdf.umd.min.js", "tier.js", "content.js", "folders.js", "templates-data.js", "templates.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["jspdf.umd.min.js", "tier.js", "content.js", "folders.js", "templates-data.js", "templates.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["jspdf.umd.min.js", "tier.js", "content.js", "folders.js", "templates-data.js", "templates.js"], "run_at": "document_idle"}, {"matches": ["https://www.tresprompt.com/*", "https://tresprompt.com/*"], "js": ["auth-bridge.js"], "run_at": "document_idle"}], "action": {"default_title": "TresPrompt", "default_popup": "popup.html"}, "commands": {"trigger-optimize": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Optimize the current prompt"}, "trigger-export": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Export the current chat as Markdown"}}}