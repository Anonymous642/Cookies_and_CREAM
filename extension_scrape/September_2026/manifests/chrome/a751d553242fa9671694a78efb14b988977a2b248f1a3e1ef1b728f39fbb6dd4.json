{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SearchRecall Chrome Helper", "version": "1.3.3", "description": "Scans supported Chrome search history locally and sends results only to official SearchRecall pages.", "minimum_chrome_version": "102", "permissions": ["history", "scripting", "tabs"], "host_permissions": ["https://search-recall.com/*", "https://www.search-recall.com/*", "https://search-recall.pages.dev/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://search-recall.com/*", "https://www.search-recall.com/*", "https://search-recall.pages.dev/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_title": "SearchRecall is ready", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}