{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault: Tab Groups & Sessions", "version": "1.0.0", "description": "Save tabs into named, searchable groups. Reopen, organize, favorite. Free: 1 group, unlimited tabs. Unlimited groups: $9.99.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "contextMenus"], "action": {"default_popup": "src/popup/popup.html", "default_title": "TabVault: save & manage tab groups", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/manager/manager.html", "open_in_tab": true}, "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in the current window to a new TabVault group"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the TabVault popup"}}, "background": {"service_worker": "src/background.js"}, "optional_permissions": ["tabGroups"]}