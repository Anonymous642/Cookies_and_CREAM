{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReScript", "version": "1.0.1", "description": "Turn any YouTube video into LinkedIn, X, and blog content in one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ReScript", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://extensionpay.com/*", "https://www.google-analytics.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content_script.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}