{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SocialPull \u2014 Export Followers to CSV/Excel", "version": "1.0.6", "description": "Export Instagram, TikTok, LinkedIn & X followers to CSV, Excel or JSON. For agencies \u2014 100% local & private.", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "downloads", "notifications", "cookies", "declarativeNetRequest"], "host_permissions": ["https://*.instagram.com/*", "https://*.fbcdn.net/*", "https://*.cdninstagram.com/*", "https://www.linkedin.com/*", "https://*.tiktok.com/*", "https://*.tiktokcdn.com/*", "https://*.tiktokcdn-us.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.twimg.com/*"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["src/content/instagram.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["src/content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://*.tiktok.com/*"], "js": ["src/content/tiktok.js"], "run_at": "document_idle"}, {"matches": ["https://*.tiktok.com/*"], "js": ["src/content/tiktok-main.js"], "run_at": "document_start", "world": "MAIN"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}