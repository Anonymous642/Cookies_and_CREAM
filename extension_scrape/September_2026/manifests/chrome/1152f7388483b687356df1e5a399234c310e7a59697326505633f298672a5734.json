{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdRazor: Amazon Keywords Insights Tool", "version": "1.1", "description": "Get instant keyword insights from Amazon search results pages and your competitors' product pages", "homepage_url": "https://adrazor.net/amazon-tools/amazon-keyword-insights-chrome-extension/", "permissions": ["activeTab", "storage"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'self';"}, "action": {"default_title": "AdRazor: Amazon Keywords Insights Tool", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.za/*", "https://www.amazon.co.uk/*", "https://www.amazon.com.au/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/adrazor_logo.png", "images/askppc_logo.webp"], "matches": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.za/*", "https://www.amazon.co.uk/*", "https://www.amazon.com.au/*"]}], "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}