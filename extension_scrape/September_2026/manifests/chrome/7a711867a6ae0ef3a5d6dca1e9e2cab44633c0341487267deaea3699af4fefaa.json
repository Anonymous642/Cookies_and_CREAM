{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focalized AI: Prompt & Context Manager", "version": "1.0.2", "description": "Manage prompts and persist AI context. Deploy custom expert personas across ChatGPT, Claude, Gemini, Grok & more in one click.", "icons": {"128": "icon.png"}, "permissions": ["sidePanel", "storage", "scripting", "tabs", "contextMenus", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Launch Focalized AI", "default_icon": {"128": "icon.png"}}, "content_scripts": [{"matches": ["*://*.google.com/*", "*://*.chatgpt.com/*", "*://*.claude.ai/*", "*://*.grok.com/*", "*://*.deepseek.com/*", "*://*.copilot.microsoft.com/*", "*://*.mistral.ai/*", "*://*.perplexity.ai/*", "*://*.huggingface.co/*", "*://*.phind.com/*", "*://*.poe.com/*"], "js": ["content.js"]}, {"matches": ["https://focalizedai.com/import.html*"], "js": ["web-import-bridge.js"], "run_at": "document_end"}]}