{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scout \u2014 Shopping Memory", "version": "1.0.3", "description": "Save products you love. Scout watches stock and notifies you the moment something restocks.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://*.aloyoga.com/*", "https://*.gymshark.com/*", "https://*.aritzia.com/*", "https://*.shopcsb.com/*", "https://*.rarebeauty.com/*", "https://api.scouttt.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.aloyoga.com/products/*", "https://*.aloyoga.com/*/products/*", "https://*.gymshark.com/products/*", "https://*.gymshark.com/*/products/*", "https://*.aritzia.com/*/product/*", "https://*.aritzia.com/product/*", "https://*.shopcsb.com/products/*", "https://*.shopcsb.com/*/products/*", "https://*.rarebeauty.com/products/*", "https://*.rarebeauty.com/*/products/*"], "js": ["content.js"], "css": ["content.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-inactive16.png", "32": "icons/icon-inactive32.png", "48": "icons/icon-inactive48.png", "128": "icons/icon-inactive128.png"}}, "icons": {"16": "icons/icon-active16.png", "32": "icons/icon-active32.png", "48": "icons/icon-active48.png", "128": "icons/icon-active128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}