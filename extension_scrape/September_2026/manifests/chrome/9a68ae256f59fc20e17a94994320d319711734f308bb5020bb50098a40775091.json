{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Perkmon", "version": "0.5.8", "description": "Sync the card & loyalty offers you already see on supported issuer sites into Perkmon \u2014 only when you start a sync. No passwords.", "permissions": ["storage", "activeTab", "tabs", "identity", "scripting", "sidePanel", "alarms"], "host_permissions": ["<all_urls>", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://accounts.google.com/*", "https://*.cloudfunctions.net/*", "https://card.americanexpress.com/*", "https://global.americanexpress.com/*", "https://www.americanexpress.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Perkmon", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://perkmon.app/*", "https://www.perkmon.app/*", "https://perkmon-staging.web.app/*"]}}