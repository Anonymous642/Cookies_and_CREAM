{"update_url": "https://clients2.google.com/service/update2/crx", "name": "UsableNet AQA for Agents", "version": "0.5.2", "manifest_version": 3, "description": "Bring AQA's accessibility engine to where code is written and reviewed: live in Chrome, and as a tool AI agents can call.", "author": "UsableNet", "devtools_page": "devtools/devtools.html", "background": {"service_worker": "background/background.bundle.js"}, "action": {"default_icon": {"16": "icons/icon-regular.png", "32": "icons/icon-regular.png", "48": "icons/icon-regular.png", "128": "icons/icon-regular.png"}}, "icons": {"16": "icons/icon-regular.png", "32": "icons/icon-regular.png", "48": "icons/icon-regular.png", "128": "icons/icon-regular.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentscripts/overrides-init.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "MAIN"}], "permissions": ["storage", "webNavigation", "scripting", "sidePanel", "unlimitedStorage", "debugger", "offscreen"], "optional_permissions": ["downloads"], "commands": {"start-session": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "AQA \u2014 start a QA session on the active tab"}, "end-session": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "AQA \u2014 end the QA session on the active tab"}, "run-evaluate": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "AQA \u2014 run an evaluation on the active tab (requires an active session)"}}}