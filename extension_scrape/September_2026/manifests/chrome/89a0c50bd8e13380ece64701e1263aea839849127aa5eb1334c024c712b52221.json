{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roblox Badge Restorer", "version": "1.0.0", "description": "Restores missing legacy badges to Roblox profiles, new badges like 'UGC Creator', and brings back the classic badge culture.", "permissions": ["storage"], "host_permissions": ["https://*.roblox.com/*", "https://accountinformation.roblox.com/*", "https://presence.roblox.com/*", "https://www.rolimons.com/*"], "action": {"default_title": "Roblox Badge Restorer", "default_icon": "badges/admin.png"}, "icons": {"16": "badges/admin.png", "32": "badges/admin.png", "48": "badges/admin.png", "128": "badges/admin.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.roblox.com/users/*", "https://*.roblox.com/info/roblox-badges*", "https://*.roblox.com/my/account*"], "js": ["badge_data.js", "api_logic.js", "content.js", "settings.js"], "css": ["style.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/*", "badges/*"], "matches": ["<all_urls>"]}]}