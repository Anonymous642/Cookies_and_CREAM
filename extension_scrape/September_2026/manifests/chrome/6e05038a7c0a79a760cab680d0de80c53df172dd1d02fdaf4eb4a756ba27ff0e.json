{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AmniShield - Website Content Blocker", "description": "Blocks harmful and distracting websites using custom domain lists, keyword filters, and scheduled blocking rules.", "version": "2026.8.22", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest", "webNavigation"], "host_permissions": ["<all_urls>"], "options_ui": {"open_in_tab": false, "page": "options.html"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "AmniShield", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}