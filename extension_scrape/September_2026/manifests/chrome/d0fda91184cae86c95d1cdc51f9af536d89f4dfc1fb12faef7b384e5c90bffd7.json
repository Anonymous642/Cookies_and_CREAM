{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Open All Links in Tabs", "version": "2.2.0", "description": "Extract links from text input and open each link in a separate tab. Perfect for quickly opening multiple URLs from copied text.", "permissions": ["tabs", "storage", "offscreen", "clipboardRead", "clipboardWrite", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "service-worker.js"}, "commands": {"extract-clipboard": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Extract links from clipboard and open tabs"}, "copy-tabs": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Copy all current tab URLs to clipboard"}, "open-selection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open links from selected text"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}