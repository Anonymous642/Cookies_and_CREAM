{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comment Picker \u2013 Facebook, Instagram, YouTube & TikTok", "version": "9.10.28", "description": "Export Facebook, Instagram, YouTube and TikTok comments to CSV/Excel/PDF, and pick a random giveaway winner from them.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "downloads", "storage", "tabs", "scripting", "notifications"], "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*", "https://www.tiktok.com/*", "https://tiktok.com/*", "https://vm.tiktok.com/*", "https://vt.tiktok.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Social Comment Exporter", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["instagram.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["youtube.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["tiktok.js"], "run_at": "document_idle"}]}