{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Organizer", "version": "1.0", "description": "Groups tabs by domain automatically.", "permissions": ["tabs", "tabGroups", "sidePanel", "commands", "storage"], "background": {"service_worker": "background.js"}, "commands": {"group-tabs": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Group tabs by domain"}, "ungroup-tabs": {"suggested_key": {"default": "Alt+E", "mac": "Alt+E"}, "description": "Ungroup all tabs"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}