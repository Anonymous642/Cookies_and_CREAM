{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProductSafer", "version": "1.1.0", "description": "See product safety ratings while you shop on Amazon, Tesco, Sainsbury's and more.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.amazon.co.uk/*", "https://www.amazon.com/*", "https://www.tesco.com/*", "https://www.sainsburys.co.uk/*", "https://www.asda.com/*", "https://www.ocado.com/*", "https://www.boots.com/*", "https://www.superdrug.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.amazon.co.uk/dp/*", "https://www.amazon.co.uk/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.tesco.com/groceries/*", "https://www.tesco.com/shop/*", "https://www.sainsburys.co.uk/shop/gb/groceries/*", "https://www.sainsburys.co.uk/gol-ui/product/*", "https://www.sainsburys.co.uk/shop/*", "https://www.asda.com/product/*", "https://www.ocado.com/products/*", "https://www.boots.com/*", "https://www.superdrug.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "browser_specific_settings": {"gecko": {"id": "extension@productsafer.com", "strict_min_version": "127.0"}}}