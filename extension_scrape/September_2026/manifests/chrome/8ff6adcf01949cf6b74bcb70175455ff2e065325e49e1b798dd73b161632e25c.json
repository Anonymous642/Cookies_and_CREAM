{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Auto Clicker: works in the background", "version": "1.0.6", "description": "Pick an element on a web page and click it automatically.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "action": {"default_title": "Simple Auto Clicker: works in the background", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "service-worker.js"}, "commands": {"toggle-clicking": {"suggested_key": {"default": "Alt+Shift+6"}, "description": "Start or stop clicking"}, "pick-target": {"suggested_key": {"default": "Alt+Shift+7"}, "description": "Pick an element on the current page"}}}