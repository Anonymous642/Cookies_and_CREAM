{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapAI - Smart Screenshot & AI Productivity Tool", "version": "0.1.0", "description": "A privacy-first screenshot extension with local editing, history, OCR, and optional AI productivity tools.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads", "desktopCapture", "offscreen", "clipboardWrite", "unlimitedStorage"], "background": {"service_worker": "extension/background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "SnapAI", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Capture the visible tab"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Capture a selected area"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Capture the full page"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+4"}, "description": "Capture a selected element"}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* data: blob:; img-src 'self' data: blob:;"}}