{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Title for Google Docs", "version": "1.0.0", "description": "Generates a short title for your Google Doc based on its content, not its first line", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.openai.com/*", "https://docs.google.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Smart Title for Google Docs \u2014 click to set API key", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}