{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Time Halo", "description": "Always-visible ambient time indicator for ADHD time blindness", "version": "1.0.0", "homepage_url": "https://enaid.app", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Time Halo"}, "options_page": "src/options/index.html", "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "offscreen", "notifications"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Time Halo popup"}, "toggle-timer": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start/pause/resume the timer"}}}