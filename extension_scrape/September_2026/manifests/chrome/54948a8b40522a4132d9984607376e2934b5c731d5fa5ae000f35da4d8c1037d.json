{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X JST Time Switcher", "version": "1.1.2", "description": "Convert X/Twitter timestamps to JST, UTC, local, market, and streamer-friendly formats.", "permissions": ["storage", "contextMenus", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "X JST Time Switcher", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}