{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AWS Aliaser", "version": "1.1.0", "description": "Shows a friendly account label (alias/name) in the AWS Console header.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://*.console.aws.amazon.com/*", "https://*.signin.aws.amazon.com/*", "*://*.awsapps.com/start/*"], "content_scripts": [{"matches": ["https://*.console.aws.amazon.com/*", "https://*.signin.aws.amazon.com/sessions/*", "*://*.awsapps.com/start*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}