{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenDrop - Record Screen & Drop Into Claude, ChatGPT, Grok, Gemini", "version": "1.1.1", "description": "Record your screen and drop the video straight into Claude, ChatGPT, Grok, or Gemini.", "permissions": ["offscreen", "storage", "downloads"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://grok.com/*", "https://gemini.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"toggle-screendrop-recording": {"suggested_key": {"default": "Ctrl+Shift+7"}, "description": "Start / stop recording", "global": true}, "pause-screendrop-recording": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Pause / resume recording", "global": true}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://grok.com/*", "https://gemini.google.com/*"]}]}