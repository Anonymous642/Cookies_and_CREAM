{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptVault \u2014 AI Prompt Library", "version": "1.0.0", "description": "Save, organize, and instantly use your AI prompts across ChatGPT, Claude, Gemini, and more.", "permissions": ["storage", "activeTab", "sidePanel", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://poe.com/*", "https://grok.com/*", "https://*.lemonsqueezy.com/*"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://poe.com/*", "https://grok.com/*"], "js": ["content.js"], "css": ["assets/content.css"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open PromptVault"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}