{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TestLens Recorder", "version": "1.1.0", "description": "Record clicks, inputs, navigation and UI outcomes, then send them to TestLens to generate test cases and automation.", "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://www.testlensapp.com/*", "https://testlensapp.com/*", "http://localhost:3000/*"]}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "webNavigation", "tabs"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "TestLens Recorder", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "host_permissions": ["http://*/*", "https://*/*", "https://www.testlensapp.com/*", "https://testlensapp.com/*", "http://localhost:3000/*"], "homepage_url": "https://www.testlensapp.com"}