{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode to Notion", "version": "1.0.0", "description": "Save LeetCode problems to your Notion tracker with one click", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://leetcode.com/*", "https://api.notion.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content/content.js"], "css": ["content/content.css"]}]}