{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Segue - transitions in context", "version": "1.20.1", "description": "Watches the text box you are writing in and offers transition words that fit the logic of your last sentence.", "minimum_chrome_version": "114", "permissions": ["sidePanel", "storage", "tabs", "scripting", "clipboardWrite"], "host_permissions": ["https://api.deepseek.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open Segue", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"suggest-here": {"suggested_key": {"default": "Alt+T"}, "description": "Suggest a transition at the cursor"}}}