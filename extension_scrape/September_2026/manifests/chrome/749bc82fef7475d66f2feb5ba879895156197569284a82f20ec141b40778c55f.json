{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusForge \u2014 Site Blocker, Focus Mode & Pomodoro", "short_name": "FocusForge", "version": "1.0.1", "description": "Block distracting sites, run pomodoro sessions, and track your focus streaks. Beautiful, on-device, free, no signup.", "author": "FocusForge", "minimum_chrome_version": "116", "permissions": ["declarativeNetRequest", "alarms", "storage", "notifications", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "FocusForge \u2014 Focus, Block, Pomodoro", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle focus mode on or off"}, "start-pomodoro": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Start a pomodoro session"}}, "web_accessible_resources": [{"resources": ["blocked.html", "fonts/*", "icons/*"], "matches": ["<all_urls>"]}]}