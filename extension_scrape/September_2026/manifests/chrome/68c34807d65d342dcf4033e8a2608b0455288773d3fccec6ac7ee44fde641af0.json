{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shortie", "version": "1.0.0", "description": "Type \"go\" + a shortcut name in address bar to jump INSTANTLY to a website.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "activeTab"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "omnibox": {"keyword": "go"}, "action": {"default_popup": "src/ui/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "src/ui/options/index.html"}