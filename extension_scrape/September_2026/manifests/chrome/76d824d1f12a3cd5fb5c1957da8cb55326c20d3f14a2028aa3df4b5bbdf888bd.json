{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Job Tracker Anywhere", "version": "1.1", "manifest_version": 3, "description": "Tracks new job postings on any website and notifies the user.", "permissions": ["storage", "notifications"], "host_permissions": ["*://*/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "Open Job Tracker"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}