{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lab.zip Extension", "description": "This extension makes it easy to collect assets from any website and save them directly to your Lab.zip library", "version": "1.0.11", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["contextMenus", "tabs", "storage", "cookies"], "host_permissions": ["https://*/*", "http://*/*"], "commands": {"image_overlay": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open Lab.zip image overlay"}}, "action": {"default_popup": "popup.html", "default_title": "Lab.zip Popup"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["http://*/*", "https://*/*"]}]}