{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinsuite - Pinterest Saver", "version": "2.1.7", "description": "Download and save Pinterest boards, sections, pins and private boards into your own PinSuite library. Instagram too.", "permissions": ["cookies", "storage", "activeTab", "tabs", "downloads", "sidePanel", "contextMenus", "scripting"], "host_permissions": ["*://*.pinterest.com/*", "*://*.pinimg.com/*", "*://*.instagram.com/*", "*://*.cdninstagram.com/*", "*://*.fbcdn.net/*", "https://pinsuite.app/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidebar/sidebar.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "js": ["content/pinterest-detector.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["content/instagram-detector.js"], "run_at": "document_idle"}, {"matches": ["*://pinsuite.app/*"], "js": ["content/pinsuite-bridge.js"], "run_at": "document_idle"}]}