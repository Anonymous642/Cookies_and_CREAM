{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Cell Issue Article Exporter", "version": "2.1", "manifest_version": 3, "description": "Export article titles from Cell issue pages.", "permissions": ["scripting", "downloads", "activeTab"], "host_permissions": ["https://www.cell.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "Cell_icon.png", "32": "Cell_icon.png", "48": "Cell_icon.png", "128": "Cell_icon.png"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.cell.com/*/fulltext/*", "https://www.cell.com/*/abstract/*"], "js": ["content_script.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["xlsx.full.min.js"], "matches": ["<all_urls>"]}]}