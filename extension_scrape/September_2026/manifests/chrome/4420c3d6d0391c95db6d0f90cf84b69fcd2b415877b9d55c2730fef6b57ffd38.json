{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lock Me In", "version": "1.1.6", "description": "A chrome extension that stops you from doomscrolling on YouTube Shorts (TikTok, Instagram, and TBD)", "action": {"default_popup": "index.html"}, "permissions": ["declarativeNetRequest", "storage", "webNavigation", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.google.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*", "*://*.x.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["/fonts/EncodeSansExpanded-Regular.ttf"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}