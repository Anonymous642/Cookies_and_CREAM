{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TaskPort: ChatGPT to Word, Excel & PDF", "version": "1.1.0", "description": "Save any ChatGPT chat as a document or spreadsheet in one click. Tables stay real tables. Runs 100% locally in your browser.", "minimum_chrome_version": "111", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_title": "TaskPort \u2014 export this chat", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/common/zip.js", "src/common/model.js", "src/common/xlsx.js", "src/common/docx.js", "src/common/markdown.js", "src/common/csvutil.js", "src/common/html.js", "src/common/license.js", "src/common/rate.js", "src/content/adapters.js", "src/content/parser.js", "src/content/collector.js", "src/content/recon.js", "src/content/exporter.js", "src/content/ui.js", "src/content/main.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Open the TaskPort popup"}}, "web_accessible_resources": [{"resources": ["src/print/print.html"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}