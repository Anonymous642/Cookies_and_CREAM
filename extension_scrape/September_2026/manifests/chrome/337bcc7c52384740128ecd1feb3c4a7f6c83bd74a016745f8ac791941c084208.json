{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Repro Screenshots \u2014 Screen Recorder", "version": "1.6.0", "description": "Screenshot & screen recorder: full page, area, element. Record a tab, region or webcam. Annotate, redact, trim, GIF.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "desktopCapture", "contextMenus", "offscreen", "storage", "unlimitedStorage", "activeTab", "tabs", "downloads", "identity", "scripting"], "host_permissions": ["<all_urls>"], "oauth2": {"client_id": "194599356490-gi6f84pgkjvetbsl33ju8ikcendlpq1c.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_title": "Repro Screenshots", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Screenshot the visible part of the tab"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Screenshot a selected area"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Screenshot the full page"}, "toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Start / stop tab recording"}}, "web_accessible_resources": [{"resources": ["bubble.html", "bubble.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/drawkit.js", "lib/areashot.js", "content.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}]}