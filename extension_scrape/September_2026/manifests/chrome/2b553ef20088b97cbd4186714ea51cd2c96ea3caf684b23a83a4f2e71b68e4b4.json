{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Beamark - AI Bookmark Manager & Web Clipper", "version": "0.2.0", "description": "Smart AI bookmark manager with visual snapshots, auto-tagging, 1-click Chrome import & semantic search. Local-first & private.", "icons": {"16": "icon-16.png", "32": "icon-light-32x32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_title": "Save to Beamark"}, "options_page": "options/index.html", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content-extractor.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "bookmarks", "storage", "unlimitedStorage", "tabs", "contextMenus", "scripting", "notifications", "favicon"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http:"}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Beamark"}}}