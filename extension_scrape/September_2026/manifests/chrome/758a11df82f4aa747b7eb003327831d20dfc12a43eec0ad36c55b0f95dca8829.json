{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Post to Telegram", "version": "1.2", "description": "Post selected text to your Telegram channel or chat via context menu or keyboard shortcut.", "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Telegram Settings", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "commands": {"quick_send": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Quick send selected text to default Telegram channel"}, "open_compose": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open compose window with selected text"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}