{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "API Request Logger", "version": "1.0.0", "description": "Developer tool that logs all API calls made by websites. Shows method, headers, payload, and response in a clean dev-friendly UI.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "api-logger-background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["api-logger-content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "action": {"default_popup": "api-logger-popup.html", "default_icon": {"16": "icons/api-logger-icon16.png", "48": "icons/api-logger-icon48.png", "128": "icons/api-logger-icon128.png"}}, "icons": {"16": "icons/api-logger-icon16.png", "48": "icons/api-logger-icon48.png", "128": "icons/api-logger-icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"}, "web_accessible_resources": [{"resources": ["api-logger-inject.js"], "matches": ["<all_urls>"]}]}