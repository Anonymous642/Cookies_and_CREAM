{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HighlightPro - Web & PDF Highlighter", "version": "1.3.6", "description": "Highlight text on web & PDFs, organize folders, restore highlights, APA/MLA/Chicago citations. For students.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["<all_urls>"], "optional_host_permissions": ["file:///*"], "commands": {"quick-highlight": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Quick highlight selection (yellow)"}, "toggle-highlighter": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Toggle HighlightPro highlighter"}, "open-popup": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Open HighlightPro popup"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "HighlightPro"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["http://*/*", "https://*/*"]}]}