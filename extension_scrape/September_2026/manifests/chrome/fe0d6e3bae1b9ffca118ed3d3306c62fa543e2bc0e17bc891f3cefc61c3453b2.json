{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Podium for Google Meet", "short_name": "Podium", "version": "1.0.0", "description": "Call on Google Meet participants one by one \u2014 random, A-Z, or Z-A order, no repeats. Built for teachers, standups & Q&A.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://meet.google.com/*"], "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Podium \u2014 Call on participants"}, "options_page": "settings.html", "background": {"service_worker": "background.js"}, "commands": {"next-participant": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Call next participant"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}