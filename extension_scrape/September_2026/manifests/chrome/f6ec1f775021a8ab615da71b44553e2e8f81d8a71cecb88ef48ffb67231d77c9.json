{"manifest_version": 3, "name": "Permission Scanner for Chrome", "version": "1.0.0.1", "update_url": "https://clients2.google.com/service/update2/crx", "homepage_url": "https://singleclickapps.com/permission-scanner", "description": "Permission Scanner audits all installed extensions and apps, analyzing their permissions, and provides quick risk score assessment.", "icons": {"16": "icon.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "contextMenus", "management", "storage"], "optional_permissions": [], "action": {"default_icon": "icon.png", "default_title": "Permission Scanner"}, "background": {"service_worker": "background.js"}, "options_page": "settings.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}}}}