{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "2eazy - Video Insights Extractor", "version": "1.2.8", "description": "Turn YouTube and Reddit research into a self-organizing knowledge base", "permissions": ["activeTab", "storage", "tabs", "alarms", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*", "https://api.deepseek.com/*", "https://api.openai.com/*", "https://*.supabase.co/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/detector.js", "content/youtube-extractor.js"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["content/detector.js", "content/reddit-detector.js"], "run_at": "document_idle"}, {"matches": ["https://2eazy.app/*", "https://*.2eazy.app/*"], "js": ["content/auth-sync.js"], "run_at": "document_idle"}], "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["utils/*.js"], "matches": ["*://*.youtube.com/*", "*://*.reddit.com/*"]}], "externally_connectable": {"matches": ["https://2eazy.app/*", "https://*.2eazy.app/*"]}}