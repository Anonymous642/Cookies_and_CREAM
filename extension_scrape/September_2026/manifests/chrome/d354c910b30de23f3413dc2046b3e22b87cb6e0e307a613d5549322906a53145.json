{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flow Prompt Runner", "version": "1.1.0", "description": "Run queued image prompts in your active Google Flow project while keeping its current generation settings.", "permissions": ["storage", "scripting"], "host_permissions": ["https://flow.google.com/*"], "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "Flow Prompt Runner", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://flow.google.com/project/*"], "js": ["content.js"], "run_at": "document_idle"}]}