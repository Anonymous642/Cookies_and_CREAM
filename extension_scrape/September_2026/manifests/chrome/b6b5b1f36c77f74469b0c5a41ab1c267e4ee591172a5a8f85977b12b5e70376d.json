{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabZen", "version": "0.2.0", "description": "Track how you really use your tabs, catch duplicates before they open, and purge, group and sort what is left.", "minimum_chrome_version": "116", "homepage_url": "https://github.com/diemtvu/tabzen", "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/ui/popup/popup.html", "default_title": "TabZen", "default_icon": {"16": "src/ui/icons/icon16.png", "32": "src/ui/icons/icon32.png"}}, "options_page": "src/ui/options/options.html", "permissions": ["tabs", "tabGroups", "storage", "sessions", "idle", "alarms", "scripting", "notifications", "unlimitedStorage", "favicon"], "optional_host_permissions": ["<all_urls>"], "commands": {"open-dashboard": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open the TabZen dashboard"}}, "icons": {"16": "src/ui/icons/icon16.png", "32": "src/ui/icons/icon32.png", "48": "src/ui/icons/icon48.png", "128": "src/ui/icons/icon128.png"}}