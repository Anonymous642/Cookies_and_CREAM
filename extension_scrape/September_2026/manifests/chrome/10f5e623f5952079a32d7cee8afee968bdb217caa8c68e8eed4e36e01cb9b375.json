{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rated Video Skipper", "version": "1.0", "description": "Automatically skips videos that have been rated (liked/disliked)", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png"}, "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["*://*.youtube.com/*"]}], "commands": {"cancel-skip": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Cancel the auto-skip countdown via keyboard shortcut"}}}