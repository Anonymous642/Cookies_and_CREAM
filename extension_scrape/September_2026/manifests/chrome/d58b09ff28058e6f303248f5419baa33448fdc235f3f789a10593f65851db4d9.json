{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipfrog", "version": "1.0.0", "description": "A primeira e mais utilizada ferramenta brasileira para clipar v\u00eddeos.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "notifications", "activeTab", "cookies", "scripting", "system.display"], "host_permissions": ["https://*.youtube.com/*", "https://*.youtu.be/*", "https://*.twitch.tv/*", "https://*.kick.com/*", "https://*.clipfrog.ai/*", "https://api.clipfrog.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.youtu.be/*", "https://*.twitch.tv/*", "https://*.kick.com/*"], "js": ["content-platform-detector.js", "content-widget-styles.js", "content-widget-ui.js", "content-main.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://*.youtube.com/*", "https://*.youtu.be/*", "https://*.twitch.tv/*", "https://*.kick.com/*"]}], "commands": {"quick-clip": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Clipar rapidamente o v\u00eddeo atual"}}}