{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BizDam CRM", "version": "2.0.0", "description": "BizDam CRM integration for LinkedIn and Facebook", "permissions": ["storage", "activeTab", "tabs", "notifications", "alarms", "scripting"], "host_permissions": ["https://bizdam.ai/*", "https://*.linkedin.com/*", "https://*.facebook.com/*"], "optional_host_permissions": ["https://*/*"], "externally_connectable": {"ids": [], "matches": []}, "background": {"service_worker": "dist/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["dist/linkedin.js", "dist/feed-monitor.js"], "run_at": "document_idle", "css": ["src/content/content.css"]}, {"matches": ["https://www.facebook.com/*"], "js": ["dist/facebook.js", "dist/feed-monitor.js"], "run_at": "document_idle", "css": ["src/content/content.css"]}, {"matches": ["https://www.linkedin.com/*"], "js": ["dist/linkedin-analytics.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*"], "js": ["dist/facebook-analytics.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/messaging/*"], "js": ["dist/linkedin-messaging.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}]}