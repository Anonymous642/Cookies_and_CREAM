{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rhythia+", "version": "2.0.0", "description": "Extra stats, hovercards, leaderboard tools, map downloads, a player watchlist, and osu!-style theming for rhythia.com.", "permissions": ["storage", "downloads", "alarms", "notifications"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://www.rhythia.com/*", "https://rhythia.com/*", "https://production.rhythia.com/*"], "browser_specific_settings": {"gecko": {"id": "rhythia-plus@rhythia.com", "strict_min_version": "121.0"}}, "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.rhythia.com/*", "https://rhythia.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "commands": {"toggle-inspector": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle the Rhythia+ score inspector panel"}}, "action": {"default_title": "Rhythia+", "default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}}