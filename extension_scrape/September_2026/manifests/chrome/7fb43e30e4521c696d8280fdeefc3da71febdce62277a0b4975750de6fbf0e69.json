{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meta Ad Library Creative Extractor", "version": "1.0.4", "description": "Extract image and video creative URLs from Meta Ad Library.", "permissions": ["storage", "tabs", "downloads", "scripting"], "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "action": {"default_popup": "popup.html", "default_title": "Meta Ad Library Creative Extractor", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.facebook.com/ads/library/*", "https://web.facebook.com/ads/library/*"], "js": ["content.js"], "run_at": "document_idle"}]}