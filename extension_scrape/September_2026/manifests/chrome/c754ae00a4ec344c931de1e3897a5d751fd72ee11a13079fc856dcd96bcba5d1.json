{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook Group Exit Assistant", "version": "0.3.0", "description": "Review, select, and leave unwanted Facebook groups with a paced queue you can pause or stop.", "default_locale": "en", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.facebook.com/*", "https://heydude-billing-production.heydudeapp.workers.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Facebook Group Exit Assistant", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "license.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["common.js", "content.js"], "css": ["manager.css"], "run_at": "document_idle"}]}