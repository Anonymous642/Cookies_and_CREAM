{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SendSuite: Express Email Templates", "version": "1.4.7", "description": "Quickly send templated emails using SendSuite from any webpage.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.sendsuite.us/*", "https://www.sendsuite.us/*"], "externally_connectable": {"matches": ["https://www.sendsuite.us/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://www.sendsuite.us/*"], "js": ["content.js"], "run_at": "document_idle"}]}