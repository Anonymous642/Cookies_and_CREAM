{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Beautify", "version": "1.0.0", "description": "Transform any website's look with one click. 8 stunning themes. Zero effort.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Beautify - Transform any page", "default_icon": {"16": "icons/beautify-icon16.png", "48": "icons/beautify-icon48.png", "128": "icons/beautify-icon128.png"}}, "commands": {"toggle-theme": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Toggle Beautify on/off"}, "next-theme": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Cycle to next theme"}}, "icons": {"16": "icons/beautify-icon16.png", "48": "icons/beautify-icon48.png", "128": "icons/beautify-icon128.png"}}