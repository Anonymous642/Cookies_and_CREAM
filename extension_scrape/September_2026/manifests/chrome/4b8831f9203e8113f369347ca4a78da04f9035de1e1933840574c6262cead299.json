{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DockIt", "version": "0.1.0", "description": "DockIt keeps a file open in Chrome's side panel, always one glance away. Free, local, and private.", "homepage_url": "https://dockit.dnbuilds.com", "minimum_chrome_version": "114", "icons": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "action": {"default_icon": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}}, "side_panel": {"default_path": "index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "scripting", "downloads"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["public/pdfjs/cmaps/*", "public/pdfjs/standard_fonts/*"], "use_dynamic_url": false}], "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open the DockIt side panel"}, "dock-current-tab": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Dock the document open in the current tab"}}}