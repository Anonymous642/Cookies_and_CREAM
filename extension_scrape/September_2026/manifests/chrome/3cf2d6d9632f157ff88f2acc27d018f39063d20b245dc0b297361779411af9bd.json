{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Lock \u2014 Website Blocker", "version": "1.0.0", "description": "Block distracting websites for focus sessions. Hard mode that survives restarts, schedules, whitelist mode, and stats.", "permissions": ["storage", "declarativeNetRequest", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "declarative_net_request": {"rule_resources": [{"id": "blocked_sites", "enabled": false, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["blocked.html", "friction.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}