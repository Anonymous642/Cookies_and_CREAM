{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "5LEAF - Amazon Product Research", "version": "1.0.3", "description": "Instant product analytics while browsing Amazon. See Deal Scores, BSR, sales estimates, and more.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*"], "externally_connectable": {"matches": ["https://5leaf.io/*", "https://*.lovableproject.com/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com/dp/*", "https://*.amazon.com/*/dp/*", "https://*.amazon.com/gp/product/*", "https://*.amazon.co.uk/dp/*", "https://*.amazon.co.uk/*/dp/*", "https://*.amazon.de/dp/*", "https://*.amazon.de/*/dp/*", "https://*.amazon.fr/dp/*", "https://*.amazon.fr/*/dp/*", "https://*.amazon.it/dp/*", "https://*.amazon.it/*/dp/*", "https://*.amazon.es/dp/*", "https://*.amazon.es/*/dp/*", "https://*.amazon.ca/dp/*", "https://*.amazon.ca/*/dp/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://5leaf.io/*", "https://*.lovableproject.com/*"], "js": ["auth-content.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*"]}]}