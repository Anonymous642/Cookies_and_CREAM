{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StealthGPT \u2014 Disguise Chat Sites", "version": "1.0.0", "description": "Instantly disguise AI chat sites as neutral pages with a simple toggle.", "action": {"default_title": "StealthGPT", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://phind.com/*", "https://poe.com/*", "https://you.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://perplexity.ai/*"], "js": ["content-script.js"], "css": ["styles.css"], "run_at": "document_idle"}], "commands": {"toggle-stealth": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S", "windows": "Alt+S", "chromeos": "Alt+S", "linux": "Alt+S"}, "description": "Toggle Stealth Mode"}, "panic-blank": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P", "windows": "Alt+Shift+P", "chromeos": "Alt+Shift+P", "linux": "Alt+Shift+P"}, "description": "Instant blank screen"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["https://*/*"]}