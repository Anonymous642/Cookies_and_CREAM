{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Upwind", "version": "0.2.1", "description": "Scans superyacht job postings on Yotspot with your Upwind account and applies to jobs you have reviewed. Only ever acts on Yotspot.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://www.yotspot.com/*", "https://upwindcrew.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.yotspot.com/job-profile/*"], "js": ["content-yotspot.js"], "css": ["content-yotspot.css"], "run_at": "document_idle"}, {"matches": ["https://www.yotspot.com/job-search.html*"], "js": ["content-yotspot-search.js"], "run_at": "document_idle"}, {"matches": ["https://www.yotspot.com/*"], "js": ["content-yotspot-dashboard.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Upwind"}, "externally_connectable": {"matches": ["https://upwindcrew.com/*"]}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}