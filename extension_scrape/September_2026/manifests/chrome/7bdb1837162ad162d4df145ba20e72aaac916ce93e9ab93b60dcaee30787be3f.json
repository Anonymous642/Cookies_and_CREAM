{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "TL;DW",
  "version": "0.2.1",
  "description": "Know before you watch. Quick video summaries, right on YouTube thumbnails.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "host_permissions": ["https://api.tldw.nl/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*"],
  "permissions": ["storage", "alarms"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{
    "resources": ["assets/logo.png"],
    "matches": ["https://www.youtube.com/*"]
  }],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["src/youtube.js", "src/api.js", "src/content.js"],
    "css": ["src/styles.css"],
    "run_at": "document_idle"
  }]
}
