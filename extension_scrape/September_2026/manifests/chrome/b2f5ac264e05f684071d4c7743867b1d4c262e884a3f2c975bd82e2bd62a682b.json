{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RotateX \u2013 Image Rotator & Webpage Rotator", "version": "2.5.1", "description": "Image rotator for Chrome. Rotate webpages, photos, PDFs and videos 90\u00b0, 180\u00b0 or 270\u00b0 in one click, and zoom into any image.", "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.dodopayments.com/*", "*://dodopayments.com/*"], "js": ["scripts/checkout-listener.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["purchased.html"], "matches": ["*://*.dodopayments.com/*", "*://dodopayments.com/*"]}], "action": {"default_popup": "popup.html"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "commands": {"rotate-cycle": {"suggested_key": {"default": "Ctrl+Q", "mac": "MacCtrl+Q"}, "description": "Rotate image/page 90\u00b0 (Cycle all 4 sides)"}, "rotate-90": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1"}, "description": "Rotate page 90\u00b0 clockwise"}, "rotate-180": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2"}, "description": "Rotate page 180\u00b0"}, "rotate-270": {"description": "Rotate page 270\u00b0"}, "rotate-reset": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "MacCtrl+Shift+0"}, "description": "Reset page rotation"}}, "icons": {"16": "rotate16.png", "32": "rotate32.png", "48": "rotate48.png", "128": "rotate128.png"}}