{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GrabCSS \u2014 copy any element's CSS & HTML", "version": "0.1.0", "description": "Grab the clean CSS and HTML of any element in one click. Hover, click, copy \u2014 no DevTools digging.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.gumroad.com/*"], "action": {"default_title": "Toggle GrabCSS (Alt+Shift+C)", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "commands": {"toggle-scan": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle GrabCSS on the current page"}, "toggle-grid": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Toggle the grid overlay"}, "scan-parent": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Scan the parent element"}}}