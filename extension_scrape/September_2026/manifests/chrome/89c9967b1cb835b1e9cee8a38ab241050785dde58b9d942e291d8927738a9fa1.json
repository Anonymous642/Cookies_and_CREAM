{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Mute", "description": "Mute and unmute tabs fast. Focus mode, auto-mute new tabs, and site rules.", "version": "1.0.0", "action": {"default_title": "Tab Mute", "default_popup": "popup.html"}, "background": {"service_worker": "service_worker.js", "type": "module"}, "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "options_page": "options.html", "commands": {"toggle-mute-tab": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle mute for current tab"}, "mute-others": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Command+Shift+O"}, "description": "Mute all tabs except current tab (window)"}, "mute-all-window": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Command+Shift+A"}, "description": "Mute all tabs in current window"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}