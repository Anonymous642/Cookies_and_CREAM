{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Orchetta", "version": "0.1.0", "description": "Capture research from any website and add it to your customer journeys", "icons": {"16": "public/icon-16.png", "32": "public/icon-32.png", "48": "public/icon-48.png", "128": "public/icon-128.png"}, "permissions": ["activeTab", "tabs", "contextMenus", "sidePanel", "scripting", "storage"], "host_permissions": ["https://orchetta.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Orchetta", "default_icon": {"16": "public/icon-16.png", "32": "public/icon-32.png", "48": "public/icon-48.png"}}, "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open Orchetta side panel"}, "quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save current selection"}}}