{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlowSave", "version": "1.0.0", "description": "Effortlessly save links, highlights, and notes without breaking your flow. Stay focused now\u2014review on your schedule.", "permissions": ["activeTab", "tabs", "contextMenus", "storage", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "FlowSave - Save this page"}, "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"]}], "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to FlowSave"}, "save-selection": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Save selected text to FlowSave"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}