{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FarLink \u2014 Every link on a page, by keyboard", "description": "Ctrl+Shift+Period (Cmd on Mac) opens every link on the page in one list. Filter by title or address. No mouse.", "version": "0.2.0", "short_name": "FarLink", "icons": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting", "activeTab"], "minimum_chrome_version": "116", "action": {"default_title": "FarLink \u2014 open on this page", "default_icon": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}}}, "background": {"service_worker": "background.js"}, "content_scripts": []}