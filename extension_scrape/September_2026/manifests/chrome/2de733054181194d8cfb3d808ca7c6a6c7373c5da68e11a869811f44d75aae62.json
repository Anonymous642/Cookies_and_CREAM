{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Block eBay Live Feed - no live streams", "version": "1.0.0", "description": "Hides eBay Live banners, carousels and the menu entry on eBay. Redirects /ebaylive to the homepage.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.co.uk/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.ie/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect_live", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.co.uk/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.ie/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}