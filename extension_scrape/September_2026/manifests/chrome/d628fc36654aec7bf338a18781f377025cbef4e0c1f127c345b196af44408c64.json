{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kamcart Multi-Channel Cross-Lister", "version": "1.0.0", "description": "1-Click automated cross-listing from Kamcart to Poshmark, Vinted, Etsy, Mercari, and more.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://app.kamcart.com/*", "https://*.poshmark.com/*", "https://*.vinted.com/*", "https://*.vinted.co.uk/*", "https://*.vinted.fr/*", "https://*.etsy.com/*", "https://*.mercari.com/*", "https://*.depop.com/*"], "content_scripts": [{"matches": ["https://app.kamcart.com/*"], "js": ["content_kamcart.js"], "run_at": "document_start"}, {"matches": ["https://poshmark.com/create-listing*", "https://*.poshmark.com/create-listing*", "https://poshmark.com/edit-listing*", "https://*.poshmark.com/edit-listing*"], "js": ["channels/channel_base.js", "channels/poshmark_channel.js"], "run_at": "document_idle"}, {"matches": ["https://*.vinted.com/items/new*", "https://*.vinted.co.uk/items/new*", "https://*.vinted.fr/items/new*"], "js": ["channels/channel_base.js", "channels/vinted_channel.js"], "run_at": "document_idle"}, {"matches": ["https://*.etsy.com/your/shops/*/tools/listings/create*"], "js": ["channels/channel_base.js", "channels/etsy_channel.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "channels/*"], "matches": ["<all_urls>"]}]}