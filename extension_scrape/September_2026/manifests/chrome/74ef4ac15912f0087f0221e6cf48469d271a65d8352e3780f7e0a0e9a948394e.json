{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amnesia AI Shield", "description": "Local-first protection for prompts and meetings.", "version": "1.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.perplexity.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://meet.google.com/*", "https://grok.com/*"], "externally_connectable": {"matches": ["https://meet.google.com/*", "https://login.amnesia-ai.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["promptInterceptor.js", "pageRehydrator.js", "promptOverlay.js"], "matches": ["https://*.perplexity.ai/*", "https://chatgpt.com/*"]}, {"resources": ["promptInterceptorGemini.js", "pageRehydrator.js", "promptOverlay.js"], "matches": ["https://gemini.google.com/*"]}, {"resources": ["promptInterceptorGrok.js", "pageRehydrator.js", "promptOverlay.js"], "matches": ["https://grok.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "AmnesiaAI Popup", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/meet.js"], "world": "MAIN"}, {"matches": ["https://meet.google.com/*"], "run_at": "document_start", "js": ["content-scripts/meetBridge.js"]}, {"matches": ["*://*.perplexity.ai/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://grok.com/*"], "run_at": "document_start", "js": ["content-scripts/promptInterceptorLoader.js"]}]}