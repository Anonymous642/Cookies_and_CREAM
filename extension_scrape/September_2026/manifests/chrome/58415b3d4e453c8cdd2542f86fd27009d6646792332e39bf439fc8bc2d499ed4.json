{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mirqab - Video Playback Inspector", "short_name": "Mirqab", "version": "1.4.0", "description": "A watchtower over your video playback: real resolution and FPS, dropped frames, buffer, live latency, codec, DRM and CDN.", "minimum_chrome_version": "114", "permissions": ["activeTab", "sidePanel", "storage", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Mirqab \u2014 Video Playback Inspector", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_start", "world": "MAIN", "js": ["content/page-hook.js"]}, {"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_start", "world": "ISOLATED", "js": ["utils/formatting.js", "utils/metrics.js", "utils/sparkline.js", "content/page-bridge.js", "content/video-monitor.js", "content/overlay.js", "content/content-script.js"]}], "web_accessible_resources": [{"resources": ["content/overlay.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Show or hide the Mirqab overlay on the page"}}}