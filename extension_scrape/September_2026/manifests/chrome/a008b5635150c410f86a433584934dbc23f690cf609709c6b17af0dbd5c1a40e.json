{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Antela Export Manager", "version": "1.0", "description": "Import Antela listings into Crexi and other CRE forms.", "icons": {"16": "logo-icon.png", "32": "logo-icon.png", "48": "logo-icon.png", "128": "logo-icon.png"}, "permissions": ["storage", "cookies", "scripting", "tabs"], "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://localhost:3000/*", "https://antela.ai/*", "https://www.antela.ai/*", "https://dev.antela.ai/*", "https://app.antela.ai/*", "https://crexi.com/*", "https://*.crexi.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Export Manager", "default_icon": {"16": "logo-icon.png", "32": "logo-icon.png", "48": "logo-icon.png", "128": "logo-icon.png"}}, "content_scripts": [{"matches": ["*://*.crexi.com/*", "*://crexi.com/*"], "js": ["content-script.js"], "run_at": "document_idle", "all_frames": true}]}