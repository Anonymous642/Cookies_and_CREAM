{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipManager", "version": "1.0.0", "description": "Clipboard history manager with macro support", "permissions": ["storage", "clipboardRead", "clipboardWrite", "activeTab", "contextMenus", "notifications", "scripting"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-clipboard": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Save clipboard to history"}, "run-macro-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Run Macro 1"}, "run-macro-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Run Macro 2"}, "run-macro-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Run Macro 3"}}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}]}