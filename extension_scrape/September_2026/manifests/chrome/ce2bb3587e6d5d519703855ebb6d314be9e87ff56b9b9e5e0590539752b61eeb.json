{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GP Dash", "version": "1.4.0", "description": "Price Amazon products against your own eBay store, and fill a buyer's address at checkout.", "permissions": ["storage", "scripting", "sidePanel"], "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*", "https://gpdash.app/*", "https://*.gpdash.app/*", "https://www.amazon.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "panel/panel.html"}, "action": {"default_title": "GP Dash", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content/common.js", "content/flow.js", "content/scan.js"], "css": ["content/gpdash.css"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.com/gp/buy/*", "https://www.amazon.com/checkout/*", "https://www.amazon.com/a/addresses/*", "https://www.amazon.com/gp/css/account/address/*"], "js": ["content/common.js", "content/flow.js", "content/checkout.js"], "css": ["content/gpdash.css"], "run_at": "document_idle"}]}