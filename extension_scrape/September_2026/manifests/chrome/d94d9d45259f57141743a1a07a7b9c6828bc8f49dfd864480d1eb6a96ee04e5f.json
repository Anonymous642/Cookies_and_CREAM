{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Listener Sync", "version": "1.1.0", "description": "Connects your podcast hosting accounts to Listener once, so Listener can keep your analytics up to date on its own.", "minimum_chrome_version": "120", "permissions": ["alarms", "storage", "cookies", "identity", "scripting"], "host_permissions": ["https://accounts.spotify.com/*", "https://creators.spotify.com/*", "https://cms.megaphone.fm/*", "https://*.megaphone.fm/*", "https://podcastsconnect.apple.com/*", "https://*.apple.com/*", "https://network.listener.com/*", "https://listener.com/*", "https://www.listener.com/*"], "background": {"service_worker": "sw/service-worker.js", "type": "module"}, "action": {"default_title": "Listener Sync", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://network.listener.com/*", "https://listener.com/*", "https://www.listener.com/*"], "js": ["bridge/page-bridge.js"], "run_at": "document_start", "all_frames": false}]}