{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube BookStamp", "key": "", "description": "Create bookmarks, precise timestamps, and custom tracklists for your favorite YouTube videos.", "version": "1.0.5", "action": {"default_popup": "index.html", "default_icon": "icons/icon16.png"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "unlimitedStorage", "identity"], "host_permissions": ["https://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content_script.js"], "css": ["ytbs.css"], "run_at": "document_start"}], "commands": {"abs": {"suggested_key": {"default": "Alt+B"}, "description": "Bookmark video and save timestamp"}, "rt": {"description": "TIMESTAMP MODE: Delete timestamp nearest to current playback time | TRACKLIST MODE: Remove currently playing track from tracklist"}, "set": {"suggested_key": {"default": "Alt+N"}, "description": "Set end time of timestamp before current playback time"}, "pt": {"suggested_key": {"default": "Alt+1"}, "description": "Skip to previous timestamp"}, "nt": {"suggested_key": {"default": "Alt+2"}, "description": "Skip to next timestamp"}}, "web_accessible_resources": [{"resources": ["icons/ytbs-btn.png"], "matches": ["https://*.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "oauth2": {"client_id": "252556069355-pf1lgsukh2hn7a1umlo6u30fppif3qmn.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}}