{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Clik \u2013 QR Scanner for Chrome", "description": "Scan QR codes directly from any webpage and turn them into clickable links\u2014no phone needed.", "version": "0.1.0", "action": {"default_popup": "popup.html", "default_title": "QR Clik \u2014 Scan QR on this page"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["jsQR.js", "content.js"], "run_at": "document_idle"}]}