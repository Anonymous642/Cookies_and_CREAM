{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BUCKS \u2014 Shopping Cashback", "version": "1.1.1", "description": "Earn cashback on Amazon.com purchases. Click to activate on each product. BUCKS earns commissions; cashback is from us, not Amazon", "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://*.amazon.com/*", "https://autobucks.app/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://autobucks.app/*"], "js": ["detect-web.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "optional_permissions": ["notifications"]}