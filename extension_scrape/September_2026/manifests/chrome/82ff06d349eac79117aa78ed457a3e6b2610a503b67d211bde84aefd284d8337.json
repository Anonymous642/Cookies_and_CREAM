{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "blurme - Privacy for Screen Sharing", "version": "1.0.4", "description": "Hide sensitive information during screen sharing, recordings, demos, and meetings.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.blurme.site/*", "https://blurme.site/*"], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+X", "mac": "Alt+X"}, "description": "Toggle blur panel"}, "toggle-element-select": {"suggested_key": {"default": "Alt+E", "mac": "Alt+E"}, "description": "Toggle element blur selection"}, "toggle-full-screen-blur": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Toggle full screen blur"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "BlurMe", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["whatsapp.js", "assets/*.js", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content.js"], "css": ["style.css"], "run_at": "document_start"}]}