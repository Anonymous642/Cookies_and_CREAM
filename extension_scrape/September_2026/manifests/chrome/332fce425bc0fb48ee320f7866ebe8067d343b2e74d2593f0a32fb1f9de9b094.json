{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Groovyday - Playlist Music Player for YouTube\u2122", "version": "0.1.0", "minimum_chrome_version": "114", "description": "Turn long YouTube videos into a chapter-aware listening queue.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["sidePanel", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Groovyday Playlist Music Player", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["chapter-parser.js", "content.js"], "run_at": "document_idle"}]}