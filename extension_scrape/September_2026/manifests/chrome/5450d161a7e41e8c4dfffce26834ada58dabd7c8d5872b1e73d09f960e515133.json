{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Power Control", "version": "1.0.0", "description": "All-in-one YouTube enhancement tool: Speed, Loop, Audio Boost, and more.", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["scripts/content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "options_page": "pages/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.youtube.com/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}}