{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PLSFIX-THX - Screenshot Annotator", "version": "1.1.0", "description": "Professional screenshot annotation with full-screen editor", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://plsfix-thx.com/*"], "action": {"default_popup": "popup.html", "default_title": "PLSFIX-THX Annotator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"area-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start area selection for screenshot"}, "full-page-capture": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page screenshot"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["editor.html", "editor.js", "editor-state.js", "editor-utils.js", "editor-storage.js", "editor-canvas.js", "editor-viewport.js", "editor-annotations.js", "editor-drawing.js", "editor-images.js", "editor-export.js", "editor-share.js", "editor-ui.js", "editor-keyboard.js", "editor-init.js", "editor.css", "jspdf.umd.min.js", "subscription-manager.js", "usage-tracker.js", "watermark-engine.js", "pdf-alternative.js", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://plsfix-thx.com"}}