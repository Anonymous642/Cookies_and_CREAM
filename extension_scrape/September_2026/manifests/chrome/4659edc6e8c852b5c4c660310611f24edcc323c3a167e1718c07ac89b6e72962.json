{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Maps Review Checker", "version": "4.0", "description": "Analyzes Google Maps reviews to detect suspicious reviewers", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://www.google.com/*", "https://maps.google.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Review Analysis Tab", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://maps.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}