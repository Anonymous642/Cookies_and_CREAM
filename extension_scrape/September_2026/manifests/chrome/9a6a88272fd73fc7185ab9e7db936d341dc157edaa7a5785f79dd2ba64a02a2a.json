{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EyeEase by EyeClinicDirectory.ca", "version": "1.0.7", "description": "Healthier screen time: 20-20-20 breaks with audio cue, per-site reading comfort, warm sunset tint. By EyeClinicDirectory.ca.", "homepage_url": "https://eyeclinicdirectory.ca", "permissions": ["storage", "alarms", "scripting", "activeTab", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "EyeEase", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "options_page": "options.html", "commands": {"take-break-now": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Take a break now"}, "snooze-15": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Snooze EyeEase for 15 minutes"}, "toggle-reading-comfort": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle Reading Comfort on the current site"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}