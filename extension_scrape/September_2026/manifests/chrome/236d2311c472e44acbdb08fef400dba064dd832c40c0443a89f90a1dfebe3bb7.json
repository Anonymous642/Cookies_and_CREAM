{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Work Hours Bar", "version": "1.8", "description": "Displays a live work hours progress bar on Google Calendar and the extension homepage.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage", "contextMenus", "tabs", "scripting", "activeTab", "declarativeContent"], "host_permissions": ["https://*.googleapis.com/", "https://*.accounts.dev/", "https://accounts.dev/", "https://api.clerk.dev/", "https://*.vercel.app/*", "https://workhoursbar.winstontech.me/"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Work Hours Bar", "default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png"}}, "content_scripts": [{"matches": ["https://calendar.google.com/*", "https://winstontech.me/*", "https://*.winstontech.me/*"], "js": ["config.js", "extension-utils.js", "content-message-bridge.js", "content.js"], "css": ["style.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.accounts.dev https://api.clerk.dev"}, "web_accessible_resources": [{"resources": ["popup.html", "clerk-config-check.html", "style.css", "extension-utils.js", "images/*"], "matches": ["https://calendar.google.com/*", "https://winstontech.me/*", "https://*.winstontech.me/*"]}], "externally_connectable": {"matches": ["https://*.accounts.dev/*", "https://*.vercel.app/*"], "accepts_tls_channel_id": false}}