{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Seek Skipper for YouTube", "version": "1.0.0", "description": "Jump forward or back on any YouTube video by 5, 10 or 20 seconds \u2014 from the toolbar, an on-video panel, or keyboard shortcuts.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Seek Skipper"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"seek_back_10": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Rewind 10 seconds"}, "seek_forward_10": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Skip ahead 10 seconds"}, "seek_back_5": {"description": "Rewind 5 seconds"}, "seek_forward_5": {"description": "Skip ahead 5 seconds"}, "seek_back_20": {"description": "Rewind 20 seconds"}, "seek_forward_20": {"description": "Skip ahead 20 seconds"}}}