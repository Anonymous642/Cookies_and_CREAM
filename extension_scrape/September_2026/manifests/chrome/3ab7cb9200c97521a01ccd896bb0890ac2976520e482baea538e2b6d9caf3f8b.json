{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Odoo Debug 2.0", "version": "1.5", "description": "Simple and fast extension to toggle Odoo debug modes.", "icons": {"16": "src/icons/monkeynormal.png", "48": "src/icons/monkeynormal.png", "128": "src/icons/monkeynormal.png"}, "permissions": ["storage", "activeTab", "tabs"], "action": {"default_title": "Toggle Odoo Debug Mode", "default_icon": "src/icons/placeholder.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Toggle Debug Mode (Click Action)"}, "set_mode_normal": {"description": "Switch to Normal Mode"}, "set_mode_debug": {"description": "Switch to Debug Mode"}, "set_mode_assets": {"description": "Switch to Assets Mode"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}}