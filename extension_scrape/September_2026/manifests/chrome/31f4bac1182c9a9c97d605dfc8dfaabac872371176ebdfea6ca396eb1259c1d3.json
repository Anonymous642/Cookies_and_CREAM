{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClientFlow Meeting Assistant", "version": "0.4.2", "description": "Captures Google Meet captions as text and syncs them to ClientFlow. No audio or video recording.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "tabs"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://meet.google.com/*", "https://clientflow-crm.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["meet-content.js"], "run_at": "document_idle"}, {"matches": ["https://clientflow-crm.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["crm-bridge.js"], "run_at": "document_start"}], "options_page": "options.html", "action": {"default_title": "ClientFlow Meeting Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}