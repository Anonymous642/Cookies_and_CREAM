{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabShelf - Browser Workspace Manager", "short_name": "TabShelf", "version": "1.0.3", "description": "Save your open tabs as a named workspace and reopen the whole project in one click. Organize browser clutter into projects.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "contextMenus"], "host_permissions": ["https://fondationdtm.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "TabShelf - Save this workspace"}, "commands": {"save-workspace": {"suggested_key": {"default": "Ctrl+Shift+S", "windows": "Ctrl+Shift+S"}, "description": "Save the current window as a workspace"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+E", "windows": "Ctrl+Shift+E"}, "description": "Open the TabShelf dashboard"}}}