{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meet to Salesforce Task Logger", "version": "1.1.0", "description": "Automatically logs Google Meet call subject and duration as Salesforce Tasks.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["identity", "storage", "alarms", "tabs"], "host_permissions": ["https://meet.google.com/*", "https://*.salesforce.com/*", "https://*.force.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "action": {"default_popup": "options.html", "default_title": "Meet to Salesforce", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}