{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RepoToPrompt: GitHub Code Packer for LLMs", "version": "1.0", "description": "Pack GitHub repositories into a single structured Markdown prompt for ChatGPT, Claude, and Gemini with one click.", "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://raw.githubusercontent.com/*", "https://codeload.github.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_start"}]}