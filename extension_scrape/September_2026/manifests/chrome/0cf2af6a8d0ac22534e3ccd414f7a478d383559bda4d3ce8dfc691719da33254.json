{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Custom Playback Speed", "description": "Minimal extension that lets you watch YouTube videos at any speed you want.", "version": "0.4.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Set playback speed", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "exclude_matches": ["https://www.youtube.com/account*", "https://www.youtube.com/login*", "https://www.youtube.com/signup*"], "js": ["dist/content.js"], "run_at": "document_idle"}]}