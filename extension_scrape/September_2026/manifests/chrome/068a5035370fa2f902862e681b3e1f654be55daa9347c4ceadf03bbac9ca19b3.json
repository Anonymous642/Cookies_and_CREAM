{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tater", "version": "0.1.0", "description": "Jot webpage annotations, stash recent captures, and stick them in a clean image view.", "icons": {"16": "icons/tater-16.png", "32": "icons/tater-32.png", "48": "icons/tater-48.png", "128": "icons/tater-128.png"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "action": {"default_title": "Tater", "default_popup": "popup.html", "default_icon": {"16": "icons/tater-16.png", "32": "icons/tater-32.png", "48": "icons/tater-48.png", "128": "icons/tater-128.png"}}, "background": {"service_worker": "assets/background.js", "type": "module"}, "commands": {"capture-visible-tab": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Capture the current visible viewport with Tater"}}}