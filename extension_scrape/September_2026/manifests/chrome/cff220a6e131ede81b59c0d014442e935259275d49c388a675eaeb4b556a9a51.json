{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HN Labels", "version": "1.0.0", "description": "Add custom labels next to usernames on Hacker News.", "permissions": ["storage"], "host_permissions": ["https://news.ycombinator.com/*", "https://hnlabels.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_title": "HN Labels", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}}