{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Ads Searchterm Translator", "version": "1.9.1", "description": "Translate Google Ads search terms into any of 130+ Google Translate languages, no API key. Developed by Corrado Seifert.", "permissions": ["storage"], "host_permissions": ["https://ads.google.com/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Google Ads Searchterm Translator settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://ads.google.com/*"], "js": ["export.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}