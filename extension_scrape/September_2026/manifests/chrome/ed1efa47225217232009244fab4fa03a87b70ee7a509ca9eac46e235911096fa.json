{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Booster", "version": "1.1.0", "description": "Boost any tab's volume up to 1000%, with per-site memory, bass/treble/voice EQ, dynamic compression, AGC, and safe listening mode.", "minimum_chrome_version": "100", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Volume Booster", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": false, "run_at": "document_start"}], "commands": {"volume-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase this tab's volume by 10%"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease this tab's volume by 10%"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute / unmute this tab"}, "reset-volume": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Reset this tab's volume to 100%"}, "toggle-boost": {"description": "Temporarily boost this tab's volume, then auto-revert (unbound by default; assign a key at chrome://extensions/shortcuts)"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}