{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wingman", "version": "0.5.0", "description": "An AI assistant beside your TradingView chart. It reads the chart, answers in levels you can point at, and draws the plan for you.", "minimum_chrome_version": "125", "permissions": ["sidePanel", "storage", "identity", "scripting"], "host_permissions": ["<all_urls>", "https://api.usewingman.xyz/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Open Wingman", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+W"}, "description": "Open Wingman"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "web_accessible_resources": [{"resources": ["assets/logo-mark.svg"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_origin_as_fallback": true, "js": ["dist/content.js"], "css": ["content.css"], "run_at": "document_idle"}]}