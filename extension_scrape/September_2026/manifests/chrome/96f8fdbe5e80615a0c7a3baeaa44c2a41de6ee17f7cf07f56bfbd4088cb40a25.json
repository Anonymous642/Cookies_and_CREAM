{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Connections Exporter", "description": "Scans your LinkedIn Connections page and exports name + profile URL.", "version": "1.0.0", "permissions": ["activeTab", "downloads"], "host_permissions": ["https://www.linkedin.com/*"], "icons": {"16": "icons/export-16x16.png", "48": "icons/export-48x48.png", "128": "icons/export-128x128.png"}, "action": {"default_title": "Connections Exporter", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/export-16x16.png", "48": "icons/export-48x48.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}