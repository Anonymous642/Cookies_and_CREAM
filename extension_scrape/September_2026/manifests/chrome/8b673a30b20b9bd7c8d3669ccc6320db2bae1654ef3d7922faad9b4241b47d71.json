{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PinBulk - Pinterest Bulk Uploader & Scheduler", "description": "Bulk upload and schedule pins to your Pinterest account, with API and DOM upload engines.", "version": "1.0.2", "permissions": ["activeTab", "storage", "sidePanel", "identity", "tabs", "scripting", "offscreen", "alarms"], "host_permissions": ["https://www.pinterest.com/*", "https://pinterest.com/*", "https://i.pinimg.com/*", "https://u.pinimg.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.pinterest.com/*", "https://pinterest.com/*"], "js": ["pinterestContentScript.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/*"], "matches": ["https://www.pinterest.com/*", "https://pinterest.com/*"]}], "action": {"default_title": "PinBulk - Pinterest Bulk Uploader & Scheduler", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "side_panel": {"default_path": "./src/index.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}