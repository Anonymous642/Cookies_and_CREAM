{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Popsicle Capture \u2014 capture any part of a page as HTML or Figma layers", "version": "1.3.3", "description": "Capture any element (or the whole page) as a standalone HTML artifact or a JSON snapshot.", "permissions": ["activeTab", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Popsicle Capture: HTML / Figma  (Alt+Shift+S)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-capture": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Popsicle Capture mode on the current page"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}