{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zunoy Bug Tracker", "version": "1.0.3", "description": "Capture screenshots, annotate issues, and report bugs with console and network context.", "permissions": ["activeTab", "storage", "webRequest", "contextMenus"], "host_permissions": ["https://api.zunoy.com/*", "*://*.zunoy.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/dist/index.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["overlay/dist/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"start-annotation": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start screen annotation"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}