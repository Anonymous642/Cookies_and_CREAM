{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tomato Garden: Pomodoro Timer & Website Blocker", "short_name": "Tomato Garden", "version": "1.0.0", "description": "Pomodoro focus timer that grows a garden. Block distracting websites and track study and work time by category. Fully offline.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tomato Garden", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["storage", "alarms", "notifications", "sidePanel", "offscreen", "declarativeNetRequestWithHostAccess"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["blocked.html", "sounds/*", "icons/*"], "use_dynamic_url": false}]}