{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sidebar Hub", "version": "2.0.0", "description": "Sidebar for tabs, downloads, bookmarks, notes, clipboard history, translation, Spotify control, and more.", "permissions": ["downloads", "storage", "tabs", "tabGroups", "sessions", "scripting", "sidePanel", "clipboardWrite", "identity", "history", "alarms", "bookmarks"], "host_permissions": ["http://*/*", "https://*/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/clipboard-capture.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Open Sidebar Hub"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open Sidebar Hub"}, "archive-current-tab": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Archive and close the current tab"}, "open-command-search": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Open Sidebar Hub and focus command search"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}