{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TranscriptSnap", "version": "1.0.0", "description": "One-click YouTube transcript copying for notes, AI prompts, and research", "homepage_url": "https://github.com/YOUR_USERNAME/transcriptsnap", "permissions": ["activeTab", "storage", "clipboardWrite", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/utils/transcript.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "commands": {"copy-transcript": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Copy transcript to clipboard"}}}