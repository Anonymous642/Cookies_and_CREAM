{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scroll Marks", "version": "1.0.0", "description": "Create named scroll marks to quickly navigate long pages. Perfect for ChatGPT conversations, documentation, and long-form content.", "author": "Scroll Marks Team", "homepage_url": "https://github.com/scrollmarks/scrollmarks-extension", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "commands"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/common.js", "src/storage.js", "src/content.js"], "css": ["src/ui.css"], "run_at": "document_end"}], "options_page": "src/options.html", "commands": {"add_mark_shortcut": {"suggested_key": {"default": "Alt+M"}, "description": "Add scroll mark at current position"}, "toggle_panel": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle scroll marks panel"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "", "default_title": "Scroll Marks - Click to activate"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}