{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tag My Tab", "version": "0.2.0", "description": "Manage browser tabs by assigning tags and adding comments.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "128": "assets/icon128.png"}, "permissions": ["tabs", "storage", "alarms"], "action": {"default_popup": "src/popup/popup.html"}, "background": {"service_worker": "dist/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["src/popup/views/*.html", "dist/*"], "matches": ["<all_urls>"]}]}