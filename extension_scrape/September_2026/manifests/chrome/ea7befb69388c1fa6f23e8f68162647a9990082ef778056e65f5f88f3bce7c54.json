{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Branchport", "version": "0.3.0", "description": "See which Git worktree and branch is serving each localhost port.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "clipboardWrite"], "host_permissions": ["http://127.0.0.1:32190/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Branchport", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L"}, "description": "Open Branchport"}}, "content_scripts": [{"matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "js": ["i18n.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}