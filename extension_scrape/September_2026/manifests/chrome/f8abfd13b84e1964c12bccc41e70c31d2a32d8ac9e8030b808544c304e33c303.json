{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shopya - Save from Any Store", "version": "1.1.1", "description": "Save products from any online store in one click. Organise your finds into collections and never lose a great deal again.", "permissions": ["storage", "activeTab", "scripting", "alarms"], "host_permissions": ["https://*/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content/extractor.js", "content/modal.js", "content/content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "Save to Shopya", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://shopya.app/*"]}, "web_accessible_resources": [{"resources": ["icons/*", "content/modal.css"], "matches": ["https://*/*"]}]}