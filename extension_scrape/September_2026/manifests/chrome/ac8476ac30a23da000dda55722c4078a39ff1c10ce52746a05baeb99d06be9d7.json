{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Formula Error Explainer Pro", "version": "1.1", "description": "Hover any #DIV/0!, #N/A, #REF! or other Google Sheets error to see what went wrong and how to fix it.", "permissions": ["storage"], "host_permissions": ["https://docs.google.com/*", "https://imromec-extensions.vercel.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/spreadsheets/*"], "js": ["errors.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Toggle Formula Error Explainer sidebar"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}