{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dim for Focus", "version": "1.1", "description": "Too many tabs? Focus on one. This free tool helps you concentrate. Try it!", "permissions": ["tabs", "scripting", "storage", "windows"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"128": "icon.png"}, "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle Focus Mode On/Off"}, "toggle-brightness-current-site": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Add/Remove Current Page from Bright List"}, "increase-dim-level": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase Dimming Level"}, "decrease-dim-level": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease Dimming Level"}}}