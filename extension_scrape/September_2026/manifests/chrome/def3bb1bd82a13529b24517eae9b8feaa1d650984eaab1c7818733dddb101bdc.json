{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CSGO Roll Guide", "description": "This extension will help you determine how many coins you need to level up and how much the coins cost in dollars on CSGORoll.", "version": "2.0.0", "icons": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "256": "icon/256.png"}, "permissions": ["background", "storage"], "host_permissions": ["https://www.csgoroll.com/*", "https://steamcommunity.com/pointssummary/ajaxgetasyncconfig"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.csgoroll.com/*"], "js": ["content-scripts/csgoroll.js"]}, {"matches": ["https://steamcommunity.com/pointssummary/ajaxgetasyncconfig"], "js": ["content-scripts/steam.js"]}]}