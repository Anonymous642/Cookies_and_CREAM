{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TCGPlayer Order Info", "description": "This extension will scan your TCGPlayer cart or order screen for all relevant information and download it into a formatted .csv!", "version": "1.0", "manifest_version": 3, "action": {"default_popup": "TCGPlayerCartInfo.html", "default_icon": "images/magicBack.png"}, "web_accessible_resources": [{"resources": ["popup.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://www.tcgplayer.com/cart*"], "js": ["TCGPlayerCartInfo.js"]}, {"matches": ["https://store.tcgplayer.com/myaccount/orderhistory*"], "js": ["TCGPlayerOrderInfo.js"]}], "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://www.tcgplayer.com/cart", "https://store.tcgplayer.com/myaccount/orderhistory"], "background": {"service_worker": "background.js"}}