{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FB Likes Extractor", "version": "1.0", "description": "Extrae usuarios que reaccionaron a fotos de Facebook y genera CSVs comparativos.", "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["https://www.facebook.com/*"], "icons": {"16": "16x16.png", "48": "48x48.png", "128": "128x128.png"}, "action": {"default_icon": {"16": "16x16.png", "48": "48x48.png", "128": "128x128.png"}, "default_popup": "popup.html", "default_title": "FB Likes Extractor"}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}