{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Deep Tab Search: Search Tab Content", "short_name": "DeepTab Search", "description": "Search open tabs by title, URL, or full page text. Find words and passages inside tab content, privately and locally in Chrome.", "version": "1.51.0", "manifest_version": 3, "minimum_chrome_version": "109", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "scripting", "favicon", "offscreen"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js"}, "incognito": "split", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["browser_compat.js", "content_highlight.js", "content_extraction.js", "content_script.js"], "css": ["content_highlight.css"], "all_frames": true, "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open DeepTab Search popup"}}, "action": {"default_title": "DeepTab Search", "default_popup": "popup.html"}}