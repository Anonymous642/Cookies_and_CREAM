{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Immersion Atlas \u2014 find Japanese YouTube at your level", "version": "1.4.0", "description": "Discover Japanese YouTube at your level, sync your Anki vocabulary, and optionally track immersion \u2014 on your device.", "action": {"default_title": "Immersion Atlas", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://immersionatlas.com/*", "https://www.immersionatlas.com/*", "https://okmine.app/*", "https://www.okmine.app/*"], "js": ["src/content-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["src/yt-tracker.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://www.youtube.com/*"], "js": ["src/yt-identity.js"], "run_at": "document_idle", "world": "MAIN", "all_frames": true}], "host_permissions": ["*://*.youtube.com/*"], "optional_host_permissions": ["http://127.0.0.1/*"], "permissions": ["declarativeNetRequestWithHostAccess", "storage"], "declarative_net_request": {"rule_resources": [{"id": "timedtext", "enabled": true, "path": "rules.json"}]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}