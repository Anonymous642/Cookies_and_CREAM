{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Groupify", "version": "1.0.1", "description": "A tab groups manager that gives you actual control over Chrome's built-in tab groups.", "minimum_chrome_version": "89", "action": {"default_title": "Groupify", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "options_page": "options/options.html", "permissions": ["tabs", "tabGroups", "storage", "windows"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open Groupify"}, "collapse-all": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Collapse all groups (Pro)"}, "expand-all": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Expand all groups (Pro)"}, "save-current-group": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab's group (Pro)"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://extensionpay.com"}}