{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wiredale - Price Tracker", "version": "2.0.0", "description": "Get Wiredale's expert ratings, price history, and buying insights while shopping on Amazon.", "permissions": ["activeTab", "storage", "sidePanel"], "host_permissions": ["https://www.wiredale.com/*", "https://wiredale.com/*", "http://localhost:4000/*", "https://www.amazon.com/*", "https://amazon.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://amazon.com/*"], "js": ["scripts/content.js"], "css": ["styles/content.css"]}], "background": {"service_worker": "scripts/background.js"}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["<all_urls>"]}]}