{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stockly \u2014 Inventory Monitor", "short_name": "Stockly", "version": "2.0.0", "description": "Monitor your store's inventory in real time. Instant low-stock alerts for Shopify, WooCommerce, Salla & Zid. \u0631\u0627\u0642\u0628 \u0645\u062e\u0632\u0648\u0646 \u0645\u062a\u062c\u0631\u0643.", "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications", "downloads", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Stockly \u2014 Inventory Monitor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["upgrade.html"], "matches": ["<all_urls>"]}]}