{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TheCarGo Phone", "description": "TheCarGo softphone \u2014 calls and SMS from your browser side panel.", "version": "1.4.6", "minimum_chrome_version": "116", "action": {"default_title": "TheCarGo Phone"}, "commands": {"answer-call": {"suggested_key": {"default": "Alt+Shift+A", "mac": "MacCtrl+Shift+A"}, "description": "Answer the incoming call"}, "hangup-call": {"suggested_key": {"default": "Alt+Shift+H", "mac": "MacCtrl+Shift+H"}, "description": "Hang up (or decline a ringing call)"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "MacCtrl+Shift+M"}, "description": "Mute or unmute the microphone"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"48": "icons/logo48.png", "128": "icons/logo128.png", "192": "icons/logo192.png", "512": "icons/logo512.png"}, "permissions": ["sidePanel", "storage", "offscreen", "notifications", "alarms", "power", "idle", "scripting", "activeTab"], "host_permissions": ["https://*.thecargo.io/*"], "content_scripts": [{"matches": ["https://*.thecargo.io/*"], "js": ["content-bridge.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo48.png"], "matches": ["<all_urls>"]}]}