{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTrace", "version": "1.0.1", "description": "Switch between tabs like Cmd+Tab \u2014 press Ctrl+M to cycle through your most recently used tabs with a visual overlay.", "permissions": ["storage", "tabs", "scripting", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Switch to previous tab"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"switch_tab": {"suggested_key": {"default": "Ctrl+M", "mac": "MacCtrl+M"}, "description": "Switch to previous tab"}}}