{"manifest_version": 3, "name": "WebRadar: Free Website Traffic & SEO Checker", "short_name": "WebRadar", "description": "Free website traffic and SEO checker with Domain Rating, backlinks, WHOIS, traffic sources, regions, and keyword insights.", "version": "0.1.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "WebRadar", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["storage", "tabs", "sidePanel", "alarms"], "host_permissions": ["https://webapi.domaintraffic.org/*", "https://dr.domaintraffic.org/*", "https://rdap.org/*", "https://api.github.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"toggle_side_panel": {"suggested_key": {"default": "Alt+D"}, "description": "Toggle WebRadar side panel"}}, "update_url": "https://clients2.google.com/service/update2/crx"}