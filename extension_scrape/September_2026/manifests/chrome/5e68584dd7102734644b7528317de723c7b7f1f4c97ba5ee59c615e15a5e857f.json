{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenSnap - Beautiful Screenshot Maker", "version": "1.3.0", "description": "Beautify screenshots instantly. Add backgrounds, padding, shadows & icons. Perfect for social media, docs, and product demos.", "permissions": ["activeTab", "tabs", "storage", "clipboardWrite", "scripting", "contextMenus", "unlimitedStorage", "alarms", "cookies"], "host_permissions": ["https://www.screensnap.site/*", "https://screensnap.site/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture region with ScreenSnap"}}, "externally_connectable": {"matches": ["https://screensnap.site/*", "https://www.screensnap.site/*", "http://localhost:3001/*"]}}