{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screend - Record Screen & Share faster", "description": "Record your screen with webcam, drawing tools, and quick sharing \u2014 designed for demos, tutorials, and presentations.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "scripting", "tabCapture", "desktopCapture", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Screend - Screen Recording", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["webcam.html"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}