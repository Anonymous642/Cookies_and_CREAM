{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitch CleanChat", "version": "1.1.0", "description": "Twitch CleanChat vous permet de bloquer les messages d\u2019utilisateurs sp\u00e9cifiques en temps r\u00e9el, pour un chat plus propre", "action": {"default_popup": "popup.html", "default_title": "Twitch CleanChat", "default_icon": {"16": "image/icone16.png", "48": "image/icone48.png", "128": "image/icone128.png"}}, "permissions": ["storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+M", "mac": "Command+Shift+Y"}}}, "icons": {"16": "image/icone16.png", "48": "image/icone48.png", "128": "image/icone128.png"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["i18n.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}