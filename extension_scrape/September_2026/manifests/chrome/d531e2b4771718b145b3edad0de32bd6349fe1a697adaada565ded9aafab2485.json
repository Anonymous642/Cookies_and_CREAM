{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StartlyTab", "version": "1.0.5", "description": "A small pause, built into your day. A beautiful new tab page with gateway shortcuts.", "permissions": ["bookmarks", "tabs", "search", "storage"], "chrome_url_overrides": {"newtab": "index.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Add Gateway", "default_icon": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-64x64.png", "128": "icons/icon-128x128.png"}}, "icons": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-64x64.png", "128": "icons/icon-128x128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co;"}, "externally_connectable": {"matches": ["https://www.startlytab.com/*", "https://startlytab.com/*"]}, "key": "", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open Gateway Adder"}}}