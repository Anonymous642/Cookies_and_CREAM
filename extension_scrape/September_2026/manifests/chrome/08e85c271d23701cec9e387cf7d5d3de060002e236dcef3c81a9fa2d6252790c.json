{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager for Browser", "version": "1.1", "description": "Split tabs into tiled windows. Grid & ratio layouts, PiP overlay, auto-split rules, focus dim, presets, multi-monitor support.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Tab Manager for Browser"}, "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "system.display", "windows", "favicon", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icons/*", "_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"]}], "commands": {"undo-resize": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "MacCtrl+Shift+Z"}, "description": "Undo last resize"}, "layout-1x1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1"}, "description": "Apply 1x1 layout (full screen)"}, "layout-1x2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2"}, "description": "Apply 1x2 layout (side by side)"}, "layout-2x2": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "MacCtrl+Shift+4"}, "description": "Apply 2x2 layout (quad view)"}}, "offline_enabled": true, "minimum_chrome_version": "110"}