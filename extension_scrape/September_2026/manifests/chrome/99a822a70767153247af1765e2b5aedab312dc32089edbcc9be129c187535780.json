{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadOnly for X (Twitter)", "version": "1.1.2", "description": "Makes X/Twitter read-only: removes posting and replying. Browsing, likes, reposts and DMs keep working.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://x.com/*", "*://twitter.com/*", "*://mobile.twitter.com/*", "*://pro.x.com/*"], "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*", "*://mobile.twitter.com/*", "*://pro.x.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "block-write-endpoints", "enabled": true, "path": "rules.json"}]}}