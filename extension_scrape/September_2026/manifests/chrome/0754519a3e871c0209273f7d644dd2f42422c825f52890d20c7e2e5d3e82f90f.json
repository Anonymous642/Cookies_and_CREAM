{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Warmth", "version": "0.6.1", "description": "Browser half of the Warmth focus app for Mac. Tells the app which tab you're on and blocks sites you chose. Needs the Warmth app.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "alarms", "storage", "declarativeNetRequest", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["tokens.css", "blocked.html", "blocked.css", "blocked.js"], "matches": ["<all_urls>"]}]}