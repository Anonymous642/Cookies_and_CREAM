{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MagiWords", "version": "0.2.0", "description": "Turn every page you read into a personal vocabulary lesson. Highlight, collect and quiz words while you browse.", "minimum_chrome_version": "114", "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://api.mymemory.translated.net/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "MagiWords", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "options_page": "src/dashboard/dashboard.html", "commands": {"toggle-highlight": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Analyze / stop analyzing the current page"}, "save-unknown": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Add all unknown words on this page"}}}