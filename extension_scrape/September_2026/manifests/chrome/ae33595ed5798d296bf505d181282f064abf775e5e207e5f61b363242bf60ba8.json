{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Espresso Resume", "version": "4.1.1", "description": "Resume tailoring & ATS formatting. Job application status tracking. Export to PDF & DOCX", "permissions": ["activeTab", "storage", "downloads", "scripting"], "host_permissions": ["https://*.linkedin.com/jobs/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://app.espresso-resume.com"}, "web_accessible_resources": [{"resources": ["libs/pdf.min.js", "libs/pdf.worker.min.js", "libs/pdf-config.js"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/espresso-16.png", "48": "icons/espresso-48.png", "128": "icons/espresso-128.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*"], "js": ["content.js"], "run_at": "document_idle"}]}