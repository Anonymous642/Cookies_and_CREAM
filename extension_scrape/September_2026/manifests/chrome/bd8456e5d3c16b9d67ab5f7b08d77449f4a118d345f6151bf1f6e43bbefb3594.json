{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jotato: Take Notes on YouTube & Webpages", "description": "Don't let saved links pile up unread. Clip, think and jot now.", "version": "0.10.9", "permissions": ["storage", "activeTab", "downloads", "tabs", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open Jotato", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background.js"}, "commands": {"clip-selection": {"suggested_key": {"default": "Ctrl+E", "mac": "Command+E"}, "description": "Clip selection"}}, "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-32.png", "icons/icon-48.png", "icons/icon-128.png", "icons/jotato-mark-256.png", "icons/jotato-hero-1024.png", "fonts/NotoSansSC-Variable.woff2", "fonts/NotoSerifSC-Variable.woff2", "fonts/Jost-Variable.woff2"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}