{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Review Analyzer Pro", "version": "1.4.6", "description": "Analyze and summarize Amazon product reviews with AI", "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://api.perplexity.ai/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.mx/*", "https://*.amazon.com.br/*", "https://*.amazon.com.au/*", "https://*.amazon.co.jp/*"], "action": {"default_title": "Amazon Review Analyzer Pro", "default_popup": "popup.html"}, "commands": {"analyze-reviews": {"suggested_key": {"default": "Alt+A", "mac": "MacCtrl+A"}, "description": "Analyze Amazon reviews directly"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.mx/*", "https://*.amazon.com.br/*", "https://*.amazon.com.au/*", "https://*.amazon.co.jp/*"], "js": ["content.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["settings.svg", "icon_128.png", "popup.css", "ExtPay.js", "marked.min.js"], "matches": ["<all_urls>"]}]}