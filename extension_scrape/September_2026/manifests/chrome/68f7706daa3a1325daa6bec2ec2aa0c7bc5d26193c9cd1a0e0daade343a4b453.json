{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RockRecipes", "version": "1.0.0", "description": "Save recipes from any website to your RockRecipes kitchen", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://rock.recipes/*", "https://*.paprikaapp.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/recipe-detector.js"], "run_at": "document_idle"}, {"matches": ["https://*.paprikaapp.com/*"], "js": ["content-scripts/paprika-importer.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-recipe": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Save recipe from current page"}}, "options_page": "options/options.html", "externally_connectable": {"matches": ["https://rock.recipes/*", "https://*.rock.recipes/*", "http://localhost:*/*"]}}