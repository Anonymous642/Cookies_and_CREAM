{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bonsai \u2014 JSON Tree Viewer", "description": "An editor-style JSON viewer with structure tree, search, and themes.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://daaar.github.io/bonsai-extension/", "permissions": ["storage", "activeTab"], "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_title": "Bonsai \u2014 JSON Tree Viewer", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*.json", "file:///*.jsonl", "file:///*.ndjson"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}