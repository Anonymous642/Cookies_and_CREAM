{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PR Pulse by CodePulse", "version": "1.0.0", "description": "See PR age and complexity at a glance on GitHub. Lightweight, free, no data collection. From CodePulseHQ.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "PR Pulse Settings"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://github.com/*/pull/*", "https://github.com/*/pulls", "https://github.com/*/pulls?*"], "js": ["content.js"], "css": ["badges.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://github.com/*"]}]}