{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoTyper by Pixelplot (Free)", "version": "1.1", "description": "Auto types text into focused input/textarea with configurable speed. Also supports auto-filling multiple form fields.", "author": "pixelplot", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "host_permissions": ["<all_urls>"], "commands": {"start-typing": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Start auto typing into focused field"}, "stop-typing": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Stop auto typing"}}}