{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Music Controller", "version": "1.1.0", "description": "Floating media controller with 360\u00b0 Visualizer, Bass Boost, Treble & 8D Audio across tabs. Made with \ud83e\udd0d by Karan Bhardwaj", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Floating Music Controller"}, "background": {"service_worker": "src/background/service-worker.js"}, "permissions": ["storage", "tabs", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/shared/constants.js", "src/shared/messages.js", "src/content/audio-effects.js", "src/content/media-detector.js", "src/content/media-controller.js", "src/content/controller.js", "src/content/content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/content/content.css", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"play_pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Play or pause current media"}, "next_track_or_seek_forward": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Alt+Shift+Right"}, "description": "Seek forward 10 seconds"}, "prev_track_or_seek_backward": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Alt+Shift+Left"}, "description": "Seek backward 10 seconds"}, "toggle_controller": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle floating controller visibility"}}}