{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snippit - Snippet Injector", "version": "4.0.0", "description": "Inject JS, CSS, HTML, JSON, TypeScript, YAML, XPath etc. and custom scripts into any website for testing and debugging.", "permissions": ["scripting", "activeTab", "storage", "tabs", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Snippit \u2013 Open Panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"quick-pick": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open snippet quick picker"}, "reinject-last": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Re-inject last snippet"}, "quick-inject": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Inject current snippet"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}, "description": "Toggle Snippit panel"}}, "web_accessible_resources": [{"resources": ["content/panel.css", "content/languages.js", "content/features.js", "content/dev-tools.js", "data/templates.json", "icons/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}