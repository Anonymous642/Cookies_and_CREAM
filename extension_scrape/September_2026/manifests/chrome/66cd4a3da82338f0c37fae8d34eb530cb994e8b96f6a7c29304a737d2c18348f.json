{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Alavo \u2014 Smart Vocabulary Learning", "description": "Look up words on any page or YouTube video, save them to your notebook, and review each one right before you forget it.", "version": "1.0.15", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "unlimitedStorage", "scripting", "offscreen", "tabs", "sidePanel", "identity", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://translate.googleapis.com/*", "https://clients5.google.com/*", "https://api.mymemory.translated.net/*", "https://freedictionaryapi.com/*", "https://*.wiktionary.org/*", "https://api.groq.com/*", "https://generativelanguage.googleapis.com/*", "https://api.deepseek.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["icons/*", "logo.svg", "icon.json"], "matches": ["*://*.youtube.com/*"]}], "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_title": "Alavo \u2014 Quick Lookup", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube-isolated.js", "content-scripts/youtube.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube-main-world.js"], "world": "MAIN"}]}