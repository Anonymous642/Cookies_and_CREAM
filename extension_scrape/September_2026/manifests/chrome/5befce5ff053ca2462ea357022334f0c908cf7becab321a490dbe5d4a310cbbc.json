{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Elite Recording Manager BETA", "version": "3.2.8", "description": "THIS EXTENSION IS FOR BETA TESTING. Record and manage Chrome tab audio with timers, recovery, trimming, and multi-tab capture.", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "downloads", "unlimitedStorage", "sidePanel"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Elite Recording Manager BETA \u2014 record this tab", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"start-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start recording audio from the active tab"}, "stop-recording": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Stop recording the active tab (or the most recent recording)"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "side_panel": {"default_path": "sidepanel.html"}, "version_name": "3.2.8 beta"}