{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RASTATAB", "version": "6.1.4", "description": "Color-code your tabs with a right-click, keyboard shortcuts, or voice. Compare products, apartments & more.", "permissions": ["activeTab", "contextMenus", "storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"color-cycle": {"suggested_key": {"default": "Alt+R"}, "description": "Cycle through colors"}, "color-remove": {"suggested_key": {"default": "Alt+Q"}, "description": "Remove tab color"}, "toggle-voice": {"description": "Toggle voice commands (microphone)"}}}