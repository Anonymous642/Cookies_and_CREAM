{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Click-to-Call (ViciAgent)", "version": "0.9.2", "description": "Turns a lead's phone number in Salesforce into a click-to-call link. Vicidial places the call in the signed-in ViciAgent session.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["<all_urls>"], "storage": {"managed_schema": "managed_schema.json"}, "host_permissions": ["*://*.lightning.force.com/*", "*://*.salesforce.com/*", "*://*.force.com/*", "*://*.visualforce.com/*", "*://*.cpscentral.com/*", "*://agent.smartdemo.genxcontactcenter.com/*", "*://agent.cps.smartcarrier.io/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.lightning.force.com/*", "*://*.salesforce.com/*", "*://*.force.com/*", "*://*.visualforce.com/*", "*://*.cpscentral.com/*", "http://localhost/*", "http://127.0.0.1/*", "file:///*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Salesforce Click-to-Call", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html"}