{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Custro LinkedIn Assistant", "version": "1.0.2", "description": "AI writing assistant for LinkedIn job seekers \u2014 drafts posts, comments, outreach. User-initiated only; nothing sent automatically.", "author": "Custro Team", "homepage_url": "https://custro.com", "permissions": ["activeTab", "storage", "tabs", "identity", "sidePanel", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://custro.com/*", "https://www.youtube.com/*"], "externally_connectable": {"matches": ["https://custro.com/*"]}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content/content.js"], "run_at": "document_end", "all_frames": true}], "action": {"default_title": "Custro Assistant", "default_icon": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}}, "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["public/assets/*"], "matches": ["https://www.linkedin.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.youtube.com"}}