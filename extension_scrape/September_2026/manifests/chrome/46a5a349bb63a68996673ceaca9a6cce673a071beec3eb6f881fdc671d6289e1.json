{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GhostFill \u2014 Clipboard-to-Form Filler", "version": "0.1.0", "description": "Fill forms from structured clipboard data (JSON/CSV/YAML) in one click.", "permissions": ["storage", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_title": "GhostFill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "commands": {"fill-from-clipboard": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Fill current page form(s) from last clipboard data"}, "undo-last-fill": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Undo the last GhostFill fill"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}