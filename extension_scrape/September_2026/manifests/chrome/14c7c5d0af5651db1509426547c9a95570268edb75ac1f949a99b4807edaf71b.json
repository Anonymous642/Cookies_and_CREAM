{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Daplinks - Your Digital Access Point", "version": "1.0.2", "description": "Transform your new tab into a productivity hub. Manage tabs, organize bookmarks, and boost focus\u2014all in one place.", "homepage_url": "https://daplinks.com", "permissions": ["storage", "tabs", "activeTab", "bookmarks", "notifications", "contextMenus", "webNavigation", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "chrome_url_overrides": {"newtab": "newtab.html"}, "side_panel": {"default_path": "sidebar.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "DapLinks"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*", "fonts/fontawesome/*", "fonts/fontawesome/css/*", "fonts/fontawesome/webfonts/*", "fonts/google/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Open Daplinks popup"}}}