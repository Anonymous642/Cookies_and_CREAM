{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "inboxy \u2014 email aliases on focus", "short_name": "inboxy", "version": "1.0.0", "description": "Pre-fill emails with random @inboxy.net aliases. Swap to your real address. Keeps spam and trackers off inbox.", "homepage_url": "https://inboxy.net", "icons": {"16": "icons/inboxy-16.png", "32": "icons/inboxy-32.png", "48": "icons/inboxy-48.png", "128": "icons/inboxy-128.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "inboxy", "default_popup": "popup/index.html", "default_icon": {"16": "icons/inboxy-16.png", "32": "icons/inboxy-32.png", "48": "icons/inboxy-48.png"}}, "permissions": ["storage", "identity", "activeTab"], "host_permissions": ["https://api.inboxy.net/*", "https://inboxy.net/*"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://inboxy.net/*", "https://*.inboxy.net/*"], "js": ["content/index.js"], "run_at": "document_idle", "all_frames": true, "match_origin_as_fallback": true}], "commands": {"reroll": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Fill the focused field with a different alias"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}