{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AuthRelay", "short_name": "AuthRelay", "version": "0.2.0", "description": "Sign in with Google on desktop using your phone. Intercepts OAuth redirects and relays them to your mobile device.", "author": "AuthRelay Contributors", "homepage_url": "https://authrelay.app", "permissions": ["storage", "webNavigation"], "host_permissions": ["https://accounts.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "116"}