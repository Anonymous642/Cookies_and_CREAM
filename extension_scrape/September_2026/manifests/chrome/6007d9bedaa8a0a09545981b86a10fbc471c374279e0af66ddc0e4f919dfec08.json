{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Comments Extractor by GTM minute", "version": "1.2.3", "description": "Extract comments from a LinkedIn post and download them as CSV/JSON.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "activeTab", "storage", "downloads", "tabs", "identity", "sidePanel"], "host_permissions": ["https://*.linkedin.com/*", "https://gtmminute.com/*", "https://data.gtmminute.com/*", "https://extensionpay.com/*", "https://accounts.google.com/*", "https://www.googleapis.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Extract LinkedIn comments", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["ExtPay.js"], "matches": ["https://extensionpay.com/*"]}]}