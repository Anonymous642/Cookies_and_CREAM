{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Job Application Tracker for LinkedIn (Auto Apply)", "version": "1.0", "description": "Automatically track your LinkedIn job applications, add notes, manage status, and mark applied jobs directly on LinkedIn.", "minimum_chrome_version": "109", "action": {"default_popup": "popup/popup.html", "default_icon": "assets/icon48.png", "default_title": "LinkedIn Job Tracker"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://www.linkedin.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"], "js": ["utils.js", "content.js"], "run_at": "document_idle"}]}