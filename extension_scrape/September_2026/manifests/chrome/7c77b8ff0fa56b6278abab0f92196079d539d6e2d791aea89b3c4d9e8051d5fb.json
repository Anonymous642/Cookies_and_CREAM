{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Switcher", "version": "1.3", "description": "Dual AI Chat interface with global hotkeys, custom endpoints, and dark mode.", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["https://gemini.google.com/*", "https://m365.cloud.microsoft/*", "https://copilot.microsoft.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://duck.ai/*", "https://login.microsoftonline.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open AI Switcher", "default_icon": "icon-ai-16.png"}, "declarative_net_request": {"rule_resources": [{"id": "remove-headers", "enabled": true, "path": "rules.json"}]}, "commands": {"toggle-toolbar": {"suggested_key": {"default": "Alt+T"}, "description": "Toggle Toolbar Visibility"}, "maximize-left": {"suggested_key": {"default": "Alt+1"}, "description": "Maximize/Restore Left Frame"}, "maximize-right": {"suggested_key": {"default": "Alt+2"}, "description": "Maximize/Restore Right Frame"}}, "icons": {"16": "icon-ai-16.png", "48": "icon-ai-48.png", "128": "icon-ai-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}