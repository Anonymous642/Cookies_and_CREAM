{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simpan Dulu", "version": "1.0.4", "description": "Simpan dan kelola bookmark dengan mudah. Quick save, save all tabs, dan akses dari mana saja.", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "default_title": "Simpan Dulu"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["activeTab", "contextMenus", "tabs", "cookies", "scripting", "storage"], "host_permissions": ["https://simpandulu.com/*", "https://www.simpandulu.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Buka Simpan Dulu"}, "quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Simpan halaman ini langsung"}, "save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Simpan semua tabs"}}, "minimum_chrome_version": "110"}