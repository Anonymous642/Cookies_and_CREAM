{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feed Bob Everywhere", "version": "1.2.0", "description": "Inject your team's context into any AI chat + capture text from anywhere", "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://feedbob.com/*", "https://www.feedbob.com/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}, {"matches": ["https://feedbob.com/*", "https://www.feedbob.com/*", "http://localhost:3000/*"], "js": ["feedbob-bridge.js"], "run_at": "document_end"}, {"matches": ["<all_urls>"], "js": ["universal-content.js"], "run_at": "document_end", "all_frames": false}], "action": {"default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "commands": {"inject-context": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Inject Bob's context into current chat"}, "feed-to-bob": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Feed selected text to Bob (Cmd+Shift+K or Cmd+Shift+F)"}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "popup.html", "popup.js", "onboarding.html"], "matches": ["<all_urls>"]}]}