{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ForcePaste - Smart Clipboard Typer", "version": "2.0.0", "description": "Smart clipboard tool: simulates typing, manages snippets, reliable on all websites.", "background": {"service_worker": "background.js"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "contextMenus", "debugger", "scripting", "activeTab", "clipboardRead", "clipboardWrite"], "host_permissions": ["file:///*", "<all_urls>"], "commands": {"start_typing": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start typing from clipboard"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open ForcePaste settings"}}, "action": {"default_popup": "popup.html", "default_title": "ForcePaste - Smart Clipboard Typer"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}]}