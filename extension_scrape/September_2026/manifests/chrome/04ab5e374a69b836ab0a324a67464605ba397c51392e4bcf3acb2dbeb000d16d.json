{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ImpulseVault", "version": "0.1.0", "description": "Pause online purchases with a private cooling-off vault before checkout.", "action": {"default_title": "ImpulseVault", "default_popup": "popup.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "permissions": ["storage", "alarms", "activeTab"], "optional_permissions": ["notifications"], "host_permissions": ["https://*.amazon.com/*", "https://*.bestbuy.com/*", "https://*.target.com/*", "https://*.walmart.com/*", "https://*.ebay.com/*", "https://*.etsy.com/*"], "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.bestbuy.com/*", "https://*.target.com/*", "https://*.walmart.com/*", "https://*.ebay.com/*", "https://*.etsy.com/*"], "js": ["assets/content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "dashboard.html", "commands": {"add-current-page-to-vault": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Add current page to Vault"}}}