{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PaneTrans", "version": "1.0.0", "description": "Free, private translation that runs 100% on your device: live YouTube subtitles, bilingual pages, and any screen region.", "permissions": ["storage", "activeTab", "offscreen", "contextMenus", "scripting", "tabs", "alarms"], "host_permissions": ["<all_urls>", "https://*.huggingface.co/*", "https://*.hf.co/*", "https://cdn.jsdelivr.net/*", "https://tessdata.projectnaptha.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/content.js"], "css": ["content/subtitle-overlay.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content/region-select.js"], "css": ["content/region-select.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content/page-translate.js"], "css": ["content/page-translate.css"], "run_at": "document_idle"}], "commands": {"toggle-page-translate": {"suggested_key": {"default": "Alt+T"}, "description": "Translate this page (bilingual) / restore original"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["wasm/*", "tesseract/*", "content/region-select.css", "content/page-translate.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}