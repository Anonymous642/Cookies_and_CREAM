{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Message Archiver", "version": "1.0.0", "description": "Injects an Archive button into LinkedIn message list items and archives the selected conversation.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "tabs", "webNavigation"], "host_permissions": ["https://www.linkedin.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "LinkedIn Message Archiver"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}