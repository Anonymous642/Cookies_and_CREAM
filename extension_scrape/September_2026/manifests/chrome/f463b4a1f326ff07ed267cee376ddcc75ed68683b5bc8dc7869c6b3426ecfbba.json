{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouFocus", "description": "Stay focused on YouTube by hiding home recommendations, suggested videos, thumbnails, comments, and distractions.", "version": "1.0.0", "icons": {"16": "icons/youfocus16.png", "32": "icons/youfocus32.png", "48": "icons/youfocus_icon_48.png", "128": "icons/youfocus_icon_128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/youfocus32.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}