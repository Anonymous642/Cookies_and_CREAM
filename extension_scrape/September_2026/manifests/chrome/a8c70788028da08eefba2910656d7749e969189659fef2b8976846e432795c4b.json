{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marketplace Phone Extractor", "version": "1.5.0", "description": "Adds a Show phone button to Facebook Marketplace listings, reveals the seller phone number, and copies it to the clipboard.", "permissions": ["tabs", "scripting", "clipboardWrite", "debugger"], "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Get listing phone", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/item/*", "https://m.facebook.com/marketplace/item/*"], "js": ["content.js"], "run_at": "document_idle"}]}