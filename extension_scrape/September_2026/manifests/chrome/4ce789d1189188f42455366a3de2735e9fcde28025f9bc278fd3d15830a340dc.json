{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pic to Event - Image to Calendar Converter", "version": "1.1.0", "description": "Convert event images to Google Calendar events with one click. Works on Instagram, Facebook, email, and any website.", "permissions": ["contextMenus", "activeTab", "storage", "clipboardWrite", "notifications"], "host_permissions": ["https://api.alwayshello.com/*", "<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content-instagram.js"], "run_at": "document_end"}], "commands": {"capture-screen": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture screen and create calendar event"}}}