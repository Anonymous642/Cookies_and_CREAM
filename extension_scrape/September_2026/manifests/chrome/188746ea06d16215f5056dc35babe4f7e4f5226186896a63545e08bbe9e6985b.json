{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Design Toolkit - Element Inspector & Measurement", "version": "1.2.1", "description": "Inspect, measure and copy any web design: box model, spacing, fonts, colors, responsive preview and animations for AI.", "homepage_url": "https://www.designtoolkit.online/", "permissions": ["activeTab", "scripting", "declarativeNetRequestWithHostAccess", "storage"], "optional_permissions": ["downloads"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle Design Toolkit"}, "inspect": {"suggested_key": {"default": "Alt+I"}, "description": "Turn on the inspector"}, "measure": {"suggested_key": {"default": "Alt+M"}, "description": "Turn on distance measurement"}}, "externally_connectable": {"matches": ["https://www.designtoolkit.online/*", "https://designtoolkit.online/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}