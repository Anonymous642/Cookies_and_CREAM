{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Z-Shot Beta", "version": "1.0.0", "description": "Professional visual workspace - capture, organize, and annotate webpages with precision.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "html/popup.html", "default_title": "Z-Shot - Capture & Annotate", "default_icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "side_panel": {"default_path": "html/sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Z-Shot extension popup"}, "capture_full_page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture full page screenshot"}, "capture_visible_area": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture visible area screenshot"}, "capture_area": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Capture selected region"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/privacy_engine.js", "js/content_wrap.js", "js/content.js"], "run_at": "document_idle"}]}