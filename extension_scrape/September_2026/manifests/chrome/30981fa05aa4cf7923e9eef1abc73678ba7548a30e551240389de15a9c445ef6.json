{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Like/Dislike Ratio", "version": "2.1.0", "description": "Shows like/dislike ratio on YouTube (via Return YouTube Dislike API).", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "https://returnyoutubedislikeapi.com/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "YouTube Like/Dislike Ratio", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}