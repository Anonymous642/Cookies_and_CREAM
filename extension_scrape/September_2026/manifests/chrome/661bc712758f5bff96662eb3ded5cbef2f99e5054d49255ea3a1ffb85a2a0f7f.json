{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SecurePass AI - Password Generator", "version": "1.0.0", "description": "Generate highly secure, customizable passwords and auto-fill them into any password field. 100% offline, no tracking, no analytics.", "author": "SecurePass AI", "minimum_chrome_version": "102", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "SecurePass AI", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": true}], "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"], "host_permissions": ["<all_urls>"], "commands": {"generate-password": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate a new password"}, "fill-password": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fill the last generated password into the focused field"}, "copy-password": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy the last generated password to clipboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}}