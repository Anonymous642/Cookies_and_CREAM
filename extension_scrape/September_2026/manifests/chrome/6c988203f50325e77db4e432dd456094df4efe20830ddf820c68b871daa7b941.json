{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rastry Music", "version": "1.0.5", "description": "Detects music from YouTube Music, Spotify, Apple Music, SoundCloud and displays it on Twitch streams. Requires rastry.com account", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://music.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*", "https://soundcloud.com/*", "https://www.rastry.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content-youtube.js"], "run_at": "document_idle"}, {"matches": ["https://open.spotify.com/*"], "js": ["content-spotify.js"], "run_at": "document_idle"}, {"matches": ["https://music.apple.com/*"], "js": ["content-itunes.js"], "run_at": "document_idle"}, {"matches": ["https://soundcloud.com/*"], "js": ["content-soundcloud.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}