{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dual Pilot \u2014 for ChatGPT & Claude", "short_name": "Dual Pilot", "version": "1.0.1", "description": "Send one prompt to ChatGPT and Claude at the same time. Uses your existing logins \u2014 no API keys required.", "permissions": ["tabs", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_title": "Dual Pilot"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-claude.js"], "run_at": "document_idle"}]}