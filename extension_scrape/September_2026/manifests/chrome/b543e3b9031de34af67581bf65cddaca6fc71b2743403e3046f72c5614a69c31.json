{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode AI Assistant", "version": "1.0.0", "description": "AI-powered assistant for LeetCode problem-solving. Get hints, explanations, and solutions using Google Gemini, OpenAI, or Anthropic.", "author": "Ganesh S P", "homepage_url": "https://github.com/ganeshsp1/leetcode-ai-assistant", "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs", "windows"], "host_permissions": ["https://leetcode.com/*", "https://*.leetcode.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://hooks.slack.com/*"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle LeetCode AI Assistant"}}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*", "https://*.leetcode.com/problems/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["tailwind.min.css", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://hooks.slack.com https://generativelanguage.googleapis.com https://api.openai.com https://api.anthropic.com"}, "minimum_chrome_version": "114"}