{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "App Release Assistant", "version": "0.8.0", "description": "Reuse localized What's New text and edit Description safely in App Store Connect.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "App Release Assistant", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://appstoreconnect.apple.com/*"], "content_scripts": [{"matches": ["https://appstoreconnect.apple.com/*"], "js": ["content/index.js"], "css": ["content/inline-assistant.css"], "run_at": "document_idle"}]}