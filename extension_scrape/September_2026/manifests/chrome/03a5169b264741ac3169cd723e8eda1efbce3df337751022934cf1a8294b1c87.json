{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab-CoPilot", "version": "1.0.0", "description": "Intelligently suspends inactive tabs to save memory with AI-inspired approach", "permissions": ["tabs", "storage", "scripting", "tabGroups"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["suspended-tab-icon.css"]}], "web_accessible_resources": [{"resources": ["activity-tracker.js", "unsaved-work-detector.js", "suspend-prompt.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Open Tab-CoPilot"}, "toggle-suspension": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Toggle tab suspension for the current tab"}, "optimize-tabs": {"suggested_key": {"default": "Ctrl+Shift+O"}, "description": "Run tab optimization"}}}