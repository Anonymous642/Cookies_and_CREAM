{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Sound Recorder - Record & Export MP3", "version": "1.1", "description": "Record audio playing in the active tab and save it as a WAV or MP3 file. Trim the recording and adjust the volume before saving.", "permissions": ["tabCapture", "offscreen", "downloads", "storage", "activeTab"], "host_permissions": ["https://minimalapi.thomasrasmussen.dk/*"], "background": {"service_worker": "background.js"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Start or stop recording the active tab"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}