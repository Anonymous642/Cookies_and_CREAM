{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Plify AI Insight - Reddit AI Summary Tool (Free)", "description": "AI-powered summarizer for Reddit, YouTube, Hacker News and more. Less reading, more insight.", "version": "0.5.1", "short_name": "Plify AI Insight", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "activeTab", "storage", "scripting"], "host_permissions": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://news.ycombinator.com/*"], "action": {"default_title": "Plify AI Insight", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://news.ycombinator.com/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://*.reddit.com/*"], "js": ["content-reddit.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-youtube.js"]}, {"matches": ["*://news.ycombinator.com/item?id=*"], "js": ["content-hacker-news.js"]}, {"matches": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://news.ycombinator.com/*"], "js": ["content-scripts/content.js"]}], "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["icons/*", "*.css"], "matches": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://news.ycombinator.com/*"]}], "background": {"service_worker": "background.js"}}