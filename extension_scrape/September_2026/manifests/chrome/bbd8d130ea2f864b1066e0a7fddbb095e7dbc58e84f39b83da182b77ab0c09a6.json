{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Simplify YouTube", "version": "1.7", "manifest_version": 3, "description": "Reduces YouTube interface to the bare minimum", "homepage_url": "https://simpl.fyi", "icons": {"48": "img/icon48.png", "128": "img/icon128.png", "512": "img/icon512.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["js/constants.js", "js/util.js", "js/input.js", "js/home.js", "js/watch.js", "js/history.js", "js/observers.js", "js/url.js", "js/main.js"], "css": ["style.css"], "run_at": "document_start", "all_frames": false}], "content_security_policy": {"extension_pages": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self'"}}