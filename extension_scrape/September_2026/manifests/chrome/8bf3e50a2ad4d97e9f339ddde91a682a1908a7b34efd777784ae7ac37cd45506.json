{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MonoFill: Smart E-Filing", "description": "MonoFill by Monolo is a browser extension that auto-fills client and case details into USCIS, FLAG, and CEAC online forms.", "version": "0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "activeTab", "sidePanel"], "host_permissions": ["*://*.vtus.app/*", "*://my.uscis.gov/forms/*"], "web_accessible_resources": [{"resources": ["callback.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://my.uscis.gov/forms/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://my.uscis.gov/forms/*"], "js": ["content-scripts/main-world.js"], "world": "MAIN"}]}