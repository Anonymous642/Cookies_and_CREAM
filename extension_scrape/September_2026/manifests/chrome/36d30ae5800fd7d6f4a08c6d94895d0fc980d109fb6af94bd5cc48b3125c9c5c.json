{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StikyTabs", "version": "2.0", "description": "Colorful sticky notes on every page. States: active, in progress, done. Expiry countdown.", "permissions": ["storage", "tabs", "contextMenus", "downloads"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "StikyTabs"}, "background": {"service_worker": "background.js"}, "commands": {"create-postit": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Create a new sticky note on the current page"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end"}]}