{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paper Terminal \u2014 practice crypto trading", "short_name": "Paper Terminal", "version": "1.0.1", "description": "Practice trading with virtual money at live prices. Simulated fills, full history, exportable style. Works with fomo.family.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Paper Terminal", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "identity", "sidePanel"], "host_permissions": ["https://fomo.family/*", "https://paper-terminal-production.up.railway.app/*"], "content_scripts": [{"matches": ["https://fomo.family/*"], "js": ["src/content/loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/*", "src/components/*", "src/integrations/target-terminal/*", "src/services/*", "src/storage/*", "src/config.js", "src/docs/*"], "matches": ["https://fomo.family/*"]}], "commands": {"open-side-panel": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open the Paper Terminal side panel"}, "toggle-paper-mode": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Turn the Paper Terminal on FOMO on or off"}}}