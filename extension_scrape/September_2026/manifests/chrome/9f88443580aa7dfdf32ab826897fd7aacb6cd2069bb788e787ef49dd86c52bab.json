{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stylewright", "description": "Write per-site CSS to restyle any website. Injected only when you click Apply. 100% local \u2014 no account, no network, no tracking.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "sidePanel", "unlimitedStorage"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "Stylewright"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"}, "background": {"service_worker": "background.js"}, "content_scripts": []}