{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "key": "", "name": "YouTube Transcript by ToobText", "version": "1.5", "description": "Adds a 'Transcription' panel to YouTube video pages.", "permissions": ["activeTab", "tabs", "identity", "storage"], "host_permissions": ["https://*.youtube.com/*", "https://toobtext.com/*", "https://www.toobtext.com/*", "https://www.googleapis.com/*"], "externally_connectable": {"matches": ["https://toobtext.com/*"]}, "action": {"default_title": "Transcribe with toobtext", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}