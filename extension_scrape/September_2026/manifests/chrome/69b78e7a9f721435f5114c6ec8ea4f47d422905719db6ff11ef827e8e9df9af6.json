{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Captain Tabs", "description": "A full-featured Chrome tab manager with sessions, analytics, and advanced tab organization features.", "version": "2.0.0", "homepage_url": "https://captaintabs.draft2deploy.com", "permissions": ["tabs", "tabGroups", "storage", "sessions", "bookmarks", "alarms"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Captain Tabs", "default_popup": "src/popup.html"}, "options_page": "src/options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Ctrl+Shift+F"}, "description": "Open Captain Tabs"}, "open-search": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Ctrl+Shift+G"}, "description": "Open quick tab search"}, "group-tabs": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Ctrl+Shift+T"}, "description": "Group tabs by domain"}, "remove-duplicates": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Ctrl+Shift+D"}, "description": "Remove duplicate tabs"}}}