{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wawa", "description": "Minimal local export of X/Twitter posts without telemetry.", "version": "1.2.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage", "unlimitedStorage", "downloads", "webRequest"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://video.twimg.com/*"], "action": {"default_title": "Wawa", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["/interceptor.js"], "matches": ["*://*.x.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}