{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chatalog \u2014 Export & Organize AI Chats", "short_name": "Chatalog", "version": "1.0.0", "description": "Bulk-export ChatGPT & Claude chats from open tabs to Markdown/TXT/JSON. Local folders and full-text search over your saved chats.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["scripting", "storage", "downloads", "tabs", "unlimitedStorage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["lib/extract.js", "content.js"], "run_at": "document_idle"}]}