{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Musebox", "short_name": "Musebox", "description": "Access your Musebox.io prompts from any AI service. Paste your prompts into ChatGPT, Claude, Midjourney, and more.", "version": "2.0.5", "action": {"default_title": "Toggle Musebox", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["identity", "storage", "scripting", "activeTab", "sidePanel"], "host_permissions": ["https://*.musebox.io/*", "https://staging.musebox.io/*", "http://localhost:3000/*", "http://localhost:3001/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "options_page": "src/options/index.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; connect-src 'self' https://musebox.io https://*.musebox.io https://staging.musebox.io http://localhost:3000 http://localhost:3001; style-src 'self' 'unsafe-inline'; base-uri 'self'"}, "minimum_chrome_version": "114", "commands": {"toggle-shelf": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle Musebox shelf"}}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["styles.css", "src/panel/index.html", "panel.js", "panel.css", "assets/*"]}]}