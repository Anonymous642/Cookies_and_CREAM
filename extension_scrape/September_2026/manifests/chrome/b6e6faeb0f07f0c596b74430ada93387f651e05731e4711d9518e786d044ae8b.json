{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OhTab", "version": "0.2.0", "description": "Save, search, and restore Chrome tab sessions locally.", "permissions": ["tabs", "storage", "alarms", "contextMenus", "tabGroups"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "OhTab", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"description": "Activate OhTab"}, "display-heytap": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "Display OhTab"}, "save-current-window": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Send all tabs to OhTab"}, "save-all-windows": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Send all tabs from all windows to OhTab"}, "save-current-tab": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Send the current tab to OhTab"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "setting.html"}