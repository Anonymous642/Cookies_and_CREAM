{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CUSIS Calendar Exporter", "version": "0.0.0.5", "description": "Export your CUHK class schedule as an ICS file", "permissions": ["webRequest"], "minimum_chrome_version": "138", "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Visit View My Classes on CUSIS to export", "default_popup": "popup.html"}, "content_scripts": [{"js": ["scripts/content.js"], "matches": ["https://cusis.cuhk.edu.hk/*"], "run_at": "document_end"}]}