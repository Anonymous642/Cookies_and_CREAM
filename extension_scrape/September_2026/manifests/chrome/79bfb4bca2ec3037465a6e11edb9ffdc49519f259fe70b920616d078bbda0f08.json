{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curb Report \u2014 Real Estate Market Intelligence", "version": "0.6.3", "description": "Overlay forecast, crash risk, and value scores on Zillow, Redfin, Realtor.com, and Homes.com. Look past the curb appeal.", "host_permissions": ["https://www.zillow.com/*", "https://www.redfin.com/*", "https://www.realtor.com/*", "https://www.homes.com/*", "https://curb-report.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Curb Report", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.zillow.com/homedetails/*", "https://www.zillow.com/homes/*", "https://www.redfin.com/*/home/*", "https://www.realtor.com/*", "https://www.homes.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://curb-report.com/*"], "js": ["connect-listener.js"], "run_at": "document_start"}], "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}