{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChainGuard", "version": "0.3.0", "description": "Inspect the real TLS certificate chain of every site against your regex patterns; flag matches on the toolbar icon.", "permissions": ["webRequest", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/chrome/background.js", "type": "module"}, "action": {"default_title": "ChainGuard", "default_popup": "src/common/popup/popup.html", "default_icon": {"16": "assets/icons/state-gray-16.png", "32": "assets/icons/state-gray-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open the ChainGuard popup"}, "rescan-page": {"description": "Re-scan (reload) the current page"}, "toggle-mute": {"description": "Mute or un-mute the current site"}, "toggle-skip": {"description": "Skip or resume scanning the current site"}}, "options_ui": {"page": "src/common/options/options.html", "open_in_tab": true}, "icons": {"48": "assets/icons/logo-48.png", "128": "assets/icons/logo-128.png"}, "optional_permissions": ["notifications"]}