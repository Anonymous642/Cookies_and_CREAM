{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Assassin (Auto-Cleanup)", "version": "1.2.2", "description": "Auto-close inactive tabs, keep Chrome fast, whitelist sites, restore tabs, and always one tab per domain. Tab Assassin.", "action": {"default_title": "Tab Assassin", "default_popup": "src/pages/popup.html"}, "options_page": "src/pages/options.html", "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms"], "icons": {"16": "icons/Icon16.png", "48": "icons/Icon48.png", "128": "icons/Icon128.png"}, "web_accessible_resources": [{"matches": ["*://*/*"], "resources": ["icons/*.png", "TabAssassin-logo-light.png", "src/pages/auth-callback.html", "src/pages/success.html", "src/pages/cancel.html"], "use_dynamic_url": false}]}