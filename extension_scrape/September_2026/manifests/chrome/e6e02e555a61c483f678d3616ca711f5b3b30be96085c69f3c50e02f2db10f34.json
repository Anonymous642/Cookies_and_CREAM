{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Solace \u2014 Comfortable Reading", "version": "2.0.0", "description": "Comfortable, accessible reading: dyslexia styling, read-aloud, on-device AI, reader mode, and captions. Free and private.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>", "https://api.dictionaryapi.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Solace \u2014 Comfortable Reading", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/storage.js", "lib/Readability.js", "content/ai.js", "content/dyslexia.js", "content/reader.js", "content/captions.js", "content/ui.js", "content/content.js"], "css": ["content/overlay.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-styling": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle styling on this site"}, "read-aloud": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read aloud / pause"}, "stop-reading": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop reading"}, "reader-mode": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open reader mode"}, "summarize": {"description": "Summarize the page"}}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}]}