{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Semrush Keyword Briefing Automation", "version": "0.1.1", "description": "Collects Semrush and Google SERP data like , PPA, AI Overviews and AI Mode for keyword batches.", "permissions": ["tabs", "scripting", "storage", "downloads", "windows"], "host_permissions": ["https://www.semrush.com/*", "https://*.semrush.com/*", "https://www.google.com/*", "https://*.google.com/*", "http://*/*", "https://*/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.semrush.com/*", "https://*.semrush.com/*"], "js": ["src/content/semrush.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/*", "https://*.google.com/*"], "js": ["src/content/google.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/content/page.js"], "run_at": "document_idle"}]}