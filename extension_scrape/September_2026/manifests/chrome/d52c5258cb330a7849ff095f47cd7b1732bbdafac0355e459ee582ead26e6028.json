{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CursorClarify - AI Text Assistant", "version": "2.1.0", "description": "Summarize, explain, translate, change tone, ask AI & fix grammar on any website with Groq AI. Free & Private.", "permissions": ["clipboardWrite", "storage", "contextMenus"], "host_permissions": ["https://api.groq.com/*"], "commands": {"summarize": {"suggested_key": {"default": "Alt+S"}, "description": "Summarize selected text"}, "grammar-fix": {"suggested_key": {"default": "Alt+G"}, "description": "Fix grammar"}, "translate": {"suggested_key": {"default": "Alt+T"}, "description": "Translate selected text"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "CursorClarify \u2014 Settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}