{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HeyPogo Browser Agent", "version": "0.1.0", "minimum_chrome_version": "120", "description": "Give HeyPogo a task on a website. Watch its actions, control approvals, and stop at any time.", "permissions": ["storage", "tabs", "scripting", "sidePanel", "alarms", "identity"], "host_permissions": [], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+J", "mac": "Alt+J"}, "description": "Open HeyPogo"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "HeyPogo Browser Agent", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"matches": ["http://*/*", "https://*/*"], "resources": ["src/content/index.js"], "use_dynamic_url": false}]}