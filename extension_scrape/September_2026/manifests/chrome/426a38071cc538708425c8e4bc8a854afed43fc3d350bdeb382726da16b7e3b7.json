{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VibeCK", "version": "1.5.0", "description": "Vibe, keyword & mood analysis for X, Facebook and YouTube replies. Works offline. Optional multi-AI.", "icons": {"16": "icons/vibeck-icon-16.png", "32": "icons/vibeck-icon-32.png", "48": "icons/vibeck-icon-48.png", "128": "icons/vibeck-icon-128.png"}, "permissions": ["storage", "webNavigation"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"], "web_accessible_resources": [{"resources": ["icons/*", "welcome.html"], "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"]}], "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://generativelanguage.googleapis.com/*"], "js": ["content_scripts/intercept.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content_scripts/x_injector.js"], "world": "ISOLATED", "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*", "https://facebook.com/*"], "js": ["content_scripts/fb_injector.js"], "world": "ISOLATED", "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"], "js": ["content_scripts/yt_injector.js"], "world": "ISOLATED", "run_at": "document_idle"}]}