{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PinMyTube", "version": "1.1.1", "description": "Pin timestamps on YouTube videos, add notes, and revisit them anytime.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "PinMyTube", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "http://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}