{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Interview Coach for LeetCode", "version": "1.0.0", "description": "AI-powered interview coach that injects a coaching panel into LeetCode problem pages.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*", "https://leetcode.cn/problems/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Toggle the AI Interview Coach panel"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://api.anthropic.com/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://leetcode.com/*"]}]}