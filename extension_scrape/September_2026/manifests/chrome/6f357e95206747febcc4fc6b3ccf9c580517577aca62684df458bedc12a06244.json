{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CHAMPREP", "short_name": "CHAMPREP", "version": "2.0.0", "description": "CHAMPREP AI in a side panel: ask about a page when you choose, approve actions, and capture to Notes, Work and Calendar.", "minimum_chrome_version": "120", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open CHAMPREP", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus", "identity"], "host_permissions": ["https://api.champrep.com/*", "https://cdn.champrep.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "omnibox": {"keyword": "cp"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open CHAMPREP"}, "ask-page": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Ask CHAMPREP AI about this page"}, "save-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the selection to Notes"}}, "storage": {"managed_schema": "managed-schema.json"}, "externally_connectable": {"ids": [], "matches": []}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"}}