{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Relaw Extension", "version": "1.0.1", "description": "A Chrome extension with a side drawer that syncs relaw intake contacts to the current page", "action": {"default_title": "Toggle Chat Drawer"}, "permissions": ["activeTab", "sidePanel", "storage", "cookies"], "host_permissions": ["<all_urls>", "https://app.relaw.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["index.html", "relaw.svg"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"toggle-sidepanel": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Toggle the chat drawer"}}, "oauth2": {"client_id": "${CLERK_CHROME_CLIENT_ID}", "scopes": ["openid", "email", "profile"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}