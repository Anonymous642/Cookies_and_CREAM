{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DropGuard", "version": "1.0.9", "description": "One-click price-drop guards from your SSENSE orders, plus price-drop tracking across supported stores.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "identity", "activeTab", "scripting"], "host_permissions": ["https://www.dropguard.org/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "DropGuard", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.ssense.com/*/account/order-history/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://*.ssense.com/*/product/*", "https://*.farfetch.com/shopping/*", "https://*.farfetch.com/*/shopping/*", "https://*.nike.com/t/*", "https://*.abercrombie.com/shop/*", "https://*.allsaints.com/*", "https://*.on.com/*", "https://*.lululemon.com/p/*", "https://*.arcteryx.com/*", "https://*.gymshark.com/*products/*", "https://*.representclo.com/*products/*"], "js": ["product-nudge.js"], "run_at": "document_idle"}, {"matches": ["https://www.dropguard.org/*", "https://dropguard.org/*"], "js": ["marker.js"], "run_at": "document_start"}]}