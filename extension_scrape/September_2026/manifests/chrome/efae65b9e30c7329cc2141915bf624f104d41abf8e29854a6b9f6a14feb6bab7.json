{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paneglass - ChatGPT Importer", "version": "1.0.0", "description": "Export your ChatGPT conversations directly to Paneglass", "homepage_url": "https://www.paneglass.ai", "permissions": ["activeTab", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://localhost:3000/*", "https://www.paneglass.ai/*", "https://*.paneglass.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["config.js", "content.js"], "run_at": "document_idle"}, {"matches": ["http://localhost:3000/*", "https://www.paneglass.ai/*", "https://*.paneglass.ai/*"], "js": ["config.js", "paneglass-content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["injected.js", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}