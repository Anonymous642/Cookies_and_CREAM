{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DigMyLoop: Crate Digger + BPM & Key Finder", "version": "1.3.2", "description": "BPM, key & Camelot for any YouTube track, then keep digging: similar records, rare finds, stems, Digs & a sample bank.", "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "tabCapture", "offscreen"], "host_permissions": ["*://*.youtube.com/*", "*://*.soundcloud.com/*", "*://*.bandcamp.com/*", "https://digmyloop.com/*", "https://www.digmyloop.com/*", "https://app.digmyloop.com/*", "https://dml-backend-ms7d.onrender.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "DML \u2014 Click to analyze this track", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.soundcloud.com/*"], "js": ["content/soundcloud.js"], "run_at": "document_idle"}, {"matches": ["*://*.bandcamp.com/track/*"], "js": ["content/bandcamp.js"], "run_at": "document_idle"}, {"matches": ["https://digmyloop.com/*", "https://www.digmyloop.com/*", "https://app.digmyloop.com/*"], "js": ["content/digmyloop.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "offscreen/*", "onboarding/onboarding.html", "privacy-policy.html"], "matches": ["<all_urls>"]}]}