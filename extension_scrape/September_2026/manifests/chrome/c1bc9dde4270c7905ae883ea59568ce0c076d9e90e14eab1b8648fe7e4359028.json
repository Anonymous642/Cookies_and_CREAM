{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Get Google Drive Photos/Videos Download Link in 1-click | Import\u014d", "version": "0.1.1", "description": "Click on any photo or video in your Google Drive to instantly download it and/or get its download link.", "action": {"default_popup": "index.html", "default_title": "Click to open popup", "default_icon": {"16": "logos/icon16.png", "32": "logos/icon32.png"}}, "background": {"service_worker": "service-workers/service-workers-google-drive-file-links.js"}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["content_scripts/onGoogleDriveItemClick.js"], "run_at": "document_end"}], "permissions": ["storage", "scripting", "tabs", "downloads"], "host_permissions": ["https://drive.google.com/*", "https://drive.usercontent.google.com/*"], "icons": {"16": "logos/icon16.png", "32": "logos/icon32.png", "48": "logos/icon48.png", "128": "logos/icon128.png"}, "web_accessible_resources": [{"resources": ["logos/icon16.png", "logos/icon32.png", "logos/icon48.png", "logos/icon128.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' https://storage.googleapis.com;"}}