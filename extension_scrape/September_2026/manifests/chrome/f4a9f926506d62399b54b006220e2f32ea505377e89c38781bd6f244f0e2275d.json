{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kosu", "description": "Save pages and links to your mindful Kosu queue.", "version": "0.1.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "host_permissions": ["https://usekosu.com/*"], "externally_connectable": {"matches": ["https://usekosu.com/*"]}, "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"save-to-kosu": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Save the current page to your Kosu queue"}}, "action": {"default_title": "Save to Kosu", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}