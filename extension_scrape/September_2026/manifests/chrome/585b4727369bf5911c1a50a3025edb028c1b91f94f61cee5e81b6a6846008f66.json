{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebCapture - Full Page Screenshot & Scrolling Screen Capture", "version": "1.0.10", "description": "Take full-page scrolling screenshots of any webpage. Annotate, redact, and export to PNG, JPG or PDF. Fast, private, no signup.", "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads", "clipboardWrite", "offscreen", "notifications"], "host_permissions": ["https://webcapture.anhbui.dev/*"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "WebCapture", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_page": "options/options.html", "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Capture visible part"}, "capture-selection": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Capture selection"}, "capture-entire-page": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Capture entire page"}}}