{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unblock \u2014 Right Click & Copy", "version": "0.1.0", "description": "Restore right-click, text selection, copy and common shortcuts on pages that block them. Private and local by design.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "src/popup/index.html", "default_title": "Unblock", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"toggle-unlock": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Unlock the current page"}}, "optional_host_permissions": ["http://*/*", "https://*/*"], "minimum_chrome_version": "111", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}