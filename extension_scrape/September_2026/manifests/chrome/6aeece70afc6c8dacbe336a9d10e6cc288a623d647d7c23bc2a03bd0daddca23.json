{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Limitless Tab Snooze", "version": "1.0.4", "description": "Snooze browser tabs for later \u2014 they land in Limitless Crew Actions and your Profile.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Snooze with Limitless", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://limitlesscrew.com/extension/*", "https://www.limitlesscrew.com/extension/*", "http://localhost:3000/extension/*"], "js": ["content-connect.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "contextMenus", "alarms"], "host_permissions": ["https://limitlesscrew.com/*", "https://www.limitlesscrew.com/*", "http://localhost:3000/*"], "commands": {"snooze-tonight": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Snooze current tab until tomorrow"}}}