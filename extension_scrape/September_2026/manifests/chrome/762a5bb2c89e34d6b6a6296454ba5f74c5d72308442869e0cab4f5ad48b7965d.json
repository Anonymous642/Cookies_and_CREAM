{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clean Link", "version": "1.0.8", "description": "Remove tracking parameters from the current tab and copy the clean link to your clipboard. All locally done, no external API calls.", "action": {"default_title": "Clean Link \u2013 copy without trackers", "default_icon": {"16": "icons/CleanLink_logo_16.png", "32": "icons/CleanLink_logo_32.png"}}, "icons": {"16": "icons/CleanLink_logo_16.png", "32": "icons/CleanLink_logo_32.png", "48": "icons/CleanLink_logo_48.png", "128": "icons/CleanLink_logo_128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}