{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Growfol for LinkedIn", "description": "Comment faster, save posts, and sync LinkedIn analytics with your Growfol account.", "version": "0.1.0", "icons": {"16": "icons/logo-icon.png", "32": "icons/logo-icon.png", "48": "icons/logo-icon.png"}, "permissions": ["storage", "scripting", "activeTab", "webRequest"], "host_permissions": ["https://www.linkedin.com/*", "https://*.linkedin.com/*", "https://growfol.com/*", "http://localhost:6334/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Growfol for LinkedIn", "default_popup": "popup.html", "default_icon": {"16": "icons/logo-icon.png", "32": "icons/logo-icon.png", "48": "icons/logo-icon.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.linkedin.com/*"]}], "options_page": "options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}]}