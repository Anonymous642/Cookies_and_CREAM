{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemoryCrow", "version": "0.1.0", "description": "Save anything you read into your AI's memory, then recall it anywhere.", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "96": "assets/icon.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "action": {"default_popup": "src/popup/index.html", "default_title": "Save to MemoryCrow"}, "commands": {"toggle-clipper": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle the MemoryCrow clipper on this page"}}, "web_accessible_resources": [{"resources": ["assets/icon.png"], "matches": ["<all_urls>"]}], "host_permissions": ["https://api.memorycrow.com/*"], "background": {"service_worker": "background.js", "type": "module"}}