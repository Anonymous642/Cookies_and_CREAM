{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Affify \u2014 Enviar produto", "version": "0.1.1", "description": "Transforme o produto Amazon aberto em um rascunho pronto para revisar no Affify.", "minimum_chrome_version": "116", "homepage_url": "https://affify.app/pt/features#extension", "icons": {"16": "src/assets/icon-16.png", "32": "src/assets/icon-32.png", "48": "src/assets/icon-48.png", "128": "src/assets/icon-128.png"}, "permissions": ["activeTab", "identity", "storage"], "host_permissions": ["https://my.affify.app/*", "https://www.amazon.com/*", "https://www.amazon.com.br/*"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_title": "Enviar para o Affify", "default_popup": "src/popup/popup.html", "default_icon": {"16": "src/assets/icon-16.png", "32": "src/assets/icon-32.png"}}, "options_page": "src/options/options.html", "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.com.br/*"], "js": ["src/shared/amazon-context.js", "src/content/amazon-product.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/assets/icon-48.png"], "matches": ["https://www.amazon.com/*", "https://www.amazon.com.br/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}