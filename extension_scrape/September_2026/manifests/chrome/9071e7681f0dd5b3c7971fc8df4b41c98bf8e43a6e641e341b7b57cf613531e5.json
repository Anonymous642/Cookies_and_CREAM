{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hexpi Product Reviews", "version": "1.4.1", "description": "Import reviews from top e-commerce sites and capture custom HTML selectors directly in your Shopify store with ease.", "default_locale": "en", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "icons": {"34": "icon-34.png", "128": "icon-128.png"}, "externally_connectable": {"matches": ["*://localhost/*", "https://*.ausir.me/*", "https://admin-product-reviews.hexpi.io/*", "https://admin-product-reviews-dev.hexpi.io/*", "https://admin-product-reviews-staging.hexpi.io/*", "https://hexpi-product-reviews-admin.pages.dev/*", "https://*.hexpi-product-reviews-admin.pages.dev/*"]}, "content_scripts": [{"js": ["src/content/index.store.js"], "run_at": "document_idle", "matches": ["https://*.myshopify.com/*"]}, {"js": ["src/content/index.admin.js"], "run_at": "document_idle", "matches": ["https://admin.shopify.com/*"], "all_frames": true, "match_about_blank": true}, {"js": ["src/content/index.import-reviews.js"], "run_at": "document_idle", "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.ru/*", "https://*.aliexpress.us/*", "https://*.aliexpress.com.tr/*"]}], "web_accessible_resources": [{"resources": ["icon-128.png", "icon-34.png"], "matches": ["<all_urls>"]}], "host_permissions": ["https://*.myshopify.com/*", "https://admin.shopify.com/*", "https://*.aliexpress.com/*", "https://*.aliexpress.ru/*", "https://*.aliexpress.us/*", "https://*.aliexpress.com.tr/*"], "permissions": ["tabs", "storage", "scripting"]}