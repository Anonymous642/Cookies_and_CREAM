{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Duo Captions Pro - Legendas Duplas", "version": "10.0", "description": "Aprenda idiomas com legendas duplas em YouTube, Netflix e Amazon Prime. Repeti\u00e7\u00e3o de v\u00eddeo, minera\u00e7\u00e3o de frases e m\u00faltiplos idiomas", "author": "Enoque Leite", "permissions": ["storage", "activeTab", "notifications", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://www.primevideo.com/*", "https://www.amazon.com/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Duo Captions Pro", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-captions": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Ativar/Desativar Legendas"}, "repeat-phrase": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Repetir frase com v\u00eddeo"}, "save-phrase": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Salvar frase"}, "show-history": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Abrir hist\u00f3rico"}}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*", "*://www.netflix.com/watch/*", "*://www.primevideo.com/*", "*://www.amazon.com/gp/video/detail/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://www.youtube.com/*", "*://www.netflix.com/*", "*://www.primevideo.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}