{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClearRead: Reading Help for Dyslexia, ADHD & Focus", "version": "4", "description": "Make any webpage or PDF easier to read. Focus line, read aloud, simpler words and calm layouts for dyslexia, ADHD and tired eyes.", "permissions": ["scripting", "activeTab", "storage", "alarms", "contextMenus", "sidePanel", "webNavigation"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://en.wiktionary.org/*", "https://generativelanguage.googleapis.com/*"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https: http: file: data: blob:; object-src 'self'"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "ClearRead: Smart Reading Assistant for Dyslexia", "default_icon": "icon.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"reading-panel": {"suggested_key": {"default": "Alt+R"}, "description": "Open the reading panel"}, "command-palette": {"suggested_key": {"default": "Alt+S"}, "description": "Open the ClearRead command palette"}, "settings-panel": {"suggested_key": {"default": "Alt+A"}, "description": "Open ClearRead settings"}, "toggle-mode": {"suggested_key": {"default": "Alt+X"}, "description": "Turn ClearRead on or off for this site"}}, "web_accessible_resources": [{"resources": ["icon.png", "pdf-viewer.html", "pdf-reader.html", "tutorial.html", "voice-check.html", "privacy.html", "PRIVACY.md", "fonts/OpenDyslexic-Regular.otf", "fonts/Lexend-Regular.ttf", "fonts/OpenSans-Regular.ttf", "lib/spell/double-metaphone.js", "dict/en.txt", "dict/en-known.txt", "dict/en-bigrams.txt", "dict/en-context.txt", "writer.html"], "matches": ["<all_urls>"]}]}