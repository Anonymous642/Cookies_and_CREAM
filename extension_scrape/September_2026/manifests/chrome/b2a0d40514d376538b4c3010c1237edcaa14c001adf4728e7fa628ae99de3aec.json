{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clad9 Closet Capture", "version": "1.0.0", "description": "Save a product photo from any shopping site into your Clad9 wardrobe closet in one click.", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service_worker.js"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://clad9.com/api/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://clad9.com/account/extension*"], "js": ["content_scripts/pairing.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}