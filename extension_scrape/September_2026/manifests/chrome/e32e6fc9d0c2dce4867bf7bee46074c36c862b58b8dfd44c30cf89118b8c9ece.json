{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Steam GG.deals price panel", "version": "1.0.1", "description": "Adds a price panel to Steam store pages, showing prices from GG.deals.", "author": "Krzysztof Fedorowicz <krzysztof@fedorowicz.email>", "homepage_url": "https://fedorowicz.dev/", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "tabs"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*", "https://store.steampowered.com/agecheck/app/*"], "js": ["src/i18n.js", "src/custom-messages.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "host_permissions": ["https://store.steampowered.com/*", "https://api.gg.deals/*"], "action": {"default_title": "Steam GG.deals price panel", "default_popup": "src/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "minimum_chrome_version": "114", "web_accessible_resources": [{"resources": ["src/locales/*.json"], "matches": ["https://store.steampowered.com/*"]}]}