{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AllReads \u2014 Text to speech & read it later", "version": "1.1.1", "description": "Listen to any web page, PDF, or article in natural sounding voices. Save what you find to read or hear later.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "AllReads", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://allreads.net/*"], "js": ["sidebar.js"], "run_at": "document_idle"}, {"matches": ["https://allreads.net/*"], "js": ["announce.js"], "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["shared/save-button.js", "x-inject.js"], "css": ["x-inject.css"], "run_at": "document_idle"}, {"matches": ["https://substack.com/*", "https://*.substack.com/*"], "js": ["shared/save-button.js", "substack-inject.js"], "css": ["substack-inject.css"], "run_at": "document_idle"}, {"matches": ["https://news.ycombinator.com/*"], "js": ["shared/save-button.js", "hn-inject.js"], "css": ["hn-inject.css"], "run_at": "document_end"}, {"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*", "https://np.reddit.com/*"], "js": ["shared/save-button.js", "reddit-inject.js"], "css": ["reddit-inject.css"], "run_at": "document_start"}, {"matches": ["https://www.indiehackers.com/*", "https://indiehackers.com/*"], "js": ["shared/save-button.js", "ih-inject.js"], "css": ["ih-inject.css"], "run_at": "document_end"}], "commands": {"save-page": {"suggested_key": {"d