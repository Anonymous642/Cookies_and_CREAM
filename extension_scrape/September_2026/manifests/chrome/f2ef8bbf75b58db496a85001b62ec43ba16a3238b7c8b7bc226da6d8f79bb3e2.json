{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Talentum - LinkedIn Profile Analyzer (Side Panel)", "version": "1.0.2", "description": "Analiza perfiles con un click: resumen profesional, habilidades destacadas, perfiles similares, entre otras", "permissions": ["tabs", "sidePanel"], "host_permissions": ["https://www.linkedin.com/*", "https://api-extension.production.talentum.chat/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"128": "public/vector-logo.png"}, "action": {"default_title": "Abrir Side Panel de Talentum", "default_icon": {"128": "public/vector-logo.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["sidepanel.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker.js"}}