{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Translator", "version": "0.1.3", "description": "Bulk-upload Salesforce translations from Excel. Validated per row, deployed in one click.", "permissions": ["cookies", "storage"], "host_permissions": ["https://*.salesforce.com/*", "https://*.salesforce-setup.com/*", "https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.my.salesforce-setup.com/*", "https://*.lightning.force.com/*", "https://*.cloudforce.com/*", "https://*.visualforce.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://*.lightning.force.com/*", "https://*.salesforce.com/*"], "exclude_matches": ["https://login.salesforce.com/*", "https://test.salesforce.com/*", "https://*.salesforce.com/_ui/common/apex/debug/*", "https://*.lightning.force.com/_ui/common/apex/debug/*", "https://*.lightning.force.com/lightning/setup/*"], "js": ["src/launcher.js"], "css": ["src/launcher.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["app.html", "src/app.js", "src/app.css", "src/zip.js", "src/xlsx.js", "src/picklists.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "Salesforce Translator"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}