{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtio", "version": "1.0.2", "description": "Optimize YouTube Studio titles, descriptions, tags and thumbnails with AI. Requires a Youtio account.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Youtio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "cookies"], "host_permissions": ["https://studio.youtube.com/*", "https://www.youtube.com/*", "https://yt3.ggpht.com/*", "https://*.ggpht.com/*", "https://i.ytimg.com/*", "https://yteklentiai.vercel.app/*", "https://youtio.com/*", "https://www.youtio.com/*"], "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}, "homepage_url": "https://youtio.com"}