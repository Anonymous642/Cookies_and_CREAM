{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Copy Current URL", "description": "Copies the current URL to the clipboard (default shortcut: Ctrl+Shift+V or Shift+Command+V on Mac)", "version": "0.0.0.1", "manifest_version": 3, "action": {"default_icon": {"16": "images/copy16.png", "32": "images/copy32.png", "48": "images/copy48.png"}}, "icons": {"128": "images/copy128.png"}, "permissions": ["activeTab", "scripting"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Shift+Command+V"}}}, "background": {"service_worker": "background.js"}}