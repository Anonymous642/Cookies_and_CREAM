{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptHulk - Prompt Optimizer", "short_name": "PromptHulk", "version": "0.4.0", "description": "Write clearer prompts inside ChatGPT, Claude, Gemini, and Perplexity.", "minimum_chrome_version": "109", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://api.duckduckgo.com/*", "https://news.google.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Open PromptHulk", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "commands": {"open-prompthulk": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Option+Shift+P"}, "description": "Open PromptHulk on a supported AI assistant"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "css": ["src/content/content.css"], "js": ["src/shared/ai-sites.js", "src/shared/prompt-engine.js", "src/shared/trending-prompts.js", "src/content/content.js"], "run_at": "document_idle"}]}