{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FairSkip Ad Blocker for YouTube", "short_name": "FairSkip", "version": "0.4.0", "description": "Blocks video ads, banners, overlays, and promoted posts on YouTube with one simple on/off switch.", "minimum_chrome_version": "120", "permissions": ["storage", "declarativeNetRequest", "scripting"], "host_permissions": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "FairSkip", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["src/shared.js", "src/engine.js", "src/content.js"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "fairskip-youtube-ads", "enabled": false, "path": "rules/youtube-ads.json"}]}}