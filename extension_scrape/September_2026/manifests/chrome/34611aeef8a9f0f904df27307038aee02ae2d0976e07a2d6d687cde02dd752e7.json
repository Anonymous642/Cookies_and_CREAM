{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Notebook Agent", "description": "Autonomous agent for Colab notebooks. Autonomously edits the notebook, runs code, explores data, and more.", "version": "1.1.1", "manifest_version": 3, "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "action": {"default_title": "Start/Stop Notebook Agent", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}}, "permissions": ["scripting", "tabs", "storage", "webNavigation", "identity"], "host_permissions": ["https://colab.research.google.com/*", "https://colab.research.googleusercontent.com/*"], "content_scripts": [{"matches": ["https://colab.research.googleusercontent.com/*outputframe*.html*"], "all_frames": true, "run_at": "document_start", "js": ["content.js"]}, {"matches": ["https://colab.research.googleusercontent.com/*outputframe*.html*"], "all_frames": true, "run_at": "document_idle", "js": ["content_output_watcher.js"]}, {"matches": ["https://colab.research.google.com/*"], "all_frames": false, "run_at": "document_idle", "js": ["thinking_panel.js"]}, {"matches": ["https://colab.research.google.com/*"], "all_frames": false, "run_at": "document_idle", "js": ["content_diff_renderer.js"]}], "background": {"service_worker": "background.js", "type": "module"}}