{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Booklight \u2013 Instant Bookmark Search", "short_name": "Booklight", "description": "Spotlight-style bookmark search. Press a shortcut, fuzzy-find any bookmark, open in tab groups by folder.", "version": "1.0.0", "version_name": "1.0.0", "homepage_url": "https://gitlab.com/OrangeClyde/booklight", "permissions": ["bookmarks", "tabs", "tabGroups", "favicon"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/search/search.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Booklight search"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "offline_enabled": true}