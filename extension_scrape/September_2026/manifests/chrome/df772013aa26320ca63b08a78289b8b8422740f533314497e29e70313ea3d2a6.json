{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Randomly: Weather, Timers, Notes, 400+ Tools", "short_name": "Randomly", "version": "1.2.0", "description": "A weather and clock orb on every page, a 409-tool palette, timers that outlive the tab, notes that autosave. Nothing is uploaded.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "notifications", "contextMenus"], "host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://api.bigdatacloud.net/*", "https://ipwho.is/*"], "background": {"service_worker": "src/background/sw.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/kit.js", "src/content/sky.js", "src/content/panels.js", "src/content/main.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Randomly Companion \u2014 search tools, timers and notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the Randomly tool palette"}, "toggle-orb": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Show or hide the orb on every page"}}, "web_accessible_resources": [{"resources": ["src/content/ui.css", "src/data/tools.json", "icons/*"], "matches": ["http://*/*", "https://*/*"]}]}