{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess.com Custom Pieces & GIF Background", "description": "Customize your chess board on Chess.com with your own images and even animated GIFs! Import new ones or share yours with others.", "version": "1.1.0", "content_security_policy": {"extension_pages": "script-src 'self' ; object-src 'self'"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Chess.com Custom Pieces", "default_icon": "icon.png"}, "permissions": ["storage", "unlimitedStorage"], "content_scripts": [{"matches": ["https://www.chess.com/*"], "all_frames": true, "js": ["shared.js", "content.js"]}]}