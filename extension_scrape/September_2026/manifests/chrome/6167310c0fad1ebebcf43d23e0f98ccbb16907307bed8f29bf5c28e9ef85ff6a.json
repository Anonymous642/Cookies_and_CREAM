{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Snoozify", "description": "A Better Way to Nap Your Tabs.", "version": "1.0.1", "manifest_version": 3, "permissions": ["tabs", "storage", "alarms", "notifications", "contextMenus", "offscreen"], "action": {"default_title": "Snoozify", "default_popup": "popup.html"}, "background": {"service_worker": "service_worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["snoozed.html", "snoozed.js", "settings.html", "settings.js", "offscreen.html", "offscreen.js", "media/beep.mp3"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"snoozify_one_hour": {"description": "Snooze current tab for 1 hour", "suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}}, "snoozify_tonight": {"description": "Snooze current tab for tonight", "suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}}, "snoozify_next_monday_morning": {"description": "Snooze current tab for next Monday morning", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "snoozify_choose_time": {"description": "Open Snoozify picker (choose your own time)", "suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}}}}