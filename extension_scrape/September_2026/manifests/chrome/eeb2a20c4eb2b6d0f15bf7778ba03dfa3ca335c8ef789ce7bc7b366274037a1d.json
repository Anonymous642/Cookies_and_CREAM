{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pomodoro Timer", "description": "A simple Pomodoro timer with manual breaks and long break reminders.", "version": "0.3.0", "permissions": ["alarms", "storage", "notifications", "offscreen", "contextMenus"], "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "Pomodoro Timer", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"start-focus": {"suggested_key": {"default": "Alt+P"}, "description": "Start focus session"}, "start-short-break": {"suggested_key": {"default": "Alt+S"}, "description": "Start short break"}, "start-long-break": {"suggested_key": {"default": "Alt+L"}, "description": "Start long break"}}}