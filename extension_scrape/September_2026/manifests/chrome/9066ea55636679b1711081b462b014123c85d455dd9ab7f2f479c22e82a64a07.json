{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jira IDSpector", "version": "0.1.0", "description": "Click a Jira Cloud field to copy its real ID (customfield_NNNNN). Bulk-copy custom, system, or all fields at once.", "permissions": ["activeTab", "clipboardWrite"], "host_permissions": ["*://*.atlassian.net/*"], "icons": {"16": "src/icons/icon-16.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "src/icons/icon-16.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.atlassian.net/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}