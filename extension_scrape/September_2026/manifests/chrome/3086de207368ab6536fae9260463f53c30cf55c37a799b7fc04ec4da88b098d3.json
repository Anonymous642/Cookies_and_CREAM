{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Price Shark", "version": "1.0.7", "description": "PriceShark hunts down price drops across your favorite stores and helps you save you money. Never pay full price again!", "icons": {"48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "notifications", "cookies"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*"], "js": ["extension-config.js", "content-amazon.js"], "run_at": "document_end"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*"], "js": ["extension-config.js", "content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Price Shark", "default_icon": {"128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["extension-config.js"], "matches": ["<all_urls>"]}]}