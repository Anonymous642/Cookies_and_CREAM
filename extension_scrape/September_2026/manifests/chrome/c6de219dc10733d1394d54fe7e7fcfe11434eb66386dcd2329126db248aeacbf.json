{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "114", "name": "Redimates", "version": "0.3.0", "description": "Reads the sub's rules, the post, and the comments \u2014 then writes your reply in the sub's voice. Free 10 replies/week.", "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*", "https://redimates.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*"], "js": ["content.js", "content/anchors.js", "content/i18n.js", "content/heuristics.js", "content/reddit-context.js", "content/templates.js", "content/tracker.js", "content/inject-summary.js", "content/inject-ai-btn.js", "content/inject-microlink.js", "content/inline-entry.js"], "css": ["content/inline.css"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_title": "Open Redimates"}, "side_panel": {"default_path": "sidepanel/index.html"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["config.js", "utils/*.js", "content/inline.css"], "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*"]}]}