{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapTall \u2014 Full Page Screenshot & Screen Capture", "version": "1.0.0", "description": "Full-page, region, and visible-area screenshots with a full annotation editor, searchable history, and one-click export.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "downloads", "contextMenus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Capture selected region"}}, "web_accessible_resources": [{"resources": ["editor/*", "lib/*", "icons/*"], "matches": ["<all_urls>"]}]}