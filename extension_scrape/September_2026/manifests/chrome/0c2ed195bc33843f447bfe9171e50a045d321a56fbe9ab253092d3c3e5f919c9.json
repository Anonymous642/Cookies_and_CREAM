{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WordPress Admin Bar Toggle", "version": "1.2", "description": "Toggle the WordPress admin bar visibility with a single click!", "author": "Bart Wiggers", "background": {"service_worker": "lib/main.js"}, "action": {"default_icon": {"24": "img/icon24_grey.png", "48": "img/icon48_grey.png", "128": "img/icon128_grey.png"}, "default_title": "WP Admin Bar Toggle"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Toggle the WordPress admin bar"}}, "content_scripts": [{"matches": ["*://*/*"], "css": ["lib/hide-admin-bar.css"], "js": ["lib/content-script.js"], "run_at": "document_start"}], "icons": {"24": "img/icon24.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["img/icon24.png", "img/icon48.png", "img/icon128.png", "img/icon24_red.png", "img/icon48_red.png", "img/icon128_red.png", "img/icon24_grey.png", "img/icon48_grey.png", "img/icon128_grey.png"], "matches": ["<all_urls>"]}], "short_name": "WP Admin Bar Toggle"}