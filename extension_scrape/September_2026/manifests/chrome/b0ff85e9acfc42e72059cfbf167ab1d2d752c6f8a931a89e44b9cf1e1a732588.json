{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snipedit - Screenshot & Annotate", "version": "1.0.0", "description": "Capture a region, the visible tab or the full page; then annotate with arrows, boxes, text, blur and step numbers!", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["activeTab", "scripting", "tabs"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Snipedit"}, "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture a region"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture the full page"}}, "minimum_chrome_version": "116"}