{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discord & Telegram Popup - Compact Chat Window", "version": "2.0", "description": "Access Discord and Telegram chats in sleek popup windows. Save multi-window setups.", "homepage_url": "https://chromewebstore.google.com/detail/discord-lite-popup-compac/hpmoimiecindclbcjcddicgokacanaho", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "system.display", "sidePanel"], "host_permissions": ["https://discord.com/*", "https://web.telegram.org/*"], "action": {"default_popup": "popup.html", "default_title": "Discord & Telegram Chat Popup", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}, {"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; default-src 'self'; connect-src 'self' https://discord.com https://web.telegram.org; img-src 'self' data: https: http:; frame-src 'none'"}, "web_accessible_resources": [{"resources": ["inject.js", "popup.css"], "matches": ["https://discord.com/*"]}, {"resources": ["inject-telegram.js", "popup.css"], "matches": ["https://web.telegram.org/*"]}]}