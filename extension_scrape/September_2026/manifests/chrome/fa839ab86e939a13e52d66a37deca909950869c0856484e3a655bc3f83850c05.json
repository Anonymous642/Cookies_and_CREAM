{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PlaceCom CRM Assistant", "version": "3.1", "description": "Add LinkedIn leads to your PlaceCom CRM, see who on your team already contacted them, and send templated emails.", "permissions": ["storage", "tabs", "scripting", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_title": "PlaceCom CRM Assistant", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["pair.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["gmail.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"matches": ["https://docs.google.com/spreadsheets/*"], "js": ["sheets.js"], "run_at": "document_idle"}, {"matches": ["https://mailsuite.com/*"], "js": ["mailsuite.js"], "run_at": "document_idle"}], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}