{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SiteWipe", "version": "1.0.1", "description": "One click clears the cache and wipes site cookies \u2014 without logging you out.", "permissions": ["browsingData", "cookies", "storage", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "SiteWipe \u2014 Clear cache for this site", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"clear-current-tab": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Clear This Tab (cache + unprotected cookies)"}, "clear-cache-only": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Clear Cache Only (keep cookies)"}, "clear-everything": {"description": "Clear Everything (no default \u2014 set in Chrome shortcuts)"}}}