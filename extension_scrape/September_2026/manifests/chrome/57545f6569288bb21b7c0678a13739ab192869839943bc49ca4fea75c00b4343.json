{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI WideView - Extension & Customizer for AI", "version": "1.0.1", "description": "Personaliza de forma visual y granular la interfaz de ChatGPT, Claude, Gemini y Copilot (ancho, fuentes, tablas y sidebar).", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://copilot.microsoft.com/*", "*://copilot.cloud.microsoft/*"], "css": ["content_scripts/styles/common.css", "content_scripts/styles/chatgpt.css", "content_scripts/styles/claude.css", "content_scripts/styles/gemini.css", "content_scripts/styles/copilot.css"], "js": ["content_scripts/content.js"], "run_at": "document_start"}], "commands": {"toggle-wide-mode": {"suggested_key": {"default": "Alt+W"}, "description": "Alternar Modo Ancho Completo / Normal"}}}