{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SweepLinks", "short_name": "SweepLinks", "version": "1.0.0", "description": "SweepLinks - Safe Bulk Link Opener. Select links on a page and safely open, copy, or bookmark them - only on sites you allow.", "action": {"default_title": "SweepLinks", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "activeTab", "bookmarks"], "optional_host_permissions": ["http://*/*", "https://*/*"], "commands": {"toggle-selection-mode": {"description": "Toggle SweepLinks selection mode on enabled site", "suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}}}}