{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrawlCheck \u2013 AI Crawler & SEO Checker", "version": "1.0.2", "description": "AI crawler & SEO checker: what GPTBot, ClaudeBot, Perplexity and Googlebot get from your site. robots.txt, llms.txt, schema, vitals.", "permissions": ["declarativeNetRequest", "activeTab", "scripting", "storage", "contextMenus", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "CrawlCheck", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "minimum_chrome_version": "121", "web_accessible_resources": [{"resources": ["probe-page.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.bing.com/search*", "*://duckduckgo.com/*", "*://*.google.co.uk/search*"], "js": ["serp.js"], "run_at": "document_idle"}], "commands": {"toggle-hud": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Show what a crawler receives from this page"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}