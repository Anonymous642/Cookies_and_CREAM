{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Eggcellent - Recipe Converter", "version": "1.8.1", "description": "Convert YouTube, Facebook, Instagram videos and recipe websites into formatted recipes. Save and sync.", "homepage_url": "https://eggcellent.io/privacy", "permissions": ["activeTab", "storage", "sidePanel", "tabs", "scripting", "identity", "downloads"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.instagram.com/*", "https://instagram.com/*"], "background": {"service_worker": "scripts/background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Eggcellent - Recipe Converter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup/popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.instagram.com/*", "https://instagram.com/*"], "js": ["scripts/content.js"], "css": ["scripts/content.css"]}, {"matches": ["http://localhost:3000/*", "https://eggcellent.io/*", "https://www.eggcellent.io/*"], "js": ["scripts/content-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["popup/*", "icons/*", "images/*", "welcome/*", "callback.html"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://eggcellent.io/*", "https://www.eggcellent.io/*"], "ids": ["*"]}}