{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slopstop", "version": "1.0", "description": "Automatically disable AI-generated answers in Google Search", "permissions": ["scripting", "webNavigation", "storage"], "host_permissions": ["https://www.google.com/*", "https://www.google.co.uk/*", "https://www.google.de/*", "https://www.google.fr/*", "https://www.google.it/*", "https://www.google.es/*", "https://www.google.ca/*", "https://www.google.au/*", "https://www.google.jp/*", "https://duckduckgo.com/*"], "action": {"default_popup": "popup.html", "default_title": "Disable AI Search Answers"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.co.uk/search*", "https://www.google.de/search*", "https://www.google.fr/search*", "https://www.google.it/search*", "https://www.google.es/search*", "https://www.google.ca/search*", "https://www.google.au/search*", "https://www.google.jp/search*", "https://www.google.com/*", "https://duckduckgo.com/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}