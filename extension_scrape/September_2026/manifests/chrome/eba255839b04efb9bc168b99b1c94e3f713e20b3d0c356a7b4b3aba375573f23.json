{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "miClip - The Minimalist Web Clipper", "version": "1.0.2", "description": "miClip is a plain-text web clipper for focused reading and clean note-taking.", "permissions": ["storage", "activeTab", "contextMenus"], "action": {"default_popup": "index.html", "default_icon": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"_execute_action": {"suggested_key": {"mac": "Command+Shift+Y", "windows": "Ctrl+Shift+Y"}}, "trigger-clip": {"description": "Save selected text to miClip", "suggested_key": {"mac": "Command+Shift+K", "windows": "Ctrl+Shift+K"}}}, "background": {"service_worker": "background.js"}}