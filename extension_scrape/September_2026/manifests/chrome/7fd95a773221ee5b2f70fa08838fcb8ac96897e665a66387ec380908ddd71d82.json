{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabCtrl", "version": "2.2.0", "description": "TabCtrl is an agentic browser extension. Bring your own API keys. Chain multiple models with different capabilities.", "minimum_chrome_version": "118", "action": {"default_title": "Open TabCtrl (Ctrl+E)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'none'; media-src 'self' data:"}, "side_panel": {"default_path": "src/sidepanel.html"}, "options_page": "src/options.html", "commands": {"toggle-side-panel": {"description": "Toggle TabCtrl side panel", "suggested_key": {"default": "Ctrl+E", "mac": "Command+E"}}}, "permissions": ["activeTab", "scripting", "tabs", "tabGroups", "storage", "sidePanel", "webNavigation", "declarativeNetRequest", "unlimitedStorage", "alarms", "notifications", "offscreen", "debugger", "nativeMessaging"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/ax-tree.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["src/click-safety.js", "src/content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["src/visual-indicator.js"], "run_at": "document_idle", "all_frames": false}]}