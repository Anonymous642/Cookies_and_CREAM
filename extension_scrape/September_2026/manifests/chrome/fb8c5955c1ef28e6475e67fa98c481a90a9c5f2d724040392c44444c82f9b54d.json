{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AlgoVault", "description": "Safely sync accepted coding challenge solutions to a selected GitHub repository", "homepage_url": "https://github.com/vikas-kushwaha-dev/algovault-extension", "version": "0.1.1", "author": "Vikas Kushwaha", "action": {"default_icon": {"16": "assets/algovault-16.png", "32": "assets/algovault-32.png", "48": "assets/algovault-48.png", "128": "assets/algovault-128.png"}, "default_popup": "popup.html", "default_title": "Sync coding solutions to GitHub"}, "icons": {"16": "assets/algovault-16.png", "32": "assets/algovault-32.png", "48": "assets/algovault-48.png", "128": "assets/algovault-128.png"}, "background": {"service_worker": "scripts/background.js"}, "permissions": ["storage", "webNavigation"], "optional_host_permissions": ["https://api.github.com/*"], "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["scripts/leetcode.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}