{"update_url": "https://clients2.google.com/service/update2/crx", "description": "A chrome extension for working with TikTok on chrome side panel", "version": "1.0.2", "manifest_version": 3, "name": "sidetok", "minimum_chrome_version": "101", "permissions": ["sidePanel", "declarativeNetRequest"], "side_panel": {"default_path": "copy/content-sidebar.html"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "copy/rules_1.json"}]}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.bundle.js"}, "action": {"default_popup": "", "default_icon": "icon-34.png"}, "icons": {"128": "icon-128.png"}, "content_scripts": [{"matches": ["https://*.tiktok.com/*"], "js": ["copy/content.js"], "run_at": "document_start", "all_frames": true}], "commands": {"open-sidebar": {"suggested_key": {"default": "Alt+E", "linux": "Alt+E", "windows": "Alt+E", "mac": "Command+E"}, "description": "Open Sidebar"}}, "web_accessible_resources": [{"resources": ["*"], "matches": ["<all_urls>"]}]}