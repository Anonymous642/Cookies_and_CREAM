{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InfoFi Reply Assistant", "version": "1.1.0", "description": "A productivity tool that highlights specific posts on X (Twitter) and assists with quick reply text templates.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["*://*.twitter.com/*", "*://x.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://x.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}