{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Keytastic", "version": "1.0.8", "description": "Save time on LinkedIn\u2014access your snippets instantly in Inbox, Sales Nav, Comments & Replies with keytastic.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.linkedin.com/*", "https://mail.google.com/*", "https://app.keytastic.io/*", "https://app-dev.keytastic.io/*"]}], "externally_connectable": {"matches": ["https://app-dev.keytastic.io/*", "https://app.keytastic.io/*"]}, "host_permissions": ["https://www.linkedin.com/*", "https://mail.google.com/*", "https://app.keytastic.io/*", "https://app-dev.keytastic.io/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://mail.google.com/*", "https://app.keytastic.io/*", "https://app-dev.keytastic.io/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}