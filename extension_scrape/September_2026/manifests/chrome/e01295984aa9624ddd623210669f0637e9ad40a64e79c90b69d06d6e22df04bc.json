{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OnSIP Call Assistant", "description": "OnSIP customers can maximize workday efficiency with click-to-call, caller ID popups, and Zendesk integration.", "version": "2.0.4", "action": {"default_icon": "images/icon-19.png"}, "icons": {"16": "images/icon-16.png", "19": "images/icon-19.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "web_accessible_resources": [{"resources": ["images/icon-phone.png"], "matches": ["*://*/*"]}], "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["css/content_page.css"]}], "content_security_policy": {"extension_pages": "default-src 'self'; connect-src https: wss:; img-src *; script-src 'self'"}, "externally_connectable": {"matches": ["*://*.onsip.com/*", "*://*.zendesk.com/*", "*://*/*"]}, "permissions": ["webRequest", "notifications", "tabs", "storage", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "html/options.html"}