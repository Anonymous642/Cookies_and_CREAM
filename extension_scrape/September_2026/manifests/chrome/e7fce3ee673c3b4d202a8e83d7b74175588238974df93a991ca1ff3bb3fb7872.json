{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TabShab \u2013 Search Through 100+ Tabs Instantly", "description": "Easily Search and Organize Tabs, the best tool for Tab Management, enhancing your productivity and saving time.", "version": "1.1.1", "manifest_version": 3, "icons": {"16": "images/icon-16.png", "128": "images/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"32": "images/icon-32.png", "64": "images/icon-64.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1", "chromeos": "Ctrl+Shift+1", "linux": "Ctrl+Shift+1"}, "description": "Open Search"}}, "content_scripts": [{"matches": ["https://tabshab.com/*"], "js": ["content.js"]}], "permissions": ["tabs", "bookmarks", "storage", "sidePanel", "windows"], "side_panel": {"default_path": "popup/popup.html"}, "host_permissions": ["https://tabshab.com/*"], "externally_connectable": {"matches": ["https://tabshab.com/*"]}}