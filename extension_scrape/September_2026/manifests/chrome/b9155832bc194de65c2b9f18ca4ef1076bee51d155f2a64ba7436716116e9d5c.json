{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpoilerCub \u2013 YouTube Spoiler Blocker for Movies, Shows & Games", "version": "1.1.3", "description": "Block YouTube videos containing spoilers for games, movies, or shows you specify", "author": "Nikola Arbov", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["extpay-error-suppress.js", "extpay.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["thumbnail.jpg", "spoiler_short.png", "icon128.png"], "matches": ["https://www.youtube.com/*"]}]}