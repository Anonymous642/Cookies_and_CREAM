{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BreakTask", "version": "1.0", "description": "Transform your new tab into a Windows-style task manager. Break down tasks into subtasks with drag-and-drop organization.", "author": "Naman Monga", "homepage_url": "https://github.com/Naman-Monga/breaktask", "permissions": ["storage", "topSites"], "host_permissions": ["https://www.google.com/s2/*"], "chrome_url_overrides": {"newtab": "index.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["main.js", "*.js", "*.css", "assets/*", "backgrounds/config.json", "backgrounds/*.jpg", "backgrounds/*.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}