{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SortIt \u2013 Automatic Download Organizer", "short_name": "SortIt", "description": "Automatically organize your downloads into folders by file type and custom rules. Keep your Downloads folder clean with zero setup.", "version": "1.2.0", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon18.png", "32": "icons/icon48.png"}}, "icons": {"16": "icons/icon18.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "downloads.open", "storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}