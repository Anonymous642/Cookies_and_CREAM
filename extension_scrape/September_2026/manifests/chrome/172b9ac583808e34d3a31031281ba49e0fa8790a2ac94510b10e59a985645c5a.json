{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Mover", "version": "1.0.0", "description": "Move tabs to named windows using keyboard shortcuts", "permissions": ["tabs", "storage", "commands"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"move-to-window-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Move tab to window 1"}, "move-to-window-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Move tab to window 2"}, "move-to-window-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Move tab to window 3"}, "move-to-window-4": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Command+Shift+4"}, "description": "Move tab to window 4"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}