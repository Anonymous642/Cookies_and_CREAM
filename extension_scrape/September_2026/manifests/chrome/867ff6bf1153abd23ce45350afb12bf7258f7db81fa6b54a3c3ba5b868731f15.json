{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curiosa Edit Mode", "version": "1.0.0", "description": "Edit search and filter results from curiosa.io/cards: drag and drop, sort by threshold, and remove individual cards.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://curiosa.io/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle Curiosa Edit Mode", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://curiosa.io/*"], "js": ["cards-data.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}