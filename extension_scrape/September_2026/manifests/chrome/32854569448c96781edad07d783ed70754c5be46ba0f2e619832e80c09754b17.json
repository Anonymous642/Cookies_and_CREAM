{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrandSnap \u2014 Screenshot to Social Post", "short_name": "BrandSnap", "version": "1.0.0", "description": "Capture any screenshot and turn it into a branded, social-ready image in 1-Click. Gradients, watermarks \u2014 no Canva needed.", "author": "BrandSnap", "minimum_chrome_version": "114", "action": {"default_title": "BrandSnap \u2014 capture & post", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["activeTab", "tabs", "storage", "scripting", "downloads", "clipboardWrite", "offscreen", "notifications"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Capture visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Capture a region"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Capture an element"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Capture full page"}}, "web_accessible_resources": [{"resources": ["editor/editor.html", "settings/settings.html", "offscreen/offscreen.html", "content/content.css"], "matches": ["<all_urls>"]}]}