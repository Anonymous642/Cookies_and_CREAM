{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuizFeast Study Helper", "version": "1.2.0", "description": "Turn any page, PDF or Word file into flashcards. Every card shows the sentence it came from, so you can check it yourself.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://quizfeast.com/*"], "action": {"default_popup": "popup.html", "default_title": "Make flashcards from this page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://quizfeast.com/create*"], "js": ["bridge.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}