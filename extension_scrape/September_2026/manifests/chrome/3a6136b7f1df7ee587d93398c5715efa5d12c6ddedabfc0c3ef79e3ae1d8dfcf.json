{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Job Saver", "version": "1.1.0", "description": "Local job tracker side panel for LinkedIn + Indeed (with floating Save button and resume attach).", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://www.linkedin.com/*", "https://www.indeed.com/*", "https://*.indeed.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Job Saver"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content/linkedin.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.indeed.com/*", "https://*.indeed.com/*"], "js": ["src/content/indeed.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}