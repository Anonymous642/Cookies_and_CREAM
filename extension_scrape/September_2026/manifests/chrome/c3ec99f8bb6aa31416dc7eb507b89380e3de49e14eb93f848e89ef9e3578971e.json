{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Templates for Gemini and ChatGPT", "version": "1.0.1", "description": "A Chrome Extension for managing and launching templates into Gemini and ChatGPT interfaces", "permissions": ["storage", "activeTab", "sidePanel"], "host_permissions": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*"], "commands": {"open-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Open Template Launcher"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}}, "action": {"default_title": "Template Launcher", "default_icon": {"16": "icons/kite-circle.png", "32": "icons/kite-circle.png", "48": "icons/kite-circle.png", "128": "icons/kite-circle.png"}}, "icons": {"16": "icons/kite-circle.png", "32": "icons/kite-circle.png", "48": "icons/kite-circle.png", "128": "icons/kite-circle.png"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "background": {"service_worker": "src/background/service.js", "type": "module"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/content/contentScript.js"], "run_at": "document_end"}]}