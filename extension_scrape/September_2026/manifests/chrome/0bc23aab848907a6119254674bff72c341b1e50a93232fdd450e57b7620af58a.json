{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VidMute Master", "version": "1.0.2", "description": "Stop videos from playing with sound. Automatically starts videos silently and remembers your preferences.", "author": "NestDev LLC", "permissions": ["storage", "activeTab"], "optional_host_permissions": ["*://*/*"], "action": {"default_popup": "popup.html", "default_title": "VidMute Master - Control video sound", "default_icon": "icons/volume-cross-48.png"}, "icons": {"16": "icons/volume-cross-16.png", "32": "icons/volume-cross-32.png", "48": "icons/volume-cross-48.png", "128": "icons/volume-cross-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "minimum_chrome_version": "88", "short_name": "VidMuteMaster", "commands": {"toggle-automute": {"suggested_key": {"default": "Alt+Shift+Space"}, "description": "Turn video auto-mute on or off"}, "reset-preferences": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Clear my sound preferences"}, "mute-all": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Turn off sound for all videos"}, "unmute-all": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Turn on sound for all videos"}}}