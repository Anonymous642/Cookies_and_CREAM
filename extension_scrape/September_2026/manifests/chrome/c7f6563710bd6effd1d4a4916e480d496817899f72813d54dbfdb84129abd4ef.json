{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ViralWiz \u2014 Import & publish videos", "short_name": "ViralWiz", "version": "1.1.0", "description": "Import videos from YouTube/TikTok/Instagram and publish your edits directly to your YouTube channel, no API quotas needed.", "permissions": ["storage", "cookies", "tabs"], "host_permissions": ["https://viralwiz.co/*", "https://*.viralwiz.co/*", "https://*.youtube.com/*", "https://youtube.com/*", "https://studio.youtube.com/*", "https://*.tiktok.com/*", "https://tiktok.com/*", "https://*.instagram.com/*", "https://instagram.com/*", "https://*.r2.dev/*", "https://*.r2.cloudflarestorage.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/watch*", "https://*.youtube.com/shorts/*", "https://*.tiktok.com/@*/video/*", "https://*.instagram.com/reel/*", "https://*.instagram.com/p/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://viralwiz.co/dashboard/*", "https://viralwiz.co/dashboard"], "js": ["content-vw.js"], "run_at": "document_idle"}, {"matches": ["https://studio.youtube.com/*"], "js": ["content-upload.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://viralwiz.co/*", "https://*.viralwiz.co/*"]}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}