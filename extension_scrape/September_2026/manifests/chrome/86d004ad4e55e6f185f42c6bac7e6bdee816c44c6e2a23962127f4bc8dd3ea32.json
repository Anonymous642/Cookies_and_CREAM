{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dynamic Web Panel", "version": "2.0", "description": "Configure a custom link and icon to open in Chrome's side panel or a custom-sized floating popup window.", "options_page": "options.html", "permissions": ["storage", "sidePanel", "contextMenus", "declarativeNetRequest", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_icon": "icon.png", "default_title": "Open Dynamic Web Panel"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["theme-watcher.js"], "run_at": "document_start"}]}