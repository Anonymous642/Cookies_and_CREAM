{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save ChatGPT & Claude Snippets \u2014 LassoSnap", "version": "1.0.3", "description": "Capture AI conversation snippets, organize by topic, summarize with AI, push to Obsidian or Notion.", "permissions": ["storage", "unlimitedStorage", "sidePanel", "activeTab", "alarms", "identity", "contextMenus"], "host_permissions": ["https://www.googleapis.com/drive/*", "https://www.googleapis.com/upload/drive/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://api.byzanx.com/*"], "externally_connectable": {"matches": ["https://byzanx.com/*"]}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "js": ["src/content/index.js"]}], "side_panel": {"default_path": "src/sidepanel/index.html"}, "action": {"default_title": "LassoSnap", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open LassoSnap Side Panel"}, "toggle-quick-paste": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Toggle Quick Paste panel"}, "save-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the selected text to LassoSnap"}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}