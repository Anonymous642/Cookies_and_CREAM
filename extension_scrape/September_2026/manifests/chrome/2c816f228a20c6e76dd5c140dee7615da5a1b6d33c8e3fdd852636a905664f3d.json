{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Vault \u2014 Session Manager & Backup", "version": "1.1.0", "description": "Never lose a tab again. Auto-backs up your tabs on a timer, with one-click restore and export. 100% local & private.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tab Vault"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["tabs", "storage", "alarms", "unlimitedStorage", "downloads"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["lib/ExtPay.js"]}]}