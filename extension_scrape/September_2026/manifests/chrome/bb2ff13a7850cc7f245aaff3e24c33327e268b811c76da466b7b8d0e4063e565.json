{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Backtrack: AI History Search - Find Any Page You Read, On-Device", "version": "1.0.0", "description": "Search your browser history by meaning with on-device AI. Find any page you've read, even if you forgot its title or exact words.", "permissions": ["offscreen"], "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Backtrack"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.bundle.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["wasm/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}