{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Flusk For Chrome", "version": "1.0.0", "description": "Chrome extension to integrate flusk's services to Bubble.io", "manifest_version": 3, "author": "Fusk", "minimum_chrome_version": "101", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": "icons/icon.png", "default_popup": "popup.html", "default_title": "Flusk For Chrome"}, "background": {"service_worker": "src/js/service_worker.js"}, "host_permissions": ["https://bubble.io/page?name=*", "https://bubble.io/page?type=*", "https://app.flusk.eu/version-test/chrome_deploy*"], "content_scripts": [{"matches": ["https://bubble.io/page?name=*", "https://bubble.io/page?type=*"], "js": ["src/js/injection.js"], "css": ["src/css/injection.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["src/html/frame.html", "src/img/*"], "matches": ["<all_urls>"]}], "permissions": ["tabs", "declarativeNetRequestWithHostAccess"]}