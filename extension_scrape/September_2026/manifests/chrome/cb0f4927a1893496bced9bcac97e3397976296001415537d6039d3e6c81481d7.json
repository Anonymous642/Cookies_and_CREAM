{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AniDeck \u2014 Spoiler Shield, Stats & Episode Companion", "version": "1.3.0", "description": "Blur anime spoilers past your episode, see your stats as a shareable card, and get cast and discussion beside what you watch.", "minimum_chrome_version": "114", "action": {"default_title": "Open AniDeck"}, "side_panel": {"default_path": "panel/panel.html"}, "background": {"service_worker": "sw.js", "type": "module"}, "permissions": ["sidePanel", "storage"], "host_permissions": ["https://graphql.anilist.co/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}, "commands": {"toggle-shield": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Turn the spoiler shield on or off"}}, "content_scripts": [{"matches": ["https://www.crunchyroll.com/*", "https://beta.crunchyroll.com/*"], "js": ["content/cr.js"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*"], "js": ["lib/match.js", "content/shield.js"], "css": ["content/shield.css"], "run_at": "document_idle", "all_frames": false}], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}