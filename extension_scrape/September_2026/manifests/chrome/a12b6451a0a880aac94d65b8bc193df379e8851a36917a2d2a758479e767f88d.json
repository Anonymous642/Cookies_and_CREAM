{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dyslexia Assist Suite", "version": "1.0.0", "description": "Reading toolkit for dyslexia: text-to-speech, bionic reading, reader mode, font/spacing/overlay tools, and a dyslexia simulator.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>", "file://*/*"], "commands": {"toggle-simulation": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle dyslexia simulation"}}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>", "file://*/*"], "js": ["assets/content.js"], "css": ["assets/content.css"], "all_frames": true, "match_about_blank": true}], "background": {"service_worker": "src/background/background.js", "type": "module"}}