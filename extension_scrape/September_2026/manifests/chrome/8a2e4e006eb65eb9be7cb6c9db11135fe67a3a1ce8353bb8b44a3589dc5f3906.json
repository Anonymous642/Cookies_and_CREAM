{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextGenieAI: AI Writing Assistant", "version": "0.2.1", "description": "Write, rewrite, summarize, translate, and reply with AI on any webpage\u2014without breaking your flow.", "default_locale": "en", "permissions": ["storage", "contextMenus", "activeTab", "commands", "sidePanel", "tabs"], "host_permissions": ["https://textgenieai.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "icons": {"16": "icons/textgenie-16.png", "32": "icons/textgenie-32.png", "48": "icons/textgenie-64.png", "128": "icons/textgenie-128.png"}, "action": {"default_title": "Open TextGenieAI", "default_popup": "popup.html", "default_icon": {"16": "icons/textgenie-16.png", "32": "icons/textgenie-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open-textgenie": {"suggested_key": {"default": "Alt+Shift+G", "mac": "MacCtrl+Shift+G"}, "description": "Open TextGenieAI"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}