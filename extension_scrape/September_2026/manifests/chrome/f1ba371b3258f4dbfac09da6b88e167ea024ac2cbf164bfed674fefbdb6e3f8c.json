{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook to FBI Quick Tip Reporter", "author": "JT Brunner", "homepage_url": "https://github.com/HeiligKuh", "version": "1.0.5", "description": "Efficiently report posts to the FBI.", "permissions": ["activeTab", "scripting"], "action": {"default_title": "Facebook to FBI Quick Tip Reporter", "default_popup": "popup.html", "default_icon": {"48": "images/icon48.png", "72": "images/icon72.png", "96": "images/icon96.png", "128": "images/icon128.png", "144": "images/icon144.png", "192": "images/icon192.png", "512": "images/icon512.png", "1024": "images/icon1024.png"}}, "icons": {"48": "images/icon48.png", "72": "images/icon72.png", "96": "images/icon96.png", "128": "images/icon128.png", "144": "images/icon144.png", "192": "images/icon192.png", "512": "images/icon512.png", "1024": "images/icon1024.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' https://fonts.googleapis.com 'unsafe-inline';"}, "content_scripts": [{"matches": ["*://tips.fbi.gov/*", "*://*.facebook.com/*"], "js": ["popup.js"], "run_at": "document_idle"}], "host_permissions": ["*://*.fbi.gov/*", "*://*.facebook.com/*"]}