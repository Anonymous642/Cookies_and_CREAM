{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JSONPeek - JSON Viewer & Formatter", "description": "Auto-formats JSON in browser tabs with syntax highlighting, collapsible trees, search, and path copying.", "version": "1.0.2", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage"], "commands": {"toggle-format": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Toggle JSON formatting"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}