{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Citation Sleuth", "version": "1.4.1", "description": "See where your AI answers came from. Captures the web sources cited by ChatGPT, Gemini and Perplexity.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://api.dataforseo.com/*", "https://sandbox.dataforseo.com/*"], "action": {"default_title": "Open Citation Sleuth", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["interceptor.js"], "matches": ["https://gemini.google.com/*"]}]}