{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneTabFocus \u2014 Focus Mode, Pomodoro Timer & Tab Manager for Deep Work", "version": "1.1.0", "description": "Focus mode for Chrome that locks one tab and hides the rest. Real Pomodoro timer, tab manager & distraction blocker for deep work.", "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "alarms", "notifications", "offscreen"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "action": {"default_title": "OneTabFocus \u2014 click to open the side panel", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "side_panel": {"default_path": "src/sidebar/sidebar.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["src/locked/locked.html", "src/locked/locked.js", "src/locked/locked.css", "src/break/break.html", "src/break/break.js", "src/break/break.css", "src/heatmap/heatmap.html", "src/heatmap/heatmap.js", "src/heatmap/heatmap.css", "src/onboarding/onboarding.html", "src/onboarding/onboarding.js", "src/onboarding/onboarding.css", "src/shared/theme.css", "assets/sounds/*.wav", "assets/icon-*.png"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://onetabfocus.com/*"]}, "minimum_chrome_version": "114"}