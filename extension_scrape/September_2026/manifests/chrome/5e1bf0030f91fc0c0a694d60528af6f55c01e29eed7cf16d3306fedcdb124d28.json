{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ad Replacer", "version": "3.0.0", "description": "Block ads and replace them with beautiful artwork, NASA photos, museum art, or productivity tools.", "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "contextMenus", "alarms", "sidePanel", "declarativeNetRequest", "declarativeNetRequestFeedback", "scripting", "webNavigation"], "web_accessible_resources": [{"resources": ["assets/*.js", "assets/*.css", "src/sidepanel.html"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "host_permissions": ["http://*/*", "https://*/*"], "declarative_net_request": {"rule_resources": [{"id": "block_ads", "enabled": true, "path": "rules/block_ads.json"}, {"id": "strip_utm", "enabled": true, "path": "rules/strip_utm.json"}]}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icon_16.png", "64": "icon_64.png", "128": "icon_128.png"}}, "side_panel": {"default_path": "src/sidepanel.html"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_start"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Open Ad Replacer popup"}, "toggle-extension": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Toggle Ad Replacer on/off"}, "open-side-panel": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Ad Replacer side panel"}}, "icons": {"16": "icon_16.png", "64": "icon_64.png", "128": "icon_128.png"}}