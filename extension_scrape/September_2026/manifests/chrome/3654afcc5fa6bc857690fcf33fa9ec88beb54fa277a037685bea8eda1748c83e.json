{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GetReplier.AI Email Responder", "version": "1.0.0", "manifest_version": 3, "description": "GetReplier.AI is an AI-powered email browser extension that helps you respond to emails faster.", "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite", "tabs"], "host_permissions": ["https://localhost:3003/*", "https://*.getreplier.ai/*"], "web_accessible_resources": [{"resources": ["commonResponses.json", "content-script.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"generate_response": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Generate AI response suggestion"}}}