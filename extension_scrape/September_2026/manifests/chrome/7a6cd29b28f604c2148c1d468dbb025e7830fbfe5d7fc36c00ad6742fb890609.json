{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Tab Manager - Group & Organize", "version": "1.2.0", "description": "Automatically organize your tabs with AI. Clean up clutter, auto-group related tabs, and boost productivity.", "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "AI Tabs Organizer", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "commands": {"organize-tabs": {"suggested_key": {"default": "Alt+O", "mac": "Alt+O"}, "description": "Organize all tabs with AI"}, "group-current": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Group current tab with similar tabs"}}}