{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouNote - YouTube Note Taker", "version": "1.0.1", "description": "Take timestamped notes while watching YouTube videos. Automatically syncs to YouNote.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://www.younote.dev/*", "https://younote.dev/*", "http://localhost:3000/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "css": ["styles/youtube.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["styles/youtube.css"], "matches": ["https://www.youtube.com/*", "https://youtu.be/*"]}]}