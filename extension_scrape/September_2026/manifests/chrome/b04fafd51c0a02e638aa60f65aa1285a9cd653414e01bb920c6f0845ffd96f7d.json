{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anotely \u2013 Place Notes & Highlights on Any Webpage", "version": "1.0.4", "description": "Add sticky notes, highlights, and annotations to any webpage. Your notes stay exactly where you left them.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"place-note": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Place a new note"}, "search-notes": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Search all notes"}, "toggle-annotation-toolbar": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle annotation toolbar"}, "toggle-right-side-buttons": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle right side action buttons"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}