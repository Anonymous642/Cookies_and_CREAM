{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EnvSwitch \u2014 Developer Environment Switcher", "version": "1.2.0", "description": "Toggle instantly between Localhost, Staging, and Production environments via Side Panel, Popup, or Hotkeys.", "permissions": ["activeTab", "storage", "tabs", "sidePanel", "contextMenus"], "action": {"default_popup": "popup.html", "default_title": "EnvSwitch"}, "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"switch-env-1": {"suggested_key": {"default": "Alt+Shift+1", "mac": "Option+Shift+1"}, "description": "Switch to Local Environment"}, "switch-env-2": {"suggested_key": {"default": "Alt+Shift+2", "mac": "Option+Shift+2"}, "description": "Switch to Staging Environment"}, "switch-env-3": {"suggested_key": {"default": "Alt+Shift+3", "mac": "Option+Shift+3"}, "description": "Switch to Production Environment"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}