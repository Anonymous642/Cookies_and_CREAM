{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "dumdum.fyi real estate price predictor", "version": "0.3.1", "description": "Estimates the eventual sale price of homes on Zillow, Redfin, and Realtor.com using the dumdum.fyi predictor.", "permissions": ["storage"], "host_permissions": ["https://dumdum.fyi/*"], "web_accessible_resources": [{"resources": ["icons/icon16.png"], "matches": ["https://dumdum.fyi/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.zillow.com/*", "https://www.redfin.com/*", "https://www.realtor.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "dumdum.fyi predictor settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}