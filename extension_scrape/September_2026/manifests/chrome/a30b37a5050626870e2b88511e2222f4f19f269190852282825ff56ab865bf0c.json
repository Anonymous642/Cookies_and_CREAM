{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feedback Node", "short_name": "Feedback Node", "version": "1.2.0", "description": "Capture, annotate and comment on any page, then export the review as Markdown with annotated screenshots.", "minimum_chrome_version": "116", "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "clipboardWrite"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_title": "Feedback Node", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"capture-new-issue": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capture the viewport into a new issue"}, "capture-add-current": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Capture the viewport into the current issue"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Show / hide the review panel"}}}