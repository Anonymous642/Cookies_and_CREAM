{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X to InLeo", "version": "2.0.1", "description": "Share X/Twitter and Reddit posts to InLeo blockchain", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://api.hive.blog/*", "https://tinyurl.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["https://reddit.com/*", "https://www.reddit.com/*"], "js": ["reddit-content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "X & Reddit to InLeo"}, "web_accessible_resources": [{"resources": ["keychain-bridge.js"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://reddit.com/*", "https://www.reddit.com/*"]}]}