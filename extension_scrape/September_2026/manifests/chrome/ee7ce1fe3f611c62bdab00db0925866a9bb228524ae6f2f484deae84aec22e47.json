{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Temu Finder", "version": "1.7", "description": "Temu Finder extract goods name and goods image from product pages and search in Temu in order to convenient comparison", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "tabs", "contextMenus"], "host_permissions": ["*://*.amazon.com/*", "*://*.temu.com/*", "*://*.ebay.com/*", "*://*.etsy.com/*", "*://*.aliexpress.com/*", "*://*.shein.com/*", "*://*.tiktok.com/*", "*://*.thunt.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.amazon.com/*/dp/*", "*://*.amazon.com/*/gp/product/*", "*://*.amazon.com/dp/*", "*://*.amazon.com/gp/product/*", "*://*.ebay.com/itm/*", "*://*.etsy.com/listing/*", "*://*.aliexpress.com/item/*", "*://*.aliexpress.com/*", "*://*.shein.com/*", "*://*.tiktok.com/*/pdp/*", "*://*.tiktok.com/pdp/*"], "js": ["content.js"], "run_at": "document_end"}]}