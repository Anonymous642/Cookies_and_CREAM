{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LMK Today", "version": "0.9.0", "description": "Turns your Canvas or Brightspace assignments into a calm daily plan. Syncs automatically and learns how long your work takes.", "permissions": ["storage", "alarms", "notifications", "identity", "scripting"], "host_permissions": ["https://canvas.asu.edu/*", "https://*.instructure.com/*", "https://*.brightspace.com/*", "https://dvnson.github.io/*", "https://lmktoday.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "LMK \u2014 open your plan", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://canvas.asu.edu/*", "https://*.instructure.com/*"], "js": ["collect.js", "canvas-cs.js"], "run_at": "document_idle"}, {"matches": ["https://*.brightspace.com/*"], "js": ["collect-d2l.js", "canvas-cs.js"], "run_at": "document_idle"}, {"matches": ["https://canvas.asu.edu/*", "https://*.instructure.com/*", "https://*.brightspace.com/*"], "js": ["track.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://dvnson.github.io/*", "https://lmktoday.app/*"], "js": ["app-cs.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["https://*/*"], "options_ui": {"page": "connect.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["fonts/bricolage-700.woff2", "fonts/public-sans-400.woff2", "fonts/public-sans-600.woff2"], "matches": ["https://*/*"]}]}