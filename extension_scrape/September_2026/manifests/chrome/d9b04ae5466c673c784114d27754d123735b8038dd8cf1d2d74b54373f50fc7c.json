{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript", "version": "1.0.6", "description": "Extract YouTube video transcripts with AI analysis, translation, and multiple format support", "permissions": ["storage"], "host_permissions": ["https://*.youtube.com/*", "https://text.pollinations.ai/*", "https://youtubetotranscript.org/*"], "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "YouTube Transcript"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.youtube.com/*"]}]}