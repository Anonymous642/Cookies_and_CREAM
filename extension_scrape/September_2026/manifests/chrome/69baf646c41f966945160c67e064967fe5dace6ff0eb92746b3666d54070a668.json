{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Verimargin - Amazon FBA Profit & Fee Calculator", "version": "1.0.1", "description": "Instant FBA fees, profit, margin & ROI on every Amazon product page. Accurate, lightweight, free. No account, no data collection.", "permissions": ["storage"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "web_accessible_resources": [{"resources": ["content/overlay.css", "lib/fee-tables.json"], "matches": ["*://*.amazon.com/*"]}], "content_scripts": [{"matches": ["*://*.amazon.com/dp/*", "*://*.amazon.com/gp/product/*", "*://*.amazon.com/gp/aw/d/*", "*://*.amazon.com/*/dp/*"], "js": ["lib/prefs.js", "content/extractor.js", "content/calculator.js", "content/overlay.js", "content/content.js"], "css": []}]}