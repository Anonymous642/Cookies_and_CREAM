{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "transMag", "version": "0.1.1", "description": "Hover over any text to get an instant translation. No copy-paste needed. Supports EN, VI, ZH, JA, KO, FR, DE, ES.", "author": "Shino Pham", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.mymemory.translated.net/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Magnifier Translator", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-lens": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Toggle transMag lens"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}