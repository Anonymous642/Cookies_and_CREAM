{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "92", "name": "NOXTRACE - Scrolling Screenshot", "short_name": "NOXTRACE", "version": "4.0.1", "description": "Trace a region beyond the viewport and extract it as one seamless PNG. Local, focused, and editor-free.", "permissions": ["activeTab", "scripting", "contextMenus", "clipboardWrite"], "action": {"default_title": "NOXTRACE // Start optical capture", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Start or close a NOXTRACE capture"}}}