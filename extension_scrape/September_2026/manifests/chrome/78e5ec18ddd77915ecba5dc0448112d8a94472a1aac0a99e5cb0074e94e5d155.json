{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SupportUtils - Gmail Support Ticketing", "description": "Turn Gmail into a shared support inbox. Assign emails, track status, and see who's on what - without leaving Gmail.", "version": "1.0.0", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_popup": "src/pages/popup/index.html"}, "options_page": "src/pages/options/index.html", "permissions": ["storage", "notifications", "sidePanel", "alarms"], "host_permissions": ["https://mail.google.com/*"], "side_panel": {"default_path": "src/pages/sidepanel/index.html"}, "background": {"service_worker": "src/extension/background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/extension/content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/extension/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://supportutils.com/*", "https://*.supportutils.com/*"]}}