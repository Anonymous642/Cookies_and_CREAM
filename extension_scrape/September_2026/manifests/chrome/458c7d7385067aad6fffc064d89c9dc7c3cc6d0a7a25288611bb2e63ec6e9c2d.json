{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SaltedCX RTA Assistant", "version": "4.3.1", "description": "This extension helps assign chats fairly without manual intervention.", "permissions": ["sidePanel", "storage", "tabs"], "host_permissions": ["https://*.salted.cx/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open RTA Panel", "default_icon": {"128": "icon.png"}}, "icons": {"128": "icon.png"}, "content_scripts": [{"matches": ["https://*.salted.cx/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["chime.mp3"], "matches": ["https://*.salted.cx/*"]}]}