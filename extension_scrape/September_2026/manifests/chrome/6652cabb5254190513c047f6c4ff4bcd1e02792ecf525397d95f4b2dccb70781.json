{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResumeTex - Google Form Auto-Filler", "version": "1.0.1", "description": "Auto-fill Google Forms with your ResumeTex profile data in one click.", "permissions": ["storage", "identity"], "host_permissions": ["https://docs.google.com/forms/*", "https://server-beta.resumetex.live/*", "https://res.cloudinary.com/*"], "icons": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}}, "content_scripts": [{"matches": ["https://docs.google.com/forms/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background/background.js"}, "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["https://docs.google.com/*"]}]}