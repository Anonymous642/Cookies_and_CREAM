{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rotten Tomatoes Complete Scorecard", "version": "1.0.0", "description": "Shows the complete score data already embedded in Rotten Tomatoes movie pages.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "Complete Scorecard settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://rottentomatoes.com/*", "*://*.rottentomatoes.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}