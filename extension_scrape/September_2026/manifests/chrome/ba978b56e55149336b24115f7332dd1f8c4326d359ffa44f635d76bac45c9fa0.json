{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tidelift", "version": "0.0.16", "description": "The Tidelift extension is a tool for exploring Tidelift data about open source packages and releases on github.com", "action": {"default_title": "Tidelift Package Helper", "default_icon": "./assets/tl-icon.png", "default_popup": "./dist/popup/index.html"}, "options_ui": {"page": "./dist/options/index.html", "open_in_tab": true}, "background": {"service_worker": "./dist/background/index.mjs"}, "icons": {"16": "./assets/tl-icon.png", "48": "./assets/tl-icon.png", "128": "./assets/tl-icon.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.preview.spandrel.io/*", "*://*.tidelift.com/*"], "content_scripts": [{"matches": ["*://tidelift.com/*", "*://*.preview.spandrel.io/*", "*://crates.io/*", "*://github.com/*", "*://www.npmjs.com/*", "*://pkg.go.dev/*", "*://mvnrepository.com/*", "*://central.sonatype.com/*", "*://search.maven.org/*", "*://pypi.org/*", "*://rubygems.org/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["<all_urls>"]}, {"resources": ["*.ttf"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "key": ""}