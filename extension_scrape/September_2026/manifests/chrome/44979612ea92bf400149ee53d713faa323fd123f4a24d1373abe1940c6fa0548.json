{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hidden Review Issues for Airbnb & Booking", "description": "Surfaces recurring issues like noise, Wi-Fi, and cleanliness in Airbnb & Booking reviews \u2014 before you book.", "version": "1.0.7", "permissions": ["storage", "offscreen"], "options_page": "src/options.html", "host_permissions": ["https://airbnb.com/*", "https://*.airbnb.com/*", "https://booking.com/*", "https://*.booking.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Review Insights", "default_popup": "src/options.html"}, "content_scripts": [{"matches": ["*://*.airbnb.com/rooms/*", "*://*.booking.com/hotel/*"], "js": ["content.js"], "run_at": "document_idle", "css": ["content.css"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; object-src 'self'"}, "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}