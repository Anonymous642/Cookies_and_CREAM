{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wellphrase", "version": "1.2.0", "description": "Rewrites prompts on Claude, ChatGPT, Gemini, Copilot, and Perplexity using an AI backend.", "minimum_chrome_version": "109", "permissions": ["storage", "contextMenus"], "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://wellphrase-api.vercel.app/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://*.claude.ai/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "js": ["content-script.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [], "externally_connectable": {"matches": ["https://wellphrase-api.vercel.app/*", "https://wellphrase.com/*", "https://www.wellphrase.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "commands": {"improve-prompt": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Improve the current prompt"}}}