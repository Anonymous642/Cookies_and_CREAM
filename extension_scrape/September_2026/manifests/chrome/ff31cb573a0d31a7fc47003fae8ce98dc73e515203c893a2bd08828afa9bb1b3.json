{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptPilot", "description": "Better prompts, Better results. Transform your AI interactions with smarter, more effective prompts - Better input, better output.", "version": "1.0.0", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "permissions": ["storage"], "host_permissions": ["https://chat.openai.com/*", "https://*.openai.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://gemini.google.com/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "src/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://*.openai.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://gemini.google.com/*"], "js": ["src/contentScript.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "src/icon16.png", "48": "src/icon48.png", "128": "src/icon128.png"}}, "icons": {"16": "src/icon16.png", "48": "src/icon48.png", "128": "src/icon128.png"}, "web_accessible_resources": [{"resources": ["src/*"], "matches": ["https://chat.openai.com/*", "https://*.openai.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://gemini.google.com/*"]}]}