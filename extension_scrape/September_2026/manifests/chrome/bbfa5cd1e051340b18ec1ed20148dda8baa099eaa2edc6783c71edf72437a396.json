{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scan For Cards", "version": "1.1.2", "description": "Get Telegram and desktop alerts when cards on your watchlist show up in Instagram stories from sellers you follow.", "homepage_url": "https://scanforcards.com", "minimum_chrome_version": "116", "permissions": ["storage", "alarms", "tabs", "activeTab", "scripting", "notifications"], "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "externally_connectable": {"matches": ["https://scanforcards.com/*", "https://www.scanforcards.com/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Scan For Cards", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["scanner.js"], "run_at": "document_idle"}]}