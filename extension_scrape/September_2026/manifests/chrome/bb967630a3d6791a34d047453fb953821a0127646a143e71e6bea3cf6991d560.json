{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuillReply for Gmail", "version": "1.3.0", "description": "Turn any email into a reminder with the right due date, and draft replies in your own voice. Buttons live inside Gmail.", "permissions": ["storage", "identity", "contextMenus", "alarms"], "host_permissions": ["https://api.quillreply.com/*"], "optional_host_permissions": ["https://graph.microsoft.com/*", "https://login.microsoftonline.com/*", "https://api.todoist.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/lib/gmail.js", "src/lib/ui.js", "src/content.js"], "css": ["src/inject.css"], "run_at": "document_idle"}], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "commands": {"remind-me": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Turn the open email into a reminder"}, "draft-reply": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Draft a reply in my voice"}}, "action": {"default_title": "QuillReply: waiting on a reply", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}