{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Analyzer", "version": "1.0.0", "description": "Instantly analyzes any GitHub profile and shows a developer score, top skills, and key stats \u2014 right on the page.", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "GitHub Analyzer Settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content/detector.js", "content/dom-parser.js", "content/scorer.js", "content/categorizer.js", "content/redflags.js", "content/exporter.js", "content/injector.js", "content/content-main.js"], "css": ["styles/dashboard.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles/dashboard.css"], "matches": ["https://github.com/*"]}], "permissions": ["storage"], "host_permissions": ["https://api.github.com/*", "https://api.gumroad.com/*"]}