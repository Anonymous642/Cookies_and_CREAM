{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Receipt", "version": "0.1.1", "description": "A local focus timer that lets users save selected tabs during a session and review a simple focus receipt afterward.", "action": {"default_title": "Focus Receipt", "default_icon": {"48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "alarms", "activeTab", "notifications", "contextMenus", "sidePanel"], "commands": {"capture-current-tab": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture the current tab for the active focus session"}}}