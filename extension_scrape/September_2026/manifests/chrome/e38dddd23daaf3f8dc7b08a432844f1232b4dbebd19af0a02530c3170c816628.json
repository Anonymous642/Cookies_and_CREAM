{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JustAMin - Mindful Browsing", "version": "1.0.0", "description": "Pause one minute before opening distracting sites. Block any site, build focus habits, and stay in control of your time.", "author": "Piyush from AiXceler", "permissions": ["tabs", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "JustAMin", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "web_accessible_resources": [{"resources": ["interstitial.html"], "matches": ["<all_urls>"]}]}