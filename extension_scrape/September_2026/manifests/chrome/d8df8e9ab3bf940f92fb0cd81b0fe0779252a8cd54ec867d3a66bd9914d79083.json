{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Image Sniper", "version": "1.0.0", "description": "Select images directly in forum threads and auto-download full-resolution files.", "permissions": ["downloads", "activeTab", "scripting", "storage"], "options_page": "options.html", "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle Image Sniper (Alt+S)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*", "file:///*"], "js": ["hotkey.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://*.twitter.com/*"], "js": ["resolver.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"toggle-sniper": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Toggle Image Sniper Mode"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}