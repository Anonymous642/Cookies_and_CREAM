{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EngramClip: YouTube Notes & PDF", "version": "0.2.2", "description": "Save YouTube timestamps and notes - organize by project, export as PDF.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Open EngramClip", "default_icon": {"16": "icon16.png", "32": "icon32.png"}}, "side_panel": {"default_path": "panel.html"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Alt+Shift+E"}, "description": "Open EngramClip Panel"}, "take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture current video frame"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["sidePanel", "storage", "tabs", "activeTab"], "host_permissions": ["https://www.youtube.com/*"]}