{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTidy", "version": "1.0", "description": "Automatically groups your Chrome tabs by URL for a cleaner, more organized browsing experience.", "permissions": ["tabs", "tabGroups", "storage", "history"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}}}