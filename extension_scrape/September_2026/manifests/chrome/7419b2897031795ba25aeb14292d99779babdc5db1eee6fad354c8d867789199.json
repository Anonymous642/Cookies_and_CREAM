{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paper Mode - Read the Web Like E-Ink", "short_name": "Paper Mode", "version": "1.0.1", "description": "Turn webpages into paper-like e-ink reading experience with grayscale, reduced glare, cleaner typography, and optional reader mode.", "permissions": ["storage", "activeTab", "scripting", "management"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Paper Mode", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "commands": {"toggle-paper-mode": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Toggle the Paper Mode default for all websites"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://extensionpay.com"}}