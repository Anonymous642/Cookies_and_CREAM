{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Reseller Sync - Auto Delist & Inventory Sync", "version": "1.0.2", "description": "Automatically delist sold items across Poshmark, Depop, Mercari, eBay, Etsy. Prevent double-selling and account bans.", "manifest_version": 3, "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "notifications"], "host_permissions": ["https://*.poshmark.com/*", "https://*.depop.com/*", "https://*.mercari.com/*", "https://*.ebay.com/*", "https://*.etsy.com/*", "https://api.stripe.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.poshmark.com/*"], "js": ["content/poshmark.js"], "run_at": "document_idle"}, {"matches": ["https://*.depop.com/*"], "js": ["content/depop.js"], "run_at": "document_idle"}, {"matches": ["https://*.mercari.com/*"], "js": ["content/mercari.js"], "run_at": "document_idle"}, {"matches": ["https://*.ebay.com/*"], "js": ["content/ebay.js"], "run_at": "document_idle"}, {"matches": ["https://*.etsy.com/*"], "js": ["content/etsy.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Reseller Sync", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "styles/*.css"], "matches": ["<all_urls>"]}]}