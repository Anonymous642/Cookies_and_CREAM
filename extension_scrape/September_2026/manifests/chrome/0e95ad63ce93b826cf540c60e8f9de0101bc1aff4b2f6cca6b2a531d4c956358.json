{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cosmiq Search", "version": "0.3.0", "description": "Find a profile's top Instagram posts and reels by views, likes or comments. Export to Excel, CSV or JSON. Local, no signup.", "action": {"default_popup": "popup.html", "default_title": "Cosmiq Search", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "activeTab"], "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["sortfeed-lite.js"], "run_at": "document_start", "world": "MAIN"}]}