{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebMaster Suite \u2014 All-in-One Toolkit", "version": "2.2.0", "description": "Tab manager, sticky notes, image downloader, clipboard history. 100% local \u2014 no servers, no tracking, no analytics.", "permissions": ["activeTab", "storage", "scripting", "downloads", "clipboardWrite", "tabGroups", "tabs", "commands"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "WebMaster Suite", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "commands": {"create_note": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Create new sticky note"}, "suspend_tabs": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Suspend inactive tabs"}, "group_tabs": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Group tabs by domain"}, "show_clipboard": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle clipboard history popup"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}