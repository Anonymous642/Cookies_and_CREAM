{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShotForge \u2014 Full Page Screenshot", "version": "1.0.0", "description": "Capture entire scrolling pages, a visible area or a selected region. Crop, annotate and export to PNG, JPG, WEBP or PDF.", "minimum_chrome_version": "109", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "offscreen", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "ShotForge \u2014 capture this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture the entire page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture a selected region"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Capture an element on the page"}}}