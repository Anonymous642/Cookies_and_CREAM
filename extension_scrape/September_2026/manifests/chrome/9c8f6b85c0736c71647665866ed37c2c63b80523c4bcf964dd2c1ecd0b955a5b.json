{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Metrician \u2014 AI usage & limit tracker", "description": "A fuel gauge for your AI \u2014 usage, resets, alerts and pacing for ChatGPT, Claude, Grok, OpenCode Go and Ollama. Private, local-first.", "version": "1.0.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'none';"}, "permissions": ["alarms", "storage", "scripting"], "optional_host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://grok.com/*", "https://opencode.ai/*", "https://ollama.com/*", "http://*/*", "https://*/*"], "action": {"default_title": "Open Metrician", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16-light.png", "32": "icons/icon-32-light.png"}}, "commands": {"toggle-usage-bar": {"description": "Show or hide the Metrician widget"}}, "web_accessible_resources": [{"resources": ["icons/*", "icons/providers/*", "content-scripts/widget.css"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}}