{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Groundery \u2014 Fact-check the web", "version": "0.1.6", "description": "The fact-checking layer for the web. Select any text on any page or fact-check YouTube videos \u2014 claims scored against real sources.", "action": {"default_popup": "src/popup/index.html", "default_title": "Groundery", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["src/content/youtube.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/content/selection.js"], "run_at": "document_idle"}], "commands": {"factcheck-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Fact-check the selected text"}}, "permissions": ["storage", "cookies"], "host_permissions": ["https://*.youtube.com/*", "https://www.groundery.com/*", "https://groundery.com/*", "https://clerk.groundery.com/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["http://*/*", "https://*/*"]}]}