{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusFlow Pomodoro", "description": "Pomodoro timer that runs in the background, blocks distracting sites during focus, and syncs to your FocusFlow account.", "version": "0.1.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest"], "host_permissions": ["https://pomodoro.marklu.page/*", "*://*.facebook.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "FocusFlow", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}}