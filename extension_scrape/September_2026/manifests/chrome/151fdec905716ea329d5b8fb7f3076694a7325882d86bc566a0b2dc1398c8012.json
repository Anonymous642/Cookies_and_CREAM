{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Have I Been Here", "version": "1.0", "description": "Effortlessly track your browsing history and see if you've visited a page before.", "permissions": ["storage", "tabs", "scripting", "downloads"], "background": {"service_worker": "background.js"}, "commands": {"mark_done": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Mark page as Done"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon/icon16.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}}, "icons": {"16": "icon/icon16.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}