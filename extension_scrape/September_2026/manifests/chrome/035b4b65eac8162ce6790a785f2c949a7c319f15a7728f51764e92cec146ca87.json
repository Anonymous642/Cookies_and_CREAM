{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chrome Tab Switching Shortcut", "description": "Implementing a shortcut to switch between tabs in Chrome", "version": "1.1", "background": {"service_worker": "tabswitch.js"}, "permissions": ["scripting", "activeTab", "tabs"], "icons": {"16": "icon/TabSwitch16.png", "48": "icon/TabSwitch48.png", "128": "icon/TabSwitch128.png"}, "action": {"default_popup": "TabSearch.html", "default_icon": "icon/TabSwitch128.png"}, "commands": {"next-tab": {"suggested_key": {"windows": "Alt+Right", "mac": "Ctrl+Right"}, "description": "Switch to the next tab"}, "previous-tab": {"suggested_key": {"windows": "Alt+Left", "mac": "Ctrl+Left"}, "description": "Switch to the previous tab"}, "scroll-up": {"suggested_key": {"windows": "Alt+Up", "mac": "Ctrl+Up"}, "description": "Scroll up"}, "scroll-down": {"suggested_key": {"windows": "Alt+Down", "mac": "Ctrl+Down"}, "description": "Scroll down"}, "_execute_action": {}}}