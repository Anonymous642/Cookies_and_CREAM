{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneDollarTrack Gmail Open Tracking", "version": "1.0.1", "description": "Minimal Gmail open tracking for personal use.", "author": "Daniel Olshansky", "permissions": ["storage", "identity", "alarms", "notifications"], "host_permissions": ["https://mail.google.com/*", "https://api.onedollartrack.com/*"], "optional_host_permissions": ["http://localhost:8000/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "run_at": "document_idle"}], "options_page": "options/index.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/icon.svg", "icons/placeholder.svg"], "matches": ["https://mail.google.com/*"]}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-toolbar-16.png", "32": "icons/icon-toolbar-32.png", "48": "icons/icon-toolbar-48.png", "128": "icons/icon-toolbar-128.png"}}}