{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Capture", "version": "1.9.9", "description": "Capture audio, video, screenshots, and transcripts from any browser tab. Local-first, no account required.", "homepage_url": "https://simple-capture.com", "permissions": ["tabCapture", "activeTab", "offscreen", "downloads", "storage", "sidePanel", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Simple Capture", "default_icon": {"16": "icons/icon-idle-16.png", "48": "icons/icon-idle-48.png", "128": "icons/icon-idle-128.png"}}, "icons": {"16": "icons/icon-idle-16.png", "48": "icons/icon-idle-48.png", "128": "icons/icon-idle-128.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "minimum_chrome_version": "116", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Open Simple Capture"}}}