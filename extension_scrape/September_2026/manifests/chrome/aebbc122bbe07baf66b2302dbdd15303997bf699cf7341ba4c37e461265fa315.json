{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ch\u1ee5p m\u00e0n h\u00ecnh web", "version": "1.0.1", "description": "Ch\u1ee5p tr\u1ecdn m\u1ed9t trang web th\u00e0nh m\u1ed9t \u1ea3nh, k\u1ec3 c\u1ea3 ph\u1ea7n ph\u1ea3i cu\u1ed9n nhi\u1ec1u m\u00e0n. Ch\u1ee5p \u0111\u01b0\u1ee3c v\u00f9ng ch\u1ecdn tay v\u00e0 b\u00e0i vi\u1ebft Facebook.", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "downloads"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Ch\u1ee5p tr\u1ecdn trang \u0111ang m\u1edf", "default_icon": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"capture-post": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Ch\u1ee5p tr\u1ecdn trang, ho\u1eb7c b\u00e0i vi\u1ebft \u0111ang m\u1edf"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ch\u1ecdn tay m\u1ed9t v\u00f9ng r\u1ed3i ch\u1ee5p"}, "capture-batch": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Ch\u1ecdn nhi\u1ec1u ph\u1ea7n r\u1ed3i ch\u1ee5p m\u1ed9t l\u01b0\u1ee3t"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}