{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SourceScope \u2014 Wikipedia Research Assistant", "version": "0.90.15", "description": "Turn Wikipedia into a research workflow. Check citations, find stronger sources, recover archives, and export Source Packs.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.wikipedia.org/*", "https://archive.org/*", "https://web.archive.org/*", "https://api.crossref.org/*", "https://eutils.ncbi.nlm.nih.gov/*", "https://export.arxiv.org/*", "https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://*.wikipedia.org/wiki/*"], "exclude_matches": ["https://*.wikipedia.org/wiki/Main_Page", "https://*.m.wikipedia.org/wiki/*"], "js": ["src/data/uiStrings.js", "src/content/modules/config.js", "src/content/modules/utils.js", "src/content/modules/sourceIntelligence.js", "src/content/modules/reports.js", "src/content/modules/sourcePacks.js", "src/content/content.js"], "css": ["src/content/styles.css", "src/content/designSystem.css"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["src/vendor/extpay-content.js"], "run_at": "document_start"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "SourceScope", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "src/background/background.js"}, "web_accessible_resources": [{"resources": ["src/data/sourceRatings.js"], "matches": ["https://*.wikipedia.org/*"]}]}