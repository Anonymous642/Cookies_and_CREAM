{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Genie: All-In-One Multi AI Voice and Chat Assistant & Smart AI Sidebar", "short_name": "Genie", "version": "2.0.0", "description": "Ultimate Voice & Chat sidebar assistant. Ask anything, summarize websites, analyze PDFs & talk live with ChatGPT, Gemini, Grok & Pi.", "permissions": ["sidePanel", "storage", "scripting", "declarativeNetRequest", "offscreen", "cookies", "contextMenus"], "host_permissions": ["https://*/*", "http://*/*", "file:///*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*", "file:///*"], "js": ["content.js"], "css": ["content-styles.css"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "default_title": "Hey Genie \u2014 Ask Any Page with AI & Voice"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the Hey Genie side panel"}}, "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "web_accessible_resources": [{"resources": ["sidepanel.html", "icons/icon_32.png"], "matches": ["<all_urls>"]}]}