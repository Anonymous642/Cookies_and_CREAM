{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitter/X GIF Saver", "description": "Adds a Save GIF button for X (Twitter) GIFs and a Copy Link button for posts that embed properly in Discord.", "version": "1.2.0", "minimum_chrome_version": "109", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "offscreen", "storage"], "host_permissions": ["https://video.twimg.com/*"], "background": {"service_worker": "src/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/content.js", "src/copy-link.js", "src/gif-aura.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "action": {"default_title": "Twitter/X GIF Saver", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}