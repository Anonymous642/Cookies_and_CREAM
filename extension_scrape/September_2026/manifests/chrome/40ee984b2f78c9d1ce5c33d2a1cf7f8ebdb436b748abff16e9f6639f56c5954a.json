{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Revibe \u2014 Codebase X-ray for GitHub", "version": "0.2.0", "description": "Understand any GitHub repo without reading every file. Architecture, dependencies, user flows \u2014 mapped to actual code.", "permissions": ["storage", "notifications", "alarms", "tabs"], "host_permissions": ["https://github.com/*", "https://app.revibe.codes/*", "https://app-backend.revibe.codes/*", "https://www.revibe.codes/*", "https://revibe.codes/*"], "icons": {"16": "assets/revibe_icon_16x16.png", "48": "assets/revibe_icon_48x48.png", "128": "assets/revibe_icon_128x128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.revibe.codes/*", "https://app.revibe.codes/*", "https://revibe.codes/*"], "js": ["content/revibe-bridge.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/logo.png", "assets/revibe_icon_128x128.png"], "matches": ["https://github.com/*"]}]}