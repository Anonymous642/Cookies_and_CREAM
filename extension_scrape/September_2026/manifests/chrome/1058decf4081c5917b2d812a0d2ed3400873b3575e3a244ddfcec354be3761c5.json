{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dynamic Chromeland", "version": "1.8.1", "description": "Chrome version of dynamic island for increased productivity.", "permissions": ["storage", "scripting", "activeTab", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Dynamic Chromeland", "default_popup": "popup/popup.html"}, "commands": {"toggle-visibility": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Toggle Dynamic Island Visibility"}, "toggle-flip": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Flip the Dynamic Island to the tabs stack"}, "toggle-mode": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Cycle the Dynamic Island mode (Auto / Original / Compact)"}, "toggle-expand": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Expand / collapse the Playlist or Tabs card"}}, "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/loader.js"], "css": ["content/island.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/content.js", "assets/*", "ml-model/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}