{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuietTube: Autoplay Blocker for YouTube", "version": "1.1.4", "default_locale": "en", "description": "Prevents video autoplay exclusively on YouTube. Upgrades your UX.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "QuietTube"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.youtube.com/*"], "js": ["injected.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://*.youtube.com/*"]}]}