{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Infinity Prompt", "version": "1.0.2", "description": "Enhance your prompts in any input field using Infinity Prompt.", "permissions": ["sidePanel", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Infinity Prompt"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"16": "infinity-logo.png", "48": "infinity-logo.png", "128": "infinity-logo.png"}, "web_accessible_resources": [{"resources": ["infinity-logo.png"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+I", "mac": "Command+I"}, "description": "Open Infinity Prompt sidebar"}}}