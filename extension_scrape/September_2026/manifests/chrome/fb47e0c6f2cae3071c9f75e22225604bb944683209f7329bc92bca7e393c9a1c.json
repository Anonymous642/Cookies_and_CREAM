{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneFightMore Mock Question Snipper", "version": "1.0.5", "description": "Snip and auto-attach mock questions from exam tabs to your OneFightMore log using Alt+S (Windows) or Option+S (Mac).", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["*://*.onefightmore.in/*", "*://onefightmore.in/*", "http://localhost/*", "http://127.0.0.1/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Snip Mock Question (Alt+S / Option+S)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"snip_question": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Snip Question Area on Current Mock Page"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.onefightmore.in/*", "*://onefightmore.in/*", "*://localhost/*", "*://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start"}]}