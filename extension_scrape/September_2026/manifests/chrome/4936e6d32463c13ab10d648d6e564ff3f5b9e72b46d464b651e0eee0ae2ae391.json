{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Re-See", "version": "0.5.0", "description": "Brighten dark, murky video in your browser so under-lit scenes become watchable. Video only, near-zero overhead.", "author": "Paresh Pandit", "permissions": ["scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Re-See", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content.js"]}], "commands": {"increase": {"suggested_key": {"default": "Alt+Shift+Period"}, "description": "Re-See: brighten video"}, "decrease": {"suggested_key": {"default": "Alt+Shift+Comma"}, "description": "Re-See: dim video (toward normal)"}, "reset": {"suggested_key": {"default": "Alt+Shift+0"}, "description": "Re-See: reset to normal"}}}