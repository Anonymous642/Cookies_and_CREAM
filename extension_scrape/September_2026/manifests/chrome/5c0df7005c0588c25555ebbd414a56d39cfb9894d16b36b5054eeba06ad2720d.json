{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gateway Log Viewer", "version": "2.9.0", "description": "Advanced log viewer for API Gateway logs with smart decoding, visualization and network recording", "permissions": ["storage", "contextMenus", "activeTab", "clipboardRead", "clipboardWrite", "downloads", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/curl-builder.js", "scripts/content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"format-log": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Paste from clipboard and format log"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle network request recording"}}, "web_accessible_resources": [{"resources": ["scripts/injected-recorder.js"], "matches": ["<all_urls>"]}]}