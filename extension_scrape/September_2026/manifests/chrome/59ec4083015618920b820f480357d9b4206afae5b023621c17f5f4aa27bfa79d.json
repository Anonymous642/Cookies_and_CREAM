{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Autoclicker", "version": "2.0.0", "description": "Automate webpage clicks with random intervals, click limits, shortcuts, position capture and scheduled sessions.", "author": "Arnav Sharma", "permissions": ["activeTab", "storage", "scripting", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Autoclicker \u2014 start or stop webpage clicks"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "120", "commands": {"toggle-clicking": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Start or stop Autoclicker"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}