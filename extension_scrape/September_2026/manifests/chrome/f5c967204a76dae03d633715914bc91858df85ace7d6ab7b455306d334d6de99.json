{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discord Translator+ (Romaji, Pinyin, Hangul)", "version": "0.2.0", "description": "Translate Discord messages with romaji, pinyin & hangul romanization. Built for language learners. BYOK or free Google.", "permissions": ["storage", "contextMenus", "offscreen"], "host_permissions": ["https://discord.com/*", "https://translate.googleapis.com/*", "https://generativelanguage.googleapis.com/*"], "web_accessible_resources": [{"resources": ["kuromoji-dict/*"], "matches": ["https://discord.com/*"]}], "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://discord.com/channels/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_icon": {"32": "icons/icon-32.png"}}, "options_page": "src/options/index.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}