{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Scroll Shield", "version": "1.0.1", "description": "Stops mindless scrolling", "manifest_version": 3, "author": "Kai Hartvigsen", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "declarativeNetRequestWithHostAccess", "storage", "declarativeContent"], "host_permissions": ["https://www.instagram.com/*", "https://www.youtube.com/*", "https://www.facebook.com/*", "https://www.snapchat.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["instagram.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_start"}, {"matches": ["https://www.facebook.com/*"], "js": ["facebook.js"], "run_at": "document_start"}, {"matches": ["https://web.snapchat.com/*"], "js": ["snapchat.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}