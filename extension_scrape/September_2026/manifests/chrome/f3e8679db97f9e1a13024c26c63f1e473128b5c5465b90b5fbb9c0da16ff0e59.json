{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CaptureWebPage \u2014 Full Page Screenshot & Editor", "short_name": "CaptureWebPage", "description": "Capture full webpages, areas, elements, windows and scrolling pages. Annotate, beautify and export as PNG, JPG, PDF, SVG or ZIP.", "version": "1.0.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "CaptureWebPage \u2014 capture this page", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "options_page": "src/options/index.html", "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "downloads", "contextMenus", "offscreen", "desktopCapture", "fontSettings"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["src/editor/index.html", "src/history/index.html", "src/offscreen/index.html", "icons/*", "assets/*"], "use_dynamic_url": false}], "commands": {"capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the entire webpage"}, "capture-visible": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture the visible area"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Capture a selected area"}, "capture-element": {"description": "Capture a specific element"}, "open-history": {"description": "Open the screenshot library"}}, "minimum_chrome_version": "116"}