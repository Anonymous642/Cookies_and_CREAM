{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subreddit Scout \u2014 Rules Checker & Self-Promo Score", "version": "1.0.0", "description": "One click on any subreddit: self-promo tolerance score, rules digest, mod strictness, and the best times to post. By GrowWithReddit.", "action": {"default_popup": "popup.html", "default_title": "Subreddit Scout"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.reddit.com/r/*", "https://old.reddit.com/r/*"], "js": ["scout.js"], "css": ["scout.css"], "run_at": "document_idle"}]}