{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Medium Exporter", "version": "2.0.0", "description": "Export Medium articles and reading lists to Markdown files. Free and simple tool for writers and readers.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "scripting", "downloads", "storage", "alarms", "notifications"], "host_permissions": ["https://medium.com/*", "https://*.medium.com/*", "https://medium-exporter-pro-api.onrender.com/*"], "optional_host_permissions": ["https://*/*"], "action": {"default_title": "Medium Exporter", "default_popup": "popup_minimal.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://medium.com/*", "https://*.medium.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["libs/turndown.js", "libs/jszip.js"], "matches": ["<all_urls>"]}]}