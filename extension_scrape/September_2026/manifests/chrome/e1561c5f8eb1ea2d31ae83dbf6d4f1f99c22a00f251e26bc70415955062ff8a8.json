{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen to GIF - Gifaffe", "version": "1.5.1", "description": "One hotkey to record your screen and save a clean GIF.", "action": {"default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["commands", "storage", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://*.posthog.com https://gifaffe.vercel.app"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["overlay.css", "file.svg", "lib/posthog.min.js", "lib/posthog-init.js", "lib/posthog-recorder.js", "demo-mode/zoom-engine.js", "demo-mode/cursor-effects.js", "demo-mode/cursor-effects.css", "demo-mode/element-selector.js", "demo-mode/element-selector.css", "demo-mode/template-engine.js", "demo-mode/dom-replacer.js", "demo-mode/personalization-panel.js", "demo-mode/personalization-panel.css", "demo-mode/demo-controller.js", "demo-mode/template-manager.js", "demo-mode/template-manager.css"], "matches": ["<all_urls>"]}], "commands": {"start-stop": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Start/stop screen capture"}}}