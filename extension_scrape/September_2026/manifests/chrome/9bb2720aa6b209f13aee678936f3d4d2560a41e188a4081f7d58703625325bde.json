{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rescriber", "description": "Helps you stay aware of oversharing by sanitizing personal data in AI conversations", "version": "1.0.2", "homepage_url": "https://rescriber.io", "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"], "permissions": ["storage", "offscreen"], "action": {"default_popup": "popup.html", "default_title": "Rescriber Configuration"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "type": "module", "run_at": "document_start", "all_frames": true}, {"matches": ["https://claude.ai/*"], "js": ["content.js"], "type": "module", "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["chatgptInject.js", "claudeInject.js", "assets/*", "wasm/*", "model/*"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}