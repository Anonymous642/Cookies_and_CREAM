{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PerfectReply.ai", "version": "1.0.3", "description": "Reply to any message perfectly. Write replies 100X faster with perfect knowledge of your business.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "PerfectReply.ai", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "full-panel.html", "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"generate-reply": {"description": "Generate reply from highlighted text", "suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}}, "cycle-avatar": {"description": "Cycle active style avatar", "suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}}}}