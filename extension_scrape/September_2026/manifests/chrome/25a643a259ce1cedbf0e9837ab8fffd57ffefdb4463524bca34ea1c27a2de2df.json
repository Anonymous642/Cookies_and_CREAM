{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AIDetector - AI Content Detection", "version": "1.0.1", "description": "Detect AI-generated images and videos in your browser. Right-click any image or video to analyze. Works locally or with APIs.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "downloads", "windows"], "host_permissions": ["https://api.thehive.ai/*", "https://api.aiornot.com/*", "https://api.sensity.ai/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_title": "AIDetector - AI Content Detection", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "settings/*", "models/*", "utils/detector-config.json"], "matches": ["<all_urls>"]}], "options_page": "settings/settings.html"}