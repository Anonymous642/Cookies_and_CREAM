{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Allegro Price Memory", "version": "1.0.0", "description": "Remembers prices you saw on Allegro and shows changes when you visit the product again.", "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://allegro.pl/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Allegro Price Memory", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://allegro.pl/oferta/*", "https://allegro.pl/produkt/*"], "js": ["content.js"], "run_at": "document_idle"}]}