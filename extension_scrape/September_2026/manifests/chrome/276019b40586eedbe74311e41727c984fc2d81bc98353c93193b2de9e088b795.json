{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Toby: Tab Manager & Session Saver", "description": "Too many tabs? Save them in one click, organize them into collections, and restore any session later, on any device.", "version": "2.0.0.11", "short_name": "Toby", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Toby", "default_popup": "popup.html"}, "permissions": ["storage", "unlimitedStorage", "tabs", "contextMenus", "declarativeNetRequestWithHostAccess", "cookies", "sidePanel"], "optional_permissions": ["tabGroups", "history"], "minimum_chrome_version": "103", "host_permissions": ["https://*.gettoby.com/*"], "optional_host_permissions": ["*://to/*", "<all_urls>"], "omnibox": {"keyword": "to/"}, "web_accessible_resources": [{"resources": ["assets/js/*.js", "assets/css/*.css", "icon/128.png", "icon/32.png"], "matches": ["*://*/*"]}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src * data: blob:; connect-src 'self' https:"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.gettoby.com/*"], "run_at": "document_idle", "js": ["content-scripts/gettoby-buttons.js", "content-scripts/public-collection.js"]}]}