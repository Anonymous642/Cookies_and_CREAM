{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notemark", "version": "1.0.1", "description": "Instantly capture notes on any webpage. Notes are tied to the page URL, searchable, and always one click away.", "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/widget.js"], "css": [], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/index.html"}, "action": {"default_title": "Notemark", "default_popup": "popup/popup.html", "default_icon": {"16": "page-notes.png", "32": "page-notes.png", "48": "page-notes.png", "128": "page-notes.png"}}, "web_accessible_resources": [{"resources": ["content/widget.css"], "matches": ["<all_urls>"]}]}