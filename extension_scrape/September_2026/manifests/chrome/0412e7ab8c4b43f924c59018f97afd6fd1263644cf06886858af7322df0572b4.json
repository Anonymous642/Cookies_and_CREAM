{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopyBridge", "version": "0.7.4", "description": "Paste addresses into checkout forms (Amazon/Walmart & any site via training).", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab", "clipboardRead", "clipboardWrite", "notifications"], "host_permissions": ["*://*/*", "*://*.supabase.co/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.ca/*"], "js": ["content-amazon.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["*://*.walmart.com/*", "*://*.walmart.ca/*"], "js": ["content-walmart.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["lib/field-finder.js", "content-trainer.js", "content-fill.js", "content-bootstrap.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["lib/field-finder.js", "content-trainer.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "CopyBridge", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"paste-address": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Paste last saved address into the current site (set in chrome://extensions/shortcuts)"}}}