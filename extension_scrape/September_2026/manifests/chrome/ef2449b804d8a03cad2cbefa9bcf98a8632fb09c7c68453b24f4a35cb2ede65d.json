{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ember \u2014 Focus Mode, Site Blocker & Distraction Pause", "version": "1.1.0", "description": "A warmer way to focus. Gentle pauses instead of hard blocks. Free forever \u2014 no account, and your data stays on your device.", "permissions": ["storage", "alarms", "scripting"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Ember", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://news.ycombinator.com/*", "*://*.twitch.tv/*"], "exclude_matches": ["*://music.youtube.com/*"], "js": ["content/intercept.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["assets/fonts/*.woff2", "js/common.js"], "matches": ["*://*/*"], "use_dynamic_url": true}]}