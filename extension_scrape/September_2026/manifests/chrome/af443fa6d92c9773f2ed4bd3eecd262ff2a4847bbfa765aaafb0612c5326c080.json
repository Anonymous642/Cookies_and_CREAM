{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No Shorts - Block YouTube Shorts", "version": "1.0.0", "description": "Block YouTube Shorts and keep YouTube focused.", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "No Shorts", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "css": ["src/content/content.css"], "js": ["src/shared/constants.js", "src/shared/storage.js", "src/shared/schedule-policy.js", "src/shared/settings.js", "src/shared/stats.js", "src/shared/whitelist.js", "src/content/youtube-context.js", "src/content/focus-overlay.js", "src/content/dom-blocker.js", "src/content/navigation-interceptor.js", "src/shared/regret-interceptor.js", "src/content/main.js"], "run_at": "document_end"}], "commands": {"toggle-shorts": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle No Shorts"}}, "web_accessible_resources": [{"resources": ["images/zen-logo.png", "images/no-shorts.svg"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}]}