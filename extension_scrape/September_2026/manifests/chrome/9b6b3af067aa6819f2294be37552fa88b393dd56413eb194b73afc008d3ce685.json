{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Element Remover", "version": "1.0.2", "description": "Click elements to permanently remove them. Features a terminal-style management interface.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle Removal Terminal", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/blocker.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["content/styles.css"], "matches": ["<all_urls>"]}]}