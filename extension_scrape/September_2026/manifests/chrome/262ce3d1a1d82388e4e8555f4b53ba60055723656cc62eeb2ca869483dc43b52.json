{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JCI Quote Copilot", "version": "1.1.0", "description": "Keeps lead info in a side panel and fills it into any carrier portal. Click a portal field and the matching lead field lights up.", "permissions": ["sidePanel", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open JCI Quote Copilot"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["matcher.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"fill-focused": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Fill the field you're clicked into"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}