{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabForge Client", "version": "4.0.511", "description": "TabForge transforms your new tab into a desktop-style workspace.  Complete with the most practical bookmark system you've ever seen.", "permissions": ["storage", "tabs", "downloads", "search", "unlimitedStorage", "sessions", "webNavigation", "alarms", "clipboardRead", "clipboardWrite", "identity"], "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "assets/icon-16-forged-light.png", "32": "assets/icon-32-forged-light.png", "48": "assets/icon-48-forged-light.png", "128": "assets/icon-128-forged-light.png"}, "action": {"default_title": "Add current page to TabForge", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"tabforge-undo-closed-tab": {"suggested_key": {"default": "Ctrl+Z", "linux": "Ctrl+Z", "windows": "Ctrl+Z", "mac": "Command+Z"}, "description": "TabForge: undo/reopen the most recently closed tab"}}, "host_permissions": ["https://comms-app-1wo0.onrender.com/*", "https://notes.sendforge.app/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://www.copilot.microsoft.com/*", "https://you.com/*"], "js": ["ai-prompt-bridge.js"], "run_at": "document_idle", "all_frames": false}]}