{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PatchPoint - Game Patch Notes Tracker", "description": "Track game patch notes and updates. Get notified when Steam games, Valorant, Fortnite and more release patches and hotfixes.", "version": "2.1.0", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://store.steampowered.com/*", "https://api.steampowered.com/*", "https://api.rawg.io/*", "https://api.web3forms.com/*", "https://www.minecraft.net/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16_dark.png", "48": "icons/icon48_dark.png", "128": "icons/icon128_dark.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16_dark.png", "48": "icons/icon48_dark.png", "128": "icons/icon128_dark.png"}, "web_accessible_resources": [{"resources": ["fonts/*", "icons/*"], "matches": ["<all_urls>"]}]}