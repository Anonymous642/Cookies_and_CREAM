{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeView: VS Code plugin for Github", "version": "1.0.2", "description": "Check out your github repositories in IDE mode.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html"}, "host_permissions": ["*://*.github.com/*", "*://*.githubusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.github.com/*"], "css": ["content.css"], "js": ["content.js"], "exclude_matches": []}]}