{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clypno \u2014 Clip to Notion & Obsidian", "version": "0.3.2", "description": "Clip pages or highlights into clean Markdown, auto-tag them, and file them in Notion or Obsidian.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "downloads", "notifications"], "host_permissions": ["https://api.notion.com/*", "https://api.anthropic.com/*", "https://api.gumroad.com/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "action": {"default_popup": "popup.html", "default_title": "Clip this page"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the clipper"}, "quick-clip": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Clip page to last-used destination"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}