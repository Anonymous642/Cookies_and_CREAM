{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PatientNotes Launcher (Plus)", "version": "1.8.5", "description": "Launch PatientNotes quickly from Nookal, Pogozo or Splose. Prefills the patient name and provides a draggable PN button.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "PatientNotes", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["tabs", "contextMenus", "scripting", "clipboardRead", "storage"], "host_permissions": ["https://www.patientnotes.app/*", "https://*.nookal.com/*", "https://*.pogozo.com/*", "https://signin.pogozo.com/*", "https://*.splose.com/*"], "omnibox": {"keyword": "pn"}, "content_scripts": [{"matches": ["https://www.patientnotes.app/dashboard/sessions/new*"], "js": ["pn_prefill.js"], "run_at": "document_idle"}, {"matches": ["https://*.nookal.com/*"], "js": ["pn_fab.js"], "css": ["pn_fab.css"], "run_at": "document_idle"}, {"matches": ["https://*.pogozo.com/*"], "js": ["pn_fab.js", "pn_paste_icon.js"], "css": ["pn_fab.css"], "run_at": "document_idle"}, {"matches": ["https://*.splose.com/*"], "js": ["pn_fab.js", "pn_paste_icon.js"], "css": ["pn_fab.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon16.png", "icon32.png", "icon48.png", "icon128.png", "headerlogo.png"], "matches": ["https://*.nookal.com/*", "https://*.pogozo.com/*", "https://signin.pogozo.com/*", "https://*.splose.com/*"]}], "commands": {"open-pn-dashboard": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open PatientNotes Dashboard"}}}