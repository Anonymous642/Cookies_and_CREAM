{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Sleep \u2013 Auto Suspend Idle Tabs", "version": "1.2.0", "description": "Automatically suspend idle tabs to free up RAM and speed up Chrome. Simple, lightweight, no clutter.", "permissions": ["alarms", "contextMenus", "storage", "tabs", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Tab Sleep \u2013 Auto Suspend Idle Tabs", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"suspend-current": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Suspend current tab"}, "suspend-others": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Suspend other tabs"}, "suspend-all": {"description": "Suspend all tabs"}, "restore-all": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Restore all tabs"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/floating-timer.js", "content/form-watch.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["suspended/suspended.html", "suspended/suspended.js"], "matches": ["<all_urls>"]}]}