{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web2PDF - Save any webpage as a clean PDF", "description": "Convert the current webpage into a clean, print-ready PDF. Runs entirely on your device - nothing is uploaded.", "version": "1.0.0", "short_name": "Web2PDF", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "debugger"], "action": {"default_title": "Web2PDF", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js"}}