{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SeoSoup", "version": "1.9", "description": "Checks Google index size via 'site:' operator and provides a right-click context menu to inspect any link's domain or URL.", "permissions": ["contextMenus", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_title": "SeoSoup", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["modules/linkFinder.js", "modules/contactFinder.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}]}