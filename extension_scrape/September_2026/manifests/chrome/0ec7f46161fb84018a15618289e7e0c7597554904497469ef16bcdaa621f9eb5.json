{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZingFilter", "short_name": "ZingFilter", "version": "3.0", "description": "Allows you to watch filtered YouTube videos (and to create filters yourself) in order to mute/skip objectionable or boring content.", "author": "ZingFilter", "homepage_url": "https://zingfilter.in/", "action": {"default_icon": {"16": "images/logo_16.png", "19": "images/logo_19.png", "38": "images/logo_38.png", "48": "images/logo_48.png"}, "default_popup": "popup.html", "default_title": "ZingFilter Settings"}, "icons": {"16": "images/logo_16.png", "19": "images/logo_19.png", "38": "images/logo_38.png", "48": "images/logo_48.png", "128": "images/logo_128.png"}, "background": {"service_worker": "js/background.js"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://zingfilter.in/*"], "content_scripts": [{"all_frames": false, "run_at": "document_idle", "matches": ["https://www.youtube.com/*", "https://zingfilter.in/*"], "js": ["js/ZingFilter.js"]}]}