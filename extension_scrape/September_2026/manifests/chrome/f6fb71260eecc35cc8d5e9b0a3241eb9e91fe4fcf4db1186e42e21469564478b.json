{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Job Compass", "version": "1.2.0", "description": "Save and track jobs from LinkedIn, Indeed, CV-Library & NHS Jobs with AI cover letters, match scoring, and a local dashboard.", "permissions": ["activeTab", "scripting", "storage", "notifications"], "host_permissions": ["https://www.linkedin.com/*", "https://uk.indeed.com/*", "https://www.indeed.com/*", "https://www.cv-library.co.uk/*", "https://www.jobs.nhs.uk/*", "http://localhost/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://uk.indeed.com/*", "https://www.indeed.com/*", "https://indeed.com/*", "https://www.cv-library.co.uk/job/*", "https://www.jobs.nhs.uk/candidate/jobadvert/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}