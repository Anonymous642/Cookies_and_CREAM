{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Redactopia: Privacy Guard", "version": "1.2.0", "description": "Warns before you send sensitive info to AI assistants.", "permissions": ["storage", "sidePanel", "scripting", "activeTab", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://poe.com/*", "https://copilot.microsoft.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Redactopia", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open Redactopia side panel"}, "open-redactor-dock": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Open the Visual Redactor dock on the current page"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["gemini.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*"], "js": ["perplexity.js"], "run_at": "document_idle"}, {"matches": ["https://poe.com/*"], "js": ["poe.js"], "run_at": "document_idle"}, {"matches": ["https://copilot.microsoft.com/*"], "js": ["copilot.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.lemonsqueezy.com; object-src 'none'"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}