{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Idleon Wisdom Helper", "description": "A browser extension to help you win *that* memory card game in Idleon", "version": "1.1.0", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "background": {"service_worker": "src/service_worker.js"}, "commands": {"Initial capture": {"suggested_key": {"default": "Alt+Q"}, "description": "Initial screenshot"}, "Capture changes": {"suggested_key": {"default": "Alt+W"}, "description": "Capture flipped cards"}}, "permissions": ["activeTab", "storage"], "action": {"default_title": "Idleon Wisdom Helper"}, "content_scripts": [{"matches": ["https://*.legendsofidleon.com/*", "https://legendsofidleon.com/*"], "run_at": "document_start", "js": ["src/content_script.js"]}]}