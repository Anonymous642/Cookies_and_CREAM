{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Webflow Helper", "version": "0.2.3", "description": "Webflow toolkit: audit empty links & missing alt text, clipboard editor with XscpData transform and live preview.", "action": {"default_popup": "popup.html", "default_title": "Webflow Helper", "default_icon": {"16": "icons/webflow_helper_16.png", "32": "icons/webflow_helper_32.png", "48": "icons/webflow_helper_48.png", "128": "icons/webflow_helper_128.png"}}, "icons": {"16": "icons/webflow_helper_16.png", "32": "icons/webflow_helper_32.png", "48": "icons/webflow_helper_48.png", "128": "icons/webflow_helper_128.png"}, "permissions": ["storage", "tabs", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "commands": {"toggle-empty-links": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle highlighting empty links on the current tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}