{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkView", "version": "1.0.0", "description": "View Markdown files as beautifully rendered HTML \u2014 local files, dropped files, and remote .md URLs. Fully offline.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "MarkView \u2014 open Markdown viewer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage"], "host_permissions": ["file:///*", "http://*/*", "https://*/*"], "content_scripts": [{"matches": ["file:///*", "http://*/*", "https://*/*"], "include_globs": ["*.md", "*.markdown", "*.mkd", "*.mdown", "*.mdwn"], "js": ["lib/marked.min.js", "lib/purify.min.js", "lib/highlight.min.js", "src/render.js", "src/theme.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/styles/github-markdown.css", "src/styles/viewer.css", "src/styles/hljs-light.css", "src/styles/hljs-dark.css"], "matches": ["file:///*", "http://*/*", "https://*/*"]}]}