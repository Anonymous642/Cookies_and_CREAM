{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Super Fast Screenshot", "description": "Capture full-page screenshots using a keyboard shortcut", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["debugger", "activeTab", "scripting", "storage", "downloads"], "action": {"default_title": "Screenshot Manager", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Open screenshot popup"}, "capture-screenshot": {"suggested_key": {"default": "Alt+F", "mac": "Alt+F"}, "description": "Capture full page screenshot"}, "capture-viewport": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Capture viewport screenshot"}, "capture-area": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Capture selected area screenshot"}}, "background": {"service_worker": "background.js"}}