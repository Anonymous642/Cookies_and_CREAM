{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Qodo Merge: AI-Powered Code Reviews & Chat", "version": "2.3.6", "manifest_version": 3, "description": "Chat with your GitHub pull request code, and get AI-powered reviews, descriptions, and code suggestions", "homepage_url": "https://codium.ai", "icons": {"16": "icons/QodoMergeProIcon_16.png", "48": "icons/QodoMergeProIcon_48.png", "128": "icons/QodoMergeProIcon_128.png"}, "default_locale": "en", "permissions": ["tabs", "scripting", "storage", "cookies"], "options_page": "options.html", "storage": {"managed_schema": "schema.json"}, "host_permissions": ["https://github.com/*/*/pull/*", "https://github.com/*/*/pull/*/files", "https://github.com/*/*/pull/*/changes", "https://pro.github.pr-agent.codium.ai/*", "https://staging.pro.github.pr-agent.codium.ai/*", "https://api.github.com/repos/*/*/pulls/*/files*"], "externally_connectable": {"matches": ["https://auth.codium.ai/*", "https://auth.qodo.ai/*"]}, "background": {"service_worker": "dist/background.bundle.js"}, "web_accessible_resources": [{"resources": ["icons/*", "img/*"], "matches": ["*://github.com/*"]}]}