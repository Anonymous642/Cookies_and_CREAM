{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SZA Text to Speech", "version": "1.0.0", "description": "Reads highlighted text aloud with your chosen voice.", "permissions": ["contextMenus", "storage", "offscreen", "scripting", "activeTab"], "host_permissions": ["https://rhasspy.github.io/*", "https://huggingface.co/*"], "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "icons": {"16": "picture.png", "32": "picture.png", "48": "picture.png", "128": "picture.png"}, "options_page": "options.html", "action": {"default_title": "SZA Text to Speech", "default_popup": "popup.html", "default_icon": {"16": "picture.png", "32": "picture.png", "48": "picture.png"}}, "commands": {"speak-selected-shortcut": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Speak the currently selected text"}}}