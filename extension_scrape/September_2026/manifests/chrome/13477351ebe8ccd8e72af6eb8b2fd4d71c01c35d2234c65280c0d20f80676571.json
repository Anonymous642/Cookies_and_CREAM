{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScholarFree \u2014 Open Access Paper Finder", "short_name": "ScholarFree", "version": "1.1.0", "description": "Find open access scientific papers in your browser. Export BibTeX/CSV/RIS for Mendeley & Zotero. Works on Google Scholar & PubMed.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ScholarFree \u2014 Open Access Paper Finder"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://scholar.google.com/*", "https://pubmed.ncbi.nlm.nih.gov/*", "https://www.semanticscholar.org/*", "https://www.researchgate.net/*", "https://doi.org/*", "https://*.doi.org/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://api.openalex.org/*"], "options_page": "options.html", "web_accessible_resources": [{"resources": ["icons/*", "content.css"], "matches": ["<all_urls>"]}]}