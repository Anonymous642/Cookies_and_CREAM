{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TakeMe", "version": "1.0.1", "description": "Turn any browser workflow into a step-by-step guided tutorial. Record once, then guide your users through your site.", "minimum_chrome_version": "116", "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "sidePanel", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/loader.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "action": {"default_title": "TakeMe \u2014 record & play tutorials", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["src/content/*.js", "src/shared/*.js"], "matches": ["http://*/*", "https://*/*"]}]}