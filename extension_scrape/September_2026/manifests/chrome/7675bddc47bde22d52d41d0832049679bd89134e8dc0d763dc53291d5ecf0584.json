{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Triggerman", "version": "1.1.0", "description": "Automate your browser with custom triggers that react to what any website does the moment you visit them.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["webRequest", "webNavigation", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}