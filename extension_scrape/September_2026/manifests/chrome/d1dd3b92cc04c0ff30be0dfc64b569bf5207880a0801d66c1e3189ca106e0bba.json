{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spellar: AI Meeting Notetaker & Recorder", "description": "Record your browser meetings with Spellar \u2014 no bot, no desktop app.", "version": "3.4.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "Spellar Recorder", "default_popup": "popup.html"}, "permissions": ["tabCapture", "offscreen", "activeTab", "alarms", "cookies", "identity", "storage", "scripting"], "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start or stop the meeting recording"}}, "host_permissions": ["https://spellar.ai/*", "https://www.spellar.ai/*", "https://dev.spellar.ai/*", "https://api.spellar.ai/*", "https://test.api.spellar.ai/*", "https://audio.spellar.ai/*", "https://dev.audio.spellar.ai/*", "*://meet.google.com/*", "*://*.zoom.us/*", "*://teams.microsoft.com/*", "*://teams.live.com/*", "*://*.webex.com/*", "<all_urls>"], "web_accessible_resources": [{"resources": ["icon/48.png", "share-dialog-hint.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.webex.com/*", "*://*.zoom.us/*", "*://meet.google.com/*", "*://spellar.ai/*", "*://teams.live.com/*", "*://teams.microsoft.com/*", "*://www.spellar.ai/*", "<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}, {"matches": ["*://meet.google.com/*"], "run_at": "document_start", "js": ["content-scripts/meet-rtc.js"], "world": "MAIN"}, {"matches": ["*://meet.google.com/*"], "run_at": "document_start", "js": ["content-scripts/meet-speakers.js"]}]}