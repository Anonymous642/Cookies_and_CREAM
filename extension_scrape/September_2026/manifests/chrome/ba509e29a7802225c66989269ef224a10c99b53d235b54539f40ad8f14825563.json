{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Digital Safe Vault", "short_name": "Safe Vault", "version": "1.0.1", "description": "Fully offline, zero-knowledge vault for passwords, cards, secure notes & files, with quick-access popup and in-page autofill.", "author": "Sacinta Services", "homepage_url": "https://sacinta.com/digital-safe-vault", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Digital Safe Vault", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "optional_host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["src/full-page.html", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "src/service-worker.js", "type": "module"}, "permissions": ["storage", "scripting", "activeTab", "alarms", "offscreen"]}