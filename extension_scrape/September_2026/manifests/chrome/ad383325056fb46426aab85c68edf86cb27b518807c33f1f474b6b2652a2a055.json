{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Calculator Overlay Pro", "version": "1.0.0", "description": "A draggable floating calculator that works on any webpage\u2014instant calculations anywhere while browsing.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "116", "permissions": ["storage", "scripting", "contextMenus", "activeTab"], "host_permissions": ["*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Floating Calculator Overlay Pro"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["styles/designSystem.css"], "js": ["storage/storageManager.js", "modules/calculatorEngine.js", "content/calculatorUI.js", "content/overlayInjector.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["cal.png"], "matches": ["*://*/*"]}], "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle the Floating Calculator overlay"}}}