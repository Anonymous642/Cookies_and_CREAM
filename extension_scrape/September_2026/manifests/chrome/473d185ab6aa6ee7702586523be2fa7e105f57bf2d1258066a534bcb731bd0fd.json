{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeagueLore.ai Sync", "version": "1.4.0", "description": "Connect your ESPN or Yahoo fantasy football league to LeagueLore. Sends league data only to LeagueLore.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "LeagueLore.ai Sync", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["cookies", "alarms"], "host_permissions": ["https://*.espn.com/*", "https://football.fantasysports.yahoo.com/*", "https://leaguelore.ai/*"], "externally_connectable": {"matches": ["https://leaguelore.ai/*"]}}