{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kept - Session Recorder for Cancellations & Refunds", "description": "Record proof of online cancellations, refunds, and support chats. Save screen recordings, screenshots, and receipts on your device.", "version": "0.4.0", "minimum_chrome_version": "116", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Kept", "default_popup": "popup/index.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Alt+Shift+W"}, "description": "Start or stop keeping proof for the active tab"}}, "permissions": ["alarms", "offscreen", "scripting", "storage", "tabCapture", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"]}