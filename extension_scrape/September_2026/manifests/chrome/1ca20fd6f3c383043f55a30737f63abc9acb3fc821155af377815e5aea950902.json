{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResumeFix \u2014 ATS Resume Checker & Score", "version": "1.0.0", "description": "Get an honest ATS score for your resume against any LinkedIn or Indeed job in 60 seconds. Free. No signup.", "homepage_url": "https://resumefix.app", "permissions": ["activeTab"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "ResumeFix \u2014 check this job", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://*.indeed.com/viewjob*", "https://*.indeed.com/jobs*", "https://*.indeed.com/m/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}