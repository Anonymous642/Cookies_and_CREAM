{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Repl1 \u2013 AI Email Reply Assistant", "version": "1.2.1", "description": "Privacy-first AI email replies for Gmail. Generate smart reply suggestions with one click.", "permissions": ["storage", "alarms"], "host_permissions": ["https://mail.google.com/*", "http://localhost:3000/*", "https://repl1.app/*", "https://www.repl1.app/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["gmail-dom.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["http://localhost:3000/*", "https://repl1.app/*", "https://www.repl1.app/*"], "js": ["token-bridge.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"generate-reply": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Draft a reply for the open Gmail thread"}, "toggle-panel": {"description": "Show or hide the Repl1 panel"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://mail.google.com/*"]}]}