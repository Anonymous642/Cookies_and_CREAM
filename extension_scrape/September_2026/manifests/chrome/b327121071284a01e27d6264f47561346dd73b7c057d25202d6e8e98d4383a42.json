{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Float Translate", "short_name": "FloatTranslate", "version": "3.1.0", "description": "Floating translator: type in your language, inject the translation into any input. 55+ languages, on-device AI.", "author": "Float Translate", "homepage_url": "https://mralikhalaf.com/floattranslate", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_title": "Float Translate (Alt+T)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T", "linux": "Alt+T", "windows": "Alt+T"}, "description": "Toggle Float Translate widget"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["content/widget.js", "content/constants.js", "content/i18n.js", "content/storage.js", "content/translator.js", "content/detector.js", "content/injector.js", "content/sound.js", "content/providers/chrome-builtin.js", "content/providers/google.js", "content/providers/mymemory.js", "fonts/*.woff2", "icons/icon128.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}