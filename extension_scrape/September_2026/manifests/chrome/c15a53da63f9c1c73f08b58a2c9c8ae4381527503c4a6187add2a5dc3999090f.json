{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Toggle Tab \u2013 Ocultador de Pesta\u00f1as(By Ricitos)", "version": "1.0.0", "description": "Oculta pesta\u00f1as de juegos con un atajo de teclado y abre una p\u00e1gina segura autom\u00e1ticamente.", "permissions": ["tabs", "storage", "commands"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-tabs": {"suggested_key": {"default": "Alt+Q"}, "description": "Ocultar/mostrar pesta\u00f1as de juegos"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}