{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Hop", "version": "0.1.2", "description": "Easily move tabs between tab groups", "icons": {"16": "icons/tiny_icon_v2.png", "32": "icons/v3LargeLogo32.png", "48": "icons/v3LargeLogo48.png", "128": "icons/v3LargeLogo128.png"}, "permissions": ["tabs", "tabGroups", "commands"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/tiny_icon_v2.png", "32": "icons/v3LargeLogo32.png", "48": "icons/v3LargeLogo48.png", "128": "icons/v3LargeLogo128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+2"}, "description": "Show Group Picker to move current tab to a group"}, "undo-last-move": {"suggested_key": {"default": "Alt+Z"}, "description": "Undo last tab group move"}}, "homepage_url": "https://roderickjdunn.github.io/group-hopper-privacy/"}