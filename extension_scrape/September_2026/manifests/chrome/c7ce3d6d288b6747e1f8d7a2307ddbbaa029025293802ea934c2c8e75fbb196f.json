{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PomodoroYT", "version": "1.1.5", "description": "Pomodoro timer for YouTube with one locked tab, session-based playback control, break reminders, and ad muting.", "permissions": ["storage", "tabs", "alarms", "notifications", "scripting", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/background.js", "type": "module"}, "action": {"default_title": "PomodoroYT", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/youtube-content.js"], "css": ["styles/widget.css"], "run_at": "document_idle"}]}