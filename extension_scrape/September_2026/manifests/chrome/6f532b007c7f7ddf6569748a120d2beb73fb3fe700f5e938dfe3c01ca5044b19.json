{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Custom Rewind", "version": "1.0.1", "description": "Fast-forwards / Rewinds the video player by X seconds when a hotkey combination is pressed (default Alt+1 and Alt+2).", "permissions": ["activeTab", "scripting", "storage", "commands"], "background": {"service_worker": "background.js"}, "commands": {"forward": {"suggested_key": {"default": "Alt+2"}, "description": "Forward video"}, "rewind": {"suggested_key": {"default": "Alt+1"}, "description": "Rewind video"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}