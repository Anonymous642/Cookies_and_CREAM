{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Twitter Location Display", "version": "1.1.0", "description": "Shows country flag emoji next to Twitter usernames based on account location", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "permissions": ["activeTab", "storage", "tabs"], "action": {"default_popup": "popup.html", "default_title": "X Twitter Location Display", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["countryFlags.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pageScript.js", "sounds/*.mp3", "fonts/Twemoji.Mozilla.ttf"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]}