{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OutlineMySource (v0.1.1)", "version": "0.1.1", "description": "Extract a Markdown outline from the current webpage before you read it deeply (Readability-first, no uploads).", "action": {"default_title": "OutlineMySource (v0.1.1)", "default_popup": "open-launcher.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "assets/background.js"}, "permissions": ["storage", "tabs", "scripting", "windows"], "host_permissions": ["https://*/*", "http://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}