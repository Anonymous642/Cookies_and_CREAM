{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpotIt Sound ID", "version": "0.8.0", "description": "Names the bird calling in the YouTube live stream you are watching. Runs entirely in your browser; no audio leaves your machine.", "minimum_chrome_version": "116", "action": {"default_title": "SpotIt Sound ID \u2014 open the panel to listen", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["offscreen", "storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://spotitwildsan.blob.core.windows.net/*"], "web_accessible_resources": [{"resources": ["panel.css", "fonts/*", "names.json", "icons/*", "thumbs/*", "species.json", "species.html"], "matches": ["https://www.youtube.com/*"]}, {"resources": ["tflite/*", "no-threads.js", "sandbox.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "sandbox": {"pages": ["sandbox.html"]}}