{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timebox YouTube Blocker", "version": "1.0.0", "description": "Blocks YouTube by default and allows only three 20-minute breaks per day.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["alarms", "declarativeNetRequest", "storage", "tabs"], "host_permissions": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtu.be/*", "*://youtube-nocookie.com/*", "*://*.youtube-nocookie.com/*", "*://googlevideo.com/*", "*://*.googlevideo.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtu.be/*", "*://youtube-nocookie.com/*", "*://*.youtube-nocookie.com/*"], "js": ["content-blocker.js"], "run_at": "document_start"}], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "YouTube Blocker"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["blocked.html", "blocked.css", "blocked.js"], "matches": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtu.be/*", "*://youtube-nocookie.com/*", "*://*.youtube-nocookie.com/*"]}]}