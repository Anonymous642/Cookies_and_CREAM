{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Teamleader Integrations", "version": "4.0.16", "description": "This extension implements Teamleader functionality into other services such as Gmail and LinkedIn.", "options_page": "settings.html", "background": {"service_worker": "serviceWorker.js"}, "icons": {"16": "static/icon16.png", "32": "static/icon32.png", "48": "static/icon48.png", "128": "static/icon128.png"}, "action": {"default_icon": {"16": "static/icon16.png", "24": "static/icon24.png", "32": "static/icon32.png"}}, "permissions": ["scripting", "management", "identity", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://mail.google.com/*", "https://focus.teamleader.eu/*", "https://auth.focus.teamleader.eu/*"], "web_accessible_resources": [{"resources": ["static/*", "gmailGlobals.js"], "matches": ["https://www.linkedin.com/*", "https://mail.google.com/*"]}]}