{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nudge: LeetCode AI Interview Tutor", "description": "AI-powered LeetCode tutor: adaptive hints, approach feedback, and interview coaching \u2014 built right into your editor.", "version": "1.0.7", "icons": {"16": "icons/nudge-16.png", "32": "icons/nudge-32.png", "48": "icons/nudge-48.png", "128": "icons/nudge-128.png"}, "permissions": ["storage", "identity", "scripting", "sidePanel"], "host_permissions": ["https://trynudge.dev/*", "https://leetcode.com/*", "https://leetcode.cn/*"], "action": {"default_title": "Open Nudge", "default_icon": {"16": "icons/nudge-16.png", "32": "icons/nudge-32.png", "48": "icons/nudge-48.png", "128": "icons/nudge-128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://leetcode.cn/*", "https://leetcode.com/*"], "run_at": "document_idle", "js": ["content-scripts/leetcode.js"]}]}