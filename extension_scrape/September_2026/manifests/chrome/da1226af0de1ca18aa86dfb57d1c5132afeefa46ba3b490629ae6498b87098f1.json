{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PR Review Tracker", "version": "0.1.0", "description": "Never lose your place reviewing a big GitHub pull request. Persistent per-file checkboxes and a progress bar, 100% local.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://github.com/*"], "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["content_script.js"], "css": ["content_style.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "pr-review-tracker@tomciohq.dev", "strict_min_version": "109.0"}}}