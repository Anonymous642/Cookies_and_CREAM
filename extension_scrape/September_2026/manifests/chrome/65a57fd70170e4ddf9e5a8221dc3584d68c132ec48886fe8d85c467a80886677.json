{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Summary Copy & Paste", "version": "1.0.3", "description": "Copy any URL with an AI-generated summary. Supports Claude, OpenAI, and Gemini.", "permissions": ["contextMenus", "activeTab", "storage", "clipboardWrite", "scripting"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"generate-summary": {"description": "Generate AI summary and copy to clipboard"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}