{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Profile Keyword Filter", "version": "0.2.0", "description": "Hide tweets on x.com when an author's bio or public profile metadata matches registered keywords.", "homepage_url": "https://github.com/hexarf/x-profile-keyword-filter", "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://www.x.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "X Profile Keyword Filter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://www.x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}