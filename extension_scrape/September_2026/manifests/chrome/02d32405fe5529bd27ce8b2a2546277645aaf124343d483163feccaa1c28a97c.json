{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TryGoNo", "version": "0.1.3", "description": "AI-powered job application assistant. Analyze job descriptions, get match scores, and generate cover letters.", "permissions": ["storage", "activeTab", "sidePanel", "tabs", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://www.indeed.com/*", "https://trygono.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.indeed.com/viewjob*"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "TryGoNo"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}