{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Producktive", "version": "1.0", "description": "Spawns flying ducks to stop procrastination when you're on unproductive sites for too long.", "icon": "assets/icon128.png", "permissions": ["tabs", "storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "assets/icon128.png"}, "icons": {"128": "assets/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["ducks/*.png", "ducks/*.jpg", "assets/*.mp3", "assets/*.png"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "options_page": "popup.html"}