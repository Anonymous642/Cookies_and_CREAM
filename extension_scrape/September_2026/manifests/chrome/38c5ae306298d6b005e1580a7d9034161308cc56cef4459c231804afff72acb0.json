{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notion Quick Save", "version": "1.0.0", "description": "Text snippets, screenshots, URLs straight to any Notion page. Set once, save endlessly. Built for research.", "permissions": ["activeTab", "storage", "scripting", "identity", "tabs"], "host_permissions": ["https://api.notion.com/*", "https://api.imgur.com/*", "https://*/*"], "action": {"default_icon": {"16": "assets/icons/icon128.png", "48": "assets/icons/icon128.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "all_frames": false, "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icons/icon128.png", "48": "assets/icons/icon128.png", "128": "assets/icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Open Notion Quick Save popup"}, "add_source": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Add current page as source to Notion"}, "select_area": {"suggested_key": {"default": "Ctrl+Shift+7", "mac": "Command+Shift+7"}, "description": "Select area for screenshot"}}, "web_accessible_resources": [{"resources": ["popup.html"], "matches": ["https://*/*", "http://*/*"]}]}