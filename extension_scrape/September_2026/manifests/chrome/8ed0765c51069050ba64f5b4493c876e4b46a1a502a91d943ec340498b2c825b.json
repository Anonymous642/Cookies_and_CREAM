{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FormSaver", "version": "1.0.0", "description": "Automatically save your unfinished web forms locally and recover them when something goes wrong. No cloud, no account, 100% private.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "FormSaver \u2014 Never lose what you typed."}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/field-matcher.js", "content/form-detector.js", "content/observer.js", "content/recovery.js", "content/content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/content.css"], "matches": ["http://*/*", "https://*/*"]}], "permissions": ["storage", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "incognito": "not_allowed"}