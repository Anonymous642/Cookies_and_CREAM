{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Squirrel Surprise", "version": "0.2.0", "description": "Click or press Alt+Shift+S: a squirrel appears in one of nine seasonal scenes, spots you watching, and bolts.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Squirrel! (Alt+Shift+S)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage"], "commands": {"show-squirrel": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Show the squirrel"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["assets/scenes/*"], "matches": ["<all_urls>"]}]}