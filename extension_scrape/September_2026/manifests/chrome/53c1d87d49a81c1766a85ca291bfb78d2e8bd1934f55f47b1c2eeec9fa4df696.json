{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mimi's Tab Manager - Chrome Tab Organizer", "version": "1.0.7", "description": "Clear browser, clean mind. Organize your tabs with Mimi's help! Maintain a clutter-free browser.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "alarms", "bookmarks"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "Mimi's Smart Tab Organizer"}}