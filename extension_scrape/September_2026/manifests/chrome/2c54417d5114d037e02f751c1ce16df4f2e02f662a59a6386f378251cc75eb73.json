{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BugShot", "version": "2.1.0", "description": "Capture any UI element and file a rich GitHub issue with screenshot, selector, and page context \u2014 in seconds.", "homepage_url": "https://github.com/neerajgrg/bugshot", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://*/*", "http://*/*", "https://api.github.com/*"], "commands": {"activate-picker": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Pick a page element to file a bug"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}