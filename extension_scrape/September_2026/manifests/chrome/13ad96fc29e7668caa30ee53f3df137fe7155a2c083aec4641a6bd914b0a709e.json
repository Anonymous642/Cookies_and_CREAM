{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Media Time Tracker", "version": "1.5", "description": "Track time spent on Facebook, YouTube, Instagram, Twitter/X and reset the time daily.", "permissions": ["storage", "activeTab", "alarms"], "background": {"service_worker": "background.js"}, "host_permissions": ["*://www.facebook.com/*", "*://www.youtube.com/*", "*://www.instagram.com/*", "*://x.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon/icon48.png", "default_title": "Social Media Time Tracker"}, "icons": {"16": "icon/icon16.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "content_scripts": [{"matches": ["*://www.facebook.com/*", "*://www.youtube.com/*", "*://www.instagram.com/*", "*://x.com/*"], "js": ["content.js"], "run_at": "document_end"}]}