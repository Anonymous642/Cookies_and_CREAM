{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ItsMeHere Meeting Recorder", "version": "1.0.0", "description": "Record online meetings (Google Meet, Microsoft Teams, Zoom) and generate AI transcripts and minutes.", "minimum_chrome_version": "116", "action": {"default_popup": "src/popup/popup.html", "default_title": "Record meeting"}, "background": {"service_worker": "background/index.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "tabs", "alarms"], "host_permissions": ["https://itsmehere.com/*", "https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/*"], "content_scripts": [{"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/*"], "js": ["content/meeting-detector.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/offscreen/offscreen.html", "src/recorder/recorder.html", "src/permission/permission.html", "assets/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}