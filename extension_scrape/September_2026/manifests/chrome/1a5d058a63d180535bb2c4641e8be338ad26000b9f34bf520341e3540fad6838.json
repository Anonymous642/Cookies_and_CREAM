{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Illuminate", "version": "1.0.17", "description": "See the world in your language. Select any area on your screen to extract and translate text instantly.", "homepage_url": "https://illuminatepro.app/", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "offscreen", "storage", "contextMenus", "unlimitedStorage"], "host_permissions": ["<all_urls>", "https://illuminatepro.app/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css", "subscription.css"], "all_frames": true}], "web_accessible_resources": [{"resources": ["lib/*.js", "lib/*.wasm", "icons/*.png"], "matches": ["<all_urls>"]}], "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture and select an area to translate"}}}