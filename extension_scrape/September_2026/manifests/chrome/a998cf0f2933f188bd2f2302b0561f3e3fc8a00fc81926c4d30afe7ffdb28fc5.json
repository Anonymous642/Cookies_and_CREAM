{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SummaryLens - Discussion Intelligence", "version": "2.2.0", "description": "Understand Reddit and YouTube discussions with private, on-device AI: structured summaries, positions, insights and source comments.", "permissions": ["storage", "sidePanel", "scripting"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://www.youtube.com/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "SummaryLens - Discussion Intelligence", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.reddit.com/r/*/comments/*", "https://old.reddit.com/r/*/comments/*", "https://www.youtube.com/watch?v=*", "https://www.youtube.com/shorts/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}