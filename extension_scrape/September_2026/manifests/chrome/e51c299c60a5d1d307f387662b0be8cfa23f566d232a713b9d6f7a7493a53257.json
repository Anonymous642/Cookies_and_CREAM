{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipFlow", "description": "Privacy-first clipboard manager \u2014 save text, links & images. Pin, search, export.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "sidePanel", "clipboardRead", "clipboardWrite", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open ClipFlow popup (over browser, no slide)"}, "open_sidepanel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open ClipFlow side panel"}, "save_selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current selection to ClipFlow"}, "toggle_extension": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Show / hide ClipFlow (toggle side panel)"}}, "action": {"default_title": "ClipFlow", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": false, "run_at": "document_end", "js": ["content-scripts/content.js"]}]}