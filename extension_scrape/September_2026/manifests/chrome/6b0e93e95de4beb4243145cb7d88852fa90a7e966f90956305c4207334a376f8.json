{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spiff", "version": "3.2.0", "description": "Scrape a vehicle from a dealership page and auto-fill the Facebook Marketplace vehicle listing form for review.", "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"], "host_permissions": ["https://www.facebook.com/*", "https://spiff-backend-pclm.onrender.com/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Spiff \u2014 click to open on this page", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/create/vehicle*"], "js": ["fb_fill.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}