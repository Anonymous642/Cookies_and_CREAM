{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Text Capture", "description": "Local-first OCR for copying visible text from videos, images, PDFs, and protected pages.", "version": "1.1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_title": "Smart Text Capture", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/serviceWorker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus", "clipboardWrite", "offscreen", "notifications"], "side_panel": {"default_path": "sidepanel/index.html"}, "host_permissions": ["https://smarttextcapture.anhbui.dev/*"], "externally_connectable": {"matches": ["https://smarttextcapture.anhbui.dev/*"]}, "commands": {"capture-area": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture visible text from an area"}, "toggle-result-panel": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Show or hide the OCR results panel"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture text from the visible page"}, "open-history": {"description": "Open Smart Text Capture history"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "options_page": "options/index.html"}