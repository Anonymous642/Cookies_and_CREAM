{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Apply Forge", "description": "Free, private cover letters for LinkedIn, Seek & Trade Me. Resumes per job coming soon.", "version": "0.0.1", "short_name": "Apply Forge", "icons": {"16": "apply-forge-icon-16.png", "32": "apply-forge-icon-32.png", "48": "apply-forge-icon-48.png", "96": "icon/96.png", "128": "apply-forge-icon-128.png"}, "action": {"default_title": "Apply Forge"}, "permissions": ["storage"], "web_accessible_resources": [{"resources": ["auth.html"], "matches": ["<all_urls>"]}, {"resources": ["options.html"], "matches": ["<all_urls>"]}, {"resources": ["assets/*.js", "seek-bridge.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*", "*://*.seek.co.nz/job/*/apply*", "*://*.trademe.co.nz/a/jobs/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}