{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat PDF Exporter - Save ChatGPT & Claude As PDF", "version": "1.0.0", "description": "Export AI conversations from ChatGPT, Claude & Perplexity as high-quality PDFs. Save code blocks, formatting & tables intact.", "icons": {"16": "assets/icon16.svg", "32": "assets/icon32.svg", "48": "assets/icon48.svg", "128": "assets/icon128.svg"}, "action": {"default_title": "Export to PDF", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.svg", "32": "assets/icon32.svg", "48": "assets/icon48.svg", "128": "assets/icon128.svg"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*"], "js": ["content-scripts/extractOpenAI.js"]}, {"matches": ["https://www.perplexity.ai/*"], "js": ["content-scripts/extractPerplexity.js"]}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/extractClaude.js"]}], "permissions": ["activeTab", "contextMenus", "downloads", "storage", "identity"], "host_permissions": ["https://chat.openai.com/*", "https://www.perplexity.ai/*", "https://claude.ai/*"], "options_page": "options/options.html", "oauth2": {"client_id": "${GOOGLE_CLIENT_ID}", "scopes": ["https://www.googleapis.com/auth/drive.file"]}}