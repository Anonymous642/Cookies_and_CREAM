{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pricegeist", "version": "0.1.0", "description": "Shows cheaper used-price options on Amazon product pages when available.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": [], "host_permissions": ["https://www.amazon.com/*"], "content_scripts": [{"matches": ["https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*"], "js": ["content.js"], "run_at": "document_idle"}]}