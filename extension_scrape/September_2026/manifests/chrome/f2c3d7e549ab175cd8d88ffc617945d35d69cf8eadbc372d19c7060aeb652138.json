{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ScreenCalm", "description": "Reduce screen motion, contrast, and visual noise for people with screen intolerance.", "version": "1.0.0", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_title": "ScreenCalm Settings"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "scripts/background.js"}, "commands": {"toggle-screencalm": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle screen overlays on current tab"}, "toggle-options": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open settings panel"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/shared.js", "scripts/content.js"], "css": ["styles/shared.css"]}], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icons/icon-settings-btn.svg"]}], "icons": {"16": "icons/icon32.png", "32": "icons/icon64.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}}