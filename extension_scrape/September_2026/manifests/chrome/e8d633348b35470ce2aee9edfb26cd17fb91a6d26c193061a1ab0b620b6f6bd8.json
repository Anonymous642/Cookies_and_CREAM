{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WPoptic | WordPress Theme Detector and Plugins Detector", "version": "2.1.0", "description": "Instantly detect WordPress plugins and themes used on any website.", "action": {"default_popup": "index.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "WPoptic 2.1.0"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "webRequest", "scripting", "storage", "alarms", "identity", "identity.email"], "host_permissions": ["http://*/*", "https://*/*", "https://*.sentry.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["wasm/wasm_exec.js", "wasm/scanner.wasm", "output.css", "modules/pow-worker.js"], "matches": ["<all_urls>"]}, {"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.sentry.io http://* https://*"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*/wp-admin/*", "*://*/wp-login.php*"], "js": ["scripts/wordpress-detector.js"], "run_at": "document_idle"}]}