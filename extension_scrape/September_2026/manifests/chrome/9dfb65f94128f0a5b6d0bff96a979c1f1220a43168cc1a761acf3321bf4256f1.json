{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Perch", "description": "Jump to the tab that needs you \u2014 track AI chats, club tabs by site, and watch the ones you set aside. Inspired by herdr.", "version": "0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "notifications"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*"], "action": {"default_title": "Perch \u2014 open dashboard"}, "commands": {"toggle-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle the command palette"}, "open-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the side panel dashboard"}, "jump-next-attention": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Jump to the next tab that needs attention"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/agents.js"]}, {"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/palette.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/palette.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}