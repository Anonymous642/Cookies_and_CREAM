{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemFreeze \u2014 Smart Tab Manager", "short_name": "MemFreeze", "version": "1.0.0", "description": "Auto-manage tabs to free memory. Idle thresholds, tab groups, duplicate detection, search, and closed group restore.", "homepage_url": "https://zeeesh.com", "permissions": ["tabs", "alarms", "storage", "tabGroups", "sessions"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "MemFreeze \u2014 Smart Tab Manager"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open command palette"}, "discard-current-tab": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Set current tab idle"}, "discard-all-tabs": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Set all tabs idle in current window"}}, "minimum_chrome_version": "116"}