{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Human Doc Typer", "version": "1.6.0", "description": "Types text into Google Docs with realistic typos that get corrected, at a speed you choose.", "permissions": ["storage", "tabs", "scripting", "debugger"], "host_permissions": ["https://docs.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Human Doc Typer", "default_popup": "popup.html"}, "commands": {"start-typing": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Start typing saved text into the Google Doc (click in the doc first)"}}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["doc-panel.js"], "run_at": "document_idle", "all_frames": false}]}