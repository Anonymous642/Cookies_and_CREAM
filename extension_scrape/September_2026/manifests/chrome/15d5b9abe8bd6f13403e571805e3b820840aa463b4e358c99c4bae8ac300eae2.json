{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Overview", "version": "1.0.1", "description": "See tabs in your current window as a grid of thumbnails, like Safari's Tab Overview.", "permissions": ["tabs", "storage", "unlimitedStorage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Tab Overview"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+0"}, "description": "Show Tab Overview"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}