{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BLAqua", "description": "Play a fishing game while enjoying your Twitter/X Newsfeed and earn yield ($QUA, $ETH token) on Blast.", "version": "2.3", "icons": {"16": "icons/MAIN_LOGO.png", "48": "icons/MAIN_LOGO.png", "128": "icons/MAIN_LOGO.png"}, "permissions": ["tabs", "storage", "cookies"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://blaqua.fish/*", "https://www.blaqua.fish/*", "http://localhost:8080/reload/", "http://*/*", "https://*/*", "https://blaqua.s3.ap-southeast-1.amazonaws.com/*"], "background": {"service_worker": "js/background.js"}, "action": {"default_icon": "icons/MAIN_LOGO.png", "default_title": "Extension Popup", "default_popup": "html/popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://blaqua.s3.ap-southeast-1.amazonaws.com/"], "js": ["js/contentScripts.js"], "css": ["css/contentScripts.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["images/*", "fonts/*", "icons/*", "js/*", "css/*", "html/*"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "88"}