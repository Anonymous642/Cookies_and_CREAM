{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flick \u2014 swipe your inbox to zero", "version": "0.3.1", "description": "Your Flick triage deck in Chrome's side panel. Four verbs, two minutes, done. Requires a Flick account; never reads your mailbox.", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "alarms", "identity"], "host_permissions": ["https://app.flicked.email/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open Flick"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"open-flick": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open your Flick deck"}}}