{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Garuda Grab - Download Manager", "description": "Download manager with auto-filing, resource sniffing, batch downloads, and queue management.", "version": "0.5.1", "icons": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}, "minimum_chrome_version": "120", "action": {"default_icon": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}}, "permissions": ["downloads", "downloads.open", "downloads.ui", "storage", "contextMenus", "webRequest", "alarms", "notifications", "scripting", "offscreen", "sidePanel"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Open Garuda side panel"}, "toggle-pause-all": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume all downloads"}}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/scanner.js"]}]}