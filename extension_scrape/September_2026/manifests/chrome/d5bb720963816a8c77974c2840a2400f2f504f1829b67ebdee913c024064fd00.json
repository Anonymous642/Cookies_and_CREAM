{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Notes for YouTube | Timestamped Notes", "version": "3.1.0", "description": "Timestamped notes on any YouTube video. Export to Obsidian, Notion, or Markdown. 100% local, no account needed.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "optional_permissions": ["unlimitedStorage"], "optional_host_permissions": ["https://video-notes-for-youtube.onrender.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Video Notes for YouTube", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/Inter-roman.var.woff2"], "matches": ["*://*.youtube.com/*"]}]}