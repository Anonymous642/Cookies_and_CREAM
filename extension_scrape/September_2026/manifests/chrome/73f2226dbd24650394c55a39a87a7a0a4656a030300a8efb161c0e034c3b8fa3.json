{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DOM Snapshot & Diff", "version": "1.1.4", "description": "Capture, compare, and manage DOM snapshots with encrypted storage", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "alarms"], "host_permissions": ["<all_urls>", "https://license-api.smb-base.com/*", "https://license-management.smb-base.com/*", "http://license-api.smb-base.local:8000/*", "http://localhost:8000/*"], "commands": {"capture-snapshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture DOM snapshot of current tab"}, "quick-diff": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Quick diff with last snapshot"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline';"}}