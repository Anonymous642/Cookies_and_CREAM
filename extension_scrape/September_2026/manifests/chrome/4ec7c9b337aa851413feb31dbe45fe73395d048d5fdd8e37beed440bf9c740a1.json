{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Currency Converter with Tax Refund \u00b7 Homeprice", "version": "1.0.0", "description": "Converts prices on any site into your currency, shows the real price on hover, and estimates your tourist tax refund.", "permissions": ["storage", "alarms"], "host_permissions": ["https://cdn.jsdelivr.net/*", "https://latest.currency-api.pages.dev/*", "https://api.frankfurter.app/*"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_idle", "css": ["src/content/content.css"], "js": ["src/core/currencies.js", "src/core/parse.js", "src/core/convert.js", "src/core/vat.js", "src/core/settings.js", "src/core/rates-seed.js", "src/core/render.js", "src/content/content.js"]}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Homeprice", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-homeprice": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Turn price conversion on or off for this page"}}, "homepage_url": "https://homeprice.nimit.dev"}