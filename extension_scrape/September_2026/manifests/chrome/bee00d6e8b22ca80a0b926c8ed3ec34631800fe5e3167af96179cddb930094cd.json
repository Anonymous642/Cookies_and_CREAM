{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Extex", "version": "1.3.1", "author": "Extex", "description": "This extension is used to attempt the coursera course quiz, video, reading material, ungraded plugin and discussion automatically.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "activeTab", "tabs", "commands"], "background": {"service_worker": "scripts/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "options_page": "settings.html", "content_scripts": [{"run_at": "document_start", "matches": ["*://*.coursera.org/*"], "js": ["scripts/config.js", "scripts/extensionBackend.js", "scripts/content.js", "scripts/xyz.js", "scripts/courseraExtractor.js"], "css": ["styles/content.css"]}], "commands": {"open_popup_1": {"suggested_key": {"default": "Alt+B", "mac": "Command+B"}, "description": "Open the Course Automation Extension popup window with Alt+B"}, "open_popup_2": {"suggested_key": {"default": "Alt+W", "mac": "Command+W"}, "description": "Open the Course Automation Extension popup window with Alt+W"}}, "web_accessible_resources": [{"resources": ["scripts/rdr.js", "scripts/config.js"], "matches": ["*://*.coursera.org/*"]}], "host_permissions": ["*://*.coursera.org/*", "https://sattabazarstarline.com/*", "https://api.sattabazarstarline.com/*", "https://extex.vercel.app/*"]}