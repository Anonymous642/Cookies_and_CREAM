{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CatBlocker \u2014 Replace Ads with Cats", "description": "Hides ads and replaces them with wholesome cat pictures. Toggle, whitelist, and live counter included.", "version": "1.3.0", "action": {"default_popup": "popup/popup.html", "default_title": "CatBlocker"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": []}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["common.js", "content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["cats/*.jpg", "icons/icon-128.png"], "matches": ["<all_urls>"]}], "options_page": "options/options.html", "commands": {"replace-now": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "CatBlocker: Replace ads on this page"}}}