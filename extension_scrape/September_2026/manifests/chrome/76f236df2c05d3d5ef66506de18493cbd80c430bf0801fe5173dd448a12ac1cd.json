{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RealityCheck", "short_name": "RealityCheck", "version": "1.0.0", "description": "Exposes hype, manipulation, and hidden incentives on any webpage. Powered by your own Anthropic API key.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.anthropic.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}, "default_title": "RealityCheck \u2014 expose manipulation on this page"}, "icons": {"128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "116"}