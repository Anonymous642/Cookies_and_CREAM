{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NotionHighlighter - web page highlight, annotate, screenshot to Notion", "permissions": ["storage", "tabs", "identity", "commands", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "options_page": "options.html", "background": {"service_worker": "background.bundle.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["contentScript.bundle.js"], "css": ["content.styles.css"]}], "devtools_page": "devtools.html", "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+W", "mac": "Ctrl+W"}, "description": "Take screenshot of selected area", "global": true}}, "web_accessible_resources": [{"resources": ["content.styles.css", "icon-128.png", "icon-34.png", "history.html", "history.bundle.js"], "matches": ["<all_urls>"]}], "description": "Web highlighter Chrome extension with Notion sync", "version": "5.1.0"}