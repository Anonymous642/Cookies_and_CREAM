{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MaxDM \u2013 Video & Media Download Manager", "short_name": "MaxDM", "version": "4.2.0", "description": "Download video, audio, thumbnails and transcripts from supported sites with live progress, history and local media merging.", "permissions": ["downloads", "storage", "declarativeNetRequest", "scripting", "tabs", "offscreen", "power", "webRequest", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "MaxDM", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content/youtube-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/video-overlay.js"], "css": ["content/video-overlay.css"], "run_at": "document_start"}], "minimum_chrome_version": "111", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "youtube_headers", "enabled": true, "path": "rules/youtube-headers.json"}]}}