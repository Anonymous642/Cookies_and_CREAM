{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FollowThroo for LinkedIn", "short_name": "FollowThroo", "version": "3.3.1", "description": "Save people from LinkedIn into your FollowThroo CRM. Reads only \u2014 connection requests are sent by the FollowThroo desktop app.", "homepage_url": "https://followthroo.com", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "scripting", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://app.followthroo.com/*"], "optional_host_permissions": ["http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "FollowThroo for LinkedIn", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}