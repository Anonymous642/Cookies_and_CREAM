{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProjectX", "version": "1.1.0", "description": "Capture any UI element from the web, extract its code, and generate AI-ready prompts", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ProjectX - Capture UI Elements"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["activeTab", "storage", "sidePanel", "scripting", "notifications"], "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-selector": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle element selector"}}}