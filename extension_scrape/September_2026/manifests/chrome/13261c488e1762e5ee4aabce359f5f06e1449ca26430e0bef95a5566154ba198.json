{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HoloCloset", "version": "1.0.0", "description": "Capture clothing from any online store and send to HoloCloset (holocloset.com). Build your digital closet and see outfits.", "permissions": ["activeTab", "storage", "contextMenus", "scripting", "notifications"], "host_permissions": ["https://www.holocloset.com/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://www.holocloset.com/*"], "js": ["content/content.js"], "css": ["assets/styles/content.css"]}], "action": {"default_title": "Capture to HoloCloset"}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.holocloset.com/*"]}]}