{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kimchigoose AI Translator", "description": "Capture any region on a webpage or image, extract text with OCR, and translate it inline or in the side panel.", "version": "1.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_locale": "en", "permissions": ["activeTab", "contextMenus", "offscreen", "sidePanel", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["tesseract/*"], "matches": ["<all_urls>"]}], "commands": {"activate-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Activate region selection for OCR translation"}, "inline-translate": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Select region and show inline translation overlay"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}}}, "action": {"default_title": "Kimchigoose AI Translator", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}