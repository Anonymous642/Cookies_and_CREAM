{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextBoost-AI", "version": "2.0.0", "description": "Right-click in any editable field to rewrite, summarize, or expand text using AI.", "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "optional_host_permissions": ["https://generativelanguage.googleapis.com/*", "https://openrouter.ai/api/*", "https://api.openai.com/*", "https://api.deepseek.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "TextBoost AI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"ai-quick-rewrite": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Quick rewrite"}, "ai-quick-rewrite-alt": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Quick rewrite (alternate shortcut)"}, "ai-summarize": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Summarize"}, "ai-expand": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Write in detail"}}}