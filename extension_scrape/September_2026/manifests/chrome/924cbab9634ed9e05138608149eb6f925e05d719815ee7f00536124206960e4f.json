{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "inreer", "version": "1.1.0", "description": "inreer is an AI-powered one-click solution to analyze LinkedIn jobs against resume. The goal is to give users job-match insights", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "64": "icon.png", "128": "icon.png"}, "action": {"default_icon": {"16": "icon.png", "24": "icon.png", "32": "icon.png"}, "default_title": "Click to open panel"}, "permissions": ["sidePanel", "tabs", "scripting", "storage"], "side_panel": {"default_path": "sidepanel.html"}, "host_permissions": ["https://*.linkedin.com/jobs/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/search/*", "https://*.linkedin.com/jobs/collections/*", "https://*.linkedin.com/jobs/view/*"], "js": ["shared-vendor.js", "contentScript.js"]}], "web_accessible_resources": [{"resources": ["shared-vendor.js", "contentScript.js"], "matches": ["https://*.linkedin.com/*"]}]}