{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SourceHawk Scout: Eligibility Checker", "version": "1.6.0", "description": "SellerAmp SAS overlay: per-product eligibility badges, live storefront filters, and a bulk ASIN eligibility checker.", "homepage_url": "https://sourcehawk.fleczona.com", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SourceHawk Scout"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://sas.selleramp.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"__comment": "Seller Central turned product search into a JavaScript app, so the eligibility data no longer sits at a fixed address. sc_observe runs in the page world (the only place the app's own calls are visible) and reports the address to sc_bridge; no new host access is involved, sellercentral.amazon.com is already required for the check itself.", "matches": ["https://sellercentral.amazon.com/*"], "js": ["sc_observe.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://sellercentral.amazon.com/*"], "js": ["sc_bridge.js"], "run_at": "document_start"}], "permissions": ["storage", "alarms", "identity"], "host_permissions": ["https://sas.selleramp.com/*", "https://sellercentral.amazon.com/*", "https://sheets.googleapis.com/*", "https://www.googleapis.com/*", "https://api.polar.sh/*"], "web_accessible_resources": [{"resources": ["icons/icon48.png", "icons/icon128.png", "overlay.css"], "matches": ["https://sas.selleramp.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "oauth2": {"client_id": "251344331015-dvod4eiidjp809ef1dfnk845bhpo2e3f.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}}