{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "swish", "version": "1.0.1", "description": "Sort, group, deduplicate, and undo changes to tabs in your current Chrome window using the popup or keyboard shortcuts.", "permissions": ["tabs", "storage", "tabGroups"], "background": {"service_worker": "background.js"}, "action": {"default_title": "swish", "default_popup": "src/popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "options_page": "src/options.html", "commands": {"sort-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Sort tabs in current window"}, "dedupe-tabs": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Close duplicate tabs in current window"}, "undo-sort": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Undo last tab sort"}, "group-tabs": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Group tabs by topic"}}}