{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grade Tracker", "version": "1.0", "description": "Tracks your grades from Brightspace and Canvas", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.brightspace.com/*", "*://*.instructure.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.brightspace.com/*"], "js": ["content-scripts/brightspace.js"]}, {"matches": ["*://*.instructure.com/*"], "js": ["content-scripts/canvas.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}