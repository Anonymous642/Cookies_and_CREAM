{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabIQ", "version": "2.0.0", "description": "AI-powered tab grouping with privacy-first design", "permissions": ["tabs", "tabGroups", "storage", "activeTab", "scripting"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "TabIQ", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/privacy-consent.js", "content/content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "homepage_url": "https://github.com/IMohitsai/TabIQ", "author": "Mohit Sai"}