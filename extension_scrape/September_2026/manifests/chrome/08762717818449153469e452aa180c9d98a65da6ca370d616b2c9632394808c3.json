{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JoyHob Sync", "description": "Exporta tu historial de Prime Video y tus logros de Exophase a un JSON para importar en JoyHob. No afiliada a esas plataformas.", "version": "0.1.0", "short_name": "JoyHob Sync", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "sync@joyhob.com", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://*.primevideo.com/*", "*://*.exophase.com/*", "*://*.joyhob.com/*"], "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "JoyHob Sync", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.exophase.com/user/*"], "js": ["content-scripts/exophase.js"]}, {"matches": ["*://*.joyhob.com/*"], "js": ["content-scripts/joyhob-bridge.js"]}, {"matches": ["*://*.primevideo.com/settings/watch-history*"], "js": ["content-scripts/prime-video.js"]}]}