{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Design Prompt Bridge", "version": "2.0.0", "description": "Turn reference images into structured prompts and copyable prompt layers.", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs"], "host_permissions": ["https://dpb-api.vibecodingsolution.ovh/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Design Prompt Bridge", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open Design Prompt Bridge panel"}, "analyze-largest-image": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Analyze the largest visible image"}, "crop-screenshot": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Analyze a screenshot crop"}}}