{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Suspender", "version": "15.2.2", "description": "Suspend inactive tabs. Save memory. Keeps the site logo. Video timecode. AI-aware. Private by design.", "permissions": ["tabs", "storage", "alarms", "scripting", "contextMenus", "commands", "activeTab", "favicon", "system.memory"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"suspend-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Suspendre / restaurer l'onglet actif"}, "suspend-all": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Suspendre tous les autres onglets"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["suspended.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}