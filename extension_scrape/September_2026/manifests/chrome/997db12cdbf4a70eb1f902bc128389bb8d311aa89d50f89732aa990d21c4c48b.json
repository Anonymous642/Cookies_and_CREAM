{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HaloUtils", "short_name": "HaloUtils", "description": "HaloITSM tools for faster navigation, update-set capture, rollback planning, and multi-instance administration.", "version": "0.22.2", "author": "HaloUtils", "minimum_chrome_version": "114", "permissions": ["activeTab", "alarms", "notifications", "scripting", "sidePanel", "storage", "tabs", "webRequest"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/worker/index.js", "type": "module"}, "side_panel": {"default_path": "src/sidebar/index.html"}, "options_page": "src/options/index.html", "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Open Halo side panel"}, "start-update-set": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start Halo update set recording"}, "stop-update-set": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop Halo update set recording"}, "mark-current-page": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Pin current Halo page to active update set"}, "capture-page-metadata": {"description": "Capture current Halo page metadata"}, "open-mutation-inspector": {"description": "Open current page mutation inspector"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["https://*/*"]}]}