{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shhh YouTube", "version": "1.0", "description": "Gives you the ability to turn off recommended videos on the YouTube home page and recommended videos while watching other videos.", "icons": {"16": "study.png", "48": "study.png", "128": "study.png"}, "action": {"default_icon": "study.png", "default_title": "Shhh YouTube", "default_popup": "popup.html"}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}