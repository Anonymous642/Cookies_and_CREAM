{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Riff Repeater", "version": "0.1.0", "description": "Create hotkeys for YouTube video timestamps to easily repeat sections of the video.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://us.i.posthog.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["assets/*.svg", "assets/*.jpg", "assets/images/*"], "matches": ["<all_urls>"]}]}