{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cuememo", "description": "Quickly log into Cuememo and access your cue-based notes.", "version": "1.0.0", "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Cuememo", "default_icon": {"16": "src/icons/not-recording.png", "24": "src/icons/not-recording.png", "32": "src/icons/not-recording.png", "48": "src/icons/not-recording.png", "128": "src/icons/not-recording.png"}}, "permissions": ["storage", "tabCapture", "tabs", "offscreen"], "host_permissions": ["https://cuememo.ai/*"], "web_accessible_resources": [{"resources": ["src/offscreen/index.html", "src/permission/index.html", "src/icons/recording.png", "src/icons/not-recording.png"], "matches": ["<all_urls>"]}]}