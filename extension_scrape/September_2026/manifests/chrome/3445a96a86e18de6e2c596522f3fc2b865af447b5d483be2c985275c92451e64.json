{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTChat AI", "version": "1.0.0", "description": "AI assistant for YouTube videos with OpenAI integration", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "YTChat AI"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["direct.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["contentScript.css", "assets/*"], "matches": ["*://*.youtube.com/*"]}], "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"]}