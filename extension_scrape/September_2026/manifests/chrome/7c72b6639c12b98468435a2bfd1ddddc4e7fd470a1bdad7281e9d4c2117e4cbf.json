{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OfflineRedact \u2014 PII Detection & Redaction", "description": "Automatically detects and redacts sensitive data (PII) before sharing with ChatGPT, Gmail, and other cloud services.", "version": "1.0.1", "icons": {"16": "/icons/icon-16.png", "48": "/icons/icon-48.png", "128": "/icons/icon-128.png"}, "permissions": ["storage", "alarms", "cookies"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://notion.so/*", "https://app.slack.com/*", "https://discord.com/*", "https://offlineredact.com/*"], "web_accessible_resources": [{"resources": ["dictionaries/*.json"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://notion.so/*", "https://app.slack.com/*", "https://discord.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "PDFcensor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://app.slack.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://discord.com/*", "https://gemini.google.com/*", "https://mail.google.com/*", "https://notion.so/*", "https://outlook.live.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://offlineredact.com/*"], "run_at": "document_idle", "js": ["content-scripts/offlineredact-auth.js"]}]}