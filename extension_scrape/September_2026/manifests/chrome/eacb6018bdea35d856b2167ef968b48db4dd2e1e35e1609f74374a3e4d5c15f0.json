{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unfollowers Tracker for IG", "version": "1.0.0", "description": "See who doesn't follow you back on Instagram and track who unfollowed you over time. Read-only and fully local.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open Unfollowers Tracker", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://www.instagram.com/*", "https://api.polar.sh/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}