{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save Tabs \u2013 Workspace Manager", "version": "2.0.4", "description": "Save your open tabs into named project workspaces. Switch, restore, and organize your browser in one click. Free, local-first.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "128": "images/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "unlimitedStorage", "tabs", "windows", "activeTab"], "host_permissions": ["https://tabworkspace-api.vuvuive.org/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://tabworkspace-api.vuvuive.org"}}