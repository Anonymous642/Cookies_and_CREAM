{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Accio Prompt!", "version": "1.0.1", "description": "Summon better AI prompts with one click \u00e2\u20ac\u201d for ChatGPT, Gemini, and Claude.", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Accio Prompt!", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage", "identity"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content/shared/dom-utils.js", "content/chatgpt.js"], "css": ["content/button.css"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content/shared/dom-utils.js", "content/gemini.js"], "css": ["content/button.css"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content/shared/dom-utils.js", "content/claude.js"], "css": ["content/button.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/success.html", "popup/cancel.html"], "matches": ["<all_urls>"]}]}