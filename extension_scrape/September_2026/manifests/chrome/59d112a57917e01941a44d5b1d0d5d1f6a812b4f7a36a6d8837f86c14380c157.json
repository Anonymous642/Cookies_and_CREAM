{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nifty", "description": "A nifty little clipboard manager for Chrome", "version": "1.3", "permissions": ["storage", "clipboardWrite", "clipboardRead", "offscreen"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'none';"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/toolbar16.png", "48": "icons/toolbar48.png", "128": "icons/toolbar128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}