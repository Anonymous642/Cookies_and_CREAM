{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Boost Pro", "version": "1.0.0", "description": "Boost tab audio up to 600% with voice enhancement, bass boost, presets, limiter protection and per-tab controls.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "tabs", "storage", "offscreen"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Volume Boost Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-boost": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Command+Shift+B"}, "description": "Toggle audio boost for the active tab"}, "increase-volume": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Increase active tab volume"}, "decrease-volume": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Decrease active tab volume"}}}