{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Auto-Filler for Devs & Testers", "short_name": "Smart Auto-Filler", "version": "1.0.0", "description": "Instantly fill web forms with realistic dummy data using one keyboard shortcut. Built for fast web development and QA testing.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Smart Auto-Filler (Ctrl+Shift+F)"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage"], "commands": {"fill-form": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Auto-fill the current form with random dummy data"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}}}, "minimum_chrome_version": "96"}