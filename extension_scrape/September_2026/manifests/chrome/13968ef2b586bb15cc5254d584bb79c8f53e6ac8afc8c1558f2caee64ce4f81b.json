{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lyrics Copier", "version": "1.0.1", "description": "Copy lyrics from Musixmatch, Genius with one click", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "clipboardWrite"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}, "default_title": "Copy Lyrics", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.musixmatch.com/lyrics/*"], "js": ["extractors/musixmatch.js", "content.js"], "run_at": "document_idle"}, {"matches": ["*://*.genius.com/*-lyrics"], "js": ["extractors/genius.js", "content.js"], "run_at": "document_idle"}]}