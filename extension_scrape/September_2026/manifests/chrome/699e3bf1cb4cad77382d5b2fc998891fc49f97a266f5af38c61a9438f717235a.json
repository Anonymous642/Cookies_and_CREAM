{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Murmr - Murmur it. Done.", "version": "0.10.50", "description": "Murmr drafts polished, send-ready emails in Gmail and Outlook - new threads, replies, and follow-ups, no keyboard needed.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://murmrflow.com/*", "https://www.murmrflow.com/*"], "action": {"default_popup": "popup.html", "default_title": "Murmr", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png", "256": "icon.png"}}, "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://murmrflow.com/*", "https://www.murmrflow.com/*"]}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://murmrflow.com/*", "https://www.murmrflow.com/*"], "js": ["session-sync.js"], "run_at": "document_start"}], "commands": {"murmr-talk": {"suggested_key": {"default": "Alt+Space", "mac": "Alt+Space"}, "description": "Open Murmr widget"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png", "256": "icon.png"}, "web_accessible_resources": [{"resources": ["icon16.png", "icon32.png", "icon48.png", "icon96.png", "icon128.png", "icon.png", "icon512.png"], "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"]}]}