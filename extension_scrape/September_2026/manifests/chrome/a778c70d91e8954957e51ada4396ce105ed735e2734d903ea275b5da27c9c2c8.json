{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenSEO", "description": "Look up any domain's traffic, backlinks and keywords through the open glasser API. No page content is sent.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "alarms"], "host_permissions": ["https://api.glasser.ai/*"], "web_accessible_resources": [{"resources": ["panel.html"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "options_ui": {"open_in_tab": false, "page": "options.html"}, "action": {"default_title": "OpenSEO"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+D"}, "description": "Open OpenSEO for this tab"}}, "background": {"service_worker": "background.js"}}