{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartChat Assistant", "version": "1.0.0", "description": "Professional AI-powered writing assistance for content creation, editing, and enhancement.", "permissions": ["activeTab", "storage", "scripting", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "SmartChat", "default_icon": {"16": "icon-16.png", "32": "icon-16.png", "48": "icon-16.png", "128": "icon-16.png"}}, "icons": {"16": "icon-16.png", "32": "icon-16.png", "48": "icon-16.png", "128": "icon-16.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Open AI Writing Assistant"}, "quick-improve": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Quick improve selected text"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}