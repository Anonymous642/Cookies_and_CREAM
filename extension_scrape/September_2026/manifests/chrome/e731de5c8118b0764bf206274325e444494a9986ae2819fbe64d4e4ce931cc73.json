{"update_url": "https://clients2.google.com/service/update2/crx", "name": "EqualWeb Accessibility Checker", "version": "2.0.0", "description": "EqualWeb Accessibility Checker - Web Accessibility Checker powered by EqualWeb for WCAG 2.2 compliance validation", "manifest_version": 3, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "./images/fav16.png", "32": "./images/fav32.png", "48": "./images/fav64.png", "128": "./images/fav128.png"}, "default_title": "Check Accessibility"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "images/fav16.png", "32": "images/fav32.png", "48": "images/fav64.png", "128": "images/fav128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/axe.min.js", "images/*.png", "images/techIcons/*.png", "assets/js/*.js"], "matches": ["<all_urls>"]}]}