{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lyrla \u2014 Visual Bookmarks & Boards", "version": "1.0.0", "description": "Visual boards, categories, and fast 1-click bookmarks with Lyrla Bird AI assistant and Side Panel access.", "permissions": ["tabs", "storage", "contextMenus", "sidePanel", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "Save to Lyrla"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://lyrla.com/*", "*://*.lyrla.com/*"], "js": ["content/lyrla_bridge.js"], "run_at": "document_idle"}], "omnibox": {"keyword": "ly"}, "commands": {"quick-save": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Quick save active tab to Lyrla"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}