{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitLab SVG Differ", "version": "0.1.0", "description": "Visual diff for SVG files on GitLab merge request pages: 2-up, swipe, and onion-skin comparison.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["*://gitlab.com/*"], "background": {"service_worker": "src/background.js"}, "options_page": "src/options.html", "action": {"default_title": "GitLab SVG Differ options", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://gitlab.com/*/-/merge_requests/*"], "js": ["src/config.js", "src/svg-diff.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}