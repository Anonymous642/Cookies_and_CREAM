{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Response Notifier", "version": "1.0.0", "description": "Get notified with a sound when ChatGPT or Claude finishes generating a response", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "notifications", "scripting", "webRequest"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["chatgpt-detector.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["claude-detector.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["sounds/notification.wav", "icons/icon128.png"], "matches": ["<all_urls>"]}]}