{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pikuuu - Your Browser Pet", "author": "Suryagopal Dhara", "version": "1.0.0", "description": "A virtual pet that lives on your screen. Feed it, pet it, watch it wander and sleep.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Pikuuu - Your Browser Pet"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["pet.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["images/*.png"], "matches": ["<all_urls>"]}]}