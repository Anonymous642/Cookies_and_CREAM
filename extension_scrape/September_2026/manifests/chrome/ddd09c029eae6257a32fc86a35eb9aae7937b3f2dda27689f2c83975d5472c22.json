{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnipStash \u2014 Save & Reuse Text", "short_name": "SnipStash", "version": "1.0.0", "description": "Save text from any text box with one click, grouped by website. Copy it back whenever you need it.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "SnipStash \u2014 saved text", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "commands": {"save-current-field": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the focused text field"}, "open-snippet-picker": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Open the saved-snippets picker on the focused field"}}, "permissions": ["storage", "activeTab", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}