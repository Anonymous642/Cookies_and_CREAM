{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "mr-tracker", "version": "1.0.0", "description": "Track GitLab, GitHub, and Bitbucket merge/pull requests and get notified when their status changes.", "author": {"email": "rajamohanty12345@gmail.com"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Merge Requests"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "options_page": "src/options/options.html", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://gitlab.com/*", "https://api.github.com/*", "https://api.bitbucket.org/*"], "optional_host_permissions": ["https://*/*"]}