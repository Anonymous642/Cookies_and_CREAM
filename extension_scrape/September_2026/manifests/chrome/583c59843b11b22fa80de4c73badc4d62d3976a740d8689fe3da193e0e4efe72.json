{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Session Guardian", "version": "0.1.1", "description": "Never lose your tabs again. Privacy-first tab session manager.", "permissions": ["tabs", "storage", "alarms", "sessions", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Session Guardian", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last saved session"}}}