{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tartol - Save Ads from Facebook Ad Library", "description": "Save ads from the Facebook Ad Library to your Tartol account with one click. Build your swipe file in seconds.", "version": "1.0.59", "manifest_version": 3, "permissions": ["storage", "cookies"], "host_permissions": ["*://*.facebook.com/ads/library*", "*://*.tartol.com/*", "*://tartol.com/*"], "externally_connectable": {"matches": ["https://tartol.com/*", "https://*.tartol.com/*", "http://localhost/*", "http://127.0.0.1/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"js": ["interceptors/fb-inject.js"], "matches": ["*://*.facebook.com/ads/library*"], "run_at": "document_start", "world": "MAIN"}, {"js": ["content-scripts/facebook-ads-library.js"], "matches": ["*://*.facebook.com/ads/library*"], "run_at": "document_start"}, {"js": ["content-scripts/tartol-auth.js"], "matches": ["*://*.tartol.com/*", "*://tartol.com/*"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}