{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "#share2slack", "version": "0.1.0", "description": "#S2S - Instantly share web pages to Slack channels with one click", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "alarms", "tabs"], "host_permissions": ["https://hooks.slack.com/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "#share2slack"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Share current page with #S2S"}, "quick_share": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Quick share to default channel (instant mode)"}}}