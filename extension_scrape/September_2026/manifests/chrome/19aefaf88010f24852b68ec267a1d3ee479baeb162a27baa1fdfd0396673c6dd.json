{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneCraft Tutorial Recorder", "version": "0.1.0", "description": "Record a click-through of your product as screenshots with click points, then turn them into a tutorial video in OneCraft.", "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "OneCraft Tutorial Recorder"}, "commands": {"capture-step": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the current screen as a step"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}