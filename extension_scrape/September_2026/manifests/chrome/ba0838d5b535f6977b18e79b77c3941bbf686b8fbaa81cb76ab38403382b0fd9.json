{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skippr - AI Freelancer Scorer", "version": "1.0.42", "description": "AI scores every freelance service listing on Fiverr, Upwork, Contra and Toptal \u2014 so you hire the right person and skip the rest.", "author": "Skippr", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Skippr"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.upwork.com/*", "https://www.fiverr.com/*", "https://contra.com/*", "https://www.toptal.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "permissions": ["storage", "identity", "alarms"], "host_permissions": ["https://www.upwork.com/*", "https://www.fiverr.com/*", "https://contra.com/*", "https://www.toptal.com/*", "https://*.supabase.co/*", "https://skippr-backend-production.up.railway.app/*"], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.upwork.com/*", "https://www.fiverr.com/*", "https://contra.com/*", "https://www.toptal.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}