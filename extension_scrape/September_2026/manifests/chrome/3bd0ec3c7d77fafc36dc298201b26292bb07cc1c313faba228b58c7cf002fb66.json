{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Optimizer", "version": "1.0.1", "description": "Optimize your prompts for ChatGPT, Claude, and Gemini", "permissions": ["storage", "cookies"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.promptoptimizr.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content-scripts/common.js", "content-scripts/chatgpt.js"], "css": ["content-scripts/common.css"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/common.js", "content-scripts/claude.js"], "css": ["content-scripts/common.css"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/common.js", "content-scripts/gemini.js"], "css": ["content-scripts/common.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "commands": {"optimize-prompt": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Optimize the current prompt"}}}