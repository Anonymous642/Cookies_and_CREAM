{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Note Taker & Meeting Recorder - Vyxora: Record Any Tab", "description": "Record meetings, lectures & browser audio from any tab. Turn recordings into structured AI notes, transcripts, tasks, and mind maps.", "version": "0.2.6", "short_name": "Vyxora", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "127", "permissions": ["activeTab", "cookies", "storage", "unlimitedStorage", "offscreen", "tabCapture", "alarms", "notifications"], "host_permissions": ["https://api.vyxora.app/*", "https://workspace.vyxora.app/*", "https://clerk.vyxora.app/*"], "optional_host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://*.zoom.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_title": "Vyxora Capture", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}}