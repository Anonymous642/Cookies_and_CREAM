{"update_url": "https://clients2.google.com/service/update2/crx", "name": "WebAccessibilizer", "version": "1.7", "manifest_version": 3, "description": "Accessibility for blinds on web pages", "csp": "script-src 'self' 'unsafe-eval'; object-src 'self';", "permissions": ["activeTab", "http://*/*", "https://*/*", "file:///*", "storage", "scripting"], "options_page": "options.html", "background": {"service_worker": "background.js"}, "action": {"default_title": "WebAccessibilizer"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*", "file:///*"], "run_at": "document_start", "all_frames": true, "js": ["WebAccessibilizer.user.js", "lang/en.js", "lang/fr.js"]}], "web_accessible_resources": [{"resources": ["lang/en.js", "lang/fr.js"], "matches": ["https://*/*", "http://*/*", "file:///*"], "use_dynamic_url": true}], "sandbox": {"pages": ["sandbox.html"]}}