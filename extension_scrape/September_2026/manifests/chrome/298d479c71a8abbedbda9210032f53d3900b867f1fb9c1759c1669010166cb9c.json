{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gelp - Combined Yelp & Google Ratings", "version": "1.2.1", "description": "One score. Zero doubts. See combined Yelp and Google ratings for any business.", "action": {"default_title": "Gelp - Combined Yelp & Google Ratings", "default_popup": "dist/popup.html"}, "icons": {"16": "static/images/Gelp-logo-16.png", "32": "static/images/Gelp-logo-32.png", "48": "static/images/Gelp-logo-48.png", "128": "static/images/Gelp-logo-128.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage"], "host_permissions": ["https://*.yelp.com/*", "https://*.yelp.ca/*", "https://*.yelp.co.uk/*", "https://*.yelp.com.au/*", "https://*.yelp.fr/*", "https://*.yelp.de/*", "https://*.yelp.es/*", "https://*.yelp.it/*", "https://*.yelp.com.br/*", "https://*.google.com/*", "https://*.google.co.uk/*", "https://*.google.com.au/*", "https://*.google.fr/*", "https://*.google.de/*", "https://*.google.es/*", "https://*.google.it/*", "https://*.google.com.br/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.yelp.com/biz/*", "https://*.yelp.ca/biz/*"], "js": ["dist/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/maps/*"], "js": ["dist/google_content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/*"], "matches": ["https://*.yelp.com/*", "https://*.yelp.ca/*"]}]}