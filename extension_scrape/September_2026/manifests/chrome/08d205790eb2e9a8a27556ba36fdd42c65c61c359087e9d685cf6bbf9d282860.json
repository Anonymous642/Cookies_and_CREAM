{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tagdef Lookup Utility", "version": "1.4", "description": "Highlight any word or phrase on most major social networks and right-click to instantly look it up on Tagdef.", "permissions": ["contextMenus", "tabs"], "host_permissions": ["https://tagdef.com/*", "https://www.tagdef.com/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://tagdef.com/*", "https://www.tagdef.com/*"], "js": ["content.js"], "run_at": "document_end", "world": "MAIN"}]}