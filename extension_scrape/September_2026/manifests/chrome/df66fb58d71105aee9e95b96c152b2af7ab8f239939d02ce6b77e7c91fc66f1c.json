{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Instagram Page ID Finder", "version": "1.1.7", "description": "Find an Instagram user ID from the live profile page with a branded WatanNetwork popup and on-page card.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "tabs"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"], "action": {"default_title": "Instagram Page ID Finder", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}