{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GTF Research Companion", "version": "1.0.0", "description": "Capture genealogical data from any webpage and sync with GTF", "icons": {"16": "icons/icon-16x16.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "permissions": ["activeTab", "sidePanel", "storage", "contextMenus", "scripting"], "host_permissions": ["https://*.gatherthefamily.com/*"], "action": {"default_icon": {"16": "icons/icon-16x16.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "default_title": "GTF Research Companion"}, "side_panel": {"default_path": "www/index.html"}, "commands": {"capture-page": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Capture current page to GTF"}}, "web_accessible_resources": [{"resources": ["*"], "matches": ["*://*/*"]}], "content_scripts": [{"matches": ["https://*.gatherthefamily.com/*"], "css": ["assets/content.css"], "js": ["content-script.js"]}], "background": {"service_worker": "background.js"}, "short_name": "GTF Research Companion"}