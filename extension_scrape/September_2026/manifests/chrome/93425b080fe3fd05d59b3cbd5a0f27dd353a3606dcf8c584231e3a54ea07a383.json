{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StyleGrabber", "description": "Hover any element to inspect non-default CSS and copy clean HTML/CSS. Local-only style grabber for developers.", "version": "0.1.0", "short_name": "StyleGrabber", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/kapaggar/StyleGrabber", "action": {"default_title": "StyleGrabber", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["storage", "clipboardWrite", "activeTab"], "host_permissions": ["<all_urls>", "file:///*"], "commands": {"toggle-pin": {"suggested_key": {"default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Toggle Pin Overlay"}, "toggle-tree-mode": {"suggested_key": {"default": "Alt+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Toggle Tree Mode"}, "toggle-auto-copy": {"suggested_key": {"default": "Alt+Shift+C", "mac": "MacCtrl+Shift+C"}, "description": "Toggle Auto Copy"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>", "file:///*"]}]}