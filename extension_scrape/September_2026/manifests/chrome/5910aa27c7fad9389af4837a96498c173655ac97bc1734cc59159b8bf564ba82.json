{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roman Urdu Quick Translate", "version": "1.0.0", "description": "Translate text in browser chat boxes to natural Roman Urdu with Ctrl+Shift+R.", "permissions": ["storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Roman Urdu Quick Translate"}, "commands": {"translate-to-roman-urdu": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Translate the current chat/input text to Roman Urdu"}}}