{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "404 to Archive", "version": "1.0.0", "description": "Detect unavailable pages and offer a safe Wayback Machine option without forced redirects.", "minimum_chrome_version": "114", "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["storage", "tabs", "webNavigation", "webRequest"], "host_permissions": ["<all_urls>"], "action": {"default_title": "404 to Archive", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content-script.js"], "run_at": "document_idle"}]}