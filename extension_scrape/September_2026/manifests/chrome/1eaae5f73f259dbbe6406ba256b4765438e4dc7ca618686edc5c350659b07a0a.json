{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Contact Saver", "version": "1.0.5", "description": "Fast tool to auto save, extract, and export WhatsApp contacts and group members to Excel (.xlsx / .csv), Google Contacts, and vCard.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "identity"], "host_permissions": ["https://web.whatsapp.com/*", "https://wacontact.mikro.co.id/*"], "action": {"default_popup": "popup.html", "default_title": "WhatsApp Contact Saver", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["export_helper.js", "content.js"], "run_at": "document_idle"}]}