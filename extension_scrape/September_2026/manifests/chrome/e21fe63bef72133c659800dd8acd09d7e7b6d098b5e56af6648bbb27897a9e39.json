{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Make Maps Normal Again", "short_name": "MMNA", "version": "1.6.0", "description": "Restores Canadian-region geographic naming on Google Maps and adds clearly satirical location annotations.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.google.com/*", "https://maps.google.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Make Maps Normal Again", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://maps.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://www.google.com/preferences*"], "js": ["preferences.js"], "run_at": "document_idle"}]}