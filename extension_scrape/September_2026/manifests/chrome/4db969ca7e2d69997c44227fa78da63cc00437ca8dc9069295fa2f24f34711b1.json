{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MakiMode \u2014 Focus & Site Blocker", "version": "1.0.0", "description": "Block distracting sites and hide addictive feeds (YouTube, Instagram) to stay in the zone. Pairs with the MakiMode focus display.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "MakiMode \u2014 open", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-blocker.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["content-youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.instagram.com/*"], "js": ["content-instagram.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}