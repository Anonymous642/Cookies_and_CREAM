{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Overview", "version": "1.1.0", "description": "View all open tabs, filter by keywords, and close them all in one click with this extension.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "permissions": ["tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Tab Overview", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}}}