{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BookmarkMaster", "version": "1.0.1", "description": "Local-first bookmark index, search, and AI recall. Private by design.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["bookmarks", "storage", "offscreen", "scripting"], "host_permissions": ["<all_urls>", "https://github.com/*", "https://objects.githubusercontent.com/*", "https://*.huggingface.co/*", "https://api.github.com/*", "https://www.youtube.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "BookmarkMaster", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["ui/dashboard.html", "ui/dashboard.css", "ui/dashboard.js", "vendor/transformers/*", "offscreen/*"], "matches": ["<all_urls>"]}]}