{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pomororo Companion", "description": "A calm local-first Pomororo timer companion with optional Focus Guard.", "version": "0.1.1", "action": {"default_title": "Pomororo", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "192": "icons/icon-192.png", "512": "icons/icon-512.png"}, "permissions": ["alarms", "declarativeNetRequest", "notifications", "storage"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://pomororo.com/*", "https://www.pomororo.com/*"], "js": ["bridge/content.js"], "run_at": "document_start"}]}