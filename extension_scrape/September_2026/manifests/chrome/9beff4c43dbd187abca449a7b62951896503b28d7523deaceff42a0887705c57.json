{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy URL Toolkit \u2014 Copy, Clean, Convert & Share", "short_name": "Copy URL Toolkit", "description": "Copy page & tab URLs in 25+ formats. Clean tracking params, make QR codes, shorten, export, organize and copy whole sessions.", "version": "1.0.0", "version_name": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Copy URL Toolkit", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "contextMenus", "tabs", "notifications", "offscreen"], "optional_host_permissions": ["https://tinyurl.com/*", "https://api.tinyurl.com/*", "https://api-ssl.bitly.com/*", "https://api.dub.co/*", "https://is.gd/*", "https://v.gd/*", "https://cleanuri.com/*", "https://spoo.me/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Open Copy URL Toolkit"}, "copy-current-url": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy the current page URL"}, "copy-as-markdown": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Copy the current page as a Markdown link"}, "open-library": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Open the URL Library"}, "copy-clean-url": {"description": "Copy the current URL with tracking parameters removed"}, "copy-title-and-url": {"description": "Copy the current page title and URL"}, "copy-all-tabs": {"description": "Copy the URLs of all tabs in thi