{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SupWriter - Humanize AI Text", "version": "1.0.2", "description": "Humanize AI text, detect AI content, check grammar, and paraphrase. Bypass AI detectors instantly.", "permissions": ["storage", "activeTab", "contextMenus", "scripting", "alarms", "clipboardWrite"], "host_permissions": ["https://supwriter.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "SupWriter - Humanize AI Text"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["content-styles.css"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://supwriter.com/*"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["<all_urls>"]}], "commands": {"humanize-selection": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Humanize selected text"}, "detect-selection": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Detect AI in selected text"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}