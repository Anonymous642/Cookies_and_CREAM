{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Peroot - AI Prompt Enhancer", "short_name": "Peroot", "version": "2.2.0", "description": "Enhance any prompt instantly with AI. Right-click to upgrade selected text or use the popup launcher. Supports Hebrew and English.", "homepage_url": "https://peroot.space", "author": "Peroot by Joyatech", "permissions": ["contextMenus", "activeTab", "tabs", "storage", "scripting"], "host_permissions": ["https://peroot.space/*", "https://www.peroot.space/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Peroot - \u05e9\u05d3\u05e8\u05d5\u05d2 \u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Open Peroot popup"}, "enhance-selection": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Enhance selected text"}}, "content_scripts": [{"matches": ["https://peroot.space/*", "https://www.peroot.space/*"], "js": ["content/auth-sync.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}