{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pasterboy - Paste Formatted Text to X.com", "version": "1.3.0", "description": "Paste Markdown, Google Docs, Notion, or Word text into X.com with bold & italic formatting. Auto-splits long posts into threads.", "permissions": ["activeTab", "scripting", "debugger", "storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.gumroad.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}