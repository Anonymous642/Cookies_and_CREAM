{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voltky - Cross-Listing for Resellers", "version": "9.67", "description": "Cross-list an eBay item to Facebook, Mercari, Poshmark and Depop: Voltky fills each listing form in your own browser.", "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://i.ebayimg.com/*", "https://www.facebook.com/*", "https://www.mercari.com/*", "https://poshmark.com/*", "https://www.depop.com/*", "https://webapi.depop.com/*", "https://app.voltky.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.voltky.com/*"], "js": ["content_app.js"], "run_at": "document_idle", "exclude_matches": ["https://www.facebook.com/*", "https://www.mercari.com/*"]}, {"matches": ["https://www.facebook.com/marketplace/create/*", "https://www.facebook.com/marketplace/you/*", "https://www.facebook.com/marketplace/item/*"], "js": ["content_fb.js"], "run_at": "document_idle"}, {"matches": ["https://www.mercari.com/*"], "js": ["content_mercari.js"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/*"], "js": ["trusted_input.js", "content_poshmark.js"], "run_at": "document_idle"}, {"matches": ["https://www.depop.com/*"], "js": ["content_depop.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Voltky", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}