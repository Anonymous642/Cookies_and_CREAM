{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapDeck", "version": "4.2", "description": "All\u2011in\u2011one tool for capturing software workflows. Minimalist UI: capture screenshots, videos & simulations. Export to PPT or ZIP.", "permissions": ["storage", "activeTab", "windows", "tabCapture", "downloads", "offscreen", "unlimitedStorage", "scripting", "tabs", "notifications", "clipboardWrite"], "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Take a screenshot of the current tab"}, "toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Toggle video recording on/off"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/snapdeck_logo.png", "48": "images/snapdeck_logo.png", "128": "images/snapdeck_logo.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["offscreen.html"], "matches": ["<all_urls>"]}, {"resources": ["offscreen.html", "ffmpeg/*"], "matches": ["<all_urls>"]}, {"resources": ["viewer.html", "viewer.css"], "matches": ["<all_urls>"]}, {"resources": ["simulation_capture.js"], "matches": ["<all_urls>"]}]}