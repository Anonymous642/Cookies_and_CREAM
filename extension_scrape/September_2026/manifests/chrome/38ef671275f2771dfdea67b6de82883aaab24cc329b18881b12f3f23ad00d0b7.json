{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat Clipboard", "version": "1.3.3", "description": "Copia o hist\u00f3rico do chat de atendimento para o clipboard, formatado com data, papel e texto limpo.", "author": "Mayke de Souza Nogueira", "homepage_url": "https://github.com/MaykeSN/chat-clipboard-extension", "permissions": ["clipboardWrite", "scripting", "activeTab", "storage"], "background": {"service_worker": "background.js"}, "commands": {"copy-chat": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Extrai e copia o chat atual para o clipboard"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Chat Clipboard - configura\u00e7\u00f5es e c\u00f3pia", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}