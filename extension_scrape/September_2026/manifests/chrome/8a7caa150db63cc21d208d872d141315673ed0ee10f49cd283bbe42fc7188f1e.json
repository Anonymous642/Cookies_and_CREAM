{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SourceLens - LinkedIn Bridge", "version": "1.3.0", "description": "Export LinkedIn Recruiter profielen direct naar SourceLens voor AI-analyse", "author": "SourceLens", "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["https://*.linkedin.com/*", "https://*.sourcelens.ai/*", "https://*.sourcelens.nl/*", "https://*.replit.dev/*", "https://*.replit.app/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/talent/*", "https://www.linkedin.com/recruiter/*", "https://www.linkedin.com/hiring/*", "https://www.linkedin.com/jobs/*/hiring/*", "https://www.linkedin.com/search/results/*", "https://www.linkedin.com/in/*"], "js": ["src/content/linkedin-recruiter.js"], "css": ["src/content/styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "default_title": "SourceLens"}, "icons": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["public/icons/*"], "matches": ["https://*.linkedin.com/*"]}]}