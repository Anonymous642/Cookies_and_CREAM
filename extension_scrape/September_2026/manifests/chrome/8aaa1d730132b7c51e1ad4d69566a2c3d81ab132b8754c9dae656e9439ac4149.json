{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SMS Keyword Alerts", "short_name": "SMS Alerts", "version": "0.1.0", "author": "Jaydeep Malik", "homepage_url": "https://www.jaydeepmalik.com/", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "description": "Monitor Google Messages Web for new SMS messages and alert when configured keywords are detected.", "permissions": ["storage", "notifications", "offscreen"], "host_permissions": ["https://messages.google.com/web/conversations*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://messages.google.com/web/conversations*"], "js": ["contentScript.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "action": {"default_title": "SMS Keyword Alert", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["sounds/siren.mp3"], "matches": ["https://messages.google.com/*"]}]}