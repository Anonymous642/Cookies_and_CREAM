{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "126", "name": "Screely - Screenshot to Beautiful Mockup", "short_name": "Screely", "version": "2.5.2.2", "version_name": "2.5.2.2", "description": "Capture screenshots and record active tabs in MP4. Edit, enhance, mock up, and organize everything locally\u2014no uploads or account.", "homepage_url": "https://screely.app", "author": "AticMatic", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "permissions": ["activeTab", "scripting", "tabs", "storage", "offscreen", "contextMenus", "notifications", "tabCapture"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "default_title": "Screely - Modern Screenshot & Mockup"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Capture visible area"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Capture selection"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Capture full page"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+4"}, "description": "Capture element"}}}