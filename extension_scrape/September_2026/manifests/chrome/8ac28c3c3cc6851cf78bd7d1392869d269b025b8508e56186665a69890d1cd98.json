{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShortFlow Auto Advance", "short_name": "ShortFlow", "version": "1.1.0", "description": "Automatically advances YouTube Shorts, Instagram Reels, TikTok videos and Facebook Reels after the current video finishes.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "ShortFlow Auto Advance", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.instagram.com/*", "*://www.tiktok.com/*", "*://m.tiktok.com/*", "*://www.facebook.com/*", "*://web.facebook.com/*", "*://m.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}