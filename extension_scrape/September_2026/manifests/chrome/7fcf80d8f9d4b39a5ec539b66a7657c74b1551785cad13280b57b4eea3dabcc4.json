{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tapfill \u2013 Social Comment Assistant", "version": "1.0.1", "description": "Suggests comment drafts on social posts so you can reply without leaving the page. You review and post every comment yourself.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Tapfill", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "host_permissions": ["https://www.facebook.com/*", "https://*.pinterest.com/*", "https://www.instagram.com/*", "https://www.linkedin.com/*", "https://media.licdn.com/*", "https://dms.licdn.com/*", "https://static.licdn.com/*", "https://*.youtube.com/*", "*://img.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://pbs.twimg.com/*", "https://tapfill.io/*", "https://www.tapfill.io/*"], "externally_connectable": {"matches": ["https://tapfill.io/*", "https://www.tapfill.io/*"]}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.facebook.com/*", "https://*.pinterest.com/*", "https://www.instagram.com/*", "https://www.linkedin.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*"]}], "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["fb-content.js"], "run_at": "document_idle"}, {"matches": ["https://*.pinterest.com/*"], "js": ["pin-content.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["ig-content.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["li-content.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["fb-content.js", "yt-content.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["fb-content.js", "x-content.js"], "run_at": "document_idle"}]}