{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vocuno", "description": "Vocuno for Suno and Udio: back up your music, get stems, MIDI and analysis for the track playing, detect tempo and key on any tab.", "version": "0.2.0", "short_name": "Vocuno", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://vocuno.com", "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "scripting", "activeTab", "alarms", "tabCapture", "offscreen", "contextMenus"], "host_permissions": ["https://vocuno.com/*", "https://suno.com/*", "https://www.suno.com/*", "https://udio.com/*", "https://www.udio.com/*"], "action": {"default_title": "Vocuno"}, "commands": {"detect-tempo": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Detect the tempo and key of the current tab"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://suno.com/*", "https://www.suno.com/*"], "run_at": "document_start", "js": ["content-scripts/suno-observer.js"], "world": "MAIN"}, {"matches": ["https://suno.com/*", "https://udio.com/*", "https://www.suno.com/*", "https://www.udio.com/*"], "run_at": "document_idle", "js": ["content-scripts/universal.js"]}, {"matches": ["https://vocuno.com/*"], "run_at": "document_start", "js": ["content-scripts/vocuno-bridge.js"]}]}