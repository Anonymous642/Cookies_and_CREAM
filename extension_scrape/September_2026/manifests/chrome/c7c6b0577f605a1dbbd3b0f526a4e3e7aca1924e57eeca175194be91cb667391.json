{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trace", "version": "0.1.0", "description": "Draw and annotate on any website.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "tabs", "scripting", "downloads", "debugger"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.chase.com/*", "*://*.bankofamerica.com/*", "*://*.wellsfargo.com/*", "*://*.citi.com/*", "*://*.usbank.com/*", "*://*.pnc.com/*", "*://*.capitalone.com/*", "*://*.schwab.com/*", "*://*.fidelity.com/*", "*://*.etrade.com/*", "*://*.tdameritrade.com/*", "*://*.robinhood.com/*", "*://*.coinbase.com/*", "*://*.binance.com/*", "*://*.paypal.com/*", "*://*.stripe.com/*", "*://*.myhealthonline.com/*", "*://*.patientportal.com/*", "*://*.epic.com/*", "*://*.cerner.com/*", "*://*.irs.gov/*", "*://*.ssa.gov/*", "*://*.gov/*", "*://*.mil/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+T"}, "description": "Toggle drawing overlay"}}, "web_accessible_resources": [{"resources": ["chunks/*", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';"}}