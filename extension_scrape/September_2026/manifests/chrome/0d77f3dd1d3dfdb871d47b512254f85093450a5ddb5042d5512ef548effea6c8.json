{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Parascope", "version": "2.0.0", "description": "Search Parascope CMDB for configuration items from any webpage", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "optional_host_permissions": ["https://*.parascope.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Parascope", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "commands": {"search-selection": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Search Parascope for selected text"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["lib/format.js"], "matches": ["<all_urls>"], "use_dynamic_url": true}]}