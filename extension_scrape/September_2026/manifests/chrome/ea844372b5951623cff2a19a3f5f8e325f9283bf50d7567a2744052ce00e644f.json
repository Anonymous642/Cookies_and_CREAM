{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Slides & Docs downloader, Extractor & Zoom", "version": "1.2.0", "description": "Download, zoom, and extract images from Google Docs, Sheets & Slides. Zip download, individual save, gallery view, and image zoom.", "permissions": ["scripting", "activeTab"], "host_permissions": ["*://docs.google.com/document/*", "*://docs.google.com/presentation/*", "*://docs.google.com/spreadsheets/*", "*://*.googleusercontent.com/*"], "action": {"default_popup": "views/popup.html"}, "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}, "content_scripts": [{"matches": ["*://docs.google.com/document/*", "*://docs.google.com/presentation/*", "*://docs.google.com/spreadsheets/*"], "css": ["css/lightbox.css"], "js": ["js/contentScript.js", "js/imageZoom.js"]}, {"matches": ["*://docs.google.com/document/*", "*://docs.google.com/presentation/*", "*://docs.google.com/spreadsheets/*"], "js": ["js/blobCollector.js"], "world": "MAIN", "run_at": "document_start"}]}