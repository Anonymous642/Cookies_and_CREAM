{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cat Mode \u2014 Keyboard Guard", "version": "1.3.0", "description": "Block your keyboard & trackpad so pets walking across them can't disrupt your video or page. Unlock with your own shortcut.", "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Cat Mode", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-cat-mode": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Toggle Cat Mode on/off"}, "unlock-cat-mode": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Turn Cat Mode OFF (panic unlock)"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}