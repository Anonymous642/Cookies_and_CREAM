{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RediTop \u2013 Scroll to Top for Reddit", "description": "Adds a floating scroll-to-top button and Alt+Up keyboard shortcut on Reddit", "version": "1.4.0", "icons": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["storage", "alarms", "windows"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "*://*/*"], "web_accessible_resources": [{"resources": ["background.js"], "matches": ["*://*/*"]}], "commands": {"scroll-to-top": {"suggested_key": {"default": "Alt+Up"}, "description": "Scroll to top"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "RediTop", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://old.reddit.com/*", "https://www.reddit.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}