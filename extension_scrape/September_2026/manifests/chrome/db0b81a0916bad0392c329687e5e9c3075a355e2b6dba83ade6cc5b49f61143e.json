{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voxaflow - Voice Replies for X & LinkedIn", "description": "Reply to tweets with your voice. AI-powered transcription and refinement.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "sidePanel", "tabs", "offscreen"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "externally_connectable": {"matches": ["http://localhost/*", "https://*.railway.app/*", "https://*.up.railway.app/*"]}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "Start/stop voice recording"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Voxaflow", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://linkedin.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://x.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}