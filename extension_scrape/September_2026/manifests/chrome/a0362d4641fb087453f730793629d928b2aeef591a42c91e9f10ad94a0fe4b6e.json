{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kiku: Primed Listening", "version": "1.3.0", "description": "Automatically pauses video playback after subtitles to aid in language learning via the 'Primed Listening' technique.", "permissions": ["storage", "activeTab", "scripting", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Primed Listening Settings"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"], "js": ["settings.js", "detectors.js", "picker.js", "content.js"], "run_at": "document_idle", "all_frames": true}]}