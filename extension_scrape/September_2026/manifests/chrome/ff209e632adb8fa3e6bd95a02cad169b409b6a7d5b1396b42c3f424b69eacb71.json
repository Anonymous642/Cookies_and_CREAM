{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Forminator", "version": "1.0", "description": "Automatically fills repetitive Google Forms with your data", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["https://docs.google.com/forms/*"], "js": ["content.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "commands": {"trigger-autofill": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Auto-fill Google Form"}}, "action": {"default_popup": "popup.html", "default_title": "Auto-Fill Form", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}