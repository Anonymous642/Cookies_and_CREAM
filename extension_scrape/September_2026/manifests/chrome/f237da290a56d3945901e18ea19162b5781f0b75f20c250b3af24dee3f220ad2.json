{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reflow \u2014 columns & paged reading", "version": "2.0.0", "description": "Reflow articles into balanced columns or full-height pages you turn sideways. Solarized Dark. Fills your widescreen.", "homepage_url": "https://github.com/walkerjian/reflow", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Reflow (Alt+Shift+K)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-reflow": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Toggle Reflow on this page"}, "toggle-paged": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Reflow: paged reading mode"}}}