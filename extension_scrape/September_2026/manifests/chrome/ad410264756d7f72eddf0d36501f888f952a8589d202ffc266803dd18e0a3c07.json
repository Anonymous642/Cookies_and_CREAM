{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Buddy \u2013 ADHD Focus Widget & Mini Games", "short_name": "Focus Buddy", "version": "3.31.0", "description": "Beat distraction with a tiny corner widget: 28 mini games, a pet world that grows with your focus, notes & timers. Made for ADHD.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "alarms"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Focus Buddy", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-widget": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle the focus widget"}, "toggle-notes": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Open/close the floating notes panel"}, "toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle the reading ruler"}, "toggle-highlighter": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle the page highlighter"}}, "web_accessible_resources": [{"resources": ["sprites/*"], "matches": ["<all_urls>"]}]}