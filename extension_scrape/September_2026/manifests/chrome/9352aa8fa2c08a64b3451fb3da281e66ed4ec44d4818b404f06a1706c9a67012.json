{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VerbaFix", "key": "", "version": "0.12", "description": "Check grammar, fix all errors in one click, and translate text on any site. Your AI-powered writing assistant in the browser.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage", "cookies", "alarms"], "host_permissions": ["https://verbafix.com/*", "https://*.verbafix.com/*", "https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://verbafix.com/*"]}, "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_popup": "src/popup/index.html", "default_title": "VerbaFix \u2014 Grammar Checker & Translator"}, "web_accessible_resources": [{"resources": ["assets/*", "assets/images/*", "assets/images/logo.png", "content/content.css"], "matches": ["<all_urls>"]}], "commands": {"check-grammar": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Check grammar on current page"}, "fix-all": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fix all grammar errors"}, "translate": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Translate text in the focused editor"}}}