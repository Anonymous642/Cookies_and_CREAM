{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TurboRead", "description": "Unlock your full potential by training your brain to read faster and smarter.", "version": "1.2", "manifest_version": 3, "action": {"default_popup": "src/popup/popup.html"}, "background": {"service_worker": "service_worker.js", "type": "module"}, "permissions": ["storage", "tabs", "activeTab"], "commands": {"trigger-boost-read": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Run Boost Read"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"], "type": "module", "run_at": "document_idle"}], "host_permissions": ["<all_urls>", "https://*.firebaseio.com/", "https://*.firebaseapp.com/"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "images/icons/icon-16.png", "32": "images/icons/icon-32.png", "48": "images/icons/icon-48.png", "128": "images/icons/icon-128.png"}}