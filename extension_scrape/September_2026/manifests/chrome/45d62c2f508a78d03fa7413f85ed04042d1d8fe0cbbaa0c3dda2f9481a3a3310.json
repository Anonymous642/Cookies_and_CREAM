{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MusicPulse", "version": "1.0.1", "description": "Automate SubmitHub submissions and track curator responses with MusicPulse", "permissions": ["activeTab", "storage", "tabs", "alarms", "contextMenus"], "host_permissions": ["https://www.submithub.com/*", "https://submithub.com/*", "https://www.musicpulse.app/*", "https://musicpulse.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.submithub.com/*", "https://submithub.com/*"], "js": ["lib/storage.js", "lib/api.js", "content/selectors.js", "content/response-capture.js", "content/auto-submit.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.musicpulse.app/auth/plugin-login*", "https://musicpulse.app/auth/plugin-login*"], "js": ["content/plugin-login.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.submithub.com/*"]}, {"resources": ["welcome.html"], "matches": ["https://www.musicpulse.app/*", "https://musicpulse.app/*"]}]}