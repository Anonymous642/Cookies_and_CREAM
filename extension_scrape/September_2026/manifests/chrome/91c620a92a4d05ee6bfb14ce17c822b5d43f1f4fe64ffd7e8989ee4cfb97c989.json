{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Post Booster", "version": "1.7.2", "description": "Auto-post text, images and videos to multiple Facebook groups one at a time", "permissions": ["sidePanel", "storage", "tabs", "scripting", "alarms", "notifications"], "host_permissions": ["https://*.facebook.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "background": {"service_worker": "background.bundle.js"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Post Booster"}, "content_scripts": [{"matches": ["https://*.facebook.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "MAIN"}]}