{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paiger", "version": "1.39", "description": "Quickly share a web page through Paiger or add it to your websites for suggestions in the future", "action": {"default_popup": "index.html", "default_icon": {"16": "images/content-logo-16.png"}, "default_title": "Paiger - Research companies, contacts and candidates in just a few clicks."}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://*/*.rss", "*://*/*.xml"], "js": ["contentScript.js"], "all_frames": true}], "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "tabs", "clipboardWrite", "storage"], "icons": {"16": "images/content-logo-16.png", "48": "images/content-logo-48.png", "128": "images/content-logo-128.png"}, "web_accessible_resources": [{"resources": ["images/*"], "matches": ["<all_urls>"]}]}