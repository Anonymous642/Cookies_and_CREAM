{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Darb", "description": "Turn long YouTube videos into structured, trackable daily courses.", "version": "0.1.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "homepage_url": "https://github.com/KhalidRouissi1/darb-youtube", "permissions": ["activeTab", "storage"], "optional_permissions": ["notifications"], "action": {"default_title": "Darb", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}