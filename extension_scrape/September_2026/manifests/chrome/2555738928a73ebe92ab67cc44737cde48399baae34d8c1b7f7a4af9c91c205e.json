{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jump to Top Button", "version": "0.1.0", "description": "Adds a floating button on every page to quickly jump to the top.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"jump-to-top": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Jump to top of the active tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}]}