{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlockZeee", "version": "3.7.14", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "description": "Zero-compromise privacy protection. Blocks ads, trackers, fingerprinting, telemetry, and more.", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "cookies", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "youtube_ads", "enabled": true, "path": "rules/youtube-ads.json"}, {"id": "ad_networks", "enabled": true, "path": "rules/ad-networks.json"}, {"id": "trackers", "enabled": true, "path": "rules/trackers.json"}, {"id": "telemetry", "enabled": true, "path": "rules/telemetry.json"}, {"id": "https_upgrade", "enabled": true, "path": "rules/https-upgrade.json"}, {"id": "cname_trackers", "enabled": true, "path": "rules/cname-trackers.json"}, {"id": "referrer_strip", "enabled": true, "path": "rules/referrer.json"}, {"id": "web_fonts", "enabled": true, "path": "rules/web-fonts.json"}, {"id": "fingerprinting", "enabled": true, "path": "rules/fingerprinting.json"}]}, "background": {"service_worker": "background.js"}, "commands": {"toggle-protection": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Pause/resume BlockZeee protection"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "BlockZeee"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}