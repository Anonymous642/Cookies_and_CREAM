{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Signaware \u2013 Dynamic GIF Email Signatures", "description": "Add dynamic GIFs to your Gmail, Outlook, and Yahoo email signatures to stand out and personalize every message", "version": "1.01", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_popup": "src/popup.html"}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*", "https://*.supabase.co/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content-scripts/gmail-injector.js"], "run_at": "document_end"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["src/content-scripts/outlook-injector.js"], "run_at": "document_end"}, {"matches": ["https://mail.yahoo.com/*"], "js": ["src/content-scripts/yahooMail-injector.js"], "run_at": "document_end"}]}