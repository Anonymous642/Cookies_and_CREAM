{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SellFlow", "short_name": "SellFlow", "description": "Import dealer inventory and publish approved vehicle listings from SellFlow in your browser.", "version": "1.3.0", "homepage_url": "https://sellflow.autos", "minimum_chrome_version": "116", "action": {"default_title": "Open SellFlow", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://sellflow.autos/*", "https://www.facebook.com/*"], "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}