{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Playback Advance", "description": "Keyboard shortcuts to control playback when the browser is in the background.", "version": "1.1", "manifest_version": 3, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "img/icon16.png", "24": "img/icon24.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["*://*/*"], "action": {"default_title": "Open Playback Advance Tab", "content_scripts": [{"all_frames": false, "match_origin_as_fallback": false, "match_about_blank": false, "run_at": "document_end", "world": "MAIN"}]}, "commands": {"videoSpeedSlower": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Slow Down", "global": true}, "playPause": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Pause", "global": true}, "videoSpeedFaster": {"suggested_key": {"default": "Ctrl+Shift+0"}, "description": "Speed Up", "global": true}}}