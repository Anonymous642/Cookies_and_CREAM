{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Webtrace", "version": "1.0.0", "description": "Trace webpages into editable Figma layers. Save locally, copy to Figma, or send an end-to-end encrypted trace.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Webtrace"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage", "debugger", "clipboardWrite"], "commands": {"capture-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Trace current page"}}}