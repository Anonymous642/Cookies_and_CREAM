{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ThreadIT: Reddit to PDF Exporter", "version": "0.1.2", "description": "Reddit to PDF - Export Reddit discussion threads as a clean PDF.", "action": {"default_title": "Reddit to PDF - Export Reddit thread to PDF"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "downloads", "storage", "debugger"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}