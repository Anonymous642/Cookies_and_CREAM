{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Time Pinner", "version": "1.1", "description": "Pins the exact timestamp of a YouTube video to resume watching later.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"16": "image/pin.png", "48": "image/pin.png", "128": "image/pin.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "image/pin.png", "48": "image/pin.png", "128": "image/pin.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["image/pin.png", "image/trash.png", "image/list.png", "image/check.png"], "matches": ["*://*.youtube.com/*"]}]}