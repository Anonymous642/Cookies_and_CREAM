{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Auto Refresh", "version": "1.1.0", "description": "Auto-refresh with safe pauses and alerts. Page data stays on-device\u2014no tracking, ads, analytics, sale, or sharing.", "author": "Arifur Rahman (https://earif.com)", "minimum_chrome_version": "114", "action": {"default_title": "Smart Auto Refresh", "default_popup": "popup.html"}, "options_page": "options.html", "background": {"service_worker": "serviceWorker.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting"], "optional_permissions": ["notifications"], "optional_host_permissions": [], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/sounds/alert.wav"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}]}