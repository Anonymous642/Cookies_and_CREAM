{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CarCheckBot Auction Assistant", "description": "Embedded CarCheckBot assistant for Copart and IAAI auction pages.", "version": "1.0.13", "minimum_chrome_version": "116", "permissions": ["activeTab", "identity", "storage"], "host_permissions": ["https://*.copart.com/*", "https://*.iaai.com/*", "https://api.carcheckbot.com/*", "https://carcheckbot.com/*", "https://www.carcheckbot.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-32.png"], "matches": ["https://*.copart.com/*", "https://*.iaai.com/*"]}], "action": {"default_title": "CarCheckBot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.copart.com/*", "https://*.iaai.com/*"], "js": ["content/auction-page-parser.js", "content/embedded-auction-ui.js", "content/detect-auction-page.js"], "run_at": "document_idle"}]}