{"update_url": "https://clients2.google.com/service/update2/crx", "name": "LinkedIn Notes & Reminders", "description": "Save private notes, tags, and follow-up reminders directly on LinkedIn profiles. 100% free and stored locally.", "version": "1.1.0", "manifest_version": 3, "action": {"default_title": "LinkedIn Notes", "default_popup": "popup.html"}, "permissions": ["storage", "alarms", "notifications", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}