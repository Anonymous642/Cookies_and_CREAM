{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Digital Memory", "short_name": "Memory", "version": "0.1.0", "description": "Your browser never forgets. 100% offline, private, searchable memory of everything you see in Chrome.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Digital Memory", "default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "options_page": "src/dashboard/index.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["bookmarks", "downloads", "storage", "unlimitedStorage", "tabs", "webNavigation", "sidePanel", "contextMenus", "alarms", "offscreen", "clipboardWrite", "favicon"], "host_permissions": ["http://*/*", "https://*/*", "file:///*"], "commands": {"quick-search": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Quick search"}, "open-memory": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Memory"}, "new-note": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "New note"}, "todays-timeline": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Today's timeline"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["http://*/*", "https://*/*"]}]}