{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SMS Reply Assistant", "version": "0.6.0", "description": "AI-assisted replies for your Infotxt SMS inbox \u2014 Gemini, Claude or OpenAI, with keyword fallback. Auto-send is off by default.", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.myinfotxt.com/*", "https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "SMS Reply Assistant", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["https://api.myinfotxt.com/inbox.php*"], "js": ["content.js"], "run_at": "document_idle"}]}