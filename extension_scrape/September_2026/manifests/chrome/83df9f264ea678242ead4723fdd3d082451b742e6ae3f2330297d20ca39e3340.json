{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hastro", "version": "1.7", "description": "Hastro analyzes your writing style and turns your old LinkedIn posts into fresh, high-performing content.", "permissions": ["activeTab", "tabs", "sidePanel", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://app.hastro.io/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}