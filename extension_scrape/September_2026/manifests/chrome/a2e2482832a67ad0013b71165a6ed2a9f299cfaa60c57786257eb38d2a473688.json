{"update_url": "https://clients2.google.com/service/update2/crx", "name": "WordBridge \u2014 Vocabulary Builder & Dictionary", "description": "Save any word with the sentence you found it in. Definitions, pronunciation, and flashcard review as you browse.", "version": "1.2.1", "manifest_version": 3, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "WordBridge", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "options_page": "options.html", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://freedictionaryapi.com/*", "https://www.dictionaryapi.com/*", "https://api.mymemory.translated.net/*", "https://en.wiktionary.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}