{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pigment - Color Picker & Palette Tool", "short_name": "Pigment", "description": "Color picker with 28 formats, image color extractor, gradient generator, contrast checker, blindness simulator & palette export.", "author": "Zuka Murvanidze", "version": "1.1.1", "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "src/pages/sidepanel/index.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/extractColors.js"], "run_at": "document_idle"}], "action": {"default_title": "Open Pigment"}, "commands": {"pick-color": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pick a color with the eyedropper"}}, "minimum_chrome_version": "114", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}