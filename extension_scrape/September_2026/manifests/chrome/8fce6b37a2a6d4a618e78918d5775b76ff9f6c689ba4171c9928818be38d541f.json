{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Draw Your Screen", "version": "1.3.1", "description": "Capture, annotate, redact, and export screenshots instantly with professional drawing tools completely offline.", "author": "Gul", "action": {"default_popup": "popup/popup.html", "default_title": "Draw Your Screen"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "permissions": ["activeTab", "storage", "scripting"], "commands": {"capture-visible-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible screen"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Capture selected area"}}, "web_accessible_resources": [{"resources": ["index.html", "editor/editor.html", "assets/*"], "matches": ["<all_urls>"]}]}