{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GraderPal", "version": "1.39", "description": "Auto-detects Canvas assignments and fills feedback comments instantly. Supports multiple courses and Google Sheets import.", "permissions": ["activeTab", "clipboardWrite", "storage"], "host_permissions": ["*://*.instructure.com/*", "https://docs.google.com/*", "https://*.google.com/*", "https://*.googleusercontent.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.instructure.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}