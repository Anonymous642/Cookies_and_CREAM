{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeRetriever", "description": "Hide short video and feeds on the sites you choose, or a whole site on a schedule. Stay too long and a puppy walks in.", "version": "0.8.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "favicon", "scripting"], "host_permissions": ["*://*/*", "*://*.youtube.com/*", "*://x.com/*", "*://twitter.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*"], "action": {"default_title": "TimeRetriever", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "run_at": "document_start", "css": ["content-scripts/instagram.css"], "js": ["content-scripts/instagram.js"]}, {"matches": ["*://*.linkedin.com/*"], "run_at": "document_start", "css": ["content-scripts/linkedin.css"], "js": ["content-scripts/linkedin.js"]}, {"matches": ["*://*.reddit.com/*"], "run_at": "document_start", "css": ["content-scripts/reddit.css"], "js": ["content-scripts/reddit.js"]}, {"matches": ["*://twitter.com/*", "*://x.com/*"], "run_at": "document_start", "css": ["content-scripts/x.css"], "js": ["content-scripts/x.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "css": ["content-scripts/youtube.css"], "js": ["content-scripts/youtube.js"]}]}