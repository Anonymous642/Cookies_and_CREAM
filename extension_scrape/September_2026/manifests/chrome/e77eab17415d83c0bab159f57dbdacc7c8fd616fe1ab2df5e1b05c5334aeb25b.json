{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClickMee \u2014 Click-to-Copy", "version": "1.0", "description": "Click a word to select it, click again to copy. Multi-word selection, copy history, per-site rules and link blocking.", "permissions": ["tabs", "clipboardWrite", "storage", "sidePanel"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"open-history": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Open Copy History"}, "toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Turn ClickMee on or off"}}, "side_panel": {"default_path": "popup.html?mode=panel"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content.js"], "css": ["style.css"]}]}