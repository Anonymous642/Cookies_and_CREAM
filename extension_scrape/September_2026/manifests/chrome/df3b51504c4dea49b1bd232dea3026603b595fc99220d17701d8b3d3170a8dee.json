{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SlyOS", "version": "0.1.2", "description": "SlyOS reads the LinkedIn conversation you already have open and places your draft in its message box. It never presses Send.", "minimum_chrome_version": "116", "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "SlyOS", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "host_permissions": ["https://www.linkedin.com/*", "https://api.slyos.world/*"], "permissions": ["storage", "alarms", "activeTab", "sidePanel"], "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Show the SlyOS draft for this conversation"}}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://slyos.world/*", "https://www.slyos.world/*", "https://staging.slyos.world/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}