{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Locavore", "version": "1.0", "description": "When on Amazon pages, searches for bookstores close to you that have the book in stock that you are looking for.", "permissions": ["geolocation"], "host_permissions": ["https://pathmatch.com/*", "http://localhost:8000/*"], "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["content.js"], "run_at": "document_end"}]}