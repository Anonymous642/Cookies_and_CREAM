{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goldfish - Site Blocker, Hide Elements on YouTube & Instagram", "version": "2.0.0", "description": "Block distracting websites and hide elements on YouTube & Instagram to help you focus.", "permissions": ["storage", "tabs", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "webNavigation", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "html/popup.html", "default_icon": {"16": "icons/goldfish-16.png", "32": "icons/goldfish-32.png", "48": "icons/goldfish-48.png"}}, "icons": {"16": "icons/goldfish-16.png", "32": "icons/goldfish-32.png", "48": "icons/goldfish-48.png", "128": "icons/goldfish-128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://m.youtube.com/*"], "css": ["css/youtube.css"], "js": ["js/content_youtube.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.instagram.com/*"], "css": ["css/instagram.css"], "js": ["js/content_instagram.js"], "run_at": "document_start"}, {"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*"], "js": ["js/content_amazon.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["html/blocked.html", "html/wait.html", "css/main.css", "css/instagram.css", "js/wait.js", "js/blocked.js", "js/youtube_injection.js", "icons/goldfish-128.png"], "matches": ["<all_urls>"]}]}