{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TaskWhole \u2014 Cold Email Follow-ups from Any Page", "version": "1.0.0", "description": "Send cold email with your templates and variables, and see or mark replies, without leaving the page you found the lead on.", "permissions": ["storage", "identity", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "TaskWhole", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "commands": {"fill-variable": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Put the selected text into the next empty variable"}, "send-email": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Send (a follow-up still asks first)"}}}