{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenShield \u2014 Blur Sensitive Info for Screen Sharing", "description": "Instantly blur any text, image or area on any webpage. Perfect for screen recording, live demos & presentations.", "version": "2.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://extensionpay.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'"}, "commands": {"toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Toggle blur mode"}, "clear-blurs": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Clear all blurs on current page"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "ScreenShield", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}]}