{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Huggingface Chat Export - Convert Huggingface to JSON/PDF", "description": "Export your HuggingFace chat conversations to JSON or PDF. Filter by date, select multiple chats, and download with one click.", "manifest_version": 3, "version": "1.1.0", "icons": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "128": "images/128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["downloads", "activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_icon": "images/48.png"}, "host_permissions": ["https://huggingface.co/*", "https://statespeed.solutions/*"], "web_accessible_resources": [{"resources": ["converter.html", "converter.js", "converter.css"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Open HuggingFace Chat Exporter"}}, "offline_enabled": true, "content_scripts": [{"matches": ["https://huggingface.co/chat/*"], "js": ["content.js"], "run_at": "document_end"}]}