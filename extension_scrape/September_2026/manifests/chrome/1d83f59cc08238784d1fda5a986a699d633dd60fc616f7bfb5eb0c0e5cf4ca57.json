{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save My Tabs - Tab Session Manager", "short_name": "Save My Tabs", "version": "1.1.0", "description": "Privacy-focused offline session manager. Save, organize, search, and restore tab groups with one click.", "permissions": ["storage", "tabs", "contextMenus", "activeTab", "alarms"], "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Save My Tabs", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background.js", "type": "module"}, "commands": {"save_current_session": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current window as new session"}, "quick_restore_last": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Quick restore the most recent session"}}}