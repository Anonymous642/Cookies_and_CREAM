{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabStash", "version": "1.05", "description": "Save the current tab's URL with a button or keyboard shortcut for later use.", "permissions": ["tabs", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "resources/icon16.png", "48": "resources/icon48.png", "128": "resources/icon128.png"}}, "options_page": "options.html", "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current tab's URL"}}, "icons": {"16": "resources/icon16.png", "48": "resources/icon48.png", "128": "resources/icon128.png"}, "web_accessible_resources": [{"resources": ["resources/kofi-icon.png"], "matches": ["<all_urls>"]}]}