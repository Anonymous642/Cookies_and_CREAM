{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Followers Exporter Local", "version": "1.0.0", "description": "Collect visible Instagram followers or following into local CSV/JSON files, or import your downloaded relationship JSON.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "worker.js"}, "action": {"default_title": "Open Followers Exporter"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["shared.js", "collector.js"], "run_at": "document_idle"}]}