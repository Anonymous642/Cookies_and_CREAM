{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Fatomate", "description": "Automate Your Facebook in Seconds", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "storage", "activeTab", "scripting", "cookies", "declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "host_permissions": ["*://*.facebook.com/*", "https://fatomate-production.up.railway.app/*"], "action": {"default_title": "Fatomate"}, "side_panel": {"default_path": "src/sidebar.html"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["src/inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.facebook.com/*"], "js": ["src/content.js"], "run_at": "document_start"}]}