{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Eyedle", "version": "2.0.0", "description": "Reminds your eyes to blink and gently squints your screen the longer you stare. Take care of your eyes.", "permissions": ["storage", "activeTab", "tabs", "contextMenus", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Turn Eyedle on or off"}, "snooze-30": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Snooze Eyedle for 30 minutes"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}