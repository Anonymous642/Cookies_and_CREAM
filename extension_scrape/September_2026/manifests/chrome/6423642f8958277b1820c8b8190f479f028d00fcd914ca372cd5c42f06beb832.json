{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Video Speed Controller", "version": "1.1", "description": "Control and auto-apply YouTube playback speed up to 10x.", "permissions": ["storage", "scripting", "tabs"], "background": {"service_worker": "background.js"}, "commands": {"speed_1x": {"suggested_key": {"default": "Alt+1"}, "description": "Set speed to 1x"}, "speed_2x": {"suggested_key": {"default": "Alt+2"}, "description": "Set speed to 2x"}, "speed_3x": {"suggested_key": {"default": "Alt+3"}, "description": "Set speed to 3x"}, "speed_4x": {"suggested_key": {"default": "Alt+4"}, "description": "Set speed to 4x"}}, "action": {"default_popup": "popup.html", "default_icon": "media/icon.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "icons": {"128": "media/icon.png"}}