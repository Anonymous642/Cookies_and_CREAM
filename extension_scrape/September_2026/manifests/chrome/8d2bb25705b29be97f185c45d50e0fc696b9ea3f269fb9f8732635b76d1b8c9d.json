{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grow on X: Consistency Tracker", "version": "1.0.0", "description": "Gamify your growth on X. Track daily posts & replies, visualize your consistency with a contribution graph, and build a habit.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://cdn.syndication.twimg.com/*"], "action": {"default_popup": "popup.html", "default_title": "Grow on X"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["assets/content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}