{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rendemo - Interactive Demo Recorder & Product Tours", "description": "Record any web app once and turn it into a clickable interactive demo you can embed anywhere. Free plan, no watermark tricks.", "version": "0.10.7", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "homepage_url": "https://www.rendemo.com/extension", "action": {"default_title": "Rendemo", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "permissions": ["tabs", "storage", "activeTab", "scripting", "webNavigation", "alarms", "debugger"], "optional_permissions": ["tabCapture", "desktopCapture", "offscreen"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://rendemo.com/*", "https://*.rendemo.com/*", "http://localhost:3000/*"]}, "commands": {"start-recording": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Start recording the active tab with Rendemo"}, "stop-recording": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Stop the active Rendemo recording"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["offscreen.html", "recorder.html", "desktop-recorder.html", "calibrate.html", "models/*", "models/**"], "matches": ["<all_urls>"]}], "background": {"type": "module", "service_worker": "background.js"}, "content_scripts": [{"matches": ["http://localhost:3000/*", "https://*.rendemo.com/*", "https://rendemo.com/*"], "run_at": "document_start", "js": ["content-scripts/bridge.js"]}, {"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"], "match_origin_as_fallback": true}]}