{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Outlook Email Spicer", "version": "1.0.10", "description": "Make important parts of Outlook web emails larger and colorized (dates, names, emails, phones).", "action": {"default_popup": "popup.html", "default_title": "Spice up this email"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://outlook.office.com/*", "https://*.outlook.office.com/*", "https://outlook.live.com/*", "https://*.office.com/*", "https://outlook.office365.com/*", "https://*.outlook.office365.com/*"], "content_scripts": [{"matches": ["https://outlook.office.com/*", "https://*.outlook.office.com/*", "https://outlook.live.com/*", "https://*.office.com/*", "https://outlook.office365.com/*", "https://*.outlook.office365.com/*"], "js": ["content_script.js"], "all_frames": true, "run_at": "document_idle"}]}