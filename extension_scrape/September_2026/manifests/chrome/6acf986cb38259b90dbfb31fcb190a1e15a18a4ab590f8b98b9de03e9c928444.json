{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "x-coms Overlay", "description": "Adds an independent x-coms community sidebar to x.com.", "version": "0.1.8", "icons": {"128": "logo.png"}, "action": {"default_title": "x-coms", "default_popup": "popup.html", "default_icon": "logo.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://x-coms.com/*", "https://www.x-coms.com/*"], "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]}