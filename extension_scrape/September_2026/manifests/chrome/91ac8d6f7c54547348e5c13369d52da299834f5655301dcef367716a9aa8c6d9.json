{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PiPlet", "version": "1.0.1", "description": "Toggle Picture-in-Picture on YouTube with a toolbar button or in-page pill.", "action": {"default_title": "Toggle PiP", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"], "js": ["piplet-core.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}