{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lights Off \u2014 Dark Mode for Every Site", "version": "2.0.0", "description": "Turn any website dark. Per-site memory, brightness and warmth controls, a night schedule, and a one-key shortcut.", "minimum_chrome_version": "108", "permissions": ["storage", "scripting", "alarms", "contextMenus"], "optional_permissions": ["geolocation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/core.js", "content.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Lights Off", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-site": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Toggle dark mode on this site"}, "toggle-global": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Pause or resume Lights Off everywhere"}, "cycle-mode": {"description": "Switch between Invert and Dim"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}