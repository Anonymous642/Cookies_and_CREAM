{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chinna", "description": "Chinna \u2014 local-first side-panel browser agent. Sign in to Chinna-assistant to run tasks.", "version": "1.1.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "116", "permissions": ["sidePanel", "tabs", "tabGroups", "scripting", "storage", "alarms", "activeTab", "downloads", "notifications"], "optional_host_permissions": ["<all_urls>", "http://*/*", "https://*/*"], "host_permissions": ["https://chinna-assistant.vercel.app/*", "https://html.duckduckgo.com/*", "https://duckduckgo.com/*"], "action": {"default_title": "Open Chinna", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*", "overlay.html", "mic-capture.html"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"toggle-side-panel": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle Chinna side panel"}, "stop-agent": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop Chinna agent"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}