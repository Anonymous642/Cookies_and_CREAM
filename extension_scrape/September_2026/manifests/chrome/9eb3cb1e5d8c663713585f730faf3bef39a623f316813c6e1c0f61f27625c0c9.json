{"update_url": "https://clients2.google.com/service/update2/crx", "name": "RTL Direction for ChatGPT \u2014 Arabic, Hebrew & Persian", "description": "Auto-detects Arabic, Hebrew, Persian text in ChatGPT and switches to RTL. Code blocks stay untouched. Works on chatgpt.com.", "version": "1.0.0", "manifest_version": 3, "background": {"service_worker": "background.js"}, "permissions": [], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "action": {"default_title": "Toggle language direction", "default_popup": "popup.html"}, "commands": {"toggle-direction": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle RTL direction"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}