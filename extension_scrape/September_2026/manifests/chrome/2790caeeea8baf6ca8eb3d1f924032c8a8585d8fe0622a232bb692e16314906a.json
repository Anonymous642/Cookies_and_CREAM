{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bulwark \u2014 Privacy Posture & Tracker Shield", "short_name": "Bulwark", "version": "1.0.0", "description": "Audits your browser's privacy settings, blocks trackers, and flags risky extensions. Everything runs on your machine.", "minimum_chrome_version": "116", "permissions": ["storage", "privacy", "management", "declarativeNetRequest", "activeTab", "scripting"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Bulwark", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "analytics", "enabled": true, "path": "rules/analytics.json"}, {"id": "advertising", "enabled": true, "path": "rules/advertising.json"}, {"id": "session_replay", "enabled": true, "path": "rules/session_replay.json"}, {"id": "fingerprinting", "enabled": true, "path": "rules/fingerprinting.json"}, {"id": "link_cleaner", "enabled": false, "path": "rules/link_cleaner.json"}]}}