{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Qai the Sales Agent", "version": "1.0.3", "description": "Adds a Qai reply button to Gmail and Outlook threads and assists with AI-generated replies.", "permissions": ["activeTab", "storage", "sidePanel", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' http://localhost:3000 https://app.qualifier.ai; connect-src 'self' http://localhost:3000 https://app.qualifier.ai"}, "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://app.qualifier.ai/*", "http://localhost:3000/*"], "side_panel": {"default_path": "sidebar.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["settings.js", "selectors_config.js", "content.js", "gmail.js"], "run_at": "document_idle"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["settings.js", "selectors_config.js", "content.js", "outlook.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Qai"}, "web_accessible_resources": [{"resources": ["sidebar.html", "extension_selectors.json"], "matches": ["<all_urls>"]}]}