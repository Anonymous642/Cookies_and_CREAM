{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DH Auto Refresh \u2014 Page Monitor", "version": "1.0.0", "description": "Auto refresh pages on fixed, random, or custom intervals with page monitoring, captcha & error detection. By Digital Heroes.", "minimum_chrome_version": "120", "permissions": ["tabs", "storage", "alarms", "notifications", "offscreen", "sidePanel", "webRequest", "webNavigation", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "ui/popup.html", "default_title": "DH Auto Refresh", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "side_panel": {"default_path": "ui/sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}]}