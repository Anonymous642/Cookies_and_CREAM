{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reqoto", "version": "0.5.0", "description": "Capture an X post, copy it with your reply prompt, and fill ChatGPT.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "offscreen", "clipboardWrite", "scripting"], "host_permissions": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://chatgpt.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Reqoto settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"], "js": ["locale.js", "content/x-extract.js", "content/x-button.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["locale.js", "content/chatgpt-fill.js"], "run_at": "document_idle"}]}