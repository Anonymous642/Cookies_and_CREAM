{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WatchPanda", "version": "0.19.3", "description": "Pair a YouTube reaction with a Crunchyroll, Hulu, Netflix, or Disney+ episode using its visible timer.", "minimum_chrome_version": "120", "background": {"service_worker": "src/background.js"}, "action": {"default_title": "WatchPanda", "default_icon": {"16": "icons/watchpanda-16.png", "32": "icons/watchpanda-32.png", "48": "icons/watchpanda-48.png", "128": "icons/watchpanda-128.png"}}, "icons": {"16": "icons/watchpanda-16.png", "32": "icons/watchpanda-32.png", "48": "icons/watchpanda-48.png", "128": "icons/watchpanda-128.png"}, "content_scripts": [{"matches": ["https://*.crunchyroll.com/watch/*", "https://*.crunchyroll.com/*/watch/*", "https://www.hulu.com/watch/*", "https://www.netflix.com/watch/*", "https://www.disneyplus.com/play/*", "https://www.disneyplus.com/*/play/*"], "js": ["src/common.js", "src/media.js", "src/hulu.js", "src/netflix.js", "src/disney.js", "src/engine.js", "src/panel.js", "src/timer-entry.js", "src/controller.js"], "all_frames": false, "run_at": "document_idle"}, {"matches": ["https://static.crunchyroll.com/*"], "js": ["src/common.js", "src/media.js", "src/controller.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/embed/*"], "js": ["src/media.js", "src/youtube.js"], "all_frames": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' data:; object-src 'none'; style-src 'self';"}, "permissions": ["activeTab", "offscreen"]}