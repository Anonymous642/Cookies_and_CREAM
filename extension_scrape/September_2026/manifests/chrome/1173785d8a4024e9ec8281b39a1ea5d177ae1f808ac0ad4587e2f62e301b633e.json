{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stash - Close Tabs Without Losing Them", "description": "A tab manager that saves every open tab in one click and frees your memory. They stay safe on your device until you want them back.", "version": "1.3.4", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "116", "permissions": ["contextMenus", "storage", "unlimitedStorage", "tabs", "alarms", "favicon", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Stash", "default_popup": "popup.html"}, "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in the current window"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}