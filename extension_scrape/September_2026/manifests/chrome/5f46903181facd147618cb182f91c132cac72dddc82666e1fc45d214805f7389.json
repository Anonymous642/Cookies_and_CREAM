{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTShortsPlus", "version": "1.0.0", "description": "Bring YouTube Shorts to Life! Upgrade your Shorts experience with powerful features YouTube forgot to add", "icons": {"128": "icons/icon.png"}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "src/popup/index.html", "default_icon": "icons/icon.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["assets/css/common.css"]}], "commands": {"prev-shorts": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Prev Shorts"}, "next-shorts": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Next Shorts"}, "toggle-play": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Pause/Play Shorts"}, "like-shorts": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Toggle like on Shorts"}, "dislike-shorts": {"description": "Toggle Dislike on Shorts (set manually in chrome://extensions/shortcuts)"}, "mute-shorts": {"description": "Mute Shorts sound"}, "open-settings": {"description": "Open extension popup"}}, "web_accessible_resources": [{"resources": ["assets/*.css"], "matches": ["<all_urls>"]}]}