{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal STEM Literature Exporter", "version": "1.2.0", "description": "Export paper metadata from PubMed, Scholar, IEEE Xplore, arXiv, ACS, and more into clean CSVs for literature reviews.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://pubmed.ncbi.nlm.nih.gov/*", "https://scholar.google.com/*", "https://scholar.google.ca/*", "https://scholar.google.co.uk/*", "https://ieeexplore.ieee.org/*", "https://arxiv.org/*", "https://pubs.acs.org/*", "https://www.nature.com/*", "https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Universal STEM Literature Exporter", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}