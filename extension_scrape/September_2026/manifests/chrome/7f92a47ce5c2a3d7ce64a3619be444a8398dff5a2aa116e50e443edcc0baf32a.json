{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusBold - Faster Web Reading", "version": "1.0.0", "description": "Bold the start of each word on articles so reading feels faster. Local toggle \u2014 no endless loading spinner.", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "FocusBold", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-focusbold": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle FocusBold on this page"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}