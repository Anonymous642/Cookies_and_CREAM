{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AnyPiece", "description": "AnyPiece (Any Piece) lets you clip any part of any webpage and save it as a visual piece.", "version": "0.1.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "AnyPiece", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"begin-clip": {"suggested_key": {"default": "Alt+X", "mac": "Option+X"}, "description": "Start clipping the current page"}}, "permissions": ["activeTab", "scripting"], "web_accessible_resources": [{"resources": ["icons/scissors.svg"], "matches": ["<all_urls>"]}]}