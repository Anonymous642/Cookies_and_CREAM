{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Agent", "version": "1.0.1", "description": "Control Reddit with plain English. Browse, comment, vote, and more.", "permissions": ["activeTab", "storage", "tabs", "scripting", "sidePanel"], "host_permissions": ["https://old.reddit.com/*", "https://www.reddit.com/*", "https://www.getredditagent.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://old.reddit.com/*", "https://www.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}