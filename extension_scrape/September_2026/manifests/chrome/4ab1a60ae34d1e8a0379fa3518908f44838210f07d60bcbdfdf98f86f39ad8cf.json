{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CommandBar+", "version": "1.0.2", "description": "A keyboard-triggered command interface for browser control and AI-powered actions", "permissions": ["tabs", "clipboardWrite", "storage", "activeTab", "scripting", "contextMenus", "windows", "bookmarks", "sessions", "downloads", "management", "history", "tabGroups", "topSites", "browsingData", "scripting", "notifications"], "host_permissions": ["https://api.groq.com/*", "<all_urls>"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["recorder.html", "recorder.js"], "matches": ["<all_urls>"]}], "incognito": "spanning", "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+J"}, "description": "Toggle CommandBar+"}, "pop_to_root_search": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Pop to root search"}}}