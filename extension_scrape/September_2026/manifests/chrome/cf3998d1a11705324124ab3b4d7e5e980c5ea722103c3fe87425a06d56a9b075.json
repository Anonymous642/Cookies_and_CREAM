{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MAGE AI Exporter", "version": "1.0.0", "description": "Export AI conversations from Claude, ChatGPT, Gemini and Grok as HTML, JSON, TXT or Markdown. One click, fully local.", "icons": {"16": "src/icons/icon16.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "src/icons/icon16.png", "48": "src/icons/icon48.png"}}, "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["https://*.googleusercontent.com/*", "https://*.google.com/*", "https://*.ggpht.com/*", "https://*.openai.com/*", "https://*.oaiusercontent.com/*", "https://cdn.openai.com/*", "https://*.anthropic.com/*", "https://*.claude.ai/*", "https://*.x.com/*", "https://*.twimg.com/*", "https://*.grok.com/*", "https://*.xai.com/*"], "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["src/adapters/base.js", "src/adapters/claude.js"], "run_at": "document_idle"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["src/lib/purify.min.js", "src/lib/highlight.min.js", "src/adapters/base.js", "src/adapters/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["src/lib/highlight.min.js", "src/adapters/base.js", "src/adapters/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://grok.com/*", "https://x.com/i/grok*"], "js": ["src/adapters/base.js", "src/adapters/grok.js"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["src/icons/*", "src/lib/*", "src/lib/katex-fonts/*", "src/lib/fonts/*"], "matches": ["<all_urls>"]}]}