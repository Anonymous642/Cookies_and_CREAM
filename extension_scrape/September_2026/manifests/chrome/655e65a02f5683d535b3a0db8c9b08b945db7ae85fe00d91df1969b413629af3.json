{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice Notes to Notion, Google Docs & Gmail", "description": "Record a voice note, get it transcribed, and send it to Notion, Google Docs, Google Sheets or Gmail. Or just keep it and share.", "version": "1.0.0", "short_name": "SendMyVoice", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "storage"], "externally_connectable": {"matches": ["https://sendmyvoice.com/*"]}, "action": {}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content-scripts/gmail.js"]}]}