{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EcoTab: Carbon-Conscious Tab Manager", "version": "1.0.0", "description": "Hibernate inactive tabs intelligently and track your carbon savings. Every closed tab is a step towards a greener planet. \ud83c\udf3f", "author": "GreenCo", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "EcoTab \u2014 Carbon Conscious Browsing"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "idle", "alarms", "scripting", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["http://localhost:5000/*", "https://localhost:5000/*", "http://ip-api.com/*", "<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "energy_rules", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["sleep.html", "sleep.js"], "matches": ["<all_urls>"]}]}