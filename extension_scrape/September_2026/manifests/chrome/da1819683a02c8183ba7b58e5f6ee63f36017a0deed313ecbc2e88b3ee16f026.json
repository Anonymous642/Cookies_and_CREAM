{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FaceGuard", "version": "0.17.0", "description": "Protect browser pages with continuous, on-device owner face recognition.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "scripting", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "options_page": "options.html", "action": {"default_title": "FaceGuard settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["lock.css"], "matches": ["http://*/*", "https://*/*"]}]}