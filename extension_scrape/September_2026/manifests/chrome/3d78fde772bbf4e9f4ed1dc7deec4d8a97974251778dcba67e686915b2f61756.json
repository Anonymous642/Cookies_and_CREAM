{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "137", "name": "Obsecurea", "version": "0.1.2", "description": "Locally filters sensitive images and explicit language, blocks common ads, and syncs your Obsecurea exclusions.", "permissions": ["identity", "storage", "alarms", "offscreen", "declarativeNetRequest"], "host_permissions": ["https://app.obsecurea.com/*", "http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "obsecurea_ads", "enabled": true, "path": "ad-rules.json"}]}, "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["media-guard.css"], "js": ["language-guard.js", "media-guard.js"], "run_at": "document_start", "all_frames": true}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}