{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FloatStream", "version": "1.0.0", "description": "Float any stream into a picture-in-picture mini player. Works on Twitch, YouTube, Kick and more with just a simple keybind", "author": "tojuszn", "homepage_url": "https://github.com/tojuszn/floatstream", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "commands"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FloatStream by tojuszn"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"float-video": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Float the video on this tab into a mini player"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}