{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatHandoff - AI Chat Transfer", "description": "Move & export AI chats: ChatGPT, Claude, Gemini & more. Full conversation in one click. Export Markdown.", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png", "256": "icon-256.png", "512": "icon-512.png"}, "permissions": ["storage", "tabs", "activeTab", "clipboardWrite"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://api.polar.sh/*"], "action": {"default_title": "ChatHandoff", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "commands": {"transfer-handoff": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Transfer chat to the other model"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}