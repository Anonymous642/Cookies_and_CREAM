{"update_url": "https://clients2.google.com/service/update2/crx", "version": "2.2.0", "manifest_version": 3, "name": "Tab Locker Room", "description": "Password-protect your tabs with a secure full-page lock screen. Unlock once per tab, auto re-lock on inactivity.", "minimum_chrome_version": "116", "homepage_url": "https://github.com/The-x-35/tab-locker-room", "permissions": ["tabs", "storage", "scripting", "alarms", "contextMenus", "idle"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["js/content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "js/index.html", "default_title": "Tab Locker Room", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"lock-current-tab": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock the current tab"}, "lock-browser": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Lock the whole browser"}, "hide-current-tab": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "MacCtrl+Shift+H"}, "description": "Hide the current tab in the vault"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["js/auth.html"], "matches": ["http://*/*", "https://*/*"]}]}