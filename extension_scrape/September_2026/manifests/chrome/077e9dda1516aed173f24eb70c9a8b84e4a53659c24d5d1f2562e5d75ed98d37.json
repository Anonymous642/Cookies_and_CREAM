{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Off-Hours PR Guard", "version": "1.0.0", "description": "Helps prevent PR merges during off-hours on GitHub by blocking merge buttons and requiring explicit acknowledgement.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Off-hours PR merge settings", "default_icon": "icons/icon.svg"}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "content_scripts": [{"matches": ["https://github.com/*/pull/*"], "js": ["content.js"], "run_at": "document_idle"}]}