{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shortless", "description": "Hide YouTube Shorts and distractions. Optional Slop patrol checks video metadata for low-value content.", "version": "2.1", "icons": {"48": "images/icon-48.png", "64": "images/icon-64.png", "96": "images/icon-96.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["selectors.js", "video-selectors.js", "cloud-classifier.js", "content.js"], "css": ["content.css"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "shorts_assets", "enabled": true, "path": "rules.json"}]}, "optional_host_permissions": ["https://patrol.shortless.app/*"], "action": {"default_title": "Shortless", "default_popup": "popup.html", "default_icon": {"48": "images/icon-48.png"}}, "options_ui": {"page": "history.html", "open_in_tab": true}, "minimum_chrome_version": "148"}