{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "contentgrove", "description": "Generate and insert contentgrove links while editing YouTube Studio descriptions.", "version": "0.9.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["sidePanel", "storage", "tabs"], "host_permissions": ["https://studio.youtube.com/*", "https://app.contentgrove.io/*"], "action": {"default_title": "Open contentgrove side panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}