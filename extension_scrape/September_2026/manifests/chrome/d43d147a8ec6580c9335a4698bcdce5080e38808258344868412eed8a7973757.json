{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Nodes Tree - Vertical Tree Style Tabs in Side Panel", "description": "Effortlessly navigate and organize your tabs with an intuitive tree-style view", "default_locale": "en", "options_page": "options.html", "devtools_page": "devtools.html", "side_panel": {"default_path": "side-panel.html"}, "background": {"service_worker": "background.bundle.js"}, "action": {"default_icon": "logo-34.png", "default_title": "Open Tabs Nodes Tree"}, "icons": {"128": "logo-128.png"}, "web_accessible_resources": [{"resources": ["content.styles.css", "logo-128.png", "logo-34.png"], "matches": []}], "permissions": ["tabs", "sidePanel", "tabGroups", "storage", "commands", "alarms", "webNavigation"], "content_security_policy": {"extension_pages": "script-src 'self' http://localhost:*; connect-src http://localhost:* ws://localhost:* https://*.tab-nodes-tree.app"}, "commands": {"create_new_tab_at_the_same_level": {"suggested_key": {"default": "Alt+A", "mac": "MacCtrl+Shift+A"}, "description": "Create a new tab at the same level"}, "create_new_tab_as_a_child": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+Command+A"}, "description": "Create a new tab as a child"}, "duplicate_active_tab": {"description": "Duplicate active tab"}, "add_to_branch": {"suggested_key": {"default": "Alt+B", "mac": "MacCtrl+Command+B"}, "description": "Add selected tab nodes to a branch"}, "open_quick_navigation_panel": {"suggested_key": {"default": "Ctrl+Q", "mac": "MacCtrl+Q"}, "description": "Open \"Quick Navigation Panel\""}, "open_search_bar": {"description": "Open/Close \"Search Bar\""}, "enable_regex_search": {"description": "Enable regular expression search"}, "focus_previous_search_result": {"description": "Focus previous search result"}, "focus_next_search_result": {"description": "Focus next search result"}, "activate_focused_node": {"description": "Activate focused node"}}, "version": "1.7.2"}