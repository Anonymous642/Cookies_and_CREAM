{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy Context \u2014 Continue Any AI Chat Anywhere", "version": "2.0.1", "description": "Copy a Claude, ChatGPT, or Gemini conversation into a clean, paste-ready transcript so you can continue it in any other AI chat.", "permissions": ["clipboardWrite", "activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "Copy Context"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://claude.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://share.gemini.google/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}