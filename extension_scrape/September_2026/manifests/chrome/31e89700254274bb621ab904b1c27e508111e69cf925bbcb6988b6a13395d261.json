{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quietwall \u2014 Ad & Tracker Blocker", "version": "1.3.2", "minimum_chrome_version": "120", "description": "Block ads, trackers, popups, risky redirects, and many video ads. Local Manifest V3 protection with no developer telemetry.", "permissions": ["activeTab", "alarms", "declarativeNetRequest", "scripting", "storage", "webNavigation", "webRequest"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Open Quietwall", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["redirect/*"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": false}, {"resources": ["focus.html"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": false}], "declarative_net_request": {"rule_resources": [{"id": "unbreak", "enabled": true, "path": "rules/unbreak.json"}, {"id": "ads", "enabled": true, "path": "rules/ads.json"}, {"id": "trackers", "enabled": true, "path": "rules/trackers.json"}, {"id": "threats", "enabled": true, "path": "rules/threats.json"}, {"id": "telemetry", "enabled": true, "path": "rules/telemetry.json"}, {"id": "social", "enabled": false, "path": "rules/social.json"}, {"id": "annoyances", "enabled": false, "path": "rules/annoyances.json"}, {"id": "https", "enabled": false, "path": "rules/https.json"}]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}