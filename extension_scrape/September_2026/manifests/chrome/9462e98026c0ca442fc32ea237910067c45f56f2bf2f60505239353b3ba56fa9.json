{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Declutter", "version": "1.1.2", "description": "Hide view counts, engagement metrics and side menus on YouTube Studio, TikTok and X. Pick anything to remove it.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Social Declutter"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://studio.youtube.com/*", "https://www.tiktok.com/*", "https://x.com/*", "https://twitter.com/*"], "css": ["declutter.css"], "js": ["declutter.js"], "run_at": "document_start"}]}