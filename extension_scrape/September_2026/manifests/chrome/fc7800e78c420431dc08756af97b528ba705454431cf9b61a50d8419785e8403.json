{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyncToSheet \u2013 LinkedIn to Google Sheets Sync", "version": "2.0.0", "description": "One-click LinkedIn to Google Sheets sync. Capture profile data and save it instantly to your spreadsheet.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://app.synctosheet.com/*", "https://api.synctosheet.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/company/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["auth/auth.html"], "matches": ["https://app.synctosheet.com/*"]}, {"resources": ["icons/icon16.png", "icons/icon32.png"], "matches": ["https://www.linkedin.com/*"]}]}