{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No More Scroll", "version": "1.2", "description": "Limit Social Network usage to help prevent social media addiction and promote healthier browsing habits.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.threads.net/*"], "content_scripts": [{"matches": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.threads.net/*"], "js": ["content.js"]}]}