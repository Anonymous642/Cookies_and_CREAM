{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Suno LoopLess", "version": "8.0.0", "description": "Analyzes and sends songs in bulk to Suno. Developed by Nardoto.", "author": "Nardoto", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background/update-handler.js"}, "permissions": ["storage", "identity"], "host_permissions": ["https://suno.com/*", "https://firestore.googleapis.com/*", "https://nardoto-labs.web.app/*", "https://*.googleapis.com/*"], "content_scripts": [{"matches": ["https://suno.com/*"], "js": ["src/auth/firebase-config.js", "src/auth/auth-manager.js", "content.js"], "css": ["sidebar.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["sidebar.html", "icons/*", "src/auth/firebase-config.js", "src/auth/auth-manager.js"], "matches": ["https://suno.com/*"]}]}