{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blip \u2014 AI Chat for YouTube & the Web", "version": "5.0.0", "description": "Blip adds an AI chat panel to YouTube and any web page \u2014 ask questions and get summaries using your own provider API key.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "scripting", "unlimitedStorage"], "host_permissions": ["*://*.youtube.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://openrouter.ai/*", "https://integrate.api.nvidia.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/debug-log.js", "content/markdown.js", "content/chat-ui.js", "content/content-script.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Toggle YouTube AI Chat", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://api.openai.com https://openrouter.ai https://integrate.api.nvidia.com https://*.youtube.com; base-uri 'none'; frame-ancestors 'none'"}, "web_accessible_resources": [{"resources": ["content/chat-ui.css", "assets/mascots/*.png"], "matches": ["*://*.youtube.com/*"]}, {"resources": ["content/chat-ui.css", "assets/mascots/*.png"], "matches": ["https://*/*"]}]}