{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ProxyStar", "description": "ProxyStar allows you to configure proxy settings. It supports HTTP, HTTPS, SOCKS4, and SOCKS5 proxies.", "version": "1.2.2", "manifest_version": 3, "action": {"default_popup": "html/popup.html", "default_icon": "icon/32.png"}, "icons": {"32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "proxy", "webRequest", "clipboardRead", "webRequestAuthProvider"], "background": {"service_worker": "worker.js"}, "host_permissions": ["*://*/*", "<all_urls>"]}