{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AiPal - Multi AI Sidebar Assistant for Chrome", "version": "1.0", "description": "Instantly Chat and Work with ChatGPT, Claude, Gemini & 5 more AI Tools directly from your Chrome side panel without switching tabs", "permissions": ["contextMenus", "storage", "sidePanel", "activeTab", "scripting", "declarativeNetRequest"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://claude.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://www.meta.ai/*"], "commands": {"send-selection": {"suggested_key": {"default": "Alt+A"}, "description": "Continue chat with selected text (Alt+A)"}}, "background": {"service_worker": "background.js", "type": "module"}, "declarative_net_request": {"rule_resources": [{"enabled": true, "id": "ruleset_1", "path": "rules.json"}]}, "content_scripts": [{"all_frames": true, "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://claude.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://www.meta.ai/*"], "js": ["content.js"]}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}