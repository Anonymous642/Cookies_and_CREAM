{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WEBShift", "version": "1.2.4", "description": "Switch any website between Light and Dark \u2014 instantly.", "action": {"default_title": "WEBShift", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "options_page": "options/options.html", "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"toggle-mode": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Command+Shift+D"}, "description": "Cycle WEBShift appearance on the current page"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["content/theme.css"], "js": ["utils/site-utils.js", "utils/storage.js", "content/theme-engine.js", "content/content.js"], "run_at": "document_start"}]}