{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chitchatfill - Auto expander", "description": "An elegant text expander with autofill. Press \"==\" to expand your snippets anywhere.", "version": "3.6.5", "action": {"default_title": "Chitchatfill - Toggle sidebar", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "permissions": ["scripting", "storage", "tabs", "alarms", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shadowHost.js", "content.js", "overlay.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+E"}, "description": "Toggle Chitchatfill popup sidebar"}}, "web_accessible_resources": [{"resources": ["sidepanel/sidepanel.html", "assets/*", "content.css"], "matches": ["http://*/*", "https://*/*"]}]}