{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rotating Tabs", "version": "1.0.6", "description": "Automate tab rotation with custom timers, smart skipping (pinned/audio/URLs), auto-refresh, and startup automation.", "permissions": ["tabs", "storage", "alarms", "idle"], "action": {"default_popup": "popup/popup.html", "default_title": "Chrome Tab Rotator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"service_worker": "background/service-worker.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle_rotation": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle Tab Rotation On/Off"}, "rotate_next": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Alt+Shift+Right"}, "description": "Rotate to Next Tab"}, "rotate_prev": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Alt+Shift+Left"}, "description": "Rotate to Previous Tab"}}, "minimum_chrome_version": "102"}