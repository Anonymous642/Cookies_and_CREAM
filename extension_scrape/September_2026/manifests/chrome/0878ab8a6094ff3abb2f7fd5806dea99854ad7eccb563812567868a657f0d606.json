{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loadout", "short_name": "Loadout", "version": "0.14.0", "description": "Capture a window of tabs as a page and reopen it in one click. Group links into boards. Everything stays on this device.", "minimum_chrome_version": "116", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "bookmarks", "contextMenus", "scripting", "activeTab", "favicon"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Loadout \u2014 save this tab", "default_popup": "src/popup.html"}, "chrome_url_overrides": {"newtab": "src/newtab.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "quick-save": {"description": "Save the current tab without asking (unassigned by default)"}, "capture-window": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture every tab in this window as a new project"}, "toggle-privacy": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Blur names and links for screen sharing"}}, "optional_host_permissions": ["http://*/*", "https://*/*"]}