{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JT Focus Mode", "version": "1.0.0", "description": "Distraction-free browsing for YouTube, X/Twitter, Instagram, and Facebook.", "minimum_chrome_version": "114", "action": {"default_title": "JT Focus Mode", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "https://api.gumroad.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["src/content/twitter.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["src/content/instagram.js"], "run_at": "document_idle"}, {"matches": ["*://*.facebook.com/*"], "js": ["src/content/facebook.js"], "run_at": "document_idle"}]}