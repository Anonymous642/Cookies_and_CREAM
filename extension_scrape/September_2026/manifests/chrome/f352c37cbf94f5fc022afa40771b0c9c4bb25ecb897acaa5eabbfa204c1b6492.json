{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RunMacro Smart HTML", "version": "1.1.0", "description": "Smart HTML selector, explorer, and recording bridge for RunMacro automation.", "permissions": ["activeTab", "tabs", "scripting", "contextMenus", "storage", "alarms", "webNavigation"], "host_permissions": ["http://127.0.0.1:9888/*", "http://localhost:9888/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "RunMacro Smart HTML", "default_popup": "explorer.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"pick-hovered-element": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Pick hovered element for Smart HTML"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["resolver.js", "content.js"], "run_at": "document_idle", "all_frames": true}]}