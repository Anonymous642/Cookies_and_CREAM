{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zapspace", "description": "Save tasks from any webpage to your Zapspace account", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://api.zapspace.tech/*", "https://app.zapspace.tech/*"], "action": {"default_title": "Zapspace", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"mac": "Command+E", "windows": "Ctrl+E", "default": "Ctrl+E"}, "description": "Open Zapspace"}}, "externally_connectable": {"matches": ["https://app.zapspace.tech/*"]}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://app.zapspace.tech/auth/extension*"], "run_at": "document_idle", "js": ["content-scripts/auth-handoff.js"]}]}