{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zen Notes", "short_name": "Zen Notes", "description": "A calm offline notes extension with website links, sticky notes, markdown tasks, search, YouTube timestamps", "version": "1.2.0", "action": {"default_title": "Zen Notes", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "contextMenus", "downloads", "scripting", "sidePanel", "storage", "tabs"], "host_permissions": ["<all_urls>"], "commands": {"open-panel": {"description": "Open Zen Notes side panel", "suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}}, "quick-capture": {"description": "Save selected text as a note", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "css": ["contentScript.css"], "run_at": "document_idle"}]}