{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reference Link", "description": "Copy YouTube video links for reference. Hold Ctrl and click to instantly copy URLs.", "version": "1.3.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["clipboardWrite", "storage", "tabs"], "host_permissions": ["https://*.youtube.com/*", "https://youtu.be/*"], "action": {"default_popup": "popup.html", "default_title": "Reference Link", "default_icon": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}