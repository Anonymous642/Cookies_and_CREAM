{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ColorSip \u2014 Color Picker & Palette", "version": "1.0.0", "description": "Pick colors from any page, copy HEX, RGB, HSL, OKLCH or a Tailwind class, and build palettes. No host permissions, works offline.", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup/popup.html", "default_title": "ColorSip", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"pick-on-page": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Pick a color from the current page"}}}