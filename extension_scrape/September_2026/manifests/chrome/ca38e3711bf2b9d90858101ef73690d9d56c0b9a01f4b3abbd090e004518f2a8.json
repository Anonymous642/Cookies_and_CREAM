{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GTA x LeetCode", "description": "GTA-style mission passed/wasted overlays for LeetCode submissions. Celebrate your coding victories with style!", "version": "1.1.0", "manifest_version": 3, "action": {"default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}, "default_title": "GTA LeetCode", "default_popup": "popup.html"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["webRequest", "scripting", "activeTab", "cookies"], "host_permissions": ["https://leetcode.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/mission_passed.mp3", "assets/wasted.mp3", "assets/mission_passed_green.mp4", "assets/wasted_green.mp4"], "matches": ["https://leetcode.com/*"]}]}