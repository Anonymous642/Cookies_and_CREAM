{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stager", "version": "1.0.0", "description": "The truly simple tab manager with universal search.", "author": "Miguel Garcia", "minimum_chrome_version": "102", "permissions": ["activeTab", "tabs", "tabGroups", "storage", "unlimitedStorage"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "commands": {"open-search": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Stager and search across all tabs"}, "save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all open tabs to a new Stage"}}, "action": {"default_popup": "popup.html", "default_title": "Open Stager", "default_icon": {"16": "icons/toolbar-16.png", "32": "icons/toolbar-32.png", "48": "icons/toolbar-48.png", "128": "icons/toolbar-128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}