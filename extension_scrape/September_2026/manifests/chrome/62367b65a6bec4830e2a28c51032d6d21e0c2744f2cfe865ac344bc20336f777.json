{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoDuo Extension", "version": "0.1.0", "description": "AutoDuo helps do Duolingo for you, smoothly and automatically.", "icons": {"16": "autoduo_logo.png", "32": "autoduo_logo.png", "48": "autoduo_logo.png", "128": "autoduo_logo.png"}, "permissions": ["tabs", "nativeMessaging", "storage", "scripting"], "action": {"default_title": "AutoDuo", "default_icon": {"16": "autoduo_logo.png", "32": "autoduo_logo.png", "48": "autoduo_logo.png", "128": "autoduo_logo.png"}}, "host_permissions": ["https://www.duolingo.com/*", "https://duolingo.com/*", "http://127.0.0.1:8765/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["autoduo_logo.png", "autoduo_finished_success.png"], "matches": ["https://www.duolingo.com/*", "https://duolingo.com/*"]}], "content_scripts": [{"matches": ["https://www.duolingo.com/*", "https://duolingo.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}