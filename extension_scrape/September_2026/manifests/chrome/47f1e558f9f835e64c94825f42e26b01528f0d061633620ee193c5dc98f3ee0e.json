{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZoomIn \u2014 Inline Maps for Google", "version": "2.0.0", "description": "Instantly see an interactive map when you search for a place on Google \u2014 no tab switching, no clicks.", "author": "ZoomIn", "icons": {"16": "icons16.png", "48": "icons48.png", "128": "icons128.png"}, "action": {"default_title": "ZoomIn", "default_popup": "popup/popup.html", "default_icon": {"16": "icons16.png", "48": "icons48.png", "128": "icons128.png"}}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["src/content.js"], "run_at": "document_idle"}], "host_permissions": ["https://www.google.com/*"], "permissions": ["storage", "tabs"], "web_accessible_resources": [{"resources": ["icons16.png", "icons48.png", "icons128.png"], "matches": ["https://www.google.com/*"]}]}