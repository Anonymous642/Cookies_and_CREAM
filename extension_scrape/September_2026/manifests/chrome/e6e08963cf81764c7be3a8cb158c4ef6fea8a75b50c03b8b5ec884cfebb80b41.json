{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Instagram Reels Ad Blocker", "version": "1.0.0", "description": "Hides sponsored Reels and blocks ad requests on Instagram desktop.", "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.fbcdn.net/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Instagram Reels Ad Blocker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "declarative_net_request": {"rule_resources": [{"id": "ad_rules", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}