{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RemoteTube - Control YouTube PC from your Phone", "version": "2.0.0", "description": "Control YouTube playback on your PC from your mobile device in real-time. Play, pause, seek, volume control, and recommendations.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://www.youtube.com/*", "http://localhost/*", "http://127.0.0.1/*", "https://yt.remay.xyz/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}}