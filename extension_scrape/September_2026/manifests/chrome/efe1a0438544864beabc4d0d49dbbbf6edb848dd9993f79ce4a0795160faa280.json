{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlurMyScreen", "version": "1.4.0", "description": "Blur, mosaic, cover or blackout any tab. Regional blur, auto-blur, PIN lock, focus timer & boss screen. 100% local, no data.", "minimum_chrome_version": "102", "permissions": ["activeTab", "scripting", "storage", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_title": "BlurMyScreen", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle blur on the active tab"}, "boss-screen": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Show/hide the boss screen on the active tab"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}