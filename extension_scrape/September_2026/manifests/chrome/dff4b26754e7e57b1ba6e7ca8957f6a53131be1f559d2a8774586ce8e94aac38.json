{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Later", "version": "1.0.9", "description": "Cross-platform bookmarking manager that lets you capture, classify, remind, and rediscover anything you encounter on the web.", "permissions": ["activeTab", "scripting", "contextMenus", "alarms", "notifications"], "host_permissions": ["https://laterapi.up.railway.app/*", "http://localhost/*", "https://localhost/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["twitter-content.js"], "run_at": "document_end"}, {"matches": ["*://*.linkedin.com/*"], "js": ["linkedin-content.js"], "run_at": "document_end"}, {"matches": ["*://*.substack.com/*"], "js": ["substack-content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Later - Save bookmark", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "src/notification-styles.css"], "matches": ["<all_urls>"]}], "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Save the current tab to Later"}}, "externally_connectable": {"matches": ["https://*.up.railway.app/*", "http://localhost/*", "https://localhost/*"]}}