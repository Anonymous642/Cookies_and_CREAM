{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aplikado Autofill", "version": "0.4.0", "description": "Wype\u0142nia formularze aplikacyjne (te\u017c w iframe) danymi z Twojego konta Aplikado i wstawia gotow\u0105 wiadomo\u015b\u0107 do rekrutera.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.aplikado.pl/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Aplikado", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Otw\u00f3rz Aplikado (autofill / dodaj ofert\u0119)"}}, "content_scripts": [{"matches": ["https://www.aplikado.pl/*"], "js": ["content-bridge.js"], "run_at": "document_idle"}]}