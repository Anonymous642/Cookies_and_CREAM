{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "D365FO OData Link Builder", "version": "1.1.2", "description": "Build D365FO OData URLs with filters, field selection, history, and favorites.", "action": {"default_title": "D365FO OData Link Builder", "default_popup": "popup.html"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "options_page": "options.html", "permissions": ["storage", "tabs", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"}, "host_permissions": ["https://*.dynamics.com/*"], "content_scripts": [{"matches": ["https://*.dynamics.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}