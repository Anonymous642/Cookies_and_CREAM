{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flowork Web Clipper", "version": "0.5.3", "description": "Sauvegarde des articles web et analyse des vid\u00e9os YouTube dans ta biblioth\u00e8que Flowork.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "scripting", "tabs"], "host_permissions": ["https://app.flowork.dev/*", "https://flowork.dev/*", "https://flowork-chi.vercel.app/*", "https://*.youtube.com/*"], "externally_connectable": {"matches": ["https://app.flowork.dev/*", "https://flowork.dev/*", "https://flowork-chi.vercel.app/*", "http://localhost:3000/*"]}, "action": {"default_popup": "popup.html", "default_title": "Sauvegarder dans Flowork (Alt+R)", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["youtube-bridge.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://*.youtube.com/*"], "js": ["reseau.js", "youtube-content.js"], "run_at": "document_idle"}, {"matches": ["https://*.youtube.com/playlist*"], "js": ["youtube-playlist.js"], "run_at": "document_idle"}], "commands": {"save-current-tab": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Sauvegarder l'onglet courant dans Flowork"}}}