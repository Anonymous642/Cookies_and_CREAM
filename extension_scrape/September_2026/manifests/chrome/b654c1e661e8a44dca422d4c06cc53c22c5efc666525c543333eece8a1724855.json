{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Can I Run It? PC Compatibility Checker - Mansone", "short_name": "Can I Run It?", "version": "1.0.0", "description": "Auto-detects your GPU, CPU, and RAM. Search any PC game for an instant compatibility verdict. Works on Steam, Epic, EA, and GOG.", "permissions": ["storage", "activeTab", "scripting", "system.cpu", "system.memory"], "host_permissions": ["*://*.steampowered.com/*", "*://store.epicgames.com/*", "*://ea.com/*", "*://*.ea.com/*", "*://gog.com/*", "*://*.gog.com/*", "https://mansone.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://store.steampowered.com/app/*", "*://store.epicgames.com/*/p/*", "*://store.epicgames.com/p/*", "*://www.ea.com/games/*", "*://ea.com/games/*", "*://www.gog.com/*/game/*", "*://www.gog.com/game/*", "*://gog.com/*/game/*", "*://gog.com/game/*"], "css": ["content/steam.css"], "js": ["content/store.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/wordmark.svg"], "matches": ["*://store.steampowered.com/*", "*://store.epicgames.com/*", "*://*.ea.com/*", "*://*.gog.com/*", "*://gog.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "homepage_url": "https://mansone.com/can-i-run-it"}