{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Catch Up for Twitch", "version": "1.1.2", "description": "An inbox of the streams you missed. Pick your channels, see their recent VODs, and jump straight back in where you left off.", "permissions": ["identity", "storage", "alarms"], "host_permissions": ["https://api.twitch.tv/*", "https://id.twitch.tv/*", "https://www.twitch.tv/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Catch Up for Twitch"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}]}