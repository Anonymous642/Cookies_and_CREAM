{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TockTexture Studio - GameDev Texture Processor", "version": "1.1.2", "description": "Ultra-fast local texture optimization, POT scaling, DirectX/OpenGL Y-flip, DDS encoding, Alpha Bleed, and PBR channel packing.", "permissions": ["sidePanel", "storage", "activeTab", "contextMenus"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["src/modules/ExtPay_content_script.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "TockTexture Studio", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/workers/textureProcessor.worker.js", "src/modules/*", "icons/*"], "matches": ["<all_urls>"]}]}