{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comment Sense: AI-Powered Reference Search", "version": "1.0.0", "description": "AI-powered extension that helps verify factual accuracy of YouTube comments through intelligent reference searching.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://*.wikipedia.org/*", "https://api.semanticscholar.org/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Comment Sense - Reference Search"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.youtube.com/*"]}]}