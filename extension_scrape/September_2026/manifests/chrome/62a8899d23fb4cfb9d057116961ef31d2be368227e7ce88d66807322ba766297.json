{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "README Guard", "version": "1.0.0", "description": "Notifies when your GitHub README is missing, outdated, or lacks badges", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://github.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["styles/content.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/logo.svg", "48": "icons/logo.svg", "128": "icons/logo.svg"}}, "icons": {"16": "icons/logo.svg", "48": "icons/logo.svg", "128": "icons/logo.svg"}, "web_accessible_resources": [{"resources": ["icons/*.svg"], "matches": ["<all_urls>"]}]}