{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Time", "version": "1.0.1", "description": "Screen time management for your browser tabs. Set daily limits on websites and take back control of your browsing.", "permissions": ["storage", "tabs", "alarms", "activeTab", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/timer-light16.png", "32": "icons/timer-light32.png", "48": "icons/timer-light48.png", "128": "icons/timer-light128.png"}}, "icons": {"16": "icons/timer-light16.png", "32": "icons/timer-light32.png", "48": "icons/timer-light48.png", "128": "icons/timer-light128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}