{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Redirect: Block Sites, Stay Focused, Digital Wellbeing", "description": "Site blocker for focus and productivity. Redirect distracting websites like YouTube or Reddit to your goals. Mindful pauses.", "version": "1.7", "short_name": "Redirect", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "alarms", "webNavigation", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Redirect", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["options.html", "icon/128.png"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://heyredirect.com/*"]}, "commands": {"open-dashboard": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open Redirect dashboard"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/timer.js"]}]}