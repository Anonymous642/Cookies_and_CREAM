{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stepshot", "description": "Turn a recorded browser workflow into a step-by-step visual guide. Local-only: nothing ever leaves your browser.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "138", "incognito": "not_allowed", "permissions": ["storage", "offscreen", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start or stop recording"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Stepshot", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}