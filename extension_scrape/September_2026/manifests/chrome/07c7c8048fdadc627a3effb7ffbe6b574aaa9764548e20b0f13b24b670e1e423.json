{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Booster & Video Speed Controller - Bass Boost", "version": "1.0.0", "description": "Boost volume up to 600% with bass & voice EQ, control video playback speed on any site. Per-site memory, keyboard shortcuts.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_idle", "all_frames": true}], "options_page": "src/options/options.html", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["src/content/main.js", "src/content/*.js", "src/lib/*.js"], "matches": ["<all_urls>"]}], "commands": {"volume-up": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Increase volume by 10%"}, "volume-down": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Decrease volume by 10%"}, "speed-up": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Increase video speed"}, "speed-down": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Decrease video speed"}, "toggle-mute": {"description": "Toggle mute"}, "speed-reset": {"description": "Reset video speed to 1x"}, "rewind": {"description": "Rewind video"}, "advance": {"description": "Advance video"}}, "minimum_chrome_version": "116"}