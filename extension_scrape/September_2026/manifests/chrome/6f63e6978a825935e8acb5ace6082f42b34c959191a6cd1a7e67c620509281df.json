{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Markdown It", "description": "Copy any webpage as Markdown with a single click", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "contextMenus", "clipboardWrite", "storage"], "action": {"default_title": "Markdown It", "default_popup": "popup.html"}, "commands": {"copy-as-markdown": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Copy current page as Markdown"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}