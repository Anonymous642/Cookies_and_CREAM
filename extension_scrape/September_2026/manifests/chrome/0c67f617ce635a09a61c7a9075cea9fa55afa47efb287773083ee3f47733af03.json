{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tildew: YouTube transcript & summary", "short_name": "Tildew", "description": "YouTube transcript and timestamped notes in one click. No captions needed. 20 languages. Lectures, podcasts, tutorials.", "version": "0.4.0", "minimum_chrome_version": "120", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["sidePanel", "storage", "identity", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://api.tildew.com/*"], "action": {"default_title": "Open Tildew", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["page.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' https://i.ytimg.com"}}