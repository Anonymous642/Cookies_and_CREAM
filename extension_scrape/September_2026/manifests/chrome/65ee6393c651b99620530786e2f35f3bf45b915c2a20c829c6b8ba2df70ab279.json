{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zithian Email Collector", "version": "1.0.0", "description": "Collects publicly visible email addresses from pages you visit, deduplicates them locally, and exports to CSV/XLSX. All data stays", "permissions": ["storage", "tabs", "downloads", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Zithian Email Collector", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}