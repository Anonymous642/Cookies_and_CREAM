{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coding Solutions Sync", "short_name": "Solutions Sync", "version": "2.0.0", "description": "Automatically commit your accepted LeetCode, DataLemur and StrataScratch solutions to your GitHub repositories.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.github.com/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "action": {"default_title": "Coding Solutions Sync", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://leetcode.com/*", "https://datalemur.com/*", "https://www.datalemur.com/*", "https://platform.stratascratch.com/*"], "js": ["content/main/page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://leetcode.com/*"], "js": ["content/common.js", "content/leetcode.js"], "run_at": "document_idle"}, {"matches": ["https://datalemur.com/*", "https://www.datalemur.com/*"], "js": ["content/common.js", "content/datalemur.js"], "run_at": "document_idle"}, {"matches": ["https://platform.stratascratch.com/*"], "js": ["content/common.js", "content/stratascratch.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}