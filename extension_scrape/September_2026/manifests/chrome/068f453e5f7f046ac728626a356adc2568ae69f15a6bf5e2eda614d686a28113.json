{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yubblo - Better YouTube Chat", "version": "0.1.6", "description": "Chat Client for YouTube Live Chat.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "downloads", "unlimitedStorage", "offscreen"], "host_permissions": ["https://www.youtube.com/*", "https://7tv.io/*"], "background": {"service_worker": "serviceWorker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/live_chat*", "https://www.youtube.com/live_chat_replay*"], "js": ["src/content/chat-injector.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/live/*", "https://www.youtube.com/shorts/*"], "js": ["src/content/watch-stream-probe.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["*", "assets/*", "assets/src/content/chat-interceptor.js", "assets/youtube-page-catalog.js", "src/chat/*", "src/chat/chat.html", "src/content/*", "src/content/chat-interceptor.js"], "matches": ["https://www.youtube.com/*"]}, {"resources": ["assets/src/content/chat-injector.js", "assets/command-catalog.js", "assets/ExtensionI18nProvider.js", "assets/settings.js", "assets/experimental-flags.js", "assets/stream-context.js", "assets/runtime-messaging.js", "assets/youtube-page-catalog.js"], "matches": ["https://www.youtube.com/*", "https://www.youtube.com/*"]}, {"resources": ["assets/src/content/watch-stream-probe.js", "assets/stream-context.js", "assets/runtime-messaging.js"], "matches": ["https://www.youtube.com/*", "https://www.youtube.com/*", "https://www.youtube.com/*"]}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "action": {"default_title": "Yubblo", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}