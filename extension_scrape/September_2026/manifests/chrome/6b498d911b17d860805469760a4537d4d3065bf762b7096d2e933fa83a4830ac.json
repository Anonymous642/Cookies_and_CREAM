{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KeepKit", "version": "3.0.5", "description": "Enhance Google Keep: copy, CSV export, indent/outdent, sounds, themes, Drive attachments. Premium: custom backgrounds.", "author": "KeepKit", "homepage_url": "https://keepkit.nzapps.co.nz", "permissions": ["storage", "tabs"], "host_permissions": ["https://keep.google.com/*", "https://keepkit.nzapps.co.nz/*"], "web_accessible_resources": [{"resources": ["bg/*.png", "bg/*.jpg", "bg/*.gif", "*.png", "*.jpg", "*.gif", "audio/*.mp3", "audio/*.wav"], "matches": ["https://keep.google.com/*"]}], "content_scripts": [{"matches": ["https://keep.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "KeepKit", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}