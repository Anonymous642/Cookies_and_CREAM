{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vocab Flashcards", "version": "2.0", "description": "Select a word, look up its English-English meaning, and review it as a spaced-repetition flashcard.", "permissions": ["contextMenus", "storage", "scripting", "activeTab"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://injaoonja.nl/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://injaoonja.nl/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Vocab Flashcards", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"lookup-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Look up the selected word"}}, "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}]}