{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextToVision", "version": "0.2.1", "description": "Turn selected text into stunning visuals instantly with TextToVision - your smart image search companion!", "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "TextToVision", "default_popup": "popup.html"}, "permissions": ["storage"], "host_permissions": ["https://www.googleapis.com/"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["contentScript.js"]}], "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+I", "windows": "Ctrl+I", "mac": "Command+I"}}}}