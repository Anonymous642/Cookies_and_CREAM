{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zihin \u2014 Bookmark Sync", "version": "0.3.9", "description": "Sync the bookmarks you already saved on X, LinkedIn, and Chrome into your Zihin library \u2014 searchable, taggable, AI-organized.", "permissions": ["bookmarks", "storage", "tabs", "scripting"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://zihin.engineer/*", "https://www.zihin.engineer/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Zihin Bookmark Sync", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["https://www.linkedin.com/*"], "js": ["linkedin-content.js"], "run_at": "document_start"}, {"matches": ["https://zihin.engineer/*", "https://www.zihin.engineer/*"], "js": ["app-bridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-capture.js"], "matches": ["https://x.com/*", "https://twitter.com/*"]}, {"resources": ["linkedin-page-capture.js"], "matches": ["https://www.linkedin.com/*"]}]}