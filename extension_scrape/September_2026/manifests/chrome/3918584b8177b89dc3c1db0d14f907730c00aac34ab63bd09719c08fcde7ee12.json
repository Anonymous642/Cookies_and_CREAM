{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Docs to Google Forms & Fillable Form", "version": "1.0.1", "description": "Turn documents into Google Forms, fillable Google Docs, and fillable PDF worksheets.", "action": {"default_title": "Docs to Google Forms & Fillable Form", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "tabs", "scripting"], "host_permissions": ["https://docs.google.com/*", "https://forms.google.com/*", "https://myquizgpt.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*", "https://docs.google.com/forms/*", "https://forms.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png", "docs_detect.js"], "matches": ["https://docs.google.com/*", "https://forms.google.com/*"]}]}