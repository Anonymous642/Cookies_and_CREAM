{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "version": "1.0.0", "name": "Hello Kitty To-Do List: Cute Task Planner with Pomodoro & Subtasks", "description": "A cute pink to-do list with subtasks, pomodoro timer, recurring tasks, categories & drag-drop sorting. Stay organised in style.", "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["storage", "alarms", "notifications", "contextMenus", "sidePanel"], "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "index.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "add-task": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add a new task"}}, "omnibox": {"keyword": "kitty"}}