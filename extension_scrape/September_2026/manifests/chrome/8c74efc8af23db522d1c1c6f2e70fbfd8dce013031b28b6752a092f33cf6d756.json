{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sornic Reader \u2014 Listen on Page", "short_name": "Sornic Reader", "version": "1.0.0", "description": "Listen to any article directly on the page. In-page audio player with 6 AI voices. No redirect needed.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Listen to this article"}, "permissions": ["activeTab", "contextMenus", "storage", "scripting"], "host_permissions": ["https://sornic.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["content.css", "icons/icon-16.png", "samples/nova.mp3", "samples/alloy.mp3", "samples/echo.mp3", "samples/fable.mp3", "samples/onyx.mp3", "samples/shimmer.mp3"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"listen-to-page": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Listen to current page with Sornic"}}}