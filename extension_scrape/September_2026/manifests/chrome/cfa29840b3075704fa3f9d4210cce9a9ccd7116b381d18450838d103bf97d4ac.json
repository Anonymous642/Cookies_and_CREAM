{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Highlight Search On Internet", "version": "1.0.0", "description": "Select any text, right-click, and get pictures, a summary and web results in a panel over the page.", "permissions": ["contextMenus", "scripting", "activeTab", "storage"], "host_permissions": ["https://*.wikipedia.org/*", "https://www.bing.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Highlight Search On Internet - select text, then right-click", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"lookup-selection": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Quick Info for the selected text"}}, "web_accessible_resources": [{"resources": ["src/modal.html"], "matches": ["<all_urls>"]}]}