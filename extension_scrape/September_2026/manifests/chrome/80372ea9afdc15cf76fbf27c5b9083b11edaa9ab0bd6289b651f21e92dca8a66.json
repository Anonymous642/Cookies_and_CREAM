{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Absolute Zero", "version": "1.0.1", "minimum_chrome_version": "102", "description": "Tell the digit 0 apart from the letter O: renders every zero on a page in a slashed-zero font. Off by default, per tab.", "author": {"email": "kiril.gerenov@gmail.com"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Absolute Zero (off) - click to enable on this tab", "default_icon": {"16": "Icons/absolute-zero-inactive-16.png", "24": "Icons/absolute-zero-inactive-24.png", "32": "Icons/absolute-zero-inactive-32.png", "48": "Icons/absolute-zero-inactive-48.png", "128": "Icons/absolute-zero-inactive-128.png"}}, "icons": {"16": "Icons/absolute-zero-active-16.png", "32": "Icons/absolute-zero-active-32.png", "48": "Icons/absolute-zero-active-48.png", "128": "Icons/absolute-zero-active-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "css": ["absoluteZero.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["font/*.woff2"], "matches": ["<all_urls>"]}]}