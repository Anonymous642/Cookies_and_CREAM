{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Comment Assistant", "version": "1.0.3", "description": "Generate comment and reply variants for LinkedIn using DeepSeek.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.deepseek.com/*"], "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/config/selectors.js", "src/content/context.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "LinkedIn Comment Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/popup/popup.html", "open_in_tab": true}}