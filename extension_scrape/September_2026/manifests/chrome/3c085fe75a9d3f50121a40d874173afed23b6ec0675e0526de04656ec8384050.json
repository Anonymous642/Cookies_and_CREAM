{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floweo Notes", "version": "0.2.0", "description": "Take notes on YouTube videos with AI chat \u2014 synced to floweo.org.", "homepage_url": "https://floweo.org", "minimum_chrome_version": "114", "permissions": ["sidePanel", "tabs", "cookies", "scripting"], "host_permissions": ["https://floweo.org/*", "https://api.floweo.org/*", "https://www.youtube.com/watch*", "https://m.youtube.com/watch*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open Floweo notes"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://m.youtube.com/watch*"], "js": ["content-yt.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Floweo side panel"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://floweo.org https://api.floweo.org;"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}