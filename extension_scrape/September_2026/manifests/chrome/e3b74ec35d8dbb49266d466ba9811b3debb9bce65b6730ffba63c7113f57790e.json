{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DupDub: YouTube Video Transcript & Summary Tool", "description": "DupDub: Free YouTube Transcript, Translation, AI Summary, and Text to Speech", "version": "1.0.4", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies", "webRequest", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://*.dupdub.com/*"], "action": {"default_title": "DupDub", "browser_style": true, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}