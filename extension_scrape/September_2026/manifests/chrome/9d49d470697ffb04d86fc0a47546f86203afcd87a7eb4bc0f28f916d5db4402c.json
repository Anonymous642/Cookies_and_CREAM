{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Haalock: YouTube Screen Lock & Time Badge", "version": "1.1.5", "description": "Haalock locks your YouTube screen, limits daily viewing, blocks Shorts, and displays the current time on video.", "permissions": ["storage", "commands", "alarms"], "host_permissions": ["https://www.youtube.com/*"], "icons": {"16": "icons/icon-unlocked-16.png", "32": "icons/icon-unlocked-32.png", "48": "icons/icon-unlocked-48.png", "128": "icons/icon-unlocked-128.png"}, "action": {"default_title": "Haalock", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-unlocked-16.png", "32": "icons/icon-unlocked-32.png", "48": "icons/icon-unlocked-48.png", "128": "icons/icon-unlocked-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "options_page": "options.html", "web_accessible_resources": [{"resources": ["icons/*.gif", "icons/*.png"], "matches": ["https://www.youtube.com/*"]}], "commands": {"toggle-lock": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Toggle Haalock"}}}