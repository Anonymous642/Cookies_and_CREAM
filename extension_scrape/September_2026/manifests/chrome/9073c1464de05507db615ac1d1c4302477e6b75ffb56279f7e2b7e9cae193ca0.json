{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LyrClip Clipper", "version": "1.1.0", "description": "Clip moments from YouTube videos into your LyrClip library to share as short clips. Not affiliated with YouTube or Google.", "homepage_url": "https://lyrclip.com", "action": {"default_title": "LyrClip", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://lyrclip.com/*", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["src/content/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://lyrclip.com/connect*"], "js": ["src/content/connect.js"], "run_at": "document_idle"}]}