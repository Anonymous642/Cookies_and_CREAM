{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ForceDeck", "version": "1.2.1", "description": "Permissions, metadata, data and release tools for Salesforce. Runs on the session you're already in. Nothing leaves your browser.", "minimum_chrome_version": "116", "permissions": ["cookies", "storage", "tabs"], "host_permissions": ["https://*.salesforce.com/*", "https://*.salesforce-setup.com/*", "https://*.force.com/*", "https://*.cloudforce.com/*", "https://*.visualforce.com/*"], "background": {"service_worker": "background/sw.js", "type": "module"}, "action": {"default_title": "ForceDeck", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.salesforce-setup.com/*"], "js": ["content/detect.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open the ForceDeck popup"}, "open-console": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open the ForceDeck console"}}, "web_accessible_resources": [{"resources": ["app/index.html", "icons/*"], "matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.salesforce-setup.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}