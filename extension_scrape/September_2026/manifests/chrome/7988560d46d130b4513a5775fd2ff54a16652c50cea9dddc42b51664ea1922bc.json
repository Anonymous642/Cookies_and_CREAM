{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MA Clipboard Toolkit", "version": "1.9.2", "description": "Select and copy Manhattan Active grids and web tables, then format clipboard values for lists and SQL.", "permissions": ["clipboardRead", "clipboardWrite", "offscreen", "storage", "scripting", "tabs", "webNavigation"], "action": {"default_title": "MA Clipboard Toolkit", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"comma-separator": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Convert clipboard to comma-separated values"}, "row-constructor": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Convert clipboard to quoted row-constructor format"}, "sql-in-clause": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Convert clipboard to a SQL IN clause"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "standard-table-selector.js"], "css": ["styles.css", "standard-table-selector.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}