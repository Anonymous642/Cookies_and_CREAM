{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pretii Time Tracker", "version": "1.4.0", "description": "Track your work time and generate invoices via Pretii.", "permissions": ["storage", "alarms", "notifications", "offscreen"], "host_permissions": ["https://pretii.online/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.bundle.js"}, "commands": {"toggle-active-timer": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Start or pause the active timer"}, "cycle-active-timer": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Switch focus to the next timer"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-timer-overlay.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content-timer-overlay.css"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}