{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scope Rec \u2014 Gravador de Reuni\u00f5es", "version": "0.1.3", "description": "Grava a reuni\u00e3o do Google Meet, transcreve no seu navegador e arquiva no seu Google Drive. Nada passa por servidores de terceiros.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "storage", "identity", "alarms", "tabs", "notifications"], "host_permissions": ["https://meet.google.com/*", "https://www.googleapis.com/*", "https://huggingface.co/*", "https://cdn-lfs.huggingface.co/*", "https://cdn-lfs-us-1.huggingface.co/*", "https://painel.scopecompany.com.br/*"], "optional_host_permissions": ["https://*/*"], "externally_connectable": {"matches": ["https://painel.scopecompany.com.br/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Gravador Scope", "default_icon": {"16": "icone-16.png", "32": "icone-32.png"}}, "oauth2": {"client_id": "1046010679977-j4h479faej5f2reqaup8l1rq1l3k290i.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"16": "icone-16.png", "32": "icone-32.png", "48": "icone-48.png", "128": "icone-128.png"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["meet.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Abrir o Scope Rec na chamada"}}}