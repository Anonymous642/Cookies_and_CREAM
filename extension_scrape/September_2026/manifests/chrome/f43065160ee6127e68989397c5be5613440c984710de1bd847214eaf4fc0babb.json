{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LaTeX to TI-Nspire", "description": "Translate your LaTeX math expression to TI-Nspire's format using one keyboard shortcut.", "version": "0.0.1.9", "icons": {"128": "images/icon128.png"}, "background": {"service_worker": "scripts/background.js"}, "commands": {"copy_and_translate": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Copy and translate"}}, "action": {"default_popup": "popup/popup.html"}, "permissions": ["activeTab", "scripting", "storage"], "web_accessible_resources": [{"resources": ["images/copied_and_translated.png", "images/error.png"], "matches": ["<all_urls>"]}]}