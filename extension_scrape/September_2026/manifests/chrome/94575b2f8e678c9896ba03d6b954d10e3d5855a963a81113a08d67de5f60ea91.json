{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MailFury - AI sorter of significant letters", "description": "MailFury uses AI to prioritize crucial business emails for a clutter-free Gmail inbox, enhancing efficiency and saving valuable time", "version": "1.0", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "action": {"default_popup": "popup.html", "default_icon": "assets/mail-fury.png"}, "icons": {"16": "assets/mail-fury-16.png", "32": "assets/mail-fury-32.png", "48": "assets/mail-fury-48.png", "128": "assets/mail-fury-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Execute Mail Marker"}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}}