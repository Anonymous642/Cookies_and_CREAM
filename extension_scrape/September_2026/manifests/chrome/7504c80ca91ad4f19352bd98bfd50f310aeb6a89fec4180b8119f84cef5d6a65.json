{"update_url": "https://clients2.google.com/service/update2/crx", "name": "BlockSite", "description": "Block distracting sites, lock focus with a password, and set daily limits for YouTube Shorts, videos, and Instagram Reels.", "version": "3.2.0", "manifest_version": 3, "permissions": ["storage", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "./index.html", "default_title": "BlockSite - Manage blocked sites"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "./background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*", "*://youtu.be/*", "*://www.instagram.com/*", "*://instagram.com/*"], "js": ["media-counter.js"], "run_at": "document_idle"}], "incognito": "split", "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "quotes.js"], "matches": ["<all_urls>"]}]}