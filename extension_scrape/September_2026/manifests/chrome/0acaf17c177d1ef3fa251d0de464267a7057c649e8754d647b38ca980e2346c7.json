{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notekit - Smart Note Taking & Organization", "version": "1.2.0", "description": "Notekit: Powerful note-taking extension with projects, tasks, reminders, calendar, and voice notes. Organize thoughts and boost prod", "permissions": ["storage", "sidePanel", "tabCapture", "tabs", "activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://www.google.com/*", "https://www.notekit.co/*", "https://*.vercel.app/*", "https://*.lemonsqueezy.com/*"], "side_panel": {"default_path": "sidebar.html"}, "action": {"default_title": "Open Notekit - Smart Note Taking", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["speech-recognition.html", "speech-recognition.js"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}}, "quick-capture": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Quick Capture - Save selected text to Notekit"}}}