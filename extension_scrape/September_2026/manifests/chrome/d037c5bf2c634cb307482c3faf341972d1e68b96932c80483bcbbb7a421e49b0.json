{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtube Utility", "version": "1.0", "description": "Adds Shorts auto play, screenshots, Picture in Picture, and Mini Player to YouTube.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "YouTube Utility - ON", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}