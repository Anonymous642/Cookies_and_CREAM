{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScrollMinder", "version": "1.0.2", "description": "Gently interrupts endless scrolling by asking what you meant to do instead. Not a blocker \u2014 a mirror.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://reddit.com/*", "https://*.reddit.com/*", "https://youtube.com/*", "https://*.youtube.com/*", "https://facebook.com/*", "https://*.facebook.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://tiktok.com/*", "https://*.tiktok.com/*"], "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://reddit.com/*", "https://*.reddit.com/*", "https://youtube.com/*", "https://*.youtube.com/*", "https://facebook.com/*", "https://*.facebook.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://tiktok.com/*", "https://*.tiktok.com/*"], "js": ["constants.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ScrollMinder"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}