{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reibu-Tomo", "description": "Reibu.net companion: analyzes your own tab audio locally (with permission) for a real spectrogram. Audio never leaves your machine.", "version": "1.2.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabCapture", "offscreen", "storage", "alarms"], "commands": {"start-capture": {"description": "Start capturing the active tab for Reibu"}}, "host_permissions": ["https://reibu.net/*"], "action": {"default_title": "Reibu-Tomo", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://reibu.net/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}