{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "English Coach \u2014 Transcriptor de conversaciones", "version": "1.20.0", "description": "Captura el audio de la pesta\u00f1a y tu micr\u00f3fono, los transcribe por separado (t\u00fa / interlocutor) y te deja analizar tu ingl\u00e9s.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "activeTab", "tabs", "scripting", "notifications", "contextMenus"], "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*", "https://api.groq.com/*", "https://api.anthropic.com/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["overlay.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"suggest-reply": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Sugerir una respuesta para lo \u00faltimo que dijo el interlocutor"}, "toggle-capture": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Empezar o detener la transcripci\u00f3n de esta pesta\u00f1a"}}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "English Coach", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "setup.html", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}}