{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trading Card Collector Assistant \u2014 by A5", "version": "2026.01.30.0000", "description": "Save eBay trading card listing snapshots, build your collection library, export to CSV. Free tier: 10 snapshots. Pro: unlimited.", "author": "Allen Five Holdings LLC", "homepage_url": "https://allenfive.com/terms/", "minimum_chrome_version": "90", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://api.gumroad.com/*", "https://www.ebay.com/*", "https://*.ebay.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "ui/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.ebay.com/*", "https://*.ebay.com/*"], "js": ["content/ebay-extractor.js"], "run_at": "document_idle"}], "options_page": "ui/options/options.html"}