{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Udemy Free Auto-Enroller", "version": "0.0.11", "description": "Automatically enrolls in free Udemy courses from a list of URLs.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.udemy.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.udemy.com/course/*", "https://www.udemy.com/payment/checkout/express/*", "https://www.udemy.com/cart/success/*"], "js": ["udemy-course-logger.js"], "run_at": "document_idle"}]}