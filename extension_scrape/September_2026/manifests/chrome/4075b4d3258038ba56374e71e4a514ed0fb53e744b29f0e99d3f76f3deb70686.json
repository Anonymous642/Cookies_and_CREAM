{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartSnap", "version": "2.2.1", "key": "", "description": "AI study assistant for any website. Hover any paragraph to understand it, then turn your notes into flashcards and quizzes.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "SmartSnap - AI Learning Assistant"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "scripting"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://smartsnap.io/*", "https://www.smartsnap.io/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "all_frames": true, "run_at": "document_idle"}], "commands": {"toggle-scan": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Turn SmartSnap on or off for the current page"}}}