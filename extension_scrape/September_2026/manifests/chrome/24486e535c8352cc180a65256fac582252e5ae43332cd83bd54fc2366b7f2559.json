{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabrlo", "version": "2.1", "description": "Save web links where you left off. Free up browser memory and organize your tabs in a beautiful dashboard.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png", "512": "icon.png"}, "action": {"default_title": "Send tabs to Tabrlo", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["icon.png", "icon16.png", "icon48.png", "icon128.png"], "matches": ["<all_urls>"]}], "permissions": ["storage", "tabs", "sidePanel", "history", "contextMenus"], "host_permissions": ["<all_urls>", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://notebook.google.com/*", "*://notebooklm.google.com/*"], "js": ["notebooklm-injector.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}