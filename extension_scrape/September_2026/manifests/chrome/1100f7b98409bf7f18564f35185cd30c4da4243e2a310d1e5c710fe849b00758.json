{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Analytics Firewall \u2013 Block GA4, Meta Pixel & Bing Tracking", "version": "1.0", "description": "Block tracking from GA4, Facebook Meta, and Bing with easy toggle controls", "permissions": ["storage", "declarativeNetRequest", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Privacy Shield"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "tracking_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}]}