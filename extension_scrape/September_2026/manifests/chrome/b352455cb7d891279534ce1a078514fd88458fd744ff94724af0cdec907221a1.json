{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fast Goodreads Edition Switcher", "version": "1.0.0", "description": "Shows a button on Goodreads book pages linking to editions available in your chosen language(s).", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.goodreads.com/*"], "options_page": "options.html", "content_scripts": [{"matches": ["https://www.goodreads.com/book/show/*"], "js": ["languages.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}