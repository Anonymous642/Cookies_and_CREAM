{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TabAtlas", "description": "Master 400+ tabs with ease. Deep archiving, local search and semantic grouping to keep your browser fast and focused.", "version": "1.18.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "alarms", "scripting", "activeTab", "sidePanel", "offscreen"], "omnibox": {"keyword": "ta"}, "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open TabAtlas side panel"}, "focus_search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Focus TabAtlas search"}, "open_groups": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Show TabAtlas groups"}, "reveal_active_tab": {"description": "Reveal the active tab in TabAtlas"}, "propose_grouping": {"description": "Analyze tabs for TabAtlas grouping"}}, "action": {"default_title": "TabAtlas"}}