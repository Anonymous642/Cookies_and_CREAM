{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WinPath \u2014 Outreach CRM Companion", "version": "3.0.0", "description": "Automate your B2B and B2C outreach tracking. Auto-detect LinkedIn sends, Gmail replies, and manage your pipeline from any page.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://app.winpathcrm.com/*", "https://mail.google.com/*", "https://www.linkedin.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-scripts/gmail-injector.js"], "css": ["styles/gmail-inject.css"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content-scripts/linkedin-injector.js"], "css": ["styles/linkedin-inject.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/icons/*"], "matches": ["https://mail.google.com/*", "https://www.linkedin.com/*"]}]}