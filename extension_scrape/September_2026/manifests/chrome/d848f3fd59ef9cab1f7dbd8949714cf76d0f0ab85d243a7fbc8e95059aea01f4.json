{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InfluSpy - Influencer Analytics", "version": "1.0.0", "description": "Sidebar-based influencer analytics and outreach tool for Instagram, TikTok, YouTube, and X.", "permissions": ["sidePanel", "storage", "unlimitedStorage", "activeTab"], "host_permissions": ["*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Open InfluSpy Dashboard"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content-scripts/content-instagram.js"], "run_at": "document_idle"}, {"matches": ["*://*.tiktok.com/*"], "js": ["content-scripts/content-tiktok.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/content-youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content-scripts/content-twitter.js"], "run_at": "document_idle"}]}