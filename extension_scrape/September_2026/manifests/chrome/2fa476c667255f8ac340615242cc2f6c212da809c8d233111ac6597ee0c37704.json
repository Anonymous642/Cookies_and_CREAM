{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timestamp Diff", "version": "1.0.2", "description": "Highlight any timestamp on any webpage and calculate the time difference with one click. Perfect for developers and data analysts.", "author": "Joel H", "permissions": ["storage", "contextMenus", "notifications", "scripting", "activeTab"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Timestamp Diff"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"add-timestamp": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Add selected timestamp (keeps last 2 and calculates difference)"}}}