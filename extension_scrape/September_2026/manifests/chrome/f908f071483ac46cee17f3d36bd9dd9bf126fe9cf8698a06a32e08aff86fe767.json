{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot & OCR \u2014 Capture, Annotate & Extract", "version": "1.0.0", "description": "Capture screenshots, extract OCR text, annotate pages, and automate cleanup with local post-capture workflows.", "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite", "contextMenus", "offscreen", "downloads"], "optional_host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["https://portal.hforgex.com/*"]}, "web_accessible_resources": [{"resources": ["tesseract.min.js", "tesseract.js@v5.0.4_dist_worker.min.js", "tesseract-core-lstm.wasm.js", "tesseract-core-simd-lstm.wasm.js", "*.traineddata.gz"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"captureSelectedArea": {"suggested_key": {"default": "Ctrl+Shift+7", "mac": "Command+Shift+7"}, "description": "Capture selected area of the page"}, "captureVisibleTab": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Capture visible part of the tab"}, "captureSelectedAreaToText": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Capture selected area and extract text"}, "startAnnotation": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Start annotation mode"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}