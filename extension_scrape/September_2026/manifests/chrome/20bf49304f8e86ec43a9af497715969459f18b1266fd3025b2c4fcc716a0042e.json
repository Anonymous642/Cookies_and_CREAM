{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bandcamp AutoPlay FullScreen", "version": "0.0.0.2", "description": "This extension adds continuous play to Bandcamp and a customizable full-screen player for a better listening experience.", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["https://bandcamp.com/discover/*"], "background": {"service_worker": "background.js"}, "commands": {"next-song": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Play next song"}, "play-pause": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Play / Pause"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "web_accessible_resources": [{"resources": ["images/button.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://bandcamp.com/discover/*"], "js": ["content.js"], "css": ["styles.css"]}]}