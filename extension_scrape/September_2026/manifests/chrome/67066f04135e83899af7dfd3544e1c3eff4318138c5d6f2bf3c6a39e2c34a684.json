{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Text Saver", "description": "Advanced clipboard manager with smart features - Save, organize, and manage your text efficiently", "version": "2.0.0", "manifest_version": 3, "author": "kbaooo", "action": {"default_popup": "popup/popup.html", "default_title": "Text Saver", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon64.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon64.png", "128": "images/icon128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "notifications", "clipboardWrite", "clipboardRead"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"open-popup": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Text Saver popup"}, "save-selected-text": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save selected text to clipboard"}, "quick-paste": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Quick paste last saved text"}, "toggle-auto-save": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Toggle auto-save mode"}}, "web_accessible_resources": [{"resources": ["images/*"], "matches": ["<all_urls>"]}]}