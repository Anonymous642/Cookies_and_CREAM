{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kandue for Graders on Canvas LMS", "short_name": "Kandue for Graders", "version": "0.15.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "description": "For TAs and instructors: a read-only grading queue for Canvas, longest-waiting students first. Reads submissions; enters no grade.", "homepage_url": "https://kandue.app/", "permissions": ["storage", "sidePanel", "alarms", "notifications", "scripting", "activeTab"], "host_permissions": ["https://*.edu/*", "https://*.instructure.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.edu/*", "https://*.instructure.com/*"], "js": ["content.js", "floating-panel.js"], "run_at": "document_idle"}], "commands": {"find-student": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Find a student"}}, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "default_title": "Kandue \u2014 open your grading queue"}, "side_panel": {"default_path": "panel.html"}, "web_accessible_resources": [{"resources": ["icon-48.png", "report.html"], "matches": ["https://*.edu/*", "https://*.instructure.com/*"]}, {"resources": ["panel.html"], "matches": ["https://*/*", "http://*/*"]}]}