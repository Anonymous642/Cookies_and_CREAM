{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PTCG Snap Redeem", "version": "0.2.3", "description": "Capture visible Pok\u00e9mon TCG Live QR codes from YouTube and open the official redemption page.", "icons": {"16": "icons/ptcg-snap-redeem-16.png", "32": "icons/ptcg-snap-redeem-32.png", "48": "icons/ptcg-snap-redeem-48.png", "128": "icons/ptcg-snap-redeem-128.png"}, "permissions": ["activeTab", "offscreen", "storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background-bundle.js", "type": "module"}, "action": {"default_title": "Capture Pok\u00e9mon QR code"}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "commands": {"capture-code": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture and scan the active YouTube tab"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}, {"matches": ["https://redeem.tcg.pokemon.com/*"], "js": ["redeem.js"], "run_at": "document_start"}]}