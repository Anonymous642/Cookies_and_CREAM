{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat History Exporter", "version": "1.0.0", "description": "Export your AI chat conversation history to a local SQLite database file.", "permissions": ["activeTab", "scripting", "storage", "offscreen", "downloads", "downloads.open", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/content-script.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["sql-wasm.wasm"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}