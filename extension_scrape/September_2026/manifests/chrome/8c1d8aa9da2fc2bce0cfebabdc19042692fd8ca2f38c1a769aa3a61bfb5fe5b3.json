{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClearClause \u2014 AI Contract Reviewer", "short_name": "ClearClause", "version": "1.0.0", "description": "Click to analyze any contract, Terms of Service, or legal PDF in your browser. ClearClause flags risky clauses in plain English.", "action": {"default_title": "ClearClause \u2014 Review this document", "default_popup": "popup.html"}, "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "storage", "scripting", "sidePanel"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["lib/pdf.worker.min.js"], "matches": ["<all_urls>"]}]}