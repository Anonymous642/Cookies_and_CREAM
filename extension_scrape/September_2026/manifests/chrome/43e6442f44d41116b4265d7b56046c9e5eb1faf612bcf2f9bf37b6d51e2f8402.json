{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Surprise Jerry!", "description": "Shows a small Jerry animation when clicking his face in the toolbar. You can have him show up randomly in the settings.", "version": "1.0.0", "action": {"default_title": "Show Jerry"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "scripting", "activeTab"], "optional_host_permissions": ["<all_urls>"], "options_page": "options.html", "web_accessible_resources": [{"resources": ["jerry.png"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}}