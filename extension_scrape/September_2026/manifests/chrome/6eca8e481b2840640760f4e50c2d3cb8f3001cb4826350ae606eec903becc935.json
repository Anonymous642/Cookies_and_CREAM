{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Advanced Auto Refresh & Page Monitor | Tools Make Life Easy", "version": "1.4.2", "description": "Premium tab auto-refresher \u2014 Interval, Timer, Tabs & Monitor in the popup; Templates, Alerts, Stats & Settings in the side panel.", "permissions": ["tabs", "storage", "alarms", "notifications", "scripting", "activeTab", "offscreen", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-refresh": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Start/stop auto-refresh on current tab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}