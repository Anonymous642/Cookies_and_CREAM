{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Search Hover Preview", "version": "0.4.3", "description": "Inspect Google search results in a privacy-friendly right-side preview panel.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["bookmarks", "readingList", "storage"], "host_permissions": ["https://www.google.com/search*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["content.js"], "css": ["preview.css"], "run_at": "document_idle"}]}