{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Redact & Snap", "version": "1.1.0", "description": "Hide sensitive information on any page, then copy a clean screenshot. Everything stays on your device.", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "aiLanguageModelOriginTrial"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "src/background.js"}, "commands": {"redact-page": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Redact the current page"}, "pick-areas": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Pick areas to redact"}, "copy-screenshot": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Save a redacted screenshot"}}}