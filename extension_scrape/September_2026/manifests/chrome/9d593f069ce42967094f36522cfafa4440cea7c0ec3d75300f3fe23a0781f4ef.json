{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Search By Image - Quick Product Finder", "version": "4.0.1", "description": "Right-click any image to search on Amazon! Find products fast and dropship easily with this powerful image search tool.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.ca/*", "*://*.amazon.com.br/*", "*://*.amazon.in/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.au/*", "*://*.amazon.nl/*", "*://*.amazon.se/*", "*://*.amazon.tr/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.sg/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}