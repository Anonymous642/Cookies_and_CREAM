{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinyin Viewer", "version": "1.3.2", "description": "Toggle Pinyin display on Chinese text. Hover for pronunciation.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["data.js", "pinyin-dict.js", "jyutping-dict.js", "content.js"], "css": ["styles.css"]}], "action": {"default_title": "Pinyin Viewer (Ctrl+Shift+P to toggle)", "default_icon": {"16": "icon_off_16.png", "32": "icon_off_32.png", "48": "icon_off_48.png", "128": "icon_off.png"}}, "commands": {"toggle-pinyin": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle Pinyin display"}, "cycle-mode": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Option+Shift+P"}, "description": "Cycle pronunciation mode"}}, "icons": {"16": "icon_on_16.png", "32": "icon_on_32.png", "48": "icon_on_48.png", "128": "icon_on.png"}}