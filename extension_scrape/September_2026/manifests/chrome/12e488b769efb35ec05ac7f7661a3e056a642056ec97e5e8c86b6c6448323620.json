{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Max Repo Size", "version": "1.0.0", "description": "Activate this extension to get quick insights into GitHub repo and file sizes directly on the site ", "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle GitHub Repo Size", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://github.com/*"]}]}