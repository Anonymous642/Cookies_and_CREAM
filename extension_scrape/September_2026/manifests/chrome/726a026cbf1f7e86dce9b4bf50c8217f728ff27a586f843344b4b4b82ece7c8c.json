{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cortisol Maxxer", "version": "2.1.0", "description": "Detects the most visible tweet on your feed and shows a fun cortisol stress gauge overlay", "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "exclude_matches": ["https://twitter.com/settings/*", "https://twitter.com/messages/*", "https://twitter.com/i/*", "https://x.com/settings/*", "https://x.com/messages/*", "https://x.com/i/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_title": "Cortisol Maxxer"}, "icons": {"48": "icon48.png", "128": "icon128.png"}}