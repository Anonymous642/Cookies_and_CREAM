{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LocalAI Chat \u2014 Offline GGUF Assistant", "version": "1.2.0", "description": "Chat with any GGUF model 100% offline in your browser. Streaming, vision, PDF/Word/CSV analysis, workspace file editing.", "permissions": ["tabs", "storage", "unlimitedStorage", "activeTab"], "host_permissions": ["file:///*"], "action": {"default_title": "Open LocalAI Chat", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"}, "web_accessible_resources": [{"resources": ["lib/*", "wasm/*", "src/*", "newtab.html", "icons/*"], "matches": ["chrome-extension://*/*"], "use_dynamic_url": false}]}