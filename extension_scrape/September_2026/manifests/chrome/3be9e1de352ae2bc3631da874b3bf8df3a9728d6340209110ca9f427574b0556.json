{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Futurama Randomizer (URL List)", "version": "1.0", "description": "Play a random Futurama episode from a predefined list of Hulu watch URLs.", "permissions": ["tabs", "scripting", "storage", "webNavigation"], "host_permissions": ["https://*.hulu.com/watch/*"], "action": {"default_popup": "popup.html", "default_title": "Random Futurama", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.hulu.com/watch/*"], "js": ["content.js"], "run_at": "document_idle"}]}