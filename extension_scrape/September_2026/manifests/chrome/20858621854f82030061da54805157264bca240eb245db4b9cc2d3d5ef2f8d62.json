{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SummarizAI \u2014 Summarize & Chat with Any YouTube, PDF & Webpage", "short_name": "SummarizAI", "version": "2.1.1", "description": "AI-powered page summarizer & chat \u2014 YouTube videos, PDFs, articles, emails, reviews. 16 languages. Completely free. No login.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "sidePanel", "tabs"], "host_permissions": ["https://api.deepseek.com/*", "https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "__MSG_actionTitle__", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "panel/panel.html"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/youtube-main.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"summarize-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "__MSG_cmdSummarizePage__"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "__MSG_cmdOpenPanel__"}}, "default_locale": "en", "output_languages": {"en": "English", "zh": "Chinese (Simplified)", "hi": "Hindi", "es": "Spanish", "fr": "French", "ar": "Arabic", "bn": "Bengali", "pt": "Portuguese", "ru": "Russian", "id": "Indonesian", "de": "German", "ja": "Japanese", "ko": "Korean", "tr": "Turkish", "vi": "Vietnamese", "hinglish": "Hinglish"}}