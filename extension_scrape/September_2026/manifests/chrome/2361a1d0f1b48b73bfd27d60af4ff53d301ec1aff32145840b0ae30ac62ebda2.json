{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinQ Control", "version": "3.1", "description": "Extract all links from any page. Save, clean, filter, and open links in bulk. Your ultimate link workflow and collection tool.", "permissions": ["scripting", "storage", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"extract-links": {"suggested_key": {"default": "Ctrl+Q"}, "description": "Extract links"}, "open-popup": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Open links popup"}, "save-link": {"suggested_key": {"default": "Alt+Q"}, "description": "Save link to links list"}, "delete-link": {"suggested_key": {"default": "Alt+W"}, "description": "Delete link from links list"}}, "action": {"default_icon": {"128": "icon.png"}, "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}}