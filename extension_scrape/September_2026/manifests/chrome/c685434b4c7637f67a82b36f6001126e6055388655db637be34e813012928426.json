{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gemini Writing Assistant", "version": "1.1.1", "description": "A Gemini-powered writing assistant triggered by a shortcut or context menu.", "homepage_url": "https://sites.google.com/view/gemini-writing-assistant", "permissions": ["activeTab", "storage", "contextMenus", "scripting"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src https://generativelanguage.googleapis.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'self';"}, "background": {"service_worker": "background.js", "type": "module"}, "sandbox": {"pages": []}, "commands": {"generate-text": {"suggested_key": {"default": "Alt+R"}, "description": "Generate text with Gemini"}, "dictate-and-process": {"suggested_key": {"default": "Alt+L"}, "description": "Start or stop dictation"}, "cycle-output-style": {"suggested_key": {"default": "Alt+O"}, "description": "Cycle through output styles"}, "open-spotlight": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Open Gemini Spotlight"}}, "action": {"default_popup": "popup.html", "default_icon": "assets/icons/icon-48.png"}, "icons": {"48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/audio/start.mp3", "assets/audio/end.mp3"], "matches": ["<all_urls>"]}]}