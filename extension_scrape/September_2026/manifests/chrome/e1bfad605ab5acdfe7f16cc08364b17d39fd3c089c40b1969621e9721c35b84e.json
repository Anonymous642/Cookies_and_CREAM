{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Miles \u2014 Your AI Personal Operator", "short_name": "Miles", "version": "1.0.0", "description": "Miles lives in your browser \u2014 summarize pages, prep for meetings, save to memory, and take action from anywhere.", "permissions": ["activeTab", "storage", "sidePanel", "contextMenus", "tabs", "commands", "scripting"], "host_permissions": ["https://meet.google.com/*", "https://zoom.us/*", "https://*.zoom.us/*", "https://docs.google.com/*", "https://app.heymiles.app/*", "https://heymiles.app/*"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Open Miles"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/detector.js"], "css": ["src/content/miles-fab.css"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*"], "js": ["src/content/google-meet.js"], "css": ["src/content/google-meet.css"], "run_at": "document_idle"}, {"matches": ["https://app.heymiles.app/*", "https://heymiles.app/*", "http://localhost:5173/*"], "js": ["src/content/auth-bridge.js"], "run_at": "document_idle"}], "commands": {"toggle-miles": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle Miles side panel"}, "ask-miles": {"suggested_key": {"default": "Ctrl+M", "mac": "Command+M"}, "description": "Ask Miles about selected text"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://meet.google.com/*", "https://docs.google.com/*", "https://app.heymiles.app/*", "https://heymiles.app/*"]}]}