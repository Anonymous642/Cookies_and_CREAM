{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Pause for YouTube - Pause on Tab Switch", "version": "1.0.0", "description": "Pause your video when you switch tabs and resume on return \u2014 unless you paused it yourself. Works great with YouTube.", "minimum_chrome_version": "116", "permissions": ["storage", "scripting"], "host_permissions": ["https://*.youtube.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["common.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "24": "icons/24.png", "32": "icons/32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"toggle-site": {"description": "Toggle Auto Pause on the current site"}, "toggle-global": {"description": "Toggle Auto Pause globally"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}