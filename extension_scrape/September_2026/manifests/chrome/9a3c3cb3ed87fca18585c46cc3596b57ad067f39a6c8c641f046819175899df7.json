{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NexShot - Screenshot Annotator", "version": "1.0.0", "description": "Captura, anota y difumina capturas de pantalla desde tu navegador. Herramienta r\u00e1pida con 2 modos de captura y editor integrado.", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "contextMenus"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capturar pantalla visible"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Capturar regi\u00f3n seleccionada"}}}