{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "version": "2.3.0", "name": "SessionHub: Multi-Account Browsing in Isolated Tabs", "short_name": "SessionHub", "description": "Use multiple accounts in isolated tabs for the same website without logging out.", "permissions": ["activeTab", "tabs", "scripting", "storage", "cookies", "declarativeNetRequest", "webRequest"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["<all_urls>"]}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_start", "world": "MAIN", "js": ["content-script.js"]}], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "index.html"}, "web_accessible_resources": [{"resources": ["wait.html", "assets/images/logo-icon-48.png"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Display all saved sessions related to the current website"}, "find-session": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Search and filter through saved sessions to find specific session"}, "open-all-sessions": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open all saved sessions related to the current website in new tabs"}, "new-session": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Create a new, isolated session for the current website"}}, "icons": {"16": "assets/images/logo-icon-16.png", "32": "assets/images/logo-icon-32.png", "48": "assets/images/logo-icon-48.png", "128": "assets/images/logo-icon-128.png"}}