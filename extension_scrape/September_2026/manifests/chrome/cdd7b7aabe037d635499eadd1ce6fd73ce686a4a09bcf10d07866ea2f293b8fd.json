{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitter/X Media Reply Hider", "version": "1.0", "author": "Aden Stewart", "description": "This extension allows you to hide media replies on Twitter/X so you can see text replies easier.", "permissions": ["storage"], "content_scripts": [{"matches": ["*://twitter.com/*"], "js": ["contentScript.js"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["svg/video_icon.svg", "svg/photo_icon.svg", "popup/bg.png"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}