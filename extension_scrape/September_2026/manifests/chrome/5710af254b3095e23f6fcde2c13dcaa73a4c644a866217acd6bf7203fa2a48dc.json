{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timpi Extension", "version": "2.1.25", "description": "Timpi browser extension with Wilson, Search, Echo, native side panel and overlay mode.", "permissions": ["tabs", "contextMenus", "storage", "scripting", "sidePanel", "activeTab"], "host_permissions": ["https://timpi.com/*", "https://api.timpi.com/*", "https://auth.timpi.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Timpi"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles.css", "icons/*", "content/*.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"timpi-focus-search": {"suggested_key": {"default": "Alt+K", "mac": "Command+Shift+K"}, "description": "Open Timpi Search"}, "timpi-open-wilson": {"suggested_key": {"default": "Alt+W", "mac": "Command+Shift+W"}, "description": "Open Wilson AI"}}, "side_panel": {"default_path": "sidepanel.html"}}