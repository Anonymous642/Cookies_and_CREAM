{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SupaPM", "version": "0.0.22", "description": "AI-powered product management assistant with context-aware chat", "permissions": ["storage", "unlimitedStorage", "tabs", "sidePanel", "activeTab", "scripting"], "host_permissions": ["https://supapm.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.typesafe.ai/*", "http://localhost/*", "http://127.0.0.1/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/index.html"}, "action": {"default_title": "SupaPM"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Open SupaPM side panel"}, "add_selection_to_context": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Add highlighted text to SupaPM context"}}, "options_page": "options/index.html", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/icon-16.png", "assets/icon-48.png", "assets/icon-128.png"], "matches": ["https://supapm.com/*"]}]}