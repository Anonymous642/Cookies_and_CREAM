{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Auto Chat", "version": "1.0", "description": "Automatically send prompts to ChatGPT one by one. Queue multiple prompts and auto-submit them when ChatGPT is ready.", "permissions": ["activeTab", "scripting", "clipboardWrite", "sidePanel", "tabs", "storage"], "action": {"default_icon": "icons/logo.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}