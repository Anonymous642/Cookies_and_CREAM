{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkLynk", "version": "1.0.1", "description": "Save, categorize, and manage your links in one place", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.jpg", "48": "icons/icon48.jpg", "128": "icons/icon128.jpg"}, "default_title": "LinkLynk"}, "options_page": "options/options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["notification-content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["notification.mp3"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.jpg", "48": "icons/icon48.jpg", "128": "icons/icon128.jpg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open LinkLynk popup"}, "quick_save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save to default category"}}}