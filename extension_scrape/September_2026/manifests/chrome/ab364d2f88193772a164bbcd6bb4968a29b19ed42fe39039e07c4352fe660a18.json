{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pro Car Finder Inventory Connector", "version": "0.9.141", "description": "Sync authorized dealership inventory and prepare user-confirmed Facebook Marketplace vehicle listings.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "downloads", "scripting"], "host_permissions": ["https://app.procarfinder.com/*", "https://www.facebook.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Pro Car Finder", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://app.procarfinder.com/dashboard*", "https://app.procarfinder.com/connect-extension*"], "js": ["app-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/marketplace/create/vehicle*", "https://www.facebook.com/marketplace/item/*"], "js": ["facebook-assistant.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/messages/*"], "js": ["messenger-replies.js"], "run_at": "document_idle"}]}