{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ambient Spanish \u2014 Learn by Repetition", "version": "1.0.0", "description": "Passively learn English or Spanish while you browse: a flashcard cycles through words, and page words get swapped for translations.", "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["data/words.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}