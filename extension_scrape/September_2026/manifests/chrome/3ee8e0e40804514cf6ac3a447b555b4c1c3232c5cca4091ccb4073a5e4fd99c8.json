{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Library - Prompt Manager for ChatGPT & Claude", "short_name": "AI Prompt Library", "version": "1.1.0", "description": "Save, organise, and inject prompts into ChatGPT, Claude, Gemini & Perplexity. Folders, tags, and {{variable}} placeholders.", "author": "Cosmos Web Tech", "homepage_url": "https://extensions.cchk.info/ai-prompt-library", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*"], "action": {"default_popup": "popup.html", "default_title": "AI Prompt Library", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*"], "js": ["lib/platformSelectors.js", "content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"open-library": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open prompt library"}}}