{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EZTC Password Generator", "version": "2.14.3", "description": "Ultimate password generator with customizable options, dictionary words, dark theme, and multiple viewing modes.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "clipboardWrite", "sidePanel", "tabs", "windows", "contextMenus", "activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_title": "EZTC Password Generator"}, "side_panel": {"default_path": "side-panel.html"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["words.json", "content.js"], "matches": ["<all_urls>"]}], "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open password generator in side panel"}}}