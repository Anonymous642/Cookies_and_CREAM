{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Plan Builder Plus", "description": "Capture web screens for test plans and representative samples, and export a populated Word sample file.", "version": "0.1.2", "minimum_chrome_version": "109", "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"], "background": {"service_worker": "src/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_popup": "src/popup.html", "default_title": "Plan Builder Plus", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png"}}, "commands": {"capture-current-screen": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Capture the current screen"}}}