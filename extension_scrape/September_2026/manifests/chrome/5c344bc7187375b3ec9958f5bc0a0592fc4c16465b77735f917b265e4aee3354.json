{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chartbuddy", "version": "1.8.26", "description": "Create, update and insert charts within Google Slides, using data from Google Sheets.", "permissions": ["activeTab", "scripting", "storage", "tabs", "offscreen"], "background": {"service_worker": "CE/boot/serviceWorker.js"}, "action": {"default_icon": {"16": "ts/shared/assets/app-icons/icon16.png", "48": "ts/shared/assets/app-icons/icon48.png", "128": "ts/shared/assets/app-icons/icon128.png"}}, "host_permissions": ["https://docs.google.com/*", "https://sheets.google.com/*", "https://*.canva.com/*", "https://chartbuddy.io/*", "http://127.0.0.1/*"], "web_accessible_resources": [{"resources": ["ts/**/*.js", "ts/**/*.js.map", "ts/shared/assets/*.png", "ts/shared/assets/brand/*.png", "ts/shared/assets/3rdparties/*.png", "ts/shared/assets/3rdparties/*.webp", "CE/pages/onboarding/*.png", "CE/pages/html/**/*.html", "CE/pages/onboarding/**/*.html", "CE/pages/onboarding/*.css", "ts/shared/css/*.css", "ts/shared/libraries/*.js", "js/core/chart/labelPlacementEngine.js", "js/core/chart/labelPlacementWorker.js", "*.wasm", "shared/css/**/*.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}