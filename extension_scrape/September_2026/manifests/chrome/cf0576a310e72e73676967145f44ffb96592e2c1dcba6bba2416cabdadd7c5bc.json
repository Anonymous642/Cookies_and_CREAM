{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vlog Migration Tool", "version": "1.1", "description": "Extract YouTube and Vimeo channel video data \u2014 titles, embed links, and thumbnails \u2014 for migration.", "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://vimeo.com/*", "https://i.ytimg.com/*", "https://i.vimeocdn.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://vimeo.com/*"], "js": ["content.js"], "css": ["sidebar.css"], "run_at": "document_idle"}], "action": {"default_title": "Vlog Migration Tool", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}