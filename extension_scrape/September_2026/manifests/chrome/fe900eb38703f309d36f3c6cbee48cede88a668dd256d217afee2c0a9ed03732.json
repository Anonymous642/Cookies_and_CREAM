{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ultra Ctrl F", "version": "3.0", "description": "Search any webpage for ideas rather than just words. An AI-powered, better Ctrl F", "permissions": ["storage", "scripting", "tabs", "webNavigation", "clipboardRead"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service_worker.js"}, "action": {"default_icon": {"16": "src/assets/icons/icon16.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}}, "icons": {"16": "src/assets/icons/icon16.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/shared/accountAuth.js", "src/content/content_script.js"], "all_frames": true}], "externally_connectable": {"matches": ["http://localhost:5173/*", "http://localhost/*", "http://127.0.0.1/*", "https://ultra-ctrlf.dragotoba.com/*"]}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open or close Ultra Ctrl F search"}, "toggle-overlay-alt": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Option+Shift+U"}, "description": "Open or close Ultra Ctrl F search (alternate)"}, "submit-search": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Option+Shift+S"}, "description": "Submit search"}, "cycle-search-mode-next": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Option+Shift+Right"}, "description": "Cycle search mode"}}, "options_page": "src/options/options.html"}