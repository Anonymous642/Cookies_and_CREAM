{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TWCC Universal Translator - Twitch Chat", "version": "1.0.6", "minimum_chrome_version": "102", "description": "Translate the focused input field via hotkey using OpenAI, with configurable languages.", "homepage_url": "https://www.webcreativecommunity.org/twitch-translator", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "webNavigation"], "host_permissions": ["https://api.openai.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "TWCC Translator", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options.html", "commands": {"translate-active-field": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Translate the focused field"}, "translate-page-text": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle Twitch chat translation"}}}