{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Acuova LinkedIn Logger", "short_name": "Acuova", "version": "0.18.4", "description": "Acuova's LinkedIn companion: capture the profile you're viewing into your CRM, log outreach, and see pipeline context inline.", "permissions": ["storage", "sidePanel", "activeTab", "tabs", "webNavigation"], "host_permissions": ["*://*.linkedin.com/*", "https://acuova.com/*", "https://www.acuova.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open Acuova panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.linkedin.com/in/*", "*://linkedin.com/in/*", "*://www.linkedin.com/company/*", "*://linkedin.com/company/*"], "js": ["scrape-core.js", "content.js"], "run_at": "document_idle"}, {"matches": ["*://www.linkedin.com/*", "*://linkedin.com/*"], "js": ["tab-launcher.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["sidepanel.html", "icons/*"], "matches": ["*://www.linkedin.com/*", "*://linkedin.com/*"]}]}