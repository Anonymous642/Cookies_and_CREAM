{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "E-invoice Parser Pro", "version": "1.0.1", "description": "Wandelt XML E-Rechnungen per Klick in eine lesbare Ansicht um.", "permissions": ["activeTab", "sidePanel", "storage", "tabs"], "host_permissions": ["file:///*", "https://ec.europa.eu/*"], "action": {"default_title": "Rechnung umwandeln", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "side_panel": {"default_path": "sidebar.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*.xml", "file:///*.XML", "*://*/*.xml", "*://*/*.XML"], "js": ["parsers/utils.js", "parsers/i18n.js", "parsers/styles.js", "parsers/view.js", "parsers/de.js", "parsers/dk.js", "parsers/be.js", "parsers/it.js", "parsers/hr.js", "parsers/gr.js", "parsers/pl.js", "parsers/ro.js", "parsers/rs.js", "parsers/tr.js", "parsers/hu.js", "parsers/ubl.js", "parsers/core.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["style.css", "icons/*.svg"], "matches": ["<all_urls>"]}], "commands": {"generate_invoice": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Startet den E-Rechnung Parser"}}}