{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pin Keyword Collector", "version": "1.0.4", "description": "Collect and analyze Pinterest autocomplete keyword ideas for content, SEO, and niche research.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "downloads", "activeTab", "scripting", "alarms", "sidePanel"], "host_permissions": ["https://pinterest.com/*", "https://www.pinterest.com/*", "https://*.pinterest.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "popup.html"}, "action": {"default_title": "Open Pin Keyword Collector", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://pinterest.com/*", "https://www.pinterest.com/*", "https://*.pinterest.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}