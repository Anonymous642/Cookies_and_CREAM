{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tap Counter \u2014 Tally & Click Counter", "short_name": "Tap Counter", "version": "1.0.0", "description": "Count anything from your toolbar. Save multiple counters, set goals, use a stopwatch, and keep your progress offline.", "homepage_url": "https://tapcounter.app/", "minimum_chrome_version": "114", "permissions": ["storage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Tap Counter", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"_execute_action": {"suggested_key": "Alt+Shift+T"}, "increment": {"suggested_key": "Alt+Shift+C", "description": "Add a step to the active counter"}, "decrement": {"description": "Subtract a step from the active counter"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}