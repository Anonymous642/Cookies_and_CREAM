{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recapio: AI Youtube Summarizer", "version": "0.5.3", "description": "AI-powered YouTube summarizer. Get instant video summaries, key insights & chat with content. Turn hours into minutes.", "action": {"default_popup": "index.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "permissions": ["storage", "activeTab", "tabs", "notifications", "webRequest", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://api.recapio.com/*", "http://localhost:5001/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"]}, {"matches": ["*://www.youtube.com/*"], "js": ["youtube-content.js"], "run_at": "document_end"}, {"matches": ["https://recapio.com/*"], "js": ["recapio-auth.js"]}, {"matches": ["http://localhost:3000/*"], "js": ["recapio-auth.js"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}