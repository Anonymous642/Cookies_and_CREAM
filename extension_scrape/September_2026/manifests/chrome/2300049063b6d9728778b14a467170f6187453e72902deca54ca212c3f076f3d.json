{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CampusClear", "version": "2.0.0", "description": "Instantly see if a job is a ghost listing and how well your resume matches \u2014 on LinkedIn, Indeed, and Handshake.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CampusClear"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.indeed.com/*"], "js": ["indeed-fetch-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.linkedin.com/jobs/*", "*://*.indeed.com/*", "*://*.joinhandshake.com/*"], "js": ["site-adapters.js", "ghost-scorer.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}