{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slop Blocker", "version": "1.5.0", "description": "Highlight AI-style slop in your X/Twitter feed. On-device scoring only. Mute, not interested, and block stay off by default.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Slop Blocker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*"], "js": ["lib/patterns.js", "lib/detector.js", "lib/storage.js", "content/highlight.js", "content/actions.js", "content/neural.js", "content/timeline.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "permissions": ["storage", "offscreen"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["icons/*", "lib/onnx/*"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]}