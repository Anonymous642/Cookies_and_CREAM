{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zendesk View Refresher", "version": "2.2.6", "description": "Auto-refreshes Zendesk views with live countdown, tab consolidation, and status notifications.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["scripting", "storage", "tabs", "webNavigation"], "host_permissions": ["*://*.zendesk.com/*"], "content_scripts": [{"matches": ["*://*.zendesk.com/agent/*"], "css": ["styles/theme.css"], "js": ["content-script.js"], "run_at": "document_end", "all_frames": false}], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["CHANGELOG.MD", "changelog.html", "utils/*.js", "config/*.js", "styles/*.css"], "matches": ["*://*.zendesk.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}