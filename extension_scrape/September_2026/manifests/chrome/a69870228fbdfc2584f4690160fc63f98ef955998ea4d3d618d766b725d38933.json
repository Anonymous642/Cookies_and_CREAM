{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quizzal", "version": "1.0.4", "description": "Remember everything you read. Quizzal generates quiz questions from articles you browse, helping you retain what you learn.", "homepage_url": "https://quizzal.io", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "host_permissions": ["http://*/*", "https://*/*"], "permissions": ["activeTab", "scripting", "tabs", "storage", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}]}