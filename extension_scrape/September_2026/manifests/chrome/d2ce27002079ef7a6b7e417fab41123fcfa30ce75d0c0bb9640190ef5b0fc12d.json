{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Motherboard Notepad", "version": "0.5", "icons": {"16": "logo/16.png", "48": "logo/48.png", "128": "logo/128.png"}, "description": "Turn every new tab into a fast, local-first notepad. Write in Markdown or plain text, organized in folders. Works fully offline.", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["storage", "unlimitedStorage"], "sandbox": {"pages": ["sandbox.html"]}, "content_security_policy": {"sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"}, "background": {"service_worker": "service-worker-min.js", "type": "module"}}