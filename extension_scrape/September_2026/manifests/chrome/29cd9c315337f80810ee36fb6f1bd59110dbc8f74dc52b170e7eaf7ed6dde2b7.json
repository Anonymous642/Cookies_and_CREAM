{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Web Recorder", "short_name": "Web Recorder", "version": "0.2.0", "minimum_chrome_version": "116", "description": "Record a browser tab silently, add narration and camera layers, and save locally.", "homepage_url": "https://williamjiamin.github.io/simple-web-recorder-site/", "permissions": ["activeTab", "scripting", "tabCapture", "desktopCapture", "offscreen", "storage", "downloads"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "Simple Web Recorder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"start-recording": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+R"}, "description": "Start recording the active tab with the last used settings"}, "stop-recording": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Stop the active recording"}, "toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Pause or resume the active recording"}, "add-instant-retake": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Option+Shift+4"}, "description": "Mark the previous 10 seconds as an Instant Retake"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}