{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trustroop \u2013 Check Trust Scores Before You Proceed", "version": "1.0.5", "description": "Check if a website, product, or link is safe with Trustroop. Read and share real reviews to stay protected online.", "permissions": ["tabs", "storage"], "host_permissions": ["https://api.trustroop.com/*"], "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon-w-16.png", "32": "icons/icon-w-32.png", "128": "icons/icon-w-128.png"}, "default_title": "Trustroop - Report Fake News"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-w-16.png", "32": "icons/icon-w-32.png", "128": "icons/icon-w-128.png", "192": "icons/icon-w-192.png", "512": "icons/icon-w-512.png"}, "web_accessible_resources": [{"resources": ["icons/safe.svg", "icons/fake.svg", "icons/danger.svg"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}