{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tekorn Music Sidebar for YouTube\u2122", "version": "1.1.0", "description": "Tr\u00ecnh ph\u00e1t nh\u1ea1c ch\u1ea1y ng\u1ea7m b\u00ean sidebar c\u1ef1c chill d\u00e0nh cho YouTube\u2122 v\u1edbi hi\u1ec7u \u1ee9ng hoa anh \u0111\u00e0o r\u01a1i nh\u1eb9 nh\u00e0ng. Ph\u00e1t tri\u1ec3n b\u1edfi Tekorn.com.", "homepage_url": "https://tekorn.com", "permissions": ["sidePanel", "storage", "declarativeNetRequest", "offscreen"], "host_permissions": ["https://*.youtube.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://i.ytimg.com data:;"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Music Sidebar for YouTube\u2122", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidebar.html"}, "content_scripts": [{"matches": ["https://*.youtube.com/watch*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["public/*"], "matches": ["<all_urls>"]}]}