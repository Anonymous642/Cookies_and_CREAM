{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OnDevicePDF - Offline PDF Tools: Merge, Split & Compress", "version": "3.1.0", "description": "Merge, split, rotate, reorder & compress PDFs, ask questions, view PDFs - 100% on-device in your browser. No uploads, no account.", "minimum_chrome_version": "128", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Open OnDevicePDF side panel", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "permissions": ["sidePanel", "contextMenus", "storage"], "optional_permissions": ["declarativeNetRequestWithHostAccess", "downloads", "notifications"], "optional_host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["<all_urls>"]}], "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open the OnDevicePDF side panel"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}