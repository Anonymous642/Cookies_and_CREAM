{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Don't Watch Alone", "description": "Watch videos together with friends. This extension syncs your Youtube playback with friends for a shared viewing experience.", "version": "0.0.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["sidePanel", "tabs", "webRequest", "storage", "activeTab", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self'"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}