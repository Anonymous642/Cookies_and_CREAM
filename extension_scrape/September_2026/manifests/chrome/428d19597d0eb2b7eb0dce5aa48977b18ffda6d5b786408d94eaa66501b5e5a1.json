{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grabber - Save & find links fast ( A Bookmark Alternative )", "short_name": "Grabber", "description": "Grabber is a smarter bookmark alternative to save, tag, and organize links. Build swipe files, team libraries, or read-it-later hubs", "version": "2.1.8", "action": {"default_icon": "images/favIcon.png"}, "background": {"service_worker": "static/js/grabberBackground.js"}, "commands": {"toggle-grabber": {"suggested_key": {"default": "Alt+G"}, "description": "Toggle Grabber Popup"}}, "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["css/grabber.css", "static/js/grabberContent.js", "*.css", "*.woff2", "*.jpg", "*.png", "*.svg", "images/*", "static/js/*", "*.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}