{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Social Media Filter", "version": "1.0", "description": "Intercept and filter Threads.com content", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "storage", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "host_permissions": ["https://*.threads.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.threads.com/*"], "js": ["content-filter.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["filtered-posts.js", "network-intercept.js"], "matches": ["https://*.threads.com/*"]}]}