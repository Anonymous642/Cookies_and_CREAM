{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Top Rocket: back to top and reading progress on every web page!", "description": "A useful reading progress indicator and a convenient back-to-top button with fun animations, overlaid onto every page you visit!", "homepage_url": "https://garagerocket.com/extensions/toprocket", "version": "0.0.3", "manifest_version": 3, "minimum_chrome_version": "116", "action": {"default_title": "Top Rocket: right-click to customize"}, "background": {"service_worker": "serviceworker.js", "type": "module"}, "commands": {"rocketNowKey": {"suggested_key": {"default": "Alt+R"}, "description": "Send a rocket request to the current tab"}, "toggleOverlayKey": {"suggested_key": {"default": "Alt+T"}, "description": "Show/hide the overlay"}, "toggleDebugKey": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "enable/disable console logging"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "/images/toprocket-store-icon-16.png", "32": "/images/toprocket-store-icon-32.png", "48": "/images/toprocket-store-icon-48.png", "64": "/images/toprocket-store-icon-64.png", "96": "/images/toprocket-store-icon-96.png", "128": "/images/toprocket-store-icon-128.png"}, "permissions": ["alarms", "contextMenus", "scripting", "storage", "tabs"]}