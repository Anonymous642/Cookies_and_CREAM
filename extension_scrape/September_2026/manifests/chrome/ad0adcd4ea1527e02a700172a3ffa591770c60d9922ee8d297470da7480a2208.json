{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Block YouTube Shorts - I'm UnHooked", "version": "1.0.1", "description": "Remove YouTube Shorts from your feed. Stay focused, avoid endless scrolling, and take back control of your time.", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": "youtube-icon.png"}, "icons": {"48": "youtube-icon.png", "128": "youtube-icon.png"}, "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}