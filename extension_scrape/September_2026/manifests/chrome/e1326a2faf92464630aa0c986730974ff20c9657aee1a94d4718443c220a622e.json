{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Neko", "version": "1.3", "description": "Documenting is tedious. This extension makes it easy: speak to document and ask to find information. Try it!", "icons": {"16": "icons/Cat16.png", "48": "icons/Cat48.png", "128": "icons/Cat128.png"}, "background": {"service_worker": "service-worker.js"}, "side_panel": {"default_path": "panel.html"}, "action": {"default_title": "Neko: Document Smarter, Work Better"}, "permissions": ["sidePanel"], "host_permissions": ["https://backend-extension-397605286686.us-central1.run.app/"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}}}, "web_accessible_resources": [{"resources": ["mic.html", "mic.js", "placeholder-handler.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}