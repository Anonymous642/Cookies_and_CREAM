{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebPin Notes - Smart URL & Web Notes", "description": "Capture context-rich notes tied to every webpage and website you browse.", "version": "1.0.2", "short_name": "WebPin Notes", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "contextMenus", "activeTab", "scripting", "storage", "sidePanel"], "action": {"default_title": "WebPin Notes"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Open WebPin Notes Sidepanel"}, "save-selection": {"suggested_key": {"default": "Ctrl+Q", "mac": "Command+Q"}, "description": "Save selected text to WebPin Notes Note"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}