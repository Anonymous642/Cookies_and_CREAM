{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SignalBox CRM: Save Contacts", "short_name": "SignalBox", "version": "2.0.0", "description": "Save people from LinkedIn and Instagram to SignalBox in one click, straight into your circles, or update them if already there.", "homepage_url": "https://signalboxcrm.com", "externally_connectable": {"matches": ["https://www.signalboxcrm.com/*", "https://signalboxcrm.com/*"]}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://www.instagram.com/*", "https://www.signalboxcrm.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/geist-latin.woff2"], "matches": ["https://www.linkedin.com/*", "https://www.instagram.com/*"]}]}