{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UniProxy", "version": "1.12.1", "description": "Connect to HTTP and SOCKS5 proxies directly from your browser toolbar.", "permissions": ["proxy", "storage", "notifications", "webRequest", "webRequestAuthProvider", "browsingData"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "UniProxy"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"toggle-proxy": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle proxy on/off"}, "next-profile": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Switch to the next proxy profile"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}