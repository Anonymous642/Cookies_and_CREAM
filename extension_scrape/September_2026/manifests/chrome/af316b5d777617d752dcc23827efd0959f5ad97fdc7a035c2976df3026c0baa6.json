{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Secure your Profile \u2014 by Agate Business Consulting", "description": "Soft-lock Chrome browsing with a local password gate. Credentials are cryptographically protected and stored only on this device.", "version": "1.1.9", "minimum_chrome_version": "114", "action": {"default_title": "Secure your Profile", "default_popup": "pages/popup.html"}, "options_page": "pages/options.html", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage", "declarativeNetRequest"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service_worker.js", "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "base_rules", "enabled": true, "path": "dnr/base_rules.json"}]}}