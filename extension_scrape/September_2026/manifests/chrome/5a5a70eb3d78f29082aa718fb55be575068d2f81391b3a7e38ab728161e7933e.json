{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Inbox", "version": "1.0.0", "description": "Turn saved tabs into an actionable queue.", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_title": "Tab Inbox", "default_popup": "src/popup/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["storage", "tabs", "alarms"], "commands": {"save-current-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save current tab to Tab Inbox"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open Tab Inbox dashboard"}}}