{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SolveX", "version": "2.5.2", "description": "AI solver for McGraw-Hill Connect & SmartBook 2.0. Requires a SolveX account \u2014 sign in at solvex.help.", "permissions": ["storage", "activeTab", "scripting", "tabs", "power", "alarms"], "host_permissions": ["*://*.mheducation.com/*", "*://*.mhhe.com/*", "*://*.amazonaws.com/*", "*://*.cloudfront.net/*", "https://solvex-backend-production.up.railway.app/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.mheducation.com/*", "*://*.mhhe.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SolveX"}, "commands": {"snap-solve": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Snap Solver \u2014 crop any question on screen to solve it"}, "panic-close": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Panic \u2014 instantly hide SolveX and stop solving"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "popup.html", "popup.js"], "matches": ["*://*.mheducation.com/*", "*://*.mhhe.com/*"]}]}