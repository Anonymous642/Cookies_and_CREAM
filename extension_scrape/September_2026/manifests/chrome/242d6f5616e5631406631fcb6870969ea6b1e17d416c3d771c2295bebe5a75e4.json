{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GoodIndigoOutlet", "version": "1.2.0", "description": "View Goodreads ratings for books on indigo.ca, bookoutlet.ca, and kobo.com.", "permissions": ["storage"], "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "128": "images/icon-128.png", "192": "images/icon-192.png"}, "content_scripts": [{"js": ["scripts/content.js"], "css": ["goodreads.css"], "matches": ["https://www.indigo.ca/*", "https://indigo.ca/*", "https://bookoutlet.ca/book/*", "https://www.kobo.com/*/*/ebook/*"]}], "background": {"service_worker": "scripts/background.js"}, "host_permissions": ["https://www.goodreads.com/*", "https://openlibrary.org/*"]}