{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrowseAI", "version": "1.0.0", "description": "BrowseAI turns browsing into memory: trails, searchable pages, missions, replay, and highlights\u2014stored locall.", "permissions": ["scripting", "storage", "tabs", "activeTab", "management"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_title": "BrowseAI - Toggle Trails", "default_icon": {"16": "public/icons/icon-16.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}}, "icons": {"16": "public/icons/icon-16.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["public/missions.html", "public/missions.js"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"toggle-carousel": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle BrowseAI Trails"}}}