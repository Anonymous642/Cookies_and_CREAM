{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Great Filter", "version": "0.8.0", "description": "Filter toxic posts from X, Reddit, YouTube & Bluesky. Block scams, outrage bait & harassment. Three modes, no account needed.", "permissions": ["storage", "idle"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://www.youtube.com/*", "https://bsky.app/*", "https://great-filter-backend-production.up.railway.app/*"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "The Great Filter", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://www.reddit.com/*", "https://reddit.com/*"], "js": ["reddit.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["youtube.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://bsky.app/*"], "js": ["bluesky.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["report.html", "report.js"], "matches": ["chrome-extension://*/*"]}]}