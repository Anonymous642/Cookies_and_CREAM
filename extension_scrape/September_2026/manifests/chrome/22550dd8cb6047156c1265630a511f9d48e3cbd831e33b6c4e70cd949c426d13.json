{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sealit Vault \u2014 Password Manager", "version": "1.1.0", "description": "Zero-knowledge encrypted password manager. Autofill passwords on websites. Your passwords never leave your device unencrypted.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Sealit Vault"}, "commands": {"autofill-shortcut": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Autofill credentials on this page"}}, "permissions": ["activeTab", "storage", "tabs"], "externally_connectable": {"matches": ["https://sealit.sealed-vault.com/*", "http://localhost:5173/*"]}, "host_permissions": ["https://sealit.sealed-vault.com/*", "https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}