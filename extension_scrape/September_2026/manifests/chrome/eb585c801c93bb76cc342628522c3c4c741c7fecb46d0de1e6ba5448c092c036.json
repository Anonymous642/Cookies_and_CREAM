{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VolumePro - Advanced Audio Control", "version": "1.0.0", "description": "Professional audio control with per-site memory, EQ, and intelligent volume management. 600% boost, never reset volumes again.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/page-audio-hook.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/audio-injector.js", "content/desktop-equalizer.js", "content/desktop-player.js"], "run_at": "document_start", "all_frames": true}], "commands": {"volume-up": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Increase volume by 10%"}, "volume-down": {"suggested_key": {"default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Decrease volume by 10%"}, "mute-toggle": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle mute"}}, "web_accessible_resources": [{"resources": ["content/page-audio-hook.js"], "matches": ["<all_urls>"]}]}