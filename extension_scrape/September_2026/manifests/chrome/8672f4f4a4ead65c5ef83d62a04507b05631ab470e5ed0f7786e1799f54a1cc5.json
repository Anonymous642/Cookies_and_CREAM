{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Auto Switch", "version": "1.0.0", "description": "Rotate through chosen tabs or tab groups automatically, on your own interval, hands free.", "minimum_chrome_version": "120", "permissions": ["tabs", "tabGroups", "storage", "alarms", "scripting", "power"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Tab Auto Switch", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"previous-tab": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Go back to the previous tab"}, "next-tab": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Skip to the next tab"}, "pause-rotation": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Pause the rotation"}, "resume-rotation": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Resume the rotation, or start one"}, "toggle-rotation": {"description": "Start, or pause and resume, with one key (assign a key to use this)"}, "stop-rotation": {"description": "Stop the rotation (assign a key to use this)"}}}