{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chrome Tab Switcher", "version": "1.0.0", "description": "Native Mac app integration for ultra-fast tab switching with visual overlay", "permissions": ["tabs", "storage", "activeTab", "nativeMessaging", "notifications"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"switch-mru": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Switch to next MRU tab"}, "switch-mru-reverse": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Switch to previous MRU tab"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "minimum_chrome_version": "110"}