{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "100xtuber Creator Tools", "version": "1.0.0", "description": "YouTube creator tools without leaving the page: tags, transcript, thumbnails, CTR, CPM, and video ideas.", "permissions": ["sidePanel", "activeTab", "storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://studio.youtube.com/*", "https://100xtuber.com/*", "https://img.youtube.com/*", "https://i.ytimg.com/*", "https://noembed.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open 100xtuber tools", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://studio.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}