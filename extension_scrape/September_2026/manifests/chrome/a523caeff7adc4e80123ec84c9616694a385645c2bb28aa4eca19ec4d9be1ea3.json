{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Live Capture", "description": "Keyboard-driven capture assistant. Capture what you're looking at.", "version": "1.0.2", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"capture_profile": {"suggested_key": {"mac": "Command+1", "default": "Ctrl+1"}, "description": "Capture as Profile"}, "capture_post": {"suggested_key": {"mac": "Command+2", "default": "Ctrl+2"}, "description": "Capture as Post"}, "capture_interesting": {"suggested_key": {"mac": "Command+3", "default": "Ctrl+3"}, "description": "Capture as Interesting"}}}