{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "What a PDF! for Gmail & Drive", "version": "2.1.9", "description": "Open PDF files from Gmail and Google Drive directly in What a PDF! to edit, sign, compress and more.", "author": "What a PDF!", "homepage_url": "https://whatapdf.com", "host_permissions": ["https://mail.google.com/*", "https://drive.google.com/*", "https://whatapdf.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://drive.google.com/*"], "js": ["content-drive.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}}