{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Summarizer (Overlay)", "version": "1.5.0", "description": "Markierten Text als Stichpunkte zusammenfassen \u2013 lokal (offline) oder via eigenem KI-Provider. Overlay, Hotkeys, Artikelmodus.", "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_title": "Quick Summarizer"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"summarize-selection": {"suggested_key": {"default": "Alt+S"}, "description": "Auswahl zusammenfassen (Overlay)"}, "summarize-article": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Artikel zusammenfassen (Overlay)"}, "toggle-quickselect": {"suggested_key": {"default": "Alt+X"}, "description": "Quick-Select Modus umschalten"}}}