{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MockupForge Capture", "version": "0.6.0", "description": "Capture a tab as a desktop, tablet or mobile viewport, or both at once, and send it to MockupForge 3D for a device mockup.", "author": "lukeduff.co.uk", "homepage_url": "https://mockup.lukeduff.co.uk/extension", "action": {"default_popup": "popup.html", "default_title": "MockupForge Capture", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"capture-desktop": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Capture this tab and open it in MockupForge"}, "capture-mobile": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Capture this tab as a mobile viewport"}, "capture-tablet": {"suggested_key": {"default": "Ctrl+Shift+7", "mac": "Command+Shift+7"}, "description": "Capture this tab as a tablet viewport"}, "capture-both": {"description": "Capture this tab as desktop and mobile together"}}, "permissions": ["activeTab", "storage", "downloads", "alarms", "debugger", "unlimitedStorage"], "host_permissions": ["https://mockup.lukeduff.co.uk/*"], "content_scripts": [{"matches": ["https://mockup.lukeduff.co.uk/studio*"], "js": ["config.js", "content-bridge.js"], "run_at": "document_idle"}], "options_page": "settings.html"}