{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marketplace Image Downloader", "version": "0.3.2", "description": "Download full-resolution images from Facebook Marketplace, Kijiji, and eBay listings.", "permissions": ["downloads", "tabs"], "host_permissions": ["*://*.facebook.com/*", "*://*.kijiji.ca/*", "*://*.ebay.com/*", "*://*.ebay.ca/*", "*://*.ebay.co.uk/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Download listing images", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*.facebook.com/marketplace/*", "*://*.kijiji.ca/*", "*://*.ebay.com/*", "*://*.ebay.ca/*", "*://*.ebay.co.uk/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}