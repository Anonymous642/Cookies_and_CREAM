{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Web Elements Remover", "version": "1.1.0", "description": "Hover, hide, remember. A minimal element remover with per-site memory.", "action": {"default_icon": "icons/action_inactive.png", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"activate": {"suggested_key": {"chromeos": "Ctrl+Shift+X", "linux": "Ctrl+Shift+X", "mac": "Shift+Command+X", "windows": "Ctrl+Shift+X"}, "description": "Activate element selection mode"}, "activate_once": {"description": "Activate one-time element selection mode"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": false}], "permissions": ["commands", "scripting", "storage"], "host_permissions": ["*://*/*"], "icons": {"16": "icons/action_inactive.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "web_accessible_resources": [{"matches": ["*://*/*"], "resources": ["content.css"]}]}