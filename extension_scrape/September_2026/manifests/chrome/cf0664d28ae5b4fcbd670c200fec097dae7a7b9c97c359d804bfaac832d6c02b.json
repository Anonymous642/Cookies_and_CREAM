{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Domicad \u2014 write better, anywhere", "version": "0.1.0", "description": "Select any text on any site and rewrite it in your own voice, check it for AI, or fix the grammar \u2014 without leaving the page.", "minimum_chrome_version": "114", "permissions": ["contextMenus", "storage", "sidePanel", "activeTab", "scripting"], "commands": {"humanize": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Rewrite the selected text in my voice"}, "grammar": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Fix grammar in the selected text"}}, "host_permissions": ["https://domicad.app/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["https://domicad.app/*"], "js": ["bridge.js"], "run_at": "document_idle"}], "action": {"default_title": "Domicad", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "externally_connectable": {"matches": ["https://domicad.app/*"]}, "web_accessible_resources": [{"resources": ["welcome.html"], "matches": ["https://domicad.app/*"]}]}