{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pulse360 Library - Snippets & Prompts", "description": "Stop rewriting. Insert reusable snippets and AI prompts anywhere \u2014 including ChatGPT, Gemini, Claude, Gmail & more.", "version": "0.3.0", "short_name": "Pulse360 Library", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "storage", "cookies", "activeTab", "clipboardWrite", "clipboardRead", "contextMenus", "scripting"], "host_permissions": ["https://app.pulse360.com/*", "https://api.pulse360.com/*", "https://clerk.pulse360.com/*"], "commands": {"add-note": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Add selected text as note"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}