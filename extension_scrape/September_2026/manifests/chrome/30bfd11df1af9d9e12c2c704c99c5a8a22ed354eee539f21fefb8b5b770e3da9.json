{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Docs Dark Mode (Offline, No-Network)", "version": "1.0.0", "description": "Offline dark mode for Google Docs documents. No network calls.", "action": {"default_title": "Toggle Docs Dark Mode", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": true}], "commands": {"toggle": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle Docs Dark Mode"}}}