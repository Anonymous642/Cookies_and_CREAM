{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Resume Refiner - Job Search Co-Pilot", "version": "1.5.0", "description": "Score your resume against jobs on LinkedIn, Indeed, Glassdoor and more. Refine your resume to get interviews at your next dream job.", "permissions": ["storage", "activeTab", "identity", "tabs", "sidePanel", "scripting", "alarms"], "host_permissions": ["https://www.resumerefiner.ai/*"], "optional_host_permissions": ["*://*/*"], "action": {"default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.angel.co/jobs*", "*://*.angel.co/company/*/jobs*", "*://*.wellfound.com/jobs*", "*://*.wellfound.com/company/*/jobs*", "*://*.wellfound.com/l/*", "*://*.glassdoor.com/job-listing/*", "*://*.glassdoor.com/Job/*", "*://*.indeed.com/viewjob*", "*://*.indeed.com/m/viewjob*", "*://*.indeed.com/jobs*", "*://*.linkedin.com/jobs/*"], "js": ["content/content.js"]}], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}