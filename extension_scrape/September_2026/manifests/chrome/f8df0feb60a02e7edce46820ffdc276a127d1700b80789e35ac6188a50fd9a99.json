{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Atlassian Backup", "version": "1.0.0", "description": "Backup Confluence pages and Jira tickets as PDF with attachments to Downloads or SharePoint. No tokens needed.", "permissions": ["activeTab", "tabs", "debugger", "downloads", "scripting", "storage"], "host_permissions": ["https://*.atlassian.net/*", "https://*.atlassian.com/*", "https://*.sharepoint.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_title": "Atlassian Backup", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://*.atlassian.net/wiki/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://*.atlassian.net/*"], "js": ["jira.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://*.sharepoint.com/*"], "js": ["sp.js"], "run_at": "document_idle"}]}