{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RotoMonster Extension", "version": "0.8.3", "description": "Connects your ESPN and CBS fantasy accounts to RotoMonster (Baseball Monster / Basketball Monster).", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["cookies", "storage"], "host_permissions": ["*://*.espn.com/*", "*://*.cbssports.com/*", "*://*.fantasysports.yahoo.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.basketballmonster.com/authenticate.aspx*", "*://*.baseballmonster.com/authenticate.aspx*"], "js": ["content.js"], "css": ["content.css"]}, {"matches": ["*://fantasy.espn.com/*"], "js": ["espn-draft.js"], "run_at": "document_idle"}, {"matches": ["*://*.basketballmonster.com/*", "*://*.baseballmonster.com/*"], "js": ["draft-import.js"], "run_at": "document_idle"}, {"matches": ["*://*.fantasysports.yahoo.com/*"], "js": ["yahoo-roster.js"], "run_at": "document_idle"}, {"matches": ["*://*.fantasysports.yahoo.com/*"], "js": ["yahoo-draft.js"], "run_at": "document_idle"}]}