{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Just Translate Already \u2014 for X", "version": "1.0.0", "description": "Auto-clicks X's native Translate post button so foreign-language posts translate as you scroll. No setup, one toggle.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Just Translate Already \u2014 for X", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}