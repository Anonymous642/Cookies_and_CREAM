{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unmarked", "version": "1.0.1", "minimum_chrome_version": "140", "description": "Unmark copied text and text attachments by removing invisible Unicode, with optional user-configured rewriting.", "permissions": ["alarms", "clipboardRead", "clipboardWrite", "storage", "identity", "contextMenus", "activeTab", "scripting"], "optional_host_permissions": ["https://*/*", "*://localhost/*", "*://127.0.0.1/*", "*://[::1]/*"], "action": {"default_title": "Unmarked \u2014 unmark clipboard text or attachments", "default_popup": "popup.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "commands": {"rewrite-selected-text": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Rewrite selected editable text with Unmarked"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}