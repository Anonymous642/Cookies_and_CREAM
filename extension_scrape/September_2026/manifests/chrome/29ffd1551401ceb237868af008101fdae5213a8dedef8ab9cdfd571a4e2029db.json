{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Usefooltool - Link Grabber for Instagram", "description": "Automatically scrolls through your Instagram saved folder and collects all post and reel links for easy import to usefooltool.com.", "version": "1.0.1", "manifest_version": 3, "author": "Usefooltool.com", "homepage_url": "https://usefooltool.com", "icons": {"16": "icons/logo-usefool-tools-square-16x-black.png", "32": "icons/logo-usefool-tools-square-32x-black.png", "48": "icons/logo-usefool-tools-square-48x-black.png", "128": "icons/logo-usefool-tools-square-128x-black.png"}, "action": {"default_popup": "popup.html", "default_title": "Content Collector", "default_icon": {"16": "icons/logo-usefool-tools-square-16x-black.png", "32": "icons/logo-usefool-tools-square-32x-black.png", "48": "icons/logo-usefool-tools-square-48x-black.png", "128": "icons/logo-usefool-tools-square-128x-black.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["downloads", "activeTab"], "host_permissions": ["https://www.instagram.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*/saved/*"], "js": ["content.js"], "run_at": "document_idle"}]}