{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Folklore", "version": "0.1.0", "description": "Recognize genomic variants on web pages and open them in Folklore.", "permissions": ["storage"], "action": {"default_title": "Folklore", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://folklore.helena.bio/*", "*://*.folklore.helena.bio/*"], "js": ["variants.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}