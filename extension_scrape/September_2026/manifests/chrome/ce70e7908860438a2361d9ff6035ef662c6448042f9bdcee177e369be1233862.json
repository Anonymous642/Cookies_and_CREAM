{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Buster", "description": "Constrained browser agent that plans, clicks, and types from a side panel.", "version": "0.3.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "debugger", "sidePanel", "storage", "tabs", "tabGroups", "downloads"], "host_permissions": ["https://ai-gateway.vercel.sh/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Open Browser Buster", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/overlay.js"]}]}