{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "version": "1.0.0", "name": "Yopicky", "description": "See car parts instantly while browsing IAAI, Copart, & other auto auction sites", "author": "yopicky", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "assets/images/car_logo 16.png", "48": "assets/images/car_logo 48.png", "128": "assets/images/car_logo.png"}, "action": {"default_title": "Yopicky", "default_icon": "assets/images/car_logo.png", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "index.html"}, "permissions": ["tabs", "scripting", "activeTab", "sidePanel"], "host_permissions": ["*://www.iaai.com/*", "*://www.copart.com/*", "*://*.scaauction.com/*", "*://sca.auction/*", "*://*.erepairables.com/*", "*://www.autobidmaster.com/*", "*://*.replit.dev/*"], "content_scripts": [{"matches": ["*://www.iaai.com/*", "*://www.copart.com/*", "*://*.scaauction.com/*", "*://sca.auction/*", "*://*.erepairables.com/*", "*://www.autobidmaster.com/*"], "js": ["assets/js/content_script.js"], "run_at": "document_end"}]}