{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CS Concept Companion", "version": "1.0.0", "description": "Highlight any computer science term while you read and get a clear, beginner-friendly explanation without leaving the page.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://*.wikipedia.org/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "CS Concept Companion"}, "options_page": "options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"explain-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Explain the currently highlighted text"}}}