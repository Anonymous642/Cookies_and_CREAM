{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindFile - your AI memory", "version": "1.1.1", "description": "One local memory for ChatGPT, Claude, Gemini and more. Saved on your device, injected into new chats. No account, no cloud.", "background": {"service_worker": "extension/sw.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "permissions": ["storage", "contextMenus", "alarms"], "optional_host_permissions": ["https://*/*", "http://localhost/*"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://api.jwum.com/*", "https://jwum.b-cdn.net/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*"], "js": ["extension/lib/scrub.js", "extension/lib/store.js", "extension/lib/categorize.js", "extension/lib/dedupe.js", "extension/lib/suggest.js", "extension/lib/rank.js", "extension/lib/block.js", "extension/lib/packs.js", "extension/lib/enginecore.js", "extension/lib/license.js", "extension/content/engine.js"], "css": ["extension/content/engine.css"], "run_at": "document_idle"}], "commands": {"mf-insert-memory": {"suggested_key": {"default": "Alt+M", "mac": "MacCtrl+Shift+M"}, "description": "Insert MindFile memory into the chat composer"}}, "action": {"default_popup": "extension/popup.html", "default_title": "MindFile", "default_icon": {"16": "resources/logo_16.png", "32": "resources/logo_32.