{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Find It Again \u2014 Secure Full-Text History, Forever", "description": "Power your full-text web history search experience with secure local storage.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["offscreen", "storage", "unlimitedStorage", "history", "tabs", "scripting"], "action": {}, "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}