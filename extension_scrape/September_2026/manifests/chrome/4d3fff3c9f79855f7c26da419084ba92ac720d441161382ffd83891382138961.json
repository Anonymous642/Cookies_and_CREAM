{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SiteChat", "version": "0.2.2", "description": "Chat with people on the same site (domain/path). Activate per tab via the toolbar icon. Overlay + docked; Side Panel optional.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "SiteChat"}, "permissions": ["activeTab", "scripting", "sidePanel", "tabs"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["panel.html", "panel.css", "icon16.png", "icon48.png", "icon128.png"], "matches": ["<all_urls>"]}]}