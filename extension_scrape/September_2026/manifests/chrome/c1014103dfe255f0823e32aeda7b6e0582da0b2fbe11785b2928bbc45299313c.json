{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BingeBoost", "version": "1.2.0", "description": "Auto skip intros and boost volume on Netflix, Hotstar, and YouTube.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.netflix.com/*", "*://*.hotstar.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "BingeBoost", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.netflix.com/*", "*://*.hotstar.com/*"], "js": ["content/storage.js", "content/detector.js"], "run_at": "document_idle"}, {"matches": ["*://*.netflix.com/*", "*://*.hotstar.com/*"], "js": ["content/audio.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/youtube-controller.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/youtube-audio.js"], "run_at": "document_idle", "world": "MAIN"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["whats-new/whats-new.html"], "matches": ["<all_urls>"]}]}