{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Search Console Bulk URL Removal Tool (FREE)", "version": "3.0.2", "description": "Remove multiple URLs from Google Search Console at once. Supports both temporary and permanent removals.", "author": "Jim Walker, The Hack Repair Guy", "homepage_url": "https://hackrepair.com/bulk-url-removal-tool-for-google-search-console", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://search.google.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["popup/about.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://search.google.com/search-console/*"], "js": ["content/content.js"]}], "icons": {"16": "icons/icon16.png", "128": "icons/icon128.png"}}