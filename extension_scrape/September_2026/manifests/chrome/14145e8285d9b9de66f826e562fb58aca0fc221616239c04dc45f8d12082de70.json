{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quad \u2014 YouTube TV Multiview", "version": "1.4.0", "description": "YouTube TV multiview for Chrome: watch four channels in a fullscreen grid, switch audio, and save your lineup.", "minimum_chrome_version": "110", "permissions": ["storage", "system.display"], "host_permissions": ["https://tv.youtube.com/*"], "content_scripts": [{"matches": ["https://tv.youtube.com/*"], "js": ["shortcuts.js", "grid-content.js"], "run_at": "document_start", "all_frames": true}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open Quad \u2014 YouTube TV Multiview", "default_icon": "icons/128.png"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"open-launcher": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open Quad controls"}, "cycle-audio": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Switch audio to the next window"}, "mute-all": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Mute or restore all audio"}, "last-audio": {"description": "Previous player audio"}, "audio-1": {"description": "Select player 1 audio"}, "audio-2": {"description": "Select player 2 audio"}, "audio-3": {"description": "Select player 3 audio"}, "audio-4": {"description": "Select player 4 audio"}, "toggle-fullscreen": {"description": "Toggle grid fullscreen"}, "toggle-menus": {"description": "Show or hide channel menus"}, "save-channels": {"description": "Save current channels"}}, "web_accessible_resources": [{"resources": ["fonts/InterVariable.woff2"], "matches": ["https://tv.youtube.com/*"]}], "short_name": "Quad"}