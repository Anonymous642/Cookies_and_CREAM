{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LumaNote Learning Capture", "short_name": "LumaNote", "version": "0.3.0", "description": "Capture YouTube transcripts and save timestamped video snapshots to your LumaNote learning workspace.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://lumanote-library.yaoyaoyaoyap.workers.dev/*"], "action": {"default_title": "Capture with LumaNote", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "commands": {"capture-snapshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the current LumaNote video frame"}}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*"], "js": ["transcript-utils.js", "youtube-content.js"], "run_at": "document_idle"}, {"matches": ["https://lumanote-library.yaoyaoyaoyap.workers.dev/library*"], "js": ["pending-transcript.js", "lumanote-handoff.js"], "run_at": "document_idle"}]}