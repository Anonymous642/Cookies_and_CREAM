{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PIIShield Mail Guard", "version": "1.0.1", "description": "Detecta PII e ajuda a redigir e-mails com seguran\u00e7a no Gmail, Outlook Web e outros webmails.", "permissions": ["storage", "tabs", "sidePanel"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*", "https://api.piishield.com.br/*", "https://sandbox-api.mail-guard.melloait.com/*"], "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/sidebar.html"}, "action": {"default_title": "PIIShield Mail Guard", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "web_accessible_resources": [{"resources": ["assets/logo.svg"], "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*"]}]}