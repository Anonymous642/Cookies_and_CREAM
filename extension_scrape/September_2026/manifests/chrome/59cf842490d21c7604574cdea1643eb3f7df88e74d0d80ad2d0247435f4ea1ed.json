{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kokateki", "version": "2.0.0", "description": "Productivity-focused tab manager with timers and focus tools", "permissions": ["tabs", "storage", "activeTab", "alarms", "notifications", "offscreen"], "icons": {"48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-last-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last saved session"}, "start-timer": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Start focus timer"}}}