{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rezimi \u2014 Job Import", "version": "0.1.0", "description": "Generate a tailored resume from any job posting in one click.", "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://api.rezimi.com/*", "https://rezimi.com/*", "https://*.rezimi.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Rezimi \u2014 Generate a resume from this job", "default_popup": "src/popup/popup.html", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content/linkedin.js"], "run_at": "document_idle"}]}