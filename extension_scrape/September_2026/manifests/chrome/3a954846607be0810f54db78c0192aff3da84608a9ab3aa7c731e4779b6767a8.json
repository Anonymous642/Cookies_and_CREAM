{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blur My Chats", "version": "2.0.7", "description": "Blur messages and media on WhatsApp, LinkedIn, Facebook, Messenger, and Instagram. Reveal content on hover.", "permissions": ["storage", "scripting"], "host_permissions": ["https://web.whatsapp.com/*", "https://www.linkedin.com/*", "https://www.facebook.com/*", "https://www.messenger.com/*", "https://www.instagram.com/*", "https://blurmychats.com/*", "https://www.blurmychats.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*", "https://www.linkedin.com/*", "https://www.facebook.com/*", "https://www.messenger.com/*", "https://www.instagram.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}