{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speed & PiP \u2013 Netflix, Crunchyroll, Prime Video, YouTube", "version": "1.0.0", "description": "\u00c4ndert die Abspielgeschwindigkeit und aktiviert Bild-im-Bild (Picture-in-Picture) auf Netflix, Crunchyroll, Prime Video und YouTube.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "Speed & PiP", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.netflix.com/*", "*://*.crunchyroll.com/*", "*://static.crunchyroll.com/*", "*://*.primevideo.com/*", "*://*.amazon.de/gp/video/*", "*://*.amazon.com/gp/video/*", "*://*.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "all_frames": true, "run_at": "document_idle"}]}