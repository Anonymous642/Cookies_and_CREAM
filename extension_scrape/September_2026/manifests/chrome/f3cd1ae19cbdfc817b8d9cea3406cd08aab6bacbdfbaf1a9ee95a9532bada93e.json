{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleanTube - YouTube Content Filter", "version": "1.3.1", "description": "Advanced content filtering for YouTube - Block users, channels, and keywords for a cleaner viewing experience", "permissions": ["storage", "contextMenus", "activeTab", "notifications", "scripting", "tabs"], "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*", "*://cleantube.net/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["cleantube-shared.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/live_chat*"], "js": ["cleantube-shared.js", "livechat.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}