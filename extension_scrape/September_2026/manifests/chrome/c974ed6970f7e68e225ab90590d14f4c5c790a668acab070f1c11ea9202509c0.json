{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AIChatLens - AI Memory and Knowledge layer for Chats", "version": "1.0.0", "description": "Save, search, and organize AI chats and snippets from ChatGPT, Copilot, and Gemini", "permissions": ["storage", "scripting", "sidePanel", "contextMenus", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*"], "externally_connectable": {"matches": ["http://localhost:*/*", "https://aichatlens.com/*", "https://viewer.aichatlens.com/*", "https://*.vercel.app/*", "https://*.netlify.app/*"]}, "background": {"service_worker": "background.js"}, "icons": {"16": "favicons/icon-16.png", "32": "favicons/icon-32.png", "48": "favicons/icon-48.png", "128": "favicons/icon-128.png"}, "action": {"default_title": "AIChatLens", "default_icon": {"16": "favicons/icon-16.png", "32": "favicons/icon-32.png", "48": "favicons/icon-48.png", "128": "favicons/icon-128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*"], "js": ["chatContent.js", "snippetContent.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["favicons/*.png"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*"]}]}