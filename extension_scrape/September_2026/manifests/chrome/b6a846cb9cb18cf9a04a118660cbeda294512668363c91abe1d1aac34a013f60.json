{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Message Hider \u2014 Hide & Restore", "short_name": "ChatGPT Hider", "version": "2.3.0", "description": "Hide selected ChatGPT messages with one click and restore them anytime", "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidebar.html"}, "action": {"default_title": "ChatGPT Message Hider"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}