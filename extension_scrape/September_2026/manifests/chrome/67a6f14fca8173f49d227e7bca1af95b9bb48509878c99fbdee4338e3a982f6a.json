{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CookieSweep", "version": "1.0.0", "description": "Good-bye zombie cookies. Auto-deletes all first- & third-party cookies after tab closes.", "author": "TWINDLE NEDERLAND B.V.", "homepage_url": "https://cookiesweep.twindle.nl", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["cookies", "tabs", "storage", "notifications", "webRequest", "scripting", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CookieSweep - Click to manage settings"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "declarative_net_request": {"rule_resources": [{"id": "fingerprinting_ruleset", "enabled": true, "path": "rules.json"}]}, "minimum_chrome_version": "88", "short_name": "CookieSweep", "offline_enabled": true, "incognito": "split", "web_accessible_resources": [{"resources": ["privacy-policy.html", "icons/*.png"], "matches": ["<all_urls>"]}]}