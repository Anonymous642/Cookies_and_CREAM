{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volkey - Volume Control & Keybinds", "version": "2.1.0", "description": "Per-tab volume control (0-1000%). Set custom presets at any level and trigger them instantly with custom keyboard shortcuts.", "permissions": ["activeTab", "offscreen", "tabCapture", "tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"preset-1": {"suggested_key": {"default": "Alt+1", "mac": "Alt+1"}, "description": "Volkey: Apply Preset 1"}, "preset-2": {"suggested_key": {"default": "Alt+2", "mac": "Alt+2"}, "description": "Volkey: Apply Preset 2"}, "preset-3": {"description": "Volkey: Apply Preset 3"}, "preset-4": {"description": "Volkey: Apply Preset 4"}, "preset-5": {"description": "Volkey: Apply Preset 5"}, "volume-up": {"suggested_key": {"default": "Alt+Up", "mac": "Alt+Up"}, "description": "Volkey: Volume Up (step)"}, "volume-down": {"suggested_key": {"default": "Alt+Down", "mac": "Alt+Down"}, "description": "Volkey: Volume Down (step)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}