{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chinese Console Popup Dictionary", "description": "Hover over Chinese characters for definitions, images, examples, visualizations, radicals, frequencies, HSK info, & more", "version": "1.5.1", "action": {"default_icon": "images/icon48.png", "default_title": "Chinese Console - Chinese-English Dictionary"}, "background": {"service_worker": "extension_background.js"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["extension_content.js"], "all_frames": false}], "permissions": ["activeTab", "storage"], "web_accessible_resources": [{"resources": ["data/*", "images/*", "fonts/*"], "matches": ["*://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'"}}