{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Summary Box for Wikipedia", "version": "2.2.1", "description": "Select any word on any website and its Wikipedia summary appears next to it. Search Wikipedia in the box, star articles.", "author": "pinkytoes.com, Dominik Fehr", "homepage_url": "https://su-pa.net/wikiPrevBox/", "minimum_chrome_version": "102", "icons": {"48": "icons/wiki-summary-w-on-48.png", "128": "icons/wiki-summary-w-on-128.png"}, "action": {"default_icon": {"16": "icons/wikibox-16.png", "32": "icons/wikibox-32.png"}, "default_title": "Summary Box for Wikipedia"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Turn the summary box on or off"}, "toggle-site": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Turn the summary box on or off for the current site"}}, "background": {"service_worker": "sw.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["settings.js", "wikipediaPreviewEnhanced.js"], "css": ["wikiBoxHost.css"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "contextMenus"], "host_permissions": ["*://*.wikipedia.org/*"], "web_accessible_resources": [{"resources": ["wikiPreviewBox.css", "SegoeWP-Semilight.woff2", "wiki-W.woff2", "bullet.gif"], "matches": ["<all_urls>"]}]}