{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Telegram Comments Remover", "version": "0.1.0", "description": "Hide comments on Telegram Web to reduce distractions.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}