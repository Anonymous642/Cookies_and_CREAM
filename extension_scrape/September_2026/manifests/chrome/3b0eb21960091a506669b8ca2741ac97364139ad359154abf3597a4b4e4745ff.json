{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Drift Light: Stop Youtube Doomscrolling", "version": "0.2.1", "manifest_version": 3, "description": "A YouTube blocker that reads your behavior, not the clock.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Drift Light", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms", "scripting"], "web_accessible_resources": [{"resources": ["ui/blocked.html", "ui/blocked.js"], "matches": ["https://www.youtube.com/*"]}], "host_permissions": ["https://www.youtube.com/*", "https://drift-light-api.drift-light.workers.dev/*", "https://drift-light.app/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content/youtube.js"], "run_at": "document_idle"}, {"matches": ["https://drift-light.app/*"], "js": ["src/content/site-theme.js"], "run_at": "document_start"}, {"matches": ["https://drift-light.app/success*"], "js": ["src/content/success.js"], "run_at": "document_idle"}, {"matches": ["https://drift-light.app/redeem*"], "js": ["src/content/redeem.js"], "run_at": "document_idle"}]}