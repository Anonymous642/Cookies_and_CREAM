{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleoSum \u2014 AI YouTube Video Analysis", "version": "1.5.17", "description": "AI analyzes YouTube videos before you click. See scores, summaries, comment insights & transcripts on thumbnails.", "permissions": ["storage", "scripting", "activeTab", "identity", "sidePanel", "alarms", "notifications"], "host_permissions": ["https://www.youtube.com/*", "https://cleosum.com/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["caption-bridge.js"], "run_at": "document_idle", "world": "MAIN"}], "side_panel": {"default_path": "popup.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.youtube.com/*"]}]}