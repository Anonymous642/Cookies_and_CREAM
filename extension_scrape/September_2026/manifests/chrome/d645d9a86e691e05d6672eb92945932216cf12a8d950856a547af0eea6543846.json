{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "description": "Use your authenticated browser sessions to generate Yokee social media Snapshots.", "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"js": ["yokee-bridge.js"], "run_at": "document_start", "matches": ["https://yokee.net/*"]}], "incognito": "not_allowed", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "name": "Yokee Snapshot", "version": "2.2.3", "permissions": ["cookies", "storage"], "optional_host_permissions": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}