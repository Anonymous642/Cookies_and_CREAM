{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Realtism", "version": "1.0.1", "description": "Save homes from Zillow, Redfin, Trulia, and Realtor.com and send them to your realtor with notes and ratings.", "author": "Realtism", "homepage_url": "https://realtism.lovable.app", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["*://*.zillow.com/*", "*://*.redfin.com/*", "*://*.trulia.com/*", "*://*.realtor.com/*"], "action": {"default_popup": "popup.html", "default_title": "Save this home", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "content_scripts": [{"matches": ["*://*.zillow.com/*", "*://*.redfin.com/*", "*://*.trulia.com/*", "*://*.realtor.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}