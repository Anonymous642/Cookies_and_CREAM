{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Program List Exporter for Residency Explorer", "version": "0.1.1", "description": "Export the residency program data you can already see on residencyexplorer.org as a CSV. Not affiliated with or endorsed by AAMC.", "permissions": ["storage", "downloads", "sidePanel"], "host_permissions": ["https://www.residencyexplorer.org/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.residencyexplorer.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/sidepanel/index.html"}, "action": {"default_title": "Program List Exporter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}