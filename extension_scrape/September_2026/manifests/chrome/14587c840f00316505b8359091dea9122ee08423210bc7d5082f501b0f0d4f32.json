{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CommentGrab", "version": "1.0.0", "description": "Grab YouTube comments, arrange and animate them on a canvas, and export PNGs or video.", "homepage_url": "https://staiola.studio", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "unlimitedStorage", "scripting", "downloads", "offscreen"], "host_permissions": ["https://www.youtube.com/*", "https://*.ggpht.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "CommentGrab: pick comments (Alt/Option+Shift+C)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-picker": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle the comment picker"}, "open-canvas": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open the comment canvas"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content/picker.js"], "css": ["src/content/picker.css"], "run_at": "document_idle"}]}