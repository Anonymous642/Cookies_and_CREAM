{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Mixer for Chrome", "version": "1.8.0", "description": "Control, mute, and boost individual Chrome tabs up to 600% with remembered site defaults.", "permissions": ["activeTab", "contextMenus", "scripting", "tabs", "storage", "tabCapture", "offscreen", "sidePanel"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Volume Mixer for Chrome"}, "side_panel": {"default_path": "popup.html"}, "commands": {"volume_up": {"description": "Increase current tab volume by 10%"}, "volume_down": {"description": "Decrease current tab volume by 10%"}, "mute_current_tab": {"description": "Mute or unmute the current tab"}, "connect_current_tab": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Open the mixer and connect the current tab"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "116"}