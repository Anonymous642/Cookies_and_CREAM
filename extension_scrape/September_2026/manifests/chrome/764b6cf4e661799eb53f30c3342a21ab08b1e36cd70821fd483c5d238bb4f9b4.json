{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flow Exporter for Zoho Flow", "version": "1.3.0", "description": "Export a Zoho Flow workflow \u2014 steps, field mappings and custom function code \u2014 to one JSON file. Nothing leaves your browser.", "permissions": ["scripting", "storage"], "host_permissions": ["https://flow.zoho.com/*", "https://flow.zoho.eu/*", "https://flow.zoho.in/*", "https://flow.zoho.com.au/*", "https://flow.zoho.jp/*", "https://flow.zohocloud.ca/*", "https://flow.zoho.sa/*", "https://flow.zoho.uk/*", "https://flow.zoho.com.cn/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Export this Zoho Flow"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://flow.zoho.com/*", "https://flow.zoho.eu/*", "https://flow.zoho.in/*", "https://flow.zoho.com.au/*", "https://flow.zoho.jp/*", "https://flow.zohocloud.ca/*", "https://flow.zoho.sa/*", "https://flow.zoho.uk/*", "https://flow.zoho.com.cn/*"], "js": ["src/lib/hosts.js", "src/lib/json-safe.js", "src/lib/org-id.js", "src/lib/bridge-client.js", "src/lib/api.js", "src/lib/normalize.js", "src/content.js"], "run_at": "document_idle"}]}