{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Typeseek", "version": "1.1.0", "description": "Hide & seek with fonts. See the fonts any website really uses: hover text for details, pin and copy styles, press Esc to close.", "permissions": ["scripting", "activeTab", "storage"], "action": {"default_title": "Typeseek \u2014 inspect fonts (Esc closes)"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-typeseek": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle Typeseek on the current page"}}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}