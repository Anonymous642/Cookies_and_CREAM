{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TradingWizard: AI Trading Bots for TradingView", "version": "5.0.5", "description": "Deploy Wiz AI trading bots on any TradingView chart and see each bot's live read and reasoning. Bots trade on paper only.", "minimum_chrome_version": "116", "permissions": ["storage", "alarms", "sidePanel"], "host_permissions": ["https://tradingwizard.ai/*", "https://www.tradingwizard.ai/*", "https://www.tradingview.com/*", "https://tradingview.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.tradingview.com/*", "https://tradingview.com/*"], "js": ["content/content-script.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://tradingwizard.ai/extension-auth*", "https://www.tradingwizard.ai/extension-auth*"], "js": ["content/auth-bridge.js"], "run_at": "document_end"}], "side_panel": {"default_path": "sidebar/sidebar.html"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}, "commands": {"open-sidebar": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Alt+Shift+W"}, "description": "Open the Wiz bots panel"}}}