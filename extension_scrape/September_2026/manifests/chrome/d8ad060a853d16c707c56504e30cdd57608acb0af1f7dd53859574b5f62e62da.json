{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TempoTango - BPM & Key Analyzer", "short_name": "TempoTango", "version": "1.0.1", "description": "Detect the BPM and musical key of the track playing in your active tab. Built for DJs prepping their next set.", "author": "TempoTango", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "TempoTango: analyze BPM & key", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "activeTab", "storage", "scripting"], "host_permissions": ["https://soundcloud.com/*", "https://*.soundcloud.com/*", "https://api.lemonsqueezy.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "sandbox": {"pages": ["sandbox/sandbox.html"]}, "web_accessible_resources": [{"resources": ["lib/*", "sandbox/sandbox.html"], "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"]}], "minimum_chrome_version": "116"}