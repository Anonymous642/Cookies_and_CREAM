{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts Auto Scroll", "version": "1.0", "description": "T\u1ef1 \u0111\u1ed9ng l\u01b0\u1edbt qua YouTube Shorts khi video loop l\u1ea1i. B\u1eadt/t\u1eaft b\u1eb1ng Alt+S ho\u1eb7c n\u00fat trong popup.", "permissions": ["storage", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YouTube Shorts Auto Scroll"}, "content_scripts": [{"matches": ["*://www.youtube.com/shorts/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}