{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindFilter - Visual Word Filter", "version": "1.0.0", "description": "Visually filter specific words and phrases on web pages with custom display modes while preserving original text and page layout.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "MindFilter", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "css": ["content/content.css"], "js": ["content/content.js"], "run_at": "document_idle"}], "commands": {"toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle extension on/off"}, "reveal-page": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Temporarily reveal all text on current page"}, "pause-filtering": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Pause word filtering"}}}