{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HookTide Assistant", "version": "1.5.0", "description": "Suggest authentic replies on LinkedIn using your HookTide profile.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["*://*.linkedin.com/*"]}], "permissions": ["storage"], "host_permissions": ["*://*.linkedin.com/*", "https://hooktide.io/*"], "commands": {"suggest-reply": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Suggest a reply in the focused LinkedIn comment box"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content-linkedin.js"], "css": ["content-styles.css"]}], "options_page": "options.html"}