{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kids' Recall \u2014 Recall Checker for Baby & Kids Products", "version": "1.1.0", "description": "Checks products against official U.S. children's recall data (CPSC) as you shop.", "permissions": ["storage", "alarms", "activeTab"], "host_permissions": ["https://www.saferproducts.gov/*", "https://*.amazon.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icons/shield-16.png", "32": "icons/shield-32.png", "48": "icons/shield-48.png", "128": "icons/shield-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Kids' Recall", "default_icon": {"16": "icons/shield-16.png", "32": "icons/shield-32.png", "48": "icons/shield-48.png", "128": "icons/shield-128.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}