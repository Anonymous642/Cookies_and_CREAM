{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickClip", "version": "1.1.0", "description": "Auto-copy text on double-click or selection. Keep a local history of copied items.", "default_locale": "en", "permissions": ["storage", "activeTab", "clipboardWrite", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "QuickClip"}, "options_page": "options/options.html", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"copy-selection": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Copy current selection"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}