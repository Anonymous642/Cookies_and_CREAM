{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SleepyTabs", "description": "Save memory by putting inactive tabs to sleep", "default_locale": "en", "version": "1.10.1", "icons": {"32": "/icons/icon-32.png", "64": "/icons/icon-64.png", "128": "/icons/icon-128.png"}, "permissions": ["tabs", "storage", "alarms", "contextMenus", "notifications", "sessions", "tabGroups", "sidePanel", "downloads"], "optional_host_permissions": ["<all_urls>"], "optional_permissions": ["scripting"], "background": {"service_worker": "main.js", "type": "module"}, "side_panel": {"default_path": "popup/popup.html"}, "action": {"default_icon": {"32": "/icons/icon-32.png", "48": "/icons/icon-64.png", "128": "/icons/icon-128.png"}, "default_title": "SleepyTabs", "default_popup": "/popup/popup.html"}, "commands": {"sleep-current-tab": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Sleep the current tab"}, "sleep-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Sleep all tabs"}, "wake-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Wake all tabs"}, "openSidePanel": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Command+Shift+4"}, "description": "Open SleepyTabs sidebar"}, "add-to-caffeinelist": {"description": "Add the current tab to the caffeine list"}, "giveEspressoShot": {"description": "Give the current tab an espresso shot"}, "removeEspressoShot": {"description": "Remove the current tab's espresso shot"}, "wake-current-tab": {"description": "Wake the current tab"}, "toggle-current-tab": {"description": "Toggle sleep/wake for the current tab"}}}