{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spotify Lyrics Pop-Out", "version": "0.1.7", "description": "Floating, synchronized lyrics for Spotify Web in a resizable Picture-in-Picture window.", "minimum_chrome_version": "130", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://open.spotify.com/*", "https://lrclib.net/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Open Spotify Lyrics Pop-Out", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://open.spotify.com/*"], "js": ["src/lyrics.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/pip.css"], "matches": ["https://open.spotify.com/*"]}]}