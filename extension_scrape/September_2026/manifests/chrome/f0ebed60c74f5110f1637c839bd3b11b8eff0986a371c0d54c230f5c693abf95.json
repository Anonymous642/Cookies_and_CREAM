{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "eBay Cross-Lister", "version": "1.0.2", "description": "Instantly cross-list eBay listings to Vinted, Depop, and Facebook Marketplace in background tabs.", "permissions": ["storage"], "host_permissions": ["https://*.ebay.com/*", "https://*.ebay.com.au/*", "https://*.facebook.com/*", "https://*.vinted.com/*", "https://*.vinted.com.au/*", "https://*.depop.com/*", "https://*.ebaydesc.com/*", "https://*.ebayimg.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.ebay.com/*", "https://*.ebay.com.au/*"], "js": ["ebay_content.js"], "run_at": "document_idle"}, {"matches": ["https://*.facebook.com/*"], "js": ["facebook_content.js"], "run_at": "document_idle"}, {"matches": ["https://*.vinted.com/*", "https://*.vinted.com.au/*"], "js": ["vinted_content.js"], "run_at": "document_idle"}, {"matches": ["https://*.depop.com/*"], "js": ["depop_content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}}