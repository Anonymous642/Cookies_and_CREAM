{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StickyNotes", "version": "2.0.0", "description": "Create and manage sticky notes on any webpage. Notes sync across devices.", "permissions": ["storage", "contextMenus", "alarms", "notifications", "activeTab"], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles/notes.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "StickyNotes", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"create-note": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Create a new sticky note on this page"}}}