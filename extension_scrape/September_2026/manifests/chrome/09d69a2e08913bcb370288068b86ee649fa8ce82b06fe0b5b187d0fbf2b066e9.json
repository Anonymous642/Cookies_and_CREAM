{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BadBlock for Bad Ads", "description": "Stops unwanted pop-up tabs on select websites.", "version": "1.0.0", "icons": {"16": "icon/16.png", "24": "icon/24.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "host_permissions": ["https://the.streameast.app/*"], "permissions": ["storage", "declarativeNetRequest", "tabs", "webRequest"], "declarative_net_request": {"rule_resources": [{"id": "streameast", "enabled": true, "path": "./rules/streameast.json"}]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "BadBlock", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://the.streameast.app/*"], "js": ["content-scripts/content.js"]}]}