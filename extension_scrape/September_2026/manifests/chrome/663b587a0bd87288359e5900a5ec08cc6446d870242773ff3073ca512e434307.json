{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Punchlite: YouTube AI Summaries with ChatGPT and Gemini", "version": "1.4.1", "description": "Summarize YouTube videos and X Spaces with AI, powered by ChatGPT, Gemini, and Claude. Save time and start learning fast.", "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["https://punchlite.ai/*", "https://*.youtube.com/*", "https://x.com/*", "https://twitter.com/*", "https://us.i.posthog.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self';"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/youtube.js"], "css": ["content/styles.css"]}, {"matches": ["https://x.com/i/spaces/*", "https://twitter.com/i/spaces/*"], "js": ["content/xspaces.js"], "css": ["content/styles.css"]}, {"matches": ["https://punchlite.ai/*"], "js": ["content/auth-sync.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}