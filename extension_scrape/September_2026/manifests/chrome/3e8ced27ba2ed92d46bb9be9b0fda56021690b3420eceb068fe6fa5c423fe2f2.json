{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeCasino", "description": "De-casino-fy distracting sites: grayscale, time overlay, HDR kill switch, and per-site control.", "version": "1.1.1", "icons": {"16": "icons/decasino-16.png", "32": "icons/decasino-32.png", "48": "icons/decasino-48.png", "128": "icons/decasino-128.png"}, "permissions": ["storage", "tabs", "favicon"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["_favicon/*", "icons/*.png"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "DeCasino"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}