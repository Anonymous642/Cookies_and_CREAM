{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Severn Planner Overlay", "version": "1.3.1", "description": "Puts Severn Planner on top of your school's Blackbaud, Canvas, Schoology or Google Classroom site and syncs assignments and grades.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://*.myschoolapp.com/*", "https://app.severnplanner.com/*", "https://severnplanner.edgeone.app/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.myschoolapp.com/*"], "js": ["content-overlay.js"], "run_at": "document_end"}, {"matches": ["https://app.severnplanner.com/*", "https://severnplanner.edgeone.app/*"], "js": ["shared/planner-bridge.js"], "all_frames": true, "run_at": "document_end"}]}