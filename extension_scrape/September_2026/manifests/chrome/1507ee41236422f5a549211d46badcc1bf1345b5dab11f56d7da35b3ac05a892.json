{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Search Console \u2013 Bulk URL Indexing Tool", "version": "1.6", "description": "Automates URL input in GSC, handles dialogs, and tracks processing stats. Stops on quota.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://search.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "GSC Bulk Inspector", "default_icon": {"128": "images/icon128.png"}}, "icons": {"128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://search.google.com/search-console/*", "https://search.google.com/u/*/search-console/*"], "js": ["content.js"]}]}