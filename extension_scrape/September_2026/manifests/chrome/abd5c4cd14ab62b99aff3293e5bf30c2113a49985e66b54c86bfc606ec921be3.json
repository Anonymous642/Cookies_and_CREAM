{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StumbleU", "version": "1.4.23", "description": "Discover unexpected, interesting pages across the web. One click to stumble, optional AI thinking to go deeper.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://stumbleu.vercel.app/*"], "commands": {"stumble-now": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Stumble to a new page"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["dashboard.html", "dashboard.css", "dashboard.js", "welcome.html"], "matches": ["https://stumbleu.vercel.app/*", "http://localhost:3000/*"]}]}