{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whiteboard for LeetCode", "version": "1.0.4", "description": "A whiteboard on every LeetCode problem. Sketch trees, graphs, arrays, etc. while saving your drawings per problem.", "permissions": ["storage", "unlimitedStorage"], "action": {"default_title": "Whiteboard for LeetCode", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/*", "https://leetcode.cn/*"], "js": ["src/board.js", "src/ui.js", "src/content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/whiteboard.css"], "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"]}], "commands": {"toggle-whiteboard": {"suggested_key": {"default": "Alt+W"}, "description": "Show or hide the whiteboard"}}}