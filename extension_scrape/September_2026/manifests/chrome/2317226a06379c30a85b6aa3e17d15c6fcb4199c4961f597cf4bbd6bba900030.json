{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Button", "version": "3.3.3", "description": "Identifying and filtering AI Slop everywhere.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "commands"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "css": ["ai-button.css", "channel-ai-styles.css", "comment-analyzer.css"], "js": ["firebase.js", "youtube-theme-detector.js", "ai-button.js", "channel-ai.js", "comment-analyzer.js", "content.js"], "run_at": "document_idle"}, {"matches": ["*://www.instagram.com/*"], "css": ["ai-button-instagram.css"], "js": ["firebase.js", "instagram-theme-detector.js", "ai-button-instagram.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://www.youtube.com/watch?v=*", "*://www.youtube.com/shorts/*", "*://www.instagram.com/*", "*://www.youtube.com/*"], "css": ["smart-hover.css"], "js": ["firebase.js", "smart-hover.js", "smart-hover-init.js"], "run_at": "document_idle", "all_frames": false}], "host_permissions": ["https://firestore.googleapis.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"], "background": {"service_worker": "background.js"}, "commands": {"toggle_smart_hover": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle Smart Hover feature"}, "toggle_ai_button_position": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle AI Button position"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}