{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSweep \u2014 Auto-Clear Cookies & Storage on Tab Close", "version": "0.1.0", "description": "Auto-clears a site's cookies, localStorage, IndexedDB & cache when you close its last tab. Free, no paywall, per-site allowlist.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TabSweep", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "incognito": "split", "commands": {"clean-current-site": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Clean the current site's data now"}}, "permissions": ["tabs", "cookies", "browsingData", "storage", "alarms"], "optional_host_permissions": ["https://*/*", "http://*/*"]}