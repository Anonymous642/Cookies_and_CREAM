{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CoachFox", "version": "1.0", "description": "CoachFox tracks your browsing behavior in 20\u2011minute increments to help you stay focused and boost productivity.", "permissions": ["tabs", "storage", "scripting", "activeTab", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icon_happy.png", "32": "icon_happy.png", "48": "icon_happy.png", "128": "icon_happy.png"}, "action": {"default_icon": "icon_happy.png", "default_title": "CoachFox is happy", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon_happy.png", "icon_neutral.png", "icon_sad.png"], "matches": ["http://*/*", "https://*/*"]}]}