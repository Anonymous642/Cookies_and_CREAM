{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeNitro", "version": "1.3", "description": "Adds a playback speed slider to the YouTube video page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com;"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["constants.js", "longPressSlider.js", "longPress/slider.js", "longPress/ui.js", "speedControls.js", "styles.js"], "matches": ["https://www.youtube.com/*"]}]}