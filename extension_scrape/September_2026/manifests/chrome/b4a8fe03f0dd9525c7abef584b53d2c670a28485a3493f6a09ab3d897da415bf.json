{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShortlistFast L1", "version": "1.0.0", "description": "Capture meeting transcripts for L1 interviews (Meet, Zoom, Teams)", "homepage_url": "https://shortlistfast.com", "privacy_policy": "https://shortlistfast.com/privacy", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://shortlistfast-api.onrender.com/*", "https://meet.google.com/*", "https://*.zoom.us/*", "https://*.teams.microsoft.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://gov.teams.microsoft.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["chat-panel.css"], "matches": ["*://meet.google.com/*", "*://*.zoom.us/*", "*://*.teams.microsoft.com/*", "*://teams.microsoft.com/*", "*://teams.live.com/*"]}, {"resources": ["meet-captions.inline.js"], "matches": ["*://meet.google.com/*"]}, {"resources": ["zoom.inline.js"], "matches": ["*://*.zoom.us/*"]}, {"resources": ["msteams.inline.js"], "matches": ["*://teams.microsoft.com/*", "*://teams.live.com/*", "*://*.teams.microsoft.com/*", "*://*.teams.live.com/*"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "sidepanel.html", "default_title": "ShortlistFast L1 \u2013 Start interview, Enter ID, End interview", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://meet.google.com/*", "*://*.zoom.us/*", "*://teams.microsoft.com/*", "*://teams.live.com/*", "*://*.teams.microsoft.com/*", "*://*.teams.live.com/*"], "js": ["injector.js"], "run_at": "document_start"}, {"matches": ["*://meet.google.com/*", "*://*.zoom.us/*", "*://teams.microsoft.com/*", "*://teams.live.com/*", "*://*.teams.microsoft.com/*", "*://*.teams.live.com/*", "*://gov.teams.microsoft.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}