{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ICU OCR: Intelligent Capture Utility", "short_name": "ICU OCR", "description": "Go beyond simple OCR and create custom AI workflows to instantly extract, format and send text from any image to your favorite apps.", "version": "0.1.1", "manifest_version": 3, "minimum_chrome_version": "109", "permissions": ["contextMenus", "storage", "offscreen", "clipboardRead", "clipboardWrite", "activeTab", "notifications"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "action": {"default_title": "ICU OCR \u2014 AI Clipboard", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com;"}, "commands": {"ocr_clipboard_image": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "OCR the current clipboard image via AI"}}, "web_accessible_resources": [{"resources": ["content/drag-overlay.css", "icons/*.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/drag-overlay.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/theme-detector.js"], "run_at": "document_start"}, {"matches": ["https://workflowy.com/*", "https://beta.workflowy.com/*"], "js": ["content/workflowy-connector.js"], "run_at": "document_idle", "all_frames": true}]}