{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Settings Navigator", "version": "1.0.1", "description": "Quick navigation between configuration areas on Aprimo DAM environments.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Settings Navigator"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.dam.aprimo.com/*", "https://*.aprimo.com/*", "https://*.demobrandportal.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["storage", "tabs"], "host_permissions": ["https://*.dam.aprimo.com/*", "https://*.aprimo.com/*", "https://*.demobrandportal.com/*"], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Toggle the Aprimo Settings Navigator sidebar"}}}