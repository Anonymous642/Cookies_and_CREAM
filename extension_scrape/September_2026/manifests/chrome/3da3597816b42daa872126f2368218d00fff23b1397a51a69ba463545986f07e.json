{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Privacy Shield", "description": "Locally blur sensitive WhatsApp Web content until you intentionally reveal it.", "version": "1.0.1", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WhatsApp Privacy Shield", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "permissions": ["storage"], "host_permissions": ["https://web.whatsapp.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content/selector-config.js", "content/content.js"], "css": ["content/privacy-blur.css"], "run_at": "document_idle"}], "commands": {"toggle-privacy-shield": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Toggle Privacy Shield"}, "panic-blur-all": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Panic blur all protected areas"}, "next-privacy-profile": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Alt+Shift+Right"}, "description": "Switch to next Privacy Shield profile"}, "previous-privacy-profile": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Alt+Shift+Left"}, "description": "Switch to previous Privacy Shield profile"}}}