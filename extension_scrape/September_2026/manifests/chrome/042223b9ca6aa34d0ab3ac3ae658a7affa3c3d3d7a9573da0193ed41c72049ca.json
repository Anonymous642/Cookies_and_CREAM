{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickMind Summarizer Pro", "description": "AI-powered summarization, translation, replies, and intelligent form filling for any page.", "version": "2.0.0", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"quickSummarize": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Quick summarize the current context"}, "quickReply": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Generate a quick reply"}, "quickTranslate": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Translate selected or page text"}, "quickFormFill": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Auto fill the current form with AI"}}, "web_accessible_resources": [{"resources": ["content-styles.css"], "matches": ["<all_urls>"]}]}