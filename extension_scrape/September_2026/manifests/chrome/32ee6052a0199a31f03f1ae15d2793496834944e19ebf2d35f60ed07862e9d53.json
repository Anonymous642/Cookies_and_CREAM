{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageCue \u2014 Add Notes to Any Webpage", "description": "Add private notes to webpages and compare jobs, apartments, products, hotels, research pages, and more in one dashboard.", "version": "1.0.3", "short_name": "PageCue", "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "permissions": ["storage", "tabs", "activeTab", "commands", "identity", "alarms"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["logo.png", "icons/*.png"], "matches": ["<all_urls>"]}], "action": {"default_title": "PageCue", "default_icon": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "default_popup": "popup.html"}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "commands": {"toggle_pagecue_note": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle PageCue note panel."}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}