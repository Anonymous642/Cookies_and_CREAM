{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipboard+ \u2013 Clipboard Manager, History & Sync Across Devices", "short_name": "Clipboard+", "description": "Clipboard Manager for Chrome with history, text expander & cloud sync across iOS, Android, and desktop. Never lose copied text.", "version": "1.7.6", "minimum_chrome_version": "116", "homepage_url": "https://clipboardplus.apercallc.com/", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'"}, "theme_color": "#fbfaf8", "action": {"default_title": "Clipboard+", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["storage", "tabs", "clipboardRead", "clipboardWrite", "offscreen", "contextMenus", "alarms"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["extension-observability.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "oauth-callback.html", "oauth-callback.js"], "matches": ["<all_urls>"]}], "commands": {"check-clipboard-now": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Check system clipboard and save if changed"}, "toggle-widget": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Toggle Clipboard Widget for easy pasting"}, "toggle-snippets": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle the snippets (text expander) view"}, "insert-last-snippet": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "descri