{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpeedRead Everywhere", "description": "Read any website one word at a time using numpad speed controls.", "version": "1.0.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SpeedRead Everywhere", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "host_permissions": ["https://play.google.com/books/*", "https://books.google.com/*", "https://books.googleusercontent.com/*"], "permissions": ["activeTab", "scripting", "webNavigation"], "commands": {"quick-start-speedread": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Quick start SpeedRead on the active tab"}}, "background": {"service_worker": "background.js"}}