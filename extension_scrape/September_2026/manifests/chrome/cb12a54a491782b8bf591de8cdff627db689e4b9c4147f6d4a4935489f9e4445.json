{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Review Rule Checker by Remove One Star", "short_name": "Review Rule Checker", "version": "0.2.0", "description": "Marks Trustpilot reviews that may break a Trustpilot rule, and checks any review text you select. Runs locally; sends nothing.", "homepage_url": "https://www.removeonestar.com/tools/chrome-extension", "permissions": ["activeTab", "contextMenus"], "host_permissions": ["https://www.trustpilot.com/*", "https://*.trustpilot.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.trustpilot.com/review/*", "https://*.trustpilot.com/review/*"], "js": ["lib/review-rule-check.js", "content.js"], "css": ["tokens.css", "content.css"], "run_at": "document_idle"}], "action": {"default_title": "Review Rule Checker", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}}