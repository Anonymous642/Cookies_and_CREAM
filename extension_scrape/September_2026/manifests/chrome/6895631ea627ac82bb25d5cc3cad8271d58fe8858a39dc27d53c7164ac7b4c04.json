{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenvibing", "version": "0.5.0", "description": "Capture screenshots from any site and send them to ChatGPT or Claude.", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"service_worker": "background.js"}, "commands": {"capture-and-send": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture and send to AI"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle"}]}