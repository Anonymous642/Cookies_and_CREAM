{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Inserter", "description": "Best-in-class prompt/snippet inserter. Free + Pro: hotstrings, quickbar, chaining, packs, stats.", "version": "1.4.0", "action": {"default_title": "AI Prompt Inserter", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "clipboardWrite", "downloads", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["page.css"], "run_at": "document_idle"}], "commands": {"insert-last-prompt": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Insert last used prompt"}, "insert-favorite-1": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Insert favorite #1"}, "insert-favorite-2": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Insert favorite #2"}, "insert-favorite-3": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Insert favorite #3"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}