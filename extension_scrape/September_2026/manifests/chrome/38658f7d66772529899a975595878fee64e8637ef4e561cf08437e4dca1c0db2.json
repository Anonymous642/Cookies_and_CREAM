{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Feed Ranger Extension", "description": "A browser extension for finding RSS feeds and subscribing to them in Feed Ranger", "version": "1.1.1", "version_name": "1.1.1", "manifest_version": 3, "icons": {"16": "assets/favicon/Icon16.png", "32": "assets/favicon/Icon32.png", "48": "assets/favicon/Icon48.png", "128": "assets/favicon/Icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Find RSS Feeds", "default_popup": "index.html"}, "background": {"service_worker": "./service-worker.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://feedranger.com data:"}, "host_permissions": ["https://feedranger.com/api/v1/*"]}