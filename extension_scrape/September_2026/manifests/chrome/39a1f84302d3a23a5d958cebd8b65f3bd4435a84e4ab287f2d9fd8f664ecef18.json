{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabopsy", "version": "1.0.0", "description": "Find what's killing your browser. Run a tabopsy.", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_title": "Tabopsy", "default_popup": "src/popup/index.html"}, "options_ui": {"page": "src/sessions/index.html", "open_in_tab": true}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms", "system.memory", "scripting", "contextMenus", "clipboardWrite"], "omnibox": {"keyword": "tabopsy"}, "commands": {"archive-window": {"suggested_key": {"default": "Alt+Shift+1", "mac": "Alt+Shift+1"}, "description": "Archive all tabs in this window to Tabopsy"}, "open-saved": {"suggested_key": {"default": "Alt+Shift+2", "mac": "Alt+Shift+2"}, "description": "Open saved tabs page"}}, "incognito": "split", "optional_host_permissions": ["https://*/*", "http://*/*"]}