{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "tabhaven", "version": "1.0.2", "description": "Save and organize tabs to tabhaven.com", "permissions": ["tabs", "contextMenus", "cookies", "notifications", "storage", "alarms", "unlimitedStorage"], "host_permissions": ["https://tabhaven.com/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "omnibox": {"keyword": "th"}, "browser_specific_settings": {"gecko": {"id": "hello@tabhaven.com", "strict_min_version": "109.0"}}, "commands": {"send-to-tabhaven": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current tab to tabhaven"}, "open-search": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open or focus tabhaven search"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}