{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoFill Anywhere", "version": "0.0.4", "description": "AutoFill Anywhere lets you save and re-use your form data. Auto-fill your forms with one click using a clean side panel.", "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["<all_urls>", "file:///*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open AutoFill Anywhere"}, "icons": {"128": "icons/image128.png"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content.js"], "run_at": "document_idle"}]}