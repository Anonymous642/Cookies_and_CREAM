{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "tint. \u2014 themes for YouTube", "version": "0.6.0", "description": "Eighteen expressive YouTube palettes with colored titles, readable text, and an easy-to-browse theme gallery.", "permissions": ["storage", "scripting"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "tint."}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "run_at": "document_start", "all_frames": true, "js": ["src/resolve.js", "src/custom-content.js"]}], "web_accessible_resources": [{"resources": ["src/css/themes/*.css", "src/custom.js", "src/themes/index.json"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*"]}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "minimum_chrome_version": "120", "commands": {"toggle-theme": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "Toggle tint. on or off"}}}