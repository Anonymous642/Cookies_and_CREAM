{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Story Prompt Helper for ChatGPT & Gemini", "version": "1.0.1", "description": "Quickly generate story prompts and auto-insert them into ChatGPT and Gemini for faster story writing.", "author": "Story Generator Team", "homepage_url": "https://github.com/yourusername/story-generator", "permissions": ["activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"], "action": {"default_popup": "index.html", "default_title": "Story Prompt Helper for ChatGPT & Gemini", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Story Generator popup"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"]}]}