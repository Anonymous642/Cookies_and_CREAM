{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IntentMaster - Auto Clicker & Smart Reload", "version": "3.0", "author": "Cinnerce Solutions, London", "description": "Auto-Click, Smart Reload &  Nav. Developed by Cinnerce.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "tabs", "contextMenus"], "commands": {"toggle-safe-nav": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Safe Nav"}, "toggle-auto-click": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle Auto-Click"}, "trigger-reload": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Hard Reload Page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["tracker.js"], "css": ["overlay.css"]}]}