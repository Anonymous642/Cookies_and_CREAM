{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Odoo Aliexpress Importer", "version": "1.2.0", "description": "This extension is used to import product from aliexpress to odoo store.", "icons": {"16": "resources/image/icon16.png", "48": "resources/image/icon48.png", "128": "resources/image/icon128.png"}, "action": {"default_icon": "resources/image/icon-disabled.png", "default_popup": "resources/html/disabledPopUp.html"}, "background": {"service_worker": "resources/js/background.js"}, "content_scripts": [{"matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"], "js": ["resources/js/jquery-3.3.1.min.js", "resources/js/content.js"], "css": ["resources/css/content.css"]}], "permissions": ["tabs", "activeTab"], "web_accessible_resources": [{"resources": ["resources/js/*.js", "resources/image/*.png", "resources/image/*.gif"], "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"]}]}