{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobAI Helper - Job Assistant", "version": "1.0.0", "description": "Generate cover letter and resume bullets for your job application", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "http://localhost:3000/*", "https://www.jobaihelp.com/*", "https://jobaihelp.com/*", "https://*.jobaihelp.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["environment.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "JobAI Helper"}, "web_accessible_resources": [{"resources": ["popup.html", "results.html", "results.js", "styles.css", "icons/*"], "matches": ["https://www.linkedin.com/*", "<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}