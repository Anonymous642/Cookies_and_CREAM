{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoSpeech - ChatGPT Voice Saver", "version": "1.0.1", "description": "Auto input text and capture Direct MP3 Audio from ChatGPT API.", "permissions": ["activeTab", "storage", "sidePanel", "tabs"], "host_permissions": ["*://chatgpt.com/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Open AutoSpeech", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["*://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["hook.js", "voice/*.mp3"], "matches": ["*://chatgpt.com/*"]}]}