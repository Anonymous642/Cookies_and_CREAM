{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoorLock \u2014 Short-form video blocker", "description": "Reclaim your attention. Blocks YouTube Shorts, Instagram Reels, TikTok, and Facebook Reels before they load.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/noorkin-dev/noorlock-browser", "minimum_chrome_version": "108", "permissions": ["storage", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*"]}], "action": {"default_title": "NoorLock", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "run_at": "document_start", "js": ["content-scripts/facebook.js"]}, {"matches": ["*://*.instagram.com/*"], "run_at": "document_start", "js": ["content-scripts/instagram.js"]}, {"matches": ["*://*.tiktok.com/*"], "run_at": "document_start", "js": ["content-scripts/tiktok.js"]}, {"matches": ["*://*.youtube.com/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/youtube.js"]}]}