{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Snap - QR code scanner for any page", "version": "1.0.0", "description": "Find QR codes on the page you are viewing, or snip any region of the screen, and read, copy or open the value.", "homepage_url": "https://github.com/Maacaa0/QR_snap", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "QR Snap", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "contextMenus", "storage", "clipboardWrite"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Open QR Snap"}, "snip-region": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Snip a screen region and read its QR code"}}}