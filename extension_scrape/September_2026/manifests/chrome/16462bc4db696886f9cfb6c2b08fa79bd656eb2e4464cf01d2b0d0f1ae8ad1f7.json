{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loupewire: HTTP Request Inspector, Header Editor and Masked HAR Export", "short_name": "Loupewire", "version": "1.1.0", "default_locale": "en", "description": "Capture traffic from every tab in one window, apply header rules, mask secrets and export HAR. All on-device, no accounts.", "author": "Tung Dang", "homepage_url": "https://loupewire.com/", "minimum_chrome_version": "122", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Open Loupewire", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "background": {"service_worker": "js/background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Open Loupewire, or bring the tracker window to the front"}}, "permissions": ["declarativeNetRequest", "webRequest", "storage"], "host_permissions": ["<all_urls>"]}