{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Genix Linkedin", "version": "1.0.0", "description": "Seamlessly extract LinkedIn profile data and sync it to Genix System in one click with the LinkedIn to Genix Data Sync extension.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "Genix Linkedin", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage", "tabs", "contextMenus", "sidePanel"], "side_panel": {"default_path": "popup.html"}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.linkedin.com/in/*"], "js": ["contentScript.js"], "run_at": "document_idle"}]}