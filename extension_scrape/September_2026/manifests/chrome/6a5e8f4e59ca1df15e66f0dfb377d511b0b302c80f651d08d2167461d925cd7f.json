{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Code Reviewer", "version": "1.0.0", "description": "Review GitLab merge request diffs from a Chrome side panel.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["activeTab", "sidePanel", "scripting", "tabs", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "AI Code Reviewer", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}