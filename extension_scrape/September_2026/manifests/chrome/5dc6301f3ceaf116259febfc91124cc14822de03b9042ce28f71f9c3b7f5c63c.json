{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Stash", "description": "Group, archive, and recall tabs automatically. Clean tabs, clear mind \u2014 with optional AI-powered smart grouping.", "version": "0.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "version_name": "0.0.2-beta", "permissions": ["tabs", "tabGroups", "storage", "alarms", "unlimitedStorage"], "host_permissions": ["https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"], "commands": {"open-archive": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Open the archive page"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Tab Stash", "default_popup": "popup.html"}}