{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Translext \u2014 Live Audio Translator & Captions", "description": "Live translator for video calls, webinars and streams. Real-time captions and spoken translation in 70+ languages.", "version": "0.1.8", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "identity"], "host_permissions": ["https://api.translext.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_title": "Translext", "default_popup": "popup.html"}, "externally_connectable": {"matches": ["https://translext.com/*"]}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}