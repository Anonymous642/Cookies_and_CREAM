{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leif List - Sustainability Scores", "version": "2.6", "description": "See a brand's sustainability score while you shop on Amazon and partner brand sites. Click the Leif icon to check any product.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Leif List - Sustainability Scores", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["https://www.amazon.com/*", "https://*.amazon.com/*", "https://firestore.googleapis.com/*", "https://us-central1-leif-extension.cloudfunctions.net/*", "https://*.algolia.net/*", "https://*.algolianet.com/*"], "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://*.amazon.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles/content.css", "assets/leiflist-vertical-white.png"], "matches": ["https://*/*"]}]}