{"update_url": "https://clients2.google.com/service/update2/crx", "$schema": "https://json.schemastore.org/chrome-manifest", "manifest_version": 3, "name": "Screenshot 4K YouTube", "version": "1.2.0", "description": "One-click 4K YouTube screenshots.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "src/options/index.html", "action": {"default_title": "Screenshot 4K YouTube"}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Take a screenshot"}, "copy-to-clipboard": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Copy screenshot to clipboard"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/content/page.js"], "css": ["src/content/style.css"], "run_at": "document_idle"}], "permissions": ["storage"]}