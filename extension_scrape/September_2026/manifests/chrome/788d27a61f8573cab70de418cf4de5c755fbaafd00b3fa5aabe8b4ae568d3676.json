{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ComuSearch - Community Search Tool for Google", "version": "0.1.1", "description": "Enable the 'ComuSearch' toggle to search only within selected communities on Google.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.google.com/search*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.google.com/search*"], "js": ["content.js"], "run_at": "document_end"}]}