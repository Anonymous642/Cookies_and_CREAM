{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Perfect Demo Screen Recorder", "version": "1.7.0", "description": "Record your screen, microphone/system audio, and on-page interactions to create narrated Perfect Demo product demos.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "activeTab", "tabCapture", "scripting", "storage", "alarms"], "host_permissions": ["https://*/*"], "background": {"service_worker": "src/background/background.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Perfect Demo Recorder"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Start or stop a Perfect Demo recording"}, "mark-chapter": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Mark a new chapter/step (works even outside the browser)"}}, "content_scripts": [{"matches": ["https://app.perfectdemo.ai/*"], "js": ["src/config.js", "src/shared/wire-protocol.js", "src/content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/page-hook.js"], "matches": ["<all_urls>"]}]}