{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CSSBite - Select & Extract Clean Code", "version": "1.1.0", "description": "Extract website components into clean, reusable code in multiple formats like HTML, React, Vue, Tailwind, and more.", "permissions": ["activeTab", "scripting", "sidePanel", "storage"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Activate CSSBite selection mode"}}, "web_accessible_resources": [{"resources": ["content/selector.css"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}