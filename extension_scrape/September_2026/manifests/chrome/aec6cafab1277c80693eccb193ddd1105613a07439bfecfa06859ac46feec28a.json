{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "2Chat: Calls & WhatsApp conversations inside HubSpot", "version": "1.3.4", "description": "Start phone calls and chats on WhatsApp with your customers using 2Chat connected to your HubSpot account.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:* http://127.0.0.1:*; object-src 'self'"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://*.hubspot.com/*"], "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.hubspot.com/contacts/*/record/*"], "css": ["content.css"], "js": ["content.js"]}], "externally_connectable": {"matches": ["https://*.2chat.io/*", "https://*.2chat.co/*", "https://*.2chat.com/*"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["welcome.html", "welcome.css", "welcome.js", "icons/*"], "matches": ["<all_urls>"]}]}