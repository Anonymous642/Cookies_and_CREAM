{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CRM Pilot - AI Sales Assistant", "version": "1.5.1", "description": "Log Gmail, calls & LinkedIn to HubSpot/Pipedrive in 1 click. AI summaries, voice notes & a sales copilot \u2014 zero typing.", "permissions": ["activeTab", "storage", "sidePanel", "contextMenus", "scripting"], "host_permissions": ["https://*.hubspot.com/*", "https://*.google.com/*", "https://*.linkedin.com/*", "https://*.supabase.co/*", "https://crmpilot.pages.dev/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidebar.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.hubspot.com/*", "https://mail.google.com/*", "https://calendar.google.com/*", "https://*.linkedin.com/*", "http://localhost:8080/*"], "js": ["content.js"], "css": ["content.css"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "options_page": "settings.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}