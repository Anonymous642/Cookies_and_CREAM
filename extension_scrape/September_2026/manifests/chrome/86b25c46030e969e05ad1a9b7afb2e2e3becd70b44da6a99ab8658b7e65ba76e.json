{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClearCart: Hide Junk on Amazon & Walmart", "version": "1.12.0", "description": "Filters gibberish no-name brands and dropship junk out of Amazon and Walmart search results. 100% local \u00e2\u20ac\u201d no data collected.", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.amazon.com/s*", "https://*.amazon.com/dp/*", "https://*.amazon.com/*/dp/*", "https://*.amazon.com/gp/product/*", "https://*.amazon.ca/s*", "https://*.amazon.ca/dp/*", "https://*.amazon.ca/*/dp/*", "https://*.amazon.ca/gp/product/*", "https://*.amazon.co.uk/s*", "https://*.amazon.co.uk/dp/*", "https://*.amazon.co.uk/*/dp/*", "https://*.amazon.co.uk/gp/product/*", "https://*.amazon.com.au/s*", "https://*.amazon.com.au/dp/*", "https://*.amazon.com.au/*/dp/*", "https://*.amazon.com.au/gp/product/*", "https://*.amazon.in/s*", "https://*.amazon.in/dp/*", "https://*.amazon.in/*/dp/*", "https://*.amazon.in/gp/product/*", "https://www.walmart.com/search*", "https://www.walmart.com/ip/*", "https://extensionpay.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/s*", "https://*.amazon.ca/s*", "https://*.amazon.co.uk/s*", "https://*.amazon.com.au/s*", "https://*.amazon.in/s*"], "js": ["src/selectors.js", "src/config.js", "src/scoring.js", "src/review-prompt.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.com/dp/*", "https://*.amazon.com/*/dp/*", "https://*.amazon.com/gp/product/*", "https://*.amazon.ca/dp/*", "https://*.amazon.ca/*/dp/*", "https://*.amazon.ca/gp/product/*", "https://*.amazon.co.uk/dp/*", "https://*.amazon.co.uk/*/dp/*", "https://*.amazon.co.uk/gp/product/*", "https://*.amazon.com.au/dp/*", "https://*.amazon.com.au/*/dp/*", "https://*.amazon.com.au/gp/product/*", "https://*.amazon.in/dp/*", "https://*.amazon.in/*/dp/*", "https://*.amazon.in/gp/produc