{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Drive AI", "version": "1.0.2", "description": "AI-powered file organization for Google Drive, OneDrive, and more", "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["https://drive.google.com/*", "https://service.thedrive.ai/*", "https://onedrive.live.com/*", "https://*.sharepoint.com/*", "https://www.dropbox.com/*", "https://dropbox.com/*", "http://localhost:3001/*"], "side_panel": {"default_path": "main.html"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://service.thedrive.ai http://localhost:3001"}, "externally_connectable": {"matches": ["http://localhost:3000/*", "https://*.thedrive.ai/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}