{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemoryWeave", "version": "3.0.0", "version_name": "3.0.0 - Intelligence Update", "short_name": "MemoryWeave", "description": "Compress AI conversations by 80-90% while preserving context. Never lose conversation history. Secure compression. ChatGPT & more.", "homepage_url": "https://harmoniqos.com/memoryweave", "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "alarms", "contextMenus", "downloads"], "optional_permissions": ["notifications"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://bard.google.com/*", "https://gemini.google.com/*", "https://poe.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://bard.google.com/*", "https://gemini.google.com/*", "https://poe.com/*"], "js": ["detector/platform-detector.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content/providers/chatgpt/chatgpt-injector.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://claude.ai/*"], "js": ["content/providers/claude/claude-injector.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["ExtPay.js", "content/providers/chatgpt/*", "content/providers/claude/*", "content/providers/gemini/*", "content/providers/poe/*", "content/providers/shared/*", "content/providers/shared/storage/*", "content/providers/shared/core/*", "content/providers/shared/ui/*", "content/providers/shared/styles/*", "content/shared/*", "content/shared/storage/*", "content/shared/core/*", "content/providers/base-provider.js", "wasm/*", "manager/*", "assets/*", "po