{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Novera - Block Mindless Scrolling", "short_name": "Novera", "version": "1.0.0", "description": "Remove algorithm-driven distractions while preserving the utility of websites.", "permissions": ["storage", "activeTab", "alarms"], "background": {"service_worker": "dist/background.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Novera Settings", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+A", "mac": "MacCtrl+A"}, "description": "Open Novera Settings"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"], "css": ["src/sites/youtube/shield.css", "src/sites/instagram/shield.css"], "js": ["dist/content.js"], "run_at": "document_start"}], "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/icons/*.png"], "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"]}]}