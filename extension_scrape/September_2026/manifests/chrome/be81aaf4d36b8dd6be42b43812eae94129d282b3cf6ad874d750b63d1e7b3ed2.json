{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OmniBrief: AI Summarizer, Read-It-Later & Offline Search", "short_name": "OmniBrief", "version": "1.0.0", "description": "AI summarizer & read-it-later extension. Save pages, get instant on-device AI summaries, and search your library \u2014 private, offline.", "minimum_chrome_version": "138", "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "tabGroups", "scripting", "contextMenus", "offscreen", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "ui/sidepanel.html"}, "action": {"default_title": "Open OmniBrief", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"brief-current-tab": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open OmniBrief and summarize the current tab"}, "read-latest-brief": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Read the most recent brief aloud"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}