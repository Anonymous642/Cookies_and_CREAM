{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InstaLingo - Instagram DM Translator", "version": "1.0.0", "description": "Auto-translate Instagram DM messages using multiple translation engines. Supports Google Translate, LibreTranslate, and MyMemory.", "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://translate.googleapis.com/*", "https://libretranslate.com/*", "https://api.mymemory.translated.net/*", "https://social-translators.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["services/storage.js", "services/translator.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.instagram.com/*"]}]}