{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MyTextExpander \u2014 Text Expander & Snippets", "description": "Save reusable text snippets and insert them anywhere. Local-only, private, offline.", "version": "1.0.0", "short_name": "MyTextExpander", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "minimum_chrome_version": "120", "permissions": ["storage", "sidePanel", "contextMenus", "activeTab"], "action": {"default_title": "Open MyTextExpander"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open-snippet-search": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Open snippet search"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["content-scripts/content.js"], "match_origin_as_fallback": true}]}