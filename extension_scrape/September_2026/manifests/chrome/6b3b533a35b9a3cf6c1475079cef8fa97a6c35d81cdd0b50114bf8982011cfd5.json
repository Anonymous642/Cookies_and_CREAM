{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nookspan \u2014 Property maps for Facebook groups", "version": "3.0.1", "description": "Find your place in the feed. Map, filter and save property listings. One group free; unlimited groups with a 30-day pass.", "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["https://www.facebook.com/*", "https://*.fbcdn.net/*", "https://tile.openstreetmap.org/*", "https://nookspan.app/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "Nookspan", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["graphql-bridge-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.facebook.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "short_name": "Nookspan", "minimum_chrome_version": "120", "externally_connectable": {"matches": ["https://nookspan.app/*"]}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "web_accessible_resources": [{"resources": ["map-worker-host.html"], "matches": ["https://www.facebook.com/*"]}]}