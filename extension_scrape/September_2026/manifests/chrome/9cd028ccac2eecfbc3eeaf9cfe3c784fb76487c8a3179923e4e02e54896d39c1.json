{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapQuery AI", "short_name": "SnapQuery", "version": "1.0.0", "description": "AI-powered image analysis extension. Analyze images with AI insights. All image collection is user-initiated.", "homepage_url": "https://snapquery.app", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "contextMenus"], "host_permissions": ["https://snapquery.app/*", "https://api.snapquery.app/*", "http://localhost:3000/*", "http://localhost:5173/*", "*://*/*"], "content_scripts": [{"matches": ["http://localhost:5173/*", "https://snapquery.app/*", "https://*.snapquery.app/*"], "js": ["websiteBridge.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http:"}, "web_accessible_resources": [{"resources": ["pages/history/*", "pages/chat/*", "assets/*", "js/*"], "matches": ["<all_urls>"]}]}