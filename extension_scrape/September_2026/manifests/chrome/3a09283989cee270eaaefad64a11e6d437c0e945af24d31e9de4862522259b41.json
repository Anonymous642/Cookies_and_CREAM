{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GPT Project Switcher", "version": "1.1.1", "description": "Enhanced ChatGPT project navigation with searchable modal and alphabetical sorting", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "commands": {"toggle_project_switcher": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Command+J"}, "description": "Jump to GPT Project"}, "move_project_switcher": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+M"}, "description": "Move current chat to GPT Project"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "GPT Project Switcher", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["icon48.png", "icon128.png", "popup.html", "popup.css", "popup.js"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}