{"manifest_version": 3, "name": "Dediseedbox Torrent Uploader", "version": "0.1.5", "description": "This extension will recognise a .torrent file download and upload the .torrent file to a remote server running the rutorrent webui", "background": {"service_worker": "data/background.js"}, "content_scripts": [{"all_frames": true, "js": ["data/content.js"], "matches": ["*://*/*"], "run_at": "document_end"}], "icons": {"16": "data/img/icon16.png", "48": "data/img/icon48.png", "128": "data/img/icon128.png"}, "action": {"default_icon": "data/img/icon16.png"}, "options_page": "data/html/options.html", "permissions": ["contextMenus", "notifications", "storage", "tabs", "windows"], "host_permissions": ["*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "key": "", "update_url": "https://clients2.google.com/service/update2/crx"}