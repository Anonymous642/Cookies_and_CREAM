{"manifest_version": 3, "name": "EazyNet Workspace", "version": "2.1.0", "description": "Fast tab grouping, sessions, search, and workspace tools\u2014runs locally in your browser with no sign-in required.", "update_url": "https://clients2.google.com/service/update2/crx", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "resources/Logo_128x128.png", "48": "resources/Logo_128x128.png", "128": "resources/Logo_128x128.png"}, "permissions": ["tabs", "tabGroups", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/js/content.js"]}], "externally_connectable": {"matches": ["https://*.chromiumapp.org/*", "https://*.eazynet.app/*", "https://eazynet.app/*"]}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "resources/Logo_128x128.png", "48": "resources/Logo_128x128.png", "128": "resources/Logo_128x128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open EazyNet Workspace"}, "group_tabs": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Group all open tabs"}, "ungroup_tabs": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ungroup all open tabs"}}, "background": {"service_worker": "src/js/background.js", "type": "module"}}