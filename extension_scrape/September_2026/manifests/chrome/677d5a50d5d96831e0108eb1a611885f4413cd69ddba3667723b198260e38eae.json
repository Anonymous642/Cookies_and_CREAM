{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Cleanser - Focus & Productivity", "version": "1.0.0", "description": "Remove distractions from social media. Block suggested posts, autoplay videos, and sponsored content. Stay focused!", "permissions": ["alarms", "declarativeNetRequest", "storage"], "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.linkedin.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.linkedin.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "social_rules", "enabled": true, "path": "rules/social_rules.json"}, {"id": "amazon_rules", "enabled": true, "path": "rules/amazon_rules.json"}]}}