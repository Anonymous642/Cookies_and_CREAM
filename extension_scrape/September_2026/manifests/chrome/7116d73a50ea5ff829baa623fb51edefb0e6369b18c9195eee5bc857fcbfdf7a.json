{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Audibly", "version": "1.3", "description": "Turn any webpage into a podcast. Smart AI reader with clean text extraction and voice cloning.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"toggle-playback": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Play/Pause Speech"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Audibly"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["Readability.js", "content.js"], "run_at": "document_idle"}]}