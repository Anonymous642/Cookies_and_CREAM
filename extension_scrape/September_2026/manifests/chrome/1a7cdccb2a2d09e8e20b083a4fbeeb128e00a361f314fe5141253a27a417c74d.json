{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Infact \u2014 AI Fact Checker", "version": "1.1.0", "description": "Instant AI-powered fact-checking. Select text, check YouTube videos, or verify articles.", "permissions": ["sidePanel", "contextMenus", "activeTab", "storage", "alarms"], "host_permissions": ["https://api.factly.fyi/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "side-panel.html"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Open Infact popup"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Open Infact side panel"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["analytics.js", "utils.js", "content-script.js"], "css": ["content-script.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*/*", "http://*/*"]}]}