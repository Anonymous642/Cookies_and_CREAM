{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roamlings", "short_name": "Roamlings", "description": "Creatures that walk, climb, dance, ride each other and chase treats on your pages. Import custom Shimeji image sets too.", "version": "1.1.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Roamlings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["characters.js", "content.js"], "run_at": "document_idle"}], "commands": {"toggle-roamlings": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Hide or show everyone"}, "spawn-random": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Invite a random friend"}, "toss-treat": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Toss treats onto the page"}}}