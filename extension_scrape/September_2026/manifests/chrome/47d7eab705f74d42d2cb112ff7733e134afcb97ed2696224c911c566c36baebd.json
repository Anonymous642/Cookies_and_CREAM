{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZenHighlight", "description": "Highlight in one drag. Optional sync to your company-os second brain.", "version": "2.4.2", "short_name": "ZenHighlight", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "contextMenus", "activeTab", "sidePanel", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["sidepanel.html"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "action": {"default_title": "Turn the highlighter on"}, "commands": {"toggle-highlighter": {"suggested_key": {"default": "Alt+H"}, "description": "Highlighter on/off (while on, every drag highlights)"}, "open-panel": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Open the reading panel (and save the page)"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/history.js"], "world": "MAIN"}]}