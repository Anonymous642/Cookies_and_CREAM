{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VendScan Assistant", "description": "Helps transfer product details from VendScan to Facebook Marketplace with user confirmation.", "version": "0.3.5", "action": {"default_title": "VendScan Assistant", "default_popup": "popup.html"}, "icons": {"16": "logo_16.png", "48": "logo_48.png", "96": "logo_96.png", "128": "logo_128.png"}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://www.vendscan.app/*", "https://vendscan.app/*", "https://www.facebook.com/marketplace/create/item/*"], "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://www.vendscan.app/*", "https://vendscan.app/*"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"open_fb_creator": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open FB Marketplace creator with last item"}}}