{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenyMate - Screen & Meet Smart Recorder", "version": "1.0.0", "description": "Smart screen recorder for Google Meet. Automatically mutes mic recording when Meet is muted and saves recordings to device.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ScreenyMate Recorder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "downloads", "tabs", "activeTab", "tabCapture"], "host_permissions": ["https://meet.google.com/*"], "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content/meet-detector.js", "content/meet-widget.js"], "css": ["content/meet-widget.css"], "run_at": "document_end"}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Start / Stop Screen Recording"}}}