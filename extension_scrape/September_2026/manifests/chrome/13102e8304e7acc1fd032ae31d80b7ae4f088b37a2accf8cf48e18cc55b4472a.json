{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StepSnap", "description": "Do a task once \u2014 get a step-by-step guide with screenshots. Captures one shot per click, not video. 100% on-device.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "optional_host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "StepSnap", "default_popup": "popup.html"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+R"}, "description": "Start/finish capturing steps (current site)"}}, "background": {"service_worker": "background.js"}, "content_scripts": []}