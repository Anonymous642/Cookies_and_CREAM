{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mockeys - Mock Typing Extension", "version": "1.0.1", "description": "Type naturally on camera while pre-written text appears instead of your keystrokes. Perfect for video recording!", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Mockeys - Configure Mock Text"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-script-1": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle Script 1"}, "toggle-script-2": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Toggle Script 2"}, "toggle-script-3": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle Script 3"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}