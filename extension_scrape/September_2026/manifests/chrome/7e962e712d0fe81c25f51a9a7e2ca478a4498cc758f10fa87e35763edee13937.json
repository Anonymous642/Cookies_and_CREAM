{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TagMyFav", "description": "TagMyFav is an awesome bookmark solution to manage your browser links and sync with multiple apps on Microsoft 365 platform.", "version": "0.1.7", "background": {"service_worker": "background.js"}, "action": {"default_popup": "index.html", "default_icon": "img/32X32.png", "default_title": "TagMyFav"}, "externally_connectable": {"matches": ["https://app.tagmyfav.com/*"]}, "web_accessible_resources": [{"resources": ["images/*.png", "images/*.svg"], "matches": ["<all_urls>"]}], "icons": {"32": "img/32X32.png"}, "permissions": ["tabs", "activeTab", "contextMenus", "bookmarks", "storage"], "host_permissions": ["https://app.tagmyfav.com/*"]}