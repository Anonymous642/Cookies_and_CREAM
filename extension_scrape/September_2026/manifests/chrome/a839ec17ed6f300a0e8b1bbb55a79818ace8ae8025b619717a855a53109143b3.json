{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Learn Languages While You Browse \u2013 LingoPop", "description": "Learn foreign-language vocabulary with quick pop quizzes while you browse. Spaced repetition in 6 languages, no flashcards.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "activeTab"], "host_permissions": ["https://lingopop.istos.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "LingoPop", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}