{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Magic Docs - Aesthetic Google Docs Themes", "version": "6.0.0", "description": "Transform Google Docs with 112+ aesthetic themes, dark mode, animated backgrounds & particle effects \u2014 free & private.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://docs.google.com/document/d/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/document/d/*"], "js": ["content.js"], "css": ["styles/inject.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Magic Docs Theme Studio", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon16.png", "128": "assets/icon16.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon16.png", "128": "assets/icon16.png"}, "web_accessible_resources": [{"resources": ["styles/inject.css", "assets/*"], "matches": ["https://docs.google.com/*"]}]}