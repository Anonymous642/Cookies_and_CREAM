{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Remote Workspace Meet Framer", "version": "1.1.0", "description": "Enable embedding and auto-joining Google Meet within remote-workplace.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://meet.google.com/*", "https://kalviumlabs.github.io/remote-workplace/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "net_rules.json"}]}, "content_scripts": [{"matches": ["*://meet.google.com/*"], "js": ["meet-autojoin.js"], "run_at": "document_idle", "all_frames": true}]}