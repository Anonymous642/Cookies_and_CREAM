{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shown \u2014 Screenshot & Annotate, Local Only", "version": "0.1.2", "description": "Capture, annotate, and redact screenshots into a local library. Nothing is uploaded \u2014 no account, no server, ever.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "action": {"default_title": "Shown", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture a region"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible page"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture the full page"}}}