{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PixelCore \u2014 Right-click Upload", "version": "3.0.0", "version_name": "3.0.0", "description": "Right-click any image, video, or link to upload to PixelCore. Plus screenshot capture, URL paste, and bulk page-image upload.", "minimum_chrome_version": "114", "permissions": ["contextMenus", "storage", "notifications", "clipboardWrite", "offscreen", "activeTab", "scripting", "tabs"], "host_permissions": ["https://pixelcore.co.za/*", "https://www.pixelcore.co.za/*", "https://api.pixelcore.co.za/*"], "optional_host_permissions": ["https://*.pages.dev/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "action": {"default_title": "PixelCore \u2014 upload here", "default_popup": "options.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open PixelCore (upload a file / paste URL / screenshot)"}, "screenshot-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Screenshot the current tab and upload to PixelCore"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}