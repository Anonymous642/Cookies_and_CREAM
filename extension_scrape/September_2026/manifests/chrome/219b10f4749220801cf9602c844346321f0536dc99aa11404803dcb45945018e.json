{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Capture Free Screen Recorder & Screenshot (4K, No Watermark)", "short_name": "Capture", "version": "0.1.0", "description": "Record your screen in 4K and capture full-page screenshots \u2014 free, no watermark, no sign-up. Tab, desktop & webcam recording.", "minimum_chrome_version": "116", "action": {"default_title": "Capture \u2014 Screen Recorder & Screenshot", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options/options.html", "permissions": ["activeTab", "tabs", "tabCapture", "desktopCapture", "scripting", "storage", "downloads", "downloads.open", "offscreen", "contextMenus", "clipboardWrite", "notifications", "debugger"], "host_permissions": ["<all_urls>"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture region"}, "toggle-record": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start/stop tab recording"}, "capture-element": {"description": "Pick an element to capture"}, "open-library": {"description": "Open capture library"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["shared/ui.css", "icons/*"], "matches": ["<all_urls>"]}]}