{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MakerFlow: Etsy Production Tracking & Workflow Stages", "version": "2.5", "description": "Simple item production tracking for Etsy sellers. Track production stages right in your dashboard. Never miss a deadline again.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["scripting", "storage", "tabs"], "host_permissions": ["https://www.etsy.com/*", "https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://www.etsy.com/your/orders/sold*", "https://www.etsy.com/your/orders*"], "js": ["ExtPay.js", "utils.js", "content.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["makerflow_logo_xp.png", "gear.svg", "welcome.html", "welcome.js", "icon128.png"], "matches": ["https://www.etsy.com/*"]}]}