{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Repo Analyzer - Repo Intelligence", "short_name": "GitHub Repo Analyzer", "version": "1.1.0", "description": "GitHub repo health scoring with saved-repo bookmarks, snapshot trends over time, and similar-repo suggestions. By Cloud Geeks.", "author": "Cloud Geeks", "homepage_url": "https://github-repo-analyzer.cchk.info", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://github.com/*", "https://api.github.com/*"], "action": {"default_popup": "popup.html", "default_title": "GitHub Repo Analyzer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["lib/githubParser.js", "lib/repoScorer.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}