{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nimbli - Url Shortener", "description": "Nimbli: Create shareable short links. Up to 100 links. Free!", "version": "0.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.nimbli.app/*", "http://localhost/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open Nimbli URL Shortener"}}, "externally_connectable": {"matches": ["https://*.nimbli.app/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}}