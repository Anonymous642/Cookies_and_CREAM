{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EcomXray \u2014 Product Analytics", "version": "1.2.0", "description": "Shows cost price, gross margin, units sold and restock recommendations on Shopify product pages.", "permissions": ["storage", "scripting"], "host_permissions": ["https://app.ecomos.dk/*"], "optional_host_permissions": ["https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "EcomXray", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://*.myshopify.com/products/*", "https://*.shopifypreview.com/products*", "https://*.shopifypreview.com/products_preview*"], "run_at": "document_idle", "js": ["content.js"]}]}