{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice Sell Ai", "short_name": "Voice Sell Ai", "version": "1.6.1", "description": "Import LinkedIn and TrackHS contacts to VoiceSell AI with one click. Launch automated voice campaigns for sales outreach.", "author": "VoiceSell AI", "homepage_url": "https://voicesellai.com", "permissions": ["activeTab", "storage", "scripting", "notifications"], "host_permissions": ["https://*.linkedin.com/*", "https://*.voicesellai.com/*", "https://*.trackhs.com/*", "https://*.onrender.com/*"], "action": {"default_popup": "popup.html", "default_title": "Voice Sell Ai", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.trackhs.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://*.linkedin.com/*", "https://*.trackhs.com/*"]}], "commands": {"scan-contacts": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Scan current page for contacts"}}}