{"update_url": "https://clients2.google.com/service/update2/crx", "name": "U.GG Champion Builds - Quick Search for League of Legends", "short_name": "U.GG Builds Quick Search by Eloking", "icons": {"16": "img/logo.png", "48": "img/logo.png", "128": "img/logo.png"}, "version": "1.0.1", "manifest_version": 3, "homepage_url": "https://eloking.com", "description": "Instant access to League of Legends champion builds from U.GG. Search any champion with partial names and get builds instantly.", "action": {"default_icon": "img/logo.png", "default_title": "Search Champion Builds", "default_popup": "popup.html"}, "background": {"service_worker": "scripts/background.js"}, "host_permissions": ["https://u.gg/*"], "content_scripts": [{"matches": ["https://u.gg/*"], "css": ["style.css"], "js": ["scripts/main.js"]}], "web_accessible_resources": [{"resources": ["img/logo.png"], "matches": ["<all_urls>"]}], "permissions": ["activeTab", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Champion Build Search"}}}