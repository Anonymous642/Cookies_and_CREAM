{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobCred \u2013 Job Portal Credential Isolation", "version": "0.7.0", "minimum_chrome_version": "120.0", "description": "Prevents credential overwrites on Workday, SuccessFactors, BambooHR and other job portals.", "browser_specific_settings": {"gecko": {"id": "jobcred@warrior-rpt", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "webNavigation"], "host_permissions": ["*://*.myworkdayjobs.com/*", "*://*.successfactors.com/*", "*://*.successfactors.eu/*", "*://*.sapsf.com/*", "*://*.hr.cloud.sap/*", "*://*.bamboohr.com/*", "*://*.bamboohr.co.uk/*", "*://*/*career*", "*://*/*jobs*"], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "background": {"service_worker": "serviceWorker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.myworkdayjobs.com/*", "*://*.successfactors.com/*", "*://*.successfactors.eu/*", "*://*.sapsf.com/*", "*://*.hr.cloud.sap/*", "*://*.bamboohr.com/*", "*://*.bamboohr.co.uk/*", "*://*/*career*", "*://*/*jobs*"], "js": ["contentScript.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["*.js"], "matches": ["<all_urls>"]}]}