{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "tabMaster", "version": "1000", "description": "Save RAM. Become Master", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Option+Shift+M"}, "description": "Master tabs"}, "stop-tab": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Option+Shift+T"}, "description": "Stop tab"}, "stop-window": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Option+Shift+W"}, "description": "Stop window"}, "stop-other-windows": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Option+Shift+O"}, "description": "Stop other windows"}}}