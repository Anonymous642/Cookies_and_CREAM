{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "All Urls Copy&Paste", "version": "1.0", "description": "Copy all tab URLs from current window and open URLs from clipboard in bulk", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "activeTab", "clipboardRead", "clipboardWrite", "notifications", "scripting", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "All Urls Copy&Paste", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"copy-all-urls": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Copy all tab URLs from current window"}, "open-urls-from-clipboard": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Open URLs from clipboard in bulk"}}}