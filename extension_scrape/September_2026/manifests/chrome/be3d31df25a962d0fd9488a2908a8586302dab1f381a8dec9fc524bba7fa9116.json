{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumeo", "description": "Your LinkedIn content in 30 minutes? Lumeo takes care of it", "version": "1.0.1", "action": {"default_popup": "popup.html", "default_title": "Lumeo", "default_icon": "icon.png"}, "permissions": ["cookies", "storage"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://lumeo.me/*"], "js": ["contentScript.js"], "run_at": "document_end"}], "host_permissions": ["http://lumeo.me/*", "http://www.lumeo.me/*", "https://linkedin.com/*", "https://www.linkedin.com/*"]}