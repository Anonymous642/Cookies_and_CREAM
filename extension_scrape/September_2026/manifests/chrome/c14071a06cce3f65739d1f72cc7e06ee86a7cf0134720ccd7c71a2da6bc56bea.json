{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabKeeper \u2013 Tab Manager & Duplicate Cleaner", "short_name": "TabKeeper", "version": "1.2.0", "description": "Protects tabs you're still working on. Auto-cleans the rest. Merges duplicates.", "permissions": ["tabs", "storage", "alarms"], "action": {"default_popup": "popup.html", "default_title": "TabKeeper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-pin-active-work": {"suggested_key": {"default": "Alt+P"}, "description": "Pin / unpin current tab as active work"}}}