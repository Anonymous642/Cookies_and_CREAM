{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hunger Games Simulator Cast Collector", "description": "Collect names and image URLs from any page, then import a custom cast into Hunger Games Simulator.", "version": "0.1.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "116", "action": {"default_title": "Open HGS Cast Collector", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "permissions": ["contextMenus", "storage", "sidePanel"], "externally_connectable": {"matches": ["https://hungergamesimulator.org/*", "https://www.hungergamesimulator.org/*"]}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}