{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bias Noticer", "description": "See through the propaganda. AI-assisted critical reading that highlights bias signals \u2014 never censors content.", "version": "2.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus"], "host_permissions": ["https://api.x.ai/*", "http://*/*", "https://*/*"], "action": {"default_title": "Bias Noticer", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-analysis": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Activate / deactivate Bias Noticer shades"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Bias Noticer side panel"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}