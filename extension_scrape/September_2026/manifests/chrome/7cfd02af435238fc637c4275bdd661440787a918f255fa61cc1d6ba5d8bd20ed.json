{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Silence - Twitter Filter", "version": "1.0.0", "description": "Take back your feed. Block verified shills, engagement bait, and brain rot. Your timeline, your rules.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "notifications"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "Silence Settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}