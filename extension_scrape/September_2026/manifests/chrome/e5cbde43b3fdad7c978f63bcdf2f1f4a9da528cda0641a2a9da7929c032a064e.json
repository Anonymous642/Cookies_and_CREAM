-hormozi.js", "lib/coaching-templates/dan-lok.js", "components/feedback-toast.js", "lib/supabase-realtime.js", "scripts/feedback-listener.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-copilot": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Toggle Live Copilot overlay"}, "mute-copilot": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Mute/unmute Live Copilot audio capture"}}}