{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitter/X AutoScroll", "version": "1.0.3", "description": "Auto-scroll Twitter/X with variable speed and pointer settings", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"128": "icon.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Twitter/X AutoScroll", "default_popup": "popup.html"}, "commands": {"toggle-autoscroll": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Toggle auto-scroll on the current Twitter/X tab"}}}