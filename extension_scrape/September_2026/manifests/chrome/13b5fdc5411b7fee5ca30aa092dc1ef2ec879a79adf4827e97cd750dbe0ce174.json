{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gifty - Add to Lists", "version": "1.1.0", "description": "Add items from Amazon to your Gifty lists with one click", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["identity"], "host_permissions": ["https://gifty-658dd.firebaseapp.com/*", "https://www.amazon.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content/content-script.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}