{"manifest_version": 3, "name": "AutoScroll with Layout Manager", "version": "1.3.6", "description": "Auto-scroll long pages, pause when the mouse stops, keep a clean reading focus, and resume on reload.", "key": "", "update_url": "https://clients2.google.com/service/update2/crx", "permissions": ["activeTab", "scripting", "storage", "commands", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "notifications"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "csp_bypass_rules", "enabled": true, "path": "csp_rules.json"}]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "AutoScroll - Scroll with Layout Control", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-scroll": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Start or stop auto-scrolling"}, "toggle-menu": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Show or hide the floating hint"}, "toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Start or stop area recording"}, "toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Pause or resume area recording"}, "cycle-layout": {"description": "Cycle through layout modes"}}, "web_accessible_resources": [{"resources": ["content.js", "injected.js", "popup.html", "popup.js", "loader.js", "lang/*.json"], "matches": ["<all_urls>"]}]}