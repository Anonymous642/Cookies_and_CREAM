{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "APEX Copilot", "version": "1.0.1", "description": "Captura el gr\u00e1fico visible, comprueba el contexto del activo y registra la operaci\u00f3n en tu cuenta de APEX.", "permissions": ["activeTab", "sidePanel", "storage"], "host_permissions": ["https://apextradingcoach.vercel.app/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"], "optional_host_permissions": ["https://*.supabase.co/*", "http://localhost:54321/*", "http://127.0.0.1:54321/*"], "externally_connectable": {"matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://apextradingcoach.vercel.app/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Abrir el Copilot de APEX", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "copilot-ui/panel.html"}, "commands": {"capture-and-analyze": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Abrir el Copilot de APEX para analizar el gr\u00e1fico visible"}, "toggle-copilot-panel": {"description": "Abrir el panel del Copilot de APEX"}, "check-with-apex": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Comprobar el activo \u2014 el contexto de APEX antes de decidir"}}}