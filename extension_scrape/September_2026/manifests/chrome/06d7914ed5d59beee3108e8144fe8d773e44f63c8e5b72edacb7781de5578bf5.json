{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LiHelper Connector", "version": "0.3.9", "homepage_url": "https://lihelper.com/chrome-extension", "description": "Syncs your LinkedIn analytics to LiHelper from your own browser session. No password or cookie ever leaves your browser.", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*", "https://api.lihelper.com/*"], "externally_connectable": {"matches": ["https://lihelper.com/*", "https://www.lihelper.com/*", "https://lihelper.vercel.app/*"]}, "background": {"service_worker": "src/background/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/analytics/*", "https://www.linkedin.com/dashboard/*", "https://www.linkedin.com/in/*"], "js": ["src/content/linkedin_reader.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/in/*", "https://www.linkedin.com/posts/*"], "js": ["src/content/linkedin_actor.js", "src/content/grow_reach.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/jobs/*"], "js": ["src/content/linkedin_apply.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/company/*"], "js": ["src/content/linkedin_page_post.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "LiHelper Connector", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}