{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LIRA - Study Assistant", "description": "Learn In Real-Time Assistant", "version": "1.02", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "clipboardWrite", "commands", "unlimitedStorage", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_title": "LIRA - Study Assistant", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Toggle the popup"}, "note": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Add a note"}, "screenshot": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Take a screenshot"}, "answer": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Get an answer"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}