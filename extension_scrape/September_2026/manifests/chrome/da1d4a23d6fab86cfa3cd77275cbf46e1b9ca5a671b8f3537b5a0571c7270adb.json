{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blocka", "short_name": "Blocka", "version": "1.0.0", "description": "Free and open-source site blocker for staying focused", "homepage_url": "https://github.com/Sax-Yusuph/Blocka", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage", "webNavigation", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png"}}, "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["src/blocked.html"], "matches": ["<all_urls>"]}]}