{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy YouTube Video Description", "version": "1.0.0", "description": "Copy the description from a YouTube watch page with one native-feeling button.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Copy YouTube Video Description", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/description.js"], "css": ["src/description.css"], "run_at": "document_idle"}]}