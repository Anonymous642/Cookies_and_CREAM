{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comprehensible Input Monitor", "description": "Tracks YouTube watchtime for videos that appear to be mostly Spanish so you can measure comprehensible input.", "version": "0.2.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*", "https://comprehensible-input-monitor.onrender.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["src/spanish-category-detector.js", "src/content-script.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://comprehensible-input-monitor.onrender.com/api/login", "http://localhost/api/login", "http://127.0.0.1/api/login"], "js": ["src/web-auth-content-script.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Comprehensible Input Monitor", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}