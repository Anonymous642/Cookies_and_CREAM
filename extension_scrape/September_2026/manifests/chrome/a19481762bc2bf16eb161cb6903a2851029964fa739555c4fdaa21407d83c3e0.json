{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Brilly \u2014 AI Live Assistant", "short_name": "Brilly", "version": "1.0.0", "description": "A live AI assistant that floats over any webpage. Bring your own API key. Your data stays in your browser.", "default_locale": "en", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Brilly", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"], "optional_host_permissions": ["<all_urls>"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"toggle-brilly": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Toggle the Brilly floating assistant"}}, "web_accessible_resources": [{"resources": ["content/panel.css", "vendor/*", "lib/*", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}}