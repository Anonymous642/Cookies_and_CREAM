{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkVision", "version": "1.4.0", "default_locale": "en", "description": "Beautiful Markdown rendering for Chrome \u2014 auto-render .md URLs and real-time editor", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "commands": {"toggle-render": {"suggested_key": {"default": "Alt+F"}, "description": "Toggle Markdown render / restore"}}, "options_page": "options/options.html", "background": {"service_worker": "background.min.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/marked.min.js", "lib/highlight.min.js", "content.min.js"], "css": ["styles/katex.min.css", "styles/highlight-github.css", "styles/theme-github.css"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src https://www.plantuml.com https: file:; object-src 'self'"}, "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest", "downloads", "downloads.open", "contextMenus"], "host_permissions": ["<all_urls>", "file:///*"], "declarative_net_request": {"rule_resources": [{"id": "markvision_rules", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["styles/*"], "matches": ["<all_urls>"]}]}