{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrossClip", "version": "1.0.4", "description": "Cross-device clipboard. Copy once, access everywhere.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CrossClip"}, "background": {"service_worker": "background.js"}, "permissions": ["contextMenus", "storage", "clipboardRead", "clipboardWrite", "notifications"], "host_permissions": ["https://*/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"], "externally_connectable": {"matches": ["https://usecrossclip.com/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src * data: blob:; media-src * blob:; connect-src * data: blob:"}}