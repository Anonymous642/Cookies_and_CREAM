{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SalesAllReady", "description": "SalesAllReady Extension", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_title": "SalesAllReady", "default_icon": "icon.png"}, "permissions": ["storage", "cookies"], "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["contentScript.js"]}], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.salesallready.com"}, "web_accessible_resources": [{"resources": ["icon.png", "google.png"], "matches": ["<all_urls>"]}]}