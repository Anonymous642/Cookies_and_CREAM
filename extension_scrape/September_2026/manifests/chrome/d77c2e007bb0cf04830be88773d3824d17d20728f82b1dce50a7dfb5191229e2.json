{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat2Anki", "version": "1.2", "description": "Make flashcards from your ChatGPT Conversations", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Chat2Anki", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["dist/bundle.js", "sidebar.html", "add_note_example.json"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}