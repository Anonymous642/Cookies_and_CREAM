{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Broken Link Checker - BLC", "short_name": "Broken Link Checker", "description": "Scan any page for broken links, 404s, soft 404s and redirect chains. Results stream in live while the scan runs.", "version": "1.0.3", "minimum_chrome_version": "116", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Broken Link Checker"}, "side_panel": {"default_path": "src/panel.html"}, "background": {"service_worker": "src/worker.js", "type": "module"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open Broken Link Checker"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the results side panel"}}, "permissions": ["activeTab", "scripting", "storage", "sidePanel", "alarms"], "optional_permissions": ["notifications"], "content_scripts": [{"matches": ["https://brokenlinkchecker.io/extension/connected*"], "js": ["src/content/connected.js"], "run_at": "document_idle"}]}