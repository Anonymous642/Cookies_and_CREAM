{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Growth Tracker - Productivity Tree", "version": "2.8.0", "description": "Track habits and grow a productivity tree. Categorize sites, log focus sessions, and manage tasks - 100% local and private.", "author": "Rudra Gupta", "homepage_url": "https://github.com/Rudra-Gupta15", "permissions": ["tabs", "storage", "alarms", "activeTab", "idle", "notifications", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Open Growth Tracker"}}, "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["growth_how-to-use.html"], "matches": ["<all_urls>"]}]}