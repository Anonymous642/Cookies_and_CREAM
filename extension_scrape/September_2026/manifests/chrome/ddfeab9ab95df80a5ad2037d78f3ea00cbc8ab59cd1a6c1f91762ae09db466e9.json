{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Messages History Exporter", "version": "2.1.0", "description": "Exports the currently opened Google Messages conversation to CSV or JSON.", "permissions": ["downloads", "storage", "unlimitedStorage"], "host_permissions": ["https://messages.google.com/*"], "background": {"service_worker": "service_worker.js"}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://messages.google.com/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle", "world": "ISOLATED"}]}