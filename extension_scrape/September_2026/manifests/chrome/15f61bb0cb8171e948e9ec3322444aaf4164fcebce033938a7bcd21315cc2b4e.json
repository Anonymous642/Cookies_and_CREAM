{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Test Card Filler", "version": "1.0.0", "description": "Fill checkout forms with test card numbers (Stripe, Adyen, Braintree, PayPal) in one click. Bring your own cards too.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "action": {"default_popup": "src/popup.html", "default_title": "Test Card Filler", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Open Test Card Filler"}, "fill-last-card": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Fill the last used test card"}}}