{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mooru: Tab & Session Manager \u2014 OneTab Alt", "version": "1.0.0", "description": "Save all your open tabs in one click and restore them anytime. Reliable, with export/backup so you never lose your tabs.", "permissions": ["tabs", "storage", "alarms"], "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Mooru", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "options_page": "src/options/options.html", "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "commands": {"save-current-window": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in the current window"}}}