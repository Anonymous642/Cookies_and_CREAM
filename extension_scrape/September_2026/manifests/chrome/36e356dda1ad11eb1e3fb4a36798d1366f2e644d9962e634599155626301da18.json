{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DelayZone", "version": "1.0", "description": "DelayZone adds a custom delay to chosen sites, helping you resist impulse browsing and build focus through intentional pauses.", "permissions": ["storage", "webNavigation", "tabs"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Site Delay Settings"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["delay.html"], "matches": ["<all_urls>"]}]}