{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Screenshot + Annotate", "version": "1.1.1", "description": "Capture \u2192 Annotate \u2192 Copy/Download in 5 seconds. No login. No uploads. Everything stays in your browser.", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Capture selected area"}, "capture-div": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Capture element"}}, "web_accessible_resources": [{"resources": ["annotate.html"], "matches": ["<all_urls>"]}]}