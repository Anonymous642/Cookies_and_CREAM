{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mrky \u2014 Learn English Everywhere", "version": "1.5.3", "description": "Translate, color-code, and save flashcards from any webpage, YouTube, Netflix, and more.", "permissions": ["storage", "activeTab", "alarms", "offscreen", "scripting"], "host_permissions": ["https://*.youtube.com/*", "https://*.netflix.com/*", "https://*.primevideo.com/*", "https://*.disneyplus.com/*", "<all_urls>"], "background": {"service_worker": "background/worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://mrky.org/*"], "js": ["libs/compromise.min.js", "content/index.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://*.netflix.com/*", "https://*.disneyplus.com/*", "https://*.osnplus.com/*"], "js": ["content/nf-capture.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://*.youtube.com/*"], "js": ["content/yt-capture.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "commands": {"toggle-ocr": {"suggested_key": {"default": "Alt+S", "mac": "Command+Shift+S"}, "description": "Toggle OCR capture mode"}, "toggle-coloring": {"suggested_key": {"default": "Alt+W", "mac": "Command+Shift+W"}, "description": "Toggle word coloring"}}, "web_accessible_resources": [{"resources": ["assets/*", "libs/*", "content/*"], "matches": ["<all_urls>"]}]}