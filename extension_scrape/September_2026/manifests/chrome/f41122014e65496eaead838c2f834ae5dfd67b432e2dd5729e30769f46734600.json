{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GitHub Default Filters", "description": "Allows configuration of default filters for GitHub issues and pull requests", "version": "1.0", "manifest_version": 3, "action": {"default_popup": "popups/popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "webNavigation"], "host_permissions": ["https://github.com/*/*/pulls", "https://github.com/*/*/issues"], "background": {"service_worker": "scripts/worker.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["scripts/shared.js", "scripts/content.js"], "run_at": "document_end"}]}