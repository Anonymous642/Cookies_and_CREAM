{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DetoxAI: Filter for X, Reddit & Facebook", "version": "1.2.0", "description": "AI filter removing toxic & clickbait posts from X (Twitter), Reddit & Facebook. Protect your mental health.", "minimum_chrome_version": "118", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["alarms", "storage", "activeTab", "sidePanel"], "host_permissions": ["https://*.x.com/*", "https://*.twitter.com/*", "https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.threads.net/*", "https://*.reddit.com/*", "https://*.cnn.com/*", "https://*.bbc.com/*", "https://*.bbc.co.uk/*", "https://*.nytimes.com/*", "https://*.washingtonpost.com/*", "https://*.theguardian.com/*", "https://*.reuters.com/*", "https://*.ap.org/*", "https://*.npr.org/*", "https://*.news.yahoo.com/*", "https://*.news.google.com/*", "https://openrouter.ai/api/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.x.com/*", "https://*.twitter.com/*", "https://*.threads.net/*", "https://*.facebook.com/*", "https://*.reddit.com/*", "https://*.cnn.com/*", "https://*.bbc.com/*", "https://*.bbc.co.uk/*", "https://*.nytimes.com/*", "https://*.washingtonpost.com/*", "https://*.theguardian.com/*", "https://*.reuters.com/*", "https://*.ap.org/*", "https://*.npr.org/*", "https://*.news.yahoo.com/*", "https://*.news.google.com/*"], "js": ["utils/blocklist.js", "adapters/site-adapter.js", "adapters/twitter.js", "adapters/threads.js", "adapters/facebook.js", "adapters/reddit.js", "adapters/generic.js", "content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Open DetoxAI Panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, 