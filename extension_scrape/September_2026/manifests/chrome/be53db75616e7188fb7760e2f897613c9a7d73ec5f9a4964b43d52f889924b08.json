{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spy Agent \u2014 X Engagement Checker", "version": "3.0.2", "description": "Scan X (Twitter) post replies to find which members of your group engaged. Identify missing engagements instantly.", "minimum_chrome_version": "116", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Spy Agent"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["scripting", "tabs", "storage", "alarms", "contextMenus", "notifications", "sidePanel"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*.supabase.co/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "popup.html"}, "commands": {"start-scan": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Start engagement scan"}, "pause-scan": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Pause / Resume scan"}, "open-settings": {"suggested_key": {"default": "Alt+Comma", "mac": "Alt+Comma"}, "description": "Open settings page"}, "open-side-panel": {"suggested_key": {"default": "Alt+D", "mac": "Alt+D"}, "description": "Open side panel"}}, "options_page": "pages/settings.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}