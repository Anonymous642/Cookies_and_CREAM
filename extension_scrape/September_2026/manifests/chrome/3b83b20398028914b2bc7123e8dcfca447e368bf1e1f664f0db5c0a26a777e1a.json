{"manifest_version": 3, "version": "1.0.7", "name": "All Find Seek", "description": "Extension adding All Find Seek search engine to browser.", "icons": {"128": "128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://allfindseek.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset", "enabled": true, "path": "rules.json"}]}, "chrome_settings_overrides": {"search_provider": {"name": "All Find Seek", "keyword": "allfindseek.com", "search_url": "https://allfindseek.com/search?q={searchTerms}", "favicon_url": "https://allfindseek.com/favicon.ico", "encoding": "UTF-8", "is_default": true}}, "background": {"service_worker": "background.js"}, "update_url": "https://clients2.google.com/service/update2/crx"}