{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrewGIF \u2014 Region GIF Recorder", "version": "1.0.0", "description": "Drag-select a region of the current tab (or record the whole tab), record up to 25 seconds, and save an optimized animated GIF.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "downloads", "clipboardWrite"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "CrewGIF \u2014 record region as GIF", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"stop-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop the current GIF recording"}}}