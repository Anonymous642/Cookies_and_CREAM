{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jazmine AI", "version": "2.1.1", "description": "Your personal AI prompt library. Organize prompts into colorful categories, favorite, track usage, and reuse them anywhere.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Jazmine AI"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/chatgpt-inject.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/popup.html", "icons/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}