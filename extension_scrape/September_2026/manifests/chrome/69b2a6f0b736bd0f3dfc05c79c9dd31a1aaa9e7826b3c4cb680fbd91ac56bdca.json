{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SNS Blacklist", "version": "0.1.0", "description": "Block those users you don't want to see on YouTube and Twitter.", "author": "butaixianran", "default_locale": "en", "permissions": ["storage", "unlimitedStorage", "activeTab"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://x.com/*", "*://twitter.com/*", "*://raw.githubusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["shared/storage.js", "shared/i18n.js", "content-scripts/youtube.js"], "css": ["content-scripts/content.css"], "run_at": "document_end"}, {"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["shared/storage.js", "shared/i18n.js", "content-scripts/twitter.js"], "css": ["content-scripts/content.css"], "run_at": "document_end"}], "action": {"default_icon": {"128": "icons/icon128.png"}, "default_title": "__MSG_extName__"}, "icons": {"128": "icons/icon128.png"}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["fonts/*", "_locales/*", "_locales/en/*", "_locales/zh_CN/*"], "matches": ["<all_urls>"]}]}