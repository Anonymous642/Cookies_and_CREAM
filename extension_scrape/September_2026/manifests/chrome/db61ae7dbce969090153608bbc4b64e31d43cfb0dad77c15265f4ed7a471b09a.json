{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GoFullScreenshot: Full Page Screenshot", "short_name": "GoScreenshot", "version": "1.9.60", "version_name": "1.9.60", "description": "Capture full pages, visible areas, or selected regions. Edit and export locally. No tracking, backend, or uploads.", "homepage_url": "https://gofullscreenshot.com/", "minimum_chrome_version": "106", "permissions": ["activeTab", "alarms", "scripting", "storage"], "optional_permissions": ["downloads"], "optional_host_permissions": ["https://*/*", "http://*/*", "file:///*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "GoFullScreenshot - Choose what to capture", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+S", "windows": "Alt+Shift+S", "mac": "Option+Shift+S", "chromeos": "Alt+Shift+S", "linux": "Alt+Shift+S"}, "description": "Capture a full-page screenshot of the current tab"}, "capture-visible-area": {"suggested_key": {"default": "Alt+Shift+V", "windows": "Alt+Shift+V", "mac": "Option+Shift+V", "chromeos": "Alt+Shift+V", "linux": "Alt+Shift+V"}, "description": "Capture the visible area of the current tab"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R", "windows": "Alt+Shift+R", "mac": "Option+Shift+R", "chromeos": "Alt+Shift+R", "linux": "Alt+Shift+R"}, "description": "Select and capture a region of the current tab"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}