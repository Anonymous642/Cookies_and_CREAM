{"manifest_version": 3, "name": "Razuna", "version": "1.4.1", "description": "Collect URLs, images, files, or text from any site! Build your library and share with your team in Razuna DAM.", "update_url": "https://clients2.google.com/service/update2/crx", "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Razuna", "default_popup": "popup.html"}, "options_page": "options.html", "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["activeTab", "contextMenus", "storage", "tabs", "scripting", "sidePanel", "notifications"], "host_permissions": ["https://*/*", "http://*/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content_script.js"]}]}