{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmark Organizer", "version": "1.0.0", "description": "Organize bookmarks with tags, dark mode, and keyboard shortcuts", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "permissions": ["bookmarks", "storage", "tabs", "commands"], "commands": {"save-bookmark": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab as bookmark"}}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}