{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RE Calculator \u2014 Real Estate Investment Analyzer", "version": "1.0.2", "description": "Analyze any Zillow or Redfin listing as an investment. See cash flow, cap rate, cash-on-cash return and DSCR instantly.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.zillow.com/*", "https://www.redfin.com/*", "https://www.realtor.com/*", "https://replywell.ai/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.zillow.com/*"], "js": ["scraper_zillow.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.redfin.com/*"], "js": ["scraper_redfin.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Open RE Calculator"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}