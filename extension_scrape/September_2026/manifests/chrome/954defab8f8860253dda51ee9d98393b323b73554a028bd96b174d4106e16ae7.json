{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zillurl Vocab", "version": "0.1.10.29", "default_locale": "zh_TW", "description": "Learn vocabulary from YouTube videos with AI. Extract words from subtitles, get context-aware definitions, and track your progress.", "homepage_url": "https://vocab.zillurl.com/support", "permissions": ["storage", "alarms", "cookies"], "host_permissions": ["https://vocab.zillurl.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "exclude_matches": ["https://www.youtube.com/embed/*", "https://youtube.com/embed/*", "https://m.youtube.com/embed/*"], "js": ["injected.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "exclude_matches": ["https://www.youtube.com/embed/*", "https://youtube.com/embed/*", "https://m.youtube.com/embed/*"], "js": ["content.js"], "css": ["styles/tokens.css", "styles/panelStates.css", "styles/overlay.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["_locales/*/messages.json"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}