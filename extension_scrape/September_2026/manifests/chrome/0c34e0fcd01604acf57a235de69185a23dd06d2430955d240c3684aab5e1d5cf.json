{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Backup - ChatGPT to PDF, MD, and more", "description": "Backup your OpenAI ChatGPT history in either JSON or Markdown format", "version": "0.1.4", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_title": "ChatGPT Backup", "default_popup": "popup.html"}, "host_permissions": ["https://chatgpt.com/*"], "permissions": ["activeTab", "downloads", "storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}