{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Odoo Browser Assistant", "description": "Match webpage contacts to Odoo and create leads or quotations in a side panel. By TechUltra Solutions.", "version": "0.2.28", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "activeTab", "contextMenus", "scripting", "alarms", "tabs", "cookies"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Odoo Browser Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Toggle Odoo Browser Assistant"}, "read-selection": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Read current selection"}, "action-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Fire suggested action 1"}, "action-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Fire suggested action 2"}, "action-3": {"description": "Fire suggested action 3 (assign a key in chrome://extensions/shortcuts)"}}, "browser_specific_settings": {"gecko": {"id": "odoo-copilot@techultra", "strict_min_version": "121.0"}}}