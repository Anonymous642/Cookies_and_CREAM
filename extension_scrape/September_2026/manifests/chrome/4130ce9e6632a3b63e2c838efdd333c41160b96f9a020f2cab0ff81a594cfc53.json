{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "English Dictionary Lookup & Pronunciation", "version": "1.2.0", "description": "Instant Cambridge, Oxford & Merriam-Webster lookups for English learners \u2014 plus one-click pronunciation.", "permissions": ["activeTab", "contextMenus", "storage", "scripting", "tts"], "host_permissions": ["https://dictionary.cambridge.org/*", "https://www.merriam-webster.com/*", "https://www.oxfordlearnersdictionaries.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}, {"matches": ["https://dictionary.cambridge.org/*", "https://www.merriam-webster.com/*", "https://www.oxfordlearnersdictionaries.com/*"], "js": ["dictionary-scroll.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Dictionary Lookup", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"lookup-word": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Look up selected word"}, "listen-word": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Listen to pronunciation of selected word"}}}