{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ThinkTwice", "version": "1.0.0", "description": "Removes Amazon's Buy Now buttons and adds a 30-second pause before checkout, so you can think twice before buying.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["src/config.js", "src/content-product.js", "src/content-cart.js"], "css": ["src/overlay.css"], "run_at": "document_idle"}]}