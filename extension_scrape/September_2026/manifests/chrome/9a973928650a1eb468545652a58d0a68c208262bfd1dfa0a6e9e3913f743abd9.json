{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WikiClicks", "version": "1.0.0", "description": "Navigate from one Wikipedia article to another using only hyperlinks. Track your path and compete for the fewest clicks!", "author": "Nicole Louise Deyro, HectoWeb Studio", "permissions": ["storage", "tabs", "activeTab", "sidePanel"], "host_permissions": ["*://*.wikipedia.org/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.wikipedia.org/wiki/*"], "js": ["content/content-script.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "WikiClicks - Click to open"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}}