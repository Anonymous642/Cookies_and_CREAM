{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NestarioTabs", "version": "1.4.2", "description": "Organize tabs into workspaces, save and recover sessions, focus, search everything, and manage your browser with AI.", "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "favicon", "alarms", "sidePanel", "identity", "contextMenus", "scripting", "activeTab", "idle"], "host_permissions": ["https://nestariotabs.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "commands": {"save-current-window": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current window as a session"}, "open-manager": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the full session manager (side panel)"}, "exit-focus": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Leave Focus Mode"}}, "content_scripts": [{"matches": ["https://nestariotabs.com/s/*"], "js": ["src/content/sharePage.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/manager/index.html"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}