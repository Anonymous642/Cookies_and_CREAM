{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Translate Any", "version": "1.1", "description": "Translate any website, including Notion. Free (unlimited!), Safe (no data sent to us), and One-click to use.", "permissions": ["scripting", "tabs", "storage", "activeTab"], "action": {"default_title": "Translate Any"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["viewer.html", "options.html"], "matches": ["<all_urls>"]}]}