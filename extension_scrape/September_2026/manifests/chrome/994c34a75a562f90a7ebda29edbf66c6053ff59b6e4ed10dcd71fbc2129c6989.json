{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SellerScope \u2014 Product & Keyword Research", "short_name": "SellerScope", "version": "1.0.0", "description": "Sales estimates, fees, profit and keyword research for Amazon sellers across 9 marketplaces. Computed locally, no account.", "minimum_chrome_version": "116", "action": {"default_title": "SellerScope", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/index.html"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.amazon.co.jp/*", "https://*.amazon.com.au/*", "https://*.amazon.ae/*", "https://*.amazon.sa/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "unlimitedStorage", "sidePanel", "tabs", "alarms", "contextMenus", "notifications", "scripting", "offscreen"], "optional_permissions": ["identity"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.amazon.co.jp/*", "https://*.amazon.com.au/*", "https://*.amazon.ae/*", "https://*.amazon.sa/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open the SellerScope popup"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle the SellerScope side panel"}, "toggle-overlay": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Toggle the on-page data overlay"}, "run-xray": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Run X-Ray on the current search results"}}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.amazon.co.jp/*", "https://*.amazon.com.au/*", "https://*.amazon.ae/*", "https://*.amazon.sa/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}