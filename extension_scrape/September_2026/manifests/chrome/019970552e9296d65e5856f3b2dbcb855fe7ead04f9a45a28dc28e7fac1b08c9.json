{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hello Shop HQ Helper", "version": "0.4.0", "description": "Works in your own logged-in Chrome: walk your Hello Shop HQ outreach queue and fill each comment for you to post yourself.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://app.hello-shop.com.au/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Hello Shop HQ Helper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.threads.net/*", "https://*.threads.com/*", "https://*.pinterest.com/*", "https://*.youtube.com/*"], "js": ["content-comment.js"], "run_at": "document_idle"}]}