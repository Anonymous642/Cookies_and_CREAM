{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Crossfade \u2013 Smart Media Control", "version": "1.2.0", "description": "Watching a video? Crossfade automatically lowers or pauses your music and brings it back when you're done.", "minimum_chrome_version": "116", "permissions": ["storage", "identity", "alarms", "notifications", "scripting", "tabs"], "host_permissions": ["https://api.spotify.com/*", "https://accounts.spotify.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Video Spotify Sync", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Video Spotify Sync on/off"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.udemy.com/*", "https://*.netflix.com/*", "https://*.twitch.tv/*", "https://*.vimeo.com/*", "https://*.coursera.org/*", "https://*.dailymotion.com/*"], "exclude_matches": ["https://open.spotify.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["yt-bridge.js"], "matches": ["https://*.youtube.com/*"]}]}