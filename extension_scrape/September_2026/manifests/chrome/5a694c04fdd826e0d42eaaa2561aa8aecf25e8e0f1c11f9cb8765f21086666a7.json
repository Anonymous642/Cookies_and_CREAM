{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Do Not Distracted \u2014 Focus OS", "short_name": "Do Not Distracted", "version": "1.6.0", "description": "focus blocker: all websites are locked by default, and each focus mode lets the user choose which websites and categories available", "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "contextMenus", "notifications", "sidePanel", "declarativeNetRequest"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "commands": {"start-focus": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Start a focus session"}, "toggle-blocking": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Toggle blocking"}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}]}