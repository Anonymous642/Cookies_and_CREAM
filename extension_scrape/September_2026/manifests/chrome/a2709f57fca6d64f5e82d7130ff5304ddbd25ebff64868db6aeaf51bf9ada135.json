{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TradeCorner", "version": "1.0.0", "description": "Real-time crypto prices, charts, alerts and a floating price overlay.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "alarms", "notifications", "scripting", "activeTab", "offscreen"], "host_permissions": ["https://api.coingecko.com/*", "https://data-api.binance.vision/*", "https://open.er-api.com/*", "https://api.alternative.me/*", "https://*.supabase.co/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Open TradeCorner"}, "pin-pill": {"suggested_key": {"default": "Alt+Q"}, "description": "Pin the last coin as a floating pill on the page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}