{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PriceWatch - Price Tracker & Coupon Finder", "version": "1.0.8", "description": "Auto-test coupon codes at checkout and track prices on major retailers including Amazon. No affiliate links, no data selling.", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "PriceWatch"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.walmart.com/*", "https://www.target.com/*", "https://www.bestbuy.com/*", "https://www.ebay.com/*"], "js": ["content.js", "coupons.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["storage", "notifications", "alarms", "scripting"], "host_permissions": ["https://www.amazon.com/*", "https://www.walmart.com/*", "https://www.target.com/*", "https://www.bestbuy.com/*", "https://www.ebay.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://mainewinters.com/*"]}}