{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Calculator & Highlighter", "version": "4.0", "description": "Turns any webpage into a calculator: click numbers to sum, average & more. Highlight, draw & annotate pages. Syncs across tabs.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Calculator & Highlighter"}, "commands": {"toggle-selection-mode": {"suggested_key": {"default": "Alt+X", "windows": "Alt+X", "mac": "Alt+X"}, "description": "Toggle number selection mode"}, "reset-calculator": {"suggested_key": {"default": "Alt+R", "windows": "Alt+R", "mac": "Alt+R"}, "description": "Reset calculator and clear all selections"}, "toggle-pen-mode": {"suggested_key": {"default": "Alt+P", "windows": "Alt+P", "mac": "Alt+P"}, "description": "Toggle drawing mode"}, "clear-drawings": {"suggested_key": {"default": "Ctrl+Shift+C", "windows": "Ctrl+Shift+C"}, "description": "Clear all drawings and text"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": [], "matches": ["<all_urls>"]}], "minimum_chrome_version": "102"}