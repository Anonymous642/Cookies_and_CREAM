{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Question Timer", "version": "1.0.0", "description": "Track time spent per question with keyboard shortcuts and export a PDF report.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Question Timer", "default_popup": "popup.html"}, "commands": {"start-next-question": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Start the next question timer"}, "stop-current-question": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Stop the current question timer"}, "reset-current-question": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Reset the current (or most recent) question timer"}}}