{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spelly - Spelling Practice", "short_name": "spelly", "version": "0.0.18", "description": "Easily boost your spelling skills by adding misspelled words to your list and practicing them effectively.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon-32x32.png", "48": "assets/icons/icon-48x48.png", "128": "assets/icons/icon-128x128.png"}, "permissions": ["activeTab", "contextMenus", "scripting"], "action": {"default_title": "Login to Spelly", "default_popup": "popup.html"}, "commands": {"add_word_to_spelly": {"suggested_key": {"default": "Alt+S"}, "description": "Add Word to Spelly"}}, "background": {"service_worker": "utils.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["libs/toastify-es.js", "background.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["check.js"], "matches": ["<all_urls>"]}]}