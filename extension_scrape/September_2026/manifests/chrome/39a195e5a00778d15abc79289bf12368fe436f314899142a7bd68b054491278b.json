{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scribeberry", "description": "A browser extension that helps you take notes while you're interacting with popular webapps.", "version": "1.0.11", "icons": {"16": "img/logo-16.png", "32": "img/logo-34.png", "48": "img/logo-48.png", "128": "img/logo-128.png"}, "web_accessible_resources": [{"resources": ["img/logo-16.png", "img/logo-34.png", "img/logo-48.png", "img/logo-128.png", "img/logo-32.png", "img/smart-push-icon.png", "locales/**/*.json"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/toolbar.css"], "matches": ["https://*/*"]}], "permissions": ["sidePanel", "storage", "alarms", "activeTab", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://extension.scribeberry.com/*", "https://app.scribeberry.com/*", "https://*.scribeberry.com/*", "https://scribeberry-app-git-test-scribeberry.vercel.app/*", "https://scribeberry-app-git-dev-scribeberry.vercel.app/*", "https://scribeberry-app-git-extension-scribeberry.vercel.app/*"]}, "action": {}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'self'; form-action 'self'"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*/*"], "all_frames": true, "match_about_blank": false, "js": ["content-scripts/toolbar.js"]}]}