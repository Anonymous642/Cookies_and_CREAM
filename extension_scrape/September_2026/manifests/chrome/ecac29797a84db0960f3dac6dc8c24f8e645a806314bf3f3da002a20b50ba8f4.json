{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comment Sense", "description": "\ud83d\udd0d Instantly search, filter, and sort YouTube comments \u2014 find exactly what you're looking for in seconds. Works from a side panel.", "version": "0.0.9", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "activeTab", "sidePanel"], "host_permissions": ["https://www.googleapis.com/youtube/v3/*", "https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["content-scripts/content.js"]}, {"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}]}