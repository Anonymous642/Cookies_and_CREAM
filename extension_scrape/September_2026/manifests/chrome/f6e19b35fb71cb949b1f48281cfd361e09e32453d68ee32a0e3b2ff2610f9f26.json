{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript and Summary", "version": "0.1.0", "description": "Read, search, copy, export and summarize YouTube captions.", "permissions": ["storage", "scripting", "sidePanel"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://*.vercel.app/*", "http://localhost:3000/*"], "background": {"service_worker": "assets/background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "YouTube Transcript and Summary", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://youtube.com/watch*", "https://youtube.com/shorts/*"], "js": ["assets/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/bridge.js"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}