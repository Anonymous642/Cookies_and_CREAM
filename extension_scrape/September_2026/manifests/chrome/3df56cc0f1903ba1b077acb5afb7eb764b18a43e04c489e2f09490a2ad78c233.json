{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextSave", "description": "Save and continue AI conversations.", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "clipboardWrite", "identity", "scripting", "storage", "tabs"], "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://kimi.com/*", "https://*.kimi.com/*", "https://www.kimi.com/*", "https://perplexity.ai/*", "https://*.perplexity.ai/*", "https://context-save-web.vercel.app/*", "https://*.supabase.co/*"], "action": {"default_title": "ContextSave", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "commands": {"save-current-conversation": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current AI conversation"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.claude.ai/*", "https://*.kimi.com/*", "https://*.perplexity.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://kimi.com/*", "https://perplexity.ai/*", "https://www.kimi.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}