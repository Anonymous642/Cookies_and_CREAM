{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScheinSafe", "version": "1.2.2", "description": "Fahrzeugschein scannen, Daten speichern und Formulare automatisch ausf\u00fcllen. Mit T\u00dcV-Erinnerung.", "author": "ScheinSafe", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.scheinsafe.de"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "ScheinSafe", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "js/*", "css/*", "fonts/*"], "matches": ["<all_urls>"]}]}