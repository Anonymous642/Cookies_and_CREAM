{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Notes Bottom Bar", "version": "1.0.7", "description": "Access and reuse saved AI prompts directly from compatible websites.", "permissions": ["activeTab", "storage", "tabs", "identity"], "background": {"service_worker": "background.js"}, "commands": {"toggle-bottom-bar": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Show/hide the AI Notes toolbar"}, "open-templates": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open Templates with search focused"}}, "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://chat.deepseek.com/*", "https://perplexity.ai/*", "https://chat.mistral.ai/*", "https://ai-nots.com/*", "https://x.com/i/grok*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["callback.html", "callback.js"], "matches": ["https://ai-nots.com/*"]}], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.com/i/grok*", "https://chat.deepseek.com/*", "https://perplexity.ai/*", "https://chat.mistral.ai/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "index.html", "default_title": "AI Notes"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}