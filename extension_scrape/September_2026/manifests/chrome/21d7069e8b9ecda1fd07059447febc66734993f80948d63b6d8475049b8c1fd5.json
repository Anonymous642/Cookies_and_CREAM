{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fund Flow", "version": "1.0.11", "description": "A sidebar-based CRM extension for scraping user profiles from social media platforms", "permissions": ["sidePanel", "activeTab", "storage", "scripting", "tabs", "identity"], "host_permissions": ["*://*.linkedin.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*", "*://www.fundflowos.com/*", "*://*.fundflowos.com/*", "*://generativelanguage.googleapis.com/*", "*://*.sentry.io/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["linkedin-interceptor.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true, "match_about_blank": true}, {"matches": ["*://*.instagram.com/*"], "js": ["instagram-interceptor.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://*.linkedin.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*"], "js": ["content/index.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["*://www.fundflowos.com/*", "*://*.fundflowos.com/*"], "js": ["content/token-listener.js"], "type": "module", "run_at": "document_idle"}], "side_panel": {"default_path": "src/pages/sidepanel/index.html"}, "action": {"default_title": "Open Fund Flow", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/fundflow-icon.png", "assets/fundflow-icon.svg"], "matches": ["*://*.linkedin.com/*", "*://*.instagram.com/*"]}]}