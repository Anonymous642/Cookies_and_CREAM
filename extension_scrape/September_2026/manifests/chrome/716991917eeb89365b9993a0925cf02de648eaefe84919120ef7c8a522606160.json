{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Herb \u2022 AI Workflow & Prompt Manager", "version": "1.4.9", "description": "AI workflow & prompt manager for developers. Rules, context, and sessions auto-injected into your AI coding tools. Free to use.", "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "nativeMessaging"], "host_permissions": ["https://cursor.com/*", "https://www.cursor.com/*", "https://claude.ai/*", "https://chatgpt.com/*", "https://windsurf.com/*", "https://www.windsurf.com/*", "https://github.com/*", "https://news.ycombinator.com/*", "https://firestore.googleapis.com/*", "https://raw.githubusercontent.com/*", "https://gist.githubusercontent.com/*", "https://gist.github.com/*", "https://pastebin.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://cursor.com/*", "https://www.cursor.com/*", "https://claude.ai/*", "https://chatgpt.com/*", "https://windsurf.com/*", "https://www.windsurf.com/*", "https://github.com/*", "https://news.ycombinator.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["onboarding/*.html", "onboarding/*.css", "onboarding/*.js", "dashboard/*.html", "popup/*.html"], "matches": ["<all_urls>"]}]}