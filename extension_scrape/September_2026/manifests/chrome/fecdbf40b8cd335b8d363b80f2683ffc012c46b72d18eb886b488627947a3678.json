{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "edn.chat \u2014 Assistant EDN", "short_name": "edn.chat", "description": "Posez vos questions sur un cours, un PDF ou une page d\u2019entra\u00eenement : edn.chat comprend ce que vous consultez.", "version": "0.1.3", "minimum_chrome_version": "114", "permissions": ["scripting", "sidePanel"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://edn.chat https://www.edn.chat;"}, "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "Ouvrir edn.chat", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://edn.chat/*", "https://www.edn.chat/*"]}}