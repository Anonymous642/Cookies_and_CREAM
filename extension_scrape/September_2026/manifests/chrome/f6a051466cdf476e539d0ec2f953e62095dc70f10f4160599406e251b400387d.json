{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "432 Hz YouTube Converter", "description": "Converts YouTube & music.youtube.com audio to 432 Hz tuning", "version": "1.0", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://*.youtube.com/*", "https://*.music.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}