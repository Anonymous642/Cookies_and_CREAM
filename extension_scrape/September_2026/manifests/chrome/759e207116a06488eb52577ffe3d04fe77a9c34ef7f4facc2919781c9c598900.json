{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WriteCheck \u2014 Writing Insights for Google Docs", "version": "2.13.0", "description": "See how a Google Doc was written \u2014 sessions, pace, pastes, and a replay \u2014 plus optional AI checks. No account required.", "homepage_url": "https://writecheck.org", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://docs.google.com/*", "https://*.googleusercontent.com/*"], "optional_host_permissions": ["https://writecheck.org/*", "https://api.gptzero.me/*", "https://api.gowinston.ai/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "WriteCheck", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://docs.google.com/document/d/*", "https://docs.google.com/document/u/*/d/*", "https://docs.google.com/a/*/document/d/*", "https://docs.google.com/a/*/document/u/*/d/*"], "all_frames": true, "run_at": "document_idle", "js": ["src/browser-polyfill.js", "src/changelog_parser.js", "src/docs_api.js", "src/analyzer.js", "src/replay.js", "src/fingerprint.js", "src/gptzero.js", "src/report.js", "src/ui.js", "src/content.js"], "css": ["src/styles.css"]}], "browser_specific_settings": {"gecko": {"id": "docforensics@writecheck.org", "strict_min_version": "115.0"}}}