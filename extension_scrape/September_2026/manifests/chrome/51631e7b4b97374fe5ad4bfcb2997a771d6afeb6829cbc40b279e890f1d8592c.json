{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TunnelVision \u2014 Focus for YouTube", "short_name": "TunnelVision", "version": "1.0.0", "description": "Filter YouTube's sidebar to related videos, hide Shorts and the home feed. A focus shield that's hard to switch off.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "TUNNELVISION", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options.html"}