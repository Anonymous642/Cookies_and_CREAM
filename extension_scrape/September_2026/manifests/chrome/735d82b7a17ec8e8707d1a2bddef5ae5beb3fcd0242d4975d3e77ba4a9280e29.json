{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StallNotice", "version": "1.1.0", "description": "Shows a subtle REFRESH prompt on YouTube Home when the feed stalls.", "host_permissions": ["https://www.youtube.com/*"], "permissions": ["storage"], "background": {"service_worker": "sw.js"}, "action": {"default_title": "StallNotice", "default_icon": {"16": "icons/on_icon16.png", "32": "icons/on_icon32.png", "48": "icons/on_icon48.png", "128": "icons/on_icon128.png"}}, "icons": {"16": "icons/on_icon16.png", "32": "icons/on_icon32.png", "48": "icons/on_icon48.png", "128": "icons/on_icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}