{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Momently \u2013 YouTube Timestamp Saver", "version": "1.0", "version_name": "1.0.0", "author": "Momently Team", "description": "Save important moments from YouTube videos with a single click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["dashboard.html"], "matches": ["https://www.youtube.com/*"]}]}