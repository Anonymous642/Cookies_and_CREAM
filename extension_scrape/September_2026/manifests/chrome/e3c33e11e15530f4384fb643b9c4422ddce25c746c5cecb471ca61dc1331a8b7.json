{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Full Stack Assistant", "version": "2.2.0", "description": "Developer utilities: form tools, DOM inspection, screen tools, epoch time, docs search, and more.", "permissions": ["tabs", "storage", "sidePanel", "declarativeNetRequest", "scripting"], "host_permissions": ["<all_urls>", "https://eu.i.posthog.com/*", "https://us.i.posthog.com/*", "https://dns.google/*", "https://cloudflare-dns.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://eu.i.posthog.com https://us.i.posthog.com https://dns.google https://cloudflare-dns.com;"}, "action": {"default_popup": "popup/popup.html", "default_title": "Full Stack Assistant", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "popup/popup.html?view=sidepanel"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "service-worker.js"}, "commands": {"autofill": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Option+Shift+F"}, "description": "Autofill form on active page"}, "toggle-passwords": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Option+Shift+P"}, "description": "Toggle password visibility"}, "color-picker": {"description": "Pick color from page"}, "toggle-design-mode": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Option+Shift+D"}, "description": "Toggle Design Mode (editable page)"}, "toggle-id-class": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Option+Shift+I"}, "description": "Toggle ID & Class details overlay"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}