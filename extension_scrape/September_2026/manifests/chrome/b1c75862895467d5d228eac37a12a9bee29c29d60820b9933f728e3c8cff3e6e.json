{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CSV to Google Sheets", "description": "Simple tool to format CSV data for easy pasting into Google Sheets", "version": "1.0.0", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"service_worker": "js/background.js", "type": "module"}, "content_scripts": [{"matches": ["*://docs.google.com/spreadsheets/*"], "js": ["js/content.js"]}], "permissions": ["clipboardWrite"]}