{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FUJI OCR", "version": "1.2.1", "description": "Screenshot-to-text OCR. 20+ languages. Runs 100% locally \u2014 no image or text is ever sent to any server.", "permissions": ["activeTab", "storage", "offscreen", "sidePanel", "downloads"], "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "FUJI OCR", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16-tile.png", "32": "icons/icon32-tile.png", "48": "icons/icon48-tile.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16-tile.png", "32": "icons/icon32-tile.png", "48": "icons/icon48-tile.png", "128": "icons/icon128-tile.png"}, "commands": {"start-ocr": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open side panel and activate region capture"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["ort-wasm*.wasm", "ort-wasm*.mjs", "*.wasm"], "matches": ["chrome-extension://*/*"]}]}