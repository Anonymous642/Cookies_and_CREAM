{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flow TTS | Text to Speech AI", "version": "1.0.2", "description": "A powerful local text-to-speech Chrome extension.", "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["storage", "sidePanel", "alarms", "contextMenus", "webNavigation", "tabs", "offscreen", "scripting"], "optional_permissions": ["system.cpu", "system.memory"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "tts.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["onnx-runtime/*", "models/*", "workers/tts-worker.js", "content.css", "offscreen-tts.js"], "matches": ["<all_urls>"]}]}