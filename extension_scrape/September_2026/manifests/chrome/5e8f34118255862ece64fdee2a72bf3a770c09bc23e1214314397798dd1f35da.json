{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LearnBoost - Ultimate Learning Enhancer", "version": "1.0.0", "description": "Supercharge your learning experience on Udemy, YouTube, Quora & Udacity with 50+ productivity features", "permissions": ["storage", "tabs", "scripting", "activeTab", "downloads", "contextMenus", "notifications"], "host_permissions": ["https://www.udemy.com/*", "https://www.youtube.com/*", "https://www.quora.com/*", "https://www.udacity.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://www.udemy.com/*"], "js": ["content/common.js", "content/udemy.js"], "css": ["content/styles.css"], "run_at": "document_end"}, {"matches": ["https://www.youtube.com/*"], "js": ["content/common.js", "content/youtube.js"], "css": ["content/styles.css"], "run_at": "document_end"}, {"matches": ["https://www.quora.com/*"], "js": ["content/common.js", "content/quora.js"], "css": ["content/styles.css"], "run_at": "document_end"}, {"matches": ["https://www.udacity.com/*"], "js": ["content/common.js", "content/udacity.js"], "css": ["content/styles.css"], "run_at": "document_end"}], "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}