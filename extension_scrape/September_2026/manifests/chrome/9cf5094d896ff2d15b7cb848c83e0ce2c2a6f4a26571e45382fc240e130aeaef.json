{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cope - Bring Notion to your inbox", "version": "1.9.5", "description": "Bring Notion to your inbox. Look up senders and calendar attendees in Notion without leaving Gmail.", "homepage_url": "https://startcope.com/", "permissions": ["sidePanel", "storage", "tabs", "scripting", "alarms"], "host_permissions": ["https://mail.google.com/*", "https://calendar.google.com/*", "https://contacts.google.com/*", "https://startcope.com/extension-auth-success*", "https://startcope.lovable.app/extension-auth-success*"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "Open Cope"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the Cope side panel"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["email-utils.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://calendar.google.com/*", "https://contacts.google.com/widget/*"], "js": ["email-utils.js", "content-calendar.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://startcope.com/extension-auth-success*", "https://startcope.lovable.app/extension-auth-success*"], "js": ["auth-bridge.js"], "run_at": "document_end"}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}