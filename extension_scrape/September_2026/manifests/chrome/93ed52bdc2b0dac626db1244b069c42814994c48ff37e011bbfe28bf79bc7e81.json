{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scholarify", "version": "1.0.0", "description": "Find primary academic sources from Wikipedia references.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "declarativeContent"], "host_permissions": ["*://*.wikipedia.org/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Scholarify", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "content_scripts": [{"matches": ["*://*.wikipedia.org/*"], "js": ["content.js"]}]}