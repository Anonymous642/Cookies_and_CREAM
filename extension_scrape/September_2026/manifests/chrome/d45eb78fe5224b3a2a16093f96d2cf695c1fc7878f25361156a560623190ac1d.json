{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Support Script Builder", "short_name": "ScriptBuilder", "version": "1.1.0", "description": "Generate on-brand AI customer-support replies in Zendesk, Intercom, Freshdesk & HelpScout. Knowledge base, sentiment, CSAT & more.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.zendesk.com/*", "https://app.intercom.com/*", "https://app.intercom.io/*", "https://*.freshdesk.com/*", "https://secure.helpscout.net/*", "https://api.anthropic.com/*", "https://api.freemius.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.anthropic.com https://api.freemius.com"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "AI Support Script Builder", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://*.zendesk.com/*", "https://app.intercom.com/*", "https://app.intercom.io/*", "https://*.freshdesk.com/*", "https://secure.helpscout.net/*"], "js": ["lib/tier.js", "lib/sentiment.js", "content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}