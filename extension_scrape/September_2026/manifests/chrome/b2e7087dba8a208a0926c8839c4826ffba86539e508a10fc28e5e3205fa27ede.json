{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DyslexiaReader", "description": "Convert webpage fonts to dyslexia-friendly typefaces with customizable size, spacing, and colors for better readability.", "version": "1.1", "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["preload-font.js", "content.js"], "css": ["styles.css", "font-inject.css"], "run_at": "document_start", "all_frames": true}], "background": {"service_worker": "background.js"}, "commands": {"toggle-dyslexie": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle DyslexiaReader on/off"}}, "web_accessible_resources": [{"resources": ["fonts/*", "fonts/open_dyslexic/*", "dynamic-inject.css"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"]}