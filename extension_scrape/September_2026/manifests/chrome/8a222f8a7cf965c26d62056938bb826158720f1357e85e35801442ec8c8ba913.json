{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Frejun Chrome Dialler Plugin", "version": "5.4.7", "description": "This plugin can be used to place calls from web pages using Frejun.", "permissions": ["background", "storage", "alarms", "offscreen", "notifications", "idle"], "background": {"service_worker": "serviceWorker.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://*.frejun.com/*", "https://*.whatsapp.com/*", "https://*.zoom.us/*", "https://mail.google.com/*", "https://*.indiamart.com/*", "https://*.freshteam.com/*", "https://*.dynamics.com/*", "https://docs.google.com/*"], "css": ["content.css"], "js": ["content.js"], "all_frames": true}, {"matches": ["https://*.freshteam.com/*", "https://*.indiamart.com/*"], "css": ["content.css"], "js": ["dynamicContent.js"], "all_frames": true}, {"matches": ["https://*.dynamics.com/*", "https://docs.google.com/*"], "css": ["content.css"], "js": ["inputContent.js"], "all_frames": true}], "externally_connectable": {"matches": ["https://*.frejun.com/*"]}, "icons": {"192": "logo192.png"}, "action": {"default_icon": "logo192.png", "default_title": "Popup", "default_popup": "options.html"}, "options_ui": {"page": "options.html"}, "host_permissions": ["*://*.firebase.com/*", "*://*.firebaseio.com/*", "*://*.clevertap-prod.com/*"], "web_accessible_resources": [{"resources": ["popup.html", "mic.html", "mic.js"], "matches": ["<all_urls>"]}]}