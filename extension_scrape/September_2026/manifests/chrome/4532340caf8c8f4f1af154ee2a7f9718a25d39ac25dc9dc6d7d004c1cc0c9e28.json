{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Detox", "short_name": "Reddit Detox", "version": "1.0.4", "description": "Reddit distraction blocker and focus mode: hide ads and recommendations so your feed shows only subscribed subreddits.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Reddit Detox (Focus Mode)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.reddit.com/*", "https://*.reddit.com/*"], "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://*.reddit.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}