{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smol Link Fixer", "version": "1.0.0", "description": "Automatically fixes social media links to a Discord-friendly version, copies the fixed link to clipboard, and shows a popup.", "icons": {"16": "SmolLinkGay128.png", "48": "SmolLinkGay128.png", "128": "SmolLinkGay128.png"}, "permissions": ["activeTab", "clipboardWrite", "clipboardRead"], "action": {"default_title": "Fix current page", "default_popup": "popup.html", "default_icon": {"16": "SmolLinkGay128.png", "48": "SmolLinkGay128.png", "128": "SmolLinkGay128.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://www.twitter.com/*", "https://mobile.twitter.com/*", "https://x.com/*", "https://www.x.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://bsky.app/*", "https://www.bsky.app/*", "https://instagram.com/*", "https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}