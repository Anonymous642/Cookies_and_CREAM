{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Slop Block", "version": "0.12.2", "description": "A free & open source YouTube extension for transparent crowd-sourced content filtering.", "permissions": ["storage", "identity", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_icon": {"16": "icons/simple_icon16.png", "24": "icons/simple_icon32.png", "32": "icons/simple_icon32.png", "48": "icons/simple_icon48.png"}}, "icons": {"16": "icons/simple_icon16.png", "32": "icons/simple_icon32.png", "48": "icons/simple_icon48.png", "128": "icons/slop_busters_icon128.png", "256": "icons/slop_busters_icon256.png"}, "options_page": "options.html", "host_permissions": ["https://*.youtube.com/*", "https://*.supabase.co/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}