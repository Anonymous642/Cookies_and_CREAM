{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Redpen: Report bugs with screenshot/recording", "version": "1.0.78", "offline_enabled": true, "manifest_version": 3, "description": "Capture screenshot and record screen to report bugs and visual feedback.", "action": {"default_icon": {"16": "./assets/logo_16.png", "48": "./assets/logo_48.png", "64": "./assets/logo_64.png", "128": "./assets/logo_128.png"}, "default_title": "Redpen - click to capture (Alt+Shift+X), double click to record (Alt+Shift+D)"}, "background": {"service_worker": "./js/background.js"}, "icons": {"16": "./assets/logo_16.png", "48": "./assets/logo_48.png", "64": "./assets/logo_64.png", "128": "./assets/logo_128.png"}, "content_scripts": [{"matches": ["https://app.redpen.ai/*"], "js": ["./js/redpenContentScript.js"]}, {"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://app.redpen.ai/*"], "js": ["./js/consoleScriptInjector.js", "./js/displayInfoContentScript.js", "./js/videoContentScript.js"]}], "web_accessible_resources": [{"resources": ["/js/browserConsoleReader.js", "/js/videoContentScript.js", "/assets/images/*"], "matches": ["*://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; media-src *; style-src *;"}, "host_permissions": ["*://*/*"], "permissions": ["scripting", "activeTab", "tabs", "storage", "history", "webRequest"], "commands": {"redpen_capture": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Capture a screenshot"}, "redpen_video_record": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Record a video"}}}