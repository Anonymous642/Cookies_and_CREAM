{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ytskim - YouTube Video Summarizer", "version": "1.1.4", "description": "Get AI-powered insights, key takeaways, and summaries directly on YouTube video pages using ytskim.", "permissions": ["storage", "tabs", "downloads"], "host_permissions": ["https://www.youtube.com/*", "http://localhost:3000/*", "https://*.ytskim.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/config.js", "content-scripts/state.js", "content-scripts/utils.js", "content-scripts/ui.js", "content-scripts/api.js", "content-scripts/main.js"], "css": ["content-scripts/styles.css"]}], "action": {"default_title": "ytskim Summary", "default_popup": "popup/popup.html"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/image-1.webp", "assets/image-2.webp", "assets/image-3.webp", "assets/image-error.webp"], "matches": ["*://*.youtube.com/*", "*://youtube.com/*"]}]}