{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PauseCart \u2014 Impulse Purchase Blocker", "version": "1.0.0", "description": "Adds a mindful pause before Amazon purchases. 5 honest questions to help you decide if you really need it. Free, no data collected.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.co.jp/*", "https://www.amazon.co.uk/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.ca/*", "https://www.amazon.com.au/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}