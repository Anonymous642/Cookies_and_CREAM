{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Resparse", "description": "Keeps your CV in the browser, beside the form. Highlight anything in it and drop it straight into the box you are filling.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "offscreen", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "commands": {"open-resparse": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open Resparse on the currently focused field"}}, "action": {"default_title": "Resparse", "default_popup": "popup.html"}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}