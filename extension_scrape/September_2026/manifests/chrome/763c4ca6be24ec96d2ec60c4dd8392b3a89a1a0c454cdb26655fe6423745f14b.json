{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ghost-Job Detector", "version": "0.1.2", "description": "Flags job listings that show ghost-job warning signs on LinkedIn and Indeed, with the reasons. A risk estimate, not a certainty.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.linkedin.com/*", "https://*.indeed.com/*", "https://ghost-job-verdict.jinmathtd.workers.dev/*", "http://localhost:8787/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Ghost-Job Detector", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/job/*", "https://*.indeed.com/*"], "js": ["src/content.js"], "css": ["src/badge.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/onboarding.html"], "matches": ["https://www.linkedin.com/*", "https://*.indeed.com/*"]}]}