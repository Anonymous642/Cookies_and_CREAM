{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FeedFilter", "version": "1.0.0", "description": "Restores clarity to your social media feeds. Filters AI posts, engagement bait, and custom keywords across LinkedIn, X, and Reddit.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["src/classifier.js", "src/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["src/classifier.js", "src/twitter.js"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://reddit.com/*"], "js": ["src/classifier.js", "src/reddit.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}