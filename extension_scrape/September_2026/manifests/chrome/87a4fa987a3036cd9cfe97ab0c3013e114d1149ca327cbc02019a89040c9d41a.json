{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabPilot - Tab Switch + Tab Search", "icons": {"16": "TabPilot 16x16.png", "48": "TabPilot 48x48.png", "128": "TabPilot 128x128.png"}, "version": "1.3.6", "description": "Switch between recent tabs with thumbnail previews", "permissions": ["tabs", "tabGroups", "storage", "alarms", "history", "bookmarks", "nativeMessaging", "scripting"], "web_accessible_resources": [{"resources": ["switcher.html", "switcher.js", "switcher.css", "settings.html"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["overlay.js"], "run_at": "document_start", "all_frames": false}], "background": {"service_worker": "background.js"}, "commands": {"open-switcher": {"suggested_key": {"default": "Alt+Q"}, "description": "Open tab switcher (forward)"}, "open-switcher-back": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Open tab switcher (backward)"}, "open-search": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open tab switcher focused on search"}}}