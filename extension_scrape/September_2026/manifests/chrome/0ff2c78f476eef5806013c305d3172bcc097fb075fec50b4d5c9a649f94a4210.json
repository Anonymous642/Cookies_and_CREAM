{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Field Explorer for Salesforce", "version": "1.0.0", "description": "See where a Salesforce field is used (Flows, Apex, Lightning pages, validation rules, and more) directly on Lightning record pages.", "permissions": ["cookies", "storage"], "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.salesforce.mil/*", "https://*.crmforce.mil/*"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_title": "Field Explorer for Salesforce", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.lightning.force.com/*", "https://*.lightning.crmforce.mil/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}]}