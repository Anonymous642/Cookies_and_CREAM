{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rewiser", "version": "1.0.1", "description": "Add transactions from any tab. Capture prices, speak with AI, and manage your budget effortlessly.", "permissions": ["activeTab", "storage", "scripting", "microphone"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.rewiser.io/*"], "js": ["extension-helper.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Add Transaction to Rewiser", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "config.js"], "matches": ["*://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}