{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shotseek", "version": "1.1.1", "description": "Retina screenshots, done right. Full page, area, or element \u2014 PNG, JPEG, WebP, PDF, Figma tiles, or straight to the clipboard.", "permissions": ["scripting", "activeTab", "downloads", "clipboardWrite", "storage"], "action": {"default_title": "Shotseek \u2014 take a screenshot (Esc closes)"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-shotseek": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle Shotseek on the current page"}, "snap-full": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Capture the full page"}, "snap-visible": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Capture the visible area"}, "snap-selection": {"suggested_key": {"default": "Ctrl+Shift+6", "mac": "Command+Shift+6"}, "description": "Capture a selection (drag a rectangle)"}, "snap-element": {"description": "Capture an element (click to pick)"}}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}