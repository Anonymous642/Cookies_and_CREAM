{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zerotouser Browser Assistant", "description": "Review high-intent X and Reddit conversations, draft a useful reply, and track the next step.", "version": "0.3.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["sidePanel", "storage", "tabs", "scripting", "notifications", "alarms", "webRequest"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://old.reddit.com/*", "https://api.zerotouser.com/*", "https://zerotouser.com/*", "https://www.zerotouser.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["config.js", "content-twitter.js"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://reddit.com/*", "https://old.reddit.com/*"], "js": ["config.js", "content-reddit.js"], "run_at": "document_idle"}]}