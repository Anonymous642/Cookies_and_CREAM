{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Sticky Notes", "description": "Place sticky notes on any web page, reopen them where you left off, and share per-site note collections.", "default_locale": "en", "version": "0.2.0", "minimum_chrome_version": "114", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "sidePanel", "contextMenus", "commands", "downloads"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["content/content.css", "assets/pin.svg"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/dom-anchor.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/panel.html"}, "options_page": "options.html", "action": {"default_title": "Web Sticky Notes", "default_popup": "popup.html"}, "commands": {"toggle-visibility": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Temporarily hide or show all notes"}, "show-side-panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open the Web Sticky Notes side panel"}}}