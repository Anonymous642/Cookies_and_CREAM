{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Advanced Tab Renamer - Custom Names & Icons", "version": "2.0.0", "description": "Rename any tab & set a custom favicon by URL, prefix, or regex. phpMyAdmin DB detection. Bilingual EN/FR. For all users !", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "author": "Maxime BAUDE (@MaximeCode)", "homepage_url": "https://github.com/MaximeCode/Tab_Renamer"}