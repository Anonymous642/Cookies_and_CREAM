{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTamer", "version": "1.1", "description": "AI-powered tab management for productivity enthusiasts", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["tabs", "scripting", "storage", "bookmarks"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"open-tabtamer": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Open TabTamer"}}, "web_accessible_resources": [{"resources": ["tfidf.js"], "matches": ["<all_urls>"]}]}