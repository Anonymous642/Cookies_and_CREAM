{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatForge: Organize AI Chats", "description": "Organize ChatGPT, Claude, Gemini, and Grok chats with local folders, a prompt library, and search. Data stays in your browser.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://grok.x.ai/*", "*://grok.com/*", "*://x.com/i/grok*", "https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "ChatForge", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "run_at": "document_idle", "js": ["content-scripts/chatgpt.js"]}, {"matches": ["*://claude.ai/*"], "run_at": "document_idle", "js": ["content-scripts/claude.js"]}, {"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}, {"matches": ["*://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gemini.js"]}, {"matches": ["*://grok.com/*", "*://grok.x.ai/*", "*://x.com/i/grok*"], "run_at": "document_idle", "js": ["content-scripts/grok.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/chatgpt.css"], "use_dynamic_url": true, "matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"]}, {"resources": ["content-scripts/claude.css"], "use_dynamic_url": true, "matches": ["*://claude.ai/*"]}, {"resources": ["content-scripts/gemini.css"], "use_dynamic_url": true, "matches": ["*://gemini.google.com/*"]}, {"resources": ["content-scripts/grok.css"], "use_dynamic_url": true, "matches": ["*://grok.com/*", "*://grok.x.ai/*", "*://x.com/*"]}]}