{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Supplement Compare", "version": "0.1.0", "description": "Compare supplements on Amazon by price per unit, ingredients, and review trust scores.", "permissions": ["storage"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.com.au/*", "https://*.amazon.ca/*", "https://*.amazon.de/*", "https://api.supplement-compare.shop/*"], "action": {"default_popup": "src/popup/index.html", "default_title": "Supplement Compare"}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.com.au/*", "https://*.amazon.ca/*", "https://*.amazon.de/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/comparison/index.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}