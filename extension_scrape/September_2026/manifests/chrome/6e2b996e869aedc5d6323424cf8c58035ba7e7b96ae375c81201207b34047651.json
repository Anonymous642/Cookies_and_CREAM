{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Workbookly - Make it stick with interactive workbooks", "version": "1.0.8", "description": "Turn YouTube Videos Into Interactive Workbooks in One Click", "icons": {"16": "icons/Workbookly-Themes-16.png", "32": "icons/Workbookly-Themes-32.png", "48": "icons/Workbookly-Themes-48.png", "128": "icons/Workbookly-Themes-128.png"}, "permissions": ["activeTab", "storage", "tabs", "sidePanel"], "host_permissions": ["https://www.youtube.com/*", "https://workbookly.app/*"], "action": {}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}], "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["icons/Workbookly-Themes-16.png", "icons/Workbookly-Themes-32.png", "icons/Workbookly-Themes-48.png", "icons/Workbookly-Themes-128.png", "icons/Workbookly-PaperCheck-Only-16.png", "icons/Workbookly-PaperCheck-Only-32.png", "icons/Workbookly-PaperCheck-Only-48.png", "icons/Workbookly-PaperCheck-Only-128.png"], "matches": ["https://www.youtube.com/*"]}], "externally_connectable": {"matches": ["https://www.youtube.com/*", "https://workbookly.app/*"], "accepts_tls_channel_id": false, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://workbookly.app;"}}}