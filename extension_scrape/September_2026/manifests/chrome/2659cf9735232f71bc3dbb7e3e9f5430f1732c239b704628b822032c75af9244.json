{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SFDC AI Inspect - Salesforce Quick Inspector", "version": "0.1.3", "description": "Salesforce AI inspector & navigator - Press Ctrl+I or click icon to open", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["cookies", "activeTab", "commands", "storage"], "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.visualforce.com/*", "https://*.my.site.com/*", "https://*.lightning.force.com/*"], "action": {"default_title": "Open SFDC AI Inspect", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+I", "mac": "Command+I"}, "description": "Open SFDC AI Inspect palette"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.visualforce.com/*", "https://*.my.site.com/*", "https://*.lightning.force.com/*", "https://*.salesforce-setup.com/*"], "js": ["content-loader.js"], "css": ["content.css", "assets/palette.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content.js", "assets/*", "er_tool.html", "data_tool.html", "log_tool.html", "ai_agent.html", "er_tool.js", "data_tool.js", "log_tool.js", "ai_agent.js"], "matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.visualforce.com/*", "https://*.my.site.com/*", "https://*.lightning.force.com/*", "https://*.salesforce-setup.com/*"]}]}