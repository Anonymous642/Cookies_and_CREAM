{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MikuTube", "description": "Hatsune Miku is taking over YouTube! MikuTube adds a Hatsune Miku image overlay to YouTube thumbnails!", "version": "1.0.0", "developer": {"name": "0x2B"}, "background": {"service_worker": "dist/src/background.js"}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_icon": "assets/icons/icon.png", "default_popup": "popup/miku.html", "default_title": "Go to help.Opera!"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["dist/src/miku.js"]}], "web_accessible_resources": [{"resources": ["assets/images/*.png", "assets/fonts/Poppins/*", "assets/images/miku_beam.gif"], "matches": ["<all_urls>"]}], "permissions": ["storage", "activeTab", "tabs"]}