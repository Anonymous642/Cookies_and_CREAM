{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnipIt \u2014 Screenshot, Screen Recorder & Share", "version": "1.0.4", "minimum_chrome_version": "116", "description": "Capture full pages, regions, tabs and screens. Annotate, trim and share with SnipIt.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications", "unlimitedStorage", "tabCapture", "offscreen", "desktopCapture"], "host_permissions": ["https://snipit.app/*", "https://video.bunnycdn.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "SnipIt", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Command+MacCtrl+U"}, "description": "Capture the full page"}, "capture-visible": {"description": "Capture the visible area", "suggested_key": {"default": "Alt+Shift+I", "mac": "Command+MacCtrl+I"}}, "capture-region": {"suggested_key": {"default": "Alt+Shift+Y", "mac": "Command+MacCtrl+Y"}, "description": "Capture a region"}}}