{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoastWeb", "description": "RoastWeb is a tool that provides insights in UI/UX. It analyzes web pages and provides feedback on design.", "version": "1.0.1", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "RoastWeb", "default_popup": "index.html", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}