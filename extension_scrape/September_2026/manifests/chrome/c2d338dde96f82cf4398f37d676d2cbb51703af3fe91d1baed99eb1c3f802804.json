{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Promtlo: AI Prompt Shortcuts", "short_name": "Promtlo", "version": "1.0.4", "description": "Type //shortcut to paste saved prompts anywhere on the web. Works in ChatGPT, Claude, Gemini, Gmail, Notion and more.", "homepage_url": "https://www.promtlo.com", "permissions": ["storage", "scripting", "clipboardWrite"], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Promtlo", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "all_frames": true, "run_at": "document_start"}], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["page_bridge.js"], "matches": ["<all_urls>"]}]}