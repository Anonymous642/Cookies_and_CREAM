{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bubblener", "description": "Floats the people, places and ideas from the page you're reading as bubbles you can open. Your own AI key, no account, no server.", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "notifications", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Bubblener", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/launcher.js"]}], "host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}]}