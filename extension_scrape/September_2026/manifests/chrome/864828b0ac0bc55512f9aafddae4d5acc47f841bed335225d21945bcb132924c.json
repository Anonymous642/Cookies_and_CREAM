{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedGorillas App Prefix", "version": "1.1.1", "description": "Simple extension to add \"redg.app/\" in front of any sports product URL", "permissions": ["activeTab", "tabs", "notifications"], "background": {"service_worker": "background/background.js"}, "commands": {"add-redg-prefix": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Add redg.app/ prefix to current URL"}}, "action": {"default_popup": "popup/popup.html", "default_title": "Add redg.app/ prefix", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://redg.app/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["content/content.css", "assets/icons/*.png"], "matches": ["<all_urls>"]}], "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}