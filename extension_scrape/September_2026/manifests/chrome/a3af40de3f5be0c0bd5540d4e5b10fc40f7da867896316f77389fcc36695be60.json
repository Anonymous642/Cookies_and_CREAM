{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dumbwaiter", "description": "Sign in without opening your inbox. Fill email codes and open sign-in links from Gmail or Outlook. Requires the Dumbwaiter Mac app.", "version": "1.3.16", "minimum_chrome_version": "119", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "alarms", "clipboardWrite", "nativeMessaging", "scripting", "storage"], "host_permissions": ["https://*/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "action": {"default_title": "Find a sign-in code or link"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Find and fill a recent sign-in code"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["https://*/*", "http://*/*"], "use_dynamic_url": true}]}