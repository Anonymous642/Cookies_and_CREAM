{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT2Doc", "description": "Export ChatGPT conversations locally to editable DOCX and searchable PDF.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "optional_permissions": ["nativeMessaging"], "web_accessible_resources": [{"matches": ["https://chatgpt.com/*"], "resources": ["fonts/*.ttf"]}], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "ChatGPT2Doc", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "run_at": "document_idle", "css": ["content-scripts/chatgpt.css"], "js": ["content-scripts/chatgpt.js"]}]}