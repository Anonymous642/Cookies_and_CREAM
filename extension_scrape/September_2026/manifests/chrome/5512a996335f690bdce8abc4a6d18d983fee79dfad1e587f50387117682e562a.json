{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Adapt Dictionary", "version": "0.10.8", "description": "Definitions that adapt to the sentence and page you are reading.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Adapt Dictionary", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_page": "src/options/options.html", "commands": {"define-selection": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Define the selected text"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": false}]}