{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Feedly Unread", "description": "Monitor your unread article count on Feedly", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["alarms", "storage", "tabs"], "host_permissions": ["https://feedly.com/"], "action": {"default_popup": "src/popup.html"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"js": ["src/content.js"], "matches": ["https://*.feedly.com/*"]}]}