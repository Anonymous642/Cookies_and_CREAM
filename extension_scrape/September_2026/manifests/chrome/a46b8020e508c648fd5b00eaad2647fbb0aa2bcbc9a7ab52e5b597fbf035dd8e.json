{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Math AI Solver \u2013 Screenshot Math Help", "description": "Solve math problems from screenshots with step-by-step AI explanations. Capture websites or PDF pages and ask follow-up questions.", "version": "1.1.6", "short_name": "Math AI", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_locale": "en", "permissions": ["activeTab", "contextMenus", "tabs", "storage", "scripting", "sidePanel"], "host_permissions": ["<all_urls>", "https://www.math-ai.net/*", "https://math-ai.net/*"], "minimum_chrome_version": "114", "action": {"default_title": "Math AI Solver"}, "commands": {"capture-math-problem": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Capture a math problem on the page"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://math-ai.net/*", "https://www.math-ai.net/*"], "run_at": "document_start", "js": ["content-scripts/auth-bridge.js"]}]}