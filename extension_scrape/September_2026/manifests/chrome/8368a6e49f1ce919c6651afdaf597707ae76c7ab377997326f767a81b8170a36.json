{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marmalead Keyword Tool", "version": "1.1", "description": "Give your listings an unfair advantage. Sync Marmalead insights to Corjl with a single tap. Minimal effort, maximum visibility.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["storage", "cookies"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://marmalead.com/*"], "content_scripts": [{"matches": ["https://www.corjl.com/*"], "js": ["content.js", "getKeywords.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["icon16.png", "icon48.png", "assets/images/upgrade.png", "assets/images/mml-icon.png"], "matches": ["https://www.corjl.com/*"]}]}