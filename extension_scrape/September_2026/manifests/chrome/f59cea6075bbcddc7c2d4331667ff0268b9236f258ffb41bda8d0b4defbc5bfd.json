{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LightSync Pro Extension", "short_name": "LSP Extension", "version": "1.1", "description": "Sync the current Adobe Lightroom (cloud) album to your connected WordPress site via LightSync Pro right from the browser.", "permissions": ["activeTab", "identity", "notifications", "scripting", "storage"], "host_permissions": ["https://lightroom.adobe.com/*", "https://lightsyncpro.com/*"], "action": {"default_title": "LightSync Pro Extension", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://lightroom.adobe.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}