{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Shopify Admin Shortcut Access", "version": "1.2.1", "manifest_version": 3, "description": "Quickly jump to the Shopify Admin or Theme Customizer from any page on right-click.", "permissions": ["contextMenus", "activeTab", "clipboardWrite"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"]}], "action": {"default_title": "Shopify Admin Shortcut Access", "default_popup": "popup.html"}, "commands": {"open-admin": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Shopify Admin"}, "open-customizer": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Theme Customizer"}, "copy-preview-link": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Copy Preview Link"}, "clear-cart": {"description": "Clear Shopify Cart"}}}