{"update_url": "https://clients2.google.com/service/update2/crx", "name": "multisearch", "description": "An extension to search on multiple websites simultaneously.", "version": "1.1", "manifest_version": 3, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "page/page.html", "default_icon": "icon.png"}, "content_scripts": [{"js": ["script.js"], "matches": ["https://www.google.com/*"], "all_frames": true}, {"js": ["insert.js"], "matches": ["<all_urls>"], "all_frames": true}], "chrome_url_overrides": {"newtab": "redirect.html"}, "background": {"service_worker": "background.js"}, "commands": {"search-prev": {"suggested_key": {"default": "Alt+Up"}, "description": "Select previous search engine"}, "search-next": {"suggested_key": {"default": "Alt+Down"}, "description": "Select next search engine"}, "open-multiview": {"suggested_key": {"default": "Alt+Tab"}, "description": "Open multisearch page"}}}