{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goto URL Resolver", "version": "1.0.0", "description": "Reveals the real destination behind Google's /goto redirect links on search results, and exports them to CSV.", "minimum_chrome_version": "121", "permissions": ["webRequest", "downloads"], "host_permissions": ["https://www.google.com/*", "https://google.com/*"], "action": {"default_popup": "popup.html", "default_title": "Goto URL Resolver", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://google.com/search*"], "js": ["content.js"], "run_at": "document_idle"}]}