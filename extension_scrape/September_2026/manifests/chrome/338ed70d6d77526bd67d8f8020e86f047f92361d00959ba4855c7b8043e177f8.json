{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TruthCart - Smart Keyword Scanner", "version": "2.6", "description": "Scans product pages for keywords like 'batteries not included' and unverified seller terms.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.in/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.etsy.com/*", "*://*.walmart.com/*", "*://*.aliexpress.com/*", "*://*.target.com/*", "*://*.bestbuy.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "include_globs": ["*://*.amazon.*/*", "*://*.ebay.*/*", "*://*.walmart.*/*", "*://*.aliexpress.*/*", "*://*.target.*/*", "*://*.bestbuy.*/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_icon": "icon.png", "default_popup": "popup.html"}}