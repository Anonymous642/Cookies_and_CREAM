{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickReply \u2014 Email Template Inserter", "description": "40-template starter library, smart variables ({{date+3d}}, conditionals, cursor) and a sidepanel workbench. 100% local.", "version": "2.0.2", "icons": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "sidePanel"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open-sidepanel": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open the QuickReply sidepanel"}, "insert-favorite-1": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Insert favorite template #1"}, "insert-favorite-2": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Insert favorite template #2"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "QuickReply", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/inserter.js"]}]}