{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Product Inspector", "version": "1.0.0", "description": "Inspect Amazon product details and save & compare listings.", "permissions": ["storage"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.in/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.in/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}