{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pipette \u2014 Color Picker & Gradient Studio", "version": "1.0.0", "description": "Pixel-zoom eyedropper, color picker, CSS gradient builder and page palette analyzer. Never asks to read all your websites.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Pipette", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["picker.css"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"pick-color": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pick a color from the current page"}}, "minimum_chrome_version": "102"}