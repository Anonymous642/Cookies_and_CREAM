{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot Tool - Full Page Capture & Editor", "version": "1.0.0", "description": "Capture full page, scrolling & region screenshots. Annotate, crop, export to PNG, JPEG or PDF. Free screenshot extension for Chrome.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Screenshot Tool"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "downloads", "scripting"], "optional_permissions": ["clipboardWrite"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Capture visible area"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Capture full page"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Capture selected area"}}}