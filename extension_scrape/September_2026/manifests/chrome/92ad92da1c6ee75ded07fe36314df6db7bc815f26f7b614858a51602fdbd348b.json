{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sira", "version": "2.0.0", "description": "Sira builds your digital wardrobe automatically by syncing fashion orders from Myntra, Flipkart, Amazon, Nykaa & more.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://localhost/*", "*://*.myntra.com/*", "*://*.savana.com/*", "*://*.flipkart.com/*", "*://*.nykaafashion.com/*", "*://*.amazon.in/*", "*://*.hm.com/*", "*://*.meesho.com/*", "*://*.ajio.com/*"], "externally_connectable": {"matches": ["https://closetsync.fit/*", "https://www.closetsync.fit/*", "https://wardrobe-web-shristi.fly.dev/*", "http://localhost:3000/*", "http://localhost:5173/*", "http://localhost:8000/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.myntra.com/my/orders*", "*://*.myntra.com/profile/orders*", "*://*.myntra.com/orders*"], "js": ["content_scripts/myntra.js"], "run_at": "document_start"}, {"matches": ["*://*.savana.com/order/list*"], "js": ["content_scripts/savana.js"], "run_at": "document_idle"}, {"matches": ["*://*.flipkart.com/*"], "js": ["content_scripts/flipkart.js"], "run_at": "document_idle"}, {"matches": ["*://*.nykaafashion.com/my/orders*"], "js": ["content_scripts/nykaa.js"], "run_at": "document_start"}, {"matches": ["*://*.amazon.in/gp/your-account/order-history*"], "js": ["content_scripts/amazon.js"], "run_at": "document_idle"}, {"matches": ["*://*.hm.com/*"], "js": ["content_scripts/hm.js"], "run_at": "document_idle"}, {"matches": ["*://*.meesho.com/orders*"], "js": ["content_scripts/meesho.js"], "run_at": "document_idle"}, {"matches": ["*://*.ajio.com/*"], "js": ["content_scripts/ajio.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://