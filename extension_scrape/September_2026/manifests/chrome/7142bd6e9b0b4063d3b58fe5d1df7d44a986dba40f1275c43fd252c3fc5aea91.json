{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobRadar - Smart Job Tracker", "version": "1.0.0", "description": "Track latest job postings from LinkedIn and Naukri based on your filters", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://www.naukri.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content-linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.naukri.com/*"], "js": ["content-naukri.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}