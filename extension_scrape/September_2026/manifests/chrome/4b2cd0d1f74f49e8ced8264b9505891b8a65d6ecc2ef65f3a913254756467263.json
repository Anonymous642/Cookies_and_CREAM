{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "4chan /tttt/", "description": "Shows /lgbt/ as /tttt/ on 4chan. /tttt/ URLs redirect to the real board.", "version": "1.2.2", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["*://boards.4chan.org/*", "*://boards.4channel.org/*", "*://4chan.org/*", "*://www.4chan.org/*", "*://4channel.org/*", "*://www.4channel.org/*"], "declarative_net_request": {"rule_resources": [{"id": "tttt_redirects", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://boards.4chan.org/*", "*://boards.4channel.org/*", "*://www.4chan.org/*", "*://www.4channel.org/*", "*://4chan.org/*", "*://4channel.org/*", "*://sys.4chan.org/*", "*://sys.4channel.org/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}