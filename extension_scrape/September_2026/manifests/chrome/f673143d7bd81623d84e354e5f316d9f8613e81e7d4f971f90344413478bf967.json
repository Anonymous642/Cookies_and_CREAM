{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Maple \u2014 Honest Price Tracker", "description": "Track prices on Amazon and Newegg. Get alerted at your target price. Funded by Pro users, not your purchases \u2014 no affiliate games.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["*://*.amazon.com/*", "*://*.newegg.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Maple", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.newegg.com/*"], "run_at": "document_idle", "js": ["content-scripts/product.js"]}]}