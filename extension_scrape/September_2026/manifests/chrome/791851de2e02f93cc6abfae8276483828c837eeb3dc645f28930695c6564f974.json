{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Full Page Screenshot & Screen Capture - CaptureAPI", "version": "1.0.1", "description": "Capture full page, visible screen, or selected area screenshots directly in Chrome.", "icons": {"16": "icons/logo16.png", "32": "icons/logo32.png", "48": "icons/logo48.png", "128": "icons/logo128.png"}, "action": {"default_popup": "index.html", "default_title": "Capture Screen", "default_icon": {"16": "icons/logo16.png", "32": "icons/logo32.png", "48": "icons/logo48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "downloads", "scripting"], "web_accessible_resources": [{"resources": ["sounds/capture.mp3"], "matches": ["http://*/*", "https://*/*", "file:///*"]}], "commands": {"capture-viewport": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible viewport"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page screenshot"}, "start-area-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start area selection mode"}}}