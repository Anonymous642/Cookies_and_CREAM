{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jsonade \u2014 JSON & JSONL Viewer", "version": "1.0.0", "description": "View JSON, JSONL and data embedded in any page: tree, search, copy path, repair broken JSON. No network, no accounts, offline.", "permissions": ["activeTab", "storage", "scripting", "contextMenus"], "action": {"default_popup": "popup/popup.html", "default_title": "Jsonade", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"view-current-tab": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "View the current tab as JSON"}}}