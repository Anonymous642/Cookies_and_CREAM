{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkShelf", "description": "Park tabs, organize useful links, and return to them at the right time.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "notifications", "tabs", "bookmarks", "sidePanel"], "commands": {"park-current-tab": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}, "description": "Park the current tab in the default project"}, "toggle-side-panel": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Open or close LinkShelf"}, "open-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open LinkShelf search"}, "open-today": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open LinkShelf Today"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "LinkShelf", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}}