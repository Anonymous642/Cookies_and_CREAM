{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Catodoro", "version": "1.2.0", "description": "Pomodoro timer, tasks and sticky notes in your toolbar - with floating always-on-top windows. Earn a cat for every focus session.", "homepage_url": "https://catodoro.app", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Catodoro", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "alarms", "notifications", "offscreen", "identity"], "commands": {"toggle-timer": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Start or pause the timer"}, "reset-timer": {"description": "Reset the timer"}}}