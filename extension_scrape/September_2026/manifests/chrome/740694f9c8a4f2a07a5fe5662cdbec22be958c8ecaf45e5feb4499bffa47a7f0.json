{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CaptureIt", "version": "1.0.2", "description": "Full page screenshots, video recording, and cropping - all in one extension", "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["editor/editor.html", "editor/editor.css", "editor/editor.js"], "matches": ["<all_urls>"]}], "commands": {"take-screenshot": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Take full page screenshot"}, "start-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Start/Stop video recording"}}}