{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SafariLike StartPage", "version": "1.0.1", "description": "Change the start page into a more safari like one. (Reading list, custom background image, bookmarks, last visited/recently closed.)", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["bookmarks", "topSites", "history", "storage", "unlimitedStorage", "sessions", "readingList", "favicon"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "SafariLike StartPage", "default_icon": "icon.png"}, "web_accessible_resources": [{"resources": ["newtab.js", "newtab.css", "icon.png", "index.html", "assets/*"], "matches": ["<all_urls>"]}]}