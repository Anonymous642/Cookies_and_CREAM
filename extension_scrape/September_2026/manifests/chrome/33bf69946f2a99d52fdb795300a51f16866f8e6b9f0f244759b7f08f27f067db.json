{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HostGIC \u2014 Airbnb Automation", "version": "1.1.3", "description": "Connect your Airbnb account for AI guest replies and pricing, plus live competitor comparison on search results.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["cookies", "tabs"], "host_permissions": ["https://*.airbnb.com/*", "https://*.airbnb.com.pe/*", "https://*.airbnb.com.co/*", "https://*.airbnb.com.mx/*", "https://*.airbnb.com.ar/*", "https://*.airbnb.com.br/*", "https://*.airbnb.cl/*", "https://*.airbnb.com.uy/*", "https://www.hostgic.com/*", "https://hostgic.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["https://*.airbnb.com/*", "https://*.airbnb.com.pe/*", "https://*.airbnb.com.co/*", "https://*.airbnb.com.mx/*", "https://*.airbnb.com.ar/*", "https://*.airbnb.com.br/*", "https://*.airbnb.cl/*", "https://*.airbnb.com.uy/*"], "js": ["content.js"], "run_at": "document_idle"}]}