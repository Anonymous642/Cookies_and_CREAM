{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GhostPick \u2013 No-Code Web Scraper", "version": "1.1.4", "description": "Visual no-code web scraper. Auto-detect elements, paginate results, and export data as CSV, XLSX, or JSON.", "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "tabs", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/background.js"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"start-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start element selection on current page"}, "auto-detect": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Auto-detect data lists on current page"}}, "web_accessible_resources": [{"resources": ["shared/icons.js", "content/selector.css", "results/results.html", "results/results.css", "results/results.js", "sidepanel/sidepanel.html"], "matches": ["<all_urls>"]}]}