{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TripSapien \u2014 Send to Google Maps", "version": "1.3.0", "description": "Send selected mappable places from a reviewed TripSapien itinerary to a private Google Maps saved list in your browser.", "key": "", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.google.com/maps*"], "js": ["maps-automation.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://www.google.com/*"], "externally_connectable": {"matches": ["https://www.tripsapien.com/*", "https://tripsapien.com/*", "http://localhost/*"]}, "action": {"default_title": "TripSapien \u2192 Google Maps", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}