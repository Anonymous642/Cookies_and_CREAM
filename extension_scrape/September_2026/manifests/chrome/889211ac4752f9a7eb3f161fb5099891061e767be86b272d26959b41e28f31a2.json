{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Markbook", "description": "Private Bookmarks For Life", "version": "2.2.20", "minimum_chrome_version": "88", "manifest_version": 3, "incognito": "spanning", "background": {"service_worker": "build/background.js", "type": "module"}, "permissions": ["activeTab", "bookmarks", "commands", "contextMenus", "favicon", "notifications", "offscreen", "storage", "tabs", "unlimitedStorage", "idle"], "icons": {"32": "assets/images/favicon-32x32.png"}, "action": {"default_title": "Markbook", "default_popup": "popup.html", "default_icon": "assets/images/favicon-32x32.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Down"}, "description": "Open the Markbook extension"}, "create_shortmark": {"suggested_key": {"default": "Ctrl+Up"}, "description": "Shortmark the current page."}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}