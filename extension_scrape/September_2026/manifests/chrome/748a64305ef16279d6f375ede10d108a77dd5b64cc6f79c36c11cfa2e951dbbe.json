{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GrabFrame - Screenshot, Record & OCR", "version": "1.0.18", "description": "Full page, visible, region, or element screenshots. Tab recording, editing, and local OCR. No cloud.", "permissions": ["activeTab", "contextMenus", "tabCapture", "scripting", "storage", "unlimitedStorage", "downloads", "offscreen"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "src/assets/icons/icon16.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js"}, "commands": {"show-picker": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Show capture options"}}, "icons": {"16": "src/assets/icons/icon16.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["src/lib/tesseract/*"], "matches": ["<all_urls>"], "extension_ids": []}]}