{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Invitation Assistant", "description": "Locally processes pending LinkedIn invitations after explicit user consent.", "version": "1.0.0", "minimum_chrome_version": "120", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Invitation Assistant", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/mynetwork/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}}