{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rulerify", "short_name": "Rulerify", "version": "1.0.0", "description": "Measure anything on a webpage with a clean digital ruler. Box, line, circle, angle, and inspect modes.", "homepage_url": "https://rulerify.com/", "author": "Rulerify", "minimum_chrome_version": "114", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Rulerify \u2014 measure this page", "default_icon": {"16": "icons/off16.png", "32": "icons/off32.png", "48": "icons/off48.png", "128": "icons/off128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle Rulerify on this page"}}, "web_accessible_resources": [{"resources": ["content/content.css"], "matches": ["http://*/*", "https://*/*"]}]}