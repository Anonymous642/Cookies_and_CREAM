{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EasyCap - Screenshot and Screen Editor App", "version": "1.0.0", "description": "Screenshot tool: capture pages, regions, or screen. 15+ tools: drawing, text, shapes, arrows, blur, crop. Export PNG/JPEG/PDF.", "action": {"default_icon": "icons/icon16.png", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "minimum_chrome_version": "109", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "clipboardRead"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["editor.html", "icons/*.svg", "fonts/*", "src/i18n/locales/*.json"], "matches": ["<all_urls>"]}]}