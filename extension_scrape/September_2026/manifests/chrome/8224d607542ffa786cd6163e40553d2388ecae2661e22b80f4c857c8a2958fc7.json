{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FeedWise", "version": "1.0.3", "description": "Transform your social media feeds into daily wisdom with Readwise highlights and Obsidian notes.", "author": "FeedWise Team", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "webNavigation", "scripting"], "host_permissions": ["https://readwise.io/*", "https://read.readwise.io/*"], "optional_permissions": ["fileSystem"], "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://twitter.com/*", "*://*.x.com/*", "*://x.com/*", "*://*.instagram.com/*", "*://instagram.com/*", "*://*.reddit.com/*", "*://reddit.com/*"], "js": ["quotes.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["propane-backgrounds/*.jpg", "propane-fonts/*.otf", "propane-theme.css"], "matches": ["<all_urls>"]}], "chrome_url_overrides": {"newtab": "newtab.html"}}