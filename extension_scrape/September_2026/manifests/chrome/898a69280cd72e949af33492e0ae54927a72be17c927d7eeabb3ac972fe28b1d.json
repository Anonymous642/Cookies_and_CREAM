{"action": {"default_popup": "popup.html", "default_title": "Quick Clipboard"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"description": "Open Quick Clipboard", "suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}}}, "content_scripts": [{"js": ["content.js"], "matches": ["<all_urls>"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "description": "Manage your clipboard history and templates efficiently.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "manifest_version": 3, "name": "Quick Clipboard \u2013 Clipboard History & Copy Paste Manager", "permissions": ["storage", "clipboardRead", "clipboardWrite", "offscreen", "alarms", "activeTab"], "update_url": "https://clients2.google.com/service/update2/crx", "version": "1.7.0"}