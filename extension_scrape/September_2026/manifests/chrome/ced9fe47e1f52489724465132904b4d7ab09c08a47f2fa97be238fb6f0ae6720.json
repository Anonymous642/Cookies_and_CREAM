{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FoxSpark", "description": "AI-powered draft generator for X/Twitter \u2014 craft on-brand posts with your unique voice, trending topics, and smart suggestions.", "version": "0.1.0", "permissions": ["storage", "tabs", "sidePanel"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api-foxspark.tomo.services/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api-foxspark.tomo.services"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "panel.html"}, "options_page": "options.html", "action": {"default_title": "FoxSpark", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}