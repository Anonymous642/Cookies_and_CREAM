{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Viewmento - YouTube Video Highlighter", "short_name": "Viewmento", "version": "1.6.2", "description": "Viewmento helps you remember what you view on YouTube. Highlight key video moments, review and build learning streaks.", "background": {"service_worker": "background.js"}, "permissions": ["storage", "alarms", "sidePanel"], "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["transcript_bridge.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["transcript.js", "content.js"], "css": ["styles.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon128.png", "48": "icon128.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["icon48.png"], "matches": ["*://*.youtube.com/*"]}]}