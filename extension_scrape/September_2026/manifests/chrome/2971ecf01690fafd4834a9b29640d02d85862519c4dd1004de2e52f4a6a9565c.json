{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptLens", "description": "Capture screenshots, extract text locally with OCR, record browser workflows, and send context to AI assistants.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "scripting", "offscreen", "storage", "tabCapture", "clipboardWrite"], "host_permissions": ["*://chatgpt.com/*", "*://*.chatgpt.com/*", "*://claude.ai/*", "*://*.claude.ai/*", "*://gemini.google.com/*", "*://grok.com/*", "*://*.grok.com/*", "*://x.com/*", "*://*.x.com/*", "*://perplexity.ai/*", "*://*.perplexity.ai/*", "<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "commands": {"visual-snip": {"suggested_key": {"default": "Alt+S"}, "description": "Trigger visual screenshot selection overlay"}, "ocr-snip": {"suggested_key": {"default": "Alt+O"}, "description": "Trigger visual selection overlay for OCR text extraction"}}, "action": {"default_title": "PromptLens - Dashboard", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["tesseract/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.chatgpt.com/*", "*://*.claude.ai/*", "*://*.grok.com/*", "*://*.perplexity.ai/*", "*://*.x.com/i/grok", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://grok.com/*", "*://perplexity.ai/*", "*://x.com/i/grok"], "js": ["content-scripts/content.js"]}, {"matches": ["<all_urls>"], "all_frames": false, "js": ["content-scripts/overlay.js"]}]}