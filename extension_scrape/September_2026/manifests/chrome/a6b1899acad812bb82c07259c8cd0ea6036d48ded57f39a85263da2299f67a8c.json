{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Apollo.io Data Scraper | Auto Formatted CSV Export for Apollo", "version": "2.0.1", "manifest_version": 3, "description": "Apollo Data Scraper extracts contact data from Apollo.io and exports it as CSV files with correctly formatted columns", "action": {"default_icon": "apollo-icon-64.png", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage", "scripting", "tabs", "notifications"], "incognito": "split", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "apollo-icon-16.png", "32": "apollo-icon-32.png", "64": "apollo-icon-64.png", "128": "apollo-icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["onload.css"], "js": ["js/jquery-3.1.1.min.js", "js/sha256.min.js", "onload.js"]}], "host_permissions": ["*://app.apollo.io/*", "*://*.apollo.io/*", "*://api.gumroad.com/*", "*://*.gumroad.com/*"]}