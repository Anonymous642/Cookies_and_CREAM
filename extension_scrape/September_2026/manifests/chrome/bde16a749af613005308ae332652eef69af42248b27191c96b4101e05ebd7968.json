{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Hide YouTube Player Controls for Videos & Shorts", "description": "Hide overlaying elements on YouTube and Shorts players (scrollbar, buttons, gradients, titles, etc.) with a single shortcut.", "version": "1.2", "manifest_version": 3, "action": {"default_popup": "main.html", "default_icon": "img/icon128.png"}, "commands": {"toggle-controls": {"suggested_key": {"default": "Alt+H"}, "description": "Hide YouTube Video Player Controls"}}, "permissions": ["activeTab"], "background": {"service_worker": "js/background.js"}, "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["js/content.js"]}]}