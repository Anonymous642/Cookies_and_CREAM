{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Transllmator", "version": "1.0.0", "description": "Translate or rewrite text with an OpenAI-compatible LLM endpoint from a popup or directly inside web page text fields.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Transllmator", "default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "24": "assets/icon24.png", "32": "assets/icon32.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"translate-active-field": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Translate the active text field with the selected configuration"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}