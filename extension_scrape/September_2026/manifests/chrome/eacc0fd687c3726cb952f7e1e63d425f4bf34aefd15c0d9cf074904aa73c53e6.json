{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Secondbrain Web Clipper", "version": "1.4.0", "description": "Guard\u00e1 cualquier p\u00e1gina en Secondbrain: se limpia, se resume y se archiva sola en tu workspace.", "minimum_chrome_version": "102", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Guardar en Secondbrain", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "externally_connectable": {"matches": ["https://workspace.secondbrain.media/*", "*://localhost/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Abrir el clipper en la p\u00e1gina actual"}, "clip-now": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Guardar la p\u00e1gina sin abrir el popup"}}}