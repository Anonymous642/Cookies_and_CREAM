{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Color Picker", "description": "Click the icon to instantly pick any color and copy it to your clipboard.", "version": "1.0", "manifest_version": 3, "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Pick Color"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"pick-color": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Activate Color Picker"}}, "web_accessible_resources": [{"resources": ["color-names.json", "images/play-solid-full.svg", "images/pause-solid-full.svg"], "matches": ["<all_urls>"]}]}