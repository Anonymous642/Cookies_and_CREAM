{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bug Reporter", "version": "1.6.9", "description": "Report bugs on any website: screenshots, recorded steps, technical logs, and voice-narrated video \u2014 in one shareable report.", "action": {"default_title": "Report a bug on this page"}, "side_panel": {"default_path": "popup.html"}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "storage", "identity", "sidePanel", "downloads"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://findbugs.app/*", "https://beta.findbugs.app/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["dashboard-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_permissions": ["nativeMessaging"], "optional_host_permissions": ["http://*/*", "https://*/*", "<all_urls>"]}