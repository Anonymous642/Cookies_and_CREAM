{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "eBay with Awais", "version": "4.1.0", "description": "Order Processing, Profit Tracking, and Order Cancellation \u2014 all in one.", "minimum_chrome_version": "114", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "clipboardRead", "clipboardWrite", "sidePanel", "downloads"], "host_permissions": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.de/*", "*://*.ebay.fr/*", "*://*.aliexpress.com/*", "*://*.aliexpress.us/*", "*://*.alibaba.com/*", "https://pjavyjyagxfkwzzpxzzk.supabase.co/*", "*://*.ebaydesc.com/*", "*://web.whatsapp.com/*", "*://i.ebayimg.com/*"], "side_panel": {"default_path": "popup.html"}, "action": {"default_title": "eBay with Awais", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.de/*", "*://*.ebay.fr/*"], "js": ["content_ebay_profit.js"], "run_at": "document_idle"}, {"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.de/*", "*://*.ebay.fr/*"], "js": ["content_ebay_address.js"], "run_at": "document_idle"}, {"matches": ["*://*.ebay.co.uk/sch/i.html*", "*://*.ebay.co.uk/bin/purchaseHistory*"], "js": ["content_ebay_demand.js"], "run_at": "document_idle"}, {"//": "Auto Popularity Sort \u2014 eBay search results ki list ko sold/watchers se tarteeb deta hai.", "matches": ["*://*.ebay.com/sch/*", "*://*.ebay.co.uk/sch/*", "*://*.ebay.ca/sch/*", "*://*.ebay.de/sch/*", "*://*.ebay.fr/sch/*"], "js": ["content_ebay_popularity.js"], "run_at": "document_idle"}, {"//": "Sold History button \u2014 HAR eBay site ke listing page par. ebay_sold_core.js pehle load hota hai; UI us ke functions istemal karti hai.", "matches": ["*://*.ebay.com/itm/*", "*://*.ebay.co.uk/itm/*", "*://*.ebay.ca/itm/*", "*://*.ebay.de/itm/*", "*://*.ebay.fr/itm/*"], "js": ["ebay_sold_core.js", "content_ebay_sold_history.js"], "run_at": "document_idle"}, {"//": "Listing toolbar \u2014 Purchase history / X-Ray / Profit calculator / Download images / image search. Profit drawer pehle load hota hai, toolbar us ka aeTbOpenProfit bulata hai.", "matches": ["*://*.ebay.com/itm/*", "*://*.ebay.co.uk/itm/*", "*://*.ebay.ca/itm/*", "*://*.ebay.de/itm/*", "*://*.ebay.fr/itm/*"], "js": ["ebay_sold_core.js", "content_ebay_profit_drawer.js", "content_ebay_toolbar.js"], "run_at": "document_idle"}, {"//": "Analytics + graphs \u2014 eBay ke APNE purchase-history safhe par (button wahin le jata hai).", "matches": ["*://*.ebay.com/bin/purchaseHistory*", "*://*.ebay.co.uk/bin/purchaseHistory*", "*://*.ebay.ca/bin/purchaseHistory*", "*://*.ebay.de/bin/purchaseHistory*", "*://*.ebay.fr/bin/purchaseHistory*"], "js": ["ebay_sold_core.js", "content_ebay_sold_panel.js"], "run_at": "document_idle"}, {"matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"], "js": ["content_aliexpress.js"], "run_at": "document_idle"}, {"//": "Bundle/upsell page ko seedha product page se badal deta hai. document_start par \u2014 taake bundle page render hone se pehle hi nikal jayein.", "matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"], "js": ["content_ali_skip_bundle.js"], "run_at": "document_start"}, {"//": "Har product page ko owner ke affiliate link se guzarta hai. Sirf /item/<id>.html par, aur Settings ka switch band ho to bilkul nahi. document_start par \u2014 warna banda safha dekh chuka hota hai aur phir uchhal jata.", "matches": ["*://*.aliexpress.com/item/*", "*://*.aliexpress.us/item/*"], "js": ["content_ali_affiliate_all.js"], "run_at": "document_start"}, {"matches": ["https://www.aliexpress.com/p/refund-cancel/*", "https://www.aliexpress.us/p/refund-cancel/*"], "js": ["content_cancel.js"], "run_at": "document_idle"}, {"matches": ["*://*.ebay.com/cnt/ViewMessage*", "*://*.ebay.co.uk/cnt/ViewMessage*", "*://*.ebay.ca/cnt/ViewMessage*", "*://*.ebay.de/cnt/ViewMessage*", "*://*.ebay.fr/cnt/ViewMessage*"], "js": ["content_ebay_messages.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["*://*.aliexpress.com/item/*", "*://*.aliexpress.us/item/*", "*://*.aliexpress.com/p/order/*", "*://*.aliexpress.us/p/order/*", "*://*.aliexpress.com/p/trade/*", "*://*.aliexpress.us/p/trade/*"], "js": ["content_ali_autobuy.js"], "run_at": "document_idle"}, {"matches": ["*://web.whatsapp.com/*"], "js": ["content_whatsapp.js"], "run_at": "document_idle"}, {"//": "Image search \u2014 sirf tab chalti hai jab URL me ?ae_img_search=1 ho. Site ka apna picker bhar deti hai, upload site khud karti hai.", "matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*", "*://*.alibaba.com/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.de/*", "*://*.ebay.fr/*"], "js": ["content_img_search.js"], "run_at": "document_idle"}]}