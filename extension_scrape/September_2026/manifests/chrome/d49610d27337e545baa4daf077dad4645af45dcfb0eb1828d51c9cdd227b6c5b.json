{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Negative Split for Strava", "description": "Free, local training analytics on your own Strava runs: rTSS, GAP, zones, age-graded PBs, VDOT, a shareable Run Card. No upload.", "version": "1.4.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.strava.com/*"], "web_accessible_resources": [{"resources": ["archetypes/*.webp"], "matches": ["https://www.strava.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Negative Split", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.strava.com/activities/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://www.strava.com/activities/*/edit"], "run_at": "document_idle", "js": ["content-scripts/edit.js"]}, {"matches": ["https://www.strava.com/dashboard*"], "run_at": "document_idle", "js": ["content-scripts/home.js"]}, {"matches": ["https://www.strava.com/activities/*", "https://www.strava.com/clubs/*", "https://www.strava.com/dashboard*"], "run_at": "document_idle", "js": ["content-scripts/kudos.js"]}, {"matches": ["https://www.strava.com/*"], "run_at": "document_idle", "js": ["content-scripts/nav.js"]}, {"matches": ["https://www.strava.com/athletes/*"], "run_at": "document_idle", "js": ["content-scripts/profile.js"]}]}