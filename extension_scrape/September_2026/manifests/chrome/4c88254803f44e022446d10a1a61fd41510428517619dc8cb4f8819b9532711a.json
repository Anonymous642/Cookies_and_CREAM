{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Caraokay - YouTube Queue for Karaoke & Video Marathons", "description": "Auto-plays queued YouTube videos, detects when they end, and loads the next from the Caraokay queue for karaoke and video marathons.", "version": "3.3.0", "permissions": ["storage", "debugger", "windows"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://caraokay.site/room/*", "https://api.caraokay.site/*", "https://caraokay-api-244569924008.us-central1.run.app/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Caraokay", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*", "*://m.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://caraokay.site/room/*"], "js": ["presenter.js"], "run_at": "document_idle"}, {"matches": ["https://caraokay.site/*"], "js": ["site-detector.js"], "run_at": "document_start"}]}