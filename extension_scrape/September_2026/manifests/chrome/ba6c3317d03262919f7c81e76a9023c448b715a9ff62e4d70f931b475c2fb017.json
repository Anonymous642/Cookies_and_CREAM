{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EasyApply - Job URL Autofiller", "version": "1.0.0", "description": "Save GitHub/LinkedIn/Portfolio once. Autofill or quick-copy on any job form.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"copy_github": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Copy GitHub URL to clipboard"}, "copy_linkedin": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Copy LinkedIn URL to clipboard"}, "copy_website": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Copy Portfolio URL to clipboard"}}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}}