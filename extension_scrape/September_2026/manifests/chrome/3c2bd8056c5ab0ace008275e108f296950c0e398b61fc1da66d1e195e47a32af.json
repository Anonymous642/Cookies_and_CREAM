{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Moxby", "version": "3.2.0", "description": "A workspace where you and your AI agent work in context: Mods, Missions, and chat on any site via ChatGPT, Claude, or OpenRouter.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "minimum_chrome_version": "120", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Moxby \u2014 Alt+Shift+D to toggle chat", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.moxby.localhost/*"], "js": ["content-script.js"], "run_at": "document_idle"}, {"matches": ["*://*.moxby.localhost/*"], "js": ["mod-relay.js"], "run_at": "document_start", "all_frames": true}], "permissions": ["sidePanel", "storage", "nativeMessaging", "scripting", "webNavigation", "userScripts", "contextMenus", "tabGroups", "webRequest", "debugger", "cookies", "unlimitedStorage", "alarms", "notifications", "downloads", "offscreen"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://account.moxby.com/*"]}, "web_accessible_resources": [{"resources": ["sidepanel.html", "component-preview.html", "mod-reference-preview.html", "assets/*", "icons/*", "logos/*"], "matches": ["<all_urls>"]}], "commands": {"download-debug-logs": {"suggested_key": {"default": "Ctrl+D", "mac": "Command+D"}, "description": "Download Moxby debug logs"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Open or close the Moxby side panel"}, "toggle-moxby-dock": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open or cl