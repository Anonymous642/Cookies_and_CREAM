{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MaxView (Fullscreen anything)", "version": "3.2.2", "author": "MaxView", "description": "Send any video, image, canvas or embedded game to fullscreen on any page.", "icons": {"16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["css/style.css"], "js": ["js/content.js"], "run_at": "document_idle", "all_frames": true}], "background": {"service_worker": "js/background.js"}, "action": {"default_icon": {"19": "img/icon19.png", "38": "img/icon38.png"}, "default_title": "Toggle MaxView Fullscreen"}, "commands": {"toggle-fullscreen": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Toggle MaxView Fullscreen"}}}