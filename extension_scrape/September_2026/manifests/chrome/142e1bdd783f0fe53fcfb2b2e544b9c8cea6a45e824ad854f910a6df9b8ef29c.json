{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Secret Study Buddy \u2014 AI Study Assistant", "short_name": "Study Buddy", "version": "1.3.5", "description": "Highlight a question on any page or screenshot a problem, and get a clear, step-by-step explanation in the side panel.", "minimum_chrome_version": "116", "homepage_url": "https://secretstudybuddy.com", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "activeTab", "scripting", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "Ask Secret Study Buddy", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"capture-question": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Screenshot a question"}, "_execute_action": {"description": "Open Secret Study Buddy"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}