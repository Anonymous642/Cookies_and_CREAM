{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Key", "version": "2.3.1", "description": "A local-first focus workspace with YouTube and Instagram distraction controls, study tools, site blocking, and private insights.", "permissions": ["alarms", "declarativeNetRequest", "storage", "search", "notifications"], "optional_permissions": ["idle", "tabs"], "host_permissions": ["https://*.youtube.com/*"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.ytimg.com; connect-src 'self' https://*.youtube.com; object-src 'none'; frame-src 'none';"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "home.html"}, "web_accessible_resources": [{"resources": ["videos.html", "cooldown.html"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content_youtube_router.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/@*/videos", "*://*.youtube.com/*/videos", "*://*.youtube.com/channel/*/videos", "*://*.youtube.com/user/*/videos", "*://*.youtube.com/c/*/videos"], "js": ["channel-recommender.js", "content_youtube_channel.js"], "run_at": "document_end"}, {"matches": ["*://*.youtube.com/watch*"], "css": ["styles_youtube.css"], "js": ["channel-recommender.js", "content_youtube_video.js"], "run_at": "document_end"}, {"matches": ["*://*.instagram.com/*"], "css": ["styles_instagram.css"], "js": ["content_instagram.js"], "run_at": "document_start"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "assets/logo16.png", "32": "assets/logo32.png", "48": "assets/logo48.png", "128": "assets/logo128.png"}, "action": {"default_title": "Open Focus Key", "default_icon": {"16": "assets/logo16.png", "32": "assets/logo32.png"}}}