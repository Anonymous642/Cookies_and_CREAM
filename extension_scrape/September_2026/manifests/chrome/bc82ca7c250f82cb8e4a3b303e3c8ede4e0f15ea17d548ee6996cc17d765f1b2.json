{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ribbon", "version": "1.0.10", "description": "Save a product page to your Ribbon gift list. Only that page is sent when you click Add to Ribbon.", "homepage_url": "https://ribbon-list.com", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Add to Ribbon", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "tabs", "scripting", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "incognito": "not_allowed", "commands": {"save-to-ribbon": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Save this page to Ribbon"}}}