{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lucklet: Lucky Charms for Your Browser", "short_name": "Lucklet", "version": "1.0.0", "description": "A lucky charm that hangs from the top of your browser. 41 original charms, ropes of three, and your own photo charms.", "minimum_chrome_version": "111", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Lucklet", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "gallery.html", "open_in_tab": true}, "permissions": ["storage", "alarms", "scripting", "activeTab", "search"], "host_permissions": ["https://api.gumroad.com/*"], "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-charm": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Hide or show the charm"}, "send-blessing": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Send a blessing"}}}