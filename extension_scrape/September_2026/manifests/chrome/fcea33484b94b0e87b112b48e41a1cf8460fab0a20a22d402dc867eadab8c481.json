{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UnknownWordSaver", "short_name": "UWS", "author": "BCK", "version": "1.1", "description": "Instantly save unknown words with definitions, translations, and examples to an Excel file while you browse.", "permissions": ["contextMenus", "storage", "scripting", "activeTab", "notifications", "alarms", "downloads"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://api.mymemory.translated.net/*", "https://translate.googleapis.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"save_word_command": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Save selected word"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "web_accessible_resources": [{"resources": ["data/*.json"], "matches": ["<all_urls>"]}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}