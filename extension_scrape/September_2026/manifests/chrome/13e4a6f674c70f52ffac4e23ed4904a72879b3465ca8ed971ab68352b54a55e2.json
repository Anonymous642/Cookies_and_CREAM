{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Sleep - Smart Tab Freezer", "version": "1.2.0", "description": "Auto-freezes inactive tabs to save RAM. Idle + low-memory detection, duplicate cleanup, session backup, scroll restore.", "minimum_chrome_version": "110", "permissions": ["tabs", "storage", "alarms", "idle", "system.memory", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"freeze-now": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "\u062a\u062c\u0645\u064a\u062f \u0643\u0644 \u0627\u0644\u062a\u0628\u0648\u064a\u0628\u0627\u062a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0627\u0644\u0622\u0646"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}