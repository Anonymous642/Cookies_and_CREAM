{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadAnything: Offline Text to Speech TTS PDF Reader", "version": "1.1.0", "description": "Offline on-device text to speech (TTS) reader. Read aloud PDFs, EPUB books & web articles with natural AI voice word tracking.", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "offscreen", "sidePanel", "tabs"], "host_permissions": ["https://www.google-analytics.com/*", "https://api.lemonsqueezy.com/*", "https://push-sdk-70f9e.firebaseio.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "ReadAnything", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "web_accessible_resources": [{"resources": ["src/offscreen/*", "src/pdf-viewer/*", "src/epub-viewer/*", "src/player/*", "src/content/*", "tesseract/*", "icons/*", "models/*", "wasm/*", "assets/*"], "matches": ["*://*/*"]}], "commands": {"read_selection": {"suggested_key": {"default": "Alt+R", "mac": "Command+Shift+U"}, "description": "Read selected text aloud with word tracking"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}