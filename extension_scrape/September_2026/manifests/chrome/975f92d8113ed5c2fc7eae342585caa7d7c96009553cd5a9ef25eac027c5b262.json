{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curip", "version": "1.0.0", "description": "Turn prompts into reusable templates with variables. Capture once, reuse forever. Private and secure.", "permissions": ["activeTab", "storage", "notifications"], "host_permissions": ["https://*.netlify.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_end"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_end"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/index.html", "default_title": "Curip - Capture AI Prompts", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["popup/*", "content-scripts/*"], "matches": ["<all_urls>"]}]}