{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skublox", "description": "Skublox extension brings Skublox sort wall into Chrome. Work from the extension popup or open a floating panel", "version": "1.2.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["wall-float.html", "chunks/*", "assets/*", "logo.svg"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Skublox", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}