{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SxS AI", "version": "1.0.6", "description": "Send prompts to multiple AI services to compare responses side by side", "homepage_url": "https://github.com/vaits-microsoft/AgentPlayground/tree/main/SxSAI", "permissions": ["activeTab", "storage", "tabs", "sidePanel", "scripting"], "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://x.com/*", "*://grok.com/*", "*://gemini.google.com/*", "*://www.perplexity.ai/*", "*://copilot.microsoft.com/*"], "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["*://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_idle"}, {"matches": ["*://x.com/*", "*://grok.com/*"], "js": ["content-scripts/grok.js"], "run_at": "document_idle"}, {"matches": ["*://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["*://www.perplexity.ai/*"], "js": ["content-scripts/perplexity.js"], "run_at": "document_idle"}], "action": {"default_title": "SxS AI"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}}