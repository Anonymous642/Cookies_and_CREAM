{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recall", "version": "1.3.0", "description": "Premium offline bookmark manager for productivity, research workflows, and second-brain organization.", "permissions": ["storage", "tabs", "notifications", "alarms", "contextMenus", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Recall"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open Recall Dashboard"}, "save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab"}, "focus-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Focus search"}, "command-palette": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open Command Palette"}}}