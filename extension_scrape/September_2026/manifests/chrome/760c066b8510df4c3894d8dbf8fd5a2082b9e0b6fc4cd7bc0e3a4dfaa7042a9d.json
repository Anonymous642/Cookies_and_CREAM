{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Format Painter for Gmail", "version": "3.0.0", "description": "Copy formatting in Gmail, reapply it in one click. Free plan: the full painter, 10 applies a month. Pro: unlimited + saved styles.", "minimum_chrome_version": "137", "permissions": ["contextMenus", "storage", "alarms"], "host_permissions": ["https://mail.google.com/*"], "externally_connectable": {"matches": ["https://formatpainter.app/*"]}, "storage": {"managed_schema": "managed_schema.json"}, "commands": {"copy-format": {"suggested_key": {"default": "Alt+C"}, "description": "Copy formatting from the selected text"}, "apply-format": {"suggested_key": {"default": "Alt+V"}, "description": "Apply the copied formatting to the selected text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup/popup.html", "default_title": "Gmail Format Painter"}, "background": {"service_worker": "background/index.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/index.js"], "run_at": "document_idle"}]}