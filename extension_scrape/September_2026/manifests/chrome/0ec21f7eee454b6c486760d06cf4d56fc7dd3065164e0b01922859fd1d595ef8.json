{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shared Repo", "description": "Keep your team's shared repositories at your fingertips \u2014 track PRs, issues, and review requests right from GitHub.", "version": "0.1.0", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_title": "Shared Repo", "default_popup": "popup.html"}, "options_page": "options.html", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://api.github.com/*", "https://github.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}