{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "hrvstr - Job Application Tracker", "version": "1.0.5", "description": "Save jobs from any website to your hrvstr tracker with one click", "permissions": ["storage", "activeTab", "notifications", "contextMenus", "scripting"], "host_permissions": ["https://hrvstr.com/*", "https://www.hrvstr.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"clip-job": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current job to hrvstr"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}