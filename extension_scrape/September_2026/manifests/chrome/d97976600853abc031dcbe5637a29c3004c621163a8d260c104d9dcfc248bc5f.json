{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pondchat", "version": "1.1.2", "description": "Quiet P2P video pond in Chrome \u2014 side panel, no signup. Share a pondchat.com link.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Pondchat", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "dist/sidepanel.html"}, "background": {"service_worker": "background.js"}, "permissions": ["sidePanel", "storage", "contextMenus"], "host_permissions": ["https://pondchat.com/*", "wss://pondchat.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["dist/assets/*", "dist/sidepanel.html", "dist/tab.html", "request-media.html", "request-media.js"], "matches": ["https://pondchat.com/*"]}]}