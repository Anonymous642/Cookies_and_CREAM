{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Brizy Insight Assistant", "version": "2.2.3", "description": "Corporate mailboxes only on work browsers. Blocks personal Gmail, Yahoo Mail, Outlook.com, Google Drive, and webmail.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "incognito": "spanning", "permissions": ["storage", "tabs"], "host_permissions": ["https://mail.google.com/*", "https://drive.google.com/*", "https://mail.yahoo.com/*", "https://outlook.live.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://drive.google.com/*", "https://mail.yahoo.com/*", "https://outlook.live.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}