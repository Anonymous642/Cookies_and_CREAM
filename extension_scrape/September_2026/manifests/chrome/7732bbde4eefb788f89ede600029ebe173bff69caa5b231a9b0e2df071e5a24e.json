{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marketplace Auto-Scroll Scraper", "version": "1.0.0", "description": "Auto-scroll FB Marketplace and export listings to CSV.", "icons": {"16": "assets/logo-16.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "128": "assets/logo-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.facebook.com/marketplace*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo-16.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "128": "assets/logo-128.png"}, "theme_icons": [{"light": "assets/logo-16.png", "dark": "assets/logo-w-16.png", "size": 16}, {"light": "assets/logo-32.png", "dark": "assets/logo-w-32.png", "size": 32}, {"light": "assets/logo-48.png", "dark": "assets/logo-w-48.png", "size": 48}, {"light": "assets/logo-128.png", "dark": "assets/logo-w-128.png", "size": 128}]}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace*"], "js": ["content.js"], "run_at": "document_idle"}]}