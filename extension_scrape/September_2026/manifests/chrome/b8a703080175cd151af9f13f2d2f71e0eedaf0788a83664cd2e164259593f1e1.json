{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BeeSift", "version": "1.0.2", "description": "Smart insights from any webpage - discover valuable information tailored to your goals.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "js/background.js"}, "options_page": "settings.html", "action": {"default_icon": {"16": "icons/icon_16x16.png", "32": "icons/icon_32x32.png", "48": "icons/icon_48x48.png", "128": "icons/icon_128x128.png"}, "default_title": "BeeSift"}, "side_panel": {"default_path": "settings.html"}, "web_accessible_resources": [{"resources": ["css/*", "icons/*", "success.html", "cancel.html"], "matches": ["<all_urls>"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle BeeSift Panel"}, "generate-insight": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Generate BeeSift Insight"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Open BeeSift Dashboard"}}, "icons": {"16": "icons/icon_16x16.png", "32": "icons/icon_32x32.png", "48": "icons/icon_48x48.png", "128": "icons/icon_128x128.png"}, "externally_connectable": {"matches": ["https://beesift.com/*", "https://insightbee-extension.web.app/*"]}}