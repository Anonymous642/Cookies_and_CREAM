{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Usearly \u2013 Extension Assistant", "version": "2.0.3", "description": "Partagez vos signalements, coups de c\u0153ur et suggestions directement depuis votre navigateur.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"}, "action": {"default_title": "Ouvrir Usearly", "default_icon": {"16": "assets/icons/usearly-icon-16.png", "32": "assets/icons/usearly-icon-32.png"}}, "icons": {"16": "assets/icons/usearly-icon-16.png", "32": "assets/icons/usearly-icon-32.png", "48": "assets/icons/usearly-icon-48.png", "128": "assets/icons/usearly-icon-128.png"}, "commands": {"toggle-menu": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ouvrir ou fermer le menu Usearly"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus"], "web_accessible_resources": [{"resources": ["global.css"], "matches": ["<all_urls>"], "use_dynamic_url": true}, {"resources": ["assets/sounds/*.mp3"], "matches": ["<all_urls>"]}, {"resources": ["assets/fonts/*"], "matches": ["<all_urls>"]}, {"resources": ["assets/icons/*.png", "assets/icons/*.jpg", "assets/icons/*.jpeg", "assets/icons/*.svg", "assets/icons/*.gif"], "matches": ["<all_urls>"]}, {"resources": ["assets/categories-icons/*.png", "assets/animations/*.gif"], "matches": ["<all_urls>"]}, {"resources": ["assets/emoji/*.gif"], "matches": ["<all_urls>"]}]}