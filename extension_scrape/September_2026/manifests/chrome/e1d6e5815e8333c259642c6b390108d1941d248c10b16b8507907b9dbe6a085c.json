{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Queue", "version": "0.3.0", "description": "A persistent queue for YouTube videos, controlled from a side panel.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "tabs", "webNavigation", "sidePanel", "notifications"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content/loader.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/content/*", "src/shared/*", "src/shared/storage/*"], "matches": ["*://*.youtube.com/*"]}], "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "action": {"default_title": "YouTube Queue", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"add-current-video": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Add the current YouTube video to the queue"}}}