{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lock In", "description": "Allows user to set a timer and block websites while timer is going so they can better focus.", "version": "1.1.0", "author": {"email": "CybershiftLabs@gmail.com"}, "icons": {"16": "images/lockIn-16x16.png", "32": "images/lockIn-32x32.png", "48": "images/lockIn-48x48.png", "128": "images/lockIn-128x128.png"}, "action": {"default_icon": "images/lockIn-logo.png", "default_popup": "index.html"}, "content_scripts": [{"matches": ["*://*.com/**"], "js": ["scripts/content.js"]}], "background": {"service_worker": "scripts/service_worker.js", "type": "module"}, "host_permissions": ["*://*/*"], "permissions": ["scripting", "tabs", "storage"]}