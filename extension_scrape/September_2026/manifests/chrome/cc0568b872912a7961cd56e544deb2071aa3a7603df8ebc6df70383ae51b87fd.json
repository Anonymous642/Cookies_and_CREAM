{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Update Checker for Google Chrome", "description": "Instant notification when a new stable version of Google Chrome is available. Checks securely via official API.", "version": "2.3.0", "author": "Serhii Svyrydenko", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["alarms", "storage", "tabs", "scripting", "notifications"], "host_permissions": ["https://versionhistory.googleapis.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Update Checker for Google Chrome", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}