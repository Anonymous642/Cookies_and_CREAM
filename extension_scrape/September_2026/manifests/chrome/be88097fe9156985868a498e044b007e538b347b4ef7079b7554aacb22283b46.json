{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lin Network Scanner", "version": "0.4.5", "description": "Capture job opportunities from LinkedIn and X/Twitter", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.linkedin.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://aclechyzactcsrplzhwd.supabase.co/functions/v1/*", "https://getlin.ai/*", "https://app.getlin.ai/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.linkedin.com/feed/*", "https://*.linkedin.com/posts/*", "https://*.linkedin.com/search/results/*", "https://*.linkedin.com/company/*"], "js": ["content-scripts/linkedin-feed.js"], "run_at": "document_idle"}, {"matches": ["https://*.x.com/*", "https://*.twitter.com/*"], "js": ["content-scripts/x-feed.js"], "run_at": "document_idle"}, {"matches": ["https://getlin.ai/extension-auth*", "https://app.getlin.ai/extension-auth*"], "js": ["content-scripts/lin-auth-bridge.js"], "run_at": "document_end"}, {"matches": ["https://getlin.ai/settings*", "https://app.getlin.ai/settings*"], "js": ["content-scripts/token-manager.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_title": "Lin Scanner", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}