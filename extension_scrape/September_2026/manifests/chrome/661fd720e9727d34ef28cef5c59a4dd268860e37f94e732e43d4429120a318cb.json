{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notion Sidebar", "version": "1.0.0", "description": "Quick access to Notion for all tasks. Free and fast interaction in your sidebar.", "action": {"default_title": "Notion Sidebar for Chrome", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel/index.html"}, "permissions": ["sidePanel", "declarativeNetRequest", "contextMenus", "storage"], "host_permissions": ["*://notion.so/*", "*://www.notion.so/*"], "web_accessible_resources": [{"resources": ["sidepanel/*", "images/*"], "matches": ["<all_urls>"]}]}