{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Workspace Guard", "short_name": "Workspace Guard", "version": "0.3.4", "icons": {"16": "img/icon-16.png", "32": "img/icon-32.png", "48": "img/icon-48.png", "128": "img/icon-128.png"}, "action": {"default_icon": {"16": "img/icon-16.png", "32": "img/icon-32.png"}, "default_title": "Workspace Guard"}, "description": "Safety controls for Google Workspace: hide image & video search, Explore, emojis, GIFs and embeds. Managed by your administrator.", "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://docs.google.com/*", "https://drive.google.com/*", "https://classroom.google.com/*", "https://keep.google.com/*", "https://sites.google.com/*", "https://www.google.com/*", "https://images.google.com/*", "https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*", "https://www.youtubeeducation.com/embed/*", "https://youtube.googleapis.com/embed/*"], "js": ["rules.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "permissions": ["storage", "alarms", "declarativeNetRequest"], "host_permissions": ["https://filter.tag.org/*", "*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.google.com/*"], "storage": {"managed_schema": "schema.json"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}