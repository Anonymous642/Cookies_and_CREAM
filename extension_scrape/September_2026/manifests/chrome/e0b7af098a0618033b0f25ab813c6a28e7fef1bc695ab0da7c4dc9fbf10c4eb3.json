{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReelScribe \u2014 Video Transcription", "version": "1.0.1", "description": "Transcribe Instagram Reels, TikTok videos, and YouTube Shorts directly from the page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "notifications", "alarms"], "host_permissions": ["https://reelscribe.app/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"transcribe-current": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Transcribe the current video"}}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["lib/constants.js", "lib/url-utils.js", "content/shared.js", "content/instagram.js"], "css": ["content/shared.css"], "run_at": "document_idle"}, {"matches": ["*://*.tiktok.com/*"], "js": ["lib/constants.js", "lib/url-utils.js", "content/shared.js", "content/tiktok.js"], "css": ["content/shared.css"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["lib/constants.js", "lib/url-utils.js", "content/shared.js", "content/youtube.js"], "css": ["content/shared.css"], "run_at": "document_idle"}]}