{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Instagram Follower Analyzer", "version": "3.0.4", "description": "Analyze Instagram followers: see mutuals, non-followers, fans, and more.", "permissions": ["cookies", "storage", "unlimitedStorage", "tabs", "scripting", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "declarative_net_request": {"rule_resources": [{"id": "ig_image_rules", "enabled": true, "path": "rules.json"}]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net"}}