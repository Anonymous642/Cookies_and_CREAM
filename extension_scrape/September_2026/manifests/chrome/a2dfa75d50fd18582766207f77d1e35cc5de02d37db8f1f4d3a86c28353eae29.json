{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StudyLock", "version": "1.0.0", "description": "Block distracting websites until you pass a quiz on your study material.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["webNavigation", "storage", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "StudyLock", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "sandbox": {"pages": ["sandbox.html"]}, "content_security_policy": {"sandbox": "sandbox allow-scripts; script-src https://cdn.jsdelivr.net 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "blocked.css", "sandbox.html", "onboarding.html", "onboarding.js", "onboarding.css"], "matches": ["<all_urls>"]}]}