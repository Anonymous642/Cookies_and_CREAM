{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ToStatic \u2014 Exports, SEO, Performance, AI & more", "description": "Export websites to portable files, back up, deploy, check SEO and Core Web Vitals in ToStatic.", "version": "2.0.7", "permissions": ["storage", "tabs", "scripting", "identity", "declarativeNetRequestWithHostAccess"], "optional_permissions": ["notifications", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/index.html", "default_icon": "icons/icon-x72.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://tostatic.app/*", "https://beta.tostatic.app/*", "https://tostatic.com/*", "https://www.tostatic.com/*"], "js": ["web_inject/channel.js"], "run_at": "document_start"}, {"matches": ["https://*.framer.com/projects/*", "https://editor.wix.com/html/*", "https://*.design.webflow.com/*", "https://lovable.dev/projects/*"], "js": ["lib/jquery.min.js"], "css": ["web_inject/templates.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["lib/*", "web_inject/*", "icons/*", "assets/*", "oauth/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:;", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"}, "icons": {"16": "icons/icon-x16.png", "48": "icons/icon-x48.png", "128": "icons/icon-x128.png"}}