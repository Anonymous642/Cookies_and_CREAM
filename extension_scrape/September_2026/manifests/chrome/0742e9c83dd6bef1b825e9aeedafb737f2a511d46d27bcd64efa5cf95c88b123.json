{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pixel Pet", "version": "2.5.4", "description": "A customizable pixel pet on every webpage. Toggle with a shortcut.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; connect-src 'self' https://pixel-pet-be.onrender.com"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["pet-variants.js", "pet-fox.js", "pet-dog.js", "pet-interactions.js", "pet-feeding.js", "content.js"], "css": ["content.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["assets/cats-assets/*", "assets/fox-assets/*", "assets/food-assets/*", "assets/dogs-assets/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-pet": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle Pixel Pet visibility"}}}