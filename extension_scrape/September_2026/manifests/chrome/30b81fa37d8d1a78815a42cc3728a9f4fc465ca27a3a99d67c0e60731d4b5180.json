{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Better Japanese Captions", "version": "1.1.0", "description": "Cleaner line breaks for manually added Japanese YouTube captions. Auto-generated captions are not supported.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab"], "action": {"default_title": "Better Japanese Captions", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-budoux-captions": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Toggle Better Japanese Captions (on/off)"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["dist/content.js"], "run_at": "document_start", "all_frames": true}]}