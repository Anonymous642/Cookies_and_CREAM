{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FilePeek: View & Edit CSV, JSON & Markdown", "short_name": "FilePeek", "version": "1.1.0", "description": "View and edit CSV, JSON, and Markdown files in your browser. Sortable tables, JSON tree, live Markdown editor, local file save.", "permissions": ["downloads", "webNavigation", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "include_globs": ["*.csv", "*.CSV", "*.tsv", "*.TSV"], "js": ["i18n.js", "theme.js", "csvcore.js", "content.js"], "run_at": "document_end"}, {"matches": ["file:///*", "http://*/*", "https://*/*"], "js": ["i18n.js", "theme.js", "json.js"], "run_at": "document_idle"}, {"matches": ["file:///*", "http://*/*", "https://*/*"], "include_globs": ["*.md", "*.MD", "*.markdown", "*.mkd"], "js": ["i18n.js", "theme.js", "vendor/marked.min.js", "md.js"], "css": ["vendor/gh.css"], "run_at": "document_end"}], "background": {"service_worker": "bg.js"}, "host_permissions": ["file:///*"]}