{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FRONTSTEPS ALLi", "description": "AI assistant for HOA teams: summarize, automate tasks, and take action in-browser with context-aware, voice-enabled support.", "version": "1.0.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "scripting", "sidePanel", "storage", "debugger"], "optional_permissions": ["tabCapture", "desktopCapture", "offscreen", "tabs"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"}, "action": {"default_title": "Open ALLi Assistant", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "side_panel": {"default_path": "app.html"}, "background": {"type": "module", "service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}