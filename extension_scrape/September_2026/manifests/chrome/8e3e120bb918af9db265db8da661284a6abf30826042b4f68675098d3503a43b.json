{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Verify", "version": "0.1.0", "description": "Verify your follow/subscribe status on X, YouTube, and other socials to earn loyalty bonuses on connected brand sites.", "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://kick.com/*", "https://www.tiktok.com/*", "https://www.instagram.com/*", "https://dominantsupplements.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Social Verify", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/x-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/youtube-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://kick.com/*"], "js": ["content/kick-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*"], "js": ["content/tiktok-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["content/instagram-scraper.js"], "run_at": "document_idle"}]}