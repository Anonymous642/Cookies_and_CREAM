{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KeyJump - URL Shortcuts", "version": "1.0", "description": "Bind global keyboard shortcuts to your favorite URLs for instant jumping.", "icons": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["storage", "tabs"], "action": {"default_popup": "popup.html", "default_title": "KeyJump Settings", "default_icon": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"shortcut_1": {"suggested_key": {"default": "Alt+Shift+1", "mac": "Alt+Shift+1"}, "description": "Open Shortcut 1"}, "shortcut_2": {"suggested_key": {"default": "Alt+Shift+2", "mac": "Alt+Shift+2"}, "description": "Open Shortcut 2"}, "shortcut_3": {"suggested_key": {"default": "Alt+Shift+3", "mac": "Alt+Shift+3"}, "description": "Open Shortcut 3"}, "shortcut_4": {"suggested_key": {"default": "Alt+Shift+4", "mac": "Alt+Shift+4"}, "description": "Open Shortcut 4"}}}