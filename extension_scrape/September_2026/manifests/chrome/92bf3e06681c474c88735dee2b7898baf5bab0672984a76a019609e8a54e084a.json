{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Retro Terminal View \u2014 CRT Themes for the Web", "short_name": "Retro Terminal", "version": "2.0.0", "description": "Turn websites into customizable CRT terminals with phosphor themes, site rules, safe media controls, and local settings.", "homepage_url": "https://www.masturbyte.com/retro-terminal-view/", "minimum_chrome_version": "120", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Retro Terminal View", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/defaults.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"toggle-terminal": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Option+Shift+T"}, "description": "Toggle Retro Terminal View on the current site"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}