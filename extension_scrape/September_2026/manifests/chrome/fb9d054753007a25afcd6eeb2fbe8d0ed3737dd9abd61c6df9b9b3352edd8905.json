{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Heart AI", "description": "Beta extension for turning a YouTube video into Gemini output, h.ki moments, and a prefilled viki draft.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://www.youtube-nocookie.com/*", "https://gemini.google.com/*", "https://h.ki/*", "https://youtube.h.ki/*"], "web_accessible_resources": [{"resources": ["hki-main-world.js"], "matches": ["https://h.ki/*", "https://youtube.h.ki/*"]}], "action": {"default_title": "Heart AI", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html"}, "options_page": "options.html", "commands": {"run-workflow": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Run the Heart AI workflow"}, "capture-snapshot": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Alt+Shift+M"}, "description": "Capture the active Gemini moment preview"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gemini.js"]}, {"matches": ["https://h.ki/*", "https://youtube.h.ki/*"], "run_at": "document_idle", "js": ["content-scripts/hki.js"]}, {"matches": ["https://www.youtube.com/shorts/*", "https://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}