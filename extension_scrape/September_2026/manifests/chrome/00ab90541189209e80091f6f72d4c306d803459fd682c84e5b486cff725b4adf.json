{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "1get - Link Shortener", "short_name": "1get", "version": "1.0.0", "description": "Instantly shorten any URL with 1get. Right-click or use the popup to create short links.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Shorten this page"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "activeTab", "contextMenus", "notifications", "clipboardWrite", "scripting", "offscreen"], "host_permissions": ["https://1get.site/*", "https://api.1get.site/*"], "options_ui": {"page": "options/options.html", "open_in_tab": false}, "commands": {"shorten-current-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Shorten the current page URL"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}