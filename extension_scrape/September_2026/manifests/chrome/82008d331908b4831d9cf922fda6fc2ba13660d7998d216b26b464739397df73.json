{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ExplainTXT: Highlight text. Ask AI.", "version": "4.2.8", "description": "Highlight text to explain or summarize it, or summarize the whole page with one shortcut. Your on-site AI assistant.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "cookies"], "host_permissions": ["https://explaintxt.com/*", "https://www.explaintxt.com/*", "https://clerk.explaintxt.com/*", "https://supreme-ghost-82.clerk.accounts.dev/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "action": {"default_popup": "dist/popup/index.html", "default_title": "ExplainTXT Settings"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"explain-page": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Explain selected text (summarizes the page if nothing is selected)"}, "summarize-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize this page"}}, "web_accessible_resources": [{"resources": ["constants.js", "ping.txt", "icons/icon128.png"], "matches": ["<all_urls>"]}]}