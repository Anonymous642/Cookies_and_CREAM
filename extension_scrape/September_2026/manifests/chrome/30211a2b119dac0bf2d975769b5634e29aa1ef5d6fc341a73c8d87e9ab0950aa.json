{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reader.md: View HTML, PDF, Markdown & Export", "short_name": "Reader.md", "description": "Open any page or local file in reader view: HTML, PDF, Markdown, EPUB, text. Save as HTML, Markdown, or EPUB. Send to Obsidian.", "version": "0.5.0", "key": "", "minimum_chrome_version": "120", "author": "Bart Turczynski", "homepage_url": "https://spoonkeyworks.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open in Reader.md", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "options_page": "src/options.html", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "contextMenus"], "host_permissions": ["file:///*"], "optional_host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+R"}}, "share-default": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Share with the default Reader.md destination"}, "copy-markdown": {"description": "Open the page in Reader.md and copy as Markdown"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}}