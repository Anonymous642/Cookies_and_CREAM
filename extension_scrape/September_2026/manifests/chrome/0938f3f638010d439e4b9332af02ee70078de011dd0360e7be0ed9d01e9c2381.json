{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Theme & Background Changer", "version": "1.0.0", "description": "Change ChatGPT background, gradient, overlay, blur and text color.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}