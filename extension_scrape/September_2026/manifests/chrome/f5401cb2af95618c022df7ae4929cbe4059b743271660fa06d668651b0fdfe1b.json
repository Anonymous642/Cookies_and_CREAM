{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Exporter", "version": "0.1.0", "description": "Export ChatGPT, Claude, and Gemini chats to PDF, Markdown, Text, or Image. Selective export supported.", "action": {"default_popup": "popup/popup.html", "default_title": "AI Exporter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "storage", "downloads", "tabs", "notifications", "debugger"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content/common.js", "content/adapters/chatgpt.js", "content/adapters/claude.js", "content/adapters/gemini.js", "content/scraper.js", "content/selection-overlay.js"], "css": ["content/selection-overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["preview/preview.html", "preview/preview.css", "preview/preview.js"], "matches": ["<all_urls>"]}]}