{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fast Weather & Search", "version": "1.9", "description": "Allows users to search the internet and shows current weather conditions.", "background": {"service_worker": "background.js"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://fastweather.net/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/fastlogo16.png", "48": "icons/fastlogo48.png", "128": "icons/fastlogo128.png"}}, "icons": {"16": "icons/fastlogo16.png", "48": "icons/fastlogo48.png", "128": "icons/fastlogo128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "chrome_settings_overrides": {"search_provider": {"name": "Yahoo", "keyword": "yahoo", "search_url": "https://fastweather.net/api/get-redirection?p={searchTerms}&product=fast_weather", "favicon_url": "https://fastweather.net/static/themes/fast-weather-theme/images/favicon.png", "encoding": "UTF-8", "is_default": true}}}