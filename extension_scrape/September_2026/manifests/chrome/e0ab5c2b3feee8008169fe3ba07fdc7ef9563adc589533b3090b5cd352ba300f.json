{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SuperQA Recorder", "version": "1.0.0", "description": "Capture workflow and validate scripts against the active browser tab.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["sidePanel", "activeTab", "tabs", "storage", "scripting", "debugger", "webRequest"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open SuperQA side panel"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "minimum_chrome_version": "114"}