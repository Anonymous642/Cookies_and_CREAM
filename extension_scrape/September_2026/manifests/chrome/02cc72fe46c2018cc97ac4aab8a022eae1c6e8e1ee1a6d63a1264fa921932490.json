{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "__MSG_extension_full_name__", "description": "Set a navigation checkpoint, allowing you to return to a specific page instantly whenever you need a fresh restart.", "version": "1.1.1", "icons": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png", "256": "icon/256.png"}, "default_locale": "en", "permissions": ["activeTab", "tabs", "storage", "scripting", "contextMenus", "tabGroups"], "host_permissions": ["<all_urls>"], "commands": {"shortcut-set-current-tab-checkpoint": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Option+Shift+S"}, "description": "__MSG_shortcuts_set_current_tab_checkpoint__"}, "shortcut-clear-current-tab-checkpoint": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Option+Shift+K"}, "description": "__MSG_shortcuts_clear_current_tab_checkpoint__"}, "shortcut-reset-current-tab-to-checkpoint": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Option+Shift+R"}, "description": "__MSG_shortcuts_reset_current_tab_to_checkpoint__"}, "shortcut-reset-or-close-current-tab-to-checkpoint": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Option+Shift+D"}, "description": "__MSG_shortcuts_reset_or_close_current_tab_to_checkpoint__"}}, "web_accessible_resources": [{"resources": ["icon/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Tab Checkpoint", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}