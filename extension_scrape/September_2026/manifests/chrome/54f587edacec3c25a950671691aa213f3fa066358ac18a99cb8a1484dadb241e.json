{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TLDW - Too Long Didn't Watch", "version": "1.3.0", "description": "Summarizes YouTube video using various AI models", "permissions": ["sidePanel", "activeTab", "storage", "scripting", "downloads"], "host_permissions": ["https://www.youtube.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_title": "TLDW", "default_icon": {"16": "icon16.png", "128": "icon128.png"}, "theme_icons": [{"light": "icon128B.png", "dark": "icon128.png", "size": 128}]}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["prompts.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["master_prompt.txt", "tutorial_prompt.txt"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "open_in_tab": true}}