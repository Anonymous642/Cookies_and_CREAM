{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Tab Groups", "version": "1.0.1", "description": "Group your open tabs into clear, named groups using Chrome's built-in on-device AI. Private \u2014 nothing leaves your device.", "minimum_chrome_version": "138", "permissions": ["tabs", "tabGroups", "offscreen", "storage", "scripting", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"organize-tabs": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Organize tabs in the current window"}}, "action": {"default_popup": "popup.html", "default_title": "Organize tabs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}