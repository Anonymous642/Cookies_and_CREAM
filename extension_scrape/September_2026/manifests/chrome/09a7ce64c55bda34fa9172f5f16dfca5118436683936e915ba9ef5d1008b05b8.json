{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slate Clipper", "version": "0.1.0", "description": "Send selected text and pages to your Slate vault. Cannot read your notes.", "homepage_url": "https://www.slatenotes.app", "permissions": ["contextMenus", "storage", "scripting", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Clip to Slate", "default_popup": "src/popup.html", "default_icon": {"128": "icon128.png"}}, "commands": {"clip-selection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Clip the selection to Slate"}}, "icons": {"128": "icon128.png"}, "options_ui": {"page": "src/popup.html", "open_in_tab": true}}