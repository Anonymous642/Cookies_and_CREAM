{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ColorSnap - Advanced Color Picker", "version": "1.0.2", "description": "Advanced Photoshop-style color picker extension with HEX, RGB, HSL, HWB, HSV formats, eyedropper tool, and contrast checker.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the color picker popup."}, "toggle_eyedropper": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Pick a color with EyeDropper"}}, "permissions": ["storage", "clipboardWrite", "activeTab", "scripting", "contextMenus"], "web_accessible_resources": [{"resources": ["lib/*.css", "lib/*.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}}