{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SATYA - Smart Accessibility Testing for Your Application", "description": "Powerful web accessibility testing tool. Ensure IS 17802, GIGW, and WCAG compliance with detailed reports and impact-based analysis.", "version": "2.0.8", "permissions": ["tabs", "activeTab", "scripting", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon64.png", "128": "icons/icon128.png"}, "action": {"default_icon": "icons/icon16.png", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["index.html", "content.js", "user_manual.pdf"], "matches": ["<all_urls>"]}]}