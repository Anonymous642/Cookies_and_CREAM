{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Job Jarvis", "version": "1.0.7", "description": "An extension to help you in your upwork cover letters and proposals", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "action": {"default_title": "Job Jarvis", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "tabs", "scripting", "sidePanel", "tabGroups"], "host_permissions": ["https://www.upwork.com/*"], "externally_connectable": {"matches": ["https://jobjarvis.com/*", "https://*.upwork.com/*", "http://localhost:3000/*"]}, "content_scripts": [{"matches": ["https://www.upwork.com/*", "https://jobjarvis.com/*", "http://localhost:3000/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.upwork.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}