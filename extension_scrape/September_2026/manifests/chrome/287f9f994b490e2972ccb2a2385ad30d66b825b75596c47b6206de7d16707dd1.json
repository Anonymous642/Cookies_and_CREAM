{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Apilingual", "description": "Learn languages while you watch: Netflix subtitles colored by what you know, tap-to-save vocabulary, and YouTube caption import.", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://app.apilingual.com/*"], "action": {"default_title": "Apilingual", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["https://www.netflix.com/*", "https://www.youtube.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.apilingual.com/*"], "run_at": "document_idle", "js": ["content-scripts/apilingual.js"]}, {"matches": ["*://www.netflix.com/*"], "run_at": "document_start", "js": ["content-scripts/netflix-main.js"], "world": "MAIN"}, {"matches": ["*://www.netflix.com/*"], "run_at": "document_idle", "js": ["content-scripts/netflix.js"]}, {"matches": ["*://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube-watch.js"]}, {"matches": ["*://www.youtube.com/shorts/*", "*://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}