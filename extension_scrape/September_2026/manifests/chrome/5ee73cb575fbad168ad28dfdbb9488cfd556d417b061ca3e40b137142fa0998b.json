{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Quick Tea", "description": "An AI assistant for your browser. Ask questions about any page and attachments. Great for researching technical products", "version": "0.6.0", "manifest_version": 3, "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Quick Tea"}, "side_panel": {"default_path": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Q", "mac": "Command+Q"}, "description": "Open Quick Tea sidepanel"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["content.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}