{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pomodomon", "version": "1.4.0", "description": "Focus to raise your Pomodomon \u2014 five pixel creatures that study beside you, block distractions, and explain what you read.", "permissions": ["alarms", "storage", "notifications", "declarativeNetRequest", "idle"], "host_permissions": ["<all_urls>"], "icons": {"16": "assets/pet-16.png", "32": "assets/pet-32.png", "48": "assets/pet-48.png", "128": "assets/pet-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Pomodomon"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/pet.js", "src/content/ask.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/block/block.html", "src/common/session.js", "src/common/progress.js", "src/common/sprite.js", "src/common/settings.js", "src/common/personality.js", "src/common/species.js", "src/common/sanitise.js", "src/common/ask.js", "src/common/pixel-font.js", "src/common/api.js", "assets/fonts/pixel.woff2", "assets/pets/*.png"], "matches": ["<all_urls>"]}], "commands": {"start-focus": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start a focus session"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "homepage_url": "https://github.com/abayxxx/pomodomon"}