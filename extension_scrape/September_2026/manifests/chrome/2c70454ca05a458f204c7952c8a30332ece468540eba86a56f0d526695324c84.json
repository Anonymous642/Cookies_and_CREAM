{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Git Helper for Azure DevOps", "version": "1.0.2", "description": "One-click PR creation, auto-filled descriptions, work item linking, and safe branch deletion for Azure DevOps.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://dev.azure.com/*", "https://*.visualstudio.com/*", "https://bedrock-runtime.*.amazonaws.com/*"], "content_scripts": [{"matches": ["https://dev.azure.com/*", "https://*.visualstudio.com/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Git Helper for Azure DevOps", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://dev.azure.com/*", "https://*.visualstudio.com/*"]}]}