{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Blocker - Block YouTube Comments By Keywords, Usernames & Tools", "description": "Block YouTube comments by keywords and usernames. Hide view counts and comment sections. And more!", "version": "1.6.2", "icons": {"16": "/icon/16.png", "32": "icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "Default Popup Title"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content-scripts/content.js"]}]}