{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slotcheck", "version": "1.1.1", "description": "See your Google Calendar while booking meetings on any scheduler.", "permissions": ["identity", "storage", "scripting", "webNavigation", "sidePanel"], "host_permissions": ["https://www.googleapis.com/*", "https://calendly.com/*", "https://cal.com/*", "https://meetings.hubspot.com/*", "https://savvycal.com/*", "<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_icon": "icons/icon-48.png", "default_title": "Slotcheck - Calendar Sidebar"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://calendly.com/*", "https://*.calendly.com/*", "https://cal.com/*", "https://*.cal.com/*", "https://meetings.hubspot.com/*", "https://*.hubspot.com/*", "https://savvycal.com/*", "https://*.savvycal.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}