{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leanka \u2014 Save Tool", "version": "1.1.2", "description": "Save the page you're on to your Leanka collection \u2014 the URL is filled in automatically. Pick categories, add tags, done.", "action": {"default_popup": "src/popup/popup.html", "default_title": "Save this page to Leanka", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Save the current page to Leanka"}}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://admin.leanka.me/*", "https://leanka.me/*", "https://*.leanka.me/*", "https://leanka-web.vercel.app/*"], "content_scripts": [{"matches": ["https://leanka.me/*", "https://*.leanka.me/*", "https://leanka-web.vercel.app/*"], "js": ["src/content/leanka-token.js"], "run_at": "document_idle"}]}