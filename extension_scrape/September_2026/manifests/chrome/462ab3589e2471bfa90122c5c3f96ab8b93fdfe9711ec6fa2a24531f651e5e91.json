{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ad Transcribe", "version": "1.0.0", "description": "Transcribe video ads directly from Facebook Ads Library. Get text transcriptions with optional timestamps \u2014 no download needed.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.facebook.com/*", "*://*.fbcdn.net/*", "https://api.openai.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/ads/library*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background/service-worker.js"}, "web_accessible_resources": [{"resources": ["content/page-script.js"], "matches": ["*://*.facebook.com/*"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}}