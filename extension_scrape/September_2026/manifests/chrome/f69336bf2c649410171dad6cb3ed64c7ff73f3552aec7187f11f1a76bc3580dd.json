{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoAdvance", "version": "1.2.0", "description": "Automatically advances to the next video on YouTube Shorts and Instagram Reels.", "permissions": ["storage"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "AutoAdvance"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["shared/settings.js", "content/core.js", "content/youtube.js"]}, {"matches": ["*://*.instagram.com/*"], "js": ["shared/settings.js", "content/core.js", "content/instagram.js"]}], "commands": {"toggle-current-site": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Turn AutoAdvance on or off for the current site"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}