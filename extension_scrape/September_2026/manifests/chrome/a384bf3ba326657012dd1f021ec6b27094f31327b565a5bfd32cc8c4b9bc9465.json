{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageMind - AI Summarizer", "description": "Summarize any web page and chat with its content using AI", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "commands": {"toggle-pagemind": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle PageMind panel"}}, "action": {"default_popup": "popup.html", "default_title": "PageMind"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}]}