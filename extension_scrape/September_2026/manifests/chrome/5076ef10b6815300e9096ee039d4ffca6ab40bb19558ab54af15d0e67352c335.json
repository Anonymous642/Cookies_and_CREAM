{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shelfy.so - smart web resource assistant", "version": "1.0.0", "description": "Save and organize your favorite web resources effortlessly with Shelfy\u2019s browser companion", "permissions": ["activeTab", "tabs", "storage", "scripting", "contextMenus"], "host_permissions": ["https://shelfy.so/*", "https://*.shelfy.so/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Shelfy.so - smart web resource assistant"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*", "images/*"], "matches": ["<all_urls>"]}]}