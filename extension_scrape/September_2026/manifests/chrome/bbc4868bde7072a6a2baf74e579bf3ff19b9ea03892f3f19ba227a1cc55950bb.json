{"update_url": "https://clients2.google.com/service/update2/crx", "name": "BrowSense", "description": "BrowSense is a browser extension that allows you to find and switch between tabs quickly and easily.", "manifest_version": 3, "version": "1.0", "host_permissions": ["<all_urls>"], "permissions": ["scripting", "tabs", "storage", "activeTab"], "default_locale": "en", "background": {"service_worker": "background.bundle.js"}, "action": {"default_icon": {"16": "images/icon-16.png", "19": "images/icon-19.png", "38": "images/icon-38.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "19": "images/icon-19.png", "38": "images/icon-38.png", "128": "images/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "match_about_blank": true, "all_frames": true, "js": ["content_script.bundle.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["overlay/palette.html", "overlay/palette.css", "overlay/palette.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Show TabSense Palette"}}, "externally_connectable": {"matches": ["*://localhost/*"]}}