{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SavvSkout Co-Pilot", "short_name": "SavvSkout", "version": "1.0.1", "description": "Detects job application pages, highlights form fields, and gives quick access to your SavvSkout matches and profile. Demo mode.", "permissions": ["storage", "activeTab", "scripting", "notifications", "alarms"], "host_permissions": ["https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.glassdoor.com/*", "https://*.wellfound.com/*", "https://*.reed.co.uk/*", "https://*.peopleperhour.com/*", "https://*.europelanguagejobs.com/*", "https://*.teamtailor.com/*", "https://*.smartrecruiters.com/*", "https://savvskout.com/*", "https://www.savvskout.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.glassdoor.com/*", "https://*.wellfound.com/*", "https://*.reed.co.uk/*", "https://*.peopleperhour.com/*", "https://*.europelanguagejobs.com/*", "https://*.teamtailor.com/*", "https://*.smartrecruiters.com/*", "https://savvskout.com/*", "https://www.savvskout.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://savvskout.com/*", "https://www.savvskout.com/*"]}}