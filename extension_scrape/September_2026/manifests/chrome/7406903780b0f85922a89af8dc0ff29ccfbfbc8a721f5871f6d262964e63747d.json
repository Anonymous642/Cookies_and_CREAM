{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Spotlight", "version": "1.0.0", "description": "Spotlight-style tab switcher for Chrome", "permissions": ["tabs", "history", "storage", "scripting", "activeTab", "favicon"], "background": {"service_worker": "background.js"}, "commands": {"toggle-spotlight": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open Tab Spotlight"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["keyboard-guard.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN"}], "web_accessible_resources": [{"resources": ["spotlight.css", "_favicon/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}