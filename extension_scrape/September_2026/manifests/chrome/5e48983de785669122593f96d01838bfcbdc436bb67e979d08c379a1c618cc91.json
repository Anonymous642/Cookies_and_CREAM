{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipora", "description": "A browser extension for sending links to backend service", "version": "1.0.0", "icons": {"16": "icon/logo.png", "48": "icon/logo.png", "128": "icon/logo.png"}, "default_locale": "en_US", "permissions": ["storage", "contextMenus", "notifications", "tabs", "pageCapture"], "host_permissions": ["https://clipora-api.guanshangyun.com/*"], "action": {"default_popup": "popup.html", "default_title": "Clipora"}, "web_accessible_resources": [{"resources": ["icon/*.png", "loginee/loginee.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.clipora.cc/*"], "js": ["content-scripts/content.js"]}]}