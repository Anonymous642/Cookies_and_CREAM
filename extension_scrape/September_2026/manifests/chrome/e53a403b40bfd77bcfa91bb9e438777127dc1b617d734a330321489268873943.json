{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vokto - Command Palette for the Web", "description": "Spotlight for any website. Press Cmd/Ctrl+Shift+K to search tabs, history, bookmarks, and page links, then run 50+ commands.", "version": "1.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "tabGroups", "history", "bookmarks", "readingList", "sessions", "downloads", "browsingData", "alarms", "activeTab", "favicon", "scripting"], "host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["https://*/*", "http://*/*"], "use_dynamic_url": true}], "action": {}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle the Vokto palette"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/vokto.js"]}]}