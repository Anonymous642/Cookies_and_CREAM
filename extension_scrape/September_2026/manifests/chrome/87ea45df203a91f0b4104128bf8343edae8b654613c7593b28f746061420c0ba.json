{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Luca \u2014 send bills to the Dock", "version": "0.1.0", "description": "Send a PDF bill from Gmail straight to your Luca Dock, in one click.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Luca", "default_popup": "src/popup/popup.html"}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["storage", "identity"], "host_permissions": ["https://api.luca.pro/*", "https://app.luca.pro/*", "https://mail.google.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/lib/gmail-parse.js", "src/content/gmail.js"], "css": ["src/content/gmail.css"], "run_at": "document_idle"}]}