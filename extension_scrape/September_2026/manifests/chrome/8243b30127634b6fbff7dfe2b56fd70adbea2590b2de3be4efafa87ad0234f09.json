{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cleaner - Cache & Cookie Clean for Chrome", "version": "1.1.0", "description": "Clear cache, cookies & browser data in 1 click. No login needed. Works perfectly on current tab or all sites. Privacy-first.", "permissions": ["browsingData", "cookies", "storage", "tabs", "activeTab", "scripting", "alarms", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"quick-clear": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Quick clear with current preset"}}}