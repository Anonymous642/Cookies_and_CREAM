{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anno", "description": "Annotate the web. Privately.", "version": "1.0.2", "short_name": "Anno", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://zaiq.ai", "minimum_chrome_version": "120", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"], "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"], "action": {"default_title": "Show Anno tools"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"highlight-selection": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Highlight selected text or open Anno"}, "pen-tool": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open the Anno Pen tool"}, "eraser-tool": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Open the Anno Eraser tool"}, "text-tool": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Open the Anno Text tool"}, "toggle-tools": {"description": "Open or collapse the Anno toolbar"}, "pause-tools": {"description": "Pause every Anno page tool"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["content-scripts/highlighter.css"], "use_dynamic_url": true, "matches": ["http://*/*", "https://*/*"]}]}