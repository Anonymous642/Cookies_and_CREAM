{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabStacks: Auto-group tabs by domain", "version": "1.0.4", "description": "Automatically group tabs by site and switch between them without the clutter.", "permissions": ["tabs", "tabGroups", "storage", "scripting", "windows"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "114", "commands": {"stack-next": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Switch to next tab in stack"}, "stack-prev": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Switch to previous tab in stack"}, "toggle-stacking": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle stacking on/off"}}}