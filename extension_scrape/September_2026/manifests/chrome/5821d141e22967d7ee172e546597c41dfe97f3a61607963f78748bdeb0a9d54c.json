{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipPilot", "description": "Auto-skip short-form videos on YouTube Shorts, Instagram Reels, and TikTok Web.", "version": "0.1.1", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.youtube.com/shorts/*", "https://www.instagram.com/reels/*", "https://www.instagram.com/reel/*", "https://www.tiktok.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/shorts/*", "https://www.instagram.com/reels/*", "https://www.instagram.com/reel/*", "https://www.tiktok.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "icons": {"16": "assets/icon-gray-16.png", "32": "assets/icon-gray-32.png", "48": "assets/icon-gray-48.png", "128": "assets/icon-gray-128.png"}, "action": {"default_icon": {"16": "assets/icon-gray-16.png", "32": "assets/icon-gray-32.png", "48": "assets/icon-gray-48.png"}, "default_title": "ClipPilot", "default_popup": "src/popup.html"}, "web_accessible_resources": [{"resources": ["src/support.html", "src/support.css"], "matches": ["https://www.youtube.com/*", "https://www.instagram.com/*", "https://www.tiktok.com/*"]}]}