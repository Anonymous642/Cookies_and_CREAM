{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Guerrilla Bots I\u00b2 Recorder", "version": "1.0.0", "description": "Record browser workflows for Guerrilla Process Automation. Captures clicks, inputs, and navigation \u2014 built for the last mile.", "permissions": ["activeTab", "scripting", "storage", "tabs", "nativeMessaging", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"run_at": "document_start", "matches": ["http://*/*", "https://*/*", "file://*/*"], "all_frames": false, "js": ["content/event-relay.js"]}, {"run_at": "document_idle", "matches": ["http://*/*", "https://*/*", "file://*/*"], "all_frames": false, "js": ["shared/logger.js", "shared/message-bus.js", "shared/element-schema.js", "content/xpath-gen.js"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/recorder.js"], "matches": ["<all_urls>"]}]}