{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Your Welcome", "version": "1.2.37", "description": "An extension to manage your favorites.", "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "permissions": ["storage", "history", "activeTab", "search", "favicon"], "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Your Welcome Popup"}}, "chrome_url_overrides": {"newtab": "main.html"}, "background": {"service_worker": "background.js", "type": "module"}}