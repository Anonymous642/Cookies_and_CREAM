{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Declutter - Focus Mode | Hide Shorts, Skip Sponsors & Distractions", "version": "1.0.0", "description": "Transform YouTube into a clean, productive, and distraction-free workspace. Hide Shorts, skip sponsors, and block clutter.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "https://sponsor.ajay.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Focus Mode on/off"}}}