{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Comment Remover", "version": "1.1.3", "description": "Removes comments from YouTube videos unless the channel is in a whitelist.", "permissions": ["activeTab", "storage", "scripting"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["src/content.js"], "run_at": "document_start", "css": ["src/ycr-hide.css"]}], "action": {"default_popup": "src/popup.html"}}