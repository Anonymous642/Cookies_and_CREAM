{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Practice typing with TipType", "version": "1.12", "description": "Practice typing directly on any webpage while reading real content. Improve your typing speed and accuracy on your favorite sites.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_title": "Practice typing with TipType", "default_icon": "images/icon-48.png"}, "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["http://tiptype.com/*", "https://tiptype.com/*"], "content_scripts": [{"js": ["scripts/pre-start.js"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_start"}, {"js": ["scripts/tiptype.js", "scripts/start.js"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*", "scripts/extension-load.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "scripts/background.js", "type": "module"}}