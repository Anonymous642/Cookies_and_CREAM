{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MasterLink", "version": "1.0.0", "description": "Convert Google Drive links to shareable formats with quick URL transformations for Google Workspace files", "permissions": ["activeTab", "tabs", "clipboardWrite", "clipboardRead", "storage", "contextMenus", "notifications", "downloads", "offscreen"], "host_permissions": ["https://drive.google.com/*", "https://docs.google.com/*", "https://lh3.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://drive.google.com/*", "https://docs.google.com/*"], "js": ["content.js"], "css": ["inject-styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "instructions.html"], "matches": ["https://drive.google.com/*", "https://docs.google.com/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open MasterLink popup"}}}