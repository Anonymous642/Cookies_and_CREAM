{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Avori for Chrome", "version": "0.10.0", "description": "Let your Avori agents use websites in your own Chrome when you ask. They ask before new websites and before anything that sends.", "permissions": ["activeTab", "scripting", "storage", "alarms"], "optional_permissions": ["tabs"], "optional_host_permissions": ["https://app.getavori.com/*", "<all_urls>"], "action": {"default_popup": "saved.html", "default_icon": {"16": "icons/avori-16.png", "32": "icons/avori-32.png", "48": "icons/avori-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Y"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "icons": {"16": "icons/avori-16.png", "32": "icons/avori-32.png", "48": "icons/avori-48.png", "128": "icons/avori-128.png", "192": "icons/avori-192.png"}, "background": {"service_worker": "worker.js"}, "externally_connectable": {"matches": ["https://app.getavori.com/*"], "ids": []}, "minimum_chrome_version": "120"}