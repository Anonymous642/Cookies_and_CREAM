{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptlyDo \u2014 AI Prompt Library", "description": "Your prompt library, instantly available in every AI tool. Search, paste, and save prompts to PromptlyDo from anywhere on the web.", "version": "0.1.3", "short_name": "PromptlyDo", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "notifications", "sidePanel"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://promptlydo.com/*", "https://www.promptlydo.com/*", "https://*.promptlydo.com/*", "https://promptlydo.lovable.app/*", "https://*.lovable.app/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open PromptlyDo prompt library"}}, "action": {"default_title": "PromptlyDo", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}