{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goto URL Viewer", "version": "0.1.0", "description": "Shows and copies the final destination of Google /goto search-result links.", "host_permissions": ["https://www.google.com/*", "https://www.google.co.in/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icons/reveal-icon-16.png", "32": "icons/reveal-icon-32.png", "48": "icons/reveal-icon-48.png", "128": "icons/reveal-icon-128.png"}, "action": {"default_title": "Goto URL Viewer", "default_popup": "popup.html", "default_icon": {"16": "icons/reveal-icon-16.png", "32": "icons/reveal-icon-32.png"}}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.co.in/search*"], "css": ["content.css"], "js": ["content-script.js"], "run_at": "document_idle"}]}