{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MyBB Super Filter Toolkit", "version": "2.3", "description": "Block users, specific threads, sections, filter 'New Posts', plus Export/Import and Badge Counters.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "action"], "host_permissions": ["*://*.mybroadband.co.za/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "MyBB Filter Settings", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["*://mybroadband.co.za/forum/*"], "js": ["content.js"], "run_at": "document_idle"}]}