{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabby", "version": "0.11", "description": "A powerful Tab Manager with window and tab thumbnails", "permissions": ["tabs", "tabGroups", "activeTab", "storage", "webNavigation", "contextMenus", "windows", "scripting", "debugger"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "dist/background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "chrome_url_overrides": {"newtab": "tab.html"}, "web_accessible_resources": [{"resources": ["tab.html", "refresh-popup.html", "generating-thumbnails.html", "dist/tabby-app.js", "dist/tabby-app.css", "dist/background.js", "dist/refresh-popup.js", "dist/pre-overlay.js", "icons/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle"}], "commands": {"open-tabby": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Open Tabby"}, "focus-tabby-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Search Tabs"}, "close-hovered-tab": {"suggested_key": {"default": "Alt+W"}, "description": "Close the hovered tab in Tabby"}}}