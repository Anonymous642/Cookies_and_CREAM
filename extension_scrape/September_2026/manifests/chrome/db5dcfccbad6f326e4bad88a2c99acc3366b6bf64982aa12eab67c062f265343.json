{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IPQualityScore (IPQS)", "description": "Perform lookups of IP addresses, phone numbers, URLs, and email addresses using the IPQS API.", "version": "0.1.2", "icons": {"16": "logo/logo-16.png", "48": "logo/logo-48.png", "128": "logo/logo-128.png"}, "options_page": "ui/settings/settings.html", "action": {"default_title": "IPQS", "default_popup": "ui/popup/popup.html"}, "permissions": ["activeTab", "clipboardRead", "contextMenus", "scripting", "storage"], "host_permissions": ["https://ipqualityscore.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "commands": {"shortcut_lookup": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Perform a lookup of the selected text"}}, "web_accessible_resources": [{"resources": ["assets/*", "ui/overlay/overlay.css"], "matches": ["<all_urls>"]}]}