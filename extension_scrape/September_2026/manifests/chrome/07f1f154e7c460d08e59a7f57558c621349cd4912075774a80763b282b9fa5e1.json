{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CmdPal", "version": "1.0.1", "description": "Your friendly command palette for quick navigation across bookmarks, history, tabs, and links", "permissions": ["bookmarks", "history", "tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/js/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/js/content.js"], "css": ["src/css/palette.css"], "run_at": "document_end"}], "options_page": "src/html/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/html/palette.html", "src/js/*.js", "src/js/*/*.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle CmdPal"}}}