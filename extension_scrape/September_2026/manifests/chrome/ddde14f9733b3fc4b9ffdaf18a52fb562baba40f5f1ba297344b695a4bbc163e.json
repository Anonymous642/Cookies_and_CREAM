{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Word2Talk", "version": "1.7.26", "externally_connectable": {"matches": ["https://word2talk.com/*"]}, "description": "Turn articles and PDFs into natural audio that highlights as it reads. Translate as you listen. Free to try, no card.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Word2Talk", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "cookies", "offscreen", "tabs"], "content_scripts": [{"matches": ["https://word2talk.com/activate*", "https://staging.word2talk.com/activate*"], "js": ["content_activate.js"], "run_at": "document_idle"}], "host_permissions": ["https://word2talk.com/*", "https://staging.word2talk.com/*", "file:///*"], "optional_host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["<all_urls>"]}]}