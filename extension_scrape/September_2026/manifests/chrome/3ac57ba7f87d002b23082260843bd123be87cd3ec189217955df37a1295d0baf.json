{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gmail to ChatGPT Helper", "version": "1.2", "description": "Extract Gmail thread and draft reply, then open ChatGPT.", "permissions": ["scripting", "clipboardWrite", "activeTab"], "host_permissions": ["https://mail.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png"}, "action": {"default_title": "Gmail to ChatGPT", "default_icon": {"48": "icons/icon48.png"}}, "commands": {"trigger-gmail-extract": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Extract Gmail draft and open ChatGPT"}}}