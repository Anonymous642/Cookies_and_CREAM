{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Table to CSV Exporter \u2013 Copy HTML Tables to Sheets", "short_name": "TableLift", "description": "Export HTML tables from any webpage to CSV or Excel files, or copy them to Google Sheets. Runs locally, no data uploaded.", "version": "1.0.0", "action": {"default_title": "Export tables to CSV", "default_popup": "popup.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://tablelift-api.peerlab.workers.dev/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}