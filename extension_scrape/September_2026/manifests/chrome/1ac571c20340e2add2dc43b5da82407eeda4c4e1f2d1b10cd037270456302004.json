{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Echo Lite: Voice Changer for Chrome", "version": "0.6.6", "minimum_chrome_version": "120", "description": "Free voice changer for Chrome calls with live AI voices, voice effects and a soundboard for Discord and Google Meet.", "permissions": ["storage", "scripting", "activeTab", "offscreen", "identity"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Echo Lite", "default_popup": "index.html?popup=1"}, "options_ui": {"page": "index.html", "open_in_tab": true}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"toggle-mute": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Mute or unmute Echo", "global": true}, "stop-sounds": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Stop all Echo sounds", "global": true}, "play-sound-1": {"description": "Run Echo action slot 1", "global": true}, "play-sound-2": {"description": "Run Echo action slot 2", "global": true}, "play-sound-3": {"description": "Run Echo action slot 3", "global": true}, "play-sound-4": {"description": "Run Echo action slot 4", "global": true}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; connect-src 'self' https://soundboard.pro https://media.soundboard.pro https://voicechanger.live https://eu.i.posthog.com; img-src 'self' data: blob: https://soundboard.pro; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'"}, "externally_connectable": {"matches": ["https://soundboard.pro/*"]}, "cross_origin_embedder_policy": {"value": "credentialless"}, "cross_origin_opener_policy": {"value": "same-origin"}}