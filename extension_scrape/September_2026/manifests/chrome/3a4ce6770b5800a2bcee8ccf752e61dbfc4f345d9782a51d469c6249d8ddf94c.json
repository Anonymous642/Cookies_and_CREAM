{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadSoFast - Speed Reading with Voice", "description": "Play text at sprint speed - RSVP reading with voice. Video-player controls, TTS, teleprompter, keyboard shortcuts, customisable.", "version": "1.0.0", "icons": {"16": "src/graphics/icon16.png", "48": "src/graphics/icon48.png", "128": "src/graphics/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "src/graphics/icon16.png", "48": "src/graphics/icon48.png", "128": "src/graphics/icon128.png"}}, "minimum_chrome_version": "109", "background": {"service_worker": "src/background-worker.js"}, "web_accessible_resources": [{"resources": ["src/graphics/icon16.png", "src/graphics/icon48.png", "src/graphics/icon128.png", "src/graphics/notificationBanner.png"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "src/welcome.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["src/css/stylepage.css"], "js": ["lib/jquery/jquery.min.js", "src/tts.js", "src/content.js"]}], "commands": {"rapid_read_shortcut": {"suggested_key": {"default": "Ctrl+Shift+E", "windows": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E", "linux": "Ctrl+Shift+E"}, "description": "Speed read selected text"}}, "permissions": ["contextMenus", "activeTab", "clipboardRead", "storage", "system.display"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}