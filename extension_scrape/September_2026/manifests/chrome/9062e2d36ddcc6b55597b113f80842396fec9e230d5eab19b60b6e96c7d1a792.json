{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dear Hiring Team", "version": "0.0.3", "description": "Save LinkedIn job postings to Dear Hiring Team. We only process the current page URL when you explicitly save a position.", "action": {"default_popup": "popup/index.html", "default_title": "Save Position"}, "background": {"service_worker": "assets/background.js"}, "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://api.dearhiring.team/*", "https://app.dearhiring.team/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["assets/content.js"], "run_at": "document_idle"}, {"matches": ["https://app.dearhiring.team/*"], "js": ["assets/authListener.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"48": "assets/icon.png", "128": "assets/icon-128.png"}}