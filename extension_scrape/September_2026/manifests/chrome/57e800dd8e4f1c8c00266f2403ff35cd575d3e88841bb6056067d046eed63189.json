{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AION PiP Master: Auto-Scroll & Controls", "version": "1.2", "description": "Picture-in-Picture for TikTok, Instagram & Netflix with Next/Previous controls, auto-play, and a draggable PiP button.", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "AION Panel", "default_popup": "popup.html", "default_icon": "icon.png"}, "commands": {"aion-next": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Next Video"}, "aion-prev": {"suggested_key": {"default": "Alt+Shift+A", "mac": "MacCtrl+Shift+A"}, "description": "Previous Video"}, "aion-pip": {"suggested_key": {"default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Toggle PiP Mode"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_end"}], "icons": {"128": "icon.png"}}