{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShopReply \u2014 Auto Reply AI for Facebook Messenger & Zalo", "description": "AI auto-reply for Facebook Messenger & Zalo. Detect questions, suggest answers from your Q&A database. 100% local, no cloud.", "version": "1.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://chat.zalo.me/*", "http://localhost:3939/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "ShopReply", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://facebook.com/messages", "https://facebook.com/messages/*", "https://www.facebook.com/messages", "https://www.facebook.com/messages/*"], "run_at": "document_idle", "js": ["content-scripts/facebook.js"]}, {"matches": ["https://chat.zalo.me/*"], "run_at": "document_idle", "js": ["content-scripts/zalo.js"]}]}