{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Index Checker - Bulk & Unlimited Checking", "version": "1.0.5", "description": "Bulk check unlimited URLs for Google indexing status. Fast, accurate, and free tool for SEO professionals.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.google.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["content.js"], "run_at": "document_idle"}]}