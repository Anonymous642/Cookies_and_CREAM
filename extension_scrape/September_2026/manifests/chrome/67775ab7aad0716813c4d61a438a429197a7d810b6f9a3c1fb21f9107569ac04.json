{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Atlas", "version": "1.0.0", "description": "A visual map of all your Chrome workspaces across windows, tab groups, and incognito.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "windows", "sidePanel"], "incognito": "spanning", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tab Atlas \u2013 What is this window?", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "panel.html"}, "host_permissions": ["<all_urls>"]}