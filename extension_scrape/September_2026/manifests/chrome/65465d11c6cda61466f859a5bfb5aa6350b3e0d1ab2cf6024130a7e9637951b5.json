{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AP Video Notes", "version": "1.2.3", "description": "Turn available YouTube transcripts into structured AP study notes.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "AP Video Notes", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_page": "src/options/options.html"}