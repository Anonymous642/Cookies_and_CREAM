{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinterest Video Downloader, SaveClipX", "version": "1.0.0", "description": "A Pinterest video downloader extension for Chrome. Save any public pin video or image in one click.", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://*.pinterest.com/*", "https://*.pinterest.co.uk/*", "https://*.pinterest.ca/*", "https://*.pinterest.com.au/*", "https://*.pinterest.de/*", "https://*.pinterest.fr/*", "https://*.pinterest.es/*", "https://*.pinterest.it/*", "https://*.pinterest.com.mx/*", "https://*.pinterest.jp/*", "https://pin.it/*", "https://saveclipx.com/*", "https://*.saveclipx.com/*"], "action": {"default_popup": "popup.html", "default_title": "Save this pin with SaveClipX", "default_icon": {"128": "icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.pinterest.com/*", "https://*.pinterest.co.uk/*", "https://*.pinterest.ca/*", "https://*.pinterest.com.au/*", "https://*.pinterest.de/*", "https://*.pinterest.fr/*", "https://*.pinterest.es/*", "https://*.pinterest.it/*", "https://*.pinterest.com.mx/*", "https://*.pinterest.jp/*", "https://pin.it/*"], "js": ["menu.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://saveclipx.com/*", "https://*.saveclipx.com/*"], "js": ["verify.js"], "run_at": "document_start", "all_frames": false}], "icons": {"128": "icon-128.png", "512": "icon-512.png"}, "commands": {"save-current": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Save the pin in the current tab"}}}