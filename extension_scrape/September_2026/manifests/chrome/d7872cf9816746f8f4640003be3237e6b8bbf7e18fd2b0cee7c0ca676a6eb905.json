{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Companion: Dislikes & Watch Time", "version": "1.0.0", "description": "Restores video dislikes and tracks your watch time statistics, history, and daily goals.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon128.png", "default_title": "YouTube Companion Dashboard"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "permissions": ["storage", "notifications", "unlimitedStorage"], "host_permissions": ["https://*.youtube.com/*", "https://returnyoutubedislikeapi.com/*", "http://localhost/*", "https://*.railway.app/*"]}