{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkerBack \u2014 Capture & Copy", "version": "1.0.1", "description": "Screenshot and draw on any page \u2014 free, straight to your computer. Sync into folders and PDF reports with MarkerBack.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "MarkerBack"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["launcher.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["http://*/*", "https://*/*", "file:///*"]}], "permissions": ["activeTab", "scripting", "storage", "sidePanel", "clipboardWrite", "cookies", "tabs", "downloads"], "host_permissions": ["https://www.markerback.com/*", "https://markerback.com/*", "<all_urls>", "file:///*"], "commands": {"capture-shot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the current tab"}, "toggle-draw": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Draw on the current page"}}}