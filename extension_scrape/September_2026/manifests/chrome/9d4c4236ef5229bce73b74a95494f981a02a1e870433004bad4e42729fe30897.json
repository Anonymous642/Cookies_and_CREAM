{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NudgeCSS", "version": "0.5.0", "description": "Click any element on any website to edit its CSS visually \u2014 no code required.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://localhost:8790/*", "https://nudgecss.com/api/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "NudgeCSS", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open or close the NudgeCSS panel"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["side_panel.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}