{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Code Scanner & Generator for PC", "version": "1.5.1", "description": "Scan multiple QR codes from any screen area. Generate QR codes from active tabs or custom links with history tracking.", "permissions": ["storage", "activeTab", "tabs", "commands"], "web_accessible_resources": [{"resources": ["lib/qrcode-generator.js"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "QR Scanner", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"start-scan": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Start QR scan - select region on screen"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/jsQR.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": true}]}