{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kwikly - AI Job Applications", "version": "1.1.1", "description": "Capture jobs from LinkedIn, Indeed, and Glassdoor - generate tailored resumes with AI", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://www.indeed.com/*", "https://indeed.com/*", "https://*.indeed.com/*", "https://www.glassdoor.com/*", "https://glassdoor.com/*", "https://*.glassdoor.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"], "js": ["content/linkedin-jobs.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}, {"matches": ["https://www.indeed.com/*", "https://indeed.com/*", "https://*.indeed.com/*"], "js": ["content/indeed-jobs.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}, {"matches": ["https://www.glassdoor.com/*", "https://glassdoor.com/*", "https://*.glassdoor.com/*"], "js": ["content/glassdoor-jobs.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Kwikly"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}