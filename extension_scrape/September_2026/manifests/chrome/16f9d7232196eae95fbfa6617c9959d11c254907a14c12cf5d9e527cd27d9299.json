{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Share Product - Amazon Wishlist Creator & Multi-Store Collection Tool", "version": "2.4", "description": "Create & share wishlists from Amazon, Walmart, Best Buy, Target, Costco & 50+ stores. One-click collection with shareable links.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://localhost/*", "*://127.0.0.1/*", "*://*.share-product.com/*", "*://share-product.com/*", "*://*.google.com/*", "*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.linkedin.com/*", "*://*.github.com/*", "*://*.stackoverflow.com/*", "*://*.reddit.com/*", "*://*.wikipedia.org/*"], "js": ["smart-extractors.js", "site-configs.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Share Product"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}