{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MerchScope - Product Research Overlay", "version": "1.1.2", "description": "Estimate sales, revenue, and fees on any Amazon, Shopify, or TikTok Shop product page. One-click research overlay.", "permissions": ["storage", "alarms", "tabs", "scripting"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.myshopify.com/*", "https://*.shopify.com/*", "https://www.tiktok.com/*", "https://merchscope.wetyr.com/*", "https://platform.wetyr.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://*.myshopify.com/*", "https://*.shopify.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/shop/*", "https://www.tiktok.com/@*/video/*", "https://www.tiktok.com/view/product/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://merchscope.wetyr.com/*"], "js": ["src/bridge.js"], "run_at": "document_idle"}, {"matches": ["https://*.myshopify.com/*", "https://*.shopify.com/*"], "js": ["src/detect-shopify.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://platform.wetyr.com/*", "https://merchscope.wetyr.com/*"], "js": ["src/auth-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "MerchScope", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/options.html"}