{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Auto-Refresh", "version": "2.5", "description": "Never let \"Try again later\" or \"Still watching?\" error interrupt your YouTube experience again!", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "alarms"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "options.html"}, "web_accessible_resources": [{"resources": ["s1.mp3", "s2.mp3", "s3.mp3", "s4.mp3", "s5.mp3", "s6.mp3", "s7.mp3", "s8.mp3"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}