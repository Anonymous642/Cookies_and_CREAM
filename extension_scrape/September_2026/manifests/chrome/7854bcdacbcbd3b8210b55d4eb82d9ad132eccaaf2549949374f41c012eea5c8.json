{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HuntGo \u2013 eBay Product Hunter", "short_name": "HuntGo", "version": "3.12.1", "minimum_chrome_version": "110", "description": "Hunt products on Amazon and AliExpress, screen brand risk, validate demand on Terapeak and file winners to your Google Sheet.", "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://www.amazon.co.uk/*", "https://*.aliexpress.com/*", "https://www.ebay.co.uk/*", "https://signin.ebay.co.uk/*", "https://script.google.com/*", "https://script.googleusercontent.com/*", "https://*.media-amazon.com/*", "https://*.alicdn.com/*", "https://*.ebayimg.com/*", "https://*.ssl-images-amazon.com/*", "https://*.aliexpress-media.com/*"], "optional_host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*", "https://docs.google.com/spreadsheets/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "HuntGo for eBay", "default_popup": "popup.html"}, "background": {"service_worker": "worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.amazon.co.uk/*", "https://*.aliexpress.com/*", "https://www.ebay.co.uk/*", "https://signin.ebay.co.uk/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}}