{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextBridge \u2014 Universal AI Context Sync", "short_name": "ContextBridge", "version": "1.1.0", "description": "Seamlessly transfer conversation goals, architecture decisions, and code across AI assistants with privacy and token optimization.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "tabs"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://x.ai/*", "https://copilot.microsoft.com/*", "https://edgeservices.bing.com/*", "https://chat.deepseek.com/*", "https://deepseek.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "ContextBridge", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://x.ai/*", "https://copilot.microsoft.com/*", "https://edgeservices.bing.com/*", "https://chat.deepseek.com/*", "https://deepseek.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "src/options/index.html", "commands": {"capture-conversation": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Capture current AI conversation context"}, "transfer-conversation": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Quick transfer conversation context to target AI"}}}