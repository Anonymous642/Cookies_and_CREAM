{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hamesh \u2014 \u0647\u0627\u0645\u0634", "description": "Leave a note exactly where it belongs on a web page, and find it there when you return. Share with your team, optionally.", "version": "2.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "favicon", "alarms", "sidePanel"], "action": {"default_title": "Hamesh", "default_popup": "popup.html"}, "commands": {"activate-hamesh": {"suggested_key": {"default": "Alt+H"}, "description": "Add a note with Hamesh"}, "activate-hamesh-video": {"suggested_key": {"default": "Alt+V"}, "description": "Add a video note with Hamesh"}, "activate-hamesh-text": {"suggested_key": {"default": "Alt+T"}, "description": "Add a note to the selected text"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}], "optional_host_permissions": ["https://api.hamesh.fandees.tech/*"], "optional_permissions": ["identity"], "side_panel": {"default_path": "notes.html?view=panel"}}