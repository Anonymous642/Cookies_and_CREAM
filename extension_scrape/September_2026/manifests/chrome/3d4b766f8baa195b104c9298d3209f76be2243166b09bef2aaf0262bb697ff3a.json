{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Timestamp Notes", "description": "Take timestamped notes in a YouTube sidebar and export/share them.", "version": "1.1.0", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["sidePanel", "tabs", "storage", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["src/content-script.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/sidepanel.html"}, "action": {"default_title": "Open YT Notes Hub", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}}