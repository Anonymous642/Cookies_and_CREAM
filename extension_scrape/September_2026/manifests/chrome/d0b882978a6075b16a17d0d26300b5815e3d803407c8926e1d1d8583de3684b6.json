{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeLoad", "version": "1.9.0", "description": "Unload tabs from RAM without closing them. Right-click a tab -> DeLoad.", "permissions": ["contextMenus", "tabGroups", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "DeLoad", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open the DeLoad popup"}, "deload-current": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "DeLoad this tab"}, "deload-group": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "DeLoad this group"}, "deload-window": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "DeLoad all tabs"}}, "optional_host_permissions": ["<all_urls>"]}