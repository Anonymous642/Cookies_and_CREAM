{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voicemail Player", "version": "0.1.1", "description": "Transcodes MS GSM 6.10 WAV Gmail attachments into playable PCM WAV audio.", "icons": {"32": "img/Voicemail-Player-Extension-Icon-32x32.png", "64": "img/Voicemail-Player-Extension-Icon-64x64.png", "128": "img/Voicemail-Player-Extension-Icon-128x128.png"}, "permissions": ["storage", "offscreen"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content-script.js"], "run_at": "document_start"}]}