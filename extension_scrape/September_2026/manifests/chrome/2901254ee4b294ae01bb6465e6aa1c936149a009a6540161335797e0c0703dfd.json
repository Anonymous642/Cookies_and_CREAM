{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SplitScreen Browser Sync", "description": "Pixel-perfect scroll, click and hover sync per native Chrome Split View pair.", "version": "1.0.0", "minimum_chrome_version": "140", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"sync-current-split-view": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sync current Split View"}, "sync-all-split-views": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Sync all Split Views in the current window"}, "stop-current-split-view": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop sync for current Split View"}, "hard-reload-active-pane": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Hard reload active pane"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SplitScreen Browser Sync", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["icons/icon.svg", "icons/icon16.png", "icons/icon24.png", "icons/icon32.png", "icons/icon48.png", "icons/icon64.png", "icons/icon128.png", "icons/icon256.png"], "matches": ["http://*/*", "https://*/*"]}], "author": "Jan Willem Bijker"}