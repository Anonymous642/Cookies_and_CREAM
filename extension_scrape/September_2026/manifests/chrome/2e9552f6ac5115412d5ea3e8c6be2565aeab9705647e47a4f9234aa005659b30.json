{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Manila Mail Manager", "version": "1.3.0", "description": "Find and unsubscribe from email subscriptions in Gmail with one click", "homepage_url": "https://manilamail.app", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "scripting", "alarms"], "host_permissions": ["https://mail.google.com/*", "https://license.manilamail.app/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail-injector.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Manila Mail Manager"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open email subscription manager"}}, "web_accessible_resources": [{"resources": ["assets/icon-32.png"], "matches": ["https://mail.google.com/*"]}]}