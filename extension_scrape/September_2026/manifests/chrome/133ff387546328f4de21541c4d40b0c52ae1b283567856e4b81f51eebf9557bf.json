{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hover Reader \u2013 Accessibility TTS", "version": "0.2.1", "description": "An accessibility-focused text-to-speech extension that reads text aloud on hover and via keyboard shortcuts.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "commands": {"read-again": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read last spoken text again"}, "toggle-hover": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle hover reading on/off"}, "speed-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase speech rate"}, "speed-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease speech rate"}}}