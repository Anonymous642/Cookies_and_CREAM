{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LexiFont \u2014 Dyslexia Font, Reading Ruler & OpenDyslexic", "short_name": "LexiFont", "description": "Dyslexia-friendly fonts & reading helper. OpenDyslexic, Lexend, reading ruler, tinted overlay. 100% private, no sign-up.", "version": "1.0.1", "author": "LexiFont", "homepage_url": "https://lexifont.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "LexiFont \u2014 dyslexia reading helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["fonts/*", "fonts.css"], "matches": ["<all_urls>"]}], "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://lexifont.com/api/*"], "commands": {"toggle-lexifont": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle LexiFont on the current page"}, "toggle-ruler": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle the reading ruler"}}}