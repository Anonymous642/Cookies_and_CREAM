{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etsy Listing SEO Grader", "version": "1.2.0", "description": "Grades your Etsy listing's SEO (title, tags, description, photos) and gives actionable suggestions to improve visibility.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Etsy SEO Grader"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.etsy.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.etsy.com/your/shops/*/tools/listings*", "https://www.etsy.com/your/shops/*/listing-editor/*", "https://www.etsy.com/listing/*", "https://www.etsy.com/*/listing/*"], "js": ["grader.js", "content.js"], "css": ["panel.css"], "run_at": "document_idle"}]}