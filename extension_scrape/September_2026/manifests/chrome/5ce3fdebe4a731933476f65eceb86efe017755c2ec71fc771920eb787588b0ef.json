{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sheet Tab Groups for Google Sheets", "version": "1.4.0", "description": "Organize your Google Sheets tabs into collapsible groups (folders) via a floating panel.", "permissions": ["storage"], "host_permissions": ["https://docs.google.com/spreadsheets/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Sheet Tab Groups", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+G"}, "description": "Open/close the Sheet Tab Groups panel"}}, "content_scripts": [{"matches": ["https://docs.google.com/spreadsheets/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://docs.google.com/*"]}]}