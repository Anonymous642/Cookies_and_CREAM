{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Eightball Walkthrough Recorder", "version": "1.0.0", "minimum_chrome_version": "126", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "description": "Record product demos as guided walkthroughs for your certification.", "incognito": "split", "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting", "activeTab", "tabCapture", "offscreen", "identity", "contextMenus"], "host_permissions": ["https://teams.eightball.ai/*"], "optional_host_permissions": ["https://*/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume the recording"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Record a product walkthrough"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}