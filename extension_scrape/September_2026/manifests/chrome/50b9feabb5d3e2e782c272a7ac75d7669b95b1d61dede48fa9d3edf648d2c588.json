{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curata - Universal Social Media Saver", "version": "2.0.1", "description": "Save content from any social media platform with AI summaries. Works with major platforms & websites!", "permissions": ["activeTab", "storage", "contextMenus", "scripting", "notifications"], "host_permissions": ["https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.linkedin.com/*", "https://*.tiktok.com/*", "https://*.reddit.com/*", "https://*.github.com/*", "https://*.medium.com/*", "https://*.dev.to/*", "https://*.news.ycombinator.com/*", "https://*.stackoverflow.com/*", "https://*.quora.com/*", "https://*.pinterest.com/*", "https://curata-backend-production.up.railway.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.linkedin.com/*", "https://*.tiktok.com/*", "https://*.reddit.com/*", "https://*.github.com/*", "https://*.medium.com/*", "https://*.dev.to/*", "https://*.news.ycombinator.com/*", "https://*.stackoverflow.com/*", "https://*.quora.com/*", "https://*.pinterest.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Save to Curata"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-content": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current page content"}, "quick-save": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Quick save selected text"}}}