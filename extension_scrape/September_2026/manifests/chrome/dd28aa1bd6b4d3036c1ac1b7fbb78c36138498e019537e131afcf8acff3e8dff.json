{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jira GitHub Side Panel", "version": "1.2.0", "description": "Open a contextual Jira side panel while browsing Jira or GitHub.", "action": {"default_popup": "popup.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["https://*.atlassian.net/*", "https://*.jira.com/*", "https://github.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.atlassian.net/*", "https://*.jira.com/*", "https://github.com/*", "https://*.github.com/*"], "js": ["contentScript.js"]}]}