{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AHSA Student Browser Monitor", "version": "1.2.7", "description": "Headless browser activity monitoring for school-managed Chromebooks. No student-facing UI \u2014 runs silently in the background.", "permissions": ["storage", "tabs", "alarms", "identity", "identity.email", "declarativeNetRequest", "activeTab", "idle"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "scripts/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "run_at": "document_idle"}, {"matches": ["*://*.google.com/search*", "*://www.google.com/*", "*://www.bing.com/search*", "*://www.bing.com/*"], "js": ["scripts/ai-hide.js"], "run_at": "document_start", "all_frames": false}], "declarative_net_request": {"rule_resources": [{"id": "block_rules", "enabled": true, "path": "rules/block_rules.json"}, {"id": "google_games_rules", "enabled": true, "path": "rules/google_games_rules.json"}, {"id": "force_web_tab_rules", "enabled": true, "path": "rules/force_web_tab_rules.json"}]}, "storage": {"managed_schema": "managed_schema.json"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["pages/blocked.html", "pages/blocked.css", "pages/blocked.js", "pages/locked.html", "pages/locked.css", "pages/locked.js", "rules/ai-hide.css"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "110"}