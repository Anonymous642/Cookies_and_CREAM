{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save YouTube Video Screenshot", "version": "1.0.1", "description": "Save the current frame from a YouTube video or Short.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Save YouTube Video Screenshot", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/screenshot.js"], "css": ["src/screenshot.css"], "run_at": "document_idle"}]}