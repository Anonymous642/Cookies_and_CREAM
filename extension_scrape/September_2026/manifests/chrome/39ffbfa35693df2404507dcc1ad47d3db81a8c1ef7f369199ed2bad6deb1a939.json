{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ROM-Helper", "version": "1.8.1", "description": "URL params, credentials, Jira tasks, JSON viewer, debug view & version changer tools. DeinConsultant GmbH.", "icons": {"16": "images/icons/icon16.png", "32": "images/icons/icon32.png", "48": "images/icons/icon48.png", "128": "images/icons/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "declarativeNetRequest", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "ROM-Helper", "default_icon": {"16": "images/icons/icon16.png", "32": "images/icons/icon32.png", "48": "images/icons/icon48.png", "128": "images/icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["json-inline/json-tree.js", "json-inline/content-json-inline.js"], "run_at": "document_end"}, {"matches": ["*://*.atlassian.net/*", "*://*.jira.com/*"], "js": ["jira-filter.js"], "run_at": "document_idle"}], "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open ROM-Helper popup"}}, "web_accessible_resources": [{"resources": ["json-inline/json-inline.css"], "matches": ["<all_urls>"]}, {"resources": ["images/icons/icon16.png", "images/icons/icon32.png", "images/icons/icon48.png", "images/icons/icon128.png"], "matches": ["<all_urls>"]}]}