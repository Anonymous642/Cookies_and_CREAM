{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Sum", "version": "2.9.1", "description": "Select numbers on any webpage and press Ctrl+Shift+Q to sum them.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_icon": "icon.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Toggle Quick Sum"}}, "web_accessible_resources": [{"resources": ["viewer.html", "viewer.js", "content.js", "pdfjs/pdf.mjs", "pdfjs/pdf.worker.mjs", "pdfjs/pdf_viewer.mjs"], "matches": ["file:///*", "http://*/*", "https://*/*"]}]}