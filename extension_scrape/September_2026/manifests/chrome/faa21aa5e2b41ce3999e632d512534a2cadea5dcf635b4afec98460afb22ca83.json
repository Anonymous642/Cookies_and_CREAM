{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "\u2705 Read Aloud \u2013 Text-to-Speech & Word Highlighting", "version": "1.0.2", "description": "Turn selected website text into audio narration with live word highlighting, making it easy to follow and focus.", "permissions": ["tabs", "activeTab", "contextMenus", "storage"], "minimum_chrome_version": "99", "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["mark.min.js", "content.js"], "css": ["popup.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-deactivated16.png", "32": "icons/icon-deactivated32.png", "48": "icons/icon-deactivated48.png", "128": "icons/icon-deactivated128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle read aloud"}, "play": {"suggested_key": {"default": "Alt+P"}, "description": "Resume reading"}, "pause": {"suggested_key": {"default": "Alt+S"}, "description": "Pause reading"}}}