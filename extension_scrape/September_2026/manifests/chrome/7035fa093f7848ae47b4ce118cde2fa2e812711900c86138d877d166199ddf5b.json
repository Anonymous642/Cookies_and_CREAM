{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScribeRyte ClickNote", "version": "2.0.0", "description": "Save time and ensure accuracy with ScribeRyte ClickNote, a secure solution importing AI-generated SOAP notes directly into your EHR.", "permissions": ["activeTab", "tabs", "tabGroups", "windows", "storage", "unlimitedStorage", "scripting", "notifications", "alarms", "offscreen"], "host_permissions": ["<all_urls>", "https://vlcfv42rx5.execute-api.us-east-2.amazonaws.com/*", "https://api.scriberyte.com/*", "https://api.scriberyte.com/*", "https://*.s3.*.amazonaws.com/*", "https://*.s3.amazonaws.com/*", "https://scribeemr-apim-qa.azure-api.net/*", "https://xgq1pp5aeh.execute-api.us-east-2.amazonaws.com/*", "https://api.deepgram.com/*", "https://*.cognitive.microsoft.com/*", "https://*.speech.microsoft.com/*", "https://*.stt.speech.microsoft.com/*"], "externally_connectable": {"matches": ["https://app.scriberyte.com/*", "https://*.scriberyte.com/*", "https://*.scribeemr.com/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"_comment": "EHR handler scripts \u2014 injected on every page to detect and push to EMR forms", "matches": ["<all_urls>"], "js": ["content-utils.js", "emr-handlers/advancedmd.js", "emr-handlers/drchrono.js", "emr-handlers/prognosis.js", "emr-handlers/nextgen.js", "emr-handlers/tebra.js", "emr-handlers/practicefusion.js", "emr-handlers/caretracker.js", "emr-handlers/officeally.js", "emr-handlers/medicscloud.js", "emr-handlers/veracity.js", "content.js"], "run_at": "document_idle"}, {"_comment": "Relay script \u2014 runs ONLY on the Scriberyte web app. Bridges DOM CustomEvents to the extension background without exposing the extension ID. This is what lets app.scriberyte.com trigger a note push with zero knowledge of the extension ID.", "matches": ["https://app.scriberyte.com/*", "https://*.scriberyte.com/*", "https://*.scribeem