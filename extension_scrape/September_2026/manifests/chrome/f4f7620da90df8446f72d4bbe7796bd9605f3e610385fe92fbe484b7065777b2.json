{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Enhanced Find & Print", "version": "2.1.0", "description": "Enhanced text search with site-aware browser printing for the current webpage.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Enhanced Find & Print", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js"}, "commands": {"open-enhanced-find": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Enhanced Find & Print"}, "clean-print": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open site-aware Print / Save PDF"}}, "web_accessible_resources": [{"resources": ["toolbar.css"], "matches": ["<all_urls>"]}]}