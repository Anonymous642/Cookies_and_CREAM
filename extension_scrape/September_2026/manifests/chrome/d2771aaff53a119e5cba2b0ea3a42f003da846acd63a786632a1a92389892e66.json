{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cura Digital Assistant", "version": "1.13", "description": "Cura can perform complex tasks in the browser for you!", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo16.png", "32": "assets/logo32.png", "48": "assets/logo48.png", "128": "assets/logo128.png"}}, "web_accessible_resources": [{"resources": ["assets/icon3.svg", "assets/fonts/EuclidCircularB-*.ttf", "assets/volume.svg", "assets/volume-on.svg", "assets/volume-off.svg", "assets/drag.svg", "assets/profile.svg", "assets/chevron-down.svg", "assets/pause.svg", "assets/play.svg", "assets/microphone.svg", "assets/send.svg", "assets/sparkles.svg", "assets/sparkles-group.svg", "assets/drag-dots.svg", "assets/maximize-icon.svg"], "matches": ["<all_urls>"]}], "commands": {"log-text": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Log selected text"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "options_page": "options.html", "icons": {"16": "assets/logo16.png", "32": "assets/logo32.png", "48": "assets/logo48.png", "128": "assets/logo128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "externally_connectable": {"matches": ["*://curalabs.io/*", "http://localhost:3000/*", "*://curalabs-web.vercel.app/*", "*://curalabs-web--curalabs.us-central1.hosted.app/*", "*://curalabs.web.app/*"]}}