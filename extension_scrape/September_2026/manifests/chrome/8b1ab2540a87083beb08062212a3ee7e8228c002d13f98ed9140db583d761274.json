{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Table to Excel & SQL", "description": "Capture web tables & dropdowns, edit in a side panel, generate SQL, and export to Excel/CSV/HTML/JSON.", "version": "1.7.6", "minimum_chrome_version": "114", "icons": {"48": "images/SQLToExcelIcon_48.png", "64": "images/SQLToExcelIcon_64.png", "128": "images/SQLToExcelIcon_128.png", "256": "images/SQLToExcelIcon_256.png"}, "action": {"default_title": "Web Table to Excel & SQL", "default_icon": {"48": "images/SQLToExcelIcon_48.png", "128": "images/SQLToExcelIcon_128.png"}}, "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting", "downloads", "tabs"], "host_permissions": ["https://tessdata.projectnaptha.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"matches": ["http://*/*", "https://*/*"], "resources": ["src/content/index.js"], "use_dynamic_url": false}]}