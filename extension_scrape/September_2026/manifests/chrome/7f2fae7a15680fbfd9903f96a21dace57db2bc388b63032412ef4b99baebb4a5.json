{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MeetingArmor \u2014 Your screen-share privacy buddy", "version": "1.0.0", "description": "Blurs every off-list tab the moment you screen-share, so nothing slips out. You pick what stays visible. Local-first, no tracking.", "minimum_chrome_version": "116", "permissions": ["tabs", "storage", "scripting", "windows", "contextMenus", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "MeetingArmor", "default_icon": {"16": "icons/shield-16.png", "32": "icons/shield-32.png", "48": "icons/shield-48.png", "128": "icons/shield-128.png"}}, "icons": {"16": "icons/shield-16.png", "32": "icons/shield-32.png", "48": "icons/shield-48.png", "128": "icons/shield-128.png"}, "commands": {"panic": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "PANIC: vault all tabs and show a blank New Tab"}}, "web_accessible_resources": [{"resources": ["icons/shield-48.png"], "matches": ["<all_urls>"]}]}