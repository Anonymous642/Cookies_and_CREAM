{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CitRe", "version": "1.0.0", "minimum_chrome_version": "127", "description": "Turn highlighted scholarly text into citations, verify with optional Crossref, and hand off references to Paperpile.", "permissions": ["activeTab", "contextMenus", "storage", "clipboardRead", "clipboardWrite", "offscreen"], "host_permissions": ["https://api.crossref.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["src/content/googleDocsMain.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["src/content/selection.js"], "css": ["src/content/selection.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "action": {"default_title": "CitRe", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"cite-selection": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Create a CitRe citation from the current selection"}}}