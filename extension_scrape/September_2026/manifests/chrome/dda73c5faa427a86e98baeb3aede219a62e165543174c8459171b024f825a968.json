{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InstaLoader", "version": "1.1.8", "description": "Download videos and images in one click from Instagram, X, Facebook and Reddit. Reddit videos keep their sound.", "permissions": ["downloads"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.facebook.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://*.facebook.com/*"], "js": ["fb-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.reddit.com/*"], "js": ["reddit-mux.js", "reddit.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}