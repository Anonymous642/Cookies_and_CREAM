{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Recorder Pro - Up to 4K & 60 FPS", "version": "1.2.0", "description": "Record your screen, a tab, a window, or Google Meet up to 4K and 60 FPS, plus page screenshots. Saved on your device.", "minimum_chrome_version": "116", "homepage_url": "https://resndevs.com", "short_name": "Screen Rec Pro", "permissions": ["activeTab", "scripting", "tabCapture", "downloads", "storage", "offscreen", "notifications", "alarms"], "optional_host_permissions": ["https://meet.google.com/*", "http://*/*", "https://*/*"], "action": {"default_popup": "src/popup.html", "default_title": "Screen Recorder Pro - Up to 4K & 60 FPS", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_page": "src/options.html", "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording"}, "pause-resume": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause or resume recording"}}}