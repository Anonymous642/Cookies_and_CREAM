{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Song Timer - Mood Based Music Scheduler", "version": "1.0", "description": "Schedule your favorite songs or playlists from YouTube or Spotify based on time or mood", "permissions": ["storage", "alarms"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Song Timer"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.spotify.com/embed/*", "*://*.spotify.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}