{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HorusTabs", "version": "1.0.0", "description": "A web extension to save, manage and restore sessions, windows and tabs.", "author": "Emil Milev", "homepage_url": "https://horustabs.com", "action": {"default_title": "HorusTabs", "default_popup": "./src/popup/index.html", "default_icon": {"16": "favicons/16.png", "32": "favicons/32.png", "64": "favicons/64.png"}}, "background": {"service_worker": "./src/background/background.js", "type": "module"}, "options_ui": {"page": "./src/options/index.html", "open_in_tab": true}, "commands": {"save-current-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}}, "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "contextMenus", "downloads", "bookmarks", "notifications", "sessions", "system.display", "favicon"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "externally_connectable": {"matches": ["https://horustabs.com/*"]}, "content_scripts": [{"matches": ["https://horustabs.com/auth/extension*"], "js": ["./src/content/auth-relay.js"], "run_at": "document_idle"}], "icons": {"16": "favicons/16.png", "32": "favicons/32.png", "48": "favicons/48.png", "64": "favicons/64.png", "128": "favicons/128.png"}, "default_locale": "en"}