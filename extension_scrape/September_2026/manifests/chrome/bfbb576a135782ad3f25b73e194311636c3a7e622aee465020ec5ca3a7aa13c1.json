{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DuoNinja - Dual captions for YouTube videos", "version": "2.2.2", "description": "Learn languages with dual captions. Import your Duolingo vocabulary and learn it with flashcards.", "icons": {"16": "images/logo-16.png", "32": "images/logo-32.png", "128": "images/logo-128.png"}, "permissions": ["storage"], "host_permissions": ["http://localhost:3000/*", "https://www.duoninja.com/*", "https://www.duolingo.com/*", "https://www.youtube.com/*"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.duolingo.com/*"], "js": ["content/duolingo-import.js"], "css": ["content/duolingo-import.css"]}, {"matches": ["https://www.youtube.com/*"], "js": ["content/yt/lang.js", "content/yt/words.js", "content/yt/caption-lookup-context.js", "content/yt/phrase-selection.js", "content/yt/cues.js", "content/yt/runtime.js", "content/yt/icons.js", "content/yt/tts.js", "content/yt/word-panel.js", "content/yt/settings.js", "content/yt/listening.js", "content/yt/auth-prompt.js", "content/youtube-dual.js"], "css": ["content/youtube-dual.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["content/youtube-dual-bridge.js", "images/logo-32.png"], "matches": ["https://www.youtube.com/*"]}]}