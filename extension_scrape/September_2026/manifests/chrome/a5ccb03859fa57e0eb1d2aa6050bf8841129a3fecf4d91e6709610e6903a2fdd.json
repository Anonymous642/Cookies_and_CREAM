{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CommentLens - Comment Exporter & Analyzer", "version": "0.5.0", "description": "Export YouTube, Reddit & X (Twitter) comments to CSV with keyword, question & buyer-intent analysis.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://www.reddit.com/*", "https://old.reddit.com/*", "https://reddit.com/*", "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://mobile.twitter.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CommentLens", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://www.reddit.com/r/*/comments/*", "https://www.reddit.com/comments/*", "https://old.reddit.com/r/*/comments/*", "https://old.reddit.com/comments/*", "https://reddit.com/r/*/comments/*", "https://reddit.com/comments/*", "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://mobile.twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}