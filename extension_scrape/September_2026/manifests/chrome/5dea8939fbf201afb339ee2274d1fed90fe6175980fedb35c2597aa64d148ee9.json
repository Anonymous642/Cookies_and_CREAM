{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteChrome", "version": "0.24.0", "description": "Quick notes in a side panel. Markdown, tags, search, page-linking. Works locally out of the box, or sync to your own server.", "permissions": ["storage", "unlimitedStorage", "tabs", "sidePanel"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "NoteChrome"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open NoteChrome panel"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}