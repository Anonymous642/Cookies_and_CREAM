{"manifest_version": 3, "name": "BrainApp Guard", "description": "Website blocking and browser activity stats for BrainApp.", "version": "1.0.24", "minimum_chrome_version": "101", "update_url": "https://clients2.google.com/service/update2/crx", "incognito": "spanning", "permissions": ["storage", "declarativeNetRequest", "tabs", "webNavigation", "alarms", "idle", "scripting", "nativeMessaging"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "auto_guard_pornography", "enabled": false, "path": "rules/auto-guard-pornography.json"}, {"id": "auto_guard_gambling", "enabled": false, "path": "rules/auto-guard-gambling.json"}]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["auto-guard-content.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["http://*/*", "https://*/*"], "js": ["limit-timer.js", "focus-nudge.js", "page-note.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/icon-logo-main32.png", "icons/icon-logo-main48.png"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "options.html", "action": {"default_title": "BrainApp Guard", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-logo-main16.png", "32": "icons/icon-logo-main32.png", "48": "icons/icon-logo-main48.png", "128": "icons/icon-logo-main128.png"}}, "icons": {"16": "icons/icon-logo-main16.png", "32": "icons/icon-logo-main32.png", "48": "icons/icon-logo-main48.png", "128": "icons/icon-logo-main128.png"}}