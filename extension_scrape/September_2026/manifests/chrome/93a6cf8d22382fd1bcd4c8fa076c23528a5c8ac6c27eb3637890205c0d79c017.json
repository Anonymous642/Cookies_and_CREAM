{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amber", "description": "Personal web archive: capture pages, selections and PDFs, then find them instantly. Everything local.", "version": "0.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "138", "permissions": ["storage", "unlimitedStorage", "offscreen", "sidePanel", "contextMenus", "alarms", "downloads", "tabs", "scripting", "activeTab"], "optional_permissions": ["bookmarks", "readingList", "notifications"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to Amber"}, "open-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Amber beside the page"}, "save-selection": {"description": "Save the current selection to Amber"}, "quick-note": {"description": "Capture a quick note in Amber"}}, "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_title": "Amber \u2014 capture", "default_popup": "popup.html"}, "omnibox": {"keyword": "amber"}, "options_ui": {"page": "app.html#/settings", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}