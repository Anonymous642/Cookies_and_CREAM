{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrystalBox AI \u2014 Memory Isolation & Long-Term Memory", "version": "0.5.5", "minimum_chrome_version": "114", "description": "Fix AI context confusion and wrong GPT answers with local memory isolation across people, projects, and AI tools.", "permissions": ["storage", "activeTab", "contextMenus", "clipboardRead", "clipboardWrite", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://crystalboxai.com/*", "https://www.crystalboxai.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.crystalboxai.com"}, "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "options_page": "settings/settings.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["api/posthog-config.js", "api/posthog.js", "api/analytics.js", "api/supabase.js", "api/sync-merge.js", "content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/content.css"], "matches": ["<all_urls>"]}], "action": {"default_title": "CrystalBox AI", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "commands": {"open-crystalbox": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open CrystalBox AI on the current page"}}}