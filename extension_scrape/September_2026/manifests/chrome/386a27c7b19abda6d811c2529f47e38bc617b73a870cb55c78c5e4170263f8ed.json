{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unclaw", "version": "1.1.0", "description": "Your Unclaw companion in a side panel. She sees the page you see, answers by voice, and acts in your browser when you ask.", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus"], "host_permissions": ["http://127.0.0.1/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel.html"}, "action": {"default_title": "Open Unclaw", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"ask-text": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ask about the selection (type your question)"}, "ask-voice": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Ask about the selection (speak your question)"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://unclaw.io"}