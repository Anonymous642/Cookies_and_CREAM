{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anchor", "version": "1.0.8", "description": "Keep the YouTube video anchored while browsing the page.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "Anchor: OFF", "default_icon": {"16": "icons/ANCHOR_off_16.png", "32": "icons/ANCHOR_off_32.png", "48": "icons/ANCHOR_off_48.png", "128": "icons/ANCHOR_off_128.png"}}, "icons": {"16": "icons/ANCHOR_on_16.png", "32": "icons/ANCHOR_on_32.png", "48": "icons/ANCHOR_on_48.png", "128": "icons/ANCHOR_on_128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}