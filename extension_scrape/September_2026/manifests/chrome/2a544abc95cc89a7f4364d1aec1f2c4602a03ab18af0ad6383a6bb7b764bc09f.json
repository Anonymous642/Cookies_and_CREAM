{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leetup", "description": "Leetcode extension", "version": "0.0.5", "icons": {"16": "icon/icon-16.png", "24": "icon/icon-24.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "permissions": ["activeTab", "storage", "cookies"], "host_permissions": ["https://leetup.app/*", "https://getleetup.com/*", "https://leetup.netlify.app/*", "http://localhost/*"], "action": {"default_popup": "popup-bak.html"}, "default_locale": "en", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["monaco-inject.js", "room-inject.js", "github-inject.js"], "matches": ["*://*/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}