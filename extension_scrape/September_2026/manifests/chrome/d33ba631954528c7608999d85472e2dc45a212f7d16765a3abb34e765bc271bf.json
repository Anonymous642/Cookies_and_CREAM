{"update_url": "https://clients2.google.com/service/update2/crx", "name": "JobTwine Copilot", "description": "Bring JobTwine into Meet/Zoom/Teams with a side panel", "version": "1.6.7", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "tabs", "scripting", "storage"], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://jobtwine.com/*", "https://*.lever.co/*", "https://*.turbohire.co/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "JobTwine Copilot"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://jobtwine.com/*", "https://*.lever.co/*", "https://*.turbohire.co/*"], "js": ["ats-platforms.js", "content.js"], "run_at": "document_idle"}]}