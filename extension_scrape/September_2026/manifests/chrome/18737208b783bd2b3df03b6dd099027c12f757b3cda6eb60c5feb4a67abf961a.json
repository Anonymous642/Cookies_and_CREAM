{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Indent Browser Use", "version": "0.1.1", "description": "Let the Indent agent work in your browser, in a tab group you can control and can watch. Requires the Indent desktop app to connect.", "permissions": ["debugger", "tabs", "tabGroups", "alarms", "scripting", "storage", "nativeMessaging"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Indent Browser Use", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}