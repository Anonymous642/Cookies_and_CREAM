{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OctaMart Product Extractor", "version": "1.0.1", "description": "Extract product details from e-commerce sites and add them to your OctaMart vendor catalog", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"}, "permissions": ["storage", "activeTab", "contextMenus", "sidePanel"], "host_permissions": ["https://*.arounds.us/*", "https://dev.apis.octanest.com/*", "https://octamart.arounds.us/*"], "background": {"service_worker": "dist/background/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.nl/*", "https://*.amazon.se/*", "https://*.amazon.pl/*", "https://*.amazon.com.tr/*", "https://*.amazon.com.mx/*", "https://*.amazon.com.br/*", "https://*.amazon.com.au/*", "https://*.amazon.co.jp/*", "https://*.amazon.ae/*", "https://*.amazon.sa/*", "https://*.amazon.sg/*", "https://*.amazon.eg/*", "https://*.amazon.ca/*", "https://*.amazon.be/*", "https://*.amazon.com.be/*", "https://*.amazon.co.za/*", "https://*.amazon.cl/*", "https://amazon.com/*", "https://amazon.in/*", "https://*.flipkart.com/*", "https://flipkart.com/*"], "js": ["dist/content/content.js"], "run_at": "document_idle"}, {"matches": ["https://octamart.arounds.us/*", "https://*.arounds.us/*"], "js": ["dist/content/octamart-bridge.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["popup.html", "ic