{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Music Speed Changer", "version": "2.14", "description": "Change and remember playback speed on YouTube Music", "permissions": ["storage", "webRequest"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "host_permissions": ["*://music.youtube.com/*", "*://*.googlevideo.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["bookmark_empty.png", "bookmark_filled.png", "speed_icon.png", "background.png"], "matches": ["*://music.youtube.com/*"]}]}