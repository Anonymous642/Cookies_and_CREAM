{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fractal Video Shufflr YouTube Extension", "description": "Black out YouTube videos under 100k views to help you spot hits to recreate.", "version": "0.2.3", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Fractal Video Shufflr", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png"}}, "permissions": ["activeTab", "storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://youtubetotranscript.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}]}