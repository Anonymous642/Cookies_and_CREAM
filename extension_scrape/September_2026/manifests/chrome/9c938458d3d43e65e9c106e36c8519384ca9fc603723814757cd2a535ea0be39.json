{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Exporter", "description": "Export AI conversations from ChatGPT, Claude & Gemini to PDF, Markdown & Notion \u2014 beautifully.", "version": "1.2.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://api.notion.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content/parser.js", "content/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content/parser.js", "content/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content/parser.js", "content/gemini.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}