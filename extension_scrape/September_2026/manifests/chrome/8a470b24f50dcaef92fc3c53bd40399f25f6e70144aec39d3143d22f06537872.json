{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteProof", "version": "0.1.1", "minimum_chrome_version": "102", "description": "Catch copy-and-paste mistakes across tabs. Comparisons stay private and local to your browser.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "PasteProof", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options/options.html", "commands": {"capture-value": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Capture the selected or current value"}, "verify-value": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Verify the current field"}, "clear-capture": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Clear the captured value"}}}