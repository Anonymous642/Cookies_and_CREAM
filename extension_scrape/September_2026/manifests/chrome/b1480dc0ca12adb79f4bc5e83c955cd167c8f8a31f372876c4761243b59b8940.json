{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Konto - AWS Account Navigator - For AWS Devs", "version": "1.3.0", "description": "Quick access to AWS accounts, for AWS Devs", "author": "dokuritsu", "homepage_url": "https://buymeacoffee.com/dokuritsu", "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "action": {"default_popup": "popup.html", "default_title": "Konto - AWS Account Navigator", "default_icon": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}}, "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://*.console.aws.amazon.com/*", "https://*.merlon.amazon.dev/*", "https://*.amazon.dev/*", "https://*.amazon.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.console.aws.amazon.com/*", "https://*.merlon.amazon.dev/*"], "js": ["content-enhancer.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icon_*.png"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "88", "short_name": "Konto", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Konto AWS Account Navigator"}}, "options_page": "popup.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "externally_connectable": {"matches": ["https://*.console.aws.amazon.com/*", "https://*.merlon.amazon.dev/*"]}}