{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Proxy", "version": "1.147.16", "description": "Quick proxy switcher for Chrome (HTTP/HTTPS/SOCKS4/SOCKS5)", "minimum_chrome_version": "102", "author": "Mrserg123", "permissions": ["proxy", "storage"], "background": {"service_worker": "background/background.js", "type": "module"}, "incognito": "split", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_popup": "index.html", "default_title": "Proxy switcher", "default_icon": {"16": "icons/Proxy16.png", "32": "icons/Proxy32.png", "48": "icons/Proxy48.png", "64": "icons/Proxy64.png", "128": "icons/Proxy128.png"}}, "icons": {"16": "icons/Proxy16.png", "32": "icons/Proxy32.png", "48": "icons/Proxy48.png", "64": "icons/Proxy64.png", "128": "icons/Proxy128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open proxy switcher"}, "toggle-proxy": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Toggle proxy on/off"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}