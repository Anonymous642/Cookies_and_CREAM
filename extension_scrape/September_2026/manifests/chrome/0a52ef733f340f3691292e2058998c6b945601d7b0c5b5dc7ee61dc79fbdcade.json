{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Email Paste Shortcut", "description": "Paste the primary Chrome profile email into the focused field with a hotkey.", "version": "1.1.0", "manifest_version": 3, "permissions": ["identity", "identity.email", "activeTab", "scripting", "clipboardWrite"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"paste-email": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Paste profile email into the focused field"}}}