{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bulk Power Tools for HubSpot", "version": "0.1.0", "description": "Bulk-edit HubSpot snippets, HubDB & redirects in a spreadsheet. Preview every change as a diff before it syncs. No API setup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Bulk Power Tools"}, "permissions": ["storage"], "host_permissions": ["https://*.hubspot.com/*", "https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/extpay.js"], "run_at": "document_start"}, {"matches": ["https://*.hubspot.com/*"], "js": ["content/engine/csv.js", "content/engine/differ.js", "content/engine/runner.js", "content/adapters/base.js", "content/adapters/snippets.js", "content/adapters/hubdb.js", "content/adapters/redirects.js", "content/ui/panel.js", "content/main.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.hubspot.com/*"]}]}