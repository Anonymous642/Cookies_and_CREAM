{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Privacy Guardian", "version": "0.7.2", "description": "Password manager + Privacy Shield: encrypted vault, tracker blocking, breach warnings, autofill, and site privacy score.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "scripting", "webAuthenticationProxy", "declarativeNetRequest", "declarativeNetRequestFeedback", "browsingData", "webNavigation", "alarms"], "host_permissions": ["https://app.privacyguardian.co/*", "https://*/*", "http://*/*"], "declarative_net_request": {"rule_resources": [{"id": "trackers", "enabled": true, "path": "rules/trackers.json"}]}, "action": {"default_popup": "popup.html", "default_title": "Privacy Guardian", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}