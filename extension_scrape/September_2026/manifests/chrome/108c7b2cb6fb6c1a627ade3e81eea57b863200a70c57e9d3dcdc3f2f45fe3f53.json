{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Spotlight", "version": "1.0.0", "minimum_chrome_version": "102", "description": "Spotlight-style tab switcher. Search tabs, history, bookmarks, and recently closed \u2014 all from one keyboard shortcut.", "permissions": ["tabs", "bookmarks", "history", "sessions", "storage", "tabGroups", "scripting", "activeTab"], "action": {"default_title": "Tab Spotlight"}, "background": {"service_worker": "background.js"}, "commands": {"open-spotlight": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open Tab Spotlight"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}