{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipGrabber", "version": "1.1.0", "description": "Detects Clip.Cafe clips and provides a direct MP4 download.", "permissions": ["activeTab", "downloads"], "host_permissions": ["https://clip.cafe/*"], "action": {"default_title": "ClipGrabber", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://clip.cafe/*"], "js": ["content.js"], "run_at": "document_idle"}]}