{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Limit \u2014 Tab Cap, Groups & Focus Sessions", "version": "2.2.0", "description": "Caps your open tabs, auto-groups them by category, closes idle ones, and runs timed focus sessions. Free, no paywalls.", "permissions": ["tabs", "tabGroups", "storage", "notifications", "alarms", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Focus Dashboard"}, "snooze-15": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Snooze protection for 15 minutes"}}}