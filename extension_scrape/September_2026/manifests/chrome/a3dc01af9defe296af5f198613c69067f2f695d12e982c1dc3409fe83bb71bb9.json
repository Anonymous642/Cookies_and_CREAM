{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tax Helper by Arc & Ledger", "version": "1.0.1", "description": "Private, educational explanations of tax-form fields, published by Arc & Ledger Accounting.", "homepage_url": "https://www.arcandledger.com/tax-helper/", "minimum_chrome_version": "116", "incognito": "not_allowed", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Tax Helper", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "src/pdf/pdf-helper.html"}, "options_page": "src/options/options.html", "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.irs.gov/*", "https://*.turbotax.intuit.com/*", "https://*.myturbotax.intuit.com/*", "https://*.freetaxusa.com/*", "https://*.hrblock.com/*", "https://*.taxact.com/*", "https://*.taxslayer.com/*", "https://*.olt.com/*", "https://cash.app/*", "https://*.cashapp.com/*", "https://*.efile.com/*", "https://*.1040.com/*", "https://*.tax.service.gov.uk/*", "https://*.canada.ca/*", "https://*.cra-arc.gc.ca/*", "https://*.ato.gov.au/*"], "js": ["src/content/sanity-content.js", "src/content/content-script.js"], "css": ["src/content/overlay.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["https://api.anthropic.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "commands": {"explain-focused-field": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Explain the currently focused tax field"}}}