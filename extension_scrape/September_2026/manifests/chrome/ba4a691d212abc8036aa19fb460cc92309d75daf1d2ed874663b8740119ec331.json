{"manifest_version": 3, "name": "Among Us Cursor", "version": "1.1.3", "description": "Add a touch of fun and mystery to your browsing with the Among Us Cursor Pack.", "icons": {"16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["cur/*.*"], "matches": ["*://*/*"]}], "update_url": "https://clients2.google.com/service/update2/crx"}