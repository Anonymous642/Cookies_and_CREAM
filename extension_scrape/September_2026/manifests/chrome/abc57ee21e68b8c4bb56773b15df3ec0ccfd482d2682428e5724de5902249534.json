{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Taptale Recorder", "short_name": "Taptale", "version": "2.0.20", "description": "Record and share interactive product demos, walkthroughs, and video guides from any web page.", "homepage_url": "https://taptale.app", "permissions": ["activeTab", "tabs", "tabCapture", "scripting", "storage", "offscreen", "unlimitedStorage", "notifications", "identity", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Taptale Recorder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "dist/background.js"}, "externally_connectable": {"matches": ["https://taptale.app/*", "https://pro.taptale.app/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["https://pro.taptale.app/*", "https://taptale.app/*"]}, {"resources": ["dist/rrweb-canvas-worker.js"], "matches": ["<all_urls>"]}, {"resources": ["camera-bubble.html", "dist/camera-bubble.js"], "matches": ["<all_urls>"]}]}