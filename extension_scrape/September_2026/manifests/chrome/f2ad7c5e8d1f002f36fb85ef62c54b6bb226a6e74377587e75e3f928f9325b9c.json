{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Mode \u2013 Block Feeds, Not Tools", "version": "1.0.0", "description": "Blocks distracting feeds while keeping useful pages accessible. Deep Work timer, whitelist, impulse delay. No account needed.", "permissions": ["storage", "tabs", "alarms", "idle", "notifications"], "host_permissions": ["https://api.gumroad.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"start-session-25": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start 25-minute Deep Work Session"}, "toggle-focus-mode": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle Focus Mode on/off"}}}