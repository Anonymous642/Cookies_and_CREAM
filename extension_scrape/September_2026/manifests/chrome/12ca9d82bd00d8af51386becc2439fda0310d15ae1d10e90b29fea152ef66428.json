{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LumoScroll: Attention & Doomscroll Tracker", "version": "1.10.11", "description": "Reveals what you actually pause on, not just scroll past, on X, Reddit, LinkedIn and YouTube. Topics, mood, timing. 100% on-device.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://old.reddit.com/*", "https://www.linkedin.com/*", "https://www.youtube.com/*", "https://lumoscroll-worker.shovon-ua.workers.dev/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://old.reddit.com/*", "https://www.linkedin.com/*", "https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "LumoScroll: Open your scroll digest"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}