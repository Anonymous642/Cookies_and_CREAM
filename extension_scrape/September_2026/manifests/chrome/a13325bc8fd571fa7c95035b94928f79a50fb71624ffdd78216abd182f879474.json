{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTune", "version": "1.0.0", "description": "Control audio for individual tabs with volume and voice focus", "action": {"default_popup": "popup.html", "default_title": "TabTune: Total Volume Control for Every Tab"}, "permissions": ["activeTab", "tabCapture", "storage", "offscreen"], "background": {"service_worker": "background.js", "type": "module"}, "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js"], "matches": ["<all_urls>"]}]}