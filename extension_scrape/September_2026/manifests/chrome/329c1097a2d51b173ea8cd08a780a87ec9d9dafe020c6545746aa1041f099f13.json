{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadEase \u2014 Dyslexia-Friendly Reader", "version": "1.2.0", "description": "Dyslexia-friendly reading: spacing & fonts, reading ruler, calm mode, and multilingual text-to-speech with natural voices.", "permissions": ["storage", "tts", "contextMenus", "activeTab", "offscreen", "sidePanel"], "host_permissions": ["https://texttospeech.googleapis.com/*", "https://api.dictionaryapi.dev/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "service-worker.js"}, "side_panel": {"default_path": "popup/popup.html?ctx=side"}, "action": {"default_popup": "popup/popup.html", "default_title": "ReadEase", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/typography.js", "content/ruler.js", "content/calm.js", "content/declutter.js", "content/tts-highlight.js", "content/texttools.js", "content/dictionary.js", "content/pacer.js", "content/simplify.js", "content/colorblind.js", "content/toolbar.js", "content/content.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["fonts/*", "content/overlay.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-ruler": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle reading ruler"}, "read-aloud": {"suggested_key": {"default": "Alt+S"}, "description": "Read aloud from selection"}, "toggle-clean-view": {"suggested_key": {"default": "Alt+C"}, "description": "Toggle clean reading view"}, "toggle-calm": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle calm mode"}}}