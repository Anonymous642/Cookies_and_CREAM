{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "3D SBS Master", "version": "1.2.3", "description": "Adjust per-eye width/depth, enhance video quality, convert 2D to 3D, or convert VR video to SBS \u2014 all in your browser.", "permissions": ["webNavigation", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "3D SBS Master: click a wide video to open the adjustment panel", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content/storage.js", "content/engine.js", "content/panel.js", "content/2dto3d-engine.js", "content/vr180-engine.js", "content/upscale-engine.js", "content/content.js"]}], "commands": {"nudge-width-down": {"suggested_key": {"default": "Alt+Shift+Comma"}, "description": "Nudge Width down"}, "nudge-width-up": {"suggested_key": {"default": "Alt+Shift+Period"}, "description": "Nudge Width up"}, "nudge-depth-down": {"description": "Nudge Depth down (bind a shortcut in chrome://extensions/shortcuts)"}, "nudge-depth-up": {"description": "Nudge Depth up (bind a shortcut in chrome://extensions/shortcuts)"}}}