{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zonar WindoorCraft Extractor", "version": "1.4.15", "description": "Extract production order data from WindoorCraft printer pages and send to Zonar ERP.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["identity", "storage"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Zonar Extractor", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.windoorcraft.com/printer*"], "js": ["src/content/extract.js", "src/lib/units.js", "src/content/inject.js"], "css": ["src/content/styles.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["*://*.windoorcraft.com/*"]}]}