{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Privacy Shield", "version": "1.1.0", "description": "Instantly blur your AI chat history on ChatGPT, Claude, Gemini & Perplexity. One click privacy for shared screens.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-locked-16.png", "48": "icons/icon-locked-48.png", "128": "icons/icon-locked-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "commands": {"toggle-blur": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Toggle chat history blur"}}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*"], "js": ["content/content.js"], "css": ["content/blur.css"], "run_at": "document_start"}]}