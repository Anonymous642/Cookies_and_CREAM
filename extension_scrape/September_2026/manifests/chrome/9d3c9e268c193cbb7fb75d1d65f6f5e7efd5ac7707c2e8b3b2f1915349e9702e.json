{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Find Better Deal", "version": "1.1.0", "description": "Smart shopping assistant that compares prices across e-commerce platforms in India to find the best deals", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "offscreen"], "host_permissions": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.supabase.co/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Find Better Deal"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.amazon.in/*", "*://*.flipkart.com/*"], "js": ["content.js"], "run_at": "document_end"}]}