{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LTD Swap Extension", "version": "1.0.2", "description": "This extension helps listing ltds on ltdswap.com from appsumo.com.", "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Open Panel"}, "permissions": ["windows", "scripting", "activeTab"], "host_permissions": ["https://appsumo.com/*", "https://ltdswap.com/*", "https://api.ltdswap.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["injected-monitor.js"], "matches": ["https://appsumo.com/*"]}], "content_scripts": [{"matches": ["*://*.appsumo.com/*"], "js": ["content.js"]}, {"matches": ["https://appsumo.com/account/profile*"], "js": ["profile-script.js"]}, {"matches": ["https://appsumo.com/account/products/*"], "js": ["product-script.js"], "run_at": "document_start"}, {"matches": ["https://ltdswap.com/*"], "js": ["ltdswap-script.js"]}, {"matches": ["https://api.ltdswap.com/*"], "js": ["ltdswap-script.js"]}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}