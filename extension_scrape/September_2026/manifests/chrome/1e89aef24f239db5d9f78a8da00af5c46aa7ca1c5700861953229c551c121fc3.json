{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TABTile", "version": "1.0.0", "description": "Visualize and switch tabs with a 3D carousel or tile grid.", "permissions": ["tabs", "storage", "unlimitedStorage", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Open TABTile", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "options_page": "index.html", "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["index.html"], "use_dynamic_url": false}], "commands": {"open_tab_switcher": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open TABTile switcher"}}}