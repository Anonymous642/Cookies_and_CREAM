{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dialem", "short_name": "Dialem", "version": "1.0.4", "description": "Collect business leads from Google Maps, Bing Maps, directories and websites, and call them in Dialem.", "homepage_url": "https://dialem.ai", "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "scripting"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_title": "Dialem", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://www.google.co.uk/maps/*"], "js": ["src/maps-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.google.com/maps/*", "https://www.google.co.uk/maps/*"], "js": ["src/map-view.js", "src/maps-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.bing.com/maps*"], "js": ["src/bing-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.bing.com/maps*"], "js": ["src/bing-bridge.js"], "run_at": "document_start"}, {"matches": ["https://dialem.ai/dashboard*"], "js": ["src/dashboard-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://*/*", "http://*/*"], "js": ["src/site-scan.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/ads/library*"], "js": ["src/adlib-scan.js"], "run_at": "document_idle"}, {"matches": ["https://dialem.ai/extension/connect*"], "js": ["src/connect-bridge.js"], "run_at": "document_idle"}]}