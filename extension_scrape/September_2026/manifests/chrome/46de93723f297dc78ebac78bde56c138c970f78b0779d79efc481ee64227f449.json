{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cloak \u2014 Tracker Blocker & Privacy", "version": "0.1.20", "description": "Block selected trackers, clean tracking links, and reduce browser fingerprinting. Privacy receipts stay in your browser.", "permissions": ["storage", "declarativeNetRequest", "tabs", "cookies", "browsingData", "scripting", "alarms"], "host_permissions": ["https://www.cloak.build/*"], "optional_host_permissions": ["https://*/*"], "externally_connectable": {"matches": ["https://www.cloak.build/*", "https://cloak.build/*"]}, "background": {"service_worker": "dist/background.js", "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "shopping-mode-privacy", "enabled": false, "path": "dist/rules.json"}, {"id": "rtb-hardening", "enabled": false, "path": "dist/declarative_net_request/rtb_rules.json"}]}, "icons": {"16": "dist/assets/brand/cloak-logo.png", "32": "dist/assets/brand/cloak-logo.png", "48": "dist/assets/brand/cloak-logo.png", "128": "dist/assets/brand/cloak-logo.png"}, "action": {"default_title": "cloak", "default_popup": "dist/popup.html", "default_icon": {"16": "dist/assets/brand/cloak-logo.png", "32": "dist/assets/brand/cloak-logo.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://www.cloak.build"}, "web_accessible_resources": [{"resources": ["dist/cloak-page-history-observer.js", "dist/assets/fonts/montserrat-latin-variable.woff2"], "matches": ["https://*/*"], "use_dynamic_url": true}]}