{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrowseWell", "description": "Use the internet on purpose. Block distractions without blocking the internet you need.", "version": "2.1.6", "short_name": "BrowseWell", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "declarativeNetRequest", "alarms", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "optional_permissions": ["notifications"], "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "BrowseWell", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["http://*/*", "https://*/*"]}]}