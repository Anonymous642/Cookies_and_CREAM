{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Exact Time Viewer for Social Media", "version": "2.1.1", "minimum_chrome_version": "109", "description": "See the exact date and time of a post instead of \"2h\" or \"3w ago\". Click to copy. You choose the sites. No data collected.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage", "scripting"], "host_permissions": ["*://*.instagram.com/*"], "optional_host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.threads.net/*", "*://*.threads.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.linkedin.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["idtime.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}