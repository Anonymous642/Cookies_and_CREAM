{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video History for X", "version": "0.4.0", "description": "Keep a local history of videos played on X and view it in X's History page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "133", "permissions": ["storage"], "action": {"default_title": "Open video history", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}}}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["x-page.js", "videos-tab.js", "history-store.js", "history-view.js", "return-flow.js", "qualifying-watch.js", "undo-window.js", "videos-tab-panel.js", "handoff.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}