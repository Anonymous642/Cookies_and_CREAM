{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatPilotCRM: Facebook Messenger CRM", "version": "1.4.0", "description": "Turn Facebook Messenger into a CRM for freelancers, agencies, and coaches. Tag contacts, track friend requests, send bulk DMs.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ChatPilotCRM", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "scripting", "tabs", "cookies"], "host_permissions": ["*://*.facebook.com/*", "https://app.chatpilotcrm.com/*"], "content_scripts": [{"matches": ["https://www.facebook.com/messages/*"], "js": ["content-messenger.js"], "run_at": "document_end"}, {"matches": ["https://www.facebook.com/groups/*"], "js": ["content-facebook.js"], "run_at": "document_end"}, {"matches": ["https://www.facebook.com/"], "js": ["content-autolink.js"], "run_at": "document_end"}, {"matches": ["https://app.chatpilotcrm.com/*"], "js": ["content-sync.js"], "run_at": "document_end"}], "background": {"service_worker": "background-main.js"}, "externally_connectable": {"matches": ["https://app.chatpilotcrm.com/*"]}}