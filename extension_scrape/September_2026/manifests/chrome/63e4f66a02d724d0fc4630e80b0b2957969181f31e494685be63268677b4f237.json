{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Woocommerce AliExpress Importer", "version": "2.0.0", "manifest_version": 3, "description": "It is used to import product from AliExpress to WooCommerce store with help of Webkul WooCommerce Dropship Management module.", "background": {"service_worker": "resources/js/background.js"}, "icons": {"128": "resources/images/Icon.png"}, "permissions": ["activeTab", "tabs"], "host_permissions": ["https://*.aliexpress.com/*"], "action": {"default_icon": {"16": "resources/images/icon-disabled.png", "48": "resources/images/icon-disabled.png", "128": "resources/images/icon-disabled.png"}}, "web_accessible_resources": [{"resources": ["resources/images/*.png", "resources/js/wk_inserted.js", "resources/js/jquery-3.7.1.min.js"], "matches": ["https://*.aliexpress.com/*"]}], "content_scripts": [{"matches": ["https://*.aliexpress.com/*"], "js": ["resources/js/jquery-3.7.1.min.js", "resources/js/content.js"], "css": ["resources/css/dropship.css"]}]}