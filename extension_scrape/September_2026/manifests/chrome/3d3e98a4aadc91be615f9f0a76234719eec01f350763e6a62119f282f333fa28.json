{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shimeji World - Shimeji Browser Extension", "version": "2.0.0", "description": "Adopt cute Shimeji pets with this extension! Choose from thousands of animated characters that walk, climb, and roam your screen.", "permissions": ["storage", "unlimitedStorage", "tabs"], "homepage_url": "https://shimejiworld.com", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "web_accessible_resources": [{"resources": ["shimeji/*", "icons/*", "assets/*"], "matches": ["https://*/*", "http://*/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}