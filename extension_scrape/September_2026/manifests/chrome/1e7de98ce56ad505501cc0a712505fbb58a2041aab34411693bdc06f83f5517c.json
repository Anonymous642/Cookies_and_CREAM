{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ConectAI \u2013 Captura de Session ID", "short_name": "ConectAI Session ID", "description": "Identifica automaticamente o Session ID do Instagram e salva na plataforma ConectAI, com autoriza\u00e7\u00e3o do usu\u00e1rio.", "version": "1.0.2", "permissions": ["cookies", "activeTab", "scripting"], "host_permissions": ["https://www.instagram.com/*", "https://conectai.dev.br/*"], "externally_connectable": {"matches": ["*://conectai.dev.br/*", "*://*.conectai.dev.br/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}