{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Session Vault \u2014 Tab Session Manager", "version": "0.1.0", "description": "Reliable tab session manager. Save, restore, search, and back up your browser windows locally. Your data stays on your device.", "author": "Griffs", "homepage_url": "https://session-vault-docs.pages.dev/", "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "downloads", "tabGroups", "notifications"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["src/lib/extpay-content.js"], "run_at": "document_start"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Session Vault", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "commands": {"save-current-window": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save current window as a session"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Open Session Vault dashboard"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}