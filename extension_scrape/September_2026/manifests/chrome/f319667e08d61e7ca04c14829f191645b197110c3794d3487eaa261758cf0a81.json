{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Comment Assistant for LinkedIn", "description": "AI-powered comment generator for LinkedIn. Supports OpenAI, Gemini, Claude, Perplexity, Ollama, and Chrome built-in AI.", "version": "1.0.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "AI Comments", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/service.js", "type": "module"}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://*.linkedin.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*", "https://api.perplexity.ai/*", "http://localhost:11434/*", "http://127.0.0.1:11434/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["content/tesseract/tesseract.min.js", "content/tesseract/worker.min.js", "content/tesseract/tesseract-core.wasm.js", "content/tesseract/lang-data/eng.traineddata"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content/ocr.js", "content/adapters.js", "content/content.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "commands": {"generate_suggestions": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Generate AI comment suggestions"}}}