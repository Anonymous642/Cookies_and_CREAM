{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Active Tab Tools", "permissions": ["activeTab", "scripting", "storage"], "version": "1.0.7", "manifest_version": 3, "description": "Save notes for any website... back up site data... get a warning before closing tabs... and more.", "background": {"service_worker": "background.js"}, "action": {"default_title": "Active Tab Tools", "default_popup": "home.html", "default_icon": {"16": "images/att16.png", "32": "images/att32.png", "48": "images/att48.png", "128": "images/att128.png"}}, "icons": {"16": "images/att16.png", "32": "images/att32.png", "48": "images/att48.png", "128": "images/att128.png"}, "content_scripts": [{"matches": ["https://*/*"], "run_at": "document_end", "js": ["rules/beforeunload.js"]}], "web_accessible_resources": [{"resources": ["utils.js"], "matches": ["<all_urls>"]}]}