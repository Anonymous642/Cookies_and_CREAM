{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sharp Books cart filler", "version": "0.5.7", "description": "Fills your AbeBooks basket and Amazon cart with the morning picks and logs paid orders into FroggERP. Never buys, never sees a card.", "permissions": ["tabs", "notifications", "storage", "downloads", "scripting", "alarms"], "host_permissions": ["https://books.eleazarai.dev/*", "https://www.abebooks.com/*", "https://www.amazon.com/*", "https://app.froggerp.io/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Fill basket and cart", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://books.eleazarai.dev/*"], "js": ["content.js"]}, {"matches": ["https://www.amazon.com/*"], "js": ["amazon.js"]}, {"matches": ["https://www.abebooks.com/*"], "js": ["abeorders.js"]}, {"matches": ["https://app.froggerp.io/*"], "js": ["frogg.js"]}]}