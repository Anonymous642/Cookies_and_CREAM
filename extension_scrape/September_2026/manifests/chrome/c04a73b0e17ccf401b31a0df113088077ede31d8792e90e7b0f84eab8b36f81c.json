{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TikBlock", "version": "1.2.1", "description": "Blocks all TikTok content by default. Only explicitly whitelisted videos are viewable.", "author": "Afek Sakaju (https://www.linkedin.com/in/afeksa)", "permissions": ["declarativeNetRequest", "storage", "webNavigation"], "host_permissions": ["*://*.tiktok.com/*"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "blocklist", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.tiktok.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "TikBlock", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["*://*.tiktok.com/*"]}]}