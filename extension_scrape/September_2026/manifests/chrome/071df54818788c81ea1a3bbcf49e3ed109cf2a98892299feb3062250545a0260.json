{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Reviews Extractor", "version": "1.0.1", "description": "Extract Amazon product reviews quickly and easily", "permissions": ["activeTab", "downloads", "identity"], "oauth2": {"client_id": "YOUR_GOOGLE_CLIENT_ID", "scopes": ["openid", "email", "profile"]}, "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.supabase.co/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.in/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["config.js"], "matches": ["<all_urls>"]}]}