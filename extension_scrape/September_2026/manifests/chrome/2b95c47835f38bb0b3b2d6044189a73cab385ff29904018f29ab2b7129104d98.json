{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TakeMeasure", "description": "Calibrated measurement overlay for web pages and documents.", "version": "0.1.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["clipboardWrite"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "TakeMeasure", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"tm-toggle-power": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle TakeMeasure power"}, "tm-start-calibration": {"suggested_key": {"default": "Alt+C"}, "description": "Start calibration with prompt"}, "tm-cycle-measure-mode": {"suggested_key": {"default": "Alt+M"}, "description": "Cycle measure mode (excluding calibration)"}, "tm-clear": {"suggested_key": {"default": "Alt+X"}, "description": "Clear markings (or clear + cycle corner in corner mode)"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/contentScript.js"], "css": ["src/overlay.css"], "run_at": "document_idle", "all_frames": true}]}