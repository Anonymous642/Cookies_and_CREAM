{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discord for Web", "description": "Enhance Discord Web with desktop notifications, quick controls and a floating toolbar.", "version": "1.2.0", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"open-discord": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open or focus Discord"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "notifications", "system.display", "windows", "tabs", "sidePanel", "declarativeNetRequest"], "host_permissions": ["https://discord.com/*"], "declarative_net_request": {"rule_resources": [{"id": "frame_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"]}], "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}