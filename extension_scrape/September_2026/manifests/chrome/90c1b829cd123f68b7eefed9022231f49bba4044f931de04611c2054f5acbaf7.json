{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paper Renamer", "version": "0.1.0", "description": "Renames academic PDF downloads to paper titles. Supports ACM, IEEE Xplore, arXiv.", "permissions": ["downloads", "storage"], "host_permissions": ["https://dl.acm.org/*", "https://ieeexplore.ieee.org/*", "https://arxiv.org/*", "https://export.arxiv.org/*"], "icons": {"16": "icons/paper_renamer_16x16.png", "48": "icons/paper_renamer_48x48.png", "128": "icons/paper_renamer_128x128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://dl.acm.org/doi/*", "https://ieeexplore.ieee.org/document/*", "https://arxiv.org/abs/*", "https://export.arxiv.org/abs/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Paper Renamer", "default_icon": {"16": "icons/paper_renamer_16x16.png", "48": "icons/paper_renamer_48x48.png", "128": "icons/paper_renamer_128x128.png"}}}