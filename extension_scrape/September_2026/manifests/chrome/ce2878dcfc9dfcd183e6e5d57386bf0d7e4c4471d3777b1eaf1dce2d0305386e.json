{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Peep", "version": "0.1.0", "description": "Chrome bridge for Spotify Web, Google Meet, and Discord Web commands.", "permissions": ["tabs", "scripting", "storage", "offscreen", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Peep", "default_icon": {"16": "icons/icon-16.png", "19": "icons/icon-19.png", "32": "icons/icon-32.png", "38": "icons/icon-38.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["ui/assets/*"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["https://open.spotify.com/*"], "js": ["content/shared.js", "content/spotify-controller.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["content/shared.js", "content/youtube-controller.js"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*"], "js": ["content/shared.js", "content/meet-controller.js"], "run_at": "document_idle"}, {"matches": ["https://discord.com/*"], "js": ["content/shared.js", "content/discord-controller.js"], "run_at": "document_idle"}]}