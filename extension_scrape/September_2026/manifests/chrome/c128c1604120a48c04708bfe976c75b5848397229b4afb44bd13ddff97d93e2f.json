{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RouteGuard: Keep the Messages, Skip the Feed", "short_name": "RouteGuard", "version": "1.0.0", "description": "Use Instagram for messages only. Feed, Explore and Reels sit behind a wait that grows each time. Nothing leaves your browser.", "minimum_chrome_version": "111", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["declarativeNetRequest", "storage", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"], "action": {"default_popup": "popup.html", "default_title": "RouteGuard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["history-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["guard.js"], "run_at": "document_start", "world": "ISOLATED"}]}