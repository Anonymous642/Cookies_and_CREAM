{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ToolBreezy.com - Screen Annotation Tool, Draw, Redact & Blur Image Online", "version": "1.0.0", "description": "Draw, highlight and blur anything on a page before you record it. Set it once and it is still there on the next take.", "homepage_url": "https://toolbreezy.com/", "minimum_chrome_version": "116", "action": {"default_title": "ToolBreezy.com - Screen Annotation Tool, Draw, Redact & Blur Image Online", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage"], "icons": {"16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png", "256": "icons/on-256.png"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Show or hide the annotation toolbar"}, "panic-blur": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Blur the whole page instantly"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["src/content/*.js", "src/lib/*.js"], "matches": ["<all_urls>"]}], "optional_host_permissions": ["<all_urls>"]}