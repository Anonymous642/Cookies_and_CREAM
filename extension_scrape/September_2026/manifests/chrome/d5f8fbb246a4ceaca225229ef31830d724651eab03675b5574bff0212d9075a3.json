{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Research Threads \u2013 Side Questions for ChatGPT", "short_name": "Research Threads", "version": "1.0.0", "description": "Highlight any part of a ChatGPT answer and ask about it in a side panel, without losing your place. Not affiliated with OpenAI.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Research Threads: open the side panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "panel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open the research side panel"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}