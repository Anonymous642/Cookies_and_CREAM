{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeTiles", "version": "0.17.0", "description": "See where your time goes, right on your new tab page. Time tracking, treemap, blocking and redirects in one extension.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "tabs", "alarms", "idle", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "TimeTiles", "default_icon": "icon.png"}, "commands": {"close-other-tabs": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Close all tabs in this window except the current one (pinned tabs are kept)"}, "open-settings": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Open the TimeTiles settings page"}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}