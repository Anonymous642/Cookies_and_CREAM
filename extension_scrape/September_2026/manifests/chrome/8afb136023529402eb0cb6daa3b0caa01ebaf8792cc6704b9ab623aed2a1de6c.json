{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Memory Lane - Time Travel Through Your Browser History", "version": "1.4", "description": "See what you were browsing 1-12 months ago every time you open a new tab. Save your favorite memories and revisit them later.", "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "permissions": ["history", "storage", "search"], "action": {"default_title": "Memory Lane", "default_icon": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["newtab.html"], "matches": ["<all_urls>"]}]}