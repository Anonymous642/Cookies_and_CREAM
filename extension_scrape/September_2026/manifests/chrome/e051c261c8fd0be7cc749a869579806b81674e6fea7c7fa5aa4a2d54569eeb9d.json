{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InHive Clipper", "description": "Capture a region of any tab and create an InHive task with the screenshot in the description.", "version": "0.1.3", "action": {"default_title": "InHive Clipper", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "scripting", "activeTab", "identity", "tabs"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["compose.html", "compose.js", "chunks/*", "assets/*"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["hotkeys.js"], "run_at": "document_start", "all_frames": true}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Open the clipper"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture a region of this tab"}, "capture-sketch": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Capture a region and mark it up"}}}