{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tic Text Toc - Snippets, Shortcuts & Sticky Notes", "version": "1.0.3", "description": "Save, paste & send reusable text snippets, templates and sticky notes across websites \u2014 fast, free, and keyboard-ready.", "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Tic Text Toc"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "background": {"service_worker": "background/background.js"}, "commands": {"toggle-floating-box": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Toggle Tic Text Toc floating box"}, "quick-search": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Focus on search box in Tic Text Toc widget"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png", "icons/icon512.png"], "matches": ["<all_urls>"]}]}