{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabZIF", "version": "1.3.1", "description": "Capture the current tab and export GIF or WebM.", "icons": {"16": "icons/TabZIF-16x16.png", "32": "icons/TabZIF-32x32.png", "64": "icons/TabZIF-64x64.png", "128": "icons/TabZIF-128x128.png"}, "permissions": ["tabCapture", "offscreen", "storage", "downloads", "activeTab", "scripting"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["vendor/fonts/google-sans-code-500.woff2", "vendor/fonts/google-sans-code-700.woff2"], "matches": ["http://*/*", "https://*/*", "file://*/*"], "use_dynamic_url": true}], "action": {"default_popup": "popup.html", "default_title": "TabZIF", "default_icon": {"16": "icons/TabZIF-16x16.png", "32": "icons/TabZIF-32x32.png", "64": "icons/TabZIF-64x64.png", "128": "icons/TabZIF-128x128.png"}}, "commands": {"toggle-tabzif-recording": {"suggested_key": {"default": "Ctrl+Shift+1"}, "global": false, "description": "Start or stop TabZIF recording"}}}