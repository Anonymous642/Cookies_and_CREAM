{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TDEB", "version": "1.4.0", "description": "Sourcing, publication et suivi eBay automatis\u00e9s \u2014 trouvez le fournisseur, publiez et surveillez vos annonces.", "action": {"default_title": "eBay AutoBot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "activeTab", "browsingData", "downloads"], "host_permissions": ["https://*.ebay.com/*", "https://*.ebay.fr/*", "https://*.ebay.de/*", "https://*.ebay.co.uk/*", "https://*.amazon.com/*", "https://*.amazon.fr/*", "https://*.amazon.de/*", "https://*.amazon.co.uk/*", "https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://tdshop-autobot.vercel.app/*"], "content_scripts": [{"matches": ["https://*.ebay.com/sch/*", "https://*.ebay.fr/sch/*", "https://*.ebay.de/sch/*", "https://*.ebay.co.uk/sch/*"], "js": ["src/content/ebaySoldItems.js", "src/content/ebaySearchToolbar.js"], "run_at": "document_idle"}, {"matches": ["https://*.ebay.com/str/*", "https://*.ebay.fr/str/*", "https://*.ebay.de/str/*", "https://*.ebay.co.uk/str/*", "https://*.ebay.com/usr/*", "https://*.ebay.fr/usr/*", "https://*.ebay.de/usr/*", "https://*.ebay.co.uk/usr/*"], "js": ["src/content/ebayStorePage.js"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.com/*", "https://*.amazon.fr/*", "https://*.amazon.de/*", "https://*.amazon.co.uk/*"], "js": ["src/content/amazonProduct.js"], "run_at": "document_idle"}, {"matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"], "js": ["src/content/aliexpressProduct.js", "src/content/aliexpressImageSearch.js"], "run_at": "document_idle"}, {"matches": ["https://*.ebay.com/lstng/*", "https://*.ebay.com/sl