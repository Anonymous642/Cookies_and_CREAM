{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus for YouTube", "short_name": "Focus", "version": "0.3.0", "description": "Watch YouTube on your own terms: hide the feed, Shorts, counts and autoplay, so what you watch is your choice, not the algorithm's.", "permissions": ["storage", "unlimitedStorage"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Focus for YouTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_page": "welcome.html", "commands": {"toggle-pause": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Pause or resume Focus on the current YouTube tab"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["distractions.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}