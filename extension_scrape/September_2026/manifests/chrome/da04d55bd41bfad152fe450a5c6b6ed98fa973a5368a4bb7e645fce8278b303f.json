{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTFilter", "version": "2.1.0", "short_name": "YTFilter", "description": "Filter YouTube videos by view count, date, duration, keywords, subscriber count, and more.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://unikdev.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "YTFilter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}