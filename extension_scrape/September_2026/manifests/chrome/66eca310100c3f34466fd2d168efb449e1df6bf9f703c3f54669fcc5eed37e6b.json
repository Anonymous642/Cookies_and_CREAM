{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vionaa AI: Job Tracker, Matching, LinkedIn Review, ATS Resume Check & More", "version": "1.1.1", "description": "Auto-populate job details from job-seeker websites like LinkedIn, Indeed, Glassdoor, and Naukri.", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "permissions": ["tabs", "storage", "cookies", "scripting", "activeTab"], "host_permissions": ["*://*.builder.vionaa.com/*", "*://*.vionaa.com/", "*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.glassdoor.co.in/*", "*://*.naukri.com/*", "*://*.shine.com/*", "*://*.zety.com/*"], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["*://*.builder.vionaa.com/*", "*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.glassdoor.co.in/*", "*://*.naukri.com/*", "*://*.shine.com/*", "*://*.zety.com/*"], "js": ["content/profileReview.js", "popup/popup.js", "content/easyApply.js", "content/autoFillForms.js", "content/page.js", "utils/jobUtils.js", "content/bootstrap.bundle.min.js", "content/messageHandler.js", "content/uiUpdater.js", "content/sidebar.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/popup.html", "popup/popup.js", "content/easyApply.js", "assets/icon16.png", "assets/icon48.png", "assets/icon128.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}