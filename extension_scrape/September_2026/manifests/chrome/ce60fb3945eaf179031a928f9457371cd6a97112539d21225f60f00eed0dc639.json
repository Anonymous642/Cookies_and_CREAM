{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Carcassonne Tile Counter for quibbble", "version": "1.1.0", "description": "Shows how many of each Carcassonne tile type are still unseen while playing on quibbble.com.", "homepage_url": "https://github.com/quibbble/go-carcassonne", "minimum_chrome_version": "111", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://quibbble.com/*", "*://*.quibbble.com/*"], "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Carcassonne Tile Counter: click to toggle the panel"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://quibbble.com/*", "*://*.quibbble.com/*"], "js": ["ws-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://quibbble.com/*", "*://*.quibbble.com/*"], "js": ["tile-art.js", "counter.js"], "run_at": "document_start"}]}