{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GridGrab \u2014 Export Web Tables & Dashboard Grids", "description": "Grab messy web tables and dashboard grids. Export clean CSV, Excel, JSON, or Markdown. Runs locally in your browser.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "sidePanel"], "action": {"default_title": "Open GridGrab", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open GridGrab side panel"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}