{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pause Scrolling - YouTube Shorts", "version": "1.1.1", "description": "Automatically pauses YouTube Shorts after a certain number (with a cooldown).", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}}