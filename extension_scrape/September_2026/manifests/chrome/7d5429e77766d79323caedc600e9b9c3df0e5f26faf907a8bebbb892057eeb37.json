{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartMacros: Macro Recorder & Browser Automation", "version": "0.3.1", "description": "Macro recorder and web automation: record clicks and typing, replay with CSV data, self-repair when sites change. Free, no account.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "SmartMacros", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "studio.html", "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["src/cs/00-guard.js", "src/cs/locators.js", "src/cs/fingerprint.js", "src/cs/snapshot.js", "src/cs/matcher.js", "src/cs/overlay.js", "src/cs/menu.js", "src/cs/recorder.js", "src/cs/executor.js", "src/cs/99-main.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "permissions": ["storage", "activeTab", "tabs", "scripting", "sidePanel", "webNavigation", "alarms", "contextMenus", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "commands": {"run-1": {"description": "Run macro 1"}, "run-2": {"description": "Run macro 2"}, "run-3": {"description": "Run macro 3"}, "run-4": {"description": "Run macro 4"}, "toggle-record": {"description": "Start or stop recording", "suggested_key": {"default": "Alt+Shift+R"}}}}