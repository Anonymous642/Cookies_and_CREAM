{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager", "version": "0.12.35", "description": "\u6309\u5de5\u4f5c\u9879\u7ba1\u7406\u6d4f\u89c8\u5668\u6807\u7b7e\u9875\u7684 Chrome \u6269\u5c55", "minimum_chrome_version": "114", "commands": {"toggle-previous-tab": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "\u5207\u6362\u5230\u4e0a\u4e00\u4e2a\u6807\u7b7e\u9875 / Toggle previous tab"}, "toggle-side-panel": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "\u6253\u5f00\u4fa7\u8fb9\u680f / Open side panel"}, "focus-search": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "\u805a\u7126\u641c\u7d22\u6846 / Focus search box"}, "new-workspace": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "\u65b0\u5efa\u5de5\u4f5c\u9879 / New workspace"}, "focus-next-workspace": {"description": "\u805a\u7126\u4e0b\u4e00\u4e2a\u5de5\u4f5c\u9879\u7a97 / Focus next workspace window"}, "focus-prev-workspace": {"description": "\u805a\u7126\u4e0a\u4e00\u4e2a\u5de5\u4f5c\u9879\u7a97 / Focus previous workspace window"}}, "action": {"default_title": "\u6253\u5f00 Tab Manager \u4fa7\u8fb9\u680f", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "permissions": ["tabs", "storage", "sidePanel", "alarms", "windows"], "optional_host_permissions": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*"]}