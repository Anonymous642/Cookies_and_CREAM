{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Random Wheel Picker", "short_name": "Random Wheel Picker", "version": "1.0.1", "description": "A spinning wheel decision maker, right in your browser sidebar. Add your options, spin, and let fate decide.", "author": "Oleksiy Onyshchenko", "homepage_url": "https://freerandomtools.org", "action": {"default_title": "Random Wheel Picker"}, "side_panel": {"default_path": "sidepanel.html", "default_width": 400}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "114", "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}