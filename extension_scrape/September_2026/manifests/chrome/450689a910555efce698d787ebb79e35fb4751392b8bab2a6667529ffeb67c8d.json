{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Demofx Vault", "version": "1.0.0", "description": "Encrypted credential vault for Pricefx. Autofills logins per partition and provides a Ctrl+K command menu for fast navigation.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.pricefx.eu/*", "https://*.pricefx.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open Demofx Vault"}}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "options_page": "src/config/config.html", "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["https://*.pricefx.eu/*", "https://*.pricefx.com/*"], "js": ["src/content/content.js"], "run_at": "document_idle"}, {"matches": ["https://*.pricefx.eu/*", "https://*.pricefx.com/*"], "js": ["src/content/content-command-menu.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/logo.png"], "matches": ["https://*.pricefx.eu/*", "https://*.pricefx.com/*"]}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}