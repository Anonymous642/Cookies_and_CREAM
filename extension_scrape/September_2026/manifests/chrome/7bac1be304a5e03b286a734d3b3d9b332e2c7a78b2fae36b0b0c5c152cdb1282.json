{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DriveClip \u2013 Screen Recorder & Screen Capture", "version": "1.0.7", "description": "Record your screen and camera, then save straight to your own Google Drive or OneDrive. We never store your video.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "desktopCapture", "offscreen", "downloads", "storage", "scripting", "tabs", "alarms", "notifications", "declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "relax_camera_policy", "enabled": true, "path": "rules.json"}]}, "commands": {"stop-recording": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Finish the DriveClip recording"}}, "host_permissions": ["<all_urls>"], "action": {"_comment_no_default_popup": "Deliberately absent. A native popover is closed by the browser on ANY click outside it, so reaching for the camera bubble or the recording controls dismissed it. Without default_popup the click reaches chrome.action.onClicked and the background renders popup.html as an in-page panel we control instead.", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://driveclip.ai/*", "https://*.driveclip.ai/*"], "js": ["connect.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["camera.html", "camera.js", "permissions.html", "permissions.js", "popup.html", "popup.js", "popup.css", "config.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}