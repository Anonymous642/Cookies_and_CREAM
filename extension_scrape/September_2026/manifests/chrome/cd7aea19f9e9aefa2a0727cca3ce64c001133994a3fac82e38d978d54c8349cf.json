{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SummItAll", "version": "1.1", "manifest_version": 3, "description": "Tired of long articles and tab switches? SummItAll gives you AI summaries in 1 click! \u2b09\ud83d\uddb1\ufe0f", "permissions": ["activeTab", "scripting", "storage"], "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the popup"}}, "action": {"default_title": "Click to view the popup", "default_popup": "index.html"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}