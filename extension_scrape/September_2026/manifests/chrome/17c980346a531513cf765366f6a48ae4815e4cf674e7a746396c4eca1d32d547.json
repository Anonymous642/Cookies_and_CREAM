{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleanFeed", "version": "1.0.0", "description": "A cross-platform browser extension to clean your social media feeds.", "permissions": ["storage"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*"], "action": {"default_popup": "ui/popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "css": ["styles/content.css"], "js": ["content/generic.js", "content/twitter.js"], "run_at": "document_end"}, {"matches": ["*://*.reddit.com/*"], "css": ["styles/content.css"], "js": ["content/generic.js", "content/reddit.js"], "run_at": "document_end"}, {"matches": ["*://*.youtube.com/*"], "css": ["styles/content.css"], "js": ["content/generic.js", "content/youtube.js"], "run_at": "document_end"}, {"matches": ["*://*.facebook.com/*"], "css": ["styles/content.css"], "js": ["content/generic.js", "content/facebook.js"], "run_at": "document_end"}, {"matches": ["*://*.instagram.com/*"], "css": ["styles/content.css"], "js": ["content/generic.js", "content/instagram.js"], "run_at": "document_end"}], "options_page": "ui/options.html"}