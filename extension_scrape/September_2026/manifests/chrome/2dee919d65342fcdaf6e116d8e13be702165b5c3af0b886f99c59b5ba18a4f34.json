{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Violingo", "version": "1.6.8", "description": "Learn languages through shows you love.", "short_name": "Violingo", "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting", "webRequest", "notifications", "alarms"], "host_permissions": ["https://www.netflix.com/*", "*://*.nflxvideo.net/*", "*://*.nflxso.net/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://api.violingo.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://m.youtube.com/watch*", "https://youtu.be/*"], "js": ["content.js"]}, {"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://m.youtube.com/watch*", "https://youtu.be/*"], "js": ["youtube-injected.js"], "world": "MAIN", "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/violingo_logo.png", "48": "icons/violingo_logo.png", "128": "icons/violingo_logo.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/violingo_logo.png", "48": "icons/violingo_logo.png", "128": "icons/violingo_logo.png"}, "web_accessible_resources": [{"resources": ["icons/violingo_logo.png", "images/*", "assets/*", "public/*"], "matches": ["<all_urls>"]}]}