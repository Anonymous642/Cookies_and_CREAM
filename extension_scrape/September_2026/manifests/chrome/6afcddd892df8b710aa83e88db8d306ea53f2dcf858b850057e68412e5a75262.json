{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Narrate", "version": "0.3.0", "description": "Narrate reads any page \u2014 or just your selection \u2014 aloud with on-device voices, highlighting each word as it is spoken.", "background": {"service_worker": "src/background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Narrate (Ctrl+Shift+U)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["file:///*"], "commands": {"toggle-read-aloud": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "MacCtrl+Shift+U"}, "description": "Start or stop Narrate"}}, "web_accessible_resources": [{"resources": ["src/session.js", "src/toolbar.js", "src/storage.js", "src/extract.js", "src/speech.js", "src/highlight.js", "src/jump.js", "src/reader.js", "src/toolbar.css", "src/reader.css"], "matches": ["http://*/*", "https://*/*", "file:///*"]}]}