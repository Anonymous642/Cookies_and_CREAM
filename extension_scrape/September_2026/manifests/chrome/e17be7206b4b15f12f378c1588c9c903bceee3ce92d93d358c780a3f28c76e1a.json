{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdBlocker for YouTube", "version": "1.0.1", "description": "Blocks YouTube ads, banners & popups. Skips preroll/midroll ads, blocks ads on embedded players, removes annotations.", "permissions": ["declarativeNetRequest", "storage"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "ad_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "all_frames": true, "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "AdBlocker for YouTube"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}