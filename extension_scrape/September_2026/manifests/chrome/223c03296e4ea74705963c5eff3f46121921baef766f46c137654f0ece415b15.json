{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CS2Offer", "short_name": "CS2Offer", "description": "Companion extension for cs2offer.com \u2014 sends CS2 skin trades to Steam with one click and shows sticker thumbnails on your inventory.", "version": "1.0.2", "homepage_url": "https://cs2offer.com", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/48.png"}}, "permissions": ["scripting", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://steamcommunity.com/*", "https://cs2offer.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://steamcommunity.com/tradeoffer/*"], "js": ["content/steam-trade-detector.js"], "run_at": "document_start"}, {"matches": ["https://steamcommunity.com/id/*/inventory*", "https://steamcommunity.com/profiles/*/inventory*"], "js": ["content/steam-inventory-stickers.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://cs2offer.com/*"], "js": ["content/cs2offer-bridge.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_steam", "enabled": true, "path": "rules/steam_referer.json"}]}}