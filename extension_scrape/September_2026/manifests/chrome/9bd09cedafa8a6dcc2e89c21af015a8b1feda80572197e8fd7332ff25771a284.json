{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Modestly - Distraction-Free Video Links", "version": "1.5", "description": "Generate distraction-free shareable links with Modestly.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Modestly - Video Link Generator"}, "permissions": ["storage", "activeTab", "tabs"], "storage": {"managed_schema": "managed_schema.json"}, "host_permissions": ["*://*.youtube.com/*", "*://*.vimeo.com/*", "*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}, {"matches": ["*://vimeo.com/*"], "js": ["vimeo-content.js"], "css": ["styles.css"], "run_at": "document_end"}, {"matches": ["*://mdst.ly/*"], "js": ["fill.js"], "run_at": "document_end"}, {"matches": ["*://*/*"], "js": ["fill.js"], "run_at": "document_end", "exclude_matches": ["*://www.youtube.com/*", "*://vimeo.com/*", "*://mdst.ly/*"]}], "commands": {"generate-link": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate Modestly link for current YouTube or Vimeo video"}}, "web_accessible_resources": [{"resources": ["assets/*", "setup.html", "setup.css", "setup.js"], "matches": ["*://*/*"]}], "homepage_url": "https://www.getmodest.ly/"}