{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTail \u2013 Smart Tab Manager", "description": "Awesome tab manager: group by domain, move/cycle/pin, close duplicates, mute audio, save sessions, bookmark tabs & more", "version": "1.0.0", "default_locale": "en", "permissions": ["tabs", "storage", "contextMenus", "notifications", "bookmarks"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"move_tab_to_last": {"suggested_key": {"default": "Alt+L", "mac": "Alt+L"}, "description": "Move current tab to last"}, "move_tab_to_first": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Move current tab to first"}, "cycle_tab_right": {"suggested_key": {"default": "Alt+Right", "mac": "Alt+Right"}, "description": "Move current tab one right"}, "cycle_tab_left": {"suggested_key": {"default": "Alt+Left", "mac": "Alt+Left"}, "description": "Move current tab one left"}, "close_duplicate_tabs": {"description": "Close duplicate tabs"}, "save_tab_positions": {"description": "Save tab positions"}, "restore_tab_positions": {"description": "Restore tab positions"}, "pin_tab": {"description": "Pin/unpin current tab"}, "toggle_bookmark": {"description": "Toggle bookmark for current tab"}, "close_tabs_to_right": {"description": "Close all tabs to the right"}, "close_other_tabs": {"description": "Close all other tabs"}, "toggle_window_state": {"description": "Maximize/minimize window"}, "toggle_tab_audio": {"description": "Mute/unmute current tab audio"}, "toggle_global_audio": {"description": "Mute/unmute all Chrome tabs"}, "navigate_to_audible_tab": {"description": "Navigate to tab playing audio"}}, "host_permissions": ["<all_urls>"]}