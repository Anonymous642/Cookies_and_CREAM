{"manifest_version": 3, "version": "1.0.5", "name": "Fresh Fruit Search", "description": "Extension adding Fresh Fruit search engine to Chrome.", "icons": {"128": "128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://freshfruittab.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset", "enabled": true, "path": "rules.json"}]}, "chrome_settings_overrides": {"search_provider": {"name": "Fresh Fruit Search", "keyword": "freshfruittab.com", "search_url": "https://freshfruittab.com/search?q={searchTerms}", "favicon_url": "https://freshfruittab.com/favicon.ico", "encoding": "UTF-8", "is_default": true}}, "background": {"service_worker": "background.js"}, "update_url": "https://clients2.google.com/service/update2/crx"}