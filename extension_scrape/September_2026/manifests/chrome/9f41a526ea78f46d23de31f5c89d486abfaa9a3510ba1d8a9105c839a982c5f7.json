{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipCart", "version": "1.0.0", "description": "Quick text selection tools and cart for clipboard operations", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "scripting"], "commands": {"copy-cart": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy all cart contents"}, "clear-cart": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Clear cart"}}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "sw.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.svg"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "open_in_tab": true}}