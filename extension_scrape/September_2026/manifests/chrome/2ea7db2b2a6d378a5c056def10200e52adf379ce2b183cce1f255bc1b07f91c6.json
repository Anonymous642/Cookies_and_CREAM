{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Image & PDF Toolkit", "version": "1.0.1", "default_locale": "en", "description": "Convert, compress, and edit images & PDFs \u2014 100% offline, right in your browser.", "author": "Image & PDF Toolkit", "homepage_url": "https://github.com/image-pdf-toolkit", "minimum_chrome_version": "96", "offline_enabled": true, "permissions": ["contextMenus", "downloads", "storage", "clipboardWrite", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/entry.js"}, "action": {"default_popup": "popup/index.html", "default_title": "Image & PDF Toolkit", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/index.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/utils.js", "lib/ico-parser.js", "converters/canvas.js", "converters/svg.js", "converters/heic.js", "converters/tiff.js", "content/actions.js", "content/entry.js", "preview/rules.js", "preview/overlay.js", "preview/entry.js"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["lib/*", "converters/*", "vendors/*", "sandbox/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+I"}}, "toggle-preview": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle hover preview on/off"}}, "sandbox": {"pages": ["sandbox/sandbox.html"]}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; worker-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' data: blob:", "sandbox": "sandbox allow-scripts allow-forms"}}