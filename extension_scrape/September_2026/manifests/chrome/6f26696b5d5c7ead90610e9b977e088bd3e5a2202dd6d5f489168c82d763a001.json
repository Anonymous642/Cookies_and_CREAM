{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Adaptive Focus", "version": "1.0.0", "description": "Take control of your digital life with intelligent website blocking and personalized focus management", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "scripting", "alarms", "notifications", "tabs", "identity"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://localhost:3000/*"]}, "web_accessible_resources": [{"resources": ["js/utils/*", "js/premium/*", "js/premium/integrations/*", "js/components/*", "js/free/*", "css/*", "html/premium/*"], "matches": ["<all_urls>"]}], "default_locale": "en", "minimum_chrome_version": "88"}