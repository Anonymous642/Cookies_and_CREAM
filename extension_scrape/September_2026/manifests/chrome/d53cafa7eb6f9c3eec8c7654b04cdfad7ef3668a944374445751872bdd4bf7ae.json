{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenChunk \u2014 Capture. Chunk. Share.", "short_name": "ScreenChunk", "version": "1.0.0", "description": "Capture your screen, chunk it into useful pieces, annotate, and share instantly. Fast screen capture made smarter.", "action": {"default_title": "ScreenChunk", "default_icon": {"16": "assets/screenchunk-icon-32.png", "32": "assets/screenchunk-icon-32.png", "48": "assets/screenchunk-icon-32.png", "128": "assets/screenchunk-icon-128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "index.html"}, "icons": {"16": "assets/screenchunk-icon-32.png", "32": "assets/screenchunk-icon-32.png", "48": "assets/screenchunk-icon-32.png", "128": "assets/screenchunk-icon-128.png"}, "permissions": ["desktopCapture", "activeTab", "tabCapture", "storage", "sidePanel"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://*.screenchunk.com/*", "http://localhost/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-relay.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["extension-bridge.js"], "run_at": "document_start", "world": "MAIN"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/*", "assets/wasm/*", "content-relay.js", "extension-bridge.js"], "matches": ["<all_urls>"]}]}