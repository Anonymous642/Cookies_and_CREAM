{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mimirr - Web Screenshot Capture", "description": "Capture full-page screenshots of any website and save them to your Mimirr library. Includes authenticated pages.", "version": "1.2.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html", "default_title": "Capture with Mimirr"}, "permissions": ["cookies", "activeTab", "storage", "scripting", "clipboardWrite"], "host_permissions": ["https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html"}