{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenCapture Pro", "version": "1.0.0", "description": "Capture d'\u00e9cran compl\u00e8te pour le web : zone, fen\u00eatre, plein \u00e9cran, page enti\u00e8re et YouTube \u2014 avec \u00e9diteur d'annotation int\u00e9gr\u00e9.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ScreenCapture Pro"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads", "desktopCapture", "unlimitedStorage"], "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Nouvelle capture (zone)"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Capture de la page enti\u00e8re"}, "capture-youtube": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture rapide YouTube"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["shared/i18n.js", "content-scripts/youtube-button.js"], "css": ["content-scripts/youtube-button.css"], "run_at": "document_idle"}], "options_page": "options/options.html"}