{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Relay", "version": "1.1.0", "description": "Highlight text anywhere and relay it into your armed browser tabs, secrets redacted locally. Inserts text only; never presses Send.", "minimum_chrome_version": "109", "browser_specific_settings": {"gecko": {"id": "browser-relay@saferelay.ai", "strict_min_version": "109.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Browser Relay \u2014 click to open", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs", "scripting", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "host_permissions": ["<all_urls>"], "commands": {"text-boomerang": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Text boomerang \u2014 relay selected text (browser only; does not share a shortcut with SafeRelay Desktop)"}}}