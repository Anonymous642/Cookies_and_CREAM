{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SafeAds", "description": "Control previo en Meta Ads y Google Ads: muestra presupuesto, fechas y nombre de la campa\u00f1a, y pide confirmaci\u00f3n antes de publicar.", "version": "1.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://*.supabase.co/*", "https://www.safeadsapp.com/*"], "action": {"default_title": "Safe Ads", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["https://adsmanager.facebook.com/*", "https://business.facebook.com/*", "https://ads.google.com/*"]}, {"resources": ["content-scripts/content.css"], "matches": ["https://ads.google.com/*", "https://adsmanager.facebook.com/*", "https://business.facebook.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://ads.google.com/*", "https://adsmanager.facebook.com/*", "https://business.facebook.com/*"], "js": ["content-scripts/content.js"]}]}