{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Comments Sidebar", "version": "1.0.1", "description": "View a YouTube video's comments in a floating sidebar.", "permissions": ["activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/watch*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/comment-64.png", "32": "icons/comment-64.png", "48": "icons/comment-64.png", "128": "icons/comment-128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_start"}]}