{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browlytics - Browser Time Tracker by Category", "version": "1.0.3", "description": "Track your browsing time by website. 100% local, private, and secure. See where your time goes with beautiful analytics.", "short_name": "Browlytics", "author": "Sherif Gjini", "homepage_url": "https://www.browlytics.site/", "permissions": ["tabs", "storage", "idle", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}