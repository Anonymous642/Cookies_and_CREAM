{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Trends for Twitter", "version": "1.40", "description": "A simple and convenient tool that display Google Trends on the X (Twitter) page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Set Trends Region"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "host_permissions": ["*://trends.google.com/trending/rss?geo=*"], "permissions": ["storage", "alarms", "offscreen"]}