{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Impromptu - Prompt Enhancer", "short_name": "Impromptu", "version": "1.0.3", "description": "Enhance your AI prompts with clarifying questions for better results on ChatGPT, Claude, Gemini, and Perplexity", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; trusted-types promptkin-ai-* default;"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://prompto-api.onrender.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["content/overlay.js", "content/overlay.css", "content/drawer-tailwind.css", "content/font-blocker.js", "chunks/*.js", "assets/PromptKin-Logo.svg"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*"]}]}