{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Just Take A Note", "version": "0.0.6", "description": "Take notes and draw sketches directly in your browser.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "contextMenus", "activeTab", "sidePanel", "scripting"], "host_permissions": ["https://api.openai.com/*", "http://localhost/*", "http://127.0.0.1/*"], "side_panel": {"default_path": "sidepanel.html"}, "options_page": "settings.html", "background": {"service_worker": "assets/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Open extension popup"}, "open-sidebar": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open sidebar panel"}, "new-note": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Create new note"}, "new-drawing": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Create new drawing"}}}