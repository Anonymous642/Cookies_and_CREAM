{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Full Page Screenshot Pro", "description": "Capture full web pages, annotate them, and export as PNG, JPG, WEBP, or PDF with selection capture, clipboard copy, and rich tools.", "version": "1.0.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads", "clipboardWrite", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Full Page Screenshot Pro"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture selection"}}}