{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SiteDesk \u2014 Website Workspace", "description": "Contextual website workspace: save and retrieve website-specific notes, tasks, information, and tab sessions while browsing.", "version": "0.3.0", "short_name": "SiteDesk", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "tabs", "tabGroups", "contextMenus", "alarms", "notifications", "activeTab", "offscreen"], "optional_host_permissions": ["http://*/*", "https://*/*"], "commands": {"open-side-panel": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open the SiteDesk side panel"}, "quick-note": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Add a quick note for the current website"}, "save-session": {"description": "Save all tabs in the current window as a session"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_title": "SiteDesk", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}}