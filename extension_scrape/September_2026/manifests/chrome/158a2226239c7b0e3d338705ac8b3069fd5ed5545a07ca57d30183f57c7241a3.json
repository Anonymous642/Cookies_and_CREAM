{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ounie \u2014 Save to your brain", "description": "Save pages, selections, and highlights to your Ounie AI Second Brain. Highlights reappear when you return to a page.", "version": "0.2.0", "minimum_chrome_version": "114", "homepage_url": "https://ounie.com", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://ounie.com/*"], "action": {"default_title": "Save to Ounie", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["highlights.js"], "css": ["highlights.css"], "run_at": "document_idle"}], "commands": {"save-link": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page link to Ounie"}, "clip-page": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Clip main content to Ounie"}, "save-selection": {"description": "Save selection to Ounie"}, "reading-view": {"description": "Open Ounie Reading View"}}, "options_page": "options.html"}