{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Netflix Tools", "version": "4.0", "description": "Auto-skip intros, recaps and credits, continue to the next episode, and a handful of playback conveniences for Netflix.", "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "Netflix Tools"}, "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["content.js"], "run_at": "document_end", "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["shared.js"], "matches": ["*://*.netflix.com/*"]}], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "commands": {"quick-skip": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Quick skip (intro, recap, credits, or next episode)"}, "next-episode": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Play next episode"}, "toggle-notifications": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle on-screen notifications"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}