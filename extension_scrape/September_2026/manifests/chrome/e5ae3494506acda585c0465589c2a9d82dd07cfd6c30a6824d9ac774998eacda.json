{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zillow Scraper Pro", "version": "1.0.0", "description": "Extract listings from Zillow search and property pages. Export addresses, prices, beds, baths, Zestimates, agents, and more to CSV.", "permissions": ["storage", "identity", "tabs", "activeTab", "scripting"], "host_permissions": ["https://www.zillow.com/*", "https://*.supabase.co/*", "https://www.google.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.zillow.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Zillow Scraper Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["auth-callback.html", "authCallback.js", "dashboard.html", "dashboard.js", "dashboard.css", "assets/*", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://www.zillow.com https://*.supabase.co;"}}