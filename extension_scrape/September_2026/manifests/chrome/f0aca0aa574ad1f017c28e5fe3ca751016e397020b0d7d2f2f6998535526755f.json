{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabZapper - Smart Tab Manager", "version": "1.1.0", "description": "Auto-close unused tabs, save them searchable, and recover RAM. Take control of your browser tabs.", "permissions": ["tabs", "storage", "alarms", "activeTab"], "host_permissions": ["https://extensionpay.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"zap-all": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Zap all idle tabs now"}}}