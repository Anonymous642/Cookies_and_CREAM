{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Crypto Ticker Overlay", "version": "1.0.1", "description": "A configurable crypto ticker overlay that shows live prices anywhere you browse.", "author": "mysticalg", "homepage_url": "https://github.com/mysticalg/crypto-ticker", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.coingecko.com/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html", "default_title": "Crypto Ticker"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}