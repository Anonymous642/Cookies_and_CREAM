{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WordGuard", "version": "1.0.1", "description": "Censors profane words and blocks them on websites. For example, the word cat becomes c**.", "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}