{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MapToo \u2014 Save places to your maps", "description": "Capture addresses from any webpage and save them to your MapToo maps. Quick Add, Custom Add, bulk import, and zone awareness.", "version": "1.1.4", "short_name": "MapToo", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "notifications", "tabs", "activeTab", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://maptoo.com/*", "https://www.maptoo.com/*", "https://*.maptoo.com/*", "https://*.lovable.app/*", "https://*.lovableproject.com/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open MapToo capture popup"}}, "action": {"default_title": "MapToo", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["icon/*.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline';"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://maptoo.com/extension/connect*", "https://www.maptoo.com/extension/connect*"], "run_at": "document_idle", "js": ["content-scripts/handoff.js"]}]}