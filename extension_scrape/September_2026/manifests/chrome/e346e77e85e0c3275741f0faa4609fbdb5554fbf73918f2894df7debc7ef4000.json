{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Breadcrumb", "description": "Never lose your place on the Web. Automatically saves your scroll position and highlights across all websites.", "version": "1.0.0", "manifest_version": 3, "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["styles/content.css"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["popup/*.js", "popup/*.css", "styles/*.css"], "matches": ["<all_urls>"]}], "homepage_url": "https://allitservice.com/resources/breadcrumb/", "author": "AllIT Service"}