{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat Alertz - For Twitch, Kick & YouTube", "short_name": "Chat Alertz", "version": "1.4.2", "version_name": "1.4.2", "description": "Never miss a Twitch, Kick, or YouTube keyword in chat. Get instant desktop alerts for giveaways, raffles, races, or name mentions.", "homepage_url": "https://chatalertz1.netlify.app/", "permissions": ["notifications", "storage", "alarms"], "host_permissions": ["*://www.twitch.tv/*", "*://kick.com/*", "*://www.kick.com/*", "*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["*://www.twitch.tv/*"], "js": ["content-core.js", "platforms/twitch.js"], "run_at": "document_idle"}, {"matches": ["*://kick.com/*", "*://www.kick.com/*"], "js": ["content-core.js", "platforms/kick.js"], "run_at": "document_idle"}, {"matches": ["*://youtube.com/live_chat*", "*://www.youtube.com/live_chat*", "*://m.youtube.com/live_chat*"], "js": ["content-core.js", "platforms/youtube.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}