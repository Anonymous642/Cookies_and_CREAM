{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Webpage Archive - Save Websites", "version": "1.0.0", "description": "Save complete web pages with all assets for offline viewing. Export to Netlify, backup to Archive.org, manage archives.", "author": "Mubashir Hassan", "homepage_url": "https://www.mubashirhassan.com", "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "contextMenus", "bookmarks", "notifications", "tabs", "downloads"], "action": {"default_popup": "popup.html", "default_title": "Archive this webpage with all assets", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["archived/*"], "matches": ["<all_urls>"]}]}