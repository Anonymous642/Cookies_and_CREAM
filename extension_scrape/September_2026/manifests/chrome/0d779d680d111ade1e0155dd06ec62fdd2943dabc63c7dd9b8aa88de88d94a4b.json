{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Live CC Translator", "version": "1.0.1", "description": "Translate live subtitles on Twitch and Kick in real-time. 10 languages, no account needed. Enable CC in the player to translate.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "windows", "tabs"], "host_permissions": ["https://translate.googleapis.com/*", "https://www.twitch.tv/*", "https://twitch.tv/*", "https://player.twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*", "https://player.twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Live CC Translator", "default_icon": {"32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}}