{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinCopier", "version": "1.0.0", "description": "URL\u30ea\u30f3\u30af\u3092\u30b3\u30d4\u30fc\u3057\u307e\u3059\u3002", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting"], "background": {"service_worker": "dist/background.js", "type": "module"}, "action": {"default_title": "Copy link", "default_popup": "dist/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"copy_slack_style": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Copy as Slack style"}, "copy_markdown": {"suggested_key": {"default": "Alt+Shift+C", "mac": "MacCtrl+C"}, "description": "Copy as markdown"}, "copy_url_only": {"suggested_key": {"default": "Alt+U", "mac": "Command+Shift+C"}, "description": "Copy as URL only"}}}