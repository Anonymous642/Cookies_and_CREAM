{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumen - LinkedIn Connection Remover", "version": "1.0.0", "description": "Quickly remove connections directly from your LinkedIn feed.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://*.linkedin.com/*", "https://*.ingest.us.sentry.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "lumen.png", "48": "lumen.png", "128": "lumen.png"}}, "icons": {"16": "lumen.png", "48": "lumen.png", "128": "lumen.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.ingest.us.sentry.io"}}