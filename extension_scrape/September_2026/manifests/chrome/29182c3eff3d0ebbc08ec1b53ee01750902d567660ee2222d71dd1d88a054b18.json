{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy All URLs 4.0 (Free) \u2013 Copy & Open Multiple Links", "version": "2.2", "description": "Copy all tab URLs in one click. Paste to open multiple links. Export as Text/HTML/JSON. Fast, clean, keyboard shortcuts.", "permissions": ["tabs", "clipboardWrite", "clipboardRead", "notifications", "commands", "offscreen", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "options_page": "option.html", "commands": {"copy-tabs": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Copy all tab URLs"}, "open-tabs": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "Open URLs from clipboard"}}}