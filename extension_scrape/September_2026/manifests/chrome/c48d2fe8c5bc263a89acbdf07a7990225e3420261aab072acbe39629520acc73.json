{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skopx", "description": "AI assistant for any webpage. Chat, extract data, and get real-time help during meetings and interviews.", "version": "0.7.5", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "116", "permissions": ["activeTab", "storage", "sidePanel", "cookies", "tabs", "scripting", "contextMenus", "tabCapture", "offscreen", "alarms", "debugger"], "host_permissions": ["https://skopx.com/*", "https://*.skopx.com/*", "https://*.atlassian.net/*", "https://github.com/*", "https://*.confluence.com/*", "https://*.notion.so/*", "https://huggingface.co/*", "https://cdn-lfs.huggingface.co/*", "https://cdn-lfs-us-1.huggingface.co/*"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'self'"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Skopx", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open Skopx side panel"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["*://meet.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/meet-captions.js"]}, {"matches": ["https://*.skopx.com/*", "https://skopx.com/*"], "run_at": "document_idle", "js": ["content-scripts/skopx-auth.js"]}]}