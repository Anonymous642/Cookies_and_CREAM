{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapMock", "version": "1.0.1", "description": "Screenshot to device mockup in one click. No watermark. Add annotations, pick device frames, and export in HD.", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open SnapMock"}, "capture-full-tab": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Capture Full Tab"}, "capture-area": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Capture Area"}}, "host_permissions": ["<all_urls>", "https://api.polar.sh/*"], "web_accessible_resources": [{"resources": ["content/area-selector.css"], "matches": ["<all_urls>"]}]}