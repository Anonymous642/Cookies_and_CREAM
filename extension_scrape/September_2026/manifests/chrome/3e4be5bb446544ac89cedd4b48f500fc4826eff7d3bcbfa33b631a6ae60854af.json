{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Turbo Unfollow", "description": "Filter and unfollow accounts from your Following list on X (side panel).", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "cookies", "sidePanel"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "web_accessible_resources": [{"resources": ["sponsor/*"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}