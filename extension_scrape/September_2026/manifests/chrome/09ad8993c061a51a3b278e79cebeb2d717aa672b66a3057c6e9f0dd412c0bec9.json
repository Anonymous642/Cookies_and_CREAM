{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Deep Links, QR Codes and Short URLs: LinkTwin", "description": "Create app-opening deep links, QR codes and short links in one-click. Open YouTube, Amazon and 100+ apps directly in the app.", "version": "2.0", "manifest_version": 3, "permissions": ["storage", "tabs", "contextMenus", "clipboardWrite", "clipboardRead", "notifications", "scripting", "offscreen"], "omnibox": {"keyword": "lt"}, "host_permissions": ["*://linktw.in/*", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-toolbar-16.png", "32": "images/icon-toolbar-32.png", "48": "images/icon-toolbar-48.png"}}, "icons": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "128": "images/128.png"}, "background": {"service_worker": "background.js"}, "commands": {"shorten_current_link": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Command+Shift+U"}, "description": "Shorten current page URL"}, "shorten_selected_text": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Command+Shift+K"}, "description": "Shorten selected links"}}}