{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Station - Universal AI Prompt Manager", "version": "6.3", "description": "Save & organize prompts for ChatGPT, Gemini, Copilot & Local AI. Press Enter to deploy. Privacy-first local storage.", "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icon128.png"}}, "icons": {"16": "icon128.png", "32": "icon128.png", "48": "icon128.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'self';"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/*", "http://localhost/*", "http://127.0.0.1/*", "*://*/*"], "js": ["content.js"], "run_at": "document_end"}]}