{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WipeMySocial \u2014 Mass Delete Social Media Content", "version": "1.1.0", "description": "Bulk delete comments, posts, tweets and likes on Facebook, Instagram and Twitter/X. Unfollow in bulk. Runs in your browser.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://abs.twimg.com/*", "https://wipemysocial.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/archive-runner.js"], "run_at": "document_idle"}]}