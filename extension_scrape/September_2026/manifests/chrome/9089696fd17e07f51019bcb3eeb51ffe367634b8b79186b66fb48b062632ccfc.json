{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Pomodorify", "description": "Turn any YouTube video into a Pomodoro timer", "version": "0.1.0", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Pomodorify - Click on YouTube to toggle timer"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css", "style.css"]}], "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["audio/*"], "matches": ["*://*.youtube.com/*"]}]}