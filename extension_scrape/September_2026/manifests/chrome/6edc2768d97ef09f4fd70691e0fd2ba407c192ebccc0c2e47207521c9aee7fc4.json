{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tanaw - Website Intelligence", "short_name": "Tanaw", "version": "0.5.4", "description": "See any website's hosting, IP, DNS, SSL certificate and tech stack in one click, plus security, SEO and accessibility checks.", "author": "Hublikha", "minimum_chrome_version": "116", "permissions": ["storage", "scripting", "webRequest", "sidePanel", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Open Tanaw", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "src/ui/panel.html"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Tanaw"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}}