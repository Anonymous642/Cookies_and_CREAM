{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkShot \u2014 Screenshot & Annotate", "description": "Capture the visible area or full page and annotate it \u2014 arrows, boxes, text, blur \u2014 all free, all on your device.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "identity"], "host_permissions": ["https://api.lemonsqueezy.com/*", "https://markshot.ictmadeeasy.nl/*"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Capture selected area"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "MarkShot", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://markshot.ictmadeeasy.nl/thanks*"], "js": ["content-scripts/thanks.js"]}]}