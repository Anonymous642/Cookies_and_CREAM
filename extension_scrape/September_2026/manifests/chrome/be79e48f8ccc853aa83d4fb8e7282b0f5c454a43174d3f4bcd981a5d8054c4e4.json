{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slumber", "version": "1.0.0", "description": "Free up RAM by automatically suspending inactive tabs.", "permissions": ["tabs", "storage", "alarms"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Slumber", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["suspended/suspended.html"], "matches": ["<all_urls>"]}], "commands": {"suspend-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend the current tab"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}