{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Limpador para Sistema Asgard", "version": "3.6", "description": "Formata textos e limpa dados locais do sistemaasgard.com.br para facilitar o uso do Sistema Asgard.", "permissions": ["browsingData", "cookies", "history", "scripting", "storage", "tabs"], "host_permissions": ["*://sistemaasgard.com.br/*", "*://*.sistemaasgard.com.br/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background-loader.js"}, "commands": {"run-cleaner": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Limpar e unir linhas"}}}