{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabNest: Tab Organizer, Manager & Memory Saver", "version": "1.4.0", "description": "Auto-organise tabs into smart groups. Tab manager, RAM saver, workspaces, focus mode, themes \u2014 all in one beautiful place.", "author": "Janhavi", "homepage_url": "https://janhavi12800.github.io/tabnest-website/", "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications", "sidePanel"], "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabNest \u2014 your cozy tab nest"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open TabNest popup"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open TabNest full dashboard"}, "focus-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open TabNest search"}}}