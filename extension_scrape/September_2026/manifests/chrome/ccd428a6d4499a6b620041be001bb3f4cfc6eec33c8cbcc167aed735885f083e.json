{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube to Text - Transcript Extractor", "version": "1.2.5", "description": "Toggle YouTube's transcript panel from the toolbar. Click any line to jump. No signup, no data collected.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["src/debug.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "web_accessible_resources": [{"resources": ["src/page-bridge.js"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*"]}], "action": {"default_title": "YouTube to Text \u2014 transcript OFF (click to show)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["scripting", "activeTab"]}