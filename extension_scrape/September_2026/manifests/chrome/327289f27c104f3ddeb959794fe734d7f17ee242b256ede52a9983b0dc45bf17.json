{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Break Guard", "version": "1.3.0", "description": "Smart break, eye-strain (20-20-20), stretch and hydration reminders with guided on-screen breaks. Privacy-first and free.", "minimum_chrome_version": "102", "permissions": ["alarms", "idle", "notifications", "offscreen", "storage", "tabs", "tabCapture", "unlimitedStorage"], "optional_host_permissions": ["https://api.lemonsqueezy.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"start-break-now": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Start a guided break right now"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}