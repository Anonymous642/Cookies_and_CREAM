{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Refresh with a Countdown \u2014 Refresh Loop", "version": "1.0.1", "description": "Auto-refresh any tab with a visible countdown and get an alert the moment the page text changes.", "minimum_chrome_version": "116", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Refresh Loop", "default_popup": "ui/popup.html"}, "background": {"service_worker": "sw.js", "type": "module"}, "permissions": ["storage", "alarms", "activeTab", "scripting", "offscreen"], "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-job": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop refreshing the current tab"}}, "web_accessible_resources": [{"resources": ["lib/selector.js"], "matches": ["<all_urls>"]}], "optional_permissions": ["notifications"], "options_ui": {"page": "ui/licence.html", "open_in_tab": true}}