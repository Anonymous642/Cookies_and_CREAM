{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scampilot - scam & spam checker", "short_name": "Scampilot", "version": "1.1.0", "default_locale": "en", "description": "Check any page or link for scams. Click the toolbar icon for a URL safety report in the side panel.", "icons": {"16": "assets/icons/16.png", "32": "assets/icons/32.png", "48": "assets/icons/48.png", "128": "assets/icons/128.png"}, "action": {"default_title": "Scampilot", "default_icon": {"16": "assets/icons/16.png", "32": "assets/icons/32.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "commands": {"check-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Check the selected text (or the current page) with Scampilot"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["contextMenus", "storage", "activeTab", "tabs", "scripting", "sidePanel"], "host_permissions": ["https://scampilot.de/*"], "content_scripts": [{"matches": ["https://scampilot.de/extension/connected/*"], "js": ["extension_connect_bridge.js"], "run_at": "document_idle"}], "optional_host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "scampilot@pixelandprocess.de", "strict_min_version": "120.0"}}}