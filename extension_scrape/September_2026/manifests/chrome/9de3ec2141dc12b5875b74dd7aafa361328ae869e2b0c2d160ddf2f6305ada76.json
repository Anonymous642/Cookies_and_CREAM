{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sayback: Read Aloud & Text to Speech", "version": "1.0.0", "description": "Read any page aloud with the voices already on your computer. Offline text to speech \u2014 no account, no cloud, no quota.", "permissions": ["tts", "storage", "scripting", "contextMenus", "alarms", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Read this page aloud", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "options_page": "options.html", "commands": {"read-page": {"suggested_key": {"default": "Alt+R"}, "description": "Read this page aloud"}}, "web_accessible_resources": [{"resources": ["bar.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}