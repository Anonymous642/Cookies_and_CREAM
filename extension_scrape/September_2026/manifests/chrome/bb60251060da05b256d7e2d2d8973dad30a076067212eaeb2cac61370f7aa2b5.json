{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault \u2014 Save & Restore Tab Workspaces", "version": "1.0.0", "description": "Save your tabs as a workspace in one click. Restore the exact set later. Never lose your context again.", "permissions": ["tabs", "storage", "windows", "tabGroups"], "host_permissions": ["https://extensionpay.com/*"], "action": {"default_popup": "popup.html", "default_title": "TabVault"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open TabVault"}, "quick-save": {"description": "Quick-save current window as a workspace (Pro)"}, "restore-last": {"description": "Restore most recent workspace (Pro)"}}}