{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web2Markdown", "version": "1.4.0", "description": "Convert any webpage to a clean Markdown file. One-click web clipper for researchers, writers, and developers.", "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "contextMenus"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/pages/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icons/*"], "use_dynamic_url": false}]}