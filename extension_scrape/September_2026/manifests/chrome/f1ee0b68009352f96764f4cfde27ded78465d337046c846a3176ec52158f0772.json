{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DlrPilot", "version": "0.7.7", "description": "Connects your Facebook Marketplace to your DlrPilot dashboard: posts your cars, answers your buyers, books appointments.", "permissions": ["storage", "alarms", "tabs", "scripting", "cookies"], "host_permissions": ["https://dlrpilot.com/*", "https://*.facebook.com/*", "http://localhost/*", "http://127.0.0.1/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://dlrpilot.com/*", "http://localhost:4747/*", "http://127.0.0.1:4747/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "DlrPilot", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*", "https://facebook.com/marketplace/*", "https://www.facebook.com/messages/*", "https://facebook.com/messages/*"], "js": ["content.js"], "run_at": "document_idle"}]}