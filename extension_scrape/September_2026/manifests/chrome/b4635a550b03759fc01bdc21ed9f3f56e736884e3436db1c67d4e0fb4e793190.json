{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Input", "version": "0.1.0", "description": "Mirror a focused input or textarea into a floating window so you can type from another tab or app while staying synced.", "action": {"default_title": "Float this input", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "tabs", "storage", "windows"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["inject/session_bridge.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["float/float.css"], "matches": ["http://*/*", "https://*/*"]}]}