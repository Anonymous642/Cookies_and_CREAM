{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Face Blocker", "version": "1.4.0", "description": "Detecta e oculta tweets contendo rostos espec\u00edficos cadastrados pelo usu\u00e1rio. Processamento 100% local.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["face-api.min.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["models/*"], "matches": ["<all_urls>"], "use_dynamic_url": false}]}