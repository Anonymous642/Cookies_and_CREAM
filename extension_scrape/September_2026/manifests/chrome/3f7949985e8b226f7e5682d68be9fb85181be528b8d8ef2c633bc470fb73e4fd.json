{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Search Result Filter", "version": "1.0.0", "description": "Filter out specific websites from Google, Bing, and Baidu search results", "action": {"default_icon": "icon.png", "default_title": "Search Result Filter", "default_popup": "popup.html"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.baidu.com/*", "*://*.google.com/*", "*://*.bing.com/*"], "css": ["styles.css"], "js": ["jquery-3.7.1.min.js", "content.js"], "run_at": "document_end"}], "options_page": "popup.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Opens popup.html"}}, "homepage_url": "https://toolsfy.top/"}