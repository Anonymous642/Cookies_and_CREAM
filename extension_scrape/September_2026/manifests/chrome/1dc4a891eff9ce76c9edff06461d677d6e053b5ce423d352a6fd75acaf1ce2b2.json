{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Comment Suggester", "version": "4.0.1", "description": "AI-powered comment suggestions for LinkedIn and X/Twitter. Sign in with Google.", "permissions": ["clipboardWrite", "storage", "identity"], "host_permissions": ["https://api.thinkagile.us/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "images/comment.png", "48": "images/comment.png", "128": "images/comment.png"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content_x.js"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}