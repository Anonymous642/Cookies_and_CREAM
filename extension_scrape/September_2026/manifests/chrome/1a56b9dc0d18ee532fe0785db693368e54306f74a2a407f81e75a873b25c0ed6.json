{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "English to Bangla Dictionary", "version": "1.0", "description": "Double-click a word to get Bangla meaning, synonyms, antonyms, and examples. Click outside the popup to close it.", "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*", "file:///*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "EtoB.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["BengaliDictionary.json"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"128": "EtoB.png"}}