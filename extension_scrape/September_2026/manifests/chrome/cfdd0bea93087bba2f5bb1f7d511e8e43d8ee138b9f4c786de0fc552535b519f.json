{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Workspace Organizer for Google Docs, Sheets, Slides & Forms \u2014 DocVault", "description": "Create a custom workspace for your Google Docs, Sheets, Slides & Forms. Organize files into folders; no more messy, flat lists.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Workspace Manager", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://docs.google.com/document/", "*://docs.google.com/document/u/*/"], "js": ["content-scripts/doc.js"]}, {"matches": ["*://docs.google.com/forms/", "*://docs.google.com/forms/u/*/"], "js": ["content-scripts/forms.js"]}, {"matches": ["*://docs.google.com/spreadsheets/", "*://docs.google.com/spreadsheets/u/*/"], "js": ["content-scripts/sheets.js"]}, {"matches": ["*://docs.google.com/presentation/", "*://docs.google.com/presentation/u/*/"], "js": ["content-scripts/slides.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/doc.css"], "use_dynamic_url": true, "matches": ["*://docs.google.com/*", "*://docs.google.com/*"]}, {"resources": ["content-scripts/forms.css"], "use_dynamic_url": true, "matches": ["*://docs.google.com/*", "*://docs.google.com/*"]}, {"resources": ["content-scripts/sheets.css"], "use_dynamic_url": true, "matches": ["*://docs.google.com/*", "*://docs.google.com/*"]}, {"resources": ["content-scripts/slides.css"], "use_dynamic_url": true, "matches": ["*://docs.google.com/*", "*://docs.google.com/*"]}]}