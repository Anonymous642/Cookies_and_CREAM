{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapMark", "version": "1.1.0", "description": "Free screenshots with annotations: arrows, text, blur, and crop", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "offscreen"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "SnapMark", "default_icon": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}}, "icons": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}}, "options_page": "src/options/options.html", "web_accessible_resources": [{"matches": ["http://*/*", "https://*/*"], "resources": ["src/content/capture-helper.js"], "use_dynamic_url": false}]}