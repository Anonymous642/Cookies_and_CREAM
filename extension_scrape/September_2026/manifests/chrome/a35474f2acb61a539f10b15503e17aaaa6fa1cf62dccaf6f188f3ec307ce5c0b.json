{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sorcify", "version": "1.75", "description": "AI for recruiters: score LinkedIn candidates 1-100 and turn any job into Boolean searches, outreach, and interview questions.", "permissions": ["storage", "activeTab", "clipboardWrite", "scripting"], "optional_permissions": ["tabs"], "host_permissions": ["https://api.openai.com/*", "https://openrouter.ai/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/talent/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Sorcify"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}