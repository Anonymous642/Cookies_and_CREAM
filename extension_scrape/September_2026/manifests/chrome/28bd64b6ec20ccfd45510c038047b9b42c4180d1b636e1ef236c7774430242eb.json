{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GPT Temp Chat Auto-Enable", "description": "A\u00f1ade/quita temporary-chat=true con bot\u00f3n flotante.", "version": "1.3.1", "permissions": ["tabs", "webNavigation", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://*.openai.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle Temporary Chat"}, "icons": {"128": "icon.png"}, "commands": {"toggle-temp-chat": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Toggle Temporary Chat param"}}, "content_scripts": [{"matches": ["https://chatgpt.com/g/*", "https://*.openai.com/g/*"], "js": ["content.js"], "run_at": "document_idle"}]}