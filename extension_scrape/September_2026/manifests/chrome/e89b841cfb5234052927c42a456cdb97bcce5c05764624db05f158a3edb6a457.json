{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DesignLoop: HTML to Figma & Live Page Editor", "version": "0.1.0", "description": "Edit any live page like Figma, chat to tweak it, then export it to Figma as editable layers \u2014 or file a documented GitHub issue.", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "offscreen", "sidePanel", "clipboardWrite", "debugger"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://api.github.com/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "DesignLoop \u2014 activate on this page", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "options_page": "src/options/index.html", "commands": {"start-issue": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Report an issue on an element"}, "start-export": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Export an element to Figma"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}