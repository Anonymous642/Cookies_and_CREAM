{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript Helper", "description": "Quickly open and copy YouTube transcripts or view them in a clean tab.", "version": "0.0.1", "icons": {"16": "icon/active-16.png", "32": "icon/active-32.png", "48": "icon/active-48.png", "96": "icon/active-96.png", "128": "icon/active-128.png"}, "action": {"default_title": "YouTube Transcript Helper", "default_icon": {"16": "icon/active-16.png", "32": "icon/active-32.png"}}, "permissions": ["tabs", "contextMenus"], "web_accessible_resources": [{"resources": ["transcript-viewer.html", "chunks/transcript-viewer-*.js", "assets/transcript-viewer-*.css"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}