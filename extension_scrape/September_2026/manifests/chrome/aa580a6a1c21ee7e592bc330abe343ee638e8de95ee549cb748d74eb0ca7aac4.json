{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UnicodeKruti - Convert to Unicode", "short_name": "UnicodeKruti", "version": "1.0.0", "description": "Instantly convert selected KrutiDev Hindi text into Unicode Devanagari from any webpage or popup window.", "author": "UnicodeKruti.com", "homepage_url": "https://unicodekruti.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_title": "UnicodeKruti - Convert KrutiDev to Unicode", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/converter.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"open-converter-popup": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open KrutiDev to Unicode Converter popup"}}}