{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rotten Tomatoes Average Rating Finder", "version": "4.4", "description": "Displays the average rating from critics on Rotten Tomatoes, plus a visual rating distribution", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.rottentomatoes.com/*"], "content_scripts": [{"matches": ["*://*.rottentomatoes.com/*"], "js": ["rating-chart.js", "onGetAverageRating.js", "content.js"], "run_at": "document_idle"}]}