{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Applynza", "description": "A privacy-first browser extension for saving, organizing, and tracking job applications directly from job boards.", "version": "1.0.1", "short_name": "Applynza", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "sidePanel", "storage"], "host_permissions": ["http://*/*", "https://*/*", "*://*.linkedin.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Applynza", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}