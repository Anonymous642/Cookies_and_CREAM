{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Linkedin Auto Comment", "version": "1.0.1", "description": "Automate LinkedIn comments from a side panel with a single click and preview.", "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://*.linkedin.com/*", "https://api-inference.huggingface.co/*", "https://router.huggingface.co/*", "https://huggingface.co/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidebar.html"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "Open LinkedIn Automator", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"]}]}