{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Two Curious Minds X-Ray", "version": "9.14.40", "description": "See what people really mean. Analyze any sentence to understand the mind behind it.", "permissions": ["activeTab", "contextMenus", "storage", "scripting"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://*.slack.com/*", "https://twocuriousminds.com/*", "https://www.twocuriousminds.com/*"], "commands": {"xray-selection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "X-Ray selected text"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://*.slack.com/*"], "js": ["content.js"], "css": ["content.css"]}, {"matches": ["https://twocuriousminds.com/*", "https://www.twocuriousminds.com/*"], "js": ["auth-bridge.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}