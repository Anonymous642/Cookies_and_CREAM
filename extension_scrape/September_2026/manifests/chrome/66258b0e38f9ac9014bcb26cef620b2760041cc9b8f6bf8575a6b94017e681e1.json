{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "key": "", "name": "Edisnote", "version": "1.0.1", "description": "A fast, local side-panel notepad. Write freely, paste screenshots, export to Markdown for Obsidian. Encrypted sharing, no account.", "permissions": ["activeTab", "sidePanel", "storage", "unlimitedStorage", "contextMenus", "scripting"], "commands": {"toggle-note": {"suggested_key": {"default": "Alt+S"}, "description": "Pause the video and jump into Edisnote (Esc or Alt+S to resume)"}}, "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Edisnote \u2014 open notes panel"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}