{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StorePeek \u2014 Store Inspector for Shopify", "version": "1.0.0", "description": "See any Shopify store's theme, apps, pixels and payment methods. Verifiable signals only, detected 100% locally. No account needed.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "sidePanel"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Inspect this store"}, "side_panel": {"default_path": "panel/panel.html"}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open StorePeek"}}}