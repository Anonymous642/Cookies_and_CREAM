{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QRLens", "version": "1.0.0", "description": "A gentle little lens for any QR on the page. Slides in from the right \u2014 drag to select or quick-scan.", "author": "SnowiyQ", "homepage_url": "https://github.com/SnowiyQ/qrlens", "permissions": ["activeTab", "scripting", "clipboardWrite", "notifications", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "QRLens \u2014 open panel"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-panel": {"description": "Open / close the QRLens panel"}, "quick-scan": {"description": "Quick-scan the visible viewport for a QR code"}, "region-scan": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Select a region to scan for a QR code"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["lib/jsQR.js", "panel.html", "panel.css", "panel.js"], "matches": ["<all_urls>"]}]}