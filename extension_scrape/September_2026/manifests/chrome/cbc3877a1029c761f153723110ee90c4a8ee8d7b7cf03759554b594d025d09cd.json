{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ticket Themer", "version": "19.0", "description": "Customize osTicket themes. A simple tool to change the osTicket interface with multiple theme options.", "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["css/dark-theme.css", "css/orange-justice.css", "css/midnight-theme.css", "css/image-theme.css"], "matches": ["*://*/*"]}]}