{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Sticky Notes", "version": "0.6.0", "description": "Add private sticky notes to webpages. They return when you revisit and stay stored locally in Chrome\u2014no account required.", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "src/background.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Web Sticky Notes", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"create-note": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Create a sticky note on the current page"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/storage.js", "src/selection.js", "src/anchoring.js", "src/content.js"], "run_at": "document_idle"}]}