{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabDump \u2014 Analyze My Open Tabs", "version": "1.2.2", "description": "One click. Send your open tabs to TabDump for a calm, AI-powered attention reading. Click a memory to jump back to its original tab.", "permissions": ["tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://tabdump.vercel.app/*", "*://localhost/*", "*://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle"}]}