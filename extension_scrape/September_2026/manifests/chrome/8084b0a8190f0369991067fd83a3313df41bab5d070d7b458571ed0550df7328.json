{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode Focus Gate", "version": "1.1.2", "description": "Unlock distracting sites by solving a fresh LeetCode problem.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["alarms", "declarativeNetRequest", "storage", "tabs"], "host_permissions": ["<all_urls>", "https://leetcode.com/graphql/"], "background": {"service_worker": "background.js"}, "action": {"default_title": "LeetCode Focus Gate", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "styles.css"], "matches": ["<all_urls>"]}]}