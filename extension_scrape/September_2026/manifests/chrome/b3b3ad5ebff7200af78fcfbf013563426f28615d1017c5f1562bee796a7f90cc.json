{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JarForAI Companion", "version": "2.4.4", "description": "Save your AI chats to a Jar project and bring past context back into a new conversation, without copy-pasting between sessions.", "permissions": ["activeTab", "storage", "tabs", "sidePanel"], "host_permissions": ["https://jarforai.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.ai/*", "https://kimi.com/*", "https://kimi.moonshot.cn/*", "https://chat.z.ai/*", "https://chatglm.cn/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "JarForAI \u2014 click to toggle panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.ai/*", "https://kimi.com/*", "https://kimi.moonshot.cn/*", "https://chat.z.ai/*", "https://chatglm.cn/*"], "js": ["content.js"], "run_at": "document_idle"}]}