{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Text to Speech AI\u2122", "version": "1.0.0", "description": "Read any webpage, PDF, Google Doc, or email aloud with natural AI voices. Smart reader, word highlighting, speed control, and more.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service_worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/reading-bar.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "tabs", "contextMenus", "tts"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open ClearVoice"}, "play-pause": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Play / Pause"}, "stop": {"description": "Stop reading"}, "read-selection": {"description": "Read selected text"}}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*", "content/*"], "matches": ["<all_urls>"]}]}