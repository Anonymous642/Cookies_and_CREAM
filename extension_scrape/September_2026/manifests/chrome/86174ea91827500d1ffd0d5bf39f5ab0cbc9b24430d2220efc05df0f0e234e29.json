{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusAI: Smart Website Blocker & Deep Insights", "short_name": "FocusAI", "version": "2.0.0", "description": "Smart website blocker, screen time tracker & focus timer. Block sites, YouTube Shorts, app distractions. Free AI insights dashboard.", "permissions": ["tabs", "activeTab", "storage", "unlimitedStorage", "webNavigation", "alarms", "notifications", "windows"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "scripts/background.js"}, "action": {"default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["scripts/cs-youtube.js"], "run_at": "document_idle"}, {"matches": ["*://www.google.com/*", "*://www.bing.com/*"], "js": ["scripts/cs-search.js"], "run_at": "document_start"}, {"matches": ["*://www.instagram.com/*", "*://instagram.com/*"], "js": ["scripts/cs-instagram.js"], "run_at": "document_idle"}, {"matches": ["*://www.facebook.com/*", "*://facebook.com/*"], "js": ["scripts/cs-facebook.js"], "run_at": "document_idle"}, {"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["scripts/cs-twitter.js"], "run_at": "document_idle"}, {"matches": ["*://www.reddit.com/*", "*://reddit.com/*"], "js": ["scripts/cs-reddit.js"], "run_at": "document_idle"}, {"matches": ["*://www.tiktok.com/*", "*://tiktok.com/*"], "js": ["scripts/cs-tiktok.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["scripts/cs-usage.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pages/blocked.html", "pages/system.html", "pages/welcome.html", "icons/*", "badges/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}