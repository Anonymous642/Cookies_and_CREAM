{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cortextual Omni", "version": "3.0.0", "description": "Chat with Cortextual AI anywhere and find relevant files directly in Google Search.", "permissions": ["scripting", "activeTab", "storage", "tabs"], "host_permissions": ["https://api.cortextual.com/*", "https://app.cortextual.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "index.html", "default_title": "Cortextual", "default_icon": {"16": "images/icons/logo-16.png", "32": "images/icons/logo-32.png", "34": "images/icons/logo-34.png", "48": "images/icons/logo-48.png", "128": "images/icons/logo-128.png"}}, "content_scripts": [{"matches": ["https://www.google.com/*", "https://google.com/*"], "js": ["content/google-search-injector.js", "content/google-chat-sidebar.js", "content/google-results-sidebar.js"], "css": ["content/google-search-injector.css", "content/file-preview.css", "content/google-results-sidebar.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://*/*"], "exclude_matches": ["https://*.google.com/*", "https://www.google.com/*", "https://google.com/*"], "js": ["content/google-chat-sidebar.js"], "run_at": "document_idle", "all_frames": false}], "icons": {"16": "images/icons/logo-16.png", "32": "images/icons/logo-32.png", "34": "images/icons/logo-34.png", "48": "images/icons/logo-48.png", "128": "images/icons/logo-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["images/*", "chat.html", "auth-callback.html", "content/file-preview.css"], "matches": ["https://*/*"]}]}