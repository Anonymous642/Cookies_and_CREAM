{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boltdrop \u2014 AliExpress & SHEIN Importer", "version": "1.6.4", "description": "One-click import from AliExpress or SHEIN with variants, images, and pricing \u2014 auto-fill Facebook, Mercari, Poshmark, Depop.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://*.alicdn.com/*", "https://*.aliyuncs.com/*", "https://*.aliexpress-media.com/*", "https://*.shein.com/*", "https://*.sheinsz.ltwebstatic.com/*", "https://*.ltwebstatic.com/*", "https://*.facebook.com/*", "https://*.mercari.com/*", "https://*.poshmark.com/*", "https://*.depop.com/*", "http://localhost:6001/*", "https://boltdrop.shop/*", "https://*.boltdrop.shop/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Boltdrop", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.us/item/*"], "js": ["aliexpress-runparams-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.us/item/*"], "js": ["content.js", "aliexpress-fulfill.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://*.facebook.com/marketplace/create/*"], "js": ["facebook-marketplace.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.mercari.com/sell/*", "https://www.mercari.com/list/*"], "js": ["marketplace-helpers.js", "mercari.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/create-listing*", "https://*.poshmark.com/create-listing*"], "j