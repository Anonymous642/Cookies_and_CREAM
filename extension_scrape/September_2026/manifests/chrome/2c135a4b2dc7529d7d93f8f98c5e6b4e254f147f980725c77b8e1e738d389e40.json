{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sorter AI", "version": "1.0", "description": "Rank Instagram posts by likes, comments & date. Scan any profile, find top content, and export to Google Sheets in one click.", "homepage_url": "https://insorter.com", "minimum_chrome_version": "102", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://www.instagram.com/*", "https://firestore.googleapis.com/*", "https://api.emailjs.com/*", "https://insorter.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Sorter AI"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.instagram.com/*"]}]}