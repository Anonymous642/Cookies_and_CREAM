{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Degu Screenshot - Screen Capture & Recorder", "version": "0.0.6", "description": "Powerful free screen capture, full page screenshot, area crop, screen recorder with webcam, blur tool, editor by Degu Traum.", "permissions": ["activeTab", "scripting", "storage", "desktopCapture", "offscreen", "tabs", "unlimitedStorage", "contextMenus"], "background": {"service_worker": "background/service_worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible part of page"}, "capture-selected": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture selected area"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "ocr-sniper": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "OCR Text Sniper (Extract text from region)"}}, "web_accessible_resources": [{"resources": ["content/selection.css", "content/element_capture.css", "content/webcam_bubble.css", "content/eyedropper.css", "editor/editor.html", "recorder/recorder.html", "gallery/gallery.html", "settings/settings.html", "icons/logo.jpg", "icons/icon_head.png", "content/timer_overlay.css", "content/timer_overlay.js", "lib/modal.css", "lib/modal.js", "lib/gif_encoder.js", "lib/ocr.js", "lib/privacy_filter.js", "content/recorder_overlay.css", "content/recorder_overlay.js", "content/ocr_sniper.js"], "matches": ["<all_urls>"]}]}