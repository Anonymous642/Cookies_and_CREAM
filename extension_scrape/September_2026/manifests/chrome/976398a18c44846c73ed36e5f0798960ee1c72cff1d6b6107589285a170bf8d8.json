{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PassGen \u2014 Secure Password Generator", "short_name": "PassGen", "version": "1.1.0", "description": "Generate strong passwords, diceware passphrases and PINs. Exact entropy maths, no network access, nothing leaves your device.", "minimum_chrome_version": "120", "action": {"default_title": "PassGen \u2014 generate a password", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background/service_worker.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "offscreen", "alarms", "clipboardWrite"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open PassGen"}, "generate-and-copy": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Generate a password and copy it to the clipboard"}, "generate-and-fill": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Generate a password and fill the focused password field"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}}