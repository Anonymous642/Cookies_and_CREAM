{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mouse AI", "description": "AI Voice Assistant for UI/UX & React", "version": "1.0.2", "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Mouse AI"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"toggle-activation": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle Mouse AI"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "fiber.js"], "matches": ["<all_urls>"]}]}