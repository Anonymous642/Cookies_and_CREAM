{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goodreads Book Details", "version": "0.7.0", "description": "Display book details and description under book covers. No need to click or hover. Enhance Goodreads", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.goodreads.com/*", "https://www.audible.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.goodreads.com/blog/show/*", "https://www.goodreads.com/interviews/show/*", "https://www.goodreads.com/choiceawards/*", "https://www.goodreads.com/genres/*", "https://www.goodreads.com/genres", "https://www.goodreads.com/genres/new_releases/*", "https://www.goodreads.com/list/show/*", "https://www.goodreads.com/recommendations*", "https://www.goodreads.com/shelf/show/*", "https://www.goodreads.com/review/list/*"], "css": ["style.css"], "js": ["content.js"]}], "action": {"default_title": "Goodreads Book Details", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}