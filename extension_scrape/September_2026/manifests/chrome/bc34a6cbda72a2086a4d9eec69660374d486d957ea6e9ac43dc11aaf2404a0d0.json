{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Counter Check \u2014 Send to Review", "version": "1.4", "description": "Send whatever's on screen straight to Counter Check for review \u2014 no copy-paste needed.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://countercheckai.com/*", "https://www.countercheckai.com/*"], "action": {"default_title": "Send this page to Counter Check", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://countercheckai.com/app.html*", "https://www.countercheckai.com/app.html*"], "js": ["autofill.js"], "run_at": "document_idle"}]}