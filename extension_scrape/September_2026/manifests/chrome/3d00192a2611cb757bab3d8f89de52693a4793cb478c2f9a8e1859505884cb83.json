{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "114", "name": "LaunchBert Directory Autofill", "version": "1.1.0", "description": "Autofill your product details into launch directories in one click, with simple progress tracking and one-click badges.", "permissions": ["storage", "scripting", "sidePanel", "tabs"], "host_permissions": ["https://launchbert.com/*", "https://www.launchbert.com/*"], "optional_host_permissions": ["https://*/*"], "action": {"default_title": "LaunchBert Directory Autofill", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "commands": {"autofill-form": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Auto-fill the active directory form"}, "previous-directory": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Go to the previous directory"}, "next-directory": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Go to the next directory"}, "open-directory": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Open the current directory submit page"}, "toggle-details": {"description": "Toggle product details"}, "mark-done": {"description": "Mark the current directory as done"}, "skip-directory": {"description": "Skip the current directory"}, "toggle-badge": {"description": "Add or remove the directory badge"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://launchbert.com/*", "https://www.launchbert.com/*"], "js": ["config.js", "runtime.js", "auth-handoff.js"], "run_at": "document_start"}]}