{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Wtyczka Badawcza IFIS", "description": "Logs Google search interactions and correlates opened result tabs.", "version": "1.0.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["tabs", "storage", "offscreen"], "host_permissions": ["https://www.google.com/*", "https://google.com/*", "https://www.google.pl/*", "https://google.pl/*", "https://api.plugin.ifis.jkfstudio.pl/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://google.com/search*", "https://www.google.pl/search*", "https://google.pl/search*"], "js": ["src/content.js", "src/content/google-search-capture.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.plugin.ifis.jkfstudio.pl"}, "web_accessible_resources": [{"resources": ["assets/*.js", "logo.png", "alert.wav", "index.html", "audio.html"], "matches": ["<all_urls>"], "use_dynamic_url": false}]}