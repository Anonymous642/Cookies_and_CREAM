{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SessionSync Pro - Multi-Account Manager", "version": "2.3.9", "description": "Save and switch local website sessions with passphrase-encrypted backups and paid Gumroad activation.", "author": "Uncommon Weather LLC", "permissions": ["storage", "cookies", "activeTab", "contextMenus", "notifications", "alarms"], "host_permissions": ["https://*/*", "http://*/*", "https://api.gumroad.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "exclude_matches": ["https://gumroad.com/*", "https://*.gumroad.com/*", "https://api.gumroad.com/*", "https://uncommonweather.com/*", "https://*.uncommonweather.com/*"], "js": ["legal/config.js", "legal/content-gate.js", "content-scripts/switch-notification.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "SessionSync Pro", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none';"}, "minimum_chrome_version": "119", "offline_enabled": true, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Open SessionSync"}, "switch-account": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Quick switch account"}}, "homepage_url": "https://www.uncommonweather.com/products/sessionsync.html", "externally_connectable": {"matches": ["https://www.uncommonweather.com/legal/consent-bridge.html"], "accepts_tls_channel_id": false}}