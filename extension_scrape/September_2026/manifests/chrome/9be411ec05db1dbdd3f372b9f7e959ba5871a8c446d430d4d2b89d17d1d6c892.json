{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mirada \u2014 Eyetracking local", "version": "0.1.0", "description": "Eyetracking con webcam sobre p\u00e1ginas web reales. Todo el procesamiento es local, no se env\u00eda ni se guarda v\u00eddeo.", "permissions": ["offscreen", "storage", "scripting", "activeTab", "webNavigation"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}