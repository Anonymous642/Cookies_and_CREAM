{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InstantAmp", "description": "Background play, PiP, volume control, downloads, speed up to 4x, auto-scroll & shortcuts for Instagram.", "version": "1.1.2", "permissions": ["activeTab", "storage", "downloads"], "optional_host_permissions": ["*://*.fbcdn.net/*", "*://*.cdninstagram.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "InstantAmp", "default_icon": {"16": "icon128.png", "32": "icon128.png", "48": "icon128.png", "128": "icon128.png"}}, "icons": {"16": "icon128.png", "32": "icon128.png", "48": "icon128.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_start"}]}