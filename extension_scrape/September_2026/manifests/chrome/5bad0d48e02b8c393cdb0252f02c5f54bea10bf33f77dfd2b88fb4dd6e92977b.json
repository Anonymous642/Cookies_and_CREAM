{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "unSheet", "version": "1.1", "description": "Automatically track your LeetCode journey.", "icons": {"16": "logo16.png", "48": "logo48.png", "128": "logo128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.unsheet.in/*", "http://localhost:8080/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "logo16.png", "48": "logo48.png", "128": "logo128.png"}}, "externally_connectable": {"matches": ["https://unsheet.in/*", "http://localhost:3000/*"]}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["interceptor.js"], "matches": ["https://leetcode.com/*"]}]}