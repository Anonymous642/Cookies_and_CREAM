{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecruitEasy - Chrome Extension", "description": "RecruitEase - Professional LinkedIn profile extractor and talent management assistant.", "version": "1.0.11", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "notifications", "contextMenus", "activeTab", "alarms"], "host_permissions": ["https://www.linkedin.com/*", "https://recruiteasy.ca/*", "https://www.recruiteasy.ca/*", "https://recruiteasy-api-v2.azurewebsites.net/*", "http://localhost:5080/*", "http://localhost:3001/*"], "externally_connectable": {"matches": ["https://recruiteasy.ca/*", "https://www.recruiteasy.ca/*", "http://localhost:3001/*", "https://localhost:3001/*"]}, "action": {"default_title": "RecruitEasy"}, "commands": {"extract-profile": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Add the current LinkedIn profile to RecruitEasy"}, "_execute_action": {"description": "Open the RecruitEasy panel"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content-scripts/content.js"]}]}