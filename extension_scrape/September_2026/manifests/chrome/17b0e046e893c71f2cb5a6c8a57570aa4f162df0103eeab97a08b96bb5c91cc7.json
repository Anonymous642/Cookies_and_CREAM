{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loupe \u2014 Screen Recorder with Auto Zoom", "short_name": "Loupe", "version": "1.0.0", "description": "Record a tab, a window or your whole screen, with optional auto zoom and an editor. Free, no watermark, nothing is uploaded.", "minimum_chrome_version": "120", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Loupe: record a tab, window or screen", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "sw.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "scripting", "activeTab"], "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+S", "chromeos": "Alt+Shift+2"}, "description": "Start or stop recording"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "chromeos": "Alt+Shift+3"}, "description": "Pause or resume the recording"}}}