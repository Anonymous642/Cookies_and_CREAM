{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTLDR \u2013 Anti-Clickbait for YouTube", "description": "Answers the video before the video wastes your time. See summaries on hover, skip the fluff.", "version": "0.1.64", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://youtldr.com", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://i.ytimg.com/*", "https://youtldr.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-interceptor.js"], "world": "MAIN"}, {"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}