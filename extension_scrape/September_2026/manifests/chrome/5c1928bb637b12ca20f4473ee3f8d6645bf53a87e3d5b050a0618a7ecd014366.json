{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kontx \u2014 Live Context for Every YouTube Video", "version": "0.4.1", "description": "Get the full picture from every YouTube video. Real-time context cards explain people, jargon, and concepts as you watch.", "author": "Kontx", "homepage_url": "https://kontx.live/privacy", "permissions": ["storage"], "minimum_chrome_version": "116", "host_permissions": ["https://www.youtube.com/*", "https://api.kontx.live/*"], "background": {"service_worker": "dist/background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["dist/content/content.js"], "css": ["dist/styles/kontx-variables.css", "dist/styles/sidebar.css", "dist/styles/cards.css", "dist/styles/settings.css"]}, {"matches": ["https://www.youtube.com/*"], "js": ["dist/content/player-response.js"], "world": "MAIN", "run_at": "document_idle"}], "action": {"default_popup": "dist/popup/popup.html", "default_title": "Kontx"}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/icons/*"], "matches": ["https://www.youtube.com/*"]}]}