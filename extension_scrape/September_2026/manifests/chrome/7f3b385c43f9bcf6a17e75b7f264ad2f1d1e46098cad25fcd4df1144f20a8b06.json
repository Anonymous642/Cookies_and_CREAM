{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Card Comp Snapshot", "version": "1.4.0", "description": "Capture a sports card, identify it with eBay Image Search, and search sold/completed listings.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage"], "host_permissions": ["https://www.ebay.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Capture card for comps", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-card": {"suggested_key": {"default": "Ctrl+Shift+Y", "chromeos": "Ctrl+Shift+Y"}, "description": "Capture the visible card"}}, "content_scripts": [{"matches": ["https://www.ebay.com/*"], "js": ["ebay-image-bridge.js"], "css": ["ebay-image-bridge.css"], "run_at": "document_idle"}, {"matches": ["https://www.ebay.com/sch/i.html*"], "js": ["ebay-summary.js"], "css": ["ebay-summary.css"], "run_at": "document_idle"}]}