{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recaply", "description": "Analyze your browsing history", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "permissions": ["storage", "cookies", "tabs"], "host_permissions": ["http://localhost:5173/*", "http://127.0.0.1:5173/*", "https://recaply.xyz/*"], "commands": {"open-recaply": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open Recaply"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}