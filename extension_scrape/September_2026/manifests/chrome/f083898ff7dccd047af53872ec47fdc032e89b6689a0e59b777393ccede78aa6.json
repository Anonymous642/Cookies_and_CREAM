{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VeoRec: Screen Recorder with Webcam & Share Link", "version": "1.47.0", "minimum_chrome_version": "116", "description": "Screen recorder for Chrome: record your screen, camera and mic, get an instant share link, plus screenshots and AI transcripts.", "permissions": ["storage", "activeTab", "scripting", "tabs", "notifications", "offscreen"], "optional_permissions": ["downloads"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start / stop recording"}, "pause-resume": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause / resume recording"}, "take-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Take a screenshot"}}, "content_scripts": [{"matches": ["https://veorec.com/*", "https://www.veorec.com/*"], "js": ["bridge.js"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["gmail.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["video-download.js", "player.js"], "all_frames": true, "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["bubble.html", "bubble.js", "looks.js", "messages.js"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_popup": "popup.html", "default_title": "VeoRec: Record your screen", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}