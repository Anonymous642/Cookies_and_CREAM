{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptDock \u2013 Prompt Manager for ChatGPT, Claude & Gemini", "version": "1.0.0", "description": "Save, organize and instantly insert your best prompts in ChatGPT, Claude, Gemini, Perplexity and Grok. 100% local, no account.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "PromptDock", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://aistudio.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://x.com/i/grok*", "https://chat.mistral.ai/*", "https://chat.deepseek.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the PromptDock palette"}}}