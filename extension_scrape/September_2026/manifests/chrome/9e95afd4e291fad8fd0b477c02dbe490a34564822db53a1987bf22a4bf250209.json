{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapSecure", "version": "1.0.0", "description": "Crop, annotate, and save screenshots of any tab. 100% on-device \u2014 nothing is ever uploaded, logged, or stored in the cloud.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SnapSecure \u2014 capture screenshot (Alt+Shift+S)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "commands": {"start-capture": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Start screenshot capture"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+X"}}}, "minimum_chrome_version": "110"}