{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "One-Click Gmail Template", "version": "1.1", "description": "Insert pre-saved email templates into web-based email clients with one click or add templates from Gmail emails.", "permissions": ["activeTab", "storage", "contextMenus", "scripting"], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "host_permissions": ["https://mail.google.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_end"}]}