{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tatkal Booking Assistant for IRCTC - Auto Fill", "version": "1.2.0", "description": "Fast IRCTC Tatkal ticket booking: auto fill passengers, open your train and reach UPI payment at 10/11 AM. You enter CAPTCHA & OTP.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tatkal Booking Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"auto-pilot": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Auto Pilot: search se UPI payment screen tak (IRCTC na khula ho to khol deta hai)"}}, "permissions": ["storage", "alarms", "notifications", "scripting"], "host_permissions": ["https://www.irctc.co.in/*"], "content_scripts": [{"matches": ["https://www.irctc.co.in/*"], "js": ["utils.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}