{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PocketTab \u2013 Tab Session Manager", "version": "2.0.0", "description": "Save and restore tab sessions to organize tabs, reduce clutter, and free up memory for faster browsing.", "permissions": ["tabs", "storage", "activeTab", "alarms", "unlimitedStorage"], "action": {"default_popup": "popup.html", "default_title": "PocketTab \u2013 Tab Session Manager"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"collapse-all-tabs": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Collapse all tabs in current window"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open PocketTab dashboard"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}