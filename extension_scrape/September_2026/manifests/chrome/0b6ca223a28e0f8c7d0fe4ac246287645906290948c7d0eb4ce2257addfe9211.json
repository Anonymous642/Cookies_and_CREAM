{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AliExpress Search By Image - Quick Product Finder", "version": "4.0.2", "description": "Right-click any image to search on AliExpress! Find products fast and dropship easily with this powerful image search tool.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.ru/*", "*://*.aliexpress.us/*", "*://*.aliexpress.br/*", "*://*.aliexpress.es/*", "*://*.aliexpress.fr/*", "*://*.aliexpress.pl/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}