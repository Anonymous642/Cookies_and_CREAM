{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitter Eras (Unofficial)", "version": "1.7.0", "description": "Unofficial historical Twitter UI for every year from 2006\u20132022, using your signed-in X account for timelines, messages, and actions.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "webNavigation"], "action": {"default_title": "Twitter Eras \u2014 choose an era", "default_popup": "popup/popup.html"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "exclude_matches": ["https://twitter.com/i/flow/*", "https://x.com/i/flow/*", "https://twitter.com/i/oauth2/*", "https://x.com/i/oauth2/*", "https://twitter.com/account/*", "https://x.com/account/*", "https://twitter.com/logout*", "https://x.com/logout*"], "js": ["src/eras.js", "src/settings.js", "src/injection.js", "src/api.js", "src/app.js"], "css": ["src/styles/main.css", "src/styles/2015-2022.css"], "run_at": "document_start"}], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://abs.twimg.com/*", "https://upload.twitter.com/*", "https://upload.x.com/*", "https://api.twitter.com/*", "https://api.x.com/*"]}