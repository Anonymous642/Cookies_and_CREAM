{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Gemini IMG", "version": "2.0.0", "description": "Automatically generate AI images with Google Gemini. Batch mode, 20+ styles, auto-download, and more!", "author": "Ken Dao", "permissions": ["activeTab", "downloads", "storage", "scripting", "sidePanel"], "host_permissions": ["https://gemini.google.com/*", "https://*.gemini.google.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["inject.js", "icons/icon128.png"], "matches": ["https://gemini.google.com/*"]}]}