{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auxiliador de Postagens", "version": "1.2.1", "description": "Captura o link do v\u00eddeo ou imagem aberta (X, TikTok, Instagram, Pinterest) e envia para o seu bot do Telegram.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://ext.nodebahia.com.br/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Auxiliador de Postagens", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.pinterest.com/*", "*://*.pinterest.com.br/*", "*://*.pinterest.co.uk/*", "*://*.pinterest.fr/*", "*://*.pinterest.de/*", "*://pin.it/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}