{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Page Modeller (Playwright, Selenium, Puppeteer etc.)", "description": "Browser DevTools extension for modelling web pages for automation.", "version": "3.0.0", "short_name": "PageModeller", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "storage", "contextMenus", "sidePanel"], "action": {"default_title": "Page Modeller"}, "host_permissions": ["<all_urls>"], "minimum_chrome_version": "114", "background": {"service_worker": "background.js"}, "devtools_page": "devtools.html", "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["content-scripts/content.js"], "match_origin_as_fallback": true}]}