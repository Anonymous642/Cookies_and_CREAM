{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CLYE AI Browser Extension", "description": "Registriert diesen Browser als CLYE AI MCP Gateway, sobald der Chat in der Seitenleiste ge\u00f6ffnet ist.", "version": "0.3.6", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "192": "icons/icon-192.png", "512": "icons/icon-512.png"}, "permissions": ["alarms", "contextMenus", "cookies", "debugger", "sidePanel", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/appshot-content.js"], "all_frames": true, "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/discovery-content.js", "src/content-script.js"], "all_frames": true, "run_at": "document_idle"}], "options_page": "src/options.html", "side_panel": {"default_path": "src/sidepanel.html"}, "action": {"default_title": "CLYE AI Chat \u00f6ffnen", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://* http://localhost:* http://127.0.0.1:*;"}, "commands": {"open-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "CLYE AI Chat-Sidepanel \u00f6ffnen"}, "appshot": {"description": "AppShot aufnehmen und an den CLYE AI Chat anh\u00e4ngen"}}}