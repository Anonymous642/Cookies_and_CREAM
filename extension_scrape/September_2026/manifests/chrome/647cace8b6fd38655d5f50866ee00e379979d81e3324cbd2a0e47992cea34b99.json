{"update_url": "https://clients2.google.com/service/update2/crx", "name": "LinkedIn Mute", "description": "Filter out unwanted posts from your LinkedIn feed by muting any words, phrases, or topics", "version": "1.3.1", "manifest_version": 3, "icons": {"16": "icons/linkedin-mute-16.png", "32": "icons/linkedin-mute-32.png", "48": "icons/linkedin-mute-48.png", "128": "icons/linkedin-mute-128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/linkedin-mute-16.png", "32": "icons/linkedin-mute-32.png", "48": "icons/linkedin-mute-48.png", "128": "icons/linkedin-mute-128.png"}}, "background": {"service_worker": "scripts/background.js"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://www.linkedin.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["scripts/content.js"], "css": ["styles/linkedin.css"]}]}