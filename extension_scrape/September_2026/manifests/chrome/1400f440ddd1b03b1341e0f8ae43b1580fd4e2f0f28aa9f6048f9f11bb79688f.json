{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PitchMit - Upwork Proposal Assistant", "description": "Save Upwork jobs in one click. Auto-extracts job details, client spending, hire rate, competition, and win probability.", "version": "1.1.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.upwork.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.upwork.com/jobs/*", "https://www.upwork.com/nx/search/jobs/*", "https://www.upwork.com/freelance-jobs/*", "https://www.upwork.com/ab/proposals/job/*", "https://www.upwork.com/freelancers/*", "https://www.upwork.com/fl/*"], "js": ["utils/storage.js", "utils/api.js", "content/scrapers/job-page.js", "content/scrapers/profile-page.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["https://www.upwork.com/*"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}