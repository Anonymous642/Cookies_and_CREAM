{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Su: Distraction-free Reader and Annotator", "version": "0.1.0", "description": "Read articles in a clean, focused space. Highlight, add margin notes, and export to Markdown, Obsidian or PDF.", "action": {"default_title": "Open Su Reader (\u2318U)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["scripting", "storage", "activeTab", "alarms"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://su-reader.joiqypu.workers.dev/*"], "commands": {"toggle-reader": {"suggested_key": {"default": "Alt+U", "mac": "Command+U"}, "description": "Open or close the Su Reader on the current page"}}, "web_accessible_resources": [{"resources": ["reader/*", "reader/fonts/*", "vendor/*", "icons/*"], "matches": ["<all_urls>"]}]}