{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopyBuddy \u2014 Clipboard History & HTML to PDF", "version": "3.5", "description": "Clipboard history in a side panel. Keeps what you copy, searches it, pastes it back, and saves any clip as a PDF.", "permissions": ["storage", "scripting", "activeTab", "contextMenus", "sidePanel", "alarms"], "optional_permissions": ["clipboardRead"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open CopyBuddy", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Open the CopyBuddy side panel"}}}