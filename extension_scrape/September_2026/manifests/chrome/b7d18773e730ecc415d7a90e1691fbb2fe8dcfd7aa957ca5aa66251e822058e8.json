{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Focus", "version": "1.0", "description": "Blocks Reddit URLs except specific comment threads", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["webNavigation", "scripting"], "host_permissions": ["*://*.reddit.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}]}