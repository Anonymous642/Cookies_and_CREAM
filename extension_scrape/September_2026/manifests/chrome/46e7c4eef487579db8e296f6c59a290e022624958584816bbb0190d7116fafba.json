{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stripe Dark Mode", "version": "1.0.0", "description": "A clean, traditional dark theme for the Stripe Dashboard. Accent-preserving, with intensity control and a one-click toggle.", "homepage_url": "https://github.com/palubaitis/StripeDarkMode-extension", "minimum_chrome_version": "110", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://dashboard.stripe.com/*", "https://connect.stripe.com/*"], "action": {"default_title": "Stripe Dark Mode", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://dashboard.stripe.com/*", "https://connect.stripe.com/*"], "css": ["src/darkmode.css"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Toggle Stripe Dark Mode on/off"}}}