{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Orator \u2014 Web Narrator", "description": "Narrate web pages with natural voices, speed control, click to seek, and follow along highlighting.", "version": "0.3.2", "action": {"default_title": "Orator", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "contextMenus", "scripting", "offscreen"], "web_accessible_resources": [{"resources": ["pdfWorker.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"orator-toggle-play": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play/Pause narration"}, "orator-stop": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop narration"}, "orator-next": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Next sentence"}, "orator-prev": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Previous sentence"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}