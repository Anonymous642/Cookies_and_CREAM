{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Page Notes", "version": "0.2.0", "description": "Attach private, persistent notes to any page or domain. Local-only, zero login.", "icons": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}, "permissions": ["storage", "sidePanel", "contextMenus", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Open Page Notes", "default_icon": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"quick-add-note": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Open Page Notes and focus input"}}, "minimum_chrome_version": "114"}