{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ignitd.ai \u2014 AI Plan Capture", "description": "Capture AI-generated plans from any LLM and send them to ignitd.ai to transform and take action.", "version": "0.1.0", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "tabs"], "host_permissions": ["https://ignitd.ai/*", "https://www.ignitd.ai/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Send selection to ignitd.ai", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://ignitd.ai/*"], "js": ["inject-import.js"], "run_at": "document_start"}]}