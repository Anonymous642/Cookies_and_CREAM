{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptGo", "description": "Save, organize, and reuse your best AI prompts and chat snippets. Works on ChatGPT, Claude, Gemini, and Perplexity.", "version": "1.0.1", "short_name": "PromptGo", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["<all_urls>"]}], "commands": {"toggle-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle PromptGo side panel"}}, "permissions": ["storage", "tabs", "sidePanel"], "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://*.perplexity.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.chatgpt.com/*", "*://*.claude.ai/*", "*://*.gemini.google.com/*", "*://*.perplexity.ai/*"], "js": ["content-scripts/content.js", "content-scripts/snippet-compatibility-fallback.js", "content-scripts/snippet-jumpback.js"]}]}