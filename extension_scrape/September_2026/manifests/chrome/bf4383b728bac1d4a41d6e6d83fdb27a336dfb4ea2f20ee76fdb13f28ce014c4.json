{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dayditto \u2014 Quick Task & Focus", "short_name": "Dayditto", "homepage_url": "https://dayditto.com", "description": "Quick-add tasks, run a focus timer, capture from any page, and sync with Dayditto from the toolbar.", "version": "1.1.0", "permissions": ["storage", "notifications", "activeTab", "tabs", "alarms", "offscreen", "scripting", "contextMenus"], "host_permissions": ["http://localhost:8000/*", "http://localhost:3000/*", "http://127.0.0.1:8000/*", "https://api.dayditto.com/*", "https://*.dayditto.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000 https://api.dayditto.com wss://api.dayditto.com https://*.dayditto.com wss://*.dayditto.com"}, "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Dayditto", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open Dayditto quick-add"}, "add_selection_as_task": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add selected text as Dayditto task"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}