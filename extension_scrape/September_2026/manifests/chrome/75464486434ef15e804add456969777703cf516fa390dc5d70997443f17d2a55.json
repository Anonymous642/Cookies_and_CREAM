{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blixem Tab Manager", "homepage_url": "https://blixem.io/", "description": "Organize, save & share your tabs for easy collaboration with Blixem.", "version": "1.0.2", "default_locale": "en", "permissions": ["tabs", "sessions", "topSites", "search", "bookmarks", "commands", "tabGroups", "storage", "sidePanel"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "externally_connectable": {"matches": ["https://app.blixem.io/*"]}, "action": {"default_icon": {"48": "icons/48.png"}, "default_title": "Blixem.io", "default_popup": "index.html"}, "commands": {"open-blixem": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab to workspace"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}}}, "side_panel": {"default_path": "index.html"}}