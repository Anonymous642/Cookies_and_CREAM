{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inkognito-Modus Rahmi", "short_name": "Rahmi Incognito", "description": "Open pages in incognito mode, clean tracking URLs, use smart rules and shortcuts. Free, no login, no ads.", "version": "1.1.0", "minimum_chrome_version": "112", "default_locale": "en", "action": {"default_title": "Inkognito-Modus Rahmi", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png", "512": "assets/icons/icon512.png"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["tabs", "activeTab", "storage", "contextMenus", "history"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"open-current-incognito": {"suggested_key": {"default": "Alt+I", "mac": "Alt+I"}, "description": "Open current tab in incognito"}, "open-current-clean-incognito": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Open current tab as clean URL in incognito"}, "open-all-current-window": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Open all tabs of the current window in incognito"}}, "incognito": "spanning"}