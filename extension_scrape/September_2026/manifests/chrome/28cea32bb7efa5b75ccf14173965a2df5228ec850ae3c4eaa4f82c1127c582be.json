{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuietBrowsing: Link Cleaner & Tracking Param Remover", "version": "1.0.0", "description": "Auto-remove utm_, fbclid, gclid & tracking params from links. Reveal real URLs behind redirects. 100% local, nothing uploaded.", "permissions": ["declarativeNetRequest", "contextMenus", "storage", "offscreen", "activeTab", "scripting", "clipboardRead"], "host_permissions": ["<all_urls>"], "minimum_chrome_version": "116", "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "QuietBrowsing", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "tracking_params", "enabled": true, "path": "rules/rules.json"}]}}