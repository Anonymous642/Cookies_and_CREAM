{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feed Sanitizer for LinkedIn", "version": "1.0.0", "description": "Clean up your LinkedIn feed: hide ads, AI broetry & bait, mute keywords, or show ONLY the topics/people you value. 100% local.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/rules.js", "src/sanitizer.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}