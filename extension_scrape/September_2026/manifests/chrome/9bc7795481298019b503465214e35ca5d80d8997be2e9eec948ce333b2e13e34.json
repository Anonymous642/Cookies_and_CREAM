{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Glossa \u2014 select to translate", "short_name": "Glossa", "version": "0.1.0", "description": "Select text on any page and read the translation right where you are. No account, no tracking, 100 words at a time.", "homepage_url": "https://github.com/DzhIliyas/Glossa", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/langs.js", "src/content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}], "action": {"default_popup": "src/popup.html", "default_title": "Glossa"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "commands": {"translate-selection": {"suggested_key": {"default": "Alt+T"}, "description": "Translate the current selection"}}, "browser_specific_settings": {"gecko": {"id": "glossa@openweb.tools", "strict_min_version": "115.0"}}}