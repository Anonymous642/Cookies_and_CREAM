{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lemon - A Local CRM for Linkedin", "version": "0.8.2", "description": "A lightweight Kanban board based CRM that works on top of your bookmarked contacts for Linkedin. Built by the team at Quibbly.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png", "192": "assets/icons/icon-192.png", "256": "assets/icons/icon-256.png", "512": "assets/icons/icon-512.png"}, "permissions": ["bookmarks", "storage"], "host_permissions": ["*://*.linkedin.com/*"], "action": {"default_title": "Open Bookmarks Dashboard", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["assets/icons/icon-16.png", "assets/icons/icon-32.png", "assets/icons/icon-48.png", "assets/icons/icon-128.png", "assets/icons/icon-180.png", "assets/icons/icon-192.png", "assets/icons/icon-256.png", "assets/icons/icon-512.png"], "matches": ["*://*.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["linkedin.content.js"], "run_at": "document_end"}]}