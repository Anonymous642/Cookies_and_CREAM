{"update_url": "https://clients2.google.com/service/update2/crx", "name": "KeyBinds - Keyboard Shortcuts for Web Pages", "description": "Create custom keyboard shortcuts for any button, link, or clickable element on web pages.", "version": "2.0.0", "manifest_version": 3, "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "KeyBinds - Create Keyboard Shortcuts", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"start-binding": {"suggested_key": {"default": "Alt+Q"}, "description": "Start binding a key to an element"}, "toggle-bindings": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Toggle all key bindings on/off"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/dom-utils.js", "content/selectors.js", "content/click-engine.js", "content/ui-helpers.js", "content/storage.js", "content/macro-engine.js", "content/message-handler.js", "content_script.js"], "run_at": "document_start", "all_frames": true}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*.woff*", "fonts/*.ttf"], "matches": ["<all_urls>"]}], "homepage_url": "https://kgans.com", "author": "Adam Keegan"}