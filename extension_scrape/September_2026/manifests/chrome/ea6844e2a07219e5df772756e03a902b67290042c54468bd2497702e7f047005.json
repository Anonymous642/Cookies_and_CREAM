{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Notes For Obsidian", "version": "1.2", "description": "Create Obsidian Notes from Youtube videos with keyboard shortcuts", "icons": {"16": "media/icon.png", "48": "media/icon.png", "128": "media/icon.png"}, "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["*://*.youtube.com/*", "https://podsearch-eosin.vercel.app/*"], "web_accessible_resources": [{"resources": ["*.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "dist/background.js", "type": "module"}, "options_page": "options.html", "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["dist/content.js"]}], "commands": {"quick-clip": {"suggested_key": {"mac": "Command+Shift+Y", "default": "Ctrl+Shift+Y"}, "description": "Quick clip - directly create note in Obsidian"}, "open-clipper": {"suggested_key": {"mac": "Alt+Shift+Y", "default": "Alt+Shift+Y"}, "description": "Open Obsidian Clipper menu"}}}