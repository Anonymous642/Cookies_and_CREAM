{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cleanista", "version": "0.8.0", "description": "A cleaner Idealista search experience. Finds likely duplicate property listings on the page you are viewing.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://*.idealista.com/*", "https://happylisting.ai/*", "https://www.happylisting.ai/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Cleanista", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.idealista.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}