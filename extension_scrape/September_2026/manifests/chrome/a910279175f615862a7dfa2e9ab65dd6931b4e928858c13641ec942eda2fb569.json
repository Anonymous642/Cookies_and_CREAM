{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BugTest: Visual Bug Reporter, Screenshot & Web QA", "version": "1.1.0", "description": "Bug reporter for web QA: screenshot, annotate, capture console + network errors, and export to Jira, GitHub, Linear or PDF.", "author": "BugTest", "action": {"default_title": "Open BugTest \u2014 screenshot & report a bug (Ctrl/Cmd+Shift+D)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["capture.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "permissions": ["activeTab", "storage", "scripting", "downloads", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["overlay.html", "overlay.css", "overlay.js", "capture.js", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Toggle BugTest on this page"}, "report-bug": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Quick Report Bug"}, "open-bug-board": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the Bug Board (all bugs)"}}, "minimum_chrome_version": "111"}