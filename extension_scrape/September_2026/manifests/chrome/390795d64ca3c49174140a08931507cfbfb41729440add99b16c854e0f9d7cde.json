{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Retail Root", "version": "0.4", "description": "Filters search results on major retail sites (Amazon, Walmart, etc.) to show only items sold directly by the main retailer.", "permissions": ["activeTab", "storage", "commands"], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.ca/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*", "*://*.amazon.co.uk/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.se/*", "*://*.amazon.eg/*", "*://*.amazon.sa/*", "*://*.amazon.it/*", "*://*.amazon.fr/*", "*://*.amazon.de/*", "*://*.amazon.es/*", "*://*.amazon.nl/*", "*://*.bestbuy.ca/*", "*://*.walmart.ca/*", "*://*.walmart.com/*", "*://*.newegg.com/*", "*://*.newegg.ca/*", "*://*.tesco.com/*", "*://*.zalando.co.uk/*", "*://*.fnac.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html"}, "options_page": "options.html", "commands": {"toggle-filter": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Ctrl+Shift+U"}, "description": "Active Search filters"}}}