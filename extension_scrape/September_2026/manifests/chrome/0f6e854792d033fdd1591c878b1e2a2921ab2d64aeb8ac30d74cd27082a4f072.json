{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeQueryAI", "description": "AI-powered GitHub repository explorer. Analyze any codebase with intelligent AI assistance.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "CodeQueryAI"}, "permissions": ["activeTab", "contextMenus"], "host_permissions": ["https://github.com/*", "https://codequeryai.xyz/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["content.css"]}]}