{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeakGuard", "version": "0.1.0", "description": "Quietly flag sensitive data on webpages with local detection and private DLP policies.", "action": {"default_popup": "popup.html", "default_title": "LeakGuard"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}