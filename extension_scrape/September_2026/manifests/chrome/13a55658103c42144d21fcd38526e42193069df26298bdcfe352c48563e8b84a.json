{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grove \u2013 Pomodoro Timer & Website Blocker", "version": "1.9.0", "description": "A calm, nature-themed Pomodoro timer with tasks, sound alerts, and website blocker to help you grow through focused work.", "permissions": ["storage", "notifications", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs", "scripting", "offscreen", "windows"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"quick_add_task": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Grove: quick-add a task from any page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["offscreen.html", "blocked.html", "window.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}