{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sentlume \u2013 Angebote nachfassen", "description": "Kein Angebot mehr vergessen: Nachfass-Erinnerungen direkt in Gmail und Outlook \u2013 lokal, ohne CRM, ohne automatischen Versand.", "version": "1.0.0", "short_name": "Sentlume", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "action": {"default_title": "Sentlume \u2013 f\u00e4llige Angebote", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail.js"]}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "run_at": "document_idle", "js": ["content-scripts/outlook.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/gmail.css"], "use_dynamic_url": true, "matches": ["https://mail.google.com/*"]}, {"resources": ["content-scripts/outlook.css"], "use_dynamic_url": true, "matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"]}]}