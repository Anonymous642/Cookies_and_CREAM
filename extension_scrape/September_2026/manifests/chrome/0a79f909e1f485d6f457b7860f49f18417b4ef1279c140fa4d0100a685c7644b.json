{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floaty Console", "version": "0.1.0", "description": "Floating console overlay for any page. Captures and filters output by level. Debug sites without opening DevTools.", "action": {"default_title": "Floaty Console", "default_icon": {"16": "assets/terminal_16755669.png", "32": "assets/terminal_16755669.png", "48": "assets/terminal_16755669.png", "128": "assets/terminal_16755669.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "storage"], "commands": {"toggle-floaty-console": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Floaty Console"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["contentScript.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["pageBridge.js"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"16": "assets/terminal_16755669.png", "48": "assets/terminal_16755669.png", "128": "assets/terminal_16755669.png"}}