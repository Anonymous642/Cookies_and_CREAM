{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DiscogMix: Multi-Artist Shuffle for Spotify", "description": "Select 2-10 artists (up to 15 with Lifetime) and shuffle their entire catalogs into a playlist.", "version": "1.3.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "webRequest"], "host_permissions": ["https://*.spotify.com/*", "https://open.spotifycdn.com/*"], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://open.spotify.com/*"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle DiscogMix panel"}}, "externally_connectable": {"matches": ["https://discogmix.com/*", "https://www.discogmix.com/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "DiscogMix"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://open.spotify.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}