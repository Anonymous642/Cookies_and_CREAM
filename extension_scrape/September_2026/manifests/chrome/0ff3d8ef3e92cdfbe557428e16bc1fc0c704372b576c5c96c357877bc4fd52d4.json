{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voxily: AI Reply & Comment Generator for LinkedIn, X & Reddit", "version": "1.0.25", "description": "Replies and comments in your voice on LinkedIn, X and Reddit. Drafts inside the reply box; you edit and send. Never auto-posts.", "permissions": ["storage", "activeTab", "contextMenus"], "commands": {"generate-reply": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate Voxily reply"}, "fix-reply": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fix my reply"}, "open-chat": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open Voxily Chat"}}, "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.linkedin.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://*.convex.cloud/*", "https://voxily-api.freelansar333.workers.dev/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://reddit.com/*", "https://www.reddit.com/*"], "js": ["content/shadow-intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://twitter.com/*", "https://x.com/*", "https://www.linkedin.com/*", "https://reddit.com/*", "https://www.reddit.com/*"], "js": ["content/content-script.js"], "css": ["content/voxily.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "sidepanel.html", "assets/*"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://www.linkedin.com/*", "https://reddit.com/*", "https://www.reddit.com/*"]}], "externally_connectable": {"matches": ["https://getvoxily.com/*", "https://www.get