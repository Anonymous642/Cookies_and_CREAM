{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteGuard", "short_name": "PasteGuard", "version": "1.0.0", "description": "Warns before you paste, type, or send secrets into input fields across websites. Local-first and no raw secret storage.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["src/ui/content.css"], "js": ["src/storage/defaults.js", "src/storage/settings.js", "src/detector/utils.js", "src/detector/redact.js", "src/detector/detectors.js", "src/detector/scanner.js", "src/content/editor.js", "src/ui/ui-owner.js", "src/ui/warning-modal.js", "src/ui/inline-badge.js", "src/content/content-script.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "options_page": "src/options/options.html", "action": {"default_title": "PasteGuard", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "web_accessible_resources": [{"resources": ["fonts/Inter-Regular.woff2", "fonts/Inter-Medium.woff2", "fonts/Inter-SemiBold.woff2", "fonts/Inter-Bold.woff2"], "matches": ["<all_urls>"]}]}