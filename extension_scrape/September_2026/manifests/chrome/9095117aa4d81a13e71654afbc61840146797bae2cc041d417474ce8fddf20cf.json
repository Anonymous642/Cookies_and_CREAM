{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "birthdays.social - Facebook Birthdays exporter", "version": "1.0.5", "description": "Get your Facebook friends' birthdays and export them to your Calendar of choice", "action": {"default_icon": {"16": "assets/bdsicon_16x16.png", "19": "assets/bdsicon_19x19.png", "32": "assets/bdsicon_32x32.png", "38": "assets/bdsicon_38x38.png"}, "default_popup": "launcher.html"}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://www.facebook.com/*", "http://www.facebook.com/*", "https://facebook.com/*", "http://facebook.com/*"], "icons": {"16": "assets/bdsicon_16x16.png", "48": "assets/bdsicon_48x48.png", "128": "assets/bdsicon_128x128.png"}, "permissions": ["activeTab", "scripting", "storage"], "content_scripts": [{"matches": ["https://www.facebook.com/*", "http://www.facebook.com/*", "https://facebook.com/*", "http://facebook.com/*"], "js": ["mainContent.js"]}, {"matches": ["https://www.facebook.com/*", "http://www.facebook.com/*", "https://facebook.com/*", "http://facebook.com/*"], "js": ["tabInfoContent.js"]}]}