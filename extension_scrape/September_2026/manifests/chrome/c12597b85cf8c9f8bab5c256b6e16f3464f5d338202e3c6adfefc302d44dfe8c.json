{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RankShield Browser Guardian", "version": "1.2.0", "description": "Warns you about risky extensions, phishing & OAuth-consent traps, and known-bad sites \u2014 backed by a privacy-preserving threat mesh.", "minimum_chrome_version": "121", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "RankShield Browser Guardian", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["declarativeNetRequest", "management", "identity", "identity.email", "storage", "alarms", "notifications", "webNavigation", "tabs"], "host_permissions": ["https://accounts.google.com/*", "https://myaccount.google.com/*", "https://sea-shield-production.up.railway.app/*"], "content_scripts": [{"matches": ["https://accounts.google.com/*", "https://login.microsoftonline.com/*", "https://login.live.com/*", "https://*.okta.com/*", "https://*.auth0.com/*", "https://github.com/login/oauth/*"], "js": ["src/content/consent-guardian.js"], "run_at": "document_idle"}, {"matches": ["https://myaccount.google.com/*"], "js": ["src/content/account-watch.js"], "run_at": "document_idle"}], "declarative_net_request": {"rule_resources": [{"id": "rs_static_blocklist", "enabled": true, "path": "rules/static-blocklist.json"}]}, "web_accessible_resources": [{"resources": ["warn/blocked.html", "warn/blocked.js"], "matches": ["<all_urls>"]}]}