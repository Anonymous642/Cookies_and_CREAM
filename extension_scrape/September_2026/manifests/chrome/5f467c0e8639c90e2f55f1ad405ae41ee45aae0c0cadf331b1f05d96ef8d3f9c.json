{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HackerNews Scroll", "version": "1.1", "description": "Adds a button to scroll to root comments on Hacker News.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": [], "background": {}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://news.ycombinator.com/item?id=*"], "js": ["content.js"], "run_at": "document_idle"}]}