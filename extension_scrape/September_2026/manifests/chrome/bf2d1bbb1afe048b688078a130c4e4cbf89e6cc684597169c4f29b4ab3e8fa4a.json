{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PixelCloak", "version": "1.0.0", "description": "Redact sensitive data from screenshots locally \u2014 no uploads, no cloud processing, nothing leaves your browser.", "minimum_chrome_version": "116", "permissions": ["activeTab", "storage", "scripting"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/settings/index.html", "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "commands": {"pixelcloak-shortcut": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture and redact the current tab"}}}