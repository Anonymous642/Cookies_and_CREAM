{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Seeker", "version": "1.0.0", "description": "LinkedIn job search assistant with smart filters, company blocking, and saved searches via the Quick Seeker panel.", "background": {"service_worker": "background.js"}, "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "icons": {"16": "icons/extension-icon.png", "32": "icons/extension-icon.png", "48": "icons/extension-icon.png", "128": "icons/extension-icon.png"}, "action": {"default_title": "Quick Seeker", "default_popup": "popup.html", "default_icon": {"16": "icons/extension-icon.png", "32": "icons/extension-icon.png", "48": "icons/extension-icon.png", "128": "icons/extension-icon.png"}}, "commands": {"open-quick-seeker": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Quick Seeker panel"}}, "web_accessible_resources": [{"resources": ["icons/extension-icon.png", "linkedin-url.js", "saved-search-label.js"], "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content.js"], "css": ["theme.css", "content.css"], "all_frames": true, "run_at": "document_end"}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["quick-actions.js"], "css": ["theme.css", "quick-actions.css"], "run_at": "document_end"}]}