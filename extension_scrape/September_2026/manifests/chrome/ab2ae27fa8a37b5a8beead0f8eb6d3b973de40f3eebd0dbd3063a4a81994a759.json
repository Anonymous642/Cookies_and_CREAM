{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "tabvault", "version": "1.19.0", "description": "Bookmark and session management vault.", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "permissions": ["bookmarks", "tabs", "storage", "activeTab", "notifications", "contextMenus"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Save current browsing session as a new vault"}, "save-tab": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Save the active tab to TabVault"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the TabVault dashboard"}, "toggle-trash": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the TabVault Trash Bin"}}}