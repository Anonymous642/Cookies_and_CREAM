{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Toolship: Browser Toolkit for DEV & QA", "short_name": "Toolship", "version": "0.11", "description": "Dynamically manage HTTP/HTTPS requests, browser tabs, and storage using rule-based filters and actions.", "icons": {"24": "icons/icon_24.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "action": {"default_icon": {"24": "icons/icon_24.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "default_title": "Toolship", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["declarativeNetRequest", "webRequest", "tabs", "scripting", "proxy", "alarms", "contextMenus", "downloads", "debugger", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible area screenshot"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Capture selected region screenshot"}, "extract-tables": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Command+Shift+T"}, "description": "Extract tables from current page"}, "measure-ruler": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Command+Shift+U"}, "description": "Activate measure/ruler tool"}}, "options_ui": {"page": "index.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*", "offscreen.html"], "matches": ["<all_urls>"]}], "author": "Shridhar", "homepage_url": "https://utilsware.com/products/toolship", "key": ""}