{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Enhancer", "version": "1.0", "description": "Adds new tools to enhance your YouTube experience, including features like 'Disable Shorts', 'Modify Columns of Videos' and more.", "permissions": ["storage"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "64": "assets/icon64.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "64": "assets/icon64.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}