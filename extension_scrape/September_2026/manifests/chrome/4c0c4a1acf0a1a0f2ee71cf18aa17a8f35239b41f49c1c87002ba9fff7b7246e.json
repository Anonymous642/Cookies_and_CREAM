{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Personal Echo", "version": "1.0.1", "description": "A fully local writing style assistant for Google Docs.", "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://docs.google.com/document/*"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Personal Echo"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["src/content/google-docs-adapter.js"], "run_at": "document_idle"}], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}