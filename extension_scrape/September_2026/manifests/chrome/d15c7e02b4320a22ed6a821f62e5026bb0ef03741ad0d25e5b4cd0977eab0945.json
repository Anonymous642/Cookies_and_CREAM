{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meet Live Voice Translator", "version": "1.1.3", "description": "Real-time two-way voice translation for Google Meet: hear others in your language, and be heard in theirs. Powered by Gemini.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs", "identity", "sidePanel"], "host_permissions": ["https://meet.google.com/*", "https://generativelanguage.googleapis.com/*", "wss://generativelanguage.googleapis.com/*", "https://realtime-meeting.headspacex.work/*"], "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["lib/auto-mute.js", "content/page_hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://meet.google.com/*"], "js": ["lib/i18n.js", "lib/hold-key.js", "content/content_script.js"], "css": ["content/hud.css"], "run_at": "document_idle"}], "commands": {"toggle-talk": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Toggle talking (push-to-talk) while translating"}}, "action": {"default_popup": "popup/popup.html", "default_title": "Meet Live Voice Translator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://meet.google.com/*"]}]}