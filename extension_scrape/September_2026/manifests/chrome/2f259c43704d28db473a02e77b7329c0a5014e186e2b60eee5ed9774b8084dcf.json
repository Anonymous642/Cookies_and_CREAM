{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flat.io Slider Toggle", "description": "This extension adds an extra control to Flat.io embeds that toggles the progress slider on your sheet music while playing.", "version": "1.0.4", "icons": {"128": "icons/icon-128.png"}, "host_permissions": ["https://flat.io/embed/*", "https://*.flat.io/embed/*", "https://flat-embed.com/*"], "content_scripts": [{"matches": ["https://flat.io/embed/*", "https://*.flat.io/embed/*", "https://flat-embed.com/*"], "all_frames": true, "js": ["content/inject.js"]}], "web_accessible_resources": [{"resources": ["content/injected.js"], "matches": ["https://flat.io/*", "https://*.flat.io/*", "https://flat-embed.com/*"]}], "browser_specific_settings": {"gecko": {"id": "flat-io-extension@martijnc.be"}}}