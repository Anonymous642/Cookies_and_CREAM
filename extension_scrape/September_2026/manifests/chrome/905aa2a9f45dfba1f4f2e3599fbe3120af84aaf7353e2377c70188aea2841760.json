{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TikTok Keyword Muter", "version": "1.0.4", "description": "TikTok Keyword Muter is a helpful tool to automatically scroll to the next TikTok when a muted word is detected.", "permissions": ["storage"], "host_permissions": ["https://www.tiktok.com/*", "https://extpay.com/*"], "background": {"service_worker": "dist/background.js"}, "content_scripts": [{"matches": ["https://www.tiktok.com/*"], "js": ["dist/content.js"]}], "action": {"default_popup": "popup/popup.html", "default_title": "TikTok Keyword Muter"}, "icons": {"16": "img/tiktokIcon16.png", "48": "img/tiktokIcon48.png", "128": "img/tiktokIcon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}