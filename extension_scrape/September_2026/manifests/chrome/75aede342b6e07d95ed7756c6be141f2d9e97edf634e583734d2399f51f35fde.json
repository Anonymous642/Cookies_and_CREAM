{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bunny Hop Player", "version": "1.0.1", "description": "Cute, synchronized lyrics for the song playing in YouTube Music, in a floating always-on-top window.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "sidePanel", "tabs", "scripting"], "host_permissions": ["https://music.youtube.com/*", "https://lrclib.net/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Bunny Hop Player", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["floating.html", "assets/*", "icons/*"], "matches": ["https://music.youtube.com/*"]}]}