{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Hybtra", "version": "1.1.0", "manifest_version": 3, "description": "Access thousands of curated AI prompts for ChatGPT and other AI tools. Boost your productivity with organized, searchable prompts.", "author": "Hybtra", "homepage_url": "https://hybtra.com", "permissions": ["storage", "tabs"], "host_permissions": ["https://api.hybtra.com/*", "https://hybtra.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.hybtra.com https://hybtra.com;"}, "web_accessible_resources": [{"resources": ["branding/logo.svg", "branding/logo-with-text.svg", "branding/logo.png", "branding/logo28x28.png"], "matches": ["<all_urls>"]}], "icons": {"16": "branding/logo28x28.png", "32": "branding/logo28x28.png", "48": "branding/logo.png", "128": "branding/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Hybtra", "default_icon": {"16": "branding/logo28x28.png", "32": "branding/logo28x28.png", "48": "branding/logo.png", "128": "branding/icon128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.meta.ai/*"], "js": ["src/content.js"], "run_at": "document_end", "all_frames": false}], "commands": {"open-prompt-modal": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open Hybtra prompt library"}}, "minimum_chrome_version": "88", "short_name": "Hybtra", "offline_enabled": false}