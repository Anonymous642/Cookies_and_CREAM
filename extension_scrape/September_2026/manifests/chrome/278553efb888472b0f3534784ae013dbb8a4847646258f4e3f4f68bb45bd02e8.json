{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptBox", "version": "2.8.1", "default_locale": "en", "description": "Save, organize, and reuse prompts across AI chats with templates, reusable forms, slash commands, and page actions.", "permissions": ["storage", "activeTab", "clipboardWrite", "contextMenus", "sidePanel"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://aistudio.google.com/*", "https://deepseek.com/*", "https://perplexity.ai/*", "https://www.bing.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*", "https://www.perplexity.ai/*"], "js": ["prompt-utils.js", "preset-templates.js", "content.js"], "css": ["content.css"]}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "commands": {"open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open PromptBox command palette on supported AI sites"}}, "minimum_chrome_version": "116", "side_panel": {"default_path": "sidepanel.html"}}