{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Net Social", "version": "1.0.0", "description": "Enhance your Netflix experience with social features like comments, ratings, and custom styles", "permissions": ["storage", "tabs", "scripting", "activeTab"], "host_permissions": ["https://netflix.com/*", "https://*.netflix.com/*", "https://www.netsocialreviews.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.netflix.com/*"], "js": ["content.js"], "css": ["styles.css", "netflix-styles.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["overlay.html", "overlay.js", "icons/*", "*.css", "placeholder.svg"], "matches": ["https://*.netflix.com/*"]}], "commands": {"toggle_overlay": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle Netflix Social overlay"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://www.netsocialreviews.com/*"]}}