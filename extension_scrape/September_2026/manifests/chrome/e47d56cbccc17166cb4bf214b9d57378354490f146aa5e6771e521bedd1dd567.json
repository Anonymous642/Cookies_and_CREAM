{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AliasFleet - Email Alias Manager", "description": "Create and manage email aliases instantly from any website. Protect your inbox from spam.", "version": "1.0.5", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite", "alarms", "notifications", "tabs", "scripting", "offscreen", "sidePanel"], "host_permissions": ["https://www.aliasfleet.com/*", "https://aliasfleet.com/*", "https://app.aliasfleet.com/*"], "externally_connectable": {"matches": ["https://www.aliasfleet.com/*", "https://aliasfleet.com/*", "https://app.aliasfleet.com/*"]}, "web_accessible_resources": [{"resources": ["auth-callback.html"], "matches": ["https://www.aliasfleet.com/*", "https://aliasfleet.com/*", "https://app.aliasfleet.com/*"]}, {"resources": ["sidepanel.html", "popup-fallback.html", "chunks/*", "assets/*", "icon.png", "icon.svg", "logo-light.png", "logo-dark.png"], "matches": ["<all_urls>"]}], "commands": {"generate-alias": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Generate alias for current site"}, "copy-last": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy last generated alias"}, "quick-create": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Open AliasFleet inline popup"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Toggle AliasFleet side panel"}}, "action": {"default_title": "AliasFleet", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "docum