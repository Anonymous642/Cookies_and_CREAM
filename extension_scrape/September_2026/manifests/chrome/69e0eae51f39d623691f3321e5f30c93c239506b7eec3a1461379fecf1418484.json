{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Player - Universal Picture-in-Picture with Subtitle & Reel/Short", "version": "1.1", "description": "Premium Picture-in-Picture player for web videos, Reels, and Shorts. Features custom subtitles and persistent audio visualizers.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "windows", "tabs", "system.display"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["adapters/base.js", "adapters/youtube.js", "adapters/aniwatch.js", "adapters/artplayer.js", "adapters/oneshows.js", "adapters/tiktok.js", "adapters/facebook.js", "adapters/instagram.js", "adapters/twitch.js", "adapters/libraryplayers.js", "adapters/bilibili.js", "adapters/universal.js", "content.js"], "css": ["styles.css"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["adapters/*", "styles.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-miniplayer": {"suggested_key": {"default": "Alt+P", "mac": "Command+Shift+P"}, "description": "Toggle Simple Player Picture-in-Picture"}}}