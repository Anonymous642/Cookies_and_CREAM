{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FactFrame - Fact-Check YouTube Captions", "description": "FactFrame \u2014 fact-check YouTube captions in real time using web search (Tavily, Exa, Perplexity, or Brave) and your LLM.", "version": "0.1.1", "icons": {"16": "extension-icon-16.png", "32": "extension-icon-32.png", "48": "extension-icon-48.png", "128": "extension-icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://*/*"], "action": {"default_title": "FactFrame", "default_icon": {"16": "extension-icon-16.png", "32": "extension-icon-32.png", "48": "extension-icon-48.png", "128": "extension-icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://m.youtube.com/*", "*://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}