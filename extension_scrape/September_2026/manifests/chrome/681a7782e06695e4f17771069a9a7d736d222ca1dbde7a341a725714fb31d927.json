{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EncarLens: Currency & History Tracker for Encar", "version": "1.0.1", "description": "Convert Encar prices to your local currency and keep track of visited car listings instantly.", "author": "Martin Zani", "default_locale": "en", "icons": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.encar.com/*", "https://car.encar.com/*", "https://fem.encar.com/*", "https://m.encar.com/*", "https://encar-addon.a-albania.al/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.encar.com/*", "https://car.encar.com/*", "https://fem.encar.com/*", "https://m.encar.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "default_title": "EncarLens"}, "web_accessible_resources": [{"resources": ["src/*"], "matches": ["https://www.encar.com/*", "https://car.encar.com/*", "https://fem.encar.com/*", "https://m.encar.com/*"]}]}