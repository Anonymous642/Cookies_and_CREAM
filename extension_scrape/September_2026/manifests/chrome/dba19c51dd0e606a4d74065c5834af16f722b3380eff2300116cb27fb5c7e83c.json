{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anthill", "version": "1.4.2", "description": "Copy a link, email, or phone number and Anthill offers to file it away \u2014 jobs, articles, and contacts \u2014 into your workspace.", "permissions": ["activeTab", "storage", "scripting", "cookies", "contextMenus", "alarms", "notifications", "offscreen"], "host_permissions": ["https://anthill-ai.vercel.app/*", "http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Anthill \u2014 Quick Capture", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"quick-capture": {"suggested_key": {"default": "Alt+Shift+S", "windows": "Alt+Shift+S", "linux": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save the current page to Anthill"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}