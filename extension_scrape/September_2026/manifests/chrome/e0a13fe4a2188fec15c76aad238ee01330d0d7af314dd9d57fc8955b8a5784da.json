{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RegCalc64", "version": "0.3.1", "description": "Floating 64-bit register calculator: Hex/Dec/Bin, drag-select bit fields, shifts, logic and expressions.", "action": {"default_title": "RegCalc64", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "sandbox": {"pages": ["tool.html"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["tool.html"], "matches": ["<all_urls>"]}]}