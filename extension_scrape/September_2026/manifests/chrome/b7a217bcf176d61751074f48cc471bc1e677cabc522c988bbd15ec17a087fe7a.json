{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "spenddy-link", "description": "Spenddy Link Plugin", "version": "0.0.4", "icons": {"16": "icon/logo-16.png", "32": "icon/logo-32.png", "48": "icon/logo-48.png", "128": "icon/logo-128.png"}, "permissions": ["storage", "tabs", "declarativeNetRequest", "webRequest"], "host_permissions": ["https://*.swiggy.com/*", "*://spenddy.fyi/*"], "action": {"default_icon": {"16": "icon/logo-16.png", "32": "icon/logo-32.png", "48": "icon/logo-48.png"}, "default_title": "Default Popup Title", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://spenddy.fyi/*"], "js": ["content-scripts/spenddy.js"]}, {"matches": ["*://*.swiggy.com/*"], "js": ["content-scripts/swiggy.js"]}]}