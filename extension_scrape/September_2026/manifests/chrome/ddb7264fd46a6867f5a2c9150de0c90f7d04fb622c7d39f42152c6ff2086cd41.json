{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Championsys CRM Extension", "short_name": "Championsys CRM", "description": "Save LinkedIn profiles to your CRM instantly. Enrich contacts, track companies, and manage sales directly from LinkedIn.", "version": "2.3.0", "author": "Championsys", "homepage_url": "https://championsys.com", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabs", "sidePanel", "storage", "scripting", "identity", "webNavigation", "cookies"], "host_permissions": ["https://www.linkedin.com/*", "https://*.licdn.com/*", "https://firebasestorage.googleapis.com/*", "https://accounts.google.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "index.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_title": "Toggle Championsys CRM", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["logo_white.png", "logo_c.svg", "logo_web.png", "logo_white_new.png"], "matches": ["https://www.linkedin.com/*"]}]}