{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anonymous Snapchat Story Viewer - StoryKeek", "short_name": "StoryKeek", "version": "1.0.0", "description": "Watch public Snapchat stories anonymously. One button on any profile, plus the profile picture at full size. No login.", "homepage_url": "https://storykeek.com", "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["*://*.snapchat.com/*"], "content_scripts": [{"matches": ["*://*.snapchat.com/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle"}], "action": {"default_title": "Open on StoryKeek", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "omnibox": {"keyword": "keek"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+K"}, "description": "Open StoryKeek"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}