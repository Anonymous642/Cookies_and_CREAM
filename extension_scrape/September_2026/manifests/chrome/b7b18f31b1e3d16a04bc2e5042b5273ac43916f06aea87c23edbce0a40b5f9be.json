{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Timeout & Reopener", "version": "1.2", "description": "Snooze a tab and it will reopen automatically after the delay \u2014 even if Chrome or your laptop was closed.", "icons": {"32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["tabs", "alarms", "storage", "notifications", "favicon"], "background": {"service_worker": "service-worker.js"}, "commands": {"snooze-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Snooze the current tab"}}, "action": {"default_popup": "popup.html", "default_icon": {"32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}}