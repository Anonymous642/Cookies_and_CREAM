{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Text Highlighter", "version": "0.4.0", "description": "highlight text quickly", "icons": {"16": "icons/icon48.png", "48": "icons/icon48.png", "128": "icons/icon48.png"}, "permissions": ["storage", "activeTab", "offscreen", "clipboardRead"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon48.png", "32": "icons/icon48.png"}, "default_title": "Text Highlighter", "default_popup": "popup/popup.html"}, "commands": {"replace-words-from-clipboard": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Replace word list with text in clipboard"}, "add-words-from-clipboard": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "MacCtrl+Shift+O"}, "description": "Add text in clipboard to word list"}, "toggle-highlighting": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Toggle highlighting ON/OFF"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "all_frames": true, "run_at": "document_idle"}]}