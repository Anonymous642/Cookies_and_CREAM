{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteCat", "description": "Copy-paste like a human typing. For example, you can use it on Proxmox VE to copy-paste into VNC window in browser.", "version": "0.6", "action": {"default_popup": "pastecat.html", "default_icon": "pastecat.png"}, "permissions": ["storage", "clipboardRead", "activeTab"], "background": {"service_worker": "worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content-script.js"]}], "commands": {"paste-last": {"global": true, "suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Paste last added item (first in list)"}}}