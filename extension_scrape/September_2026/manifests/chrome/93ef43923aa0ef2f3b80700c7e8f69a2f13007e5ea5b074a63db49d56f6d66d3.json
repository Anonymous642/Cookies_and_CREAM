{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Detour", "description": "Switch HTTP, HTTPS, or SOCKS proxy profiles from your toolbar, with auto-switch rules, health checks, failover, auth, and bypass.", "version": "1.7.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["proxy", "storage", "alarms", "webRequest", "webRequestAuthProvider"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Detour", "default_popup": "popup.html"}, "commands": {"toggle-detour": {"description": "Toggle Detour on or off"}, "next-profile": {"description": "Switch to the next named profile"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}