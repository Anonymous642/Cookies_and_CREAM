{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LexiRise \u2014 Vocabulary Builder", "version": "2.7.2", "description": "Adapts to your level, highlights key words, and tracks your progress.", "action": {"default_title": "LexiRise", "default_popup": "popup.html", "default_icon": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}}, "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "identity"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://*.cloudfunctions.net/*", "https://*.googleapis.com/*", "https://firebasestorage.googleapis.com/*"], "optional_host_permissions": [], "background": {"service_worker": "sw.js"}, "web_accessible_resources": [{"resources": ["data/*", "grant.html", "grant.js", "panel.html", "panel.css", "panel_bridge.js", "popup.html", "popup.css", "popup.js", "LexiRise_LongIcon.png", "LexiRise_Short_50x36_Icon.png"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "commands": {"lex_add": {"description": "LexiRise: Add word (when card open)"}, "lex_known": {"description": "LexiRise: Mark word known (when card open)"}, "lex_next": {"description": "LexiRise: Next word (when card open)"}, "lex_prev": {"description": "LexiRise: Previous word (when card open)"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}