{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Minders Extension", "description": "Validates Braze campaign names and builds tracking URLs with UTMs. Built by MINDERS for naming consistency.", "version": "1.1", "manifest_version": 3, "permissions": ["storage", "scripting", "tabs", "activeTab", "sidePanel"], "host_permissions": ["https://*.braze.com/*", "https://*.bz-rndr.com/*", "https://app.getbee.io/*"], "action": {"default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}}, "side_panel": {"default_path": "index.html"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "./service-worker.js"}, "content_scripts": [{"matches": ["https://*.braze.com/*"], "js": ["./service-background-executor.js"]}, {"matches": ["https://app.getbee.io/*"], "js": ["./iframe-executor.js"], "all_frames": true}]}