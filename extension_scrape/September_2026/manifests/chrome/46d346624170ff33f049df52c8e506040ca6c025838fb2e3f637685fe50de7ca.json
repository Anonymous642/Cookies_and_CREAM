{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quiet Web", "description": "Hide Google AI Overviews for free, then use lenses to make search cleaner.", "version": "0.1.2", "permissions": ["storage", "activeTab"], "host_permissions": ["https://google.com/*", "https://www.google.com/*", "https://www.google.co.uk/*", "https://www.google.ca/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Quiet Web", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["https://google.com/search*", "https://www.google.com/search*", "https://www.google.co.uk/search*", "https://www.google.ca/search*"], "js": ["src/config.js", "src/storage.js", "src/rules.js", "src/content-google.js"], "css": ["styles/google.css"], "run_at": "document_start"}]}