{"update_url": "https://clients2.google.com/service/update2/crx", "version": "1.0.0.0", "manifest_version": 3, "description": "3D Street View extension provides quick Street View search. Click the extension icon to get Started.", "short_name": "3D Street View", "name": "3D Street View", "background": {"service_worker": "src/js/background.js"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["*.json"]}], "icons": {"128": "assets/image/3dstreetview-logo.png"}, "action": {"default_popup": "index.html"}, "permissions": ["storage"], "omnibox": {"keyword": "search"}, "host_permissions": ["*://3dstreetview.com/*"], "chrome_settings_overrides": {"search_provider": {"name": "Online", "keyword": "3DStreetView", "search_url": "https://3dstreetview.com/admin/public/link?q={searchTerms}", "suggest_url": "https://3dstreetview.com/admin/public/autosuggest?searchTerm={searchTerms}", "favicon_url": "https://3dstreetview.com/admin/public/favicon.ico", "encoding": "UTF-8", "is_default": true}}}