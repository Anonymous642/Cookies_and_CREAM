{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Full Page Video", "short_name": "YT Full Page", "version": "1.2", "description": "Expands YouTube videos to fill your entire browser window. Fully integrated in the player controls with Fit and Fill zoom modes.", "homepage_url": "https://github.com/", "background": {"service_worker": "background.js"}, "permissions": ["tabs", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YouTube Full Page Video", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-expand": {"suggested_key": {"default": "Alt+W", "windows": "Alt+W", "mac": "Alt+W", "linux": "Alt+W"}, "description": "Toggle video expand mode: Default \u2192 Fit to Window \u2192 Fill Window"}}, "author": "YT Full Page Video"}