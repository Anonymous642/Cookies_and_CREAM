{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marksave - X Bookmarks Importer", "version": "0.1.3", "description": "Import your own X bookmarks into your Marksave library, read-only. No X password, no API costs.", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.marksave.app/*", "https://marksave.app/*", "https://x.com/*", "https://twitter.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["interceptor.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Marksave", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}