{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Custodian: Auto-Clear Cookies, Cache & Permissions", "short_name": "Custodian", "version": "1.5.1", "description": "Auto-delete cookies, cache & permissions (camera, mic, location) when a site's last tab closes. Privacy cleaner with a whitelist.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Custodian", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["tabs", "webNavigation", "browsingData", "contentSettings", "storage", "alarms", "contextMenus", "cookies", "notifications", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "commands": {"wipe-current-site": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Wipe the current tab's site now"}}}