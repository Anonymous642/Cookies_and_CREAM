{"update_url": "https://clients2.google.com/service/update2/crx", "name": "DaClipp", "description": "Save, sync, and access your clipboard history across all your devices.", "version": "1.4.6", "permissions": ["storage", "tabs", "clipboardWrite", "clipboardRead", "contextMenus", "activeTab"], "manifest_version": 3, "host_permissions": ["https://daclipp.com/"], "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "commands": {"extension_copy": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Copy with extension"}, "extension_screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Screenshot with extension"}, "extension_paste": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Paste with extension"}}, "background": {"service_worker": "scripts/background.js", "type": "module"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["scripts/*", "popup/*", "assets/*"]}], "content_scripts": [{"js": ["scripts/content.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}