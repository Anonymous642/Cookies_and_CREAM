{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecordReach", "version": "1.0.5", "description": "Premium screen recording, canvas reframing, regional screenshots, and AI caption composer for social channels.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "src/options/options.html", "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Take regional screenshot"}, "start-recording": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Start screen recording"}}, "externally_connectable": {"matches": ["https://recordreach.pro/*", "https://app.recordreach.pro/*", "http://localhost/*", "http://127.0.0.1/*"]}, "content_scripts": [{"matches": ["https://recordreach.pro/*", "https://app.recordreach.pro/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["recordbar.js"]}], "web_accessible_resources": [{"resources": ["overlay.js", "recordbar.js", "recordreach-extension.css", "assets/*"], "matches": ["<all_urls>"]}]}