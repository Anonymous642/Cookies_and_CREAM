{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meeting Mode", "version": "1.0.0", "description": "Automatically mute or pause distracting tabs when you join Google Meet or Zoom calls", "permissions": ["tabs", "activeTab", "storage", "scripting", "notifications"], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.reddit.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Meeting Mode"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}