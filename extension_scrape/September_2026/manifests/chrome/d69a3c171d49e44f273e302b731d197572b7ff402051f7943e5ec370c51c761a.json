{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpeakFlow Translate", "version": "1.0.3", "description": "Translate & AI-dub any YouTube video: natural voices, 100+ languages, subtitle (SRT) export, AI summary.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "SpeakFlow Translate", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_page": "options.html", "permissions": ["storage", "activeTab", "unlimitedStorage"], "host_permissions": ["https://*.youtube.com/*", "https://api.speakflowlive.com/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["reader.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["subtitles.css"], "run_at": "document_idle"}, {"matches": ["https://api.speakflowlive.com/account*"], "js": ["acctsync.js"], "run_at": "document_idle"}]}