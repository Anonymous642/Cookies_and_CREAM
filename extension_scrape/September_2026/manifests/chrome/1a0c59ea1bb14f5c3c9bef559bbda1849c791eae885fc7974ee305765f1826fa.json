{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Baby Photo Reminder", "version": "1.1.1", "description": "Display your baby photos periodically in the browser | \u5927\u5207\u306a\u601d\u3044\u51fa\u3092\u5b9a\u671f\u7684\u306b\u8868\u793a", "permissions": ["storage", "unlimitedStorage", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "index.html", "default_icon": "icon.png"}, "options_page": "options.html", "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"]}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}