{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Hearthstone Deck Overlay", "description": "Detect Hearthstone decks in YouTube descriptions and show a draggable card overlay.", "version": "0.2.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "YouTube Hearthstone Deck Overlay", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://hsreplay.net/*", "https://api.hearthstonejson.com/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}