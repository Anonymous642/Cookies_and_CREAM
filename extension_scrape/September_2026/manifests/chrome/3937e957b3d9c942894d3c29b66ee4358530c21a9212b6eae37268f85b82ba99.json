{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whisper Library - Meeting Transcriber", "version": "1.0.0", "description": "Detect online meetings (Google Meet, Teams, Zoom) and transcribe them with Whisper Library. Private, in-browser AI.", "permissions": ["storage", "tabs", "scripting", "cookies"], "host_permissions": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/*", "https://whisperlibrary.up.railway.app/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/j/*", "https://*.zoom.us/wc/*"], "js": ["content-scripts/meeting-detector.js"], "css": ["content-scripts/styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}