{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScanShield\u2122 \u2013 TikTok Shop Compliance Scanner", "version": "3.3.0", "description": "Real-time compliance scanning for TikTok Shop listings. Catches policy violations before they become suspensions.", "permissions": ["storage", "activeTab", "tabs", "scripting", "contextMenus"], "host_permissions": ["*://*.tiktok.com/*", "*://*.tiktokglobalshop.com/*", "*://*.tiktokshop.com/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.shopify.com/*", "*://*.myshopify.com/*", "*://*.etsy.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://seller-us.tiktok.com/*", "*://seller-uk.tiktok.com/*", "*://seller.tiktok.com/*", "*://seller.tiktokglobalshop.com/*", "*://partner.tiktokshop.com/*", "*://shop.tiktok.com/*", "*://affiliate.tiktok.com/*", "*://affiliate-us.tiktok.com/*", "*://seller-us-accounts.tiktok.com/*", "*://sellercentral.amazon.com/*", "*://sellercentral.amazon.co.uk/*", "*://sellercentral.amazon.de/*", "*://sellercentral.amazon.ca/*", "*://sellercentral.amazon.com.au/*", "*://www.amazon.com/*", "*://www.amazon.co.uk/*", "*://www.amazon.de/*", "*://www.amazon.ca/*", "*://www.amazon.com.au/*", "*://admin.shopify.com/*", "*://*.myshopify.com/admin/products/*", "*://www.etsy.com/your/shops/*", "*://www.etsy.com/listing/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://thescanshield.com/*", "https://*.thescanshield.com/*", "https://shopguardtest-w58ayttj.manus.space/*", "https://*.manus.space/*", "https://*.manus.computer/*"]}, "commands": {"trigger