{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gleanit", "version": "1.2.0", "description": "Capture, retrieve, and use anything on the internet; Also see what you captured on that live page when you need to.", "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "activeTab", "cookies", "tabs", "alarms", "scripting"], "host_permissions": ["<all_urls>", "https://gleanit.co/*", "https://api.gleanit.co/*", "http://localhost:5173/*", "http://localhost:3001/*"], "web_accessible_resources": [{"resources": ["fonts/*.woff2", "site-*.js"], "matches": ["<all_urls>"]}], "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}