{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Hyperlink from selected text", "version": "1.3.1", "manifest_version": 3, "description": "Creates a hyperlink to the current page from the selected text in one click via the context (right click) menu", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "service_worker.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.google-analytics.com;"}, "permissions": ["contextMenus", "activeTab", "storage"], "host_permissions": ["https://www.google-analytics.com/*"]}