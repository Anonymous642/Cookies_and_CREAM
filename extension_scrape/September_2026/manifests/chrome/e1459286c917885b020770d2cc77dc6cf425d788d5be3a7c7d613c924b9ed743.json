{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mimfold: Tweet & Reddit Downloader \u2014 Save X Videos, Images & Posts to Phone", "version": "1.2.5", "description": "Twitter video downloader + Reddit saver. Download tweets, X videos, Reddit posts & images to your phone library. One click.", "author": "Mimfold", "homepage_url": "https://mimfold.com", "icons": {"16": "assets/extension_icon-16.png", "32": "assets/extension_icon-32.png", "48": "assets/extension_icon-48.png", "128": "assets/extension_icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://reddit.com/*", "https://*.reddit.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://us-central1-memedia-vault.cloudfunctions.net/*"], "background": {"service_worker": "src/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://reddit.com/*", "https://*.reddit.com/*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "action": {"default_title": "Mimfold Saver", "default_popup": "popup.html", "default_icon": {"16": "assets/extension_icon-16.png", "32": "assets/extension_icon-32.png", "48": "assets/extension_icon-48.png", "128": "assets/extension_icon-128.png"}}, "web_accessible_resources": [{"resources": ["assets/extension_icon-128.png"], "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://reddit.com/*", "https://*.reddit.com/*"]}]}