{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VideoM8 - Screen Recorder & Screenshot", "version": "1.18.20", "description": "Record your screen and camera or capture annotated screenshots from any tab.", "minimum_chrome_version": "116", "permissions": ["tabs", "activeTab", "alarms", "clipboardWrite", "contextMenus", "desktopCapture", "notifications", "offscreen", "scripting", "tabCapture", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://videom8.com/*", "https://www.videom8.com/*", "https://microsite.com.au/*", "https://www.microsite.com.au/*"]}, "background": {"service_worker": "background.js"}, "storage": {"managed_schema": "managed_schema.json"}, "action": {"default_title": "Record with microsite", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"open-recorder": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open or focus the VideoM8 Recorder"}, "screenshot-region": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture a region screenshot of this tab"}, "toggle-pause-recording": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause or resume the active recording"}, "restart-recording": {"description": "Restart the active recording"}}, "web_accessible_resources": [{"resources": ["camera-bubble.html", "recorder-product-contract.json"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["https://videom8.com/record*"], "js": ["recorder-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://videom8.com/ideas*"], "js": ["ideas-capture.js"], "run_at": "document_idle"}, {"matches": ["https://videom8.com/publishing*"], "js": ["publishing-capture.js"], "run_at": "document_idle"}]}