{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZipFields Auto-Fill", "version": "1.0", "description": "Automatically fill government forms using your ZipFields profile.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://services.ontario.ca/*", "https://cxp.mgcs.gov.on.ca/*", "https://www.canada.ca/*", "https://www.ontario.ca/*", "https://zipfields.com/*", "https://www.zipfields.com/*"], "action": {"default_popup": "popup.html", "default_title": "ZipFields"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://zipfields.com/*", "https://www.zipfields.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}