{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cipher BSK Password Manager", "author": "Sazzad Saju", "version": "1.0", "description": "Lightweight password manager using Cipher-BSK\u2019s open-source encryption. Local multilayer encryption; no plaintext stored.", "icons": {"16": "img/bsk_icon.png", "48": "img/bsk_icon.png", "128": "img/bsk_icon.png"}, "background": {"service_worker": "js/background.js"}, "permissions": ["storage", "clipboardWrite", "identity"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "img/bsk_icon.png", "48": "img/bsk_icon.png", "128": "img/bsk_icon.png"}}, "web_accessible_resources": [{"resources": ["img/*"], "matches": ["<all_urls>"]}]}