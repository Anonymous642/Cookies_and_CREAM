{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nudge \u2014 Short-Form Video Check-In", "version": "1.0.0", "description": "A friendly animated mascot pops up every few YouTube Shorts or TikToks to ask if you meant to keep scrolling this long.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.tiktok.com/*"], "action": {"default_title": "Nudge", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/shorts/*"], "js": ["lib/mascot.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/foryou*", "https://www.tiktok.com/following*", "https://www.tiktok.com/"], "js": ["lib/mascot.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}