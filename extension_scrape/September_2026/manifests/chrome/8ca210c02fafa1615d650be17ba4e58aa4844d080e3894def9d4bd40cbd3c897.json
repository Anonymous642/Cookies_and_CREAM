{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shopify Collab Request", "version": "1.2.0", "description": "Request Shopify collaborator access faster with saved profiles, codes, backups, and Partner Dashboard links.", "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardRead", "clipboardWrite", "contextMenus"], "host_permissions": ["https://partners.shopify.com/*", "https://dev.shopify.com/*", "https://vlgodkxyxzkxmitqawfg.supabase.co/*"], "action": {"default_title": "Shopify Collab Request", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://partners.shopify.com/*/stores/new*", "https://dev.shopify.com/dashboard/*/stores/collaborations/new*", "https://dev.shopify.com/dashboard/*/stores*", "https://partners.shopify.com/*/stores*"], "js": ["config.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-floating-panel": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}, "description": "Open Shopify Collab Request floating panel"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}