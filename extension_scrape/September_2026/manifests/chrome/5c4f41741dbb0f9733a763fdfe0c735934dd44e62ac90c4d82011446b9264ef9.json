{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Falando \u2013 Learn Brazilian Portuguese", "description": "Companion extension for Falando.app. Discover new vocabulary while browsing the internet and import content to Falando.", "version": "0.2.0", "short_name": "Falando", "minimum_chrome_version": "114", "action": {"default_popup": "popup.html", "default_title": "Falando", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies"], "host_permissions": ["https://falando.app/*", "https://www.falando.app/*", "https://*.falando.app/*", "https://*.youtube.com/*", "https://youtu.be/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://youtu.be/*"], "js": ["youtube.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["assets/add.svg", "assets/crown.svg", "assets/icon_white.png"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "options.html", "homepage_url": "https://falando.app", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Falando extension popup"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://falando.app https://*.falando.app"}}