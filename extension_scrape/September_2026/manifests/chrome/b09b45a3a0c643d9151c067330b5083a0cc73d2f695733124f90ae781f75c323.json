{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tab Drive", "description": "Clearly see all your tabs, no matter how many you have open.", "version": "1.0", "manifest_version": 3, "icons": {"16": "icons/default-icon-6.png", "48": "icons/default-icon-6.png", "128": "icons/default-icon-6.png"}, "action": {"default_icon": {"16": "icons/enabled-icon-3.png", "48": "icons/enabled-icon-3.png", "128": "icons/enabled-icon-3.png"}}, "permissions": ["activeTab", "tabs", "scripting", "storage", "windows"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}