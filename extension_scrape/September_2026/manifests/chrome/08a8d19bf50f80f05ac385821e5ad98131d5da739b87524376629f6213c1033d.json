{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TuckShelf - Save Links", "version": "1.2.0", "description": "Save the current page to your TuckShelf collection", "permissions": ["activeTab", "storage", "scripting", "tabs", "notifications", "contextMenus"], "host_permissions": ["https://app.tuckshelf.com/*", "https://tuckshelf.com/*", "https://www.tuckshelf.com/*"], "action": {"default_popup": "popup.html", "default_title": "Save to TuckShelf"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}