{"update_url": "https://clients2.google.com/service/update2/crx", "key": "", "manifest_version": 3, "name": "VocaView - Multi-language Subtitles", "version": "2.4.4", "description": "Learn languages by watching YouTube with dual-language subtitles and instant AI-powered word analysis.", "author": "VocaView Team", "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "youtube_inner_tube_headers", "enabled": true, "path": "youtube-request-rules.json"}]}, "host_permissions": ["https://*.youtube.com/*", "https://translate.googleapis.com/*", "https://vocaview.com/*", "https://*.vocaview.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://vocaview.com/*", "https://*.vocaview.com/*", "http://localhost:4173/*", "http://127.0.0.1:4173/*"], "js": ["vocaview-auth.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "css": ["content.css"], "js": ["supabase.min.js", "config.js", "analytics.js", "content.js"]}], "web_accessible_resources": [{"resources": ["fonts/*.ttf"], "matches": ["https://www.youtube.com/*"]}], "externally_connectable": {"matches": ["https://vocaview.com/*", "https://*.vocaview.com/*", "http://localhost:5173/*", "http://localhost:4173/*", "http://127.0.0.1:4173/*"]}}