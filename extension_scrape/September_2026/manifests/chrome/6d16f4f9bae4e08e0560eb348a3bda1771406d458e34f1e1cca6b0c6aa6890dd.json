{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fantasy Foundry ESPN Connect Helper", "version": "0.1.1", "minimum_chrome_version": "102", "description": "Connect private ESPN fantasy baseball leagues to Fantasy Foundry without copying cookies by hand.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Connect ESPN to Fantasy Foundry", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["cookies", "storage", "tabs"], "host_permissions": ["http://espn.com/*", "http://*.espn.com/*", "https://espn.com/*", "https://*.espn.com/*", "https://fantasy-foundry.com/*"], "content_scripts": [{"matches": ["https://fantasy-foundry.com/*"], "js": ["src/content-script.js"], "run_at": "document_start"}]}