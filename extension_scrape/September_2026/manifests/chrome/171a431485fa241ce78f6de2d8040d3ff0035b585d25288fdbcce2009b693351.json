{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smatchup", "version": "0.7.4", "description": "Synchronise les inscrits entre une \u00e9preuve Moja (FFT) et un tournoi Smatchup, dans les deux sens.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://moja.fft.fr/*", "https://apim.fft.fr/*", "https://smatchup.fr/*", "https://smatchup.vitevu.com/*", "http://localhost:3017/*", "http://localhost:3018/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://moja.fft.fr/moja/*"], "js": ["src/content/moja-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://moja.fft.fr/moja/*"], "js": ["src/content/moja.js", "src/content/moja-bubble.js"], "run_at": "document_idle"}, {"matches": ["https://smatchup.fr/*", "https://smatchup.vitevu.com/*", "http://localhost:3018/*"], "js": ["src/content/smatchup-bridge.js"], "run_at": "document_idle"}], "action": {"default_title": "Smatchup", "default_popup": "src/popup/popup.html"}, "web_accessible_resources": [{"resources": ["src/content/moja-inject.js"], "matches": ["https://moja.fft.fr/*"]}]}