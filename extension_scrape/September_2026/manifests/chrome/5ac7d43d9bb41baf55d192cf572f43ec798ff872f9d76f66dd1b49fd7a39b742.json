{"update_url": "https://clients2.google.com/service/update2/crx", "name": "FocusGuard \u2013 Social Media Time Limiter", "version": "1.0.0", "description": "Set daily time limits for Facebook, Instagram, YouTube, Reddit & Netflix. Blurs the page when your time is up.", "manifest_version": 3, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.instagram.com/*", "https://*.reddit.com/*", "https://*.netflix.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"run_at": "document_idle", "matches": ["https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.instagram.com/*", "https://*.reddit.com/*", "https://*.netflix.com/*"], "js": ["content.js"], "css": ["styles/content.css"]}], "action": {"default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_popup": "popup.html"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}}