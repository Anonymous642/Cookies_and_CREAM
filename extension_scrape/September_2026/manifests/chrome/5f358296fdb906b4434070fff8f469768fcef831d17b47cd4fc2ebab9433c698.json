{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickSOP - SOP Recorder", "version": "1.0.1", "description": "Record any process and create step-by-step SOPs automatically. Capture clicks, screenshots, and form interactions.", "homepage_url": "https://quicksop.com", "minimum_chrome_version": "102", "permissions": ["activeTab", "tabs", "storage", "scripting", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["sidepanel.html", "sidepanel.js", "vendor.js"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://quicksop.com/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}