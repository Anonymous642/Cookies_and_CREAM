{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VantaFocus - Reclaim your time. Block distractions", "version": "0.1.0", "description": "VantaFocus Companion Extension. Blocks distracting sites during active focus sessions.", "permissions": ["declarativeNetRequest", "storage", "offscreen", "tabs", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "VantaFocus", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16-off.png", "32": "icons/icon-32-off.png", "48": "icons/icon-48-off.png", "128": "icons/icon-128-off.png"}}, "icons": {"16": "icons/icon-16-off.png", "32": "icons/icon-32-off.png", "48": "icons/icon-48-off.png", "128": "icons/icon-128-off.png"}, "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js", "blocked.html"], "matches": ["<all_urls>"]}]}