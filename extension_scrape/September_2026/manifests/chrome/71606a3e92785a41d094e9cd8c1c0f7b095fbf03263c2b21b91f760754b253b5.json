{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "dealsbot feeder", "version": "0.1.0", "description": "Extracts product/deal data from pages you browse and pushes it to your local dealsbot ingest endpoint (run: python run.py serve).", "author": "dealsbot", "homepage_url": "https://fdrstrok.github.io/dealsbot-web/", "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "dealsbot feeder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "optional_host_permissions": ["https://shop.lululemon.com/*", "https://www.fanatics.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://shop.lululemon.com/*", "https://www.fanatics.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "dealsbot-feeder@dealsbot.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}