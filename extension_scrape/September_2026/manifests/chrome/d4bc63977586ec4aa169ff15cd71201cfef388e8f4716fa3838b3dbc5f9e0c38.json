{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shorts Blocker", "version": "1.3", "description": "Blocks short-form video content on YouTube, Instagram, TikTok, and more.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "css": ["blocker.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'"}}