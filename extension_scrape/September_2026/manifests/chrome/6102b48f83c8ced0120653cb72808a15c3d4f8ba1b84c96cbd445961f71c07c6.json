{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipt Legacy", "version": "2.2.4", "description": "Create clips from YouTube, Twitter/X, Instagram, and TikTok. Browser-based processing.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "notifications", "tabs", "cookies", "unlimitedStorage"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.clipt.cc/*", "*://clipt.cc/*", "http://localhost/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.clipt.cc/*", "*://clipt.cc/*", "http://localhost/*"], "js": ["src/content.js"], "run_at": "document_end"}], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["src/videoTitleExtractor.js"], "matches": ["<all_urls>"]}]}