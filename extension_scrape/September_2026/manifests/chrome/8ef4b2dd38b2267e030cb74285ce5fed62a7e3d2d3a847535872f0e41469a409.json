{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fokus f\u00fcr YouTube", "version": "1.8.0", "description": "Blockiert Musik- und Unterhaltungsinhalte auf YouTube und schenkt dir einen Moment der Achtsamkeit, bevor Zeit verloren geht.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/defaults.js", "src/filter-engine.js", "src/content.js"], "css": ["src/overlay.css"], "run_at": "document_start"}]}