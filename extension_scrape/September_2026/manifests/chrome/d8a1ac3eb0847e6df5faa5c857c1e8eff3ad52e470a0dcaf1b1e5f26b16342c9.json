{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Icons for GitHub", "version": "1.0.0", "description": "Replaces GitHub\u2019s default file icons with custom Design SVG icons for clearer repository browsing.", "icons": {"16": "icons/material_icon.png", "48": "icons/material_icon.png", "128": "icons/material_icon.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Icons for GitHub Settings"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_end", "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["icons/*.svg"], "matches": ["https://github.com/*"]}]}