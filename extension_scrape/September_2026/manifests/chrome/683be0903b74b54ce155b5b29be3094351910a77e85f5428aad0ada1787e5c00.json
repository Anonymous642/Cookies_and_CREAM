{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopyKeywords - Copy Google Search Suggestions", "version": "1.2.0", "description": "Copy Google search keywords and suggestions with Alt+C hotkey or right-click menu", "permissions": ["activeTab", "scripting", "notifications", "clipboardWrite", "contextMenus", "storage", "tabs"], "host_permissions": ["https://www.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/*"], "js": ["content.js", "pick-keywords.js"], "css": ["pick-keywords.css"]}], "web_accessible_resources": [{"resources": ["pick-keywords.css"], "matches": ["https://www.google.com/*"]}], "action": {"default_popup": "", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"copy-search-query": {"suggested_key": {"default": "Alt+C"}, "description": "Copy Google search keywords"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}