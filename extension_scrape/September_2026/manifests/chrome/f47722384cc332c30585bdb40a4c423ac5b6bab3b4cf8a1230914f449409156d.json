{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GPT-Hotkeys", "version": "1.3", "manifest_version": 3, "description": "Various hotkeys for ChatGPT and Claude, including editing, sending, and canceling messages.", "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*"], "icons": {"16": "icons/icon128.png", "32": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon128.png", "32": "icons/icon128.png", "48": "icons/icon128.png"}}, "commands": {"gpt-quickedit": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Jump to nearest edit prompt"}, "gpt-quickinsert": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Jump to search bar"}, "gpt-quicksend": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Send edited message"}, "gpt-quickcancel": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Cancel generating response"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*"], "js": ["choosemodel.js"], "run_at": "document_idle"}]}