{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DOM Lens", "version": "1.0.0", "description": "The fastest and simplest visual DOM inspector. Instantly inspect any webpage without opening DevTools.", "permissions": ["activeTab", "storage", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "DOM Lens"}, "commands": {"toggle-dom-lens": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle DOM Lens on the active tab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles/overlay.css", "styles/tooltip.css"], "matches": ["<all_urls>"]}]}