{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpongeAI Capture", "version": "0.1.6", "description": "Capture the current tab and send to SpongeAI under your selected topic with an optional prompt.", "action": {"default_popup": "popup.html", "default_title": "SpongeAI Capture"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabs", "activeTab", "storage", "contextMenus", "commands", "scripting"], "host_permissions": ["https://www.spongeai.app/*", "https://spongeai.app/*"], "commands": {"capture-and-send": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K", "windows": "Ctrl+Shift+K", "chromeos": "Ctrl+Shift+K", "linux": "Ctrl+Shift+K"}, "description": "Capture the current tab and upload to SpongeAI"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}