{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess Eval Extension", "version": "1.1", "description": "Real-time chess position evaluation on chess.com", "icons": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["*://*.chess.com/*"], "js": ["content.js"], "css": ["content-styles.css"], "type": "module"}], "action": {"default_title": "Chess Eval", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "web_accessible_resources": [{"resources": ["stockfish/*"], "matches": ["*://*.chess.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}