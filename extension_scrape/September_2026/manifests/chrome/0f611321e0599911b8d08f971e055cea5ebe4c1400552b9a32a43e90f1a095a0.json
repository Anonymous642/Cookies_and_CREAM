{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nope - One-Click Not Interested for YouTube", "description": "One-click 'Not interested' for your YouTube feed \u2014 dismiss a video, or suppress a whole channel, without opening the menu.", "version": "1.0.1", "short_name": "Nope", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Not interested \u2014 settings", "default_popup": "popup.html"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}