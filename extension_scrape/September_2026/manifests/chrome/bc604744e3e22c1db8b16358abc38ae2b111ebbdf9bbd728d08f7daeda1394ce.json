{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aloud", "version": "1.0.1", "description": "Reads selected text or whole pages aloud in natural voices using your Google or OpenAI key. Screen-reader and keyboard friendly.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "offscreen"], "host_permissions": ["https://texttospeech.googleapis.com/*", "https://api.openai.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Aloud \u2014 read text aloud"}, "options_page": "options.html", "commands": {"read-selection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Read the selected text aloud"}, "stop-playback": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Stop reading"}}}