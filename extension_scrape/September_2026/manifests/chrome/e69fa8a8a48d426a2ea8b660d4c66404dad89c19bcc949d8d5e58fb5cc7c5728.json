{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts Manager", "version": "1.2.1", "description": "Shows the number of Shorts viewed, and the time spent. It also allows you to set limits and warns you when you go over them.", "permissions": ["storage", "notifications"], "background": {"service_worker": "service_worker.js"}, "action": {"default_popup": "popup.html", "default_title": "YouTube Shorts Counter"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}