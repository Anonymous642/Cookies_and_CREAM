{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Sidebar Tracker", "version": "0.1.0", "description": "Reddit sidebar: track viewed/unread & usage, foldered bookmarks, sub/keyword filters, smart capture with sensitive masking.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "permissions": ["sidePanel", "storage", "tabs", "activeTab", "contextMenus", "downloads", "clipboardWrite", "alarms"], "host_permissions": ["https://*.reddit.com/*", "<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.reddit.com/*"]}], "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["content/redditTracker.js", "content/capture.js", "content/filters.js"], "run_at": "document_idle"}], "action": {"default_title": "Reddit Sidebar Tracker", "default_icon": {"16": "icons/action-16.png", "32": "icons/action-32.png", "64": "icons/action-64.png", "128": "icons/action-128.png"}}}