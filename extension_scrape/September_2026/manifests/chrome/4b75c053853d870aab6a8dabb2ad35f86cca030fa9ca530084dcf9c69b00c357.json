{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Hoasted Check", "description": "Shows an blue cloud in the omnibar when you are browsing a site that is hosted on Hoasted", "version": "2.0.2", "manifest_version": 3, "icons": {"128": "images/orange-cloud-128.png"}, "permissions": ["webNavigation", "webRequest"], "host_permissions": ["http://*/", "https://*/"], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Hoasted"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentscript.js"], "run_at": "document_start"}], "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}