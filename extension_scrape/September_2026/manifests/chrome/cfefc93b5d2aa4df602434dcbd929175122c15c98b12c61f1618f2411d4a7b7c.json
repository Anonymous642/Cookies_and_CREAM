{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Video Speed Control", "description": "Control the speed of X videos with the keyboard shortcuts \"< (SHIFT+,)\" and \"> (SHIFT+.)\" just like on YouTube", "version": "0.3.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage"], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "X Video Speed Control", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}