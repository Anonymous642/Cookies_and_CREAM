{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kudos Companion", "version": "1.0.0", "author": "Ryan Jacobs", "description": "Auto-kudos Strava activities and get notifications for significant achievements. Privacy-first, no analytics, open-source.", "homepage_url": "https://github.com/rmjacobs/strava-browser-extension", "minimum_chrome_version": "120", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.strava.com/*", "https://api.pushover.net/*", "https://discord.com/api/webhooks/*", "https://hooks.slack.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.strava.com/dashboard*"], "js": ["utils/debug-logger.js", "utils/storage.js", "utils/activity-parser.js", "utils/rule-engine.js", "content-scripts/feed-monitor.js", "content-scripts/auto-kudos.js", "content-scripts/ui-enhancer.js"], "css": ["content-scripts/styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}