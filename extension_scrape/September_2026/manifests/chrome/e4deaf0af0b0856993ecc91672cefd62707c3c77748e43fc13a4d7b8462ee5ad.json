{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Custom Google Logo", "version": "2.0.0", "description": "Replace the Google logo with your own custom text or image. Works on every regional Google domain and survives doodle days.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.co.in/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.com.br/*", "*://www.google.co.jp/*", "*://www.google.com.mx/*"], "action": {"default_popup": "popup.html", "default_icon": "images/default_logo.png"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png", "256": "images/default_logo.png", "512": "images/icon512.png"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "commands": {"toggle-custom-logo": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle the custom Google logo on or off"}}, "content_scripts": [{"matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.co.in/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.com.br/*", "*://www.google.co.jp/*", "*://www.google.com.mx/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}