{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReceiptsLab - Receipt Sync", "version": "1.1.0", "description": "Sync your retail receipts to ReceiptsLab for spending analytics. Currently supports Costco (warehouse, online, gas).", "homepage_url": "https://receiptslab.com", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.costco.com/*", "https://www.costco.ca/*", "https://receiptslab.com/*"], "optional_host_permissions": ["https://amazon.com/*", "https://www.amazon.com/*", "https://target.com/*", "https://api.target.com/*"], "externally_connectable": {"matches": ["https://receiptslab.com/*", "http://localhost:3000/*"]}, "content_scripts": [{"matches": ["https://www.costco.com/*", "https://www.costco.ca/*"], "js": ["content-scripts/costco-token-capture.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "ReceiptsLab Sync", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}