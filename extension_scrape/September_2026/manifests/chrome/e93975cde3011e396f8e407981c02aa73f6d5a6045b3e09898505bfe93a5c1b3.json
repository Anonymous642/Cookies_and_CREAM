{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MojiScrub", "description": "Productivity extension that removes distracting emojis from web text while preserving useful symbols.", "version": "1.0.0", "permissions": ["storage", "contextMenus", "tabs"], "background": {"service_worker": "background.js"}, "action": {"default_title": "MojiScrub", "default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "commands": {"toggle-mojiscrub": {"description": "Toggle MojiScrub on current site", "suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}