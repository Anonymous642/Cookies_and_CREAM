{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Claude Model Watcher", "version": "1.0.0", "description": "Discreet banner showing the active Claude model on claude.ai, to avoid wasting tokens on a heavier model.", "author": "Vivien Tedesco", "homepage_url": "https://www.linkedin.com/in/vivientedesco/", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://claude.ai/*"], "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}