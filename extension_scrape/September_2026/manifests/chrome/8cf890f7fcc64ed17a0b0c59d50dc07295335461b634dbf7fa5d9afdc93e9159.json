{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sftir \u2014 Save & Analyze Videos with AI", "description": "Save videos from TikTok, Instagram, YouTube, X, and LinkedIn. Sftir transcribes, categorizes, and extracts action items.", "version": "1.2.0", "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.youtube.com/*", "https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*", "https://*.linkedin.com/*", "https://xrutwtepadkdehsvfcso.supabase.co/*", "https://app.sftir.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.youtube.com/*", "https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*", "https://*.linkedin.com/*"], "js": ["icons.js", "content.js"], "css": ["content.css"]}, {"matches": ["https://*.tiktok.com/*"], "js": ["extractor.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://app.sftir.com/auth/extension*"], "js": ["auth-listener.js"]}], "background": {"service_worker": "background.js"}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["extractor.js"], "matches": ["https://*.tiktok.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-video": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current video to Sftir"}}}