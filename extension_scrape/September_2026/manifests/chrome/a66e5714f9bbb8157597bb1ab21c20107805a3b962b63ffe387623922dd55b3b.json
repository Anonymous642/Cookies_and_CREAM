{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Click-to-Block Element Blocker", "version": "2.0.0", "description": "Point and click to hide pop-ups, banners and clutter on any website. Stays hidden on every visit. Restore anytime.", "minimum_chrome_version": "111", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Click-to-Block", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared.js", "content.js"], "run_at": "document_start"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"start-picker": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Pick an element to hide on the current page"}}}