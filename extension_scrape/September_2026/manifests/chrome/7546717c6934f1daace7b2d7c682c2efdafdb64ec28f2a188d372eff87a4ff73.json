{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SideWire", "version": "0.5.0", "description": "AI side panel for Claude, ChatGPT, Perplexity, Gemini, and on-device Local. Capture screens, tabs, regions; save reusable prompts.", "icons": {"16": "public/icon16.png", "32": "public/icon32.png", "48": "public/icon48.png", "128": "public/icon128.png"}, "permissions": ["desktopCapture", "sidePanel", "clipboardWrite", "tabs", "scripting", "storage", "offscreen", "contextMenus", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://claude.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/main.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "SideWire", "default_icon": {"16": "public/icon16.png", "32": "public/icon32.png", "48": "public/icon48.png", "128": "public/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://claude.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*"], "js": ["content/unframe.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://claude.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*"], "js": ["content/paste.bundle.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://claude.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*"], "js": ["content/widget.bundle.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"capture-screen": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture screen or window into the active AI chat"}, "capture-tab": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Capture the visible tab into the active AI chat"}, "open-prompts": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open saved prompts"}, "toggle-widget": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Show/hide the floating capture widget"}, "capture-region": {"description": "Capture a screen region into the active AI chat"}}, "declarative_net_request": {"rule_resources": [{"id": "embed_rules", "enabled": true, "path": "rules.json"}]}}