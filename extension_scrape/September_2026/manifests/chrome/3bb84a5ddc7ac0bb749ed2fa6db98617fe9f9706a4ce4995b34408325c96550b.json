{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fillio - Autofill google forms", "version": "2.0.2", "description": "A chrome extension to autofill repetitive google forms in seconds.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://docs.google.com/forms/*"], "action": {"default_popup": "index.html", "default_title": "Fillio - Autofill google forms"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/forms/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Fillio - Autofill google forms extension"}}}