{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "My-Snippets - Text Snippets and Expander", "short_name": "My-Snippets", "version": "1.0.2", "description": "Save reusable text once and insert it anywhere. Type / to pick a snippet, or a shortcut to expand it in place. Private and local.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "alarms", "contextMenus", "clipboardRead"], "host_permissions": ["https://fondationdtm.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/expander.js"], "css": ["src/content/expander.css"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "src/popup/popup.html", "default_title": "My-Snippets"}, "commands": {"open-library": {"suggested_key": {"default": "Ctrl+Shift+U", "windows": "Ctrl+Shift+U"}, "description": "Open the My-Snippets library"}}}