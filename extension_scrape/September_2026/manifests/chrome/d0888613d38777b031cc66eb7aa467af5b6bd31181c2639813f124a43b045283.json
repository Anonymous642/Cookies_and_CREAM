{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cyberbrain URL Saver", "version": "0.3.3", "description": "Save URLs to your Cyberbrain system with one click", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://app-tachikoma.cyberbrain.sh/*", "https://app.cyberbrain.sh/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.cyberbrain.sh/*"], "js": ["inject.js"], "run_at": "document_idle"}]}