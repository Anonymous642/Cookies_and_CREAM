{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextLens - AI word & Text Explainer for any Webpage or PDF", "description": "Highlight text on any page and get instant AI explanation, example and context. Free. No API Key. Works on PDFs too.", "version": "1.1.3", "permissions": ["webRequest", "webNavigation"], "host_permissions": ["https://contextlens-backend-api.vercel.app/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "ContextLens", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "match_origin_as_fallback": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["viewer/*", "viewer/web/*", "viewer/web/images/*", "viewer/build/*", "viewer/cmaps/*", "viewer/standard_fonts/*", "viewer/wasm/*"], "matches": ["http://*/*", "https://*/*"]}]}