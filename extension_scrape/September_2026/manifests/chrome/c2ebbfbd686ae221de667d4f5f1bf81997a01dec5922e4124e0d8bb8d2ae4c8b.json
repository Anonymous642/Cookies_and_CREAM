{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Conversation Exporter for ChatGPT", "version": "1.0.0", "description": "Save complete ChatGPT conversations as filtered PDF, Markdown, HTML, or JSON files.", "minimum_chrome_version": "148", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Save this conversation", "default_popup": "popup/popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Conversation Exporter for ChatGPT"}}, "background": {"service_worker": "service-worker.js"}, "permissions": ["storage", "downloads"], "options_page": "options/options.html", "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["settings.js", "content.js"], "run_at": "document_idle"}]}