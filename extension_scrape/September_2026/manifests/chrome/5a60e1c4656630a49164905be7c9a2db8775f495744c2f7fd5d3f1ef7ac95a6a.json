{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WindowFrameOverlay", "version": "1.9", "description": "Applies a realistic window-frame overlay to fullscreen YouTube. Drag, resize, upload custom frames.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "downloads", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["frame.png"], "matches": ["*://*.youtube.com/*"]}]}