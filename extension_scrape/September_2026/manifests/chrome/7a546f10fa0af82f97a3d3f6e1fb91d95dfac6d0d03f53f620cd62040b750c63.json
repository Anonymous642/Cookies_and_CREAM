{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Hover Reader", "description": "AI summaries of news articles when you hover a link.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "permissions", "scripting"], "optional_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Smart Hover Reader", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}