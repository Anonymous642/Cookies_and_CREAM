{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProseWrite Meeting Recorder", "version": "2.1.0", "description": "Record Google Meet, Microsoft Teams, and Zoom sessions and send them to ProseWrite for transcription.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabCapture", "scripting", "storage", "activeTab", "offscreen", "downloads", "tabs", "unlimitedStorage", "alarms"], "host_permissions": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://zoom.us/*", "https://app.zoom.us/*", "https://api.prosewrite.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "ProseWrite Recorder"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://zoom.us/*", "https://app.zoom.us/*"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://prosewrite.com/*", "https://*.prosewrite.com/*"]}}