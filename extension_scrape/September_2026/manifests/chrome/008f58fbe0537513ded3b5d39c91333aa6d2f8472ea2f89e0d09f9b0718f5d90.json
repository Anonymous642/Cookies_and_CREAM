{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meeting Countdown Timer", "short_name": "Countdown", "version": "1.2.0", "description": "A minimal floating countdown for Google Meet and Zoom. Detects the end time, warns before it, then counts overtime.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://*.zoom.com/*"], "action": {"default_title": "Meeting Countdown Timer", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "background": {"service_worker": "src/background/sw.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://*.zoom.com/*"], "js": ["src/lib/defaults.js", "src/lib/format.js", "src/lib/storage.js", "src/content/detector.js", "src/content/overlay.js", "src/content/main.js"], "run_at": "document_idle", "all_frames": false}]}