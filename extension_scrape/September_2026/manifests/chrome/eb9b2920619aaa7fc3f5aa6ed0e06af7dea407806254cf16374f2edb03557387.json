{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kiwami \u2013 Controls, Notes & Study Tools for YouTube", "description": "Control YouTube playback, reduce distractions, and take timestamped notes with optional transcript and study tools.", "version": "1.8.0", "short_name": "Kiwami", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "tabs", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube.com/*", "https://sponsor.ajay.app/*", "https://returnyoutubedislikeapi.com/*"], "optional_host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "https://openrouter.ai/*", "https://api.deepseek.com/*", "https://api.x.ai/*", "https://integrate.api.nvidia.com/*", "http://localhost/*", "http://127.0.0.1/*"], "browser_specific_settings": {"gecko": {"id": "kiwami@extensionsbyselfhood.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "action": {"default_title": "Kiwami", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["*://*.youtube.com/*"]}], "commands": {"toggle-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the Kiwami side panel (notes \u00b7 transcript \u00b7 AI)"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}