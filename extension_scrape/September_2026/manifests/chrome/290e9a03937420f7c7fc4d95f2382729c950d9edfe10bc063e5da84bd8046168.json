{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Research Access Helper (RAH)", "version": "1.2", "description": "Quickly access academic research papers and articles from URLs or DOIs.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"open-current-page": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open current page in Sci-Hub"}}, "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["*://*.libgen.vg/*", "*://*.libgen.la/*", "*://*.libgen.bz/*", "*://*.libgen.gl/*", "*://*.libgen.li/*"], "content_scripts": [{"matches": ["*://*.sci-hub.se/*", "*://*.sci-hub.st/*", "*://*.sci-hub.ru/*", "*://*.sci-hub.box/*", "*://*.sci-hub.su/*", "*://*.sci-hub.red/*"], "js": ["content.js"], "css": ["content.css"]}, {"matches": ["*://*.libgen.vg/*", "*://*.libgen.la/*", "*://*.libgen.bz/*", "*://*.libgen.gl/*", "*://*.libgen.li/*"], "js": ["libgen-inject.js"]}]}