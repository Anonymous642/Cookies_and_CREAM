{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Tamer", "version": "1.1.1", "description": "Search every open tab, save & restore sessions, dedupe, and suspend memory hogs.", "permissions": ["tabs", "storage", "scripting", "activeTab", "favicon", "bookmarks"], "optional_permissions": ["history"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Tab Tamer (\u2318\u21e7E)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "commands": {"toggle-palette": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Tab Tamer"}}}