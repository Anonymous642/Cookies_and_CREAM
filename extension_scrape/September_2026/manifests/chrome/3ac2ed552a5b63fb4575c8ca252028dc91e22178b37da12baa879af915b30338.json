{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab URL Copier", "version": "2.0.0", "description": "\u9078\u629e\u3057\u305f\u8907\u6570\u306e\u30bf\u30d6\u306eURL\u3092\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306b\u30b3\u30d4\u30fc\u3057\u307e\u3059", "permissions": ["tabs", "clipboardWrite", "storage", "contextMenus", "offscreen"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/favicon16.png", "32": "icons/favicon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["onboarding.html", "settings.html", "FAQ.html"], "matches": ["<all_urls>"]}], "commands": {"copy-current-tab": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "\u73fe\u5728\u306e\u30bf\u30d6\u3092\u30b3\u30d4\u30fc"}, "copy-selected-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "\u9078\u629e\u3057\u305f\u30bf\u30d6\u3092\u30b3\u30d4\u30fc"}, "copy-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "\u3059\u3079\u3066\u306e\u30bf\u30d6\u3092\u30b3\u30d4\u30fc"}}}