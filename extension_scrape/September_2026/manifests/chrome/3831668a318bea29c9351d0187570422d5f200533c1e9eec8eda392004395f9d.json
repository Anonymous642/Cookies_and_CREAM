{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mobile Lab: Responsive Testing & Screenshots", "version": "2.0.3", "description": "Test responsive websites across viewport sizes, capture screenshots, record QA flows, and inspect frontend issues.", "permissions": ["storage", "tabs", "downloads", "debugger", "declarativeNetRequest"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open Mobile Lab"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["page-env-shim.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["third_party/axe-core/axe.js", "scroll-bridge.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["flow-recorder.js"], "all_frames": false, "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page-env-shim.js"], "matches": ["http://*/*", "https://*/*"]}], "short_name": "Mobile Lab"}