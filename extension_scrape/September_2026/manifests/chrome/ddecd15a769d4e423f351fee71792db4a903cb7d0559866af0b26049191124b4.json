{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Replix \u2014 AI Replies for X, Instagram, Reddit & Quora", "version": "2.2.3", "description": "AI replies, comments & answers for X, Instagram, Reddit & Quora \u2014 in your tone, inserted into the composer for you.", "permissions": ["storage", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://www.reddit.com/*", "https://sh.reddit.com/*", "https://*.quora.com/*", "https://replix.social/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["lib/ui.js", "content/twitter.js"], "css": ["styles/replix.css"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["lib/ui.js", "content/instagram.js"], "css": ["styles/replix.css"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://sh.reddit.com/*"], "js": ["lib/ui.js", "content/reddit.js"], "css": ["styles/replix.css"], "run_at": "document_idle"}, {"matches": ["https://*.quora.com/*"], "js": ["lib/ui.js", "content/quora.js"], "css": ["styles/replix.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}