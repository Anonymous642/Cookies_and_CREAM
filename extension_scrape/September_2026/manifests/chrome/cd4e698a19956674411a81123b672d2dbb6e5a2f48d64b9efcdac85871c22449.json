{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Network Throttle Controller", "version": "1.2.0", "description": "Control network throttling with popup interface. Support global throttling and rule-based blocking without opening DevTools.", "author": "Your Name", "homepage_url": "https://github.com/yourusername/network-throttle-controller", "permissions": ["debugger", "activeTab", "storage", "tabs"], "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "popup.html", "default_title": "Network Throttle Controller", "default_icon": {"16": "assets/network-16.png", "32": "assets/network-32.png", "48": "assets/network-48.png"}}, "icons": {"16": "assets/network-16.png", "32": "assets/network-32.png", "48": "assets/network-48.png", "128": "assets/network-128.png"}, "commands": {"toggle-throttling": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Toggle network throttling"}}, "web_accessible_resources": [{"resources": ["test.html", "assets/*.png"], "matches": ["<all_urls>"]}]}