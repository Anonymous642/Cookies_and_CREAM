{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ToNY AI Assistant", "version": "1.0.2", "description": "A Gmail-only assistant that lets supervisors chat with Tony AI and manually archive opened emails into internal Workspace resources.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "host_permissions": ["https://mail.google.com/*", "https://script.google.com/*", "https://*.googleusercontent.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "css": ["toastr.min.css"], "js": ["jquery.min.js", "toastr.min.js", "content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "default-src 'self'; frame-src https://script.google.com https://*.googleusercontent.com;"}, "web_accessible_resources": [{"resources": ["icon.png"], "matches": ["https://mail.google.com/*"]}]}