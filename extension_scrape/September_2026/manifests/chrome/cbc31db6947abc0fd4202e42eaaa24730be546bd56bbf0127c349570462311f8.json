{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptDock \u2014 Private Prompt Manager for AI", "version": "0.1.0", "description": "Save AI prompts once, insert anywhere with Alt+/ on ChatGPT, Claude, Gemini & Perplexity. Prompts stay on your device.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://api.gumroad.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "PromptDock", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "manager/manager.html", "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["lib/util.js", "content/picker.js"], "run_at": "document_idle"}], "commands": {"open-manager": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open the PromptDock library"}}}