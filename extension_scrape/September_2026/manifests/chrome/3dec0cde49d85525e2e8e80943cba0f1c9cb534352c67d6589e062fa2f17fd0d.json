{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NDH Prompt Privacy", "version": "1.0.0", "description": "Local privacy guard for ChatGPT, Claude, and Gemini. Warns before sending emails, phones, IDs, addresses, card numbers, or API keys.", "permissions": ["storage"], "host_permissions": ["*://*.chatgpt.com/*", "*://*.gemini.google.com/*", "*://*.claude.ai/*"], "icons": {"32": "icon32.png", "96": "icon96.png", "192": "icon192.png", "512": "icon512.png"}, "action": {"default_popup": "popup.html", "default_icon": {"32": "icon32.png", "96": "icon96.png"}}, "content_scripts": [{"matches": ["*://*.chatgpt.com/*", "*://*.gemini.google.com/*", "*://*.claude.ai/*"], "js": ["content.js"], "css": ["inject.css"], "run_at": "document_idle"}]}