{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GmailSpeaker: Gmail Text to Speech", "version": "1.0.2", "description": "Read Gmail emails aloud with offline text to speech. Control speed, read unread threads, and manage inbox actions faster.", "permissions": ["storage", "offscreen", "alarms", "cookies", "tabs", "notifications", "clipboardWrite", "windows", "sidePanel"], "optional_permissions": ["identity"], "optional_host_permissions": ["https://www.googleapis.com/*", "https://gmail.googleapis.com/*"], "host_permissions": ["*://mail.google.com/*"], "oauth2": {"client_id": "60727320099-gg0n6ishicvrc7ng50jr332ul91brqj4.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/gmail.modify"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content.js"], "css": ["player.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/sherpa-onnx/*", "models/*", "offscreen.html", "icons/*", "options.html", "options.css", "options.js", "popup-settings.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"toggle-play": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play / Pause reading"}, "stop-reading": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop reading"}}}