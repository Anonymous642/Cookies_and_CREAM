{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Water Reminder - Your Personal Hydration Assistant", "description": "Stay hydrated with Personal Hydration Assistant! Customizable water reminders, tracks intake and shows progress. Never miss a sip!", "version": "1.2.0", "manifest_version": 3, "author": "Hafeez Mohamad", "permissions": ["storage", "alarms", "notifications", "offscreen", "idle"], "icons": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "114": "public/icons/icon114.png", "128": "public/icons/icon128.png"}, "action": {"default_title": "Water Reminder", "default_popup": "src/popup/popup.html", "default_icon": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "114": "public/icons/icon114.png", "128": "public/icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["public/icons/*", "public/sounds/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+E", "mac": "Command+E"}}}}