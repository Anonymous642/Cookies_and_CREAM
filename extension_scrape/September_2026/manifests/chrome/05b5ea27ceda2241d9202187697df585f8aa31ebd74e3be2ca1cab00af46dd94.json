{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MaskShare \u2014 Privacy Overlay for Screen Sharing", "short_name": "MaskShare", "version": "1.0.0", "description": "Cover sensitive parts of your screen with resizable privacy masks. Perfect for any browser based screenShare", "action": {"default_title": "MaskShare", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-all-masks": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Show / hide all masks"}, "add-mask": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add a new mask on the current page"}, "clear-masks": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Remove all masks from the current page"}}}