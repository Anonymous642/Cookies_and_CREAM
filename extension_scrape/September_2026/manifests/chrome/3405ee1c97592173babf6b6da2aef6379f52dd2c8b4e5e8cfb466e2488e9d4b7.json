{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SeshTab", "description": "Save tab groups, sync across devices, sleep tabs for later. The lightweight tab manager for power users.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "SeshTab \u2014 Tab Manager", "default_popup": "popup.html"}, "permissions": ["tabs", "storage", "alarms", "windows", "sessions"], "host_permissions": ["https://*.supabase.co/*", "https://www.getseshtab.com/*", "https://getseshtab.com/*"], "externally_connectable": {"matches": ["https://www.getseshtab.com/*", "https://getseshtab.com/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open SeshTab"}}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}