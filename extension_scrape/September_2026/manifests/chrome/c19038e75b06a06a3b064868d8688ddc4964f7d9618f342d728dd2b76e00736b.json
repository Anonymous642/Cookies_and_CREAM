{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal Tab Popout", "version": "1.1.2", "description": "Detach any tab into a floating window (includes native Video PiP shortcut). Enjoy windowed-fullscreen for videos & multitasking.", "permissions": ["activeTab", "system.display", "storage", "tabCapture", "offscreen", "scripting", "nativeMessaging"], "host_permissions": ["<all_urls>"], "commands": {"toggle_popout": {"suggested_key": {"default": "Alt+O", "mac": "Alt+O"}, "description": "Toggle Popout/Popin for the current tab"}, "toggle_pip": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Toggle Native Video PiP"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Popout Options", "default_popup": "popup.html"}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "background": {"service_worker": "background.js"}}