{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Quick Preview", "description": "Preview GitHub issue and PR content without leaving the current page", "version": "1.3", "icons": {"16": "icon-16.png", "24": "icon-24.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_title": "GitHub Quick Preview", "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "webRequest"], "host_permissions": ["https://api.github.com/*", "https://github.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content-scripts/content.js"]}]}