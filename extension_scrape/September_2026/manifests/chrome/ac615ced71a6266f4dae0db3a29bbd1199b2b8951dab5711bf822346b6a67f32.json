{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dubstack Dual Subtitles", "description": "Clean dual subtitles for Netflix and YouTube, with click-to-lookup for language learners.", "version": "1.0.1", "minimum_chrome_version": "116", "permissions": ["storage"], "host_permissions": ["https://netflix.com/*", "https://*.netflix.com/*", "https://nflxvideo.net/*", "https://*.nflxvideo.net/*", "https://youtube.com/*", "https://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "dist/background.js", "type": "module"}, "externally_connectable": {"matches": ["https://getdubstack.com/*", "https://www.getdubstack.com/*"]}, "content_scripts": [{"matches": ["https://netflix.com/*", "https://*.netflix.com/*", "https://*.youtube.com/*"], "js": ["src/content.js", "src/translator.js", "src/lookup.js"], "run_at": "document_start"}, {"matches": ["https://netflix.com/*", "https://*.netflix.com/*"], "js": ["src/netflix-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.youtube.com/*"], "js": ["src/youtube-main.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_title": "Dubstack", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}