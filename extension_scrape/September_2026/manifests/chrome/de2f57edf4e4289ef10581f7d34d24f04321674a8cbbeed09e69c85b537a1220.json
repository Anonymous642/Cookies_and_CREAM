{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Multi-Site Vehicle Scraper", "version": "1.0.2", "description": "Scrape vehicle data from Facebook Marketplace, Cars.com, and more sites", "permissions": ["activeTab", "storage", "downloads"], "host_permissions": ["*://www.facebook.com/*", "*://facebook.com/*", "*://www.cars.com/*", "*://cars.com/*", "*://craigslist.org/*", "*://*.craigslist.org/*", "*://axisxchange.com/*", "*://*.ngrok-free.dev/*"], "content_scripts": [{"matches": ["*://www.facebook.com/marketplace/item/*", "*://facebook.com/marketplace/item/*", "*://www.cars.com/vehicledetail/*", "*://cars.com/vehicledetail/*", "*://craigslist.org/*/cto/*", "*://*.craigslist.org/*/cto/*"], "js": ["scrapers/base-scraper.js", "scrapers/facebook-scraper.js", "scrapers/cars-scraper.js", "scrapers/craigslist-scraper.js", "server-api-client.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Multi-Site Vehicle Scraper", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "web_accessible_resources": [{"resources": ["scrapers/*.js"], "matches": ["*://www.facebook.com/*", "*://facebook.com/*", "*://www.cars.com/*", "*://cars.com/*", "*://craigslist.org/*", "*://*.craigslist.org/*"]}]}