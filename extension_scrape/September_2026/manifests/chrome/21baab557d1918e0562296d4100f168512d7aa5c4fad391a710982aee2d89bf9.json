{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Swagger Local Viewer", "version": "1.0.0", "description": "View local Swagger/OpenAPI documents (YAML/JSON) in your browser.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "host_permissions": ["file://*/*"], "content_scripts": [{"matches": ["file://*/*.yaml", "file://*/*.yml", "file://*/*.json", "http://*/*.yaml", "http://*/*.yml", "http://*/*.json", "https://*/*.yaml", "https://*/*.yml", "https://*/*.json"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["swagger-ui/*", "swagger-initializer.js"], "matches": ["<all_urls>"]}]}