{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Raven: Research & Article Finder", "version": "1.1", "description": "Fetch a free copy of any scholarly article from various sources.", "icons": {"16": "a/i/p.png", "32": "a/i/p.png", "48": "a/i/p.png", "128": "a/i/p.png"}, "permissions": ["storage", "tabs", "alarms", "proxy"], "host_permissions": ["https://arxiv.org/*", "https://api.unpaywall.org/*", "https://api.openalex.org/*", "https://api.semanticscholar.org/*", "https://api.typeset.io/*", "https://eutils.ncbi.nlm.nih.gov/*", "https://sci-hub.se/*", "https://sci-hub.st/*", "https://sci-hub.ru/*", "https://sci-hub.ren/*", "https://sci-hub.red/*", "https://sci-hub.box/*", "https://sci-hub.ee/*", "https://sci-hub.wf/*", "https://sci-hub.shop/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "b/w.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["s/b.js", "s/c.js", "s/u.js", "c/w.js", "c/d.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["a/*.gif"], "matches": ["<all_urls>"]}], "action": {"default_title": "Raven", "default_popup": "p/p.html", "default_icon": {"16": "a/i/b.png", "32": "a/i/b.png", "48": "a/i/b.png", "128": "a/i/b.png"}}, "commands": {"manual-lookup": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Run manual free article lookup on current tab"}}}