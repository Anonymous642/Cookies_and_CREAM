{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Darwinbox LinkedIn Sourcing", "version": "2.0.0", "description": "Source LinkedIn candidates into Darwinbox Recruitment via a side drawer. Add single or bulk candidates (up to 10) with enrichment.", "minimum_chrome_version": "116", "action": {"default_title": "Add to Darwinbox"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "tabs", "offscreen", "scripting", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://*.darwinbox.in/*", "https://*.darwinbox.com/*", "https://*.darwinbox.io/*", "https://*.qa.darwinbox.io/*", "https://*.qa.darwinbox.in/*", "https://*.qa.darwinbox.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/search/results/people/*", "https://www.linkedin.com/talent/*", "https://www.linkedin.com/recruiter/*"], "js": ["src/lib/constants.js", "src/lib/surface-detection.js", "src/lib/country-code-data.js", "src/lib/country-codes.js", "src/lib/formatters/experience.js", "src/lib/formatters/education.js", "src/lib/experience-format-content.js", "src/lib/education-format-content.js", "src/content/scrapers.js", "src/content/styles.js", "src/content/drawer.js", "src/content/cards.js", "src/content/content.js"], "run_at": "document_idle"}], "icons": {"16": "logo/logo16.png", "48": "logo/logo48.png", "128": "logo/logo128.png"}}