{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Defeed - Distraction-Free YouTube & LinkedIn", "version": "0.0.1", "description": "Strip feeds, recommendations, Shorts and comments on YouTube & LinkedIn. Add time tracking, daily limits, schedules and grayscale.", "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.linkedin.com/*"], "icons": {"16": "icons/defeed-icon-16.png", "32": "icons/defeed-icon-32.png", "48": "icons/defeed-icon-48.png", "128": "icons/defeed-icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Defeed", "default_icon": {"16": "icons/defeed-icon-16.png", "32": "icons/defeed-icon-32.png", "48": "icons/defeed-icon-48.png", "128": "icons/defeed-icon-128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "all_frames": false, "js": ["src/core/defaults.js", "src/core/storage.js", "src/core/features/youtube.js", "src/content/shared/common.js", "src/content/youtube/youtube.js"], "css": ["src/styles/tokens.css", "src/content/shared/common.css", "src/content/youtube/youtube.css"]}, {"matches": ["*://*.linkedin.com/*"], "run_at": "document_start", "all_frames": false, "js": ["src/core/defaults.js", "src/core/storage.js", "src/core/features/linkedin.js", "src/content/shared/common.js", "src/content/linkedin/linkedin.js"], "css": ["src/styles/tokens.css", "src/content/shared/common.css", "src/content/linkedin/linkedin.css"]}], "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Toggle Defeed on or off"}}, "web_accessible_resources": [{"resources": ["icons/defeed-icon.svg"], "matches": ["*://*.youtube.com/*", "*://*.linkedin.com/*"]}]}