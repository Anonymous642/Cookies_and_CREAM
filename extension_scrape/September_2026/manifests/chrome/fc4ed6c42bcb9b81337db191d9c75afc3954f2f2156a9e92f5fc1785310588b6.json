{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whatsapp Web Contact Hide and Blur Toggle", "version": "1.4.0", "description": "Hide, blur and change visibility of the contact sidebar on WhatsApp Web for privacy.", "permissions": ["activeTab", "storage", "scripting"], "author": "Wenjay Tew", "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://web.whatsapp.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["drag-and-drop.png", "/Hide.png", "/Reveal.png"], "matches": ["*://web.whatsapp.com/*"]}], "commands": {"toggle-blur-hide": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Toggle blur/hide on current page"}}}