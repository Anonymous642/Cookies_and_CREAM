{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClientSpace \u2014 Tab Manager & Switcher", "short_name": "ClientSpace", "version": "1.0.0", "description": "Resume work exactly where you left off. Switch contexts and restore your workspace\u2014tabs, bookmarks, tasks, and time tracking.", "permissions": ["storage", "tabs", "bookmarks", "alarms", "notifications", "scripting", "activeTab"], "host_permissions": ["<all_urls>", "https://api.gumroad.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png"}, "default_title": "ClientSpace \u2014 Resume any project in 3 seconds"}, "options_page": "options.html", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}