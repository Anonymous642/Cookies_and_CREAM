{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Code of Current Page", "version": "1.0", "description": "Generate a QR code of the current URL using a hotkey.", "permissions": ["scripting", "activeTab"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "action": {"default_title": "QR Code"}, "commands": {"open_qr_modal": {"suggested_key": {"default": "Alt+Q"}, "description": "Show QR code modal"}}, "web_accessible_resources": [{"resources": ["modal.css"], "matches": ["<all_urls>"]}]}