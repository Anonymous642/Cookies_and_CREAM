{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AttentionPay", "version": "1.0.1", "description": "Get paid for your attention. Control who reaches you and earn when they do.", "permissions": ["storage", "alarms", "activeTab"], "host_permissions": ["https://mail.google.com/*", "https://www.linkedin.com/*", "https://attentionpay.vercel.app/*"], "background": {"service_worker": "src/background.js"}, "icons": {"16": "public/icons/icon-16.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content/gmail.js"], "css": ["src/content/styles.css"]}, {"matches": ["https://www.linkedin.com/*"], "js": ["src/content/linkedin.js"], "css": ["src/content/styles.css"]}]}