{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FSD Guard \u2014 Feature-Sliced Design linter for PRs", "version": "0.2.0", "description": "FSD linter for GitHub & GitLab: flags import violations in PRs, audits the repo and maps its architecture as a dependency graph.", "homepage_url": "https://developer.living", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://patch-diff.githubusercontent.com/*", "https://*.githubusercontent.com/*", "https://codeload.github.com/*", "https://gitlab.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*", "https://gitlab.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_page": "options.html", "action": {"default_popup": "popup.html", "default_title": "FSD Guard"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}