{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptFluent - AI Prompt Library", "version": "1.2.0", "description": "Access 20,000+ expert-built AI prompts instantly. Works with ChatGPT, Claude, Gemini, Copilot, and Perplexity.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "PromptFluent"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content/platform-detector.js", "content/output-capture.js", "content/content-script.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite", "tabs", "notifications"], "host_permissions": ["https://www.promptfluent.com/*", "https://promptfluent.com/*", "https://*.promptfluent.com/*", "https://promptfluent.app/*", "https://*.promptfluent.app/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "commands": {"open_command_palette": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Open PromptFluent Command Palette"}, "insert_last_prompt": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L"}, "description": "Insert Last Used Prompt"}}, "web_accessible_resources": [{"resources": ["command-palette/palette.html", "command-palette/palette.css", "command-palette/palette.js", "icons/*"], "matches": ["<all_urls>"]}]}