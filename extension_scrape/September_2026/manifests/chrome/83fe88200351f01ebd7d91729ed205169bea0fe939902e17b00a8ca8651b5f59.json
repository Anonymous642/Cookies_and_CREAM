{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Z-Asist - UTALCA Attendance", "short_name": "Z-Asist", "version": "1.0.1", "author": "Fabi\u00e1n Ram\u00edrez Barrios <fabian.ramirez@utalca.cl>", "description": "Mark UTALCA attendance from any webpage with time tracking", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "cookies", "scripting", "notifications", "alarms"], "host_permissions": ["https://*.utalca.cl/*"], "action": {"default_popup": "src/ui/popup/popup.html"}, "background": {"service_worker": "src/background/service.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.utalca.cl/*"], "js": ["src/content/loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/messenger.js"], "matches": ["https://*.utalca.cl/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}