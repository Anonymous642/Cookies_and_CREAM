{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "asRobo", "description": "Capture, review, and prepare product drafts for Shopify and eBay.", "version": "2.0.1", "icons": {"128": "asRoboLogo128.png"}, "permissions": ["storage", "activeTab"], "commands": {"capture-product": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capture the current product"}, "prepare-form": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Prepare the current listing form"}, "open-workspace": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Open the import workspace"}}, "host_permissions": ["https://asroboweb.vercel.app/*", "https://*.alicdn.com/*", "https://*.aliexpress-media.com/*", "https://*.allegroimg.com/*", "https://*.allegrostatic.com/*", "https://*.allegro.pl/*", "https://*.allegro.cz/*", "https://*.allegro.sk/*", "https://*.allegro.hu/*", "https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://admin.shopify.com/*", "https://*.myshopify.com/admin/*", "https://*.ebay.com/*", "https://*.ebay.co.uk/*", "https://*.ebay.de/*", "https://*.ebay.fr/*", "https://*.ebay.it/*", "https://*.ebay.es/*", "https://*.ebay.ca/*", "https://*.ebay.com.au/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "asRobo", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://*.allegro.cz/*", "https://*.allegro.hu/*", "https://*.allegro.pl/*", "https://*.allegro.sk/*", "https://*.ebay.ca/*", "https://*.ebay.co.uk/*", "https://*.ebay.com.au/*", "https://*.ebay.com/*", "https://*.ebay.de/*", "https://*.ebay.es/*", "https://*.ebay.fr/*", "https://*.ebay.it/*", "https://*.myshopify.com/admin/*", "https://admin.shopify.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}