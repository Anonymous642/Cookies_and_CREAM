{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Hot Filter", "version": "0.1.0", "description": "Filter Reddit posts in subreddit listings by minimum comment count. Keep your feed focused on what's actually being discussed.", "permissions": ["storage", "activeTab", "tabs", "sidePanel"], "host_permissions": ["*://*.reddit.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Reddit Hot Filter"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}