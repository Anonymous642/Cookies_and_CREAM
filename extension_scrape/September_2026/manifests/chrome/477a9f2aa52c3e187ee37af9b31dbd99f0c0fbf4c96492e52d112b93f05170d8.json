{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Klaxon Cloud", "description": "Klaxon sends you alerts when webpages you're watching change.", "homepage_url": "https://www.documentcloud.org/add-ons/MuckRock/Klaxon/", "version": "1.3.1", "manifest_version": 3, "action": {"default_icon": "icon-128.png", "default_title": "Klaxon Cloud"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["scripting", "activeTab", "identity", "storage", "tabs", "sidePanel"], "optional_host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "host_permissions": ["https://accounts.muckrock.com/*", "https://api.www.documentcloud.org/*"], "content_scripts": [{"matches": ["https://www.klaxoncloud.org/*"], "js": ["web-bridge.js"], "run_at": "document_idle"}]}