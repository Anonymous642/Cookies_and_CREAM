{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bulk URL Opener", "version": "1.2", "description": "Open multiple URLs at once and select links with a hotkey(Z)", "permissions": ["tabs", "scripting"], "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end", "all_frames": true}], "commands": {"activate-selection": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Activate link selection mode"}}}