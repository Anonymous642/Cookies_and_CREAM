{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SiteScanner - SEO, AEO, CSS & Website Tech Stack Analyzer", "version": "1.5.6", "description": "Professional website intelligence toolkit for SEO audits, AI visibility, tech stack analysis, and asset downloads.", "permissions": ["activeTab", "scripting", "downloads", "windows", "storage", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "SiteScanner"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scanner.js"], "run_at": "document_start", "all_frames": false}], "commands": {"capture-portion": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Start area screenshot capture"}, "inspect-element": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Start element inspector"}, "toggle-highlighter": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle text highlighter"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+U"}}}}