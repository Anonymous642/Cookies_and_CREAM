{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jira & Bitbucket - Worklog Dashboard", "version": "3.1.2", "description": "Track Jira Working hours, Bitbucket PRs & DX metrics. inbuild AI features to ask questions. Calendar, team & API keys.", "permissions": ["storage", "alarms", "scripting", "tabs", "idle", "notifications", "history"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Jira & Bitbucket Dashboard"}, "options_page": "settings.html", "commands": {"new-sticky-note": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S", "windows": "Alt+Shift+S"}, "description": "Open new sticky note"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/sticky-note.js"], "run_at": "document_idle"}, {"matches": ["https://*.atlassian.net/*", "https://*.jira.com/*"], "js": ["content/summary-bar.js", "content/worklog-reminder.js"], "run_at": "document_idle"}, {"matches": ["https://bitbucket.org/*"], "js": ["content/worklog-reminder.js"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/*"], "js": ["content/meeting-overlay.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["content/ask-ai-chat.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}