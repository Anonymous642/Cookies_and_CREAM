{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabRoller", "version": "1.0.0", "description": "Automatically close unused tabs with smart prompts. Save memory and reduce tab clutter.", "permissions": ["tabs", "storage", "alarms", "notifications", "bookmarks"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TabRoller", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"close-inactive-now": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Close all inactive tabs immediately"}}}