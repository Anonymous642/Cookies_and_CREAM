{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Grayscale Webpages", "version": "1.14", "description": "Applies a grayscale filter to all webpages. Use Alt+G to toggle.", "manifest_version": 3, "permissions": ["storage", "scripting", "tabs", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "icon_on.png"}, "icons": {"16": "icon_on.png", "48": "icon_on.png", "128": "icon_on.png"}, "commands": {"toggle-grayscale": {"suggested_key": {"default": "Alt+G"}, "description": "Toggle Grayscale"}}, "web_accessible_resources": [{"resources": ["content.css", "icon_on.png", "icon_off.png"], "matches": ["<all_urls>"]}]}