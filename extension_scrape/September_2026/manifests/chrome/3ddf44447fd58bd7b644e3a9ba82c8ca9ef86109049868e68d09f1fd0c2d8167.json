{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesfinity", "version": "2.2.0", "description": "Call, email and sequence prospects from Salesforce and HubSpot, dial any phone number on any page, and work your LinkedIn inbox.", "permissions": ["sidePanel", "storage", "tabs", "scripting", "alarms", "offscreen", "contextMenus", "notifications"], "host_permissions": ["https://www.linkedin.com/*", "https://*.salesfinity.co/*", "https://api.memegen.link/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.hubspot.com/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "app/dist/src/panel/index.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.hubspot.com/*"], "js": ["app/dist/content-crm.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["app/dist/tel.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Open Salesfinity"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["app/dist/fonts/*", "app/dist/salesfinity-avatar.svg"], "matches": ["https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.hubspot.com/*"]}], "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open the Salesfinity dialer"}, "hangup-call": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Hang up the current call"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Mute or unmute the current call"}, "switch-view": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Switch between the dialer and the inbox"}}}