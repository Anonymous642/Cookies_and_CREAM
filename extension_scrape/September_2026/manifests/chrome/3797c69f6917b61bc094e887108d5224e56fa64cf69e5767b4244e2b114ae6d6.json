{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Multicaster", "version": "1.2.9", "description": "Mainstream chatbot all-in-one tool.", "permissions": ["tabs", "scripting", "storage", "declarativeNetRequest", "webNavigation", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://meta.ai/*", "https://www.meta.ai/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://chat.deepseek.com/*", "https://claude.ai/*"], "declarative_net_request": {"rule_resources": [{"id": "strip_headers", "enabled": true, "path": "rules/strip-headers.json"}]}, "action": {"default_title": "Open Chat Multicaster", "default_popup": "popup/session-picker.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"toggle-chat-and-last-tab": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle between chat and last non-chat tab", "global": true}}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://meta.ai/*", "https://www.meta.ai/*"], "js": ["content-scripts/meta.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content-scripts/perplexity.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://chat.deepseek.com/*"], "js": ["content-scripts/deepseek.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon1