{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinterest Board Dump", "description": "Download images and videos from a Pinterest board as a local zip file.", "version": "0.1.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "downloads", "sidePanel"], "host_permissions": ["https://*.pinterest.com/*", "https://*.pinimg.com/*", "https://v.pinimg.com/*"], "action": {"default_title": "pinterest board dump"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.pinterest.com/*"], "js": ["content-scripts/content.js"]}]}