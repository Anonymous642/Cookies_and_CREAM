{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gungnir \u2014 Grimnir AI for Lawyers", "version": "1.0.0", "description": "Bring your firm's AI assistant to Gmail, Google Docs, and any browser tab.", "permissions": ["cookies", "sidePanel"], "host_permissions": ["https://mail.google.com/*", "https://docs.google.com/*", "https://app.gungnir.cloud/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_title": "Grimnir \u2014 Gungnir AI", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidebar/index.html"}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "run_at": "document_idle"}, {"matches": ["https://docs.google.com/*"], "js": ["content/docs.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open Grimnir sidebar"}}}