{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Political Lens", "version": "1.0.5", "description": "Analyze a web article's text and reveal its left/right political leaning score.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "offscreen"], "host_permissions": ["*://*.cnn.com/*", "*://*.foxnews.com/*", "*://abcnews.com/*", "*://www.abcnews.com/*", "*://*.nbcnews.com/*", "*://*.nytimes.com/*", "*://*.washingtonpost.com/*", "https://news-extensions-backend.vercel.app/*"], "action": {"default_title": "Analyze this page", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.cnn.com/*", "*://*.foxnews.com/*", "*://abcnews.com/*", "*://www.abcnews.com/*", "*://*.nbcnews.com/*", "*://*.nytimes.com/*", "*://*.washingtonpost.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}]}