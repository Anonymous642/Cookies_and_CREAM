{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebSentinel", "short_name": "WebSentinel", "version": "1.0.0", "description": "Monitor webpages for changes and get notified when they update. Auto-scans at your chosen intervals.", "homepage_url": "https://github.com/Leonard013/WebSentinel", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "alarms", "notifications", "storage", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "WebSentinel", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+W"}, "description": "Open WebSentinel"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}