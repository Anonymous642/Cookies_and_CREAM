{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jira Control Chart", "version": "1.3.0", "description": "Exports issues from a self-hosted Jira board (Server/DC 9.x) into IndexedDB and builds a Control Chart.", "minimum_chrome_version": "114", "author": {"email": "izumsky@gmail.com"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Jira Control Chart"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "unlimitedStorage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}