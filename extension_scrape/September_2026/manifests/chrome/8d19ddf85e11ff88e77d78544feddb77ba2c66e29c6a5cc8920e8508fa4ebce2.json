{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lakhasly Transcript Extractor", "version": "0.1.0", "description": "Save Udemy course transcripts as one Markdown file, organized by section and lesson \u2014 ready to summarize with Lakhasly.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["*://*.udemy.com/*", "*://*.udemycdn.com/*"], "background": {"service_worker": "src/background/background.js", "scripts": ["src/background/background.js"]}, "content_scripts": [{"matches": ["*://*.udemy.com/course/*"], "js": ["src/content/content.js"]}], "web_accessible_resources": [{"resources": ["src/lib/*.js"], "matches": ["*://*.udemy.com/*"]}], "action": {"default_title": "Lakhasly Transcript Extractor", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "udemy-transcript-extractor@local", "data_collection_permissions": {"required": ["none"]}}}}