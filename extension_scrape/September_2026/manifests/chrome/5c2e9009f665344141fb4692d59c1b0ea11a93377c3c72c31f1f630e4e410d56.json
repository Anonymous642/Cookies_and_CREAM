{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TradingView \u2192 ChatGPT Helper", "description": "\u4e00\u952e\u622a\u53d6 TradingView \u56fe\u5e76\u53d1\u9001\u5230 ChatGPT\u3002", "version": "0.1.0", "permissions": ["activeTab", "scripting", "tabs", "storage", "notifications", "offscreen"], "host_permissions": ["https://*.tradingview.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "TV \u2192 ChatGPT", "default_popup": "ui/popup/index.html"}, "options_page": "ui/options/index.html", "commands": {"capture-tradingview-chart": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Capture TradingView chart and send to ChatGPT"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://*.tradingview.com/*"], "js": ["content/tv-capture.js"], "run_at": "document_idle"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content/chatgpt-inject.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}