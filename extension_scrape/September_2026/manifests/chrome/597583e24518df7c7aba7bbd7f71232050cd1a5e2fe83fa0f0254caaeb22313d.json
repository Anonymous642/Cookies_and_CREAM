{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Advanced Copy-Paste Tabs", "description": "Copy and paste URLs of your opened tabs. Supports text, HTML, JSON and custom formats.", "version": "2.0", "permissions": ["tabs", "clipboardWrite", "clipboardRead"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Copy-Paste Tabs"}, "commands": {"copy-tabs": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Copy all tabs URLs"}, "paste-tabs": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Paste and open URLs"}}}