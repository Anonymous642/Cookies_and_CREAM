{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Fence \u2014 Site Blocker & Pomodoro", "short_name": "Focus Fence", "version": "1.2.6", "description": "Website blocker + Pomodoro for Chrome. Block any site during deep work. Always-on option. Local-first.", "homepage_url": "https://ayaanrustagi.github.io/focus-field/", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Focus Fence", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "alarms", "tabs", "windows", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "optional_host_permissions": ["*://*/*"], "declarative_net_request": {"rule_resources": [{"id": "focus_block_rules", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["content/blocked.html", "timelapse/*"], "matches": ["http://*/*", "https://*/*"]}]}