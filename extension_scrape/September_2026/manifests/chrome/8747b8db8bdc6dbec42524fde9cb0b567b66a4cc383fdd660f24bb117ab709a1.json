{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stay Focused on Facebook", "version": "0.1.0", "description": "Hides the Facebook Home feed and shows a minimal search-first UI, with a settings popup and search history.", "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Focused Facebook", "default_popup": "popup.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}