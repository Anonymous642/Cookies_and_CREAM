{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shutterbox", "version": "1.0.0", "description": "Full-page screenshots that work in web apps, an annotation editor, and screen recording. Everything stays in your browser.", "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "contextMenus", "storage", "downloads", "offscreen", "unlimitedStorage", "tabCapture"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Capture selected area"}, "capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Capture full page"}}}