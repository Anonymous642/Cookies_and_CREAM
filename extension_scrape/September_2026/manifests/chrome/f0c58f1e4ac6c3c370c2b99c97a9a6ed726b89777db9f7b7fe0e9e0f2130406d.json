{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Headlinify", "version": "1.2.2", "description": "Right-click (or hover while pressing Option+Shift+Z) a headline link to overlay a neutral, factual headline.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "storage", "offscreen", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "Headlinify settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"headlinify-link": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Headlinify the link under the mouse cursor"}}, "options_page": "options.html"}