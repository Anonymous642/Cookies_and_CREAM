{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "eBay Order Autofill - Dropshipping Checkout Address Filler", "short_name": "3Dsellers Autofill", "version": "0.2.8", "description": "Auto fill the buyer shipping address from your eBay orders into supplier checkout forms in one click. For dropshipping.", "permissions": ["cookies", "storage", "activeTab", "scripting"], "host_permissions": ["https://app.3dsellers.com/*", "https://server.3dsellers.com/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://*.walmart.com/*", "https://*.temu.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "3Dsellers Order Autofill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://*.walmart.com/*", "https://*.temu.com/*"], "js": ["tds-sentry.js", "address.js", "sites.js", "content.js"], "run_at": "document_idle"}]}