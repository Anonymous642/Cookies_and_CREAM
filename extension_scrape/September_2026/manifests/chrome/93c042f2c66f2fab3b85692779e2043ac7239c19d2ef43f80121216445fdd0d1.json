{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Niche Hound \u2013 KDP Book Research: BSR, Sales & Keywords on Amazon", "short_name": "Niche Hound", "version": "1.0.0", "description": "Automatic Amazon book research for KDP: BSR for every edition, estimated sales and royalty ranges, Kindle Unlimited and keywords.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://www.amazon.com/*", "https://completion.amazon.com/*", "https://getnichehound.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}