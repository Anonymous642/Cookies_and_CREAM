{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PiP Brightness", "version": "0.1.0", "author": "ILLYA PIHOVYCH", "description": "Picture-in-Picture video with brightness controls and an enhanced Document PiP mode.", "permissions": ["activeTab", "scripting", "storage", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_title": "PiP Brightness", "default_popup": "popup/popup.html"}, "background": {"service_worker": "src/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://vite-extension-frame.vercel.app;"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "commands": {"toggle-native-pip": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle native Picture-in-Picture"}, "brightness-up": {"suggested_key": {"default": "Alt+Up"}, "description": "Increase PiP brightness"}, "brightness-down": {"suggested_key": {"default": "Alt+Down"}, "description": "Decrease PiP brightness"}, "reset-filters": {"description": "Reset PiP visual filters"}}}