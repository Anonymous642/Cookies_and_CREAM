{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabGroup Pilot", "version": "1.2.1", "description": "Auto-group, dedupe & sleep tabs. Spotlight-like search across tabs, history & bookmarks.", "permissions": ["tabs", "storage", "tabGroups", "alarms", "contextMenus", "bookmarks", "search", "history"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"duplicate-tab": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Duplicate current tab (\ud83d\udccb Duplicate)"}, "search-tabs": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Search tabs (\ud83d\udd0d Search Tabs)"}, "dedupe-tabs": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Close duplicate tabs, keep most recent (\ud83e\uddf9 Dedupe)"}, "sleep-others": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Sleep all inactive tabs (\ud83d\ude34 Sleep Others)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}