{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gesture Scroll", "version": "1.0.0", "description": "Scroll web pages with hand gestures using your webcam", "permissions": ["tabs", "activeTab", "windows", "storage", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Gesture Scroll", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://storage.googleapis.com"}, "web_accessible_resources": [{"resources": ["icons/*", "wasm/*"], "matches": ["<all_urls>"]}]}