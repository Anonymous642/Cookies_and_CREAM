{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Usage Tracker for Rork", "short_name": "Rork Tracker", "version": "1.5.0", "minimum_chrome_version": "110", "description": "See your Rork credits, usage & billing period in a sleek overlay. Never switch tabs again. Not affiliated with Rork.", "permissions": ["storage", "alarms", "tabs", "scripting"], "host_permissions": ["https://rork.com/*", "https://*.rork.com/*"], "background": {"service_worker": "bg.js"}, "content_scripts": [{"matches": ["https://rork.com/*", "https://*.rork.com/*"], "js": ["widget.js"], "css": ["widget.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"toggle-widget": {"suggested_key": {"default": "Alt+U", "mac": "Alt+U"}, "description": "Toggle Usage Tracker widget"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}