{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartShort", "version": "2.0.0", "description": "The only screenshot tool you'll ever need \u2014 capture, annotate, history.", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "downloads", "unlimitedStorage", "tabs"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://cdn.jsdelivr.net/*", "https://tessdata.projectnaptha.com/*", "https://unpkg.com/*"], "action": {"default_popup": "popup.html", "default_title": "SmartShort \u2014 Click to capture (Ctrl+Shift+S)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open SmartShort"}, "capture_region": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Capture region"}, "capture_visible": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible page"}}, "web_accessible_resources": [{"resources": ["editor.js", "style.css", "history.html", "history.js"], "matches": ["<all_urls>"]}]}