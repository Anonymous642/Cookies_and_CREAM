{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContactGuard", "version": "1.0.0", "description": "Privacy controls for WhatsApp Web and WhatsApp Business Web.", "icons": {"16": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}, "permissions": ["storage", "browsingData", "management", "scripting", "tabs"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "ContactGuard", "default_icon": {"16": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*", "https://business.whatsapp.com/*"], "js": ["src/content/content-script.js"], "run_at": "document_idle"}]}