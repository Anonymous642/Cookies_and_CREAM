{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hibiki \u2013 Step-by-Step Guide & Tutorial Maker", "description": "Turn clicks into step-by-step how-to guides & tutorials. Auto-screenshots, annotate, redact, export to PDF/HTML. 100% local.", "version": "0.3.0", "short_name": "Hibiki", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "unlimitedStorage", "downloads", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Hibiki", "default_popup": "popup.html"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start / stop recording"}, "capture-step": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture a step manually"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}