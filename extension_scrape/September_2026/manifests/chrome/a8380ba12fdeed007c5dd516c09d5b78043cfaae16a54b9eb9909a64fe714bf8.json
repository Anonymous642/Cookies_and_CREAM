{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Distraction Free YouTube", "description": "Hide YouTube distractions, start timed focus blocks, and mark a video or playlist as your current focus target.", "version": "1.4.0", "manifest_version": 3, "action": {"default_title": "YouTube Productivity Booster", "default_popup": "popup.html", "default_icon": "./images/play-16.png"}, "icons": {"48": "/images/play-256.png", "96": "/images/play-512.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": false}], "web_accessible_resources": [{"resources": ["content.js"], "matches": ["https://www.youtube.com/*"]}]}