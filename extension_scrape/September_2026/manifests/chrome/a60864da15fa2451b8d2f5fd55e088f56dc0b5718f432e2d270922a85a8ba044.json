{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StudyPony - Study Mode for YouTube", "description": "Help parents keep YouTube focused for kids: hide Shorts and recommendations, and allow approved learning channels.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "StudyPony", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "css": ["content-scripts/youtube.css"], "js": ["content-scripts/youtube.js"]}]}