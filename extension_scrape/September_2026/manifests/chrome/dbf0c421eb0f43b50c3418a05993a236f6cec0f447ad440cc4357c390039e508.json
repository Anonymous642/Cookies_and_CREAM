{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Duskly \u2014 Dark Mode for Every Website", "short_name": "Duskly", "version": "1.0.0", "description": "Dark mode that uses each site's own dark theme when it has one. Fast, non-breaking, private. Unlimited sites, free.", "author": "ownCoder", "homepage_url": "https://owncoder.github.io/duskly/", "minimum_chrome_version": "111", "default_locale": "en", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Duskly", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "options/options.html", "permissions": ["storage", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "commands": {"toggle-global": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Turn Duskly on or off everywhere"}, "toggle-site": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Turn Duskly on or off for this site"}}}