{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatMask - Blur Chat & Privacy Screen", "version": "1.0.0", "description": "Blur chats on Messenger, WhatsApp, Zalo & Telegram for privacy. Protect your messages from prying eyes with toggle controls.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.zalo.me/*", "*://*.telegram.org/*", "*://web.telegram.org/*", "*://chat.google.com/*", "*://mail.google.com/*", "*://web.whatsapp.com/*"], "background": {"service_worker": "background/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Toggle ChatMask Sidebar"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.zalo.me/*", "*://*.telegram.org/*", "*://web.telegram.org/*", "*://chat.google.com/*", "*://*.mail.google.com/*", "*://web.whatsapp.com/*"], "js": ["content/content.js"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["sidebar/sidebar.html", "sidebar/sidebar.css", "sidebar/sidebar.js"], "matches": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.zalo.me/*", "*://*.telegram.org/*", "*://web.telegram.org/*", "*://chat.google.com/*", "*://*.mail.google.com/*", "*://web.whatsapp.com/*"]}], "commands": {"toggle_blur": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Toggle Global Blur"}}}