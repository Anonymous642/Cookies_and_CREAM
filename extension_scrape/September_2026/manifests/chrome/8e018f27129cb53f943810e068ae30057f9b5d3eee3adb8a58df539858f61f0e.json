{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Atlas", "version": "1.0.0", "description": "Atlas lets you capture a selected screen region via a shortcut and receive analysis from three smart AI models.", "icons": {"16": "atlas.png", "48": "atlas.png", "128": "atlas.png"}, "action": {}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"start_region_capture": {"suggested_key": {"default": "Alt+X", "mac": "Command+Shift+Q"}, "description": "Start region selection capture"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["wordmark.svg"], "matches": ["https://*/*", "http://*/*"]}]}