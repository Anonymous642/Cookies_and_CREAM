{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecordNest \u2014 Screenshot & Screen Recorder", "short_name": "RecordNest", "version": "1.0.0", "description": "Screenshot, annotate & record your screen in 4K. AI OCR, blur tools, arrows, shapes. Save locally or cloud. Free, fast & private.", "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting", "alarms", "desktopCapture", "tabCapture", "offscreen", "notifications", "clipboardWrite"], "host_permissions": ["https://recordnests.com/*", "https://api.x.ai/*", "https://cdnjs.cloudflare.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"48": "icons/icon48.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "RecordNest", "default_icon": {"48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["capture/content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["editor/editor.html", "welcome/welcome.html", "welcome/welcome.js", "options/options.html", "recorder/recorder.html", "recorder/recorder.js"], "matches": ["<all_urls>"]}], "commands": {"screenshot-region": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Capture region screenshot"}, "screenshot-full": {"suggested_key": {"default": "Alt+F", "mac": "Alt+F"}, "description": "Capture full page screenshot"}, "start-recording": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Start/stop screen recording"}}, "options_page": "options/options.html"}