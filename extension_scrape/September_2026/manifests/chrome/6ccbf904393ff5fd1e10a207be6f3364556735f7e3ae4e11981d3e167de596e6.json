{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Hippo Translator", "description": "Elegantly display translations of words and sentences in tooltips as you browse.", "version": "1.2.2", "manifest_version": 3, "permissions": ["storage", "activeTab"], "host_permissions": ["https://generativelanguage.googleapis.com/", "https://dict.youdao.com/", "https://api.dictionaryapi.dev/*", "https://glosbe.com/*", "https://www.glosbe.com/*", "https://api.openai.com/"], "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "css": ["css/content.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/dict_16.png", "48": "images/dict_48.png", "128": "images/dict_128.png"}}, "icons": {"16": "images/dict_16.png", "48": "images/dict_48.png", "128": "images/dict_128.png"}, "commands": {"toggle-translation": {"suggested_key": {"default": "Alt+T"}, "description": "Toggle translation on/off"}}, "web_accessible_resources": [{"resources": ["images/*.png"], "matches": ["<all_urls>"]}]}