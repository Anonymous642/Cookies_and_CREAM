{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recipe Enhancer", "version": "0.0.0.4", "description": "See recipes in a cleaner and simpler format \u2014 by sizzle. Request any recipe to be added to sizzle.recipes.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Recipe Enhancer"}, "content_scripts": [{"matches": ["*://*.bbcgoodfood.com/recipes/*", "*://*.bbc.co.uk/food/recipes/*", "*://*.simplyrecipes.com/*", "*://*.janespatisserie.com/*", "*://*.allrecipes.com/*"], "js": ["hosts/hosts-bundle.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_start"}], "background": {"service_worker": "background/service-worker.js"}, "host_permissions": ["https://sizzle.recipes/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"]}