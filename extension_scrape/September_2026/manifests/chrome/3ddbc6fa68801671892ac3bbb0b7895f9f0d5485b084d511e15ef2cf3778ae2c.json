{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabby \u2014 Pet Tab", "version": "1.5.0", "description": "Gamified virtual pet that reacts to your tabs. Rewards healthy browsing with skins & achievements. Turn tab chaos into a fun game!", "permissions": ["tabs", "storage", "alarms", "sidePanel", "offscreen", "declarativeNetRequest", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "ad_rules", "enabled": true, "path": "src/dnr-rules.json"}]}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js", "src/overlay.js", "src/pixelrift.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/adeater-hooks.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/adeater.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["overlay-frame.html", "pet/**/*.png"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_popup": "popup.html", "default_title": "Tabby", "default_icon": "icons/icon-128.png"}, "commands": {"toggle-focus": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Toggle Focus/Quiet mode"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https://api.feedtabby.app"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}