{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "quickprompt - Prompt Manager for ChatGPT and Claude", "description": "Never lose prompts again", "version": "0.1.1", "icons": {"16": "icon-16.png", "24": "icon-24.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "author": "Kevin Chan <kevin.gray.chan@gmail.com>", "permissions": ["storage", "unlimitedStorage", "downloads"], "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*"], "action": {"default_title": "quickprompt", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*"]}]}