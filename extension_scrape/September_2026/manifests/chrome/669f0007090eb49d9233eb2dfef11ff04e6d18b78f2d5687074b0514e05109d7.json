{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google SERP Location Changer", "version": "1.0", "description": "Change Google SERP location with one click. Supports Google domains and custom City/ZIP via parameters.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.google.com/*", "*://*.google.co.uk/*", "*://*.google.ca/*", "*://*.google.com.pk/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.google.co.uk/search*", "*://*.google.ca/search*", "*://*.google.com.pk/search*"], "js": ["content.js"], "run_at": "document_start"}]}