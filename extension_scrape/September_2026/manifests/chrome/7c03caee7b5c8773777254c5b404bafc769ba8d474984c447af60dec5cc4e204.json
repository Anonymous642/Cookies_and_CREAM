{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Listium Quick Add", "description": "Add to your lists from any web page. This extension allows you to quickly save text, links, and images to your Listium lists.", "version": "0.8.3", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open the Listium Quick Add popup"}}, "permissions": ["cookies", "storage", "activeTab", "scripting"], "host_permissions": ["https://listium.com/"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals"}, "icons": {"16": "assets/icon.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://listium.com/*"], "js": ["notifier.js"]}], "action": {"default_icon": "assets/icon.png", "default_popup": "src/popup.html"}}