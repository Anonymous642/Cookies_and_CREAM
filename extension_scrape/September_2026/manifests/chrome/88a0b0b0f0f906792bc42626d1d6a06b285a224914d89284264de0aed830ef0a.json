{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenExtract", "version": "1.0.0", "description": "Select a visible region in the current tab and copy its text using local OCR.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "offscreen", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"start-capture": {"suggested_key": {"default": "Alt+X", "mac": "Alt+X"}, "description": "Select an area to extract text"}}, "action": {"default_title": "ScreenExtract history", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}