{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kipr - Bookmark & Extension Sync", "version": "1.0.0", "description": "Save open Chrome tabs and sync browser bookmarks directly into Kipr with AI summaries and reminders.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["bookmarks", "activeTab", "storage", "contextMenus"], "host_permissions": ["http://localhost:3000/*", "http://localhost:4200/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Kipr - Save & Sync Bookmarks", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://localhost:4200/*", "http://localhost:3000/*"], "js": ["content-script.js"]}]}