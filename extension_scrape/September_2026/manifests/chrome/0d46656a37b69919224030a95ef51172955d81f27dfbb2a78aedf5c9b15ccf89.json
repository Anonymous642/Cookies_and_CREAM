{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scopes", "description": "Cinematographer-grade visual scopes for web development \u2014 histogram, waveform, vectorscope, and composition grids.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabCapture", "storage", "activeTab"], "action": {"default_title": "Enable Scopes on this tab"}, "commands": {"invoke-scopes": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Enable Scopes on the current tab"}}, "background": {"service_worker": "background.js"}, "devtools_page": "devtools.html", "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}