{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Qualweb CUI Checker", "version": "1.0", "description": "An evaluation tool to check the Accessibility of Conversational AI Interfaces.", "background": {"service_worker": "./background.bundle.js"}, "options_page": "./options/options.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Click to open panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["storage", "tabs", "sidePanel", "activeTab", "scripting", "tts"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://api.openai.com/*"], "web_accessible_resources": [{"resources": ["resources/common-words-pt.txt", "icons/icon_settings.svg"], "matches": ["http://*/*", "https://*/*"]}]}