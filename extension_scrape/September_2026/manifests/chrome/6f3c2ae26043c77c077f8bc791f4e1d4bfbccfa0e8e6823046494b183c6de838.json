{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vocab Cloud", "version": "1.1.0", "description": "Interrogate any word on a page and get a wordcloud of synonyms, sized by relevance, right where your cursor is.", "minimum_chrome_version": "111", "permissions": ["contextMenus", "storage", "scripting", "activeTab"], "host_permissions": ["https://api.datamuse.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/styles.js", "src/layout.js", "src/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Vocab Cloud \u2014 synonyms for the word under the cursor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"lookup-at-cursor": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Show the synonym cloud for the word under the cursor"}}, "options_ui": {"page": "src/options.html", "open_in_tab": false}}