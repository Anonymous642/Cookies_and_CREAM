{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pomodoro Anywhere", "version": "1.0.0", "description": "A distraction-free Pomodoro timer that overlays a minimal countdown on any tab. 25/5 or custom intervals. Audio alerts. No signup.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup/index.html", "default_title": "Pomodoro Anywhere"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}