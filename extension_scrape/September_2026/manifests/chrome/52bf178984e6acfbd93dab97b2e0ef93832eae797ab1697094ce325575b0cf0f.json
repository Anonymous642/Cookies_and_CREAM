{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SportsHack Draft Assistant", "version": "0.2.2", "description": "Syncs your ESPN, Yahoo, Sleeper, NFL.com or CBS draft to sportshack.ai/live for pick advice. Read-only \u2014 it never drafts for you.", "homepage_url": "https://sportshack.ai", "action": {"default_popup": "popup.html", "default_title": "SportsHack Draft Assistant \u2014 status"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "core/background.js"}, "host_permissions": ["https://fantasy.espn.com/*", "https://football.fantasysports.yahoo.com/*", "https://sleeper.com/*", "https://fantasy.nfl.com/*", "https://*.cbssports.com/*", "https://sportshack.ai/*"], "content_scripts": [{"matches": ["https://fantasy.espn.com/*"], "js": ["dist/espn.js", "dist/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://football.fantasysports.yahoo.com/*"], "js": ["dist/yahoo.js", "dist/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://sleeper.com/*"], "js": ["dist/sleeper.js", "dist/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://fantasy.nfl.com/*"], "js": ["dist/nfl.js", "dist/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://*.cbssports.com/*"], "js": ["dist/cbs.js", "dist/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://sportshack.ai/live*"], "js": ["core/bridge.js"], "run_at": "document_idle"}]}