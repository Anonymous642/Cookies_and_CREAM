{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "El Luchador - Smart Web Assistant", "version": "1.0.0", "description": "AI sidebar that guides, summarizes, analyzes, translates any webpage. Import custom GPTs for enhanced workflows.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs", "offscreen", "tabCapture"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js", "content-scripts/screenshot-capture.js"], "run_at": "document_idle", "all_frames": false}], "side_panel": {"default_path": "sidebar/sidebar.html"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open/close El Luchador Sidebar"}}, "action": {"default_title": "El Luchador AI"}, "web_accessible_resources": [{"resources": ["sidebar/*"], "matches": ["<all_urls>"]}]}