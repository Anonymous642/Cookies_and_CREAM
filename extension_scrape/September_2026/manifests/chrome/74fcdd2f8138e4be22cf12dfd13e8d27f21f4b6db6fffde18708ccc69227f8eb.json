{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Perch", "version": "0.1.0", "description": "Sticky notes that live on the tab, not the URL. Switch pages \u2014 they stay. Close the tab \u2014 they go to Limbo.", "permissions": ["storage", "tabs", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Perch", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["i18n.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"new-note": {"suggested_key": {"default": "Alt+Shift+Y", "mac": "Alt+Shift+Y"}, "description": "\u041d\u043e\u0432\u0430 \u0431\u0435\u043b\u0435\u0436\u043a\u0430 \u0432 \u0442\u043e\u0437\u0438 \u0442\u0430\u0431"}}, "web_accessible_resources": [{"resources": ["note.html", "note.js", "i18n.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}