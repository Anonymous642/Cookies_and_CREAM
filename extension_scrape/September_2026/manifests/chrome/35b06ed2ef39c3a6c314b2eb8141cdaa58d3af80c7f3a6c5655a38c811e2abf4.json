{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chrome API \u767e\u5b9d\u7bb1", "version": "1.0.3", "description": "Chrome API \u6d4b\u8bd5\u5de5\u5177\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684 Chrome \u6269\u5c55 API \u793a\u4f8b\u548c\u6d4b\u8bd5\u529f\u80fd", "permissions": ["tabs", "storage", "notifications", "scripting", "activeTab", "sidePanel", "contextMenus", "downloads", "downloads.open", "alarms", "cookies", "downloads.ui"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/pages/popup/index.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "side_panel": {"default_path": "src/pages/sidepanel/index.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "\u6253\u5f00 ChromeAPIBox"}, "toggle_side_panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "\u5207\u6362\u4fa7\u8fb9\u680f"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "114", "web_accessible_resources": [{"resources": ["src/pages/api-list/*", "src/pages/custom-api/*", "src/pages/about/*", "assets/icons/*"], "matches": ["<all_urls>"]}]}