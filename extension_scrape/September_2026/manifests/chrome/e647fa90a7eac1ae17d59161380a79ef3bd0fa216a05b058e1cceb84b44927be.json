{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Just A List", "version": "1.0.7", "description": "\"Just a List\" is a task management tool and to-do list that gets out of your way. Create, edit, and organize lists with simplicity.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Just A List"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["sidePanel", "storage", "clipboardWrite"], "web_accessible_resources": [{"resources": ["privacy-policy.html"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+J"}, "description": "Open Just A List"}}}