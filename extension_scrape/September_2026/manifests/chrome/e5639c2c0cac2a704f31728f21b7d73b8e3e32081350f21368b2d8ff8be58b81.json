{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkupShot \u2013 Screen Recorder, Full Page Screenshot & Annotation Tool", "version": "1.12.0", "description": "Screen recorder with webcam, full-page screenshots, annotation, website quotes, and social sharing in one tool.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob:; worker-src 'self'; frame-src 'none'; form-action 'none'"}, "action": {"default_popup": "public/popup.html", "default_icon": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}}, "permissions": ["activeTab", "storage", "tabCapture", "alarms", "clipboardWrite"], "optional_permissions": ["desktopCapture"], "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_idle"}], "icons": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "commands": {"capture-select": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Select area to capture"}, "capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Capture full page"}, "open-recorder": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Open screen recorder"}, "open-gallery": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Open gallery"}}}