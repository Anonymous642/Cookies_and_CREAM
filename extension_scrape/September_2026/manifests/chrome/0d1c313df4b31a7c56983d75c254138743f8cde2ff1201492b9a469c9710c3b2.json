{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "De-AI Search", "version": "1.1.0", "author": "Shiva Kerdel", "homepage_url": "https://github.com/s-kerdel/de-ai", "description": "Automatically adjusts search engine settings to filter out AI-generated results", "icons": {"16": "icons/icon-enabled-16.png", "48": "icons/icon-enabled-48.png", "128": "icons/icon-enabled-128.png"}, "permissions": ["storage", "webNavigation", "cookies"], "host_permissions": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.pl/*", "*://www.google.com.br/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.bing.com/*", "*://search.brave.com/*", "*://duckduckgo.com/*", "*://search.yahoo.com/*", "*://www.ecosia.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.ecosia.org/*"], "js": ["ecosia-content.js"], "run_at": "document_start"}, {"matches": ["*://search.brave.com/*"], "js": ["brave-content.js"], "run_at": "document_start"}, {"matches": ["*://duckduckgo.com/*"], "js": ["duckduckgo-content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "De-AI Search"}}