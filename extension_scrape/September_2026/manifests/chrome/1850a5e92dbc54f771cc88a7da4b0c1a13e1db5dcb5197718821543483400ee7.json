{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MCP Locker", "short_name": "MCP Locker", "version": "1.0.0", "description": "See when a site exposes WebMCP, then add it to your MCP Locker from the side panel.", "homepage_url": "https://mcplocker.com", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "MCP Locker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["detect.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle", "world": "ISOLATED"}, {"matches": ["https://mcplocker.com/*", "https://www.mcplocker.com/*"], "js": ["auth-reader.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://mcplocker.com/*", "https://www.mcplocker.com/*"], "js": ["auth-bridge.js"], "run_at": "document_idle", "world": "ISOLATED"}], "permissions": ["sidePanel", "storage"], "host_permissions": ["https://us-central1-mcplocker.cloudfunctions.net/*", "https://securetoken.googleapis.com/*", "https://firestore.googleapis.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self'"}}