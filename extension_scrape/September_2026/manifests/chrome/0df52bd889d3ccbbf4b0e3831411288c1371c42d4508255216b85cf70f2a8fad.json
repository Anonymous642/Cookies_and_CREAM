{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PIPX - Take Control of Picture-in-Picture, Automatically", "description": "Never lose your video again, Automatic Picture-in-Picture (PiP) mode when you switch tabs.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "commands": {"_execute_action": {"suggested_key": {"windows": "Alt+P", "mac": "Alt+P", "chromeos": "Alt+P", "linux": "Alt+P"}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}