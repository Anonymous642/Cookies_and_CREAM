{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VidLingo", "description": "Bilingual subtitles: translates a video's existing captions live. Netflix, Prime Video, YouTube, Bilibili.", "version": "1.0.10", "icons": {"128": "icon-128.png"}, "permissions": ["storage", "sidePanel", "cookies", "offscreen"], "host_permissions": ["https://www.youtube.com/*", "https://api.bilibili.com/*", "https://aisubtitle.hdslb.com/*", "https://*.xhscdn.com/*", "https://*.tiktok.com/*", "https://*.bstarstatic.com/*", "https://*.bilibili.tv/*", "https://*.xiaohongshu.com/*", "https://*.rednote.com/*", "https://api.dictionaryapi.dev/*", "https://*.pv-cdn.net/*", "https://raw.githubusercontent.com/*", "https://github.com/*", "https://*.githubusercontent.com/*"], "web_accessible_resources": [{"resources": ["read-player-response.js"], "matches": ["*://*.youtube.com/*"]}, {"resources": ["shorts-bridge.js"], "matches": ["*://*.youtube.com/*"]}, {"resources": ["watch-timedtext-bridge.js"], "matches": ["*://*.youtube.com/*"]}, {"resources": ["read-xiaohongshu-note.js"], "matches": ["*://*.xiaohongshu.com/*", "*://*.rednote.com/*"]}, {"resources": ["read-tiktok-item.js"], "matches": ["*://*.tiktok.com/*"]}, {"resources": ["read-biliintl-state.js"], "matches": ["*://*.bilibili.tv/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "VidLingo", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.bilibili.com/bangumi/play/ep*", "*://*.bilibili.com/video/*"], "js": ["content-scripts/bilibili.js"]}, {"matches": ["*://*.bilibili.tv/*/play/*"], "js": ["content-scripts/biliintl.js"]}, {"matches": ["*://*.youtube.com/watch*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}, {"matches": ["*://*.netflix.com/watch/*"], "js": ["content-scripts/netflix.js"]}, {"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/page-text.js"]}, {"matches": ["*://*.amazon.co.jp/*/video/