{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AntiSlop", "version": "1.2.0", "description": "Rate web text, screen snips, and PDFs for AI slop. Side panel score + API peer comment drafts powered by InsightITS.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open AntiSlop side panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_page": "options/options.html", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "storage", "contextMenus", "scripting", "sidePanel"], "host_permissions": ["https://www.insightits.com/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/selection-pill.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"antislop-open-panel": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Rate selection (or open AntiSlop side panel)"}, "antislop-capture-region": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Capture region and rate"}, "antislop-rate-selection": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Rate current text selection"}, "antislop-toggle-overlay": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Show or hide last in-page result card"}}, "web_accessible_resources": [{"resources": ["fonts/*", "icons/*"], "matches": ["<all_urls>"]}]}