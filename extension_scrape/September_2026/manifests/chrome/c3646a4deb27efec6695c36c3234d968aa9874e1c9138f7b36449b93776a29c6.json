{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Side Panel", "description": "Browse Reddit in Chrome's side panel without switching tabs. Search posts, add subreddit shortcuts, and resume your last page.", "version": "1.8.5", "minimum_chrome_version": "145", "permissions": ["sidePanel", "declarativeNetRequestWithHostAccess", "storage"], "host_permissions": ["https://*.reddit.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open Reddit side panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["reddit-frame.js"], "all_frames": true, "run_at": "document_start"}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src https://reddit.com https://*.reddit.com"}}