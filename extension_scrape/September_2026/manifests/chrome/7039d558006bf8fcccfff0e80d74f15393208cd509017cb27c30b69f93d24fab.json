{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabComet", "version": "1.0.0", "description": "Turn a galaxy of tabs into a single comet tail.", "permissions": ["tabs", "storage", "unlimitedStorage", "tabGroups", "contextMenus", "bookmarks", "windows"], "background": {"service_worker": "src/background.js"}, "icons": {"16": "assets/logo/icons/icon-16.png", "32": "assets/logo/icons/icon-32.png", "48": "assets/logo/icons/icon-48.png", "128": "assets/logo/icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "TabComet Quick Access", "default_icon": {"16": "assets/logo/icons/icon-16.png", "32": "assets/logo/icons/icon-32.png", "48": "assets/logo/icons/icon-48.png", "128": "assets/logo/icons/icon-128.png"}}, "options_ui": {"page": "src/settings.html", "open_in_tab": true}, "omnibox": {"keyword": "11"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Open TabComet Popup"}, "sweep-all-tabs": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Sweep all tabs in current window"}, "sweep-active-tab": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Sweep active tab"}, "send-all-except-active": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Sweep all tabs except active"}}}