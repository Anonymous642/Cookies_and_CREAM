{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabCanvas - Organize Your Tabs & Windows like Art", "version": "1.1.0", "description": "Turn hundreds of open tabs into a colorful, gallery-like canvas. Folders, colors, notes, art-print exports \u2014 all stored locally.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "unlimitedStorage", "alarms"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"save-window": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Save current window to TabCanvas"}, "restore-last": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Restore the last saved group"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Open TabCanvas dashboard"}}}