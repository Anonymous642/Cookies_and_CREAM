{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LockIn Stack Command Switchboard", "description": "Open and switch workspace links from LockIn Stack command slots.", "version": "0.1.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "sidePanel"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://lockinstack.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "LockIn Stack", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open-workspace": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Ctrl+Shift+L"}, "description": "Open the active LockIn Stack workspace"}, "open-all-links": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Ctrl+Shift+O"}, "description": "Open all active workspace links"}, "next-link": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Ctrl+Shift+K"}, "description": "Open the next workspace link"}, "previous-link": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Alt+Shift+J"}, "description": "Open the previous workspace link"}, "link-slot-1": {"description": "Open workspace link slot 1"}, "link-slot-2": {"description": "Open workspace link slot 2"}, "link-slot-3": {"description": "Open workspace link slot 3"}, "link-slot-4": {"description": "Open workspace link slot 4"}, "link-slot-5": {"description": "Open workspace link slot 5"}, "link-slot-6": {"description": "Open workspace link slot 6"}, "link-slot-7": {"description": "Open workspace link slot 7"}, "link-slot-8": {"description": "Open workspace link slot 8"}, "link-slot-9": {"description": "Open workspace link slot 9"}, "close-other-tabs": {"description": "Close tabs that are not part of the active workspace"}, "toggle-side-panel": {"description": "Open