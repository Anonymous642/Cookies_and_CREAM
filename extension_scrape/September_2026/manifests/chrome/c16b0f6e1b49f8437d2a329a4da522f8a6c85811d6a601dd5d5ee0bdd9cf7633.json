{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Archon Screenshot", "version": "1.0.3", "description": "Screenshot capture with annotation, metadata footers, and Salesforce context.", "permissions": ["activeTab", "storage", "scripting", "clipboardWrite", "debugger"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "optional_host_permissions": ["*://*.my.salesforce.com/*", "*://*.lightning.force.com/*", "*://*.salesforce.com/*", "*://*.visualforce.com/*", "*://*.salesforce-setup.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-toolbar-16.png", "32": "assets/icons/icon-toolbar-32.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture selected area"}, "capture-visible": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Capture visible screen"}, "open-popup": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Archon Screenshot popup"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}