{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speed Reader Extension", "version": "1.0", "description": "A speed reader overlay and popup to quickly read web articles.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://archive.org/*", "https://*.archive.org/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "Speed Read this page", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Open Speed Reader"}}, "web_accessible_resources": [{"resources": ["overlay.html", "overlay.css", "overlay.js", "reader_engine.js", "analytics.js", "jszip.min.js"], "matches": ["<all_urls>"]}]}