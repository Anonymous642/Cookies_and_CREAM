{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tapni - Capture LinkedIn and Gmail Contacts", "description": "Capture LinkedIn profiles and Gmail Contacts in Tapni CRM with one click.", "version": "1.1.3", "short_name": "Tapni", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.linkedin.com/*", "*://mail.google.com/*", "*://tapni.com/*", "*://*.tapni.com/*"], "homepage_url": "https://tapni.com", "background": {"service_worker": "background.js"}, "action": {"default_title": "Tapni - LinkedIn Contact Capture", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/in/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["*://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail.js"]}, {"matches": ["*://*.tapni.com/*", "*://tapni.com/*"], "run_at": "document_idle", "js": ["content-scripts/tapni-auth.js"]}]}