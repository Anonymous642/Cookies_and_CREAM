{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Importador Faturar Criador", "version": "2.0.0", "description": "Importa a ficha e a genealogia completa (pais, av\u00f3s e bisav\u00f3s) de um animal do site da ABCCMM para o seu plantel no Faturar Criador.", "permissions": ["storage"], "host_permissions": ["https://novocriador.faturar.digital/*", "http://faturar-criador-novo.test/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://abccmm.org.br/animais*", "https://www.abccmm.org.br/animais*", "http://abccmm.org.br/animais*", "http://www.abccmm.org.br/animais*"], "js": ["src/content/abccmm.js"], "run_at": "document_idle"}], "action": {"default_title": "Importador ABCCMM \u2013 Faturar Criador", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/logo.png"}, "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["https://abccmm.org.br/*", "https://www.abccmm.org.br/*", "http://abccmm.org.br/*", "http://www.abccmm.org.br/*"]}]}