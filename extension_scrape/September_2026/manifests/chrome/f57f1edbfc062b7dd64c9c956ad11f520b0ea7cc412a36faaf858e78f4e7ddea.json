{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindPause", "version": "1.2.0", "description": "A lightweight mindfulness extension to combat digital fatigue with scheduled breathing exercises and focus mode", "author": "Digi Logic Labs", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_title": "MindPause"}, "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "activeTab", "contextMenus", "webNavigation", "idle"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle Focus Mode on/off"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Open MindPause for breathing exercise"}}, "web_accessible_resources": [{"resources": ["blocked.html", "assets/*"], "matches": ["https://*/*", "http://*/*"]}]}