{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DraftTrack \u2014 See How a Doc Was Written", "version": "1.0.1", "description": "See how a Google Doc was written: writing timeline, flagged pastes, and typed-vs-pasted view. By Classroom Ready AI.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Analyze this doc's writing process with DraftTrack", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["content.js"], "run_at": "document_idle"}], "host_permissions": ["https://docs.google.com/*"], "permissions": ["tabs", "storage"], "web_accessible_resources": [{"resources": ["report.html", "assets/*", "icons/*", "fonts/*"], "matches": ["https://docs.google.com/*"]}]}