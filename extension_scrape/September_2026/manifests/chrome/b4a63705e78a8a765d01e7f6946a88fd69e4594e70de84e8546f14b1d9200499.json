{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YetiProxies", "description": "YetiProxies: proxy manager + built-in antidetect (UA/WebGL/canvas/audio/timezone spoofing, DNS leak guard, fingerprint isolation).", "version": "1.18.2", "minimum_chrome_version": "108", "permissions": ["proxy", "storage", "tabs", "scripting", "alarms", "privacy", "webRequest", "webRequestAuthProvider", "notifications", "downloads", "declarativeNetRequest", "cookies", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "YetiProxies", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-detect.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://yetiproxies.com/*", "https://*.yetiproxies.com/*"], "js": ["content-yeti-auth.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://2ip.ru/*", "https://*.2ip.ru/*"], "js": ["content-2ip.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["content-spoof.js"], "matches": ["<all_urls>"]}], "commands": {"rotate-session": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Rotate proxy session ID"}, "toggle-proxy": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Connect or disconnect active proxy"}, "next-profile": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Switch to next saved profile"}}}