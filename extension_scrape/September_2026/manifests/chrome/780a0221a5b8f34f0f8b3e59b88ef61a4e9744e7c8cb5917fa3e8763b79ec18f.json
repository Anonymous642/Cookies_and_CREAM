{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Catalog Enhancer", "version": "1.6.3", "description": "Optional Catalog Enhancer companion for Shopify images, colour-level sales, privacy controls and CPC guidance in Meta Ads Manager.", "permissions": ["storage", "scripting"], "host_permissions": ["https://adsmanager.facebook.com/*", "https://business.facebook.com/*", "https://www.dailyseller.co/*", "https://cdn.shopify.com/*", "https://*.shopifycdn.com/*"], "background": {"service_worker": "src/background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Catalog Enhancer", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "src/options.html", "content_scripts": [{"matches": ["https://adsmanager.facebook.com/*", "https://business.facebook.com/*"], "js": ["src/shared.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}]}