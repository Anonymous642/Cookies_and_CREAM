{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleanPlay", "version": "1.3.4", "description": "Skips YouTube sponsors, intros, outros & fluff using SponsorBlock & AI. Requires optional CleanPlay account for AI features.", "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://sponsor.ajay.app/*", "https://api.cleanplay.app/*", "https://huggingface.co/*", "https://cdn-lfs.huggingface.co/*", "https://api.cleanplay.app/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["lib/storage-gatekeeper.js", "content/content.js"], "css": ["content/content.css", "content/overlay.css"], "run_at": "document_start"}, {"matches": ["https://*.cleanplay.app/*"], "js": ["lib/storage-gatekeeper.js", "content/auth-listener.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["content/modules/*.js", "content/modules/videoTypeDetector/*.js", "shared/videoTypes.js", "config.js", "lib/storage-gatekeeper.js", "background/crypto-storage.js", "assets/icon-48.svg"], "matches": ["https://www.youtube.com/*", "https://*.cleanplay.app/*"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+S"}, "description": "Open CleanPlay Menu"}, "force_skip": {"suggested_key": {"default": "Alt+Right", "mac": "Alt+Right"}, "description": "Force Skip Current Segment", "global": false}}}