{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TokenBurner v2 \u2014 Orquestador de Cuotas IA", "version": "2.0.0", "description": "Monitor aut\u00f3nomo de cuotas de IA multi-proveedor (Claude, ChatGPT, Gemini, OpenCode). 100% en Chrome, sin servidores externos.", "permissions": ["storage", "cookies", "alarms", "tabs"], "host_permissions": ["https://claude.ai/*", "https://a.claude.ai/*", "https://chatgpt.com/*", "https://*.google.com/*", "https://aistudio.google.com/*", "https://gemini.google.com/*", "https://*.googleusercontent.com/*", "https://opencode.ai/*", "https://*.opencode.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "TokenBurner v2", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://a.claude.ai/*"], "js": ["content-claude.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["content-chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://*.google.com/*", "https://aistudio.google.com/*", "https://gemini.google.com/*", "https://*.googleusercontent.com/*"], "js": ["content-gemini.js"], "run_at": "document_idle"}, {"matches": ["https://opencode.ai/*", "https://*.opencode.ai/*"], "js": ["content-opencode.js"], "run_at": "document_idle"}]}