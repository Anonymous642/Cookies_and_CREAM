{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebChef-Blur", "version": "3.4", "author": "AhmedFathy", "description": "Secure privacy control for WhatsApp Web with adjustable blur levels", "permissions": ["storage", "alarms", "tabs", "notifications"], "host_permissions": ["https://web.whatsapp.com/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle blur on/off instantly"}}}