{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Dub \u2013 Screen Recorder & AI Tutorial Maker", "description": "Record a window, a tab, or your screen. ScreenDub writes the script and narrates it for you.", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://www.screendub.io", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "scripting", "activeTab", "tabs", "storage", "unlimitedStorage", "webNavigation", "notifications"], "commands": {"stop-recording": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Stop the ScreenDub recording"}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume the ScreenDub recording"}, "discard-recording": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Discard the ScreenDub recording"}}, "action": {"default_title": "Screen Dub", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "web_accessible_resources": [{"resources": ["bridge.html"], "matches": ["https://www.screendub.io/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}