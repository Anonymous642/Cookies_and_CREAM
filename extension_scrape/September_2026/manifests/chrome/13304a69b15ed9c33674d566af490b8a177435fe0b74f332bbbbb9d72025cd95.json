{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Norget - Smart Bookmark Manager", "short_name": "Norget", "version": "1.2.2", "description": "Save a page in one click. Norget keeps the text, so you can ask questions about what you've read and get answers with sources.", "homepage_url": "https://norget.io", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://norget.io/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Save to Norget"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["scripts/twitter.js"], "css": ["styles/inject.css"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["scripts/instagram.js"], "css": ["styles/inject.css"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://norget.io/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save current page to Norget"}, "quick_save": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Quick save without popup"}}}