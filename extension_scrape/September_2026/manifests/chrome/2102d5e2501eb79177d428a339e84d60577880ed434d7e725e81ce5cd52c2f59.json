{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Filter for X (Twitter)", "version": "1.6.2", "description": "Filters out tweets with images, videos, and links on X (Twitter). Enjoy a text-only feed with customizable filtering options.", "author": "Justin Green", "homepage_url": "https://www.netfilterpro.com", "permissions": ["storage"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "action": {"default_popup": "popup.html", "default_title": "X Text-Only Filter", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "css": ["filter-styles.css"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "minimum_chrome_version": "88"}