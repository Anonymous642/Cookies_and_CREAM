{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EchoVeil", "version": "0.2.0", "description": "Real-time AI voice conversion for browser audio", "permissions": ["tabCapture", "offscreen", "storage", "scripting", "activeTab", "alarms"], "host_permissions": ["http://localhost:8765/*", "https://echoveil.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://echoveil.app"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["face-window.html", "face-window.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-echoveil": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Toggle EchoVeil on/off"}}}