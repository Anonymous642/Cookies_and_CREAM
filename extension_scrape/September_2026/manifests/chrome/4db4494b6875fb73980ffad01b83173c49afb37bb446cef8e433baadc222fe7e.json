{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ben's Tabs Sorter", "version": "1.3.0", "description": "I needed a tab sorter, so I made one.", "icons": {"48": "icons/bens-tab-sorter48.png", "128": "icons/bens-tab-sorter128.png"}, "action": {"default_icon": {"48": "icons/bens-tab-sorter48.png", "128": "icons/bens-tab-sorter128.png"}, "default_title": "Tabs sorter"}, "permissions": ["tabs", "storage", "tabGroups", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}}, "group-by-domain": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Group tabs by domain"}}}