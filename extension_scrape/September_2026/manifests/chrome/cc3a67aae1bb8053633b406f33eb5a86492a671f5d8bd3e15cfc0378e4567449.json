{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dutch Subtitle Translator", "version": "1.7.0", "description": "Live-translates Dutch subtitles on Videoland, KIJK, NPO, and Play into 6 languages, or just enlarges the original Dutch text.", "permissions": ["storage"], "host_permissions": ["*://*.videoland.com/*", "*://*.kijk.nl/*", "*://*.npo.nl/*", "*://*.play.tv/*", "https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*"], "background": {"service_worker": "background.js"}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle Dutch Subtitle Translator on/off"}}, "content_scripts": [{"matches": ["*://*.videoland.com/*", "*://*.kijk.nl/*", "*://*.npo.nl/*", "*://*.play.tv/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Dutch Subtitle Translator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}