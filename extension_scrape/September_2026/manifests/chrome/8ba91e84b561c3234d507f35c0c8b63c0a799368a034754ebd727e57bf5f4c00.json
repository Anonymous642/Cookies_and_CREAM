{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mask Everything - Subtitle", "version": "1.5", "description": "A versatile browser extension allows users to easily mask/blur any content for aiding language learning, such as subtitle.", "author": "azimuth", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "background": {"service_worker": "background.js"}, "commands": {"key-toggle-blur-overlay": {"suggested_key": {"default": "Alt+B", "mac": "Option+B"}, "description": "Toggle blur overlay On/Off"}}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "js": ["common.js", "content.js"]}]}