{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X-Ray: SocialScope", "version": "4.0.0", "description": "Extensi\u00f3n para investigaci\u00f3n y an\u00e1lisis de datos p\u00fablicos en X (Twitter), con exportaci\u00f3n a CSV/XLSX.", "permissions": ["activeTab", "alarms", "downloads", "scripting", "storage", "tabs"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["api_probe.js"], "run_at": "document_start"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["export_utils.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["bearer_inject.js"], "matches": ["https://twitter.com/*", "https://x.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"start-capture": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Iniciar captura de tweets"}, "stop-export": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Detener y exportar datos"}}}