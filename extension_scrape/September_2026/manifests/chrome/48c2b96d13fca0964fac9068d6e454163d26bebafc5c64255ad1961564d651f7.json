{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Audio Anchor (Tab Mute Protection)", "version": "26.9.21.911", "description": "Protect your audio source by designating an anchor tab. Other tabs that play audio will be automatically muted.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["tabs", "storage", "notifications"]}