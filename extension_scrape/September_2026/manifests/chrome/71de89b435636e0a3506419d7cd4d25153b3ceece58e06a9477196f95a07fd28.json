{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabProxy \u2014 Proxy per Tab, User-Agent & Wallet Notes", "description": "Give every tab its own proxy, User-Agent, wallet and notes. Built for airdrop and multi-account work \u2014 no antidetect browser.", "version": "0.1.0", "short_name": "TabProxy", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "120", "permissions": ["proxy", "storage", "tabs", "tabGroups", "identity", "webRequest", "webRequestAuthProvider", "declarativeNetRequest", "scripting", "webNavigation", "sidePanel", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "TabProxy", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open TabProxy"}}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/tab-badge.js"]}]}