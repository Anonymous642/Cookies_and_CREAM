{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slowpebble", "version": "0.2.3", "description": "Shows the Slowpebble block screen on blocked sites and adds browser-layer blocking against encrypted-DNS bypasses.", "minimum_chrome_version": "108", "permissions": ["alarms", "declarativeNetRequest"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-guard.js"], "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["sw-guard.js"], "run_at": "document_start", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "Slowpebble \u2014 on"}, "icons": {"128": "pebble-128.png"}}