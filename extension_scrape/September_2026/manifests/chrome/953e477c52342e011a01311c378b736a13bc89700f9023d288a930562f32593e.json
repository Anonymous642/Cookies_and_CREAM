{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Acegent", "version": "1.0.48", "description": "Disclosed real-time AI interview-prep: detects on-page questions and streams answers. Copy or autofill. No API key needed.", "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "activeTab", "scripting", "contextMenus", "clipboardWrite", "tabCapture", "offscreen", "webNavigation"], "host_permissions": ["https://acegent.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Acegent", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["icons/icon128.png", "icons/icon48.png"], "matches": ["<all_urls>"]}], "commands": {"scan-screen": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Scan the visible page with Acegent (reads images, not just text)"}}}