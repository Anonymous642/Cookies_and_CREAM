{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PodcastsAI", "version": "1.0.0", "description": "Summarize the podcast or video you are watching, without leaving the page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Summarize this episode", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_page": "options.html", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.podcasts-ai.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://open.spotify.com/*", "https://podcasts.apple.com/*"], "js": ["src/content.js"], "css": ["src/tokens.css", "src/content.css"], "run_at": "document_idle"}]}