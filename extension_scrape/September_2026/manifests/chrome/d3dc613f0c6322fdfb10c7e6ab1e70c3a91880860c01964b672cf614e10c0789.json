{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WinLog", "description": "Log your wins directly from your browser.", "version": "1.0.1", "icons": {"16": "logo-icon-white-16.png", "48": "logo-icon-white-48.png", "128": "logo-icon-white-128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "logo-icon-white-16.png", "48": "logo-icon-white-48.png", "128": "logo-icon-white-128.png"}}, "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://api.winlog.ai/api/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.winlog.ai;"}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}