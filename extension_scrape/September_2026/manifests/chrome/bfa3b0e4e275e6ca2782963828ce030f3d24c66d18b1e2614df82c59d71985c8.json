{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Group Manager", "version": "1.0.0", "description": "Keyboard-first tab group management for Chrome", "permissions": ["tabGroups", "scripting", "activeTab"], "background": {"service_worker": "background/service-worker.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"navigateLeft": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Move focus left into tab group"}, "navigateRight": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Move focus right into tab group"}, "createGroup": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Create new group"}, "listGroups": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "List all groups"}, "swapLeft": {"description": "Swap tab to the left"}, "swapRight": {"description": "Swap tab to the right"}, "openNewTab": {"description": "Open new tab in group"}, "removeFromGroup": {"description": "Remove tab from group"}, "toggleCollapse": {"description": "Toggle group collapse"}, "closeGroup": {"description": "Close group"}, "renameGroup": {"description": "Rename group"}, "cycleColor": {"description": "Cycle group color"}}}