{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Substack Notes Scheduler", "version": "2.5.0", "description": "Schedule your Substack Notes in advance. Write now, publish later.", "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting", "cookies"], "host_permissions": ["https://substack.com/*", "https://*.substack.com/*", "https://substack-note-scheduler.up.railway.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://substack.com/*", "https://*.substack.com/*"], "js": ["content.js"], "css": ["content.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}