{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFlip", "version": "0.1.3", "description": "Arc-style MRU tab switcher.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-512.png"}, "action": {"default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-512.png"}}, "permissions": ["tabs", "storage", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content_script.js"], "run_at": "document_start"}], "commands": {"toggle_switcher": {"suggested_key": {"default": "Alt+A", "mac": "MacCtrl+A"}, "description": "Open TabFlip"}}, "web_accessible_resources": [{"resources": ["assets/default-favicon.svg", "assets/default-favicon-dark.svg"], "matches": ["<all_urls>"]}], "options_page": "options/options.html"}