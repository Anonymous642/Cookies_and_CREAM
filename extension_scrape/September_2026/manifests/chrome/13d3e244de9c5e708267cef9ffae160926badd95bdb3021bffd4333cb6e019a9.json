{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WatchNest", "version": "0.1.10", "description": "Watch Netflix, Disney+, Prime, YouTube & HBO Max together. Synced playback, live chat, camera calls & AI features. Free for up to 4.", "homepage_url": "https://www.watchnest.party", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.netflix.com/*", "https://www.disneyplus.com/*", "https://www.primevideo.com/*", "https://www.youtube.com/*", "https://www.hbomax.com/*", "https://www.watchnest.party/*", "https://api.watchnest.party/*"], "background": {"service_worker": "dist/service-worker.js"}, "action": {"default_popup": "dist/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://www.disneyplus.com/*", "https://www.primevideo.com/*", "https://www.youtube.com/*", "https://www.hbomax.com/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "externally_connectable": {"matches": ["https://www.watchnest.party/*", "https://watchnest.party/*"]}, "web_accessible_resources": [{"resources": ["dist/playerBridge.js", "dist/playerBridgeNetflix.js", "dist/playerBridgeDisney.js", "dist/playerBridgePrime.js", "dist/sidebar.html", "dist/sidebar.js", "dist/sidebar.css", "dist/firebase-init.js", "assets/branding/watchnest-logo-mark.svg", "assets/branding/watchnest-wordmark.svg", "assets/branding/watchnest-logo-lockup.svg"], "matches": ["https://www.netflix.com/*", "https://www.disneyplus.com/*", "https://www.primevideo.com/*", "https://www.youtube.com/*", "https://www.hbomax.com/*"]}]}