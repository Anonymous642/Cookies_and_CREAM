{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RhymeTime - YouTube Music Lyrics", "version": "1.0.1", "description": "Display synchronized lyrics for YouTube Music. Fetches and displays real-time lyrics that sync with the currently playing track.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "RhymeTime - YouTube Music Lyrics"}, "options_ui": {"page": "setup.html", "open_in_tab": true}}