{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlockBuddy", "version": "0.1.0", "description": "Schedule website access and set daily limits with a calming zen block page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["alarms", "storage", "tabs", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "BlockBuddy", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "incognito": "spanning", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}