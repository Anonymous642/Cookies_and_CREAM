{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MPA Vision Video Speed Control", "version": "2.0.1", "description": "Premium video speed control with native UI.", "author": "MPA Studio", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/512.png", "48": "icons/512.png", "128": "icons/512.png"}}, "icons": {"16": "icons/512.png", "48": "icons/512.png", "128": "icons/512.png"}, "default_locale": "en_US", "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"mac": "Alt+Y", "linux": "Ctrl+Shift+J", "windows": "Ctrl+Shift+Y"}}, "step_down": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Decrease playback speed"}, "step_up": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Increase playback speed"}}}