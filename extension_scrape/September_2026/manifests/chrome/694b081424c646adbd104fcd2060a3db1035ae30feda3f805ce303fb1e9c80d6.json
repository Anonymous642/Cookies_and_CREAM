{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Laze Agent - AI Browser Assistant", "short_name": "Laze Agent", "description": "AI browser assistant for Chrome: search, summarize pages, compare sources, click, type, manage tabs, and schedule web tasks.", "version": "0.1.6", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "scripting", "storage", "sidePanel", "bookmarks", "history", "downloads", "alarms", "notifications", "contextMenus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "assets/background.js", "type": "module"}, "sandbox": {"pages": ["sandbox-viewer.html"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https:;", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"}, "action": {"default_title": "Laze Agent - AI Browser Assistant", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "settings.html", "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/windowOpenHook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"], "run_at": "document_idle"}]}