{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Phasoric Web Clipper", "version": "2.0.0", "description": "Capture the web as durable, connected Markdown with local OCR, templates, offline sync, and approval-first agent access.", "minimum_chrome_version": "116", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "contextMenus", "sidePanel", "offscreen"], "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Open Phasoric Clipper", "default_icon": {"16": "icon16.png", "32": "icon32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "externally_connectable": {"matches": ["https://phasoric.com/*", "https://www.phasoric.com/*", "https://basaltnotes.com/*", "https://www.basaltnotes.com/*", "http://localhost:3000/*", "http://localhost:5173/*", "http://localhost:18487/*", "http://127.0.0.1:18487/*"], "ids": ["*"]}, "commands": {"quick-clip": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Option+Shift+P"}, "description": "Quick clip this page"}, "highlight-page": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Option+Shift+H"}, "description": "Highlight this page"}}}