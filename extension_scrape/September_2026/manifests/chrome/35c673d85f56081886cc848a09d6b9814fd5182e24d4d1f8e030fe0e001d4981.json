{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Summaries - Quick Read Social Media Posts", "version": "2.0.1", "description": "AI-powered text summarizer for social media. Instant summaries in 16 languages. Save time reading.", "permissions": ["activeTab", "storage", "clipboardWrite"], "host_permissions": ["https://www.facebook.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://www.linkedin.com/*", "https://chatai.expndy.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Summaries Settings"}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["content/common.js", "content/facebook.js"], "css": ["content/styles.css"], "run_at": "document_idle"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/common.js", "content/twitter.js"], "css": ["content/styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*"], "js": ["content/common.js", "content/reddit.js"], "css": ["content/styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content/common.js", "content/linkedin.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "commands": {"summarize-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize selected text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}