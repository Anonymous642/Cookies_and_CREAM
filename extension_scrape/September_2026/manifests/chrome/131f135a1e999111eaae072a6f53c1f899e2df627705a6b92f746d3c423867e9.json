{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeutschChat \u2014 YouTube ile Almanca \u00d6\u011fren", "version": "1.0.52", "description": "Her Almanca YouTube videosunu derse \u00e7evir. Almanca-T\u00fcrk\u00e7e \u00e7ift altyaz\u0131, her kelimeye t\u0131kla, anlam\u0131n\u0131 ve dil bilgisini g\u00f6r.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://deutschchat.app/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "DeutschChat \u2014 account", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://deutschchat.app/*"]}, "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["https://www.youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["inject.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["brand.js", "content.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://deutschchat.app/*"], "js": ["site-bridge.js"], "run_at": "document_idle"}]}