{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Proxy Pilot", "description": "Proxy control for Chrome with automatic authentication, live analytics, and enterprise-grade security. Powered by WAPI.", "version": "1.2.0", "permissions": ["storage", "proxy", "webRequest", "webRequestAuthProvider", "declarativeNetRequestWithHostAccess", "alarms"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Proxy Pilot \u2022 Powered by WAPI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "commands": {"toggle-proxy": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Toggle proxy on/off"}, "next-profile": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Switch to next profile"}, "prev-profile": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Switch to previous profile"}}}