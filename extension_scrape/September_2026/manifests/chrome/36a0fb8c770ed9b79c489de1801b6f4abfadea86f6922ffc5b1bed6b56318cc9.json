{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Me-Nasoma", "description": "Listen to any article with natural Me-Nasoma Premium voices \u2014 the words highlight on the page as it reads.", "version": "1.1.0", "short_name": "Me-Nasoma", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://me-nasoma.com/*"], "web_accessible_resources": [{"resources": ["voices/*.webp"], "matches": ["*://*/*"]}, {"resources": ["auth-callback.html"], "matches": ["https://auth.me-nasoma.com/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}], "commands": {"read-page": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read the current page aloud"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Read this page with Me-Nasoma", "default_popup": "popup.html"}}