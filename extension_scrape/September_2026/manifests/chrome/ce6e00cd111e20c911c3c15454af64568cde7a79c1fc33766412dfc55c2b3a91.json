{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unlost", "version": "1.0.0", "description": "Save browser sessions without closing tabs. Backups live in Bookmarks so they survive uninstall and Chrome updates.", "minimum_chrome_version": "109", "permissions": ["tabs", "tabGroups", "bookmarks", "storage", "unlimitedStorage", "downloads", "alarms"], "background": {"service_worker": "background.js"}, "commands": {"save-window": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Unlost: save current window as a session"}, "restore-last": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Unlost: restore the most recent session"}}, "action": {"default_title": "Unlost", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}