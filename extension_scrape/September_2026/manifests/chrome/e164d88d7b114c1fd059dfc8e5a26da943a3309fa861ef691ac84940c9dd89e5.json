{"manifest_version": 3, "name": "FurAffinity Message Notifier", "version": "1.3.0", "minimum_chrome_version": "116", "description": "A notifier for FurAffinity messages.", "short_name": "FA Notifier", "update_url": "https://clients2.google.com/service/update2/crx", "background": {"service_worker": "js/service_worker.js", "type": "module"}, "action": {"default_icon": "img/fa_gray_128.png", "default_popup": "popup.html"}, "icons": {"19": "img/fa_19.png", "48": "img/fa_48.png", "128": "img/fa_128.png"}, "options_page": "options.html", "options_ui": {"open_in_tab": false, "page": "options.html"}, "permissions": ["storage", "alarms", "offscreen", "cookies"], "optional_permissions": ["notifications"], "host_permissions": ["https://www.furaffinity.net/", "https://furaffinity.net/"], "content_scripts": [{"js": ["js/injector.js"], "matches": ["https://www.furaffinity.net/msg/*"], "run_at": "document_end"}]}