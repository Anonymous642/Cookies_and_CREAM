{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "I Don't Want To See That on Jira", "version": "1.0.0", "description": "Reliably hides specified elements on Jira issue pages.", "permissions": ["scripting", "tabs", "storage", "webNavigation", "alarms"], "host_permissions": ["https://*.atlassian.net/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "images/icon128.png"}}, "commands": {"activate-picker": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Activate the element picker"}}, "icons": {"128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["picker.js", "notifier.js", "error_notifier.js"], "matches": ["https://*.atlassian.net/*"]}]}