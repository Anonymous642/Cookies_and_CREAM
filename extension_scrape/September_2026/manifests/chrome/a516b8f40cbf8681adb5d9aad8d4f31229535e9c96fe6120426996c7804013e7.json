{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Guard", "description": "Tab cleanup, clean search, web capture, local screen recording, dark mode, media saving, audio boost, and focus blocking for Chrome.", "version": "0.10.0", "minimum_chrome_version": "116", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["activeTab", "alarms", "downloads", "offscreen", "search", "scripting", "sidePanel", "tabCapture", "tabs", "storage", "tabGroups"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Browser Guard", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_popup": "src/popup/popup.html"}, "chrome_url_overrides": {"newtab": "src/newtab/newtab.html"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "commands": {"open-command-center": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the Browser Guard command center"}, "snooze-current-tab": {"description": "Snooze the current tab for one hour"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/darkmode/darkmode.js"], "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/media/x-media-content.js"], "run_at": "document_start"}, {"matches": ["https://*.facebook.com/*"], "js": ["src/media/fb-media-content.js"], "run_at": "document_start"}, {"matches": ["https://*.tiktok.com/*"], "js": ["src/media/tt-media-content.js"], "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "css": ["src/media/media-overlay.css"], "js": ["src/media/media-overlay.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/s