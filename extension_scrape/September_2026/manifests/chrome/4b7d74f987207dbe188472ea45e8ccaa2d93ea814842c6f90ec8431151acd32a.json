{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HydrateFocus - Smart Water Reminder", "version": "1.0.0", "description": "Smart water reminder that respects your meetings. Auto-detects Google Meet, Zoom, Teams and screen sharing to delay notifications.", "permissions": ["alarms", "storage", "notifications", "tabs", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "HydrateFocus Settings"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["detector.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content-overlay.css", "content-overlay.js", "icons/*"], "matches": ["<all_urls>"]}]}