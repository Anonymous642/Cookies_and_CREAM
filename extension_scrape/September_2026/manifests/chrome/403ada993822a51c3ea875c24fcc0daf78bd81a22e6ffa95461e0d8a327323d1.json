{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Return Last.fm Shoutbox", "description": "Brings back inline shouts on Last.fm pages", "version": "0.2.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "host_permissions": ["*://*.last.fm/*"], "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Return Last.fm Shoutbox", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.last.fm/*"], "js": ["content-scripts/lastfm-shoutbox.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/lastfm-shoutbox.css"], "use_dynamic_url": true, "matches": ["*://*.last.fm/*"]}]}