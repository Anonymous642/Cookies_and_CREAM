{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Weaver", "version": "1.0", "description": "Captures a scrolling screenshot of the entire active webpage.", "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture Full Page"}, "capture-custom": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture Custom Area"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["pdfobject.min.js"], "matches": ["<all_urls>"]}]}