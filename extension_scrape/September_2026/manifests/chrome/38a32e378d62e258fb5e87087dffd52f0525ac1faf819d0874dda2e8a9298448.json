{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Scam Detect", "short_name": "ScamDetect", "version": "1.0.1", "manifest_version": 3, "description": "Extracts English tweets from X.com and sends them to a backend for scam detection. This is part of a research work demonstration.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://x.com/*", "https://www.x.com/*", "https://citizenhelper.orc.gmu.edu/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["warning.png", "images/thumbsup.svg", "images/thumbsdown.svg"], "matches": ["https://x.com/*", "https://www.x.com/*"]}], "action": {"default_title": "ScamDetect"}}