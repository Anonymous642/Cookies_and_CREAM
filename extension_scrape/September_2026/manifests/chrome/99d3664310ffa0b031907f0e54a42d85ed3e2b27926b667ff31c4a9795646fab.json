{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sessions & Focus", "version": "1.0.0", "description": "Save open tabs as named sessions and restore them anytime. Block distracting sites with a built-in Focus Mode timer.", "author": "Sessions & Focus", "permissions": ["tabs", "storage", "declarativeNetRequest", "alarms"], "action": {"default_title": "Sessions & Focus", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}