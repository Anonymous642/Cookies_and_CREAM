{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinguaTweet", "version": "1.2.0", "description": "Auto-translate tweets on X.com seamlessly. No setup needed.", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_popup": "popup.html", "default_title": "LinguaTweet", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://translate.googleapis.com/*"]}