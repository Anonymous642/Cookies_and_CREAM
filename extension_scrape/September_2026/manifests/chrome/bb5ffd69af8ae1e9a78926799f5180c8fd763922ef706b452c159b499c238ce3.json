{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floqer", "description": "Browser Extension to directly send your leads to your Floqer Workflows from LinkedIn and Sales Navigator.", "version": "2.0.13", "action": {"default_title": "Floqer Utility", "default_icon": {"16": "Floqer.png", "48": "Floqer.png", "128": "Floqer.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' 'unsafe-inline';"}, "background": {"service_worker": "js/background.js"}, "icons": {"16": "Floqer.png", "48": "Floqer.png", "128": "Floqer.png"}, "host_permissions": ["*://*.linkedin.com/*", "*://*.salesnavigator.linkedin.com/*", "*://dev-workflows.netlify.app/*", "*://*.google.com/*", "*://app.floqer.com/*", "*://tourmaline-tiramisu-d15531.netlify.app/*", "*://floqer-dev-staging.netlify.app/*", "*://localhost/*"], "web_accessible_resources": [{"resources": ["*.css", "*/*.otf", "*.html"], "matches": ["https://*/*", "http://*/*"]}], "externally_connectable": {"matches": ["http://*/*", "https://*/*"]}, "permissions": ["webNavigation", "tabs", "storage", "cookies", "unlimitedStorage", "sidePanel"], "side_panel": {"default_path": "panel.html"}, "sidebar_action": {"default_panel": "panel.html", "default_title": "Floqer", "default_icon": "Floqer.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "http://*.linkedin.com/*"], "js": ["js/content-script.js"], "run_at": "document_idle"}]}