{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DontPhishMe", "version": "1.0.0", "description": "Real-time phishing detection for Gmail and Outlook. Analyzes URLs, emails, and pages to protect you from phishing attacks.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["analyzers/urlAnalyzer.js", "analyzers/emailAnalyzer.js", "analyzers/scorer.js", "content/gmail.js"], "run_at": "document_idle"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["analyzers/urlAnalyzer.js", "analyzers/emailAnalyzer.js", "analyzers/scorer.js", "content/outlook.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}