{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Seermind \u2014 your AI memory, on your device", "version": "0.6.0", "description": "Local AI memory for Claude, ChatGPT & Gemini. Save chats on your device and bring context back. Zero cloud.", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "offscreen"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://huggingface.co/*", "https://*.hf.co/*", "https://cdn.jsdelivr.net/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.hf.co https://*.huggingface.co https://cdn.jsdelivr.net"}, "web_accessible_resources": [{"resources": ["vendor/*.wasm"], "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"]}], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Seermind"}, "save-current-chat": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Save the current chat to Seermind"}}, "action": {"default_popup": "popup.html", "default_title": "Seermind"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"], "js": ["store.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}