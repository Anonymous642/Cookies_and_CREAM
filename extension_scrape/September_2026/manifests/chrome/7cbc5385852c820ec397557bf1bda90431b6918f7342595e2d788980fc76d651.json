{"update_url": "https://clients2.google.com/service/update2/crx", "name": "StudieBoost Chrome Extension", "short_name": "Studieboost", "description": "Din AI-studiepartner i browseren. Scan tekst fra billeder, mark\u00e9r og sp\u00f8rg. Stud\u00e9r smartere, ikke l\u00e6ngere.", "version": "0.6.4", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Studieboost", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "tabs", "storage", "contextMenus"], "host_permissions": ["https://api.studieboost.dk/*", "https://studieboost.dk/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/utils.js", "content/dock.js", "content/overlay.js", "content/quickAsk.js", "content/index.js"], "run_at": "document_idle"}], "commands": {"start-selection": {"description": "Scan & sp\u00f8rg \u2014 marker et omr\u00e5de p\u00e5 sk\u00e6rmen og sp\u00f8rg AI om det. Hvis du har tekst markeret, springes scanningen over.", "suggested_key": {"default": "Alt+Q", "mac": "Command+Shift+E"}}, "quick-ask": {"description": "\u00c5bn QuickAsk (hurtigt sp\u00f8rgsm\u00e5l med streaming svar)", "suggested_key": {"default": "Alt+W", "mac": "Command+Shift+F"}}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["icons/*.png", "fonts/*.otf"], "matches": ["<all_urls>"]}]}