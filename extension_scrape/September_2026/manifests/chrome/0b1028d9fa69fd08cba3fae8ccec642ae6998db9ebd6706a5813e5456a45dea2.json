{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UnReposter - Repost Remover for TikTok & Instagram", "short_name": "UnReposter", "version": "1.1.1", "description": "Fetch all of your TikTok and Instagram reposts and remove them in bulk, right from your browser. No password, no upload.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "UnReposter", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "side_panel": {"default_path": "src/popup/popup.html"}, "permissions": ["scripting", "storage", "tabs", "alarms", "sidePanel", "cookies"], "host_permissions": ["https://www.tiktok.com/*", "https://*.tiktok.com/*", "https://www.instagram.com/*", "https://*.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*", "https://api.revenuecat.com/*", "https://www.google-analytics.com/*", "https://firestore.googleapis.com/*", "https://repost-app-extension.web.app/*"], "content_scripts": [{"matches": ["https://www.tiktok.com/*", "https://*.tiktok.com/*"], "js": ["src/content/tiktok-api.js", "src/content/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*", "https://*.instagram.com/*"], "js": ["src/content/instagram-api.js", "src/content/content.js"], "run_at": "document_idle"}]}