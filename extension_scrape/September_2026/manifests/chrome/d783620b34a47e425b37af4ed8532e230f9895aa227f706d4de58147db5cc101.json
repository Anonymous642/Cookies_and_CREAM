{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Send To Blue", "version": "2.0", "description": "A Chrome extension to save web content to Blue.", "permissions": ["storage", "activeTab", "scripting", "tabs", "notifications", "contextMenus", "alarms"], "host_permissions": ["https://api.blue.cc/*", "https://*.backblazeb2.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "author": "Robert Brewer", "commands": {"_execute_action": {}, "save-to-blue": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Blue"}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}