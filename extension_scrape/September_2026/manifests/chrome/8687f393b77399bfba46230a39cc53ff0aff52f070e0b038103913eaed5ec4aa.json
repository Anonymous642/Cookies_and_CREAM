{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Crypto Risk Radar", "short_name": "CRR", "version": "1.0.1", "description": "Scan tokens, wallets & URLs for crypto scams before you sign. Detects honeypots, rug pulls, phishing & malicious approvals.", "minimum_chrome_version": "102", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Crypto Risk Radar \u2014 Scan before you sign", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"_comment": "Runs on all URLs for phishing banner detection only. Address badges restricted to crypto sites inside content.js logic.", "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "contextMenus", "notifications"], "host_permissions": ["https://cryptoriskradar.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://cryptoriskradar.com"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "homepage_url": "https://cryptoriskradar.com"}