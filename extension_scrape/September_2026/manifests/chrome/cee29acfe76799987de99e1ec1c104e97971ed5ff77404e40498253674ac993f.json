{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Knote", "version": "1.1.2", "description": "Your thoughts, waiting where you left them. Tie a note to any link, and it surfaces the moment you're back on that page.", "permissions": ["storage", "sidePanel", "tabs", "webNavigation", "scripting"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "action": {"default_title": "Knote"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["https://*/*", "http://*/*"], "options_ui": {"page": "src/manager/manager.html", "open_in_tab": true}}