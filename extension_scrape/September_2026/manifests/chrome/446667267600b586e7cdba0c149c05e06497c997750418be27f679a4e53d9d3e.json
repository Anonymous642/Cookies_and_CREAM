{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focuser \u2014 Website Blocker & Focus Timer", "version": "1.0.7", "description": "Block distracting sites with mindful prompts, focus sessions, floating timer, and scheduled blocking to stay focused", "permissions": ["alarms", "storage", "tabs", "windows"], "host_permissions": ["*://*/*"], "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"]}], "web_accessible_resources": [{"resources": ["assets/content.css", "styles/*.css", "injected/enableLogs.js"], "matches": ["*://*/*"]}], "action": {"default_popup": "src/pages/Popup/index.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "commands": {"start-quick-session": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Start a quick focus pause for the current site"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "incognito": "split"}