{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Handshaker", "version": "0.2.4", "description": "Handshaker \u2014 sync contacts from LinkedIn and Facebook", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Handshaker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "identity", "tabs", "cookies"], "host_permissions": ["https://api.handshakerai.com/*", "https://accounts.google.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://*.linkedin.com/*", "https://*.facebook.com/*"], "externally_connectable": {"matches": ["https://app.handshakerai.com/*"]}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content/linkedin/detect.js", "content/linkedin/parser.js", "content/linkedin/normalize.js", "content/linkedin/scroll.js", "content/linkedin/voyager.js", "content/linkedin/profile-enrich.js", "content/linkedin/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*", "https://facebook.com/*", "https://web.facebook.com/*"], "js": ["content/facebook/detect.js", "content/facebook/parser.js", "content/facebook/normalize.js", "content/facebook/scroll.js", "content/facebook/friends-api.js", "content/facebook/profile-enrich.js", "content/facebook/content.js"], "run_at": "document_idle"}]}