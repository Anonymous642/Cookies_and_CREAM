{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Command Center Connector for Thumbtack", "version": "0.1.4", "description": "Connect signed in Thumbtack Chrome sessions to Thumbtack Command Center. Start at thumbtack.buildwithcory.com.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["alarms", "cookies", "tabs", "scripting", "storage"], "host_permissions": ["https://thumbtack.com/*", "https://www.thumbtack.com/*", "https://app.thumbtack.com/*", "https://thumbtack.buildwithcory.com/*"], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html", "default_title": "Command Center Connector"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://thumbtack.com/*", "https://www.thumbtack.com/*", "https://app.thumbtack.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}