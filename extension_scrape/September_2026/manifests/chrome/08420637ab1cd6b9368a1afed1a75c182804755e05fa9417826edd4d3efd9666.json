{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenata: Compliance Evidence Collector", "description": "Automate compliance evidence collection for SOC 2, ISO 27001, GDPR & more.", "version": "2.4.3", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "key": "", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["<all_urls>"], "permissions": ["alarms", "storage", "activeTab", "tabs", "scripting", "identity", "tabCapture", "desktopCapture", "offscreen", "sidePanel"], "web_accessible_resources": [{"resources": ["/assets/*", "offscreen.html", "permission.html", "sidebar-trigger.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "Screenata", "default_popup": "popup.html"}, "commands": {"start-stop-recording": {"suggested_key": {"default": "Shift+Alt+E", "mac": "Shift+Alt+E"}, "description": "Start or stop recording"}, "cancel-recording": {"suggested_key": {"default": "Shift+Alt+C", "mac": "Shift+Alt+C"}, "description": "Cancel recording"}, "pause-resume-recording": {"suggested_key": {"default": "Shift+Alt+P", "mac": "Shift+Alt+P"}, "description": "Pause or resume recording"}, "take-screenshot": {"suggested_key": {"default": "Shift+Alt+T", "mac": "Shift+Alt+T"}, "description": "Take a screenshot"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}