{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sumify - YouTube AI Summarizer", "version": "1.0.2", "description": "Rangkum Video YouTube dengan AI dan highlight berdasarkan timestamp secara otomatis.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://sumify.cloud/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["src/main-world.js"], "world": "MAIN", "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://sumify.cloud/*"]}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Sumify - YouTube AI Summarizer"}, "web_accessible_resources": [{"resources": ["src/styles.css", "icons/*.png"], "matches": ["https://www.youtube.com/*"]}]}