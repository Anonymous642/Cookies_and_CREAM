{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Claim Denial & Appeal Deadline Tracker - DenialKeep", "version": "1.0.0", "description": "Catch every denied or underpaid claim before the appeal window closes. No patient data, everything stays on your computer.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "DenialKeep", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options/index.html", "permissions": ["storage", "alarms", "notifications"], "commands": {"open-worklist": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the DenialKeep worklist"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://extensionpay.com"}}