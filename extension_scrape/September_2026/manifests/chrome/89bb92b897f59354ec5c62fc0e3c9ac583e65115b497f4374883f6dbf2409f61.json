{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetNext", "version": "0.1.2", "description": "Tracks your LeetCode history and recommends what to solve next.", "permissions": ["cookies", "storage"], "host_permissions": ["https://leetcode.com/*", "https://*.leetcode.com/*", "https://huggingface.co/*", "https://*.huggingface.co/*"], "background": {"service_worker": "core/orchestrator.js"}, "content_scripts": [{"matches": ["https://*.leetcode.com/*"], "js": ["core/leetcode.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "ui/popup.html", "default_title": "LeetNext"}, "web_accessible_resources": [{"resources": ["core/leetcode-interceptor.js", "data/problems.json", "ui/dashboard.html", "ui/dashboard.js", "ui/chart.min.js", "engine/engine.wasm.wasm", "engine/brain.wasm", "engine/brain.js", "ui/onnx-worker.html", "ui/onnx-worker.js", "lib/transformers.js"], "matches": ["<all_urls>"]}]}