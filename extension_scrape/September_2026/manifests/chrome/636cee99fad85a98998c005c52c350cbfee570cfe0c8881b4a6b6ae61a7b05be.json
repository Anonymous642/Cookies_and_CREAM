{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook Post Photo Downloader", "version": "2.0.0", "description": "Download every photo from a Facebook post with one click.", "permissions": ["downloads", "activeTab", "storage", "offscreen"], "host_permissions": ["https://*.facebook.com/*", "https://*.fbcdn.net/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Facebook Post Photo Downloader", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://*.facebook.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}