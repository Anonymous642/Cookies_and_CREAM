{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoGroup: AI Tab Organizer (Privacy-First)", "version": "2.0.0", "description": "Organize tabs instantly with local AI. Privacy-first smart grouping that runs 100% on your device. No data leaves your browser.", "permissions": ["tabs", "tabGroups", "storage", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "dist/src/popup/index.html", "default_title": "AutoGroup - Organize Tabs", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}