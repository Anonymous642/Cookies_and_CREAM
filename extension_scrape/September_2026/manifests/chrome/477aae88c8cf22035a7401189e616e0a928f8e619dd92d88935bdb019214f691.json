{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fichi-Fichi", "version": "1.2.1", "description": "Automatiza el fichaje en Woffu. Visualiza el calendario, selecciona d\u00edas y ficha en lote f\u00e1cilmente.", "permissions": ["storage", "cookies"], "host_permissions": ["https://*.woffu.com/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://*.woffu.com/*"], "js": ["scripts/content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["locales/*.json"], "matches": ["<all_urls>"]}]}