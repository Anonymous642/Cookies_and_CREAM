{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Oxford Learner's Dictionary Lookup", "short_name": "OX Lookup", "version": "1.1.0", "default_locale": "en", "description": "Quick lookup words in Oxford Learner's Dictionary with UK and US support.", "author": "Tung Dang", "homepage_url": "https://github.com/dangtungg/oxford-dictionary-lookup", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "permissions": ["storage", "contextMenus", "declarativeNetRequest"], "host_permissions": ["file:///*", "*://*/*"], "background": {"service_worker": "js/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["js/content.js"], "css": ["css/content.css"], "run_at": "document_end", "match_about_blank": true}, {"matches": ["https://www.oxfordlearnersdictionaries.com/*"], "css": ["css/oxford-cookie-hide.css"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["assets/icons/*.png", "_locales/*/messages.json"], "matches": ["file:///*", "*://*/*"]}], "declarative_net_request": {"rule_resources": [{"id": "oxford_ruleset", "enabled": true, "path": "rules.json"}]}}