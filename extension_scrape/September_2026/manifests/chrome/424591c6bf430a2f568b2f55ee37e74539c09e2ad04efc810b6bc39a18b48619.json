{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Listado Clipper", "version": "0.9.0", "description": "Jednym klikni\u0119ciem zapisuj produkty z dowolnego sklepu do list w Listado.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Listado Clipper", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"start-screen-crop": {"suggested_key": {"default": "Alt+Q"}, "description": "Wytnij fragment ekranu jako zdj\u0119cie produktu"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://listado.pl/*", "https://*.listado.pl/*", "http://localhost:3000/*"]}, "web_accessible_resources": [{"resources": ["panel.html", "panel.css", "panel.js", "i18n.js"], "matches": ["<all_urls>"]}]}