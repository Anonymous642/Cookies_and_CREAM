{"manifest_version": 3, "name": "Video Notes", "description": "Learn from YouTube and Bilibili, then confirm notes in Obsidian.", "version": "0.9.2", "icons": {"16": "brand/icon-16.png", "32": "brand/icon-32.png", "48": "brand/icon-48.png", "128": "brand/icon-128.png"}, "minimum_chrome_version": "116", "permissions": ["activeTab", "storage", "tabs", "scripting", "sidePanel", "tabCapture", "offscreen", "nativeMessaging", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://www.bilibili.com/*", "https://api.bilibili.com/*", "https://*.hdslb.com/*", "https://*.bilivideo.com/*", "https://*.googlevideo.com/*", "http://127.0.0.1/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*"], "web_accessible_resources": [{"resources": ["brand/icon-32.png"], "matches": ["https://www.youtube.com/*", "https://www.bilibili.com/*"]}], "action": {"default_title": "\u6253\u5f00 Video Notes", "default_icon": {"16": "brand/icon-16.png", "32": "brand/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"add-highlight": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "\u4fdd\u5b58\u5f53\u524d\u91cd\u70b9"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://www.bilibili.com/video/*", "*://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "update_url": "https://clients2.google.com/service/update2/crx"}