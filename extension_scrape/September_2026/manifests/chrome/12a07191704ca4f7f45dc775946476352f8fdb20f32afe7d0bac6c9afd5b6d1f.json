{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickTools", "version": "1.0.0", "minimum_chrome_version": "114", "description": "Fast developer tools for text, URLs, JSON, XML, HTML and dates.", "author": "Emir Barmanbey", "homepage_url": "https://barmanbey.github.io/quicktools-site/", "icons": {"16": "extension/icons/icon-16.png", "32": "extension/icons/icon-32.png", "48": "extension/icons/icon-48.png", "128": "extension/icons/icon-128.png"}, "permissions": ["contextMenus", "storage", "clipboardWrite", "sidePanel", "scripting", "tabs", "cookies"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["extension/content-selection.js"], "run_at": "document_idle"}], "background": {"service_worker": "extension/background.js", "type": "module"}, "action": {"default_title": "QuickTools", "default_icon": {"16": "extension/icons/icon-16.png", "32": "extension/icons/icon-32.png", "48": "extension/icons/icon-48.png", "128": "extension/icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open QuickTools"}}, "side_panel": {"default_path": "extension/panel.html"}}