{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "1-Click QR", "version": "1.1.0", "description": "Scan any QR code on your screen with one click. No camera needed. Click, drag, done.", "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "1-Click QR (\u2325+Q)", "default_popup": "popup.html"}, "commands": {"trigger-scan": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Activate QR scanner"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["libs/jsqr.min.js"], "matches": ["<all_urls>"]}]}