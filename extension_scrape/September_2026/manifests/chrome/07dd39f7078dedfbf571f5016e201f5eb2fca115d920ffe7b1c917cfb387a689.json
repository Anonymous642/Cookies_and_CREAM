{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "pinlay", "description": "Drop pins on any live web page; triage and ship in your dashboard.", "version": "1.0.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "pinlay", "default_popup": "popup.html"}, "commands": {"drop-pin": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Drop a pin on this page"}}, "externally_connectable": {"matches": ["https://*.pinlay.io/*", "https://pinlay-web.vercel.app/*"]}, "web_accessible_resources": [{"resources": ["icon/*.png"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}