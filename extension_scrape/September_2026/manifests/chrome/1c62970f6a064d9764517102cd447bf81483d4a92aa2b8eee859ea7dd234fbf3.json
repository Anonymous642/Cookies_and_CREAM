{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FrameKeeper \u2014 Video Frame Extractor", "description": "__MSG_extDescription__", "version": "0.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "512": "icon/512.png"}, "default_locale": "en", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.bilibili.com/*"], "commands": {"capture-frame": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "__MSG_cmdCapture__"}, "toggle-tray": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "__MSG_cmdTray__"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "FrameKeeper", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://*.bilibili.com/*", "*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}