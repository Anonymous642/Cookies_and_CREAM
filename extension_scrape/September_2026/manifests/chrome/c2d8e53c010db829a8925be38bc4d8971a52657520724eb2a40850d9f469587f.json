{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unread Checker for Gmail", "short_name": "Gmail Count", "description": "Shows a Gmail inbox unread-count badge, refreshes automatically, and opens or focuses your Gmail tab.", "version": "1.0.6", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Unread Checker for Gmail", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["alarms", "contextMenus", "storage"], "host_permissions": ["https://mail.google.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/mail/*"], "exclude_matches": ["https://mail.google.com/mail/feed/*"], "js": ["gmail-activity.js"], "run_at": "document_idle"}]}