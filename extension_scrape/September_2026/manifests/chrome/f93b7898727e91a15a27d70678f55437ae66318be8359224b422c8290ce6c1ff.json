{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StealthShield", "version": "1.0.0", "description": "Warns on sensitive, login, and insecure web pages while browsing.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "StealthShield", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "web_accessible_resources": [{"resources": ["assets/fonts/*.woff2"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content/browsing/inject.js"], "run_at": "document_idle", "all_frames": false}]}