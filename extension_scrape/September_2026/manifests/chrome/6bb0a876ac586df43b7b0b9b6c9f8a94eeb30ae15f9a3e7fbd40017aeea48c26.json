{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Walmart to Facebook Marketplace", "version": "3.0", "description": "Automatically fetch product details from Walmart and fill Facebook Marketplace listings", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://*.walmart.com/*", "https://*.facebook.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.facebook.com/marketplace/*"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["https://*.walmart.com/*"], "js": ["walmart-content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}