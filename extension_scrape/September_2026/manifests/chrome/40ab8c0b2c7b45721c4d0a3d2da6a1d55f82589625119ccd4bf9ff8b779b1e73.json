{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tube+ mini YouTube Player", "version": "2.0.0", "description": "Compact YouTube mini Player with quick controls. Press Alt+M to open it instantly. Manage playback from any tab.", "privacy_policy": "https://darklabproject24.github.io/TubePlus/privacy.html", "permissions": ["scripting", "storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://music.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"}, "commands": {"toggle-player": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle mini player overlay"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://music.youtube.com/*"], "js": ["contentScript.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}