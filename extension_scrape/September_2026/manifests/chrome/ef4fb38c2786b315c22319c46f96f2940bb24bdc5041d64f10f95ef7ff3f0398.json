{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Answertree", "version": "1.0", "manifest_version": 3, "description": "Enhance your browsing with Answertree - open a side panel to chat, search, and get instant answers while you browse.", "background": {"service_worker": "service-worker.js"}, "icons": {"16": "images/logo-512.png", "128": "images/logo-512.png", "256": "images/logo-512.png", "512": "images/logo-512.png"}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["sidePanel", "contextMenus", "storage", "activeTab"], "action": {}, "externally_connectable": {"matches": ["http://localhost:3000/*", "https://*.answertree.ai/*"]}, "host_permissions": ["http://localhost:3000/*", "https://*.answertree.ai/*"]}