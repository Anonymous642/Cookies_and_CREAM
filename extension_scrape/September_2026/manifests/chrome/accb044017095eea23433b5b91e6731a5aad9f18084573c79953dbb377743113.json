{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ytnote (AI Teacher + Notes Maker)", "version": "1.0.2", "description": "YouTube Teacher + Notes Maker: AI-powered tool to generate summaries, notes (Text + Image), and transcripts from YouTube videos.", "icons": {"16": "image.png", "32": "image.png", "48": "image.png", "128": "image.png"}, "action": {"default_title": "Transcript", "default_popup": "popup.html", "default_icon": {"16": "image.png", "32": "image.png", "48": "image.png", "128": "image.png"}}, "permissions": ["activeTab", "scripting", "tabs", "windows", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}