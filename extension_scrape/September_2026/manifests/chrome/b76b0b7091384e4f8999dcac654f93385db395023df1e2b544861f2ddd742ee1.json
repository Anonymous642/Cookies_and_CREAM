{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkScreen - Annotate Webpages & Screenshot", "description": "Annotate webpages with pen, arrows, text & blur. Capture clear screenshots for bug reports, feedback, and docs. No account needed.", "version": "1.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "clipboardWrite"], "commands": {"toggle-markscreen": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Toggle MarkScreen drawing mode"}}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}