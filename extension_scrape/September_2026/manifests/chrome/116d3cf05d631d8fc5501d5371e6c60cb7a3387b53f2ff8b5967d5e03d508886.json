{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Docs Strikethrough Button", "version": "2.0.0", "description": "Add a one-click strikethrough button to Google Docs. Select text and toggle strikethrough instantly\u2014no shortcuts to remember.", "permissions": ["activeTab", "scripting"], "host_permissions": ["https://docs.google.com/*"], "background": {"service_worker": "src/background/serviceWorker.js", "type": "module"}, "content_scripts": [{"matches": ["https://docs.google.com/*"], "js": ["src/content/docsToolbar.js"], "run_at": "document_idle"}], "action": {"default_title": "Google Docs Strikethrough", "default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}