{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Add to Bookmax", "version": "4.1.6", "description": "Save pages to Bookmax, search your bookmarks in the sidebar, and import or export browser bookmarks.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "contextMenus", "tabs", "storage"], "host_permissions": ["https://my.bookmax.net/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://my.bookmax.net/*"], "js": ["bookmax_page.js"], "run_at": "document_start"}], "action": {"default_title": "Add to Bookmax", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open the Bookmax sidebar"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "optional_permissions": ["bookmarks"]}