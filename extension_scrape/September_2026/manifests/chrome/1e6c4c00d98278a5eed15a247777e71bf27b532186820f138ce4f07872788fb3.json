{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Internet Planetarium", "short_name": "Planetarium", "version": "1.0.0", "description": "Your browser has a universe. Every site you visit becomes a planet, on a new tab that stays entirely on your device.", "author": "Yien Studio", "minimum_chrome_version": "110", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["storage", "favicon", "search", "alarms"], "optional_permissions": ["history", "bookmarks"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}