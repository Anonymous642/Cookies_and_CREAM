{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Superside AR Extension", "description": "Applies Superside virtual accessories (hats, glasses) to webcam feed as a virtual camera for video conferencing apps.", "version": "0.1.5", "action": {"default_popup": "popup/index.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background/index.js"}, "permissions": ["storage", "offscreen"], "content_scripts": [{"matches": ["*://meet.google.com/*", "*://app.zoom.us/*", "*://*.zoom.com/*", "*://*.loom.com/*", "*://teams.live.com/*", "*://meet.jit.si/*", "*://*.whereby.com/*", "*://*.twitch.tv/*"], "js": ["content/index.js"], "run_at": "document_start", "all_frames": true}], "commands": {"_execute_action": {"description": "Open Superside AR popup"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["popup/_next/static/*", "popup/_next/static/chunks/*", "popup/_next/static/css/*", "popup/static/**/*", "popup/models/*", "popup/assets/*", "injected/index.js", "vendor/mediapipe/*", "vendor/mediapipe/**/*"], "matches": ["<all_urls>"]}], "version_name": "0.1.5"}