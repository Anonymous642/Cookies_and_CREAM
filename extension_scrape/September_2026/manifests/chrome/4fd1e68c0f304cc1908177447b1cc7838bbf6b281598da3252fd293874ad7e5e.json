{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoCopy GPT", "description": "One click to copy the latest ChatGPT answer\u2014clean text and code blocks included. Optional auto-copy.", "version": "1.0.0", "action": {"default_title": "AutoCopy GPT", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "clipboardWrite"], "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"copy-latest": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Copy the latest ChatGPT answer"}}}