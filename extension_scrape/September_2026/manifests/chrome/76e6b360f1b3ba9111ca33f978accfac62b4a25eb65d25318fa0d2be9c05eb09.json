{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoTrap", "version": "1.0", "description": "Watch youtube free of distractions like the good old days. Block suggestions feed, comments, homepage and more.", "host_permissions": ["http://www.youtube.com/*", "https://www.youtube.com/*"], "permissions": ["storage", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"48": "src/img/icon.png", "128": "src/img/icon.png"}}, "icons": {"48": "src/img/icon.png", "128": "src/img/icon.png"}, "background": {"service worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "run_at": "document_start", "type": "module"}], "web_accessible_resources": [{"resources": ["src/img/*"], "matches": ["<all_urls>"]}]}