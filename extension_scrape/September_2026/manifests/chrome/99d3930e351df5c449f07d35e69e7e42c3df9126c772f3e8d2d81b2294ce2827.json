{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Assistant", "manifest_version": 3, "description": "Chrome extension for Assisting me while browsing the web", "version": "1.0.6", "author": "IamAfasha", "icons": {"48": "img/icon-48.png", "128": "img/icon-128.png"}, "offline_enabled": true, "action": {"default_icon": {"48": "img/icon-48.png", "128": "img/icon-128.png"}, "default_title": "Assistant"}, "background": {"service_worker": "background/index.js"}, "content_security_policy": {"extension_pages": "font-src 'self'; script-src 'self'; object-src 'self'; worker-src 'self'", "content_scripts": "font-src 'self'; script-src 'self'; object-src 'self'; worker-src 'self'"}, "content_scripts": [{"matches": ["<all_urls>", "http://*/*", "https://*/*"], "exclude_matches": ["http://localhost/*"], "js": ["./contentScript/index.js"], "all_frames": true}], "web_accessible_resources": [{"resources": ["_favicon/*", "/modules/*", "/assets/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["<all_urls>"]}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["sidePanel", "topSites", "bookmarks", "favicon", "storage", "tabs"]}