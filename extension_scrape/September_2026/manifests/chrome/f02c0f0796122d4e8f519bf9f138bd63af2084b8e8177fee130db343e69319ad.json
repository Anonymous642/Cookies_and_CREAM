{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FareDip Flight Tracker", "version": "1.2", "description": "Track flight prices on airline websites", "permissions": ["storage", "activeTab", "tabs", "identity"], "host_permissions": ["https://*.delta.com/*", "https://*.united.com/*", "https://*.southwest.com/*", "https://*.jetblue.com/*", "https://*.aa.com/*"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.delta.com/*", "https://*.united.com/*", "https://*.southwest.com/*", "https://*.jetblue.com/*", "https://*.aa.com/*"], "js": ["src/content/content.js"]}], "action": {"default_popup": "src/popup/popup.html", "default_icon": "favicon.png"}, "icons": {"16": "favicon.png", "48": "favicon.png", "128": "favicon.png"}, "web_accessible_resources": [{"resources": ["faredip_logo_crop.png", "faredip-128.png"], "matches": ["https://*.delta.com/*", "https://*.united.com/*", "https://*.southwest.com/*", "https://*.jetblue.com/*", "https://*.aa.com/*"]}]}