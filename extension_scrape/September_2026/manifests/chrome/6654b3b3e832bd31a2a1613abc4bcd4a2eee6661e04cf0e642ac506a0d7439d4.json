{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lasso \u2014 Save to Notion", "version": "0.4.0", "description": "Save web pages to Notion instantly. One keystroke captures title, URL, excerpt & thumbnail. Built for Notion power users.", "permissions": ["storage", "scripting", "activeTab", "contextMenus", "identity", "tabs", "notifications"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "commands": {"save-to-library": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Command+S"}, "description": "Save page/selection to Notion"}, "save-tag-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Command+1"}, "description": "Save to Notion with Tag Shortcut 1"}, "save-tag-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Command+2"}, "description": "Save to Notion with Tag Shortcut 2"}, "save-tag-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "MacCtrl+Command+3"}, "description": "Save to Notion with Tag Shortcut 3"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}