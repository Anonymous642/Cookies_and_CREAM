{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PlatPrices: PS Store Price History", "version": "0.16.0", "description": "Price history, deal ratings and your game library, right on the PlayStation Store. Powered by platprices.com.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "notifications", "identity"], "host_permissions": ["https://store.playstation.com/*", "https://platprices.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://store.playstation.com/*/product/*", "https://store.playstation.com/*/concept/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://store.playstation.com/*/category/*"], "js": ["categoryContent.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://store.playstation.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://platprices.com"}, "minimum_chrome_version": "110"}