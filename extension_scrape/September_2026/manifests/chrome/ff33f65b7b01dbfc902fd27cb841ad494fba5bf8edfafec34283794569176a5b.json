{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "inApp \u2014 Deep Link Shortener", "version": "1.0.0", "description": "Turn any page or link into a short link that opens straight in the native app. One click, copied to your clipboard.", "homepage_url": "https://app.inapp.app", "minimum_chrome_version": "106", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "identity", "notifications"], "host_permissions": ["https://inapp.app/*", "https://app.inapp.app/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Shorten with inApp", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"shorten-current-tab": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Shorten the current tab and copy the link"}}}