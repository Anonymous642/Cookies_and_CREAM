{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GFG to GitHub", "version": "1.0.0", "description": "Capture GFG problem statement and all accepted solution codes into a Markdown file.", "action": {"default_title": "GFG to GitHub", "default_popup": "popup.html"}, "background": {"service_worker": "service_worker.js"}, "permissions": ["activeTab", "scripting", "tabs", "downloads", "storage"], "host_permissions": ["https://*.geeksforgeeks.org/*", "https://api.github.com/*"], "commands": {"generate-markdown": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Generate Markdown for current GFG problem"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.geeksforgeeks.org/*"], "js": ["utils/wait_utils.js", "utils/dom_selectors.js", "content_problem.js", "content_submissions.js", "content_submission_detail.js"], "run_at": "document_idle"}]}