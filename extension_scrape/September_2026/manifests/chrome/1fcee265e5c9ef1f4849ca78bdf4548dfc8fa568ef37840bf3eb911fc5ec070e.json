{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scribematic", "description": "This extension transfers medical notes from scribematic.ai to the user's electronic health records system.", "version": "2.7", "icons": {"128": "images/logo-no-bg-128.png"}, "action": {"default_title": "Click to open side panel"}, "side_panel": {"default_path": "sidepanels/sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.afoundria.com/*"], "js": ["content.js"]}, {"matches": ["https://*.athenahealth.com/*"], "js": ["athena.js"]}], "permissions": ["sidePanel", "tabs", "offscreen", "storage", "scripting", "alarms"], "host_permissions": ["https://*.firebaseapp.com/*", "https://*.athenahealth.com/*"], "web_accessible_resources": [{"resources": ["images/scribematic-logo.svg"], "matches": ["https://*.afoundria.com/*"]}]}