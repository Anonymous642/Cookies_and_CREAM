{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Pomodoro - Website Time Limit Blocker", "version": "1.0.0", "description": "Pomodoro-style daily time limits for websites. When the timer is up, the site is blocked until tomorrow.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/debug.js", "src/site-limit.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "action": {"default_title": "Simple Pomodoro \u2014 daily website time limits", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["http://*/*", "https://*/*"]}