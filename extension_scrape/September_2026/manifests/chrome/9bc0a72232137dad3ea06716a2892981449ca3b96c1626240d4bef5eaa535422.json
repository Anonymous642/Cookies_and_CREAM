{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ezynto Importer", "version": "1.0.1", "description": "Save profiles you're viewing on LinkedIn into your own Ezynto recruiting workspace.", "action": {"default_title": "Open Ezynto"}, "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://app.ezynto.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/search/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["panel.html"], "matches": ["https://www.linkedin.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}}