{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoleCatcher! Capture", "description": "RoleCatcher plugin for LinkedIn and job board data extraction", "version": "3.0.4", "author": "@rolecatcher", "default_locale": "en", "permissions": ["cookies", "storage", "sidePanel", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["*://app.rolecatcher.com/*", "*://uat.rolecatcher.co.uk/*", "*://localhost/*", "*://127.0.0.1/*"], "js": ["content-scripts/cse.js", "content-scripts/contacts-import.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://*.linkedin.com/*"], "js": ["content-scripts/linkedin.js", "content-scripts/linkedin-profile.js", "content-scripts/linkedin-company.js", "content-scripts/linkedin-own-profile.js", "content-scripts/cv-drag.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content-scripts/cv-drag.js", "content-scripts/logo-inject.js", "content-scripts/generic-scraper.js"], "run_at": "document_idle", "all_frames": false}], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_icon": "images/logodarkshort.png", "default_title": "RoleCatcher"}, "icons": {"16": "images/logo48x48.png", "48": "images/logo48x48.png", "128": "images/logodarkshort.png"}, "web_accessible_resources": [{"resources": ["images/*", "sidepanel/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}