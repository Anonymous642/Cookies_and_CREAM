{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RemindMe Web Clipper", "description": "Clip content from any webpage to your RemindMe spaced repetition learning system", "version": "2.6.0", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://getremindme.app/*", "https://*.getremindme.app/*", "https://remindme-app.pages.dev/*", "https://*.remindme-app.pages.dev/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"quick-clip": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick clip current page to RemindMe"}, "snip-area": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Snip area from page with AI extraction"}}, "content_scripts": [{"matches": ["https://master.remindme-app.pages.dev/*", "https://remindme-app.pages.dev/*", "https://*.remindme-app.pages.dev/*", "https://*.remindme.app/*", "https://getremindme.app/*", "https://*.getremindme.app/*", "https://www.getremindme.app/*", "*://getremindme.app/*", "*://*.getremindme.app/*"], "js": ["content-script-bridge.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["privacy.html", "terms.html"], "matches": ["https://getremindme.app/*", "https://*.getremindme.app/*"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}