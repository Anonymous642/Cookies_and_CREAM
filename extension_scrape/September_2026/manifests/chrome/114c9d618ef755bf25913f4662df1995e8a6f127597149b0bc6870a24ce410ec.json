{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Buyer Radar - CRM Assistant", "version": "1.3.0", "description": "CRM assistant for Buyer Radar. Displays account insights, hierarchy, and Route to Power on LinkedIn, Salesforce, and HubSpot.", "icons": {"16": "assets/icon.png", "32": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon.png", "32": "assets/icon.png"}, "default_title": "Buyer Radar Assistant"}, "permissions": ["storage", "alarms", "webNavigation"], "host_permissions": ["https://*.linkedin.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.hubspot.com/*", "https://fe.lapwing.buyer-radar.com/*", "https://fe.wolfhound.buyer-radar.com/*", "https://fe.prod.buyer-radar.com/*"], "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content-linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://*.salesforce.com/*", "https://*.force.com/*"], "js": ["content-salesforce.js"], "run_at": "document_idle"}, {"matches": ["https://*.hubspot.com/*"], "js": ["content-hubspot.js"], "run_at": "document_idle"}, {"matches": ["https://fe.lapwing.buyer-radar.com/*", "https://fe.wolfhound.buyer-radar.com/*", "https://fe.prod.buyer-radar.com/*"], "js": ["content-localhost.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://*.linkedin.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.hubspot.com/*"]}], "homepage_url": "https://buyer-radar.com"}