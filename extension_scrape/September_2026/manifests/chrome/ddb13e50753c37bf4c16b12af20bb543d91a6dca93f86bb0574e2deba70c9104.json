{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SEC Vendor Bridge", "version": "0.7.2", "description": "Forwards your Totango, RightNow and Radware Cloud sessions to the local SEC app so it builds reports without cookie copy-paste.", "permissions": ["cookies", "storage", "alarms", "webRequest", "scripting"], "host_permissions": ["https://*.totango.com/*", "https://support.radware.com/*", "https://console.radwarecloud.com/*", "http://localhost:5000/*", "http://127.0.0.1:5000/*"], "content_scripts": [{"matches": ["https://console.radwarecloud.com/*"], "js": ["content_radware_cloud.js"], "run_at": "document_idle"}, {"matches": ["https://console.radwarecloud.com/*"], "js": ["content_radware_waf_dashboard.js"], "run_at": "document_start"}, {"matches": ["https://console.radwarecloud.com/*"], "js": ["content_radware_waf_sweep.js"], "run_at": "document_idle"}, {"matches": ["http://localhost:5000/*", "http://127.0.0.1:5000/*"], "js": ["content_sec_app.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SEC Vendor Bridge", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}