{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Feline", "version": "1.0", "description": "Turn Chrome tabs into floating popout windows with workspaces, floating bubble menu, emergency hotkey, and custom colors.", "permissions": ["activeTab", "alarms", "contextMenus", "downloads", "scripting", "storage", "tabs", "windows"], "action": {"default_title": "Privacy Popout Cleaner", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-float": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Float current tab"}, "privacy-button": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Privacy Button: hide or restore floating windows"}, "emergency-switch": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Emergency Switch: close all popouts and open Emergency Link"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["bubble.js"], "css": ["bubble.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png", "support-config.json"], "matches": ["<all_urls>"]}]}