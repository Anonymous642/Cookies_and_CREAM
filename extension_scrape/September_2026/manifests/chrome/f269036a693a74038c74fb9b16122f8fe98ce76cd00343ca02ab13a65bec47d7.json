{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GrayFocus", "version": "1.0.0", "description": "Make distracting websites less addictive by converting them to grayscale.", "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"], "host_permissions": ["<all_urls>", "https://kiezelpay.com/"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"toggle-site-protection": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Toggle grayscale protection for current site"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}