{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Harbor Migration Assistant", "version": "1.0.6", "description": "Move your practice data from SimplePractice into Harbor. Runs in your own browser session; no passwords are ever collected.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open the Harbor import page", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["scripting", "storage", "downloads"], "host_permissions": ["https://secure.simplepractice.com/*", "https://account.simplepractice.com/*", "https://s3.us-east-2.amazonaws.com/*", "https://*.s3.us-east-2.amazonaws.com/*", "https://dashboard.harborpractice.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://dashboard.harborpractice.com/*"], "js": ["harbor-bridge.js"], "run_at": "document_idle"}]}