{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voxly", "version": "1.1.0", "description": "Clean reader view and read-aloud for web pages, PDFs, Google Docs, and uploaded books.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://api.voxly.app/*", "https://docs.google.com/*", "https://*.googleusercontent.com/*", "https://drive.google.com/*", "https://extensionpay.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Voxly", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"toggle-reader": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle reader view on the current page"}, "toggle-speech": {"suggested_key": {"default": "Alt+P"}, "description": "Play or pause read-aloud"}}, "web_accessible_resources": [{"resources": ["src/reader/*", "src/lib/*", "vendor/*", "assets/*", "USER_GUIDE.md"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["vendor/ExtPay.js"], "run_at": "document_start"}]}