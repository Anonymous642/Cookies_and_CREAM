{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "vatra \u2014 Tab Manager & Vertical Tabs Side Panel", "description": "Vertical tabs side panel and tab manager. Your most-used tabs rise to the top. Search tabs and history, all local. No account.", "version": "0.4.7", "minimum_chrome_version": "116", "permissions": ["tabs", "storage", "sidePanel", "history", "alarms", "favicon"], "background": {"service_worker": "service-worker.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Toggle vatra", "default_icon": {"16": "icons/vatra-16.png", "32": "icons/vatra-32.png", "48": "icons/vatra-48.png", "128": "icons/vatra-128.png"}}, "icons": {"16": "icons/vatra-16.png", "32": "icons/vatra-32.png", "48": "icons/vatra-48.png", "128": "icons/vatra-128.png"}, "commands": {"summon-hottabs": {"suggested_key": {"default": "Alt+S"}, "description": "Open vatra and focus the tab search"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": [{"resources": ["sidepanel.html"], "matches": ["http://*/*", "https://*/*"]}]}