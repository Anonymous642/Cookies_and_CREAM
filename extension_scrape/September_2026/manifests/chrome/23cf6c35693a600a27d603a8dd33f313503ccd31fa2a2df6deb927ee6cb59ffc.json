{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Memlane: Second Brain for the Web", "description": "Gather knowledge from any page. Memlane reads it, summarizes it, and files it under your topics \u2014 your growing second brain.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "storage", "identity"], "host_permissions": ["<all_urls>", "https://*.supabase.co/*", "https://*.workers.dev/*", "http://127.0.0.1/*"], "web_accessible_resources": [{"resources": ["capture-shadow-roots.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Memlane", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}