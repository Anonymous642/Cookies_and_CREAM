{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Utilumo", "description": "Utilumo, available everywhere in your browser. Clean URLs, fix text, and launch privacy-first tools from the page you are on.", "version": "0.1.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite", "sidePanel"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Utilumo", "default_popup": "popup.html"}, "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the Utilumo mini launcher"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}