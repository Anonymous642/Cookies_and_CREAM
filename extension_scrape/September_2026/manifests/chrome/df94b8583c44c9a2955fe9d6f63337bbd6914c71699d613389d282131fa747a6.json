{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pulse - Crypto Price Alerts", "version": "2.1.0", "description": "A Chrome extension to set price alerts for crypto trading pairs.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["sidePanel", "tabs", "storage", "alarms"], "host_permissions": ["https://pulse.kreepton.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Pulse - Crypto Price Alerts"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://pulse.kreepton.com/*"], "js": ["content.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://pulse.kreepton.com/"}}