{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Memory \u2014 Never Forget What You Were Doing", "short_name": "BrowserMem", "version": "2.5.0", "description": "Privacy-first browsing timeline. Search, resume where you left off, and organize research into projects. Data stays on your device.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*/*.pdf"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "unlimitedStorage", "tabs", "idle", "alarms", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "options_page": "dashboard.html", "chrome_url_overrides": {}, "minimum_chrome_version": "110", "browser_specific_settings": {"gecko": {"id": "browsermemory@iamristaf.in", "strict_min_version": "109.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.iamristaf.in"}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*", "blocked.html"], "matches": ["<all_urls>"]}]}