{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InterviewAI Copilot", "version": "1.0.23", "minimum_chrome_version": "116", "description": "AI-powered interview prep \u2014 practice with live transcription, AI coaching, and post-session reports", "permissions": ["tabs", "tabCapture", "offscreen", "storage", "identity", "webNavigation", "sidePanel", "activeTab", "alarms"], "host_permissions": ["https://*.copilotinterview.ai/*", "https://*.execute-api.us-east-1.amazonaws.com/*", "https://*.amazoncognito.com/*", "https://meet.google.com/*", "https://teams.microsoft.com/*", "https://zoom.us/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_title": "Open InterviewAI", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"}, "web_accessible_resources": [{"resources": ["offscreen/offscreen.html"], "matches": ["https://*.copilotinterview.ai/*"]}, {"resources": ["overlay/*", "assets/*", "chunks/*"], "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://zoom.us/*"]}], "content_scripts": [{"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://zoom.us/*"], "js": ["content/disclosed-badge.js", "content/overlay-pip.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle InterviewAI overlay"}}}