{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BidLynx", "version": "0.1.0", "description": "Scan Upwork job posts to analyse client intent before you spend your Connects.", "permissions": ["sidePanel", "activeTab", "scripting", "storage"], "host_permissions": ["https://www.upwork.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open BidLynx", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://www.upwork.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}