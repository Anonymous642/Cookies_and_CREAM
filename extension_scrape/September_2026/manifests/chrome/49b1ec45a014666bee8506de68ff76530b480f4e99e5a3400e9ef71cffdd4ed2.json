{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "125", "name": "H2F Capture", "version": "0.0.2", "description": "Capture supported web pages into local H2F files for import with the companion H2F Figma plugin.", "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/128.png"}}, "icons": {"128": "icons/128.png"}, "background": {"service_worker": "background.mjs", "type": "module"}, "permissions": ["activeTab", "scripting", "debugger", "downloads", "storage"], "commands": {"capture-full": {"description": "Capture the full page to a local H2F file", "suggested_key": {"default": "Shift+Alt+E"}}, "capture-selection": {"description": "Select a region to capture", "suggested_key": {"default": "Shift+Alt+D"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}