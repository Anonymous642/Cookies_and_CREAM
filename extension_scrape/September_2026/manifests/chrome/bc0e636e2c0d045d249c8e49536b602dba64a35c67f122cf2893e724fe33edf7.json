{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CyberQuest", "version": "2.0.2", "description": "Ultimate tab control, forget about bookmarks forever! Save system memory, time and focus. Robust local Autosave.", "permissions": ["tabs", "storage", "windows", "downloads"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/light/icon16.png", "48": "icons/light/icon48.png", "128": "icons/light/icon128.png"}}, "icons": {"16": "icons/light/icon16.png", "48": "icons/light/icon48.png", "128": "icons/light/icon128.png"}, "commands": {"copy-tabs": {"suggested_key": {"mac": "Command+M", "windows": "Ctrl+M", "linux": "Ctrl+M"}, "description": "Copy all tab URLs"}, "copy-tabs-alt": {"suggested_key": {"mac": "Command+Shift+S", "windows": "Ctrl+Shift+S", "linux": "Ctrl+Shift+S"}, "description": "Copy all tab URLs (alternative shortcut)"}}, "background": {"service_worker": "background.js"}}