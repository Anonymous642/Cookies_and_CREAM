{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LingoBinge: Language Learning Subtitles", "version": "0.2.18", "description": "Learn a language while you watch YouTube or Netflix. Subtitle words swap to your target language; tap any to translate and save.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*", "https://api.lingobinge.com/*", "https://app.lingobinge.com/*"], "icons": {"16": "icons/otto-16.png", "32": "icons/otto-32.png", "48": "icons/otto-48.png", "128": "icons/otto-128.png"}, "action": {"default_popup": "popup.html", "default_title": "LingoBinge", "default_icon": {"16": "icons/otto-16.png", "32": "icons/otto-32.png", "48": "icons/otto-48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle", "world": "ISOLATED"}, {"matches": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["netflix-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://app.lingobinge.com/*"], "js": ["bridge.js"], "run_at": "document_idle", "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["overlay.css", "packs/*.json"], "matches": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"]}]}