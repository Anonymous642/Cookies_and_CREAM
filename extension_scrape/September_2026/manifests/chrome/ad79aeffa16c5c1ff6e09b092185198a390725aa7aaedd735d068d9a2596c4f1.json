{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LingoLingo - AI Language Learning", "description": "Learn languages while watching YouTube videos - watch, translate and study with AI.", "version": "2.3.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["*://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "extension@lingolingo.app"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "LingoLingo", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}