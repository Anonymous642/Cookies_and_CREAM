{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TiksTree: Sync Tiktok Collections", "version": "1.1.0", "description": "Sync Tiktok collections directly to your private TiksTree collections via the Side Panel.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.tiktok.com/*", "https://tikstree.com/*"], "background": {"service_worker": "src/scripts/background.js", "type": "module"}, "action": {"default_title": "Open TiksTree Side Panel"}, "content_scripts": [{"matches": ["https://*.tiktok.com/*"], "exclude_globs": ["*tv_preview=1*"], "js": ["src/scripts/inject.js", "src/scripts/title-stash.js"], "run_at": "document_idle"}, {"matches": ["https://tikstree.com/*"], "exclude_globs": ["*tv_preview=1*"], "js": ["src/scripts/auth-bridge.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "src/sidepanel/*"], "matches": ["https://*.tiktok.com/*"]}], "commands": {"toggle-drawer": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle TiksTree Side Panel Drawer"}}}