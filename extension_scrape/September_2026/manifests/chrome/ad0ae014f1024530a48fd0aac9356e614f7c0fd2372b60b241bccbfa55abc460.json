{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT History Deep Searcher", "description": "Search ChatGPT history, scan selected conversations, cache snapshots, and navigate keyword hits with a minimap.", "version": "1.0.1.5", "action": {"default_title": "ChatGPT Search", "default_popup": "ui/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/content-script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "128": "icons/icon128.png"}}