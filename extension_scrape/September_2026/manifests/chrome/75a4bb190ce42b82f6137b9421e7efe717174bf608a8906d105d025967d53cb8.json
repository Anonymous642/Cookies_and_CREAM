{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unipost \u2014 eBay/Etsy/Shopify \u2192 AusPost Bridge", "version": "1.63.0", "description": "Unipost captures eBay, Etsy, and Shopify orders and fills the Australia Post MyPost Business form via a side panel.", "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://*.ebay.com.au/*", "https://*.ebay.com/*", "https://auspost.com.au/*", "https://*.myshopify.com/*", "https://admin.shopify.com/*", "https://*.etsy.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Unipost order queue", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.ebay.com.au/*", "https://*.ebay.com/*"], "js": ["content-ebay.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://*.myshopify.com/admin/orders/*", "https://admin.shopify.com/store/*/orders/*"], "js": ["content-shopify.js"], "run_at": "document_idle"}, {"matches": ["https://www.etsy.com/your/orders/*", "https://www.etsy.com/your/shops/*/orders*"], "js": ["content-etsy.js"], "run_at": "document_idle"}, {"matches": ["https://auspost.com.au/mypost-business/orders/add/retail*", "https://auspost.com.au/mypost-business/shipping-and-tracking/orders/add/retail*"], "js": ["content-auspost.js"], "all_frames": true, "run_at": "document_idle"}]}