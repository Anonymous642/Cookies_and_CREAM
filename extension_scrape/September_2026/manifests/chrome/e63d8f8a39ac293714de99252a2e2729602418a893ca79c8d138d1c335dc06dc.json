{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FitmentOS Product Importer", "description": "Import product listings into your FitmentOS catalog from any website with one click.", "version": "1.0.1", "minimum_chrome_version": "116", "action": {"default_title": "Import this product into FitmentOS"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://app.fitmentos.com/*", "http://localhost/*"], "content_scripts": [{"matches": ["https://*.ebay.com/*", "https://*.amazon.com/*", "https://*.walmart.com/*", "https://*.rockauto.com/*", "https://*.autozone.com/*", "https://*.napaonline.com/*", "https://*.advanceautoparts.com/*", "https://*.oreillyauto.com/*", "https://*.partsgeek.com/*", "https://*.carparts.com/*", "https://*.jegs.com/*", "https://*.carid.com/*", "https://*.summitracing.com/*", "http://localhost/*"], "js": ["src/content/launcher.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/popup/*", "src/lib/*", "src/content/extract.js", "assets/*"], "matches": ["https://*.ebay.com/*", "https://*.amazon.com/*", "https://*.walmart.com/*", "https://*.rockauto.com/*", "https://*.autozone.com/*", "https://*.napaonline.com/*", "https://*.advanceautoparts.com/*", "https://*.oreillyauto.com/*", "https://*.partsgeek.com/*", "https://*.carparts.com/*", "https://*.jegs.com/*", "https://*.carid.com/*", "https://*.summitracing.com/*", "http://localhost/*"]}]}