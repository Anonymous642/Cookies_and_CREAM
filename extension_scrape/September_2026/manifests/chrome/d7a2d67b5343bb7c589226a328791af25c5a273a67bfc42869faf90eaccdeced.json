{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Video URL Copier Pro", "version": "2.1", "description": "Copy, filter, export & analyze all video URLs from any YouTube page \u2014 the ultimate creator toolkit", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["icons/icon48.png", "icons/icon128.png"], "matches": ["*://*.youtube.com/*"]}], "commands": {"copy-all-urls": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Copy all video URLs on the page"}}, "background": {"service_worker": "background.js"}}