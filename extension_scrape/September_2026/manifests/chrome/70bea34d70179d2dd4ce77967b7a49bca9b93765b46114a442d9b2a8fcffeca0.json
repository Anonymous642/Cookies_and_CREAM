{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lexi Hover \u2014 English\u2013Chinese Reading Dictionary", "version": "0.7.0", "description": "Hold Alt and hover any English word for IPA, definition, part of speech and Chinese translation \u2014 without leaving the page.", "minimum_chrome_version": "116", "permissions": ["storage", "scripting", "offscreen", "activeTab", "alarms"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://api.mymemory.translated.net/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-marking": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Underline unfamiliar words on or off"}, "toggle-site": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Pause or resume Lexi Hover on this site"}, "open-word-list": {"description": "Open the word list"}}, "action": {"default_title": "Lexi Hover", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}