{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Web Cache Viewer", "description": "Quickly view older or cached versions of the current webpage.", "version": "2.0", "manifest_version": 3, "icons": {"128": "icons/icon128.png"}, "permissions": ["activeTab", "contextMenus", "storage", "scripting", "tabs"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://web.archive.org/*", "*://archive.today/*", "*://archive.is/*", "*://archive.ph/*", "*://archive.fo/*"], "js": ["content-scripts/archive-checker.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pages/changelog/changelog.html", "pages/changelog/changelog-styles.css", "pages/changelog/changelog-script.js", "pages/changelog/changelog-data.js", "content-scripts/show-cant-archive-modal.js"], "matches": ["<all_urls>"]}]}