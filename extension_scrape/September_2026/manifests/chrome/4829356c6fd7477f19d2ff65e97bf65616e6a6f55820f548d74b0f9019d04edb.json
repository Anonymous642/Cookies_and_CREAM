{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Payora Note Taker", "version": "1.0.15", "description": "Enregistre et transcrit vos appels Google Meet, puis classe le compte rendu directement dans la fiche client de votre CRM Payora.", "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "scripting"], "host_permissions": ["https://meet.google.com/*", "https://app.payora.ai/*", "https://server.payora.ai/*", "https://lh3.googleusercontent.com/*", "https://firebasestorage.googleapis.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "exclude_matches": ["https://meet.google.com/", "https://meet.google.com/landing*"], "js": ["config.js", "content-meet.js"], "run_at": "document_end"}, {"matches": ["https://app.payora.ai/*"], "js": ["config.js", "bridge.js"], "run_at": "document_idle"}, {"matches": ["https://app.payora.ai/*"], "js": ["bridge-main.js"], "world": "MAIN", "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Payora Note Taker"}, "web_accessible_resources": [{"resources": ["icons/*.png", "fonts/inter-var.woff2"], "matches": ["https://meet.google.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Ouvrir Payora Note Taker"}}}