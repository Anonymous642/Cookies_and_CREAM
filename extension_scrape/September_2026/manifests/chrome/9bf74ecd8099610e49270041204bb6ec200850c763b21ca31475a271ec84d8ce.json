{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReminderLens", "description": "Never forget what to do on a website. Attach reminders and persistent notes to pages \u2014 memory for the web.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "contextMenus", "alarms", "sidePanel", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "ReminderLens", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Open ReminderLens"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}]}