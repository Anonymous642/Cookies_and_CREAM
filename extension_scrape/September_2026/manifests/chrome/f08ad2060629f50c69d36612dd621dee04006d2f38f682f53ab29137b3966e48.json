{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grokipedia for Chrome", "version": "1.0.0", "description": "Integrates Grokipedia into your search experience!", "permissions": ["contextMenus", "sidePanel", "storage", "tabs"], "host_permissions": ["https://grokipedia.com/*", "https://www.google.com/*", "https://google.com/*", "https://*.wikipedia.org/*"], "background": {"service_worker": "background.js", "type": "module"}, "omnibox": {"keyword": "grokipedia"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_title": "Open Grokipedia Research Panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://google.com/search*"], "js": ["utils/url.js", "utils/icon.js", "content-scripts/google.js"], "css": ["styles/grokipedia-ui.css"], "run_at": "document_idle"}, {"matches": ["*://*.wikipedia.org/wiki/*"], "exclude_matches": ["*://*.wikipedia.org/wiki/Special:*", "*://*.wikipedia.org/wiki/Wikipedia:*", "*://*.wikipedia.org/wiki/Help:*", "*://*.wikipedia.org/wiki/File:*", "*://*.wikipedia.org/wiki/Template:*"], "js": ["utils/url.js", "utils/icon.js", "content-scripts/wikipedia.js"], "css": ["styles/grokipedia-ui.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png"], "matches": ["https://www.google.com/*", "https://google.com/*", "https://*.wikipedia.org/*"]}]}