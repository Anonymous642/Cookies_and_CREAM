{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skim Recap", "version": "0.4.1", "description": "Detects fast scrolling and summarizes the skipped text on-device with Gemma (LiteRT-LM).", "author": {"email": "yuimoriistudio@gmail.com"}, "homepage_url": "https://github.com/itsyuimorii", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["offscreen", "storage", "unlimitedStorage"], "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*"], "background": {"service_worker": "dist/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content.css", "fonts/*.woff2"], "matches": ["http://*/*", "https://*/*", "file:///*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"toggle-enabled": {"description": "Turn Skim Recap on or off"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}