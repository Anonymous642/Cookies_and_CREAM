{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyteClone - Website Design Inspector", "version": "1.0.0", "description": "Extract and save colors from any website. Full-page screenshots, font detection, CSS extraction, and asset downloading.", "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "downloads"], "host_permissions": ["<all_urls>", "https://extensionpay.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["https://extensionpay.com/*"], "js": ["extpay-content.js"], "run_at": "document_start"}], "options_page": "options.html", "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["*.png", "*.ico", "*.svg", "*.css", "*.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "open_side_panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the side panel"}}}