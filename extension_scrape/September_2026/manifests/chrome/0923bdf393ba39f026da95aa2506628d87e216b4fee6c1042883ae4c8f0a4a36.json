{"update_url": "https://clients2.google.com/service/update2/crx", "name": "LinkedIn Focus", "version": "0.1.0", "manifest_version": 3, "description": "Blocks LinkedIn after 5 minutes of aimless browsing. Set a goal first; the timer only runs when you're off task.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "LinkedIn Focus", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.linkedin.com/*"], "web_accessible_resources": [{"resources": ["ui/blocked.html"], "matches": ["https://www.linkedin.com/*"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content/linkedin.js"], "run_at": "document_idle", "all_frames": false}]}