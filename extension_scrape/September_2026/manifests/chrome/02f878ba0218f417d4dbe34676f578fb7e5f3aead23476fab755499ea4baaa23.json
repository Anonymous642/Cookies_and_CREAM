{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "trawlernet - amazon product filtering extension", "version": "2.0", "description": "trawlernet filters Amazon products based on country of origin or small business, empowering ethical consumerism.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://www.amazon.com/*", "https://trawlernet-functions.azurewebsites.net/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon.png", "icon_filtering.png"], "matches": ["<all_urls>"]}]}