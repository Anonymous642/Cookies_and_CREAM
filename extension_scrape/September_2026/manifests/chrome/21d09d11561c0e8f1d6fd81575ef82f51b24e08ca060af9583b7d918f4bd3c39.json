{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal Clipboard - Copy & Paste Between Devices", "version": "0.7.0", "description": "Copy on your phone, paste on your laptop. One clipboard that follows you across Android, iPhone, Chrome and the web.", "permissions": ["contextMenus", "storage", "unlimitedStorage", "clipboardWrite", "offscreen", "notifications", "alarms", "activeTab", "scripting"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"save-selection": {"suggested_key": {"default": "Alt+C"}, "description": "Save the selected text to Universal Clipboard"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Universal Clipboard", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup/index.html"}, "minimum_chrome_version": "127", "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.instagram.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.reddit.com/*", "https://*.twitch.tv/*", "https://*.claude.ai/*", "https://*.chatgpt.com/*"], "js": ["content/share.js"], "run_at": "document_idle", "all_frames": false}], "externally_connectable": {"matches": ["https://uniclip.app/*", "https://web.uniclip.app/*"]}}