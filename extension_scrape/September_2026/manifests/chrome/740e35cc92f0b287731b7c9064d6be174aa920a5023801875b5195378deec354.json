{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptHush", "description": "A local-first privacy firewall for AI prompts.", "version": "0.1.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "PromptHush", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "identity", "downloads"], "host_permissions": ["https://prompthush.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "js": ["config.js", "detect.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}