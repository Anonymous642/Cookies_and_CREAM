{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Millisave LinkedIn Clipper", "version": "1.0.18", "description": "Copy visible LinkedIn profile fields into Millisave using your existing Millisave login (session cookies).", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://online.millisave.com/*", "https://*.millisave.com/*"], "optional_host_permissions": ["https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Millisave LinkedIn Clipper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"clip-crm-contact": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Clip the current LinkedIn profile to Millisave CRM"}}, "externally_connectable": {"matches": ["https://*.millisave.com/*"]}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["profileCapture.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}