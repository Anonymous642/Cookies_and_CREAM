{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AlgoLeague Companion", "version": "1.0.0", "description": "Parse competitive programming problems from algoleague.com and send them to CPH or similar tools", "author": "Mustafa", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://algoleague.com/*", "http://localhost/*", "http://127.0.0.1/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AlgoLeague Companion"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://algoleague.com/problem/*/detail*"], "js": ["content.js"], "run_at": "document_idle"}]}