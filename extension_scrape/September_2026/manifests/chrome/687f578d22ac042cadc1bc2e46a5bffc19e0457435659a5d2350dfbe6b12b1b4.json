{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Scroller", "version": "0.5.0", "description": "Autoscrolls your X/LinkedIn feed, finds posts matching your topics, and drafts a short question for you to review and reply.", "permissions": ["storage", "activeTab", "sidePanel", "notifications"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://social-scroller-backend.vercel.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/common.js", "content/x.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content/common.js", "content/linkedin.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_title": "Social Scroller"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}