{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meesho Autofill & Profile Manager", "version": "1.3", "description": "Autofill repeated Meesho product details in one click. Save time, capture once, reuse forever on supplier.meesho.com.", "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"], "host_permissions": ["*://supplier.meesho.com/*", "https://ecomdost.com/*", "https://www.ecomdost.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "popup.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://supplier.meesho.com/*"], "js": ["selector-utils.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://ecomdost.com/*", "https://www.ecomdost.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["*://supplier.meesho.com/*"]}]}