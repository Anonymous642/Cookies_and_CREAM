{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Daily Trace", "version": "0.2.3", "description": "Passively capture your day's browsing and turn it into a calm daily journal \u2014 read it in your Daily Trace web app.", "permissions": ["history", "storage", "alarms", "tabs", "identity"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Daily Trace", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}