{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Toolkit", "description": "A professional all-in-one browser productivity toolkit with PiP, refresher, reader, script control, magnifier, and page editor.", "version": "1.0.4", "permissions": ["tabs", "storage", "scripting", "alarms", "notifications", "contentSettings", "browsingData"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Browser Toolkit", "default_popup": "popup.html", "default_icon": "icons/icon128.png"}, "options_page": "options.html", "icons": {"128": "icons/icon128.png"}, "commands": {"toggle-magnifier": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle magnifier overlay"}, "toggle-reader-theme": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle forced reader mode"}, "toggle-auto-refresh": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle auto refresh for current tab"}, "toggle-page-editor": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Toggle page edit mode for current tab"}}, "web_accessible_resources": [{"resources": ["modules/magnifier/magnifier.css", "modules/pageeditor/pageeditor-banner.css"], "matches": ["<all_urls>"]}]}