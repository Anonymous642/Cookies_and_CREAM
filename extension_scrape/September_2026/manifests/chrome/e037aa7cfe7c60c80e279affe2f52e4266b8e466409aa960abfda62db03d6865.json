{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Onyx Agent", "version": "0.1.0", "description": "User-initiated candidate capture from various platforms for verified recruiters.", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://www.linkedin.com/*", "https://*.getonyxagent.com/*", "https://*.vercel.app/*", "http://localhost/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Onyx LinkedIn Capture", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}