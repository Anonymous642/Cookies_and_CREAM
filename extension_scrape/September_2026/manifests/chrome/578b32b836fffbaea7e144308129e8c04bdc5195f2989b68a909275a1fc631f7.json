{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Review Shortcuts for GitHub", "version": "2.0.0", "description": "Keyboard shortcuts for GitHub pull request reviews: mark files viewed, jump to the next unviewed file, and track review progress.", "permissions": ["storage"], "host_permissions": ["https://github.com/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["src/defaults.js", "src/content.js"], "run_at": "document_idle"}], "commands": {"toggle-viewed": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "Toggle Viewed on the current file"}, "viewed-and-next": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Toggle Viewed, then jump to the next unviewed file"}, "next-file": {"suggested_key": {"default": "Alt+J", "mac": "Alt+J"}, "description": "Jump to the next file"}, "prev-file": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "Jump to the previous file"}}}