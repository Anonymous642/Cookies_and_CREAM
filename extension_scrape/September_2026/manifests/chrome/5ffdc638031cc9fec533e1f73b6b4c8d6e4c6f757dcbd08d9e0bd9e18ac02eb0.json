{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZeTabs", "version": "1.0.0", "description": "Save and restore browser tab sessions. 3 free sessions per day. Upgrade to Pro for unlimited sessions.", "author": "okasablack.com", "permissions": ["tabs", "storage", "unlimitedStorage", "notifications"], "host_permissions": ["https://zetabs.com/*", "https://zetabs-api.vercel.app/*", "http://localhost:3000/*", "http://localhost:3001/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/Thumb.png", "32": "assets/icons/Thumb.png", "48": "assets/icons/Thumb.png", "128": "assets/icons/Thumb.png"}}, "background": {"service_worker": "scripts/background.js"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save current tab session"}}}