{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slate Bookmarks", "version": "0.3.0", "description": "Save the current tab to Slate \u2014 as a bookmark, or clip the article as a note.", "permissions": ["activeTab", "storage", "scripting", "contextMenus"], "action": {"default_title": "Save to Slate"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Save the current tab to Slate as a bookmark"}, "clip-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Clip the current page to Slate as a note"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}