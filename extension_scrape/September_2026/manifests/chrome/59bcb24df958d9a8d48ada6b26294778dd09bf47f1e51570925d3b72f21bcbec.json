{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumia Facebook Chat Bridge", "description": "Captures Facebook/Workplace live chat in Chrome and forwards it to LumiaStream via the local API.", "version": "0.1.1", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://*.facebook.com/*", "https://*.workplace.com/*", "http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*", "ws://localhost/*", "wss://localhost/*", "ws://127.0.0.1/*", "wss://127.0.0.1/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Lumia Facebook Chat Bridge", "default_popup": "popup.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://*.facebook.com/*", "https://*.workplace.com/*"], "js": ["content-facebook.js"], "run_at": "document_idle"}]}