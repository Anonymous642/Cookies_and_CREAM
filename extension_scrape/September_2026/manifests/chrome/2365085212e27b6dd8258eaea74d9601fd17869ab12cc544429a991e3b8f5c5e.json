{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SidebarX: Fast Native Bookmarks Sidebar", "description": "A fast, native bookmarks sidebar manager. Search, expand, and open browser folder trees instantly via keyboard shortcuts.", "version": "1.2.0", "short_name": "SidebarX", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["bookmarks", "storage", "sidePanel"], "action": {"default_title": "Toggle SidebarX"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+B"}, "description": "Toggle the bookmarks sidebar"}, "expand-all": {"description": "Expand all folders"}, "collapse-all": {"description": "Collapse all folders"}, "focus-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Focus the search box"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}