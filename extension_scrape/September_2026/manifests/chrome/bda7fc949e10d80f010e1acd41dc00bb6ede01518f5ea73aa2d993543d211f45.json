{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DevSnipe", "description": "DevSnipe finds freelance jobs across Upwork, LinkedIn, Indeed, Skool and Freelancer. This extension drafts and files your proposal.", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://*.upwork.com/*", "https://devsnipe.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "DevSnipe", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.upwork.com/*"], "js": ["content-scripts/content.js"]}]}