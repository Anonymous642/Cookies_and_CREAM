{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shorts Gate", "version": "2.1.0", "description": "Before YouTube Shorts opens, choose how long and what you'll do after, then keeps a record of promises kept.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "options_ui": {"page": "options.html", "open_in_tab": false}, "action": {"default_title": "Shorts Gate settings", "default_popup": "options.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "css": ["overlay.css"], "js": ["content.js"], "run_at": "document_idle"}]}