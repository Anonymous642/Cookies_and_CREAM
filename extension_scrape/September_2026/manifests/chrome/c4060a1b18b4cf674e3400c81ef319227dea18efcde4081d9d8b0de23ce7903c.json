{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Actual Pomodoro - Best Cure for Brain Rot", "version": "1.0.0", "description": "Pomodoro timer with website blocking and Shorts/Reels removal for YouTube, Instagram & Facebook. Improve focus and productivity.", "permissions": ["storage", "tabs", "alarms", "notifications", "offscreen"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Actual Pomodoro", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_ui": {"page": "pages/dashboard.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"], "js": ["content/banner.js", "content/shorts-blocker.js"], "run_at": "document_start"}, {"matches": ["*://www.instagram.com/*", "*://instagram.com/*"], "js": ["content/banner.js", "content/instagram-reels-blocker.js"], "run_at": "document_start"}, {"matches": ["*://www.facebook.com/*", "*://facebook.com/*", "*://m.facebook.com/*"], "js": ["content/banner.js", "content/facebook-reels-blocker.js"], "run_at": "document_start"}, {"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*", "*://www.instagram.com/*", "*://instagram.com/*", "*://www.facebook.com/*", "*://facebook.com/*", "*://m.facebook.com/*"], "js": ["content/patreon-toast.js"], "run_at": "document_idle"}]}