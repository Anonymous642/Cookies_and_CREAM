{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "issueboard \u2014 report an issue", "version": "0.7.0", "description": "Report bugs to issueboard from any page: screenshot with annotation, console errors, page context. Uses your existing sign-in.", "minimum_chrome_version": "116", "action": {"default_popup": "popup.html", "default_title": "Report an issue to issueboard"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "scripting", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["popup.html", "assets/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}