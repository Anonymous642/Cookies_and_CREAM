{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Xtractly \u2014 Website to React & Tailwind Code", "version": "2.0.0", "description": "Copy any website element as React, Tailwind, HTML, Vue or Svelte code, plus its colors, fonts and assets. Formerly ScrapeStudio.", "short_name": "Xtractly", "homepage_url": "https://www.xtractly.app", "minimum_chrome_version": "88", "icons": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png", "128": "icons/favicon-128.png"}, "action": {"default_title": "Xtractly", "default_icon": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png", "128": "icons/favicon-128.png"}}, "background": {"service_worker": "src/Background/index.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/ContentScript/index.js"], "run_at": "document_end"}], "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://xtractly.app/*", "https://*.xtractly.app/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"toggle-scraping": {"suggested_key": {"default": "Alt+C"}, "description": "Extract an element \u2014 start or stop picking"}, "start-font-inspection": {"suggested_key": {"default": "Alt+F"}, "description": "Open fonts & colors (Design System panel)"}, "start-color-picker": {"suggested_key": {"default": "Alt+P"}, "description": "Pick a color from the page"}, "start-download-asset": {"suggested_key": {"default": "Alt+D"}, "description": "Open the Assets panel"}}}