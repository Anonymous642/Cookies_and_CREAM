{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusGuard \u2014 Distraction Blocker", "version": "3.0.0", "description": "Personal productivity tool. Blocks distracting websites and specific YouTube channels. All data stays on-device.", "permissions": ["tabs", "storage", "alarms", "notifications", "webNavigation", "windows", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://web.whatsapp.com/*", "*://*.whatsapp.com/*", "*://*.linkedin.com/*", "http://localhost:3001/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["content/instagram.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content/x.js"], "run_at": "document_idle"}, {"matches": ["*://web.whatsapp.com/*"], "js": ["content/whatsapp.js"], "run_at": "document_idle"}, {"matches": ["*://*.linkedin.com/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FocusGuard"}, "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/ascii-canvas.js", "icons/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}