{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pulse Assistant", "version": "1.1.9", "description": "AI side panel that researches the prospect on your screen and drafts outreach you approve. Works on LinkedIn, HubSpot, and Gmail.", "permissions": ["sidePanel", "storage", "tabs", "scripting"], "host_permissions": ["https://ether-ego-api.onrender.com/*", "https://*.linkedin.com/*", "https://*.hubspot.com/*", "https://*.apollo.io/*", "https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.clay.com/*", "https://mail.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Pulse", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.hubspot.com/*", "https://*.apollo.io/*", "https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.clay.com/*", "https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}