{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook Post ID Displayer by Adacted.com", "version": "1.8", "description": "Displays and copies the Post ID for Facebook and Facebook Business Manager video URLs", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://business.facebook.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Facebook Post ID Displayer"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://business.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}