{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemoryBox for Chrome", "description": "Save, search, and use MemoryBox items from the browser side panel.", "version": "1.2.0", "action": {"default_title": "Open MemoryBox"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://memorybox.lk/*"], "js": ["web-bridge.js"], "run_at": "document_start"}], "side_panel": {"default_path": "src/side-panel/index.html"}, "commands": {"memorybox-add-current-page": {"description": "Add the current page to MemoryBox"}, "memorybox-capture-area": {"description": "Capture an area with MemoryBox"}, "memorybox-capture-visible-area": {"description": "Capture the visible area with MemoryBox"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "192": "icon-192.png"}, "web_accessible_resources": [{"resources": ["icon-32.png"], "matches": ["http://*/*", "https://*/*"]}], "permissions": ["sidePanel", "alarms", "storage", "activeTab", "contextMenus", "scripting"], "optional_permissions": ["notifications"], "host_permissions": ["https://memorybox.lk/*"]}