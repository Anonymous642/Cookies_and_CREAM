{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Burrow: Stop Reddit Doomscrolling", "version": "0.1.0", "manifest_version": 3, "description": "A Reddit blocker that reads your behavior, not the clock.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Burrow", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms", "scripting"], "web_accessible_resources": [{"resources": ["ui/blocked.html", "ui/blocked.js"], "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"]}], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://burrow.app/*"], "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["src/content/reddit.js"], "run_at": "document_idle"}, {"matches": ["https://burrow.app/*"], "js": ["src/content/site-theme.js"], "run_at": "document_start"}]}