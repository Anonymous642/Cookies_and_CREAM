{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pulse \u2014 Activity Assistant for X", "version": "0.1.0", "description": "Analyses the X post you're viewing and suggests a like + reply. You approve every action \u2014 no blind automation.", "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "background": {"service_worker": "bg.js"}, "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_title": "Pulse", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}