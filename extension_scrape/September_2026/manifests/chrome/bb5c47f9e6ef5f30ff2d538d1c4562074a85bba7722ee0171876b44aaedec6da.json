{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShortBlock", "version": "1.9.0", "description": "Hides YouTube Shorts and Instagram/Facebook Reels: nav, feeds, search, DMs \u2014 and redirects short-form links home.", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "youtube_redirect", "enabled": true, "path": "rules/youtube.json"}, {"id": "instagram_redirect", "enabled": true, "path": "rules/instagram.json"}, {"id": "facebook_redirect", "enabled": true, "path": "rules/facebook.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["src/youtube/youtube.css"], "js": ["src/common/settings.js", "src/youtube/youtube.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.instagram.com/*"], "css": ["src/instagram/instagram.css"], "js": ["src/common/settings.js", "src/common/social.js", "src/instagram/instagram.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.facebook.com/*"], "css": ["src/facebook/facebook.css"], "js": ["src/common/settings.js", "src/common/social.js", "src/facebook/facebook.js"], "run_at": "document_start", "all_frames": false}]}