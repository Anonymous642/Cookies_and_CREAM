{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "V+ Filter f\u00fcr VOL.AT", "version": "1.0.5", "description": "Blendet kostenpflichtige V+ Artikel auf vol.at aus oder ab und warnt auf Artikelseiten hinter der Bezahlschranke.", "homepage_url": "https://www.fahrvergnuegen.com/dev/ext/vplusfilter/", "permissions": ["storage"], "host_permissions": ["*://*.vol.at/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png", "512": "icon-512.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.vol.at/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}