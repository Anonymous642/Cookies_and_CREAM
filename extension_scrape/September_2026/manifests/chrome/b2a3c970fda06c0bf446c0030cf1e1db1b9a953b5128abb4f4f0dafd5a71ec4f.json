{"update_url": "https://clients2.google.com/service/update2/crx", "name": "BookMook", "description": "Moves new bookmarks to the top of the folder", "version": "1.0.4", "manifest_version": 3, "icons": {"32": "images/bookmark-on-32.png", "64": "images/bookmark-on-64.png", "128": "images/bookmark-on-128.png"}, "action": {"default_title": "New bookmarks upwards", "default_icon": {"32": "images/bookmark-on-32.png", "64": "images/bookmark-on-64.png", "128": "images/bookmark-on-128.png"}}, "background": {"service_worker": "service_worker.js"}, "permissions": ["bookmarks", "storage"]}