{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Team Book Club", "version": "1.0.1", "description": "Suggest books to your book club from Goodreads, Amazon, and NYT Best Sellers", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.goodreads.com/*", "https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.nytimes.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.goodreads.com/book/show/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.ca/*/dp/*", "https://www.amazon.ca/dp/*", "https://www.nytimes.com/books/best-sellers", "https://www.nytimes.com/books/best-sellers/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "externally_connectable": {"matches": ["https://teambook.club/*", "https://*.teambook.club/*"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}