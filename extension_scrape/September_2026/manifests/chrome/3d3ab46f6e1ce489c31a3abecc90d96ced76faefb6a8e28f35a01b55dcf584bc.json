{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twenty CRM - LinkedIn Capture", "description": "Quickly add LinkedIn profiles and companies to your Twenty CRM", "version": "1.0.11", "short_name": "Twenty CRM", "icons": {"16": "logo-16.png", "32": "logo-32.png", "48": "logo-48.png", "128": "logo-128.png"}, "permissions": ["activeTab", "storage", "cookies", "sidePanel"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "optional_host_permissions": ["*://*/*"], "action": {}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/company/*", "*://*.linkedin.com/in/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}