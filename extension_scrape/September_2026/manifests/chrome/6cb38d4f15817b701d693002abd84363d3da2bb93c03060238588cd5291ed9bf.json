{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Autoscroller - Multi-Tab Functionality for Hands-Free Reading", "short_name": "Easy Auto", "version": "1.0.2", "description": "Hands-free scrolling at the speed you choose. Each tab keeps its own tempo. Read, lyrics, or feeds.", "action": {"default_title": "Easy Autoscroller", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "identity", "tabs", "scripting"], "host_permissions": ["https://*.supabase.co/*", "https://*.vercel.app/*"], "commands": {"toggle-scroll": {"suggested_key": {"default": "Alt+S"}, "description": "Start or pause auto-scroll"}, "speed-up": {"suggested_key": {"default": "Alt+Up"}, "description": "Scroll faster"}, "speed-down": {"suggested_key": {"default": "Alt+Down"}, "description": "Scroll slower"}}}