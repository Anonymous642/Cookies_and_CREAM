{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Custom Redirector", "version": "1.0.1", "description": "Redirect Reddit links to your preferred custom domain or alternative Reddit frontend with configurable URL settings", "author": "Hasham Babar", "homepage_url": "https://github.com/hash004/reddit-custom-redirector", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://reddit.com/*", "*://www.reddit.com/*"], "icons": {"32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Reddit Custom Redirector", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}}