{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Code Generator and Scanner", "description": "A modern QR code generator and scanner extension", "default_locale": "en", "version": "1.0.0", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["activeTab", "tabs"], "action": {"default_icon": {"19": "images/icon19.png", "38": "images/icon38.png"}, "default_title": "The QR Code Extension", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["scanner.html"], "matches": ["<all_urls>"]}]}