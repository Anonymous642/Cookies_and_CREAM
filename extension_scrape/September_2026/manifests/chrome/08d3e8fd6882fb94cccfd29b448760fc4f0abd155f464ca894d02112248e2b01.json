{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cookie Monsters", "version": "3.0", "description": "Tired of clicking that cookie popup on every single site? Your monster makes it disappear. Forever.", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "cmp_blocklist", "enabled": true, "path": "rules.json"}]}, "action": {"default_popup": "popup.html", "default_title": "Cookie Monsters"}, "icons": {"16": "icons/icon16.ico", "32": "icons/icon32.ico"}}