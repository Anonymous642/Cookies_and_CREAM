{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clickbait Article Summariser", "version": "2.0.0", "description": "Summarize articles, generate study questions and answers, and access archived versions of web pages for research and learning.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}