{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UpworkScribe", "version": "1.0.2", "description": "Generate winning Upwork proposals in one click. Sync your profile and extract job details directly into UpworkScribe.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "UpworkScribe"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.upwork.com/freelancers/*", "https://*.upwork.com/users/*"], "js": ["content-profile.js"], "run_at": "document_idle"}, {"matches": ["https://*.upwork.com/jobs/*", "https://*.upwork.com/ab/jobs/search/view/*", "https://*.upwork.com/nx/jobs/search/job-detail/*", "https://*.upwork.com/nx/proposals/job-details/*", "https://*.upwork.com/nx/search/jobs/*"], "js": ["content-job.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://www.upwork.com/*", "https://upworkscribe.com/*", "https://www.upworkscribe.com/*", "http://localhost:3001/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.upwork.com/*"]}], "externally_connectable": {"matches": ["https://upworkscribe.com/*", "https://www.upworkscribe.com/*", "http://localhost:3001/*"]}}