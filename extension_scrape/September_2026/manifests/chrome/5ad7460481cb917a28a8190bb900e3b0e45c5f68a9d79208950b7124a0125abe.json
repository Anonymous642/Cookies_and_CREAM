{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stack - Tab Manager & Session Saver", "version": "2.2.0", "description": "Save tabs as named stacks. Restore with one keystroke (scroll + form state intact). Diff view, fuzzy search. OneTab alternative.", "minimum_chrome_version": "120", "permissions": ["tabs", "tabGroups", "storage", "contextMenus", "scripting", "history", "alarms"], "omnibox": {"keyword": "stack"}, "optional_permissions": ["identity"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "bg/index.js", "type": "module"}, "options_page": "options/index.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open stack popup"}, "workspace_1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Restore workspace slot 1"}, "workspace_2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Restore workspace slot 2"}, "workspace_3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Restore workspace slot 3"}, "workspace_4": {"description": "Restore workspace slot 4 (bind in chrome://extensions/shortcuts)"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}