{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy AI Prompt Library", "version": "1.0.0", "description": "Save, organize, and instantly insert AI prompts into ChatGPT, Gemini, Copilot, Claude and more.", "author": "Ray Chan", "homepage_url": "https://raychan.net", "permissions": ["storage", "contextMenus", "activeTab", "clipboardWrite", "scripting"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-128.png", "48": "assets/icon-128.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-128.png", "48": "assets/icon-128.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://claude.ai/*", "https://chat.deepseek.com/*", "https://deepseek.com/*", "https://perplexity.ai/*", "https://poe.com/*", "https://you.com/*", "https://huggingface.co/*", "https://groq.com/*", "https://x.ai/*", "https://meta.ai/*", "https://mistral.ai/*", "https://cohere.com/*", "https://anthropic.com/*"], "js": ["content/trigger-handler.js", "content/floating-button.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"open-prompt-picker": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open prompt library picker"}}}