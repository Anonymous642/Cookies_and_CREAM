{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MSTeams.link Shortener", "version": "0.1.1", "description": "Create short links for Microsoft Teams meetings.", "action": {"default_popup": "popup.html", "default_title": "MSTeams.link"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "tabs", "clipboardWrite", "storage"], "host_permissions": ["https://msteams.link/*", "https://teams.microsoft.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "content_scripts": [{"matches": ["https://teams.microsoft.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "js": ["teams-content.js"], "run_at": "document_idle"}], "icons": {"128": "icon128.png"}}