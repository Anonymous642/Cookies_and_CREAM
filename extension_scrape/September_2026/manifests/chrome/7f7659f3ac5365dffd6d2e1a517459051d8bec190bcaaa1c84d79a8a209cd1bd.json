{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TrackRotate", "description": "A extension that displays TrackRotate data in your Spotify playlists", "version": "0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["cookies", "storage"], "host_permissions": ["*://open.spotify.com/playlist/*", "*://*.trackrotate.com/*", "*://localhost/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "\n      TrackRotate\n    ", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://open.spotify.com/playlist/*"], "js": ["content-scripts/content.js"]}]}