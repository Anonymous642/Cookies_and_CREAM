{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Understudy: job application autofill", "short_name": "Understudy", "version": "1.121.16", "description": "Sends the job applications you approved in Understudy from your own browser, in a background tab.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"], "host_permissions": ["https://understudy.live/*", "https://mail.google.com/*", "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://jobs.smartrecruiters.com/*"], "content_scripts": [{"matches": ["https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.eu.lever.co/*", "https://jobs.ashbyhq.com/*", "https://apply.workable.com/*", "https://*.recruitee.com/*", "https://ats.rippling.com/*"], "js": ["filler.js", "content.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://jobs.smartrecruiters.com/*"], "js": ["filler.js", "smartrecruiters.js", "content.js"], "all_frames": false, "run_at": "document_idle"}, {"matches": ["https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*"], "js": ["filler.js", "workday.js", "content.js"], "all_frames": false, "run_at": "document_idle"}, {"matches": ["https://understudy.live/*"], "js": ["app-bridge.js"], "run_at": "document_start"}]}