{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InstantIndexNow \u2014 IndexNow Submitter & Redirect Tracer", "version": "1.0.0", "description": "Submit URLs via IndexNow with your key file verified first. Trace redirect chains hop by hop and unshorten links.", "minimum_chrome_version": "116", "homepage_url": "https://instantindexnow.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "InstantIndexNow", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["contextMenus", "storage", "tabs", "webRequest", "scripting", "notifications", "clipboardWrite"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Open InstantIndexNow"}, "submit-current-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Submit the current page to IndexNow"}, "trace-current-tab": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Trace the current tab's redirects"}, "traffic-current-tab": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Check traffic for the current site"}}}