{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timi - Add bookmarks to YouTube videos", "version": "1.0", "description": "Save important moments in YouTube videos with timestamps and notes. Simply press Ctrl + ; to mark any moment while watching.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Timi - Add bookmarks to YouTube videos"}, "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}}