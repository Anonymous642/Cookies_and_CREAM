{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShopInspect by Elevven11", "version": "1.0.0", "description": "Inspect a product before you buy it. Price, reviews, seller, details and value, analysed in your browser. Free, private, no account.", "minimum_chrome_version": "116", "action": {"default_popup": "popup/index.html", "default_title": "ShopInspect", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "web_accessible_resources": [{"resources": ["fonts/outfit.woff2", "icons/icon-48.png"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Inspect the product on this page"}}}