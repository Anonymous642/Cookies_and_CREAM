{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mobicip Parental Control with Screen Time", "short_name": "Mobicip", "version": "4.1.2", "description": "Create a safe experience for your family using Mobicip's powerful parental control software with internet filter and screen time.", "options_page": "html/options.html", "background": {"service_worker": "js/service_worker.js", "type": "module"}, "action": {"default_icon": "images/favicon.png", "default_popup": "html/mobicip_popup.html", "default_title": "Mobicip"}, "icons": {"128": "images/favicon.png"}, "web_accessible_resources": [{"resources": ["images/*.png", "css/*.css", "script/*.js", "html/*.html"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'  ; object-src 'self'"}, "permissions": ["tabs", "storage", "proxy", "alarms", "identity", "identity.email", "management", "idle", "declarativeNetRequest"], "host_permissions": ["<all_urls>"]}