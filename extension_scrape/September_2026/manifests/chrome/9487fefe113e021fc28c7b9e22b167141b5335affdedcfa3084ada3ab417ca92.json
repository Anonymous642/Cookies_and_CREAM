{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Product Extractor", "version": "7.0.0", "description": "Extract product title, price, currency, images, description and specifications from Amazon.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.ca/*", "https://*.amazon.es/*", "https://*.amazon.it/*", "https://*.amazon.sa/*", "https://raw.githubusercontent.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.ca/*", "https://*.amazon.es/*", "https://*.amazon.it/*", "https://*.amazon.sa/*"], "js": ["core/utils.js", "core/selectors.js", "platforms/amazon.js", "platforms/specs.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["inject.js", "selectors.json"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}}