{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Screenshot Pro", "version": "2.3.4", "description": "Capture YouTube screenshots with color filters, subtitles, and your own branding logo.", "permissions": ["activeTab", "scripting", "downloads", "storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "YouTube Screenshot Pro"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Alt+S"}, "description": "Quick screenshot (apply current filter if set)"}, "toggle-ui": {"suggested_key": {"default": "Alt+X"}, "description": "Open/Close Screenshot Tool (clear filters & settings)"}, "toggle-minimize": {"suggested_key": {"default": "Alt+Z"}, "description": "Minimize/Restore Screenshot Tool (keep filters & settings)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["ui.js", "ui.css", "icons/icon128.png"], "matches": ["https://www.youtube.com/*"]}]}