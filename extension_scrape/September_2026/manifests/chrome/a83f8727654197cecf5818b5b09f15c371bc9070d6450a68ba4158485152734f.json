{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneClickShot - Screenshot & Screen Recorder", "version": "0.2.0", "description": "Screenshot & screen-record in one click: visible, region, full-page or delayed capture, plus tab, desktop and camera recording.", "action": {"default_popup": "src/popup/index.html", "default_title": "OneClickShot"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "tabCapture", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["ffmpeg/ffmpeg-core.js", "ffmpeg/ffmpeg-core.wasm"], "use_dynamic_url": false}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Take a screenshot of the visible part of the page"}, "stop-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop the current recording"}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause or resume the current recording"}}}