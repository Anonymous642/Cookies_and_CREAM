{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Impulse Block", "version": "3.0.0", "description": "Bloqueo web por dominio con lista negra/blanca, redes sociales, estad\u00edsticas y reactivaci\u00f3n autom\u00e1tica.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "tabs", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Impulse Block", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "declarative_net_request": {"rule_resources": [{"id": "blocklist", "enabled": true, "path": "rules.json"}]}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["unblocked.html", "unblocked.js", "blocked.html", "blocked.js", "welcome.html", "welcome.js", "help.html", "help.js"], "matches": ["<all_urls>"]}]}