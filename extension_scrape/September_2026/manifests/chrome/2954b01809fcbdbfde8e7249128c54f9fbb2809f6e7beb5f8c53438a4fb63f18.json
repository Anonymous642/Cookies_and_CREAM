{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lado \u2014 Key & BPM Overlay", "version": "1.2.2", "description": "Instant BPM, key & Camelot for YouTube, SoundCloud and Bandcamp. Tap tempo, metronome, pitch reference. No account, no tracking.", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://soundcloud.com/*", "https://bandcamp.com/*", "https://*.bandcamp.com/*", "https://api.getsong.co/*", "https://reccobeats.com/*", "https://musicbrainz.org/*", "https://extensionpay.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://soundcloud.com/*", "https://bandcamp.com/*", "https://*.bandcamp.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png", "onboarding.html", "onboarding.js", "options.js"], "matches": ["https://www.youtube.com/*", "https://soundcloud.com/*", "https://bandcamp.com/*", "https://*.bandcamp.com/*"]}, {"resources": ["onboarding.html", "onboarding.js", "options.js"], "matches": ["<all_urls>"]}]}