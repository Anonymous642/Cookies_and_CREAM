{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode Blacklist", "description": "Blacklist LeetCode problems to hide or grey them out from problem lists.", "version": "1.0.0", "permissions": ["storage"], "host_permissions": ["*://leetcode.com/*"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background/index.js"}, "content_scripts": [{"matches": ["*://leetcode.com/*"], "js": ["src/content/index.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}]}