{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Reviews to CSV Exporter", "description": "Export Amazon product reviews to CSV for offline analysis", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "tabs", "downloads"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Amazon Reviews to CSV Exporter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.com/*", "*://*.amazon.in/*"], "js": ["content-scripts/content.js"]}]}