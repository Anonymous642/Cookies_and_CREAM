{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Issue Links for Jira", "short_name": "Issue Links", "version": "1.6.0", "description": "Turns Jira issue keys on GitHub (or any site you choose) into links, with a hover preview and the full description one click away.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://github.com/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Issue Links for Jira settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "optional_host_permissions": ["*://*/*", "https://*.atlassian.net/*", "https://api.media.atlassian.com/*"]}