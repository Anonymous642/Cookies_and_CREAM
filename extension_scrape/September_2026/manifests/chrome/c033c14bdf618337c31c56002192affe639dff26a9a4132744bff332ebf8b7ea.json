{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trobyx Platform Connector", "version": "1.0.4", "description": "Seamlessly connect your social media accounts to Trobyx.", "permissions": ["cookies", "storage", "notifications", "contextMenus"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://app.trobyx.com/*"], "action": {"default_popup": "popup.html", "default_title": "Connect Platform to Trobyx", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content-scripts/linkedin.js"], "run_at": "document_end"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/twitter.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}