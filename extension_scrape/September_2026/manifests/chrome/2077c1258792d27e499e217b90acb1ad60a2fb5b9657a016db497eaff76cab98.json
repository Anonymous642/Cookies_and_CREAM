{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AIbar", "version": "1.0.0", "description": "A unified side panel to chat with multiple AI assistants at once. Multi-pane layouts, broadcast, and page capture.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "contextMenus", "storage", "scripting", "declarativeNetRequest", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://chat.deepseek.com/*", "*://chat.qwen.ai/*", "*://copilot.microsoft.com/*", "*://kimi.moonshot.cn/*", "*://chatglm.cn/*", "*://chat.z.ai/*", "*://perplexity.ai/*", "*://*.perplexity.ai/*", "*://meta.ai/*", "*://*.meta.ai/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "declarative_net_request": {"rule_resources": [{"id": "frame_unblock", "enabled": true, "path": "rules.json"}]}, "action": {"default_title": "Open AIbar Side Panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"trigger-crop-capture": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Trigger region capture screenshot"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://chat.deepseek.com/*", "*://chat.qwen.ai/*", "*://copilot.microsoft.com/*", "*://kimi.moonshot.cn/*", "*://chatglm.cn/*", "*://chat.z.ai/*", "*://perplexity.ai/*", "*://*.perplexity.ai/*", "*://meta.ai/*", "*://*.meta.ai/*"]}]}