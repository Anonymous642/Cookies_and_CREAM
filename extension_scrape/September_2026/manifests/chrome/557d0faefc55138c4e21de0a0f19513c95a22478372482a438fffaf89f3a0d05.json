{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nekolingo \u2014 Study anything", "version": "0.6.0", "description": "Tap a word on YouTube or any web page to look it up and send it to your Nekolingo reviews.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://nekolingo.app/*", "https://www.nekolingo.app/*", "http://127.0.0.1:8000/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"study-page": {"suggested_key": {"default": "Alt+S"}, "description": "Study the text on this page"}}, "web_accessible_resources": [{"resources": ["icons/icon32.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/interceptor.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["src/study-core.js", "src/content.js"], "css": ["src/text.css", "src/content.css"], "world": "ISOLATED", "run_at": "document_idle"}]}