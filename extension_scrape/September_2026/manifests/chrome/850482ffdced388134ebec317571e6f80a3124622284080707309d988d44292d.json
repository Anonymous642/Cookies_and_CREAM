{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitch Mini Player \u2014 Multi-Stream, Clips, VODs, Emotes", "short_name": "Twitch Mini", "description": "Floating Twitch mini player to watch live streams while you browse. Followed channels, clips, VODs, schedule, and emotes.", "version": "3.2", "action": {"default_popup": "popup.html", "default_title": "Twitch Mini Player", "default_icon": "icon.png"}, "permissions": ["tabs", "storage", "identity", "notifications", "alarms", "sidePanel", "declarativeNetRequestWithHostAccess"], "side_panel": {"default_path": "sidepanel.html"}, "declarative_net_request": {"rule_resources": [{"id": "twitch_embed", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}]}