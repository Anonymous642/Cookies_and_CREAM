{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FitCommit", "description": "An extension that allows you to block you from using YouTube if you haven't hit your fitness goals", "version": "1.0.1", "action": {"default_popup": "index.html", "default_icon": "Logo.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["identity", "storage", "activeTab", "tabs", "webNavigation", "scripting", "tabs", "windows"], "oauth2": {"client_id": "23PJZQ", "scopes": ["activity", "heartrate", "location", "profile", "settings", "sleep", "social", "weight"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "host_permissions": ["https://www.youtube.com/*", "https://api.fitbit.com/", "http://localhost:3000/*"], "web_accessible_resources": [{"resources": ["settings.html"], "matches": ["<all_urls>"]}], "icons": {"16": "16x.png", "32": "32x.png", "48": "48x.png", "128": "128x.png"}}