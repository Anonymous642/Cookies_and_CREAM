{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speed Pill", "version": "1.0.6", "description": "Compact on-video speed pill (0.25x-16x) for any website. Hover a video for +/- controls and a live speed readout in the corner.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "Speed Pill", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "js": ["src/i18n-data.js", "src/content.js"], "run_at": "document_start"}]}