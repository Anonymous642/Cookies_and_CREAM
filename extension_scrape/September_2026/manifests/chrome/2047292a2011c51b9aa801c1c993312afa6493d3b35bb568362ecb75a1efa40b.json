{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GatherOS", "version": "0.18.11", "description": "Save tweets, threads, and images from X, Instagram, and Cosmos \u2014 plus anything on the web \u2014 into your local GatherOS library.", "permissions": ["contextMenus", "nativeMessaging", "notifications", "storage", "alarms", "cookies", "activeTab", "scripting"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.cosmos.so/*", "https://cosmos.so/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/x-graphql-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/x-bookmark-watcher.js"], "run_at": "document_end"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content/ig-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content/ig-watcher.js"], "run_at": "document_end"}, {"matches": ["https://www.cosmos.so/*", "https://cosmos.so/*"], "js": ["content/cosmos-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.cosmos.so/*", "https://cosmos.so/*"], "js": ["content/cosmos-watcher.js"], "run_at": "document_end"}], "action": {"default_title": "GatherOS", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "web_accessible_resources": [{"resources": ["icons/icon.png"], "matches": ["<all_urls>"]}]}