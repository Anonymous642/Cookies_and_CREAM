{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopyCal", "version": "1.6", "description": "Easily copy and share your available time slots from Google Calendar.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://calendar.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "CopyCal", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["content.js"]}]}