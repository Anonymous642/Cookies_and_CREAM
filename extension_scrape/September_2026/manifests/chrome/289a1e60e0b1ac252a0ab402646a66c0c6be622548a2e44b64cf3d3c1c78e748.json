{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Screenshot", "description": "Capture a full-page screenshot of the current tab with a keyboard shortcut and save it to Downloads as a PNG.", "version": "1.0.2", "permissions": ["activeTab", "downloads", "scripting"], "action": {"default_title": "Capture the full page"}, "background": {"service_worker": "bg.js"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png"}, "commands": {"snap": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the full page"}}}