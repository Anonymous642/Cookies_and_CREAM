{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenRoll - Screen Recorder", "version": "1.0.6", "description": "Record Chrome tabs or your desktop (screens & windows). 100% free, local-only. Works with skills and automation.", "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs", "downloads", "scripting", "alarms", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/recordingToolbar.js", "content/faceCamOverlay.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "externally_connectable": {"matches": ["https://app.screenroll.dev/*", "https://screenroll.dev/*", "http://localhost:3000/*", "http://localhost:3001/*"]}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}