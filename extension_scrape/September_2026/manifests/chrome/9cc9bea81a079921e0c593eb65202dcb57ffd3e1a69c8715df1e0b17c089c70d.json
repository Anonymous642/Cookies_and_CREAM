{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Token Tracker \u2013 Rate Limit & Context Monitor", "version": "1.0.1", "description": "Track token usage, rate limits and context window in real-time while using AI assistants. Supports Claude, ChatGPT and Gemini.", "permissions": ["storage"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/claude_fetch.js"], "matches": ["https://claude.ai/*"]}, {"resources": ["content/chatgpt_fetch.js"], "matches": ["https://chatgpt.com/*"]}, {"resources": ["content/gemini_fetch.js"], "matches": ["https://gemini.google.com/*"]}], "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["content/claude_inject.js"], "run_at": "document_start"}, {"matches": ["https://claude.ai/*"], "js": ["utils/tokenizer.js", "topbar/topbar.js", "sidebar/sidebar.js", "badge/badge.js", "content/claude.js"], "css": ["topbar/topbar.css", "sidebar/sidebar.css", "badge/badge.css"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["content/chatgpt_inject.js"], "run_at": "document_start"}, {"matches": ["https://chatgpt.com/*"], "js": ["utils/tokenizer.js", "topbar/topbar.js", "sidebar/sidebar.js", "badge/badge.js", "content/chatgpt.js"], "css": ["topbar/topbar.css", "sidebar/sidebar.css", "badge/badge.css"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content/gemini_inject.js"], "run_at": "document_start"}, {"matches": ["https://gemini.google.com/*"], "js": ["utils/tokenizer.js", "topbar/topbar.js", "sidebar/sidebar.js", "badge/badge.js", "content/gemini.js"], "css": ["topbar/topbar.css", "sidebar/sidebar.css", "badge/badge.css"], "run_at": "document_idle"}]}