{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Should I Post This? Post Risk Check", "short_name": "Should I Post This?", "version": "1.1.0", "description": "The last check before you hit post. Score any draft for career, legal, and reputational risk in one click. Runs offline.", "homepage_url": "https://postcheck.net", "permissions": ["contextMenus", "activeTab", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Should I Post This? (Alt+Shift+P)", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open Should I Post This?"}, "check-selection": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Send the selected text to the full analyzer"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "host_permissions": ["https://install.postcheck.net/*"]}