{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipMark", "description": "Clip any webpage article and save it as a Markdown text file. Simple plain text, searchable, yours forever.", "version": "1.3.1", "author": "Eric Miller (@SimplGy)", "action": {"default_icon": "markdown19.png", "default_title": "ClipMark \u2014 Save Page as Markdown"}, "icons": {"16": "markdown16.png", "48": "markdown48.png", "128": "markdown128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["clipboardWrite", "activeTab", "storage", "scripting", "tabs", "downloads", "notifications"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "windows": "Ctrl+Shift+S", "mac": "Command+Shift+S", "chromeos": "Ctrl+Shift+S", "linux": "Ctrl+Shift+S"}}}}