{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MirrorImage", "version": "1.0.0", "description": "Access imgur images and links where imgur is blocked by loading them through DuckDuckGo's image proxy and a rimgo mirror.", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://*.imgur.com/*", "*://*.imgur.io/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "MirrorImage"}, "declarative_net_request": {"rule_resources": [{"id": "imgur_images", "enabled": true, "path": "rules_images.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}