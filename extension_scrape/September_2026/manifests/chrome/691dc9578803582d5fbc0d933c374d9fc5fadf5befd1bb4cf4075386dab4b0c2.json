{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FrameSyncX", "version": "1.4.0", "description": "Send YouTube and Twitch videos to your FrameSync room playlist \u2014 one click, or right-click any link.", "homepage_url": "https://frameshift.fun", "permissions": ["activeTab", "storage", "contextMenus", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.dailymotion.com/*", "https://rumble.com/*", "https://gql.twitch.tv/*", "https://player.twitch.tv/*", "https://vimeo.com/*", "https://frameshift.fun/*"], "externally_connectable": {"matches": ["https://frameshift.fun/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["providers.js", "content-common.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.dailymotion.com/*"], "js": ["providers.js", "content-common.js", "content-dailymotion.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://rumble.com/*"], "js": ["providers.js", "content-common.js", "content-rumble.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}