{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reklis \u2014 Rekzon LinkedIn Sourcing", "version": "1.0.6", "description": "One-click LinkedIn sourcing for your Rekzon ATS. Capture candidates from any profile straight into your hiring pipeline.", "permissions": ["activeTab", "scripting", "storage", "tabs", "contextMenus", "alarms"], "host_permissions": ["https://www.linkedin.com/*", "https://*.supabase.co/*", "https://api.rekzon.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Reklis \u2014 Add LinkedIn profile", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["content/scraper.js", "content/floating-button.js"], "css": ["content/floating.css"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/search/results/people/*", "https://www.linkedin.com/sales/*", "https://www.linkedin.com/mynetwork/*"], "js": ["content/scraper.js", "content/bulk-scrape.js"], "css": ["content/floating.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/floating.css"], "matches": ["https://www.linkedin.com/*"]}], "externally_connectable": {"matches": ["https://rekzon.com/*", "https://www.rekzon.com/*", "http://localhost:5173/*"]}}