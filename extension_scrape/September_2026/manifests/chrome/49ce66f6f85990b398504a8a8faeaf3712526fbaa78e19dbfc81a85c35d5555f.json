{"update_url": "https://clients2.google.com/service/update2/crx", "name": "StarScreen", "version": "1.02", "description": "Screenshot tool for personal and enterprise sharing and annotation", "manifest_version": 3, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://starscreen.org/*"], "optional_host_permissions": ["http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Take a screenshot", "default_icon": {"24": "images/action_icon24.png"}}, "icons": {"16": "images/icon16.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://starscreen.org/*", "http://localhost:3000/*"], "js": ["content.js"], "run_at": "document_start"}]}