{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ATCapture \u00b7 Web Element Capture", "short_name": "ATCapture", "version": "2026.4.6", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; upgrade-insecure-requests"}, "description": "Capture any webpage element in one click\u2014images, sections, tables, or UI components. No full-page screenshots needed.", "manifest_version": 3, "author": "ApakaTech (https://apakatech.com)", "omnibox": {"keyword": "wec"}, "action": {"default_popup": "index.html", "default_title": "ATCapture \u00b7 By ApakaTech"}, "options_page": "options.html", "devtools_page": "devtools.html", "background": {"service_worker": "assets/js/at.service_worker.bundle.js", "type": "module"}, "icons": {"16": "img/logo-outline.png", "48": "img/logo-outline.png", "128": "img/logo-outline.png", "200": "img/logo-outline.png"}, "permissions": ["tabs", "activeTab", "contextMenus", "storage", "scripting", "downloads", "notifications"], "commands": {"capture-full": {"suggested_key": {"default": "Alt+1"}, "description": "Capture Full Page"}, "capture-visible": {"suggested_key": {"default": "Alt+2"}, "description": "Capture Visible Area"}, "capture-element": {"suggested_key": {"default": "Alt+3"}, "description": "Capture Selected Element"}}, "web_accessible_resources": [{"resources": ["img/svg/*.svg"], "matches": ["<all_urls>"]}]}