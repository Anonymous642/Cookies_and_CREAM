{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Troll Blocker", "version": "1.0.0", "description": "Block toxic commenters on Facebook with one click. Blocks are queued and run in the background so you can keep scrolling.", "permissions": ["storage", "tabs", "declarativeNetRequest"], "host_permissions": ["*://*.facebook.com/*"], "background": {"service_worker": "src/background.js"}, "declarative_net_request": {"rule_resources": [{"id": "fbqb_frame_rules", "enabled": true, "path": "rules.json"}]}, "action": {"default_title": "Quick Troll Blocker", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["src/content.js"], "css": ["src/widget.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}]}