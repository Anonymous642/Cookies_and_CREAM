{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "iFrames Refresher", "version": "1.0.0", "description": "Show iframes count and refresh all iframes on demand.", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "commands": {"refresh_iframes": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Refresh all iframes in the active tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}