{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptRail for ChatGPT", "description": "Navigate long ChatGPT conversations with a right-side prompt rail and export selected prompt-answer pairs to PDF.", "version": "0.2.0", "action": {"default_title": "PromptRail", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["downloads", "debugger"], "background": {"service_worker": "src/background.js"}, "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}