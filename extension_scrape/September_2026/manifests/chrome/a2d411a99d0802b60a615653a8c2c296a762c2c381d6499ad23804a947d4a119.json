{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapPilot - Screenshots, Recordings and More", "short_name": "SnapPilot", "version": "2.0.11", "description": "Free screenshots, screen recording & OCR. Pro: reusable browser flows with guided playback, PDF export & sharing.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "extension/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SnapPilot"}, "background": {"service_worker": "extension/background/sw.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["extension/content/content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["tabs", "scripting", "storage", "offscreen", "contextMenus", "desktopCapture", "tabCapture", "clipboardWrite", "windows"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["extension/offscreen/vendor/*", "extension/offscreen/vendor/langdata/*", "extension/recorder/vendor/*", "extension/recorder/vendor/mediapipe/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Capture full page"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Select region"}, "start-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open screen recorder"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "minimum_chrome_version": "116", "externally_connectable": {"matches": ["https://snappilot.io/*"]}}