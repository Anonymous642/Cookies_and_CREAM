{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetForge - LeetCode Helper", "version": "1.1.0", "description": "Automatically synchronize your successful LeetCode submissions directly to your authenticated GitHub repository and local machine.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["https://leetcode.com/problems/*", "https://leet-forge-backend.vercel.app/*", "https://api.github.com/*"], "action": {"default_popup": "index.html", "default_title": "LeetForge Settings", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["inject.js", "verify.html", "index.css", "assets/*"], "matches": ["https://leetcode.com/*"]}]}