{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Outreach Machine", "version": "1.0", "description": "Automated social DM delivery \u2014 Instagram, Facebook, Twitter/X. LinkedIn is research-only.", "permissions": ["tabs", "scripting", "alarms", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://www.instagram.com/*", "https://twitter.com/*", "https://x.com/*", "http://localhost:8000/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content_instagram.js"], "run_at": "document_idle"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content_twitter.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*"], "js": ["content_facebook.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"48": "icon.png", "128": "icon.png"}}