{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Privacy Shield for Gorgias", "version": "1.4.9", "description": "Masks emails and phone numbers in Gorgias at the network, DOM, and clipboard layers. Blocks Edit/Delete email & phone menu items.", "minimum_chrome_version": "114", "permissions": ["declarativeNetRequest"], "host_permissions": ["https://*.gorgias.com/*"], "icons": {"48": "privacy-shield-logo-small.png", "128": "privacy-shield-logo-small.png"}, "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["https://*.gorgias.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://*.gorgias.com/*"]}]}