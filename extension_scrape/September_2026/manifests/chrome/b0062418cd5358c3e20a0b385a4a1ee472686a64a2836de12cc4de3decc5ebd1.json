{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Organizer Companion", "description": "Insert saved prompts, expand /shortcuts, and capture prompts into Prompt Organizer on ChatGPT, Claude, Gemini, and Perplexity.", "version": "1.3.1", "minimum_chrome_version": "116", "externally_connectable": {"matches": ["https://promptorganizer.app/*", "https://www.promptorganizer.app/*"]}, "background": {"service_worker": "service-worker.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Prompt Organizer Companion", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Prompt Organizer Companion"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open My prompts in the side panel"}, "capture-composer-draft": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the active composer draft"}}, "omnibox": {"keyword": "po"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "sidePanel", "clipboardRead", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://library.promptorganizer.app/*"], "web_accessible_resources": [{"use_dynamic_url": true, "resources": ["icons/logo.svg"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://chat.deepseek.com/*", "https://copilot.microsoft.com/*"]}], "optional_host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "htt