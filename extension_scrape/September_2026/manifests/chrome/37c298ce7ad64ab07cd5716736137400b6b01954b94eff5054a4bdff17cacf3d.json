{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Colorizer Free | Colorize your tab's icon!", "short_name": "Tab Icon Colorizer Free", "description": "Basic tab colorization - solid colors only, resets on refresh. Pro version adds overlay modes, persistence & more!", "version": "0.15", "author": "Gooberworks LLC", "icons": {"16": "logo/tabColorizer_16.png", "32": "logo/tabColorizer_32.png", "48": "logo/tabColorizer_48.png", "128": "logo/tabColorizer_128.png"}, "options_page": "options.html", "action": {"default_icon": "logo/tabColorizer_16.png", "default_title": "Tab Colorizer Free - Limited tab colorization", "default_popup": "popup.html"}, "commands": {"color-flip": {"suggested_key": "Alt+Shift+Space", "description": "Flip colors"}}, "permissions": ["tabs", "storage"], "host_permissions": ["*://*/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"js": ["foreground.js"], "matches": ["https://*/*", "http://*/*"]}]}