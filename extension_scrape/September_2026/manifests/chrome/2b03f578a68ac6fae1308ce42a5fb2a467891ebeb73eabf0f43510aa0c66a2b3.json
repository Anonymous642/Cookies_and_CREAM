{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aloft", "version": "1.2.7", "description": "Capture any part of your screen into a floating window you can mark up and keep beside your work.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Aloft", "default_icon": {"16": "icons/toolbar16.png", "32": "icons/toolbar32.png", "48": "icons/toolbar48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "clipboardWrite", "system.display", "notifications", "desktopCapture"], "commands": {"capture-region": {"suggested_key": {"default": "Ctrl+Shift+2", "chromeos": "Ctrl+Shift+2", "windows": "Ctrl+Shift+2", "linux": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Capture a region into a float"}, "capture-screen": {"suggested_key": {"default": "Ctrl+Shift+3", "chromeos": "Ctrl+Shift+3", "windows": "Ctrl+Shift+3", "linux": "Ctrl+Shift+3", "mac": "MacCtrl+Shift+3"}, "description": "Capture the whole screen into a float"}, "capture-page": {"description": "Capture a region of the current page only (no share prompt)"}}}