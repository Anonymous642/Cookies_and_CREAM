{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pointer: Custom Cursor Changer", "version": "1.3.0", "description": "Themed and animated cursors, pixel buddies, click effects and per-site rules. Cursors stay on your device; Pro payment is optional.", "action": {"default_popup": "src/popup/index.html", "default_title": "Pointer", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "options_page": "src/options/index.html", "permissions": ["storage", "tabs", "contextMenus", "alarms"], "host_permissions": ["<all_urls>"], "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Turn Pointer on or off"}, "cycle-cursor": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Cycle to the next cursor"}, "find-cursor": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Find my cursor (ping)"}, "toggle-present": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Presentation mode"}, "toggle-annotate": {"description": "Annotate this page"}, "eyedropper": {"description": "Pick a color under the cursor"}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["src/vendor/ExtPay.js"]}, {"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["src/shared/types.js", "src/shared/catalog.js", "src/shared/animated.js", "src/shared/packs.js", "src/shared/storage.js", "src/shared/rules.js", "src/shared/profiles.js", "src/shared/auras.js", "src/shared/accessories.js", "src/shared/companions.js", "src/shared/entitlements.js", "src/content/sound.js", "src/content/effects.js", "src/content/intel.js", "src/content/present.js", "src/content/annotate.js", "src/content/heatmap.js", "src/content/companion.js", "src/content/tools.js", "src/content/cursor.js"]}], "web_accessible_resources": [{"resources": ["assets/cursors/*", "assets/fonts/*"], "matches": ["<all_urls>"]}]}