{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Uniki Sidekick", "description": "Your AI-powered browsing assistant, handling tasks directly in your browser. Save time and let AI do the work for you!", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "activeTab", "sidePanel", "storage", "alarms"], "host_permissions": ["*://*.uniki.de/*", "*://*.uniki.ai/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "match_about_blank": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}