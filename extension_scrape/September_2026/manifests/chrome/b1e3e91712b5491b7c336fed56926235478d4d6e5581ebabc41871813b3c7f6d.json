{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Tab Switcher", "version": "1.1", "description": "Easily switch between active tabs and close them using keyboard shortcuts.", "permissions": ["tabs"], "background": {"service_worker": "worker.js"}, "action": {"default_icon": "icon-16.png"}, "commands": {"switch_right": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Switch to the tab on the right"}, "switch_left": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Switch to the tab on the left"}, "close_tab": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Close the active tab"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}