{"version": "5.16.3", "author": "KenjiKuroneki/Tewulf", "background": {"service_worker": "js/service_worker.js"}, "action": {"default_icon": {"16": "resources/icon-16.png", "32": "resources/icon-32.png"}, "default_popup": "html/popup.html", "default_title": "FABUI"}, "content_scripts": [{"css": ["css/quill.bubble.css", "css/fabu.css"], "js": ["js/jquery.js", "js/functions.js", "js/commissions.js", "js/quill.js", "js/uploader.js", "js/fabu.js"], "matches": ["*://*.furaffinity.net/*"], "run_at": "document_start"}], "description": "Implements a better uploader and notification system on FurAffinity.", "icons": {"16": "resources/icon-16.png", "32": "resources/icon-32.png", "48": "resources/icon-48.png", "128": "resources/icon-128.png"}, "manifest_version": 3, "minimum_chrome_version": "109", "name": "FABUI (FurAffinity Uploader & Notifier)", "host_permissions": ["*://*.furaffinity.net/*", "*://*.facdn.net/*"], "permissions": ["notifications", "offscreen", "unlimitedStorage", "storage"], "short_name": "FABUI", "update_url": "https://clients2.google.com/service/update2/crx", "web_accessible_resources": [{"resources": ["html/*", "audio/*", "js/*", "css/*", "resources/*"], "matches": ["*://*.furaffinity.net/*"]}]}