{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Canvas Module Navigator", "version": "1.0.0", "description": "Floating module directory for Canvas LMS with smooth-scroll navigation, active-section highlight, and auto-jump to the current week.", "permissions": ["storage"], "host_permissions": ["*://*.instructure.com/courses/*/modules*", "*://*.canvaslms.com/courses/*/modules*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Canvas Module Navigator", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.instructure.com/courses/*/modules*", "*://*.canvaslms.com/courses/*/modules*"], "js": ["src/storage.js", "src/modules.js", "src/scroll.js", "src/ui.js", "src/content.js"], "css": ["src/canvas-overrides.css", "src/styles.css"], "run_at": "document_idle"}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Toggle the Module Navigator panel"}}}