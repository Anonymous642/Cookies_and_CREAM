{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SellerScorer", "short_name": "SellerScorer", "version": "0.23.0", "description": "Cloud-connected Amazon sourcing intelligence with profit, risk, sales velocity, Keepa history, and buy-quantity guidance.", "permissions": ["storage", "identity", "unlimitedStorage", "alarms", "tabs"], "host_permissions": ["https://www.amazon.com/*", "https://amazon.com/*", "https://sellerscorer.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_title": "SellerScorer", "default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://amazon.com/*"], "js": ["calculations.js", "sheet-fields.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}