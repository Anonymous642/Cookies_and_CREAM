{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LanguageHack: Learn Chinese on YouTube", "version": "1.0.0", "description": "Tap any word in Chinese YouTube subtitles for pinyin and meaning. Works offline; save words to spaced repetition with an account.", "permissions": ["storage", "identity", "activeTab", "offscreen"], "host_permissions": ["https://*.youtube.com/*", "https://languagehack.online/*"], "homepage_url": "https://languagehack.online", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "LanguageHack", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content/youtube.js"], "css": ["content/youtube.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js", "vendor/tesseract/*", "vendor/tesseract/core/*", "vendor/tesseract/lang/*"], "matches": ["https://*.youtube.com/*"]}, {"resources": ["vendor/ort/*", "vendor/paddleocr/*"], "matches": ["https://*.youtube.com/*"]}]}