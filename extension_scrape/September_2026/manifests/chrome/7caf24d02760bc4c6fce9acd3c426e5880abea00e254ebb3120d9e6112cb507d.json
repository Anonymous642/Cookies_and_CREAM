{"name": "Better Gmail Buttons", "short_name": "betterbutton", "version": "0.5.4", "manifest_version": 3, "description": "Improve the usability of the Gmail buttons. Avoid marking valid email as spam by mistake, since Gmail fails to distinguish those two", "action": {"default_popup": "popup.html", "default_icon": {"32": "better-gmail-buttons32.png", "48": "better-gmail-buttons48.png", "64": "better-gmail-buttons64.png", "128": "better-gmail-buttons128.png", "256": "better-gmail-buttons256.png"}, "default_title": "Better Gmail Buttons"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "css": ["core.css"]}], "background": {"service_worker": "background.js"}, "icons": {"32": "better-gmail-buttons32.png", "48": "better-gmail-buttons48.png", "64": "better-gmail-buttons64.png", "128": "better-gmail-buttons128.png", "256": "better-gmail-buttons256.png"}, "permissions": ["activeTab"], "host_permissions": ["*://mail.google.com/*"], "homepage_url": "https://michaelkjeldsen.com/bettergmailbuttons/", "update_url": "https://clients2.google.com/service/update2/crx"}