{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Profile Extractor", "version": "0.1.1", "description": "Le couteau suisse des recruteurs. Exportez n'importe quel profil LinkedIn en fichier CSV structur\u00e9 et 100% local, en 1 clic.", "permissions": ["downloads", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Extraire le profil LinkedIn", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["content.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}