{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Komorebi Browser", "description": "Cinematic color grade with bundled film LUTs and Skia overlays (bloom, grain, leaks, particles).", "version": "0.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Komorebi Browser", "default_popup": "popup.html"}, "permissions": ["storage", "sidePanel", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "minimum_chrome_version": "116", "commands": {"komorebi-toggle-enabled": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Komorebi Browser: toggle filters"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["canvaskit/full/*"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}