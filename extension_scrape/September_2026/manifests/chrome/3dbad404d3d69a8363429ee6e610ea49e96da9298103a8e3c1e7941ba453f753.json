{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Transcript for YouTube: copy, clean, AI-ready text", "short_name": "Transcript", "version": "1.6.0", "description": "One click gets the full YouTube transcript. Copy it, clean it, or turn the video into text your AI can build from. Free.", "author": "Nocturne Voss", "homepage_url": "https://nocturnevoss.tech/en", "minimum_chrome_version": "116", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Transcript for YouTube", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Transcript for YouTube"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}