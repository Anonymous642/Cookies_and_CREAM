{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TakoMD - Page to Markdown", "description": "Convert any web page to clean markdown and open it in TakoMD. Intelligently extracts main content, removes ads and navigation.", "version": "1.5.0", "action": {"default_icon": {"32": "icons/icon32.png", "128": "icons/icon128.png"}, "default_title": "TakoMD", "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting", "contextMenus", "clipboardWrite"], "host_permissions": ["https://md.takohi.me/*"], "commands": {"copy-page-md": {"suggested_key": {"default": "Alt+M"}, "description": "Copy page as Markdown"}}, "background": {"service_worker": "background.js"}, "icons": {"32": "icons/icon32.png", "128": "icons/icon128.png"}}