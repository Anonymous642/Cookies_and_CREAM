{"update_url": "https://clients2.google.com/service/update2/crx", "version": "0.1.0", "manifest_version": 3, "name": "Grape Web Clipper", "minimum_chrome_version": "116", "homepage_url": "https://grape.cool", "description": "Save any page on the web straight into your Grape notes.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "action": {"default_title": "Clip to Grape", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"clip-page": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Clip the current page to Grape"}, "clip-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Clip the selected text to Grape"}}}