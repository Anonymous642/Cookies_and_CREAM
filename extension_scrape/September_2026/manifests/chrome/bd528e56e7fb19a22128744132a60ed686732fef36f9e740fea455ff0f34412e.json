{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BooP Remote", "version": "1.06", "description": "Control Chrome from your phone and run AI browser automation. Remote trackpad, media, tabs, keyboard. Requires mobile app.", "permissions": ["tabs", "activeTab", "storage", "scripting", "alarms", "sidePanel", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "114"}