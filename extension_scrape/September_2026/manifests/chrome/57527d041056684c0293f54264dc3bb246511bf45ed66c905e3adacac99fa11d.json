{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Captora \u2014 Screen Recorder", "short_name": "Captora", "version": "1.9.2", "description": "Record a screen area, current tab, app window, or entire screen with optional audio. Keeps your latest 3 recordings locally.", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "unlimitedStorage", "downloads", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Captora", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"stop-recording": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Stop the active recording"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "homepage_url": "https://makeanythingsimple.com/", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}