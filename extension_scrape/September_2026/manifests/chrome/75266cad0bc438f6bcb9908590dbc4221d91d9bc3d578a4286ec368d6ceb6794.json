{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Studium", "version": "1.0.1", "description": "Capture notes to Studium directly from your browser via shortcut, context menu, or the popup.", "permissions": ["contextMenus", "scripting", "storage", "activeTab"], "host_permissions": ["https://studium.life/*"], "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Studium"}, "options_page": "settings.html", "commands": {"add-note": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H", "linux": "Alt+Shift+H", "windows": "Alt+Shift+H"}, "description": "Open the note capture form"}, "add-link": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L", "linux": "Alt+Shift+L", "windows": "Alt+Shift+L"}, "description": "Save current page to reading list"}}, "content_scripts": [{"matches": ["https://read.amazon.com/notebook*"], "js": ["kindle/content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'self'"}, "web_accessible_resources": [{"resources": ["kindle/scrape.js"], "matches": ["https://read.amazon.com/*"]}]}