{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fillwright \u2014 Form Autofill", "description": "Fill saved data into web forms with one click. Works on React, shadow DOM and iframes. Local-only, no account, no tracking.", "version": "1.0.0", "short_name": "Fillwright", "icons": {"16": "icon-active-16.png", "32": "icon-active-32.png", "48": "icon-active-48.png", "128": "icon-active-128.png"}, "minimum_chrome_version": "127", "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs", "contextMenus"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "Fillwright", "default_icon": {"16": "icon-idle-16.png", "32": "icon-idle-32.png"}, "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"fill-form": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Fill the matching form on this page"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}