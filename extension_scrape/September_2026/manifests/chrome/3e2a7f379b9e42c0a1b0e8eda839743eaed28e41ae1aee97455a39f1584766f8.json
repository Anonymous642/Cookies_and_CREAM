{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MamaChecker - Food Checker for Parents", "version": "1.0.9", "description": "Check food ingredients against NHS guidelines for babies and pregnancy while you shop", "author": "MamaChecker", "homepage_url": "https://mamachecker.co.uk", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.tesco.com/*", "https://www.sainsburys.co.uk/*", "https://groceries.asda.com/*", "https://www.ocado.com/*", "https://www.waitrose.com/*", "https://www.boots.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.tesco.com/groceries/*", "https://www.sainsburys.co.uk/gol-ui/product/*", "https://groceries.asda.com/product/*", "https://www.ocado.com/products/*", "https://www.waitrose.com/*/products/*", "https://www.boots.com/*"], "js": ["content/index.js"], "css": ["assets/panel.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_title": "Check Baby Food Ingredients", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["onboarding/*", "assets/*", "chunks/*", "success/*"], "matches": ["<all_urls>"]}]}