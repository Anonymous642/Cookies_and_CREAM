{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabRecall", "version": "1.2.0", "description": "Remember where you were. Work-context recovery and custom voice commands to control Chrome hands-free.", "permissions": ["tabs", "storage", "scripting", "activeTab", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabRecall - Remember where you were"}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"quick-recall": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Jump back to the previous active tab"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["voice/command-models.js", "voice/command-matcher.js", "voice/media-controller.js", "voice/command-actions.js", "voice/speech-recognizer.js", "voice/voice-service.js", "content/hud.js"], "css": ["content/hud.css"], "run_at": "document_idle"}]}