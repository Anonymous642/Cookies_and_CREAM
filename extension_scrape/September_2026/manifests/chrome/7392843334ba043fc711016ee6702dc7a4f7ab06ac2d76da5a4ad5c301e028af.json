{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SafeNeat", "version": "1.2.2", "description": "Parental controls a parent sets up: blocks chosen sites, limits short-video scrolling, and reports their child's activity.", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "SafeNeat parental controls are active on this browser"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["nativeMessaging", "alarms", "declarativeNetRequest", "storage"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube.js"], "run_at": "document_idle", "all_frames": false}]}