{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "True Watch Time \u2014 YouTube Speed-Adjusted Timer & End Time", "description": "Shows your real remaining time on YouTube at any playback speed. Watching at 2\u00d7? See the actual time left, not YouTube's estimate.", "version": "1.7.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "True Watch Time"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/overlays.js", "content-scripts/playlist.js"]}]}