{"manifest_version": 3, "name": "My Alarm", "version": "1.0.0", "description": "Set an alarm and receive a notification when it goes off.", "author": "CYBOLITE", "homepage_url": "https://www.cybolite.com", "permissions": ["alarms", "notifications", "storage"], "host_permissions": [], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/alarm.png", "48": "images/alarm.png", "128": "images/alarm.png"}}, "icons": {"16": "images/alarm.png", "48": "images/alarm.png", "128": "images/alarm.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.cybolite.com; media-src 'self'"}, "web_accessible_resources": [{"resources": ["sounds/*"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "93", "update_url": "https://clients2.google.com/service/update2/crx", "storage": {"managed_schema": "schema.json"}}