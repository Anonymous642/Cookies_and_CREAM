{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ungatedapps \u2014 is it actually free?", "version": "0.2.8", "description": "Shows whether an app or site is genuinely free, or paywalled, right in your search results and on store pages.", "homepage_url": "https://ungatedapps.com", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://ungatedapps.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Is this actually free?", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.bing.com/search*", "https://duckduckgo.com/*", "https://apps.apple.com/*", "https://play.google.com/store/apps/*", "https://search.brave.com/*", "https://www.ecosia.org/*", "https://www.startpage.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}