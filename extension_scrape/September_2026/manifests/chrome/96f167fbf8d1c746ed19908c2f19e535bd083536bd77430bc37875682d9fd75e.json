{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unit Converter Pro: Easy Metric & Imperial Conversion", "short_name": "Unit Converter", "description": "Quickly convert units: Length (cm to in), Temp (Celsius to Fahrenheit), Weight (kg to lbs), Area, Volume, and Time in one click.", "version": "1.3.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Open Unit Converter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "omnibox": {"keyword": "convert"}, "permissions": ["storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "offline_enabled": true}