{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoicePad \u2014 dictado por voz", "version": "1.4.7", "description": "Dicta con la voz en cualquier p\u00e1gina web: transcribe en tiempo real e inserta el texto en el campo donde escribes.", "minimum_chrome_version": "116", "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite", "alarms"], "host_permissions": ["https://voicepad.soportemktg.online:8443/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Abrir VoicePad (Alt+Shift+V)", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["recorder.html", "recorder.js", "modal.css"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"toggle-voicepad": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Mostrar u ocultar la ventana de VoicePad"}, "toggle-dictado": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Iniciar o detener el dictado"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors http://*:* https://*:*"}}