{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkNote", "version": "1.0.0", "description": "Save titled notes for different URLs and easily revisit them directly from the extension's organized saved notes section.", "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["popup/savedFiles.js"]}], "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "activeTab", "notifications"]}