{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reverse Tab Order", "version": "1.2", "description": "New tabs appear at the top of the tab list instead of the bottom", "permissions": ["tabs"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"tab-up": {"suggested_key": {"default": "Alt+Up"}, "description": "Switch to the tab above (next newer tab)"}, "tab-down": {"suggested_key": {"default": "Alt+Down"}, "description": "Switch to the tab below (next older tab)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}