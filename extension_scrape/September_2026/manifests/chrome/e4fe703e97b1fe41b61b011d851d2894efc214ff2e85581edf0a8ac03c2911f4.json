{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyncWatch \u2014 Watch Party Sync", "description": "Sync YouTube, Netflix, Disney+ and Prime Video with friends. Create a room, share the code, watch together.", "version": "0.1.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms", "sidePanel"], "commands": {"toggle-play-pause": {"suggested_key": {"default": "Alt+Space"}, "description": "Toggle play / pause"}, "seek-backward": {"suggested_key": {"default": "Alt+Left"}, "description": "Seek backward 10 seconds"}, "seek-forward": {"suggested_key": {"default": "Alt+Right"}, "description": "Seek forward 10 seconds"}, "toggle-mute-voice": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle mute voice chat"}}, "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.disneyplus.com/*"], "web_accessible_resources": [{"resources": ["adapters/*", "spa-navigation-hook.js"], "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.disneyplus.com/*"]}], "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "SyncWatch", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.amazon.co.uk/gp/video/*", "*://*.amazon.com/gp/video/*", "*://*.disneyplus.com/*", "*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}