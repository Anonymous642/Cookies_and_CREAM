{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubRadar", "version": "0.1.2", "description": "Track subscriptions and free trials. Sign in to get reminders before you're charged.", "permissions": ["storage", "notifications", "alarms", "identity"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "dashboard.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}