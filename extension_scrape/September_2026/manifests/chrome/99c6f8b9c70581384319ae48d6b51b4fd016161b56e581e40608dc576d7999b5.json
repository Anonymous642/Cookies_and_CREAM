{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HitchBound - Wedding Inspiration Capture", "short_name": "HitchBound", "version": "1.0.1", "description": "Capture wedding inspiration from anywhere on the web with a smart lasso tool", "author": "HitchBound", "homepage_url": "https://app.hitchbound.com", "permissions": ["activeTab", "storage", "identity"], "host_permissions": ["<all_urls>", "https://hitchbound.onrender.com/*", "https://*.supabase.co/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/capture.js", "content/sidebar.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "commands": {"activate-capture": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Activate capture mode"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}