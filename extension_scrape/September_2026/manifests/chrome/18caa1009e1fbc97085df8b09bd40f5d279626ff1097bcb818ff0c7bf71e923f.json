{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabManager BETA", "description": "Visual tab manager with workspaces, categories, and groups. This extension is currently in Beta testing.", "version": "1.1.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab", "storage", "tabs", "tabGroups", "contextMenus", "sidePanel", "favicon", "downloads"], "optional_permissions": ["bookmarks"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab"}, "search": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Search saved tabs"}, "toggle_popover": {"suggested_key": {"default": "Ctrl+U", "mac": "Command+U"}, "description": "Toggle popover"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/popover.js"]}]}