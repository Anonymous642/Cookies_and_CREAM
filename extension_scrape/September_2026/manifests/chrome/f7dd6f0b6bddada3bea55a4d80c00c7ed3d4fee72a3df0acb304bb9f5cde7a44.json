{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContentPulse \u2014 LinkedIn Comment Capture", "short_name": "ContentPulse", "version": "1.0.0", "description": "One-click capture LinkedIn comments into your ContentPulse inbox so you can draft a reply in your client's voice.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "ContentPulse \u2014 Capture LinkedIn Comments", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*", "https://contentpulse.helloaurora.ai/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/posts/*", "https://www.linkedin.com/pulse/*", "https://www.linkedin.com/in/*/recent-activity/*"], "js": ["content-script.js"], "css": ["styles.css"], "run_at": "document_idle"}]}