{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Podsplice Stereo Tab Audio", "version": "1.0.4", "description": "Connect stereo Chrome tab audio to Podsplice V2 Recorder or Interview host as a separate audio track.", "homepage_url": "https://podsplice.com/stereo-tab-audio", "permissions": ["activeTab", "tabCapture"], "host_permissions": ["https://app.podsplice.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "Connect this tab's audio to Podsplice", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://app.podsplice.com/recorder-v2*", "https://app.podsplice.com/interview*"], "js": ["podsplice-bridge.js"], "run_at": "document_start"}]}