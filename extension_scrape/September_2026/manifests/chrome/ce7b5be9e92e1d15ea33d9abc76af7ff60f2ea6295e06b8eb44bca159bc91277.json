{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BackTab", "description": "Cycle back and forward through your last 10 active tabs.", "version": "1.1.3", "minimum_chrome_version": "114", "action": {"default_title": "BackTab settings", "default_popup": "popup/index.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["preview-frame-input.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["preview-content.js"], "run_at": "document_start"}], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"go_back": {"suggested_key": {"default": "Alt+Q"}, "description": "Go back to the last active tab (main shortcut)"}, "go_forward": {"suggested_key": {"default": "Alt+W"}, "description": "Go forward to the next active tab (main shortcut)"}, "go_back_secondary": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "MacCtrl+Command+Left"}, "description": "Go back to the last active tab (secondary shortcut)"}, "go_forward_secondary": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "MacCtrl+Command+Right"}, "description": "Go forward to the next active tab (secondary shortcut)"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["favicon", "scripting", "storage"], "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["http://*/*", "https://*/*"]}]}