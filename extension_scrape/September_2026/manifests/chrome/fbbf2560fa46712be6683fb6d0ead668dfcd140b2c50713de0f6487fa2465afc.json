{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PicPicker", "version": "2.3.3", "description": "Privacy-first browser extension to extract all images from any webpage with one click", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "downloads"], "action": {"default_title": "PicPicker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"extract-images": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Extract images from the current page"}}}