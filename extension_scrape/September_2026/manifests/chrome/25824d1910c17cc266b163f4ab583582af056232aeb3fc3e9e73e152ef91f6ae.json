{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Photos - Save All Unsaved Creations", "version": "1.0", "description": "Clicks all 'Save' controls on photos.google.com/unsaved with stubborn endless scrolling.", "permissions": ["scripting", "activeTab", "tabs"], "host_permissions": ["https://photos.google.com/*"], "action": {"default_title": "Save All Unsaved Creations", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://photos.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"start-save": {"suggested_key": {"default": "Alt+S"}, "description": "Start saving all unsaved creations"}, "stop-save": {"suggested_key": {"default": "Alt+X"}, "description": "Stop the saver"}}}