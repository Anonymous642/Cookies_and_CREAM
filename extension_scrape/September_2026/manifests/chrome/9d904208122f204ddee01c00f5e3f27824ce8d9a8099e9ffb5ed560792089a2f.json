{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jaap Daily \u2014 Naam Jaap Counter", "short_name": "Jaap Daily", "version": "1.0.0", "description": "A 108-bead mala counter for naam jaap, in your toolbar. Free, no account, no ads \u2014 your count stays on your device.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Jaap Daily \u2014 count a naam", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Alt+Shift+J"}, "description": "Open the counter"}, "count": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Count one \u2014 without opening the counter"}}, "offline_enabled": true}