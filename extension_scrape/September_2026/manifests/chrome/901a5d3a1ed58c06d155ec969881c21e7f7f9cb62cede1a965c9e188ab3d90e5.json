{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "djset-webtools", "description": "YouTube \u2194 1001tracklists integration for DJ set listeners", "version": "0.4.0", "icons": {"16": "icon/16-dark.png", "32": "icon/32-dark.png", "48": "icon/48-dark.png", "96": "icon/96-dark.png", "128": "icon/128-dark.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.1001tracklists.com/*"], "web_accessible_resources": [{"resources": ["icon/*"], "matches": ["https://www.youtube.com/*"]}], "action": {"default_icon": {"16": "icon/16-dark.png", "32": "icon/32-dark.png", "48": "icon/48-dark.png", "128": "icon/128-dark.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://www.1001tracklists.com/tracklist/*"], "run_at": "document_idle", "js": ["content-scripts/tracklists.js"]}, {"matches": ["*://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}