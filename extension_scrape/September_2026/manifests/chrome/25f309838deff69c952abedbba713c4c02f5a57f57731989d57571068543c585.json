{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Search Location Changer", "version": "1.0", "description": "Override your HTML5 Geolocation and Google Search location natively. Search and lock to any coordinates worldwide.", "permissions": ["storage", "tabs", "declarativeNetRequest"], "host_permissions": ["*://*.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.google.com/*"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_title": "Change Location"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.google.com/*"]}]}