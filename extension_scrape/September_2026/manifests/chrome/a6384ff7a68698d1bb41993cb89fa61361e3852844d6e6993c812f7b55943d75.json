{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Omarchy Tile Mode for YouTube", "version": "1.1.0", "description": "Fill your tile with the video instead of taking over the whole monitor, and repaint YouTube with your Omarchy theme.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "background": {"service_worker": "src/worker.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content.js"], "css": ["src/tile.css", "src/native.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/theme.generated.css", "src/themes.json"], "matches": ["*://*.youtube.com/*"]}], "author": "Nick Yakovliev", "homepage_url": "https://github.com/Vegasq/omarchy-youtube"}