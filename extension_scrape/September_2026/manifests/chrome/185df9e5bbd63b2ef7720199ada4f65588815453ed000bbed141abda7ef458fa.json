{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "yourautomation - Deal Analyzer", "description": "Deal analysis for Amazon and Walmart with model correct economics, fees, and seller competition.", "version": "2.1.1", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "tabs", "alarms", "sidePanel", "identity"], "host_permissions": ["https://www.amazon.com/*", "https://api.yourautomation.ai/*"], "action": {"default_title": "Deal Analyzer", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["ya-logo.png", "ya-logo-white.png"], "matches": ["https://www.amazon.com/*"]}, {"resources": ["content-scripts/amazon-sidebar.css"], "use_dynamic_url": true, "matches": ["https://www.amazon.com/*", "https://www.amazon.com/*", "https://www.amazon.com/*", "https://www.amazon.com/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.amazon.com/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/gp/aw/d/*", "https://www.amazon.com/gp/product/*"], "run_at": "document_idle", "js": ["content-scripts/amazon-sidebar.js"]}]}