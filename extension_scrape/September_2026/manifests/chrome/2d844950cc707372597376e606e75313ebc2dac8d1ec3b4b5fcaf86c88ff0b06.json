{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URL Checker Navigator", "version": "1.0.4", "description": "Navigate through website URLs one by one for testing. Check if all pages work properly with customizable timing intervals.", "permissions": ["storage", "tabs", "activeTab", "background", "notifications"], "commands": {"navigate-previous": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Navigate to previous URL"}, "navigate-next": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Navigate to next URL"}}, "action": {"default_popup": "popup.html", "default_title": "URL Checker Navigator"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}