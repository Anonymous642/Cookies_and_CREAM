{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "All Tabs Browser", "version": "1.0.0", "description": "Reads content from all open tabs and displays a beautiful summary.", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Summarize All Tabs"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}}, "web_accessible_resources": [{"resources": ["summary.html", "summary.css", "summary.js"], "matches": ["<all_urls>"]}]}