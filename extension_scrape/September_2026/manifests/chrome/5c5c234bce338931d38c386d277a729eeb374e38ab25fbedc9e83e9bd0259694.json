{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LATERLY for YouTube: Like Trello but for YouTube", "description": "Better manage YouTube videos by adding them to your To Do (To Watch) list from YouTube, tagging them within Laterly web app and more", "version": "1.0.2017", "action": {"default_popup": "popup.html", "default_title": "LATERLY", "default_icon": "laterly-icon-cropped.png"}, "permissions": ["storage", "scripting", "cookies"], "host_permissions": ["https://www.laterly.app/*"], "icons": {"16": "laterly-icon-cropped.png", "48": "laterly-icon-cropped.png", "128": "laterly-icon-cropped.png"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}