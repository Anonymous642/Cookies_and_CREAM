{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Potato Debug - Odoo 19", "version": "1.3.0", "description": "Toggle Odoo 19 debug mode with a friendly potato. Supports debug, assets, and off modes.", "author": "Agromarin Dev Team", "icons": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"}, "permissions": ["activeTab", "tabs", "contextMenus"], "host_permissions": ["*://localhost/*", "*://127.0.0.1/*", "*://*.agromarin.mx/*"], "action": {"default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png"}, "default_title": "Potato Debug: OFF\nClick = toggle debug\nDouble-click = debug assets"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://localhost/*", "*://127.0.0.1/*", "*://*.agromarin.mx/*"], "js": ["content.js"], "run_at": "document_idle"}]}