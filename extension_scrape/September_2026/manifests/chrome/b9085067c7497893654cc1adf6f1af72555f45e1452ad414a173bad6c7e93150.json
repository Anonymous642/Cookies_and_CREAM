{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabCaster: Screen Recorder with Privacy", "version": "1.6.0", "description": "Record your tab or screen with audio, cinematic auto-zoom, and privacy blur. MP4, WebM & GIF \u2014 no cloud, everything stays local.", "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "windows", "notifications"], "options_ui": {"page": "options.html", "open_in_tab": true}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://extensionpay.com"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["extpay-content-script.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U", "linux": "Ctrl+Shift+Y"}, "description": "Start/Stop Recording"}}}