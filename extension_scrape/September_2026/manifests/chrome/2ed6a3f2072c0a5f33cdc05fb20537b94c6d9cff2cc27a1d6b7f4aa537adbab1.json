{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Deepdoro: Pomodoro Timer & Website Blocker", "description": "Deepdoro is a flow-driven focus timer and distraction blocker that helps you eliminate distractions and enter deep focused session.", "version": "1.1.0", "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "alarms", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://deepdoro.com/*", "https://www.deepdoro.com/*"], "js": ["bridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["sounds/*.mp3"], "matches": ["<all_urls>"]}]}