{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GODIFY \u2014 AI Prompt Transformer", "version": "1.2.3", "description": "Turn rough requests into clearer, execution-ready AI prompts with one click. Local-first, private, and built for major AI chats.", "permissions": ["storage", "scripting", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.grok.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.grok.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["transformer.js", "eval_engine.js", "learning_engine.js", "optimizer_engine.js", "adapters.js", "local_ai_engine.js", "content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"godify-current": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Open GODIFY for the current prompt"}}, "action": {"default_popup": "popup.html", "default_title": "GODIFY"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}