{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RC Paddock \u2192 Facebook", "version": "0.1.1", "description": "Auto-fills a Facebook group \"Item for sale\" post from one of your RC Paddock listings \u2014 photos included. You review and publish.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "host_permissions": ["https://rc-paddock.com/*", "https://api.rc-paddock.com/*", "https://media.rc-paddock.com/*", "https://*.facebook.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://rc-paddock.com/listings/*"], "js": ["src/content-listing.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/marketplace/create/item*", "https://www.facebook.com/groups/*"], "js": ["src/fb-selectors.js", "src/content-fb.js"], "run_at": "document_idle"}]}