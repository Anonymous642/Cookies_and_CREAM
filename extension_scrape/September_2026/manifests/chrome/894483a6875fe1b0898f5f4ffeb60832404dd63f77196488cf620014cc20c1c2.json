{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTLooper - YouTube Practice Loop", "description": "Set A/B loop points on YouTube videos. Perfect for musicians, language learners, and anyone practicing from video.", "version": "1.0.2", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "commands": {"toggle-loop": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "Toggle A/B loop on current video"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}