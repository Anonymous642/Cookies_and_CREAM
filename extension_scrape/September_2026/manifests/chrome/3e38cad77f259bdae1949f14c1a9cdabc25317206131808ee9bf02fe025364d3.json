{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "momoChef: Recipe Clipper", "version": "1.1.0", "description": "Clip recipes from websites and social posts to momoChef. Review ingredients and steps before saving them to your recipe library.", "homepage_url": "https://momochef.com", "developer": {"name": "momoChef", "url": "https://momochef.com"}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://momochef.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.fb.watch/*", "*://*.tiktok.com/*", "*://bsky.app/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.pinterest.com/*", "*://*.pin.it/*"], "action": {"default_popup": "popup.html", "default_title": "momoChef: Recipe Clipper", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}