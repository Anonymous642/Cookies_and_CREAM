{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TAGiT for YouTube - Remember What You Watch", "version": "0.10.30", "description": "Daily AI digests + flashcards for YouTube videos. Remember what you watch with proven memory science. Free to start.", "uninstall_url": "https://tagit.video/uninstall", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://tagit.video/*", "https://app.tagit.video/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://tagit.video/*", "https://app.tagit.video/*"], "js": ["dashboard-bridge.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TAGiT - Tag this moment", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"tag-moment": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Tag current moment in video"}, "_execute_action": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Open TAGiT side panel"}}, "web_accessible_resources": [{"resources": ["icon-16.png", "icon-32.png", "icon-48.png", "icon-128.png", "tagit-logo.png"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}