{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VPN Connectivity Monitor", "description": "Monitors connectivity to blocked sites and alerts when VPN drops", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["notifications", "alarms", "storage", "offscreen"], "host_permissions": ["https://dns.google/*", "https://www.google.com/*", "https://www.youtube.com/*", "https://graph.facebook.com/*", "https://x.com/*", "https://www.baidu.com/*", "https://www.taobao.com/*", "https://www.qq.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "VPN Connectivity Monitor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}