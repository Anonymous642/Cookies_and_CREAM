{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save & Dump", "version": "1.0.0", "author": "Just Create Labs LLC", "description": "Save your tab chaos, restore your zen. Manage browser tabs with smart save slots and quick switching.", "permissions": ["tabs", "storage", "activeTab", "notifications"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Save & Dump", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"save-and-dump": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current tabs and close them"}, "dump-only": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Close all tabs without saving"}, "load-slot-01": {"suggested_key": {"default": "Ctrl+1"}, "description": "(Slot 01) Primary tabs"}, "load-slot-02": {"suggested_key": {"default": "Ctrl+2"}, "description": "(Slot 02) Secondary tabs"}, "load-slot-03": {"description": "(Slot 03) Third tab's a charm (if unlocked)"}, "load-slot-04": {"description": "(Slot 04) Four score and several tabs ago (if unlocked)"}, "load-slot-05": {"description": "(Slot 05) Five golden tabs (if unlocked)"}, "load-slot-06": {"description": "(Slot 06) Six Pack Tabs (if unlocked)"}, "load-slot-07": {"description": "(Slot 07) Tabs. Browser Tabs. (if unlocked)"}, "load-slot-08": {"description": "(Slot 08) Eight tabs a week (if unlocked)"}, "load-slot-09": {"description": "(Slot 09) The whole nine tabs (if unlocked)"}, "load-slot-10": {"description": "(Slot 10) Ten out of ten. Would tab again. (if unlocked)"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}