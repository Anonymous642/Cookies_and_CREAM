{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Axiom Karisma Bridge", "version": "1.0.0", "description": "Sends radiology reports from RadiologyDashboard into Karisma as native RTF (clipboard + optional auto-paste).", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["nativeMessaging", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://localhost:3010/*", "http://localhost:3000/*", "http://127.0.0.1:3010/*", "https://radiology-aws.axiomdata.com.au/*", "https://radiology.axiomdata.com.au/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Axiom Karisma Bridge", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}}