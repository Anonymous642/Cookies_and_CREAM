{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextFlip - Smart Text & Layout Assistant", "version": "1.1.0", "description": "Instantly fixes text typed in the wrong keyboard layout, plus AI translation and grammar correction, anywhere on the web.", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "alarms", "identity", "identity.email"], "host_permissions": ["https://translate.googleapis.com/*", "https://api.languagetool.org/*", "https://textflip-worker.textflip-app.workers.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["layoutMapper.js", "content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "support@textflip.com", "strict_min_version": "109.0"}}, "action": {"default_popup": "popup.html", "default_title": "TextFlip", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"flip-layout": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Flip the selected text's keyboard layout"}, "translate-text": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Translate the selected/active text"}, "fix-grammar": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Fix grammar/spelling in the selected/active text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}