{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Action Alert: Build Success Sound", "short_name": "BuildChime", "version": "1.0", "description": "Instant audio notifications for GitHub builds. No more manual refreshing\u2014just green checks and victory pings.", "permissions": ["alarms", "storage", "offscreen", "notifications", "tabs"], "host_permissions": ["https://api.github.com/*"], "minimum_chrome_version": "109", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "GitHub Check Monitor"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["icon16.png", "icon48.png", "icon128.png"], "matches": ["<all_urls>"]}]}