{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SortSync - ChatGPT Chat Folder Organizer", "version": "1.0.0", "description": "Developed by Sanika Rajguru from IIIT V, Organize your ChatGPT conversations into custom folders for better productivity", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "SortSync - ChatGPT Folder Organizer"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}]}