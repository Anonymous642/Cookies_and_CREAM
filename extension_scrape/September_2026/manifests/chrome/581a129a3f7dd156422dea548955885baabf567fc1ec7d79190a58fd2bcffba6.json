{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenTyper \u2014 Free Auto Typer for Docs, Slides & Word", "version": "1.7.2", "description": "Types your draft into Google Docs, Slides, Word or any text box at human speed. Free, no account, nothing leaves your browser.", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://docs.google.com/*", "https://*.officeapps.live.com/*", "https://*.office.com/*", "https://*.sharepoint.com/*", "https://onedrive.live.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "OpenTyper"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/*", "https://*.officeapps.live.com/*", "https://*.office.com/*", "https://*.sharepoint.com/*", "https://onedrive.live.com/*"], "js": ["src/content/engine.js"], "css": ["src/content/hud.css"], "all_frames": true, "run_at": "document_idle"}], "commands": {"toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Pause or resume typing"}, "stop-typing": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Emergency stop"}}}