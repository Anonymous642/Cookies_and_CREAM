{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Decay", "version": "1.0.2", "description": "Manage tab clutter by aging inactive tabs and archiving forgotten ones.", "permissions": ["tabs", "storage", "alarms", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Tab Decay", "default_popup": "ui/popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/title-marker.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}