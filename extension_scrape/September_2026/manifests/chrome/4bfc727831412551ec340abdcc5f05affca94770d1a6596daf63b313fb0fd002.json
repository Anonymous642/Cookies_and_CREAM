{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Listen to Article", "version": "1.0.0", "description": "Reads articles aloud using the toolbar popup controls.", "permissions": ["scripting", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Listen to Article"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"play": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Play article"}, "pause_toggle": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Pause or resume"}, "stop": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Stop reading"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}