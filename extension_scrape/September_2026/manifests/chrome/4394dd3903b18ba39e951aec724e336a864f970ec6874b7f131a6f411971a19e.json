{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Crewbar", "version": "1.1.0", "description": "Fast command-palette launcher for your GPTs and Gems. Press \u2318K to search and open AI assistants instantly.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "notifications"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/g/*", "https://chatgpt.com/project/*"], "js": ["scripts/content.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/", "https://chatgpt.com/discover*", "https://chatgpt.com/gpts*"], "js": ["scripts/chatgpt-scanner.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/gems/*"], "js": ["scripts/gem-content.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/", "https://gemini.google.com/app*", "https://gemini.google.com/gems*"], "js": ["scripts/gem-scanner.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"open-launcher": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open GPT/Gem launcher"}}, "web_accessible_resources": [{"resources": ["scripts/overlay.js", "scripts/overlay.css"], "matches": ["<all_urls>"]}, {"resources": ["scripts/manual-scan.js"], "matches": ["<all_urls>"]}]}