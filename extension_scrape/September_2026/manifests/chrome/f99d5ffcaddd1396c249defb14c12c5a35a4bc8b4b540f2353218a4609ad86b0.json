{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkPreview - Hover to Preview Links", "description": "Hover over any link to see a live preview of the page in a popup. No clicks needed - just hover and peek.", "version": "1.0.0", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "activeTab"], "commands": {"toggle-preview": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle link preview on hover"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}