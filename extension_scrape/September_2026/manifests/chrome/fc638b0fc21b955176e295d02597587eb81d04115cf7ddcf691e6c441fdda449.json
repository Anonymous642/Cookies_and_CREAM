{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Always YouTube Cookie", "description": "Redirects youtube-nocookie.com to youtube.com, so that embedded videos in sites like Reddit will use your logged-in YouTube account.", "version": "1.0", "manifest_version": 3, "action": {"default_icon": "icons/alwaysytcookie.png"}, "icons": {"16": "icons/alwaysytcookie16.png", "32": "icons/alwaysytcookie32.png", "48": "icons/alwaysytcookie48.png", "128": "icons/alwaysytcookie128.png"}, "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube-nocookie.com/*"], "declarative_net_request": {"rule_resources": [{"id": "alwaysytcookie", "enabled": true, "path": "rules.json"}]}}