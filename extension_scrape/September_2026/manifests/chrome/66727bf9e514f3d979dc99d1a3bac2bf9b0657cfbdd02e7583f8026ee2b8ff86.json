{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fqo.us Tab Recorder", "version": "2.1.2", "description": "Record browser tabs and upload to Fqo.us Media Center", "permissions": ["identity", "tabCapture", "storage", "unlimitedStorage", "activeTab", "scripting", "offscreen", "windows", "system.display"], "host_permissions": ["https://*.fqo.us/*", "https://fqo.us/*", "https://storage.googleapis.com/*", "https://api.dropboxapi.com/*", "https://content.dropboxapi.com/*"], "content_scripts": [{"matches": ["https://*.fqo.us/*", "https://fqo.us/*"], "js": ["content-script.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["overlay-window.html", "overlay-window.js", "onboarding.html", "pip-indicator.js", "region-selector.html", "region-selector.js", "desktop-pre-record.html", "desktop-pre-record.js", "lib/ffmpeg/ffmpeg.js", "lib/ffmpeg/814.ffmpeg.js", "lib/ffmpeg/ffmpeg-core.js", "lib/ffmpeg/ffmpeg-core.wasm"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or stop recording"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}