{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MeetMoves", "version": "6.0", "description": "Use your own video or GIF as your Google Meet background. Upload any clip right inside Meet \u2014 one click and it's applied.", "homepage_url": "https://meet-bg.meetmoves.workers.dev/", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://*.workers.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "MeetMoves", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}