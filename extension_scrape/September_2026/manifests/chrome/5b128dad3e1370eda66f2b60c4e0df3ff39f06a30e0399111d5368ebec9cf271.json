{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Midjourney Batch Prompt Runner", "description": "Paste multiple Midjourney prompts separated by blank lines and send them one by one.", "version": "0.1.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "action": {"default_popup": "popup.html", "default_title": "Midjourney Batch", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://www.midjourney.com/*", "https://midjourney.com/*", "https://discord.com/*"], "content_scripts": [{"matches": ["https://www.midjourney.com/*", "https://midjourney.com/*", "https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}