{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zynro", "description": "Replay the music from a Twitch VOD in sync with YouTube Music or Spotify.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "identity"], "host_permissions": ["*://www.twitch.tv/*", "*://music.youtube.com/*", "https://accounts.spotify.com/*", "https://api.spotify.com/*", "https://api-spotify-obs.4each.dev/*", "https://zynro.tv/*"], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["*://www.twitch.tv/*"]}], "browser_specific_settings": {"gecko": {"id": "zynro@4each.dev", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Zynro", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.twitch.tv/*"], "css": ["content-scripts/twitch-vod.css"], "js": ["content-scripts/twitch-vod.js"]}, {"matches": ["*://music.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-music.js"]}]}