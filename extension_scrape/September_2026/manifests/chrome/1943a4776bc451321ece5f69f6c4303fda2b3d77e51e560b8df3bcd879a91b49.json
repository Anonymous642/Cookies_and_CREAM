{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube to Anki - XXHK", "version": "4.3", "description": "Take Anki notes on YouTube with timestamped video.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.bilibili.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.bilibili.com/*"], "js": ["content.js"], "css": ["style.css"]}], "action": {"default_title": "YouTube and Bilibili to Anki - XXHK", "default_icon": {"16": "icons/icon16.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "commands": {"save-timestamp": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Add a note"}, "add-to-watch-later": {"suggested_key": {"default": "Alt+W"}, "description": "Add to Watch Later"}, "remove-from-watch-later": {"suggested_key": {"default": "Shift+Alt+W"}, "description": "Remove from Watch Later"}}}