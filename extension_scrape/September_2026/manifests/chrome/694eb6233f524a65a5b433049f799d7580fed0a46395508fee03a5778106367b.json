{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OnlyTube - Hide distracting feed from YouTube", "description": "YouTube with more focus. Hide YouTube's feed, Shorts, and build a personal watch list \u2014 watch only what you came for.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["*://*.youtube.com/*"], "commands": {"toggle-zen-mode": {"suggested_key": {"default": "Alt+Z"}, "description": "Toggle Zen Mode"}, "toggle-suggestions": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle Suggestions Grid"}, "toggle-shorts": {"suggested_key": {"default": "Alt+X"}, "description": "Toggle Shorts"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "OnlyTube", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*.youtube.com/*"]}]}