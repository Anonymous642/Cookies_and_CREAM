{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubTrack Pro - Subscription Manager", "short_name": "SubTrack", "version": "3.2.1", "description": "Track subscriptions, get reminders, compare prices across regions. Never miss a payment or trial ending again!", "author": "SubTrack Team", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://*.netflix.com/*", "https://*.spotify.com/*", "https://*.youtube.com/*", "https://*.dropbox.com/*", "https://*.google.com/*", "https://*.adobe.com/*", "https://*.amazon.com/*", "https://*.apple.com/*", "https://*.disneyplus.com/*", "https://*.hbomax.com/*", "https://*.max.com/*", "https://*.hulu.com/*", "https://*.notion.so/*", "https://*.figma.com/*", "https://*.canva.com/*", "https://*.github.com/*", "https://*.linkedin.com/*", "https://*.medium.com/*", "https://*.openai.com/*", "https://*.claude.ai/*", "https://*.midjourney.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://mail.yahoo.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/myicon.png", "48": "icons/myicon.png", "128": "icons/myicon.png"}, "default_title": "SubTrack Pro"}, "icons": {"16": "icons/myicon.png", "48": "icons/myicon.png", "128": "icons/myicon.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "options_page": "popup.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open SubTrack"}}}