{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Points Butler", "version": "1.5.1", "description": "Track hotel loyalty points across 9 major programs including Marriott, Hilton, Hyatt, Choice. Sync, PDF export, expiry alerts. Free.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://points-butler-api.onrender.com/*", "https://www.ihg.com/*", "https://www.marriott.com/*", "https://all.accor.com/*", "https://www.itchotels.com/*", "https://www.hilton.com/*", "https://www.hyatt.com/*", "https://www.choicehotels.com/*", "https://www.tajhotels.com/*", "https://www.radissonhotels.com/*"], "content_scripts": [{"matches": ["https://www.ihg.com/*"], "js": ["content/scraper.js", "content/ihg.js"], "run_at": "document_idle"}, {"matches": ["https://www.marriott.com/*"], "js": ["content/scraper.js", "content/marriott.js"], "run_at": "document_idle"}, {"matches": ["https://all.accor.com/*"], "js": ["content/scraper.js", "content/accor.js"], "run_at": "document_idle"}, {"matches": ["https://www.itchotels.com/*"], "js": ["content/scraper.js", "content/itc.js"], "run_at": "document_idle"}, {"matches": ["https://www.hilton.com/*"], "js": ["content/scraper.js", "content/hilton.js"], "run_at": "document_idle"}, {"matches": ["https://www.hyatt.com/*"], "js": ["content/scraper.js", "content/hyatt.js"], "run_at": "document_idle"}, {"matches": ["https://www.choicehotels.com/*"], "js": ["content/scraper.js", "content/choice.js"], "run_at": "document_idle"}, {"matches": ["https://www.tajhotels.com/*/my-account*"], "js": ["content/scraper.js", "content/taj.js"], "run_at": "document_idle"}, {"matches": ["https://www.radissonhotels.com/*"], "js": ["content/scraper.js", "content/radisson.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Points Butler", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background