{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitLab Todo Notifier", "version": "1.0.0", "description": "View, manage, and get notifications for your GitLab todos", "permissions": ["storage", "alarms", "notifications", "offscreen", "contextMenus"], "host_permissions": ["https://gitlab.com/*", "https://*.gitlab.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": "assets/icons/original.png", "default_title": "GitLab Todos"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Open GitLab Todos popup"}}, "minimum_chrome_version": "88"}