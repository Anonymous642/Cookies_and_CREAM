{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boomerang Tabs", "version": "1.3", "description": "Detect duplicate tabs, suggest switching, and navigate tabs easily.", "permissions": ["tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Boomerang Tabs", "default_icon": {"16": "favicon.png", "32": "favicon.png", "48": "favicon.png", "128": "favicon.png"}}, "icons": {"16": "favicon.png", "32": "favicon.png", "48": "favicon.png", "128": "favicon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "tabSwitcher.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["boomerang-tabs-white.png"], "matches": ["<all_urls>"]}], "commands": {"open-tab-switcher": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open tab switcher popup"}}}