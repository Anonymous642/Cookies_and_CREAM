{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Odexly Forms - Autofill rules manager", "version": "1.2.1", "description": "Create website-specific autofill rules for repetitive form fields.", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_title": "Odexly Forms", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "options_page": "options/options.html", "commands": {"fill-current-page": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Fill matching rules on the current page"}, "pick-field": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Pick a field to create an autofill rule"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content/bootstrap.js"], "run_at": "document_start"}], "host_permissions": ["http://*/*", "https://*/*", "file:///*"], "web_accessible_resources": [{"resources": ["fonts/Inter-Regular.woff2", "fonts/Inter-Medium.woff2", "fonts/Inter-SemiBold.woff2", "fonts/Inter-Bold.woff2"], "matches": ["<all_urls>"]}]}