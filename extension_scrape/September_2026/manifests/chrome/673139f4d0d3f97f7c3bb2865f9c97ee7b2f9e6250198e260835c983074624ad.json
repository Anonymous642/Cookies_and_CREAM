{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ColorContrast \u2014 WCAG & APCA Contrast Checker", "short_name": "ColorContrast", "version": "1.0.1", "description": "Free accessibility tool: scan any page for WCAG contrast violations, get APCA scores, simulate color blindness, one-click fixes.", "author": "colorcontrast.org", "homepage_url": "https://colorcontrast.org/chrome-extension/", "privacy_policy_url": "https://www.colorcontrast.org/privacy/", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "ColorContrast \u2014 Check contrast on this page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}]}