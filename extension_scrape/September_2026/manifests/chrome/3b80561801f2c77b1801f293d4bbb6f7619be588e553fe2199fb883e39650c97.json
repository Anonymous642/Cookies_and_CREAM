{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CreatorRPM for YouTube", "version": "0.4.10", "description": "Adds a YouTube channel Analytics tab with monetization checks, RPM estimates, revenue, and view estimates.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "CreatorRPM for YouTube", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}