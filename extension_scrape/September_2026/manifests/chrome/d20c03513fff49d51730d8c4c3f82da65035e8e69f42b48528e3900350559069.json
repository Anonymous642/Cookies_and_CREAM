{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Link Router: Open Tab Links in Another Window", "description": "Route links from a selected tab to a chosen Chrome window and keep multi-window browsing organized. Route as many tabs as you need.", "version": "1.1", "permissions": ["tabs", "windows", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Smart Link Router", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}