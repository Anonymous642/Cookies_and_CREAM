{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto OTP Authenticator", "description": "Multi-language TOTP (2FA) code manager that auto-fills one-time codes on verification forms.", "version": "2.2.0", "action": {"default_popup": "popup.html", "default_title": "Auto OTP Authenticator"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"copy-otp": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Copy OTP code (last used or best-matching account)"}, "fill-otp": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Fill OTP code on the page"}}, "permissions": ["storage", "tabs", "activeTab", "clipboardWrite", "scripting", "webNavigation"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["totp-core.js", "scan-totp-sources.js", "content.js"], "run_at": "document_idle", "all_frames": true}]}