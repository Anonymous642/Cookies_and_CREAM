{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Hider", "version": "1.0", "description": "Hide and show tabs using keyboard shortcuts. Stash distracting tabs and bring them back instantly. Powered by UDARAX.", "permissions": ["tabs", "storage", "history", "idle"], "icons": {"16": "icons/logo_main.png", "32": "icons/logo_main.png", "48": "icons/logo_main.png", "128": "icons/logo_main.png"}, "action": {"default_popup": "popup.html", "default_title": "Tab Hider (Alt+T)", "default_icon": {"16": "icons/logo_main.png", "32": "icons/logo_main.png", "48": "icons/logo_main.png", "128": "icons/logo_main.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"hide-current-tab": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Hide the current tab"}, "show-last-hidden": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Show the last hidden tab"}, "panic-hide-all": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Panic button: Hide all tabs in window"}, "_execute_action": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Open Tab Hider popup"}}}