{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Translate Incoming & Outgoing WhatsApp and Instagram Message InstaTranslate", "version": "3.3.0", "description": "Auto-translate incoming and outgoing WhatsApp and Instagram messages instantly \u2014 right inside your chat.", "permissions": ["storage", "contextMenus"], "host_permissions": ["https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://libretranslate.com/*", "https://libretranslate.de/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*", "https://www.instagram.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "InstaTranslate"}, "icons": {"16": "16.png", "48": "48.png", "128": "128.png"}, "commands": {"toggle-auto-translate": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Toggle InstaTranslate on/off"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}