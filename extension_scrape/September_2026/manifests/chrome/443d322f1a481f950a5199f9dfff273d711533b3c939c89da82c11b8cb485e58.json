{"update_url": "https://clients2.google.com/service/update2/crx", "name": "DualSubs", "description": "Display two subtitle tracks simultaneously on Netflix", "version": "1.0.0", "manifest_version": 3, "permissions": ["storage"], "host_permissions": ["https://www.netflix.com/watch/*", "https://assets.nflxext.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_icon": "icons/icon-gray.png", "default_popup": "settings.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["dual-subs.js", "playback-controller.js"], "matches": ["https://www.netflix.com/*"]}]}