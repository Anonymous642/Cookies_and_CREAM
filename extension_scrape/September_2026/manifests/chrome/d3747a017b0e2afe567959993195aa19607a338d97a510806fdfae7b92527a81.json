{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MalWhere", "version": "1.1", "description": "Select text or a URL and check if it's safe. Green = safe, red = malicious.", "icons": {"16": "malwhere_logo.png", "48": "malwhere_logo.png", "128": "malwhere_logo.png"}, "action": {"default_icon": {"16": "malwhere_logo.png", "48": "malwhere_logo.png", "128": "malwhere_logo.png"}, "default_popup": "popup.html"}, "permissions": ["activeTab", "storage", "tabs", "contextMenus", "notifications"], "host_permissions": ["https://safebrowsing.googleapis.com/*", "https://www.virustotal.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}