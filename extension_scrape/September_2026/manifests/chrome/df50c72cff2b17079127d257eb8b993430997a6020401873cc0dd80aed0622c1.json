{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recipe Sidebar for Minecraft", "version": "1.0.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "description": "Minecraft crafting, smelting & brewing recipes in your Google search results. Unofficial - not affiliated with Mojang/Microsoft.", "permissions": ["storage"], "host_permissions": ["https://extensionpay.com/*"], "action": {"default_title": "Browse all recipes", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["pro-config.js", "content.js"], "css": ["sidebar.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["recipes.json", "icons/*.svg", "icons/*.png"], "matches": ["https://www.google.com/*"]}]}