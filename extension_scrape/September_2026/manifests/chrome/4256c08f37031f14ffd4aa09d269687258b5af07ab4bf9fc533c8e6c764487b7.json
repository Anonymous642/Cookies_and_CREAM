{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HyperApply", "description": "Apply faster with tailored CVs for supported job boards.", "version": "0.1.3", "icons": {"16": "hyperapply_icon.png", "32": "hyperapply_icon.png", "48": "hyperapply_icon.png", "128": "hyperapply_icon.png"}, "action": {"default_popup": "popup.html", "default_title": "HyperApply"}, "background": {"service_worker": "background/serviceWorker.js", "type": "module"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://*.linkedin.com/*", "https://www.remoterocketship.com/*", "https://www.glassdoor.com/*"], "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*", "https://www.linkedin.com/preload/*", "https://www.remoterocketship.com/*/jobs/*", "https://www.remoterocketship.com/*/vagas/*", "https://www.remoterocketship.com/*/emplois/*", "https://www.remoterocketship.com/*/stellen/*", "https://www.glassdoor.com/Job/*", "https://www.glassdoor.com/job-listing/*"], "js": ["content/linkedin.js"], "run_at": "document_idle", "all_frames": true}]}