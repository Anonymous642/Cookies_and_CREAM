{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MessageMop \u2013 Discord Message Remover", "description": "Find, filter, and delete Discord messages in your browser.", "version": "0.1.12", "short_name": "MessageMop", "icons": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png", "256": "icon-256.png"}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://discord.com/*", "https://*.discord.com/*"], "action": {"default_title": "MessageMop \u2013 Discord Message Remover"}, "web_accessible_resources": [{"resources": ["app.html", "injected-button.html"], "matches": ["*://discord.com/*", "*://*.discord.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.discord.com/*", "*://discord.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}