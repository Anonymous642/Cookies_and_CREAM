{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Commenter for BBC News", "version": "1.0.1", "description": "The BBC removed comments from most articles. This extension brings them back \u2014 so the conversations that matter can still happen!", "permissions": ["storage"], "host_permissions": ["https://www.bbc.com/*", "https://www.bbc.co.uk/*"], "content_scripts": [{"matches": ["https://www.bbc.com/news/*", "https://www.bbc.co.uk/news/*", "https://www.bbc.com/sport/*", "https://www.bbc.co.uk/sport/*", "https://www.bbc.com/cbbc/*", "https://www.bbc.co.uk/cbbc/*", "https://www.bbc.com/newsround/*", "https://www.bbc.co.uk/newsround/*", "https://www.bbc.com/indepth/*", "https://www.bbc.co.uk/indepth/*"], "js": ["content.js"], "css": ["content.css"]}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://* https://*"}}