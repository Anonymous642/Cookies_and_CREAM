{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Clicker Pro", "version": "4.1.2", "description": "Professional auto clicker with advanced features. Set click positions, intervals, and automate mouse clicks in your browser.", "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"start-autoclick": {"description": "Start auto click", "suggested_key": {"default": "Ctrl+Q", "windows": "Ctrl+Q", "mac": "MacCtrl+Q", "linux": "Ctrl+Q", "chromeos": "Ctrl+Q"}}, "stop-autoclick": {"description": "Stop auto click", "suggested_key": {"default": "Ctrl+M", "windows": "Ctrl+M", "mac": "MacCtrl+M", "linux": "Ctrl+M", "chromeos": "Ctrl+M"}}}}