{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unleash Focus", "version": "1.2.1", "description": "Lock distracting sites and YouTube Shorts with one click. Unlock when you're done. Nothing leaves your device.", "permissions": ["declarativeNetRequestWithHostAccess", "storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["shorts.css"], "js": ["shorts.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Unleash Focus", "default_popup": "popup.html", "default_icon": {"16": "icons/open-16.png", "32": "icons/open-32.png"}}, "commands": {"toggle-lock": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Lock or unlock your sites"}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}