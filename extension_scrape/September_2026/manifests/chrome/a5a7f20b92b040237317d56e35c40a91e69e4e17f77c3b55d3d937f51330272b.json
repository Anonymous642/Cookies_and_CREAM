{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartCopy for LinkedIn", "version": "2.0.0", "description": "Extract LinkedIn profile data instantly with AI. One-click extraction to spreadsheet-ready format with customizable fields.", "permissions": ["activeTab", "storage", "clipboardWrite"], "host_permissions": ["https://*.linkedin.com/*", "https://api.openai.com/*"], "action": {"default_title": "SmartCopy for LinkedIn - Click to extract profile data"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["extraction_config.yaml"], "matches": ["<all_urls>"]}]}