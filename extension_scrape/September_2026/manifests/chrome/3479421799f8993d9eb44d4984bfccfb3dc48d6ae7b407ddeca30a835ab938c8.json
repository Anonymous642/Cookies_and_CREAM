{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabrixa - Custom Keyboard Shortcut Keys", "version": "1.0.5", "description": "Custom keyboard shortcut keys to open websites quickly. Better than default keyboard shortcuts mac and windows.", "icons": {"16": "logo-16.png", "32": "logo-32.png", "48": "logo-48.png", "128": "logo-128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Open Tabrixa", "default_icon": {"16": "logo-16.png", "32": "logo-32.png", "48": "logo-48.png", "128": "logo-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"shortcut_1": {"suggested_key": {"default": "Alt+1", "mac": "Alt+1"}, "description": "Open Custom Site 1"}, "shortcut_2": {"suggested_key": {"default": "Alt+2", "mac": "Alt+2"}, "description": "Open Custom Site 2"}, "shortcut_3": {"suggested_key": {"default": "Alt+3", "mac": "Alt+3"}, "description": "Open Custom Site 3"}, "shortcut_4": {"suggested_key": {"default": "Alt+4", "mac": "Alt+4"}, "description": "Open Custom Site 4"}, "shortcut_5": {"description": "Open Custom Site 5"}, "shortcut_6": {"description": "Open Custom Site 6"}, "shortcut_7": {"description": "Open Custom Site 7"}, "shortcut_8": {"description": "Open Custom Site 8"}, "shortcut_9": {"description": "Open Custom Site 9"}, "shortcut_10": {"description": "Open Custom Site 10"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}