{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VSCode Extensions Installer", "version": "1.2", "description": "A browser extension to install VSCode extensions directly from the marketplace.", "permissions": ["contextMenus", "activeTab", "scripting", "tabs"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://marketplace.visualstudio.com/items/*"], "js": ["content-scripts/marketplace-detector.js"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "default_state": "disabled"}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "commands": {"install-to-vscode": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Install to VSCode"}, "install-to-vscode-insiders": {"suggested_key": {"default": "Ctrl+Shift+I"}, "description": "Install to VSCode Insiders"}}, "web_accessible_resources": [{"resources": ["utils.js"], "matches": ["<all_urls>"]}]}