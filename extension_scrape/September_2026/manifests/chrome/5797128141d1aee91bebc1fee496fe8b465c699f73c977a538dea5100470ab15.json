{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CastAlert - Casting Call Monitor", "version": "1.0.0", "description": "Monitor casting calls, detect scams, score opportunities, and save to ActorLab. Works on Facebook, Actors Access & more.", "author": "Tombstone Dash LLC", "permissions": ["storage", "activeTab", "alarms", "notifications"], "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*", "*://*.actorsaccess.com/*", "*://*.backstage.com/*", "*://*.castingnetworks.com/*", "*://*.mandy.com/*", "*://*.projectcasting.com/*", "https://actorlab.io/*", "https://api.actorlab.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.actorsaccess.com/*", "*://*.backstage.com/*", "*://*.castingnetworks.com/*", "*://*.mandy.com/*", "*://*.projectcasting.com/*"], "js": ["content-scripts/detector.js", "content-scripts/scorer.js", "content-scripts/injector.js", "content-scripts/main.js"], "css": ["styles/badges.css", "styles/tooltip.css"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"], "js": ["content-scripts/facebook.js"], "css": ["styles/badges.css", "styles/tooltip.css", "styles/facebook.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CastAlert"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "styles/*"], "matches": ["<all_urls>"]}]}