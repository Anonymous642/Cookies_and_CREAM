{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapMark - Screenshot & Annotate", "short_name": "SnapMark", "version": "1.0.1", "description": "The ultimate screenshot tool: capture full page or custom regions, edit, annotate with text and arrows, blur sensitive data & save.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/logo.png", "48": "assets/icons/logo.png", "128": "assets/icons/logo.png"}}, "icons": {"16": "assets/icons/logo.png", "48": "assets/icons/logo.png", "128": "assets/icons/logo.png"}, "background": {"service_worker": "background.js"}, "commands": {"capture_visible": {"suggested_key": {"default": "Alt+1", "mac": "Alt+1"}, "description": "Capture visible area"}, "capture_custom": {"suggested_key": {"default": "Alt+2", "mac": "Alt+2"}, "description": "Capture custom area"}, "capture_fullpage": {"suggested_key": {"default": "Alt+3", "mac": "Alt+3"}, "description": "Capture full page"}}, "web_accessible_resources": [{"resources": ["editor/editor.html"], "matches": ["<all_urls>"]}]}