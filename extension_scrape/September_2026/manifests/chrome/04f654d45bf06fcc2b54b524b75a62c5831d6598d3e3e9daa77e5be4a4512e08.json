{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Messenger Outreach Assistant", "description": "Automatize prospec\u00e7\u00e3o no Facebook. Extraia leads de grupos e busca, envie mensagens personalizadas via Messenger.", "version": "1.0.1", "author": "FBPlanex", "homepage_url": "https://fbplanex.decax.com.br", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://www.facebook.com/*", "https://www.messenger.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["content/extractor.js"], "run_at": "document_idle"}, {"matches": ["https://www.messenger.com/*"], "js": ["content/messenger.js"], "run_at": "document_idle"}]}