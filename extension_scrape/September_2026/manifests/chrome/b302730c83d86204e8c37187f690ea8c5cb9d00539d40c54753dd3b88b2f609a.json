{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenMD", "version": "1.2.3", "description": "Capture any webpage as Markdown or a full-page screenshot. Works standalone or alongside the ScreenMD desktop app.", "author": "ScreenMD", "homepage_url": "https://screenmd.app", "minimum_chrome_version": "116", "permissions": ["scripting", "activeTab", "clipboardWrite", "notifications", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ScreenMD", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"capture-markdown": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Ctrl+MacCtrl+M"}, "description": "Capture page as Markdown"}, "capture-image": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Ctrl+MacCtrl+J"}, "description": "Capture full-page screenshot"}, "capture-both": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Ctrl+MacCtrl+K"}, "description": "Capture Markdown to clipboard and screenshot to Downloads"}}}