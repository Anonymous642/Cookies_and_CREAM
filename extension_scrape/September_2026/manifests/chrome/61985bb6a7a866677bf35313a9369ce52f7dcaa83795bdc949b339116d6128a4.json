{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Brand Voice Checker", "short_name": "BrandVoice", "version": "0.4.1", "description": "Right-click any text to check it against your brand voice guide and marketing-claims rules, then refresh it on-brand.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://davidiwanow.com/*"], "externally_connectable": {"matches": ["https://davidiwanow.com/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Brand Voice Checker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"check-brand-voice": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Check selected text for brand voice fit"}, "check-compliance": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Check selected text for claims compliance"}}}