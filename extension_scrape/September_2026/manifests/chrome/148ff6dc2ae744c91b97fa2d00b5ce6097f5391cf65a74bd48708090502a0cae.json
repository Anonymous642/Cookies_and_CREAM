{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snip", "version": "1.0.1", "description": "Capture any area of your screen, annotate with arrows, text, blur, and shapes, then copy or download as PNG.", "permissions": ["activeTab", "clipboardWrite", "downloads", "storage", "tabs", "offscreen", "scripting"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Snip", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Show Snip Browser"}, "quick-snip": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Quick Snip"}, "snip-and-annotate": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Snip & Annotate"}}}