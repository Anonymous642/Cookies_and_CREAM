{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nottana \u2014 Password Manager on Decentralized Storage", "version": "1.3.0", "description": "Zero-knowledge password manager on decentralized storage. End-to-end encrypted vault, autofill, 2FA, passkeys, and sync.", "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "scripting", "contextMenus", "windows", "webAuthenticationProxy"], "minimum_chrome_version": "115", "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["dist/passkey-injector.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["dist/injected.js", "dist/assets/*.js", "dist/assets/*.css", "icons/*.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "dist/src/popup.html", "default_title": "Nottana Password Manager", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"autofill": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Autofill with Nottana"}, "toggle-lock": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Lock/Unlock Nottana extension"}}, "homepage_url": "https://nottana.com", "author": "Nottana LLC"}