{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NovaStores Importer", "version": "2.0.1", "description": "Import product reviews from Amazon into your NovaStores store in just a few clicks.", "background": {"service_worker": "background.js"}, "action": {"default_popup": "index.html"}, "permissions": ["storage", "activeTab", "webRequest"], "host_permissions": ["https://novastores.ai/*", "*://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.in/*", "https://*.amazon.co.jp/*", "https://*.amazon.com.br/*", "https://*.amazon.com.mx/*", "https://*.amazon.sa/*"], "content_scripts": [{"js": ["amazon/loader.js"], "matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.in/*", "https://*.amazon.co.jp/*", "https://*.amazon.com.br/*", "https://*.amazon.com.mx/*", "https://*.amazon.sa/*"], "run_at": "document_idle"}], "icons": {"16": "logos/logo-16x16.png", "48": "logos/logo-48x48.png", "128": "logos/logo-128x128.png"}, "web_accessible_resources": [{"resources": ["amazon/content.js", "amazon/scraper.js", "shared/auth.js", "shared/ui.js", "shared/importer.js", "css/output.css", "logos/*.png"], "matches": ["<all_urls>"]}]}