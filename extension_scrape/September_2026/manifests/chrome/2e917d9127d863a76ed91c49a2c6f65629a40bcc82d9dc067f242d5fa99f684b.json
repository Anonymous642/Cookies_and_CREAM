{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeTrace - Navigate Your Browser History", "description": "View your history in a timeline format that shows time spent. Search through website contents as well as title and URL.", "version": "1.0.0", "version_name": "1.0.0 Beta", "icons": {"16": "icon-16.png", "32": "icon-32.png", "64": "icon-64.png", "128": "icon-128.png"}, "permissions": ["history", "tabs", "unlimitedStorage", "offscreen", "favicon"], "host_permissions": [], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'"}, "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"]}], "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"history": "history.html"}, "action": {"default_title": "TimeTrace Web Extension", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}