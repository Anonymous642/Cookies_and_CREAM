{"update_url": "https://clients2.google.com/service/update2/crx", "name": "KitchBridge: Watch and chat on Kick from Twitch", "description": "Combine Kick and Twitch into one seamless experience. Watch Twitch streams and interact with Kick in the same place.", "version": "1.6", "manifest_version": 3, "permissions": ["storage", "activeTab", "cookies"], "host_permissions": ["https://www.twitch.tv/*", "https://player.kick.com/*", "https://kick.com/*", "https://7tv.io/*", "wss://*.pusher.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "css": ["overlay.css"]}, {"matches": ["https://player.kick.com/*"], "js": ["kick-hide.js"], "css": ["kick-hide.css"], "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "icons/*.webp"], "matches": ["https://www.twitch.tv/*"]}]}