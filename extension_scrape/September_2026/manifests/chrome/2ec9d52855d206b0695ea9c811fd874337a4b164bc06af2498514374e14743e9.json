{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Fingerprint Alert", "description": "This extension alerts you whenever a web page attempts to collect your browser fingerprint.", "version": "1.0.1", "manifest_version": 3, "background": {"service_worker": "worker.js"}, "permissions": ["storage", "notifications", "tabs"], "action": {"default_popup": "html/popup.html", "default_icon": "icon/32.png"}, "icons": {"32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["<all_urls>"], "css": ["css/notification.css"], "js": ["notification.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["*.html", "*.js", "*.css", "*.wasm"], "matches": ["<all_urls>"]}]}