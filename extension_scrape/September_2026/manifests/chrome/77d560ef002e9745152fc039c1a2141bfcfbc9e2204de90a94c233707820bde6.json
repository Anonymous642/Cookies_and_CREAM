{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Overview Blocker", "version": "1.2.0", "description": "Hide AI-generated overviews and clean up distracting sections on Google Search.", "permissions": ["storage"], "host_permissions": ["https://www.google.com/*", "https://www.google.ca/*", "https://www.google.co.uk/*", "https://www.google.com.au/*", "https://www.google.de/*", "https://www.google.fr/*", "https://www.google.it/*", "https://www.google.es/*", "https://www.google.co.jp/*", "https://www.google.co.in/*"], "icons": {"128": "icons/icon128.png"}, "action": {"default_title": "AI Overview Blocker", "default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.ca/search*", "https://www.google.co.uk/search*", "https://www.google.com.au/search*", "https://www.google.de/search*", "https://www.google.fr/search*", "https://www.google.it/search*", "https://www.google.es/search*", "https://www.google.co.jp/search*", "https://www.google.co.in/search*"], "js": ["config.js", "content.js"], "run_at": "document_start"}]}