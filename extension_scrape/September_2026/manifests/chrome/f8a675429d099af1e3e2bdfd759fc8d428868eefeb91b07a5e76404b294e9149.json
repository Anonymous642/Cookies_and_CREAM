{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GNMSherlock", "short_name": "GNMSherlock", "version": "2.0.0", "description": "Elementary, my dear newsmap. GNMSherlock automatically discovers and validates all Google News Sitemap URLs for any website.", "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["batch.html", "feed-builder.html", "help.html"], "matches": ["https://*/*", "http://*/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}