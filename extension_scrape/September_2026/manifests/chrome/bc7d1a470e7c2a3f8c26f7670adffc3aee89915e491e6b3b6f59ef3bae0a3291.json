{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Screenshot - TubeSnaps", "description": "Take screenshots from YouTube videos and Shorts without player controls. Save as PNG or copy to your clipboard.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "TubeSnaps", "default_popup": "popup.html"}, "permissions": ["activeTab", "offscreen"], "host_permissions": ["https://www.youtube.com/*"], "commands": {"capture-download": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture and download the current YouTube frame"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/youtube.js"]}]}