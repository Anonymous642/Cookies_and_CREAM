{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TweetScrub", "version": "1.3", "description": "Automate deleting your tweets on X (Twitter) based on keywords.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://tweetscrub.vercel.app/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://x.com/*", "*://twitter.com/*"], "action": {"default_popup": "popup.html", "default_title": "TweetScrub"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*", "*://x.com/*", "*://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}