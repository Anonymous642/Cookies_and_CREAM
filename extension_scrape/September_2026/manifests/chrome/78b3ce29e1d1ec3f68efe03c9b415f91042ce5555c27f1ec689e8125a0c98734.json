{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Extract My Leads - Facebook Contact Extractor", "version": "2.1.0", "author": "Krofile", "homepage_url": "https://extractmyleads.com", "description": "Extract contact info from Facebook profiles, pages & groups. Emails, phones, social links & 30+ data points. One-click CSV export.", "permissions": ["notifications", "storage"], "web_accessible_resources": [{"resources": ["js/ExtPay.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["js/content.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["js/ExtPay.js"], "run_at": "document_start"}], "host_permissions": ["https://extensionpay.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_icon": "icons/icon48.png", "default_popup": "popup.html"}}