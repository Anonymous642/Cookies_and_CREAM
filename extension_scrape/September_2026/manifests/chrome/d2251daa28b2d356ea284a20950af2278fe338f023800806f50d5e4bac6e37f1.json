{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "version": "1.2.2", "name": "Amazon Coupon Finder (Hamster Deals)", "description": "Displays Amazon coupons and suggests similar products with active savings directly on product pages.", "permissions": ["contextMenus", "storage", "unlimitedStorage", "alarms", "notifications", "offscreen"], "host_permissions": ["*://www.amazon.com/*", "*://amazon.com/*", "*://*.amazon.com/*", "https://my-worker.yatsek24.workers.dev/*", "https://feedback-worker-dev.yatsek24.workers.dev/*", "https://feedback-worker.yatsek24.workers.dev/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Hamster Coupon Finder"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://amazon.com/*", "https://*.amazon.com/*"], "js": ["utils.js", "content.js"], "css": ["styles.css"], "run_at": "document_start"}, {"matches": ["https://*.amazon.com/promocode/*", "https://*.amazon.com/gp/promotions/*", "https://*.amazon.com/promotions/*"], "js": ["expired_detector.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["icon.png", "icon-16.png", "icon-32.png", "icon-48.png", "disclosure.html", "privacy.html", "search.html", "search.css", "search.js", "bridge.html", "bridge.css", "bridge.js"], "matches": ["https://www.amazon.com/*", "https://amazon.com/*", "https://*.amazon.com/*"]}]}