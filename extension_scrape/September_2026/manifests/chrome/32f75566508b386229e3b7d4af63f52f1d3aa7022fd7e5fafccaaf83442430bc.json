{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Continuer", "version": "1.0", "description": "When ChatGPT stops generating and a \"Continue Generating\" button appears, click it to view the rest of the text.", "default_locale": "en", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*"], "action": {"default_popup": "popup.html"}, "icons": {"32": "icons/32x32.png", "48": "icons/48x48.png", "64": "icons/64x64.png", "128": "icons/128x128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"]}]}