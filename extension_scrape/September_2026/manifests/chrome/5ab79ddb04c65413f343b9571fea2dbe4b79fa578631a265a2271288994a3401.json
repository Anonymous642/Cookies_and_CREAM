{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Glean - Save Tweets & Videos as Todos", "version": "1.1.1", "description": "Turn saved pages, X posts, and YouTube videos into todos your agents can finish.", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "identity", "contextMenus", "activeTab", "scripting", "sidePanel", "notifications", "alarms"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.youtube.com/*", "https://us-central1-glean-app.cloudfunctions.net/*"], "background": {"service_worker": "background/worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["assets/fonts/*.woff2"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/page/index.js"], "run_at": "document_idle"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/twitter/index.js"], "css": ["content-scripts/twitter/styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/youtube/index.js"], "css": ["content-scripts/youtube/styles.css"], "run_at": "document_idle"}], "commands": {"capture-current-tab": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Capture the current page with Glean"}}, "action": {"default_title": "Open Glean panel", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "side_panel": {"default_path": "side-panel/index.html"}}