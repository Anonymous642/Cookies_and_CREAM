{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OmniChat", "version": "1.3.1", "description": "Replace Twitch, Kick, and YouTube chat with OmniChat's merged multi-platform chat.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "cookies", "webRequest"], "host_permissions": ["https://omnichat.tv/*", "https://*.twitch.tv/*", "https://gql.twitch.tv/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["*://*.twitch.tv/*", "*://*.kick.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://omnichat.tv/*"], "js": ["omnichat-bridge.js"], "run_at": "document_start", "all_frames": true}]}