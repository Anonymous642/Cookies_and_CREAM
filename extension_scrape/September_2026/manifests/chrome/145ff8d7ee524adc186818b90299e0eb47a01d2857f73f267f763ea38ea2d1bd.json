{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "alpass", "description": "Zero-knowledge password manager", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_title": "alpass", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "permissions": ["storage", "idle", "contextMenus", "activeTab", "offscreen"], "host_permissions": ["https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "commands": {"fill-login": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Fill login on this page"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content-scripts/content.js"]}]}