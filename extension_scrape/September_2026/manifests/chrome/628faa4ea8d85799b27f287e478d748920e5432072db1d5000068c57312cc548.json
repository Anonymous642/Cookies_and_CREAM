{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MuteURL", "version": "1.0.1", "description": "Prevent certain sites from being autopopulated in the search bar", "permissions": ["storage", "history", "alarms", "sessions", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "/icons/mute-16.png", "48": "/icons/mute-48.png", "128": "/icons/mute-128.png"}}