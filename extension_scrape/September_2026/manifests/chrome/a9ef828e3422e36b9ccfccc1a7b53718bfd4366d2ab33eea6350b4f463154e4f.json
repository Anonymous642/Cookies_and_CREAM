{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipCast", "description": "Chrome Extension for Video Recording", "version": "2.0.6", "icons": {"128": "icon.png"}, "action": {"default_icon": "icon.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["js/content.js"]}, {"matches": ["https://clipcut.5ab.org/*"], "js": ["js/editor-bridge.js"], "run_at": "document_start"}], "background": {"service_worker": "js/worker.js"}, "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "offscreen", "tabCapture", "desktopCapture", "tabs", "contextMenus"], "host_permissions": ["https://clipcast.5ab.org/*", "https://storage.5ab.org/*", "https://clipcut.5ab.org/*"], "web_accessible_resources": [{"resources": ["camera-frame.html", "js/camera-frame.js"], "matches": ["<all_urls>"]}, {"resources": ["whiteboard.html", "js/whiteboard-page.js"], "matches": ["<all_urls>"]}, {"resources": ["video-player.html", "js/video-player.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' blob:;"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "ClipCast: Start / stop recording"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "ClipCast: Pause / resume recording"}, "toggle-mic": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "ClipCast: Toggle microphone"}, "open-whiteboard": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Alt+Shift+W"}, "description": "ClipCast: Open standalone whiteboard tab"}}}