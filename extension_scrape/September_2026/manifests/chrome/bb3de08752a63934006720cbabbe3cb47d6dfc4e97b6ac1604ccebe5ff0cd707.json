{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts Blocker", "version": "1.0", "description": "Blocks YouTube Shorts from appearing on YouTube", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "YouTube Shorts Blocker"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}]}