{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Enhancer", "version": "1.0", "description": "Add a floating bubble to jump between your prompts and enhance ChatGPT with color-coded backgrounds and typography options.", "permissions": ["storage", "alarms", "identity"], "host_permissions": ["https://www.superwebextensions.com/*"], "background": {"service_worker": "src/background/service_worker.js"}, "action": {"default_popup": "popup.html", "default_title": "ChatGPT Enhancer", "default_icon": {"16": "src/Icons/Logo/logo 16.png", "32": "src/Icons/Logo/logo 32.png", "48": "src/Icons/Logo/logo 64.png", "128": "src/Icons/Logo/logo 128.png"}}, "icons": {"16": "src/Icons/Logo/logo 16.png", "32": "src/Icons/Logo/logo 32.png", "48": "src/Icons/Logo/logo 64.png", "128": "src/Icons/Logo/logo 128.png"}, "options_page": "src/options/options.html", "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["src/content/content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/Icons/*.png"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}]}