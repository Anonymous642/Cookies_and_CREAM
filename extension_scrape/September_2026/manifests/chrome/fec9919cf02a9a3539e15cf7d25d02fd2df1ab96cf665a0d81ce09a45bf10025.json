{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Salesforce Logins", "version": "2.0.7", "description": "One-click Salesforce logins. Auto-fill credentials and MFA. Manage orgs securely. 100% local - credentials never leave your device.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.sandbox.my.salesforce.com/*", "https://*.trailblazer.me/*", "https://*.developer.salesforce.com/*"], "action": {"default_popup": "extension-popup.html", "default_title": "Easy Salesforce Logins"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://login.salesforce.com/*", "https://test.salesforce.com/*", "https://*.my.salesforce.com/*", "https://*.sandbox.my.salesforce.com/*", "https://*.salesforce.com/secur/*", "https://*.salesforce.com/*identity/verification*", "https://*.force.com/*identity/verification*"], "exclude_globs": ["https://*.my.salesforce.com/lightning/*", "https://*.my.salesforce.com/*/lightning/*", "https://*.sandbox.my.salesforce.com/lightning/*", "https://*.sandbox.my.salesforce.com/*/lightning/*", "https://*.my.salesforce.com/one/one.app*", "https://*.sandbox.my.salesforce.com/one/one.app*"], "js": ["mfa-utils.js", "content.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}