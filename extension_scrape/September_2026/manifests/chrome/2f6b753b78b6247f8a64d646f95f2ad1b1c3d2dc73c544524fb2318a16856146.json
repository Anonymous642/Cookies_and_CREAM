{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InstantTranslate", "version": "1.5.5", "description": "Select text, middle-click on it: detects the language and translates instantly.", "permissions": ["storage", "clipboardRead", "contextMenus"], "host_permissions": ["<all_urls>", "https://translate.googleapis.com/*", "https://translate.google.com/*", "https://clients5.google.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*", "https://lingva.ml/*", "https://translate.plausibility.cloud/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "InstantTranslate \u2014 Settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"translate-selection": {"suggested_key": {"default": "Alt+Shift+Y", "mac": "Alt+Shift+Y"}, "description": "Translate selection"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["popup.css"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true}]}