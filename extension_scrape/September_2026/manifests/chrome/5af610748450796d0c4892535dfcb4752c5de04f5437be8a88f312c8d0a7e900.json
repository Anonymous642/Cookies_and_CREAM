{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sirvez \u2014 Screen Recorder & Screenshots", "version": "1.7.57", "description": "Record your screen, take screenshots, edit and share \u2014 all from your browser.", "permissions": ["tabCapture", "storage", "unlimitedStorage", "activeTab", "scripting", "offscreen", "windows", "system.display"], "host_permissions": ["https://*.supabase.co/*", "https://*.r2.cloudflarestorage.com/*", "https://*.r2.dev/*", "https://app.sirvez.com/*", "https://*.sirvez.pages.dev/*"], "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["overlay-window.html", "overlay-window.js", "onboarding.html", "region-selector.html", "region-selector.js", "desktop-pre-record.html", "desktop-pre-record.js", "lib/ffmpeg/ffmpeg.js", "lib/ffmpeg/814.ffmpeg.js", "lib/ffmpeg/ffmpeg-core.js", "lib/ffmpeg/ffmpeg-core.wasm", "icons/SirvezLogo.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or stop recording"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}