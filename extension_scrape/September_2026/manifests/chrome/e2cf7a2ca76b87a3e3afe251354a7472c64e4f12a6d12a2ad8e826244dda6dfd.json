{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Todo", "version": "1.3.0", "description": "Save the current YouTube video to your watch-later todo service.", "author": "YouTube Todo", "homepage_url": "https://www.youtube-todo.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "activeTab", "storage", "contextMenus", "notifications"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "https://www.youtube-todo.com/*", "https://youtube-todo.com/*", "http://localhost/*", "https://localhost/*"], "action": {"default_title": "Save YouTube video", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube-todo.com/*", "https://youtube-todo.com/*", "http://localhost/*", "https://localhost/*"], "js": ["detect.js"], "run_at": "document_start"}]}