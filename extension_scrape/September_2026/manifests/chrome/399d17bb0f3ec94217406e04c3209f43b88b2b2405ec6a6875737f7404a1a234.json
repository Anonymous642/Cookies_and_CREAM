{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PiP Anywhere", "version": "1.0.0", "description": "Picture-in-Picture mode for any website with full interactivity \u2014 scroll, click, type, and navigate in an always-on-top window.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "cookies", "storage"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "pip_rules", "enabled": true, "path": "rules/static-rules.json"}]}, "web_accessible_resources": [{"resources": ["pip-launcher.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-pip": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Toggle Picture-in-Picture mode"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["frame-guard.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}]}