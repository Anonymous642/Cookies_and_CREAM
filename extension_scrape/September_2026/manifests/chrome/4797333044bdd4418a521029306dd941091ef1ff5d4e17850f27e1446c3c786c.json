{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSpace", "version": "1.0.0", "description": "TabSpace - Your intelligent Chrome workspace for tabs, bookmarks, and more", "chrome_url_overrides": {"newtab": "index.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "unlimitedStorage", "topSites", "tabs", "tabGroups", "bookmarks", "history", "downloads", "system.memory"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}