{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SlingAgent \u2014 Promote this page", "version": "0.6.0", "description": "Promote any page with SlingAgent \u2014 put it on autopilot, or share it once with a trackable link.", "action": {"default_popup": "popup.html", "default_title": "Promote with SlingAgent", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["tabs", "contextMenus", "storage", "scripting", "activeTab"], "host_permissions": ["https://slingagent.com/*", "http://localhost:3000/*"], "commands": {"promote-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Promote the current tab with SlingAgent"}, "share-once-tab": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Share the current tab once with SlingAgent"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["panel.html", "panel.css", "panel.js", "config.js", "platform-icons.js"], "matches": ["<all_urls>"]}]}