{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Cart", "version": "1.0.4", "description": "Know if a deal is real. Smart Cart tracks Amazon price history and tells you when to buy.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.amazon.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Smart Cart", "default_icon": "icons/icon48.png"}, "content_scripts": [{"matches": ["https://www.amazon.com/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/gp/product/*"], "js": ["storage.js", "content.js"], "run_at": "document_idle"}]}