{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chatgpt Assistant Tools", "version": "0.3.0", "description": "All-in-one ChatGPT toolkit: prompts, context menus, writing assistant, YouTube summaries, and side-panel chat.", "permissions": ["storage", "scripting", "activeTab", "tabs", "contextMenus", "notifications", "sidePanel", "identity", "identity.email", "alarms", "cookies"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://www.youtube.com/*", "https://api.openai.com/*", "https://openrouter.ai/*", "https://extenzyhq.com/*"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "ChatGPT Toolkit", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://www.youtube.com/*"], "js": ["youtube-summary.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content-overlay.js", "writing-assistant.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open ChatGPT Toolkit"}, "ct-writing-assistant": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open the writing assistant on the focused text field"}}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "<all_urls>"]}]}