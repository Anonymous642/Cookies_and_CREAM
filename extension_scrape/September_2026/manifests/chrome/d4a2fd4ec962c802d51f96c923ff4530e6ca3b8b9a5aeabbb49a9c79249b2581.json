{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Upwork AI Proposals, Filters, Instant Job Alerts - UpCat", "description": "Use A.I. to enhance your job search on Upwork with personalized proposals and real-time alerts.", "version": "2.0.2", "key": "", "minimum_chrome_version": "129", "action": {"default_icon": "images/icon-128.png"}, "options_ui": {"page": "option-ui.html", "open_in_tab": true}, "background": {"service_worker": "assets/service-worker.js", "type": "module"}, "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "offscreen", "declarativeNetRequest", "cookies"], "host_permissions": ["https://*.upwork.com/*", "https://*.openai.com/*", "https://*.chatgpt.com/*", "https://*.upcat.app/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_upwork", "enabled": true, "path": "request_modifier.json"}]}, "content_scripts": [{"matches": ["https://*.upwork.com/ab/proposals/job/*/apply*", "https://*.upwork.com/nx/proposals/job/*/apply*", "https://chat.openai.com/*", "https://*.chatgpt.com/*"], "js": ["assets/content-script-entry.js"], "run_at": "document_end"}, {"matches": ["https://*.upwork.com/nx/search*", "https://*.upwork.com/nx/find-work*"], "js": ["assets/cloudflare_detect.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"matches": ["*://*/*"], "resources": ["assets/*"]}]}