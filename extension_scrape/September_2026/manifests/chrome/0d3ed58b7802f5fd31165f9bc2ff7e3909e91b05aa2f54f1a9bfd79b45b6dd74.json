{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flit \u2014 Hover. Save. Done.", "short_name": "Flit", "version": "1.0.1", "description": "Hover any link to save it instantly. Side-panel reading list. Local-only storage\u2014no accounts, no cloud sync.", "permissions": ["storage", "sidePanel", "contextMenus", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Flit"}, "side_panel": {"default_path": "dist/sidepanel/sidepanel.html"}, "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://*/*", "http://*/*"]}], "commands": {"save-hovered-link": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the currently hovered link"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the reading list"}}}