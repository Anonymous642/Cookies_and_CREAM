{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timeline Blocker for X/Twitter", "version": "1.2.0", "description": "Limit your X/Twitter timeline to 5 min/hour \u2014 or block the timeline and notifications 100% of the time. DMs and posting stay open.", "homepage_url": "https://post-bridge.com/?ref=x-limiter", "permissions": ["storage", "alarms"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Timeline Blocker for X/Twitter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_start", "all_frames": false}]}