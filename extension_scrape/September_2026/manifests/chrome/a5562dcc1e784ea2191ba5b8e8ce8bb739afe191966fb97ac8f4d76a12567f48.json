{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PeekFrame \u2014 Product Image Preview", "version": "0.5.1", "minimum_chrome_version": "114", "description": "Hover a Shopify product thumbnail for a magnify button; click for an image preview. Explicit Save settings.", "permissions": ["storage", "activeTab", "scripting"], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "PeekFrame settings", "default_popup": "settings.html"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://admin.shopify.com/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}