{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KeepingTab", "version": "1.1.0", "description": "Only a few tabs matter. Focus on those.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"service_worker": "scripts/background.js", "type": "module"}, "permissions": ["alarms", "tabs", "activeTab", "storage", "webNavigation", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"open-priority-overlay": {"suggested_key": {"default": "Alt+P"}, "description": "Open priority tab overlay"}}, "web_accessible_resources": [{"resources": ["welcome.html", "signin.html"], "matches": ["<all_urls>"]}]}