{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT search", "version": "1.11", "description": "Change default search engine to ChatGPT search.", "icons": {"16": "images/icon16.png", "19": "images/icon19.png", "38": "images/icon38.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "chrome_settings_overrides": {"search_provider": {"name": "ChatGPT", "keyword": "chatgpt.com", "favicon_url": "https://chatgpt.com/faviconDark.ico", "search_url": "https://chatgpt.com/?q={searchTerms}&hints=search&ref=ext", "encoding": "UTF-8", "is_default": true}}, "content_scripts": [{"matches": ["https://*.chatgpt.com/*"], "js": ["content_script.js"], "run_at": "document_start"}]}