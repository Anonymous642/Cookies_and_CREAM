{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SwipeOut - Clean Up Google Photos", "version": "3.5.1", "description": "Google Photos storage full? Swipe left to delete, right to keep. Review photos fast with filters by date, type. One-time purchase.", "permissions": ["activeTab", "storage", "identity", "scripting"], "host_permissions": ["https://photos.google.com/*", "https://accounts.google.com/*", "https://securetoken.googleapis.com/*", "https://www.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://photos.google.com/*"], "js": ["content.js"], "css": ["assets/content.css"], "run_at": "document_idle"}], "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}