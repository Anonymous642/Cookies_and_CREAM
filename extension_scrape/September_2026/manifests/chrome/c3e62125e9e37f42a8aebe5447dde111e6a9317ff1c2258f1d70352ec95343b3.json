{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Carrier Assure - Quick Search", "version": "2.3.9", "description": "Highlight text on any page to extract MC/DOT/FF/MX IDs and instantly open Carrier Assure company profiles with Quick Search.", "permissions": ["tabs", "activeTab", "scripting", "cookies", "sidePanel", "notifications", "storage"], "host_permissions": ["https://*.carrierassure.com/*", "https://api.carrierassure.com/api/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "64": "images/icon64.png", "128": "images/icon128.png"}}, "side_panel": {"default_path": "preview.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://docs.google.com/spreadsheets/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["preview.css", "images/carrier-assure-logo-blue.svg", "config.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';"}, "commands": {"toggle-side-panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Activate Carrier Assure - Quick Search Mode"}}}