{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Exogram", "version": "2.1.0", "description": "Inject verified memory context into ChatGPT, Claude, Gemini & Perplexity. Your AI knows what's true.", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://*.exogram.ai/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content-chatgpt.js"], "run_at": "document_end"}, {"matches": ["https://claude.ai/*"], "js": ["content-claude.js"], "run_at": "document_end"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-gemini.js"], "run_at": "document_end"}, {"matches": ["https://*.perplexity.ai/*"], "js": ["content-perplexity.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}