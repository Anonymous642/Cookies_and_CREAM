{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EyeO - The Ultimate Accessibility Plugin", "version": "1.0.0", "description": "Advanced accessibility tools for enhanced web browsing experience", "permissions": ["storage", "activeTab", "scripting"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle focus assist mode"}, "increase-font": {"suggested_key": {"default": "Ctrl+Shift+0"}, "description": "Increase font size by 10%"}, "decrease-font": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Decrease font size by 10%"}}}