{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pastree", "description": "Clipboard history in a side panel: save what you copy, keep snippets in lists, attach files to upload forms, and reuse prompts.", "minimum_chrome_version": "116", "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "clipboardRead", "clipboardWrite", "scripting", "sidePanel", "alarms"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Pastree - Clipboard Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "src/popup/popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "src/options/options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Open or close Pastree"}, "paste-last": {"suggested_key": {"default": "Alt+P", "mac": "MacCtrl+Shift+O"}, "description": "Paste shortcut item 3"}, "paste-second": {"suggested_key": {"default": "Alt+O", "mac": "MacCtrl+Shift+I"}, "description": "Paste shortcut item 2"}, "paste-third": {"suggested_key": {"default": "Alt+I", "mac": "MacCtrl+Shift+U"}, "description": "Paste shortcut item 1"}, "toggle-auto-capture": {"description": "Turn auto-capture on or off"}, "clear-history": {"description": "Open Clear All Data"}}, "version": "1.2.1"}