{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "XtterLikeDL", "version": "2.0.0", "description": "This extension downloads your liked \"tweets\".", "icons": {"48": "images/icon48.png", "64": "images/icon64.png", "128": "images/icon128.png"}, "action": {"default_popup": "src/popup.html"}, "background": {"service_worker": "src/bg.js", "type": "module"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["src/index.js"]}], "web_accessible_resources": [{"resources": ["src/embed.js", "src/functions.js"], "matches": ["https://x.com/*"]}, {"resources": ["src/bgdownload.html"], "matches": ["<all_urls>"]}], "permissions": ["downloads", "downloads.ui", "storage", "alarms", "unlimitedStorage"]}