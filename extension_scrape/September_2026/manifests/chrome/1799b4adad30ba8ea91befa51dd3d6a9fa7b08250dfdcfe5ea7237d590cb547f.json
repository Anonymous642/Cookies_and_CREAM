{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Compressr", "description": "Keeps browser audio at one comfortable volume. Levels quiet dialogue, tames sudden loud bursts. Fully local.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "activeTab", "tabCapture", "offscreen", "scripting"], "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-processing": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Toggle Compressr for this tab"}}, "web_accessible_resources": [{"resources": ["worklets/*.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.compressr.io"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Loading\u2026", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}