{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen OCR - Free Area Text Extractor", "version": "1.0.0", "description": "Select an area of a webpage and extract readable text locally. Copy, read aloud, or search the extracted text.", "author": "Pardeep Patel (ToolNPlay.com)", "homepage_url": "https://toolnplay.com", "permissions": ["activeTab", "scripting", "clipboardWrite"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"snip_screen": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Activate Screen OCR Selection Tool"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["lib/*", "icons/*"], "matches": ["<all_urls>"]}]}