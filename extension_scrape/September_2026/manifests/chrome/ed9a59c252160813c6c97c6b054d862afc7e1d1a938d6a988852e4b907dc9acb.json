{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabNotes: Sticky Notes for Websites", "description": "Attach sticky notes to tabs, URLs, domains, and pages. Save reminders, highlights, Markdown notes, screenshots, and AI summaries.", "version": "1.0.3", "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "scripting", "sidePanel", "storage", "tabs"], "host_permissions": ["https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"], "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background.js"}, "action": {"default_title": "TabNotes", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/dashboard.html", "side_panel": {"default_path": "src/sidepanel.html"}, "commands": {"add-note": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Add a sticky note to the current tab"}, "toggle-notes": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Show or hide sticky notes on the current tab"}, "open-dashboard": {"description": "Open the TabNotes dashboard"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}]}