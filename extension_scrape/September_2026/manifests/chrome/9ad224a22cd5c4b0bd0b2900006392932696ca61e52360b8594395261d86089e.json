{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "pr-snap", "version": "1.1", "description": "PR-Snap is a Chrome extension that helps you quickly copy GitHub pull request links with titles in various formats for easy sharing.", "permissions": ["clipboardWrite", "activeTab", "scripting", "storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://github.com/*/pull/*"], "css": ["styles/toast.css", "styles/copy-icon.css"], "js": ["scripts/shared/constants.js", "scripts/shared/pr-parser.js", "scripts/shared/clipboard.js", "scripts/shared/toast.js", "scripts/copy-icon.js", "scripts/content.js"]}], "background": {"service_worker": "scripts/background.js"}, "commands": {"copy_pr_link_shortcut": {"description": "Copy GitHub PR link"}}}