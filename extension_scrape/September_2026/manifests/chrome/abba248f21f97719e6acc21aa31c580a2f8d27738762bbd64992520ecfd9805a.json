{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SecureLocker Bookmarks", "version": "0.1.0", "description": "Sidebar bookmark manager with optional end-to-end encryption and panic save.", "icons": {"16": "src/shared/icons/bookmarksLogo16.png", "32": "src/shared/icons/bookmarksLogo32.png", "48": "src/shared/icons/bookmarksLogo48.png", "128": "src/shared/icons/bookmarksLogo128.png"}, "permissions": ["sidePanel", "storage", "tabs", "activeTab", "contextMenus"], "optional_permissions": ["tabGroups"], "background": {"service_worker": "src/background/sw.js", "type": "module"}, "action": {"default_title": "SecureLocker Bookmarks", "default_icon": {"16": "src/shared/icons/bookmarksLogo16.png", "32": "src/shared/icons/bookmarksLogo32.png", "48": "src/shared/icons/bookmarksLogo48.png", "128": "src/shared/icons/bookmarksLogo128.png"}}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "commands": {"panic_save": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Panic: save all tabs and close current window"}, "quick_save": {"suggested_key": {"default": "Alt+S"}, "description": "Quick save current tab"}}, "options_page": "src/options/options.html"}