{"update_url": "https://clients2.google.com/service/update2/crx", "name": "vREST - REST API Testing Tool", "short_name": "vREST", "description": "vREST is an automated REST API Testing Tool. This extension records HTTP requests and their responses in vREST application.", "version": "1.3.0", "manifest_version": 3, "icons": {"16": "images/icon-16.png", "128": "images/icon-128.png"}, "author": "Dheeraj Kumar Aggarwal <dheeraj.aggarwal@optimizory.com>", "background": {"service_worker": "service_worker.js"}, "options_page": "options.html", "permissions": ["debugger", "webRequest", "storage"], "web_accessible_resources": [{"resources": ["options.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["scripts/vrest_content.js"]}], "action": {"default_icon": "images/pause-icon.png", "default_title": "vREST: Click to start capturing", "default_popup": "popup/popup.html"}, "host_permissions": ["http://*/*", "https://*/*"]}