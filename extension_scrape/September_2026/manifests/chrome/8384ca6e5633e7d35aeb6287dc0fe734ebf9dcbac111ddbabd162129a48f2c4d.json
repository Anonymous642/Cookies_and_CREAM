{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Automation Toolkit", "version": "1.0.0", "description": "Queue and auto-run prompts on ChatGPT, then auto-download the replies and images. No accounts, no telemetry, no remote server.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open PromptRunner"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "sidePanel", "downloads"], "host_permissions": ["*://*/*"]}