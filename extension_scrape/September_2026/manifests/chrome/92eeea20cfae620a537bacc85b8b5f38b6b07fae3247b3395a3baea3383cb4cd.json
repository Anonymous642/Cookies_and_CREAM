{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "heynotai - AI Content Detector", "description": "Check text, images, and supported videos for signs of AI generation while you browse.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "identity", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_title": "heynotai"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open the heynotai drawer"}, "scan-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Check the current page"}}, "web_accessible_resources": [{"resources": ["drawer.html", "assets/*", "chunks/*", "fonts/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "css": ["content-scripts/content.css", "content-scripts/text-overlay.css"], "js": ["content-scripts/content.js", "content-scripts/text-overlay.js"]}]}