{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NotesHQ Clipper", "short_name": "NotesHQ", "version": "0.1.1", "description": "Save any webpage to NotesHQ in one click. Captures the URL, title, selected text, and an optional snapshot.", "homepage_url": "https://noteshq.ai/", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "notifications"], "host_permissions": ["https://api.noteshq.ai/*"], "action": {"default_title": "Save to NotesHQ", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["https://app.noteshq.ai/*", "http://localhost/*"]}, "content_scripts": [{"matches": ["https://app.noteshq.ai/*", "http://localhost/*"], "js": ["content-marker.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current page to NotesHQ"}}}