{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Employee Location Extension", "version": "1.0.0", "description": "Shows LinkedIn country breakdown for a company while you're on their website.", "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://www.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Show LinkedIn People breakdown"}, "content_scripts": [{"matches": ["https://www.linkedin.com/company/*/people/*"], "js": ["linkedinScraper.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["overlayContent.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/search*"], "js": ["googleSearchContent.js"], "run_at": "document_idle"}]}