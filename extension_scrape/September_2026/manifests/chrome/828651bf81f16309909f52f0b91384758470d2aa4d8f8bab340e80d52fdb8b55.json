{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Safeey \u2014 Site X-ray & safety check", "version": "0.6.1", "description": "See what any site is built with, who's tracking you, and whether it's safe \u2014 in one click.", "homepage_url": "https://safeey.io", "action": {"default_popup": "popup.html", "default_title": "X-ray this site with Safeey"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"], "host_permissions": ["https://safeey.io/*"], "optional_host_permissions": ["*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}