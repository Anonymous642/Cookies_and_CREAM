{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "cdvolume", "version": "1.0.1", "description": "Aumenta el volumen de audio de las p\u00e1ginas web por encima del 100%", "author": "cdvolume", "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "default_title": "cdvolume - Control de Volumen"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "commands": {"toggle_boost": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Activar/desactivar boost de volumen"}}, "background": {"service_worker": "background/background.js"}}