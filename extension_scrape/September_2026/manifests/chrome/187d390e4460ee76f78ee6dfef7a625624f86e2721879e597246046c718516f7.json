{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aqvil Pastes", "short_name": "Aqvil Pastes", "version": "1.2.0", "description": "Save text to your Aqvil pastes, clip quotes into your article drafts, and save pages to read later in Study.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Aqvil Pastes", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://aqvil.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open Aqvil Pastes"}, "save-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the selected text to your pastes"}, "read-later": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Save this page to read later"}}}