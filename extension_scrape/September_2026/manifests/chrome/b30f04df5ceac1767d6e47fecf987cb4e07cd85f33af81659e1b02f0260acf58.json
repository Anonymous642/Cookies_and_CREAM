{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT EduFocus \u2013 YouTube Learning Mode", "version": "3.0.0", "description": "Focus mode for YouTube replaces the recommendation sidebar with educational content related to the current video.", "permissions": ["storage", "scripting", "notifications", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "exclude_matches": ["https://www.youtube.com/watch*"], "js": ["homepage.js"], "css": ["homepage.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["injected.js", "icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://www.youtube.com/*"]}], "commands": {"toggle-focus": {"suggested_key": {"default": "Alt+F", "mac": "Alt+F"}, "description": "Toggle Focus Mode"}, "toggle-notes": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Open / Close Notes Panel"}, "cycle-speed": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Cycle video playback speed"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}}