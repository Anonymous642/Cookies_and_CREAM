{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Redbelly Name Service Resolver", "version": "0.5.1", "description": "Resolve .rbnt on Redbelly. Auto-labels wallet addresses and .rbnt names on any page. Omnibox + popup lookup. Never reads your keys.", "permissions": ["omnibox", "storage", "clipboardWrite"], "host_permissions": ["https://rbnames.xyz/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "omnibox": {"keyword": "rbnt"}, "action": {"default_popup": "popup.html", "default_title": "Redbelly Name Service Resolver"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}