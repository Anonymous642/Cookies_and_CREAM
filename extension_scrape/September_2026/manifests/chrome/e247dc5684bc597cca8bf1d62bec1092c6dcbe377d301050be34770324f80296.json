{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitch Auto Open", "version": "4.0", "description": "It notifies you and automatically opens when your favorite Twitch channels are live", "icons": {"16": "icon-16.png", "32": "icon-32.png", "128": "icon-128.png"}, "permissions": ["tabs", "alarms", "notifications", "storage"], "host_permissions": ["https://gql.twitch.tv/*", "https://www.twitch.tv/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["notification.mp3", "play-sound.html"], "matches": ["<all_urls>"]}]}