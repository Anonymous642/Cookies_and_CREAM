{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeMark \u2014 Video Timestamp Bookmarks", "version": "2.0.1", "description": "Bookmark specific timestamps in YouTube videos and jump back to them instantly.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}