{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TemplFlow", "version": "1.1.0", "description": "Plantillas Markdown para las descripciones de KanbanFlow", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.kanbanflow.com/*", "*://*.trello.com/*", "*://*.atlassian.net/*", "*://*.linear.app/*", "*://*.notion.so/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Abrir TemplFlow"}}, "content_scripts": [{"matches": ["*://*.kanbanflow.com/*", "*://*.trello.com/*", "*://*.atlassian.net/*", "*://*.linear.app/*", "*://*.notion.so/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}