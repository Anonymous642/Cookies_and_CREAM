{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeepVerify - AI Fact Checker for YouTube", "default_locale": "en", "version": "0.1.56", "description": "Verify claims on any webpage, YouTube video, or live conversation \u2014 instant AI fact-checks backed by real sources.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "DeepVerify"}, "permissions": ["activeTab", "contextMenus", "storage", "scripting", "cookies", "tabs", "sidePanel", "alarms", "tabCapture", "favicon", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_end"}], "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"start-tab-audio-capture": {"suggested_key": {"default": "Alt+T"}, "description": "Start tab audio capture for Live Fact Check"}}, "web_accessible_resources": [{"resources": ["icons/deepverify_logo.svg", "icons/wambat_stop.png"], "matches": ["<all_urls>"]}]}