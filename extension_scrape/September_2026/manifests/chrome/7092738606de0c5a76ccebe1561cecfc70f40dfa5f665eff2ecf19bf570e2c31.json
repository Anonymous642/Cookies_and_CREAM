{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shortlist", "version": "0.1.0", "description": "Highlights LinkedIn hiring posts mentioning your skills and collapses the rest \u2014 entirely local, no network requests.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Shortlist", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/search/results/content/*"], "js": ["content.js"], "run_at": "document_idle"}]}