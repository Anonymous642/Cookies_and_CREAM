{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Full Page Screenshot \u2013 PageSnag", "version": "1.0.1", "description": "Full-page screenshots with minimal permissions, frame capture, built-in editing, and fast PNG/PDF export.", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs", "offscreen", "contextMenus"], "host_permissions": ["https://0x0.st/*", "https://api.imgur.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "PageSnag \u2014 Capture full page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture full page screenshot"}, "capture-visible": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible viewport"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["editor.html", "offscreen.html"], "matches": ["chrome-extension://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}