{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClaudiaFind: Regex Find on Page", "short_name": "ClaudiaFind", "version": "1.0.2", "description": "Better find on page for Chrome. Free: fast text search. Lifetime ($4.99): regex, wildcards, all-tabs search, CSV export.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ClaudiaFind"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"toggle-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open ClaudiaFind search bar"}}, "permissions": ["activeTab", "storage", "scripting", "alarms"], "optional_permissions": ["tabs"], "optional_host_permissions": ["https://*/*", "http://*/*"], "host_permissions": ["https://api.vwapster.cloud/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}