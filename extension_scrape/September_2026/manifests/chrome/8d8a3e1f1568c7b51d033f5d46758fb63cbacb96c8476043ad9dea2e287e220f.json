{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amplify \u2014 Publishing Session Bridge", "version": "1.0.17", "description": "Browser-session bridge for Substack, Medium, and X (Twitter) posting from Amplify", "permissions": ["cookies", "activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://*.substack.com/*", "https://medium.com/*", "https://x.com/*", "https://twitter.com/*", "https://api.x.com/*", "https://amplify.elelem.expert/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://amplify.elelem.expert/*"], "js": ["content.js"], "run_at": "document_start"}]}