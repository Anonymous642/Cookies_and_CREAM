{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StayCheck", "version": "0.1.0", "description": "Shows a Google Maps review check on Booking.com, Agoda, and Expedia property pages.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://staycheck-api.msannan121.workers.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "StayCheck", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["assets/icon-16.png", "assets/icon-32.png", "assets/icon-48.png", "assets/icon-128.png"], "matches": ["https://*.booking.com/*", "https://*.agoda.com/*", "https://*.expedia.co.in/*", "https://*.expedia.com/*"]}], "content_scripts": [{"matches": ["https://www.booking.com/hotel/*", "https://*.booking.com/hotel/*", "https://www.agoda.com/*", "https://*.agoda.com/*", "https://www.expedia.co.in/*", "https://www.expedia.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}