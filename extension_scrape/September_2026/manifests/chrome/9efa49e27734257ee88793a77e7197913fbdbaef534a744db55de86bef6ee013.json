{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMUX", "version": "1.0.0", "description": "tmux-inspired tab group manager. Organize tabs with keyboard shortcuts: Alt+Shift+G to group, Alt+Shift+0-9 to switch.", "permissions": ["tabs", "tabGroups"], "icons": {"16": "tabmux-icon-set/icon16.png", "32": "tabmux-icon-set/icon32.png", "48": "tabmux-icon-set/icon48.png", "128": "tabmux-icon-set/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "TabMUX", "default_icon": {"16": "tabmux-icon-set/icon16.png", "32": "tabmux-icon-set/icon32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}}, "move-mode": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Enter move mode (then press 0..9)"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}]}