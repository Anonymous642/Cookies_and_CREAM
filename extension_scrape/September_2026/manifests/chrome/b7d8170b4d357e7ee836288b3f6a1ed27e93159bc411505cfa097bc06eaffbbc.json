{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "XMarket Composer", "version": "0.1.1", "description": "Recommend prediction markets while composing posts on X.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://api.xmarket.markets/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["assets/content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-32.png"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "background": {"service_worker": "assets/background.js", "type": "module"}, "externally_connectable": {"matches": ["https://xmarket.markets/*"]}, "action": {"default_title": "XMarket", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}