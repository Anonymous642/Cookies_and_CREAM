{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hooked Title Assistant", "version": "1.0", "description": "Generate high-performing YouTube titles", "background": {"service_worker": "background.js"}, "permissions": ["scripting", "tabs"], "host_permissions": ["https://studio.youtube.com/*", "https://hooked-olive.vercel.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://studio.youtube.com/*"]}], "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}