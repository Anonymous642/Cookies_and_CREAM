{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ajax Session Capture", "version": "1.2.0", "description": "Capture a target's authenticated session (cookies + bearer/OAuth2 tokens) from your browser for the Ajax launch wizard.", "minimum_chrome_version": "127", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "dist/background.js"}, "action": {"default_title": "Ajax Session Capture", "default_popup": "dist/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["cookies", "webRequest", "scripting", "tabs", "browsingData"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://*.emulateai.dev/*", "https://*.emulateai.ai/*"], "js": ["dist/bridge.content.js"], "run_at": "document_start"}]}