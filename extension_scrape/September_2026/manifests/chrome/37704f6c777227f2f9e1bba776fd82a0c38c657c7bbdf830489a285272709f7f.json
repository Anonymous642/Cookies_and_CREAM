{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabreel: Screen Recorder & Video Editor", "description": "Record any tab with auto-zoom, smooth cursor effects, and styled exports. Everything stays on your machine.", "version": "1.3.0", "permissions": ["tabCapture", "offscreen", "storage", "downloads", "activeTab", "scripting", "tabs"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_idle"}], "action": {"default_title": "Tabreel", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["countdown.html"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording the current tab"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}