{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumshot \u2013 Screenshot & Annotation Tool", "version": "1.1.0", "description": "Capture, annotate, and explain anything you see in Chrome with a powerful screenshot and screen capture tool.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Lumshot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Capture the visible area right away"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Select a region of the page to capture"}}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "desktopCapture", "offscreen", "notifications"]}