{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PayPerFax Tracker: Monitor Your Fax Transmissions", "description": "Track your PayPerFax transmissions in real-time and view your complete fax history directly in your browser.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "host_permissions": ["https://*.payperfax.com/*", "https://payperfax.com/*"], "permissions": ["storage", "alarms"], "action": {"default_title": "PayPerFax", "default_popup": "popup.html"}, "externally_connectable": {"matches": ["https://*.payperfax.com//*"]}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.payperfax.com/*", "https://payperfax.com/*"], "js": ["content-scripts/content.js"]}]}