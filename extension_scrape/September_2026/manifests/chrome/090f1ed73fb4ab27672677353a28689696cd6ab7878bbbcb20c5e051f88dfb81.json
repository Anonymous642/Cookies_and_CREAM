{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DevSnap - Screenshot & Color Picker", "version": "1.4.1", "description": "Professional screenshot tool with annotation, color picker, element inspector, and measurement tools for developers and designers.", "permissions": ["activeTab", "storage", "downloads", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}, "color-picker": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Activate color picker"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}