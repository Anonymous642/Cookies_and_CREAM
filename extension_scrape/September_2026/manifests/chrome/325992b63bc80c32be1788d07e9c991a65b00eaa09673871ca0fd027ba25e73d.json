{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discountify: Automatic Verified Coupons & Deals", "description": "Automatically find verified coupon codes and affiliate deals while you shop online. Privacy-first, zero identity tracking.", "version": "1.0.4", "permissions": ["tabs", "storage", "favicon"], "host_permissions": ["*://*/*"], "action": {"default_icon": {"16": "action16.png", "32": "action32.png", "48": "action48.png", "128": "action128.png"}, "default_title": "Discountify Coupon Finder", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["favicon.svg", "logo.svg", "discountify.png"], "matches": ["*://*/*"]}], "browser_specific_settings": {"gecko": {"id": "discountify-extension@discountify.io", "strict_min_version": "109.0"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}