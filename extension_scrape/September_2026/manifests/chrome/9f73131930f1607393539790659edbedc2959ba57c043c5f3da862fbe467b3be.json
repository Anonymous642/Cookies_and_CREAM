{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mosaic \u2014 browser context", "short_name": "Mosaic", "description": "Lets Mosaic see your active tab's URL and title so it gives smarter answers about your work. Never page contents or passwords.", "version": "0.1.2", "minimum_chrome_version": "110", "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Mosaic browser context"}, "options_page": "options.html", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["auth-callback.html", "auth-callback.js"], "matches": ["https://usemosaicai.com/*", "https://*.usemosaicai.com/*", "http://localhost:*/*"]}]}