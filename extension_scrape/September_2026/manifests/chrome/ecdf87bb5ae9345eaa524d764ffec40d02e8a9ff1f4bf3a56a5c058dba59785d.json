{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reading Ruler", "version": "0.1.0", "description": "A horizontal highlight that follows the mouse to help you focus on a single line while reading. Useful for ADHD, dyslexia, students.", "permissions": ["storage", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Reading Ruler", "default_popup": "popup.html", "default_icon": {"16": "icons/ruler-off-16.png", "48": "icons/ruler-off-48.png", "128": "icons/ruler-off-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-ruler": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Ctrl+Shift+Y"}, "description": "Toggle the reading ruler on or off"}}}