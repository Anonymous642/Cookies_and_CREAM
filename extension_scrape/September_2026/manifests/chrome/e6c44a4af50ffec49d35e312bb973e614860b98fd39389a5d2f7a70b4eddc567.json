{"update_url": "https://clients2.google.com/service/update2/crx", "name": "LLM Inspector", "description": "Track ChatGPT conversations for search queries, ranked source domains, citations, and models used.", "version": "1.3.0", "manifest_version": 3, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "side_panel": {"default_path": "sidebar.html"}, "background": {"service_worker": "background.js"}, "permissions": ["scripting", "sidePanel", "storage", "unlimitedStorage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gist.githubusercontent.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/c/*", "https://chat.openai.com/c/*"], "css": ["overlay.css"], "js": ["analyzer_core.js", "overlay.js"], "run_at": "document_idle"}]}