{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResearchBud: Chrome extension for notes while researching", "short_name": "ResearchBud", "description": "Take research and study notes without leaving your webpage. A simple notes sidebar for saving highlights and ideas, as you browse.", "version": "0.1.2", "permissions": ["contextMenus", "notifications", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/icon.svg"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Toggle ResearchBud"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"]}]}