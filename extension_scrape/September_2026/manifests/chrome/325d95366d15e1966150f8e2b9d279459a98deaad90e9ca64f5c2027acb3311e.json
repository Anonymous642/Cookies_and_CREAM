{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Highlight Notes Prototype", "version": "0.2.0", "description": "Capture highlighted text, turn it into AI-ready prompts, track notes, and export them for Word.", "permissions": ["activeTab", "contextMenus", "downloads", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Send Notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"capture-highlight": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Capture the current text selection as a highlight"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}