{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Just Cache", "short_name": "Just Cache", "version": "1.0.0", "description": "Clear Cache. Faster Browsing. Clear the cache for the site you're on in one click, or for any site in your history.", "author": "HackitzLabs", "minimum_chrome_version": "116", "homepage_url": "https://hackitzlabs.net", "permissions": ["browsingData", "tabs", "history", "storage", "contextMenus", "alarms", "favicon", "notifications"], "host_permissions": ["https://hackitzlabs-licence.hackitzlabs.workers.dev/*"], "action": {"default_title": "Just Cache \u2014 clear this site's cache", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options/options.html", "commands": {"clear-current-site": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clear cached data for the current site"}, "clear-and-reload": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Clear cached data and hard-reload the current site"}, "open-manage": {"description": "Open the Manage Sites page"}}}