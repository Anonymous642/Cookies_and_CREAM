{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Edit Anything Plus", "version": "1.1", "description": "Edit any page and keep the changes permanently.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-edit-mode": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Toggle Editing Mode On/Off"}, "save-page-edits": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save Edits Permanently"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}