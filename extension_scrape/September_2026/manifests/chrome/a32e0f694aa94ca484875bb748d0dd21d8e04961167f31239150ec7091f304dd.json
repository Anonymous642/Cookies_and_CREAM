{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lexiora: Dictionary & Vocabulary Builder", "description": "Look up any word in context, hear how it sounds, save it with a memory cue, and remember it with spaced repetition.", "version": "2.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Lexiora"}, "web_accessible_resources": [{"resources": ["wikipedia.webp"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}