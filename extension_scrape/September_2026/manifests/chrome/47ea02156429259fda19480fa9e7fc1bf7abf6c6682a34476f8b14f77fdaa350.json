{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Azure DevOps Work Items for GitHub", "version": "1.0.0", "description": "Display Azure DevOps work items linked to GitHub Pull Requests", "permissions": ["storage", "activeTab"], "host_permissions": ["https://dev.azure.com/*", "https://*.visualstudio.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/SPARK_icon.png", "48": "icons/SPARK_icon.png", "128": "icons/SPARK_icon.png"}}, "icons": {"16": "icons/SPARK_icon.png", "48": "icons/SPARK_icon.png", "128": "icons/SPARK_icon.png"}, "web_accessible_resources": [{"resources": ["icons/SPARK.png", "icons/SPARK_white.png"], "matches": ["https://github.com/*"]}]}