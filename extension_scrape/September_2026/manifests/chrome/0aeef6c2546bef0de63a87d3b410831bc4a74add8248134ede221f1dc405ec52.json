{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DOI Link Highlighter", "version": "1.0", "description": "Highlights URLs and DOIs from your custom list on any webpage", "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardRead"], "icons": {"16": "DOI_Highlighter_16x16.png", "48": "DOI_Highlighter_48x48.png", "128": "DOI_Highlighter_128x128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "background": {"service_worker": "background.js"}, "commands": {"add-page-to-list1": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Add current page to List 1"}, "add-clipboard-to-list1": {"suggested_key": {"default": "Alt+Q"}, "description": "Add clipboard link to List 1"}, "add-page-to-list2": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Add current page to List 2"}, "add-clipboard-to-list2": {"suggested_key": {"default": "Alt+W"}, "description": "Add clipboard link to List 2"}}, "action": {"default_popup": "popup.html", "default_title": "DOI Link Highlighter", "default_icon": {"16": "DOI_Highlighter_16x16.png", "48": "DOI_Highlighter_48x48.png", "128": "DOI_Highlighter_128x128.png"}}}