{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Real Estate QR Pro", "version": "1.0.0", "description": "Generate branded QR codes for real estate listings with logo overlay and color customization", "permissions": ["activeTab", "storage", "sidePanel", "tabs"], "action": {"default_title": "Real Estate QR Pro", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://extensionpay.com"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}