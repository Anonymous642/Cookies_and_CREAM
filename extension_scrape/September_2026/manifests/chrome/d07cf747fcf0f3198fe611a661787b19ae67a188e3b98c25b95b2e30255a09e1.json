{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts Remover", "version": "2.0.0", "description": "YouTube Shorts remover that hides Shorts from homepage, sidebar, and feeds for a cleaner YouTube interface.", "permissions": ["storage", "activeTab", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "redirect_shorts", "enabled": true, "path": "rules.json"}]}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle Remove YouTube Shorts on/off"}}}