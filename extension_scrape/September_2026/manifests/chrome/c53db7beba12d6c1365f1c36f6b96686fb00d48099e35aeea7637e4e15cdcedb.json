{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "My Approval Autofill", "description": "Autofills an approved webpage.", "version": "0.3.8", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "Default Popup Title"}, "permissions": ["tabs", "storage", "scripting", "activeTab", "notifications", "sidePanel", "debugger"], "host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["icons/*.png", "icons/*.jpg"], "matches": ["<all_urls>"]}], "key": "", "externally_connectable": {"matches": ["*://*.my-approval.com/*"]}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}