{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skimlane", "version": "0.1.8", "description": "Personalized reading summaries for webpages and PDFs using on-device, local, or bring-your-own-key AI.", "author": "Bilgin Ibryam (@bibryam)", "homepage_url": "https://skimlane.com/", "short_name": "Skimlane", "minimum_chrome_version": "114", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["contextMenus", "offscreen", "scripting", "storage", "tabs", "sidePanel"], "host_permissions": ["<all_urls>", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://api.groq.com/*", "https://openrouter.ai/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_title": "Toggle Skimlane (Ctrl+> / \u2318>)", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "commands": {"toggle-skimlane": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Toggle Skimlane side panel"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["assets/icon.png", "sidepanel.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_idle"}]}