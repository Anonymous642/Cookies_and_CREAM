{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GoRizzume Job Search Companion", "description": "Save jobs from Indeed, LinkedIn and career sites to your GoRizzume tracker. Autofill applications with your profile and CV.", "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["https://gorizzume.co.uk/*", "https://*.indeed.com/*", "https://www.linkedin.com/*", "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://apply.workable.com/*", "https://jobs.ashbyhq.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.indeed.com/*"], "js": ["content/indeed.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/in/*"], "js": ["content/linkedin-profile.js"], "run_at": "document_idle"}, {"matches": ["https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*"], "js": ["content/greenhouse.js"], "run_at": "document_idle"}, {"matches": ["https://jobs.lever.co/*"], "js": ["content/lever.js"], "run_at": "document_idle"}, {"matches": ["https://apply.workable.com/*"], "js": ["content/workable.js"], "run_at": "document_idle"}, {"matches": ["https://jobs.ashbyhq.com/*"], "js": ["content/ashby.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://gorizzume.co.uk/*"]}, "side_panel": {"default_path": "popup/panel.html"}, "version": "1.7.1"}