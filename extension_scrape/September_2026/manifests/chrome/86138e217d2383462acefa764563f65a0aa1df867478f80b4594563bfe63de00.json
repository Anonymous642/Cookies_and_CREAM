{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub PR Context Loader", "version": "1.0.1", "description": "Auto-loads a PR's full context files, commits, CI status, linked issues & review state into one sidebar, with optional AI summaries.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "permissions": ["storage", "alarms"], "host_permissions": ["https://api.gumroad.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.github.com/*", "https://github.com/*"], "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}