{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Tab Manager + Session Saver", "version": "1.0.1", "description": "Save, restore, auto-group, snooze and manage your browser sessions \u2014 100% local & private", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Smart Tab Manager"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabs", "windows", "storage", "alarms", "notifications"], "commands": {"quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save current window as session"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}