{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Infra One", "description": "Save LinkedIn profiles and Gmail contacts to Infra One with one click.", "version": "0.3.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "cookies", "activeTab", "scripting"], "host_permissions": ["https://*.infra.one/*", "https://mail.google.com/*", "https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Infra One", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail-button.js", "content-scripts/gmail.js"]}, {"matches": ["https://www.linkedin.com/in/*"], "run_at": "document_idle", "js": ["content-scripts/linkedin-button.js"]}, {"matches": ["https://www.linkedin.com/*"], "run_at": "document_idle", "js": ["content-scripts/linkedin.js"]}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "run_at": "document_idle", "js": ["content-scripts/twitter.js"]}]}