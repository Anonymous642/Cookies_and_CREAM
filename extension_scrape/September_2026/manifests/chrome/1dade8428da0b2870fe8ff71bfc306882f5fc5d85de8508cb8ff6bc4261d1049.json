{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipboard History + Smart Paste", "version": "1.0.0", "description": "Never lose what you copied. Searchable clipboard history with smart paste options.", "permissions": ["storage", "clipboardRead", "clipboardWrite", "activeTab", "contextMenus", "scripting", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Clipboard History (Ctrl+Shift+V)"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_start"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open clipboard history popup"}, "inline-paste-picker": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Inline paste picker"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}