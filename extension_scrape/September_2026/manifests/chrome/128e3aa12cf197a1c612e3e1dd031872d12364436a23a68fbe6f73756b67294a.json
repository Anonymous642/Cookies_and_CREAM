{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitAlike \u2014 any git platform, preferred UX", "short_name": "GitAlike", "description": "Use any forge, keep your muscle memory. Re-skins GitHub, GitLab\u2122 and Bitbucket as each other, locally; nothing collected.", "permissions": ["storage", "scripting"], "host_permissions": ["*://github.com/*", "*://gitlab.com/*", "*://codeberg.org/*", "*://gitea.com/*", "*://bitbucket.org/*"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "GitAlike", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-site": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Toggle the UI swap for the current site"}, "open-other-host": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open this page on the other host"}}, "version": "0.1.3", "background": {"service_worker": "background.js"}}