{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Simplicity", "creator": "Avi Volah", "version": "1.0.0", "description": "An extension for a simplified, user-friendly GitHub experience. Create, delete, duplicate, rename and move files/folders in 1 click.", "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"128": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "GitHub Simplicity", "default_popup": "popup.html"}, "background": {"service_worker": "bg.js"}, "permissions": ["storage", "tabs", "https://*.github.com/*/*"], "host_permissions": ["https://.github.com/*/*"], "content_scripts": [{"matches": ["https://*.github.com/*/*"], "js": ["cs.js"]}]}