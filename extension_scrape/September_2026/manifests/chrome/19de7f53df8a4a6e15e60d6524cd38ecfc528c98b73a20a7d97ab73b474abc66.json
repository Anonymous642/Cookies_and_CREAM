{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Distro Copilot", "version": "0.1.2", "description": "Run Distro outreach missions across X and LinkedIn with prospect scoring, draft replies, DMs, and approval-based control.", "permissions": ["storage", "alarms", "clipboardWrite", "notifications", "sidePanel"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*", "https://usedistro.com/*", "https://www.usedistro.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Distro Copilot \u2014 open side panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*"]}], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-x.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content-platform.js"], "run_at": "document_idle"}, {"matches": ["https://usedistro.com/extension/connect*", "https://www.usedistro.com/extension/connect*"], "js": ["content-distro-connect.js"], "run_at": "document_idle"}]}