{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RepoKit: Github Power Tools", "version": "1.1", "description": "The GitHub power tools you're missing: file sizes, instant search, zip file downloads, and more. Zero setup.", "icons": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://raw.githubusercontent.com/*"], "content_scripts": [{"matches": ["https://github.com/*"], "js": ["jszip.min.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.svg"], "matches": ["https://github.com/*"]}]}