{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "My Chrome Home", "version": "1.0.3", "description": "A personalised new tab page with search, bookmarks, notes, and more.", "author": "Mark Hall", "homepage_url": "https://markhall.dev/my-chrome-home/", "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_popup": "popup.html", "default_title": "Quick Note"}, "options_page": "options.html", "permissions": ["sessions", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "host_permissions": ["https://api.open-meteo.com/*", "https://nominatim.openstreetmap.org/*", "https://www.bing.com/*", "https://en.wikipedia.org/*", "https://api.nasa.gov/*"]}