{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextCloak - Focus Reading Tool", "version": "1.0.1", "description": "ADHD-friendly reading extension that blurs distractions and reveals sections on hover to help maintain focus. Results may vary.", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-cloak": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle TextCloak focus mode"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}