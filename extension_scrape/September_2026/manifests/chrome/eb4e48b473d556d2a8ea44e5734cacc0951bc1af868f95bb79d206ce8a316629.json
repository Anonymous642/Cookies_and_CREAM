{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecallChess", "version": "0.6.3", "description": "Memorize your opening repertoire. Imports Chessable + PGN, reviews chess.com / lichess games for off-book moves.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["alarms", "storage", "unlimitedStorage", "tabs", "notifications"], "host_permissions": ["https://www.chessable.com/*", "https://www.chess.com/*", "https://*.chess.com/*", "https://api.chess.com/*", "https://lichess.org/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "RecallChess", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.chessable.com/*"], "js": ["content-chessable.js"], "run_at": "document_idle"}, {"matches": ["https://www.chess.com/*", "https://*.chess.com/*"], "js": ["content-chesscom.js"], "run_at": "document_idle"}, {"matches": ["https://lichess.org/*"], "js": ["content-lichess.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["http://localhost:5173/*", "http://localhost:4173/*", "https://recallchess-app.web.app/*", "https://recallchess-app.firebaseapp.com/*", "https://recallchess.app/*"]}, "web_accessible_resources": [{"resources": ["injected-network.js", "injected-chesscom-page.js"], "matches": ["https://www.chessable.com/*", "https://www.chess.com/*", "https://*.chess.com/*"]}, {"resources": ["injected-lichess-page.js"], "matches": ["https://lichess.org/*"]}]}