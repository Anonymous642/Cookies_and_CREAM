{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Terno 3rd Party Calendar Sync", "version": "0.1.0", "description": "Connects your Fresha account to Terno by detecting your existing login. Never reads or stores your password.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["cookies"], "host_permissions": ["https://*.fresha.com/*", "https://*.terno.io/admin/settings/integrations/reconnect/*", "https://*.terno.io/api/integrations/marketplace/session/extension"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.terno.io/admin/settings/integrations/reconnect/*"], "js": ["content-script.js"], "run_at": "document_start", "all_frames": false}]}