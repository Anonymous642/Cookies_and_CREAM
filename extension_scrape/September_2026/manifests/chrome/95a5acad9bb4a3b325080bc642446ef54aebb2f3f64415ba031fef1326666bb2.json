{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CapSend", "version": "1.3.1", "description": "Capture any webpage region, add a typed or spoken prompt, and prepare it in your preferred AI.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://capsend-entitlements-live.capsendco.workers.dev/*"], "web_accessible_resources": [{"resources": ["ui/theme/fonts/InterVariable.woff2", "assets/capsend/capsend-logo-header.png"], "matches": ["<all_urls>"]}], "action": {"default_title": "CapSend control center", "default_popup": "ui/control-center/popup.html", "default_icon": {"16": "assets/capsend/capsend-icon-16.png", "32": "assets/capsend/capsend-icon-32.png"}}, "icons": {"16": "assets/capsend/capsend-icon-16.png", "32": "assets/capsend/capsend-icon-32.png", "48": "assets/capsend/capsend-icon-48.png", "128": "assets/capsend/capsend-icon-128.png"}, "background": {"service_worker": "engine/delivery/background.js"}, "commands": {"start-ai-capture": {"suggested_key": {"windows": "Ctrl+Shift+Space", "linux": "Ctrl+Shift+Space", "mac": "Alt+Z"}, "description": "Start CapSend capture"}, "start-ai-voice-only": {"suggested_key": {"windows": "Ctrl+Space", "linux": "Ctrl+Space", "mac": "Alt+V"}, "description": "Start CapSend Voice Only"}}}