{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Peeksolve", "version": "1.12.1", "description": "Peek at your screen. Get the answer. Instantly.", "permissions": ["activeTab", "storage", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Peeksolve Settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"toggle-solver": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle Peeksolve (Screenshot)"}, "toggle-solver-text": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle Peeksolve (Text / Prompt)"}, "toggle-agent": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Peeksolve Agent \u2014 auto-fill (Pro)"}, "toggle-summary": {"description": "Peeksolve Page Summary (Pro). Set keyboard shortcut in Peeksolve Settings or at chrome://extensions/shortcuts"}, "toggle-godmode": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Peeksolve God Mode \u2014 auto-solve + next (Pro)"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}]}