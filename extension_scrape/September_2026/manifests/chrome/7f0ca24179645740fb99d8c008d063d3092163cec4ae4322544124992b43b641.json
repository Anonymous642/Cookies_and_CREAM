{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT 4o Switcher", "version": "1.0.1", "description": "Tired of ChatGPT always opening with GPT-5? One click to switch your default model between GPT-5 and GPT-4o. That's it.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "GPT5to4o - Switch Default Model", "default_icon": {"16": "icons/4o-16.png", "32": "icons/4o-32.png", "48": "icons/4o-48.png", "128": "icons/4o-128.png"}}, "icons": {"16": "icons/4o-16.png", "32": "icons/4o-32.png", "48": "icons/4o-48.png", "128": "icons/4o-128.png"}, "web_accessible_resources": [{"resources": ["welcome.html"], "matches": ["<all_urls>"]}]}