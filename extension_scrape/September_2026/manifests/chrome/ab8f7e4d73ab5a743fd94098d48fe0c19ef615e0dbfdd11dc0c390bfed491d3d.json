{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageHand", "description": "Analyze the current page and persist AI-generated page scripts for automatic replay.", "version": "0.2.0", "short_name": "PageHand", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png"}, "minimum_chrome_version": "120", "default_locale": "en", "homepage_url": "https://github.com/lwxyfer/pagehand", "action": {"default_title": "Open PageHand"}, "options_ui": {"page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "optional_host_permissions": ["http://*/*", "https://*/*"], "permissions": ["storage", "sidePanel", "tabs", "activeTab", "scripting", "userScripts"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/page-bridge.js"]}]}