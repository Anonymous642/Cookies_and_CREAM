{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopyCatApp", "version": "4.16.1", "description": "Automatically generate step-by-step guides as you work. Click the icon, hit Record, then use your app normally.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "tabs", "sidePanel", "downloads", "storage", "unlimitedStorage", "identity", "tabCapture", "desktopCapture", "offscreen"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["auth-callback.html"], "matches": ["https://*.supabase.co/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open CopyCatApp", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}}