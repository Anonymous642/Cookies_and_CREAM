{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Liberal Shopper", "version": "1.0.0", "description": "This extension identifies the political affiliations of different brands while you shop at Target.", "author": "Liberal Shopper", "homepage_url": "https://www.liberalshopper.com", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "128": "images/128.png"}, "action": {"default_popup": "popup.html"}, "host_permissions": ["*://*.target.com/*"], "content_scripts": [{"matches": ["*://*.target.com/*"], "js": ["companyRatings.js", "brandRatings.js", "productPage.js", "content.js"]}], "web_accessible_resources": [{"resources": ["images/trump.png", "images/128.png"], "matches": ["*://*.target.com/*"]}]}