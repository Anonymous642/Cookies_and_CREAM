{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Deck \u2014 Save & Insert AI Prompts", "version": "0.1.2", "description": "Save reusable prompts and paste them into ChatGPT, Claude & Gemini in one hotkey. Local-first, no account needed.", "permissions": ["storage", "contextMenus", "identity"], "host_permissions": ["https://api.cs2tradebot.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "src/popup.html", "default_title": "Prompt Deck"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-snippet-search": {"suggested_key": {"default": "Alt+Q"}, "description": "Open snippet quick search"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["src/core.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}