{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrawlRaven SEO Toolbar: On-Page SEO Audit & Schema Validator", "description": "On-page SEO audit tool. Check meta tags, schema markup, hreflang, redirects, and broken links from a Chrome side panel.", "version": "0.2.0", "short_name": "CrawlRaven", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["alarms", "scripting", "storage", "tabs", "webNavigation", "webRequest", "sidePanel"], "host_permissions": ["*://*/*"], "action": {"default_title": "CrawlRaven \u00b7 SEO Toolbar"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+Command+S"}}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://*/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*/*"], "exclude_matches": ["*://*/*.pdf", "*://*/*.txt", "*://*/*.xml"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}