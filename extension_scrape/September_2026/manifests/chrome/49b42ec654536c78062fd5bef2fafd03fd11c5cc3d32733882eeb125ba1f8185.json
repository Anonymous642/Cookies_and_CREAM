{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lens by Vectored - Tab Capture & Organizer", "version": "1.23.0", "description": "Lens by Vectored: capture regions and record GIFs with hotkeys, filed into local project folders with a metadata timeline.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/background.js", "type": "module"}, "minimum_chrome_version": "137", "permissions": ["activeTab", "alarms", "storage", "scripting", "downloads", "tabs", "tabCapture", "offscreen", "identity", "identity.email", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture region of active tab (macOS style)"}, "record-steps": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Command+Shift+E"}, "description": "Smart Capture: record a step-by-step guide (screenshot per click)"}, "record-gif": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Record high-res GIF region of active tab"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["lib/gifencoder.js", "content/guide-player.css", "icons/icon-128.png"], "matches": ["<all_urls>"]}]}