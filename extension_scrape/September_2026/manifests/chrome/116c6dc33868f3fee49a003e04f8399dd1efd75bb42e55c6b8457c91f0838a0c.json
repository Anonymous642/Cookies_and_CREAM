{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Keyboard Controls", "version": "3.0.0", "description": "Use Up/Down for previous/next post, Left/Right to navigate image carousels on Reddit. Join our Discord:https://discord.gg/NnMeWpyzYK", "permissions": ["storage", "tabs", "downloads"], "background": {"service_worker": "background/background.js"}, "action": {"default_title": "Reddit Keyboard Controls", "default_popup": "popup/popup.html", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "content_scripts": [{"matches": ["*://www.reddit.com/*", "*://old.reddit.com/*", "*://np.reddit.com/*", "*://new.reddit.com/*"], "js": ["shared/messages.js", "shared/settings.js", "content/ui/unified-control-view.js", "content/dom-helpers.js", "content/modules/theme-manager.js", "content/modules/post-navigation.js", "content/modules/media-controls.js", "content/modules/ui-widgets.js", "content/modules/duplicate-detection.js", "content/modules/keyboard-handler.js", "content/content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["*://www.reddit.com/*", "*://old.reddit.com/*", "*://new.reddit.com/*", "*://np.reddit.com/*"]}]}