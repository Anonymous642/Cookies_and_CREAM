{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ListJetGo Companion", "version": "1.1.5", "description": "Companion extension for ListJetGo that captures Amazon product data and processes listing jobs.", "permissions": ["tabs", "storage", "scripting", "alarms", "activeTab"], "host_permissions": ["https://www.amazon.com/*", "https://amazon.com/*", "https://app.listjetgo.com/*", "https://panel.listjetgo.com/*", "https://api.listjetgo.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.com/s*", "https://www.amazon.com/*/s*"], "js": ["amazonSearch.js"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.com/*", "https://amazon.com/*"], "js": ["amazonCheckoutStarter.js"], "run_at": "document_idle"}, {"matches": ["https://app.listjetgo.com/*", "https://panel.listjetgo.com/*"], "js": ["panelBridge.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html"}}