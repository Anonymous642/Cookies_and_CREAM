{"update_url": "https://clients2.google.com/service/update2/crx", "name": "DVI Unsent Monitor", "version": "0.3.6", "manifest_version": 3, "description": "Detects DVIs that are completed (signed) but not sent. SPA-aware, popup shows list; optional floating panel.", "permissions": ["activeTab", "alarms", "notifications", "offscreen", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "DVI Unsent Monitor", "default_popup": "popup.html", "default_icon": {"16": "icons/action16.png", "32": "icons/action32.png", "48": "icons/action48.png", "128": "icons/action128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["<all_urls>"]}]}