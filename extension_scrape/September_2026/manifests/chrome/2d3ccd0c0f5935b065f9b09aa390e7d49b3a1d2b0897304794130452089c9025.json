{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cairn \u2014 Tab Manager, Workspaces & Session Saver", "short_name": "Cairn", "version": "2.0.0", "description": "Tab manager that saves your open tabs as named workspaces \u2014 close everything, restore your session in one click. No account.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open Cairn"}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "history", "bookmarks", "sessions", "contextMenus", "favicon", "alarms"], "host_permissions": [], "optional_permissions": ["downloads", "notifications"], "optional_host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open Cairn"}, "open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Cairn command palette"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*"}, "minimum_chrome_version": "116"}