{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClinicWeed \u2014 Gravador de Consultas (Meet)", "version": "0.4.2", "description": "Grava a consulta no Meet e envia ao ClinicWeed. Agora tamb\u00e9m cria consultas e abre o Meet pelo popup.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabCapture", "offscreen", "storage", "tabs"], "host_permissions": ["https://meet.google.com/*", "https://app.clinicweed.com.br/*", "https://api.clinicweed.com.br/*"], "externally_connectable": {"matches": ["https://app.clinicweed.com.br/*"]}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://meet.google.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "ClinicWeed \u2014 Gravador de consultas", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Gravar a consulta no Meet"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["config.js", "content-meet.js"], "run_at": "document_idle"}, {"matches": ["https://app.clinicweed.com.br/*"], "js": ["config.js", "content-app.js"], "run_at": "document_idle"}]}