{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MagneticProxy", "description": "Chrome extension to configure proxies from MagneticProxy.", "version": "0.1.12", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["proxy", "webRequest", "webRequestAuthProvider", "storage"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://*.magneticproxy.net/*", "https://*.magneticproxy.com/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Magnetic Proxy", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.magneticproxy.com/*", "https://*.magneticproxy.net/*"], "js": ["content-scripts/content.js"]}]}