{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Commyt - LinkedIn Job Search", "version": "1.6.4", "description": "Capture jobs and connections from LinkedIn automatically. Smart dashboard with scoring and messages.", "permissions": ["storage", "activeTab", "scripting", "alarms", "clipboardWrite"], "host_permissions": ["https://www.linkedin.com/*", "https://*.onrender.com/*", "https://www.commyt.net/*", "https://commyt.net/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["i18n-ext.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["i18n-ext.js", "connection-capture.js"], "run_at": "document_idle"}, {"matches": ["https://*.onrender.com/*", "https://www.commyt.net/*", "https://commyt.net/*"], "js": ["token-sync.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Commyt - Your job search assistant", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}