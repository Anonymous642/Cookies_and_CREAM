{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ChatGPT Input Recorder", "manifest_version": 3, "version": "1.0", "description": "Record ChatGPT user inputs and manage them through a side panel with bookmarks and history.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "tabs"], "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content/common.js", "content/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Open Recorder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}