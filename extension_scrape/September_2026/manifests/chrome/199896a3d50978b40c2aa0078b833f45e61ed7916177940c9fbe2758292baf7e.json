{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedactShield: Blur & Redact for Screen Share", "description": "Blur, block, or truly redact anything on a page for demos and screen shares. Real DOM redaction, on-device, no subscription.", "version": "0.1.1", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "RedactShield"}, "background": {"service_worker": "background.js"}, "commands": {"panic-redact": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Toggle emergency full-screen redaction"}}, "permissions": ["activeTab", "commands", "scripting", "storage"], "optional_host_permissions": ["*://*/*", "https://api.gumroad.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html"}