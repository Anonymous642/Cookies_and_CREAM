{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jira Peek", "description": "Peek at Jira tickets without leaving GitHub.", "version": "1.2.1", "action": {"default_popup": "src/popup/index.html", "default_title": "Jira Peek", "default_icon": {"16": "img/icons/icon-16.png", "48": "img/icons/icon-48.png", "128": "img/icons/icon-128.png"}}, "icons": {"16": "img/icons/icon-16.png", "48": "img/icons/icon-48.png", "128": "img/icons/icon-128.png"}, "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*", "https://github.dev/*"], "js": ["src/contentScript/index.js"]}], "permissions": ["storage", "activeTab", "sidePanel"], "host_permissions": ["https://github.com/*", "https://github.dev/*", "https://*.atlassian.com/*", "https://*.atlassian.net/*"], "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "short_name": "Jira Peek"}