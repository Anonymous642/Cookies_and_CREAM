{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "New Tab Redirect", "description": "Allows a user to provide the URL of the page that loads in a new tab.", "version": "1.0.1", "short_name": "NTR!", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "icon/96.png", "128": "/icon/128.png"}, "permissions": ["storage", "tabs"], "optional_host_permissions": ["file:///*"], "minimum_chrome_version": "89", "action": {"default_title": "New Tab Redirect - Click to open options"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}}