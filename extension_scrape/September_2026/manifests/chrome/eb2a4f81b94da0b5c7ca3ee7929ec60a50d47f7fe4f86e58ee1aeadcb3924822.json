{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SafeMind: Short-Video & Distraction Blocker", "version": "1.4", "description": "Reclaim attention. Blocks doomscrolling, shorts, reels (FB, IG, YT), adult sites & ads. Fully customizable privacy blocker.", "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "activeTab"], "host_permissions": ["https://*.youtube.com/*", "https://*.instagram.com/*", "https://*.facebook.com/*"], "action": {"default_popup": "popup.html", "default_title": "SafeMind Settings", "default_icon": "icon128.png"}, "icons": {"128": "icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "easylist_rules", "enabled": true, "path": "rules.json"}, {"id": "adult_rules", "enabled": true, "path": "rules_adult.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content_youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*"], "js": ["content_meta.js"], "run_at": "document_start"}]}