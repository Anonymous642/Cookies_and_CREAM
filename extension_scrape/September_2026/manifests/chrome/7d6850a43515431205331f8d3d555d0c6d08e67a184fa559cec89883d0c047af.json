{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Obsidian Clipper", "version": "0.1.5", "description": "Grab YouTube captions, preview Markdown, and save notes to Obsidian Local REST API.", "permissions": ["storage", "scripting", "activeTab", "sidePanel"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://youtu.be/*", "http://127.0.0.1/*", "https://127.0.0.1/*", "http://localhost/*", "https://localhost/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://www.youtube.com/embed/*", "https://m.youtube.com/watch*", "https://m.youtube.com/shorts/*", "https://music.youtube.com/watch*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "YouTube Obsidian Clipper", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html"}}