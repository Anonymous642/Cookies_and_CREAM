{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Pronnel", "version": "1.1", "description": "Pronnel - Create items, notes, and contacts from LinkedIn. Manage your time tracker and stay organized.", "manifest_version": 3, "permissions": ["tabs", "storage", "identity", "contextMenus"], "content_scripts": [{"js": ["contentScript.js"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html"}, "icons": {"16": "assets/PronnelBrandLogo.png", "48": "assets/PronnelBrandLogo.png", "128": "assets/PronnelBrandLogo.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["index.html", "assets/PronnelBrandLogo.png", "assets/icons/close-gray.svg", "assets/drag-dots.svg"], "matches": ["<all_urls>"]}], "commands": {"create-item": {"suggested_key": {"default": "Ctrl+I", "mac": "Command+I"}, "description": "Create Item from selected text"}, "create-note": {"suggested_key": {"default": "Alt+N", "mac": "Command+Shift+N"}, "description": "Create Note from selected text"}}}