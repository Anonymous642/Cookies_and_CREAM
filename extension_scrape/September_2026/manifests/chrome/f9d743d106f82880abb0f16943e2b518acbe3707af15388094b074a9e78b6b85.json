{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdminPalette \u2013 Shopify Admin Command Center", "version": "1.1.0", "description": "Lightning-fast command center for Shopify Admin. Navigate anywhere instantly with Ctrl+Shift+K.", "author": "Inoviqa", "homepage_url": "https://adminpalette.com", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.myshopify.com/*", "https://admin.shopify.com/*"], "background": {"service_worker": "src/background/service_worker.js"}, "content_scripts": [{"matches": ["https://*.myshopify.com/*", "https://admin.shopify.com/*"], "js": ["src/core/config.js", "src/shared/device_id.js", "src/shared/shopify_context.js", "src/shared/storage.js", "src/shared/licensing.js", "src/shared/default_commands.js", "src/content/ui/fuzzy.js", "src/content/ui/palette.js", "src/content/content_script.js"], "css": ["src/content/ui/palette.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "AdminPalette"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "commands": {"toggle-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open AdminPalette Command Center"}}, "web_accessible_resources": [{"resources": ["assets/*", "src/content/ui/palette.css"], "matches": ["https://*.myshopify.com/*", "https://admin.shopify.com/*"]}]}