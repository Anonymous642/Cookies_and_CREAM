{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UI Extractor", "version": "1.0.3", "description": "Hover-pick any element and keep it as self-contained HTML with the CSS that really applies. Scan pages. Build a UI library.", "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "sidePanel", "contextMenus", "tabs", "downloads"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "action": {"default_title": "Pick an element (Alt+Shift+E)"}, "minimum_chrome_version": "116", "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"activate-picker": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Start picking an element on the current page"}}}