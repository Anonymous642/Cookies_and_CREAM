{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Get The Full Page", "version": "1.0.0", "description": "Capture visible viewport, full page, or desktop/window/tab screenshots.", "permissions": ["activeTab", "tabs", "downloads", "desktopCapture", "scripting", "storage", "unlimitedStorage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open Get The Full Page"}, "capture-viewport": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture visible viewport"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Select a region to capture"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page (scroll & stitch)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}