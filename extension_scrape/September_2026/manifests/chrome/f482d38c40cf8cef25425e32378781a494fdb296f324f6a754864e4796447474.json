{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Maggpie: Save & Collect Design Inspiration", "description": "Save pages, screenshots, and the real SVGs, images, and videos from any website to your Maggpie library.", "version": "0.6.16", "short_name": "Maggpie", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://maggpie.app/*"], "optional_host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://maggpie.app/*"]}, "action": {"default_title": "Maggpie", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open Maggpie"}, "capture-page": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Save page"}, "capture-screenshot": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Screenshot"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Pick element"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://maggpie.app/*"], "run_at": "document_start", "js": ["content-scripts/web-bridge.js"]}]}