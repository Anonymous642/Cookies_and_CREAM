{"update_url": "https://clients2.google.com/service/update2/crx", "description": "Hypelio extension to Generate and schedule LinkedIn posts", "version": "0.0.4", "manifest_version": 3, "name": "Hypelio - LinkedIn Post Generator", "background": {"service_worker": "background.bundle.js"}, "action": {"default_icon": "main-default.png"}, "icons": {"128": "main-default-large.png"}, "content_scripts": [{"matches": ["https://app.hypelio.com/*", "http://localhost:3000/*"], "js": ["contentScript.bundle.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self'; img-src 'self';"}, "permissions": ["scripting", "cookies", "tabs", "debugger", "alarms", "storage"], "host_permissions": ["https://www.linkedin.com/", "https://app.hypelio.com/"]}