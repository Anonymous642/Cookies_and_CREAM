{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhisperAI.com - The Official Speech to Text", "version": "2.0.0", "description": "Dictate in any language with the official WhisperAI.com speech-to-text app, powered by OpenAI.", "permissions": ["identity", "sidePanel", "storage", "activeTab", "offscreen", "scripting", "alarms", "tabs", "tabCapture", "contextMenus"], "optional_permissions": ["notifications"], "omnibox": {"keyword": "wai"}, "host_permissions": ["https://whisperai.com/*", "https://*.whisperai.com/*", "http://*/*", "https://*/*"], "action": {"default_title": "WhisperAI - Click to start voice typing", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["content/content.js", "offscreen/audio-processor.js"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "options/options.html", "icons": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Start/stop voice recording"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}