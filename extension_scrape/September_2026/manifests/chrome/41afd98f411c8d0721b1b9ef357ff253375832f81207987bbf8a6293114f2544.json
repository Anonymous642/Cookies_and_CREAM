{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickTabNav", "version": "1.0.6", "description": "Search open tabs, optional bookmarks, and 30-day History, then switch or open in one step.", "permissions": ["tabs", "storage", "scripting", "sessions", "search", "favicon"], "optional_permissions": ["bookmarks", "history"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open QuickTabNav", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open QuickTabNav"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}