{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabruns: AI Browser Assistant & Form Filler", "version": "0.8.22", "description": "AI assistant & chat for any website: fills forms, clicks buttons, answers questions, automates tasks. Nothing runs without your OK.", "minimum_chrome_version": "116", "homepage_url": "https://tabruns.com", "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs", "downloads", "alarms", "notifications"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Tabruns", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T"}, "description": "Open Tabruns"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}