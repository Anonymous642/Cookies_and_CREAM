{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Search NoAI", "version": "1.0.0", "description": "Automatically appends '-noai' to Google search queries.", "author": "KingAkrej", "permissions": ["storage"], "host_permissions": ["https://www.google.com/*", "https://www.google.cz/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Search NoAI", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.cz/search*"], "js": ["content.js"], "run_at": "document_start"}]}