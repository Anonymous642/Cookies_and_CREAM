{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebShot - Advanced Web Screenshot Tool", "version": "4.0.5", "description": "Professional web screenshot automation tool with advanced features for security testing, monitoring, and documentation.", "author": "Aplastine Team", "homepage_url": "https://github.com/aplastine/webshot", "background": {"service_worker": "src/js/background.js"}, "action": {"default_popup": "src/html/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "WebShot - Take Screenshots"}, "permissions": ["activeTab", "tabs", "downloads", "storage", "scripting", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["src/js/libs/html2canvas.min.js", "src/js/libs/xlsx.full.min.js", "src/js/content.js"], "matches": ["<all_urls>"]}], "options_ui": {"page": "src/html/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area of current tab"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page of current tab"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"}}