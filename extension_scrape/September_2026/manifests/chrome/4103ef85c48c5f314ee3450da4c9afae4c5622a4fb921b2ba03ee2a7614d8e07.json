{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Post Scraper - Export Communities and Search to CSV/JSON", "version": "0.1.0", "description": "Export visible Reddit community and search posts, authors, metrics, text and media links to JSON or CSV.", "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["https://www.reddit.com/*", "https://reddit.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://reddit.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}