{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Memo - Web Capture by MemorySpace", "version": "2.0.0", "description": "Memo saves web pages, screenshots, and highlights to your AI memory. Never lose what you find online.", "permissions": ["storage", "contextMenus", "activeTab", "tabs", "alarms", "scripting"], "host_permissions": ["https://memoryspace.ai/*", "https://api.memoryspace.ai/*", "https://*/*", "http://*/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Memo - Save to your AI memory"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}