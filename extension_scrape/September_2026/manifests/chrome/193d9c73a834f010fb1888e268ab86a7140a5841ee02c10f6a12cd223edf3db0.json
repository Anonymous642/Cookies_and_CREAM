{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Troll", "version": "1.1.2", "description": "Auto-logs you out of distracting sites when you close them. Next revisit becomes a conscious choice, not a mindless habit.", "permissions": ["tabs", "storage", "cookies", "browsingData", "declarativeNetRequest", "scripting", "identity", "offscreen", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://*.youtube.com/*", "*://tiktok.com/*", "*://*.tiktok.com/*", "*://reddit.com/*", "*://*.reddit.com/*"], "js": ["site-feed-guard-config.js", "site-feed-guard.js"], "run_at": "document_start"}, {"matches": ["*://facebook.com/*", "*://*.facebook.com/*", "*://instagram.com/*", "*://*.instagram.com/*", "*://youtube.com/*", "*://*.youtube.com/*", "*://tiktok.com/*", "*://*.tiktok.com/*", "*://reddit.com/*", "*://*.reddit.com/*", "*://x.com/*", "*://*.x.com/*", "*://linkedin.com/*", "*://*.linkedin.com/*"], "js": ["default-site-prompt.js"], "run_at": "document_idle"}], "options_ui": {"page": "settings.html", "open_in_tab": true}, "action": {"default_title": "Focus Troll Settings"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/images/website-extension-detect.svg", "settings.html"], "matches": ["https://www.focustroll.com/*", "https://focustroll.com/*", "http://localhost:5173/*"]}, {"resources": ["assets/images/focus_troll_logo_full_dark.png"], "matches": ["*://facebook.com/*", "*://*.facebook.com/*", "*://instagram.com/*", "*://*.instagram.com/*", "*://youtube.com/*", "*://*.youtube.com/*", "*://tiktok.com/*", "*://*.tiktok.com/*", "*://reddit.com/*", "*://*.reddit.com/*", "*://x.com/*", "*://*.x.com/*", "*://linkedin.com/*", "*://*.linkedin.com/*"]}]}