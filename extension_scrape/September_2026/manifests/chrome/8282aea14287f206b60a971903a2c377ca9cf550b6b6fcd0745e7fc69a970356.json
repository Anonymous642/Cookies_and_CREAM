{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MoodReads - Spice Content for Goodreads & AO3", "version": "0.1.11", "description": "See spice levels, romance tropes, content warnings, mood tags, and similar books directly on Goodreads and AO3 pages.", "author": "MoodReads", "homepage_url": "https://moodreads.app", "permissions": ["storage", "activeTab", "alarms", "identity"], "host_permissions": ["https://www.goodreads.com/*", "https://archiveofourown.org/*", "https://moodreads-api-prod.up.railway.app/*"], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Toggle MoodReads panel"}}, "content_scripts": [{"matches": ["https://www.goodreads.com/book/show/*"], "js": ["fieldDescriptions.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://archiveofourown.org/works/*"], "js": ["fieldDescriptions.js", "ao3-content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.goodreads.com/review/list/*", "https://www.goodreads.com/shelf/*"], "js": ["goodreads-shelf-content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://moodreads.app/*"]}, "web_accessible_resources": [{"resources": ["icons/logo.webp"], "matches": ["https://www.goodreads.com/*", "https://archiveofourown.org/*"]}]}