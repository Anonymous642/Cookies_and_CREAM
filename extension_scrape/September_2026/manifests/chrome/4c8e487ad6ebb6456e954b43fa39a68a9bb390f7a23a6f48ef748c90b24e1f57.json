{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Upwork Autopilot - Monitoring, Insights and More", "short_name": "Upwork Autopilot", "description": "Real-time job insights, risk scoring, proposal management, and automated job monitoring for Upwork freelancers.", "version": "1.0.0", "permissions": ["storage", "scripting", "tabs", "alarms", "notifications"], "host_permissions": ["https://www.upwork.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"js": ["content/tokenInterceptor.js"], "matches": ["https://www.upwork.com/*"], "run_at": "document_start"}, {"js": ["content/proposal.js"], "matches": ["https://www.upwork.com/nx/proposals/job/*/apply/*", "https://www.upwork.com/nx/proposals/job/*/apply*", "https://www.upwork.com/ab/proposals/job/*/apply/*", "https://www.upwork.com/ab/proposals/job/*/apply*"], "run_at": "document_idle"}, {"js": ["content/search.js"], "matches": ["https://www.upwork.com/nx/search/*"], "run_at": "document_idle"}, {"js": ["content/feed.js"], "matches": ["https://www.upwork.com/nx/find-work/*", "https://www.upwork.com/nx/jobs/feed/*", "https://www.upwork.com/ab/jobs/search/*"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Upwork Autopilot", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "web_accessible_resources": [{"resources": ["dashboard.html", "icons/*"], "matches": ["*://*.upwork.com/*"]}]}