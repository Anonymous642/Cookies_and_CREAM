{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMate: AI Assistant for Chrome Tabs", "version": "0.2.3", "description": "TabMate adds a floating assistant button and page actions for quick ChatGPT, Claude, or Gemini popup workflows.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "options_page": "onboarding.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["provider-logos/*"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"open-selected-provider": {"description": "Open the selected assistant in a fresh popup window", "suggested_key": {"default": "Alt+Shift+Y", "mac": "Command+Shift+Y"}}}}