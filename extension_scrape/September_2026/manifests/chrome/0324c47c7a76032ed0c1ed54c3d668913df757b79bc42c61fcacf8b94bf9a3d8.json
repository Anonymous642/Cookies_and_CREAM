{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumina-Flux Full Page Capture", "version": "1.1.6", "description": "Capture a whole scrolling web page as one long image, saved straight to your computer. Nothing is ever sent anywhere.", "author": "Lumina-Flux", "homepage_url": "https://lumina-flux.com", "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage", "clipboardWrite"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Capture full page (Alt+Shift+P)"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}