{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SingVault", "version": "2.0.7", "description": "Back up your own Smule karaoke recordings to your computer or Google Drive all in one click, next time only the new ones.", "host_permissions": ["https://*.smule.com/*", "https://singvault.app/*", "https://www.googleapis.com/*"], "permissions": ["identity", "storage", "unlimitedStorage", "declarativeNetRequest"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "SingVault", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "bg.js"}, "content_scripts": [{"matches": ["https://www.smule.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}