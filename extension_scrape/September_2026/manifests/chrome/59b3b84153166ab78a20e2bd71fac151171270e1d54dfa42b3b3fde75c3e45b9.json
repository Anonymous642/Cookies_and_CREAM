{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Temu Scraper 2.0", "version": "2.1.0", "description": "Easily Scrapes Temu product details manually.", "author": "softametics@gmail.com", "permissions": ["tabs", "storage", "scripting", "downloads", "cookies"], "web_accessible_resources": [{"resources": ["src/popup.html", "src/settings.html", "src/settings.js", "src/content_scrape_product.js", "src/content_remove_scraped.js", "src/content_floating_button.js", "src/content_floating_remove.js"], "matches": ["https://www.temu.com/*", "https://temu.com/*"]}], "host_permissions": ["https://www.temu.com/*", "https://temu.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Temu Scraper", "default_popup": "src/popup.html"}, "commands": {"scrape-current": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Scrape current product page"}, "batch-scrape": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Batch scrape all Temu product tabs"}}, "icons": {"16": "assets/2.png", "48": "assets/3.png", "128": "assets/4.png"}, "content_scripts": [{"matches": ["https://www.temu.com/*", "https://temu.com/*"], "js": ["src/content_common.js", "src/content_floating_button.js", "src/content_floating_remove.js"], "run_at": "document_idle"}]}