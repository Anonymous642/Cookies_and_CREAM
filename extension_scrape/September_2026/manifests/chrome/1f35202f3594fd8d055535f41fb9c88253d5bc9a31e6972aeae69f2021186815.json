{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Manager \u2014 Promptnest", "short_name": "Promptnest", "version": "1.0.4", "description": "Save the prompts you keep retyping and reuse them on any AI chat with a keyboard shortcut. Free for 20 prompts.", "author": "Promptnest", "permissions": ["storage", "identity", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://grok.com/*", "https://pi.ai/*", "https://huggingface.co/chat/*", "https://www.phind.com/*", "https://phind.com/*", "https://you.com/*", "https://poe.com/*", "https://bolt.new/*", "https://lovable.dev/*", "https://v0.app/*", "https://v0.dev/*", "https://*.supabase.co/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_title": "Promptnest", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "scripts/background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Activate the extension"}, "open-picker": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open Promptnest prompt picker"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["scripts/storage.js", "scripts/content-base.js", "scripts/content-chatgpt.js"], "css": ["styles/inject.css"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["scripts/storage.js", "scripts