{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Capchur: Screen Capture, make guides automatically", "description": "Capchur browser workflow recorder", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "alarms", "identity", "scripting", "storage"], "host_permissions": ["https://capchur.io/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Capchur recording controls", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}