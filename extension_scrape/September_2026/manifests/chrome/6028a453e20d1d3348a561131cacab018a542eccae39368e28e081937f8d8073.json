{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Booster \u2014 Boost Sound Up to 800%", "short_name": "Volume Booster", "version": "1.0.0", "description": "Boost any tab's volume up to 800% with sound presets and a 10-band equalizer. Crystal-clear, distortion-free, fast, and private.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Volume Booster \u2014 Boost Sound Up to 800%", "default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "assets/background.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "storage", "tabs", "activeTab"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Open Volume Booster"}, "volume-up": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "Alt+Shift+Up"}, "description": "Increase volume of the current tab"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "Alt+Shift+Down"}, "description": "Decrease volume of the current tab"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Mute or unmute the current tab"}, "reset-volume": {"description": "Reset the current tab to 100%"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}