{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "catchroll", "version": "1.0.49", "description": "Capture full pages cleanly \u2014 pixels for you, real text for your AI \u2014 in a library of files you own. All on your machine.", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "clipboardWrite"], "action": {"default_title": "catchroll", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"start-region-capture": {"suggested_key": {"default": "Ctrl+Shift+Insert", "mac": "Command+Shift+Insert"}, "description": "Start region capture"}, "start-scroll-capture": {"suggested_key": {"default": "Ctrl+Shift+Home", "mac": "Command+Shift+Home"}, "description": "Start scrolling-column capture"}, "start-element-capture": {"suggested_key": {"default": "Ctrl+Shift+End", "mac": "Command+Shift+End"}, "description": "Start element-pick capture"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["canvas.html"], "matches": ["<all_urls>"]}]}