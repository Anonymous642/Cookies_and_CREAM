{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabHaven", "version": "1.0.0", "description": "Save, organize and restore tab sessions with Tab Groups, cloud sync, categories, snooze and more. Your tabs deserve a safe haven.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "contextMenus"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save current session"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://extensionpay.com;"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}