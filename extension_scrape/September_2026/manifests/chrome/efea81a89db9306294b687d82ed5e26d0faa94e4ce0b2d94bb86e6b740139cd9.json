{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OPPY Application Autofill", "version": "0.2.0", "description": "Fills employer job application forms from your OPPY application profile. You review and submit every application yourself.", "minimum_chrome_version": "116", "permissions": ["storage", "scripting", "activeTab", "sidePanel"], "host_permissions": ["*://*.myworkdayjobs.com/*", "*://*.wd1.myworkdayjobs.com/*", "*://*.wd3.myworkdayjobs.com/*", "*://*.wd5.myworkdayjobs.com/*", "*://job-boards.greenhouse.io/*", "*://boards.greenhouse.io/*", "*://*.greenhouse.io/*", "*://jobs.lever.co/*", "*://*.ashbyhq.com/*", "*://*.icims.com/*", "*://*.workable.com/*", "*://*.smartrecruiters.com/*", "*://*.jobvite.com/*", "*://*.taleo.net/*", "https://app.oppy.work/*", "https://staging.oppy.work/*"], "externally_connectable": {"matches": ["https://app.oppy.work/*", "https://staging.oppy.work/*"]}, "background": {"service_worker": "dist/background.js", "type": "module"}, "action": {"default_title": "OPPY Autofill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "popup.html"}, "commands": {"fill-page": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Fill this application from your Oppy profile"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}