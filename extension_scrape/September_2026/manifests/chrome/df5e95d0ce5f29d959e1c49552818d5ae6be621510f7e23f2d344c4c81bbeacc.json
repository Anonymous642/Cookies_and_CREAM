{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Solution Num\u00e9rique T\u00e9l\u00e9com Click2Call", "description": "Searches for a phone numbers on web pages, allows to make calls with 1 click for Solution Num\u00e9rique T\u00e9l\u00e9com phone system users.", "version": "2.1", "manifest_version": 3, "icons": {"128": "img/favicon/favicon.png"}, "permissions": ["activeTab", "commands", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_icon": "img/favicon/favicon.png", "default_title": "Solution Num\u00e9rique T\u00e9l\u00e9com Click2Call", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+J", "chromeos": "Ctrl+Shift+U", "linux": "Ctrl+Shift+J", "mac": "Command+Shift+Y", "windows": "Ctrl+Shift+Y"}, "description": "Opens the extension"}}, "background": {"service_worker": "background.bundle.js"}, "content_scripts": [{"all_frames": true, "js": ["vendors/mutation-summary.js", "content.bundle.js"], "exclude_matches": ["*://webphone.sn-telecom.fr/*"], "matches": ["<all_urls>"]}], "web_accessible_resources": [{"resources": ["img/*.png", "img/*.jpg", "img/*.svg"], "matches": ["*://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "sandbox": "sandbox allow-scripts; script-src 'self'"}}