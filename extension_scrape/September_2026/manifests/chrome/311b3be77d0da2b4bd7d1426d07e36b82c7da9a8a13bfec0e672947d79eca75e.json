{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JSK ClipKeep \u2014 Clipboard Manager & History", "description": "Clipboard history that detects and protects the secrets you copy. Encrypted on your device, never sent anywhere.", "version": "0.1.0", "short_name": "ClipKeep", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "clipboardRead", "clipboardWrite", "unlimitedStorage", "alarms", "activeTab", "scripting", "tabs", "offscreen", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_title": "ClipKeep", "default_popup": "popup.html"}, "commands": {"open_panel": {"description": "Open ClipKeep"}, "paste_last": {"description": "Paste the most recent clip"}, "toggle_capture": {"description": "Pause or resume capture"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}