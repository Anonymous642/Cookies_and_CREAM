{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Verity Meet Capture", "version": "1.0.0", "description": "Record and transcribe your Google Meet meetings, with your consent.", "minimum_chrome_version": "116", "permissions": ["activeTab", "downloads", "offscreen", "sidePanel", "storage", "tabCapture"], "action": {"default_title": "Verity Meet capture", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Verity Meet capture"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content/coach-chip.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/coach-chip.css"], "matches": ["https://meet.google.com/*"]}], "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://app.verityscribe.com/*"]}}