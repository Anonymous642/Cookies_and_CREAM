{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SideNote", "short_name": "SideNote", "description": "SideNote lets you park, branch, and resume ChatGPT conversations without losing context.", "version": "0.0.11", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs", "webNavigation"], "host_permissions": ["https://chatgpt.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "SideNote"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"]}]}