{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Batch Link Extractor", "version": "1.2.1", "description": "Intelligently extract links from documentation websites and YouTube channels, batch add to NotebookLM and other knowledge bases", "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["site-adapters.js", "automation.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Extract Page Links"}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["content.js", "img/icon.png"], "matches": ["<all_urls>"]}]}