{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quicky PDF: Edit PDFs, No Uploads", "short_name": "Quicky PDF", "version": "2.0.2", "description": "Opens PDFs in a viewer with the tools built in. Highlight, sign, fill, redact and split, right in the tab. Nothing uploaded.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Quicky PDF"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["contextMenus", "declarativeNetRequest"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["<all_urls>"]}]}