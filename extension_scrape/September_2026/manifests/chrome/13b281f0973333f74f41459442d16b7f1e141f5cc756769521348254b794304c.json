{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Link Actions", "description": "Copy a page or link's URL, clean URL, Markdown link, domain, host, path or custom formats", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "scripting", "activeTab", "storage", "clipboardWrite", "offscreen"], "optional_permissions": ["tabs"], "commands": {"copy-page-url": {"suggested_key": {"default": "Alt+Shift+U", "mac": "MacCtrl+Shift+U"}, "description": "Copy current page URL"}, "copy-page-domain": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Copy current page domain"}, "copy-page-subdomain": {"description": "Copy current page subdomain"}, "copy-page-host": {"description": "Copy current page host"}, "copy-page-path": {"description": "Copy current page path"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Link Actions", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}