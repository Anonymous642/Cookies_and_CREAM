{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recent Tab Switcher", "description": "Switch back through recently active tabs with a keyboard shortcut.", "version": "0.1.19", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Recent Tab Switcher"}, "permissions": ["storage", "tabs", "scripting", "activeTab"], "background": {"service_worker": "service-worker.js"}, "commands": {"switch-recent-tab": {"suggested_key": {"default": "Ctrl+Q", "mac": "MacCtrl+Q"}, "description": "Switch to a recently active tab"}, "switch-recent-tab-reverse": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "MacCtrl+Shift+Q"}, "description": "Move backward in recent tab preview"}}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["overlay.js"], "run_at": "document_idle"}]}