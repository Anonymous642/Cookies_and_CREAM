{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Citation Extractor", "version": "1.0.2", "description": "Extract citations from ChatGPT outputs", "permissions": ["activeTab"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "action": {"default_popup": "popup.html", "default_title": "Extract Citations", "default_icon": {"16": "Assets/icon16.png", "32": "Assets/icon32.png", "48": "Assets/icon48.png"}}, "icons": {"16": "Assets/icon16.png", "32": "Assets/icon32.png", "48": "Assets/icon48.png", "128": "Assets/icon128.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}