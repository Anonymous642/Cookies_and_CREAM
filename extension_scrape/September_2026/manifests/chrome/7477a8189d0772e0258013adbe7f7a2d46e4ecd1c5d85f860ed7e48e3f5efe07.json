{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabitha", "description": "Your new tab workspace for saving, reorganizing, and searching tabs \u2014 with optional AI summaries and grouping.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "permissions": ["storage", "tabs", "downloads", "scripting", "unlimitedStorage", "alarms"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Tabitha"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Tabitha", "default_popup": "popup.html"}}