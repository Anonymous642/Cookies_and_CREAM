{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Viblyy \u2014 Turn music down while AI answers", "short_name": "Viblyy", "version": "1.1.0", "description": "Never touch the volume again. Music drops when an answer lands, back when you send.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "alarms", "webRequest", "favicon", "activeTab"], "optional_permissions": ["nativeMessaging"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["*://claude.ai/*", "*://chatgpt.com/*", "*://gemini.google.com/*", "*://www.perplexity.ai/*", "*://copilot.microsoft.com/*", "*://open.spotify.com/*", "*://music.youtube.com/*", "*://www.youtube.com/*", "*://soundcloud.com/*", "*://listen.tidal.com/*", "*://music.apple.com/*", "*://www.deezer.com/*", "*://bandcamp.com/*", "*://*.bandcamp.com/*"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "action": {"default_title": "Viblyy", "default_popup": "src/ui/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/ui/options.html", "open_in_tab": true}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Turn Viblyy on/off"}}}