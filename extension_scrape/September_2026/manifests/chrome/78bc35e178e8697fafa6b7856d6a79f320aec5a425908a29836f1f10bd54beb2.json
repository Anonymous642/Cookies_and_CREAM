{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Creos Capture", "version": "1.0.2", "minimum_chrome_version": "114", "description": "Save posts from Instagram, X, Pinterest & YouTube \u2014 plus any page or screenshot \u2014 into your local Creos library.", "permissions": ["storage", "activeTab", "scripting", "pageCapture", "contextMenus", "alarms"], "host_permissions": ["http://127.0.0.1:47615/*", "https://*.instagram.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.pinterest.com/*", "https://*.youtube.com/*", "https://cdn.syndication.twimg.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Creos", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://*.instagram.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.pinterest.com/*"], "js": ["collect.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup.html", "popup.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}