{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coconudge", "description": "Practice while you browse", "version": "0.3.1", "permissions": ["storage", "tabs", "scripting", "alarms", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Coconudge", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["logo-icon.png", "icons/icon48.png"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://coconudge.com/*", "https://www.coconudge.com/*"]}}