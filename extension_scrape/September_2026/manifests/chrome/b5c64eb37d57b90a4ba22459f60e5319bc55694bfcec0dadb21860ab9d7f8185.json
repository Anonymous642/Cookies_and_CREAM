{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timecheck", "description": "Know where your time really goes with the help of a floating timer and a friendly frog.", "version": "1.1.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "idle"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Timecheck", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}