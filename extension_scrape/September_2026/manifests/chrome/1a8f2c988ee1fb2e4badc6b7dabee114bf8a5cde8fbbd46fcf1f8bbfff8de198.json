{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Email Alert", "version": "0.0.0.1", "icons": {"16": "/images/icon16.png", "32": "/images/icon32.png", "48": "/images/icon48.png", "128": "/images/icon128.png"}, "description": "This Chrome extension monitors your Gmail and alerts you with music when a new email arrives. Never miss an important email again!", "permissions": ["activeTab", "alarms", "scripting"], "host_permissions": ["*://mail.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "/popup/popup.html", "default_icon": "/images/icon128.png"}, "author": "orsik.adrienn@gmail.com", "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'"}}