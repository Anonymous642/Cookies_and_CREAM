{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Next Recorder", "description": "Record your screen, tab or camera with audio, capture full-page screenshots, annotate them, and save to your device or the cloud.", "version": "1.5.0", "icons": {"16": "assets/images/favicon.png", "32": "assets/images/favicon.png", "48": "assets/images/favicon.png", "128": "assets/images/favicon.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "assets/images/favicon.png", "32": "assets/images/favicon.png", "48": "assets/images/favicon.png", "128": "assets/images/favicon.png"}}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs", "desktopCapture", "tabCapture", "notifications", "clipboardWrite", "offscreen"], "background": {"service_worker": "background.js"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Screenshot: capture visible part"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Screenshot: capture full page"}, "capture-area": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Screenshot: capture selected area"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["video.html", "camera-preview.html", "camera-preview.js", "assets/sound/beep.wav", "assets/css/recording-bar.css", "recording-bar.html", "assets/images/*.png", "assets/images/*.svg"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "host_permissions": ["http://*/*", "https://*/*", "https://*.nextrecorder.com/*", "https://nextrecorder.com/*"]}