{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UNIVERSAL COPY CLEANER", "version": "1.0.0", "description": "Auto-cleans pasted text, removes formatting, manages clipboard history. Clean, consistent text everywhere you paste.", "minimum_chrome_version": "109", "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'"}, "permissions": ["storage", "clipboardRead", "clipboardWrite", "contextMenus", "offscreen", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["modules/formatProfiles.js", "modules/textCleanerEngine.js", "content/pasteInterceptor.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Universal Copy Cleaner", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"clean-paste": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Clean paste"}, "open-popup": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "MacCtrl+Shift+C"}, "description": "Open Copy Cleaner"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["off_screen.html"], "matches": ["<all_urls>"]}]}