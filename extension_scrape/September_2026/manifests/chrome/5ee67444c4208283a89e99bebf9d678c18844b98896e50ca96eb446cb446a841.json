{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ross Time Capture", "version": "0.1.0", "description": "Captures active browsing time and page context as billable-time signals for Ross. Typed input and passwords are never captured.", "homepage_url": "https://www.runverba.com", "minimum_chrome_version": "120", "incognito": "not_allowed", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Ross Time Capture", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}}