{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gmail <> Salesforce", "version": "3.1.1", "description": "AI-powered Gmail to Salesforce integration. Log emails, search records, post to Chatter, upload attachments - all in one click.", "author": "SCube <scubedevelopmentteam@gmail.com>", "homepage_url": "https://scubedevelopmentteam.github.io/scube-website/gmail.html", "permissions": ["storage", "identity", "tabs", "alarms", "notifications", "contextMenus", "sidePanel"], "host_permissions": ["https://mail.google.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://*.workers.dev/*", "https://www.googleapis.com/*", "https://accounts.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://mail.google.com/*"]}], "commands": {"open-log-panel": {"suggested_key": {"default": "Alt+L"}, "description": "Open the Gmail SyncForce log panel"}}}