{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabCluster - Smart Tab Organization", "version": "1.2.10", "description": "Smart Tab Grouping with Minimal UI", "permissions": ["tabs", "tabGroups", "activeTab", "storage", "notifications", "contextMenus"], "action": {"default_popup": "popup.html", "default_title": "TabCluster"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: chrome-extension: chrome://favicon/ https://* http://*;"}, "commands": {"group-tabs": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Group tabs by domain"}, "ungroup-tabs": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ungroup all tabs"}, "toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Toggle extension popup"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}