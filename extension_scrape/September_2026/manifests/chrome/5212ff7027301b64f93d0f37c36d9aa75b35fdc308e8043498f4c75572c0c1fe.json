{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Button Shortcut Clicker", "version": "1.1", "description": "Click buttons on specific websites using keyboard shortcuts.", "icons": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Shortcut Settings", "default_icon": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}}, "commands": {"shortcut_1": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Trigger Shortcut 1"}, "shortcut_2": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Trigger Shortcut 2"}, "shortcut_3": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "MacCtrl+Shift+Q"}, "description": "Trigger Shortcut 3"}, "shortcut_4": {"suggested_key": {"default": "Alt+Shift+A", "mac": "MacCtrl+Shift+D"}, "description": "Trigger Shortcut 4"}}}