{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Last Tab", "version": "1.0.3", "description": "Toggle between the current tab and the one you were on just before \u2014 like a TV last-channel button.", "minimum_chrome_version": "109", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "windows", "storage"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_title": "Last Tab \u2014 click to jump to previous tab", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-last-tab": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Toggle to previous tab"}}}