{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenHighlights", "version": "1.5.1", "description": "A private library for highlights, notes, PDFs, and offline reading.", "minimum_chrome_version": "114", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "sidePanel", "tabs"], "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Open OpenHighlights", "default_icon": {"16": "icon16.png", "32": "icon32.png"}, "default_popup": "index.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open OpenHighlights"}}}