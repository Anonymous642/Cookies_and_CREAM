{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Definio AI: Multi-Modal AI Sidebar", "short_name": "Definio AI", "description": "Definio runs every LLM model from one sidebar. Throw your question at any of them, switch on a whim, never open a new tab.", "version": "3.0.1", "author": "Zuka Murvanidze", "homepage_url": "https://ai.definio.org", "minimum_chrome_version": "114", "permissions": ["storage", "sidePanel", "tabs", "activeTab", "scripting"], "host_permissions": ["https://definio.org/*", "https://ai.definio.org/*"], "externally_connectable": {"matches": ["http://localhost/*", "https://localhost/*", "https://definio.org/*", "https://*.definio.org/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/selection.js"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "src/pages/sidepanel/index.html"}, "action": {"default_title": "Open Definio AI", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open Definio AI side panel"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}