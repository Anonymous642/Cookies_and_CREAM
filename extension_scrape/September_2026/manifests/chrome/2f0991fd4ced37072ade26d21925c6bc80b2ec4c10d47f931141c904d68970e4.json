{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubClipper: Extract and Translate On-Screen Subtitles", "version": "1.0.7", "description": "Capture subtitles shown directly on videos and turn them into translatable text. Works on YouTube, Instagram, and TikTok", "permissions": ["activeTab", "storage", "sidePanel", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://www.instagram.com/*", "https://www.tiktok.com/*", "https://*.modal.run/*", "https://extensionpay.com/*", "https://huggingface.co/*", "https://*.huggingface.co/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "SubClipper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "src/popup/popup.html"}, "background": {"service_worker": "src/background/serviceWorker.js"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://www.instagram.com/*", "https://www.tiktok.com/*"], "js": ["src/content/videoCapture.js", "src/content/frameDiff.js", "src/content/ocrQueue.js", "src/content/overlay.js", "src/content/captureLoop.js", "src/content/ocrConsumer.js", "src/content/contentScript.js"], "run_at": "document_idle"}]}