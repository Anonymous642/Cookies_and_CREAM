{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grammar.Ink - AI Writing Assistant", "version": "1.0.1", "description": "AI writing assistant with grammar checking, email generation, sentiment analysis, and spam detection. Supports 11 languages.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://grammar.ink/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Grammar.Ink - AI Writing Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles.css", "icons/*"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"analyze_text": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Analyze selected text with AI"}, "generate_email": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate AI email"}, "check_sentiment": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Analyze text sentiment"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://grammar.ink https://*.replit.dev https://*.google.com;"}}