{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Humanize Autotyper: Auto Typer for Google Docs & Any Site", "version": "1.3.5", "description": "Turn your own notes, drafts, and study material into natural on-screen typing, without manually retyping everything.", "homepage_url": "https://humanizeautotyper.com", "minimum_chrome_version": "108", "permissions": ["debugger", "storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Humanize Autotyper", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "account.html", "commands": {"stop-typing": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Stop typing immediately"}, "toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Pause / resume typing"}}}