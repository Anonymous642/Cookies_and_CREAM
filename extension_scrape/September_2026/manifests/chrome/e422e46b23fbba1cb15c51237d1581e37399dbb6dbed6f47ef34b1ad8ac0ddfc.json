{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NexCRM Password Manager", "version": "0.4.0", "description": "Save, autofill, and generate logins backed by your NexCRM vault. Bitwarden-style password manager for NexCRM.", "action": {"default_popup": "popup.html", "default_title": "NexCRM Vault", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "clipboardWrite", "clipboardRead", "notifications", "tabs", "alarms", "offscreen"], "host_permissions": ["https://api.nexcrm.net/*", "http://127.0.0.1:8000/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["lib/messages.js", "lib/dom-fill.js", "lib/totp.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}