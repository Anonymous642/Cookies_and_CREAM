{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AuditFocus: WCAG Accessibility Audits", "short_name": "AuditFocus", "version": "0.1.1", "description": "One-click WCAG 2.1 AA accessibility audits. Find issues, get AI fix suggestions, export timestamped PDF reports.", "author": "Loophead Labs LLC", "homepage_url": "https://auditfocus.app", "permissions": ["activeTab", "tabs", "scripting", "sidePanel", "storage", "downloads"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://extensionpay.com/*", "https://api.extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/extpay.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Scan this page for accessibility issues", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["lib/axe.min.js"], "matches": ["<all_urls>"]}]}