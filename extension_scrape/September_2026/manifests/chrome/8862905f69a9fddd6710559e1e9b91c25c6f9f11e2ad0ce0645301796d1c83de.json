{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Session Manager Pro", "version": "2.2.0", "description": "Advanced session management with robust tab restoration, search, favorites, and export/import capabilities", "permissions": ["tabs", "storage", "sessions", "windows", "notifications", "alarms"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_title": "Session Manager Pro", "default_icon": {"16": "assets/img/timer.png", "48": "assets/img/timer.png", "128": "assets/img/timer.png"}}, "icons": {"16": "assets/img/timer.png", "48": "assets/img/timer.png", "128": "assets/img/timer.png"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"}, "web_accessible_resources": [{"resources": ["assets/img/*"], "matches": ["<all_urls>"]}], "commands": {"save-current-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-last-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last saved session"}}}