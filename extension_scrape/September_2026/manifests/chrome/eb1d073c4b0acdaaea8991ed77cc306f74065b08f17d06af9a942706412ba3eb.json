{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextFlow - Continue AI Chats Across LLMs", "version": "0.2.0", "description": "Copy AI chat context, summarize with Gemini, and continue anywhere \u2014 ChatGPT, Claude, Grok, Gemini, Perplexity.", "minimum_chrome_version": "120", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://grok.com/*", "https://x.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://deepseek.com/*", "https://chat.mistral.ai/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "action": {"default_title": "ContextFlow", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"copy-context": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Copy and summarize the current AI conversation"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://grok.com/*", "https://x.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://deepseek.com/*", "https://chat.mistral.ai/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://grok.com/*", "https://x.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://deepseek.com/*", "https://chat.mistral.ai/*"]}]}