{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sendabrief: SOP Generator & Screen Recorder", "version": "0.1.2", "description": "Turn any browser workflow into a step-by-step SOP. Click capture with screenshots and optional voice narration. No video, ever.", "permissions": ["activeTab", "tabs", "storage", "scripting", "sidePanel", "unlimitedStorage", "offscreen"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://sendabrief.com/*"]}, "background": {"service_worker": "dist/background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Sendabrief: record a walkthrough", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "web_accessible_resources": [{"resources": ["icons/mark.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle", "all_frames": true}]}