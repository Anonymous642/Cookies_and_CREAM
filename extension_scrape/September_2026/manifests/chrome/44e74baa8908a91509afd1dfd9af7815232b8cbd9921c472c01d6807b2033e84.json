{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MySamantha", "description": "Web Clipper and Audio Recorder for MySamantha Notes with AI transcription.", "version": "2.6.1", "icons": {"16": "/icon-16.png", "24": "/icon-24.png", "48": "/icon-48.png", "96": "/icon-96.png", "128": "/icon-128.png"}, "permissions": ["offscreen", "tabs", "storage", "sidePanel"], "host_permissions": ["<all_urls>"], "commands": {"trigger-meeting-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Option+Shift+R"}, "description": "Start meeting recording", "global": true}, "trigger-clipper": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Option+Shift+C"}, "description": "Activate web clipper"}, "save-full-page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Option+Shift+F"}, "description": "Save full page"}, "capture-screenshot": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Option+Shift+S"}, "description": "Capture screenshot during recording"}}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["twitter-content.js"]}, {"matches": ["*://*.zoom.us/*", "*://*.zoom.com/*", "*://meet.google.com/*", "*://teams.microsoft.com/*", "*://teams.live.com/*", "*://*.webex.com/*", "*://whereby.com/*", "*://meet.jit.si/*"], "js": ["meeting-content.js"]}, {"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["twitter-popup.html", "chunks/*", "assets/*"], "matches": ["*://twitter.com/*", "*://x.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "MySamantha", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}}