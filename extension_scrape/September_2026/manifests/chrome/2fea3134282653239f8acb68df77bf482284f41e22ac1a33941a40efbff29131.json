{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Proofpad \u2014 AI Writing Assistant", "version": "1.3.1", "description": "Free grammar, spelling and style checks on any site, done locally. Add a Google AI key to unlock AI rewrites too.", "minimum_chrome_version": "120", "permissions": ["storage", "contextMenus", "activeTab", "offscreen"], "host_permissions": ["https://generativelanguage.googleapis.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://chromewebstore.google.com/*", "https://chrome.google.com/webstore/*", "https://accounts.google.com/*"], "js": ["src/content/boot.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Proofpad", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "options_page": "src/options/options.html", "web_accessible_resources": [{"resources": ["src/content/*", "src/content/adapters/*", "src/content/decorators/*", "src/content/ui/*", "src/shared/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"accept-next": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Accept the next suggestion"}, "dismiss-current": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Dismiss the current suggestion"}}}