{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spelling Bee Tutor", "version": "0.1.2", "description": "The definition, examples, and a fun fact for every word you find in the Spelling Bee \u2014 so you learn as you play.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://spelling-bee-tutor.spellingbeetutor.workers.dev/*", "https://www.nytimes.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Spelling Bee Tutor", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.nytimes.com/puzzles/spelling-bee*"], "js": ["content-spellingbee.js"], "css": ["panel.css"], "run_at": "document_idle"}]}