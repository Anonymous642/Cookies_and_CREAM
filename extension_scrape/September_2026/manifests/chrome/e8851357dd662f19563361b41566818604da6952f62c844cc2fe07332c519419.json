{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Free Content Scraper", "version": "1.6", "description": "Scrape content from Google search results and download as text", "manifest_version": 3, "permissions": ["sidePanel", "tabs", "scripting", "activeTab", "sidePanel.open"], "host_permissions": ["https://www.google.com/*", "https://*.google.com/*", "http://localhost:5000/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Free Content Scraper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://*.google.com/search*"], "js": ["content-script.js"], "run_at": "document_idle"}], "author": "Free Content Scraper", "homepage_url": "https://github.com/FreeContentScraper", "minimum_chrome_version": "114"}