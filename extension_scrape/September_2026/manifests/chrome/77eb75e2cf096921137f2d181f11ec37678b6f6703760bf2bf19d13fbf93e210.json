{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twittervim", "version": "1.0.0", "description": "Navigate X (Twitter) using vim-style keyboard shortcuts", "action": {"default_icon": "assets/icon-512.png", "default_popup": "dist/popup/index.html"}, "options_ui": {"page": "dist/options/index.html", "open_in_tab": true}, "background": {"service_worker": "dist/background/index.mjs"}, "icons": {"16": "assets/icon-512.png", "48": "assets/icon-512.png", "128": "assets/icon-512.png"}, "permissions": ["tabs", "storage", "sidePanel"], "host_permissions": ["*://twitter.com/*", "*://x.com/*"], "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["*://twitter.com/*", "*://x.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "side_panel": {"default_path": "dist/sidepanel/index.html"}}