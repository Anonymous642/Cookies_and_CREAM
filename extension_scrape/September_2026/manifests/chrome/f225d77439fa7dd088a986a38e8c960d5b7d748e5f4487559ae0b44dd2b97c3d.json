{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Lock | App lock for websites", "description": "Your app lock, but for the web. Protect any website with a password!", "version": "2.0.1", "short_name": "weblock", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "author": "Khokon M. (khokon.dev)", "homepage_url": "https://weblock.site", "permissions": ["storage", "unlimitedStorage", "alarms", "idle"], "optional_permissions": ["tabs"], "action": {"default_title": "Web Lock"}, "options_ui": {"page": "app.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://weblock.site; font-src 'self' data:; media-src 'self' blob:"}, "web_accessible_resources": [{"resources": ["lock.html", "blocked.html"], "matches": ["<all_urls>"]}], "incognito": "split", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/gate.js"]}, {"matches": ["https://weblock.site/installed*"], "run_at": "document_start", "js": ["content-scripts/site.js"]}]}