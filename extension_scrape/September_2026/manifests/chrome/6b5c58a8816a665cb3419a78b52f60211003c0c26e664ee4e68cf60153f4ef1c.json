{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anchor chatgpt AI LLM bookmarks in Chart", "version": "3.7", "description": "Quick Search & Actions on long chats Chatgpt, gemini, AI, perplexity, AI Chat Clipper, Prompt Shortcut Manager", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "unlimitedStorage", "activeTab", "tabs", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"open_floating_app": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open Anchor App at Cursor"}, "trigger_clip_creation": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Clip Selected Text Location"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["popup.html", "styles.css", "popup.js"], "matches": ["http://*/*", "https://*/*"]}]}