{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etsy Insight AI", "version": "1.0.3", "description": "AI-powered Etsy analysis \u2014 SEO scores, keyword research, market scans and revenue estimates from public page data.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Etsy Insight AI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.etsy.com/listing/*", "https://www.etsy.com/*/listing/*", "https://www.etsy.com/search*", "https://www.etsy.com/*/search*", "https://www.etsy.com/c/*", "https://www.etsy.com/*/c/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "tabs", "activeTab", "scripting", "notifications", "sidePanel", "downloads", "alarms"], "host_permissions": ["https://www.etsy.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-32.png", "icons/icon-48.png", "icons/icon-128.png"], "matches": ["https://www.etsy.com/*"]}], "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the Etsy Insight AI dashboard"}}}