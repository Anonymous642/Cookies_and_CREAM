{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FormPilot \u2014 Smart Form Filler", "short_name": "FormPilot", "version": "1.0.0", "description": "Fill any web form instantly. Profiles, smart field detection, realistic test data, per-site rules, encryption and one-click undo.", "minimum_chrome_version": "114", "permissions": ["storage", "contextMenus", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://chrome.google.com/webstore/*", "*://chromewebstore.google.com/*"], "js": ["src/lib/utils.js", "src/lib/matchers.js", "src/lib/generator.js", "src/content/detector.js", "src/content/filler.js", "src/content/overlay.js", "src/content/content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}], "action": {"default_popup": "popup/popup.html", "default_title": "FormPilot \u2014 fill this form", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open FormPilot"}, "fill-profile": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Fill the current page with the active profile"}, "fill-random": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Fill the current page with realistic test data"}, "undo-fill": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Undo the last fill"}, "highlight-fields": {"description": "Highlight and label every detected field"}}, "web_accessible_resources": [{"resources": ["icons