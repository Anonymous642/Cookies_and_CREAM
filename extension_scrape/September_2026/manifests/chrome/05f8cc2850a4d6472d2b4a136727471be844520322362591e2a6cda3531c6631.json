{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PriceWatch - Amazon Price Tracker & Alert System", "version": "1.0.1", "description": "Track Amazon product prices and get alerts when they drop. View price history, set target prices, and save money.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "PriceWatch"}, "permissions": ["storage", "activeTab"], "externally_connectable": {"matches": ["https://notify.onlinetechbd.com/*"]}, "host_permissions": ["https://*.amazonaws.com/*"], "background": {"service_worker": "background.js"}}