{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Carly AI - Scheduling Assistant", "version": "1.2.3", "description": "Integrate Carly AI scheduling assistant into Gmail for effortless meeting coordination", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "alarms", "cookies"], "host_permissions": ["*://mail.google.com/*", "*://outlook.office.com/*", "https://calbotservice.com/*", "https://www.calbotservice.com/*", "https://carlyassistant.com/*", "https://*.carlyassistant.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content/gmail-injector.js"], "css": ["content/styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "web_accessible_resources": [{"resources": ["icons/*", "content/styles.css"], "matches": ["*://mail.google.com/*", "*://outlook.office.com/*"]}]}