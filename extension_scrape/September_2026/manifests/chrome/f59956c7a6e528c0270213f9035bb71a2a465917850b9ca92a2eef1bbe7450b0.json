{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tired Budgie", "version": "1.2.2", "description": "A micro-break reminder featuring a screaming budgie! Take breaks, manage tabs, stay productive. \ud83e\udd9c", "permissions": ["alarms", "storage", "notifications"], "commands": {"start-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Start focus timer"}, "start-break": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Start break timer"}, "pause-resume": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause/Resume timer"}, "finish-session": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Finish session"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/budgie-16.png", "32": "icons/budgie-32.png", "48": "icons/budgie-48.png", "128": "icons/budgie-128.png"}, "default_title": "Tired Budgie - Take a break!"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/budgie-16.png", "32": "icons/budgie-32.png", "48": "icons/budgie-48.png", "128": "icons/budgie-128.png"}, "web_accessible_resources": [{"resources": ["sounds/*", "images/*"], "matches": ["<all_urls>"]}]}