{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WordJumble", "version": "1.0", "description": "OPTION+J. Uses the typoglycemia effect. Jumbles the middle letters of words to help with reading.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-jumble": {"suggested_key": {"default": "Alt+J", "mac": "Alt+J"}, "description": "Toggle word jumble on/off"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}