{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RetroView", "version": "1.1", "description": "Read articles in glorious 8-bit style!", "icons": {"16": "icons/retroview-16.png", "32": "icons/retroview-32.png", "48": "icons/retroview-48.png", "64": "icons/retroview-64.png", "128": "icons/retroview-128.png", "256": "icons/retroview-256.png", "512": "icons/retroview-512.png"}, "permissions": ["scripting", "activeTab", "storage"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"open_reader": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open Reader Mode for active tab"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["Readability.js", "content.js"], "run_at": "document_idle"}]}