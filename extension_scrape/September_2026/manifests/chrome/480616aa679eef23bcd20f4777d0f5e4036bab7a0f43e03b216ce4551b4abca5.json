{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BillSensor - SaaS Billing Monitor", "version": "1.1.6", "description": "Never miss a SaaS renewal. Monitors Outlook & Gmail for billing emails. Alerts you 7 days before charges hit. 63+ tools supported.", "permissions": ["storage", "alarms", "notifications", "scripting"], "host_permissions": ["https://mail.google.com/*", "https://billsensor.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/16.png", "48": "assets/icons/48.png", "128": "assets/icons/128.png"}}, "icons": {"16": "assets/icons/16.png", "48": "assets/icons/48.png", "128": "assets/icons/128.png"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["https://billsensor.com/*"], "js": ["content/site-bridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["data/tools.json"], "matches": ["https://mail.google.com/*"]}]}