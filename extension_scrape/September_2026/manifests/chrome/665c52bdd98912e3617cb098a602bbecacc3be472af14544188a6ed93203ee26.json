{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SoonTM", "version": "1.0.0", "description": "Snooze tabs and todos until you actually need them. Everything stays local \u2014 no accounts, no tracking, no network.", "minimum_chrome_version": "109", "homepage_url": "https://github.com/itali43/soontm", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "SoonTM \u2014 snooze this tab", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "options_ui": {"page": "app.html", "open_in_tab": true}, "permissions": ["activeTab", "alarms", "storage", "notifications", "offscreen"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S"}, "description": "Open the SoonTM snooze popup"}, "repeat-last-snooze": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Repeat the last snooze on the current tab"}, "open-sleeping": {"suggested_key": {"default": "Alt+J"}, "description": "Open the Sleeping items page"}, "new-todo": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "New Todo"}}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"}}