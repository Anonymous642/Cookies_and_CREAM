{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PauseMate - YouTube Bookmarker", "version": "1.0.3", "permissions": ["tabs", "commands", "storage"], "description": "Just pause, mate.", "icons": {"16": "assets/icons/pausemate-chrex-icon.png", "32": "assets/icons/pausemate-chrex-icon.png", "48": "assets/icons/pausemate-chrex-icon.png", "128": "assets/icons/pausemate-chrex-icon.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "assets/icons/pausemate-chrex-icon.png", "32": "assets/icons/pausemate-chrex-icon.png", "48": "assets/icons/pausemate-chrex-icon.png", "128": "assets/icons/pausemate-chrex-icon.png"}}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content-script.js"]}], "web_accessible_resources": [{"resources": ["assets/pausemate-icon.png", "assets/pausemate-logo.png", "assets/pausemate-icon-padded.png", "assets/pausemate-icon-padded-red-bg.png", "sounds/ding.mp3", "sounds/success.mp3"], "matches": ["https://*.youtube.com/*"]}], "commands": {"close_tab": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Closes the current YouTube tab"}}}