{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browser Optimizer: Tab Sleeper & Site Time Tracker", "short_name": "Browser Optimizer", "version": "2.0.1", "description": "Sleep or close tabs you stopped using, get warned when a site hogs CPU or memory, and see where your browsing time goes.", "permissions": ["tabs", "storage", "idle", "alarms", "notifications", "scripting", "system.memory"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Browser Optimizer", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["monitor.js"], "run_at": "document_start"}], "options_page": "options.html"}