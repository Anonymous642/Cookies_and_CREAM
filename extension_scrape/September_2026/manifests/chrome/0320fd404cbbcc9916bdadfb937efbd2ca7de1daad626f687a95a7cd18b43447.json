{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Forgetwell", "description": "Save pages to Forgetwell and recall them by searching \u2014 a bookmark replacement built on your second memory.", "version": "0.1.0", "homepage_url": "https://forgetwell.com", "action": {"default_popup": "src/popup/popup.html", "default_title": "Save to Forgetwell"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_page": "src/options/options.html", "permissions": ["activeTab", "scripting", "storage", "bookmarks", "identity"], "host_permissions": ["https://forgetwell.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "omnibox": {"keyword": "fw"}, "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current page to Forgetwell"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}