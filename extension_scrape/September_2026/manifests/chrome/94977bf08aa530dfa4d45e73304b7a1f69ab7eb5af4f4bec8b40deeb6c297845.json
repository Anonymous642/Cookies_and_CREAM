{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Doodle Memo \u2014 Page Overlay Notes", "version": "0.1.1", "description": "Draw, annotate, and leave notes directly on web pages. Auto-saves per URL and restores on revisit.", "action": {"default_title": "Doodle Memo", "default_popup": "src/popup.html"}, "permissions": ["storage", "downloads"], "background": {"service_worker": "src/background.js"}, "commands": {"toggle-doodle": {"suggested_key": {"default": "Alt+D"}, "description": "Toggle Doodle Memo overlay"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "icons": {"16": "src/icons/icon16.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}}