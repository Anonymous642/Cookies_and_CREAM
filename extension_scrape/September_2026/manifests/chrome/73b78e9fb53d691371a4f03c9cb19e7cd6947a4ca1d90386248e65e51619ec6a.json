{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlogLift - SEO & Internal Links for Blogger", "description": "Analyze Blogger posts, suggest internal links, find broken links and images, and run a pre-publish checklist locally.", "version": "0.1.0", "short_name": "BlogLift", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "116", "default_locale": "en", "permissions": ["storage", "sidePanel", "alarms"], "host_permissions": ["https://www.blogger.com/*", "https://*.blogspot.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "BlogLift"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; style-src 'self' 'unsafe-inline';"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://*.blogspot.com/*", "https://www.blogger.com/*"], "run_at": "document_idle", "js": ["content-scripts/blogger.js"]}]}