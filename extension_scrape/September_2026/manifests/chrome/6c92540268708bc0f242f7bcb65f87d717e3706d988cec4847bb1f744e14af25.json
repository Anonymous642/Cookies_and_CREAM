{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rosetta for Intune", "version": "1.1.1", "description": "Translate cryptic Windows build numbers in the Intune console into clear labels like 11-25H2-Jul2026.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://learn.microsoft.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Rosetta for Intune", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://intune.microsoft.com/*", "https://endpoint.microsoft.com/*", "https://portal.azure.com/*", "https://*.hosting.portal.azure.net/*", "https://hosting.portal.azure.net/*", "https://*.portal.azure.net/*", "https://*.msftcloudes.com/*", "https://*.microsoft.com/*"], "js": ["src/versions.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}]}