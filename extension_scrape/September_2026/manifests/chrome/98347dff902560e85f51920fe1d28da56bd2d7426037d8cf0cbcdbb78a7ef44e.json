{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PagePI - Edit, Summarize & Annotate", "version": "1.1.0", "description": "Edit any webpage, summarize content locally, copy images, highlight text, reader mode, dark mode, and more - all locally and free", "permissions": ["activeTab", "storage", "contextMenus", "downloads", "clipboardWrite", "clipboardRead", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "PagePI", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "commands": {"toggle-edit-mode": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle Edit Mode"}, "summarize-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize Page"}, "highlight-selection": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Highlight Selected Text"}, "increase-font": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Increase Font Size"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["lib/*", "styles.css"], "matches": ["<all_urls>"]}]}