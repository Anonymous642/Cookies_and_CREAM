{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SIPERB - Browser Softphone", "short_name": "Siperb", "description": "Siperb is a SIP to WebRTC Proxy, allowing you to make and receive calls from your PBX (like Asterisk) to your web browser.", "version": "2.0.1", "author": "Conrad de Wet", "homepage_url": "https://www.siperb.com", "permissions": ["sidePanel", "declarativeNetRequest", "contentSettings", "contextMenus", "storage"], "host_permissions": ["https://www.siperb.com/*"], "background": {"service_worker": "js/serviceworker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/clickToDial.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["js/clickToDialBridge.js"], "run_at": "document_idle", "world": "MAIN"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules/strip_frame_headers.json"}]}, "side_panel": {"default_path": "index.html"}, "action": {"default_title": "Siperb Phone"}, "icons": {"16": "images/Logo_16.png", "32": "images/Logo_32.png", "48": "images/Logo_48.png", "128": "images/Logo_128.png"}}