{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeNarrator", "version": "1.0", "description": "This extension reads code on web pages and generates beginner-friendly pseudo code.", "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.github.com/*"], "js": ["contentScript.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}