{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scrap Book - PDF Collector for AI & Research", "version": "1.0.1", "description": "Collect and organize web pages as PDFs, then merge them for AI language models (ChatGPT, Claude, Gemini).", "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads", "sidePanel", "debugger", "offscreen"], "action": {"default_popup": "popup/popup.html", "default_title": "Scrap Book - Collect web pages as PDFs for AI"}, "side_panel": {"default_path": "sidebar/sidebar.html"}, "background": {"service_worker": "background/background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["background/lib/pdf-lib.min.js", "background/storage-manager.js", "offscreen/offscreen.html", "offscreen/offscreen.js"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"]}