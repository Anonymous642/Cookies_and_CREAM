{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI JobScraper", "version": "1.0", "description": "Extract job listings from LinkedIn, Upwork and other job boards with ease", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_title": "AI JobScraper", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*.upwork.com/*", "*://*.indeed.com/*", "*://*.glassdoor.com/*", "*://*.monster.com/*", "*://*.ziprecruiter.com/*", "*://*.simplyhired.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}