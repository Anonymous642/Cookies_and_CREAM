{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flowly - Task Manager & Time Tracker", "description": "Quick-add tasks with natural language, run timers, and stay focused \u2014 all from your browser.", "version": "0.1.8", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["sidePanel", "storage", "activeTab", "contextMenus", "notifications", "alarms", "idle"], "host_permissions": ["https://api.flowly.run/*"], "externally_connectable": {"matches": ["https://flowly.run/*"]}, "action": {"default_title": "Flowly", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"quick-add": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Quick-add a Flowly task"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the Flowly side panel"}}, "omnibox": {"keyword": "fl"}, "background": {"service_worker": "background.js"}}