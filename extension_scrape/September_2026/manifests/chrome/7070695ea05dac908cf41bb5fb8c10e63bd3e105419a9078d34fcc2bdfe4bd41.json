{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shades - Secure Input", "description": "Mask sensitive input on web pages.", "version": "0.0.0.2", "short_name": "Shades", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "action": {"default_title": "Shades - Secure Input", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_popup": "popup.html"}, "commands": {"toggle-protection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Enable or disable Shades protection"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/content.js"]}]}