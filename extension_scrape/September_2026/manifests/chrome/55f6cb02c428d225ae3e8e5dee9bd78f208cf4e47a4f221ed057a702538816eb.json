{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubChat Prime: Highlight to Ask AI", "version": "5.2.0", "description": "Floating AI assistant for any webpage. Chat seamlessly using your logged-in Claude or ChatGPT sessions. Zero API keys needed.", "permissions": ["storage", "unlimitedStorage", "activeTab", "contextMenus", "scripting", "tabs"], "host_permissions": ["<all_urls>", "https://claude.ai/*", "https://gemini.google.com/*", "https://chatgpt.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://api.deepseek.com/*", "https://test.dodopayments.com/*", "https://live.dodopayments.com/*", "https://api.dodopayments.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SubChat Prime Dashboard"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}], "commands": {"toggle-subchat": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+S"}, "description": "Trigger SubChat on current selection"}}}