{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No More Load", "version": "1.0.0", "description": "No More Load automatically loads all comments on GitHub issues and pull requests \u2014 no more clicking 'Load more'.", "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "index.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}