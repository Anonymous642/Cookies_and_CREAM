{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Subtitle Translator for YouTube", "version": "2.5", "description": "It detects English subtitles on YouTube and automatically translates them into your chosen language.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["languages.js", "content.js"]}]}