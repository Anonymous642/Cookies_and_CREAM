{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Usage Tracker for Claude.ai", "version": "3.1.0", "description": "See your Claude.ai usage, limits & reset timers in a sleek overlay. Never switch tabs again. Not affiliated with Anthropic.", "permissions": ["storage", "alarms", "tabs", "scripting"], "host_permissions": ["https://claude.ai/*"], "background": {"service_worker": "bg.js"}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["widget.js"], "css": ["widget.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "options_page": "options.html", "commands": {"toggle-widget": {"suggested_key": {"default": "Alt+U", "mac": "Alt+U"}, "description": "Toggle Usage Tracker widget"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}