{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabNotes: Per-Tab Notepad for Productivity", "version": "1.0.0", "description": "Take notes tied to each browser tab. Perfect for remote work, study, and freelancing.", "icons": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup-modern.html", "default_icon": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}}, "background": {"service_worker": "background-modern.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}