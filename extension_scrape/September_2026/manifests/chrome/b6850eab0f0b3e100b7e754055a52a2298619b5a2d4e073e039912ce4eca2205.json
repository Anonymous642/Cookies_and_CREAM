{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feedback", "version": "1.0.2", "description": "It solves the common problem of losing your Youtube feed due to accidental page refreshes or tab reloads.", "permissions": ["activeTab", "webNavigation", "scripting", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "Feedback"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}