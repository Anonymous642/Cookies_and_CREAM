{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Last.fm Artwork Upload Helper", "version": "1.2.8", "description": "Streamlines the process of uploading album artwork to Last.fm with visual missing artwork detection", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.last.fm/*", "https://covers.musichoarders.xyz/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Last.fm Artwork Upload Helper", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.last.fm/*", "https://covers.musichoarders.xyz/*"]}]}