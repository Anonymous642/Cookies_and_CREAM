{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabScribe \u2014 Research OS for the Web", "short_name": "TabScribe", "description": "Highlight \u2192 Summarize \u2192 Translate \u2192 Rewrite \u2192 Cite. A privacy-first research side panel powered by Chrome's built-in AI.", "version": "0.9.0", "version_name": "Beta 0.9 (Chrome AI + Offline)", "minimum_chrome_version": "138", "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.openalex.org/*", "https://api.crossref.org/*"], "action": {"default_title": "Open TabScribe Side Panel", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "background": {"service_worker": "service_worker.js", "type": "module"}, "options_page": "options.html", "commands": {"save-selection": {"suggested_key": {"default": "Alt+S"}, "description": "Save current selection to TabScribe"}}, "side_panel": {"default_path": "sidebar.html"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*", "file://*/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["sidebar.html", "styles.css"], "matches": ["https://*/*", "http://*/*", "file://*/*"]}], "homepage_url": "https://github.com/Accidental-MVP/TabScribe"}