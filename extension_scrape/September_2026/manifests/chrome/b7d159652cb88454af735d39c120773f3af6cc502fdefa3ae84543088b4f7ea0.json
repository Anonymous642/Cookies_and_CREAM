{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SoundBooster \u2014 Sound & Volume Booster", "short_name": "SoundBooster", "version": "1.0.0", "description": "Make any Chrome tab up to 600% louder without distortion, with a bass booster, 5-band equalizer and per-tab volume.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "SoundBooster", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["tabCapture", "offscreen", "storage", "activeTab"], "commands": {"volume-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase tab volume by 25%"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease tab volume by 25%"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute or unmute the boosted tab"}, "reset-volume": {"suggested_key": {"default": "Alt+Shift+0"}, "description": "Reset tab volume to 100%"}}, "externally_connectable": {"matches": ["https://soundboost.com/*", "https://*.soundboost.com/*"]}}