{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabs in Vertical", "version": "1.0", "description": "Displays all open tabs in a vertical sidebar for better readability", "permissions": ["tabs", "storage", "sidePanel", "tabGroups"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidebar.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Toggle Vertical Side Tabs"}}, "web_accessible_resources": [{"resources": ["sidebar.html", "styles.css", "sidebar.js", "icons/default-favicon.svg"], "matches": ["<all_urls>"]}]}