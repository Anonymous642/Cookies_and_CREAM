{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecipeRip", "version": "1.0.1", "description": "RecipeRip extracts recipe details (ingredients, steps, macros) from web pages using AI.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["https://reciperip.com/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}