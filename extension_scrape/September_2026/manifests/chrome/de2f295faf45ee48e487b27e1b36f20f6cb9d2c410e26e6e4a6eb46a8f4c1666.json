{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clippy", "version": "1.0.0", "description": "Intelligently adds a copy-to-clipboard button near every input field on any webpage", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CopyClip", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content-script.js"], "all_frames": true, "run_at": "document_idle"}]}