{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subslator - Selective Subtitle Translator", "description": "Translate hovered subtitle words or phrases instantly on YouTube, Netflix and Udemy. No Tab Switching, No Interruptions!", "version": "1.2.1", "permissions": ["storage", "scripting", "tabs", "commands"], "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://www.udemy.com/*", "https://app.subslator.com/*", "https://*.subslator.com/*", "https://subslator.com/*", "https://translate.googleapis.com/*", "https://api.dictionaryapi.dev/*"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "icons": {"16": "assets/subslator-logo.png", "32": "assets/subslator-logo.png", "48": "assets/subslator-logo.png", "128": "assets/subslator-logo.png"}, "action": {"default_title": "Subslator", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/subslator-logo.png", "32": "assets/subslator-logo.png", "48": "assets/subslator-logo.png", "128": "assets/subslator-logo.png"}}, "web_accessible_resources": [{"resources": ["src/**/*.js", "src/config.js", "assets/*.svg", "assets/*.png"], "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://www.udemy.com/*", "https://app.subslator.com/*", "https://*.subslator.com/*", "https://subslator.com/*"]}], "commands": {"toggle-selection-mode": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle subtitle selection mode"}}}