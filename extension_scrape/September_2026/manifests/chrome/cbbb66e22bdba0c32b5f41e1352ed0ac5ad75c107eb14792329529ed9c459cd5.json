{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ILoveSnapshots - Full Page Beautiful Screenshots", "description": "Capture beautiful full page screenshots of any website instantly. One click, aesthetic backgrounds, 4K quality and editing tools", "version": "1.1.1", "short_name": "ILoveSnapshots", "icons": {"16": "/icon/icon16.png", "32": "/icon/icon32.png", "48": "/icon/icon48.png", "64": "/icon/icon64.png", "96": "/icon/96.png", "128": "/icon/icon128.png"}, "permissions": ["activeTab", "storage", "scripting", "notifications"], "host_permissions": ["https://www.ilovesnapshots.online/*"], "action": {"default_title": "ILoveSnapshots - Screenshot & Text Capture", "default_popup": "popup.html"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture visible area screenshot"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture full page screenshot"}, "toggle-copy-capture": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Alt+Shift+J"}, "description": "Toggle copy capture mode"}, "toggle-copy-selection": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Toggle copy selection mode"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.ilovesnapshots.online/*"], "js": ["content-scripts/auth.js"]}, {"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}