{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Image Quarry \u2014 Extract, Convert & Snip", "short_name": "Image Quarry", "version": "1.0.0", "description": "Extract every image on a page, convert between 40+ formats, compress to an exact file size, and snip the screen like a pro.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs", "webRequest", "clipboardWrite", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Image Quarry", "default_popup": "src/popup/popup.html", "default_icon": {"16": "src/assets/icon16.png", "32": "src/assets/icon32.png", "48": "src/assets/icon48.png", "128": "src/assets/icon128.png"}}, "icons": {"16": "src/assets/icon16.png", "32": "src/assets/icon32.png", "48": "src/assets/icon48.png", "128": "src/assets/icon128.png"}, "commands": {"open-gallery": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Extract images from the current page"}, "snip-rectangle": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Rectangular snip"}, "snip-freeform": {"description": "Free-form snip"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/collector.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}], "web_accessible_resources": [{"resources": ["src/content/snipper.css", "src/gallery/gallery.html", "src/editor/editor.html", "src/lib/*", "src/assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "author": "Souvik Dey"}