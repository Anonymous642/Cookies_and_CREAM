{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Substack Chat Exporter by Stackscraper", "version": "1.5.3", "description": "Export Substack chat threads, replies, and sub-replies from the current page to JSON, CSV, or Markdown.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "unlimitedStorage", "identity", "downloads", "notifications", "offscreen"], "host_permissions": ["*://*.substack.com/*", "*://substack.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.substack.com/*", "*://substack.com/*"], "js": ["content.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}}