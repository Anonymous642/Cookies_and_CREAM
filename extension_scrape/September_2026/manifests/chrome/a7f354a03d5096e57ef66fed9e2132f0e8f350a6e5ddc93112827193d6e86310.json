{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobOS \u00b7 Save to JobOS", "version": "0.4.5", "description": "Save LinkedIn and Indeed jobs into your JobOS workspace with one click.", "permissions": ["storage", "alarms"], "host_permissions": ["https://api.findjobos.com/*", "https://app.findjobos.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "JobOS", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin-jobs.js"], "css": ["content/inject.css"], "run_at": "document_idle"}, {"matches": ["https://*.indeed.com/viewjob*", "https://*.indeed.com/jobs*", "https://*.indeed.com/q-*", "https://*.indeed.com/cmp/*/jobs*"], "js": ["content/indeed-jobs.js"], "css": ["content/inject.css"], "run_at": "document_idle"}, {"matches": ["https://app.findjobos.com/*"], "js": ["content/jobos-marker.js"], "run_at": "document_start"}]}