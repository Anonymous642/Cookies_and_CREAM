{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuizQueue", "version": "1.0.0", "description": "Queue up your daily quizzes into playlists and blast through them \u2014 auto-advance, keybinds, and a discover feed.", "minimum_chrome_version": "120", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "QuizQueue"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"next-quiz": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Go to the next quiz"}, "skip-quiz": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Skip this quiz"}, "cancel-countdown": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Cancel the auto-advance countdown"}, "add-current-page": {"description": "Add the current page to the active list"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}}}, "permissions": ["storage", "tabs", "bookmarks", "scripting", "contextMenus", "webRequest"], "host_permissions": ["<all_urls>"]}