{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatShield - AI Data Leak Protection", "version": "0.1.3", "description": "Stop sensitive data leaks to ChatGPT, Claude & Gemini. Detects API keys, SSNs, emails before sending. 100% local, zero tracking.", "permissions": ["storage"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["src/ui/icons/icons.js", "src/detection/patterns.js", "src/content.js"], "css": ["src/ui/warning-modal.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ChatShield"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/ui/*", "src/prosemirror-bridge.js"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}]}