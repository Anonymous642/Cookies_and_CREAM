{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yet Another Data Cleaner", "description": "Clean per-site browser data (cookies, localStorage, IndexedDB, cache, service workers, and more) for the current tab.", "version": "1.0.0", "icons": {"16": "icon-cleaner/16.png", "32": "icon-cleaner/32.png", "48": "icon-cleaner/48.png", "96": "icon-cleaner/96.png", "128": "icon-cleaner/128.png"}, "permissions": ["activeTab", "browsingData", "cookies", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Yet Another Data Cleaner", "default_popup": "popup.html"}}