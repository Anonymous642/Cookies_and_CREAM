{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cerberus SSO", "version": "1.0.1", "description": "Automatically fills application login credentials from the Cerberus SSO vault via the desktop agent and captures login-page fields.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["nativeMessaging", "tabs", "alarms", "scripting", "storage"], "host_permissions": ["http://127.0.0.1/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"esso-capture": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Capture this page's login fields for the ESSO console"}}}