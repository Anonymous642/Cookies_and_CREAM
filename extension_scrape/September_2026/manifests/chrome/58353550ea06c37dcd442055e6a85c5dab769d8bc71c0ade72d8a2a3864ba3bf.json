{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Safe", "version": "1.0.1", "description": "Chrome extension to safely capture and export prompt content from textarea elements", "icons": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "permissions": ["activeTab", "scripting", "notifications", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_title": "Prompt Safe - Capture Prompts", "default_icon": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"start-element-picker": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Start element picker to select custom input elements"}}}