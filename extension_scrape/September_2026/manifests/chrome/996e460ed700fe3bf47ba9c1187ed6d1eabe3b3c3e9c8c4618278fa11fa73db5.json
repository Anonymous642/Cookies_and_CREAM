{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AssetGrab: SVG & Image Downloader", "short_name": "AssetGrab", "version": "0.1.0", "description": "Instantly discover, preview, and bulk-download SVGs, images, and background assets from any webpage with a single click.", "action": {"default_title": "Scan assets", "default_popup": "src/popup/index.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "permissions": ["activeTab", "downloads", "storage", "scripting", "clipboardWrite"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}