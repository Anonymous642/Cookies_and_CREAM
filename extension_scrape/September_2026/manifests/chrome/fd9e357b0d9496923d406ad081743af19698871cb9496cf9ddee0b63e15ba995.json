{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SeeVee - AI Job Search Assistant", "version": "1.0.1", "description": "Your AI-powered job search companion. Capture jobs, track hiring contacts, manage campaigns, and land your dream role.", "permissions": ["storage", "activeTab", "sidePanel", "tabs", "webNavigation"], "host_permissions": ["https://api.openai.com/*", "https://www.wellfound.com/*", "https://wellfound.com/*", "https://angel.co/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "action": {"default_title": "Open SeeVee", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}}, "side_panel": {"default_path": "index.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://backend-extension-staging.up.railway.app/*", "https://wellfound.com/jobs*", "https://www.wellfound.com/jobs*", "https://wellfound.com/company/*/jobs*", "https://www.wellfound.com/company/*/jobs*", "https://angel.co/*", "https://www.linkedin.com/*", "https://linkedin.com/*", "https://api.apollo.io/*"], "js": ["extractors.js", "content.js"], "run_at": "document_idle"}]}