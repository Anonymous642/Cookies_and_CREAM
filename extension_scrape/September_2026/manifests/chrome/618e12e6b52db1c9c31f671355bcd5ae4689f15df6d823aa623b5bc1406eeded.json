{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipflow Recorder", "version": "1.0.0", "description": "Record screen, microphone, clicks, and page context for Clipflow workflow videos and guides.", "action": {"default_title": "Clipflow Recorder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "offscreen", "activeTab", "scripting", "tabCapture", "desktopCapture"], "host_permissions": ["https://www.clipflow.chat/*", "https://clipflow.chat/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "commands": {"clipflow-stop-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Stop recording"}}, "content_scripts": [{"matches": ["https://www.clipflow.chat/*", "https://clipflow.chat/*"], "js": ["content-script.js"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js", "mic-permission.html", "mic-permission.js"], "matches": ["https://www.clipflow.chat/*", "https://clipflow.chat/*"]}]}