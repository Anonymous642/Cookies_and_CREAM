{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Toggle - Reference Tab", "version": "1.4.3", "description": "Quickly toggle between your current tab and a saved reference tab with a hotkey.", "permissions": ["tabs", "storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tab Toggle", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"set_reference": {"suggested_key": {"default": "Alt+Y", "mac": "Alt+Y"}, "description": "Set current tab as reference"}, "toggle_tab": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Toggle to reference tab"}}}