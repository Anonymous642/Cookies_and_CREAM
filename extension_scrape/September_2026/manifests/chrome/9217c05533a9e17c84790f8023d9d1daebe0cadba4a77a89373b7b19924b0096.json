{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shopify Dark Mode", "version": "1.0.0", "description": "Use this extension to enable Dark Mode on Shopify for a smoother, eye-friendly experience", "permissions": ["storage", "notifications", "scripting", "activeTab"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.shopify.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_icon": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}}, "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "web_accessible_resources": [{"resources": ["styles/darkmode.css", "images/icon.png"], "matches": ["https://*.shopify.com/*"]}]}