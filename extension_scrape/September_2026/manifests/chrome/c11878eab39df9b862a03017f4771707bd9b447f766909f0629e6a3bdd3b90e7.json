{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabitt \u2014 Tab Snapshots & Restore", "version": "1.3.0", "description": "Automatic snapshots of your open tabs and windows, so a crash never costs you your session.", "minimum_chrome_version": "117", "icons": {"16": "img/icon-16.png", "32": "img/icon-32.png", "48": "img/icon-48.png", "128": "img/icon-128.png"}, "action": {"default_title": "Tabitt", "default_popup": "popup.html", "default_icon": {"16": "img/icon-16.png", "32": "img/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["tabs", "tabGroups", "storage", "alarms", "favicon"], "optional_permissions": ["sessions"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Tabitt"}, "snapshot-now": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Take a snapshot now"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}