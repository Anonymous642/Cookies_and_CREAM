{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quiet: Hide YouTube Shorts & Distractions", "short_name": "Quiet", "version": "1.1.1", "description": "Hide YouTube Shorts, recommendations, the homepage feed and comments. Use YouTube without YouTube using you.", "homepage_url": "https://www.letsgetquiet.com", "permissions": ["storage", "alarms"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-quiet": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Toggle Quiet on/off"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "externally_connectable": {"matches": ["https://*.letsgetquiet.com/*"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}