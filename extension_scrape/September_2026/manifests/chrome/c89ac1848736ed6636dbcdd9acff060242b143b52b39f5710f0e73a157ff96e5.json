{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PopTitle: Subtitle Highlighter", "version": "0.5", "description": "Master GRE words & JLPT grammar while watching Netflix & YouTube. Auto-highlights keywords with instant translation popup.", "permissions": ["storage"], "host_permissions": ["https://www.netflix.com/*", "https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Highlight Subtitles", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://www.youtube.com/*"], "js": ["grammar_patterns.js", "content.js"], "run_at": "document_idle"}]}