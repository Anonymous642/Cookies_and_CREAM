{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IngageAi", "version": "1.0.0", "description": "Generate high-quality LinkedIn comments and reposts with AI.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "sidePanel"], "host_permissions": ["https://*.linkedin.com/*", "https://linkedin-ai-engagement-assistant.onrender.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "css": ["content-styles.css"]}], "action": {"default_popup": "popup.html", "default_icon": "icon128.png"}, "side_panel": {"default_path": "panel.html"}, "web_accessible_resources": [{"resources": ["panel.html", "panel.js", "styles.css"], "matches": ["https://*.linkedin.com/*"]}]}