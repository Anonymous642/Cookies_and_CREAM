{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedClean", "version": "1.0.0", "description": "Simplify LinkedIn posts using AI for better readability and engagement", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.linkedin.com/*", "https://api-inference.huggingface.co/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["src/scripts/content.js"], "css": ["src/styles/content.css"]}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["src/styles/content.css", "src/scripts/content.js", "src/popup/popup.js", "src/popup/popup.html", "PRIVACY.md"], "matches": ["https://*.linkedin.com/*"]}], "offline_enabled": true, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle post simplification"}, "simplify_current": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Simplify current post"}}, "minimum_chrome_version": "88", "author": "LAB-00", "homepage_url": "https://github.com/yourusername/linkedin-post-simplifier", "incognito": "split"}