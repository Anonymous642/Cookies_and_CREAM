{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dial-Up Mode", "version": "1.0.0", "description": "Reclaim your focus by emulating the intentionality of the dial-up era. Batch your emails and escape the constant inbox noise.", "author": "David Lozano Lucas", "homepage_url": "https://blog.davidlozanolucas.com", "icons": {"16": "icon16-min.png", "48": "icon48-min.png", "128": "icon128-min.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.google.com/*", "*://mail.google.com/*", "*://accounts.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Dial-Up Mode"}}