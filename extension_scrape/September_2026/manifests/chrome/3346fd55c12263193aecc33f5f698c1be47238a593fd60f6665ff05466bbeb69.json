{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "To-Do Bookmark Bar - Manage your bookmarks bar like a to-do list", "short_name": "To-Do Bookmark Bar", "minimum_chrome_version": "114", "version": "1.3", "description": "Manage your bookmarks bar like a to-do list", "permissions": ["tabs", "bookmarks", "storage", "sidePanel", "contextMenus", "notifications", "alarms", "tabGroups"], "background": {"service_worker": "background.js"}, "action": {"default_title": "To-do bar", "default_icon": {"16": "icons/to-do-bar.png", "48": "icons/to-do-bar.png", "128": "icons/to-do-bar.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-side-panel": {"suggested_key": {"default": "Alt+Shift+1", "mac": "Alt+Shift+1"}, "description": "Open/Close the side panel"}, "add-current-tab-to-task": {"suggested_key": {"default": "Alt+Shift+2", "mac": "Alt+Shift+2"}, "description": "Add the active tab as a task"}}, "icons": {"16": "icons/to-do-bar.png", "48": "icons/to-do-bar.png", "128": "icons/to-do-bar.png"}}