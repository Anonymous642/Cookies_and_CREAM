{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatrHub Call Control", "description": "Call control for ChatrHub. Designed to be used alongside the ChatrHub local recorder to manage, monitor, and control active calls.", "version": "3.0.4", "icons": {"48": "images/logo_48x48.png"}, "action": {"default_title": "ChatrHub", "default_popup": "popup/popup.html", "default_icon": {"48": "images/logo_48x48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "scripting", "alarms", "cookies", "notifications"], "host_permissions": ["<all_urls>", "https://na1-api.chatrhub.com/*", "https://sandbox-api.chatrhub.com/*", "http://localhost:8003/*", "https://na1.chatrhub.com/*", "https://sandbox.chatrhub.com/*", "http://localhost/*"], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["bootstrap.js"], "run_at": "document_idle"}], "options_page": "options/options.html"}