{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Don't Spoil Me", "version": "0.1.0", "description": "Hide YouTube's duration, timeline, thumbnails and titles, so nothing on the page spoils what happens in a video.", "minimum_chrome_version": "88", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "css": ["src/hide.css"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": false}], "background": {"service_worker": "src/background.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Don't Spoil Me", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}