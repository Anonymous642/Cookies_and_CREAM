{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Digital Authenticator", "short_name": "Digital Auth", "version": "1.0.1", "description": "Fox Portal passwords and 2FA codes \u2014 autofill, auto-save and authenticator codes in your browser.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Digital Authenticator", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["storage", "alarms", "tabs", "clipboardWrite", "offscreen"], "host_permissions": ["https://digitalfoxportal.space/*"], "content_scripts": [{"matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-32.png"], "matches": ["<all_urls>"]}], "commands": {"fill-login": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Fill a saved login on this page"}}, "background": {"service_worker": "background.js"}, "minimum_chrome_version": "116"}