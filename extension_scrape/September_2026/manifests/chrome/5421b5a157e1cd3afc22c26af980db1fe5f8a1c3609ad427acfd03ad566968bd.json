{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ListLabs Helper", "version": "2.0.0", "description": "Keepa Product Finder autofill, eBay order buttons, and Amazon address fill for ListLabs dropshipping workflow.", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://keepa.com/*", "https://www.ebay.com/*", "https://www.amazon.com/*"], "action": {"default_popup": "popup.html", "default_title": "ListLabs Helper", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://www.ebay.com/*"], "js": ["ebay-content.js"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.com/*"], "js": ["amazon-content.js"], "run_at": "document_idle", "all_frames": true}]}