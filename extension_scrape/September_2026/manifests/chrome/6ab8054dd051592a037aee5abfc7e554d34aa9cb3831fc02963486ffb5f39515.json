{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GRate Price Switcher", "version": "1.3", "description": "Shows prices in your currency right on the page \u2014 at Google rate, without breaking stores.", "permissions": ["activeTab", "storage", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "GRate Price Switcher"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["rules.js", "content.js"], "run_at": "document_end"}], "commands": {"toggle-conversion": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Toggle price conversion on this page"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}