{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Price Tracker - DealUpdates", "short_name": "DealUpdates", "description": "DealUpdates tracks prices on Amazon and sends price drop alerts. Bookmark any product and know when to buy.", "version": "1.3.1", "homepage_url": "https://dealupdates.com", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://www.amazon.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*"], "js": ["content.js"]}, {"matches": ["https://dealupdates.com/auth/extension-token*"], "js": ["extension-auth.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "fonts/*"], "matches": ["https://www.amazon.com/*"]}]}