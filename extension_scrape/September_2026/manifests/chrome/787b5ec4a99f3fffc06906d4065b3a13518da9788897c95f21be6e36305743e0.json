{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Telegram Web Translator", "version": "0.4.6", "description": "Traduz mensagens do Telegram Web usando a API translator.dinbot.com.br.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://web.telegram.org/*", "https://translator.dinbot.com.br/*"], "action": {"default_title": "Telegram Web Translator", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}