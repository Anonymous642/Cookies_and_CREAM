{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QubeGst \u2014 GST Downloader", "description": "Download your GST returns from gst.gov.in locally \u2014 uses your own logged-in session, never your password or OTP.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "downloads", "declarativeNetRequest"], "host_permissions": ["https://*.gst.gov.in/*"], "web_accessible_resources": [{"resources": ["gst-portal-main.js"], "matches": ["*://*.gst.gov.in/*"]}], "declarative_net_request": {"rule_resources": [{"id": "gst", "enabled": true, "path": "gst-dnr-rules.json"}]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "QubeGst \u2014 GST Downloader", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.gst.gov.in/*"], "js": ["content-scripts/gst-portal.js"]}]}