{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "vosso - Screen Recorder with Auto Zoom", "description": "Screen recorder with auto zoom \u2014 record a tab, get a polished video, and edit it free in your browser.", "version": "1.10.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://vos.so/recorder", "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "system.display"], "optional_host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["handoff-frame.html"], "matches": ["*://vos.so/*", "*://*.vos.so/*", "*://localhost/*"]}], "action": {"default_title": "vosso Recorder"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start / stop recording"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.vos.so/*", "*://localhost/*", "*://vos.so/*"], "run_at": "document_idle", "js": ["content-scripts/handoff.js"]}]}