{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mocku Shot", "description": "Capture your tab and turn it into a polished product shot in seconds.", "version": "0.2.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Mocku Shot", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/serviceWorker.js", "type": "module"}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture screenshot and open Mocku Shot editor"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop Mocku Shot recording"}, "toggle-demo-recording": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Start or stop Mocku Shot demo recording"}}, "permissions": ["activeTab", "tabCapture", "offscreen", "downloads", "scripting", "storage"]}