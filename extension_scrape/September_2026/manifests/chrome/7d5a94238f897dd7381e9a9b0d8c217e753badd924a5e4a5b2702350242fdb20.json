{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trajectory \u2014 LinkedIn Job Grabber", "version": "1.0.1", "description": "Send the LinkedIn job you are viewing to Trajectory for a bridge score. No scraping - reads only the open page.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.linkedin.com/*"], "action": {"default_popup": "popup.html", "default_title": "Trajectory \u2014 grab this job"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*", "https://*.linkedin.com/jobs/view/*"], "js": ["content.js"], "run_at": "document_idle"}]}