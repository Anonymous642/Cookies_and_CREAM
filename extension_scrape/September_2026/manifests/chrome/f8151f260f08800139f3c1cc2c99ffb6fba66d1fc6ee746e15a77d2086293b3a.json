{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NugIt \u2014 Save & Find Your AI Answers", "version": "0.2.3", "description": "Save answers from ChatGPT, Claude, Gemini and Perplexity in one searchable library\u2014and find them when you need them.", "minimum_chrome_version": "120", "permissions": ["contextMenus", "activeTab", "storage", "identity", "scripting"], "background": {"service_worker": "background.mjs", "type": "module"}, "action": {"default_title": "NugIt", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "optional_host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*"], "commands": {"save-selection": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Preview selected text in NugIt"}}, "options_ui": {"page": "sites.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["https://nugit.ai/*"]}