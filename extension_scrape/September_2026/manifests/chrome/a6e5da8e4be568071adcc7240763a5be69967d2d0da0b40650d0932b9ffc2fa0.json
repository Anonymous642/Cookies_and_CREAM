{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "background": {"service_worker": "background.js"}, "name": "Optiflux", "version": "1.1.0", "description": "Fetches posts from LinkedIn profile activity feed, filters them based on user criteria, and exports the results in CSV format", "permissions": ["clipboardWrite", "activeTab", "scripting", "tabs"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "author": "Optistreams", "homepage_url": "https://optiflux-api.optistreams.co", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*/recent-activity/*"], "js": ["Optiflux.js"], "run_at": "document_end"}]}