{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yogo Organizer", "version": "1.0.1", "description": "Find everything on one topic in your YouTube history or playlists, review every match, then delete it or file it into a playlist.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://myactivity.google.com/*", "https://www.youtube.com/playlist*", "https://www.youtube.com/feed/playlists*", "https://www.youtube.com/feed/history*", "https://www.youtube.com/watch*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Yogo Organizer", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "dashboard/dashboard.html", "open_in_tab": true}, "background": {"service_worker": "worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://myactivity.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/playlist*", "https://www.youtube.com/feed/playlists*"], "js": ["content.js"], "run_at": "document_idle"}]}