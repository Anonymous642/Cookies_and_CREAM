{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Refresh & URL Rotator - Cycle Tabs", "version": "1.1.0", "description": "Auto-refresh a tab on a timer, or cycle through a list of URLs hands-free. Pick an interval, press start, let it rotate.", "permissions": ["storage", "tabs", "activeTab", "background", "notifications"], "commands": {"navigate-previous": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Go to previous URL"}, "navigate-next": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Go to next URL"}}, "action": {"default_popup": "popup.html", "default_title": "Auto URL Rotator"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}