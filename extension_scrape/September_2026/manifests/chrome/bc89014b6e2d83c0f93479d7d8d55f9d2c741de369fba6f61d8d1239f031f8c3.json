{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Talk To Type (3T)", "description": "Voice-to-text dictation. Record your voice and transcribe or translate it directly into any text field.", "version": "1.0.3", "permissions": ["activeTab", "storage", "offscreen", "notifications", "commands", "scripting"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options/options.html", "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle voice recording on/off"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}