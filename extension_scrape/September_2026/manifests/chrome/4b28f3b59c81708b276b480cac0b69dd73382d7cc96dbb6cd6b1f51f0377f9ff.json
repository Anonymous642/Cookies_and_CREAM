{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProfileSift", "description": "ProfileSift is a Chrome browser extension that works as an enhancement layer directly on top of your favorite websites.", "version": "0.0.8", "short_name": "ProfileSift", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "author": "ProfileSift", "homepage_url": "https://profilesift.com", "action": {"default_title": "ProfileSift", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "tabs", "sidePanel"], "host_permissions": ["https://api.profilesift.com/*"], "commands": {"sort-feed": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Sort vids by views"}, "revert": {"description": "Revert original"}, "scrape-reels": {"description": "Scrape vids"}, "copy-reels": {"description": "Copy vids to clipboard"}, "scrape-comments": {"description": "Scrape comments"}, "scrape-transcript": {"description": "Scrape transcript"}, "scrape-following": {"description": "Scrape following"}, "copy-comments": {"description": "Copy comments to clipboard"}, "copy-transcript": {"description": "Copy transcript to clipboard"}, "copy-following": {"description": "Copy following to clipboard"}, "toggle-scrape-all": {"description": "Toggle scrape all"}, "toggle-bar": {"description": "Show or hide page tools"}}, "background": {"service_worker": "background.js"}, "devtools_page": "devtools.html", "options_ui": {"open_in_tab": false, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.youtube.com/*", "https://tiktok.com/*", "https://youtube.com/*"], "js": ["content-scripts/content.js"]}]}