{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Guidely: Step-by-Step Guide, SOP & Screenshot Maker", "description": "Record clicks into a step-by-step guide with a screenshot per step, then export a PDF for free. Great for SOPs & documentation.", "version": "0.5.0", "short_name": "Guidely", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["scripting", "storage", "unlimitedStorage", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Guidely \u2014 open recorder"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/recorder.js"]}]}