{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RabbitMark", "version": "1.0.4", "description": "Drop marks. Hop back. Never lose your place in AI chats again.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://medium.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"drop-mark": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Drop a mark at current position"}, "hop-next": {"suggested_key": {"default": "Alt+Down", "mac": "Alt+Down"}, "description": "Hop to next mark"}, "hop-prev": {"suggested_key": {"default": "Alt+Up", "mac": "Alt+Up"}, "description": "Hop to previous mark"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://claude.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://medium.com/*"]}]}