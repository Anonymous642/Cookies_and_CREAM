{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ToastKit", "version": "0.2.3", "description": "Clear cookies, cache, storage, and permissions for the current site. Everything else in your browser stays untouched.", "permissions": ["browsingData", "cookies", "contentSettings", "tabs", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "ToastKit", "default_popup": "popup.html", "default_icon": {"16": "icons/toastkit_toolbar_16.png", "32": "icons/toastkit_toolbar_32.png", "48": "icons/toastkit_48.png", "128": "icons/toastkit_toolbar_128.png"}}, "icons": {"16": "icons/toastkit_16.png", "32": "icons/toastkit_32.png", "48": "icons/toastkit_48.png", "128": "icons/toastkit_128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"reset-current-site": {"suggested_key": {"default": "Alt+T"}, "description": "Toast current site instantly"}}}