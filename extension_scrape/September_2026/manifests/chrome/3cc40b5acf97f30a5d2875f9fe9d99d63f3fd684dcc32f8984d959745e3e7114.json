{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TS3MusicBot WebStream (TeamSpeak & Discord)", "description": "Stream your current TAB sound to a TeamSpeak or Discord server with TS3MusicBot. Compatible with any music/media playing website.", "version": "1.2.4", "manifest_version": 3, "icons": {"16": "images/icon_19.png", "48": "images/icon_38.png", "128": "images/icon.png"}, "background": {"service_worker": "js/service-worker.js"}, "action": {"default_icon": "images/icon.png", "default_popup": "html/overview.html"}, "permissions": ["storage", "offscreen", "scripting"], "optional_permissions": ["activeTab", "tabCapture"], "optional_host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["/images/*.png", "/webfonts/*.tff"], "matches": ["<all_urls>"]}]}