{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Component Highlighter \u2014 LWC & Aura", "short_name": "Highlighter", "version": "1.1.0", "description": "Highlight LWC and Aura component boundaries on any Salesforce page. Inspect, debug and document Lightning & Experience Cloud.", "homepage_url": "https://colt255programmer.github.io/salesforce-component-highlighter/", "action": {"default_popup": "popup/popup.html", "default_title": "Salesforce Component Highlighter \u2014 highlight LWC & Aura", "default_icon": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png"}}, "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://*.force.com/*", "https://*.salesforce.com/*", "https://*.salesforce-setup.com/*", "https://*.my.site.com/*", "https://*.salesforce-experience.com/*", "https://*.salesforce-sites.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://*.force.com/*", "https://*.salesforce.com/*", "https://*.salesforce-setup.com/*", "https://*.my.site.com/*", "https://*.salesforce-experience.com/*", "https://*.salesforce-sites.com/*"], "js": ["foreground.js"], "all_frames": true, "run_at": "document_idle"}], "commands": {"toggle_lwc": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Toggle LWC highlights"}, "toggle_aura": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Toggle Aura highlights"}, "clear_all": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Clear all highlights"}, "toggle_hover": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Toggle hover-only labels"}, "snapshot": {"description": "Export a component snapshot"}}, "minimum_chrome_version": "114"}