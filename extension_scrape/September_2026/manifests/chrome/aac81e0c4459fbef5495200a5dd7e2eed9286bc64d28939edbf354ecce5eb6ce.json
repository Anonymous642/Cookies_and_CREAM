{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WordPress Plugin Filter", "version": "2.0.4", "description": "Enhanced WordPress plugin directory filtering with health scores, compatibility status, and advanced search capabilities.", "author": "Terry Arthur", "homepage_url": "https://wppd-filters.terryarthur.com/index.html", "permissions": [], "host_permissions": ["*://wordpress.org/*", "*://api.wordpress.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://wordpress.org/plugins/*", "*://wordpress.org/plugins/search/*"], "js": ["content.js"], "css": ["inject-ui.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["*://wordpress.org/*"]}], "icons": {"16": "icons/icon48.png", "32": "icons/icon48.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WordPress Plugin Filter - Active on WordPress.org plugin pages"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "88"}