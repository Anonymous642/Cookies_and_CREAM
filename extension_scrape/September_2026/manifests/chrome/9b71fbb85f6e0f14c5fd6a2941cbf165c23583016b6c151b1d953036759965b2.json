{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Comment Generator for LinkedIn, X & Instagram", "version": "0.4.0", "description": "One click writes a short, human comment for the post you're reading. No cringe, no spam. Plus a save-to-swipe-file button.", "homepage_url": "https://marketordie.io/extension", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://www.linkedin.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-x.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["content-instagram.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content-linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["linkedin-main.js"], "run_at": "document_idle", "world": "MAIN"}], "minimum_chrome_version": "111"}