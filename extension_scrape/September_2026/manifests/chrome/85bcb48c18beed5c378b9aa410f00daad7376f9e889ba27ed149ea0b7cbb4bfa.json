{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Copy \u2014 by Web Syntax", "version": "2.0.1", "description": "Restore normal text selection, copying, and context menus on websites that disable common interactions.", "permissions": ["storage", "activeTab"], "action": {"default_title": "Web Copy", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-copy": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Toggle Web Copy on the current page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}