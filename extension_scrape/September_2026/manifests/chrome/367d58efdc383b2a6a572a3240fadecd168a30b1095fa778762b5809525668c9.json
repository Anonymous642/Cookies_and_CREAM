{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WordTube", "version": "1.0.0", "description": "See when every word is spoken in a YouTube video \u2014 searchable timeline and horizon chart, right under the player.", "author": "Rodrigo Stockebrand", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WordTube \u2014 toggle panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["d3.v7.min.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://www.youtube.com/*"]}], "permissions": ["scripting", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://api.anthropic.com/*"]}