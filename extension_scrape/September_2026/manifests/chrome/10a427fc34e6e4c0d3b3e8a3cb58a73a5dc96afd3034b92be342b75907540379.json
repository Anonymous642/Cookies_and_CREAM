{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Take Fullpage Screenshots - Smox", "description": "Capture full pages, visible areas, selections, and batches of URLs. Annotate, edit, and export as PNG, JPG, or PDF.", "version": "1.3.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Smox", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "clipboardWrite", "contextMenus", "downloads", "scripting", "storage", "tabs", "unlimitedStorage"], "optional_permissions": ["debugger"], "host_permissions": ["<all_urls>"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture selected area"}}}