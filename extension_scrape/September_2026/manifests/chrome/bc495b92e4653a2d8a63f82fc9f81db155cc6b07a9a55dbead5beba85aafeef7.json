{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pwdly - Zero-Knowledge Password Manager For Teams", "version": "2.7", "description": "Non-intrusive zero-knowledge password manager built for teams. Easily autofill credentials and organize passwords in your browser.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; frame-src https://dash.pwdly.app; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_width": 420, "default_height": 620}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-bundle.js"], "run_at": "document_idle", "exclude_matches": ["https://dash.pwdly.app/*"]}]}