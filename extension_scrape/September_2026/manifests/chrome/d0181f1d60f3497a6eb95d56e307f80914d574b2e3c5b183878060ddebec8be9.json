{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "imgtree", "version": "1.11.0", "description": "Capture full pages, the visible area, or a custom selection \u2014 then upload to imgtree in one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "imgtree \u2014 capture & upload"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture full page and upload to imgtree"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture visible area and upload to imgtree"}, "capture-area": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Select an area and upload to imgtree"}}, "permissions": ["activeTab", "contextMenus", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://imgtree.co/*", "https://www.imgtree.co/*"], "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]}