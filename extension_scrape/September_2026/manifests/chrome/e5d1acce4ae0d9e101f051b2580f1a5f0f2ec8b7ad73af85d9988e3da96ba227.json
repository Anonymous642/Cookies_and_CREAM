{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grid Tool \u2014 Ruler & Guides", "version": "0.4.0", "description": "On-page rulers, alignment guides, and a measurement tool for web designers and frontend developers.", "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "options_page": "src/options/options.html", "permissions": ["storage", "activeTab", "contextMenus"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/storage.js", "src/content/units.js", "src/content/ruler.js", "src/content/guides.js", "src/content/measurement.js", "src/content/inspector.js", "src/content/content.js"], "css": ["src/content/styles.css"], "run_at": "document_idle"}], "commands": {"toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle both rulers"}, "toggle-guides": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Show/hide guides (without deleting them)"}, "toggle-measure": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle measurement mode"}, "clear-guides": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clear all guides on this page"}, "toggle-inspector": {"description": "Toggle element inspector (no default shortcut \u2014 Chrome limits extensions to 4 default shortcuts; assign one at chrome://extensions/shortcuts)"}}, "minimum_chrome_version": "110"}