{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TraderScope", "version": "0.6.0", "description": "Hover any chart image to read the price at the cursor \u2014 converted into your preferred currency. Works on sites you configure.", "permissions": ["storage", "contextMenus", "scripting", "tabs", "activeTab", "offscreen", "alarms"], "host_permissions": ["https://api.traderscope.de/*", "https://www.ecb.europa.eu/*"], "optional_host_permissions": ["https://*/*"], "icons": {"16": "icons/icon16-active.png", "32": "icons/icon32-active.png", "48": "icons/icon48-active.png", "128": "icons/icon128-active.png"}, "action": {"default_title": "TraderScope", "default_icon": {"16": "icons/icon16-inactive.png", "32": "icons/icon32-inactive.png", "48": "icons/icon48-inactive.png", "128": "icons/icon128-inactive.png"}}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["chart_overlay.js", "styles/*.css"], "matches": ["https://*/*"], "use_dynamic_url": true}]}