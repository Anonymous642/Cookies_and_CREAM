{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mambo Break - Viral Meme Dance Overlay", "short_name": "Mambo Break", "version": "1.0.2", "description": "Bring the viral Mambo Oh Yeah meme dance to any webpage with a draggable anime overlay, focus timers, site breaks, and streaks.", "minimum_chrome_version": "102", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "Take a Mambo break", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"play-mambo": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Play the selected Mambo dance on the current tab"}}, "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*", "https://live.dodopayments.com/*"], "web_accessible_resources": [{"resources": ["assets/dances/*.webm", "assets/dances/*.gif", "assets/dances/*.mp4", "assets/audio/*.m4a", "assets/audio/*.mp3", "assets/sfx/*.wav", "assets/images/*.webp", "assets/images/*.png", "content/dance-overlay.css", "content/site-break.css"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}