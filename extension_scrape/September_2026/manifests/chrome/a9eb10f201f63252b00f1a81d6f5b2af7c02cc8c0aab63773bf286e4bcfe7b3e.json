{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Home Tab", "version": "2.1", "description": "Jump to your home tab, toggle back to your most recent tab, and more", "action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "permissions": ["tabs", "storage", "contextMenus"], "background": {"service_worker": "background.js"}, "commands": {"open-home-tab": {"suggested_key": {"default": "Alt+Shift+H", "mac": "MacCtrl+Shift+H"}, "description": "Open Home Tab"}, "back-to-recent": {"suggested_key": {"default": "Alt+Shift+B", "mac": "MacCtrl+Shift+B"}, "description": "Back to Most Recent Tab"}, "set-home-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Set current tab as Home Tab"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}