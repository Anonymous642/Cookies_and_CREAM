{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Slowed (Slowed + Reverb for Youtube & SoundCloud)", "version": "0.12.2", "manifest_version": 3, "description": "Slowed + reverb for YouTube, YouTube Music and SoundCloud. Slow down any song, add reverb, lo-fi tape and vinyl crackle in your tab.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "identity", "identity.email", "alarms", "scripting"], "host_permissions": ["*://www.youtube.com/*", "*://music.youtube.com/*", "https://api.payhook.link/*", "https://api.slowed.app/*"], "optional_host_permissions": ["*://soundcloud.com/*", "*://w.soundcloud.com/*", "*://open.spotify.com/*"], "commands": {"slowed-toggle": {"description": "Activate the extension"}, "slow-down": {"description": "Slow down"}, "speed-up": {"description": "Speed up"}, "low-pass-mode-toggle": {"description": "Low Pass toggle"}, "high-pass-mode-toggle": {"description": "High Pass toggle"}, "lofi-tape-mode-toggle": {"description": "Lo-fi Tape toggle"}, "rainy-mode-toggle": {"description": "Rain toggle"}, "coffee-shop-mode-toggle": {"description": "Coffee Shop toggle"}, "bitcrusher-mode-toggle": {"description": "Down Sampler toggle"}, "vinyl-crackle-mode-toggle": {"description": "Vinyl Crackle toggle"}, "bass-boost-mode-toggle": {"description": "Bass Boost toggle"}, "phaser-mode-toggle": {"description": "Phase Shifter toggle"}, "echo-mode-toggle": {"description": "Echo Delay toggle"}, "preserve-pitch-mode-toggle": {"description": "Lock Pitch toggle"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"], "js": ["global.js", "youtubeContent.js", "panel.js"], "css": ["youtubeContent.css"], "run_at": "document_end", "all_frames": false}, {"matches": ["*://www.youtube.com/embed/*"], "js": ["global.js", "youtubeContent.js"], "css": ["youtubeContent.css"], "run_at": "document_end", "all_frames": true}, {"matches": ["*://slowed.app/*", "*://www.slowed.app/*"], "js": ["global.js", "slowedContent.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["*://console.slowed.app/*"], "js": ["consoleContent.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Slowed", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "web_accessible_resources": [{"resources": ["tapeHiss.mp3", "rain.mp3", "coffeeShop.mp3", "seashore.mp3", "berghain.mp3", "hotelLounge.mp3", "cocktailBar.mp3", "vinylCrackle.mp3", "datorroReverb.js", "mp3Encoder.js", "popup.html", "capNotice.html"], "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://w.soundcloud.com/*", "https://slowed.app/*", "https://www.slowed.app/*", "https://open.spotify.com/*"], "extension_ids": []}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["*://*.slowed.app/*", "https://payhook.link/*", "https://*.payhook.link/*"]}}