{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scene Echo - Capture", "version": "1.7.2", "description": "Capture a frame from any web page or video and send it straight to your Scene Echo collections.", "homepage_url": "https://sceneecho.com/get-extension", "permissions": ["activeTab", "storage", "tabs", "scripting", "alarms"], "host_permissions": ["https://sceneecho.com/*", "https://sceneecho.lovable.app/*", "https://*.supabase.co/*", "http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://sceneecho.com/extension-auth*", "https://sceneecho.lovable.app/extension-auth*"], "js": ["content-auth.js"], "run_at": "document_idle"}], "commands": {"capture-frame": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the current video frame"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["preview.html"], "matches": ["<all_urls>"]}]}