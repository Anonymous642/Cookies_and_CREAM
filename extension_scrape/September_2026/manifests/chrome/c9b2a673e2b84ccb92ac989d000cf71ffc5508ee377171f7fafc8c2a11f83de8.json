{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ikharo Inspector", "version": "1.0", "description": "A powerful tool for inspecting and analyzing page elements with visual highlighting and detailed information.", "permissions": ["activeTab", "scripting", "tabs", "storage", "clipboardWrite"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Toggle extension on/off"}, "copy-tooltip": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Copy tooltip content to clipboard"}}, "web_accessible_resources": [{"resources": ["settings.html", "settings.js", "docs.html", "privacy.html", "styles.css", "icon16.png", "icon32.png", "icon48.png", "icon128.png"], "matches": ["http://*/*", "https://*/*"]}]}