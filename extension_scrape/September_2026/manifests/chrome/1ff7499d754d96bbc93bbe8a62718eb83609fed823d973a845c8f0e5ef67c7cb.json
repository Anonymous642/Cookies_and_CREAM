{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenDocs", "version": "1.0", "description": "Turn a long Google Docs link into a clean, branded URL at opendocs with only two clicks.", "action": {"default_popup": "popup.html", "default_width": 350, "default_icon": {"16": "favicon.png", "32": "favicon.png", "48": "favicon.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "cookies", "webRequest", "storage"], "host_permissions": ["https://docs.google.com/*", "https://opendocs.to/*"]}