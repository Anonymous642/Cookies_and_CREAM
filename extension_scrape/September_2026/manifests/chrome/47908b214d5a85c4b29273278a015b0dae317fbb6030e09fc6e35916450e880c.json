{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ListenReader \u2014 Natural Read Aloud", "version": "1.5.3", "description": "Reads any page out loud in a natural voice while every word lights up. Works on articles, Google Docs, PDFs and Gmail. 7 days free.", "permissions": ["contextMenus", "storage", "offscreen", "unlimitedStorage", "alarms", "notifications", "scripting", "identity"], "host_permissions": ["https://api.openai.com/*", "http://*/*", "https://*/*"], "commands": {"read-page": {"suggested_key": {"default": "Alt+L"}, "description": "Read this page aloud, or play/pause"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["voice-photos.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Listen settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}