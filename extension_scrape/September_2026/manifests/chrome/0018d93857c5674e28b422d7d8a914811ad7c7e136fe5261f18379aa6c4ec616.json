{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Readit - Save to Library", "description": "One-click save the current tab to your Readit library. Captures the page from your browser, so paywalled sites just work.", "version": "0.4.0", "action": {"default_title": "Save to Readit", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-512.png", "48": "icons/icon-512.png", "128": "icons/icon-512.png"}}, "icons": {"16": "icons/icon-512.png", "48": "icons/icon-512.png", "128": "icons/icon-512.png"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"], "host_permissions": ["https://wereadit.com/*", "https://*.wereadit.com/*"], "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current tab to Readit"}}, "content_scripts": [{"matches": ["https://wereadit.com/*", "https://*.wereadit.com/*"], "js": ["detect.js"], "run_at": "document_start"}]}