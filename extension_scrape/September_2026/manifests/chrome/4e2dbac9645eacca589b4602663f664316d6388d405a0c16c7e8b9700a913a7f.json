{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hyranse: Free Linkedin Email Finder", "version": "1.0.20", "description": "Find anyone's contact info in seconds. Emails, phone numbers, GitHub, and Telegram - all in one click. Completely free.", "action": {"default_icon": {"128": "128.png"}}, "icons": {"128": "128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.linkedin.com/*", "http://contacts.hyranse.com/*", "https://contacts.hyranse.com/*"], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://www.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"]}]}