{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VisitLens", "version": "1.2.0", "description": "Tracks time spent per domain (hostname only) and shows a clean dashboard in the popup.", "permissions": ["tabs", "storage", "idle", "alarms", "windows", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Domain Time Tracker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src * data: blob:;"}, "web_accessible_resources": [{"resources": ["trip.json", "keyword.json", "city_aliases.json", "strings.json"], "matches": ["<all_urls>"]}]}