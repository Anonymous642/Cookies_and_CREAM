{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SEO helper - Bulk Google Search & Link Extractor", "description": "A browser extension for SEO research and Google search automation", "version": "1.2.1", "short_name": "SEO helper", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "offscreen", "clipboardRead"], "host_permissions": ["<all_urls>"], "commands": {"search-from-clipboard": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Search Google using clipboard content"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "SEO Helper", "default_popup": "popup.html"}}