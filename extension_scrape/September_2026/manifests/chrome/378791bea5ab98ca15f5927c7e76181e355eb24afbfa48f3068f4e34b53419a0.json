{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loop YouTube Video", "version": "1.0.2", "description": "Add a one-click loop toggle to YouTube watch pages.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Loop YouTube Video", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/loop.js"], "css": ["src/loop.css"], "run_at": "document_idle"}]}