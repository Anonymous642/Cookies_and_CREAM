{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Keyword Density & SEO Tool", "version": "1.0", "description": "Analyze keyword density on Amazon product pages to optimize your listings.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.es/*", "*://*.amazon.it/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.nl/*", "*://*.amazon.pl/*", "*://*.amazon.se/*", "*://*.amazon.tr/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.cn/*", "*://*.amazon.com.br/*", "*://*.amazon.com.mx/*", "*://*.amazon.sg/*", "*://*.amazon.eg/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "src/*"], "matches": ["<all_urls>"]}]}