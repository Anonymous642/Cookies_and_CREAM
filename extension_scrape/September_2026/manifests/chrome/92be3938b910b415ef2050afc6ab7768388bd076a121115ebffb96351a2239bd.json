{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Video Detector", "version": "1.0.0", "description": "Sosyal medyadaki AI taraf\u0131ndan olu\u015fturulan videolar\u0131 tespit eder", "default_locale": "tr", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["src/content/detector.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "AI Video Detector"}, "web_accessible_resources": [{"resources": ["assets/*", "styles/*"], "matches": ["<all_urls>"]}]}