{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GPTree - Branch, Compare & Merge From ChatGPT", "version": "1.19.12", "description": "Branch conversations from ChatGPT into GPTree for deeper exploration, branching, and merging.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://*.gptree.app/*", "https://gp-tree.com/*", "https://*.gp-tree.com/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/utils/dom-selectors.js", "src/content.js"], "css": ["src/inject.css"], "run_at": "document_idle"}, {"matches": ["https://*.gptree.app/*", "https://gp-tree.com/*", "https://*.gp-tree.com/*"], "js": ["src/gptree-bridge.js"], "run_at": "document_start"}], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "externally_connectable": {"matches": ["https://*.gptree.app/*", "https://gp-tree.com/*", "https://*.gp-tree.com/*"]}, "commands": {"branch-to-gptree": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Branch current conversation to GPTree"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}