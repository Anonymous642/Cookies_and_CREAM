{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CutThatCrap - YouTube Summarizer", "version": "1.0.10", "description": "Summarize YouTube videos instantly with AI. Fetch transcripts directly from your browser and get concise summaries.", "permissions": ["activeTab", "storage", "sidePanel", "alarms", "scripting", "tabs", "webRequest"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://cuthatcrap.com/*", "https://www.cuthatcrap.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open CutThatCrap"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://cuthatcrap.com/extension/auth*", "https://www.cuthatcrap.com/extension/auth*", "http://localhost:3000/extension/auth*"], "js": ["auth-content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}