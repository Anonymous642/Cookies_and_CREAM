{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KAIO Extension Manager", "description": "Automate Chrome extension management with smart profiles, rules, and groups. Control extensions by URL, domain, or condition.", "version": "0.0.1", "short_name": "KAIO", "icons": {"16": "icons/16-light.png", "32": "icons/32-light.png", "48": "icons/48-light.png", "128": "icons/128-light.png"}, "permissions": ["management", "storage", "alarms", "contextMenus", "tabs"], "externally_connectable": {"matches": ["https://kaioapps.com/*", "https://www.kaioapps.com/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open KAIO Extension Manager"}}, "action": {"default_title": "KAIO Extension Manager", "theme_icons": [{"light": "icons/16-light.png", "dark": "icons/16-dark.png", "size": 16}, {"light": "icons/32-light.png", "dark": "icons/32-dark.png", "size": 32}], "default_popup": "popup.html"}, "background": {"type": "module", "service_worker": "background.js"}}