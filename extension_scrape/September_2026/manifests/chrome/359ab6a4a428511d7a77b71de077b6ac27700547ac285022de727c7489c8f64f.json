{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Designer Blvd. Product Clipper", "version": "1.0.1", "description": "Clip product data from vendor pages into the Designer Boulevard catalog.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "sidePanel", "storage", "scripting"], "host_permissions": ["https://*/*", "http://localhost:3000/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["dist/content.js"], "run_at": "document_idle"}, {"matches": ["https://app.designerblvdaz.com/*", "https://designer-boulevard.vercel.app/*", "http://localhost:3000/*"], "js": ["dist/bridge.js"], "run_at": "document_start"}], "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["https://*/*"]}], "action": {"default_title": "Clip this product", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}}