{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Speed Control for Chrome", "version": "1.1.2", "description": "Speed up or slow down any video, even inside iframes. Popup, shortcuts, presets up to 8\u00d7, per-site memory \u2014 no on-video overlay.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Video Speed Controller", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "scripting", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "js": ["src/content.js"], "run_at": "document_start"}], "commands": {"speed-faster": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Increase playback speed"}, "speed-slower": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Decrease playback speed"}, "speed-reset": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Reset playback speed to 1.0x"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}