{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Digital Household - Purchase History Extractor", "version": "1.0.6", "description": "Extract and organize your grocery purchases from Amazon Whole Foods and other major retailers.", "permissions": ["activeTab", "storage", "scripting", "notifications", "downloads"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.es/*", "https://*.amazon.co.uk/*", "https://*.kroger.com/*", "https://*.walmart.com/*", "https://*.target.com/*", "https://*.costco.com/*", "https://*.mercadona.es/*", "https://*.carrefour.es/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.es/*", "https://*.amazon.co.uk/*"], "js": ["extractors/amazon.js"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.com/lists/pastpurchases/whole-foods-market*", "https://*.amazon.es/lists/pastpurchases/whole-foods-market*", "https://*.amazon.com/afx/lists/pastpurchases/whole-foods-market*", "https://*.amazon.com/fopo/order-details*"], "js": ["extractors/amazon-wholefoods.js"], "run_at": "document_idle"}, {"matches": ["https://*.kroger.com/*"], "js": ["extractors/kroger.js"], "run_at": "document_idle"}, {"matches": ["https://*.walmart.com/*"], "js": ["extractors/walmart.js"], "run_at": "document_idle"}, {"matches": ["https://*.target.com/*"], "js": ["extractors/target.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Digital Household - Purchase Extractor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles.css", "extractors/*.js"], "matches": ["<all_urls>"]}, {"resources": ["auth/*"], "matches": ["<all_urls>"]}]}