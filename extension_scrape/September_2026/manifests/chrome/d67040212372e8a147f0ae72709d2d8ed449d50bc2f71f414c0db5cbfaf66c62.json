{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lasso", "description": "Point at anything on a live site and file a ticket with a screenshot, console errors and page details. Reviewers need no account.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://www.lasso.tools/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Lasso", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.lasso.tools/*"], "js": ["content-scripts/share-link.js"]}]}