{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pauch", "description": "Sync your X.com bookmarks and folders to Pauch for powerful search and organization.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["cookies", "storage", "webRequest"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.x.com/*", "https://pauch.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Pauch", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["content-scripts/content.js"]}]}