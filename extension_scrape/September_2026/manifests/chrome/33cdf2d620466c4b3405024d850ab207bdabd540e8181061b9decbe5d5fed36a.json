{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DarkPage \u2013 Smart Dark Mode Reader", "version": "2.1.0", "description": "DarkPage - Dark mode extension for all websites with per-site control, auto scheduling, and eye strain reduction.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Alt+D"}, "description": "Toggle dark mode on current tab"}}}