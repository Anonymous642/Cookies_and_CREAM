{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Add to Treasures", "description": "Add products from the web to your Treasures inventory and wishlists.", "version": "1.0.6", "short_name": "Add to Treasures", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png", "512": "icon-512.png"}, "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs", "sidePanel"], "minimum_chrome_version": "114", "host_permissions": ["https://*.treasures.app/*"], "action": {"default_title": "Add to Treasures"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/product-context.js"]}]}