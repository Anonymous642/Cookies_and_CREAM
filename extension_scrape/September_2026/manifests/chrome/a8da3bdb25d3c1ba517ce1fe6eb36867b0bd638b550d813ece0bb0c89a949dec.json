{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Feed Gatekeeper", "version": "1.2.0", "description": "Hides LinkedIn's Main Feed by default. Popup unlock lasts 2 minutes, then auto-hides.", "permissions": ["storage", "alarms"], "action": {"default_title": "Feed Gatekeeper", "default_popup": "popup.html"}, "background": {"service_worker": "bg.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "css": ["hide.css"], "js": ["content.js"], "run_at": "document_start"}]}