{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Scroll \u2014 Reader Mode & Highlighter", "short_name": "Focus Scroll", "version": "1.2.2", "minimum_chrome_version": "115", "description": "Reader mode with a focus zone: text sharpens as it enters your reading line, distractions fade. Highlight, take notes, export.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Read Article with Scroll Reveal", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle the Focus Scroll reader"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/OpenDyslexic-Regular.otf"], "matches": ["<all_urls>"]}]}