{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ControlSurf: Productivity & Shorts, Reels, Website Blocker", "short_name": "ControlSurf", "version": "1.0", "description": "Block websites, YouTube Shorts, Instagram Reels, and distractions while tracking and boosting productivity with ControlSurf.", "permissions": ["storage", "tabs", "declarativeNetRequest", "alarms", "idle"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/youtube.js"], "css": ["content/youtube.css"], "run_at": "document_start"}, {"matches": ["*://*.instagram.com/*"], "js": ["content/instagram.js"], "css": ["content/instagram.css"], "run_at": "document_start"}], "background": {"service_worker": "background/background.js"}, "web_accessible_resources": [{"resources": ["icons/*", "pet assets/*"], "matches": ["<all_urls>"]}]}