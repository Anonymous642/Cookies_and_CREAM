{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodaOne: AI Writing Assistant & Text Humanizer", "version": "1.2.2", "description": "Right-click any text to see what reads like AI, then rewrite it. Detect, humanize, rewrite, grammar check. Free, no signup.", "permissions": ["activeTab", "contextMenus", "storage", "scripting"], "host_permissions": ["https://www.codaone.ai/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"humanize": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Humanize selected text"}, "detect": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Detect AI in selected text"}}, "homepage_url": "https://www.codaone.ai/ai/humanizer", "minimum_chrome_version": "114"}