{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WorkShade \u2014 Shade Off-Hours & Weekends on Google Calendar", "version": "1.2.0", "description": "Shades non-working hours and weekends on Google Calendar. Configurable, instant, fully private \u2014 no account needed.", "permissions": ["storage"], "host_permissions": ["https://unikdev.app/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "WorkShade", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}