{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rezoomed: LinkedIn Profile Optimizer", "description": "Unmatched LinkedIn profile optimization: score your profile, fix weak sections, and boost recruiter visibility with Rezoomed.", "version": "0.1.0", "short_name": "Rezoomed", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.linkedin.com/*", "https://rezoomed.com/*", "https://*.rezoomed.com/*"], "action": {"default_title": "Rezoomed: LinkedIn Profile Optimizer", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "externally_connectable": {"matches": ["https://rezoomed.com/*", "https://*.rezoomed.com/*"]}, "web_accessible_resources": [{"resources": ["fonts/*", "icon/*"], "matches": ["https://*.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.linkedin.com/in/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}