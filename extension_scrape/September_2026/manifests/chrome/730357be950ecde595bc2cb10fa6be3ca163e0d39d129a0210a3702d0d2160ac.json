{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageSynth", "version": "1.0.0", "description": "Turn the current webpage into ambient generative music.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "offscreen"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "src/popup.html", "default_title": "PageSynth", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}]}