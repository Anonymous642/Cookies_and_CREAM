{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shisu-ko", "version": "0.17.0", "description": "Live Japanese subtitles for YouTube from a local Whisper server, scannable with Yomitan, mined into Anki with screenshot and audio.", "homepage_url": "https://github.com/Multysquid/shisu-ko", "permissions": ["storage", "downloads", "tabs", "notifications"], "optional_permissions": ["nativeMessaging"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"], "js": ["browser-api.js", "settings.js", "match.js", "words.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Shisu-ko", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "popup.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "commands": {"toggle-subtitles": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle Shisu-ko subtitles"}, "toggle-transcript": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Toggle the transcript panel"}, "mine-current": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mine the current subtitle: screenshot and audio clip to Anki or Downloads"}, "mark-known": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Mark the word under the pointer as known (or unmark it)"}, "toggle-status": {"description": "Show or hide the status badge on the video (errors too)"}}, "minimum_chrome_version": "120"}