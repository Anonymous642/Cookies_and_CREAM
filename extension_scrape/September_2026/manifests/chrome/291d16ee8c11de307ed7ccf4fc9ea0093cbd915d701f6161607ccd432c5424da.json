{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Chat Translator", "version": "1.1.0", "manifest_version": 3, "description": "Translate Youtube and Twitch chat messages natively in chat.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://translate.googleapis.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://studio.youtube.com/*"], "js": ["content-scripts/content.js"], "css": ["content-scripts/content.css"], "run_at": "document_idle", "all_frames": true}]}