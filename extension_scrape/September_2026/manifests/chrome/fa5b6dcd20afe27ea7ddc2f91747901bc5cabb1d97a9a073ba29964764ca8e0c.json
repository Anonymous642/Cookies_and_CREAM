{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Readow \u2014 Markdown Reader", "description": "Read Markdown beautifully \u2014 free & private. Mermaid, math, folder workspaces, highlights, read-aloud, and web Reader Mode.", "version": "0.6.0", "short_name": "Readow", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting", "activeTab", "sidePanel"], "host_permissions": ["file:///*"], "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "Readow"}, "commands": {"open-viewer": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open Readow viewer"}, "reader-mode": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open current page in Reader Mode"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*/*.markdown", "*://*/*.markdown?*", "*://*/*.md", "*://*/*.md?*", "*://*/*.mdown", "*://*/*.mdx", "*://*/*.mkd", "file://*/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}