{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discipline Feed Guard", "version": "2.0.3", "description": "Local-only feed discipline controls for Reddit, YouTube, LinkedIn, Instagram, and X.", "permissions": ["storage"], "host_permissions": ["https://*.reddit.com/*", "https://*.youtube.com/*", "https://*.linkedin.com/*", "https://instagram.com/*", "https://www.instagram.com/*", "https://x.com/*", "https://www.x.com/*", "https://google.com/search*", "https://www.google.com/search*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Discipline Feed Guard", "default_popup": "popup.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["storage.js", "content_reddit.js"], "run_at": "document_start"}, {"matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["storage.js", "content_youtube.js"], "run_at": "document_start"}, {"matches": ["https://*.linkedin.com/*"], "js": ["storage.js", "content_linkedin.js"], "run_at": "document_start"}, {"matches": ["https://instagram.com/*", "https://www.instagram.com/*"], "js": ["storage.js", "content_instagram.js"], "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://www.x.com/*"], "js": ["storage.js", "content_x.js"], "run_at": "document_start"}, {"matches": ["https://google.com/search*", "https://www.google.com/search*"], "js": ["storage.js", "content_google_youtube.js"], "run_at": "document_start"}]}