{"update_url": "https://clients2.google.com/service/update2/crx", "name": "HiringCoachAI Job Importer", "description": "Save jobs and complete applications with HiringCoachAI. Autofill forms and draft answers from your resume.", "version": "1.2.0", "manifest_version": 3, "minimum_chrome_version": "120", "permissions": ["activeTab", "storage", "scripting", "identity", "contextMenus"], "optional_host_permissions": ["https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.workable.com/*"], "host_permissions": ["https://www.linkedin.com/*", "https://hiringcoach.ai/*"], "externally_connectable": {"matches": ["https://hiringcoach.ai/extension/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Save this job or autofill this application with HiringCoachAI", "default_popup": "popup/popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Save a job or autofill an application with HiringCoachAI"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/logo-mark-white.png", "color-tokens.css"], "matches": ["https://www.linkedin.com/*"], "use_dynamic_url": true}], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}]}