{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PostCardX - One-click Bilingual Card Share", "version": "1.2.0", "description": "Add PostCardX to the X (Twitter) Share menu. Capture Grok translations and export beautiful cards directly to the clipboard.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["snapdom.js", "content.js"], "run_at": "document_end"}], "permissions": ["clipboardWrite"], "web_accessible_resources": [{"resources": ["icons/paypal_qr.png", "icons/creator_avatar.png"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "host_permissions": ["https://pbs.twimg.com/*", "https://abs.twimg.com/*", "https://api.fxtwitter.com/*"]}