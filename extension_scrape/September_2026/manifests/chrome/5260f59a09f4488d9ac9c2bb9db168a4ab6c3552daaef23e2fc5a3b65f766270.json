{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PlusThat", "version": "0.20", "description": "Read and write public comments and private chat on any webpage.", "background": {"service_worker": "service-worker.js"}, "icons": {"16": "assets/img/icons/16x16.png", "32": "assets/img/icons/32x32.png", "48": "assets/img/icons/48x48.png", "128": "assets/img/icons/128x128.png"}, "permissions": ["sidePanel", "contextMenus", "tabs", "offscreen"], "externally_connectable": {"matches": ["https://plusthat.com/*"]}, "commands": {"open-side-panel-comments-cmd": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Activate the PlusThat extension"}, "add-to-later-list-cmd": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Add the current page to your Later List"}}}