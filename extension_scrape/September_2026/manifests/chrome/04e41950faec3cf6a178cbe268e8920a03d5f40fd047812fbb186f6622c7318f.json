{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Arbilister TrackerBot", "version": "1.0.13", "description": "Automatically sync Amazon tracking numbers to your eBay orders via your Arbilister account.", "homepage_url": "https://arbilister.com", "author": "Arbilister", "permissions": ["storage", "alarms", "windows"], "host_permissions": ["https://*.amazon.co.uk/*", "https://*.amazon.com/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://api.arbilister.com/*", "https://arbilister.com/*", "https://*.arbilister.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.amazon.co.uk/ap/signin*", "https://*.amazon.com/ap/signin*", "https://*.amazon.de/ap/signin*", "https://*.amazon.fr/ap/signin*", "https://*.amazon.it/ap/signin*", "https://*.amazon.es/ap/signin*", "https://*.amazon.ca/ap/signin*", "https://*.amazon.com.au/ap/signin*"], "js": ["content/amazon-signin.js"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.co.uk/*", "https://*.amazon.com/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*"], "js": ["content/amazon-parser.js"], "run_at": "document_idle"}, {"matches": ["https://arbilister.com/*", "https://*.arbilister.com/*"], "js": ["content/arbilister-session.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}