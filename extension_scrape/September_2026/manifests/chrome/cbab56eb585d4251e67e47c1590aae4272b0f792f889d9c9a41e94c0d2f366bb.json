{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sticky Notes Anywhere", "version": "1.4.0", "description": "The ultimate tool for taking quick notes anywhere on the web, with a unified notepad sidebar.", "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}, "action": {"default_title": "Click to open sticky notes panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/background.js"}, "side_panel": {"default_path": "src/panel/panel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"]}], "web_accessible_resources": [{"resources": ["src/content/content.css"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Sticky Notes Panel"}, "add_site_note": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Add Note to Current Webpage"}}}