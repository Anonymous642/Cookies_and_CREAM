{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Swearfy", "version": "6.41", "description": "Swearfy helps Censor swear words on Youtube by playing a beep sound when it detects it in the Closed Captions.", "permissions": ["scripting", "activeTab", "storage"], "icons": {"128": "icon.png"}, "host_permissions": ["https://*.youtube.com/*", "http://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["beep.wav"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://*.youtube.com/*", "http://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}}