{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pith", "version": "0.1.0", "description": "Machine review for the scientific record. Adds Pith trust signals to arXiv papers.", "icons": {"16": "icons/pith-16.png", "32": "icons/pith-32.png", "48": "icons/pith-48.png", "128": "icons/pith-128.png"}, "action": {"default_title": "Pith", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/pith-16.png", "32": "icons/pith-32.png", "48": "icons/pith-48.png", "128": "icons/pith-128.png"}}, "background": {"service_worker": "src/background.js"}, "host_permissions": ["https://pith.science/*"], "content_scripts": [{"matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*", "https://arxiv.org/html/*", "https://www.arxiv.org/html/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}