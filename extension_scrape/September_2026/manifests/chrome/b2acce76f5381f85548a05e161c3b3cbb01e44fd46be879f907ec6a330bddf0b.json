{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MathChimp Chrome Extension", "description": "Let us do your math homework!", "version": "2.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["fonts/**/*"], "matches": ["*://*/*"]}, {"resources": ["content-scripts/mathchimp-screenshot.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-stealth-mode": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle Stealth Mode", "global": false}, "mathchimp-solve": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Screenshot a problem", "global": false}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/mathchimp-screenshot.js"]}]}