{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KlipJar \u2014 Instagram & Facebook Downloader", "version": "0.5.0", "description": "Save Instagram & Facebook videos and Reels. Video and audio are combined into one file in your browser \u2014 nothing uploaded.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "KlipJar downloader", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["downloads", "tabs", "storage", "webRequest"], "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*", "https://klipjar.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["src/resolve-instagram.js", "src/content.js"], "run_at": "document_start"}, {"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["src/resolve-facebook.js", "src/content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/inject-main.js"], "matches": ["https://www.instagram.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*"]}]}