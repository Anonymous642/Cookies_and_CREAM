{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pop Stone 2 - Offline Game While Browsing", "version": "1.0.0", "description": "Play Pop Stone 2 offline in Chrome sidebar while browsing! Sound control with mute by default. Quick game breaks.", "permissions": ["sidePanel", "storage"], "host_permissions": ["https://popstone2.com/*"], "web_accessible_resources": [{"resources": ["game/*", "js/audio-control-inject.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "Pop Stone 2 - Offline Game While Browsing", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html", "default_width": 450}, "background": {"service_worker": "js/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "homepage_url": "https://popstone2.com"}