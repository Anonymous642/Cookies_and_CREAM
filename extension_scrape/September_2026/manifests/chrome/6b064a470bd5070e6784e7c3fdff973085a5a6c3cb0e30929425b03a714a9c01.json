{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TransLingo", "description": "Select text and translate with OpenAI, Qwen, or DeepSeek.", "version": "0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["https://api.openai.com/*", "https://api.deepseek.com/*", "https://dashscope.aliyuncs.com/*"], "action": {"default_title": "TransLingo"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}