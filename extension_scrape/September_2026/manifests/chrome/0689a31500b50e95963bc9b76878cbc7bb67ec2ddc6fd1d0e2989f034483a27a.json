{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Deepmark \u2014 Search Bookmarks, X, Instagram & YouTube Saves", "description": "One search for browser bookmarks, X bookmarks, Instagram saves and YouTube \u2014 videos transcribed, images read. Describe it, find it.", "version": "0.3.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "homepage_url": "https://usedeepmark.com", "permissions": ["bookmarks", "storage", "cookies", "tabGroups", "sidePanel"], "action": {"default_title": "Deepmark"}, "host_permissions": ["https://usedeepmark.com/*", "https://stag.usedeepmark.com/*"], "optional_host_permissions": ["https://x.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "run_at": "document_idle", "js": ["content-scripts/ig-saved.js"]}, {"matches": ["https://x.com/*"], "run_at": "document_idle", "js": ["content-scripts/x-bookmarks.js"]}, {"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/yt-saved.js"]}]}