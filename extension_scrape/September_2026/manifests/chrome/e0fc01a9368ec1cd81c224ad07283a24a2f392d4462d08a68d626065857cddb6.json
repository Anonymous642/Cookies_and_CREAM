{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedditComment - Comment Inspiration Tool", "version": "1.0.0", "description": "Get AI-powered writing inspiration for Reddit comments. Overcome writer's block with intelligent suggestions.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://*.reddit.com/*", "https://redditcomment.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["content/reddit.js"], "css": ["content/reddit.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://*.reddit.com/*"]}]}