{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "uShot: Clean Screenshots", "version": "1.0.1", "description": "Capture, annotate, and share screenshots from your browser. Arrow, line, pen, rectangle, ellipse, highlight, text and blur tools.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "uShot \u2014 Capture Area"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite"], "host_permissions": ["https://scrn.cloud/*"], "commands": {"start-capture": {"suggested_key": {"default": "Ctrl+Shift+5", "mac": "MacCtrl+Shift+5"}, "description": "Capture an area of the visible page"}}}