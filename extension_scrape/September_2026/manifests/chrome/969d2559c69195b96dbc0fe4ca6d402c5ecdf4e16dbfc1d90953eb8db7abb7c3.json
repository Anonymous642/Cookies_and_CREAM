{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FRAG.CHAT - Chat Anywhere", "description": "Automatically join a voice lobby for any website you visit. Experience gaming proximity chat across the web.", "version": "0.0.3", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "homepage_url": "https://frag.chat", "minimum_chrome_version": "116", "permissions": ["storage", "tabs", "offscreen"], "host_permissions": ["https://*/*"], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://frag.chat/*", "https://butthole.frag.chat/*", "https://livekit.frag.chat/*", "https://turn.frag.chat/*"]}, "action": {"default_title": "Frag.chat Lobby", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Toggle popup"}, "toggle-lobby": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Toggle the lobby"}, "toggle-sound": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle sound"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle Microphone"}}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*", "ranks/*"], "matches": ["https://*/*"]}, {"resources": ["content-scripts/content.css"], "matches": ["https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src * data: blob:; connect-src * ws: wss:; frame-src *;"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content-scripts/content.js"]}]}