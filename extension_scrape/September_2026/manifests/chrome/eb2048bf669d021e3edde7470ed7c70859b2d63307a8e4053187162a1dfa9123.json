{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault - Tab & Session Manager", "short_name": "TabVault", "description": "Save, restore and organize tabs as private local workspaces with search, recovery snapshots, tab groups and encrypted backups.", "version": "1.0", "minimum_chrome_version": "116", "permissions": ["tabs", "tabGroups", "storage", "sessions", "bookmarks", "alarms", "sidePanel", "favicon"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "TabVault", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_page": "src/options/options.html", "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"save-current-session": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current tab session"}}}