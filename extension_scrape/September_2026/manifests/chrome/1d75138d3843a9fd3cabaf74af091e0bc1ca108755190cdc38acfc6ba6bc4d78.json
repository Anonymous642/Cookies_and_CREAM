{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CRE Engage", "version": "0.1.43", "description": "Runs LinkedIn outreach actions from CRE Engage in the user's browser.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "scripting", "debugger", "storage", "alarms"], "host_permissions": ["https://creengage.com/*", "https://*.creengage.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "CRE Engage", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://creengage.com/*", "https://*.creengage.com/*"], "js": ["creengage-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["linkedin-content.js"], "run_at": "document_idle"}]}