{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unofficial enhancements for eBird", "description": "Adds life/year list status badges to species links on ebird.org. Not affiliated with eBird or the Cornell Lab of Ornithology.", "version": "0.1.0", "short_name": "eBird Enhancements", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://ebird.org/*"], "run_at": "document_idle", "css": ["content-scripts/ebird.css"], "js": ["content-scripts/ebird.js"]}]}