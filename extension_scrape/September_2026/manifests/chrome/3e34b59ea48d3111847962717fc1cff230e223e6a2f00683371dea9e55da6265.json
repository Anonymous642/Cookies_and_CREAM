{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GuidedShot - Screenshot SOP & Guide Maker", "version": "0.4.12", "description": "Turn clicks into step-by-step guides & SOPs. Auto-screenshot every action, export to PDF/ZIP. Private, local, no account.", "permissions": ["storage", "tabs", "activeTab", "scripting", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "GuidedShot", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}