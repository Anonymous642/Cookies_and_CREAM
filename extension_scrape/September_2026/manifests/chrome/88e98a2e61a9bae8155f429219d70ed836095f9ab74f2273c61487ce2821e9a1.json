{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Railgun Pixel \u2014 Email Tracking, Both Ways", "version": "0.10.0", "description": "Read receipts for Gmail \u2014 know when your email is opened, how often, and from where. And see who is tracking you.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Railgun Pixel", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "alarms"], "optional_permissions": ["notifications"], "host_permissions": ["https://mail.google.com/*", "https://api.railgun.chat/*"], "externally_connectable": {"matches": ["https://railgun.chat/*"]}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}