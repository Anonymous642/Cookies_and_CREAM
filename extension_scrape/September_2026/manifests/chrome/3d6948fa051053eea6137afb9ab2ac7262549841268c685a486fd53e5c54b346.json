{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReplyPulseAI Auto-Reply", "description": "Auto-fill AI review replies from ReplyPulseAI into Google review reply boxes.", "version": "1.3.2", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://replypulseai.com/*", "https://www.google.com/*", "https://maps.google.com/*", "https://business.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.google.com/*", "https://maps.google.com/*", "https://business.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}