{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Explainer - Local AI Tool", "version": "2.0.0", "description": "Free AI text assistant with Gemini Nano. Summarize, explain, translate, write emails. 100% private \u2014 data stays on your device.", "permissions": ["contextMenus", "activeTab", "storage", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "diagnostics.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"explain-selected": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Explain selected text"}, "translate-selected": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Translate selected text"}, "summarize-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize page"}}}