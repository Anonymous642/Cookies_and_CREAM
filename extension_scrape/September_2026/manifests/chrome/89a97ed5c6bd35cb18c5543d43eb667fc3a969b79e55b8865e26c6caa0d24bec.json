{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DebugShot", "version": "1.1.0", "description": "All-in-one bug capture: screenshot + DOM selectors + console + network (MV3).", "action": {"default_title": "DebugShot", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background-sw.js"}, "devtools_page": "devtools/devtools.html", "host_permissions": ["<all_urls>"], "permissions": ["activeTab", "tabs", "scripting", "downloads", "storage"], "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture selected area"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture full tab"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["injected/console-hook.js"], "matches": ["<all_urls>"]}]}