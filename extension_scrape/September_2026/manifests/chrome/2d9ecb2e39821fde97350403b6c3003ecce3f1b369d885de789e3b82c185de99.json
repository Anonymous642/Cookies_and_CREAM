{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Moonga Companion beta v1.0", "description": "Moonga Companion helps streamers save clips and use Moonga tools on supported Kick and Twitch pages.", "version": "1.0.0", "action": {"default_title": "Moonga Companion beta v1.0", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus", "clipboardRead"], "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*", "https://moonga.tv/*", "https://www.moonga.tv/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://moonga.tv/*", "https://www.moonga.tv/*"], "js": ["moonga-auth.js"], "run_at": "document_idle"}]}