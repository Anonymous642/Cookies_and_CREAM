{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Airstream Buy Sell \u2014 Listing Importer", "version": "0.7.7", "description": "Copy your own Facebook, Airstream Marketplace, or Airstream Hunter trailer listing into a private Airstream Buy Sell draft.", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://*.fbcdn.net/*", "https://www.airstreammarketplace.com/*", "https://airstreammarketplace.com/*", "https://www.airstreamhunter.com/*", "https://airstreamhunter.com/*", "https://airstreambuysell.com/*", "https://www.airstreambuysell.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Import this trailer listing", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/item/*", "https://facebook.com/marketplace/item/*"], "js": ["facebook-listing.js"], "run_at": "document_idle"}, {"matches": ["https://www.airstreammarketplace.com/*", "https://airstreammarketplace.com/*"], "js": ["airstream-marketplace-listing.js"], "run_at": "document_idle"}, {"matches": ["https://www.airstreamhunter.com/*", "https://airstreamhunter.com/*"], "js": ["airstream-hunter-listing.js"], "run_at": "document_idle"}, {"matches": ["https://airstreambuysell.com/*", "https://www.airstreambuysell.com/*"], "js": ["app-bridge.js"], "run_at": "document_start"}]}