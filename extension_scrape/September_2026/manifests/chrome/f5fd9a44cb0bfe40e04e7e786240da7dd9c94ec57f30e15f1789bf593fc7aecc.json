{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Timer \u2014 Themed Pomodoro", "version": "1.0.0", "description": "Pomodoro timer with animated themes (Naruto, Anime, Islamic & more), website blocker & floating countdown. Build deep focus habits.", "permissions": ["storage", "alarms", "scripting", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": []}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content/floating-timer.css"], "js": ["content/floating-timer.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://YOUR-DOMAIN.com/*"]}, "web_accessible_resources": [{"resources": ["data/*.json", "css/themes/*.css", "sounds/*", "blocked.html"], "matches": ["<all_urls>"]}]}