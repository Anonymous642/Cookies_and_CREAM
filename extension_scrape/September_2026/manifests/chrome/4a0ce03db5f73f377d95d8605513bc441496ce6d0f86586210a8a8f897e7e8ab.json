{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapRecall - Web to Flashcards + SRS", "short_name": "SnapRecall", "version": "1.0.5", "description": "Turn web text into private SRS flashcards. Study data stays local; optional Lifetime unlock verifies with Gumroad.", "homepage_url": "https://www.uncommonweather.com/products/snaprecall.html", "minimum_chrome_version": "114", "incognito": "split", "author": "Uncommon Weather LLC", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "action": {"default_popup": "popup.html", "default_title": "SnapRecall", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://gumroad.com/*", "https://*.gumroad.com/*", "https://uncommonweather.com/*", "https://*.uncommonweather.com/*"], "js": ["legal/config.js", "legal/content-gate.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "permissions": ["storage", "activeTab", "scripting", "contextMenus", "sidePanel", "alarms"], "host_permissions": ["https://api.gumroad.com/*"], "commands": {"quick-capture": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick capture current text selection as flashcard(s) in SnapRecall"}}, "externally_connectable": {"matches": ["https://www.uncommonweather.com/legal/consent-bridge.html"], "accepts_tls_channel_id": false}}