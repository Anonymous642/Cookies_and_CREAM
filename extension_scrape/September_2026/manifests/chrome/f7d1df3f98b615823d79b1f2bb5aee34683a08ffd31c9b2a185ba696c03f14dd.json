{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Versance Inbox", "version": "1.1.0", "description": "AI-drafted replies to investor emails, inside Gmail and Outlook \u2014 grounded in your company's approved IR content via Versance.", "permissions": ["storage", "scripting"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "optional_host_permissions": ["https://*/*"], "externally_connectable": {"matches": ["https://clients.versance.ai/*", "https://*.versance.ai/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}