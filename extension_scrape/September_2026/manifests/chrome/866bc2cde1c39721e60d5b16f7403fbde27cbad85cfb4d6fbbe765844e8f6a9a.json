{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Design Overlay Tool", "version": "1.0.0", "description": "Overlay design mockups on web pages for pixel-perfect implementation verification", "permissions": ["storage", "activeTab"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "src/images/icon16.png", "48": "src/images/icon48.png", "128": "src/images/icon128.png"}}, "background": {"service_worker": "src/background/background.js"}, "commands": {"toggle-overlay": {"description": "Toggle design overlay"}, "increase-opacity": {"description": "Increase overlay opacity"}, "decrease-opacity": {"description": "Decrease overlay opacity"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/images/*"], "matches": ["<all_urls>"]}], "icons": {"16": "src/images/icon16.png", "48": "src/images/icon48.png", "128": "src/images/icon128.png"}}