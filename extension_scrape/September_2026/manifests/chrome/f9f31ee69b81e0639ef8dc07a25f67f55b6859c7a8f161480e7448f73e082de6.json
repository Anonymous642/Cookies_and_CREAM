{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paperweight \u2014 Read Later, Stored as Files", "version": "0.1.2", "description": "Save articles to read later. Your library is a folder of Markdown files on your own machine. No account, no server.", "permissions": ["activeTab", "scripting", "unlimitedStorage", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Save this page to Paperweight"}, "options_ui": {"page": "src/library/library.html", "open_in_tab": true}, "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save this page"}, "open-library": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Open your library"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}