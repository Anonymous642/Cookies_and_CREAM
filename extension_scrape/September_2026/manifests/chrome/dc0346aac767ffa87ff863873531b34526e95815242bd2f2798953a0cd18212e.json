{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The AirNyx METAR Decoder", "version": "1.0.0", "description": "Decode METARs anywhere on the web. Auto-highlights METARs on aviation sites with hover-to-decode. Built for pilots and dispatchers.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "The AirNyx METAR Decoder", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "scripting"], "content_scripts": [{"matches": ["https://aviationweather.gov/*", "https://*.aviationweather.gov/*", "https://1800wxbrief.com/*", "https://*.1800wxbrief.com/*"], "js": ["metar.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "homepage_url": "https://theairnyx.com"}