{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Contador de Turno", "version": "1.2", "description": "Contador de casos (on/off) y promedio por hora para tu turno, con atajos de teclado.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "commands": {"add-off": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Sumar 1 a Correos (Off)"}, "add-on": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Sumar 1 a Chats (On)"}, "subtract-off": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Restar 1 a Correos (Off)"}, "subtract-on": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Command+Shift+4"}, "description": "Restar 1 a Chats (On)"}}}