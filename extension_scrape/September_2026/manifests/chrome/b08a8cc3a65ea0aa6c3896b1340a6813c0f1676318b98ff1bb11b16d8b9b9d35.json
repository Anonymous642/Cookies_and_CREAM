{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Scroll Videos", "version": "1.1.0", "description": "Auto scroll videos on Facebook Reels, YouTube Shorts, and TikTok.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup/popup.html", "default_title": "Auto Scroll Settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["scripts/common.js", "scripts/content_fb.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["scripts/common.js", "scripts/content_yt.js"]}, {"matches": ["*://*.tiktok.com/*"], "js": ["scripts/common.js", "scripts/content_tiktok.js"]}]}