{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Just do It! ChatGPT", "description": "Add a quick-send button to ChatGPT that inserts a customizable message and sends it.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Just do It! ChatGPT \u2014 Options", "default_popup": "options.html"}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://chatgpt.com/*"]}], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html"}