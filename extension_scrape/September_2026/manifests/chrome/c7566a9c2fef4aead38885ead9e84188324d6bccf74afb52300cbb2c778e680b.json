{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DemoFast - Interactive Demo Recorder", "version": "1.1.0", "description": "Create interactive product demos in minutes. Record clicks, add annotations, and share step-by-step guides.", "author": "DemoFast", "homepage_url": "https://demofa.st", "action": {"default_title": "DemoFast", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Start/Stop recording"}, "toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Pause/Resume recording"}, "manual-capture": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Manual capture"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["content/redact-live.js"]}, {"matches": ["<all_urls>"], "all_frames": false, "match_about_blank": false, "run_at": "document_start", "js": ["content/recorder.js"]}, {"matches": ["https://app.demofa.st/*"], "run_at": "document_start", "js": ["content/auth-bridge-wrapper.js"]}]}