{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Page Moderation", "version": "1.0.1", "description": "Tool for systematic page evaluation and error reporting by moderators", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["dist/content-panel.js"], "run_at": "document_end", "type": "module"}, {"matches": ["http://*/*", "https://*/*"], "js": ["dist/content-form.js"], "run_at": "document_end", "type": "module"}, {"matches": ["http://*/*", "https://*/*"], "js": ["dist/content-results.js"], "run_at": "document_end", "type": "module"}], "web_accessible_resources": [{"resources": ["docs/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle moderation panel"}, "pause-resume": {"suggested_key": {"default": "Alt+P"}, "description": "Pause/Resume session"}, "quick-ok": {"suggested_key": {"default": "Alt+O"}, "description": "Quick OK"}, "quick-error": {"suggested_key": {"default": "Alt+E"}, "description": "Quick Error"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "dist/popup.html", "default_title": "Page Moderation", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}