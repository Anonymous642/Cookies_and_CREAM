{"update_url": "https://clients2.google.com/service/update2/crx", "name": "YouTube Transcript 1-Click", "version": "2.1.1", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "downloads", "storage", "scripting", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}]}