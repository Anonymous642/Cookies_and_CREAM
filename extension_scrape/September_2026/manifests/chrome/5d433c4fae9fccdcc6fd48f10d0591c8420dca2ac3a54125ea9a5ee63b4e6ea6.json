{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VTimer \u2014 Multi-Mode Timer with Voice Commands", "short_name": "VTimer", "version": "1.0.1", "description": "Pomodoro timer, Tabata intervals, a stopwatch and a countdown \u2014 controlled by voice or by typing, on any page. No account needed.", "permissions": ["storage", "alarms", "tabs", "scripting", "notifications", "tts", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Show or hide VTimer"}, "commands": {"toggle-play-pause": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start, pause, or resume the timer"}, "toggle-widget": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Show or hide the VTimer widget"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}