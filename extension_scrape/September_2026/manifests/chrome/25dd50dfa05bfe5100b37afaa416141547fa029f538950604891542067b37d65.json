{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Text Extraction - YouTube", "version": "0.0.1", "description": "Select an area on a YouTube video and extract text", "permissions": ["activeTab", "offscreen"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "Text Extraction - Look for the extract button in YouTube player controls", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/youtube-detector.js", "content/selection-overlay.js", "content/frame-capture.js", "content/results-panel.js", "content/content-script.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["lib/*", "offscreen/offscreen.html"], "matches": ["https://www.youtube.com/*"]}]}