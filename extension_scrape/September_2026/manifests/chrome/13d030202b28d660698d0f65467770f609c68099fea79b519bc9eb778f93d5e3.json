{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cogcopper", "description": "Find records and median prices on Discogs while browsing YouTube.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.discogs.com/*"], "web_accessible_resources": [{"resources": ["icon/copcog-badge.png"], "matches": ["*://*.youtube.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Cogcopper Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}