{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Compr Crosslisting Extension", "version": "1.1.0", "description": "Automate crosslisting to Poshmark, Mercari, and Depop. Detect sales and auto-delist across platforms.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "notifications", "storage", "alarms", "webRequest", "cookies", "scripting", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.poshmark.com/*", "*://*.mercari.com/*", "*://*.depop.com/*", "*://*.ebay.com/*", "*://*.s3.amazonaws.com/*", "*://*.s3-accelerate.amazonaws.com/*", "*://*.supabase.co/*", "https://compr.co/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "rules", "enabled": true, "path": "corsRules.json"}]}, "content_scripts": [{"matches": ["*://*.poshmark.com/*"], "js": ["content-scripts/poshmark/listing-creator.js"], "run_at": "document_idle"}, {"matches": ["*://*.mercari.com/*"], "js": ["content-scripts/mercari/listing-creator.js"], "run_at": "document_idle"}, {"matches": ["*://*.depop.com/*"], "js": ["content-scripts/depop/listing-creator.js"], "run_at": "document_idle"}, {"matches": ["https://compr.co/*"], "js": ["content-scripts/compr/bridge.js", "content-scripts/compr/iframe-manager.js"], "run_at": "document_start"}], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "externally_connectable": {"matches": ["https://compr.co/*"]}}