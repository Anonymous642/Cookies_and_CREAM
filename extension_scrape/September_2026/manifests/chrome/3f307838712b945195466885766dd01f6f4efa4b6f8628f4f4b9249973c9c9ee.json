{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Notification Sound Changer", "version": "2.0", "description": "Set a custom notification sound for WhatsApp!", "author": {"email": "extensions@mejia.dev"}, "action": {"default_popup": "popup.html", "default_icon": "icons/default-icon.png"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "offscreen"], "host_permissions": ["https://web.whatsapp.com/*"], "background": {"service_worker": "scripts/service-worker.js"}, "content_scripts": [{"js": ["scripts/injector.js"], "matches": ["https://web.whatsapp.com/*"]}], "web_accessible_resources": [{"resources": ["scripts/inject.js"], "matches": ["https://web.whatsapp.com/*"]}]}