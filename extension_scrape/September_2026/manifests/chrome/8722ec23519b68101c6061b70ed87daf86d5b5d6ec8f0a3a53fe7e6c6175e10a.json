{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IGRecent Follower Exporter - CSV & Excel", "version": "1.0.0", "description": "Export Instagram followers and following lists to CSV and Excel files. Safe, local-first, and resumeable.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["alarms", "sidePanel", "storage", "scripting"], "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "index.html"}, "action": {"default_title": "IGRecent Follower Exporter", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}