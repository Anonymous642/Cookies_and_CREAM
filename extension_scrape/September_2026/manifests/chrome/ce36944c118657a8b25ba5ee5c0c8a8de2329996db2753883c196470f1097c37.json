{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Livid Recorder", "version": "1.2.1", "description": "Record your screen, a window or a tab with your camera and microphone, download locally or upload to Livid.", "minimum_chrome_version": "116", "incognito": "split", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Livid Recorder", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["offscreen", "storage", "activeTab", "scripting", "tabs", "unlimitedStorage", "cookies", "declarativeNetRequest"], "optional_host_permissions": ["https://livid.com/*", "https://*.livid.com/*", "https://storage.googleapis.com/*", "<all_urls>"], "web_accessible_resources": [{"resources": ["content/camera-frame.html", "content/camera-frame.js", "content/bubble.css"], "matches": ["<all_urls>"]}], "commands": {"stop-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop the current recording"}}}