{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LangCapture - Immersive Translation & English Phrases", "version": "0.5.1", "description": "Translate webpages inline and save useful English phrases from GitHub, Slack, Jira, docs, and email to your LangCapture library.", "permissions": ["contextMenus", "activeTab", "scripting", "commands", "storage"], "host_permissions": ["https://langcapture.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "LangCapture", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"save-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save selected text to LangCapture"}, "translate-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Translate the current page with LangCapture"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}