{"update_url": "https://clients2.google.com/service/update2/crx", "name": "StealthGeo", "version": "2.0.0", "manifest_version": 3, "description": "Privacy-profile-based location, proxy, and fingerprint spoofing.", "permissions": ["storage", "privacy", "proxy", "scripting", "tabs", "webRequest", "webRequestAuthProvider", "declarativeNetRequest", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "action": {"default_title": "StealthGeo", "default_popup": "src/dashboard/dashboard.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-spoofing": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Toggle location spoofing on/off"}}, "declarative_net_request": {"rule_resources": [{"id": "tracker_block", "enabled": false, "path": "rules/tracker_block.json"}]}}