{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Recorder 4K - With Mic & System Audio", "description": "Record a tab, window, or screen in 4K with mic and system audio. No watermark, no login. RecBaba: edit and export MP4.", "version": "2.0.1", "short_name": "RecBaba", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "116", "homepage_url": "https://www.recbaba.com", "permissions": ["storage", "windows", "unlimitedStorage", "scripting", "tabs", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "RecBaba"}, "commands": {"_execute_action": {"description": "Open RecBaba", "suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}}, "toggle-recording-pause": {"description": "Pause or resume recording", "suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}}, "stop-recording": {"description": "Stop recording", "suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}}}, "web_accessible_resources": [{"resources": ["bridge.html", "chunks/*.js"], "matches": ["https://www.recbaba.com/*", "https://app.recbaba.com/*"]}, {"resources": ["overlay.html", "chunks/*.js", "assets/*.css"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://www.recbaba.com/*", "https://app.recbaba.com/*"]}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.recbaba.com/*", "https://www.recbaba.com/*"], "run_at": "document_start", "js": ["content-scripts/site-integration.js"]}]}