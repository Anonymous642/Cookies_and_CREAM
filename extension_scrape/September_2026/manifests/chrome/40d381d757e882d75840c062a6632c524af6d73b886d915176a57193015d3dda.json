{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lope LinkedIn Recruiter", "short_name": "Lope Recruiter", "version": "2.0.2", "description": "View candidate status and add LinkedIn profiles to your Lope CRM. Requires a Lope account at withlope.com.", "minimum_chrome_version": "116", "permissions": ["sidePanel", "tabs", "storage", "cookies"], "host_permissions": ["https://www.linkedin.com/*", "https://*.withlope.com/*", "https://withlope.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["config.js", "sidepanel_bridge.js"], "run_at": "document_idle"}], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Lope LinkedIn Recruiter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://www.linkedin.com/*"]}]}