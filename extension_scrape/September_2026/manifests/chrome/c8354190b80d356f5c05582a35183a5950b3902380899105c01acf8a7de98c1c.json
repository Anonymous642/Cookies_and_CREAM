{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pocketdown \u2014 Markdown Web Clipper: Pages, Video & PDF", "description": "One-click Markdown web clipper: save any web page, article, video captions or PDF as clean, portable Markdown. Local & private.", "version": "1.1.1", "short_name": "Pocketdown", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "action": {"default_icon": {"16": "/icon/16.png", "32": "/icon/32.png"}, "default_title": "Pocketdown", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "downloads", "clipboardWrite", "scripting", "contextMenus"], "optional_permissions": ["tabs"], "optional_host_permissions": ["https://api.notion.com/*", "https://readwise.io/*", "http://127.0.0.1/*"], "commands": {"clip-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Clip current page to Markdown"}, "clip-selection": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clip selection to Markdown"}, "pick-element": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Pick an element to clip"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}