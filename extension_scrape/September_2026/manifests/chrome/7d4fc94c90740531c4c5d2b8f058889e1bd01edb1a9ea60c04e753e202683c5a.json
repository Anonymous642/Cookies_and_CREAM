{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Zentab - Parallel Account", "short_name": "Zentab - Parallel Account", "manifest_version": 3, "version": "9", "description": "Zentab is a multi-account manager lets you open multiple isolated sessions per website \u2014 right inside your browser and your phone.", "permissions": ["activeTab", "scripting", "tabs", "cookies", "storage", "sidePanel"], "homepage_url": "https://zentab.app", "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_icon": {"16": "icons/Icon-192.png", "32": "icons/Icon-192.png", "48": "icons/Icon-192.png", "128": "icons/Icon-192.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "service-worker.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; script-src-elem 'self';"}, "side_panel": {"default_path": "index.html"}}