{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMemo", "short_name": "TabMemo", "version": "1.0.0", "description": "Attach sticky notes to any webpage with zero-effort interaction", "permissions": ["tabs", "storage", "notifications"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline';"}, "commands": {"open-popup": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Open TabMemo popup"}, "quick-note": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Quick note mode"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo-16.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "128": "assets/logo-128.png"}}, "icons": {"16": "assets/logo-16.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "128": "assets/logo-128.png"}}