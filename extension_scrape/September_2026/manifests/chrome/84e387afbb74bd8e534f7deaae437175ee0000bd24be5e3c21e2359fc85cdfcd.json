{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marshall", "version": "1.1.1", "description": "Warns when sensitive data (API keys, tokens, passwords) is pasted into AI chat sites.", "permissions": ["storage", "tabs", "notifications", "scripting", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://x.com/i/grok*", "https://grok.com/*", "https://chat.qwen.ai/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://x.com/i/grok*", "https://grok.com/*", "https://chat.qwen.ai/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Marshall", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}