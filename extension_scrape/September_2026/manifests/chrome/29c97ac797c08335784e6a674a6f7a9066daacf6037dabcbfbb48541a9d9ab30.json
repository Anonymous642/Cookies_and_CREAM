{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VAT Assistant by myaccountingtools", "version": "1.2.2", "description": "Instantly find the correct UK VAT rate for any good or service while you do the books. Works alongside QuickBooks, Xero & Sage.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "VAT Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "host_permissions": ["https://*.quickbooks.intuit.com/*", "https://*.qbo.intuit.com/*", "https://*.xero.com/*", "https://*.sage.com/*", "https://*.freeagent.com/*"], "content_scripts": [{"matches": ["https://*.quickbooks.intuit.com/*", "https://*.qbo.intuit.com/*", "https://*.xero.com/*", "https://*.sage.com/*", "https://*.freeagent.com/*"], "js": ["vat-data.js", "payees.js", "clients.js", "extpay.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["extpay.js"], "run_at": "document_start"}]}