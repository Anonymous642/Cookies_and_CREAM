{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SignaGenius", "version": "0.4.0", "description": "Your team's email signature, automatically in every message you write in Gmail, Outlook on the web and HubSpot.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["https://panel.signagenius.com/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*"], "options_page": "options.html", "action": {"default_title": "SignaGenius", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.live.com/*", "https://app.hubspot.com/*"], "js": ["validation.js", "content.js"], "run_at": "document_idle"}]}