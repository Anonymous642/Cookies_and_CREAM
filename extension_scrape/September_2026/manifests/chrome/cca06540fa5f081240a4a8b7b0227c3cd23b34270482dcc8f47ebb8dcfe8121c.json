{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextSnap", "version": "1.0.5", "description": "Extract text from anywhere", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_popup": "popup.html", "default_title": "TextSnap", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "permissions": ["activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["styles.css", "tesseract/*.js", "tesseract/*.wasm", "tesseract/langs/*", "tesseract/langs/*/*", "tesseract-core/*.js", "tesseract-core/*.wasm"], "matches": ["<all_urls>"]}], "commands": {"activate-selection": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Select area for OCR"}}}