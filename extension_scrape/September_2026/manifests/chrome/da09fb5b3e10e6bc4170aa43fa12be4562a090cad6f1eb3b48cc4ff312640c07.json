{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AudioSnip - Web Audio Recorder & Trimmer", "version": "1.1.0", "description": "Record web audio or microphone, trim with visual waveform, and download as MP3 or WAV. 100% private & local.", "permissions": ["tabCapture", "desktopCapture", "offscreen", "storage", "downloads", "activeTab", "scripting", "sidePanel"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "AudioSnip", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "popup/popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open AudioSnip Popup"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or Stop Audio Recording"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}