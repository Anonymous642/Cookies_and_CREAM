{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DocMate", "version": "1.0.1", "description": "DocMate enhances Google Docs by generating tables, lists, and charts from selected text, and user instructions", "action": {"default_popup": "index.html", "default_icon": {"16": "assets/favicon-16x16.png", "32": "assets/favicon-32x32.png", "48": "assets/favicon-48x48.png", "128": "assets/favicon-128x128.png"}}, "externally_connectable": {"matches": ["https://docmate.aidex.co/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["content.js", "injectFonts.js"], "run_at": "document_end"}], "host_permissions": ["https://docs.google.com/document/*"], "web_accessible_resources": [{"resources": ["assets/*", "assets/fonts/*", "*.png", "*.jpg", "*.svg"], "matches": ["https://docs.google.com/*"]}, {"resources": ["assets/logo.png", "assets/numbered.png", "assets/bulleted.png", "assets/checkbox.png", "assets/alphabetical.png", "assets/multilevel.png", "assets/emoji.png", "assets/pop-up-logo.png"], "matches": ["<all_urls>"]}]}