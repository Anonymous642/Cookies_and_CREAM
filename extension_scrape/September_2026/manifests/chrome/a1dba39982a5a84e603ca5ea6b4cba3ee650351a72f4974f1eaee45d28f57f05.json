{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Context Sticky Notes", "version": "4.0.0", "description": "Attach rich notes to any webpage or domain. States, templates, version history, auto-color, cross-tab sync & more.", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "clipboardWrite"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-note": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Toggle sticky note on current page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}