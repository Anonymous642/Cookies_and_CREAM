{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Calm Reader", "description": "Reads the page aloud in a calm voice and highlights the words as it goes.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open Calm Reader"}, "toggle-play": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play / pause reading"}, "read-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Read the selected text"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Calm Reader", "default_popup": "popup.html"}}