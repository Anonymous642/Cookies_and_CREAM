{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFlow - Visual Bubble Tab Manager", "version": "2.0.3", "description": "Visual bubble tab manager. Group tabs, snooze for later, save layouts, clipboard history, highlights. 100% local.", "permissions": ["storage", "tabs", "tabGroups", "sidePanel", "contextMenus", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "side_panel": {"default_path": "panel/panel.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle TabFlow panel"}, "show-overlay": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Show bubble picker overlay"}}}