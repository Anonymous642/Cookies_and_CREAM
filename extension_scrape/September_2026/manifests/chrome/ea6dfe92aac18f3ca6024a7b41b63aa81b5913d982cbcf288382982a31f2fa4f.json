{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Daysift \u2013 Find Any Tab Instantly", "version": "1.0.24", "description": "Find anything. Instantly. Private by default. Press \u2318J to get back to any doc, page or tab you opened.", "permissions": ["tabs", "storage", "unlimitedStorage", "history", "alarms", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "js/background.js", "type": "module"}, "action": {"default_icon": {"16": "images/favicon-dark.png", "48": "images/favicon-dark.png", "128": "images/favicon-dark.png"}, "default_title": "Daysift (\u2318J)"}, "icons": {"16": "images/favicon-dark.png", "48": "images/favicon-dark.png", "128": "images/favicon-dark.png"}, "commands": {"open-daysift": {"suggested_key": {"default": "Alt+J", "mac": "Command+J"}, "description": "Open Daysift search"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/js/content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["images/*"], "matches": ["<all_urls>"]}], "options_page": "dist/options/index.html"}