{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HotSkip", "version": "0.6.0", "description": "Advanced music control miniplayer for all audio tabs", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["*://*.spotify.com/*", "*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.soundcloud.com/*", "*://*.music.apple.com/*", "*://*.music.amazon.com/*", "*://*.deezer.com/*", "*://*.tidal.com/*", "*://*.bandcamp.com/*", "*://*.twitch.tv/*", "*://*.mixer.com/*", "*://music.yandex.com/*", "*://play.google.com/*", "<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "HotSkip - Music Control", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"next-track": {"suggested_key": {"default": "Alt+X"}, "description": "Skip to next track in any tab"}}, "content_scripts": [{"matches": ["*://*.spotify.com/*", "*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.soundcloud.com/*", "*://*.music.apple.com/*", "*://*.music.amazon.com/*", "*://*.deezer.com/*", "*://*.tidal.com/*", "*://*.bandcamp.com/*", "*://*.twitch.tv/*", "*://*.mixer.com/*", "*://music.yandex.com/*", "*://play.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}