{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Playlist Transcripts", "version": "1.0.0", "description": "Extract transcripts from every video in a YouTube playlist. Copy or download as ZIP.", "permissions": ["activeTab", "storage", "downloads", "alarms", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}