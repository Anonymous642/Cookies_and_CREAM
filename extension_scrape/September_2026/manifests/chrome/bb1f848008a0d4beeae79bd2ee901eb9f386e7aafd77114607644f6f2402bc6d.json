{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tappy: Human AI Replies for LinkedIn & Emails", "short_name": "Tappy", "version": "0.2.7", "description": "One tap writes your reply on LinkedIn, Gmail, Outlook & Zoho, in your voice, not the usual AI slop.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://*.outlook.office365.com/*", "https://*.outlook.com/*", "https://mail.zoho.com/*", "https://mail.zoho.eu/*", "https://mail.zoho.in/*", "https://mail.zoho.com.au/*", "https://outlook.cloud.microsoft/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/serviceWorker.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://*.outlook.office365.com/*", "https://*.outlook.com/*", "https://mail.zoho.com/*", "https://mail.zoho.eu/*", "https://mail.zoho.in/*", "https://mail.zoho.com.au/*", "https://outlook.cloud.microsoft/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["src/content/index.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}