{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CommerceBase Capture", "description": "Save products from Amazon, Prom.ua and Rozetka into your CommerceBase catalog", "version": "0.1.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "tabs"], "commands": {"capture-product": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture current product to CommerceBase"}}, "host_permissions": ["http://localhost:8888/*", "https://*.commercebase.io/*"], "options_ui": {"page": "options.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "CommerceBase", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.es/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.pl/*", "*://*.ebay.co.uk/*", "*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.es/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.pl/*", "*://*.emag.bg/*", "*://*.emag.hu/*", "*://*.emag.ro/*", "*://*.kasta.ua/*", "*://*.prom.ua/*", "*://*.rozetka.com.ua/*", "*://*.shafa.ua/*", "*://*.temu.com/*", "*://*.zakupka.com/*"], "js": ["content-scripts/content.js"]}]}