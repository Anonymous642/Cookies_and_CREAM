{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WeAssign", "version": "1.1.0", "description": "Ajoutez un profil LinkedIn \u00e0 votre espace WeAssign en un clic : candidat ou contact client, v\u00e9rifi\u00e9 avant envoi.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"], "host_permissions": ["https://www.linkedin.com/*", "https://*.supabase.co/*", "https://we-assign.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "WeAssign \u2014 importer ce profil", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/company/*"], "js": ["content.js"], "run_at": "document_idle"}]}