{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DoppelFill: Universal Form Memory", "version": "1.0.0", "description": "Save personalized answers to common web form fields and auto-fill them with a single click", "permissions": ["storage", "activeTab"], "host_permissions": [], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://chrome.google.com/*", "https://webstore.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "DoppelFill"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Trigger DoppelFill autofill"}}, "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}]}