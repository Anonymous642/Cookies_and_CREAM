{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Bookmark Viewer", "version": "2.0", "homepage_url": "https://easybookmark.co/", "description": "Advanced bookmark management with powerful features", "permissions": ["storage", "bookmarks", "tabs", "activeTab", "contextMenus", "topSites"], "action": {"default_popup": "popup/popup.html"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"open-bookmark-viewer": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Open the Easy Bookmark Viewer new tab page"}, "quick-add-bookmark": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Quick add the current page as a bookmark"}}}