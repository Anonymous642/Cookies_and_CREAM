{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMind - AI Tab Manager", "description": "Semantic search and AI grouping for browser tabs.", "version": "0.1.0", "icons": {"16": "icons/ai-tabmanagerICO.png", "32": "icons/ai-tabmanagerICO.png", "48": "icons/ai-tabmanagerICO.png", "128": "icons/ai-tabmanagerICO.png"}, "permissions": ["tabs", "storage", "tabGroups", "sidePanel", "scripting", "sessions"], "host_permissions": ["<all_urls>", "https://api.openai.com/*", "https://api.anthropic.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open TabMind", "default_icon": {"16": "icons/ai-tabmanagerICO.png", "32": "icons/ai-tabmanagerICO.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}