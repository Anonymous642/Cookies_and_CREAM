{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DraftMilk - Live Draft Assistant", "version": "1.1.5", "description": "Real-time fantasy football draft assistance with VORP-based player recommendations", "permissions": ["storage", "activeTab"], "host_permissions": ["https://draftmilk.com/*", "https://www.draftmilk.com/*", "https://*.espn.com/*", "https://*.yahoo.com/*", "https://sleeper.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://fantasy.espn.com/*", "*://football.fantasysports.yahoo.com/*", "*://sleeper.com/draft/*"], "js": ["content/content-script.js"], "css": ["src/content/overlay.css"], "run_at": "document_idle"}, {"matches": ["*://fantasy.espn.com/*"], "js": ["content/espn-ws-hook.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["src/content/overlay.css", "assets/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://draftmilk.com/*", "https://www.draftmilk.com/*"]}}