{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MicroTTS \u2014 Instant voice for any text", "version": "1.3.3", "description": "Right-click any text or page to hear premium multilingual AI voices \u2014 inline, one-click, privacy-first.", "permissions": ["contextMenus", "storage", "offscreen", "clipboardRead", "downloads", "scripting", "activeTab"], "host_permissions": ["https://sr.microq.org/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "action": {"default_title": "MicroTTS \u2014 Instant voice for any text", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"read-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Read the current text selection aloud"}, "read-page": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Read the entire article on the current page aloud"}, "toggle-pause": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Pause or resume current playback"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["lib/Readability.js"], "matches": ["<all_urls>"]}]}