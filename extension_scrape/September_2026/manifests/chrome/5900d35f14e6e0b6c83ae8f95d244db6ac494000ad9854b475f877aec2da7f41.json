{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spicy Jollof", "version": "1.0.0", "description": "Download Instagram images and videos with style. From sparklylabz.com", "permissions": ["storage", "activeTab", "scripting", "downloads", "tabs", "clipboardWrite", "contextMenus"], "host_permissions": ["*://*.instagram.com/*", "*://i.instagram.com/*", "*://*.cdninstagram.com/*", "*://scontent.cdninstagram.com/*", "*://*.fbcdn.net/*"], "background": {"service_worker": "important/service-worker.js"}, "content_scripts": [{"matches": ["*://www.instagram.com/*"], "js": ["important/logger.js", "important/download.js", "important/instagram.js"], "run_at": "document_start"}], "action": {"default_popup": "important/popup.html", "default_title": "Spicy Jollof - Instagram Downloader", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"download-media": {"suggested_key": {"default": "Alt+K"}, "description": "Download current Instagram media"}, "open-media": {"suggested_key": {"default": "Alt+I"}, "description": "Open Instagram media in new tab"}, "next-media": {"suggested_key": {"default": "Alt+L"}, "description": "Next media in carousel"}, "prev-media": {"suggested_key": {"default": "Alt+J"}, "description": "Previous media in carousel"}}, "web_accessible_resources": [{"resources": ["themes/*.css", "icons/*"], "matches": ["*://*.instagram.com/*"]}]}