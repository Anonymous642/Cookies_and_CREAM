{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReviewPulse", "version": "1.1.0", "description": "Track Amazon product review trends over time", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.es/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*/dp/*", "*://*.amazon.es/*/dp/*", "*://*.amazon.com/dp/*", "*://*.amazon.es/dp/*", "*://*.amazon.com/product-reviews/*", "*://*.amazon.es/product-reviews/*", "*://*.amazon.com/portal/customer-reviews/*", "*://*.amazon.es/portal/customer-reviews/*"], "js": ["recent-purchases.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}