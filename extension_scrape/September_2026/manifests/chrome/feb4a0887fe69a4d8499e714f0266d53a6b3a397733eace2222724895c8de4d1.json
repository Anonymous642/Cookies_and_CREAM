{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hirable - AI Resume Builder", "description": "Scan job postings on LinkedIn and Indeed, then generate tailored resumes and cover letters powered by AI.", "version": "2.2.2", "minimum_chrome_version": "114", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Hirable", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "permissions": ["identity", "storage", "tabs", "activeTab", "scripting", "downloads", "sidePanel"], "content_scripts": [{"matches": ["https://linkedin.com/*", "https://www.linkedin.com/*", "https://indeed.com/*", "https://www.indeed.com/*"], "js": ["job-extractor.js"], "run_at": "document_idle"}], "host_permissions": ["https://hirable.me/*", "https://linkedin.com/*", "https://www.linkedin.com/*", "https://indeed.com/*", "https://www.indeed.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle Hirable sidebar"}}}