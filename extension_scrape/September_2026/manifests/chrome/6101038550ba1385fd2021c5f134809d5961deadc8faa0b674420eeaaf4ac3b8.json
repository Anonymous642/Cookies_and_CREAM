{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Draft Decoder Assistant", "version": "1.9", "description": "Helper extension for Draft Decoder to capture draft credentials and sync draft boards.", "browser_specific_settings": {"gecko": {"id": "extension@draftdecoder.com", "strict_min_version": "109.0"}}, "permissions": ["cookies"], "host_permissions": ["https://*.espn.com/*", "https://*.sleeper.com/*", "https://*.sleeper.app/*", "https://*.yahoo.com/*", "http://localhost:3000/*", "https://localhost:3000/*", "https://draftdecoder.com/*", "https://*.draftdecoder.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://localhost:3000/*", "https://localhost:3000/*", "https://draftdecoder.com/*", "https://*.draftdecoder.com/*", "https://*.espn.com/*", "https://*.sleeper.com/*", "https://*.sleeper.app/*", "https://*.yahoo.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}