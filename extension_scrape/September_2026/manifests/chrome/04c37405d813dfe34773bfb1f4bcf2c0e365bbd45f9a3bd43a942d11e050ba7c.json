{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Waifu Gatekeeper", "version": "1.0.2", "description": "Break doomscrolling habits with cute anime character overlays and timed breaks.", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "options_page": "options/options.html", "permissions": ["storage", "tabs", "alarms", "scripting", "activeTab"], "host_permissions": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.reddit.com/*", "https://live.dodopayments.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["assets/characters/*", "assets/thumb/*"], "matches": ["<all_urls>"]}], "commands": {"trigger_break": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Manually trigger a break"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}