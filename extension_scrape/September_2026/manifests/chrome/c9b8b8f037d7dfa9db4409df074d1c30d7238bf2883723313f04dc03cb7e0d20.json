{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MockUpDesign", "version": "1.4.1", "description": "VS Code\u2013style studio to mock UI on live sites for design reviews \u2014 PMs, UX, frontend, QA. Local-only exports.", "permissions": ["storage", "activeTab", "scripting", "tabs", "downloads"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "MockUpDesign", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-design-mode": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Toggle Design Mode"}}, "web_accessible_resources": [{"resources": ["icons/bank-qr.png", "icons/off.png", "icons/icon48.png", "icons/logo.svg"], "matches": ["http://*/*", "https://*/*", "file://*/*"]}]}