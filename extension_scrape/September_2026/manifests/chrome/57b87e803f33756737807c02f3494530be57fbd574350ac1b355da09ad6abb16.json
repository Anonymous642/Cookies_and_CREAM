{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextMute", "version": "0.1.0", "description": "Censors on-page text using a configurable obfuscation style.", "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TextMute", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-off-16.png", "32": "icons/icon-off-32.png", "48": "icons/icon-off-48.png", "128": "icons/icon-off-128.png"}}, "commands": {"toggle-textmute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle TextMute"}, "cycle-style": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Cycle TextMute style"}}, "icons": {"16": "icons/icon-off-16.png", "32": "icons/icon-off-32.png", "48": "icons/icon-off-48.png", "128": "icons/icon-off-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["styles.css"], "js": ["main.js"], "run_at": "document_idle"}]}