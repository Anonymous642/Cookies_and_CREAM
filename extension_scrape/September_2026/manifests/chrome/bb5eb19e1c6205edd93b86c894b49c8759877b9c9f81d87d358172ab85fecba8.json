{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DistractionFree", "version": "2.0.0", "description": "Block distracting feeds, sidebars, badges, and upsells on LinkedIn.", "permissions": ["storage"], "host_permissions": ["*://*.linkedin.com/*", "*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*", "https://raw.githubusercontent.com/thenuka-zero/DistractionFree/main/selectors.json"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "web_accessible_resources": [{"resources": ["data/quotes.js"], "matches": ["*://*.linkedin.com/*", "*://*.instagram.com/*"]}], "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["data/quotes.js", "content/shared.js", "content/linkedin.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["data/quotes.js", "content/shared.js", "content/youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.reddit.com/*"], "js": ["data/quotes.js", "content/shared.js", "content/reddit.js"], "run_at": "document_start"}, {"matches": ["*://*.instagram.com/*"], "js": ["data/quotes.js", "content/shared.js", "content/instagram.js"], "run_at": "document_start"}]}