{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shutter: Ad Blocker, Website Blocker & Focus Timer", "short_name": "Shutter", "version": "1.0.0", "description": "Ad blocker and site blocker in one. Blocks ads, trackers and sites you pick, with schedules, daily limits and a focus timer.", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "alarms", "scripting", "idle", "contextMenus", "activeTab", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Shutter"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "declarative_net_request": {"rule_resources": [{"id": "ads", "enabled": true, "path": "rules/ads.json"}, {"id": "trackers", "enabled": true, "path": "rules/trackers.json"}]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["hide.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "commands": {"focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Start or stop a focus timer"}, "block-site": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Block or unblock the current site"}}}