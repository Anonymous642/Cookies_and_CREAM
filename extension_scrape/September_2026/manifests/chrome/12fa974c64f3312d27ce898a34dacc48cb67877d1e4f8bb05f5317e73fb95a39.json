{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X.com Blocker", "version": "1.0", "description": "Blocks all X.com (Twitter) content including links, images, login buttons, embedded posts, Grok AI, and X AI services", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.twimg.com/*", "*://*.t.co/*", "*://*.x.ai/*", "*://*.grok.com/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon-48.png", "48": "icons/icon-48.png", "128": "icons/icon-96.png"}, "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["<all_urls>"]}]}