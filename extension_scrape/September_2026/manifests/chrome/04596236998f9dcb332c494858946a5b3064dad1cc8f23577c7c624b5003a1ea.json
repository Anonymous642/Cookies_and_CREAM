{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Conversation Copier", "version": "1.0.0", "description": "Copy or download full ChatGPT shared conversations as clean Markdown.", "action": {"default_popup": "popup/popup.html", "default_title": "Copy ChatGPT conversation", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "clipboardWrite", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/share/*", "https://chat.openai.com/share/*"], "js": ["content/extract.js"], "run_at": "document_idle"}]}