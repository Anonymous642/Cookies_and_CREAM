{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "__MSG_appName__", "description": "__MSG_shortDesc__", "default_locale": "en", "version": "2.1.2", "permissions": ["tabs", "tabGroups", "bookmarks", "sidePanel", "favicon", "storage", "sessions", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api-v1.tab-manager.com;"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["_favicon/*"], "use_dynamic_url": false}], "action": {"default_title": "Tab Manager - toggle sidebar"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+V"}, "description": "Toggle tabs sidebar"}, "open-tabs-overview": {"suggested_key": {"default": "Alt+T"}, "description": "Open tabs overview"}, "switch-to-previous-tab-global": {"suggested_key": {"default": "Alt+S"}, "description": "Switch to the previous tab"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "sidebar.html"}, "options_ui": {"page": "welcome.html", "open_in_tab": true}, "icons": {"16": "public/favicon-16.png", "32": "public/favicon-32.png", "48": "public/favicon-48.png", "128": "public/favicon-128.png"}}