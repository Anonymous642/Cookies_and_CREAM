{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GO READ A BOOK", "version": "1.0", "description": "Redirects distracting websites to your Kindle Cloud Reader.", "permissions": ["storage", "declarativeNetRequest", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Go Read A Book"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://read.amazon.com/*"], "js": ["content/book_picker.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}