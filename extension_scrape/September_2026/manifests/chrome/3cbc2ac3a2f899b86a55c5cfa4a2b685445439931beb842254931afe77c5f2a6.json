{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TargetPaste", "version": "1.0.0", "description": "Select a field in any tab. Copy anywhere. It pastes automatically into your chosen field.", "permissions": ["activeTab", "scripting", "tabs", "storage", "clipboardRead", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TargetPaste"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"set-target": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Start selecting target field on current tab"}, "clear-target": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Clear current target"}}}