{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Noir Lite - Simple and Effective Dark Mode", "version": "1.1", "description": "Inverts page colors for a dark mode experience. Simple and working, no complicated features, no stupid bugs.", "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "default_popup": "popup.html", "default_title": "Noir Lite"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-invert": {"suggested_key": {"default": "Alt+I"}, "description": "Toggle invert on current tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}