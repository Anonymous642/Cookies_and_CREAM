{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sanctify Browser Protection", "version": "1.0.2", "description": "Shows a calm, faith-shaped page when Sanctify Browser Protection blocks a website.", "homepage_url": "https://sanctify.faith/browser-protection", "minimum_chrome_version": "121", "permissions": ["alarms", "declarativeNetRequest", "storage", "webNavigation"], "host_permissions": ["https://app.sanctify.faith/*", "<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Sanctify Browser Protection", "default_popup": "popup.html"}, "options_page": "options.html", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "declarative_net_request": {"rule_resources": [{"id": "core_intervention", "enabled": false, "path": "rules/core.json"}]}, "web_accessible_resources": [{"resources": ["intervention.html", "intervention.css", "intervention.js", "catalog.js", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}