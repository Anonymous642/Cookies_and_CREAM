{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jobscribe - Job Saver", "version": "1.1.0", "description": "Save job postings from LinkedIn, Indeed, and more to Jobscribe with one click", "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/jobs/search-results/*", "https://linkedin.com/jobs/*", "https://linkedin.com/jobs/search-results/*", "https://www.indeed.com/jobs*", "https://www.indeed.com/viewjob*", "https://*.indeed.com/jobs*", "https://*.indeed.com/viewjob*", "https://www.glassdoor.com/Job/*", "https://www.glassdoor.com/job-listing/*", "https://www.glassdoor.co.uk/Job/*", "https://www.glassdoor.co.uk/job-listing/*"], "js": ["content/job-extractor.js"], "run_at": "document_idle"}, {"matches": ["https://getjobscribe.com/*", "https://www.getjobscribe.com/*"], "js": ["content/auth-bridge.js"], "run_at": "document_idle"}], "permissions": ["storage", "webNavigation", "scripting", "sidePanel"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://www.indeed.com/*", "https://*.indeed.com/*", "https://www.glassdoor.com/*", "https://www.glassdoor.co.uk/*", "https://getjobscribe.com/*", "https://www.getjobscribe.com/*"]}