{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Summarizer for YouTube", "version": "2.1.0", "description": "One click on a YouTube video or Short sends its transcript to ChatGPT or Claude for an instant summary. No API keys.", "minimum_chrome_version": "116", "permissions": ["storage"], "background": {"service_worker": "src/background.js"}, "options_page": "src/options.html", "action": {"default_title": "YouTube Summarizer \u2014 settings"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "world": "ISOLATED", "all_frames": false}, {"matches": ["https://chatgpt.com/*", "https://claude.ai/*"], "js": ["src/handoff-autofill.js"], "run_at": "document_idle", "all_frames": false}], "short_name": "Video Summarizer"}