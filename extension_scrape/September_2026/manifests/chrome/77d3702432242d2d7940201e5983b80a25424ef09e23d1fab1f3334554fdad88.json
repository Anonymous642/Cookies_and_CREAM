{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Overtype \u2014 PDF Text Editor", "description": "Fix a typo, change a date, delete a line. Edit the real text inside any PDF, in its own font. No uploads, no subscription.", "version": "1.8.6", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "declarativeNetRequest", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "storage": {"managed_schema": "managed-schema.json"}, "web_accessible_resources": [{"resources": ["editor.html", "chunks/*", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Open Overtype PDF editor", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "background": {"service_worker": "background.js"}}