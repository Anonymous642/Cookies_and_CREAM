{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Juriswift Automation", "description": "Browser automation for Juriswift legal practice management. Automate repetitive web tasks.", "version": "1.3.3", "manifest_version": 3, "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "alarms", "storage", "declarativeNetRequest"], "externally_connectable": {"matches": ["https://portal.juriswift.ai/*", "https://portal-test.juriswift.ai/*", "http://localhost:3000/*"]}, "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src *;"}, "action": {"default_title": "Juriswift Automation", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "dist/sidepanel.html"}, "declarative_net_request": {"rule_resources": [{"id": "csp_rules", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "dist/background.js", "type": "module"}}