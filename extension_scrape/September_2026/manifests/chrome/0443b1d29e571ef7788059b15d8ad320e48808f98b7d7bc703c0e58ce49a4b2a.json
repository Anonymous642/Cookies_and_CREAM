{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Monk Mode \u2014 Website Blocker & Focus Timer", "version": "2.001", "description": "Block distracting websites, set focus timers, and track screen time. Strict mode, auto-schedules, and productivity stats built in.", "permissions": ["storage", "alarms", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "icons/apps/*"], "matches": ["<all_urls>"]}]}