{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IntelliScribe AI", "version": "5.0.0", "description": "Dictate anywhere and fix spelling & grammar as you type \u2014 free, on your device. Classes for schools. Optional AI with your key.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "IntelliScribe AI"}, "permissions": ["storage", "sidePanel", "identity", "offscreen", "scripting", "activeTab", "contextMenus"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://intelliscribe-app.netlify.app/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"toggle-dictation": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space", "chromeos": "Alt+Shift+D"}, "description": "Start / stop dictation bar on this page"}, "toggle-writing": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Turn writing checks (spelling and grammar underlines) on / off for this page"}}}