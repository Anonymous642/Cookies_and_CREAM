{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteLint", "version": "1.0.0", "description": "Context-aware paste protection to prevent accidental data leaks and security risks", "permissions": ["storage"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content-script.js"], "css": ["ui/styles.css"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "PasteLint"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}