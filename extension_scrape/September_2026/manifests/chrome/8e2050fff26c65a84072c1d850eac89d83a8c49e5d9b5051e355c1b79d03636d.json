{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shutdown App", "version": "1.0.0", "description": "A calm, guided ritual to end your workday with clarity. Detects open tabs, groups them, and helps you shut down mindfully.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://tryshutdown.lovable.app/*"], "js": ["content.js"]}], "commands": {"start-shutdown": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start Shutdown Ritual"}, "morning-recap": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open Morning Recap"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}