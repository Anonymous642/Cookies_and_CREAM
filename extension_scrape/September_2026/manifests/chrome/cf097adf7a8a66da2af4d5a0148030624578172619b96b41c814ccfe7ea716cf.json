{"update_url": "https://clients2.google.com/service/update2/crx", "name": "QuickMeet Launcher", "description": "Provides a one-click button to launch detected meeting links in a new tab.", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "QuickMeet Launcher"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://quickmeetapp.com/*"], "externally_connectable": {"matches": ["https://quickmeetapp.com/*"]}}