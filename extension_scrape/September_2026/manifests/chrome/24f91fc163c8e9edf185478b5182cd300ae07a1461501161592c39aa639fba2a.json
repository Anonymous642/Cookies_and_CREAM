{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Manusights Reference Sentry", "version": "0.1.0", "description": "Flags retracted, expression-of-concern, and corrected references on bioRxiv paper pages.", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.biorxiv.org/content/*", "https://biorxiv.org/content/*"], "js": ["content/biorxiv.js"], "css": ["content/badges.css"], "run_at": "document_idle"}], "host_permissions": ["https://manusights.com/*", "https://www.manusights.com/*"], "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Manusights Reference Sentry", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}