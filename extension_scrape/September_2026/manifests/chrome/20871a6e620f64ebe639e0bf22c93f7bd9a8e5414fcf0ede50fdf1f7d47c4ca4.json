{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shastimer", "author": "Ivan Nokonoko", "description": "Task timer for Maps Analyst raters working on TryRating.com", "version": "6.1", "version_name": "for TryRating (v.6.1)", "minimum_chrome_version": "121", "permissions": ["tabs", "storage", "offscreen", "notifications", "webRequest", "identity", "scripting"], "host_permissions": ["*://*.tryrating.com/*", "*://*.cloudfunctions.net/*", "*://*.firebaseio.com/*", "*://*.lbtimer.com/*"], "icons": {"16": "img/t16.png", "48": "img/t48.png", "128": "img/t128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "sw.js"}, "action": {"default_title": "Shastimer", "default_popup": "o.html"}, "content_scripts": [{"matches": ["*://*.tryrating.com/*"], "js": ["tr.js"], "run_at": "document_end"}]}