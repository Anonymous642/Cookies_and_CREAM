{"update_url": "https://clients2.google.com/service/update2/crx", "version": "1.2.3", "manifest_version": 3, "background": {"service_worker": "background.js", "type": "module"}, "name": "TabDock", "description": "TabDock is a chrome extension that allows you to save your tabs in workspaces and open them later.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage", "tabGroups", "favicon", "alarms", "commands", "sidePanel"], "omnibox": {"keyword": "go"}, "action": {"default_title": "TabDock", "default_popup": "js/popup.html"}, "side_panel": {"default_path": "js/sidepanel_workspaces.html"}, "chrome_url_overrides": {"newtab": "js/index.html"}, "commands": {"kbar": {"suggested_key": {"default": "Ctrl+K"}, "description": "Open TabDock kbar"}}, "externally_connectable": {"matches": ["https://my.tabdock.app/*"]}, "web_accessible_resources": [{"resources": ["js/kbar.html", "js/kbar.js", "js/index.html", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png", "*/_favicon/?*"], "matches": ["<all_urls>"]}]}