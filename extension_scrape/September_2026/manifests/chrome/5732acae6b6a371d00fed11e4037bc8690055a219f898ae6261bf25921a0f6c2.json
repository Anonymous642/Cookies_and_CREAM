{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UltraShot - HD Webpage Screenshots", "version": "1.5.0", "author": "PJMT", "description": "Capture high-resolution webpage screenshots in 4K, 8K, or 12K. Export as PNG, JPEG, or WebP.", "permissions": ["debugger", "activeTab", "downloads", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture_fullpage": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture full page screenshot"}, "capture_visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area screenshot"}, "repeat_custom_selection": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Repeat last custom area screenshot"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["selection.css", "selection.js"], "matches": ["<all_urls>"]}]}