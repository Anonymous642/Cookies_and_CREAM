{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Piazza Answer Grabber", "description": "Extract the current Piazza question and its answers as JSON.", "version": "0.1.0", "permissions": ["clipboardWrite", "scripting"], "host_permissions": ["https://piazza.com/class/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Grab Piazza Answers"}, "content_scripts": [{"matches": ["https://piazza.com/class/*"], "js": ["content.js"], "run_at": "document_idle"}]}