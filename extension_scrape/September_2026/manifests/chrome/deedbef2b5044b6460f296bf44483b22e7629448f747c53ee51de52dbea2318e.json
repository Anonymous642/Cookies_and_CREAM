{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusGate", "version": "1.0.0", "description": "Enforce focus by restricting tabs to task-relevant websites. Tasks control tabs, not willpower.", "permissions": ["tabs", "webNavigation", "scripting", "storage", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Focus Gate", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}