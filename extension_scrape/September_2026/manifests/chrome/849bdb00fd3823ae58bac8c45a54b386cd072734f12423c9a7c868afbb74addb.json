{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ToolBreezy.com - Cookie Editor, Manager & Stay Logged In", "homepage_url": "https://toolbreezy.com/dev/", "version": "1.0.1", "description": "Stop getting signed out of the site you use every day. Save a login state, restore it in one click, and edit cookies safely.", "action": {"default_popup": "src/popup/popup.html", "default_title": "ToolBreezy.com - Cookie Editor, Manager & Stay Logged In", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "src/panel/panel.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png", "256": "icons/256.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "offline_enabled": true, "permissions": ["activeTab", "cookies", "storage", "tabs", "sidePanel"], "optional_host_permissions": ["<all_urls>"]}