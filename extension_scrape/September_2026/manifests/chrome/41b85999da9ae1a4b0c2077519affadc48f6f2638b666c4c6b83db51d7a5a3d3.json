{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "White Whale", "version": "0.2.9", "description": "Block distracting sites until you type a passage or your own goal.", "permissions": ["storage", "alarms", "declarativeNetRequest", "history", "browsingData"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+F"}, "description": "Open the White Whale popup"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["gate/gate.html"], "matches": ["<all_urls>"]}, {"resources": ["options/options.html"], "matches": ["https://focus-extension-api.focus-extension.workers.dev/*"]}]}