{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Playback Buddy", "description": "Automatically resume YouTube videos where you left off.", "version": "1.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}