{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shopify API Client: GraphiQL, MCP & CSV", "version": "1.2.0", "description": "Run Shopify Admin API queries with your own browser session. No API token. GraphiQL, MCP for Claude, analytics and CSV.", "author": "Fabian Genell", "minimum_chrome_version": "88", "permissions": ["storage", "webRequest", "tabs", "identity", "downloads", "alarms", "scripting"], "host_permissions": ["https://admin.shopify.com/*", "https://shopify.dev/*", "http://localhost/*", "http://127.0.0.1/*", "https://shopify-graphql-ai.fly.dev/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://admin.shopify.com/*"], "js": ["content-script.js"]}], "background": {"service_worker": "background.js", "type": "module"}, "homepage_url": "https://shopifythemes.dev/blog/shopify-api-chrome-extension", "offline_enabled": false, "short_name": "Shopify API Client", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Open Shopify API Client"}}}