{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Outreach Assistant", "version": "1.3.1", "description": "Send templated outreach messages and follow-ups on LinkedIn", "permissions": ["storage", "alarms", "notifications", "tabs", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://outreachai.in/*", "https://*.outreachai.in/*", "http://localhost/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://outreachai.in/*", "https://*.outreachai.in/*", "http://localhost/*"], "js": ["content.js"], "run_at": "document_idle", "css": ["styles.css"]}, {"matches": ["https://outreachai.in/*", "https://*.outreachai.in/*", "http://localhost/*"], "js": ["web-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "LinkedIn Outreach Assistant"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open LinkedIn Outreach Assistant"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "image.png", "styles.css"], "matches": ["https://www.linkedin.com/*", "https://outreachai.in/*", "https://*.outreachai.in/*", "http://localhost/*"]}]}