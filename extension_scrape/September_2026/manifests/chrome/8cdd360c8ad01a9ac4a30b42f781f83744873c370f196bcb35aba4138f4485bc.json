{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lapse - Auto-clear old history", "version": "1.1.0", "description": "Auto-deletes browsing history older than the days you set. Runs at startup and every 6h. Optional cache, cookie & data clearing.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["history", "browsingData", "storage", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Lapse", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "homepage_url": "https://github.com/ItisPratham/"}