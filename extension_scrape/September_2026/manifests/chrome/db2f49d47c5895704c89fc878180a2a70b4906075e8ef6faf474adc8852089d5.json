{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ThisPanel \u2013 Side Panel Tab Manager", "description": "Side panel tab manager for Chrome. Organize too many tabs into Spaces, Favorites, Folders & Archive. No account, all local.", "version": "1.0.4", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "tabs", "favicon", "search", "storage"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Open ThisPanel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "omnibox": {"keyword": "thispanel"}, "options_page": "options.html", "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Open ThisPanel sidebar"}, "switch-space-1": {"description": "Switch to first space"}, "switch-space-2": {"description": "Switch to second space"}}}