{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Refindbox Save", "version": "0.1.2", "description": "Save inspiration links and image captures to Refindbox.", "permissions": ["activeTab", "storage", "contextMenus", "scripting", "tabs", "notifications", "alarms"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Save to Refindbox", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}