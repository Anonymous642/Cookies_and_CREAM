{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inventory Purchase Tracker", "version": "0.7.72", "description": "Log eBay purchases by Amazon ASIN and check recent purchase history before sourcing again.", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.ebay.com/*", "https://*.execute-api.us-west-2.amazonaws.com/*", "https://inventorypurchasetracker.com/*", "https://admin.replencatcher.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_title": "Inventory Purchase Tracker", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.ebay.com/*", "https://admin.replencatcher.com/*"], "js": ["shared/namespace.js", "shared/validation.js", "shared/license-client.js", "shared/api-client.js", "shared/ui.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["shared/panel.css", "icons/sellerboard.jpg", "icons/amazon.png"], "matches": ["https://*.ebay.com/*", "https://admin.replencatcher.com/*"]}]}