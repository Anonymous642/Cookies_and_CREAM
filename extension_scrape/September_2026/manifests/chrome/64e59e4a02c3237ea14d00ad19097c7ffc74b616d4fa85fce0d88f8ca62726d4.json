{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Webbu Shopify Connector", "version": "1.0.0", "description": "Connect your open Shopify stores to Webbu. Run Admin GraphQL through your browser session. No API tokens, no install.", "author": "Webbu", "minimum_chrome_version": "116", "permissions": ["storage", "webRequest", "tabs", "alarms"], "host_permissions": ["https://admin.shopify.com/*", "https://*.webbu.ai/*", "wss://*.webbu.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://admin.shopify.com/*"], "js": ["content-script.js"]}], "background": {"service_worker": "background.js", "type": "module"}}