{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TrustDPV", "version": "1.0.1", "description": "See trust scores and verified profiles next to seller names on online marketplaces. Backed by 7 platform connections.", "permissions": ["contextMenus"], "host_permissions": ["https://trustdpv.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*", "https://www.facebook.com/groups/*"], "js": ["content/tdpv.js", "content/facebook.js"], "css": ["content/trustdpv.css"], "run_at": "document_idle"}, {"matches": ["https://www.ebay.co.uk/*", "https://www.ebay.com/*", "https://www.ebay.de/*", "https://www.ebay.fr/*", "https://www.ebay.es/*", "https://www.ebay.it/*"], "js": ["content/tdpv.js", "content/ebay.js"], "css": ["content/trustdpv.css"], "run_at": "document_idle"}, {"matches": ["https://www.gumtree.com/*"], "js": ["content/tdpv.js", "content/gumtree.js"], "css": ["content/trustdpv.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}]}