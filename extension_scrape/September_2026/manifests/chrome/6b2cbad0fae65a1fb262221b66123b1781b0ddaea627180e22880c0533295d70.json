{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tweetpilot - Grow on X", "description": "Find X conversations worth joining, draft replies in your voice, and review before you post.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting"], "action": {"default_title": "Tweetpilot - Grow on X"}, "host_permissions": ["*://x.com/*", "*://twitter.com/*", "https://app.tweetpilot.co/*", "https://api.tweetpilot.co/*"], "externally_connectable": {"matches": ["https://app.tweetpilot.co/*"]}, "web_accessible_resources": [{"resources": ["icon.png", "logo-light.png", "logo-dark.png", "panel.html"], "matches": ["*://x.com/*", "*://twitter.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["content-scripts/content.js"]}]}