{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BakLater", "description": "Save recommendations from the web directly to your private BakLater list.", "version": "0.1.2", "action": {"default_title": "Add to BakLater", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Add the current page to BakLater"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "scripting", "storage"], "host_permissions": ["https://baklater.com/*"]}