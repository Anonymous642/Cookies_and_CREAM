{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PerkWatch - Travel perk reminder", "version": "0.1.0", "description": "Sign in on a supported airline or hotel account page, then open PerkWatch to capture perks, balances, and upcoming expirations.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["scripting", "storage", "alarms", "downloads", "notifications", "tabs"], "host_permissions": ["https://*.alaskaair.com/*", "https://*.delta.com/*", "https://*.ihg.com/*", "https://*.hyatt.com/*", "https://*.world.hyatt.com/*", "https://*.hilton.com/*", "https://*.lifemiles.com/*", "https://*.marriott.com/*", "https://*.united.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png"}, "default_popup": "popup.html", "default_title": "PerkWatch - Travel perk reminder"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://*.alaskaair.com/*", "https://*.delta.com/*", "https://*.ihg.com/*", "https://*.hyatt.com/*", "https://*.world.hyatt.com/*", "https://*.hilton.com/*", "https://*.lifemiles.com/*", "https://*.marriott.com/*", "https://*.united.com/*"], "js": ["content-script.bundle.js"], "run_at": "document_idle"}]}