{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snapmark - Screenshot & Annotate", "version": "1.0.0", "description": "Capture screenshots and annotate with arrows, text, shapes, and highlights. Perfect for tutorials, bug reports, and documentation.", "permissions": ["activeTab", "storage", "scripting", "downloads", "contextMenus"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Snapmark - Screenshot & Annotate"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S", "linux": "Alt+Shift+S"}, "description": "Capture visible area and edit"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F", "linux": "Alt+Shift+F"}, "description": "Capture full page and edit"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D", "linux": "Alt+Shift+D"}, "description": "Quick save screenshot"}}, "options_page": "options.html", "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["editor.html", "editor.css", "editor.js", "onboarding.html", "privacy.html", "options.html", "pricing.html", "licensing.js"], "matches": ["chrome-extension://*/*"]}]}