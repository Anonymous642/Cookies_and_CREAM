{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Clip To Workflowy", "version": "3.1.4", "description": "Bookmark websites in Workflowy", "manifest_version": 3, "action": {"default_icon": "icon-128.png", "default_title": "Clip To Workflowy"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "tabs", "storage", "scripting", "contextMenus", "alarms", "clipboardRead", "clipboardWrite", "offscreen"], "host_permissions": ["https://workflowy.com/*", "https://*.workflowy.com/*"], "content_scripts": [{"matches": ["https://workflowy.com/*", "https://*.workflowy.com/*"], "js": ["cursor_tracker.js"], "run_at": "document_idle"}, {"matches": ["https://workflowy.com/*", "https://*.workflowy.com/*"], "js": ["cursor_tracker_main.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://workflowy.com/api-key/*", "https://workflowy.com/api-key"], "js": ["token_sniffer.js"], "run_at": "document_end"}], "options_ui": {"page": "popup.html", "open_in_tab": true}, "commands": {"1-default-destination": {"description": "Clip to default destination", "suggested_key": {"default": "Alt+Shift+D"}}, "2-clip-cursor": {"description": "Clip to cursor (API)", "suggested_key": {"default": "Alt+C"}}, "3-clip-clipboard": {"description": "Clip to clipboard (OPML)", "suggested_key": {"default": "Alt+Shift+C"}}, "4-repeat-last": {"description": "Repeat last clip action", "suggested_key": {"default": "Alt+Shift+R"}}, "5-arrange-browser-split": {"description": "Side-by-side Browser Tabs"}, "6-arrange-windows": {"description": "Side-by-side Windows"}}}