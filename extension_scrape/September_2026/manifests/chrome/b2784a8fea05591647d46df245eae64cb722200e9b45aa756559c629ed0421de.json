{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TradeCut for Chrome", "version": "0.1.3", "description": "Records the trading tab you choose and uploads clips around your trades to your TradeCut account.", "action": {"default_popup": "src/popup/index.html", "default_title": "TradeCut"}, "options_page": "src/options/index.html", "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "scripting", "storage", "commands", "activeTab", "tabs", "alarms", "notifications", "identity"], "host_permissions": ["https://trade-cut.com/*", "https://*.r2.cloudflarestorage.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"mark-entry": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Mark trade entry"}, "mark-exit": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Mark trade exit"}, "toggle-record": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Start or stop recording"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}