{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick URL Copy", "version": "1.2", "description": "A simple and fast extension to copy URLs with various formatting options.", "permissions": ["activeTab", "storage", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open Quick URL Copy popup"}, "copy-current-url": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Copy current tab URL directly"}}}