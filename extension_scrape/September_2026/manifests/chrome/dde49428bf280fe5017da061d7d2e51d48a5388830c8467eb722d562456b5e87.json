{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TG Media Organizer", "description": "Local-first organizer for media visible on Telegram Web, with optional account sync.", "version": "1.0.3", "permissions": ["activeTab", "downloads", "scripting", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://web.telegram.org/*", "https://www.tgmediaorganizer.app/*"], "web_accessible_resources": [{"resources": ["bridge-inject.js"], "matches": ["https://web.telegram.org/*"]}], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TG Media Organizer", "default_popup": "src/popup/index.html"}, "content_scripts": [{"matches": ["https://web.telegram.org/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}