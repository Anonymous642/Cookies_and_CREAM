{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loud", "version": "0.1.0", "description": "See every tab making noise. Pause one, jump to it, or silence the whole room.", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Loud", "default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"mute-all": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Silence all audible tabs"}}}