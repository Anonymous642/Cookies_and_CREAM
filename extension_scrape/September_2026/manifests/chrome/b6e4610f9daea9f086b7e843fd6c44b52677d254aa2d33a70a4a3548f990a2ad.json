{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fly Loft", "version": "1.1.15", "minimum_chrome_version": "102", "description": "I split this window's tabs into real windows on your screen.", "permissions": ["system.display", "storage", "tabGroups"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Fly Loft", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"layout-50-50": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Split 50 / 50"}, "layout-2x2": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Split 2 \u00d7 2"}, "layout-25-50-25": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Split 25 / 50 / 25"}, "layout-two-monitors": {"description": "Send half the tabs to the other screen"}, "undo-last": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Undo last split"}}}