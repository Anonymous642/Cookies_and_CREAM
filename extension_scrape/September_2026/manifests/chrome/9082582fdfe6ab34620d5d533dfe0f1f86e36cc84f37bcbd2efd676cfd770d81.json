{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Render View for Azure DevOps", "version": "1.0.0", "description": "Adds a Render tab to the Azure DevOps file viewer so .html files render live in a sandboxed iframe \u2014 either inline or in a new tab.", "author": "Fn First Holdings LLC", "homepage_url": "https://fnfirst.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Render View for Azure DevOps", "default_popup": "popup.html"}, "host_permissions": ["https://dev.azure.com/*", "https://*.visualstudio.com/*", "https://dev.azure.com.mcas.ms/*", "https://*.visualstudio.com.mcas.ms/*", "https://dev.azure.com.mcas-gov.us/*", "https://dev.azure.com.mcas-gov.ms/*"], "content_scripts": [{"matches": ["https://dev.azure.com/*", "https://*.visualstudio.com/*", "https://dev.azure.com.mcas.ms/*", "https://*.visualstudio.com.mcas.ms/*", "https://dev.azure.com.mcas-gov.us/*", "https://dev.azure.com.mcas-gov.ms/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "sandbox": {"pages": ["viewer.html"]}, "content_security_policy": {"sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: blob: data:; child-src 'self'"}, "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["https://dev.azure.com/*", "https://*.visualstudio.com/*", "https://dev.azure.com.mcas.ms/*", "https://*.visualstudio.com.mcas.ms/*", "https://dev.azure.com.mcas-gov.us/*", "https://dev.azure.com.mcas-gov.ms/*"]}]}