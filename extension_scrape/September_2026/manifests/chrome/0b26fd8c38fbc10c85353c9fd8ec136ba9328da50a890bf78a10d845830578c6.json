{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Site Lock: Web Guard", "version": "1.0.0", "description": "Password-protect specific websites and URLs to control access and enhance privacy.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "webNavigation", "declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["lock/lock.html"], "matches": ["<all_urls>"]}]}