{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dialup AI", "description": "Plays a dial-up style sound while AI responses are generating and tracks your wait time.", "version": "1.0.0", "permissions": ["storage", "tabs"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "web_accessible_resources": [{"resources": ["*.mp3", "*.wav", "assets/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}], "icons": {"16": "dialup_favicon.png", "32": "dialup_favicon.png", "48": "dialup_favicon.png", "128": "dialup_favicon.png"}, "action": {"default_title": "Dialup AI Sound", "default_popup": "popup.html", "default_icon": {"16": "dialup_favicon.png", "32": "dialup_favicon.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}