{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Date Resolver for GMail", "short_name": "date_resolver", "version": "0.1.0", "author": "Robert Gehrsitz", "description": "Resolves relative dates like 'today', 'tomorrow', 'this Friday', and 'next week' in Gmail relative to the email sent date.", "icons": {"16": "dist/icons/icon16.png", "32": "dist/icons/icon32.png", "48": "dist/icons/icon48.png", "128": "dist/icons/icon128.png"}, "action": {"default_popup": "dist/popup.html", "default_title": "Date Resolver Settings", "default_icon": {"16": "dist/icons/icon16.png", "32": "dist/icons/icon32.png", "48": "dist/icons/icon48.png", "128": "dist/icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*"], "content_scripts": [{"matches": ["*://mail.google.com/*"], "css": ["dist/styles.css"], "js": ["dist/extension.js"], "run_at": "document_start"}]}