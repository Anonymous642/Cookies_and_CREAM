{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lexora - Language Assistant", "version": "0.18.4", "description": "Language reading assistant: translate, explain, and pronounce selected text with Wikipedia context", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Lexora", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["contextMenus", "offscreen", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://*.wikipedia.org/*", "https://www.wikidata.org/*", "https://translate.google.com/*", "https://translate.googleapis.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["selection.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["youtube-content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["youtube/playerBridge.js"], "matches": ["https://www.youtube.com/*"]}], "options_page": "options.html", "commands": {"lexora_toggle": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open or toggle Lexora"}}}