{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GoToBrand", "version": "1.0.0", "description": "Instantly see brand details and official product pages while you shop online.", "permissions": ["activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.amazon.com/*/dp/*", "*://*.amazon.com/dp/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["brands.json"], "matches": ["<all_urls>"]}]}