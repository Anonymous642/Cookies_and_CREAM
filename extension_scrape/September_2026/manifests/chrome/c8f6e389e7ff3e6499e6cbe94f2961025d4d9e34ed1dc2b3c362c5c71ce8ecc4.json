{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapClip \u2014 Screenshot & Annotate to Clipboard", "version": "1.1.1", "description": "Capture, annotate, and copy screenshots straight to your clipboard, or extract their text. No download step, no account, no upload.", "permissions": ["activeTab", "scripting", "storage", "offscreen"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "SnapClip \u2014 capture a region", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"capture-region": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture a region"}, "capture-viewport": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Capture the visible viewport"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}