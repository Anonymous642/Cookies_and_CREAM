{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chimely - Gentle Sound Reminder for Focus & Productivity", "version": "1.4", "description": "Stay focused with gentle chimes. Customize your reminder intervals and sounds for a productive, mindful workflow.", "permissions": ["alarms", "storage", "offscreen"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["offscreen.html", "sounds/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/chime_16.png", "32": "icons/chime_32.png", "48": "icons/chime_48.png", "128": "icons/chime_128.png"}}