{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SkyNote \u2014 Reminders That Fly", "version": "2.1.0", "description": "Your reminders fly across the screen as a vintage plane towing a banner. Blimps, drones, balloons & a reminder train too.", "permissions": ["alarms", "storage", "notifications", "scripting", "tabs", "contextMenus"], "commands": {"quick-add": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Quick-add a reminder on this page"}}, "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "SkyNote \u2014 reminders that fly", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}, {"matches": ["https://flyskynote.app/*"], "js": ["flight-bridge.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["share/share.html"], "matches": ["<all_urls>"]}]}