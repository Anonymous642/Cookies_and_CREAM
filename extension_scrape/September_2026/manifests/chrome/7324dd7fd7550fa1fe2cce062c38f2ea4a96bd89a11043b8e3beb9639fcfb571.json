{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bricks Builder Dev-Sync", "version": "2.1", "description": "Updates the Bricks preview (view in Frontend) when saving with Ctrl+S or via the save button.", "icons": {"128": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "Bricks Dev-Sync aktiv"}, "permissions": ["tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "include_globs": ["*bricks=run*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}