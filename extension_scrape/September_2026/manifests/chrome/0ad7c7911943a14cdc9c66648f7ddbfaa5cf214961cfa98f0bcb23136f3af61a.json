{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SkipWatching", "version": "1.3.1", "description": "Turn any YouTube video into a 2-minute read with Claude, ChatGPT, or Gemini.", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://skipwatching.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "SkipWatching", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["src/fonts/archivo.woff2"], "matches": ["https://www.youtube.com/*"]}], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/page-transcript.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["src/prompt.js", "src/content-youtube.js"], "css": ["src/ui.css"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"], "js": ["src/content-provider.js"], "run_at": "document_idle"}]}