{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Streamlin \u2014 Never Locked Out", "version": "1.2.3", "description": "Sign in to your household's shared streaming services without ever typing the password. Auto-fills Netflix, Disney+, Hulu, Max.", "author": "Streamlin", "homepage_url": "https://streamlin.app", "permissions": ["storage"], "host_permissions": ["https://www.netflix.com/*", "https://netflix.com/*", "https://www.disneyplus.com/*", "https://disneyplus.com/*", "https://www.hulu.com/*", "https://hulu.com/*", "https://auth.hulu.com/*", "https://www.max.com/*", "https://max.com/*", "https://streamlin.app/*"], "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://netflix.com/*"], "js": ["content/_autofill.js", "content/netflix.js"], "run_at": "document_idle"}, {"matches": ["https://www.disneyplus.com/*", "https://disneyplus.com/*"], "js": ["content/_autofill.js", "content/disneyplus.js"], "run_at": "document_idle"}, {"matches": ["https://www.hulu.com/*", "https://hulu.com/*", "https://auth.hulu.com/*"], "js": ["content/_autofill.js", "content/hulu.js"], "run_at": "document_idle"}, {"matches": ["https://www.max.com/*", "https://max.com/*"], "js": ["content/_autofill.js", "content/max.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Streamlin \u2014 Stay signed in"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html"}