{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LLMemory \u2013 Export & Backup ChatGPT, Claude & Gemini Chats", "version": "0.1.5", "description": "Export, back up & search your AI chats \u2014 ChatGPT, Claude, Gemini & more \u2014 into your own private, searchable memory on Drive.", "permissions": ["alarms", "identity", "storage", "tabs", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://www.google.com/search*", "https://www.googleapis.com/*", "https://api.llmemory.xyz/*"], "icons": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "LLMemory", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/capture/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["src/capture/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["src/capture/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["src/capture/perplexity.js"], "run_at": "document_idle"}, {"matches": ["https://grok.com/*"], "js": ["src/capture/grok.js"], "run_at": "document_idle"}, {"matches": ["https://copilot.microsoft.com/*"], "js": ["src/capture/copilot.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/search*"], "js": ["src/capture/googleSearch.js"], "run_at": "document_idle"}]}