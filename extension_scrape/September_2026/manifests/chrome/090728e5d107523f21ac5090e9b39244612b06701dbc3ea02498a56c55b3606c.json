{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatPin", "version": "3.10.3", "description": "Pin AI chat responses at your preferred height with an adjustable slider. Works with ChatGPT, Gemini, and Grok.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["scripting", "storage"], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "css": ["style.css"]}, {"matches": ["https://gemini.google.com/*"], "js": ["gemini.js"]}, {"matches": ["https://grok.com/*"], "js": ["grok.js"]}]}