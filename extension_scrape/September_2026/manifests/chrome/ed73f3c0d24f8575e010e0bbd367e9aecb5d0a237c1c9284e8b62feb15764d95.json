{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmarkr \u2013 Bookmarks & Tags", "short_name": "Bookmarkr", "version": "1.0.1", "description": "Bookmarkr helps you organize, clean and manage your bookmarks with tags and bulk tools. All local\u2014no cloud, no account.", "permissions": ["bookmarks", "storage", "favicon", "topSites", "tabs", "history"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Save page as bookmark"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"]}]}