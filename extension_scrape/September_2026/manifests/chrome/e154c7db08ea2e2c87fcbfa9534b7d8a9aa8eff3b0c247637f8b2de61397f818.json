{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Loka \u2014 meeting notes & transcription", "description": "Record Google Meet, Zoom, and Teams calls with one click. Transcripts, AI summaries, and action items in your Loka dashboard.", "version": "0.2.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "tabCapture", "offscreen", "sidePanel", "storage", "identity"], "host_permissions": ["https://app.lokanote.com/*", "https://storage.googleapis.com/*"], "action": {"default_title": "Loka", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://app.lokanote.com https://storage.googleapis.com"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/meet.js"]}, {"matches": ["https://teams.live.com/*", "https://teams.microsoft.com/*"], "run_at": "document_idle", "js": ["content-scripts/teams.js"]}, {"matches": ["https://*.zoom.us/wc/*", "https://app.zoom.us/wc/*"], "run_at": "document_idle", "js": ["content-scripts/zoom.js"]}]}