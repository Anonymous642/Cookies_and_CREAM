{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meet Volume Control", "description": "Easily adjust the volume of your Google Meet meetings with a simple slider.", "version": "1.5", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js"}, "commands": {"toggle-mute": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+M"}, "description": "Mute / Unmute meeting"}, "increase-volume": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Increase volume by 10%"}, "decrease-volume": {"suggested_key": {"default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Decrease volume by 10%"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "icons": {"16": "meet16.png", "48": "meet48.png", "128": "meet128.png"}}