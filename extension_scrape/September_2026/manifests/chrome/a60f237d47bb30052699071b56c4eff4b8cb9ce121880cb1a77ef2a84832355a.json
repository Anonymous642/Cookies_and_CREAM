{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Same Tab (eBay / Temu / AliExpress)", "version": "1.0.0", "description": "Stops eBay, Temu and AliExpress forcing every click into a new tab. Cmd-click still opens a new tab when you want one.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ie/*", "*://*.ebay.de/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.temu.com/*", "*://*.aliexpress.com/*", "*://*.aliexpress.us/*", "*://*.aliexpress.ru/*"], "js": ["same-tab.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}]}