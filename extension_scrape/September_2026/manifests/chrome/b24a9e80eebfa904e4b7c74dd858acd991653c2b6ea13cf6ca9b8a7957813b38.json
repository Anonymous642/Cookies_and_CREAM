{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Keen \u2014 every prompt, sharper.", "version": "2.1.0", "description": "Turns vague prompts into expert-level instructions before you hit send \u2014 on Claude, ChatGPT, Gemini, and Perplexity.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://promptenhancer-comeback.onrender.com/*", "http://127.0.0.1:8787/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"enhance-prompt": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Enhance the current prompt"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Keen", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}}