{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Private Twitter Bookmarks - Lock & Blur with PIN for X", "version": "2.2.0", "description": "PIN-lock your X (Twitter) Bookmarks tab and blur saved tweets instantly. Keep them private on shared computers and laptops.", "permissions": ["storage", "activeTab", "tabs", "alarms"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "https://api.lemonsqueezy.com/*"], "commands": {"panic_lock": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L"}, "description": "Instantly lock Bookmarks tab"}}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["overlay.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.x.com/*", "*://*.twitter.com/*", "https://api.lemonsqueezy.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon16.png", "128": "icons/icon16.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon16.png", "128": "icons/icon16.png"}}