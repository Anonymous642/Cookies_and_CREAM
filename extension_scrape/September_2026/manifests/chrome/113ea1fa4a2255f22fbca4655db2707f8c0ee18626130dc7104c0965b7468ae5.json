{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bareium \u2014 URL Shortener", "version": "1.2.2", "description": "Shorten any URL with Bareium. Right-click or use the popup to create branded short links instantly.", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "identity", "clipboardWrite"], "host_permissions": ["https://api.bareium.com/*", "https://bareium.supabase.co/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "service-worker.js"}, "commands": {"shorten-current-page": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Shorten current page URL"}}}