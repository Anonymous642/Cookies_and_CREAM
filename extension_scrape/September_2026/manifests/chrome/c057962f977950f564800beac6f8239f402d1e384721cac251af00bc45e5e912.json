{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeTLDR - YouTube AI Video Summarizer", "version": "1.6.3", "description": "Instantly summarize YouTube videos, extract recommendations and picks, and jump to key timestamps.", "permissions": ["storage", "activeTab", "sidePanel", "alarms", "notifications"], "host_permissions": ["https://*.youtube.com/*", "https://generativelanguage.googleapis.com/*", "https://api.notion.com/*"], "action": {"default_title": "Open Video Summarizer"}, "commands": {"toggle_summary": {"suggested_key": {"default": "Alt+S", "mac": "Command+Shift+S"}, "description": "Toggle Video Summary Widget"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://youtube.com/shorts/*"], "js": ["main_world_bridge.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://youtube.com/shorts/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}