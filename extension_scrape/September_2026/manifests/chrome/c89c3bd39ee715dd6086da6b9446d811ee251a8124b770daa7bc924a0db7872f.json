{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KindnessSender - Spread Kindness Everywhere", "short_name": "KindnessSender", "version": "1.0.3", "description": "Send anonymous kind words to people who might be struggling. Spread positivity from your browser.", "homepage_url": "https://kindnesssender.com", "permissions": ["storage", "geolocation", "notifications"], "host_permissions": ["https://kindnesssender.com/*", "https://www.kindnesssender.com/*", "https://staging.kindnesssender.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Send Kind Words", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.cnn.com/*", "*://*.bbc.com/*", "*://*.nytimes.com/*", "*://*.washingtonpost.com/*", "*://*.reuters.com/*", "*://*.ap.org/*", "*://*.npr.org/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["popup.html", "options.html", "icons/*"], "matches": ["<all_urls>"]}], "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}