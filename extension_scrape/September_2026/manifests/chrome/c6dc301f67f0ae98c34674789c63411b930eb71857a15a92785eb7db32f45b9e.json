{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chromate", "version": "0.1.13", "description": "Organized browser workspaces with preserved tabs.", "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "alarms", "scripting", "identity"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["reddy-panel-handle.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Chromate", "default_icon": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}}, "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Chromate side panel"}, "sleep-inactive-tools": {"description": "Unload inactive Chromate tools"}, "previous-workspace-tab": {"description": "Select the previous open tab in the current Chromate workspace", "global": true}, "next-workspace-tab": {"description": "Select the next open tab in the current Chromate workspace", "global": true}}}