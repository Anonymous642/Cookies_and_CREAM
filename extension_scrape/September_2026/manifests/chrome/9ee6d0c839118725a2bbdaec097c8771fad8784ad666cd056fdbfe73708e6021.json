{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OCR Texte Extractor Pro \u2014 Image, PDF & Word vers Texte", "version": "1.2.4", "description": "Extrayez le texte d'images, captures d'\u00e9cran, PDF et Word (OCR), 100% hors-ligne, multilingue et priv\u00e9.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "OCR Texte Extractor Pro"}, "background": {"service_worker": "src/background/background.js"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "clipboardWrite", "downloads", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "options_page": "src/options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/capture.js"], "css": ["src/content/capture.css"], "run_at": "document_idle"}], "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Capturer une zone de l'\u00e9cran pour l'OCR"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["lib/tesseract/*", "lib/tessdata/*", "lib/pdfjs/*", "lib/jszip/*", "src/result/*"], "matches": ["<all_urls>"]}]}