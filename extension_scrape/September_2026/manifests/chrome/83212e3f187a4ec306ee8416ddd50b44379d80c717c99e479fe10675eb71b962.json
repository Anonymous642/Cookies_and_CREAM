{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sylva Capture", "version": "1.0.0", "description": "Capture Slack, Outlook, and web content into Sylva", "permissions": ["storage", "alarms", "scripting", "contextMenus"], "optional_host_permissions": ["https://*.slack.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "host_permissions": ["https://app.mysylva.app/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_page": "options/options.html", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}