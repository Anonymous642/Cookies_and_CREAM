{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Search in Incognito", "version": "1.0.0", "description": "Fast private search from toolbar, context menu, and keyboard shortcuts.", "action": {"default_title": "Search in Incognito", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus", "tabs", "commands", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "scripting", "activeTab"], "host_permissions": ["https://*.google.com/*", "https://duckduckgo.com/*", "https://search.brave.com/*", "https://www.startpage.com/*"], "commands": {"private-search": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Open private search"}, "private-search-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Search selected text privately"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}