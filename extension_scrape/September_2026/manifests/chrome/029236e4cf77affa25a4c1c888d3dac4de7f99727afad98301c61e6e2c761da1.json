{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HTML to Markdown", "description": "Convert web pages to clean Markdown \u2014 optimized for AI understanding", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "contextMenus", "offscreen", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"convert-page": {"suggested_key": {"default": "Alt+M"}, "description": "Convert current page to Markdown"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "HTML \u2192 MD", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}