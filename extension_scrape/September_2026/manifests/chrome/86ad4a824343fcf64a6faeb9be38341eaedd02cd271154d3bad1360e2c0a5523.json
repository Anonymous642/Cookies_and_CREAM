{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chive: Recipes & Nutrition", "description": "See recipe nutrition, read recipes from articles, and save, shop, or plan meals with Chive.", "version": "0.1.7", "short_name": "Chive", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "116", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://www.chive.recipes/*"]}, "web_accessible_resources": [{"resources": ["icon-32.png", "fonts/fraunces-var.woff2", "fonts/instrument-sans-var.woff2", "fonts/ibm-plex-mono-400.woff2", "fonts/ibm-plex-mono-600.woff2"], "matches": ["http://*/*", "https://*/*"]}, {"resources": ["content-scripts/recipe-popover.css"], "use_dynamic_url": true, "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.chive.recipes; img-src 'self' data: https://www.chive.recipes https://www.chive.recipes https://*.public.blob.vercel-storage.com; style-src 'self' 'unsafe-inline'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Chive", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/recipe-popover.js"]}]}