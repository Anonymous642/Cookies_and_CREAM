{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flickr URL Grabber", "version": "1.0", "description": "Collect high-resolution Flickr image URLs while browsing. Click photos to save full-size URLs for downloading.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "View Collected Images", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.flickr.com/*"], "js": ["content.js"], "run_at": "document_start"}]}