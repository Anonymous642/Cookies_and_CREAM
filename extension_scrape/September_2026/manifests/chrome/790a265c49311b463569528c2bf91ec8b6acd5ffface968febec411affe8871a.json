{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MyScrive", "short_name": "MyScrive", "version": "0.2.2", "description": "AI writing copilot. Multi-model (Claude, GPT, Gemini) with native Gmail integration, 25+ output languages, and style controls.", "permissions": ["storage", "sidePanel", "contextMenus", "scripting", "activeTab", "clipboardWrite"], "host_permissions": ["https://myscrive.com/*", "https://www.myscrive.com/*", "https://*.myscrive.com/*", "http://localhost:3000/*", "https://mail.google.com/*", "<all_urls>"], "externally_connectable": {"matches": ["https://myscrive.com/*", "https://www.myscrive.com/*", "https://*.myscrive.com/*", "http://localhost:3000/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open MyScrive", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "css": ["content/gmail.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "exclude_matches": ["https://mail.google.com/*"], "js": ["content/universal.js"], "css": ["content/universal.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content/overlay-host.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["sidepanel/*", "overlay/*", "lib/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Open MyScrive side panel"}, "open-overlay": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift