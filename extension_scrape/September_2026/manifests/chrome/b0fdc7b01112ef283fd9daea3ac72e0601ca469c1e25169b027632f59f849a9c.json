{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeepMemo", "version": "1.0.1", "description": "Capture highlights to your personal knowledge base \u2014 deepmemo.io", "permissions": ["activeTab", "storage", "contextMenus", "scripting"], "host_permissions": ["https://*.deepmemo.io/*"], "action": {"default_title": "DeepMemo - Save highlights", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"save-selection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Save selection as DeepMemo"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}