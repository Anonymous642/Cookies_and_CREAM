{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeSwipe", "description": "Save YouTube video ideas into a swipe file with one right-click.", "version": "1.2.1", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["contextMenus", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://img.youtube.com/*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_popup": "popup.html", "default_title": "TubeSwipe"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}