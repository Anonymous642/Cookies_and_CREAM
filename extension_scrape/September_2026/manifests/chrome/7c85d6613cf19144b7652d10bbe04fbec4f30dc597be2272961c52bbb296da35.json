{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Group Toggle", "version": "1.0.0", "description": "One hotkey to expand or collapse the current tab's group. Works in vertical and horizontal tabs.", "permissions": ["tabs", "tabGroups"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Tab Group Toggle", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-group": {"suggested_key": {"default": "Ctrl+G", "mac": "MacCtrl+G"}, "description": "Expand/collapse current tab's group"}}}