{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JayBoard", "version": "0.1.2", "description": "Select images, videos, and links on any webpage and save them into your own library - organized into projects, tagged, searchable.", "minimum_chrome_version": "120", "action": {"default_title": "JayBoard", "default_popup": "pages/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "pages/options/index.html", "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle image selection mode on the current page"}, "toggle-oneclick": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle one-click mode: a click sends that image to your active project"}}, "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}