{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResellHub Crosslister", "version": "1.0.0", "description": "Auto-fill your ResellHub listings on Facebook Marketplace, eBay, Depop, Poshmark, Etsy, and more.", "action": {"default_popup": "popup.html", "default_title": "ResellHub Crosslister", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.facebook.com/marketplace/*", "*://*.depop.com/*", "*://*.poshmark.com/*", "*://*.ebay.com/*", "*://*.etsy.com/*", "*://*.vinted.com/*", "*://*.mercari.com/*", "*://*.offerup.com/*", "*://*.whatnot.com/*", "*://*.nextdoor.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.facebook.com/*", "*://*.depop.com/*", "*://*.poshmark.com/*", "*://*.ebay.com/*", "*://*.etsy.com/*", "*://*.vinted.com/*", "*://*.mercari.com/*", "*://*.offerup.com/*", "*://*.whatnot.com/*", "*://*.nextdoor.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}