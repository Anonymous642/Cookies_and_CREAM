{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zombie Tab Defense", "version": "1.0.0", "description": "Auto-close the browser tabs created by deep links when your apps launch externally. Keep your browser clean and clutter-free.", "permissions": ["storage", "tabs", "activeTab", "notifications"], "host_permissions": ["https://figma.com/*", "https://www.figma.com/*", "https://sketch.com/*", "https://www.sketch.com/*", "https://framer.com/*", "https://www.framer.com/*", "https://miro.com/*", "https://www.miro.com/*", "https://notion.so/*", "https://www.notion.so/*", "https://airtable.com/*", "https://www.airtable.com/*"], "content_scripts": [{"matches": ["https://figma.com/*", "https://www.figma.com/*", "https://sketch.com/*", "https://www.sketch.com/*", "https://framer.com/*", "https://www.framer.com/*", "https://miro.com/*", "https://www.miro.com/*", "https://notion.so/*", "https://www.notion.so/*", "https://airtable.com/*", "https://www.airtable.com/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ZombieTabDefense", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}