{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BurnTest Recorder", "short_name": "BurnTest", "description": "One-click screen + voice recording of the tab you're reviewing for burntest.io. No share picker, tab audio included.", "version": "1.1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "BurnTest Recorder", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs"], "host_permissions": ["https://burntest.io/*"], "externally_connectable": {"matches": ["https://burntest.io/*"]}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Start / stop recording the current tab"}}, "minimum_chrome_version": "116"}