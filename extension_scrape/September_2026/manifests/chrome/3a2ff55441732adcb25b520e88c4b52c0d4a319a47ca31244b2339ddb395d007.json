{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VeriHuman - AI Text Humanizer & Detector", "version": "1.0.1", "description": "Humanize AI-generated text and detect AI content directly from any webpage", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "activeTab", "clipboardWrite", "notifications"], "host_permissions": ["https://www.verihuman.xyz/*", "https://docs.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/main.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"humanize-text": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Humanize selected text"}, "detect-ai": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Detect AI in selected text"}}}