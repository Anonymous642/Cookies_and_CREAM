{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hubu: Nota de consulta para tu software veterinario", "short_name": "Hubu", "version": "0.4.0", "description": "Dicta o selecciona, y Hubu escribe la nota cl\u00ednica y el mensaje al tutor en el software veterinario que ya usas.", "author": "Hubu", "homepage_url": "https://workspace.hubu.com.co", "minimum_chrome_version": "116", "icons": {"16": "iconos/16.png", "32": "iconos/32.png", "48": "iconos/48.png", "128": "iconos/128.png"}, "permissions": ["storage", "identity", "sidePanel", "activeTab"], "host_permissions": ["http://localhost:8001/*", "https://workspace.hubu.com.co/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: http://localhost:8001 https://workspace.hubu.com.co"}, "background": {"service_worker": "dist/fondo.js"}, "commands": {"abrir-hubu": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Dictar en el campo donde est\u00e1 el cursor"}}, "side_panel": {"default_path": "panel.html"}, "action": {"default_title": "Hubu", "default_popup": "popup.html", "default_icon": {"16": "iconos/16.png", "32": "iconos/32.png", "48": "iconos/48.png", "128": "iconos/128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://claude.ai/*", "https://*.google.com/*"], "js": ["dist/contenido.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["iconos/glifo-48.png"], "matches": ["http://*/*", "https://*/*"]}]}