{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn AI Blocker", "version": "1.2.0", "description": "Hide LinkedIn images marked with Content Credentials (CR) as AI-generated. Free, local, no uploads.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "LinkedIn AI Blocker", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["*://www.linkedin.com/*", "*://linkedin.com/*"], "content_scripts": [{"matches": ["*://www.linkedin.com/*", "*://linkedin.com/*"], "js": ["src/content/content.bundle.js"], "css": ["src/content/styles.css"], "run_at": "document_idle", "all_frames": false}]}