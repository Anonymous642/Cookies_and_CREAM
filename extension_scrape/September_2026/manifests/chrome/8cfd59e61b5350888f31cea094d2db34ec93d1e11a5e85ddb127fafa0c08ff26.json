{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Code Citation", "version": "0.1.0", "description": "Copy selected GitHub lines as a stable, commit-pinned Markdown citation.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://github.com/*/*/blob/*"], "js": ["core.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}