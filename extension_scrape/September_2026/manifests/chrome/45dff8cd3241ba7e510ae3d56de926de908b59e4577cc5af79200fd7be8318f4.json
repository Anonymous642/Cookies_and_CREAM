{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabloomy: Tab Manager & Session Saver", "short_name": "Tabloomy", "version": "1.1.0", "version_name": "1.1.0 \u2014 Folders, Multi-language & Onboarding", "description": "Save tab sessions into organized workspaces, free up computer memory instantly, and restore your work with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_title": "Tabloomy", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabs", "storage", "tabGroups", "contextMenus"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Tabloomy popup"}, "search_tabs": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Search saved workspaces"}}}