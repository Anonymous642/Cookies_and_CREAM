{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EmoteBeat", "version": "0.1.4", "minimum_chrome_version": "116", "description": "Synchronize animated Twitch chat emotes to the beat of the stream you are watching.", "permissions": ["tabCapture", "offscreen", "storage", "scripting"], "host_permissions": ["https://www.twitch.tv/*", "https://7tv.io/*", "https://cdn.7tv.app/*", "https://api.betterttv.net/*", "https://cdn.betterttv.net/*", "https://static-cdn.jtvnw.net/*", "https://irc-ws.chat.twitch.tv/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "EmoteBeat", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["twitch/content-script.js"], "run_at": "document_idle"}]}