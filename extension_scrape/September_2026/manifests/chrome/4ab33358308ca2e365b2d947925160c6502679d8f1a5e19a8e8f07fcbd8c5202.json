{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Zipsale Crosslisting Plugin", "description": "Crosslist second-hand items to different marketplaces", "version": "0.0.91", "manifest_version": 3, "permissions": ["tabs", "scripting", "cookies", "storage", "webRequest", "alarms", "idle", "declarativeNetRequest"], "host_permissions": ["https://web.zipsale.co.uk/*", "http://127.0.0.1:8000/*", "*://*.vinted.co.uk/*", "*://*.facebook.com/*", "*://*.vestiairecollective.com/*", "*://*.ipapi.co/*", "*://*.depop.com/*"], "action": {"default_icon": "icons/logo.png", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*"], "js": ["marketplaces/facebook/network_interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.facebook.com/marketplace/*"], "js": ["lib/jquery-3.6.1.min.js", "marketplaces/facebook/parsing.js", "marketplaces/facebook/facebook.js"]}, {"matches": ["https://web.zipsale.co.uk/*", "https://web.zipsale.co.uk/users/settings/marketplaces*", "http://127.0.0.1:8000/*"], "js": ["chrome_extension_id_injection.js"]}, {"matches": ["https://web.zipsale.co.uk/*", "http://127.0.0.1:8000/*"], "js": ["windowAlert.js"]}], "externally_connectable": {"matches": ["https://web.zipsale.co.uk/*", "http://127.0.0.1:8000/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/zipsale_16.png", "32": "icons/zipsale_32.png", "48": "icons/zipsale_48.png", "128": "icons/zipsale_128.png"}}