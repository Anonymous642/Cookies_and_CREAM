{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Spoiler Blocker", "version": "1.0.2", "description": "Blur YouTube thumbnails and hover previews so nothing spoils a video \u2014 and hide sports scores in titles, keeping team names.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "YouTube Spoiler Blocker", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}]}