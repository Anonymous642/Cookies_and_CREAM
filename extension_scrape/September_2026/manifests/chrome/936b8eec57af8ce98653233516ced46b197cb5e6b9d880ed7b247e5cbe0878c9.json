{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WorkTab - Tab Manager & Organizer", "description": "Organize tabs into workspaces, auto-save sessions, group by domain, and restore easily. Best tab manager for Chrome.", "version": "1.0.11", "action": {"default_popup": "popup.html", "default_title": "WorkTab - Tab Manager & Organizer"}, "background": {"service_worker": "background.js"}, "permissions": ["tabs", "storage", "tabGroups", "scripting", "contextMenus", "alarms", "activeTab", "system.memory", "bookmarks", "topSites", "notifications"], "host_permissions": ["http://*/*", "https://*/*"], "chrome_url_overrides": {"newtab": "fullpage.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["site-popover.js"], "css": ["site-popover.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}], "commands": {"open-fullpage": {"suggested_key": {"mac": "Command+Shift+F", "default": "Alt+Shift+F"}, "description": "Open WorkTab Full Page View"}, "create-new-workspace": {"suggested_key": {"mac": "Command+Shift+N", "default": "Alt+Shift+N"}, "description": "Create new workspace with current tab"}, "unsuspend-all-tabs": {"suggested_key": {"mac": "Command+Shift+Z", "default": "Alt+Shift+Z"}, "description": "Unsuspend all suspended tabs"}}}