{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dawn Board", "version": "1.3.1", "description": "New tab board: clock, dated tasks, links, notes, search. Free stays local. Pro syncs the board via ExtHub.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "alarms", "notifications"], "chrome_url_overrides": {"newtab": "newtab.html"}, "host_permissions": ["https://exthub.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://exthub.app/*"], "js": ["exthub-handoff.js"], "run_at": "document_idle"}]}