{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dev Blink - Request Error Monitor", "description": "Visual feedback for failed HTTP requests. Blinks your page with color-coded alerts on localhost.", "version": "1.0.0", "author": "Developer Tools", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html", "default_title": "Dev Blink - Monitor localhost errors"}, "content_scripts": [{"matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "js": ["js/content_script.js"], "run_at": "document_start"}], "host_permissions": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "background": {"service_worker": "js/background.js"}, "permissions": ["storage", "webRequest"]}