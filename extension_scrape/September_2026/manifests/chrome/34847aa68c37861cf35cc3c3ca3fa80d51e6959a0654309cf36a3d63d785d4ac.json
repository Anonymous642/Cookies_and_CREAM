{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SAM Copier - URL Manager", "short_name": "SAM Copier", "version": "1.0.1", "description": "URL management tool for 3D Market Places. Copy product URLs from open tabs or purchase history with one click.", "author": "GetSAM.app", "homepage_url": "https://getsam.app", "permissions": ["tabs", "clipboardWrite", "activeTab", "scripting"], "host_permissions": ["https://3dsky.org/*"], "action": {"default_popup": "popup.html", "default_title": "SAM Copier - Copy 3DSky URLs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://3dsky.org/user/purchases*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"copy-tab-urls": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Copy all open tab URLs"}, "copy-page-products": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Copy products from current page"}}, "background": {"service_worker": "background.js"}}