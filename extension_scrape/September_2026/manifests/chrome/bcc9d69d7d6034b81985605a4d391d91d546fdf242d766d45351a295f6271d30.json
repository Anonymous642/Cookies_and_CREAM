{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mantis \u2014 Private Screen Recorder for Bug Reports", "description": "Private screen recorder with video, console, network and repro steps \u2014 no sign-up for local capture, no broad always-on access.", "version": "1.1.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "key": "", "author": {"email": "support@mantis.sh"}, "homepage_url": "https://mantis.sh", "externally_connectable": {"matches": ["https://api.mantis.sh/*", "https://mantis.sh/*"]}, "host_permissions": ["https://api.mantis.sh/*"], "web_accessible_resources": [{"resources": ["camera-embed.html"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "commands": {"draw": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Option+Shift+D"}, "description": "Enable Drawing tool."}, "annotate": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Option+Shift+A"}, "description": "Activate Annotation tool."}, "capture": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Option+Shift+R"}, "description": "Start screen capture."}, "screenshot": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Option+Shift+S"}, "description": "Take a screenshot."}}, "permissions": ["activeTab", "storage", "alarms", "offscreen", "contextMenus", "unlimitedStorage", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://mantis.sh/*"], "run_at": "document_start", "js": ["content-scripts/status.js"]}]}