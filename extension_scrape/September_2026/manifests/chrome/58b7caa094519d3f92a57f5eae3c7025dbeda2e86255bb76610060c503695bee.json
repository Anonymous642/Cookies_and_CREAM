{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Quran Reader", "description": "Read, search, bookmark and listen to the Holy Quran from your side panel.", "version": "1.15", "manifest_version": 3, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["sidePanel", "storage", "identity"], "host_permissions": ["https://prelive-oauth2.quran.foundation/*", "https://oauth2.quran.foundation/*", "https://apis-prelive.quran.foundation/*", "https://apis.quran.foundation/*", "https://api.quran.com/*", "https://verses.quran.foundation/*", "https://verses.quran.com/*", "https://download.quranicaudio.com/*", "https://audio.qurancdn.com/*", "https://*.workers.dev/*", "https://quran-extension-api.yusuf-fachroni.my.id/*"], "side_panel": {"default_path": "src/pages/panel/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icon-128.png", "icon-32.png", "icon-16.png", "icon-48.png", "assets/*"], "use_dynamic_url": false}]}