{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CheckFlow Browser Relay", "version": "2026.4.1.1", "description": "Connect your AI agent to Chrome. Automate browsing, extract data, fill forms \u2014 100% local, no cloud. Powered by CheckFlow.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["debugger", "tabs", "activeTab", "storage", "alarms", "webNavigation", "notifications", "clipboardWrite", "contextMenus"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "CheckFlow Browser Relay", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"attach-tab": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Attach current tab"}, "detach-tab": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Detach current tab"}, "toggle-safe-mode": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle safe mode"}}, "default_locale": "en", "web_accessible_resources": [{"resources": ["help.html", "onboard.html", "onboard.js", "uninstall.html"], "matches": ["<all_urls>"]}]}