{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault", "version": "1.0.1", "description": "Save and organize all your tabs into named collections. Restore anytime. Private, clutter-free, and built to keep you in flow.", "permissions": ["tabs", "storage"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all open tabs as a new collection"}, "add-current-tab": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add current tab to an existing collection"}, "quick-restore": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Quick restore last saved collection"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}