{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Citadel Vault", "version": "0.6.12", "description": "Password manager with autofill, autosave, TOTP codes, vaults, and strong password suggestions.", "permissions": ["storage", "activeTab", "tabs", "scripting", "clipboardRead", "clipboardWrite", "windows"], "host_permissions": ["http://localhost/*", "https://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Citadel Vault", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "panel.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "http://tauri.localhost/*", "https://tauri.localhost/*", "https://*.vercel.app/*", "https://miniapps.webebble.com/*", "https://citedalvault.com/*", "https://www.citedalvault.com/*"]}, "web_accessible_resources": [{"resources": ["icons/icon-128.png", "icons/icon-48.png", "icons/icon-32.png", "icons/citadel-logo.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.bundle.js"], "css": ["content.css"], "run_at": "document_idle"}]}