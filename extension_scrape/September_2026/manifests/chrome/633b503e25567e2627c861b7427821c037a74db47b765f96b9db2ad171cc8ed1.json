{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recurl \u2014 Request Recorder & Copy as cURL", "short_name": "Recurl", "version": "1.0.4", "minimum_chrome_version": "125", "description": "Record API traffic across tabs, inspect request details, copy cURL commands, and export sessions for Postman.", "author": "Asish Kumar", "icons": {"16": "src/assets/icons/icon16.png", "32": "src/assets/icons/icon32.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}, "action": {"default_title": "Recurl \u2014 open recorder", "default_icon": {"16": "src/assets/icons/icon16.png", "32": "src/assets/icons/icon32.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}}, "side_panel": {"default_path": "src/ui/panel.html"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["debugger", "tabs", "storage", "unlimitedStorage", "sidePanel", "clipboardWrite"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start / stop recording"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}