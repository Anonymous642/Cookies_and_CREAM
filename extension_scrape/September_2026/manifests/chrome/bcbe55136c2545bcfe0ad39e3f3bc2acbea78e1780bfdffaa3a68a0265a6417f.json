{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pagesong: Read Aloud with a Natural Voice", "short_name": "Pagesong", "version": "1.0.0", "minimum_chrome_version": "120", "description": "Listen to web pages in a natural English voice. The voice runs in your browser, and page text is never sent anywhere.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage", "offscreen"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Pagesong", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"read-selection": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read the selection, or the page if nothing is selected"}}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"}}