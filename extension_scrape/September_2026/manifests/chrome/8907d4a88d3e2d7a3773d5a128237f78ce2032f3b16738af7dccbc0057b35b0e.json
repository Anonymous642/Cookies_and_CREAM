{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI to NotebookLM", "version": "1.1.1", "description": "Capture AI chats and pages, then create new NotebookLM notebooks and import the content automatically.", "default_locale": "en", "permissions": ["activeTab", "contextMenus", "downloads", "identity", "identity.email", "scripting", "storage", "tabs"], "host_permissions": ["https://notebooklm.google.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "AI to NotebookLM", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "commands": {"capture-active-tab": {"description": "__MSG_cmdCaptureActiveTab__"}, "open-notebooklm": {"description": "__MSG_cmdOpenNotebookLM__"}}, "content_scripts": [{"matches": ["https://notebooklm.google.com/*"], "js": ["content/notebooklm-panel.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content/ai-capture.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/notebooklm-mark.svg", "assets/notebooklm-logo.svg"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"]}]}