{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Solo Recorder", "version": "0.0.1", "description": "Captures clicks, navigation, and keyboard focus on recorded pages, relaying them to Solo (soloapp.so), a local test-recording app.", "permissions": ["tabs", "windows", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Solo Recorder"}, "externally_connectable": {"matches": ["https://soloapp.so/*", "https://www.soloapp.so/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "recorder@soloapp.so", "strict_min_version": "121.0"}}}