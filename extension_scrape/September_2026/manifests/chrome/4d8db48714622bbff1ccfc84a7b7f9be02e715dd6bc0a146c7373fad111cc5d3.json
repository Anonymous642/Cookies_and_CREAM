{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdShield Pro - Advanced Ad Blocker", "version": "1.0.1", "description": "The most powerful ad blocker for Chrome. Block ads, trackers, malware, and protect your privacy. All free. Manifest V3 compatible.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "webNavigation", "contextMenus"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "basic_filters", "enabled": true, "path": "rules/basic_filters.json"}, {"id": "privacy_filters", "enabled": true, "path": "rules/privacy_filters.json"}, {"id": "premium_filters", "enabled": true, "path": "rules/premium_filters.json"}, {"id": "social_filters", "enabled": true, "path": "rules/social_filters.json"}, {"id": "annoyances_filters", "enabled": true, "path": "rules/annoyances_filters.json"}]}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}