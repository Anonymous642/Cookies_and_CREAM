{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jarvis", "version": "2.3.30", "description": "Let Jarvis read and reply in tabs you share with it. Shared tabs sit in a coloured group; drag a tab out to stop sharing.", "externally_connectable": {"matches": ["https://power-x.com/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["*://*.linkedin.com/*", "*://*.messenger.com/*", "*://*.facebook.com/*"], "permissions": ["tabs", "tabGroups", "storage", "alarms", "sidePanel", "contextMenus", "scripting", "activeTab"], "commands": {"send-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Send this page to Jarvis"}}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Jarvis", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "minimum_chrome_version": "125"}