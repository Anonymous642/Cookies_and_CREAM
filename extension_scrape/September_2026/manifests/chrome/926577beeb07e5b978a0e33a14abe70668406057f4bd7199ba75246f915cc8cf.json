{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DepWall \u2014 package verdicts", "version": "0.4.0", "description": "See the verdict DepWall's install-time gate would return for an npm or PyPI package. It reports; it does not block.", "homepage_url": "https://depwall.com/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://api.depwall.com/*"], "content_scripts": [{"matches": ["https://www.npmjs.com/package/*", "https://pypi.org/project/*"], "js": ["src/content.js"], "css": ["src/badge.css", "src/meter.css"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "DepWall", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "options_ui": {"page": "src/options.html", "open_in_tab": false}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open DepWall"}}, "optional_host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["src/detect.js", "src/confidence.js"], "matches": ["https://*/*"]}]}