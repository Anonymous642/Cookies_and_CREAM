{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hyperfocus Pomodoro", "version": "1.0.0", "description": "Boost productivity with Pomodoro. Blocks distracting sites during focus, allows during breaks. Chimes and notifications.", "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "sw.js"}, "action": {"default_title": "Hyperfocus Pomodoro", "default_popup": "popup.html"}, "options_page": "options.html", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["block.html", "block.css"], "matches": ["<all_urls>"]}], "commands": {"toggle": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Start/Stop Pomodoro"}, "skip": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Skip to next phase"}}}