{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TailorSearch", "version": "1.0", "description": "Tailor your job search with custom filters for experience level, keywords and more, find the right opportunities faster.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.glassdoor.com/*", "*://*.monster.com/*", "*://*.dice.com/*", "*://*.careerbuilder.com/*", "*://*.ziprecruiter.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.glassdoor.com/*", "*://*.monster.com/*", "*://*.dice.com/*", "*://*.careerbuilder.com/*", "*://*.ziprecruiter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["*.png", "*.css"], "matches": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.glassdoor.com/*", "*://*.monster.com/*", "*://*.dice.com/*", "*://*.careerbuilder.com/*", "*://*.ziprecruiter.com/*"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "author": "jwycd25@gmail.com", "homepage_url": "https://github.com/jycd25", "minimum_chrome_version": "88"}