{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Home Depot Price Tracker", "version": "2.5", "description": "Tracks item prices on homedepot.com across different stores.", "permissions": ["storage", "alarms", "system.display", "offscreen", "geolocation", "scripting"], "host_permissions": ["https://www.homedepot.com/*", "https://apionline.homedepot.com/*", "https://images.thdstatic.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["popup.css", "notification.html", "notification.js", "offscreen.html", "offscreen.js"], "matches": ["<all_urls>"]}]}