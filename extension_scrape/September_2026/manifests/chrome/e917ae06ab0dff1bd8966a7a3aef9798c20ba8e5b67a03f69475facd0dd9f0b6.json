{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon.com Price Tracker", "version": "1.8.3", "description": "Track Amazon.com product prices locally. Get alerts on price drops or when target price is reached.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "notifications", "tabs", "alarms", "scripting"], "host_permissions": ["https://www.amazon.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content.js", "match.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/amazon-favicon.png", "icons/icon48.png", "icons/animation.gif"], "matches": ["<all_urls>"]}]}