{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Patriot Copy", "version": "0.1.0", "description": "Copy page HTML, visible text, and console into a prepared prompt for AI", "permissions": ["activeTab", "scripting", "tabs", "clipboardWrite", "debugger", "storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-console-capture.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject-console-capture.js"], "matches": ["<all_urls>"]}], "commands": {"copy-page-prompt": {"suggested_key": {"mac": "Command+Shift+P", "default": "Ctrl+Shift+P"}, "description": "Copy page text (HTML + visible text + console)"}, "copy-page-prompt-with-screenshot": {"suggested_key": {"mac": "Command+Shift+S", "default": "Ctrl+Shift+S"}, "description": "Copy page prompt + screenshot"}, "toggle-console-from-load": {"suggested_key": {"mac": "Command+Shift+O", "default": "Ctrl+Shift+O"}, "description": "Toggle capture console from page load (full console; shows Chrome banner when on)"}}}