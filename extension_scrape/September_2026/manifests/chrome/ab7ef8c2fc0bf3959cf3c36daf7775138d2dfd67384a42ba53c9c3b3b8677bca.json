{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Friction Gate", "version": "0.1.1", "description": "Interrupt mindless scrolling with a 10 second pause before distracting websites like Reddit, X, and YouTube.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["declarativeNetRequestWithHostAccess", "storage", "alarms"], "host_permissions": ["*://*.reddit.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["src/gate.html"], "matches": ["<all_urls>"], "use_dynamic_url": true}]}