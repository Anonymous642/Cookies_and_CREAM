{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RequestPilot \u2014 HTTP Header & Request Modifier", "version": "1.1.0", "description": "Modify HTTP request and response headers for development and testing. Fast, secure, privacy-first.", "permissions": ["storage", "declarativeNetRequest", "tabs", "alarms", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "RequestPilot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/options/index.html", "devtools_page": "src/devtools/devtools.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle RequestPilot"}, "profile-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Activate Profile Slot 1"}, "profile-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Activate Profile Slot 2"}, "profile-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Activate Profile Slot 3"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}