{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MyReaderApp", "version": "2.1.0", "description": "L\u00e6ser tekst op med ord-for-ord markering og lader dig skrive med stemmen. Bygget til ordblinde. Virker ogs\u00e5 i Word og Google Docs.", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "tabs", "clipboardRead", "clipboardWrite", "alarms", "webNavigation", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared/math.js", "shared/utils.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://docs.google.com/document/*"], "js": ["shared/gdocs-annotate.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_title": "MyReaderApp"}, "commands": {"read-selected": {"description": "L\u00e6s markeret tekst"}, "toggle-pause": {"description": "Pause / Forts\u00e6t"}, "scan-region": {"description": "Scan et omr\u00e5de og l\u00e6s op"}, "dictate": {"description": "Indtal: skriv med stemmen, hvor mark\u00f8ren st\u00e5r"}}, "web_accessible_resources": [{"resources": ["shared/gdocs-bridge.js"], "matches": ["*://docs.google.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}