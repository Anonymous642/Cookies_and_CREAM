{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snap Availability for Google Calendar", "description": "Generate a screenshottable version of your Google Calendar to send to someone and help with finding availability.", "version": "1.2.1", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Snap Availability", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://calendar.google.com/calendar/*"], "js": ["content.js"], "run_at": "document_idle"}]}