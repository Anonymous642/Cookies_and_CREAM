{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Conduktor: Command Palette for the browser", "description": "A keyboard-first command bar for browser actions and faster navigation.", "version": "2.1.1", "short_name": "Conduktor", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "bookmarks", "clipboardWrite", "favicon", "offscreen", "sessions", "scripting", "storage", "tabs", "tabGroups"], "host_permissions": ["https://api.polar.sh/*"], "action": {"default_title": "Conduktor", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "switch-previous-tab": {"suggested_key": {"default": "Ctrl+Q", "mac": "Alt+Q"}, "description": "Switch to previous tab"}, "copy-tab-url": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy tab URL"}}, "background": {"service_worker": "background.js"}}