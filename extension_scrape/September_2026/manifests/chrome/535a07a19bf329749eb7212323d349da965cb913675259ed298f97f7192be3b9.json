{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "One23 Truckstop Removal", "description": "Removes the top bars and left sidebar on Truckstop so the load table fills the screen. Click the icon to bring them back.", "version": "1.0.7", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.truckstop.com/*", "https://truckstop.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Bars hidden. Click to show them", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.truckstop.com/*", "https://truckstop.com/*"], "css": ["hide.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}