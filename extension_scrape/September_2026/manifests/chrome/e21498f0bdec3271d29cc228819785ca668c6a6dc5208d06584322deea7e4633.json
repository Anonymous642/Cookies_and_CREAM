{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoPinner: Pinterest Auto-Fill & Scheduler", "version": "1.0.0", "description": "Automate Pinterest pin creation using Google Sheets. Save hours by auto-filling titles, descriptions, links, and boards.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["*://*.pinterest.com/*", "*://*/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "icons": {"128": "icons/icon128.png"}, "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "js": ["src/content/content.js"], "css": ["dist/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dist/content.css"], "matches": ["*://*.pinterest.com/*"]}]}