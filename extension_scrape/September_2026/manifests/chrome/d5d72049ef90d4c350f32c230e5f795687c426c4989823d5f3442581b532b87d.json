{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blockedin", "version": "2.1.5", "description": "The ultimate LinkedIn job search filter - Block companies, keywords, and recruiters from your job search", "permissions": ["storage", "activeTab", "webNavigation", "contextMenus"], "host_permissions": ["*://www.linkedin.com/*", "https://app.posthog.com/*", "https://us.i.posthog.com/*", "https://eu.i.posthog.com/*"], "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["analytics.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/Blockedin.svg", "icons/Blockedin-t.svg"], "matches": ["*://www.linkedin.com/*"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Toggle Blockedin panel"}, "quick-block": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Quick block focused company"}}}