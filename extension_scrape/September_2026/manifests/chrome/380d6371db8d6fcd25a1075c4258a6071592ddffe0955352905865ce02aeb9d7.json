{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeCap \u2014 YouTube Tab & Time Limiter", "version": "1.0.0", "description": "Limit YouTube tabs by count, cumulative video duration, or both. Take control of your time.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/duration-extractor.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/main-world-extractor.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/block-overlay.js"], "run_at": "document_end"}], "web_accessible_resources": []}