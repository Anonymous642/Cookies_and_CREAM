{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Persona - Multiple Accounts for Any Website", "short_name": "Persona", "version": "1.0.0", "description": "Keep several logins for the same site and switch between them in one click. No Incognito windows, no juggling Chrome profiles.", "author": {"email": "mohameddrawesh2000@gmail.com"}, "minimum_chrome_version": "120", "permissions": ["cookies", "storage", "unlimitedStorage", "tabs", "scripting", "browsingData", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Persona", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/agent.js"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open the session picker"}, "cycle-session": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Switch to the next session for this site"}}}