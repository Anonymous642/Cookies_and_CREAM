{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hoodmaps for Airbnb", "version": "0.4.0", "description": "Overlay Hoodmaps neighborhood data on Airbnb maps \u2014 see which areas are touristy, hip, rich, or suits.", "permissions": ["storage", "scripting", "webNavigation"], "host_permissions": ["https://hoodmaps.com/*", "https://www.airbnb.com/*", "https://www.airbnb.co.uk/*", "https://www.airbnb.ca/*", "https://www.airbnb.com.au/*", "https://www.airbnb.de/*", "https://www.airbnb.fr/*", "https://www.airbnb.es/*", "https://www.airbnb.it/*", "https://www.airbnb.pt/*", "https://www.airbnb.nl/*", "https://www.airbnb.co.in/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.airbnb.com/*", "https://www.airbnb.co.uk/*", "https://www.airbnb.ca/*", "https://www.airbnb.com.au/*", "https://www.airbnb.de/*", "https://www.airbnb.fr/*", "https://www.airbnb.es/*", "https://www.airbnb.it/*", "https://www.airbnb.pt/*", "https://www.airbnb.nl/*", "https://www.airbnb.co.in/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16_inactive.png", "48": "icons/icon48_inactive.png", "128": "icons/icon128_inactive.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["data/autocomplete_cities.json", "assets/fonts/*.woff2"], "matches": ["<all_urls>"]}]}