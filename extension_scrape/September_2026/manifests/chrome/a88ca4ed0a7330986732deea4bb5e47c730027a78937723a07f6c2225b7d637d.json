{"name": "UK Visa Sponsors Pro", "short_name": "UK Visa Sponsors Pro", "version": "1.2.1", "manifest_version": 3, "description": "Discover if a company offers UK Visa sponsorship while browsing job listings on LinkedIn, Indeed, Glassdoor, and Google Jobs.", "icons": {"16": "images/uk_logo_16x16.png", "48": "images/uk_logo_48x48.png", "96": "images/uk_logo_96x96.png", "128": "images/uk_logo_128x128.png"}, "action": {"default_icon": "images/uk_logo_128x128.png", "default_popup": "popup.html", "default_title": "UK Visa Checker Pro works automatically on LinkedIn, Indeed, Glassdoor, and Google job search pages."}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["hello.html"], "matches": ["<all_urls>"]}], "permissions": ["tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"css": ["styles/tailwind.css"], "js": ["content.js"], "matches": ["*://*.linkedin.com/*", "*://*.uk.indeed.com/*", "*://*.glassdoor.co.uk/*", "*://www.google.com/*"], "run_at": "document_idle"}], "update_url": "https://clients2.google.com/service/update2/crx"}