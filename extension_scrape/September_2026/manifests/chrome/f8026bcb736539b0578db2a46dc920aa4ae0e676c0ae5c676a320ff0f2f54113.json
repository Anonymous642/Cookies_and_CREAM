{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy URL and title of current tab as clickable link with keyboard shortcut", "description": "Copy URL with title of the current tab in multiple formats. Customize keyboard shortcuts or simply click to the extension button!", "version": "1.1.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["clipboardWrite", "activeTab", "scripting", "storage"], "host_permissions": ["https://www.google-analytics.com/"], "action": {"default_popup": "popup.html", "default_title": "Copy URL & Title", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "theme_icons": [{"light": "icons/icon16.png", "dark": "icons/icon16-dark.png", "size": 16}, {"light": "icons/icon32.png", "dark": "icons/icon32-dark.png", "size": 32}, {"light": "icons/icon48.png", "dark": "icons/icon48-dark.png", "size": 48}, {"light": "icons/icon128.png", "dark": "icons/icon128-dark.png", "size": 128}]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Activate extension"}, "copy-plain": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy as plain text"}, "copy-rich": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Copy as clickable link"}, "copy-markdown": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Copy as markdown"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}}