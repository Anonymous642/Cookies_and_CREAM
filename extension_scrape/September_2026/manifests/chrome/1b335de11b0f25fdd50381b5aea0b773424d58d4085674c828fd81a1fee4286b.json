{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jarvis Helpdesk Copilot", "description": "AI-powered copilot for Jarvis Helpdesk \u2014 lookup knowledge and manage tickets from any tab", "version": "1.0.1", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "permissions": ["sidePanel", "storage", "tabs", "notifications", "offscreen", "alarms"], "host_permissions": ["https://*.jarvis.cx/*"], "externally_connectable": {"matches": ["https://*.jarvis.cx/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src http://localhost:* https://*.jarvis.cx;"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://localhost/*", "https://*.jarvis.cx/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}