{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NookSpeak - Animal Crossing Text to Speech", "short_name": "NookSpeak", "version": "1.2.3", "description": "Read selected webpage text with Animal Crossing-style Animalese audio, animated dialogue, custom voices, and keyboard shortcuts.", "author": "NookSpeak Team", "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_title": "NookSpeak Settings"}, "background": {"service_worker": "background.js"}, "commands": {"read-selected-text": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Read selected text with NookSpeak"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["dialogue.html", "dialogue.js", "improved-animalese.js", "popup.html", "popup.js", "popup.css", "sounds/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}