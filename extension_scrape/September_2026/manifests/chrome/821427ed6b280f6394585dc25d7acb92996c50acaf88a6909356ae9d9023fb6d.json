{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdvaTab - Advanced Tab Manager", "short_name": "AdvaTab", "version": "0.1.0", "description": "Save, organize, search, and restore tab groups. Keep tabs locally or sync them through your own encrypted server.", "minimum_chrome_version": "120", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AdvaTab - Advanced Tab Manager", "default_popup": "index.html"}, "permissions": ["tabs", "storage", "tabGroups", "bookmarks", "alarms", "contextMenus", "notifications"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open AdvaTab"}, "save-all-tabs": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save all tabs to AdvaTab"}, "save-left-tabs": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Alt+Shift+Left"}, "description": "Save tabs to the left"}, "save-right-tabs": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Alt+Shift+Right"}, "description": "Save tabs to the right"}}}