{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Guard - Instant Stealth", "short_name": "Tab Guard - Instant Stealth", "version": "1.0.0", "description": "Hide tabs in one keypress with a custom decoy page, Instant Lock, Auto-Return, and optional Master Lock for restores.", "author": "Szentivanszky Sandor", "minimum_chrome_version": "88", "permissions": ["tabs", "scripting", "storage", "alarms", "browsingData", "sessions"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Tab Guard - Instant Stealth", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "commands": {"instant-lock-toggle": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Instant Lock ON: hide all other tabs in the window; OFF: toggle only the active tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["auth_overlay.js"], "run_at": "document_idle"}]}