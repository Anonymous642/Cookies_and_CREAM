{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabBoard", "version": "2.0.3", "description": "Advanced tab session manager. Save, restore, and organize your browser sessions by boards/profiles with import/export functionality.", "author": "TabBoard Team", "homepage_url": "https://ko-fi.com/bucklemeshoe", "icons": {"16": "icons/tabboard-icon-16.png", "48": "icons/tabboard-icon-48.png", "128": "icons/tabboard-icon-128.png"}, "permissions": ["tabs", "storage", "commands", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TabBoard - Tab Session Manager", "default_icon": {"16": "icons/tabboard-icon-16.png", "48": "icons/tabboard-icon-48.png", "128": "icons/tabboard-icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Activate the extension"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}