{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FavSync Metaimage", "version": "1.0.0", "description": "Grabs and previews the metadata image (og:image, twitter:image, etc.) of the current tab.", "permissions": ["scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://favsync.com/*", "http://localhost/*", "http://127.0.0.1/*", "https://*.favsync.com/*"], "js": ["metaimage-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}