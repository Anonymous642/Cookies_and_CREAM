{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Picseta", "description": "Auto-fill Shutterstock contributor forms with AI metadata. Connect Picseta and fill title, description, and keywords in one click.", "version": "1.0.1", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://picseta.com/*", "http://localhost/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Picseta", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.shutterstock.com/contributor*", "*://shutterstock.com/contributor*", "*://submit.shutterstock.com/*"], "run_at": "document_idle", "js": ["content-scripts/contributor.js"]}]}