{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boring-X", "version": "1.1", "options_page": "usage.html", "description": "Chrome extension to make X(formerly Twitter) boring.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "idle", "sidePanel"], "action": {"default_title": "Open Boring-X Side Panel"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["config.js", "content.js"], "run_at": "document_end"}]}