{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat Privacy Screen", "version": "3.0.0", "minimum_chrome_version": "114", "description": "Blur chats on WhatsApp, Telegram & Arattai \u2014 hover to reveal. Zero data, no account, no servers.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://web.whatsapp.com/*", "https://web.telegram.org/*", "https://web.arattai.in/*"], "action": {"default_title": "Chat Privacy Screen", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "css": ["privacy.css"], "run_at": "document_idle"}, {"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "css": ["telegram-privacy.css"], "run_at": "document_idle"}, {"matches": ["https://web.arattai.in/*"], "js": ["content.js"], "css": ["arattai-privacy.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-privacy": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P", "windows": "Alt+Shift+P", "linux": "Alt+Shift+P", "chromeos": "Alt+Shift+P"}, "description": "Toggle chat privacy mode"}}}