{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notebook LM Tab Collector", "version": "2.1", "permissions": ["tabs", "activeTab", "scripting"], "host_permissions": ["https://notebooklm.google.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/app_icon.png", "32": "assets/app_icon.png", "48": "assets/app_icon.png", "128": "assets/app_icon.png"}, "action": {"default_popup": "popup.html", "default_icon": "assets/app_icon.png"}, "content_scripts": [{"matches": ["https://notebooklm.google.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["content.js"], "matches": ["https://notebooklm.google.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "description": "Send open tab URLs to Google Notebook LM (NotebookLM) with one click \u2014 fast, easy source collection for research."}