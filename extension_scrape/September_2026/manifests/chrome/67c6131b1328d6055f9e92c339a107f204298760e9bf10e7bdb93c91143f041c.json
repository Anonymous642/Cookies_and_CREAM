{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OverTube \u2014 Speed, Volume, OCR & More for YouTube", "version": "0.0.1", "description": "Power tools for YouTube, volume 0-300%, A-B loop, 4x speed, screenshot edit, sleep timer, transcript copy, per-video notes, and OCR.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["ocr.html", "ocr.js", "tesseract/*"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}