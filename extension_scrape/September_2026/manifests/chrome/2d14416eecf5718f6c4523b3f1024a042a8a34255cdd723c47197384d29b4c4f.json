{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KahfGuard", "short_name": "KahfGuard", "description": "Applies KahfGuard's website rules and daily time limits inside the browser. Needs the KahfGuard service running on this computer.", "version": "1.4.0", "author": "Kahf Software Ltd", "minimum_chrome_version": "120", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs", "alarms", "storage", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["policy-rules.js", "risky-words.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "KahfGuard", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "web_accessible_resources": [{"resources": ["blocked.html", "pause.html"], "matches": ["<all_urls>"]}]}