{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Batch Downloader for Meta AI", "version": "1.2.0", "description": "Batch-download your own AI-generated videos and images from Meta AI (meta.ai) in one click. Free and unlimited.", "default_locale": "en", "permissions": ["downloads", "activeTab", "scripting", "sidePanel", "storage"], "host_permissions": ["https://www.meta.ai/*", "https://meta.ai/*", "https://*.fbcdn.net/*", "https://*.cdninstagram.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Batch Downloader for Meta AI"}, "side_panel": {"default_path": "popup.html?panel=1"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.meta.ai/*", "https://meta.ai/*"], "js": ["content.js"], "run_at": "document_idle"}]}