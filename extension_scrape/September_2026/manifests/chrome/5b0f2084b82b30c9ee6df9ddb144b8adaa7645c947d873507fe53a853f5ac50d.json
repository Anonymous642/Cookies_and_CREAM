{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GSheet Quick single tab export", "description": "Downloads the current active google sheet tab", "version": "1.0.0", "manifest_version": 3, "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["https://docs.google.com/spreadsheets/d/*", "https://docs.googleusercontent.com/*"], "action": {"default_title": "Export this tab", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html"}