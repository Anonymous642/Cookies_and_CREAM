{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tong", "description": "Rewrite X posts, replies, and DMs into natural English. Tong never posts or sends for you.", "version": "0.1.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["https://tong.awes.it.kr/*"], "homepage_url": "https://tong.awes.it.kr", "web_accessible_resources": [{"resources": ["tong-bot.svg"], "matches": ["https://x.com/*"]}], "commands": {"rewrite-focused": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Rewrite the current X composer"}}, "action": {"default_title": "Tong settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}