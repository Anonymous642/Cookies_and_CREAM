{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DemoShots BETA", "description": "THIS EXTENSION IS FOR BETA TESTING. Record, edit, and export product demo videos locally.", "version": "0.1.2", "icons": {"16": "brand/extension-icons/icon-16.png", "32": "brand/extension-icons/icon-32.png", "48": "brand/extension-icons/icon-48.png", "128": "brand/extension-icons/icon-128.png"}, "action": {"default_icon": {"16": "brand/extension-icons/icon-16.png", "32": "brand/extension-icons/icon-32.png"}, "default_title": "DemoShots"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src https://tally.so;"}, "commands": {"stop-and-edit": {"description": "Stop recording and open the editor", "suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}}}, "host_permissions": ["http://*/*", "https://*/*"], "minimum_chrome_version": "116", "permissions": ["offscreen", "scripting", "tabCapture", "favicon", "storage"], "web_accessible_resources": [{"matches": ["https://demoshots.com/*", "https://www.demoshots.com/*"], "resources": ["editor.html", "assets/*", "brand/*", "chunks/*", "onnx/*", "visual-system/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://demoshots.com/editor*", "https://www.demoshots.com/editor*"], "run_at": "document_start", "js": ["content-scripts/editor-bridge.js"]}, {"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/telemetry.js"]}]}