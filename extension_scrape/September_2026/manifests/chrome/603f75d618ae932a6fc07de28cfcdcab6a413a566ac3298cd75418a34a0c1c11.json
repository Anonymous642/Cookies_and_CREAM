{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scroll Buddy", "version": "1.0.0", "description": "A friendly buddy that auto-detects articles and forum posts, saves your scroll position, and lets you restore it on your next visit.", "permissions": ["storage", "sidePanel", "tabs", "alarms"], "action": {"default_title": "Scroll Buddy"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-buddy": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Enable or disable the buddy orb"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["assets/icon.svg"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}