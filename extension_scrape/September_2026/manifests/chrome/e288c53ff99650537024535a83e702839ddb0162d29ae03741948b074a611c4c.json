{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PresentSafe", "version": "2.0", "description": "Privacy for presenters. Auto-blurs data & silences pings. Use Alt+Shift+P (Opt+Shift+P on Mac) for an emergency privacy fog.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["storage", "scripting", "tabs", "contextMenus"], "background": {"service_worker": "background.js"}, "commands": {"toggle-panic": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Emergency Privacy Blur"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["privacy-styles.css"]}], "web_accessible_resources": [{"resources": ["dashboard.html", "silence.js"], "matches": ["<all_urls>"]}]}