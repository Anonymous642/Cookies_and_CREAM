{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SnapLingo - AI Language Learning", "description": "Learn any language while browsing. AI word analysis, flashcard review, phrase breakdown. 23 languages supported.", "version": "1.0.5", "manifest_version": 3, "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://translate.googleapis.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://*.workers.dev/*"], "background": {"service_worker": "service-worker.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"js": ["scripts/content.js"], "matches": ["<all_urls>"]}]}