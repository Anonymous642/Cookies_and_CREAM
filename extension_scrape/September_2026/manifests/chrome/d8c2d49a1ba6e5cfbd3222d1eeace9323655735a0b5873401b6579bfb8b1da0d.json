{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Repo \u2013 GitHub Repo Organizer", "version": "1.0.0", "description": "Never lose a GitHub repo again. Organize repos, stars & bookmarks into collections and open any project in 2 clicks.", "action": {"default_popup": "src/popup/popup.html", "default_title": "Quick Repo"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://firestore.googleapis.com/*"], "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}