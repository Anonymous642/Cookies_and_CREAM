{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Navalyze", "description": "Track visited pages and searches locally. Export your history as JSON anytime.", "version": "1.0.0", "action": {"default_popup": "popup.html", "default_title": "Navalyze"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["history", "tabs", "storage", "webNavigation", "downloads"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "commands": {"export-json": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Export logs to a JSON file"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause/Resume logging"}}}