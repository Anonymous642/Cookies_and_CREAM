{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HLF Leads", "version": "1.3.2", "description": "Capture business leads from Google Maps search results and export them with subscription-aware access control.", "permissions": ["storage", "downloads", "tabs", "alarms"], "host_permissions": ["https://www.google.com/*", "https://app.softwareauth.com/*", "https://services.leadconnectorhq.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "HLF Leads", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.google.com/maps/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}