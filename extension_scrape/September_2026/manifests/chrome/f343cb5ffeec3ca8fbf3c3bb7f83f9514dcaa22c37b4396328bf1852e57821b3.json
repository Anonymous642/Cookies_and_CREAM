{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DealFinder", "short_name": "DealFinder", "description": "Detects shopping sites and shows available coupons and deals. Placeholder affiliate IDs included \u2014 replace with your own.", "version": "1.0.1", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.amazon.com/*", "*://*.ebay.com/*", "*://*.bestbuy.com/*", "*://*.asos.com/*", "*://*.etsy.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.ebay.com/*", "*://*.bestbuy.com/*", "*://*.asos.com/*", "*://*.etsy.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}