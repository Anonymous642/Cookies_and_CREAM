{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No Distractions", "version": "1.1.1", "minimum_chrome_version": "114", "author": "Lior Raban", "description": "Tame social media: block sites, hide distracting features (Reels, Shorts, comments), set daily time budgets.", "permissions": ["storage", "declarativeNetRequest", "tabs", "alarms", "webNavigation", "favicon"], "host_permissions": ["*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.linkedin.com/*", "*://web.whatsapp.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "No Distractions", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-focus": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Start or end a 25-minute focus session"}, "block-current-site": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Block or unblock the current tab's site"}}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content/common.js", "content/instagram.js"], "run_at": "document_start"}, {"matches": ["*://*.facebook.com/*"], "js": ["content/common.js", "content/facebook.js"], "run_at": "document_start"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content/common.js", "content/twitter.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/common.js", "content/youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.tiktok.com/*"], "js": ["content/common.js", "content/tiktok.js"], "run_at": "document_start"}, {"matches": ["*://*.reddit.com/*"], "js": ["content/common.js", "content/reddit.js"], "run_at": "document_start"}, {"matches": ["*://*.linkedin.com/*"], "js": ["content/common.js", "content/linkedin.js"], "run_at": "document_start"}, {"matches": ["*://web.whatsapp.com/*"], "js": ["content/common.js", "content/whatsapp.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}