{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Summary", "version": "1.0.3", "description": "Quickly summarize YouTube videos using ChatGPT, Claude, Grok, Gemini, or DeepSeek", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://grok.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*", "https://codemarket.ch/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/ad-skip.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/watch*"], "js": ["content/transcript.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content/chatgpt-autofill.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content/claude-autofill.js"], "run_at": "document_idle"}, {"matches": ["https://grok.com/*"], "js": ["content/grok-autofill.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content/gemini-autofill.js"], "run_at": "document_idle"}, {"matches": ["https://chat.deepseek.com/*"], "js": ["content/deepseek-autofill.js"], "run_at": "document_idle"}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/claude-logo.svg"], "matches": ["https://www.youtube.com/*", "https://youtu.be/*"]}]}