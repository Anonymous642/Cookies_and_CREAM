{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GTMCat Capture", "description": "Capture Reddit through your own logged-in session for GTMCat. Reads only \u2014 never posts or votes.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "tabs", "sidePanel"], "host_permissions": ["*://*.reddit.com/*", "http://localhost:3000/*", "https://app.gtmcat.xyz/*"], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://app.gtmcat.xyz/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "GTMCat Capture", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content-scripts/content.js"]}]}