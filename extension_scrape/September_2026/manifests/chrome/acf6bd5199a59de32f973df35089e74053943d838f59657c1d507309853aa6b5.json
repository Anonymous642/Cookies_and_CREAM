{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Scroll for Instagram Reels - ReelFlow", "short_name": "ReelFlow", "version": "1.2.1", "description": "Auto-scroll Instagram Reels hands-free, with playback speed, auto-mute, and auto-like controls.", "permissions": ["storage"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ReelFlow", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}