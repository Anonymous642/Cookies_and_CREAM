{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Minimal Pinterest Scroller \u2014 Full-Screen Scroll, Save & Analytics", "version": "2.0.0", "description": "Full-screen scrolling, one-click downloads, pin analytics, growth insights, and save-anywhere for Pinterest.", "permissions": ["storage", "downloads", "contextMenus", "tabs", "activeTab", "scripting", "cookies", "alarms", "identity", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.pinterest.com/*"], "js": ["content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.pinterest.com/*"], "js": ["pin-analytics.js"], "run_at": "document_idle"}, {"matches": ["https://*.pinterest.com/*"], "js": ["growth-intelligence.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://*.pinterest.com/*"], "js": ["save-anywhere.js"], "run_at": "document_idle"}, {"matches": ["https://*.pinterest.com/*"], "js": ["pin-data-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.pinterest.com/pin-creation-tool/*", "https://*.pinterest.com/pin-creation-tool", "https://*.pinterest.com/pin-builder/*", "https://*.pinterest.com/pin-builder"], "js": ["board-extractor.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icons16.png", "48": "icons/icons48.png", "128": "icons/icons128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icons16.png", "48": "icons/icons48.png", "128": "icons/icons128.png"}}