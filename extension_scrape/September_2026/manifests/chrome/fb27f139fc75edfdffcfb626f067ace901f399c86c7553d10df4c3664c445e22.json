{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Browser Assistant", "version": "0.2.1", "description": "AI assistant for web browsing", "permissions": ["activeTab", "storage", "scripting", "sidePanel", "tabs"], "host_permissions": ["https://api.openai.com/*", "<all_urls>"], "action": {"default_title": "AI Browser Assistant"}, "web_accessible_resources": [{"resources": ["locales/*.json"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"]}], "options_page": "src/options/options.html", "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open/close chat panel"}}}