{"manifest_version": 3, "name": "Intent Browser Guard", "version": "0.2.14", "description": "Enforces active Intent browser rules inside Google Chrome.", "update_url": "https://clients2.google.com/service/update2/crx", "icons": {"48": "icons/intent-48.png", "128": "icons/intent-128.png"}, "permissions": ["nativeMessaging", "storage", "tabs", "webNavigation", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Intent Browser Guard", "default_popup": "popup.html", "default_icon": {"48": "icons/intent-48.png", "128": "icons/intent-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["rule-helpers.js", "content-guard.js"], "run_at": "document_start", "all_frames": true}]}