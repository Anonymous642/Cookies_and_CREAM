{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Channel Blocker", "version": "1.0.1", "description": "Block YouTube channels on Home, Search, and Shorts. Local blocklist with export/import. No account, no tracking.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/lib/channel-id.js", "src/lib/storage.js", "src/lib/surfaces.js", "src/lib/shorts.js", "src/lib/selectors.js", "src/lib/engine.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "action": {"default_title": "YouTube Channel Blocker", "default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}