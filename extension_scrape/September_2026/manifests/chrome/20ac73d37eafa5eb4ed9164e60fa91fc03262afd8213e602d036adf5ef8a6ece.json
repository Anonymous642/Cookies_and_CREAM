{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MensorAI: AI Note Taker for YouTube", "description": "Free transcript viewer, notes, and AI Q&A for any YouTube video. Build a searchable library of everything you watch.", "version": "2.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "scripting", "cookies", "alarms"], "host_permissions": ["https://*.youtube.com/*", "https://www.mensorai.com/*"], "action": {"default_title": "MensorAI", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["icon/*"], "matches": ["https://*.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "mensorai@mensorai.com", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/shorts/*", "https://*.youtube.com/watch*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}, {"matches": ["https://mensorai.com/*", "https://www.mensorai.com/*"], "run_at": "document_start", "js": ["content-scripts/webapp-auth-bridge.js"], "world": "ISOLATED"}, {"matches": ["https://mensorai.com/*", "https://www.mensorai.com/*"], "run_at": "document_end", "js": ["content-scripts/webapp-auth.js"], "world": "MAIN"}]}