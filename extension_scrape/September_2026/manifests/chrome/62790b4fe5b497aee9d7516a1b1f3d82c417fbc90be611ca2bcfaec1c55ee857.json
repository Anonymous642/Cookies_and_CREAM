{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Angular Code Review \u2014 PR Reviewer", "version": "1.0.0", "description": "Static Angular code reviews for GitHub, GitLab, Azure DevOps, and Bitbucket pull/merge requests.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.github.com/*", "https://gitlab.com/*", "https://dev.azure.com/*", "https://api.bitbucket.org/*"], "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["https://github.com/*/pull/*", "https://gitlab.com/*/-/merge_requests/*", "https://dev.azure.com/*/_git/*/pullrequest/*", "https://bitbucket.org/*/pull-requests/*"], "js": ["src/platforms/github.js", "src/platforms/gitlab.js", "src/platforms/azureDevOps.js", "src/platforms/bitbucket.js", "src/rules/rules.js", "src/rules/checklistData.js", "src/rules/ruleMapping.js", "src/rules/versionGating.js", "src/rules/fixExamples.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "action": {"default_title": "Angular Code Review", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html"}