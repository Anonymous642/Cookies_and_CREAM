{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PhishNet", "version": "1.1.0", "description": "In-browser phishing detection for webmail. Analyzes emails locally with AI and shows inline risk overlays.", "permissions": ["activeTab", "alarms", "idle", "offscreen", "storage"], "optional_permissions": ["identity"], "oauth2": {"client_id": "YOUR_GCP_OAUTH_CLIENT_ID.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]}, "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-gmail.js"], "css": ["overlay.css", "onboarding-inline.css", "quarantine-inline.css"], "run_at": "document_idle"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*"], "js": ["content-outlook.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"matches": ["https://mail.yahoo.com/*"], "js": ["content-yahoo.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://mail.yahoo.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}