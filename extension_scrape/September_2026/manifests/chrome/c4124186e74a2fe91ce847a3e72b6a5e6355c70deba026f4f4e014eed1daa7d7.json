{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Drupal Localization Assistant (German)", "version": "1.7.0", "author": "Drupal Translation Community", "description": "Speeds up German UI localization on localize.drupal.org with free machine translation and batch approval.", "icons": {"16": "droppy_square.png", "32": "droppy_square.png", "48": "droppy_square.png", "128": "droppy_square.png"}, "permissions": ["storage"], "host_permissions": ["https://localize.drupal.org/*", "https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*", "https://www.drupal.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://localize.drupal.org/*"], "js": ["content-i18n.js", "content-core.js", "content-editor-modal.js", "content-changelog.js", "content-init.js", "content-site-localization.js", "content-review-assistant.js", "content-dark-theme.js", "content-page-loader.js", "content-panel-ui.js", "content-batch-translate.js", "content-tour-clippy.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["GUI Block.svg", "droppy.png", "clippy-core.mjs", "clippy-data.mjs", "clippy-sprite.png", "CHANGELOG.md", "CHANGELOG.en.md"], "matches": ["https://localize.drupal.org/*"]}], "action": {"default_title": "Drupal Localization Assistant (German)", "default_popup": "options.html", "default_icon": {"16": "droppy_square.png", "32": "droppy_square.png", "48": "droppy_square.png", "128": "droppy_square.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"editor-direct-rework": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Bearbeiten-Modal: Direkt \u00fcberarbeiten"}, "editor-next": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Bearbeiten-Modal: Weiter"}, "editor-prev": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Bearbeiten-Modal: Zur\u00fcck"}, "editor-don