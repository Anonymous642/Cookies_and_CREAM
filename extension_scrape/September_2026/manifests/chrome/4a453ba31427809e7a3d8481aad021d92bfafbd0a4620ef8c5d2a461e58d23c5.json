{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WakeMark", "description": "Search your X bookmarks, import full history, ask AI, and check X search visibility \u2014 powered by WakeMark.", "version": "0.2.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "sidePanel", "tabs", "alarms", "scripting"], "host_permissions": ["https://wakemark.app/*"], "optional_host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.x.com/*", "https://abs.twimg.com/*"], "externally_connectable": {"matches": ["https://wakemark.app/*"]}, "action": {"default_title": "WakeMark", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: https: blob:;"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://wakemark.app/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://twitter.com/i/bookmarks*", "https://x.com/i/bookmarks*"], "run_at": "document_start", "js": ["content-scripts/x-bookmarks-hook.js"], "world": "MAIN"}, {"matches": ["https://twitter.com/i/bookmarks*", "https://x.com/i/bookmarks*"], "run_at": "document_idle", "js": ["content-scripts/x-bookmarks.js"]}]}