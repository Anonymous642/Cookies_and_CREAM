{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Free Telegram Web Translator", "description": "Translate visible messages in Telegram Web from a simple popup.", "version": "0.1.0", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://web.telegram.org/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_title": "Free Telegram Web Translator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}