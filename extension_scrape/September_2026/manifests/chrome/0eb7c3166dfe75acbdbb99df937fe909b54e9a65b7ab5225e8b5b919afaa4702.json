{"update_url": "https://clients2.google.com/service/update2/crx", "name": "PowCal Helper", "short_name": "PowCal", "description": "Redirect Google Calendar links and downloaded calendar files from your browser to the PowCal app.", "author": "Thomas Bachem <mail@thomasbachem.com>", "version": "1.1", "key": "", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "browser-ext@powcal.com"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open in PowCal", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png"}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["*://calendar.google.com/*"], "js": ["redirect.js"]}], "declarative_net_request": {"rule_resources": [{"id": "ruleset", "enabled": true, "path": "rules.json"}]}, "permissions": ["activeTab", "declarativeNetRequest", "downloads"], "host_permissions": ["*://calendar.google.com/*"]}