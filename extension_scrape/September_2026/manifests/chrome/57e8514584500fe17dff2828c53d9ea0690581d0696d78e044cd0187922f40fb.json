{"update_url": "https://clients2.google.com/service/update2/crx", "name": "YT Summarizer \u2014 AI Video Summary", "description": "Get instant AI-powered summaries of any YouTube video. Save time, watch smarter.", "version": "1.4.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["content/content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background/background.js"}, "permissions": ["storage", "scripting"], "host_permissions": ["*://*.youtube.com/*", "https://youtubetranscript.com/*"], "commands": {"run-summary": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize current video"}}, "web_accessible_resources": [{"resources": ["icons/*", "inject/inject.js"], "matches": ["*://*.youtube.com/*"]}]}