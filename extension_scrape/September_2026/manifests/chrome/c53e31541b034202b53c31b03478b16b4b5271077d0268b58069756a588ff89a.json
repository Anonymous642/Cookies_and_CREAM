{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebDAV Drive", "version": "0.1.0", "description": "A native WebDAV File System Provider for ChromeOS. It mounts remote WebDAV shares into the ChromeOS Files App.", "permissions": ["fileSystemProvider", "storage", "unlimitedStorage", "webRequest", "webRequestAuthProvider"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service_worker.js", "type": "module"}, "icons": {"16": "img/icon-16.png", "32": "img/icon-32.png", "48": "img/icon-48.png", "128": "img/icon-128.png"}, "file_system_provider_capabilities": {"configurable": true, "watchable": false, "multiple_mounts": true, "source": "network"}}