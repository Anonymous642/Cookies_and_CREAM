{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zrcade Deployer", "description": "Publish Google AI Studio projects to Zrcade in one click\u2014no manual export/import. \u5728 Google AI Studio \u4e00\u952e\u53d1\u5e03\u81f3 Zrcade\uff0c\u544a\u522b\u624b\u52a8\u5bfc\u51fa\u5bfc\u5165\u3002", "version": "1.8", "permissions": ["storage", "scripting", "tabs", "declarativeNetRequest"], "host_permissions": ["https://aistudio.google.com/*", "https://zrcade.ai/*", "https://zrcade-web.onrender.com/*"], "declarative_net_request": {"rule_resources": [{"id": "zrcade_origin_rules", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Zrcade Deployer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://aistudio.google.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://aistudio.google.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED"}, {"matches": ["https://zrcade.ai/*"], "js": ["zrcade_content.js"], "run_at": "document_start", "world": "ISOLATED"}]}