{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SpaceSnap - Tab Workspace Saver", "version": "0.0.3", "description": "Snap your tabs. Free your mind. Save browser windows as named Spaces with one click.", "permissions": ["storage", "tabs", "tabGroups", "contextMenus", "alarms"], "background": {"service_worker": "controller.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "commands": {"snap-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Snap all tabs in current window"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "manifest_version": 3}