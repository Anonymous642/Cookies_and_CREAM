{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Translator: Captions, Transcript & AI Summary with ChatGPT & Claude", "version": "1.0.23", "description": "YouTube transcript, translation in 100+ languages, one-click summary via ChatGPT & Claude. Free & unlimited. No signup.", "background": {"service_worker": "background.js"}, "permissions": ["storage", "identity", "identity.email", "cookies"], "host_permissions": ["https://www.youtube.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://translate.googleapis.com/*", "https://www.newdev.net/*", "https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["page-bridge.js"], "all_frames": false, "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["config.js", "index.js", "js/translator.js", "content.js"], "all_frames": false, "type": "module"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["index.js"], "all_frames": false, "type": "module"}, {"matches": ["https://claude.ai/*"], "js": ["index.js"], "all_frames": false, "type": "module"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://www.youtube.com/*"]}], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}}