{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Formular Screenshot Tracker", "description": "Generiere automatisch Screenshots der Formulardaten von Webseiten die du besuchst und speichere sie innerhalb vom Browser.", "version": "1.5", "permissions": ["tabs", "activeTab", "storage", "unlimitedStorage", "notifications"], "default_locale": "en", "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html"}, "web_accessible_resources": [{"resources": ["presentation/presentation.html"], "matches": ["<all_urls>"]}]}