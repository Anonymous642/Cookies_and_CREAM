{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GrokBuster", "version": "1.2.0", "description": "The BEST tool to bust Grok spam on X/Twitter. Reclaim your timeline by hiding Grok tweets, navigation links, in real-time.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "GrokBuster"}}