{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Commentra \u2014 YouTube Comment Analyser", "version": "0.1.1", "description": "AI-powered YouTube comment analysis. Sentiment, topics, FAQs, virality & competitor tracking.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "activeTab", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://commentra.io/*", "http://localhost:3000/*", "http://127.0.0.1:8000/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Commentra \u2014 analyse this video's comments", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["content.js"], "matches": ["https://www.youtube.com/*", "https://*.youtube.com/*"]}]}