{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Radar", "version": "1.0.0", "description": "Instantly see what Reddit thinks about any product, service, or website you're browsing.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_title": "Reddit Radar"}, "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://*/*", "http://*/*"]}