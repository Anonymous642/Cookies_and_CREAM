{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Talishar Helper \u2014 Token & Keyword Overlay", "version": "1.3.0", "description": "Enhance your Talishar.net experience with token info overlays and keyword hints on hover.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://talishar.net/*", "https://images.talishar.net/*"], "web_accessible_resources": [{"resources": ["symbols/*.png"], "matches": ["*://talishar.net/*", "*://*.talishar.net/*"]}], "action": {"default_popup": "popup.html", "default_title": "Talishar Helper", "default_icon": {"16": "icons/action16.png", "32": "icons/action32.png"}}, "content_scripts": [{"matches": ["*://talishar.net/*", "*://*.talishar.net/*"], "js": ["card_keywords.js", "content.js"], "css": ["content.css"], "all_frames": true, "run_at": "document_start"}]}