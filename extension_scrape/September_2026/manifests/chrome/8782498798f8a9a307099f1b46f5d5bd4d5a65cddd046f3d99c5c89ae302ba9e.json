{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipler", "version": "1.0.2", "description": "Save frequently used text and images as cards, and copy them to your clipboard with a single click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["storage", "clipboardWrite", "clipboardRead", "unlimitedStorage"], "web_accessible_resources": [{"resources": ["locales/*.json", "onboarding/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "\u958b\u555f Clipler"}, "open_window": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open Clipler in a separate window"}}}