{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Wiki Enhancer", "version": "1.0.0", "description": "Enhance GitHub repository pages with DeepWiki and CodeWiki quick access buttons", "host_permissions": ["https://github.com/*"], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://github.com/*/*"], "js": ["js/content.js"], "run_at": "document_idle", "css": ["css/content.css"]}], "action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "GitHub Wiki Enhancer"}, "web_accessible_resources": [{"resources": ["images/*.svg", "images/*.jpg"], "matches": ["https://github.com/*"]}], "author": "weetime001@gmail.com"}