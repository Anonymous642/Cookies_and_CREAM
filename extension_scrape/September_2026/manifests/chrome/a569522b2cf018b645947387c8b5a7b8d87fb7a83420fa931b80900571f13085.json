{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSlurp", "version": "3.0.1", "description": "Save and restore browser tab sessions with ease", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage"], "action": {"default_popup": "popup.html", "default_title": "TabSlurp - Save & Restore Sessions", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last session"}}}