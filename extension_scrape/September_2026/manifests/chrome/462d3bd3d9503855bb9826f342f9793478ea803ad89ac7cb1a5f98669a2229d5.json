{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClientRadar \u2014 Find Clients on Facebook, Reddit, X & LinkedIn", "version": "1.0.5", "description": "ClientRadar watches Facebook Groups, Reddit, X and LinkedIn for people asking for what you sell, then drafts the reply on autopilot.", "background": {"service_worker": "background.js"}, "action": {"default_title": "Open ClientRadar", "default_icon": "icons/smalllogo.png"}, "icons": {"16": "icons/smalllogo.png", "48": "icons/smalllogo.png", "128": "icons/smalllogo.png"}, "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications", "declarativeNetRequest", "webRequest", "cookies", "offscreen"], "host_permissions": ["*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://abs.twimg.com/*", "*://*.linkedin.com/*", "*://*.licdn.com/*"], "optional_host_permissions": ["https://*/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "networkrule.json"}]}, "content_scripts": [{"matches": ["https://*.facebook.com/messages/*"], "js": ["dm-assist.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://getclientradar.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}