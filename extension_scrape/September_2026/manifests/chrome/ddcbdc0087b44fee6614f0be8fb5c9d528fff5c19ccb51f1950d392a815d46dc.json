{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Email & Phone Extractor \u2014 Web Lead Finder", "version": "1.1.0", "description": "Extract emails, phone numbers & social links from any website. Bulk scan URLs, export to CSV/JSON. Free lead scraper.", "permissions": ["activeTab", "storage", "sidePanel", "tabs", "notifications"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Email & Phone Extractor", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"open-popup": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Open Email & Phone Extractor"}}, "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["<all_urls>"]}]}