{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "XFocused", "version": "1.0.0", "description": "Enhanced X (Twitter) tools - search replies, track history and more!", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["utils.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "XFocused Settings"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}