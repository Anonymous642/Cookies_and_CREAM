{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Message Designer Pro", "version": "1.0.1", "description": "Design beautiful WhatsApp messages in seconds. Templates, variables, unicode fonts, emoji, signatures & one-click paste.", "author": "Appsgain Technologies", "minimum_chrome_version": "114", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WhatsApp Message Designer Pro", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "sidePanel"], "host_permissions": ["https://web.whatsapp.com/*"], "web_accessible_resources": [{"resources": ["sidepanel/*", "lib/*", "icons/*"], "matches": ["https://web.whatsapp.com/*"]}], "commands": {"open-designer": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Open Message Designer"}, "paste-template": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Paste last template into chat"}, "save-message": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current message"}, "search-templates": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Search templates"}}}