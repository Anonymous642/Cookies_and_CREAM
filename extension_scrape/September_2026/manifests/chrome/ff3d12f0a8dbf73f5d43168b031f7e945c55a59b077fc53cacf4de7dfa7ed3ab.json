{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "C.I \u00b7 YouTube Home Filter", "version": "0.8.2", "description": "Filtra o feed inicial do YouTube por visualiza\u00e7\u00f5es, inscritos, data e VPH. Salve canais favoritos por categoria.", "icons": {"16": "icons/ci-logo.png", "48": "icons/ci-logo.png", "128": "icons/ci-logo.png"}, "action": {"default_title": "C.I \u00b7 YouTube Home Filter", "default_icon": {"16": "icons/ci-logo.png", "48": "icons/ci-logo.png", "128": "icons/ci-logo.png"}}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.googleapis.com/*", "https://www.comunidadeinvisivel.com.br/*", "https://comunidadeinvisivel.com.br/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/ci-logo.png"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}