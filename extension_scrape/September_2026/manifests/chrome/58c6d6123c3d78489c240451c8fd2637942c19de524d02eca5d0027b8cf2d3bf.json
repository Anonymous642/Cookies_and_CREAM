{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResellerLedger \u2014 Sales & Profit Tracker", "version": "0.3.0", "description": "Track reseller sales & profit across eBay, Mercari, Poshmark & Depop in one place. Add costs, export a tax-ready CSV.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.ebay.com/*", "https://www.mercari.com/*", "https://poshmark.com/*", "https://www.depop.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.ebay.com/sh/ord*", "https://www.ebay.com/mesh/ord*", "https://www.ebay.com/mye/myebay/sold*", "https://www.ebay.com/mye/myebay/v2/sold*"], "js": ["src/parsers/core.js", "src/parsers/ebay.js", "src/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.mercari.com/mypage/*", "https://www.mercari.com/transaction/*"], "js": ["src/parsers/core.js", "src/parsers/mercari.js", "src/content.js"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/order/*", "https://poshmark.com/closet*", "https://poshmark.com/myshop*"], "js": ["src/parsers/core.js", "src/parsers/poshmark.js", "src/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.depop.com/*"], "js": ["src/parsers/core.js", "src/parsers/depop.js", "src/content.js"], "run_at": "document_idle"}], "options_page": "options/options.html"}