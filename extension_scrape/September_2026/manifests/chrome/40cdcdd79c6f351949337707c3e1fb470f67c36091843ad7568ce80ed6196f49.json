{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SponsorSpot - Dutch Sponsor Job Finder", "version": "1.8.5", "description": "Check LinkedIn and Indeed jobs from Dutch companies authorized to sponsor Kennismigrant (Highly Skilled Migrant) visas.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["https://*.linkedin.com/*", "https://*.indeed.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["sponsors.json", "company_aliases.json", "welcome.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}}