{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SlayTab \u2014 One tab instead of twenty", "version": "3.52.2", "description": "Save the tab you're on, or every tab in the window, straight into your SlayTab workspace.", "homepage_url": "https://slaytab.com", "minimum_chrome_version": "116", "permissions": ["tabs", "storage", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Save to SlayTab", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"save-current-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current tab to SlayTab"}, "save-all-tabs": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Save every tab in this window to SlayTab"}, "open-slaytab": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open SlayTab"}}, "chrome_url_overrides": {"newtab": "newtab.html"}}