{"manifest_version": 3, "name": "eBay Order Export Tool", "version": "1.2", "description": "A powerful tool to export eBay orders to Excel. Support batch export, custom date range and multiple order status filtering.", "default_locale": "en", "permissions": ["storage", "tabs", "activeTab", "background", "windows"], "host_permissions": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.com.au/*", "*://*.ebay.com.ca/*", "*://*.kodepay.cn/*", "*://*.kodepay.io/*"], "action": {"default_popup": "popup.html", "default_title": "eBay Order Export Tool", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.com.au/*", "*://*.ebay.com.ca/*"], "js": ["lib/jquery.min.js", "lib/xlsx.full.min.js", "lib/file.saver.js", "content.js"], "run_at": "document_end"}, {"matches": ["*://*.kodepay.io/*"], "js": ["dist/kodepayContent.bundle.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["lib/jquery.min.js", "lib/xlsx.full.min.js", "lib/file.saver.js", "images/*", "pages/*", "styles/*", "node_modules/kodepay/dist/*", "dist/*", "config/config.json"], "matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.com.au/*", "*://*.ebay.com.ca/*", "*://*.kodepay.io/*", "<all_urls>"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "dist/background.bundle.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self'"}, "chrome_url_overrides": {"subscription": "subscription.html"}, "options_page": "options.html", "update_url": "https://clients2.google.com/service/update2/crx"}