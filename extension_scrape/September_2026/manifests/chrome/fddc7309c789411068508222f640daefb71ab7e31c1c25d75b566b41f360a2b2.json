{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trigger Checker", "short_name": "TriggerChecker", "version": "1.1.0", "description": "Check for triggers and phobias in what you're watching \u2014 without leaving the page. Supports Netflix, Prime Video, Disney+ and IMDb.", "homepage_url": "https://www.triggerchecker.com", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Trigger Checker"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.triggerchecker.com/*", "https://www.netflix.com/*", "https://www.primevideo.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.com/*", "https://www.disneyplus.com/*", "https://www.imdb.com/*"], "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://www.primevideo.com/*", "https://www.amazon.co.uk/gp/video/*", "https://www.amazon.com/gp/video/*", "https://www.disneyplus.com/*", "https://www.imdb.com/title/*"], "js": ["content.js"], "run_at": "document_idle"}]}