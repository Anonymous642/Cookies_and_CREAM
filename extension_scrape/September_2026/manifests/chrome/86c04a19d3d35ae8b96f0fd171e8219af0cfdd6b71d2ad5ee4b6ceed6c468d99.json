{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KyuCite - Academic Citation Assistant", "description": "Automatically add citations to LaTeX documents in Overleaf", "version": "1.0.0", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"js": ["content.js"], "matches": ["*://*.overleaf.com/*"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.overleaf.com/*", "https://generativelanguage.googleapis.com/*", "https://api.upstage.ai/*", "https://api.semanticscholar.org/*"]}