{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Important! \u2014 Email Alerts", "version": "1.0.1", "description": "Get notified about important emails that match your rules.", "permissions": ["storage", "alarms", "notifications", "sidePanel"], "host_permissions": ["https://api.important-app.com/*", "https://mail.google.com/*"], "note_host_permissions": "localhost URL is replaced by copy-extra.js during build \u2014 set src/config.js SERVER_URL before deploying", "externally_connectable": {"matches": ["https://important-app.com/*", "http://localhost:5173/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {}, "side_panel": {"default_path": "sidepanel/index.html"}, "content_scripts": [{"matches": ["https://api.important-app.com/api/auth/extension-callback*"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Open Important! side panel"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}