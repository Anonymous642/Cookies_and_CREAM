{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shopify Store Inspector - Theme, Apps & Products", "version": "1.1.0", "description": "Detect Shopify themes, apps, products, best sellers & store insights. Privacy-first alternative to Commerce Inspector.", "permissions": ["activeTab", "storage", "sidePanel", "tabs", "webNavigation"], "host_permissions": ["*://*/*", "https://shopify-inspector.winner3.workers.dev/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}