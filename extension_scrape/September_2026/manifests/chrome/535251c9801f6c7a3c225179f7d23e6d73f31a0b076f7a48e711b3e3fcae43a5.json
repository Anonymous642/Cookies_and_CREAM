{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShotPDF: Full Page Screenshot & Webpage to PDF", "short_name": "ShotPDF", "version": "1.1.1", "description": "Take a full page screenshot of any website or a selected area, then save it as an image or PDF. Everything stays on your device.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ShotPDF \u2013 capture this page", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "settings.html", "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus"], "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-selected": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Select an area to capture"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self';"}, "minimum_chrome_version": "116"}