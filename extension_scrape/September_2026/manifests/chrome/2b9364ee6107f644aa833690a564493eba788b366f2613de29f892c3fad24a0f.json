{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Technical SEO - Robots Status & Index Checker", "version": "1.3.0", "description": "Auto-checks robots.txt, meta robots, X-Robots-Tag & canonical. Instant Google index status. Smart icon alerts issues automatically.", "permissions": ["activeTab", "scripting", "tabs", "webRequest"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "Resources/logo-48.png", "128": "Resources/logo-128.png"}}, "icons": {"48": "Resources/logo-48.png", "128": "Resources/logo-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}