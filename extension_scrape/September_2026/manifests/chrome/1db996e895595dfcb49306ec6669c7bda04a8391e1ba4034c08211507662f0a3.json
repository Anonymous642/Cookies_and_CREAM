{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "coffeeinabit - Luma LinkedIn Extractor", "version": "1.0.0", "description": "Extract LinkedIn profiles from Luma events and add them to coffeeinabit campaigns", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://*.luma.com/*", "https://api.coffeeinabit.com/*", "https://api2.luma.com/*", "https://cloud.coffeeinabit.com/*", "https://www.linkedin.com/*", "https://coffeeinabit.auth.us-east-1.amazoncognito.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.luma.com/*"], "js": ["popup/core.js", "content-scripts/content.js"], "run_at": "document_start"}, {"matches": ["https://cloud.coffeeinabit.com/*"], "js": ["popup/core.js", "content-scripts/content-cloud.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["popup/popup.html", "content-scripts/injected-page-script.js", "popup/page-loader.js", "popup/pages/auth-section.html", "popup/pages/linkedin-section.html", "popup/pages/campaign-section.html", "popup/pages/luma-campaign-section.html"], "matches": ["https://*.luma.com/*"]}, {"resources": ["auth/callback.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}