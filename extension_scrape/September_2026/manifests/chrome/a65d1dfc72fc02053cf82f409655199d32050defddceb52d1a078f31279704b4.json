{"manifest_version": 3, "name": "Google Calendar Export GCal to CSV", "short_name": "Calendar Export", "description": "Extracts GCal Events and Search Results into a CSV export. Multiple language support.", "version": "1.2.0", "icons": {"128": "icons/calendar-download.png"}, "background": {"service_worker": "js/background.js"}, "action": {"default_title": "GCal Events Export"}, "content_scripts": [{"matches": ["https://calendar.google.com/calendar/*"], "js": ["js/extractEvents.js"]}], "permissions": ["scripting", "activeTab"], "host_permissions": ["https://calendar.google.com/calendar/*"], "homepage_url": "http://www.github.com/chetanganatra", "update_url": "https://clients2.google.com/service/update2/crx"}