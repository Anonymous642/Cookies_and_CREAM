{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sober Extension", "version": "2.1.0", "description": "Tracks how many days you've gone without visiting certain sites, celebrates milestones, and can optionally block them.", "permissions": ["storage", "webNavigation", "declarativeNetRequest", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Sober Extension", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "icons/*"], "matches": ["<all_urls>"]}]}