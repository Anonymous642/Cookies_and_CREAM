{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roblox Wiki Helper \u2014 Bloxron", "description": "Wiki guides, active codes, and calculators for Roblox games. In-game drawer on Roblox, plus popup and side panel from Bloxron.", "version": "0.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "alarms", "notifications", "sidePanel"], "host_permissions": ["https://bloxron.com/*", "https://r2.bloxron.com/*", "https://www.roblox.com/*", "https://web.roblox.com/*"], "action": {"default_title": "Bloxron Wiki Helper", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["logo.png", "icon-48.png", "icon-128.png"], "matches": ["https://www.roblox.com/*", "https://web.roblox.com/*"]}, {"resources": ["content-scripts/roblox-overlay.css"], "use_dynamic_url": true, "matches": ["https://web.roblox.com/*", "https://www.roblox.com/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://web.roblox.com/games/*", "https://www.roblox.com/games/*"], "js": ["content-scripts/roblox-overlay.js"]}]}