{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Customer City", "description": "Your deals have blind spots. We find them. Real-time health scoring, blind spot detection, and deal insights for Salesforce.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "sidePanel", "alarms", "tabs", "cookies"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "host_permissions": ["https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://app.customercity.com/*", "https://customer-city-api-production.up.railway.app/*"], "externally_connectable": {"matches": ["https://app.customercity.com/*", "http://localhost:3000/*"]}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "Customer City", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*"], "run_at": "document_idle", "js": ["content-scripts/salesforce.js"]}]}