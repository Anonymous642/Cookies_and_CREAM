{"update_url": "https://clients2.google.com/service/update2/crx", "name": "resonote", "description": "Transcribe audio from your current browser tab using Whisper.cpp", "version": "1.08", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "manifest_version": 3, "permissions": ["activeTab", "tabCapture", "scripting", "storage", "tabs", "sidePanel", "nativeMessaging", "webRequest", "audioCapture"], "host_permissions": ["<all_urls>", "https://your-api-domain.com/*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_popup": "popup.html", "default_title": "Start Audio Transcription"}, "side_panel": {"default_path": "sidebar.html"}, "web_accessible_resources": [{"resources": ["transcript.html", "capture.html", "sidebar.html", "mic_permission.html", "login.html", "subscribe-popup.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["http://localhost:5173/*", "http://localhost:5174/*", "http://localhost:3000/*", "http://127.0.0.1:5174/*", "http://127.0.0.1:3000/*", "https://resonote-ai.vercel.app/*"]}}