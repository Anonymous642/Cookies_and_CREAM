{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TAB Back", "description": "This extension provides navigation history for tabs.", "version": "1.0.6", "author": "tkromrych@gmail.com", "key": "", "background": {"service_worker": "js/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';", "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": {"16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "default_popup": "options.html"}, "icons": {"16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "commands": {"back": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "MacCtrl+Shift+K"}, "description": "Back"}, "toggle": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Toggle"}, "forth": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L"}, "description": "Forth"}}, "permissions": ["storage", "notifications"]}