{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlurSite \u2014 hide sensitive info on any page", "description": "Blur, pixelate or black out anything on a webpage before you share your screen. Warns you when sensitive data is exposed.", "version": "1.0.0", "short_name": "BlurSite", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "minimum_chrome_version": "116", "commands": {"toggle-single-click": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Blur an element"}, "toggle-area-select": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Blur an area"}, "toggle-curtain": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hide the whole page (privacy curtain)"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}}}, "action": {"default_title": "BlurSite", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}, {"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/share-guard.js"], "world": "MAIN"}]}