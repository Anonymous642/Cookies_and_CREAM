{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "116", "name": "ReadyStill \u2014 Screenshot to Launch Pack", "short_name": "ReadyStill", "description": "Capture a webpage, polish it locally, review privacy, and export six launch-ready images.", "version": "0.3.1", "permissions": ["activeTab", "scripting", "storage", "alarms"], "optional_permissions": ["clipboardWrite"], "host_permissions": ["https://readystill.app/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Capture with ReadyStill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"capture-viewport": {"suggested_key": {"default": "Ctrl+Shift+5", "mac": "Command+Shift+U"}, "description": "Capture the visible page"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}