{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cursoria \u2014 Cursor Motion Studio", "version": "2.0.1", "description": "A premium-quality cursor studio that lives entirely inside the extension popup.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open Cursoria", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "commands": {"toggle-cursor": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Toggle Cursoria"}, "toggle-presentation": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Toggle presentation spotlight"}}}