{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aquiline Tracking Chrome Extension", "description": "Collect orders across your Amazon accounts and track shipments in Aquiline Tracking App", "version": "1.0.0", "permissions": ["storage", "tabs", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.ca/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*", "https://aquiline-tracking.com/*", "https://*.aquiline-tracking.com/*", "https://*.cloudfunctions.net/*"], "background": {"service_worker": "service_worker.js", "type": "module"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "default_title": "Aquiline Tracking Chrome Extension"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js"], "matches": ["https://*.amazon.com/*", "https://*.amazon.ca/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*"]}], "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.ca/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*"], "css": ["content/overlay.css"], "js": ["content/order-history.js"], "run_at": "document_idle"}]}