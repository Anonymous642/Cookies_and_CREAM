{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabscope", "version": "1.0.2", "description": "Vim tabs, Keyboard-only fuzzy finder for tabs, history and bookmarks, inspired by Vim's telescope.nvim.", "minimum_chrome_version": "114", "permissions": ["tabs", "history", "bookmarks", "scripting", "activeTab", "favicon"], "background": {"service_worker": "sw.js"}, "action": {"default_title": "Open the finder", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"toggle-finder": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the finder"}}, "web_accessible_resources": [{"resources": ["finder.html"], "matches": ["<all_urls>"]}]}