{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteHeist \u2013 Capture Video Frame, Extract Text & Bookmark Video in Notes", "version": "1.3.2", "description": "Capture video frames, extract text from videos, bookmark videos, clip the web, and sync notes across Web and VS Code.", "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "cookies"], "host_permissions": ["https://noteheist.com/*", "https://www.noteheist.com/*", "<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "action": {"default_title": "Open Notes", "default_icon": {"16": "noteheist-icon-16.png", "32": "noteheist-icon-32.png", "48": "noteheist-icon-48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle_panel": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Hide or show Noteheist panel"}}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["index.html", "assets/*", "noteheist-icon.svg", "noteheist-icon-16.png", "noteheist-icon-32.png", "noteheist-icon-48.png", "noteheist-icon-128.png"], "matches": ["<all_urls>"]}], "icons": {"16": "noteheist-icon-16.png", "32": "noteheist-icon-32.png", "48": "noteheist-icon-48.png", "128": "noteheist-icon-128.png"}}