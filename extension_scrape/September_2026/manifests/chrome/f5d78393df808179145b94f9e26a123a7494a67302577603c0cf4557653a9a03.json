{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "XRay - Reputation for X", "version": "1.2.20", "description": "See through the noise. Community-driven reputation scores for X/Twitter profiles.", "permissions": ["storage", "activeTab", "tabs", "alarms", "scripting"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://mainnet.base.org/*", "https://api.xrayrep.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/index.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/index.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles/content.css", "injected/ethereum.js", "icons/sherlock-bones.mp4", "icons/xray-logo.jpg"], "matches": ["https://twitter.com/*", "https://x.com/*"]}], "externally_connectable": {"matches": ["https://xrayrep.com/*", "https://*.xrayrep.com/*"]}}