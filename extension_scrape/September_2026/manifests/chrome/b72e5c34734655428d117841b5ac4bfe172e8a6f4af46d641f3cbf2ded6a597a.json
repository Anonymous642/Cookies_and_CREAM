{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mini Tab Sidebar", "description": "Minimal side panel: every window and its tabs, always expanded, searchable.", "version": "0.1.0", "permissions": ["tabs", "sidePanel", "favicon", "storage", "sessions"], "host_permissions": ["http://127.0.0.1:8975/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Mini Tab Sidebar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+I", "mac": "Command+I"}, "description": "Toggle the tab sidebar"}}}