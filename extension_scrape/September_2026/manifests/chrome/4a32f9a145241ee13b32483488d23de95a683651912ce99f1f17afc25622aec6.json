{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartTab - Tab Manager & History Search", "version": "2.3.3", "description": "Tab manager that searches inside tab content. Organize unlimited tabs, restore closed tabs & browse with complete privacy", "permissions": ["tabs", "storage", "unlimitedStorage", "scripting", "notifications", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SmartTab - View History"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Open SmartTab"}, "toggle-favorite-current": {"suggested_key": {"default": "Alt+D", "mac": "Alt+D"}, "description": "Toggle favorite for current tab"}}, "web_accessible_resources": [{"resources": ["icons/*", "landing/*", "support/*", "privacy/*", "terms/*", "ExtPay.js"], "matches": ["<all_urls>"]}]}