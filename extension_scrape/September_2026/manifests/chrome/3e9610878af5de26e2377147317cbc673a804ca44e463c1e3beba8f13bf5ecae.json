{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AudioTube", "version": "1.0.0", "description": "Play YouTube audio-only in the background, per tab.", "permissions": ["storage", "scripting", "sidePanel", "webNavigation", "alarms"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background/index.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "commands": {"toggle-audio-mode": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle audio-only mode"}, "toggle-playback": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Play/pause"}, "next-video": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Next video"}, "previous-video": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Previous video"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["inject/index.js", "icons/icon128.png"], "matches": ["https://www.youtube.com/*"]}]}