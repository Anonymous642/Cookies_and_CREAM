{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Handback Recorder", "version": "1.9.0", "description": "Narrate what's broken. Recording, transcript, and console errors land in your Handback inbox for an agent to fix \u2014 you sign off.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Handback \u2014 open panel", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://handback.dev/*", "http://localhost/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["<all_urls>"]}], "commands": {"draw-live": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Draw on the page while recording"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}