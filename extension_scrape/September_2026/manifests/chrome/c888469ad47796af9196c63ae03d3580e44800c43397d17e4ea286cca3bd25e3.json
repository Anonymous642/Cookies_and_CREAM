{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Illuminati Proxy Switcher", "version": "0.3.0", "description": "One-click proxy switcher with per-proxy fingerprint spoofing (UA, timezone, WebGL, canvas), per-site rules & WebRTC leak protection.", "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "tabs", "privacy", "declarativeNetRequest", "scripting", "webNavigation", "userScripts"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://illuminatinetworks.com/*", "https://*.illuminatinetworks.com/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Illuminati Proxy Switcher"}, "options_page": "options.html", "commands": {"toggle-proxy": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle the proxy on/off"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}