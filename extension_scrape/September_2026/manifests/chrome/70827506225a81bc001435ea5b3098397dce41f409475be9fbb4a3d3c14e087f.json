{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Preflow Sync", "version": "1.4.1", "description": "Prevents Webflow class duplication when pasting from clipboard. By Denis Chernyshov.", "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html", "default_title": "Preflow Sync"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"js": ["webflow-sync.js"], "matches": ["https://*.design.webflow.com/*"], "run_at": "document_idle"}], "host_permissions": ["https://*.design.webflow.com/*"], "permissions": ["storage", "clipboardRead", "clipboardWrite"]}