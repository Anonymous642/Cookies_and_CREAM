{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Synopsis", "version": "1.0.3", "description": "Access your Synopsis data platform from anywhere. Chat with your data, view entity insights, and monitor sync status.", "icons": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "permissions": ["sidePanel", "storage", "activeTab", "notifications", "alarms"], "host_permissions": ["https://getsynopsis.ai/*"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "default_title": "Synopsis"}, "content_scripts": [{"matches": ["https://getsynopsis.ai/*"], "js": ["src/content/synopsis.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["public/icons/*", "src/styles/*"], "matches": ["<all_urls>"]}]}