{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rochel", "version": "0.7.10", "description": "Click what feels off on any website, keep every note private and local, and ship a clean coding-agent prompt.", "permissions": ["activeTab", "scripting", "storage", "sidePanel"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "annotations.html?panel=1"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Rochel", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png"}}, "commands": {"toggle-annotations": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Start or stop annotating"}, "toggle-checks": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Show or hide page inspection"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["picker-form.html", "picker-form.css", "picker-form.js", "fonts.css", "fonts/*.woff2"], "matches": ["<all_urls>"]}]}