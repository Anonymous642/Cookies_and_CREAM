{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode Uploader", "description": "A Chrome extension to upload LeetCode solutions to GitHub", "version": "1.0.5", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "action": {"default_popup": "window.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "tabs", "scripting", "storage"], "host_permissions": ["https://leetcode.com/*"], "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content.js"], "run_at": "document_idle"}]}