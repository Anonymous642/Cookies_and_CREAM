{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFlow Pro - Smart Workspace, Focus Engine & Tab Manager", "version": "1.2.0", "author": "Joydeb (https://iam.joydeb.xyz)", "homepage_url": "https://iam.joydeb.xyz", "description": "Organize your browser tabs into workspaces, stay focused with a Pomodoro timer, and free up memory by freezing inactive tabs.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "TabFlow Pro", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background/service-worker.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["tabs", "storage", "sidePanel", "activeTab", "scripting", "contextMenus", "bookmarks", "alarms", "notifications", "sessions", "downloads"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open TabFlow Pro Popup"}, "toggle-side-panel": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle Workspace Side Panel"}, "toggle-reader-mode": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle Clean Reader View"}}}