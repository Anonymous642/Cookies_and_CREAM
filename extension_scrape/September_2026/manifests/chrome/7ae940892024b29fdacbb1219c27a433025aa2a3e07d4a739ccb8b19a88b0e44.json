{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Darxiv", "version": "1.0.3", "description": "Dark mode reader, Google Drive/Sheets auto-collect, and LaTeX copy for arXiv papers. arXiv \ub17c\ubb38 \ub2e4\ud06c\ubaa8\ub4dc \ub9ac\ub354 + \uc790\ub3d9 \uc218\uc9d1 + LaTeX \ubcf5\uc0ac.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["identity", "storage", "activeTab", "tabs"], "host_permissions": ["https://arxiv.org/*", "https://ar5iv.org/*", "https://ar5iv.labs.arxiv.org/*", "https://export.arxiv.org/*", "https://api.crossref.org/*", "https://api.semanticscholar.org/*", "https://www.googleapis.com/*", "https://sheets.googleapis.com/*"], "oauth2": {"client_id": "108413733020-dsimpi2umu26hfmtupndq3msj41bo3vt.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file", "https://www.googleapis.com/auth/spreadsheets"]}, "action": {"default_popup": "popup/index.html", "default_title": "Darxiv", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://arxiv.org/abs/*", "https://arxiv.org/pdf/*", "https://arxiv.org/html/*", "https://ar5iv.labs.arxiv.org/html/*", "https://ar5iv.org/html/*"], "js": ["content/detector.js"], "css": ["content/detector.css"], "run_at": "document_idle"}, {"matches": ["https://arxiv.org/html/*", "https://ar5iv.labs.arxiv.org/html/*", "https://ar5iv.org/html/*"], "js": ["content/copy-helper.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["reader/index.html", "lib/*"], "matches": ["<all_urls>"]}]}