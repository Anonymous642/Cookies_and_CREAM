{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "screenshottr", "version": "0.8.0", "description": "Pixel-perfect screenshots, GIFs and demo staging: element, full-page and scroll-container capture. Fast and fully local.", "minimum_chrome_version": "121", "permissions": ["scripting", "storage", "downloads", "debugger", "tabs", "offscreen", "declarativeNetRequest", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "screenshottr"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"view-capture": {"description": "Capture the visible area"}, "node-capture": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capture an element"}, "full-capture": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Capture the full page"}, "gif-toggle": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Start / stop GIF recording"}, "hud-toggle": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Toggle the size readout"}}}