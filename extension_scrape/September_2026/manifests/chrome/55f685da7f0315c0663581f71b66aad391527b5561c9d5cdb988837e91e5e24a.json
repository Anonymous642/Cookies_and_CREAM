{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Drift - Gentle Distraction Blocker", "description": "A calm focus extension that blocks distractions and reminds you what you were working on.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "webNavigation", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Drift", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_popup": "popup.html"}, "commands": {"toggle-focus": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open Drift or end the current session"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}