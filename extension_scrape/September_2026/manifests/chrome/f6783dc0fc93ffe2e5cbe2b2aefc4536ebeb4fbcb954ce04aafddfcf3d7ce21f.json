{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice Transcriber", "version": "1.3.3", "description": "Transcribe voice to text using Groq Whisper API. Record \u2192 Transcribe \u2192 Copy to clipboard.", "permissions": ["offscreen", "notifications", "tabs", "storage"], "host_permissions": ["https://api.groq.com/*", "https://*.ingest.de.sentry.io/*"], "optional_permissions": [], "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start/stop voice recording"}}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["content-script.css"], "run_at": "document_idle"}]}