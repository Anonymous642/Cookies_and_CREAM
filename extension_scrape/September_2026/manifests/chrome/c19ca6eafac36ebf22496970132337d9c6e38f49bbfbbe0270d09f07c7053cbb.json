{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Undertune: Tab Audio for Google Meet", "version": "0.4.1", "description": "Play any tab's audio into your Google Meet call. No screen share, nothing for the other person to install. 100% local.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "tabs", "storage"], "host_permissions": ["https://meet.google.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Undertune", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "commands": {"toggle-music-mute": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Instantly mute/unmute the shared tab audio in the call"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content/bridge.js"], "run_at": "document_start"}, {"matches": ["https://meet.google.com/*"], "js": ["content/mixer.js"], "run_at": "document_start", "world": "MAIN"}]}