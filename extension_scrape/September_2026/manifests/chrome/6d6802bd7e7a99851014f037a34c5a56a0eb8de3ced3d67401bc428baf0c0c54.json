{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Drive Sidebar Toggle", "version": "1.0.0", "description": "Toggle (hide/show) the left sidebar navigation in Google Drive.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://drive.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle Drive sidebar"}, "commands": {"toggle-drive-sidebar": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Drive sidebar"}}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}