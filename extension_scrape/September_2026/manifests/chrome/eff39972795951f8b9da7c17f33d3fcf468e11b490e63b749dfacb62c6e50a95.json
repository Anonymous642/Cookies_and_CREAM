{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flashly - AI Conversation to Flashcards", "description": "Turn your ChatGPT conversations into spaced repetition flashcards", "version": "1.0.1", "action": {"default_popup": "popup/popup.html"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://api.flashly.dev/*", "https://app.flashly.dev/*", "https://flashly.dev/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/chatgpt.js"]}, {"matches": ["https://app.flashly.dev/*", "https://flashly.dev/*", "http://localhost:5173/*"], "js": ["content/flashly.js"], "run_at": "document_idle"}]}