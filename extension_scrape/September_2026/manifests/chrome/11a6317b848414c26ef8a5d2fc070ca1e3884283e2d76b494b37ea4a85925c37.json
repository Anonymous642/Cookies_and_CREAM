{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Autocheckly \u2014 Car Deal Checker", "version": "1.0.2", "description": "Instantly see if car listings are good deals while you browse Facebook Marketplace, Kijiji, AutoTrader, and Craigslist.", "permissions": ["storage"], "host_permissions": ["https://*.facebook.com/*", "https://*.kijiji.ca/*", "https://*.kijiji.com/*", "https://*.autotrader.ca/*", "https://*.autotrader.com/*", "https://*.craigslist.org/*", "https://*.replit.dev/*", "https://*.replit.app/*", "https://*.autocheckly.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace*", "https://m.facebook.com/marketplace*", "https://*.kijiji.ca/*", "https://*.autotrader.ca/*", "https://*.autotrader.com/*", "https://*.craigslist.org/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}}