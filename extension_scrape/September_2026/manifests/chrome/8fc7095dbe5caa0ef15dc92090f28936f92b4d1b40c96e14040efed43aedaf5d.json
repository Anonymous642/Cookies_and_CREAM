{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Look-Around", "description": "Lightning-fast Github Command Palette to repos, PRs, and issues", "version": "0.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle Command Palette"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "GitHub Look-Around", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["*://github.com/settings/tokens/new*"], "js": ["content-scripts/github-token-helper.js"]}]}