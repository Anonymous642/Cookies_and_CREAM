{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "clearQR - Secure QR Scanner", "version": "1.0.0", "description": "Scan QR codes safely. See the full URL before visiting. Everything stays local.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon48.png", "default_title": "clearQR - Scan QR Codes"}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["activeTab", "storage", "clipboardWrite"], "optional_permissions": ["desktopCapture", "tabs"], "commands": {"scan-tab": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Scan current tab for QR codes"}}}