{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "qrsr \u2014 QR Screen Reader", "version": "0.1.0", "description": "Frame any QR code on the page with a resizable box, decode it, and auto-open URLs.", "author": "robert.egorov@gmail.com", "homepage_url": "https://github.com/regorov/qrsr", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Scan a QR code (Alt+Shift+Q)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"scan-qr": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Start QR selection on the current tab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}