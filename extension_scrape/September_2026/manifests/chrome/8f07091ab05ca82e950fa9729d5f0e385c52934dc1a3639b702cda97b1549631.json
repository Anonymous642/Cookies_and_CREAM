{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager", "version": "1.0.5", "description": "Never lose a tab again - save, organize, and quickly reopen closed tabs", "homepage_url": "https://savemytab.framer.ai", "permissions": ["tabs", "storage", "windows", "history", "activeTab", "background", "downloads"], "host_permissions": ["https://*.supabase.co/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/tabs-16.png", "32": "icons/tabs-32.png", "48": "icons/tabs-48.png", "128": "icons/tabs-128.png"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["popup.html", "extended.html", "spotlight.html"], "matches": ["<all_urls>"]}], "commands": {"open-tab-manager": {"suggested_key": {"default": "Alt+Space", "mac": "Alt+Space"}, "description": "Open Tab Manager"}, "open-tab-manager-alt1": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Open Tab Manager (Alt 1)"}, "open-spotlight-search": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Open Spotlight Search"}, "open-spotlight-search-alt1": {"suggested_key": {"default": "Ctrl+Space", "mac": "MacCtrl+Space"}, "description": "Open Spotlight Search (Alt 1)"}}, "icons": {"16": "icons/tabs-16.png", "32": "icons/tabs-32.png", "48": "icons/tabs-48.png", "128": "icons/tabs-128.png"}}