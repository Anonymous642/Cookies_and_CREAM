{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SkyBoard \u2014 Live Flight Panel", "version": "0.3.0", "description": "A small LED board that floats over any page and shows the aircraft passing overhead, one at a time.", "minimum_chrome_version": "111", "permissions": ["storage", "activeTab", "scripting", "geolocation"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["https://opensky-network.org/*", "https://auth.opensky-network.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Show the SkyBoard panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["src/panel.html", "src/panel.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Show or hide the SkyBoard panel"}}}