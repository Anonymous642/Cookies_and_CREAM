{"update_url": "https://clients2.google.com/service/update2/crx", "author": "Forestudio", "description": "Slack-style :shortcode: emoji suggestions in every text field on the web, plus a searchable picker in the toolbar. Free and private.", "name": "Emoji Anywhere", "version": "1.0.7", "manifest_version": 3, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Emoji Anywhere \u2014 search & copy emojis", "default_popup": "src/entries/popup/index.html"}, "options_ui": {"page": "src/entries/options/index.html", "open_in_tab": true}, "background": {"service_worker": "serviceWorker.js", "type": "module"}, "commands": {"open-emoji-picker": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the emoji picker at the text cursor"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "host_permissions": ["<all_urls>"], "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}, "web_accessible_resources": [{"resources": ["data/emoji.json", "src/entries/stats/index.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://challenges.cloudflare.com/*", "*://*.hcaptcha.com/*", "*://www.google.com/recaptcha/*", "*://*.recaptcha.net/*", "*://*.arkoselabs.com/*", "*://*.funcaptcha.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}