{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Website Sticky Notes", "version": "1.0.0", "description": "Create, edit, and manage sticky notes on any website. Notes persist per site and sync across devices.", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_title": "Sticky Notes"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_page": "options.html", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"create-note": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Create a new sticky note"}, "toggle-notes": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Show or hide all notes"}}}