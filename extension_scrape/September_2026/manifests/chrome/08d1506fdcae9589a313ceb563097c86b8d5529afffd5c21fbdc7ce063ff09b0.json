{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Bandit: Tab Manager, Copy & Open URLs", "description": "Copy, open, and share groups of tabs in one click \u2014 plus smart tab management to keep Chrome fast.", "version": "1.0.5", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Tab Bandit: Tab Manager, Copy & Open URLs", "default_popup": "popup.html"}, "options_page": "options.html", "background": {"service_worker": "background-bundled.js"}, "content_scripts": [{"matches": ["*://share.tabbandit.io/*"], "js": ["content/sharePageMarker.js"], "run_at": "document_start"}], "permissions": ["tabs", "scripting", "clipboardWrite", "clipboardRead", "offscreen", "storage", "notifications", "contextMenus", "alarms", "tabGroups", "webNavigation"], "optional_permissions": ["idle", "browsingData"], "host_permissions": ["<all_urls>"], "commands": {"copy-urls": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Copy URLs from current window"}, "open-urls": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open URLs from clipboard"}, "detach-tabs": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Detach active / highlighted tabs"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Tab Dashboard"}}}