{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cformly", "version": "0.1.0", "description": "Auto-fill FRRO Form III from the Cformly app\u2019s clipboard payload (Tier 1).", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "clipboardRead"], "host_permissions": ["https://indianfrro.gov.in/frro/FormC*", "https://indianfrro.gov.in/frro/formc*", "https://*.cformly.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cformly-extension@cformly.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}, "strict_min_version": "125.0"}}, "action": {"default_popup": "popup.html", "default_title": "Cformly", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open the Cformly auto-fill popup"}}, "content_scripts": [{"matches": ["https://indianfrro.gov.in/frro/FormC*", "https://indianfrro.gov.in/frro/formc*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["content-heavy.js"], "matches": ["https://indianfrro.gov.in/*"]}]}