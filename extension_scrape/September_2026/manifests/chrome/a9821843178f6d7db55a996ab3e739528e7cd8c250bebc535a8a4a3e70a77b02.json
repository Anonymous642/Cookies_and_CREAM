{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mindlatch", "version": "0.6.0", "description": "A quiet library for what you save with intent. Latch, highlight, liberate, decide. Import, ask, export, forget.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Mindlatch", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Latch the current page with a note"}, "liberate-tabs": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Liberate all tabs \u2014 save and close them"}, "new-decision": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Start a new Decision Log"}, "open-library": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open the Mindlatch library"}}, "web_accessible_resources": [{"resources": ["library.html", "settings.html", "imports.html", "ask.html", "decision.html", "forget.html"], "matches": ["<all_urls>"]}]}