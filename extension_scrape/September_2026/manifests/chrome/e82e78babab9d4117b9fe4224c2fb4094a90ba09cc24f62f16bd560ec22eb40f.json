{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Conversation Timeline", "version": "1.0.0", "description": "Adds a navigation timeline to your ChatGPT, DeepSeek, and Gemini conversations for easy navigation.", "action": {"default_popup": "popup.html", "default_title": "\u4f1a\u8bdd\u65f6\u95f4\u8f74"}, "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-chatgpt.js"], "css": ["styles-chatgpt.css"]}, {"matches": ["https://chat.deepseek.com/*"], "js": ["content-deepseek.js"], "css": ["styles-deepseek.css"]}, {"matches": ["https://gemini.google.com/*"], "js": ["content-gemini.js"], "css": ["styles-gemini.css"]}, {"matches": ["https://claude.ai/*"], "js": ["content-claude.js"], "css": ["styles-claude.css"]}]}