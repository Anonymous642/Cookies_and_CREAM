{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "deepeye: Deepfake & AI Content Detector", "version": "1.0.4", "description": "Know what's real. deepeye scores web pages for AI-generated text, synthetic images, and live-call deepfakes in seconds.", "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus", "alarms", "identity", "notifications", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://stripe.com/*", "https://*.stripe.com/*", "https://*.stripe.network/*"], "js": ["content-script.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "action": {"default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "options.html", "commands": {"deep-scan-page": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "deepeye: Deep scan the current page or selection"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: blob: https: http:"}, "web_accessible_resources": [{"resources": ["content-style.css", "assets/icons/*", "assets/graphics/*", "assets/*.lottie", "assets/loading/*", "assets/*.webm", "assets/*.png", "assets/*.svg", "assets/*.webp"], "matches": ["<all_urls>"]}]}