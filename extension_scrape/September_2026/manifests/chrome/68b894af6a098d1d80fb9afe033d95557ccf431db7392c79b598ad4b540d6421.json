{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProspectPen", "version": "1.0.0", "description": "AI-powered LinkedIn outreach message generator. Write personalized connection requests and cold DMs in seconds.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://prospectpen.vercel.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "settings.html"}