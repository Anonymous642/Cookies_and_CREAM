{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ApplyForge Job Clipper", "version": "1.0.1", "description": "See your Priority Score on every LinkedIn, Indeed, and Glassdoor listing before you apply.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://applyforge.pro/*", "https://applyforge.co.uk/*", "https://server.applyforge.pro/*", "https://www.linkedin.com/jobs/*", "https://www.indeed.com/*", "https://*.indeed.com/*", "https://www.glassdoor.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ApplyForge", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/shared.js", "content/linkedin.js"], "css": ["styles/badge.css"], "run_at": "document_idle"}, {"matches": ["https://*.indeed.com/*"], "js": ["content/shared.js", "content/indeed.js"], "css": ["styles/badge.css"], "run_at": "document_idle"}, {"matches": ["https://www.glassdoor.com/*"], "js": ["content/shared.js", "content/glassdoor.js"], "css": ["styles/badge.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}