{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Longshot \u2014 Full Page Screenshot", "short_name": "Longshot", "version": "2.1.1", "description": "Capture the visible area, the whole scrolling page, or every dropdown on it. Save as PNG, JPEG or PDF. Nothing leaves your browser.", "permissions": ["activeTab", "scripting", "unlimitedStorage"], "action": {"default_title": "Longshot \u2014 capture this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/sw.js", "type": "module"}, "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture the full page, keeping any open menu"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture just the visible area"}}, "web_accessible_resources": [{"resources": ["capture/*.js", "content/engine.js"], "matches": ["<all_urls>"]}]}