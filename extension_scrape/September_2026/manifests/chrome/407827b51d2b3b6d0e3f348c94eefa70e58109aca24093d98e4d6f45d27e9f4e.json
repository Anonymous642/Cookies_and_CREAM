{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Image Number Helper", "version": "2.0.0", "description": "Number every image on a page for design reviews, QA, and meetings. Overlay badges that do not break the layout.", "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Image Number Helper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-labels": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Toggle image labels"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://chrome.google.com/webstore/*", "*://chromewebstore.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}