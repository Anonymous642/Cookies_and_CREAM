{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StreamCapture Toolkit: Download and clip audio streams - In Browser", "version": "4.20.3", "description": "StreamCapture Toolkit lets you download audio and video and create custom clips directly in your browser.  HLS & m3u8 supported.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["webRequest", "storage", "downloads", "declarativeNetRequest", "windows", "background"], "host_permissions": ["*://*.pscp.tv/*", "*://*.periscope.tv/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.video.twitter.com/*", "*://*.media.twitter.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["hls.min.js"], "matches": ["<all_urls>"]}]}