{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clockdin", "version": "1.4.0", "description": "Agendador de posts para LinkedIn via API oficial", "permissions": ["identity", "storage", "alarms", "sidePanel", "notifications"], "host_permissions": ["https://api.linkedin.com/*", "https://www.linkedin.com/*", "https://api.github.com/*", "https://*.workers.dev/*", "https://extensionpay.com/*"], "action": {"default_title": "Clockdin - Agendador LinkedIn", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "side_panel": {"default_path": "src/sidepanel.html"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["src/ExtPay.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}