{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rudra Inspect", "version": "1.1.2", "description": "Inspect CSS on any webpage \u2014 fonts, colors, headings, contrast, and element inspection", "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Rudra Inspect", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"toggle-inspect": {"suggested_key": {"default": "Alt+I", "mac": "Alt+I"}, "description": "Toggle element inspector on the current page"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "web_accessible_resources": [{"matches": ["http://*/*", "https://*/*"], "resources": ["src/content/inspector.js"], "use_dynamic_url": false}]}