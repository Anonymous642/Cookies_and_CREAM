{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Sideway Chatbot by AI Muse (Beta)", "short_name": "AI Sidewaybot", "description": "An AI chatbot on your side. This extension provides a chatbot interface to the Browser built-in LLM model, Gemini Nano (free).", "version": "0.9.4", "version_name": "0.9.4 Beta", "manifest_version": 3, "minimum_chrome_version": "138", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_title": "AI Sidewaybot", "default_state": "enabled", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "scripts/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["scripts/content-summarize.js"], "all_frames": true}], "web_accessible_resources": [{"matches": ["http://*/*", "https://*/*"], "resources": ["*.html", "styles/*.css", "scripts/*.js"]}], "commands": {"open_sideway_chatbot": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Open the Sideway Chatbot app."}}, "host_permissions": ["<all_urls>"], "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "commands", "contextMenus", "scripting", "sidePanel", "storage"]}