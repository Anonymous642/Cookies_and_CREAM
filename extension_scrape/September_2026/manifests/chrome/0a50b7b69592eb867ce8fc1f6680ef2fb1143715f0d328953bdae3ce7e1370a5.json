{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GTM Tab Marker", "version": "1.0.2", "description": "Distinct favicons for Google Tag Manager tabs: one colour per container, filled for the container UI, outlined for preview.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://datamine.dk", "permissions": ["storage", "activeTab", "scripting"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "GTM Tab Marker \u2013 click on a server preview tab (/gtm/debug) to enable it here"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://tagmanager.google.com/*", "https://tagassistant.google.com/*"], "js": ["favicon.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}