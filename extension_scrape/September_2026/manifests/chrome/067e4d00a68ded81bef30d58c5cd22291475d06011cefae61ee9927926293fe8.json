{"update_url": "https://clients2.google.com/service/update2/crx", "author": "Aleksei Panin | lexpan.dev", "manifest_version": 3, "name": "Story Link for Jira", "version": "0.1.0", "description": "Link an issue to a User Story right from Jira Server: one button, instant picker, undo. For Jira Server/DC 8.20+.", "default_locale": "en", "permissions": ["storage", "scripting"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Story Link for Jira"}, "web_accessible_resources": [{"resources": ["logics/shared/*.js", "core/*.js", "common/*.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}