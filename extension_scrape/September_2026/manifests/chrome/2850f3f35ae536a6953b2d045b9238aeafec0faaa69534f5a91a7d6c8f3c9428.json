{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UUID Generator", "description": "Free online UUID Generator supporting v1, v3, v4, and v5 with export to JSON, CSV, or TXT.", "version": "2.2.1", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://www.uuidtools.com/api/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.uuidtools.com/api/"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}