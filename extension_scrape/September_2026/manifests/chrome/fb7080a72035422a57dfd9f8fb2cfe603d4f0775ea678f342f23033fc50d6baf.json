{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlurMyData", "description": "Browser-page privacy controls for demos, screenshots, and recordings.", "version": "0.1.1", "action": {"default_title": "BlurMyData", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-emergency-hide": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Toggle Emergency Hide on the current page"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "settings/settings.html", "permissions": ["activeTab", "scripting", "storage", "tabs"], "web_accessible_resources": [{"resources": ["shared/**"], "matches": ["<all_urls>"]}], "host_permissions": ["https://blurmydata.vercel.app/*"]}