{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WikiQuiz: AI-Powered Wikipedia Quizzes", "description": "Generate content-specific quizzes from any Wikipedia article", "version": "2.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.wikipedia.org/wiki/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "WikiQuiz: AI-Powered Wikipedia Quizzes", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.wikipedia.org/wiki/*"], "js": ["content-scripts/content.js", "content-scripts/sidebar.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/sidebar.css"], "matches": ["*://*.wikipedia.org/*"]}]}