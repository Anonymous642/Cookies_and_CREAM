{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Suspender Pro", "version": "1.0.0", "description": "Automatically suspend inactive tabs to save RAM. Restore instantly with a click.", "permissions": ["tabs", "alarms", "storage", "scripting", "identity"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "options_page": "settings/settings.html", "commands": {"suspend-current-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Suspend current tab"}, "resume-current-tab": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Resume current tab"}, "suspend-all-tabs": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Suspend all tabs"}}, "externally_connectable": {"matches": ["https://tab-suspender-pro-api-staging.phuong-labs.workers.dev/*", "https://tab-suspender-pro-api.phuong-labs.workers.dev/*"]}, "web_accessible_resources": [{"resources": ["suspended/suspended.html", "suspended/suspended.js"], "matches": ["<all_urls>"]}]}