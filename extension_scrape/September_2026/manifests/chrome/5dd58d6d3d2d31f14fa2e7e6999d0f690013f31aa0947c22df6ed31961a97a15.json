{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Still \u2014 Audio & Voice Recorder", "author": "Ajink Gupta", "homepage_url": "https://ajink.in/", "version": "1.2.0", "description": "Record audio and video demos from your tab. Mark smooth zooms, highlight clicks, and export locally. No uploads.", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabCapture", "offscreen", "downloads", "scripting"], "commands": {"demo-zoom": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Mark a demo zoom at the pointer"}, "demo-stop": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop the active tab\u2019s video demo"}}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Still \u2014 Record this tab"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self';"}}