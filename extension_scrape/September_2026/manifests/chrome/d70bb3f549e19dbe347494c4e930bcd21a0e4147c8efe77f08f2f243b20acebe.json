{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tasknest \u2014 To-Do List, Tasks & Reminders", "version": "1.0.0", "description": "To-do list & task manager with list, board, and calendar views from a side panel. Capture tasks with natural language.", "minimum_chrome_version": "116", "action": {"default_title": "Open Tasknest \u2014 To-Do List", "default_icon": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "permissions": ["storage", "alarms", "notifications", "sidePanel", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/badge.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["sidepanel.html", "permission.html", "assets/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"open-sidepanel": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Open Tasknest side panel"}, "quick-add": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Open Tasknest and focus the quick-add input"}}}