{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemorIN: CS2 Demo Viewer", "version": "0.4.2", "description": "Turn CS2 demos into interactive 3D browser replays. Open a supported match or demo link and build the replay with one click.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab"], "host_permissions": ["https://www.faceit.com/*", "https://faceit.com/*", "https://www.hltv.org/*", "https://hltv.org/*", "https://r2-demos.hltv.org/*", "https://memorin.app/*", "https://viewer.memorin.app/*"], "background": {"service_worker": "background.js", "scripts": ["lib/origins.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.faceit.com/*", "https://faceit.com/*"], "js": ["content/faceit.js"], "run_at": "document_idle"}, {"matches": ["https://www.faceit.com/*", "https://faceit.com/*"], "js": ["page/faceit-bridge.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.hltv.org/*", "https://hltv.org/*"], "js": ["lib/hltv.js", "content/hltv.js"], "run_at": "document_idle"}, {"matches": ["https://memorin.app/*", "https://viewer.memorin.app/*"], "js": ["content/presence.js"], "run_at": "document_start"}, {"matches": ["https://memorin.app/pair*", "https://viewer.memorin.app/pair*"], "js": ["content/pair.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-128.png"], "matches": ["https://www.faceit.com/*", "https://faceit.com/*", "https://www.hltv.org/*", "https://hltv.org/*"]}], "action": {"default_title": "MemorIN: Watch in 3D", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "browser_specific_settings": {"gecko": {"id": "watch