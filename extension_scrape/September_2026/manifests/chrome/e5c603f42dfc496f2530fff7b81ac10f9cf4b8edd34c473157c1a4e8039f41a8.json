{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Extract page info with one click", "version": "1.3.1", "description": "Extract key information from the current page and copy it in one click.", "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"], "action": {"default_title": "Extract page info with one click", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"copy-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Copy the current page as clean text"}, "extract-insight": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "MacCtrl+Shift+I"}, "description": "Extract key information from the current page"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html"}