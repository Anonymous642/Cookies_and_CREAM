{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Varren", "version": "1.0.0", "description": "Let Varren work in its own tab in your Chrome, signed in as you, while you watch. Sign-ins, codes and payments stay with you.", "minimum_chrome_version": "120", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Varren", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "background": {"service_worker": "src/sw.js", "type": "module"}, "permissions": ["debugger", "storage", "alarms", "tabGroups", "activeTab"], "commands": {"stop-varren": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop Varren in this Chrome"}}}