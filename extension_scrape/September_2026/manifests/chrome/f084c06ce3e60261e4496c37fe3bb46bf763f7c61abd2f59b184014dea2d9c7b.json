{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipstack \u2014 Save Articles & Read Later", "version": "1.0.0", "description": "Save articles, blog posts & web pages to read later. Full-text search, tags, highlights, and a clean reading experience.", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "cookies", "tabs", "scripting", "activeTab"], "host_permissions": ["https://clipstack.one/*"], "externally_connectable": {"matches": ["https://clipstack.one/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://lh3.googleusercontent.com"}}