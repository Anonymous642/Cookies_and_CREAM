{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "admute", "version": "0.1.0", "description": "Detects streaming ads and fills the break with your own content.", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "launcher.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["games/*", "launcher.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/detect-youtube.js"], "run_at": "document_idle"}, {"matches": ["https://www.primevideo.com/*", "https://*.primevideo.com/*", "https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.de/*"], "js": ["content/detector-lib.js", "content/detect-prime.js"], "run_at": "document_idle"}, {"matches": ["https://tubitv.com/*", "https://*.tubitv.com/*"], "js": ["content/detector-lib.js", "content/detect-tubi.js"], "run_at": "document_idle"}, {"matches": ["https://*/*"], "js": ["content/profiles.js", "content/detector-lib.js", "content/detect-generic.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "css": ["overlay.css"], "js": ["content/boot.js", "content/facts.js", "overlay.js", "content/bridge.js"], "run_at": "document_idle"}], "options_page": "options.html", "action": {"default_popup": "options.html", "default_title": "admute", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}