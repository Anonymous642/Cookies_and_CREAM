{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Better Prompt", "version": "1.0", "description": "Transform simple queries into detailed LLM prompts using AI", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "contextMenus"], "host_permissions": ["https://openrouter.ai/api/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options/options.html", "commands": {"enhance-query": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Enhance the selected LLM query"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}