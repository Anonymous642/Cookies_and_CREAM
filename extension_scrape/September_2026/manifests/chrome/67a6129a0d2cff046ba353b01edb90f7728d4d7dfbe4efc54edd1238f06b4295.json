{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Allen for LinkedIn", "version": "1.5.1", "description": "Write a comment in your voice for the LinkedIn post you're looking at, and add anyone to your Allen watchlist from their profile.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Allen: write a comment for this post"}, "host_permissions": ["https://tryallen.ai/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/icon-16.png"], "matches": ["https://www.linkedin.com/*"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}