{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lexilit - Your Novel Companion", "version": "1.0.0", "description": "Capture novel chapters from the page you're reading and add them to your Lexilit translation projects.", "author": "Lexilit", "permissions": ["activeTab", "contextMenus", "storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://lexilit.com/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}