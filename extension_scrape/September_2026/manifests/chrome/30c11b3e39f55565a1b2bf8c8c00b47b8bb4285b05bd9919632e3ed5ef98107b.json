{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Video Sync", "version": "0.1.0", "description": "Synchronize playback of an already-open video with another consenting participant.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://webmaster-api.com/"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Web Video Sync", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.bilibili.com/*", "*://*.yfsp.tv/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}