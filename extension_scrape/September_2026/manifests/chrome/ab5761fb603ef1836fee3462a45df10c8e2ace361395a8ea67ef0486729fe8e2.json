{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Web Privacy Blur", "version": "1.0.3", "description": "Blur chats, messages, and headers on WhatsApp Web, then toggle blur or the sidebar with a click or keyboard shortcut.", "icons": {"48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["activeTab", "scripting"], "background": {"service_worker": "dist/background.js"}, "action": {"default_title": "Toggle WhatsApp sidebar"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle the WhatsApp sidebar"}, "toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Toggle the privacy blur"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "host_permissions": ["https://web.whatsapp.com/*"]}