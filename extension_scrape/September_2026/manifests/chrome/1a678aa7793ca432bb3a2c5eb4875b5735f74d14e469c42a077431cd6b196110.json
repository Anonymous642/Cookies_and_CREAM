{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Path to Hired", "version": "1.1.0", "description": "Path to Hired browser extension. Save jobs from any website with one click. Automatically extracts job details for easy tracking.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.indeed.co.uk/*", "*://*.indeed.ca/*", "*://*.indeed.de/*", "*://*.indeed.fr/*", "*://*.indeed.nl/*", "*://*.glassdoor.com/*", "*://*.glassdoor.co.uk/*", "*://*.glassdoor.ca/*", "*://*.glassdoor.de/*", "*://*.glassdoor.fr/*", "*://*.glassdoor.nl/*", "*://*.glassdoor.be/*", "*://*.glassdoor.at/*", "*://*.glassdoor.ch/*", "*://*.glassdoor.ie/*", "*://*.glassdoor.es/*", "*://*.glassdoor.it/*", "*://*.glassdoor.com.au/*", "*://*.glassdoor.co.in/*", "*://*.glassdoor.co.nz/*", "*://*.glassdoor.sg/*", "*://*.glassdoor.com.hk/*", "*://*.glassdoor.com.mx/*", "*://*.glassdoor.com.br/*", "*://*.glassdoor.com.ar/*", "https://*/*", "http://*/*"], "icons": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save Job", "default_icon": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://pathtohired.com/*", "https://*.pathtohired.com/*", "http://localhost/*"]}, "web_accessible_resources": [{"resources": ["detected.json"], "matches": ["https://pathtohired.com/*", "https://*.pathtohired.com/*", "http://localhost/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}