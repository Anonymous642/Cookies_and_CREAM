{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WiserReview", "version": "1.5", "description": "This extension helps you to pull the latest reviews from review platforms. So you can show them on your website or sales pages", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_title": "WiserReview"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "tabs", "storage", "contextMenus"], "host_permissions": ["*://*/*"], "externally_connectable": {"matches": ["https://app.wiserreview.com/*"]}, "web_accessible_resources": [{"resources": ["html/index.html", "html/auth.html", "html/list.html", "index.css", "main.js"], "matches": ["https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["contentScript.js"], "run_at": "document_end", "css": ["index.css"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}