{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Timestamper", "description": "Save bookmarks (timestamps + notes) for YouTube videos. Jump directly to saved timestamps.", "version": "1.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Video Timestamper", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "tabs", "commands"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*", "*://youtu.be/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "commands": {"add-bookmark": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add a bookmark at the current timestamp"}}}