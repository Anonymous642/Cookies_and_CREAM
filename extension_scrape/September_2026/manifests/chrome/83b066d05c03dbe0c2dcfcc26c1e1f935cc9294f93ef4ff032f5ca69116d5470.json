{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube to WordPress", "version": "1.0.1", "description": "Make any YouTube video into a written WordPress blog post in seconds using AI.", "icons": {"16": "yt-wp-icon-128-128.png", "32": "yt-wp-icon-128-128.png", "48": "yt-wp-icon-128-128.png", "128": "yt-wp-icon-128-128.png"}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://img.youtube.com/*", "https://i.ytimg.com/*", "https://api.openai.com/*", "https://youtubetowordpress.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["page-world.js"], "world": "MAIN", "run_at": "document_start", "all_frames": false}, {"matches": ["https://www.youtube.com/watch*"], "js": ["content-youtube.js"], "css": ["content-youtube.css"], "run_at": "document_idle"}], "options_page": "options.html", "web_accessible_resources": [{"resources": ["yt-wp-icon-128-128.png"], "matches": ["https://www.youtube.com/*"]}], "action": {"default_title": "YouTube to WordPress", "default_popup": "popup.html", "default_icon": {"16": "yt-wp-icon-128-128.png", "32": "yt-wp-icon-128-128.png", "48": "yt-wp-icon-128-128.png", "128": "yt-wp-icon-128-128.png"}}}