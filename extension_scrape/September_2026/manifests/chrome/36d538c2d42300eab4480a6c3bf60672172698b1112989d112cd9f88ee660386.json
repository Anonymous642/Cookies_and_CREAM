{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CloudSync Tab Switcher", "version": "1.0", "description": "Switch to your CloudSync tab instantly with Ctrl+Shift+Y. Opens login automatically if no tab is found.", "permissions": ["tabs", "alarms"], "background": {"service_worker": "background.js"}, "commands": {"switch-to-cloudsync": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Switch to CloudSync tab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}