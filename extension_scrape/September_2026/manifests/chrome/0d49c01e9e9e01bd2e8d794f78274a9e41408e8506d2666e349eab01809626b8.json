{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DevTools to Markdown", "version": "1.0.0", "description": "Copy HTML elements from DevTools as Markdown", "minimum_chrome_version": "109", "permissions": ["offscreen"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "commands": {"copy-markdown": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Copy selected element as markdown"}, "export-file": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Export selected element to file"}, "copy-text": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Copy selected element as text only"}, "clear-preview": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Clear markdown preview"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "devtools_page": "src/devtools.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}