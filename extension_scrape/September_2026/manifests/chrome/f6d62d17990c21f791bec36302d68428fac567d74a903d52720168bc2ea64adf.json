{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Linqube", "version": "1.0.0", "description": "Enhances LinkedIn profiles and generates post content with Generative AI", "homepage_url": "https://www.linqube.com", "author": "Linqube", "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}, "action": {"default_title": "Go to Linqube", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["cookies", "activeTab"], "host_permissions": ["*://*.linkedin.com/*", "*://*.linqube.com/*"], "web_accessible_resources": [{"resources": ["index.html"], "matches": ["https://www.linkedin.com/*"]}], "externally_connectable": {"matches": ["*://*.linqube.com/*"]}}