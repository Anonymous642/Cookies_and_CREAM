{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tube Focus Mode", "version": "0.0.1", "description": "Learn fast with no distractions", "author": "Waleed Muhammad Khan", "permissions": ["storage", "tabs", "activeTab", "scripting", "idle"], "icons": {"16": "img/favicon-16x16.png", "48": "img/favicon-32x32.png", "128": "img/android-chrome-192x192.png"}, "host_permissions": ["https://*.youtube.com/*"], "action": {"default_title": "Click Me", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["./hideShorts/shortsVideo.js", "./pauseVideo/auto_pause.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "commands": {"toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle auto pause/resume"}, "toggle-play": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle play/pause"}, "toggle_mute": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Toggle mute"}}}