{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blind Trading", "version": "0.1.0", "description": "Ascolta il grafico su TradingView: click pi\u00f9 acuti quando il prezzo sale, pi\u00f9 gravi quando scende. Per chi non vede o vede poco.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.tradingview.com/*"], "js": ["audio-engine.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Blind Trading", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-sound": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Attiva o disattiva il suono del prezzo"}, "speak-price": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Leggi ad alta voce il prezzo corrente"}}}