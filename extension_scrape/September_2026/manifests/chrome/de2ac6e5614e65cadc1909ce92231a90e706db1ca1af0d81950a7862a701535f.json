{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Limato Voice \u2014 Offline Speech to Text", "version": "1.0.1", "description": "Offline speech to text. Voice typing that never leaves your device \u2014 no account, no cloud. Works after model download.", "permissions": ["offscreen", "storage", "activeTab"], "host_permissions": ["https://huggingface.co/*", "https://cdn-lfs.huggingface.co/*", "https://cdn-lfs-us-1.huggingface.co/*", "https://license.voice.limato.app/*"], "background": {"service_worker": "background/background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Limato Voice", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-record": {"suggested_key": {"default": "Alt+Space", "mac": "Alt+Space"}, "description": "Start dictation"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"}, "cross_origin_embedder_policy": {"value": "credentialless"}, "cross_origin_opener_policy": {"value": "same-origin"}}