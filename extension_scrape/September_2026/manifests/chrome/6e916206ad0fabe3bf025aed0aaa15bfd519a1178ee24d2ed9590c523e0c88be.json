{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Revea \u2014 Job Interview Recorder for Meet, Zoom & Teams", "version": "1.3.1", "description": "Record real job interviews on Meet, Zoom & Teams. Get AI scores on Capability, Performance & Perception\u2014not mock practice.", "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs", "alarms", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16-grey.png", "48": "assets/icon-48-grey.png", "128": "assets/icon-128-grey.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://reveaai.com/*"], "js": ["content/auth-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://zoom.us/*", "https://*.zoom.us/*"], "js": ["content/widget.js"], "run_at": "document_idle", "all_frames": true}]}