{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pin Copy Studio \u2014 Pinterest SEO Assistant", "version": "1.5.1", "description": "Generate SEO-friendly Pinterest titles, descriptions, and alt text from a topic or URL. Powered by Google Gemini.", "permissions": ["sidePanel", "scripting", "storage", "tabs"], "host_permissions": ["https://www.pinterest.com/*", "https://*.pinterest.com/*", "https://*.workers.dev/*"], "options_page": "src/options/index.html", "icons": {"16": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Pin Copy Studio", "default_icon": {"16": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["https://www.pinterest.com/*", "https://*.pinterest.com/*"], "js": ["src/content/pinterest-fill.js"], "run_at": "document_idle"}], "homepage_url": "https://viralpinpower.com"}