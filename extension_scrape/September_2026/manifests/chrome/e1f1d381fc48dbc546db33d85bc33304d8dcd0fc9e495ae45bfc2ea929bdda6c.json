{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Full Page Screenshot \u2013 Auto Screen Shooter", "description": "Full page screenshot and screen capture for any tab. Go full page. Save as PNG or PDF with custom filenames & optional auto-capture.", "version": "1.18", "icons": {"16": "icons/A-S-S-icon-32.png", "32": "icons/A-S-S-icon-32.png", "48": "icons/A-S-S-icon-48.png", "64": "icons/A-S-S-icon-64.png", "128": "icons/A-S-S-icon-128.png"}, "permissions": ["activeTab", "tabs", "downloads", "storage", "alarms", "desktopCapture", "scripting", "bookmarks"], "host_permissions": ["https://autoscreenshooter.com/*", "https://api.amiplay.net/*"], "action": {"default_title": "Full Page Screenshot \u2013 Auto Screen Shooter", "default_popup": "popup.html", "default_icon": {"16": "icons/A-S-S-icon-32.png", "32": "icons/A-S-S-icon-32.png", "48": "icons/A-S-S-icon-48.png", "64": "icons/A-S-S-icon-64.png", "128": "icons/A-S-S-icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"capture-now": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Capture current visible tab"}}}