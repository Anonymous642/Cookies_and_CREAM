{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yoyo Shortcut", "version": "1.4.3", "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://www.yoyoshortcut.com/*"]}, "commands": {"openYoyoSearchTab": {"suggested_key": {"default": "Alt+Shift+Y", "mac": "Ctrl+Shift+Y"}, "description": "Open Yoyo search tab"}, "openPrevTab": {"suggested_key": {"default": "Alt+Shift+Comma", "mac": "Ctrl+Shift+Comma"}, "description": "Go to previous tab"}, "openNextTab": {"suggested_key": {"default": "Alt+Shift+Period", "mac": "Ctrl+Shift+Period"}, "description": "Go to next tab"}, "saveTab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Ctrl+Shift+S"}, "description": "Save current tab"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.yoyoshortcut.com/*"], "run_at": "document_start", "js": ["content-scripts/yoyo.js"]}]}