{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Optimizer", "version": "1.0.2", "description": "Free on ChatGPT, no account needed. Rewrite prompts for clarity, specificity, and structure inline. One keyboard shortcut.", "homepage_url": "https://promptoptimizer.tools", "author": "Hafiz Riaz", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Prompt Optimizer", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://promptoptimizer.tools/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/content/inject.js"], "css": ["src/content/inject.css"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["src/content/inject.js"], "css": ["src/content/inject.css"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://x.com/i/grok*", "https://chat.deepseek.com/*"], "js": ["src/content/inject.js"], "css": ["src/content/inject.css"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://promptoptimizer.tools/*"]}, "commands": {"optimize-prompt": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Optimize the current prompt"}}, "web_accessible_resources": [{"resources": ["src/content/inject.css"], "matches": ["<all_urls>"]}]}