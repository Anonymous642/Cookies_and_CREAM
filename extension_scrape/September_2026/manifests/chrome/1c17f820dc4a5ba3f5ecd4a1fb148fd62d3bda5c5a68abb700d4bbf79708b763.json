{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WatchFlix - A Netflix Watchlist Extension", "version": "1.0.5", "icons": {"128": "src/128x128.png"}, "action": {"default_popup": "index.html", "default_icon": "src/WatchFlix-short-black.png", "default_title": "Start now!"}, "description": "An extension to add the things you have watched in Netflix to a seperate list and manage them on any device that has the extension.", "author": "xanndevs", "content_scripts": [{"matches": ["https://www.netflix.com/*"], "js": ["content_editor.js"], "run_at": "document_idle"}], "background": {"service_worker": "service_worker.js", "type": "module"}, "permissions": ["sidePanel", "scripting", "activeTab", "storage"], "web_accessible_resources": [{"resources": ["src/WatchFlix-short-transparent.png", "src/Flix-transparent.png", "src/Tick-transparent.png"], "matches": ["https://www.netflix.com/*"]}]}