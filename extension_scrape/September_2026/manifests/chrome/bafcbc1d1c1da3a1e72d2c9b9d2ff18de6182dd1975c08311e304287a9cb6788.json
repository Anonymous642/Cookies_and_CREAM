{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FootageMark \u2013 Video Timestamp & Clip Marker", "short_name": "FootageMark", "version": "1.0.0", "description": "Save precise In/Out video ranges, add editor context, and build clean Source Packs for editor handoff.", "minimum_chrome_version": "114", "permissions": ["storage", "sidePanel"], "action": {"default_title": "Open FootageMark", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"footagemark-set-in": {"suggested_key": {"default": "Alt+Z"}, "description": "Set FootageMark In point"}, "footagemark-set-out": {"suggested_key": {"default": "Alt+X"}, "description": "Set FootageMark Out point"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://vimeo.com/*", "https://www.vimeo.com/*", "https://rumble.com/*", "https://www.rumble.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}