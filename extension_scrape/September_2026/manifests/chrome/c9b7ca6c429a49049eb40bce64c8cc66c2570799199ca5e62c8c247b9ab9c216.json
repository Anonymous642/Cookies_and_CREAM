{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Cloak", "version": "0.1.0", "description": "Tab Cloak \u2014 Hide tab titles when sharing your screen", "permissions": ["tabs", "scripting", "storage", "tabGroups"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/mask-on-16.png", "32": "icons/mask-on-32.png", "48": "icons/mask-on-48.png", "128": "icons/mask-on-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/mask-off-16.png", "32": "icons/mask-off-32.png", "48": "icons/mask-off-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}