{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SecurePass Manager", "version": "1.0.0", "description": "A secure password manager with full subdomain support. Save and autofill credentials for any site.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite", "alarms"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://*.firebaseio.com https://*.googleapis.com https://*.firebaseapp.com; img-src 'self' https://www.google.com;"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content/content.js"], "css": ["styles/fonts.css", "styles/autofill-overlay.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "SecurePass Manager"}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["icons/*", "styles/*", "styles/fonts/*"], "matches": ["<all_urls>"]}]}