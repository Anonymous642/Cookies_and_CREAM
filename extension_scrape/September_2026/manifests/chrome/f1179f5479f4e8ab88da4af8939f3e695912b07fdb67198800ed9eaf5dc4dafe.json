{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slideflow", "version": "1.0.0", "description": "Auto-cycle through images on Instagram and Twitter/X media pages like a slideshow.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://twitter.com/*", "https://x.com/*", "https://cdn.syndication.twimg.com/*"], "action": {"default_popup": "popup.html", "default_title": "Slideflow", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*", "https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-slideshow": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Play/pause the Slideflow slideshow"}, "next-slide": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Alt+Shift+Right"}, "description": "Advance to the next slide"}, "prev-slide": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Alt+Shift+Left"}, "description": "Go to the previous slide"}}}