{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpaciQ \u2014 Gmail Cleaner", "version": "0.7.0", "description": "Free up Gmail storage: filter large attachments by size, file type, category & date. No OAuth, no server.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SpaciQ"}, "host_permissions": ["https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://mail.google.com/*"]}], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}