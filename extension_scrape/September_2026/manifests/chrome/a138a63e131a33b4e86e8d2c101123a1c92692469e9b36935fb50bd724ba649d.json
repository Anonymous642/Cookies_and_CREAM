{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SerpHarvest: 100+ Google Results on One Page", "description": "Google removed 100 results per page. Get it back \u2014 merge all search pages into one. Export to JSON & CSV in one click.", "version": "1.0.0", "short_name": "SerpHarvest", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://www.google.com/*"], "optional_host_permissions": ["https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "SERP Merger"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}