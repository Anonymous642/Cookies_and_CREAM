{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoboApply - AI Job Application Assistant", "version": "1.0.4", "description": "AI-powered job application assistant. Auto-apply to jobs on Dice, LinkedIn, Indeed with smart tracking and Google authentication.", "permissions": ["activeTab", "scripting", "storage", "tabs", "notifications", "identity", "sidePanel"], "host_permissions": ["*://*.dice.com/*", "*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.monster.com/*", "*://*.glassdoor.com/*", "*://*.ziprecruiter.com/*", "*://*.roboapply.ai/*", "https://auth.roboapply.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.dice.com/*", "*://*.linkedin.com/jobs/*", "*://*.indeed.com/*", "*://*.monster.com/*", "*://*.glassdoor.com/*", "*://*.ziprecruiter.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_title": "RoboApply - AI Job Assistant"}, "side_panel": {"default_path": "sidepanel.html", "default_width": 600}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["auth-callback.html", "dashboard.html", "sidepanel.html", "icons/*"], "matches": ["<all_urls>"]}], "author": "RoboApply Team", "homepage_url": "https://roboapply.ai", "version_name": "1.0.4 (Built: 2026-02-09)"}