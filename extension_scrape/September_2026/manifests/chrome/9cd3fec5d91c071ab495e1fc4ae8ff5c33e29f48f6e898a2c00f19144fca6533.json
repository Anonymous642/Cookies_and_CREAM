{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpsAlly AI", "version": "1.3.1", "description": "AI fluency platform for sales pros. Draft emails with AI, earn certifications, get found by employers. Get Hired. Get AI Fluent.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "tabs", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://opsally.ai/*", "http://localhost:*/*"]}, "host_permissions": ["https://mail.google.com/*", "https://docs.google.com/spreadsheets/*", "https://docs.google.com/document/*", "https://calendar.google.com/*", "https://app.slack.com/*", "https://*.hubspot.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://www.linkedin.com/*", "https://*.supabase.co/*", "https://us.i.posthog.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://docs.google.com/spreadsheets/*", "https://docs.google.com/document/*", "https://calendar.google.com/*", "https://app.slack.com/*", "https://*.hubspot.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://www.linkedin.com/*"], "js": ["content/index.js"], "css": ["content/sidebar.css"]}, {"matches": ["https://opsally.ai/*"], "js": ["content/auth-bridge.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_popup": "popup.html"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle OpsAlly sidebar"}}}