{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Barficient Helper", "description": "A Chrome extension to assist with Barficient's cookie auto-filling and CSV file management.", "version": "2.0.1", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["cookies", "storage", "tabs", "scripting", "activeTab"], "host_permissions": ["https://app.provi.com/*", "https://app.barficient.com/*", "http://*.sculpturehospitality.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["injector.js"]}], "action": {"default_popup": "index.html", "default_title": "Cookie Auto-Filler"}, "web_accessible_resources": [{"resources": ["upload.html", "csv-splitter.html", "csv-splitter.js"], "matches": ["<all_urls>"]}]}