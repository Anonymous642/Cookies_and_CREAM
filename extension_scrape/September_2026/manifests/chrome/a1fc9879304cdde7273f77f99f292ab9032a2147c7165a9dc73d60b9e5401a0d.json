{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeepSeek Quick Open", "description": "Open the official DeepSeek website in a clean browser side panel, standalone window, or tab.", "version": "0.5.5", "permissions": ["sidePanel", "tabs", "declarativeNetRequest", "contextMenus", "storage"], "host_permissions": ["https://chat.deepseek.com/*", "https://deepseek.com/*", "https://*.deepseek.com/*"], "background": {"service_worker": "src/background.js"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "DeepSeek Quick Open", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "commands": {"open-deepseek-side-panel": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "\u5728\u4fa7\u8fb9\u680f\u6253\u5f00 DeepSeek"}, "open-deepseek-window": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "\u5728\u72ec\u7acb\u7a97\u53e3\u6253\u5f00 DeepSeek"}, "open-deepseek-tab": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "\u5728\u6807\u7b7e\u9875\u6253\u5f00 DeepSeek"}}, "side_panel": {"default_path": "src/sidepanel.html"}, "declarative_net_request": {"rule_resources": [{"enabled": true, "id": "deepseek_frame_headers", "path": "rules/deepseek-frame-headers.json"}]}}