{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boast Image", "version": "0.1.0", "description": "Capture and manage screenshots with Boast Image", "author": "SaaS Experts, Inc.", "homepage_url": "https://boastimage.com", "permissions": ["activeTab", "storage", "tabs", "scripting"], "host_permissions": ["https://app.boastimage.com/*", "https://boastimage.com/*"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture selected region"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}}, "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_security_policy": {"extension_pages": "default-src 'self'; img-src 'self' data:; connect-src https://app.boastimage.com https://localhost:5000; script-src 'self'; object-src 'none'"}}