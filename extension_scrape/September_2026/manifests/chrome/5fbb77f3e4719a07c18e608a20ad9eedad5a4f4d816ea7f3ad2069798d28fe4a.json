{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HoverQR \u2013 Instantly Scan & Generate", "version": "1.0.5", "description": "Scan QR codes by hovering. Generate from any link or text. Works everywhere\u2014even in YouTube videos or PDFs. No clicks, no downloads.", "permissions": ["activeTab", "storage", "sidePanel", "contextMenus", "scripting"], "optional_host_permissions": ["https://hoverqr.in/*", "*://*/*", "file://*/*"], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "HoverQR \u2013 Instantly Scan & Generate", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"trigger-snip-scan": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Trigger Snip & Scan UI"}, "trigger-create-qr": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Generate New QR"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}}