{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URL Logger", "version": "1.3", "description": "Logs the current URL and allows for later review. Logging is done only if requested by the user.", "permissions": ["tabs", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "19": "icon19.png", "32": "icon32.png", "38": "icon38.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "19": "icon19.png", "32": "icon32.png", "38": "icon38.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["logs.html", "logs.js"], "matches": ["<all_urls>"]}]}