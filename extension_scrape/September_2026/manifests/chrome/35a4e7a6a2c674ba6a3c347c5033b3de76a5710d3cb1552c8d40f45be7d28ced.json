{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smol Cat", "version": "0.3.1", "description": "A cat lives at the edge of your browser. Now and then it wanders in, blinks at you, and goes again.", "homepage_url": "https://smol-friends.com", "minimum_chrome_version": "116", "permissions": ["storage", "alarms", "scripting", "idle", "offscreen", "activeTab"], "host_permissions": ["<all_urls>", "https://api.smol-friends.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Smol Cat", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options/options.html", "commands": {"ring-bell": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Ring the bell \u2014 a cat comes running"}}, "web_accessible_resources": [{"resources": ["content/*.js", "content/behaviours/*.js", "shared/*.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}