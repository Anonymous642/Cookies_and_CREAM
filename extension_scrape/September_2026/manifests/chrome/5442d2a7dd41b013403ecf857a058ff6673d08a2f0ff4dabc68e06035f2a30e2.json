{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ScreenHelp", "description": "Connects to the ScreenHelp web application to enable keyboard shortcuts.", "version": "1.0", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://screenhelp.ai/*"], "js": ["content.js"]}], "permissions": ["commands", "storage", "tabs"], "commands": {"01-01-left": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "MacCtrl+Shift+Left"}, "description": "Previous Answer"}, "01-02-right": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "MacCtrl+Shift+Right"}, "description": "Next Answer"}, "01-03-up": {"description": "Scroll Up"}, "01-04-down": {"description": "Scroll Down"}, "02-01-prompt_1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1"}, "description": "Run Prompt 1"}, "02-02-prompt_2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2"}, "description": "Run Prompt 2"}, "02-03-prompt_3": {"description": "Run Prompt 3"}, "02-04-prompt_4": {"description": "Run Prompt 4"}, "02-05-prompt_5": {"description": "Run Prompt 5"}, "02-06-prompt_6": {"description": "Run Prompt 6"}, "02-07-prompt_7": {"description": "Run Prompt 7"}, "02-08-prompt_8": {"description": "Run Prompt 8"}, "02-09-prompt_9": {"description": "Run Prompt 9"}}}