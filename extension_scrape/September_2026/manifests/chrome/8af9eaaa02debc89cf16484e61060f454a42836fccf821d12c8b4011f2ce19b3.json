{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Handpick: Image Downloader & Web Clipper", "short_name": "Handpick", "version": "1.4.0", "minimum_chrome_version": "116", "description": "Download images and clip text from any website, label as you go, and get a CSV spreadsheet recording the page each one came from.", "permissions": ["contextMenus", "downloads", "downloads.ui", "scripting", "sidePanel", "storage", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Open the Handpick workbench"}}, "action": {"default_popup": "popup.html", "default_title": "Handpick", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}]}