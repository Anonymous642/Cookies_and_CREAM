{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SocialScalr - LinkedIn Growth Autopilot", "version": "1.1.1", "description": "Send throttled, human-like LinkedIn connection requests and follow-ups. Build pipeline on autopilot.", "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://socialscalr.com/*", "https://*.socialscalr.pages.dev/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://socialscalr.com/*", "https://*.socialscalr.pages.dev/*"], "js": ["src/bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "SocialScalr", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/options.html"}