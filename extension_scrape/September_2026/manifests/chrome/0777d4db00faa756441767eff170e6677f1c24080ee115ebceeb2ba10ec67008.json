{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ServiceNow Link Manager", "description": "This extension ensures that record urls opened in ServiceNow do not spawn multiple tabs, consolidating them into a single workspace.", "version": "1.2", "manifest_version": 3, "action": {"default_popup": "hello.html", "default_icon": {"16": "now-extension.png", "48": "now-extension.png", "128": "now-extension.png"}}, "permissions": ["tabs", "management", "scripting", "storage", "webNavigation"], "icons": {"16": "now-extension.png", "48": "now-extension.png", "128": "now-extension.png"}, "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js", "type": "module"}}