{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LLM Based Content Generator", "version": "1.3", "description": "This extension generates the desired type of descriptions using an LLM (Large Language Model) based on the content of a website.", "icons": {"16": "icons/16x16.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "permissions": ["scripting", "activeTab", "tabs", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "Bridge/background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/128x128.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["Bridge/content.js"]}], "web_accessible_resources": [{"resources": ["shared/*"], "matches": ["<all_urls>"]}]}