{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindfulTabs", "version": "1.0", "description": "Streamline your browsing: organize tabs, save sessions, activate focus mode, and get mindful breaks.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_page": "options.html", "background": {"service_worker": "services/background.js"}, "permissions": ["tabs", "storage", "tabGroups", "alarms", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open MindfulTabs popup"}}, "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js", "alarm.mp3", "icons/*"], "matches": ["<all_urls>"]}]}