{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinako - AI Tab & Session Manager", "key": "", "version": "1.3.14", "description": "The AI Librarian for your browser: advanced tab manager with nested trees, collaborative workspace, and agentic chat panel plus MCP.", "incognito": "spanning", "permissions": ["tabs", "contextMenus", "tabGroups", "storage", "identity", "sessions", "favicon", "clipboardWrite", "alarms", "nativeMessaging", "bookmarks", "downloads"], "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "icons": {"16": "assets/images/Pinako logo 32px.png", "32": "assets/images/Pinako logo 32px.png", "48": "assets/images/Pinako logo 48px.png", "128": "assets/images/Pinako logo 128px.png", "256": "assets/images/Pinako logo 256px.png", "512": "assets/images/Pinako logo 512px.png"}, "action": {"default_title": "Open Pinako"}, "commands": {"focus-tab-world": {"suggested_key": {"default": "Alt+P"}, "description": "Open Tab Manager"}}, "content_scripts": [{"matches": ["https://pinako.pro/*", "https://*.pinako.pro/*"], "js": ["pinako-web-bridge.js"], "run_at": "document_start"}]}