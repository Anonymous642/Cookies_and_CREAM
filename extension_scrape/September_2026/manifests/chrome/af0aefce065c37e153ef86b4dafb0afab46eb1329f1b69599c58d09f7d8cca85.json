{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Axiom Meeting Scribe", "version": "1.2.0", "description": "Invisible meeting notes \u2014 transcribe any meeting in real-time.", "permissions": ["activeTab", "storage", "tabCapture", "offscreen", "cookies", "sidePanel", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.webex.com/*", "https://app.slack.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.webex.com/*", "https://app.slack.com/*", "https://axiomtranscriber.vercel.app/*", "https://*.supabase.co/*"]}