{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unfollow Tracker for X", "version": "1.0.0", "description": "See who unfollowed you on X, and tell real unfollows apart from deleted or suspended accounts. Runs in your own session.", "permissions": ["storage", "alarms", "cookies", "unlimitedStorage"], "host_permissions": ["https://x.com/*"], "action": {"default_popup": "popup.html", "default_title": "Unfollow Tracker for X", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}