{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OutTrace", "description": "Monitor website trackers and third-party services. Review changes and prepare client reports. Scan data stays local.", "version": "0.5.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "alarms", "storage", "webRequest", "declarativeNetRequestWithHostAccess"], "optional_permissions": ["contextMenus", "webNavigation", "notifications"], "optional_host_permissions": ["*://*/*"], "commands": {"scan-active-tab": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Scan the current page"}}, "action": {"default_title": "OutTrace", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}]}