{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "French Level Checker \u2014 CEFR for any text", "short_name": "French Level Checker", "version": "1.2.0", "description": "Highlight French text on any webpage to see its CEFR level (A1\u2013C2), difficult words with audio, and a simpler version.", "homepage_url": "https://french.aatechax.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "French Level Checker (Alt+Shift+F to analyze selection)", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"analyze-selection": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Analyze the currently selected French text"}, "speak-selection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Speak the selected text in French"}}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://french.aatechax.com/*", "https://*.vercel.app/*"], "web_accessible_resources": [{"resources": ["selection-bubble.js"], "matches": ["<all_urls>"]}]}