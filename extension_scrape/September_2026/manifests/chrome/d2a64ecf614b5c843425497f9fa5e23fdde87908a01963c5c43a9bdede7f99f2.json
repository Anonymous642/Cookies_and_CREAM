{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save Full History(>90 days) + Cloud Backup(Cloudflare R2)", "version": "1.0.4", "description": "Browse and search your full browsing history, with no 90-day limit, and back it up to your own Cloudflare R2 bucket.", "permissions": ["history", "storage", "unlimitedStorage", "favicon", "offscreen", "alarms", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; child-src 'none'; connect-src https:"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "background": {"service_worker": "js/background.js"}, "action": {"default_title": "History", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html"}