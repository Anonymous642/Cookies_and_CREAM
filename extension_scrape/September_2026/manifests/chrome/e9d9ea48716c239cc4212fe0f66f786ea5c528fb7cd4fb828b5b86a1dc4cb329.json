{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FantasyForge", "version": "1.2.0", "description": "Syncs your ESPN or Sleeper draft live to your fantasyforge.gg board, and connects your ESPN leagues to League Sync.", "minimum_chrome_version": "111", "permissions": ["storage", "scripting", "cookies"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "FantasyForge", "default_popup": "content/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "host_permissions": ["*://*.espn.com/*", "https://sleeper.com/*", "https://fantasyforge.gg/*", "https://www.fantasyforge.gg/*", "https://fantasyfb.net/*", "https://www.fantasyfb.net/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["fonts/cormorant-garamond-latin.woff2"], "matches": ["https://*.espn.com/*", "https://sleeper.com/*"]}], "content_scripts": [{"matches": ["https://fantasy.espn.com/football/*"], "js": ["content/ws-sniffer.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://fantasy.espn.com/football/*"], "js": ["content/espn-draft.js", "content/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://sleeper.com/*"], "js": ["content/ws-sniffer.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://sleeper.com/*"], "js": ["content/sleeper-draft.js", "content/overlay.js"], "run_at": "document_idle"}, {"matches": ["https://fantasyforge.gg/*", "https://www.fantasyforge.gg/*", "https://fantasyfb.net/*", "https://www.fantasyfb.net/*"], "js": ["content/app-bridge.js"], "all_frames": true, "run_at": "document_idle"}]}