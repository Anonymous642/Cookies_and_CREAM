{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Steam Price Converter", "version": "1.0.0", "description": "Shows converted prices next to USD prices on Steam pages.", "permissions": ["storage", "tabs", "scripting"], "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "action": {"default_title": "Steam Price Converter", "default_popup": "popup.html"}, "host_permissions": ["https://store.steampowered.com/*", "https://api.frankfurter.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://store.steampowered.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}