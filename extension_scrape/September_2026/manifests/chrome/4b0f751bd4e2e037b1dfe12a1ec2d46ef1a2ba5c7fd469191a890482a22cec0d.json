{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto SNS", "version": "1.0.4", "description": "Auto SNS is a tool that helps you to generate tweets and comments with advanced AI.", "author": "UniqueGAI", "homepage_url": "https://autosns.net", "default_locale": "en", "permissions": ["activeTab", "contextMenus", "storage", "notifications", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://autosns.net/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "http://reddit.com/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}