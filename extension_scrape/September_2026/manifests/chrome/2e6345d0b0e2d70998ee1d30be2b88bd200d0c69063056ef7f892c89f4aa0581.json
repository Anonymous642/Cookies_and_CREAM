{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReelBrief Saver", "version": "0.1.0", "description": "Bewaar YouTube-URL's tijdens het browsen en open ze met \u00e9\u00e9n klik in ReelBrief.", "permissions": ["tabs", "storage", "contextMenus"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "ReelBrief Saver", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}]}