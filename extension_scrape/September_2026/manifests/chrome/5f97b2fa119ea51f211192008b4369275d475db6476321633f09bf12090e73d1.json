{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Doc Egg Timer \u2013 Temporary Google Drive Files with Auto-Delete", "description": "Create or upload temporary Google Drive files. Set a timer so they auto move to Trash", "version": "3.3.6", "minimum_chrome_version": "116", "permissions": ["storage", "identity", "alarms"], "host_permissions": ["https://www.googleapis.com/*"], "oauth2": {"client_id": "1006310209227-ai81q115rgkl314f7b0k7nafoiekr3p4.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Doc Egg Timer", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "popup.html?full=1", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors https://drive.google.com"}, "web_accessible_resources": [{"resources": ["inline.html", "workspace.html"], "matches": ["https://drive.google.com/*"]}], "content_scripts": [{"matches": ["https://drive.google.com/drive/*"], "js": ["drive-button.js", "drive-existing.js"], "css": ["drive-button.css"], "run_at": "document_idle"}, {"matches": ["https://docs.google.com/document/d/*", "https://docs.google.com/spreadsheets/d/*", "https://docs.google.com/presentation/d/*", "https://docs.google.com/drawings/d/*", "https://drive.google.com/file/d/*"], "js": ["banner.js"], "run_at": "document_start"}]}