{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paper2Audio", "description": "Listen to your research papers, web articles and ebooks with Paper2Audio", "version": "1.8.15", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "minimum_chrome_version": "116", "permissions": ["offscreen", "storage", "tabs", "activeTab", "scripting", "unlimitedStorage"], "host_permissions": ["<all_urls>", "https://paper2audio.com/*"], "action": {"default_popup": "popup.html", "default_title": "Paper2Audio"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Paper2Audio extension (S for Submit)"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*", "*://*/*.epub", "*://*/*.pdf"], "js": ["content-scripts/content.js"]}]}