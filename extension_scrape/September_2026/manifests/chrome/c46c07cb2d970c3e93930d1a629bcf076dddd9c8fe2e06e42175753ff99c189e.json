{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UpProp - Upwork Proposal Assistant", "version": "1.3.1", "description": "AI-powered proposal writing assistant for Upwork", "permissions": ["storage", "activeTab", "scripting", "unlimitedStorage", "alarms", "notifications"], "host_permissions": ["https://www.upwork.com/*", "https://hooks.slack.com/*", "https://upprop.app/*", "https://upprop.onrender.com/*"], "action": {"default_popup": "options.html", "default_icon": {"16": "assets/images/icon16.png", "32": "assets/images/icon32.png", "48": "assets/images/icon48.png", "128": "assets/images/icon128.png"}}, "icons": {"16": "assets/images/icon16.png", "32": "assets/images/icon32.png", "48": "assets/images/icon48.png", "128": "assets/images/icon128.png"}, "background": {"service_worker": "background.min.js"}, "content_scripts": [{"matches": ["https://www.upwork.com/nx/proposals/job/*/apply/", "https://www.upwork.com/nx/proposals/interview/uid/*"], "js": ["content.min.js"], "css": ["styles.min.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["assets/*", "assets/images/*"], "matches": ["<all_urls>"]}], "options_page": "options.html"}