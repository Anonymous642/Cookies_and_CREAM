{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Screenshot Studio - Capture, Annotate, Export", "version": "2.1.8", "description": "Capture and annotate screenshots, organize local history, and export as PNG, JPG, PDF, or ZIP.", "manifest_version": 3, "minimum_chrome_version": "114", "permissions": ["activeTab", "storage", "downloads", "contextMenus", "scripting", "clipboardWrite"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "action": {"default_title": "Screenshot Studio", "default_popup": "popup.html", "default_icon": {"16": "assets/ext-icon-16.png", "24": "assets/ext-icon-24.png", "32": "assets/ext-icon-32.png", "64": "assets/ext-icon-64.png", "128": "assets/ext-icon-128.png"}}, "icons": {"16": "assets/ext-icon-16.png", "24": "assets/ext-icon-24.png", "32": "assets/ext-icon-32.png", "64": "assets/ext-icon-64.png", "128": "assets/ext-icon-128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Capture the visible area"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Capture a selected area"}}}