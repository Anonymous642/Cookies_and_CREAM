{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Sidebar", "version": "0.1.0", "description": "Chat with ChatGPT (and soon Claude & Gemini) in a side panel. Just log in \u2014 no API keys.", "permissions": ["storage", "sidePanel", "declarativeNetRequest"], "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open AI Sidebar", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open the AI Sidebar"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}