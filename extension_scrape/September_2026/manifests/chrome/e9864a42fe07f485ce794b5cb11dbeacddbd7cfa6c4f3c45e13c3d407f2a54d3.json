{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bye bye YouTube Yoodles: Hide useless banners", "description": "Blocks yoodles and promo banners outright. Switch off recommendations or the notification bell, and pick the masthead logo.", "version": "2.1.2", "icons": {"128": "icons/yoodle.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "scripts/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["scripts/strip-title.js", "scripts/swap-logo.js"], "css": ["css/yoodles.css", "css/logo.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["logos/regular.svg", "logos/premium.svg"], "matches": ["https://www.youtube.com/*"]}], "action": {"default_popup": "popup.html"}}