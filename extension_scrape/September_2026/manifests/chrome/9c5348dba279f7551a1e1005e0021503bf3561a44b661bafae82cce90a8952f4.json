{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PriceNimbus - Price Tracker & Alerts", "short_name": "PriceNimbus", "description": "Track Amazon prices, get instant alerts when prices drop, and never miss a deal. Free automatic price monitoring.", "version": "1.2.0", "author": "PriceNimbus", "homepage_url": "https://pricenimbus.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "PriceNimbus - Track Prices"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["content-scripts/amazon.js"], "css": ["content-scripts/overlay.css"], "run_at": "document_idle"}], "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["https://pricenimbus.com/*", "*://*.amazon.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://*.amazon.com/*"]}]}