{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "sub.wtf", "description": "Universal subtitle downloader and player for any video", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "identity", "webNavigation"], "host_permissions": ["https://*.supabase.co/*", "https://*.chromiumapp.org/*"], "web_accessible_resources": [{"resources": ["magic-link.html", "upgrade-success.html"], "matches": ["*://*/*"]}, {"resources": ["content-scripts/content.css"], "matches": ["*://*/*"]}], "externally_connectable": {"matches": ["http://localhost:*/*", "https://sub.wtf/*", "https://*.sub-wtf.pages.dev/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "all_frames": true, "match_about_blank": true, "js": ["content-scripts/content.js"]}]}