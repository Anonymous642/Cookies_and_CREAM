{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Magic Pen AI - Free AI Writing Assistant", "description": "Freemium AI writing assistant: 3 free requests/day. Fix grammar, rewrite text, and summarize; Premium unlocks unlimited use.", "version": "1.0.3", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "contextMenus", "identity", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"show-magicpen": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Open Magic Pen AI"}, "improve-text": {"suggested_key": {"default": "Alt+I", "mac": "Alt+I"}, "description": "Improve selected text"}, "fix-grammar": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Fix grammar"}, "summarize-text": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Summarize text"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Magic Pen AI", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}]}