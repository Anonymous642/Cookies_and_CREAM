{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Randopaedia", "version": "1.1", "description": "Random Radiopaedia cases with a study mode that hides diagnosis hints.", "icons": {"16": "icon16.png", "32": "icon32.png", "192": "icon192.png", "512": "icon512.png"}, "action": {"default_popup": "popup.html", "default_title": "Randopaedia"}, "permissions": ["tabs", "storage", "activeTab"], "host_permissions": ["https://radiopaedia.org/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://radiopaedia.org/*"], "js": ["contentScript.js"], "css": ["styles.css"], "run_at": "document_start"}], "commands": {"randomize": {"suggested_key": {"default": "Alt+R", "windows": "Alt+R", "mac": "Alt+R"}, "description": "Open random case"}, "toggle-reveal": {"suggested_key": {"default": "Alt+Space", "windows": "Alt+Space", "mac": "Alt+Space"}, "description": "Toggle reveal/unreveal diagnosis"}, "toggle-study-mode": {"suggested_key": {"default": "Alt+S", "windows": "Alt+S", "mac": "Alt+S"}, "description": "Toggle study mode on/off"}}}