{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mark-Us", "version": "0.4.0", "description": "Easily make notes on your favourite web pages and interact with them.", "icons": {"16": "assets/app-icon-16.png", "64": "assets/app-icon-64.png", "128": "assets/app-icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_title": "Mark-Us"}, "side_panel": {"default_path": "sidepanel.html", "enabled": true}, "web_accessible_resources": [{"resources": ["assets/*", "content/*", "content.css", "content.js"], "matches": ["https://*/*", "http://*/*"]}]}