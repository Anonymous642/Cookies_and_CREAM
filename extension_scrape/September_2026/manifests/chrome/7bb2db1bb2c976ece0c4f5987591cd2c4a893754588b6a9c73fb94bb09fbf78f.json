{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Quota Tracker", "version": "1.1.0", "description": "Tracks your LLM usage limits across Claude, ChatGPT, and Gemini in one dashboard.", "permissions": ["storage", "alarms", "idle", "notifications"], "host_permissions": ["https://claude.ai/api/*", "https://chatgpt.com/backend-api/*", "https://chatgpt.com/api/*", "https://api.polar.sh/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["*://chatgpt.com/*"], "js": ["content_chatgpt.js"]}, {"matches": ["https://gemini.google.com/usage*"], "js": ["gemini_scraper.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "View AI Quotas"}, "background": {"service_worker": "background.js"}, "options_page": "options.html"}