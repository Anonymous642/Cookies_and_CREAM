{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoPrintFarm", "description": "Sync your Etsy sold orders directly into your AutoPrintFarm 3D print farm account. One-click import, no CSVs.", "version": "1.2.2", "homepage_url": "https://app.autoprintfarm.com", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "alarms"], "host_permissions": ["https://www.etsy.com/*", "https://api.autoprintfarm.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["etsy-scrape.js"], "matches": ["https://www.etsy.com/*"]}], "content_scripts": [{"matches": ["https://www.etsy.com/your/orders/sold*"], "js": ["etsy-scrape.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.etsy.com/your/orders/sold*"], "js": ["content-auto.js"], "run_at": "document_idle"}, {"matches": ["https://app.autoprintfarm.com/*"], "js": ["bridge.js"], "run_at": "document_start"}]}