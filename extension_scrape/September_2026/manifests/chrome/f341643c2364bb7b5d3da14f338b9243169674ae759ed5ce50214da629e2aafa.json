{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Oculis", "version": "1.2.1", "description": "Enhances website readability for color-blind users and provides CVD simulation for developers.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}, "action": {"default_title": "CVD Simulation Extension", "default_popup": "index.html", "default_icon": {"64": "icons/64.png", "128": "icons/128.png"}}, "commands": {"toggle_high_contrast": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle High Contrast Mode"}, "toggle_cvd_simulation": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle CVD Simulation"}}, "background": {"service_worker": "background/serviceWorker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/contentScript.js"], "run_at": "document_idle"}]}