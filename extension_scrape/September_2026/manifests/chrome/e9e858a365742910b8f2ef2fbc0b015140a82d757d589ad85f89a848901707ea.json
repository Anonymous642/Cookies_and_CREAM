{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneClick Screenshot YouTube", "description": "Capture photos from YouTube videos with one click. Screenshot and download full-resolution frames easily.", "version": "1.0.0", "icons": {"16": "/icon.png", "32": "/icon.png", "48": "/icon.png", "128": "/icon.png"}, "permissions": ["storage", "tabs"], "commands": {"take-screenshot": {"description": "Take a screenshot of the current YouTube video frame"}}, "web_accessible_resources": [{"matches": ["*://*.youtube.com/*"], "resources": ["icon.svg"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "OneClick Screenshot YouTube", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}