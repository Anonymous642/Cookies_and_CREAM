{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Live Subtitle Translator", "version": "0.2.1", "description": "Instantly translate subtitles on Max, Netflix and YouTube into your language. Dual subtitles, multi-language, on/off toggle.", "permissions": ["storage"], "host_permissions": ["https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*", "https://api.openai.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://play.max.com/*", "https://www.max.com/*", "https://max.com/*", "https://play.hbomax.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://www.netflix.com/*"], "js": ["src/adapters.js", "src/content.js"], "css": ["overlay.css"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup/popup.html", "default_title": "Live Subtitle Translator", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}