{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Til Tomorrow \u2013 Task Management for Daily Productivity", "version": "1.0.0", "description": "A modern task manager that helps you avoid being overwhelmed by your schedule by helping you to focus on today and tomorrow's tasks.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.supabase.co https://*.googleapis.com https://extensionpay.com; frame-src 'self' https://*.supabase.co https://accounts.google.com/"}, "permissions": ["storage", "alarms", "notifications", "identity"], "host_permissions": ["https://*.googleapis.com/*", "https://*.supabase.co/*", "https://extensionpay.com/*", "https://accounts.google.com/*"], "web_accessible_resources": [{"resources": ["options/options.html", "options/reset-password.html", "lib/*", "assets/*"], "matches": ["https://*.supabase.co/*", "https://*.googleapis.com/*", "https://extensionpay.com/*"]}], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+E", "mac": "Command+E"}, "description": "Open Til Tomorrow Tasks popup"}, "add_new_task": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Quickly add a new task"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "options_page": "options/options.html", "oauth2": {"client_id": "${process.env.GOOGLE_CLIENT_ID}", "scopes": ["openid", "email", "profile"]}}