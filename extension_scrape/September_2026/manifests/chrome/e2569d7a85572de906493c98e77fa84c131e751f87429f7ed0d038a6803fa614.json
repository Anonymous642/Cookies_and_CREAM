{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts Blocker", "version": "1.0.0", "description": "Block YouTube Shorts across YouTube: hide Shorts shelves, cards and nav links, and bounce /shorts/ pages back home.", "author": "Prisma Labs", "homepage_url": "https://prismalabs.dev", "minimum_chrome_version": "116", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*"], "declarative_net_request": {"rule_resources": [{"id": "shorts_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content.js"], "css": ["src/block.css"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}