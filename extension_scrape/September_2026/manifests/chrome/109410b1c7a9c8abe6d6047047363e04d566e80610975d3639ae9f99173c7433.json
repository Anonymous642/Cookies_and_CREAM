{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "swft.list - minimal task manager, to-do list & notepad", "version": "6.1.7", "description": "Type a task, hit Enter, done. No extra steps, no setup. Your list lives in the browser where you already work.", "background": {"service_worker": "src/sw.js", "type": "module"}, "permissions": ["sidePanel", "notifications", "alarms", "storage"], "side_panel": {"default_path": "src/panel/panel.html"}, "action": {"default_title": "Open swft.list"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+S"}, "description": "Open the swft.list panel"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}