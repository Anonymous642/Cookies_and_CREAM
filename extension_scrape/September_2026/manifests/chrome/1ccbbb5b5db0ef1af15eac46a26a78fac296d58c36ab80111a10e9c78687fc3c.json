{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unified Privacy Guard", "version": "1.0.0", "description": "Unified privacy and visual blur protection across Facebook, WhatsApp, and Telegram.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Unified Privacy Guard"}, "background": {"service_worker": "service-worker.js"}, "options_page": "options/options.html", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.whatsapp.com/*", "*://*.web.telegram.org/*", "*://web.telegram.org/*", "*://*.telegram.org/*"], "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.whatsapp.com/*", "*://*.web.telegram.org/*", "*://web.telegram.org/*", "*://*.telegram.org/*"], "css": ["content/content.css"], "js": ["core/settings.js", "core/presets.js", "core/blur-engine.js", "core/reveal-engine.js", "adapters/facebook.js", "adapters/whatsapp.js", "adapters/telegram.js", "content/indicator.js", "content/content.js"], "run_at": "document_idle"}], "commands": {"toggle_global_privacy": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Toggle Unified Privacy Guard globally"}}}