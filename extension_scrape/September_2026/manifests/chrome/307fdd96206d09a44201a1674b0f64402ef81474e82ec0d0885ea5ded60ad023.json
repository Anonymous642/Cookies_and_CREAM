{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Endgame Blocker", "description": "A productivity extension that classifies websites into categories and blocks/lets access based on preferences.", "version": "1.0", "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "minimum_chrome_version": "92", "action": {"default_icon": {"16": "icons/icon.png", "24": "icons/icon.png", "32": "icons/icon.png"}, "default_title": "Endgame Blocker", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'"}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "web_accessible_resources": [{"resources": ["models/**", "blocker.html", "blocker.js"], "matches": ["<all_urls>"]}]}