{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Email Finder & Email Extractor", "description": "Find and extract emails from any webpage. Stored locally \u2014 no account, no credits.", "version": "0.1.1", "short_name": "Email Finder", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Email Finder & Email Extractor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}