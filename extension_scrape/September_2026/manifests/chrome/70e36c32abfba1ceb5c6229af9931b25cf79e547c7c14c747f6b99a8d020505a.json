{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Seylo: Save to your workspace", "version": "0.4.0", "description": "Save answers, prompts and images from ChatGPT, Claude or any page straight into your Seylo projects.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Seylo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://grok.com/*", "https://chat.deepseek.com/*", "https://manus.im/*", "https://www.manus.im/*", "https://kimi.com/*", "https://www.kimi.com/*", "https://kimi.moonshot.cn/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://chat.mistral.ai/*", "https://chat.qwen.ai/*", "https://poe.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}, {"matches": ["https://seylo.co/*", "https://*.seylo.co/*"], "js": ["app-bridge.js"], "run_at": "document_end"}], "permissions": ["tabs", "storage", "cookies", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://seylo.co/*", "https://*.seylo.co/*"], "commands": {"open-overlay": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Seylo on this page"}, "screenshot": {"suggested_key": {"default": "Alt+Shift+4", "mac": "Alt+Shift+4"}, "description": "Save a screenshot of this page to Seylo"}}}