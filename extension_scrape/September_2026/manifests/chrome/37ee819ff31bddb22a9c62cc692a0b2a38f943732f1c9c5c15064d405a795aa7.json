{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kunkan Engagement Detox", "version": "1.0.0", "description": "Hide like counts, follower numbers, and engagement metrics for a healthier social media experience", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.linkedin.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.threads.net/*"], "js": ["content.js"], "css": ["detox.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["detox.css"], "matches": ["<all_urls>"]}]}