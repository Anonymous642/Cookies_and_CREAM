{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Open in BlendPDF \u2014 PDF tools", "description": "Right-click any PDF to rotate, split or merge it locally, or send it to BlendPDF for compress, OCR, convert and sign.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "downloads", "unlimitedStorage"], "host_permissions": ["https://blendpdf.com/*", "https://www.blendpdf.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "BlendPDF tools", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://blendpdf.com/*", "https://www.blendpdf.com/*"], "run_at": "document_end", "js": ["content-scripts/blendpdf.js"]}]}