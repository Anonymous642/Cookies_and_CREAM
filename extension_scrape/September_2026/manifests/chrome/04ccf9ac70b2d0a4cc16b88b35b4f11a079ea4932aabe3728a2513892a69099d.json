{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Shelf", "version": "0.2.1", "description": "Close the tabs you keep for later. Tab Shelf saves them, summarizes each page with local or free AI, and groups them by topic.", "minimum_chrome_version": "130", "permissions": ["tabs", "scripting", "storage", "unlimitedStorage", "alarms", "favicon", "declarativeNetRequestWithHostAccess", "idle"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Tab Shelf", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"stash-window": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stash all tabs in this window"}}, "author": "Rose Samaras", "homepage_url": "https://reaudit.io"}