{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault \u2013 Tab Group Manager & Memory Saver", "version": "0.1.3", "description": "File open tabs into named groups, close them to free memory, reopen any group in one click. 7-day free trial.", "permissions": ["storage", "tabs", "contextMenus", "favicon"], "host_permissions": ["https://extensionpay.com/*"], "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "TabVault \u2014 save this window's tabs", "default_popup": "src/popup/popup.html"}, "chrome_url_overrides": {"newtab": "src/newtab/newtab.html"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["src/vendor/extpay.js"], "run_at": "document_start"}]}