{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeVault: Sync YouTube Collections", "version": "1.3.0", "description": "Sync YouTube collections directly to your private TubeVault collections via the Side Panel.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.youtube.com/*", "https://tubevault.app/*"], "background": {"service_worker": "src/scripts/background.js", "type": "module"}, "action": {"default_title": "Open TubeVault Side Panel"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "exclude_globs": ["*tv_preview=1*"], "js": ["src/scripts/inject.js", "src/scripts/title-stash.js"], "run_at": "document_idle"}, {"matches": ["https://tubevault.app/*"], "exclude_globs": ["*tv_preview=1*"], "js": ["src/scripts/auth-bridge.js"], "run_at": "document_start"}], "externally_connectable": {"matches": ["https://tubevault.app/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "src/sidepanel/*"], "matches": ["https://*.youtube.com/*"]}], "commands": {"toggle-drawer": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle TubeVault Side Panel Drawer"}}}