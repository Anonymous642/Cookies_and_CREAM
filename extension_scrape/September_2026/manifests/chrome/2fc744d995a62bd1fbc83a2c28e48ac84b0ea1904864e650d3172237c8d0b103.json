{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouSpeed", "version": "1.0.0", "description": "Control your YouTube player speed rate with YouSpeed extension. Clean interface. NO TRACKING. Totally FREE!", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["contentScript.js"], "css": ["style.css"]}], "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"speed-down": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Decrease playback speed"}, "speed-up": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Increase playback speed"}}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YouSpeed"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}