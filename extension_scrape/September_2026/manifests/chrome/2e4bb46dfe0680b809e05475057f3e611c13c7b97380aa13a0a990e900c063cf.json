{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Extension Auditor", "version": "1.1.0", "description": "Real-time behavioral monitoring for your Chrome extensions. Suspicious network activity, permission drift, ownership changes.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Extension Auditor \u2014 Your extensions have a security guard now."}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["management", "webRequest", "storage", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "options_ui": {"page": "options.html", "open_in_tab": true}}