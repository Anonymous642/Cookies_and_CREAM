{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextSnap - Copy Text from Video", "description": "Pause any video, recognize on-screen text, and copy it with a click.", "version": "1.1", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"js": ["browser-polyfill.min.js", "content.js"], "css": ["overlay.css"], "matches": ["<all_urls>"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png"}}, "commands": {"toggle-ocr-mode": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle OCR mode on paused video"}}, "permissions": ["storage", "clipboardWrite", "activeTab"], "host_permissions": ["https://textsnap.a17lab.com/*"]}