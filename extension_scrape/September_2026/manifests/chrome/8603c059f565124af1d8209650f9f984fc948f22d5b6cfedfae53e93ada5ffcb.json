{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rosetta", "description": "Translate any page in place, translating only what you can actually see", "version": "0.3.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "offscreen"], "host_permissions": ["https://translate.googleapis.com/*", "https://huggingface.co/*", "https://*.hf.co/*", "https://cdn-lfs.huggingface.co/*", "https://cdn-lfs-us-1.huggingface.co/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Rosetta", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}