{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Exporter", "version": "1.0.0", "description": "Export URLs from all open tabs in multiple formats \u2014 plain, markdown, domain, or JSON.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Tab Exporter"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabs", "clipboardWrite"], "commands": {"copy-all-urls": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Copy all tab URLs to clipboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}