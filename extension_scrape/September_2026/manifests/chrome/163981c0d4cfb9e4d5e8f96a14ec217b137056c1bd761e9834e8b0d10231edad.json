{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Watchman Filter", "short_name": "Watchman Filter", "author": "CoGen, LLC", "manifest_version": 3, "version": "1.3.36", "description": "Mutes audio profanity and blocks explicit content websites. Clean audio and text filtering for any site.", "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "permissions": ["contextMenus", "declarativeNetRequest", "notifications", "storage", "tabs"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["web-filter.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}, {"resources": ["img/watchman-logo.png"], "matches": ["<all_urls>"]}], "options_ui": {"open_in_tab": true, "page": "option-page.html"}, "background": {"service_worker": "background.js"}, "action": {"default_icon": {"19": "img/icon19.png", "38": "img/icon38.png"}, "default_title": "Watchman Profanity Filter", "default_popup": "popup.html"}}