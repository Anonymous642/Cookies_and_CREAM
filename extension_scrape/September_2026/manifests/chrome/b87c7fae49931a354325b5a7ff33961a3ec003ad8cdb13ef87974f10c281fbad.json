{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fillr", "version": "1.3.0", "description": "Fillr - AI Form Filler for QA, Developers and Marketers", "permissions": ["activeTab", "storage", "commands", "scripting", "identity", "alarms", "tabs"], "host_permissions": ["<all_urls>", "https://*.supabase.co/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/detector.js", "content/filler.js", "content/local-fill.js", "content/overlay.js", "content/content.js"], "run_at": "document_idle"}], "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"fill-ai": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Fill all fields with AI-generated data"}, "fill-random": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Fill all fields with random local data (no AI)"}, "fill-template": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open quick template picker"}, "clear-fields": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clear all filled fields"}}, "web_accessible_resources": [{"resources": ["assets/icons/*", "assets/fonts/*"], "matches": ["<all_urls>"]}]}