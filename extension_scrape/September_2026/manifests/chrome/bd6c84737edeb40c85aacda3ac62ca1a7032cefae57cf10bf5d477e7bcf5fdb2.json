{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Arcium", "description": "Arc-like anchored tabs for Chrome's native vertical tabs.", "version": "0.1.0", "short_name": "Arcium", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "512": "icon/512.png"}, "minimum_chrome_version": "147", "permissions": ["tabGroups", "storage", "favicon", "scripting", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"toggle-anchor": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Command+D"}, "description": "Anchor or unanchor selected tabs"}, "duplicate-anchor": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Command+Shift+D"}, "description": "Duplicate the active tab and fork its Anchor"}, "next-group-tab": {"description": "Activate the next tab in the current Tab Group"}, "previous-group-tab": {"description": "Activate the previous tab in the current Tab Group"}, "return-home": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Command+Shift+H"}, "description": "Return the active anchor to its Home URL"}}, "action": {"default_title": "Arcium", "default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_popup": "popup.html"}, "background": {"type": "module", "service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}