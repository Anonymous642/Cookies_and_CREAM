{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coldbase", "version": "1.0.5", "description": "Track cold emails in Gmail. Privacy-first: all data stored locally, never sent to external servers. No sign-up required.", "permissions": ["storage", "notifications"], "host_permissions": ["https://mail.google.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["ai-utils.js", "content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Open Coldbase Dashboard"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Coldbase - Cold Email Memory"}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["hub.html", "hub.css", "hub.js", "dashboard.html", "dashboard.css", "dashboard.js", "modal-utils.js", "settings.html", "settings.js"], "matches": ["https://mail.google.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none';"}}