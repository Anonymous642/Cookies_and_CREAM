{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Meet Timer", "version": "1.2.0", "description": "A timer for Google Meet meetings and Google Slides presentations that appears in the top-left corner", "author": "Rubem Almeida", "homepage_url": "https://github.com/rubemalmeida/meet-timer", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://meet.google.com/*", "https://docs.google.com/*"], "content_scripts": [{"matches": ["https://meet.google.com/*", "https://docs.google.com/presentation/*"], "js": ["content.js"], "css": ["timer.css"]}], "action": {"default_popup": "popup.html", "default_title": "Meet Timer Controls", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"service_worker": "background.js"}}