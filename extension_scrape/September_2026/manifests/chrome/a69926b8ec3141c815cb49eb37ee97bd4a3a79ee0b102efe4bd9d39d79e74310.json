{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ColabPilot", "version": "1.0.1", "description": "Bridge LLM chat UIs with Google Colab GPU execution. Run code blocks from ChatGPT, Claude, and Gemini directly in Colab.", "permissions": ["sidePanel", "storage", "alarms", "tabs", "activeTab", "scripting"], "host_permissions": ["https://colab.research.google.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel/panel.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://colab.research.google.com/*"], "js": ["content-scripts/colab.js"], "run_at": "document_idle"}, {"matches": ["https://*.googleusercontent.com/*"], "js": ["content-scripts/colab-output.js"], "all_frames": true, "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["injected/colab-bridge.js"], "matches": ["https://colab.research.google.com/*", "https://*.googleusercontent.com/*"]}, {"resources": ["icons/icon16.png"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "ColabPilot", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}