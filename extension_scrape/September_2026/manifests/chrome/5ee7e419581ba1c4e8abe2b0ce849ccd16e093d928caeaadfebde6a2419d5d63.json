{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hjarni Web Clipper", "version": "0.1.0", "description": "Save the current page to your Hjarni second brain.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Clip to Hjarni", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://hjarni.com/*"], "content_scripts": [{"matches": ["https://hjarni.com/clip"], "js": ["content-clip.js"], "run_at": "document_end"}]}