{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ripple by ee", "version": "0.1.0", "description": "Temporarily refract the visible webpage with a bird's-eye water ripple.", "icons": {"16": "icons/rock-16.png", "32": "icons/rock-32.png", "48": "icons/rock-48.png", "128": "icons/rock-128.png"}, "action": {"default_title": "Ripple by ee", "default_icon": {"16": "icons/rock-16.png", "32": "icons/rock-32.png", "48": "icons/rock-48.png", "128": "icons/rock-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"activate-ripple": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Activate Ripple Mode"}, "activate-skip": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Activate Rock Skip Mode"}}, "permissions": ["activeTab", "scripting"], "web_accessible_resources": [{"resources": ["assets/river-rock-cursor.png", "assets/rock-skip.mp3", "assets/stone-in-water.mp3"], "matches": ["<all_urls>"]}]}