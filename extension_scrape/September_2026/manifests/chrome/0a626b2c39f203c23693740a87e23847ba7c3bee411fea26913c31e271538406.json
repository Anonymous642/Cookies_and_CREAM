{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kyurations - AI Web Clipper & Bookmark Curator", "version": "1.3.4", "description": "AI web clipper and bookmark curator. Save any page, or highlight text and clip regions, with AI-picked lists, tags, and notes.", "homepage_url": "https://www.kyurations.in", "action": {"default_title": "Save to Kyurations", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "host_permissions": [], "optional_host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "config.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://www.kyurations.in/*", "https://kyurations.in/*"], "js": ["bridge.js"], "run_at": "document_start"}], "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save to Kyurations (with the selected text as a highlight)"}, "clip-region": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Clip a region of the page to Kyurations"}}}