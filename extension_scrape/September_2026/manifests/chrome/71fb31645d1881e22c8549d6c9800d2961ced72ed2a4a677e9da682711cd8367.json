{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TabSorter", "description": "TabSorter is a Chrome extension that helps users organize their open tabs by listing and sorting them based on their domain.", "version": "1.0", "manifest_version": 3, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "permissions": ["tabs", "storage"], "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}