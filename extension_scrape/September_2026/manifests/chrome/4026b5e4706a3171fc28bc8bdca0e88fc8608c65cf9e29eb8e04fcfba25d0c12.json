{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlowSync - YouTube AI Dubbing", "description": "AI-powered video dubbing for YouTube videos with real-time translation and voice synthesis", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["storage", "cookies"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://urflowsync.com/*"], "web_accessible_resources": [{"resources": ["assets/*", "assets/styles/*", "content/*", "_locales/*"], "matches": ["*://*.youtube.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "FlowSync - Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}