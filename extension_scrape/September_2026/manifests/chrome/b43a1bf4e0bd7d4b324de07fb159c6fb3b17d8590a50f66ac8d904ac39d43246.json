{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LaunchBridge", "version": "0.1.2", "description": "Discover and analyze competitor ads on Facebook Ad Library. Works together with your LaunchBridge account.", "permissions": ["storage", "tabs", "activeTab", "alarms"], "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://launchbridge.nl/*", "https://*.launchbridge.nl/*"], "action": {"default_popup": "popup/popup.html", "default_title": "LaunchBridge", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.facebook.com/ads/library/*"], "js": ["content/adlib-injected.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://www.facebook.com/ads/library/*"], "js": ["content/adlib.js"], "run_at": "document_idle"}, {"matches": ["https://launchbridge.nl/*", "https://*.launchbridge.nl/*"], "js": ["content/bridge.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://launchbridge.nl/*", "https://*.launchbridge.nl/*"]}, "web_accessible_resources": [{"resources": ["content/adlib-injected.js"], "matches": ["https://www.facebook.com/*"]}]}