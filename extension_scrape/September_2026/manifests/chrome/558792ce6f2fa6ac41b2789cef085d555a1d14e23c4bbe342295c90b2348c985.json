{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Open Translate AI", "version": "1.0.7", "description": "Select text, click once, and get an instant translation copied to your clipboard using your own OpenAI API key.", "action": {"default_title": "Open Translate AI", "default_popup": "popup.html"}, "permissions": ["scripting", "activeTab", "storage", "clipboardWrite"], "background": {"service_worker": "bg.js", "type": "module"}, "options_page": "options.html", "icons": {"128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}