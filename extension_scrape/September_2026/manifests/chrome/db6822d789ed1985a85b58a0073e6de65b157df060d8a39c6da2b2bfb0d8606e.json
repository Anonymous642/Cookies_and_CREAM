{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Subtitle Translator", "short_name": "Subtitle Translator", "version": "1.0.0", "description": "Hover over a word in YouTube subtitles to get an instant, context-aware translation powered by OpenAI.", "permissions": ["storage"], "host_permissions": ["https://api.openai.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "YouTube Subtitle Translator", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}