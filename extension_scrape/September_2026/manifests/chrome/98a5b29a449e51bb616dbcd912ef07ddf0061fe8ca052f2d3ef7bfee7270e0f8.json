{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Albus \u2014 Facebook Groups", "version": "9.11.4", "description": "Publish your Albus listings to your Facebook groups from your browser. \u05e4\u05e8\u05e1\u05d5\u05dd \u05e0\u05db\u05e1\u05d9\u05dd \u05d1\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e4\u05d9\u05d9\u05e1\u05d1\u05d5\u05e7 \u00b7 Publie dans tes groupes FB.", "permissions": ["scripting", "storage", "cookies"], "host_permissions": ["https://www.facebook.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://*.amazonaws.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/groups/*"], "js": ["capture-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.facebook.com/groups/*"], "js": ["api-poster.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://instagram.com/*", "https://*.instagram.com/*"], "js": ["capture-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://instagram.com/*", "https://*.instagram.com/*"], "js": ["api-ig.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.facebook.com/groups/*", "https://instagram.com/*", "https://*.instagram.com/*"], "js": ["capture-relay.js"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Albus \u2014 Publication FB", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "externally_connectable": {"matches": ["https://albus-ai.com/*", "https://*.albus-ai.com/*", "http://localhost:3000/*"]}}