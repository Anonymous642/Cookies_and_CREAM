{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Master - Save Tabs, Auto Organize & RAM Saver", "version": "1.4.0", "description": "Save & restore tabs instantly. Auto-organize, suspend tabs to save RAM, search sessions. Free local tab & session manager.", "permissions": ["tabs", "storage", "unlimitedStorage", "notifications", "alarms", "history"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["hotkey-listener.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["http://*/*", "https://*/*"], "js": ["floating-button.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}}, "quick-save": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Save all tabs and close them"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "web_accessible_resources": [{"resources": ["floating-button.css", "popup.html"], "matches": ["http://*/*", "https://*/*"]}]}