{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "View as Markdown", "description": "Extract web page content and display it as Markdown in an in-page reader.", "version": "0.3.0", "icons": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "permissions": ["activeTab"], "action": {"default_title": "View as Markdown"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "View current page as Markdown"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}