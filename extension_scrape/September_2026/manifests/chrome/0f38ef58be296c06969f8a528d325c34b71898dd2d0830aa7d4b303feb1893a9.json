{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoiceThread \u2014 Audio Comments for YouTube & Twitch", "version": "1.3.7", "description": "Leave and listen to voice notes on YouTube videos and Twitch streams.", "permissions": ["microphone", "storage", "activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://www.twitch.tv/*", "https://firestore.googleapis.com/*", "https://api.cloudinary.com/*", "https://res.cloudinary.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"], "js": ["firebase.js", "recorder.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["sounds/*.mp3"], "matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"]}]}