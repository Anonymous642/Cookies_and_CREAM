{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comment Block", "version": "1.1", "description": "Detects bot comments on YouTube and replaces their profile and name.", "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["blurred.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}