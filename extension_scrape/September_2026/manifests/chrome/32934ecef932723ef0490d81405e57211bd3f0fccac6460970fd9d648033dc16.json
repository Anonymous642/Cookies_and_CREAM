{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leaflet", "description": "Save, restore, and manage your browser tab sessions with one click", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "alarms", "favicon"], "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-last-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore most recent session"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Leaflet", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}}