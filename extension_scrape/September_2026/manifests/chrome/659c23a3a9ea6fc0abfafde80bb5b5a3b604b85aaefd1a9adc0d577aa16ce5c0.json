{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabRewind", "description": "Instantly jump back to your last visited tab with a shortcut.", "version": "1.3.0", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TabRewind", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"go-to-last-tab": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Rewind \u2014 jump to last visited tab"}, "go-to-next-tab": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Forward \u2014 go to next tab in walk history"}}}