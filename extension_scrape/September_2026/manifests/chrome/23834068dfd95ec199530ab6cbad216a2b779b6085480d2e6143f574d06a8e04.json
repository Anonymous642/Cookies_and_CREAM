{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vivies Toolkit for Youtube", "version": "1.0.3", "description": "Modular YouTube toolkit with Discovery, Quality, Focus mode, and Looper.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://us-central1-vivies-toolkit-for.cloudfunctions.net/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["core/helpers.js", "modules/looper/content-behaviors.js", "modules/quality-settings/content-behaviors.js", "modules/discovery/content-behaviors.js", "modules/focus/content-behaviors.js", "content/content.js"], "css": ["content/styles.css", "modules/looper/styles.css", "modules/discovery/styles.css"], "run_at": "document_start"}, {"matches": ["https://music.youtube.com/*"], "js": ["core/helpers.js", "modules/looper/content-behaviors-music.js", "content/content.js"], "css": ["modules/looper/styles.css"], "run_at": "document_start"}], "action": {"default_title": "Vivies Toolkit for Youtube", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidebar/sidebar.html"}, "web_accessible_resources": [{"resources": ["modules/quality-settings/page-bridge.js"], "matches": ["https://www.youtube.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}