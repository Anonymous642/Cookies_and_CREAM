{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lake Ontario, Forever", "description": "Politely asks Google Maps and embedded maps to use Canadian names. Built for anyone who prefers Lake Ontario to stay Lake Ontario.", "version": "1.0.0", "icons": {"16": "icons/canada-16.png", "32": "icons/canada-32.png", "48": "icons/canada-48.png", "128": "icons/canada-128.png"}, "action": {"default_title": "Lake Ontario, Forever", "default_popup": "popup.html", "default_icon": {"16": "icons/canada-16.png", "32": "icons/canada-32.png", "48": "icons/canada-48.png", "128": "icons/canada-128.png"}}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://maps.googleapis.com/*", "*://www.google.com/maps*", "*://google.com/maps*", "*://www.google.com/maps/embed/*", "*://google.com/maps/embed/*", "*://*/*"], "declarative_net_request": {"rule_resources": [{"id": "force_canada_region", "enabled": true, "path": "rules/force-canada-region.json"}]}, "background": {"service_worker": "service-worker.js"}}