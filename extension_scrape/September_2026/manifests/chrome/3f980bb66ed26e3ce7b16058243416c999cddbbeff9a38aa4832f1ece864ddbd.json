{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MOODY \u2014 Instagram Connector", "version": "0.2.1", "description": "Reads Instagram session cookies on instagram.com with your consent to connect your account to MOODY.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["cookies", "storage", "scripting"], "host_permissions": ["https://instagram.com/*", "https://*.instagram.com/*", "https://moody.team/*", "https://*.moody.team/*"], "content_scripts": [{"matches": ["https://moody.team/*", "https://*.moody.team/*"], "js": ["content-script.js"], "run_at": "document_start"}]}