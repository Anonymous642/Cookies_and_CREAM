{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Langsurf - Mandarin Graded Reading Extension", "version": "1.0.0", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_popup": "src/popup/index.html"}, "commands": {"toggle-translation": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Toggle between original and translated text"}, "start-translation": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Start translating the page"}}, "permissions": ["activeTab", "commands", "storage", "scripting"], "background": {"service_worker": "src/background.js"}}