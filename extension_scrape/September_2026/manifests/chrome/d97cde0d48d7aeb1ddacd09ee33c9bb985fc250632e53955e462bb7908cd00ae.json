{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Silent Thumbnails", "version": "1.0.0", "description": "Block annoying autoplay audio on YouTube thumbnails. Browse YouTube in peace and silence.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png", "512": "icon512.png"}, "action": {"default_popup": "popup.html", "default_title": "YT Silence"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}