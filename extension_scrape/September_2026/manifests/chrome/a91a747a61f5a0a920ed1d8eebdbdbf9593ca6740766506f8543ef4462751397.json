{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Website Blocker & Focus Timer \u2014 Pause", "version": "0.5.3", "description": "A website blocker and focus timer with breathing pauses. Set website limits, choose each visit length, and pause before scrolling.", "minimum_chrome_version": "120", "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess", "favicon", "activeTab", "webNavigation"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Pause settings", "default_popup": "index.html"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["pause.html"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}}