{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AudioFlow - Text to Speech", "version": "1.0.1", "description": "Read any webpage aloud with natural text-to-speech. Auto-scroll, multi-language support (EN, JP, KR, ID), and intuitive controls.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "offscreen", "tabCapture", "downloads"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["utils/storage.js", "content/page-parser.js", "content/text-mapper.js", "content/tts-engine.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "content/ui.css", "settings/*", "welcome/*"], "matches": ["http://*/*", "https://*/*"]}]}