{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Reddit Post Analyzer", "version": "1.0.5", "description": "Instantly summarize any Reddit thread, comments, or search \u2014 then ask AI to explain, explore, and clarify", "permissions": ["storage", "activeTab", "tabs", "identity"], "oauth2": {"client_id": "837073239595-d82jmt90dcg6pg1suilajc7rl2auf2b8.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/userinfo.email", "https://www.googleapis.com/auth/userinfo.profile"]}, "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://clicksummary.com/*", "https://www.clicksummary.com/*", "http://localhost:3001/*", "http://localhost:3002/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/reddit16.png", "48": "icons/reddit48.png", "128": "icons/reddit128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.reddit.com/r/*/comments/*", "https://old.reddit.com/r/*/comments/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://clicksummary.com/*", "https://www.clicksummary.com/*", "http://localhost:3002/*"], "js": ["website-sync.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"]}], "icons": {"16": "icons/reddit16.png", "48": "icons/reddit48.png", "128": "icons/reddit128.png"}, "externally_connectable": {"matches": ["http://localhost:3002/*", "https://clicksummary.com/*", "https://www.clicksummary.com/*"]}}