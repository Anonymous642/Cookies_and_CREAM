{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cookie Consent Handler", "description": "Automatically handles cookie consent banners based on your explicit preference: Accept, Reject, or Manual.", "version": "1.0.0", "action": {"default_title": "Cookie Consent Handler", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "options_page": "options/options.html", "background": {"service_worker": "background.js"}, "permissions": ["storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}