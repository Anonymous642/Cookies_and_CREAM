{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedactPro - Blur & Redact Sensitive Info", "short_name": "RedactPro", "version": "1.0.0", "description": "One click to blur, pixelate or redact sensitive info on any webpage. Auto-detects emails, API keys, IPs. Perfect for demos.", "author": "RedactPro", "action": {"default_popup": "popup/popup.html", "default_title": "RedactPro - Blur & Redact", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "scripting", "downloads", "alarms"], "host_permissions": ["https://licenses.redactpro.io/*"], "background": {"service_worker": "background/background.js"}, "web_accessible_resources": [{"resources": ["lib/LicenseClient.js"], "matches": ["<all_urls>"]}], "commands": {"toggle-redact-mode": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle Redact Mode on current tab"}, "auto-redact-sensitive": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Auto-detect and redact sensitive info"}}}