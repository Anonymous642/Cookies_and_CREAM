{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GuardRail AI \u2013 Privacy Shield for AI Chats", "version": "1.0.2", "description": "Stop sensitive data leaking into ChatGPT, Claude & other AI chats \u2014 on-device detection, redaction, smarter prompts.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://*.chatgpt.com/*", "https://*.openai.com/*", "https://*.claude.ai/*", "https://*.gemini.google.com/*", "https://*.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://chat.mistral.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*", "https://api.lemonsqueezy.com/*"], "content_scripts": [{"matches": ["https://*.chatgpt.com/*", "https://*.openai.com/*", "https://*.claude.ai/*", "https://*.gemini.google.com/*", "https://*.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://chat.mistral.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_security_policy": {"extension_pages": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' https: data: chrome-extension:; connect-src 'self' https:;"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "web_accessible_resources": [{"resources": ["content.css", "icon.png"], "matches": ["https://*.chatgpt.com/*", "https://*.openai.com/*", "https://*.claude.ai/*", "https://*.gemini.google.com/*", "https://*.perplexity.ai/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://chat.mistral.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*"]}]}