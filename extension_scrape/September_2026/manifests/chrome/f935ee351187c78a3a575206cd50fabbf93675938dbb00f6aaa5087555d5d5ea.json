{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "description": "See exactly where your browser time goes \u2014 then turn it into blocking rules in one tap. Local-only, no account, free.", "name": "TabInsights: Screen Time Tracker That Blocks Your Time Sinks", "short_name": "TabInsights", "version": "2.5.1", "minimum_chrome_version": "89", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["bookmarks", "storage", "tabs", "tabGroups", "declarativeNetRequest", "windows", "alarms", "notifications", "downloads", "contextMenus", "tts", "scripting", "activeTab", "favicon"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "19": "icon19.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "TabInsights \u2014 see your screen time, then block it"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "analytics.html", "chrome_url_overrides": {"newtab": "newtab.html"}, "web_accessible_resources": [{"resources": ["suspended.html", "blocked.html", "blocked.js", "blocked_motivator.png"], "matches": ["<all_urls>"]}], "host_permissions": ["https://live.dodopayments.com/*"], "commands": {"open-search": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open tab search"}, "group-tabs": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Group tabs by domain"}, "export-data": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Export extension data"}}}