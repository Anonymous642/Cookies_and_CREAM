{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Email Read Receipts", "version": "0.1.0", "description": "Track when your emails are opened.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.cloud.microsoft/*", "https://mail.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.cloud.microsoft/*"], "js": ["content/outlook.js"]}, {"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"]}], "side_panel": {"default_path": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Email Read Receipts", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.cloud.microsoft/*"]}], "commands": {"open-sidebar": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Open Read Receipts sidebar"}}}