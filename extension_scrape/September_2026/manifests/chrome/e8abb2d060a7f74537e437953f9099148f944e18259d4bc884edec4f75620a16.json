{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Sales Spy", "version": "1.2", "description": "Shows estimated sales, publish date, and review count on Amazon search and product pages.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Amazon Sales Spy", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}, {"matches": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*", "https://www.amazon.com.au/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.es/*", "https://www.amazon.it/*", "https://www.amazon.co.jp/*", "https://www.amazon.in/*", "https://www.amazon.com.mx/*", "https://www.amazon.com.br/*", "https://www.amazon.nl/*"], "js": ["config.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}