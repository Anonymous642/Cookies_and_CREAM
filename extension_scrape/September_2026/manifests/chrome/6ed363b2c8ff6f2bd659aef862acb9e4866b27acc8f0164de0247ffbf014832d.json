{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Volume Mixer", "version": "1.7.0", "description": "Control each tab's volume independently. Boost quiet tabs up to 600% or mute loud ones. Pro: remember a volume per website.", "commands": {"panel": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open Tab Volume Mixer (center of screen)"}, "mute-active": {"suggested_key": {"default": "Ctrl+Space"}, "description": "Mute / unmute the current tab"}, "vol-up": {"suggested_key": {"default": "Ctrl+Up"}, "description": "Volume up (current tab)"}, "vol-down": {"suggested_key": {"default": "Ctrl+Down"}, "description": "Volume down (current tab)"}}, "permissions": ["tabCapture", "offscreen", "tabs", "storage", "scripting", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Tab Volume Mixer (click for center mixer)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}