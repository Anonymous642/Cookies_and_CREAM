{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StepTrace", "version": "7.2.2", "description": "Record browser interactions as test steps. Export to Tuskr, Gherkin, Playwright, Cypress, Vibium.", "author": "Bart\u0142omiej Krzymowski", "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "scripting"], "host_permissions": ["https://*/*", "http://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "StepTrace - Record test steps"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*.png", "dictionary.html", "dictionary.js"], "matches": ["<all_urls>"]}]}