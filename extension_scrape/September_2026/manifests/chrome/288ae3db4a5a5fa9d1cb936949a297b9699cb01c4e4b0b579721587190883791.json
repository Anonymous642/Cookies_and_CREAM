{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Review Downloader", "version": "1.0.0", "description": "Extract and export Amazon product reviews to CSV, JSON, and Excel.", "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.co.jp/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.amazon.com.au/*", "https://*.amazon.com.br/*", "https://*.amazon.com.mx/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.co.jp/*", "https://*.amazon.ca/*", "https://*.amazon.in/*", "https://*.amazon.com.au/*", "https://*.amazon.com.br/*", "https://*.amazon.com.mx/*"], "js": ["contentScript.js"], "css": ["styles.css"]}], "web_accessible_resources": [{"resources": ["libs/*.js", "reviewExtractor.js", "sentimentAnalyzer.js"], "matches": ["<all_urls>"]}]}