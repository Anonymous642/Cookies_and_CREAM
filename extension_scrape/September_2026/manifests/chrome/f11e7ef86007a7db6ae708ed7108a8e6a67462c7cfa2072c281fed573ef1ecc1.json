{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tomesphere", "version": "1.0.9", "description": "TLDR, citations, linked entities, and similar papers shown beside the research paper you're reading.", "permissions": ["sidePanel", "storage", "activeTab", "tabs"], "host_permissions": ["https://arxiv.org/*", "https://www.arxiv.org/*", "https://pmc.ncbi.nlm.nih.gov/*", "https://www.ncbi.nlm.nih.gov/*", "https://www.biorxiv.org/*", "https://www.medrxiv.org/*", "https://elifesciences.org/*", "https://f1000research.com/*", "https://scholar.google.com/*", "https://paperverse.science/*", "https://tomesphere.com/*", "https://www.tomesphere.com/*"], "action": {"default_title": "Open Tomesphere panel", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "panel/panel.html"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*", "https://arxiv.org/pdf/*", "https://www.arxiv.org/pdf/*"], "js": ["content/arxiv.js"], "run_at": "document_idle"}, {"matches": ["https://pmc.ncbi.nlm.nih.gov/articles/*", "https://www.ncbi.nlm.nih.gov/pmc/articles/*", "https://www.biorxiv.org/content/*", "https://www.medrxiv.org/content/*", "https://elifesciences.org/articles/*", "https://f1000research.com/articles/*"], "js": ["content/universal.js"], "run_at": "document_idle"}, {"matches": ["https://scholar.google.com/scholar*"], "js": ["content/scholar.js"], "run_at": "document_idle"}, {"matches": ["https://paperverse.science/*", "https://tomesphere.com/*", "https://www.tomesphere.com/*"], "js": ["content/tomesphere.js"], "run_at": "document_start"}], "commands": {"open-tomesphere": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Tomesph