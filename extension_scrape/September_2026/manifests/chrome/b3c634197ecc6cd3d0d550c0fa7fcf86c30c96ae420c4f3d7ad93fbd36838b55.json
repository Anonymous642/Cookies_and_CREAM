{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vellum \u2014 Tab Audio Recorder & Sampler", "version": "1.2.2", "description": "Record audio from any tab. Persistent side panel, live waveform, WAV + MP3 export. 100% private \u2014 nothing leaves your device.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "sidePanel", "offscreen", "storage", "activeTab", "contextMenus"], "action": {"default_title": "Open Vellum"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start / stop recording"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}