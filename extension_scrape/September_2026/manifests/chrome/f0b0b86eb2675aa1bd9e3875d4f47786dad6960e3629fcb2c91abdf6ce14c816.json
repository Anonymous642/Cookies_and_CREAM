{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSorter - Smart Tab Organizer", "description": "Keep crowded browser windows readable with automatic tab sorting, tab groups, cleanup review, and saved sessions.", "version": "1.0.5", "version_name": "1.0.5", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["tabs", "tabGroups", "storage", "alarms", "scripting", "activeTab", "favicon"], "host_permissions": ["https://api.lemonsqueezy.com/*"], "optional_permissions": ["bookmarks"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "TabSorter - Smart Tab Organizer", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_popup": "src/sidepanel.html"}, "commands": {"open-tab-launcher": {"suggested_key": {"default": "Alt+K", "windows": "Alt+K", "linux": "Alt+K", "mac": "Option+K"}, "description": "Open the TabSorter Launcher"}}, "web_accessible_resources": [{"resources": ["src/tab-launcher.css"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "src/options.html"}