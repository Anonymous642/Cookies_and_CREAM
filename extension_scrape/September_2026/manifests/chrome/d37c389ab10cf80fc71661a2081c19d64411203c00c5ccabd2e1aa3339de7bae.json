{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Swagger for Notion", "version": "1.3", "description": "Turns OpenAPI JSON/YAML in Notion into interactive Swagger UI\u2014easily explore, test, and navigate your API endpoints.", "action": {"default_popup": "popup.html"}, "permissions": ["scripting", "tabs", "storage"], "content_scripts": [{"matches": ["https://www.notion.so/*", "https://*.notion.site/*"], "js": ["uuid.min.js", "content.js"], "run_at": "document_idle"}], "host_permissions": ["https://www.notion.so/*", "https://*.notion.site/*"], "web_accessible_resources": [{"resources": ["swagger_viewer.html", "swagger_viewer.js", "js-yaml.min.js", "swagger/*", "uuid.min.js"], "matches": ["*://*.notion.so/*"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}