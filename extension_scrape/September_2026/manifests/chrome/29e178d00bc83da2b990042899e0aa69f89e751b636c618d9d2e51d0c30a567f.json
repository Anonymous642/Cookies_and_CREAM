{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Networks ID Extractor", "version": "3.0", "description": "Extract account IDs from Facebook, Instagram, Twitter/X, and TikTok with a modern interface.", "permissions": ["scripting", "activeTab", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "action": {"default_icon": "icons/Magic_Aladdin.png", "default_popup": "popup.html", "default_title": "Social Networks ID Extractor"}, "icons": {"16": "icons/icons8-tiktok-ios-17-filled-16.png", "48": "icons/icons8-tiktok-ios-17-filled-32.png", "128": "icons/icons8-tiktok-ios-17-filled-120.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/jquery.min.js", "content.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "tiktok_mobile_ua", "enabled": false, "path": "rules/tiktok_mobile_ua.json"}]}, "host_permissions": ["https://www.facebook.com/*", "https://www.instagram.com/*", "https://www.tiktok.com/*", "https://x.com/*", "https://twitter.com/*"]}