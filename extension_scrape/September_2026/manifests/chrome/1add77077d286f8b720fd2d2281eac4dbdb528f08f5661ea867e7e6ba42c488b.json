{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Readgent SaveTab - One-click Tab Manager", "version": "0.1.0", "description": "Save all tabs and close them instantly. Access anywhere via cloud.", "permissions": ["tabs", "storage", "cookies"], "host_permissions": ["https://readgent.com/*", "http://localhost:5005/*", "http://localhost:9005/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"save-all-tabs": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Save all tabs to SaveTab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["http://localhost:5005/*", "http://localhost:9005/*", "https://readgent.com/*"]}}