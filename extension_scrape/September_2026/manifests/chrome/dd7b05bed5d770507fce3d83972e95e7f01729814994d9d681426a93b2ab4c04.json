{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Tidy File \u2013 Smart Image Extractor", "version": "1.0.0", "description": "Extract production-quality images from any website. Instantly scan, filter, and export high-fidelity assets.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "sidePanel", "scripting", "downloads", "storage", "notifications", "offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "src/panel.html"}, "action": {"default_title": "Tidy Image Extractor"}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Capture visible screen"}, "extract-images": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Extract all images from current page"}}}