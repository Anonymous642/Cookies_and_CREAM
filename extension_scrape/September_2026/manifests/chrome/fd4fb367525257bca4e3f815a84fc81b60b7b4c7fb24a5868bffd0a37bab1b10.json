{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "One Click MOT on Auto Trader, eBay, Facebook", "short_name": "Olmi MOT", "version": "0.9.22", "description": "Check MOT history on eBay, Facebook Marketplace listings and Auto Trader search cards and listings.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Olmi MOT", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "permissions": ["alarms", "offscreen", "storage"], "host_permissions": ["https://i.ebayimg.com/*", "https://m.atcdn.co.uk/*", "https://*.fbcdn.net/*", "https://*.fbsbx.com/*", "https://mot.olmicloud.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.ebay.co.uk/itm/*"], "js": ["chart-runtime.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://www.autotrader.co.uk/car-search*"], "js": ["chart-runtime.js", "autotrader-gallery.js"], "run_at": "document_idle"}, {"matches": ["https://www.autotrader.co.uk/*-details/*"], "js": ["chart-runtime.js", "autotrader-listing.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/marketplace/*"], "js": ["chart-runtime.js", "facebook-listing.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["https://www.ebay.co.uk/*", "https://www.autotrader.co.uk/*", "https://www.facebook.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}}