{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Rhapsody's Prompt Shelf", "description": "Drag&drop to save text/images from the web into a convenient sidepanel. Usefull when working with multiple references in MidJourney.", "version": "1.0", "manifest_version": 3, "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["https://www.midjourney.com/*"], "side_panel": {"default_path": "panel.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Click to open the Prompt Shelf", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.midjourney.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}