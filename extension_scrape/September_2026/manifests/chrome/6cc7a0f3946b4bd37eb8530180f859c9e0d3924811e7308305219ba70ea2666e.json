{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Email Finder", "version": "2.0.0", "description": "Find public emails on Instagram and TikTok profiles in the background and export CSV.", "permissions": ["activeTab", "tabs", "storage", "scripting", "downloads", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://www.tiktok.com/*", "https://tiktok.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Social Email Finder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*", "https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}