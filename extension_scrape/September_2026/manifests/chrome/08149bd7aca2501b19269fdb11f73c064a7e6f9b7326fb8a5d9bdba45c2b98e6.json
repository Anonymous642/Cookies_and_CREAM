{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Table Capture & Extractor", "version": "1.2.2", "description": "Capture tables from websites and PDFs, clean them up in Table Studio, and export ready-to-use data in your browser.", "permissions": ["activeTab", "storage", "downloads", "contextMenus", "offscreen", "clipboardWrite", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "Table Capture & Extractor", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js", "type": "module"}, "commands": {"copy-first-table": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy the first detected table to the clipboard"}, "open-studio": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Open Table Studio for the first detected table"}, "rescan-tables": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Rescan tables on the current page"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "css": ["content/content.css"], "js": ["shared/i18n.js", "shared/filenames.js", "lib/xlsx.mini.min.js", "lib/html2canvas.min.js", "lib/pdfmake.min.js", "lib/pdfmake-fonts.js", "shared/formats.js", "shared/recipes.js", "shared/exporters.js", "content/scanner.js", "content/extractor.js", "content/highlighter.js", "content/smart-selector.js", "content/range-selector.js", "content/content.js"]}], "web_accessible_resources": [{"resources": ["lib/*", "shared/*", "icons/*"], "matches": ["<all_urls>"]}], "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src