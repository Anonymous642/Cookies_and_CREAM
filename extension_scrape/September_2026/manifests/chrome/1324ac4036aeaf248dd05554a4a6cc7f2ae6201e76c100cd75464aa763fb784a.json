{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Back Button", "version": "1.2.2", "description": "Navigate back to previously active tab using Cmd+Shift+E, even across windows. Privacy-first with optional anonymous analytics.", "incognito": "spanning", "permissions": ["storage"], "options_page": "options/options.html", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"go-back": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Navigate to previously active tab (Primary)"}, "go-back-alt": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Navigate to previously active tab (Alternative)"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}