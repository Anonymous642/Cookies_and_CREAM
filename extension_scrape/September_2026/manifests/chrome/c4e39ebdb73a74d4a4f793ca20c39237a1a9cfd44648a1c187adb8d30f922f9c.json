{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ad Library Age Filter", "version": "2.1.0", "description": "Hides ads in the Facebook Ad Library older than a chosen number of days. Controlled entirely from the toolbar icon's popup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "Ad Age Filter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://facebook.com/ads/library*", "https://*.facebook.com/ads/library*"], "js": ["content.js"], "run_at": "document_idle"}]}