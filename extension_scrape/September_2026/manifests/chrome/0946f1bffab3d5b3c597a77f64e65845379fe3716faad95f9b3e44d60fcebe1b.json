{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeCue - Video Search", "version": "1.0.7", "description": "Search and jump to any moment in YouTube videos by content. Find exact timestamps instantly.", "permissions": ["activeTab", "storage", "identity", "tabs", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://timecue.onrender.com/*", "https://www.timecue.io/*", "https://timecue.io/*", "https://api.timecue.io/*"], "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["scripts/content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "scripts/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://*.timecue.io/*", "https://timecue.io/*", "https://*.vercel.app/*"]}}