{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nihongo Feed", "version": "1.1.4", "description": "Learn Japanese vocabulary while you scroll X. A few English words in your feed quietly become Japanese; click one to study it.", "permissions": ["storage"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://nihongo-feed-billing.vercel.app/*"], "action": {"default_title": "Nihongo Feed", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/content/boot.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/*.js", "src/lib/*.js", "data/words.json", "data/kana.json"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]}