{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Typeflow \u2014 Clipboard Typing", "description": "Type clipboard text into focused fields at a natural, configurable pace.", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["clipboardRead", "storage", "offscreen"], "host_permissions": ["<all_urls>"], "commands": {"start-typing": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Type clipboard text into the focused field"}, "stop-typing": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Stop typing clipboard text"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Typeflow", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["content-scripts/content.js"]}]}