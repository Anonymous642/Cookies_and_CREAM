{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Korean Romanization Viewer", "version": "1.0.2", "description": "Toggle romanization display on Korean text. Hover for pronunciation.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_title": "Korean Romanization (Ctrl+Shift+K)", "default_icon": {"128": "icon_off.png"}}, "commands": {"toggle-romanization": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle Korean romanization"}}, "icons": {"128": "icon_on.png"}}