{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HARIS: Muslim Web Blocker & Parental Control", "version": "1.3", "description": "A productivity tool for Muslims & families. Block distractions, set prayer alerts, and stay focused.", "permissions": ["storage", "activeTab", "notifications", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "mainlogo.png", "32": "mainlogo.png", "48": "mainlogo.png", "128": "mainlogo.png"}, "action": {"default_popup": "popup.html", "default_title": "HARIS"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["images/*.jpg"], "matches": ["<all_urls>"]}]}