{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Power Automate UI Switcher", "version": "3.10.0", "minimum_chrome_version": "111", "description": "Switch between the classic and modern Power Automate designer. In classic: larger expression editor, bracket colors, action search.", "permissions": ["storage"], "host_permissions": ["https://make.powerautomate.com/*", "https://*.flow.microsoft.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://make.powerautomate.com/*", "https://*.flow.microsoft.com/*"], "js": ["content.js", "whats-new.js"], "css": ["expression-editor.css", "insert-step.css", "action-search.css", "brackets.css"], "run_at": "document_start"}, {"matches": ["https://make.powerautomate.com/*", "https://*.flow.microsoft.com/*"], "js": ["expression-editor.js", "brackets.js", "insert-step.js", "action-search.js"], "world": "MAIN", "run_at": "document_idle"}], "commands": {"toggle-designer": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Switch between the classic and modern designer"}, "toggle-expression-editor": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Turn the large expression editor on or off"}, "search-actions": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Search the actions of a flow (classic designer)"}}, "action": {"default_title": "Power Automate UI Switcher", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}}