{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Generate NinjaRMM Install Command Buttons", "version": "2.0", "description": "This extension will create install command buttons for NinjaRMM.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["webRequest", "storage", "debugger"], "host_permissions": ["https://*.ninjarmm.com/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://*.ninjarmm.com/*"], "js": ["scripts/content.js"], "run_at": "document_start"}]}