{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat2Y", "version": "1.2", "description": "Look up interesting terms from AI chats on Yahoo Search\u2014in a new tab, without breaking your flow.", "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open Chat2Y", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"open-yahoo-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Chat2Y side panel"}, "search-yahoo-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open selection in Yahoo Search"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}