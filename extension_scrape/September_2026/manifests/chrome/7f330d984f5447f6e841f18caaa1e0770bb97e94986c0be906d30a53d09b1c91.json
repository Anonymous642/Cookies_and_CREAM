{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kalve \u2013 Meeting Notes", "version": "0.1.0", "description": "Capture meeting audio from browser tabs and generate structured notes with Kalve.", "permissions": ["tabCapture", "offscreen", "activeTab", "storage", "tabs"], "host_permissions": ["http://localhost:3000/*", "https://kalve.vercel.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Kalve Meeting Notes", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content/meet-detector.js", "content/caption-observer.js"], "run_at": "document_idle"}]}