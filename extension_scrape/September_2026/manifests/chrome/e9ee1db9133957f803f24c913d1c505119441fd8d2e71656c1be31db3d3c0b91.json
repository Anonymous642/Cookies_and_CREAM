{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Docs Markdown Viewer", "description": "Renders markdown files viewed in Google Docs with syntax highlighting, dark mode, and mermaid diagrams.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Google Docs Markdown Viewer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://docs.google.com/*", "*://drive.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}