{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sales AI Copilot", "version": "1.0.0", "description": "AI-powered sales assistant for personalized LinkedIn outreach. Research prospects, get talking points, and craft perfect messages.", "author": "Joshua theeuf", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Sales AI Copilot"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open side panel"}, "new-chat": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Start a new conversation"}, "summarize-chat": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize current conversation"}, "export-chat": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Export conversation to markdown"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content/linkedin-scraper.js", "content/floating-quick-actions.js"], "run_at": "document_idle"}], "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "contextMenus", "notifications"], "host_permissions": ["*://*.linkedin.com/*", "https://cvseeyou.com/*"], "web_accessible_resources": [{"resources": ["icons/*.png", "config.json"], "matches": ["*://*.linkedin.com/*"]}]}