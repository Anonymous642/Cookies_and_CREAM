{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Translate Page", "description": "Translate selected text and entire web pages. Inline tooltip, popup, history and phrasebook.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://translate.googleapis.com/*", "https://clients5.google.com/*", "<all_urls>"], "action": {"default_title": "Translate Page", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the Translate Page popup"}, "translate-selection": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Translate the current text selection"}, "translate-page": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Translate the entire current page"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}