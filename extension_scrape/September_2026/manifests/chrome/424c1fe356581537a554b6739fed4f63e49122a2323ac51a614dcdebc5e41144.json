{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Image Downloader Pro - Effortlessly Save Any Image", "version": "4.0", "description": "Download images from any webpage with a simple hover + keyboard shortcut. Supports all image formats.", "author": "Zubair Turk <zubair.turkofficial@gmail.com>", "permissions": ["activeTab", "downloads", "storage", "commands", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Image Downloader - Hover + Ctrl+Shift+D to download", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"download-image": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Download hovered image"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}]}