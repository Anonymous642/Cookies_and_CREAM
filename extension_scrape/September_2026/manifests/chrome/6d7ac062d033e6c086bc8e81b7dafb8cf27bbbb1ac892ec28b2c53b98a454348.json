{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptShield", "version": "1.0.0", "description": "Block sensitive data from being submitted to ChatGPT. Detects credit cards, SSNs, API keys, and more.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["detector.js", "overlay.js", "content.js"], "css": ["overlay.css"], "run_at": "document_idle"}]}