{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TypeFlow", "version": "0.6.5", "permissions": ["activeTab", "alarms", "storage", "contextMenus", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"open_snippets": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open snippets"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]}