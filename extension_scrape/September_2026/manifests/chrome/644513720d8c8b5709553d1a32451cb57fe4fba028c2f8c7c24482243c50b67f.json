{"update_url": "https://clients2.google.com/service/update2/crx", "name": "InstaIQ - YouTube to ChatGPT", "description": "Extract YouTube transcripts and send them to ChatGPT for summarization.", "version": "1.02", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_title": "InstaIQ Settings"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "https://youtu.be/*", "https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/yt-16.png", "48": "icons/yt-48.png", "128": "icons/yt-128.png"}}