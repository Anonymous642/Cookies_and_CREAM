{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wadoyuse (What Do You See)", "description": "An advanced ChatGPT clone featuring a circling highlighter for images.", "version": "1.0.0", "optional_host_permissions": ["<all_urls>"], "permissions": ["unlimitedStorage", "storage", "activeTab"], "web_accessible_resources": [{"resources": ["/app/*", "/images/*"], "matches": ["<all_urls>"]}], "icons": {"16": "./images/stars.png", "48": "./images/stars.png", "128": "./images/stars.png"}, "background": {"service_worker": "./app/background/background.js", "type": "module"}, "action": {"default_icon": "./images/stars.png", "default_popup": "./app/popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["./app/content/content.js"], "css": ["./app/content/content.css"], "run_at": "document_end"}]}