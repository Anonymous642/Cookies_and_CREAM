{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenShotified", "version": "1.1.10", "description": "Capture the full page, visible area, a region, or a single element. Output PNG, JPEG, WebP, or PDF.", "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus", "notifications", "clipboardWrite"], "action": {"default_popup": "popup.html", "default_title": "ScreenShotified \u2014 Capture screenshots", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture the full page"}, "capture-visible-area": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture a region (drag to select)"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Capture a single element (click to select)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}