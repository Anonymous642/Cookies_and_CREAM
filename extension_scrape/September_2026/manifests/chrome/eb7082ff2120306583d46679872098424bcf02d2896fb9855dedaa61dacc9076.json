{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OrangeURL - URL Shortener", "version": "1.0.1", "description": "Shorten URLs instantly with OrangeURL. One-click shortening, analytics tracking, and more. Works with or without an account.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Shorten URL with OrangeURL"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite", "notifications", "scripting"], "host_permissions": ["https://api.orangeurl.live/*"], "options_page": "src/options/options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}