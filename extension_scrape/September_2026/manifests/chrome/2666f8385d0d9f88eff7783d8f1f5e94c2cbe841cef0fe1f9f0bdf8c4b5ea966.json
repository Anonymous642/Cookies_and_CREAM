{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "{code} Tracker", "version": "1.2.0", "description": "Automatically syncs your LeetCode submissions with {code} \u2014 solve a problem, and it's tracked instantly.", "permissions": ["cookies", "notifications", "storage"], "host_permissions": ["https://leetcode.com/*", "https://code-ohy1.onrender.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "{code} Tracker"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://leetcode.com/*"]}]}