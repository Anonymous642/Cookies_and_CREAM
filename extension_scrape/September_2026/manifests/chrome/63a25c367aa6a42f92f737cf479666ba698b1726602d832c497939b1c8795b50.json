{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedBoss - Reddit Analytics & Insights", "version": "1.1.2", "description": "Reddit user analytics in a click! View detailed insights & track users directly from Reddit's native popup.", "author": "RedBoss", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://reddboss.com/*"], "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "action": {"default_popup": "popup.html", "default_title": "RedBoss - Reddit Analytics & Insights", "default_icon": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["src/reddit-fetcher.js", "src/hover-card.js", "src/reddit-wrapped.js", "src/content.js"], "css": ["styles/hover-card.css", "styles/reddit-wrapped.css"], "run_at": "document_end"}], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["icons/*", "styles/*"], "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"]}], "homepage_url": "https://www.reddboss.com/", "privacy_policy": "https://www.reddboss.com/extension/privacy", "support_url": "https://www.reddboss.com/contact"}