{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode Difficulty Hider", "version": "1.0", "description": "Toggle hiding of Easy/Medium/Hard labels on LeetCode by clicking the extension icon.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://leetcode.com/*"], "action": {"default_title": "Toggle difficulty labels", "default_icon": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://leetcode.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}