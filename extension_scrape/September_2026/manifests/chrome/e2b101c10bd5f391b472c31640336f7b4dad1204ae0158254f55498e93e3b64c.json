{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Library \u2014 ChatGPT, Gemini & Claude", "version": "0.1.1", "description": "Local, server-free prompt library. Save and one-click insert reusable prompts (with {{variables}}) into ChatGPT, Gemini and Claude.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "AI Prompt Library", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js"}, "options_page": "src/manager/manager.html", "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["src/page/bridge.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["src/shared/constants.js", "src/shared/templating.js", "src/shared/store.js", "src/content/insert.js", "src/content/overlay.js"], "run_at": "document_idle"}], "commands": {"open_picker": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open the prompt picker on the current AI chat"}}, "web_accessible_resources": [{"resources": ["src/content/*", "icons/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*"]}]}