{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ax's block", "version": "3.4", "description": "Bloqueia YouTube Shorts e remove videos de canais bloqueados da pagina.", "permissions": ["storage", "contextMenus"], "host_permissions": ["*://www.youtube.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Gerenciar bloqueios", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}}