{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sora Tabs", "version": "1.2.2", "description": "Save, organize, and restore browser tabs with ease. Advanced search, bulk operations, and keyboard shortcuts for power users.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in current window"}, "open-options": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open saved tabs manager"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://soratab.com/*", "https://api.soratab.com/*"], "web_accessible_resources": [{"resources": ["auth-callback.html"], "matches": ["https://soratab.com/*", "https://api.soratab.com/*"]}]}