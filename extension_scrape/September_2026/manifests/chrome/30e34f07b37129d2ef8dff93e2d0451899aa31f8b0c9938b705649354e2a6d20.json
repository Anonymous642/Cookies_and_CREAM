{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HTTPaste", "version": "1.0.2", "description": "Stop screenshotting network requests. Share HTTP request details with a single click and debug faster.", "author": "HTTPaste", "homepage_url": "https://httpaste.com", "permissions": ["storage", "cookies"], "host_permissions": ["https://httpaste.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "HTTPaste - Share Network Requests"}, "devtools_page": "devtools.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}