{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SynaptiShade", "version": "1.0.0", "description": "Tune any webpage for reading comfort and focus, locally in your browser.", "minimum_chrome_version": "116", "action": {"default_title": "SynaptiShade", "default_popup": "popup.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["https://*/*", "http://*/*"], "host_permissions": [], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle SynaptiShade overlay"}, "toggle-ruler": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle reading ruler"}, "cycle-preset": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Cycle reading comfort presets"}, "increase-font-size": {"description": "Increase SynaptiShade font size"}, "decrease-font-size": {"description": "Decrease SynaptiShade font size"}, "increase-tint-opacity": {"description": "Increase tint opacity"}, "decrease-tint-opacity": {"description": "Decrease tint opacity"}, "toggle-focus-mode": {"description": "Toggle focus tools"}}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}, "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["https://*/*", "http://*/*"]}]}