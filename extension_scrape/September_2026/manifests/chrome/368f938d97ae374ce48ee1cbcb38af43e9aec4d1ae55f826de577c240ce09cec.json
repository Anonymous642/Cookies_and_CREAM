{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "seen for Google Meet", "version": "0.1.11", "description": "Records the Google Meet call you're on and sends it to seen - no bot joins, no native Meet recording needed.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "background": {"service_worker": "background.js"}, "permissions": ["tabCapture", "storage", "offscreen", "activeTab", "notifications", "scripting", "alarms"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start or stop recording the current call"}}, "host_permissions": ["https://seendb.ai/*", "https://api.seendb.ai/*"], "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://meet.google.com/*"]}], "content_scripts": [{"matches": ["https://seendb.ai/*"], "js": ["content_seendb.js"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*"], "js": ["content_meet.js"], "run_at": "document_idle", "all_frames": true}]}