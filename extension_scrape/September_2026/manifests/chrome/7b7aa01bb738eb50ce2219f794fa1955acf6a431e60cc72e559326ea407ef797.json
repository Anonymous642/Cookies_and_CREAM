{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mixider", "description": "Save tracks to your Mixider pool and shape any tab's audio with a live equalizer, auto\u2011filter and reverb.", "version": "2.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_title": "Mixider", "default_popup": "popup.html"}, "permissions": ["storage", "tabs", "notifications", "activeTab", "tabCapture", "offscreen"], "host_permissions": ["https://mixider.com/*"], "optional_host_permissions": ["<all_urls>"], "commands": {"add-to-pool": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Add the current tab to your Mixider pool"}}, "browser_specific_settings": {"gecko": {"id": "mixider-extension@mixider.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://*.bandcamp.com/*", "https://mixcloud.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://vimeo.com/*", "https://www.mixcloud.com/*", "https://www.youtube.com/*", "https://youtube.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/add-to-pool.js"]}]}