{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InboxBinder: Email to One PDF", "version": "1.2.0", "description": "Combine a Gmail message's attached and embedded files into one correctly rotated PDF. Your documents never leave your browser.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "storage"], "host_permissions": ["https://mail.google.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "InboxBinder: save this email as one PDF", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}