{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecKatoo: Audio Recorder & Editor for Chrome Tabs", "description": "Effortlessly record and edit audio from any Chrome tab with RecKatoo. Save as MP3\u2014fast, private, and secure.", "version": "1.0.1", "icons": {"16": "icons/Icon16.png", "32": "icons/Icon32.png", "48": "icons/Icon48.png", "128": "icons/Icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/Icon32.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["tabCapture", "activeTab", "downloads", "offscreen"], "offscreen": {"reasons": ["USER_MEDIA", "AUDIO_PLAYBACK"], "justification": "Tab audio recording and live playback monitoring.", "document": "offscreen.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["editor/editor.html", "libs/*"], "matches": ["<all_urls>"]}]}