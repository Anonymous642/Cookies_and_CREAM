{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Autofill Forms with AI - Smart Form Fill Assistant for Chrome", "version": "1.3.0", "default_locale": "en", "description": "AI form filler: autofill any web form - job applications, vendor registration, B2B. One-time profile setup.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Smart Form Fill", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/form-fill.js"], "run_at": "document_idle"}]}