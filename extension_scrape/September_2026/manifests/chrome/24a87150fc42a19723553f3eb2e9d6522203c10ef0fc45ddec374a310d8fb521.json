{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CloakGPT: Privacy & Focus Layers", "version": "1.0", "description": "Enhance workspace privacy by applying custom backgrounds and text-focus modes to AI chat interfaces.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://duckduckgo.com/?q=DuckAssistant*", "https://*.deepseek.com/*", "https://grok.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://*.deepseek.com/*", "https://grok.com/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "commands": {"capture_screenshot": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Capture reference layout for background"}, "toggle_transparency": {"suggested_key": {"default": "Ctrl+I"}, "description": "Toggle Privacy Layer visibility"}, "go_to_captured_tab": {"suggested_key": {"default": "Alt+X"}, "description": "Switch focus between work and AI workspace"}, "close_captured_tab": {"suggested_key": {"default": "Alt+C"}, "description": "Quick-close AI workspace for privacy"}}}