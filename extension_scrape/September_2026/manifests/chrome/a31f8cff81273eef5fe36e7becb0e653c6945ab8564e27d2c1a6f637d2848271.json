{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZenShield", "version": "2.0.0", "description": "Pre-emptive cookie banner blocker with script blocking and CSS injection", "permissions": ["storage", "scripting", "activeTab", "declarativeNetRequest", "notifications", "contextMenus", "webNavigation"], "host_permissions": ["<all_urls>"], "declarativeNetRequest": {"rule_resources": [{"id": "cookie_scripts_ruleset", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "commands": {"toggle-protection": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Toggle ZenShield protection on/off"}, "nuke-page": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Nuclear nuke all banners on current page"}}}