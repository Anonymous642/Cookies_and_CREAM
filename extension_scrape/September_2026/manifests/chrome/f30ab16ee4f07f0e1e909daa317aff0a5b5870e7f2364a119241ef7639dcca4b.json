{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LightNote Clipper", "version": "2.4.17", "description": "Save photos & videos from Threads, Instagram & Facebook into a LightNote album - send to LightNote.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "activeTab", "identity", "storage"], "host_permissions": ["https://www.threads.com/*", "https://www.threads.net/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*", "https://*.fbcdn.net/*", "https://*.cdninstagram.com/*", "https://lightnote.baole.space/*", "https://id.baole.space/*"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html", "default_title": "LightNote Clipper \u2014 save photos & videos to LightNote"}, "content_scripts": [{"matches": ["https://www.threads.com/*", "https://www.threads.net/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["diagnostics.js", "facebook-post-data.js", "content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://www.instagram.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["facebook-background-tab.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["facebook-photo-api.js"], "run_at": "document_idle", "world": "MAIN", "all_frames": false}]}