{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AnyClip", "version": "1.0.0", "description": "Copy, paste & go, or cut browser tab URLs with quick keyboard shortcuts.", "permissions": ["activeTab", "offscreen", "clipboardRead", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"copy-url": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy current tab URL to clipboard"}, "paste-and-go": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open clipboard content as URL in new tab"}, "copy-url-and-close": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Copy current tab URL and close the tab"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "icons": {"128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["icons/*.svg"], "matches": ["<all_urls>"]}]}