{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AI Chat Transfer", "description": "Side panel which copies, summarizes, and pastes chats to and from ChatGPT, Claude, and Perplexity.", "version": "0.0.0.1", "manifest_version": 3, "icons": {"128": "icons/icon128.png"}, "action": {"default_title": "Open Chat Copier"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "popup.html"}, "permissions": ["tabs", "scripting", "activeTab", "sidePanel", "clipboardWrite", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://*.claude.ai/*", "https://*.anthropic.com/*", "https://*.openai.com/*", "https://claude.ai/*", "https://*.perplexity.ai/*", "https://perplexity.ai/*"]}