{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Navi Sourcing Assistant", "description": "One-click import from LinkedIn and GitHub into Navi sourcing.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Navi Sourcing Assistant", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["activeTab", "tabs", "scripting"], "host_permissions": ["https://linkedin.com/*", "https://www.linkedin.com/*", "https://github.com/*", "https://worknavi.app/*"]}