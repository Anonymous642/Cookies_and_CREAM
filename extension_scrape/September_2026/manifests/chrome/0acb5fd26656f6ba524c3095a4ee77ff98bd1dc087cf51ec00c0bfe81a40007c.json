{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Locked In", "version": "1.4", "description": "Block distracting websites with a 25-minute focus lock. Now with AI-powered personalized motivation from Google Gemini.", "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "declarativeNetRequestFeedback", "tabs"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "index.html", "default_icon": "icon/lockedinicon.png"}, "icons": {"128": "icon/lockedinicon.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "notification-sound.mp3"], "matches": ["<all_urls>"]}]}