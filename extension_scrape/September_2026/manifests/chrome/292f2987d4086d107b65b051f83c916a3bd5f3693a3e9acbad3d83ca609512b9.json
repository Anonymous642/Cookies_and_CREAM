{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boafo", "description": "Provides accessibility features like text-to-speech, speech-to-text, and interface resizing.", "version": "1.0.1", "permissions": ["activeTab", "tts", "scripting", "storage"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://boafo-accessibility-services-production-b6b5.up.railway.app/"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html"}, "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/speechToText.js", "content/textToSpeech.js", "content/interfaceResize.js", "content/summarizer.js", "content.js"]}], "commands": {"toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle the extension popup"}, "start-transcription": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+S"}, "description": "Start live speech-to-text transcription"}, "read-selected-text": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Ctrl+Shift+S"}, "description": "Read aloud selected text"}, "summarize-content": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Ctrl+Shift+L"}, "description": "Summarize current page content"}}}