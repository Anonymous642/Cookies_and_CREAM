{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouMuse \u2014 Mini Player for YouTube Music", "version": "1.0.2", "description": "A beautiful mini-player, command palette, themes, queue, sleep timer, and shortcuts for YouTube Music.", "homepage_url": "https://youmuse.site", "permissions": ["storage", "tabs", "scripting", "alarms", "activeTab"], "host_permissions": ["https://music.youtube.com/*", "https://youmuse.site/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "YouMuse"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["main-world-helper.js"], "matches": ["https://music.youtube.com/*"]}], "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-command-palette": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open YouMuse Command Palette"}, "play-pause": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Play or Pause music"}, "next-track": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Skip to next track"}, "prev-track": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Go back to previous track"}}}