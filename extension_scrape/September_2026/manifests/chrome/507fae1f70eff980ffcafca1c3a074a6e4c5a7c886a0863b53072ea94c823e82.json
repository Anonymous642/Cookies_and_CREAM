{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Screenshot \u2014 Capture Any Frame", "version": "1.0.0", "description": "Take pixel-perfect screenshots of any YouTube video frame. One click or Alt+S. Auto-saves to Downloads and copies to clipboard.", "permissions": ["activeTab", "downloads", "storage", "clipboardWrite"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-128.png", "32": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-128.png", "32": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}, "commands": {"take-screenshot": {"suggested_key": {"default": "Alt+S"}, "description": "Take a screenshot of the YouTube video"}}}