{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Random Goose", "version": "1.2.0", "description": "A goose occasionally waddles across your screen. Does nothing. Takes nothing. Just vibes.", "permissions": ["storage", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/goose16.png", "48": "icons/goose48.png", "128": "icons/goose128.png"}}, "icons": {"16": "icons/goose16.png", "48": "icons/goose48.png", "128": "icons/goose128.png"}, "background": {"service_worker": "background.js"}, "commands": {"summon-goose": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Summon a goose on the current tab"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["goose.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["honk.mp3"], "matches": ["http://*/*", "https://*/*"]}]}