{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Text Copy Paste Pro", "version": "1.5.4", "description": "Ultimate zero-footprint snippet manager. Save, organize, tag, and paste rich text snippets without slowing down your browser.", "permissions": ["storage", "unlimitedStorage", "contextMenus", "sidePanel", "notifications", "activeTab", "scripting"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}, "action": {"default_title": "Text Copy Paste Pro", "default_icon": "assets/icon.png"}, "options_page": "settings.html", "side_panel": {"default_path": "sidebar.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Memory Popup"}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}