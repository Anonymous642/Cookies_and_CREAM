{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sparklin.ai - LinkedIn Comment Generator", "version": "2.2.0", "description": "Generate engaging, professional AI-powered comments for LinkedIn posts using Sparklin AI", "icons": {"16": "assets/sparklin-icon-16.png", "32": "assets/sparklin-icon-32.png", "48": "assets/sparklin-icon-48.png", "128": "assets/sparklin-icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/sparklin-icon-16.png", "32": "assets/sparklin-icon-32.png", "48": "assets/sparklin-icon-48.png", "128": "assets/sparklin-icon-128.png"}}, "permissions": ["storage", "notifications"], "host_permissions": ["https://*.linkedin.com/*", "https://api.sparklin.ai/*"], "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["src/content-linkedin.js"], "css": ["styles/content-styles.css"]}, {"matches": ["https://app.sparklin.ai/*"], "js": ["src/content-sparklin.js"]}], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["assets/*.png"], "matches": ["https://*.linkedin.com/*"]}]}