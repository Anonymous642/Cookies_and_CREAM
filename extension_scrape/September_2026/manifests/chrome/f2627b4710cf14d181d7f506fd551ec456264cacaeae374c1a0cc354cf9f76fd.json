{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ctrl + Click Highlight Search Shortcut", "version": "1.1", "description": "Adds a Ctrl+Click Google search shortcut for selected/highlighted text in a new tab. Other keyboard shortcuts also configurable.", "icons": {"16": "images/16-searchicon.png", "32": "images/32-searchicon.png", "48": "images/48-searchicon.png", "128": "images/128-searchicon.png"}, "action": {"default_icon": {"16": "images/16-searchicon.png", "32": "images/32-searchicon.png", "48": "images/48-searchicon.png", "128": "images/128-searchicon.png"}, "default_popup": "popup.html", "default_title": "Ctrl + Click Highlight Search Shortcut"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"js": ["scripts/content.js"], "matches": ["<all_urls>"]}], "permissions": ["activeTab", "tabs", "storage", "search"], "commands": {"trigger_search": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Perform a Google search for selected text"}}}