{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StackFolder for GitHub", "short_name": "StackFolder", "version": "0.1.1", "minimum_chrome_version": "114", "description": "Groups stacked GitHub pull requests into collapsible folders.", "homepage_url": "https://derrickleemy.github.io/StackFolder-Demo/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["https://api.github.com/*"], "action": {"default_title": "Open StackFolder settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "options.html"}, "content_scripts": [{"matches": ["https://github.com/*/*"], "js": ["stack.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}