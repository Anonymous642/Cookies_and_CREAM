{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cocision: AI Blocker for Intentional Web Access", "description": "Talk with AI before distractions take over. Share your intent by voice, then choose a time-bounded plan you can actually keep.", "version": "0.6.2", "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html", "default_title": "Cocision"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/expiry-guard.js"], "run_at": "document_idle"}], "permissions": ["alarms", "storage", "identity", "tabs", "declarativeNetRequest", "webNavigation", "favicon"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["block.html", "settings.html", "cocision-logo-lockup.svg"], "matches": ["<all_urls>"]}], "options_page": "settings.html"}