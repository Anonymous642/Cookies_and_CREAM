{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sumra \u2013 AI Summary Assistant", "version": "1.0", "description": "Whether it's a web page, article, PDF or audio recording \u2014 let AI summarize it for you in seconds.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["https://api.sumra.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://api.sumra.app; object-src 'self'"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"128": "src/icons/sumra-icon-logo.png"}}, "icons": {"128": "src/icons/sumra-icon-logo.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["src/styles/theme-variables.css", "src/styles/theme-yellow.css", "src/styles/theme-purple.css", "src/styles/theme-mono.css", "src/styles/highlight.css", "src/libs/bootstrap-icons.css"], "js": ["src/content/highlightManager.js", "src/content/content.js"], "run_at": "document_end"}], "background": {"service_worker": "src/background/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["src/*.js", "src/*.css", "src/fonts/*", "src/libs/*.css", "src/libs/*.woff", "src/libs/*.woff2"], "matches": ["http://*/*", "https://*/*"]}], "options_ui": {"page": "src/pages/dashboard.html", "open_in_tab": true}}