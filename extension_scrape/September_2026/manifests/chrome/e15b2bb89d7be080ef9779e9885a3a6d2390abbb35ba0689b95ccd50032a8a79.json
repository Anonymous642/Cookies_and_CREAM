{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "4chan Slideshow", "version": "0.3.0", "description": "The extension icon is enabled on 4chan threads, allowing you to open all images and videos in a fullscreen slideshow.", "permissions": ["action", "tabs", "downloads", "storage"], "icons": {"16": "icon-grey-16.png", "32": "icon-grey-32.png", "48": "icon-grey-48.png", "128": "icon-grey-128.png"}, "action": {"default_icon": {"16": "icon-grey-16.png", "32": "icon-grey-32.png", "48": "icon-grey-48.png", "128": "icon-grey-128.png"}, "default_title": "4chan Slideshow"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://boards.4chan.org/*/thread/*"], "js": ["content.js"], "run_at": "document_idle"}]}