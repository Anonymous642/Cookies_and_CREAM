{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "sayit - pronunciation analysis & coach", "version": "1.3.1", "description": "Select a sentence. Hear it, say it, and see exactly which sounds to fix.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "options/options.html", "background": {"service_worker": "bg/sw.js", "type": "module"}, "permissions": ["storage", "contextMenus", "offscreen", "notifications", "activeTab", "scripting", "tabs", "cookies", "alarms"], "host_permissions": ["https://sayit.cipher.academy/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/styles.gen.js", "content/content.js"], "run_at": "document_idle"}], "commands": {"analyze-selection": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Analyze selection with sayit"}}, "web_accessible_resources": [{"resources": ["shared/*", "icons/*"], "matches": ["http://*/*", "https://*/*"]}]}