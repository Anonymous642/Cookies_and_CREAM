{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notes, Flashcards & Journals - BibNews", "short_name": "BibNews", "version": "1.8.0", "description": "Jot notes without an account. Save articles to your journal and words as flashcards with a free BibNews account.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Notes, Flashcards & Journals - BibNews", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "sidePanel", "storage"], "host_permissions": ["https://biblinkage.com/*", "https://www.biblinkage.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*", "http://127.0.0.1/*", "http://localhost/*"], "content_scripts": [{"matches": ["https://biblinkage.com/accounts/extension/connect/*", "https://www.biblinkage.com/accounts/extension/connect/*"], "js": ["connect.js"], "run_at": "document_idle"}], "commands": {"add-flashcard": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Add the selected word to your flashcards"}, "save-to-journal": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Save the selection (or the page) to your journal"}}}