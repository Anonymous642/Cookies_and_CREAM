{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goal", "version": "0.1.0", "description": "A ball is kicked straight at your screen and shows the latest score whenever a World Cup goal is scored.", "action": {"default_popup": "popup.html", "default_title": "Goal", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"demo-goal": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Trigger a demo goal (home team)"}}, "permissions": ["storage", "alarms", "scripting", "activeTab", "offscreen"], "host_permissions": ["https://goal-backend.meetmoves.workers.dev/*"], "web_accessible_resources": [{"resources": ["goal.mp3"], "matches": ["<all_urls>"]}]}