{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sifty \u2013 Filter for Reddit", "description": "Hide rage bait, spam and the subjects you'd rather skip from your Reddit feed. Follow the ones you like. No ads, no tracking.", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "action": {"default_title": "Sifty", "default_popup": "popup.html"}, "permissions": ["storage", "identity"], "host_permissions": ["https://api.siftyapp.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "web_accessible_resources": [{"resources": ["popup.html"], "matches": ["https://www.reddit.com/*", "https://reddit.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://reddit.com/*", "https://www.reddit.com/*"], "run_at": "document_idle", "css": ["content-scripts/reddit.css"], "js": ["content-scripts/reddit.js"]}]}