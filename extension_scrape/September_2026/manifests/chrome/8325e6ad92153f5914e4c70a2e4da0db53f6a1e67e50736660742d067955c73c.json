{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gmail Send to TAM Hub", "version": "1.0.0", "description": "Send the open Gmail message to My Agency in TAM Hub.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://tam-hub.internal.axon.com/*", "http://127.0.0.1:3001/*", "http://localhost:3001/*", "https://mail.google.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Gmail Send to TAM Hub", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"log-to-tam": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Send open Gmail message to TAM Hub"}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["config.js", "email-payload.js", "gmail-extract.js", "api.js", "content-script.js"], "run_at": "document_idle"}]}