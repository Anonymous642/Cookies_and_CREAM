{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Certificador QA", "description": "Registro de evidencia y an\u00e1lisis de seguridad en pruebas E2E.", "version": "1.0.9", "icons": {"16": "icons/favicon-score.png", "32": "icons/favicon-score.png", "48": "icons/favicon-score.png", "128": "icons/favicon-score.png"}, "action": {"default_popup": "popup/index.html", "default_title": "Certificador QA", "default_icon": {"16": "icons/favicon-score.png", "32": "icons/favicon-score.png"}}, "permissions": ["tabs", "activeTab", "storage", "webRequest", "tabCapture", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"qa_manual_screenshot": {"description": "Capturar evidencia manual (screenshot)", "suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pageApiHook.js", "scanner.js"], "matches": ["http://*/*", "https://*/*"]}]}