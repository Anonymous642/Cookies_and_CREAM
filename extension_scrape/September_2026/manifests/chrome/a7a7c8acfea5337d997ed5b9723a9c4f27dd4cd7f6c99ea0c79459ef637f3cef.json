{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JustFixMe - Fix typos anywhere", "short_name": "JustFixMe", "version": "0.7.9", "description": "Select text in any website, press Ctrl+Shift+F, and AI fixes the typos in place. One shortcut, everywhere.", "author": "D. Smidstrup Holding ApS", "homepage_url": "https://justfixme.app", "permissions": ["storage", "webNavigation"], "host_permissions": ["https://justfixme.app/*"], "icons": {"16": "icons/fixme-icon-16.png", "32": "icons/fixme-icon-32.png", "48": "icons/fixme-icon-48.png", "128": "icons/fixme-icon-128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "run_at": "document_idle"}], "commands": {"fix-selection": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fix typos in the selected text"}}, "action": {"default_popup": "popup.html", "default_title": "JustFixMe", "default_icon": {"16": "icons/fixme-icon-16.png", "32": "icons/fixme-icon-32.png", "48": "icons/fixme-icon-48.png", "128": "icons/fixme-icon-128.png"}}}