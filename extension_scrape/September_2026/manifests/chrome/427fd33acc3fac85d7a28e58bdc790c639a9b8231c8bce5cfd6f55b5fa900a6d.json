{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobMail AI \u2013 Free Cold Email Assistant", "version": "1.6.0", "description": "JobMail helps you apply to jobs faster! Save time, boost responses, and land more interviews effortlessly!", "permissions": ["storage", "notifications", "sidePanel"], "host_permissions": ["https://*.linkedin.com/*", "https://jobmail.netlify.app/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "web_accessible_resources": [{"resources": ["crypto-js.min.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://jobmail.netlify.app"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidebar.html"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"]}]}