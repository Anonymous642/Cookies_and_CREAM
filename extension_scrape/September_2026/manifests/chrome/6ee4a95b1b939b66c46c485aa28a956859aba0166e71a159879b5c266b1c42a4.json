{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kith", "version": "0.3.0", "description": "Knowledge reclaimed for dense text, logic, and visual work.", "author": "Kith", "minimum_chrome_version": "114", "permissions": ["storage", "activeTab", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Kith", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"explain-selection": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Explain the current text selection with Kith"}, "analyze-visual-region": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Start region-based visual analysis with Kith"}}, "options_page": "options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}