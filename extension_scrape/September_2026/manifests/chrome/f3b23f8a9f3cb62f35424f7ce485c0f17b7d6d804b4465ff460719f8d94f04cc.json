{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapFrame Pro \u2014 YouTube HD Screenshot & Frame Grabber", "version": "1.0.1", "description": "Pro YouTube frame grabber. Capture HD screenshots and batch-extract 4K frames to ZIP. Clean, one-click precision for creators.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["lib/jszip.min.js", "scripts/content.js"], "css": ["scripts/content.css"], "run_at": "document_start"}], "commands": {"capture-frame": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture current YouTube frame"}}, "web_accessible_resources": [{"resources": ["scripts/inject.js"], "matches": ["*://*.youtube.com/*"]}]}