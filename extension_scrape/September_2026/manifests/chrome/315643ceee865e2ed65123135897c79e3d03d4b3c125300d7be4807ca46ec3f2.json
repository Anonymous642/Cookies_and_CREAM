{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Canvas Open", "version": "4.0.0", "description": "Anti-detection, prior-answer autofill, and multi-provider AI solver for Canvas Classic + New Quizzes and McGraw-Hill SmartBook.", "minimum_chrome_version": "102", "permissions": ["activeTab", "tabs", "scripting", "storage", "debugger", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.instructure.com/courses/*/quizzes/*/take*", "*://*.edu/courses/*/quizzes/*/take*", "*://*.org/courses/*/quizzes/*/take*", "*://*.instructure.com/courses/*/assignments/*"], "js": ["quizanswers.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://learning.mheducation.com/static/awd/*"], "js": ["mheducation.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://chatgpt.com/*"], "js": ["ai-chatgpt.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://claude.ai/*"], "js": ["ai-claude.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://gemini.google.com/*"], "js": ["ai-gemini.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Canvas Open: show / hide overlays"}, "apply-all-answers": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Canvas Open: apply all AI answers (Read-Only mode)"}, "resolve-answers": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Canvas Open: re-run the AI on the current page"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}