{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Keyboarder", "version": "1.3", "description": "Switch between tabs using keyboard overlay", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["https://keyboarder.frdr.cc/*"], "action": {"default_popup": "popup.html", "default_title": "Keyboarder Settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "commands": {"toggle_overlay": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K", "windows": "Ctrl+Shift+K", "linux": "Ctrl+Shift+K"}, "description": "Toggle tab switcher overlay"}}}