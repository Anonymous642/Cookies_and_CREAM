{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy All Urls", "version": "3.0.0", "description": "Copy tab URLs to the clipboard (text, HTML, JSON, or custom). Paste to open multiple URLs at once.", "action": {"default_popup": "popup.html", "default_icon": {"19": "icons/folder_19.png", "64": "icons/folder_64.png", "128": "icons/folder_128.png"}, "default_title": "Copy URLs to clipboard"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "icons": {"128": "icons/folder_128.png"}, "permissions": ["tabs", "storage", "clipboardRead", "clipboardWrite"], "commands": {"copy": {"description": "Copy", "suggested_key": {"default": "Alt+C"}}, "paste": {"description": "Paste", "suggested_key": {"default": "Alt+V"}}}}