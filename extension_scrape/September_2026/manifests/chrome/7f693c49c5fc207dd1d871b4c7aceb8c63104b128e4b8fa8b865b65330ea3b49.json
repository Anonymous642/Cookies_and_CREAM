{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Seller Toolkit", "version": "2.8.6", "description": "All-in-one toolkit for eBay resellers: batch list, track profit, auto-reprice, sync orders, source products & monitor stock.", "permissions": ["storage", "scripting", "activeTab", "tabs", "identity", "downloads", "alarms"], "host_permissions": ["https://extensionpay.com/*", "https://*.supabase.co/*", "https://*.amazon.com/*", "https://*.ebay.com/*", "https://*.walmart.com/*", "https://*.etsy.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.co.jp/*"], "js": ["content.js"]}]}