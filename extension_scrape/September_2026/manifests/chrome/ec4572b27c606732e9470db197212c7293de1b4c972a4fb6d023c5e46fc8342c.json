{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabzap", "description": "Zap unused tabs manually, stay focused, and keep your browser clean.", "version": "1.0.5", "action": {"default_popup": "popup/index.html", "default_icon": {"16": "assets/icon-light-16.png", "32": "assets/icon-light-32.png", "48": "assets/icon-light-48.png", "128": "assets/icon-light-128.png"}}, "permissions": ["tabs", "storage", "sessions", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon-light-16.png", "32": "assets/icon-light-32.png", "48": "assets/icon-light-48.png", "128": "assets/icon-light-128.png"}, "web_accessible_resources": [{"resources": ["assets/*.svg", "assets/*.png"], "matches": ["<all_urls>"]}, {"resources": ["popup/assets/*.ttf"], "matches": ["<all_urls>"]}], "commands": {"open-tutorial": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Tabzap Tutorial View"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://tabzap-license-validate.customer-piko.workers.dev"}}