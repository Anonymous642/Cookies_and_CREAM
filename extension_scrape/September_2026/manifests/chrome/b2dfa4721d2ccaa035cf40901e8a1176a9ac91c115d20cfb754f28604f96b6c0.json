{"update_url": "https://clients2.google.com/service/update2/crx", "name": "The Tab Economist", "version": "1.2.0", "manifest_version": 3, "description": "Idle tabs archived with on-device AI summaries. Read Later, group-aware restore, searchable library. Fully private.", "permissions": ["tabs", "storage", "sidePanel", "alarms", "notifications", "tabGroups", "downloads", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Tab Economist", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-side-panel": {"suggested_key": {"mac": "Command+Shift+E", "default": "Ctrl+Shift+E"}, "description": "Open Tab Economist"}, "toggle-focus-mode": {"suggested_key": {"mac": "Command+Shift+F", "default": "Ctrl+Shift+F"}, "description": "Toggle Focus Session"}}}