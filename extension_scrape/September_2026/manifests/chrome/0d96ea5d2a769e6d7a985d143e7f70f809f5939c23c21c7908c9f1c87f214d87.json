{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sondeas Global Shortcut", "short_name": "Sondeas Shortcut", "version": "1.0.8", "description": "Trigger Sondeas recordings with a global keyboard shortcut on macOS and Windows.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "commands"], "host_permissions": ["https://sondeas.com/*", "https://staging.sondeas.com/*", "http://127.0.0.1:3000/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://sondeas.com/*", "https://staging.sondeas.com/*", "http://127.0.0.1:3000/*", "http://localhost:3000/*"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"toggle-sondeas-recording": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "global": true, "description": "Start or stop a recording in Sondeas"}}, "action": {"default_title": "Sondeas Global Shortcut", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}