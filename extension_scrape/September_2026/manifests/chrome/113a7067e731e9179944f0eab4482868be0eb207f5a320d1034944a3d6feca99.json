{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MiroMiro: Web to Code, Web Inspector, Font Finder & Lottie", "description": "Export web to code in one click. Web element inspector & font finder: grab CSS, fonts, colors, SVGs & Lottie. No DevTools.", "version": "2.4.0", "short_name": "MiroMiro", "icons": {"128": "images/icon.png"}, "author": "sorilc@hotmail.com", "homepage_url": "https://miromiro.app", "permissions": ["scripting", "webRequest", "downloads", "sidePanel", "storage", "tabs", "identity", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://miromiro.app/*"]}, "action": {"default_icon": "images/icon.png", "default_title": "MiroMiro"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["sidepanel.html", "chunks/*", "assets/*", "images/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; media-src 'self' https://* blob:; img-src 'self' https://* data: blob:;"}, "browser_specific_settings": {"gecko": {"id": "miromiro-app@miromiro.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}