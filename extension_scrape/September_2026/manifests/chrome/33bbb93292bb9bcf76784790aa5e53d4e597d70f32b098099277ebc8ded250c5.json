{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Summarizer", "version": "1.2", "description": "Summarizes a Youtube video using Google Gemini. Hotkey: CTRL + I", "permissions": ["tabs", "scripting", "activeTab"], "host_permissions": ["https://gemini.google.com/*", "https://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Summarize Video"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"summarize_video": {"suggested_key": {"default": "Ctrl+I"}, "description": "Summarize the current YouTube video using Google Gemini."}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}