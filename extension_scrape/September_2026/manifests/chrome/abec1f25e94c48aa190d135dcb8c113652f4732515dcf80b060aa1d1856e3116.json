{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeHub", "version": "1.0.2", "description": "Automatically sync your accepted Codeforces submissions to GitHub.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://codeforces.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "alarms"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://codeforces.com/*"]}