{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TabLens", "version": "1.0.1", "manifest_version": 3, "description": "Find any tab instantly. Never open a duplicate again. Smart search and duplicate protection for your tabs.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["tabs", "notifications", "storage", "tabGroups"], "background": {"service_worker": "src/background/index.js"}, "commands": {"focus-tablens-search": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Open TabLens and focus the search bar"}}, "action": {"default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "TabLens Tab Manager", "default_popup": "src/popup/index.html"}}