{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stillgate \u2014 Intentional browsing", "short_name": "Stillgate", "version": "1.12.0", "description": "Find your focus, manage your time, and make room for what matters. A mindful website blocker for more intentional days.", "minimum_chrome_version": "120", "permissions": ["storage", "alarms", "activeTab", "tabs", "declarativeNetRequestWithHostAccess", "webNavigation", "scripting", "favicon"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Stillgate", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}, "incognito": "not_allowed", "default_locale": "en"}