{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ec2apply Resume Job Matcher & Analyzer", "version": "0.1.45", "description": "Free AI resume matcher & analyzer. Match to a job: reads this page's job description and tailors your resume at ec2apply.com.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Tailor this job with ec2apply", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "src/panel.html"}, "permissions": ["scripting", "storage", "unlimitedStorage", "sidePanel"], "background": {"service_worker": "src/background.js", "type": "module"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["https://www.ec2apply.com/*", "https://ec2apply.com/*"], "js": ["src/bridge.js"], "run_at": "document_start"}]}