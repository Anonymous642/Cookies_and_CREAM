{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VeriSentra \u2013 Prompt Firewall", "description": "Protect sensitive data from being sent to AI tools. Local-first detection of API keys, passwords, PII, and secrets.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "VeriSentra"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://bard.google.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat/*", "https://claude.ai/*", "https://mail.google.com/*", "https://app.slack.com/*", "https://*.slack.com/*", "https://docs.google.com/*", "https://notion.so/*", "https://www.notion.so/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "alarms"], "optional_host_permissions": ["https://*/*"], "host_permissions": ["http://localhost:3001/*", "https://api.verisentra.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://bard.google.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat/*", "https://claude.ai/*", "https://mail.google.com/*", "https://app.slack.com/*", "https://*.slack.com/*", "https://docs.google.com/*", "https://notion.so/*", "https://www.notion.so/*"], "web_accessible_resources": [{"resources": ["assets/*", "chunks/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["http://localhost:3000/*", "http://localhost:3002/*", "https://verisentra.com/*", "https://*.verisentra.com/*"]}, "options_page": "options.html"}