{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chonky Chat", "version": "1.0.0", "description": "Combines messages from different live streaming platforms into one chat.", "content_scripts": [{"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["YouTube.js"], "all_frames": false}, {"matches": ["https://www.youtube.com/live_chat*"], "run_at": "document_idle", "css": ["YouTubeChat.css"], "js": ["YouTubeChat.js"], "all_frames": true}, {"matches": ["https://www.twitch.tv/*"], "run_at": "document_idle", "css": ["Twitch.css"], "js": ["Twitch.js"], "all_frames": true}, {"matches": ["https://www.youtube.com/live_chat*", "https://www.twitch.tv/*"], "run_at": "document_idle", "css": ["ChonkyChat.css"], "all_frames": true}], "options_ui": {"page": "/options/options.html", "open_in_tab": true, "browser_style": true}, "background": {"service_worker": "Background.js"}, "permissions": ["storage"], "action": {"default_popup": "Popup/Popup.html"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["/images/twitch.png"], "matches": ["https://www.youtube.com/*"]}, {"resources": ["/images/youtube.png"], "matches": ["https://www.twitch.tv/*"]}, {"resources": ["/images/icon48.png"], "matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"]}]}