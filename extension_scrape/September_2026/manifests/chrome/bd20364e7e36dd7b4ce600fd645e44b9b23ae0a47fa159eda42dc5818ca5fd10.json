{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusFeed", "description": "Block distracting feeds on Facebook, Instagram, Twitter, TikTok and YouTube", "version": "1.1.1", "permissions": ["storage", "alarms", "activeTab"], "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}