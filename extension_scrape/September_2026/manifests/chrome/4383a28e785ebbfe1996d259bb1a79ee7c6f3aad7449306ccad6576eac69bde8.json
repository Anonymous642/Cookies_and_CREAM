{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ryddle AI: Chat with Webpages & PDFs", "description": "Ask AI about the current tab, summarize pages, rewrite selected text, and chat with PDFs or images in Chrome.", "version": "1.0.0", "icons": {"16": "icons/ryddle-16.png", "32": "icons/ryddle-32.png", "48": "icons/ryddle-48.png", "128": "icons/ryddle-128.png"}, "action": {"default_title": "Open Ryddle AI", "default_icon": {"16": "icons/ryddle-16.png", "32": "icons/ryddle-32.png", "48": "icons/ryddle-48.png", "128": "icons/ryddle-128.png"}}, "background": {"service_worker": "background/index.js", "type": "module"}, "commands": {"open-ryddleai": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open Ryddle AI"}}, "host_permissions": ["<all_urls>"], "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "tabs"], "externally_connectable": {"matches": ["https://ryddleai.com/*", "https://www.ryddleai.com/*"]}, "side_panel": {"default_path": "sidepanel.html"}}