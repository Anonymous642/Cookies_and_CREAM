{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Cap: Limit Your Tab Count", "version": "1.0.0", "description": "Set a tab limit and stop tab overload. Tab Cap blocks new tabs when you reach your limit.", "permissions": ["tabs", "storage", "alarms", "windows"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}