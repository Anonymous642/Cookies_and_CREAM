{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Sidebar (Embedded)", "description": "Side panel ChatGPT with one-click summarize, translate, explain, and outline prompts from the current page.", "version": "0.5.10", "permissions": ["sidePanel", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "scripting", "tabs", "activeTab", "storage"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "action": {"default_title": "ChatGPT Sidebar", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}