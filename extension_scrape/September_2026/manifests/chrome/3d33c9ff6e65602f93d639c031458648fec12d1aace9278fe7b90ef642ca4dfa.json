{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CoverGuard", "version": "2.0.3", "description": "Permanently cover sensitive data in images and PDFs with solid colors. Remove metadata. 100% offline.", "permissions": ["downloads", "storage", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CoverGuard - Click to toggle notifications"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["editor/editor.html", "lib/*.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}