{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Page to Markdown Scraper", "version": "2.0.1", "minimum_chrome_version": "116", "description": "Capture page content and OCR text from any page or PDF. Saves as Markdown/ZIP for ChatGPT and LLMs. 100% local processing.", "permissions": ["activeTab", "downloads", "scripting", "offscreen", "contextMenus"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon_inactive_16.png", "48": "icons/icon_inactive_48.png", "128": "icons/icon_inactive_128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon_inactive_16.png", "48": "icons/icon_inactive_48.png", "128": "icons/icon_inactive_128.png"}, "commands": {"capture-ocr": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "OCR capture current viewport"}}}