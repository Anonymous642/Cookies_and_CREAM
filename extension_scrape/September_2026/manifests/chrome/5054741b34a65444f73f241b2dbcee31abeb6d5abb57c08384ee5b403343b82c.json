{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSaver Pro", "version": "1.1.0", "description": "Easily save, manage, and restore your browser sessions with TabSaver Pro. Never lose your tabs again!", "permissions": ["tabs", "storage", "commands"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png"}}, "icons": {"16": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["donate.html", "donate.css", "donate.js", "assets/*"], "matches": ["<all_urls>"]}], "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save all currently open tabs"}, "session-1": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Open session 1"}, "session-2": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Open session 2"}, "session-3": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Open session 3"}}}