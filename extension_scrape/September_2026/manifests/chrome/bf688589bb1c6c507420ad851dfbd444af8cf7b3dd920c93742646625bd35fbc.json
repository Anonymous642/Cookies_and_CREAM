{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aloud \u2014 Listen to Any Web Page", "version": "1.0.0", "description": "Have web pages read to you. Every voice runs on your own machine, so not one word of what you read leaves the device.", "permissions": ["tts", "activeTab", "scripting", "storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Aloud", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["reader.css"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"toggle": {"suggested_key": {"default": "Alt+P"}, "description": "Read, or pause if already reading"}, "stop": {"suggested_key": {"default": "Alt+O"}, "description": "Stop reading"}, "prev": {"suggested_key": {"default": "Alt+Comma"}, "description": "Previous sentence"}, "next": {"suggested_key": {"default": "Alt+Period"}, "description": "Next sentence"}}, "minimum_chrome_version": "111"}