{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabner: Your Smart Tab Manager", "description": "\ud83d\ude80 Your Smart Tab Manager - Organize tabs into boards, groups & tags with a beautiful interface", "version": "1.10.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage"], "omnibox": {"keyword": "tb"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "Tabner - Popup", "default_popup": "popup.html"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Tabner dashboard"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "default_locale": "en", "background": {"service_worker": "background.js"}}