{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DOM Lens", "description": "Grab any element on any website and give it to AI coding agents", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["main-world.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "DOM Lens", "default_popup": "popup.html", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "commands": {"toggle-grab": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Toggle DOM Lens mode"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}