{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Google Index Checker by IndexCheckr", "description": "Check if pages are indexed by Google. Single page, outbound links, or batch check.", "version": "2.0", "manifest_version": 3, "permissions": ["storage", "scripting", "activeTab", "contextMenus"], "host_permissions": ["https://indexcheckr.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open IndexCheckr"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}