{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Quoted \u2013 Copy rich quotes from any page", "short_name": "Quoted", "description": "Right-click any text to copy it as a formatted HTML quote, including indentation, italics, quote marks, source link, and author.", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "icons/quoted-16.png", "32": "icons/quoted-32.png", "48": "icons/quoted-48.png", "128": "icons/quoted.png"}, "permissions": ["contextMenus", "scripting", "activeTab", "clipboardWrite"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Get Quote (Rich)", "default_icon": {"16": "icons/quoted-16.png", "32": "icons/quoted-32.png", "48": "icons/quoted-48.png", "128": "icons/quoted.png"}}, "commands": {"get-quote-shortcut": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Copy rich quote from current selection"}}}