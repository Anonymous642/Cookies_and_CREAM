{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Search \u2013 No AI Results", "version": "2.0.0", "description": "Removes AI results from Google Search, including AI Overview.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://*.google.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["content.js"], "run_at": "document_start"}]}