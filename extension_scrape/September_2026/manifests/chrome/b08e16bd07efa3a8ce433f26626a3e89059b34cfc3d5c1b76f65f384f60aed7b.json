{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DoFollow / NoFollow Link Highlighter", "version": "1.0.0", "description": "Instantly see which links on a page are dofollow (green) or nofollow/sponsored/ugc (red). SEO link auditing made simple.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "DoFollow / NoFollow Highlighter", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}