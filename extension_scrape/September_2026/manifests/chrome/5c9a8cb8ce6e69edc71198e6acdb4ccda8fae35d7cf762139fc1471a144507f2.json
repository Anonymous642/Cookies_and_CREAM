{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Folders for ChatGPT: Folders & Prompt Manager", "version": "1.0.0", "description": "Organize ChatGPT conversations into folders. Features subfolders, drag-and-drop, prompt manager, and GPT conversation grouping.", "author": "Joseph Cavallaro Jr.", "homepage_url": "https://www.easyfolders.online/chatgpt.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://payhip.com/*", "*://promptlodge.online/*", "*://*.promptlodge.online/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://api.x.ai/*", "https://api.anthropic.com/*", "https://api.z.ai/*", "https://open.bigmodel.cn/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Easy Folders for ChatGPT", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://*.promptlodge.online/*", "*://promptlodge.online/*"], "js": ["promptlodge_main.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["*://*.promptlodge.online/*", "*://promptlodge.online/*"], "js": ["promptlodge_isolated.js"], "world": "ISOLATED", "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles.css", "image/Easy_Folders_ChatGPT.png", "image/header_logo_chatgpt.png", "image/header_logo_chatgpt_dark.png"], "matches": ["<all_urls>"]}]}