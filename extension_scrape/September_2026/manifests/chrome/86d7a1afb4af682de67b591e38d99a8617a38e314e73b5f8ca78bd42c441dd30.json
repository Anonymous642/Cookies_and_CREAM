{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Aura In Page Analytics", "description": "Providing a sidepanel to easily view your GA4 data while you browse.", "version": "1.4.2", "manifest_version": 3, "action": {"default_title": "Aura In Page Analytics"}, "content_security_policy": {"extension_pages": "script-src 'self'; script-src-elem  https://api.aurapageanalytics.com 'self'; connect-src  https://api.aurapageanalytics.com 'self';;"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "icons": {"16": "aura_icon_16.png", "32": "aura_icon_32.png", "48": "aura_icon_48.png", "128": "aura_icon_128.png"}, "permissions": ["tabs", "sidePanel", "activeTab", "scripting"], "content_scripts": [{"js": ["content.js"], "matches": ["<all_urls>"]}], "host_permissions": ["https://api.aurapageanalytics.com/", "https://*/*", "http://*/*"], "externally_connectable": {"matches": ["https://aurapageanalytics.com/*"]}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["content.js"], "use_dynamic_url": false}]}