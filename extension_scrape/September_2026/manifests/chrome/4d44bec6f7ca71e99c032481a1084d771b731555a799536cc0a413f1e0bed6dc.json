{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpotLink", "version": "1.0", "description": "Lightning-fast link navigation with keyboard. Search any page's links and open them instantly without touching your mouse.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "contextMenus"], "action": {"default_popup": "popup.html", "default_title": "Link Search"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["themes.js", "content.js"], "css": ["content.css"]}], "commands": {"toggle-search": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Open/close link search"}}}