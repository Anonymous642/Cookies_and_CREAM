{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript Filter", "version": "1.6", "description": "Mutes profanity and censors captions on YouTube.", "permissions": ["webRequest", "tabs", "scripting", "storage"], "host_permissions": ["*://www.youtube.com/*"], "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "action": {"default_title": "YouTube Profanity Muter", "default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "web_accessible_resources": [{"resources": ["badwords.json"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}