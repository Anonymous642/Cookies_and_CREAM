{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipPDF", "version": "1.2", "description": "Herramientas visuales para PDF, capturas y organizacion.", "permissions": ["activeTab", "scripting", "contextMenus", "storage"], "background": {"service_worker": "background.js"}, "host_permissions": ["<all_urls>", "file://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "ClipPDF"}, "icons": {"16": "styles/16.png", "48": "styles/48.png", "128": "styles/128.png"}, "web_accessible_resources": [{"resources": ["content/cropper.js", "content/cropper.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/detect-pdf.js"], "run_at": "document_end", "all_frames": true}]}