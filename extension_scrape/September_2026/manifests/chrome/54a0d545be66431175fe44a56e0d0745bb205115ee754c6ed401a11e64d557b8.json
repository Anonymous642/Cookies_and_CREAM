{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot YouTube & X - Video Screenshot", "version": "0.4.0", "description": "Take a screenshot from YouTube & X (Twitter) videos in one click. Saved to a folder per video, named by title and timestamp.", "permissions": ["downloads"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/capture.js", "content/youtube.js"], "css": ["content/button.css"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/youtube-main.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["*://x.com/*", "*://*.twitter.com/*"], "js": ["content/capture.js", "content/x.js"], "css": ["content/button.css"], "run_at": "document_idle"}]}