{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SoftLoad: Eye Care & Smooth Page Transitions", "version": "1.0.0", "description": "Reduce eye strain with smooth page transitions. Stop blinding white flashes and flickering for a calmer, fluid web experience.", "content_security_policy": {"extension_pages": "default-src 'self'; style-src 'self' 'unsafe-inline';"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "SoftLoad settings"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "exclude_matches": ["*://chrome.google.com/webstore/*", "*://chromewebstore.google.com/*"], "js": ["defaults.js", "content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"toggle-softload": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle SoftLoad on/off"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "softload@local.dev", "strict_min_version": "115.0"}}}