{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notion Vault \u2014 Local Backup for Notion", "version": "1.0.0", "description": "Back up your Notion workspace to your computer. One click. No third-party server. Clean markdown + CSV. Works offline.", "permissions": ["cookies", "storage", "alarms", "downloads"], "host_permissions": ["*://*.notion.so/*", "*://*.notionusercontent.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Notion Vault"}, "content_scripts": [{"matches": ["*://*.notion.so/*"], "js": ["content.js"]}]}