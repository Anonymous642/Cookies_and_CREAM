{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlurFirst \u2014 Live Screen-Share Privacy", "version": "1.1.0", "description": "Drag a box or click an element to blur sensitive content instantly, before you share your screen. Nothing leaves your browser.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://test.dodopayments.com/*", "https://live.dodopayments.com/*"], "optional_host_permissions": ["*://*/*"], "externally_connectable": {"matches": ["https://blurfirst.com/*", "https://blurfirst.vercel.app/*", "http://localhost/*"]}, "action": {"default_popup": "popup.html", "default_title": "BlurFirst"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "commands": {"toggle-blur-mode": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle blur mode on the current page"}, "panic-blur": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Panic: blur the entire page instantly"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}