{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Role Copilot", "version": "1.0.6", "description": "Extract Indeed jobs to your dashboard and apply with one click. Syncs with Role Copilot dashboard.", "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab", "contextMenus"], "host_permissions": ["https://*.indeed.com/*", "https://indeed.com/*", "https://backend.rolecopilot.com/*", "https://dashboard.rolecopilot.com/*", "http://localhost:3001/*", "http://localhost:5173/*", "<all_urls>"], "side_panel": {"default_path": "sidepanel/index.html"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["*://*.indeed.com/*/jobs*", "*://*.indeed.com/jobs*", "*://indeed.com/jobs*", "*://indeed.com/*/jobs*"], "js": ["scripts/selectors.js", "scripts/content-search.js"], "run_at": "document_idle"}, {"matches": ["*://*.indeed.com/*", "*://indeed.com/*"], "js": ["scripts/selectors.js", "scripts/content-indeed-apply.js"], "run_at": "document_idle"}, {"matches": ["http://localhost:5173/*", "https://localhost:5173/*", "https://dashboard.rolecopilot.com/*"], "js": ["scripts/content-dashboard-sync.js"], "run_at": "document_end"}], "action": {"default_title": "Role Copilot", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}