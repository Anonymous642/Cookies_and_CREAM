{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UpApply - AI Upwork Assistant", "version": "1.0.5", "description": "AI-powered Upwork assistant: scan jobs with match scores, generate proposals, answer screening questions, estimate quotes", "homepage_url": "https://www.upapply.net", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"], "host_permissions": ["https://www.upwork.com/*", "https://upapply-be.onrender.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.upwork.com/*"], "js": ["content-scripts/upwork-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.upwork.com/ab/proposals/job/*/apply*", "https://www.upwork.com/nx/proposals/job/*/apply*", "https://www.upwork.com/jobs/*/apply*", "https://www.upwork.com/nx/proposals/interview/*/accept*", "https://www.upwork.com/jobs/*", "https://www.upwork.com/nx/find-work/details/*"], "js": ["content-scripts/upwork-proposal-helper.js"], "run_at": "document_idle"}], "action": {"default_title": "Open UpApply Scanner", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "side-panel/index.html"}}