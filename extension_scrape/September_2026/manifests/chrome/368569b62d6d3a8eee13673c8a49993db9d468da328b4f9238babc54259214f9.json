{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Personal Dashboard", "version": "1.0.7", "description": "A clean, beautiful dashboard for your new tab with weather, news, and search.", "action": {"default_icon": "images/icon.png"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "chrome_url_overrides": {"newtab": "index.html"}, "web_accessible_resources": [{"resources": ["images/*.png", "images/*.jpg", "images/weather_icons/*.png"], "matches": ["<all_urls>"]}], "permissions": ["geolocation", "storage"], "host_permissions": ["https://api.openweathermap.org/*", "https://newsapi.org/*", "https://apis.scrimba.com/*", "https://images.unsplash.com/*"]}