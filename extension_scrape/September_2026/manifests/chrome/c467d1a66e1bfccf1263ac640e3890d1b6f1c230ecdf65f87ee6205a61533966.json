{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dark Docs", "version": "1.0.0", "description": "Dark theme for Google Docs: dark paper, dark toolbars and menus, tunable brightness and contrast. Not affiliated with Google.", "permissions": ["storage"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["src/content.js"], "css": ["src/darkmode.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "src/popup.html", "default_title": "Dark Docs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle dark mode on Google Docs"}}}