{"update_url": "https://clients2.google.com/service/update2/crx", "key": "", "manifest_version": 3, "minimum_chrome_version": "102", "name": "Code Medium", "version": "0.8.0", "description": "Extends the Medium and Substack writer interfaces to quickly create and edit Github Gists, without having to leave the editor.", "icons": {"48": "assets/icon.png", "128": "assets/icon.png"}, "author": "Manuel Dell'Elce", "short_name": "code-medium", "background": {"service_worker": "background/background.js"}, "action": {"default_icon": {"19": "assets/icon.png", "38": "assets/icon.png"}}, "content_scripts": [{"matches": ["https://medium.com/**"], "js": ["content/content_medium.js"], "css": ["content/content_medium.css"], "run_at": "document_idle"}, {"matches": ["https://medium.com/media/*"], "js": ["content/content_medium_iframe.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://*.substack.com/**"], "js": ["content/content_substack.js"], "css": ["content/content_substack.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["app/*.*"], "matches": ["https://medium.com/*", "https://*.substack.com/*"]}], "commands": {"medium-create-gist": {"suggested_key": {"default": "Alt+Shift+0"}, "description": "Create a Gist in the Medium Editor"}}, "permissions": ["identity", "storage", "scripting"], "host_permissions": ["https://github.com/*", "https://gist.github.com/*", "https://*.substack.com/**"]}