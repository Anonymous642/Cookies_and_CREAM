{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AppRecon", "version": "1.4", "description": "Collect and export DOM links and network request URLs for development, QA, and authorised security testing.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["webRequest", "downloads", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}