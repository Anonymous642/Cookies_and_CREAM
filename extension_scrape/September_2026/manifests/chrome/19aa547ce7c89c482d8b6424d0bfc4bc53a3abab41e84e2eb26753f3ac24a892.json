{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResumeScroll - Scroll Position Saver", "short_name": "ResumeScroll", "description": "Automatically save and restore your scroll position on any website. Resume articles, docs, papers, and research where you left off.", "version": "1.1.0", "minimum_chrome_version": "114", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "ResumeScroll", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_page": "dashboard.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}}, "save-current-position": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current scroll position"}, "restore-current-position": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Restore last scroll position"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open ResumeScroll dashboard"}, "jump-next-mark": {"description": "Jump to next saved mark"}, "jump-previous-mark": {"description": "Jump to previous saved mark"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["utils/content-helpers.js", "content.js"], "run_at": "document_idle"}]}