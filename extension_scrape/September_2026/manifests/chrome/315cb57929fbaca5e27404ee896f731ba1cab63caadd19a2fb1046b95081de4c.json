{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PostMyDeal.ai", "version": "1.6.2", "description": "Automate your dealership inventory posting to Facebook Marketplace. Save hours of manual work every day.", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "alarms", "scripting", "storage"], "host_permissions": ["https://*.carsforsale.com/*", "https://*.dealercenter.net/*", "https://pictures.dealer.com/*", "https://*.carscommerce.inc/*", "https://postmydeal.ai/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "options_page": "dashboard.html", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://postmydeal.ai/*", "https://www.postmydeal.ai/*"], "js": ["bridge.js"], "run_at": "document_idle"}, {"js": ["xhr-interceptor.js"], "matches": ["https://www.facebook.com/marketplace/create/*", "https://www.facebook.com/marketplace/edit/*"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.facebook.com/marketplace/create/*", "https://www.facebook.com/marketplace/selling/item*"], "js": ["vehicle-normalizer.js", "facebook-injector.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/free-tier-ad.jpg"], "matches": ["https://www.facebook.com/*"]}]}