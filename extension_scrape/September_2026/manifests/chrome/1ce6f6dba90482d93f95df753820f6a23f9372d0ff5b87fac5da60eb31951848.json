{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Ninja", "short_name": "QR Ninja", "version": "1.0.0", "description": "Generate QR codes instantly from selected text or links. Save and revisit your QR history anytime.", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "action": {"default_title": "QR Ninja", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "js/background.js", "type": "module"}, "commands": {"open-ninja": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Generate QR from selected text or open QR Ninja"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}