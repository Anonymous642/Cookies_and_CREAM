{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Delightloop", "description": "A smart gifting assistant for LinkedIn to capture contacts and send personalized gifts.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "storage", "tabs", "cookies"], "host_permissions": ["*://*.linkedin.com/*", "https://web.delightloop.ai/*"], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open Sidepanel"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}