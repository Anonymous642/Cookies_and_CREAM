{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AuRo - audio output device router", "version": "2.0.0", "description": "Per-tab audio mixer: route any tab to any output device, boost volume up to 400%, watch levels, and record tab audio.", "short_name": "AuRo", "author": "ish-", "homepage_url": "https://github.com/ish-/AuRo", "version_name": "2.0.0", "minimum_chrome_version": "116.0", "action": {"default_icon": {"16": "Icon16.png", "32": "Icon32.png", "48": "Icon48.png", "128": "Icon128.png"}, "default_title": "AuRo - choose your audio output device", "default_popup": "popup/popup.html"}, "icons": {"16": "Icon16-update.png", "32": "Icon32-update.png", "48": "Icon48-update.png", "128": "Icon128-update.png"}, "background": {"service_worker": "serviceWorker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content/import-index.js"], "all_frames": true, "run_at": "document_start"}], "permissions": ["activeTab", "storage", "tabs", "scripting", "declarativeNetRequest", "webNavigation", "tabCapture", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "declarative_net_request": {"rule_resources": [{"id": "auro_cors", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["chunks/*-*.js", "content/index.js"], "matches": ["*://*/*", "http://*/*", "https://*/*"]}]}