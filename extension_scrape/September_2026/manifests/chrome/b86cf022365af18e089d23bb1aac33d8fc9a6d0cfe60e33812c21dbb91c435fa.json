{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT to Google Docs", "version": "0.1.0", "description": "Copies ChatGPT responses to a new Google Doc.", "permissions": ["activeTab", "identity"], "host_permissions": ["https://chatgpt.com/*", "https://*.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"]}], "oauth2": {"client_id": "601396478276-97bspsj0o18uprji27c009l97phcbra5.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.googleapis.com/;"}}