{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MEDPOV Web Activity Tracker", "short_name": "MEDPOV Activity", "version": "1.0.1", "description": "Advanced multilingual web activity analytics, charts, goals and website blocking by MEDPOV.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "MEDPOV Web Activity Tracker", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["storage", "tabs", "idle", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open MEDPOV Activity popup"}, "open_dashboard": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open full MEDPOV Activity dashboard"}}, "web_accessible_resources": [{"resources": ["assets/icons/icon48.png", "assets/icons/icon128.png", "assets/icons/logo.png"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}