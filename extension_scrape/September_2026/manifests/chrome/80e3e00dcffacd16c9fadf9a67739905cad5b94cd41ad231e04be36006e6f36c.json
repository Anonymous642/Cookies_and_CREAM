{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenShotKit Capture", "version": "0.1.0", "description": "Capture your app screens from bloom.diy and send them straight to ScreenShotKit to turn into App Store screenshots.", "permissions": ["tabs", "storage", "activeTab", "scripting"], "host_permissions": ["https://screenshotkit.xyz/*", "https://www.screenshotkit.xyz/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html"}, "web_accessible_resources": [{"resources": ["fonts/outfit.woff2"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://screenshotkit.xyz/import*", "https://www.screenshotkit.xyz/import*", "http://localhost:3000/import*"], "js": ["content/importBridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}