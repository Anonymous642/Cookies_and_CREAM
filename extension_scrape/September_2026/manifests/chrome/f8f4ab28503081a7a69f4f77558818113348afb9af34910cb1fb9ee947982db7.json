{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BRSTSHOT", "description": "Firefox-style screenshot tool with element capture, region select, full-page stitch, burst mode & crop \u2014 all local, no data sent.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "downloads", "contextMenus", "clipboardWrite"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Take Screenshot"}, "web_accessible_resources": [{"resources": ["content/styles.css"], "matches": ["<all_urls>"]}]}