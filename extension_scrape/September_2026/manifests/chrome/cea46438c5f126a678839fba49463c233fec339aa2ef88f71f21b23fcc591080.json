{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WP Admin Bar Toggle", "author": "Hlebarov.com", "description": "Hide or show the WordPress admin bar with one click.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "WP Admin Bar Toggle", "default_popup": "popup.html"}, "commands": {"toggle-wp-admin-bar": {"suggested_key": {"default": "Alt+Shift+W", "mac": "MacCtrl+Shift+W"}, "description": "Hide or show the WordPress admin bar on the active tab"}}}