{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipMark: Web Clipper for Notion, No Lost Clips", "version": "1.1.2", "description": "Clip any page to Notion as clean Markdown. Every clip is queued locally first, so a dropped connection never loses it.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "ClipMark \u2014 clip this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "downloads", "identity", "alarms"], "host_permissions": ["https://api.notion.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open ClipMark on the current page"}}}