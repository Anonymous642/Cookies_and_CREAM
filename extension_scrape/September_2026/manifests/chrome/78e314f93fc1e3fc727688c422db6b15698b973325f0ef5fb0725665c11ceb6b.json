{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Blackout Box", "version": "1.2.0", "description": "A black box you can drag and resize to cover bright parts of a YouTube video. Turn it on or off, or show it only in fullscreen.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "YouTube Blackout Box", "default_popup": "popup.html"}, "commands": {"toggle-box": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Turn the blackout box on or off"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "css": ["box.css"], "run_at": "document_idle"}]}