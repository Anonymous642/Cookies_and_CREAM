{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PixelSnap", "version": "2.0.0", "description": "Snap, annotate, and share beautiful screenshots \u2014 visible area, full page, or batch capture with built-in editing tools.", "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "tabs", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}}}