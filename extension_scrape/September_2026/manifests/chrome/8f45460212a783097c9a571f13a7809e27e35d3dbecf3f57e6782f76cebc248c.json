{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabGod", "description": "Cross-browser tab manager. Open the toolbar icon to see every tab, or press the command palette shortcut to search.", "version": "1.3.9", "icons": {"16": "icons/16.png", "19": "icons/19.png", "32": "icons/32.png", "38": "icons/38.png", "48": "icons/48.png", "64": "icons/64.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["tabs", "storage", "alarms", "tabGroups", "favicon", "offscreen"], "optional_permissions": ["scripting", "downloads", "tabCapture", "bookmarks"], "optional_host_permissions": ["http://*/*", "https://*/*", "https://licensing.tabgod.com/*"], "commands": {"open-palette": {"description": "Open the TabGod command palette", "suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "focus-back": {"description": "Step back through recently focused tabs", "suggested_key": {"default": "Alt+Shift+Left"}}, "focus-forward": {"description": "Step forward through recently focused tabs", "suggested_key": {"default": "Alt+Shift+Right"}}, "focus-toggle": {"description": "Jump between the last two focused tabs", "suggested_key": {"default": "Alt+Shift+Down"}}}, "action": {"default_title": "TabGod", "default_icon": {"16": "icons/16.png", "19": "icons/19.png", "32": "icons/32.png", "38": "icons/38.png", "48": "icons/48.png", "64": "icons/64.png", "96": "icons/96.png", "128": "icons/128.png"}, "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}}