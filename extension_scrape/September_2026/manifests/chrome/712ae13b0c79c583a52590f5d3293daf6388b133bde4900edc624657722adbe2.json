{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Remind me \u2014 Gmail", "description": "Slack-style \"Remind me\" for Gmail. Set a reminder on any email, get a Chrome notification, and see everything in a side panel.", "version": "0.1.0", "short_name": "Remind me", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "alarms", "notifications", "sidePanel"], "host_permissions": ["https://mail.google.com/*"], "action": {"default_title": "Remind me \u2014 open reminders"}, "commands": {"open-side-panel": {"description": "Open reminders side panel", "suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}}}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/gmail.css"], "use_dynamic_url": true, "matches": ["https://mail.google.com/*"]}]}