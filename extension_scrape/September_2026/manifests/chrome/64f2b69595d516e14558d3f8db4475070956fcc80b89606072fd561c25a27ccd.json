{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Summarize It", "version": "1.3.0", "description": "Extract content from any webpage or YouTube video and copy a summarization prompt to your clipboard", "permissions": ["activeTab", "storage", "clipboardWrite", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "minimum_chrome_version": "102", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background/service-worker.js"}, "options_page": "options/options.html", "commands": {"summarize": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Copy summarization prompt"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}