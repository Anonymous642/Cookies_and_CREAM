{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Logos Link", "version": "1.8.1", "description": "Connects the web to Logos. Detect Bible references, entities, and theology terms \u2014 hover for previews, click to open in Logos.", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "sidePanel", "tabs"], "web_accessible_resources": [{"resources": ["src/viewer/index.html", "assets/*", "data/*"], "matches": ["<all_urls>"]}], "host_permissions": ["https://*.logos.com/*", "https://*.biblia.com/*", "https://api.biblia.com/*", "https://api.esv.org/*", "https://bible.helloao.org/*", "https://labs.bible.org/*", "https://api.nlt.to/*", "https://ref.ly/*", "https://www.youtube.com/feeds/*", "http://*/*.pdf", "http://*/*.pdf?*", "https://*/*.pdf", "https://*/*.pdf?*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/index.js"], "css": [], "run_at": "document_idle"}, {"matches": ["https://app.logos.com/tools/study-assistant*", "https://app.verbum.com/tools/study-assistant*"], "js": ["src/content/study-assistant-autosubmit.js"], "run_at": "document_start"}, {"matches": ["https://app.logos.com/tools/notes*", "https://app.verbum.com/tools/notes*"], "js": ["src/content/notes-autofill.js"], "run_at": "document_start"}], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "omnibox": {"keyword": "l"}, "commands": {"save-to-notes": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Save selection or page to Logos Notes"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}