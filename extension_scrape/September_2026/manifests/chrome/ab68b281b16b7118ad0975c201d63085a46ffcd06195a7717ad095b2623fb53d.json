{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BCBlur", "version": "1.3.0", "description": "Blur sensitive data before you screen-share or record. Draw boxes, hide elements, auto-detect emails & numbers. 100% local.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup-full.html", "default_title": "BCBlur", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["popup.js", "popup-full.html", "images/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-selector": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle the blur selector mode"}}}