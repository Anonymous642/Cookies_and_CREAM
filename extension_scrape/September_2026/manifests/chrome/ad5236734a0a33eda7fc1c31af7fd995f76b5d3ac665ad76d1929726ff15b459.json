{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Joey", "version": "0.9.4", "description": "Save articles for later reading. Highlight and annotate text, export to Markdown. Stored locally - no accounts, no servers.", "homepage_url": "https://github.com/", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "Save to Joey", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content/Readability.js", "content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["reader/reader.html", "list/list.html"], "matches": ["chrome-extension://*/*"]}], "permissions": ["activeTab", "storage", "unlimitedStorage", "tabs", "offscreen"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current page to Joey"}}}