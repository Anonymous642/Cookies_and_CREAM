{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ResumeAlign Autofill", "version": "0.11.30", "description": "Auto-applies to jobs: fills the form, attaches your tailored r\u00e9sum\u00e9, and walks the application through Submit. Includes mass-apply.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "downloads", "debugger", "alarms", "tabs", "scripting"], "host_permissions": ["https://*.dice.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.myworkdayjobs.com/*", "https://*.indeed.com/*", "https://*.linkedin.com/*", "https://*.ziprecruiter.com/*", "https://alignresume.com/*"], "action": {"default_popup": "src/popup.html", "default_title": "ResumeAlign Autofill", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.dice.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://alignresume.com/*"], "js": ["src/bridge.js"], "run_at": "document_idle"}, {"matches": ["https://*.dice.com/*"], "js": ["src/frameprobe.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://*.indeed.com/*", "https://*.ziprecruiter.com/*"], "js": ["src/observe.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://*.indeed.com/*"], "js": ["src/indeed.js"], "run_at": "document_idle"}, {"matches": ["https://smartapply.indeed.com/*"], "js": ["src/smartapply.js"], "run_at": "document_idle"}, {"matches": ["https://*.linkedin.com/*"], "js": ["src/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://*.ziprecruiter.com/*"], "js": ["src/ziprecruiter.js"], "run_at": "document_idle"}]}