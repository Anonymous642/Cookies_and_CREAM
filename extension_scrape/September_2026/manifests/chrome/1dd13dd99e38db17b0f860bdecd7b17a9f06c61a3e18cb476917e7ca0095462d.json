{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Refocus - Reddit Blocker & Feed Off", "version": "1.18.7", "description": "Block Reddit or just the endless subreddit scroll. Daily limits, a focus timer and a calm block screen. 100% local.", "permissions": ["declarativeNetRequest", "storage", "history", "alarms", "idle", "sidePanel", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Refocus", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["widget.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "fonts/*.woff2"], "matches": ["<all_urls>"]}]}