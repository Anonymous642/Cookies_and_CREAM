{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UnEmbed", "description": "A browser extension that replaces embedded media with links to the content.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "UnEmbed Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.dailymotion.com/*", "*://*.vimeo.com/*", "*://*.youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}