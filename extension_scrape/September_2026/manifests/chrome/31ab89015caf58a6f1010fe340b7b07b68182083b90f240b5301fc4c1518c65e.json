{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "2FA Authenticator With Autofill Helper", "version": "0.1.0", "description": "Save 2FA Authenticator for site by QR scan or manual secret and autofill OTP codes on matching sites.", "icons": {"16": "assets/2fa-icon-16.png", "48": "assets/2fa-icon-48.png", "128": "assets/2fa-icon-128.png"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "2FA Autofill Helper", "default_icon": {"16": "assets/2fa-icon-16.png", "48": "assets/2fa-icon-48.png", "128": "assets/2fa-icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["jsQR.js", "content.js"], "run_at": "document_idle"}]}