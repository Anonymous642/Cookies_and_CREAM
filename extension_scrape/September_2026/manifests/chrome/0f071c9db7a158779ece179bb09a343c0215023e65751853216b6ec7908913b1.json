{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PicPack - Image Downloader", "version": "1.0.0", "description": "Bulk download product images from Shopify stores and Pinterest boards as a ZIP file.", "permissions": ["activeTab", "scripting", "downloads"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.pinterest.com/*", "*://*.pinterest.co.uk/*", "*://*.pinterest.co.in/*", "*://*.pinterest.co.kr/*", "*://*.pinterest.co.at/*", "*://*.pinterest.co.nz/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}