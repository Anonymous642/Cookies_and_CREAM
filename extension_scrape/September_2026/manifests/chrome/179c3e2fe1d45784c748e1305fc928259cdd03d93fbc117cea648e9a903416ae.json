{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fresh Frame", "version": "0.1.0", "description": "Highlights recent posts in X's Home feed with a custom frame.", "permissions": ["storage"], "host_permissions": ["https://x.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Fresh Frame", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}