{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Site2Mail", "version": "1.0.0", "description": "Generate a site-based email address from the current tab URL.", "permissions": ["storage", "tabs", "clipboardWrite", "offscreen"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Site2Mail", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "commands": {"open-site2mail": {"suggested_key": {"default": "Alt+Shift+S", "windows": "Alt+Shift+S", "linux": "Alt+Shift+S", "chromeos": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Copy the generated Site2Mail email or open the popup"}}}