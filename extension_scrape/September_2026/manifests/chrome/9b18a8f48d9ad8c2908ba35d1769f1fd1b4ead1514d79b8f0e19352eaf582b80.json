{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetCode Review Tracker", "version": "1.0", "description": "Track LeetCode problems and schedule reviews using the Ebbinghaus forgetting curve", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://leetcode.com/*", "https://leetcode.cn/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*", "https://leetcode.cn/problems/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "LeetCode Review Tracker", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon.png"}}