{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recon \u2014 FACEIT match stats", "description": "A sharper FACEIT companion: match-room Rating/Swing/K/D/A, last-30 W/L, and a team map radar. Not affiliated with FACEIT.", "version": "1.1.0", "short_name": "Recon", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.faceit.com/*", "https://api.faceit.com/*"], "web_accessible_resources": [{"resources": ["fonts/*", "map-icons/*"], "matches": ["*://*.faceit.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.faceit.com/*"], "js": ["content-scripts/matchroom.js"]}]}