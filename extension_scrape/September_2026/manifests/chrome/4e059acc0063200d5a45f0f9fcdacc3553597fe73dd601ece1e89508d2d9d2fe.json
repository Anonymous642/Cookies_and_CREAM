{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URL Shortener", "version": "1.0", "description": "Shorten URLs instantly! Create short links for the current page or any URL. Fast, simple, and free link shortening.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://tinyurl.com/*", "https://is.gd/*", "https://v.gd/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}