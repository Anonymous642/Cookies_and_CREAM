{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gmail Button - Custom Buttons & QR Codes", "description": "Add customizable buttons and QR codes to your Gmail compose windows", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*", "http://localhost:3000/*", "http://localhost:3001/*", "https://dashboard.emailbuttons.com/*", "https://www.emailbuttons.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["http://localhost:3000/*", "https://dashboard.emailbuttons.com/*"], "run_at": "document_idle", "js": ["content-scripts/dashboard-auth.js"]}]}