{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal Page Scraper", "version": "1.0.0", "description": "Scrape tables and text from any page and export to CSV or printable view.", "permissions": ["activeTab", "scripting", "tabs", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Scrape this page"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}