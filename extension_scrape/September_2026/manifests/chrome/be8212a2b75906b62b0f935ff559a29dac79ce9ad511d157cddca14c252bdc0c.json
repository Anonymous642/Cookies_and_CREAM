{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Grid", "version": "1.1.1", "description": "\u5feb\u901f\u5bfc\u822a\u6807\u7b7e\u9875\u7684\u7f51\u683c\u7ba1\u7406\u5668\uff0c\u652f\u6301\u641c\u7d22\u3001\u952e\u76d8\u5bfc\u822a\u548c\u9884\u89c8\u3002\nA grid-based tab manager with search, keyboard navigation and preview support.", "author": "\u788e\u5f71", "icons": {"48": "icon.png", "96": "icon@2x.png", "144": "icon@3x.png", "512": "icon@512.png"}, "permissions": ["tabs", "activeTab", "storage", "scripting"], "web_accessible_resources": [{"resources": ["*"], "matches": ["<all_urls>"]}], "commands": {"toggle-grid": {"suggested_key": {"default": "Alt+Z", "mac": "Alt+Z", "windows": "Alt+Z", "linux": "Alt+Z"}, "description": "\u663e\u793a\u6807\u7b7e\u9875\u7f51\u683c / Show tab grid"}}, "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}}