{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Navigator", "version": "1.0.0", "description": "A compact right-side navigation rail for your ChatGPT questions and answers.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "action": {"default_title": "ChatGPT Navigator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}