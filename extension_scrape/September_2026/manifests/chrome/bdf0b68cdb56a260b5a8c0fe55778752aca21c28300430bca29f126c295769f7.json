{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OnTrack Blocker", "description": "Block distracting websites with customizable delays. Give yourself time to reconsider.", "version": "2.0.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "webNavigation", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "OnTrack Blocker", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://OnTrack.vercel.app/*"], "run_at": "document_end", "js": ["content-scripts/blocking.js"]}, {"matches": ["https://OnTrack.vercel.app/*"], "run_at": "document_start", "js": ["content-scripts/detection.js"], "world": "MAIN"}]}