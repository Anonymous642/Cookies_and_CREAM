{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Surf95 \u2014 Surf the Old Web", "version": "1.2.1", "description": "Surf the old web from your toolbar. Click Surf to load a random weird old-web site in your tab. Keep clicking.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle the Surf95 bar", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["bar.js"], "run_at": "document_idle"}]}