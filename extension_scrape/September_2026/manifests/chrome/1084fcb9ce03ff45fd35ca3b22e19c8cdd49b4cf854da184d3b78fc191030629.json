{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube NonStop Pro", "description": "Keep YouTube & YouTube Music playing without the 'Continue watching' pause.", "version": "1.1.1", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "commands": {"toggle-nonstop": {"suggested_key": {"default": "Alt+Shift+N", "mac": "MacCtrl+Shift+N"}, "description": "Toggle YouTube NonStop Pro"}}, "content_scripts": [{"matches": ["*://music.youtube.com/*", "*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}