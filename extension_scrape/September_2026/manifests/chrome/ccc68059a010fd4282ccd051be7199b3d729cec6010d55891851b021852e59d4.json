{"manifest_version": 3, "background": {"service_worker": "back.js"}, "action": {"default_icon": "icons8-close-128.png"}, "description": "Close all tabs with one click or shortcut, and restore them anytime. Right-click the Panic Button icon to open settings.", "icons": {"16": "icons8-close-16.png", "32": "icons8-close-32.png", "48": "icons8-close-48.png", "128": "icons8-close-128.png"}, "key": "", "name": "Panic Button", "update_url": "https://clients2.google.com/service/update2/crx", "version": "2.4", "options_ui": {"page": "settings.html", "open_in_tab": true}, "permissions": ["storage", "browsingData", "tabs"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}, "panic": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Close all open tabs"}, "restore": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Restore the previous session"}}}