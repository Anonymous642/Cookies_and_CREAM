{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Gatekeeper", "description": "A funny forced-break extension that blocks distraction sites with an animated gatekeeper.", "version": "0.1.3", "icons": {"16": "icon/icon-16.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "permissions": ["storage", "scripting", "alarms"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://threads.com/*", "*://*.threads.com/*", "*://threads.net/*", "*://*.threads.net/*", "*://*.bsky.app/*"], "action": {"default_title": "Screen Gatekeeper", "default_icon": {"16": "icon/icon-16.png", "48": "icon/icon-48.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["gatekeepers/*/*.webm", "gatekeepers/*/*.png"], "matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://threads.com/*", "*://*.threads.com/*", "*://threads.net/*", "*://*.threads.net/*", "*://*.bsky.app/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.bsky.app/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.threads.com/*", "*://*.threads.net/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*", "*://threads.com/*", "*://threads.net/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}