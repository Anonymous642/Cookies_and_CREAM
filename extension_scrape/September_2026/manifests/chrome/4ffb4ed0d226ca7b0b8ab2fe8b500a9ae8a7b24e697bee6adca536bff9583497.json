{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Contact Organizer", "version": "1.0.1", "description": "Save LinkedIn profiles locally with one click. Add notes, export to CSV. No signups, 100% free.", "author": "Jake Parker", "homepage_url": "https://github.com/Jake1848/linkedin-contact-organizer", "permissions": ["activeTab", "storage", "notifications"], "host_permissions": ["*://*.linkedin.com/*"], "action": {"default_popup": "popup.html", "default_title": "LinkedIn Contact Organizer"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"save-contact": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current LinkedIn contact"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}