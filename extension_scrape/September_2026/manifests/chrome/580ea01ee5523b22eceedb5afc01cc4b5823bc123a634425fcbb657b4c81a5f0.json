{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "sfch (Salesforce Case Highlighter)", "version": "2.3.1", "description": "Intelligently highlights and groups Salesforce cases by priority and status. Requires one-click setup on your desired list view.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.lightning.force.com/lightning/o/Case/list*", "https://*.salesforce.com/lightning/o/Case/list*", "https://*.force.com/lightning/o/Case/list*"], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "images/icon16-inactive.png", "48": "images/icon48-inactive.png", "128": "images/icon128-inactive.png"}}, "content_scripts": [{"matches": ["https://*.lightning.force.com/lightning/o/Case/list*", "https://*.salesforce.com/lightning/o/Case/list*", "https://*.force.com/lightning/o/Case/list*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/*.png", "setup.html", "setup.js"], "matches": ["https://*.lightning.force.com/*", "https://*.salesforce.com/*", "https://*.force.com/*"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}