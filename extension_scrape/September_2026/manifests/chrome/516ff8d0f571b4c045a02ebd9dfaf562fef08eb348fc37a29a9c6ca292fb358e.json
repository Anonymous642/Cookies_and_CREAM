{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZED AI Assistant", "version": "1.2.1", "description": "Instant page summaries, quick queries, and contextual AI assistance powered by ZED AI. Sign in with Google for seamless access.", "author": "HelloZed", "homepage_url": "https://ai.hellozed.com", "permissions": ["activeTab", "storage", "contextMenus", "scripting", "identity"], "host_permissions": ["https://ai.hellozed.com/*", "https://ai.hellozed.com/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "form-assistant.js", "vton-sidebar.js"], "css": ["content.css", "form-assistant.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"summarize_page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize current page"}, "quick_ask": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Quick ask ZED"}, "virtual_try_on": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Virtual Try-On"}}}