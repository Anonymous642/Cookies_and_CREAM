{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTriage \u2014 search everything you close", "version": "0.1.0", "description": "Automatically closes tabs you'll never return to, and keeps everything it closed permanently searchable. All local, no accounts.", "permissions": ["tabs", "storage", "alarms", "scripting", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/sw.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "TabTriage \u2014 search your closed tabs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open TabTriage and jump to search"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/tracker.js"], "run_at": "document_idle", "all_frames": false}]}