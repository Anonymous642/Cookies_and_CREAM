{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Summary Unlimited \u2014 ChatGPT", "description": "Summarize any YouTube video with ChatGPT. Adds a button to the player, pulls the transcript, and uses your existing session.", "version": "0.1.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "YouTube Summarize settings", "default_popup": "popup.html"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["page-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["transcript.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["chatgpt-content.js"], "run_at": "document_idle"}]}