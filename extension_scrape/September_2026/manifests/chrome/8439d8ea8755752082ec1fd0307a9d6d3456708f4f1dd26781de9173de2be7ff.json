{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyncPost", "version": "1.0.4", "description": "Background automation extension for SyncPost to automatically post on X, Facebook, Threads and Instagram.", "permissions": ["storage", "activeTab", "scripting", "alarms", "cookies", "debugger", "downloads"], "host_permissions": ["https://*.twitter.com/*", "https://twitter.com/*", "https://*.x.com/*", "https://x.com/*", "https://*.facebook.com/*", "https://facebook.com/*", "https://*.instagram.com/*", "https://instagram.com/*", "https://*.threads.net/*", "https://www.threads.net/*", "https://threads.net/*", "https://*.threads.com/*", "https://threads.com/*", "http://localhost/*", "http://127.0.0.1/*", "https://*.syncpostapp.com/*", "https://syncpostapp.com/*", "https://*.vercel.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.twitter.com/*", "https://twitter.com/*", "https://*.x.com/*", "https://x.com/*", "https://*.facebook.com/*", "https://facebook.com/*", "https://*.instagram.com/*", "https://instagram.com/*", "https://*.threads.net/*", "https://threads.net/*"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.syncpostapp.com/*", "https://syncpostapp.com/*", "https://*.vercel.app/*"], "js": ["webBridge.js"]}], "action": {"default_title": "SyncPost"}, "externally_connectable": {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.syncpostapp.com/*", "https://syncpostapp.com/*", "https://*.vercel.app/*"]}}