{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ecomchina - Calculadora de Lucro", "version": "1.0.1", "description": "Calcule lucro e margem em produtos Amazon, Shopee e Mercado Livre (Brasil).", "permissions": ["storage"], "host_permissions": ["https://*.amazon.com.br/*", "https://amazon.com.br/*", "https://*.shopee.com.br/*", "https://shopee.com.br/*", "https://*.mercadolivre.com.br/*", "https://mercadolivre.com.br/*", "http://localhost:3001/*", "http://127.0.0.1:3001/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Ecomchina Calculadora", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com.br/*", "https://amazon.com.br/*", "https://*.shopee.com.br/*", "https://shopee.com.br/*", "https://*.mercadolivre.com.br/*", "https://mercadolivre.com.br/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["panel.html", "assets/*", "chunks/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}