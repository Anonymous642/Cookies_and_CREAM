{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blueprint Softphone", "version": "1.0.2", "description": "Professional softphone with background listening and click-to-dial. Built on Twilio.", "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "storage", "tabs", "windows", "offscreen"], "host_permissions": ["https://*.twilio.com/*", "https://*.twil.io/*", "https://serverless.twilio.com/*", "https://serverless-upload.twilio.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Blueprint Softphone", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"answer-call": {"suggested_key": {"default": "Alt+A"}, "description": "Answer incoming call"}, "hangup-call": {"suggested_key": {"default": "Alt+H"}, "description": "Hang up active call"}, "toggle-mute": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle microphone mute"}, "toggle-hold": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle call hold"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}