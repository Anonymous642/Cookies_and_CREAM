{"version": "1.0.0", "name": "MailMiner", "description": "Find email addresses from any website.", "permissions": ["activeTab", "storage", "scripting", "webRequest", "webRequestBlocking"], "host_permissions": ["https://mailminer.io/*", "https://*.linkedin.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_icon": "/images/logo.png", "default_popup": "popup.html", "default_title": "MailMiner"}, "icons": {"16": "/images/logo.png", "32": "/images/logo.png", "48": "/images/logo.png", "128": "/images/logo.png"}, "manifest_version": 3, "content_scripts": [{"matches": ["https://*.linkedin.com/sales/*", "https://*.linkedin.com/recruiter/*", "https://*.linkedin.com/search/*", "https://www.linkedin.com/posts/*"], "js": ["scripts/bootstrap.bundle.min.js", "content_script.js"], "css": ["styles.css", "bootstrap/bootstrap.min.css"], "all_frames": true}], "web_accessible_resources": [{"resources": ["/images/*", "/components/*", "/scripts/*", "ajax_interceptor.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://mailminer.io/*"]}, "update_url": "https://clients2.google.com/service/update2/crx"}