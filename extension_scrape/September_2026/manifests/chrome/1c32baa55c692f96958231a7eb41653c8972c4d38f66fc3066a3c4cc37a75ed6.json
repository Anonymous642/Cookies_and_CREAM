{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Medium Translator", "version": "2.3.0", "description": "Ultra-fast translation for Medium articles \u2014 Translate to 25+ languages", "author": "OVERA", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Medium Translator", "default_popup": "popup/popup.html"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://medium.com/*", "https://*.medium.com/*", "https://towardsdatascience.com/*", "https://betterprogramming.pub/*", "https://levelup.gitconnected.com/*", "https://javascript.plainenglish.io/*", "https://uxdesign.cc/*", "https://blog.devgenius.io/*", "https://*.substack.com/*", "https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*", "https://libretranslate.de/*", "https://extensionpay.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://medium.com/*", "https://*.medium.com/*", "https://towardsdatascience.com/*", "https://betterprogramming.pub/*", "https://levelup.gitconnected.com/*", "https://javascript.plainenglish.io/*", "https://uxdesign.cc/*", "https://blog.devgenius.io/*", "https://*.substack.com/*"], "js": ["content/content.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "commands": {"toggle-translation": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Toggle translation"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}