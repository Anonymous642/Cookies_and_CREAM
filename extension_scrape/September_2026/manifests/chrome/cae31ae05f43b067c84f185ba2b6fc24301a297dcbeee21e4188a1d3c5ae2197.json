{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "vindecode.app - Free VIN Decoder and Instant Car Report", "version": "1.2.0", "description": "Decode VINs instantly. Auto-highlights VINs on pages, one-click decode, free NHTSA data, vehicle history reports.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://vpic.nhtsa.dot.gov/*", "https://www.carvertical.com/*"], "action": {"default_popup": "popup.html", "default_title": "VIN Decoder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/vin-validator.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "omnibox": {"keyword": "vin"}, "commands": {"open-decoder": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "Open VIN Decoder"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}