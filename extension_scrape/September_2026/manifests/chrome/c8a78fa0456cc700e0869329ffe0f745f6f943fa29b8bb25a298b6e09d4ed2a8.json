{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Transly", "version": "0.1.6", "description": "Read and translate webpage content while preserving the original layout.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "permissions": ["activeTab", "contextMenus", "identity", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/options/options.html", "src/popup/popup.html", "assets/*.css", "assets/*.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "Transly", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "src/popup/popup.html"}, "commands": {"translate-page": {"suggested_key": {"default": "Alt+W"}, "description": "Translate the current page"}, "restore-original": {"suggested_key": {"default": "Alt+A"}, "description": "Show the original page text"}}, "options_page": "src/options/options.html"}