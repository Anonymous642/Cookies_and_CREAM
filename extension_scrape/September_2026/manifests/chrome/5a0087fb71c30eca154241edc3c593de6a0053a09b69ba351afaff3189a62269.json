{"update_url": "https://clients2.google.com/service/update2/crx", "name": "XToggle Feed Blocker", "description": "Toggle X home feed visibility on and off.", "version": "1.0.1", "manifest_version": 3, "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "XToggle", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}