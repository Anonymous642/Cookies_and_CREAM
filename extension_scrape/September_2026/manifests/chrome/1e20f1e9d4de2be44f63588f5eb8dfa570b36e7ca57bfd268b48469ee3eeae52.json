{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LexiDay \u2014 Daily Word & Writing Coach", "version": "1.0.0", "description": "Learn a new word every day, earn points for actually using it, and catch common typos as you type. Everything stays on your device.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://api.languagetool.org/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "LexiDay", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["words.js", "dictionary.js", "grammar.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}