{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inflight \u2013 Video Feedback for Coding Agents", "description": "Record your screen and voice, point at what you mean, and get one link Claude Code, Cursor, or any coding agent can act on.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage", "tabs", "clipboardWrite"], "externally_connectable": {"matches": ["https://inflight.co/*"]}, "host_permissions": [], "action": {"default_title": "Inflight"}, "web_accessible_resources": [{"resources": ["pill.html", "permissions.html"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording this tab"}}, "background": {"service_worker": "background.js"}}