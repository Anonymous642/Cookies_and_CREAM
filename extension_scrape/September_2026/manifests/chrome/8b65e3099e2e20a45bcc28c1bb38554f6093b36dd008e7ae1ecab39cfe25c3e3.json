{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneMove Tab Shield", "version": "1.2", "description": "Hard-locks distracting websites during OneMove focus sessions to protect your attention.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "alarms", "notifications"], "host_permissions": ["https://*.onemoveflow.com/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.onemoveflow.com/*", "http://localhost:3000/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}