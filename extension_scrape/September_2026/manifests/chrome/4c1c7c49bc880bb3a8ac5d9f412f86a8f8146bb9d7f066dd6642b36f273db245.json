{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "What am I pretending today?", "short_name": "Pretending?", "description": "This extension replaces in Facebook the most displayed question 'What's on your mind today?' with 'What are you pretending today?'", "version": "2.0", "action": {"default_title": "What am I pretending today?"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://facebook.com/*", "https://*.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}