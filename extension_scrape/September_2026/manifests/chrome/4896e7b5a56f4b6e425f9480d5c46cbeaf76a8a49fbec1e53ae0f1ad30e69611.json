{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Candidate Clipper \u2014 save to your spreadsheet", "description": "Clip a profile you have open into a local list, then paste the whole list into your spreadsheet. No automation, no servers.", "version": "1.0.0", "action": {"default_popup": "index.html", "default_title": "Candidate Clipper"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "scripting"], "commands": {"clip-profile": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Clip the current profile"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}