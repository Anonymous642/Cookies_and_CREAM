{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TiimoAI", "version": "1.0.0", "description": "AI-powered productivity assistant with Pomodoro timer, focus blocking, and smart tab organization", "permissions": ["storage", "tabs", "tabGroups", "sidePanel", "webNavigation", "alarms", "scripting", "identity"], "optional_host_permissions": ["<all_urls>"], "commands": {"open-ai-highlighter": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Open AI Highlighter Assistant"}}, "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}}, "icons": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}, "web_accessible_resources": [{"resources": ["icons/logo.png", "icons/icon1.mp4", "icons/tomato.png", "icons/icon3.mp4", "icons/icon4.mp4", "blocked.html", "typingMonitor.js", "aiHighlighter.js", "aiHighlighter.css"], "matches": ["<all_urls>"]}]}