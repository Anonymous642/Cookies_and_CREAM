{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScrollSnapshot", "version": "1.0.0", "description": "Full-page, batch, region, slice, or visible-tab screenshots. Pixel-exact, local-only, no account.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "debugger"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "pages/popup.html", "default_title": "ScrollSnapshot \u2014 capture this page", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture the full page"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture a region"}, "capture-slices": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture the page as numbered slices"}}, "web_accessible_resources": [{"resources": ["pages/result.html", "assets/*", "content.js"], "matches": ["<all_urls>"]}]}