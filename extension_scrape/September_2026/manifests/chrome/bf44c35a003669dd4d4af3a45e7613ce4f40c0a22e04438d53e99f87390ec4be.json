{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Sticky Notes", "version": "0.1.2", "description": "Tab-scoped sticky notes that survive refresh and disappear when the tab closes.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "contextMenus"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_title": "Tab Sticky Notes"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["note-frame.html", "assets/*"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"create-note": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Create a new sticky note in the current tab"}}}