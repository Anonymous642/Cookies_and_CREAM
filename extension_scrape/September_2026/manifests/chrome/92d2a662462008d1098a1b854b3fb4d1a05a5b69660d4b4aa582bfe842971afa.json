{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "onUI", "version": "2.2.3", "description": "Annotate UI elements for AI agents - no code integration required", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "onUI - Annotate UI Elements", "default_popup": "src/popup/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "commands": {"toggle-annotate-mode": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Toggle annotate mode in the active tab"}, "toggle-draw-mode": {"suggested_key": {"default": "Alt+D", "mac": "Alt+D"}, "description": "Toggle draw mode in the active tab"}}, "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "alarms"]}