{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Scroll, Engage, Like & #/$ Filters for Reels, TikTok & YouTube Shorts", "version": "1.5.0", "description": "Auto scroll Reels, TikTok & Shorts. Engage with likes/comments. Filter by #hashtags & keywords. Per-platform controls.", "permissions": ["storage", "scripting", "activeTab", "tabs", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.youtube.com/*", "https://feedflow-billing.vercel.app/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Auto Scroll", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/reels/*", "https://www.instagram.com/*/reels/*", "https://www.tiktok.com/*", "https://www.youtube.com/*"], "js": ["features/auto-scroll/content.js"], "css": ["features/auto-scroll/overlay.css"], "run_at": "document_idle"}]}