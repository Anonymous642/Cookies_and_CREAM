{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LingoEcho", "description": "Turn any webpage or YouTube video into a language lesson with contextual definitions, translation, audio, and shadowing.", "version": "0.1.3", "icons": {"32": "icons/lingoecho-32.png", "64": "icons/lingoecho-64.png", "128": "icons/lingoecho-192.png"}, "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://www.lingoecho.com/*", "https://api.lingoecho.com/*", "https://media.lingoecho.com/*"], "action": {"default_title": "Open LingoEcho", "default_icon": {"32": "icons/lingoecho-32.png", "64": "icons/lingoecho-64.png", "128": "icons/lingoecho-192.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["page-surface.html", "assets/*", "chunks/*", "fonts/*", "icons/*", "images/*"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}