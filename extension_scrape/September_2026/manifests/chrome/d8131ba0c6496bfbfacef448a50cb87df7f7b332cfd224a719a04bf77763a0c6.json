{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Claudit", "version": "1.0.0", "description": "Local-only Claude usage tracker. Counts your messages, characters, and tokens. Zero telemetry.", "action": {"default_popup": "popup.html", "default_title": "Claudit", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "theme_icons": [{"size": 16, "light": "icons/icon-for-light-16.png", "dark": "icons/icon-for-dark-16.png"}, {"size": 32, "light": "icons/icon-for-light-32.png", "dark": "icons/icon-for-dark-32.png"}, {"size": 48, "light": "icons/icon-for-light-48.png", "dark": "icons/icon-for-dark-48.png"}, {"size": 128, "light": "icons/icon-for-light-128.png", "dark": "icons/icon-for-dark-128.png"}]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms"], "optional_permissions": ["cookies"], "commands": {"open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the AI Usage Tracker dashboard"}}, "host_permissions": ["*://claude.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://claude.ai/*"], "js": ["content/claude.js"], "run_at": "document_idle", "all_frames": false}]}