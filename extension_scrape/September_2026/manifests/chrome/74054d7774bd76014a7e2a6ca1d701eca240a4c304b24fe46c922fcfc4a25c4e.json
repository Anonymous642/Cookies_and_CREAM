{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GhostBox", "description": "GhostBox is a browser extension that generates unique, human-readable email aliases for use with Undelivered.io.", "version": "0.5.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "GhostBox", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_end", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["http://*/*", "https://*/*"]}]}