{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Unlimited History Tracker", "version": "1.1", "description": "Allows for unlimited history within the salesforce website so you don't lose where you just were.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["*://*.salesforce.com/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"256": "icon.png"}, "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.js", "icons/*.png"], "matches": ["<all_urls>"]}]}