{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdShield \u2014 Protection Web", "short_name": "AdShield", "version": "2.0.2", "description": "Bloque publicit\u00e9s, traqueurs, pop-ups, banni\u00e8res cookies et nuisances avec des filtres personnalisables.", "minimum_chrome_version": "121", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "alarms", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "AdShield", "default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "options_page": "options.html", "commands": {"toggle-protection": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Activer ou mettre AdShield en pause"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "declarative_net_request": {"rule_resources": [{"id": "core_rules", "enabled": true, "path": "rules/core.json"}, {"id": "privacy_rules", "enabled": true, "path": "rules/privacy.json"}, {"id": "french_rules", "enabled": true, "path": "rules/french.json"}, {"id": "annoyance_rules", "enabled": true, "path": "rules/annoyances.json"}, {"id": "social_rules", "enabled": false, "path": "rules/social.json"}, {"id": "security_rules", "enabled": true, "path": "rules/security.json"}, {"id": "youtube_rules", "enabled": true, "path": "rules/youtube.json"}]}, "web_accessible_resources": [{"resources": ["assets/logo.svg", "assets/replacements/*.png"], "matches": ["<all_urls>"]}], "author": "BELMOUFADAL Abderrahim"}