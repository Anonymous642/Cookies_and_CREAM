{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GC Stats Extension", "version": "1.27.0", "description": "Extracts box score stats from GameChanger and exports to Excel.", "permissions": ["storage", "downloads", "webRequest", "tabs"], "host_permissions": ["https://web.gc.com/*"], "content_scripts": [{"matches": ["*://web.gc.com/*"], "js": ["extractor.js"], "run_at": "document_idle"}, {"matches": ["*://web.gc.com/*"], "js": ["xlsx.min.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["extpay.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "GC Stats", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["paste.html", "xlsx.min.js", "extpay.js"], "matches": ["<all_urls>"]}]}