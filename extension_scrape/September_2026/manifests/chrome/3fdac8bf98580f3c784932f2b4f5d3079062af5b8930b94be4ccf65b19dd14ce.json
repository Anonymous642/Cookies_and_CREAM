{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple VaultPDF", "short_name": "VaultPDF", "version": "1.2.0", "description": "Local PDF editor. Merge, rotate, extract text, OCR scanned pages. Files stay on your device.", "author": "opzozi", "homepage_url": "https://github.com/opzozi/simple-vaultpdf", "permissions": ["storage", "offscreen", "unlimitedStorage"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' 'wasm-unsafe-eval';"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}