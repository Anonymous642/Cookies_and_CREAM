{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Intercall: Live Captions & Translator for Meetings", "description": "Real-time captions and live translation for any browser tab \u2014 Zoom, Google Meet, Teams, YouTube. Built for interpreters.", "version": "0.1.2", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Intercall captions", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["activeTab", "offscreen", "scripting", "storage", "tabCapture"], "host_permissions": ["https://intercall.app/*"], "externally_connectable": {"matches": ["https://intercall.app/*"]}, "commands": {"toggle-captions": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Start or stop captions for the current tab"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://intercall.app wss://stt-rt.soniox.com;"}, "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["<all_urls>"]}]}