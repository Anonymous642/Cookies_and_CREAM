{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URL to QR Code", "version": "1.1.0", "description": "Generate a QR code for any link on the page. Private \u2014 everything runs locally.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}