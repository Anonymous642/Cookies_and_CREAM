{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice2Force - Streamline Salesforce with Voice Commands", "description": "A mic icon appears next to any Salesforce field, letting you record text directly via voice for seamless, hands-free data entry.", "version": "1.6", "icons": {"16": "images/favicon-16 2.png", "32": "images/favicon-32 2.png", "128": "images/favicon-128 2.png", "180": "images/favicon-180 2.png"}, "commands": {"salesforce-shortcut": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Toggle Voice2Force on the current Salesforce page"}}, "permissions": ["cookies"], "host_permissions": ["https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://*.salesforce.com/*", "https://*.force.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.lightning.force.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "images/favicon-16 2.png", "32": "images/favicon-32 2.png", "128": "images/favicon-128 2.png", "180": "images/favicon-180 2.png"}, "default_title": "Voice2Force", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["images/*"], "matches": ["*://*.lightning.force.com/*", "*://*.my.salesforce.com/*"]}]}