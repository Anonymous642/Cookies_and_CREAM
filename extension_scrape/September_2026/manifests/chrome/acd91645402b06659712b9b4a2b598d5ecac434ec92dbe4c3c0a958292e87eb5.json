{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "4KShot - Screenshot & Screen Capture", "version": "2.2.1", "description": "Capture visible, full-page and selected screenshots. PRO adds 2K, 4K, scrolling capture and advanced annotation tools.", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabs", "scripting", "downloads", "storage", "clipboardWrite", "unlimitedStorage", "favicon"], "background": {"service_worker": "background.js"}, "action": {"default_title": "4KShot", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible area"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture active tab automatically with tab strip and URL bar"}, "capture-selected-area": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture selected area"}, "capture-scrolling-page": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Command+Shift+G"}, "description": "Capture scrolling full page"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/icon-128.png"], "matches": ["<all_urls>"]}], "host_permissions": ["https://live.dodopayments.com/*"]}