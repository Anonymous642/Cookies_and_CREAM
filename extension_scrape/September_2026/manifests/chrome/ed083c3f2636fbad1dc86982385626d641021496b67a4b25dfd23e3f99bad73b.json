{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "\u6162\u541e\u541e - Snail Timer", "version": "1.0.1", "description": "This extension sends a charmingly persistent snail after you when you stray from work websites. Watch it slowly cover your screen.", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*", "*://*/*"], "js": ["content.js"]}], "icons": {"32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png"}, "action": {"default_popup": "options.html", "default_icon": {"32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png"}}}