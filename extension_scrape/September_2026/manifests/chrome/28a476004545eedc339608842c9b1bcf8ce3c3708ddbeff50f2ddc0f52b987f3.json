{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Compressr", "version": "2.8.7", "description": "Typing is outdated. Compressr adds a 1-click reply button to Gmail and Outlook. One button. One click. One reply.", "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://compressr.replit.app/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Compressr", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["checkout-utils.js", "thread-utils.js", "content.js"], "css": ["style.css"], "run_at": "document_idle", "all_frames": true}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["welcome.html", "onboarding.html"], "matches": ["<all_urls>"]}]}