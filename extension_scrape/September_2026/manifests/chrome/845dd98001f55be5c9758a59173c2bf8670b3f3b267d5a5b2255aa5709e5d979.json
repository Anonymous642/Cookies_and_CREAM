{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SuperClicker", "description": "Autoclicker simple pour pages web (MV3).", "version": "0.3.0", "icons": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "manifest_version": 3, "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_icon": {"16": "icons/16x16.png", "32": "icons/32x32.png"}, "default_popup": "popup.html", "default_title": "SuperClicker"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-autoclick": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Start/Stop SuperClicker"}, "arm-target": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Armer la cible (prochain clic d\u00e9finit le point)"}}}