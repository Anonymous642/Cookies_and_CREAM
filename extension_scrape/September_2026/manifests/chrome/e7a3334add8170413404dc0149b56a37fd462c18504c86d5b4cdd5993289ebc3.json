{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageVoice \u2014 Read Aloud", "version": "0.1.0", "description": "Real-time text-to-speech for any web page. Reads the whole page or your selection aloud, with follow-along word highlighting.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_title": "PageVoice \u2014 Read Aloud", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-read": {"suggested_key": {"default": "Alt+R"}, "description": "Read this page / pause"}, "read-selection": {"suggested_key": {"default": "Alt+S"}, "description": "Read the selected text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}