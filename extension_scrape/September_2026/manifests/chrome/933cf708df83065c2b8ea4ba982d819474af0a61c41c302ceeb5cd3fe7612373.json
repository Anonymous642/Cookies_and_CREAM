{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Attention Aware Netflix Controller", "description": "Two-viewer attention-aware playback control for Netflix using a persistent side panel.", "version": "1.1.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "tabs", "activeTab"], "host_permissions": ["https://www.netflix.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Attention Panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["netflixBridge.js"], "matches": ["https://www.netflix.com/*"]}]}