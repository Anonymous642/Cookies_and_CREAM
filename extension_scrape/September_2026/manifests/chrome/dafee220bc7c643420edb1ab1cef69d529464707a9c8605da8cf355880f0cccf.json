{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatHop", "version": "0.7.14", "description": "Move AI chat context between leading AI assistants \u2014 without re-explaining from scratch.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "ChatHop \u2014 move this chat to another AI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"quick-transfer": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Hop this chat to your last-used destination"}}, "permissions": ["storage", "clipboardWrite", "scripting", "activeTab"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://chat.deepseek.com/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/deepseek.js"], "run_at": "document_idle"}, {"matches": ["https://chat.mistral.ai/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/mistral.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*"], "js": ["billing.js", "templates-defaults.js", "content/shared.js", "content/perplexity.js"], "run_at": "document_idle"}], "optional_host_permissions": ["https://chathop.tech/*"]}