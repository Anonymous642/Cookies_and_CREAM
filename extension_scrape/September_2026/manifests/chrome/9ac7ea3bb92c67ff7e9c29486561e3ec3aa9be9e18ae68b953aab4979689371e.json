{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Punjabi Font Pack", "description": "This extension allows the user to see the unicode fonts in Punjabi even if their system does not support it.", "version": "3.0", "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage"], "web_accessible_resources": [{"resources": ["*.woff", "font/*.woff"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "css": ["gujfonts.css"]}]}