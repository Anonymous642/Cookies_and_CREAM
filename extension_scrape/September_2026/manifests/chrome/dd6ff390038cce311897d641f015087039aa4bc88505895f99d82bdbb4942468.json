{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Crewy Credits", "description": "See Crewy project credits on YouTube and Vimeo without signing in. Search crew and companies, manage lists and your own credits.", "version": "0.1.11", "action": {"default_title": "Crewy Credits", "default_popup": "crewy-credits/popup.html"}, "background": {"service_worker": "crewy-credits/background.js"}, "icons": {"16": "crewy-credits/icons/icon16.png", "32": "crewy-credits/icons/icon32.png", "48": "crewy-credits/icons/icon48.png", "128": "crewy-credits/icons/icon128.png"}, "permissions": ["storage", "identity", "activeTab"], "host_permissions": ["https://api.crewy.com/*", "https://crewy.com/*", "https://www.crewy.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://vimeo.com/*", "https://www.vimeo.com/*", "https://player.vimeo.com/*"], "js": ["crewy-credits/inpage-launcher.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["crewy-credits/popup.html", "crewy-credits/popup.css", "crewy-credits/popup.js", "crewy-credits/config.js", "crewy-credits/icons/*"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://vimeo.com/*", "https://www.vimeo.com/*", "https://player.vimeo.com/*"]}]}