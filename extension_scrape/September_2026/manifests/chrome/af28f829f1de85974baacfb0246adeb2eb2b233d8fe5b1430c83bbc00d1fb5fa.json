{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Replylight - Reply to reviews just by highlighting them (AI)", "version": "1.0.2", "homepage_url": "https://replylight.com", "description": "Highlight a review and get a thoughtful reply instantly. For Google, Trustpilot & anywhere you can select text. No account needed", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Replylight \u2014 Select some review text to reply"}, "permissions": ["clipboardWrite", "storage", "contextMenus", "tabs", "favicon"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://api.replylight.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["context.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["styles/replylight.css", "fonts/*", "img/*", "icons/*", "_favicon/*"], "matches": ["<all_urls>"]}]}