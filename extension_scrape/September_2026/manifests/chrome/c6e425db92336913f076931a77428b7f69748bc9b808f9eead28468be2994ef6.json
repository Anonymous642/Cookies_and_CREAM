{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Good Room Planner \u2014 Model Importer", "version": "0.3.0", "description": "Click the toolbar button on any product page to send the product and its 3D model to The Good Room Planner.", "permissions": ["activeTab", "scripting", "storage", "declarativeNetRequest"], "optional_host_permissions": ["https://*/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Capture this product into The Good Room Planner", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://thegoodroomplanner.com/*", "https://www.thegoodroomplanner.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start"}]}