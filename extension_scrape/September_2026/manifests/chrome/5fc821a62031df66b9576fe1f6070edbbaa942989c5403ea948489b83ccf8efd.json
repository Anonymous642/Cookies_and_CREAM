{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Blocker - Hide AI Content on Social Media", "version": "1.2.0", "description": "Block and hide AI-generated posts, reels, and photos on Instagram, Facebook, X, Pinterest, and TikTok.", "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "AI Blocker"}, "content_scripts": [{"matches": ["https://*.twitter.com/*", "https://*.x.com/*", "https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.pinterest.com/*", "https://*.tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}