{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focus Guard", "version": "2.0.0", "description": "A local-first focus timer with guardrails. Simple or Pomodoro mode, pause/resume, optional site blocking, and daily goals.", "short_name": "Focus Guard", "minimum_chrome_version": "109", "permissions": ["storage", "alarms", "notifications", "contextMenus", "offscreen", "declarativeNetRequest", "idle"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Focus Guard", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none';"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"toggle-focus-session": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle focus session"}, "pause-resume": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Pause or resume current session"}}}