{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bubble Toolbox Essentials", "version": "1.5.20", "description": "Otimize o editor Bubble.io: alterne ajustes de performance e ative/desative o debug_mode no preview com um clique.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["storage", "tabs", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://*.bubble.io/*", "https://*.bubble.is/*", "https://*.bubbleapps.io/*", "https://*.bubble.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Bubble Toolbox Essentials"}, "commands": {"toggle_all_editor_on": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Ativar Todas Op\u00e7\u00f5es do Editor"}, "toggle_all_editor_off": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Desativar Todas Op\u00e7\u00f5es do Editor"}, "toggle_debug_mode_no_refresh": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Alternar Debug Silencioso (Sem Recarregar)"}}, "web_accessible_resources": [{"resources": ["injected-bundle-name.js"], "matches": ["https://*.bubble.io/*", "https://*.bubble.is/*", "https://*.bubbleapps.io/*", "https://*.bubble.com/*"]}], "content_scripts": [{"matches": ["https://*.bubble.io/*", "https://*.bubble.is/*", "https://*.bubbleapps.io/*", "https://*.bubble.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}