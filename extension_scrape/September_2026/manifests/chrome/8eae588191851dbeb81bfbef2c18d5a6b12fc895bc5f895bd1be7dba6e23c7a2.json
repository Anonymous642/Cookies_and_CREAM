{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mail Tracker", "version": "2.0.1", "description": "Track when your Gmail emails are opened. View read receipts and open counts in a simple popup dashboard.", "homepage_url": "https://mailtracker.qom.bd", "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*", "https://mailtracker.qom.bd/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "98": "icons/icon98.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "98": "icons/icon98.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "run_at": "document_idle"}]}