{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Sync", "version": "1.2.0", "description": "Export and sync conversations across Claude, ChatGPT, Gemini, and DeepSeek.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://claude.ai/*", "https://generativelanguage.googleapis.com/*", "https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.deepseek.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.claude.ai/*"], "js": ["injectors/claude-fetch-cache.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://*.claude.ai/*"], "js": ["config.js", "scrape-utils.js", "injectors/claude-api.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["config.js", "scrape-utils.js", "injectors/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["injectors/chatgpt-fetch-cache.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://chatgpt.com/*"], "js": ["config.js", "scrape-utils.js", "injectors/chatgpt-api.js", "injectors/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://chat.deepseek.com/*"], "js": ["config.js", "scrape-utils.js", "injectors/deepseek.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "AI Chat Sync", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}