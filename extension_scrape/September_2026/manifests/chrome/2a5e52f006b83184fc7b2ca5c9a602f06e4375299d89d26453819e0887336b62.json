{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tribble Extension", "description": "Add LinkedIn profiles to your Tribble lists", "version": "1.0.1", "manifest_version": 3, "action": {"default_popup": "index.html", "default_title": "Tribble Extension"}, "permissions": ["storage", "cookies", "activeTab"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://api.tribble.so/*", "https://www.linkedin.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.tribble.so"}}