{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Reader", "version": "1.2.0", "description": "A Chrome extension for reading and summarizing web articles", "permissions": ["scripting", "activeTab", "storage", "contextMenus", "clipboardWrite"], "action": {"default_title": "Web Reader"}, "background": {"service_worker": "js/background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["sidebar.html"], "matches": ["<all_urls>"]}], "commands": {"extract-and-summarize": {"suggested_key": {"default": "Shift+Alt+S", "mac": "Shift+Alt+S", "windows": "Shift+Alt+S", "chromeos": "Shift+Alt+S", "linux": "Shift+Alt+S"}, "description": "Extract and summarize the current article"}, "open-sidebar": {"suggested_key": {"default": "Shift+Alt+W", "mac": "Shift+Alt+W", "windows": "Shift+Alt+W", "chromeos": "Shift+Alt+W", "linux": "Shift+Alt+W"}, "description": "Open the sidebar"}}}