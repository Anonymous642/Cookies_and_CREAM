{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatYT - Chat with YouTube Videos", "description": "Chat with any YouTube video, get AI summaries, and export to PDF", "version": "1.0.0", "permissions": ["storage", "activeTab", "cookies"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://api.chatyt.io/*", "https://chatyt.io/*"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/content/index.js"], "css": ["src/styles/content.css", "src/styles/panel.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}