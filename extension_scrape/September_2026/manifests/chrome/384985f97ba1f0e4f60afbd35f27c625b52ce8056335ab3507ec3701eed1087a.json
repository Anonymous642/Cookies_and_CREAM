{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DesignAssets - Extract Any Website's Design", "version": "1.0.0", "description": "Extract colors, fonts, images, SVGs, and CSS from any website. Build design systems in seconds.", "permissions": ["activeTab", "scripting", "storage", "sidePanel", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open DesignAssets", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "side_panel": {"default_path": "popup/index.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/extractor.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}