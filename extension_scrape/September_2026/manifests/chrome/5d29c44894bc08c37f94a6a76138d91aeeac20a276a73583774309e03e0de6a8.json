{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AirTabs", "description": "Send the current window\u2019s tabs \u2013 or only the highlighted ones \u2013 to Chrome running on another machine.", "version": "1.0.2", "manifest_version": 3, "permissions": ["tabs", "storage", "contextMenus", "notifications"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_title": "AirTabs", "default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+A"}, "description": "Open the AirTabs popup"}, "send_highlighted": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Send highlighted tabs"}, "send_all": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Send every tab in this window"}, "open_pending": {"suggested_key": {"default": "Ctrl+Shift+O"}, "description": "Open next batch of received tabs"}}}