{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "All-Inclusive Accessibility Suite", "version": "3.0", "description": "Outil complet d'accessibilit\u00e9 web avec multiples fonctionnalit\u00e9s d'adaptation", "permissions": ["activeTab", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Ouvrir le menu d'accessibilit\u00e9"}, "icons": {"16": "src/logo.png", "32": "src/logo.png", "48": "src/logo.png", "128": "src/logo.png"}, "background": {"service_worker": "js/background.js"}, "commands": {"toggle-features": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Activer/D\u00e9sactiver les fonctionnalit\u00e9s All-Inclusive"}}, "web_accessible_resources": [{"resources": ["assets/fonts/*/*.woff2", "src/logo.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "css": ["css/content.css"], "run_at": "document_idle"}]}