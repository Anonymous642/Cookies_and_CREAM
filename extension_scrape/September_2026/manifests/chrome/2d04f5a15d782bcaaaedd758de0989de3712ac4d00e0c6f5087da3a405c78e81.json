{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SellerGPT", "version": "0.6.1", "description": "SellerGPT panel for Amazon product pages: profit calculator, price history, buy-box and offer intel, and sell-eligibility checks.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "cookies"], "host_permissions": ["https://api.usesellergpt.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.amazon.com/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/*/gp/product/*", "https://www.amazon.com/gp/product/*", "https://www.amazon.com/gp/aw/d/*", "https://www.amazon.com/gp/offer-listing/*", "https://smile.amazon.com/*/dp/*", "https://smile.amazon.com/dp/*", "https://smile.amazon.com/gp/product/*", "https://www.amazon.ca/*/dp/*", "https://www.amazon.ca/dp/*", "https://www.amazon.ca/gp/product/*", "https://www.amazon.ca/gp/aw/d/*", "https://www.amazon.co.uk/*/dp/*", "https://www.amazon.co.uk/dp/*", "https://www.amazon.co.uk/gp/product/*", "https://www.amazon.co.uk/gp/aw/d/*"], "js": ["content.js"], "css": ["styles/tokens.css", "styles/base.css", "styles/modules.css", "styles/sections.css", "styles/bigchart.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "SellerGPT \u2014 open a product page", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["src/*", "icons/*"], "matches": ["https://*.amazon.com/*", "https://*.amazon.ca/*", "https://*.amazon.co.uk/*"]}]}