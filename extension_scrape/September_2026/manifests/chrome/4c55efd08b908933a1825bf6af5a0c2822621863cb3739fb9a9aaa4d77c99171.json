{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wikies UML", "version": "0.1.0", "description": "Renders PlantUML diagrams from code blocks on Confluence Cloud wiki pages. Entirely in your browser - no server, no upload.", "homepage_url": "https://github.com/Saljack/wikies-uml", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.atlassian.net/wiki/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["renderer.html", "renderer.js", "vendor/plantuml.js", "vendor/viz-global.js"], "matches": ["https://*.atlassian.net/*"]}], "permissions": ["clipboardWrite"]}