{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Return YouTube Dislike", "version": "1.1", "description": "Restores YouTube dislike counts using the Return YouTube Dislike API. View dislikes on every video to make informed decisions", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://returnyoutubedislikeapi.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}