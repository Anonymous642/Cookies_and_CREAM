{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unrepostify - TikTok Repost Remover", "version": "1.0.0", "description": "Remove all your TikTok reposts in one click. No login required.", "permissions": ["storage"], "host_permissions": ["https://*.tiktok.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://*.tiktok.com/*"], "js": ["content/content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}