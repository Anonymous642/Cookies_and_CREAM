{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anara Web Clipper", "description": "Detect and save PDF documents, webpages and videos to your Anara library.", "version": "0.4.7", "icons": {"16": "icon/default/16.png", "32": "icon/default/32.png", "48": "icon/default/48.png", "96": "icon/default/96.png", "128": "icon/default/128.png"}, "permissions": ["storage", "activeTab", "tabs", "clipboardWrite", "notifications", "scripting", "webRequest"], "host_permissions": ["<all_urls>", "https://anara.com/*", "https://*.anara.com/*"], "action": {"default_icon": {"16": "icon/default/16.png", "32": "icon/default/32.png", "48": "icon/default/48.png", "96": "icon/default/96.png", "128": "icon/default/128.png"}, "default_title": "Anara Web Clipper"}, "web_accessible_resources": [{"resources": ["pdf.worker.mjs"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}