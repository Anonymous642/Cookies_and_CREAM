{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tiny Herd", "version": "2.2.0", "description": "A tiny pixel pet for every page. It levels up as you browse, runs focus sessions, earns badges, and reminds you to take breaks.", "permissions": ["storage", "alarms", "downloads", "tabs", "idle", "system.memory"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tiny Herd"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["pet.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["sprites/*.png"], "matches": ["<all_urls>"]}]}