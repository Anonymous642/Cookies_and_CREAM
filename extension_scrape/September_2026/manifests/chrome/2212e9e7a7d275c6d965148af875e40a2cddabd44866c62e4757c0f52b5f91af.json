{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub bot mentions", "version": "0.2.4", "description": "Autocomplete your saved bot accounts in GitHub comments.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "action": {"default_popup": "options.html?popup", "default_title": "GitHub bot mentions", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://github.com/*"], "js": ["bot-names.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}