{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZapQR", "version": "1.3.0", "description": "Scan a QR code with your phone to fill a password, or walk up and approve on your phone. No typing either way.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://relay.zapqr.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["qrcode.min.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}