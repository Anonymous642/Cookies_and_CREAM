{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReaPPPPeat", "version": "1.0.0", "description": "Precision video looping for YouTube - perfect for learning music, languages, and mastering video content", "author": "ReaPPPPeat Team", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "notifications", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/index.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/index.html"}, "options_page": "settings/index.html", "commands": {"mark-a": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Mark loop start point (A)"}, "mark-b": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Mark loop end point (B)"}, "toggle-loop": {"suggested_key": {"default": "Alt+L", "mac": "Alt+L"}, "description": "Toggle loop on/off"}, "save-segment": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save current segment"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["styles/*.css"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}