{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paste Loop", "version": "1.0.0", "description": "Stop losing screenshots in AI chats. Paste Loop remembers everything you share with Claude and ChatGPT.", "permissions": ["storage", "notifications", "scripting", "tabs", "sidePanel", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://perplexity.ai/*", "https://gemini.google.com/*", "https://figma.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://perplexity.ai/*", "https://gemini.google.com/*", "https://figma.com/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "action": {"default_title": "Paste Loop", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle Paste Loop panel"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}