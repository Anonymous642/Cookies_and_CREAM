{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AzureUpdatesLinkCopyExtension", "author": "kosmosebi", "version": "0.5", "manifest_version": 3, "description": "Send Azure Updates permalink and title to clipboard", "content_scripts": [{"matches": ["https://azure.microsoft.com/*/updates*", "https://www.microsoft.com/*/microsoft-365/roadmap*"], "js": ["index.js"], "run_at": "document_end"}], "commands": {"copy-title-and-url": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Copy url and title"}}, "background": {"service_worker": "background.js"}, "permissions": ["clipboardWrite", "activeTab"], "host_permissions": ["https://azure.microsoft.com/*/updates*", "https://www.microsoft.com/*/microsoft-365/roadmap*"]}