{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Moody", "description": "Sauvegarde en 1 clic des pages, images et textes pour cr\u00e9er un moodboard visuel sans friction.", "version": "1.3.0", "icons": {"16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "scripting", "clipboardWrite"], "host_permissions": ["https://moody-board.com/*"], "action": {"default_title": "Moody", "default_popup": "popup.html"}, "commands": {"moody_quick_capture": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Ouvrir la barre de capture Moody"}}, "background": {"type": "module", "service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}, {"matches": ["https://moody-board.com/*"], "js": ["content-scripts/moody-site.js"]}]}