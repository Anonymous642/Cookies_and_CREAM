{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Temporary eMail - Disposable Email", "description": "Generate and manage temporary email addresses instantly. Auto-fill email forms and receive inbox notifications.", "version": "1.2", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"css": ["content.css"], "js": ["content.js"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://temporaryemail.io;"}, "host_permissions": ["https://temporaryemail.io/*", "https://*.temporaryemail.io/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "permissions": ["storage"]}