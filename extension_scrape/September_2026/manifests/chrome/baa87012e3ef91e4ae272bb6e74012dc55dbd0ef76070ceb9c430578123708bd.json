{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snap OCR", "description": "Drag any on-screen area to extract its text and copy it \u2014 works best on clear text, fully on-device.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "offscreen", "storage"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "commands": {"start-capture": {"suggested_key": {"default": "Alt+S"}, "description": "Start area OCR"}}, "web_accessible_resources": [{"resources": ["tess/*", "tess/core/*", "tess/tessdata/*"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": []}