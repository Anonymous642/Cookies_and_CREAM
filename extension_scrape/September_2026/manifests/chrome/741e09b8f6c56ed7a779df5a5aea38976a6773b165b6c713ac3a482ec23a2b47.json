{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InvoiceGrab \u2013 Amazon Rechnungen herunterladen als PDF", "description": "Alle amazon.de-Rechnungen eines Zeitraums als PDF laden \u2014 GoBD-konform benannt, als ZIP mit DATEV-tauglichem CSV-Index.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["https://www.amazon.de/*"], "action": {"default_title": "InvoiceGrab"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.de/*"], "js": ["content-scripts/amazon.js"]}, {"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/amazon.css"], "use_dynamic_url": true, "matches": ["https://www.amazon.de/*"]}]}