{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Repo Combiner for AI", "version": "2.0", "description": "Combines GitHub repo code into one file for uploading to any AI tool, bypassing file limits.", "permissions": ["storage"], "host_permissions": ["https://api.github.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["https://github.com/*/*"], "js": ["content.js"], "run_at": "document_end"}]}