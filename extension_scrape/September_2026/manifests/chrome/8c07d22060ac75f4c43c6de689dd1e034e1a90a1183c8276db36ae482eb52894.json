{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leafmark \u2013 Auto-File Your Bookmarks", "short_name": "Leafmark", "version": "0.1.0", "description": "Files each new bookmark into the right folder, and asks only when it isn't sure. Bring your own OpenRouter key.", "permissions": ["bookmarks", "storage", "tabs", "scripting", "notifications"], "host_permissions": ["https://openrouter.ai/*", "https://api.typesafe.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Leafmark", "default_popup": "review.html?popup", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "options_page": "options.html", "optional_host_permissions": ["<all_urls>"]}