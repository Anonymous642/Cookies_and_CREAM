{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VSummary \u2014 record your meetings", "version": "1.3.0", "description": "Record any meeting in your browser with one click. Google Meet, Zoom or Teams \u2014 nothing joins your call.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "storage", "contextMenus", "activeTab"], "host_permissions": ["https://vsummary.com/*", "https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "externally_connectable": {"matches": ["https://vsummary.com/*", "http://localhost:5173/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Record this meeting to VSummary", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Start or stop recording this meeting"}}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["providers.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["permission.html", "permission.js"], "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"]}]}