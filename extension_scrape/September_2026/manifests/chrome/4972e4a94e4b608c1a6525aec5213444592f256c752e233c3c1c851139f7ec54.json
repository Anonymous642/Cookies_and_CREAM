{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabfolio", "description": "Finally, a tab manager that works and looks great. Every tab one keystroke away. Hibernate the rest into named Spaces.", "version": "0.10.1", "homepage_url": "https://tabfol.io", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabs", "storage", "windows"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"open-manager": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Tabfolio"}}, "action": {"default_title": "Open Tabfolio"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["src/manager/index.html"], "use_dynamic_url": false}]}