{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FurAffinity Account Switcher", "version": "1.2.1", "description": "Easily switch accounts on FurAffinity", "homepage_url": "https://gitlab.com/airships/fa-switcher-firefox", "author": "Showly", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "fa-switcher-firefox@owlso.me", "strict_min_version": "109.0"}}, "permissions": ["cookies", "storage", "activeTab", "tabs", "clipboardRead", "clipboardWrite"], "host_permissions": ["*://furaffinity.net/*", "*://*.furaffinity.net/*"], "background": {"scripts": ["workers/background.js"], "service_worker": "workers/background.js"}, "action": {"default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://furaffinity.net/*", "*://*.furaffinity.net/*"], "js": ["browser-polyfill.js", "workers/content.js"], "run_at": "document_idle", "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["browser-polyfill.js"], "matches": ["*://furaffinity.net/*", "*://*.furaffinity.net/*"]}]}