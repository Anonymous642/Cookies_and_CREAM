{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Privacy for WhatsApp", "version": "1.0.4", "author": "Rakshan Manvaith", "description": "Blur chat messages, text previews, images, videos, profile pictures, and contact names on WhatsApp Web for privacy.", "manifest_version": 3, "permissions": ["storage", "scripting"], "host_permissions": ["https://web.whatsapp.com/"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/"], "js": ["scripts/content.js"]}], "action": {"default_title": "Privacy for WhatsApp Web\u2122", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/styles/messages.css", "assets/styles/messagesPreview.css", "assets/styles/lastMessages.css", "assets/styles/mediaPreview.css", "assets/styles/mediaGallery.css", "assets/styles/textInput.css", "assets/styles/profilePic.css", "assets/styles/name.css", "assets/styles/unblurActive.css"], "matches": ["<all_urls>"]}], "commands": {"toggle": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Toggle privacy on/off"}}}