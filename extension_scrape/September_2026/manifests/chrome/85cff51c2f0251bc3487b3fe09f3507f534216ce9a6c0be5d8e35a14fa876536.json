{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Summate - AI Summary, Chat & Save for Later", "version": "1.2.1", "description": "Save time with instant AI summaries of any website or YouTube video. Chat with content and save for later with smart daily digests.", "background": {"service_worker": "src/pages/background/index.js", "type": "module"}, "action": {"default_icon": "icon-34.png"}, "icons": {"128": "icon-128.png"}, "permissions": ["tabs", "storage", "contextMenus"], "commands": {"open-summate": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Summarize current page"}, "save-for-later": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Save current page for later"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/pages/content/index.js"]}], "externally_connectable": {"matches": ["*://localhost/*", "https://summate.io/*"]}, "web_accessible_resources": [{"resources": ["assets/js/*.js"], "matches": ["<all_urls>"]}]}