{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipboard History Pro - Clipboard Manager", "short_name": "Clipboard Pro", "description": "Free offline clipboard manager. Save, search & organize your copy history \u2014 text, links, code, images & notes. 100% private.", "version": "1.0.0", "minimum_chrome_version": "116", "permissions": ["storage", "unlimitedStorage", "clipboardRead", "clipboardWrite", "offscreen", "alarms", "contextMenus", "notifications"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Clipboard History Pro (Ctrl+Shift+V)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open Clipboard History"}, "copy-last-item": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Copy last clipboard item"}, "copy-second-item": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Copy second clipboard item"}, "open-history-page": {"description": "Open full history dashboard"}}}