{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Angel Settings", "version": "1.2.0", "description": "Take back control of your feed. Filter rage bait, clickbait & spam on Facebook, Instagram, YouTube & X. 100% private.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "https://*.replit.app/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "index.html", "default_title": "Angel Settings", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["facebook.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["instagram.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["twitter.js"], "run_at": "document_idle"}]}