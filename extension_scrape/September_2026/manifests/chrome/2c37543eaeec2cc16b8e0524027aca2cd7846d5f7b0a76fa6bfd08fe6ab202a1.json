{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptVault \u2014 Save your AI prompts", "version": "0.1.11", "description": "Never lose a great prompt again. Auto-saves what you type into ChatGPT, Claude, Gemini, Perplexity & Replit. Search it all.", "action": {"default_title": "PromptVault", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options/options.html", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage", "alarms", "activeTab", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://replit.com/*", "https://promptvault.fyi/*", "https://*.promptvault.fyi/*", "http://localhost/*", "https://*.replit.dev/*", "https://*.replit.app/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/common.js", "content/adapters/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content/common.js", "content/adapters/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content/common.js", "content/adapters/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content/common.js", "content/adapters/perplexity.js"], "run_at": "document_idle"}, {"matches": ["https://replit.com/*"], "js": ["content/common.js", "content/adapters/replit.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/inline-ui.css"], "matches": ["<all_urls>"]}]}