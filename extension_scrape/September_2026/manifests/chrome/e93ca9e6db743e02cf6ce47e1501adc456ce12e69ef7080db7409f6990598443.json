{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Koi's Web Translator", "version": "1.0.0", "description": "Translate visible web page text and render Traditional Chinese results directly below the original content.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*", "https://libretranslate.com/*"], "background": {"service_worker": "dist/background/main.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["dist/content/main.js"], "run_at": "document_idle"}], "action": {"default_title": "Koi's Web Translator", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}, "default_popup": "popup.html"}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["assets/*.png"], "matches": ["<all_urls>"]}]}