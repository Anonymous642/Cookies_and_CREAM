{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Research Buddy", "version": "1.0.0", "description": "Notes, search, hover previews, and smart paste \u2014 your research session in one place.", "permissions": ["storage", "tabs", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Research Buddy", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content-script.js"], "css": ["content/overlay.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-notes": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle notes overlay for current page"}, "open-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open cross-tab search omnibar"}, "capture-quote": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Save selected text as a quote"}}, "web_accessible_resources": [{"resources": ["omnibar/omnibar.html"], "matches": ["<all_urls>"]}]}