{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StreamBlur", "version": "6.14.1", "description": "Protect API keys, passwords, and secrets while streaming. Blur protection for YouTube, Twitter, GitHub, Discord & Twitch.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "tabs", "sidePanel"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.github.com/*", "*://*.discord.com/*", "*://*.twitch.tv/*", "*://*.streamblur.com/*", "https://firestore.googleapis.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "StreamBlur"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.github.com/*", "*://*.discord.com/*", "*://*.twitch.tv/*", "*://*.streamblur.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"toggle-protection": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Toggle StreamBlur protection"}}}