{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpeedGrid New Tab", "description": "Open SpeedGrid on every new tab and save pages directly to your grids.", "version": "1.1.3", "homepage_url": "https://speedgrid.app/", "permissions": ["activeTab", "contextMenus", "search"], "optional_permissions": ["tabs", "tabGroups"], "externally_connectable": {"matches": ["https://speedgrid.app/*", "https://www.speedgrid.app/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "SpeedGrid Quick Save", "default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}