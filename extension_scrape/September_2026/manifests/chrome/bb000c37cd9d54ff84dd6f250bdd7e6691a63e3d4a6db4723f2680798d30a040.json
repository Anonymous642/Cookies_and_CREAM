{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CloseADeal Assistant", "description": "Extract contacts and generate personalized messages directly from LinkedIn and company websites", "version": "1.0.3", "permissions": ["activeTab", "storage", "tabs", "scripting", "notifications"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*", "https://app.closeadeal.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://app.closeadeal.ai/*"], "js": ["content-scripts/closeadeal.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content-scripts/linkedin.js", "content-scripts/sticky-sidebar.js"], "css": ["content-scripts/linkedin.css"], "run_at": "document_end"}, {"matches": ["https://*/*"], "exclude_matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content-scripts/generic.js", "content-scripts/sticky-sidebar.js"], "css": ["content-scripts/generic.css"], "run_at": "document_end"}], "action": {"default_title": "CloseADeal Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content-scripts/*", "shared/*"], "matches": ["<all_urls>"]}]}