{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Saudi Riyal Symbol", "version": "1.0.0", "description": "Replaces a custom shortcut (default Shift+4) with a Saudi Riyal symbol and Shift+Alt+4 with $ in Office Online and Google Docs.", "permissions": ["activeTab", "scripting", "clipboardWrite", "clipboardRead", "contextMenus", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.office.com/*word*", "*://*.officeapps.live.com/*word*", "*://*.sharepoint.com/*word*", "*://*.office.com/*outlook*", "*://*.officeapps.live.com/*outlook*", "*://*.sharepoint.com/*outlook*", "*://*.outlook.com/*", "*://*.outlook.office.com/*", "*://*.office.com/*powerpoint*", "*://*.officeapps.live.com/*powerpoint*", "*://*.sharepoint.com/*powerpoint*", "*://docs.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "all_frames": true}], "commands": {"insert-dollar": {"suggested_key": {"default": "Shift+Alt+4", "mac": "Shift+Alt+4"}, "description": "Inserts the original dollar sign"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["images/custom-dollar.svg", "fonts/customfont.ttf", "fonts/customfont.woff", "fonts/customfont.woff2", "options.js"], "matches": ["*://*.office.com/*", "*://*.officeapps.live.com/*", "*://*.sharepoint.com/*", "*://*.outlook.com/*", "*://*.outlook.office.com/*", "*://docs.google.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}