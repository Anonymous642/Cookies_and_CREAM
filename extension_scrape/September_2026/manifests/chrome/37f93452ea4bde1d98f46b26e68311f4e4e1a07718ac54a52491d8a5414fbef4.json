{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageWhisper", "version": "0.1.0", "description": "Whisper with the current page (HTML/PDF/images). Local-only storage, user-configured LLM endpoint.", "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/sw.js", "type": "module"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Open PageWhisper", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "side_panel": {"default_path": "src/ui/sidepanel.html"}, "commands": {"toggle-sidepanel": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle PageWhisper side panel"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/vendor/pdfjs/*"], "matches": ["<all_urls>"]}]}