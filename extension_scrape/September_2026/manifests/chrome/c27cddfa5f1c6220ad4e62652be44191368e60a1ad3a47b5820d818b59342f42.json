{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Form Filler", "version": "1.0.0", "description": "Fill test forms with smart, scoped fake data. Local-only, no tracking, injects only when you activate.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Smart Form Filler", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "commands": {"fill-form": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Fill form in scope"}, "fill-field": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Fill focused field only"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}