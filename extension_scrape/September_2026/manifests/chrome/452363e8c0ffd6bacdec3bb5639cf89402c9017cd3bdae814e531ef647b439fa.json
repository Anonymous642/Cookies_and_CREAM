{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rawlens \u2014 Markdown, JSON & CSV Viewer", "short_name": "Rawlens", "version": "1.1.0", "description": "Renders raw Markdown, JSON, and CSV opened in the browser as styled documents, with switchable themes.", "minimum_chrome_version": "128", "permissions": ["storage", "scripting", "declarativeNetRequestWithHostAccess"], "host_permissions": ["file:///*", "http://*/*", "https://*/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Rawlens \u2014 open a local file"}, "declarative_net_request": {"rule_resources": [{"id": "csv_inline", "enabled": true, "path": "rules/csv-inline.json"}]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["file:///*", "http://*/*", "https://*/*"], "js": ["src/resolve.js", "src/detect.js"], "run_at": "document_idle"}]}