{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jay Assistant", "version": "1.1.0", "description": "Extension pour automatiser vos actions CRM (HubSpot, Salesforce) depuis Jay Assistant", "permissions": ["storage", "alarms"], "host_permissions": ["https://app.hubspot.com/*", "https://app-eu1.hubspot.com/*", "https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*", "https://jay-assistant.fr/*", "http://localhost:8080/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.hubspot.com/*", "https://app-eu1.hubspot.com/*"], "js": ["content-hubspot.js"], "run_at": "document_idle"}, {"matches": ["https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*"], "js": ["content-salesforce.js"], "run_at": "document_idle"}, {"matches": ["https://jay-assistant.fr/extension/*", "http://localhost:8080/extension/*"], "js": ["content-oauth.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Ouvrir Jay Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["injected-hubspot.js"], "matches": ["https://app.hubspot.com/*", "https://app-eu1.hubspot.com/*"]}, {"resources": ["injected-salesforce.js"], "matches": ["https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.my.salesforce.com/*"]}], "externally_connectable": {"matches": ["https://jay-assistant.fr/*", "http://localhost:8080/*"]}}