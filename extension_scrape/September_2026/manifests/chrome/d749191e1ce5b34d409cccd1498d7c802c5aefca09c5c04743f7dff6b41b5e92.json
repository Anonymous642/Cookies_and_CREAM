{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Graveyard", "version": "1.0.0", "description": "Send tabs to the graveyard. Resurrect them when you're ready.", "permissions": ["contextMenus", "storage", "tabs", "activeTab", "alarms"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Tab Graveyard", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "commands": {"bury-tab": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Bury the current tab into the graveyard"}, "open-graveyard": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open the Tab Graveyard"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icons/*"], "use_dynamic_url": false}]}