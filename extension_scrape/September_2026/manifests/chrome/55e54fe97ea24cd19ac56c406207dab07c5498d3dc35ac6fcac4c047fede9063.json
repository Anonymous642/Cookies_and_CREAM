{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ayuta - Your Knowledge Universe", "version": "1.0.0", "description": "Save articles, videos, and links to your Ayuta collection. Your knowledge universe awaits.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "alarms"], "host_permissions": ["https://*.firebaseapp.com/*", "https://*.googleapis.com/*", "https://app.ayuta.me/*"], "content_scripts": [{"matches": ["https://app.ayuta.me/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"save-article": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save current page to Ayuta"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Open Ayuta popup"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}