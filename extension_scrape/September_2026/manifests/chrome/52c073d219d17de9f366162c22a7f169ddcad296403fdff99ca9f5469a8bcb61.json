{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Minimal Tab Title Changer", "short_name": "Tab Title", "version": "1.0.0", "description": "Rename a tab title via shortcut. No UI. CMD+Shift+E to rename, CMD+Shift+W to clear. (Windows: Alt+E / Alt+W)", "permissions": ["scripting", "tabs", "storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "service_worker.js"}, "commands": {"rename-tab": {"suggested_key": {"default": "Alt+E", "mac": "Command+Shift+E"}, "description": "Rename current tab (lock title)"}, "clear-rename": {"suggested_key": {"default": "Alt+W", "mac": "Command+Shift+W"}, "description": "Clear locked tab title"}}, "browser_specific_settings": {"gecko": {"id": "tab-title@rajnoha.com", "strict_min_version": "109.0"}}}