{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatBlur Pro", "version": "1.1.1", "description": "Blur chats on WhatsApp, Telegram, Messenger & more. One-click privacy.", "permissions": ["activeTab", "storage", "scripting", "commands"], "host_permissions": ["https://web.whatsapp.com/*", "https://web.telegram.org/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.instagram.com/*", "https://discord.com/*", "https://app.slack.com/*", "https://x.com/messages/*", "https://twitter.com/messages/*", "https://www.linkedin.com/messaging/*", "https://signal.me/*", "https://www.viber.com/web/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Open ChatBlur Pro popup"}, "toggle-blur": {"suggested_key": {"default": "Alt+B"}, "description": "Toggle blur on/off"}}, "action": {"default_popup": "popup/popup.html", "default_title": "ChatBlur Pro", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*", "https://web.telegram.org/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://facebook.com/*", "https://www.instagram.com/*", "https://discord.com/*", "https://app.slack.com/*", "https://x.com/messages/*", "https://twitter.com/messages/*", "https://www.linkedin.com/messaging/*", "https://signal.me/*", "https://www.viber.com/web/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles/blur.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}