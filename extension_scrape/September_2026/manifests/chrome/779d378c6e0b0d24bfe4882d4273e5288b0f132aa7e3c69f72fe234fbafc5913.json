{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wanda99", "description": "Obt\u00e9n transcripciones de videos de YouTube directamente desde tu navegador. Incluye captura autom\u00e1tica de fotogramas clave.", "version": "1.0.2", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "scripting", "tabs", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://youtubei.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_title": "Wanda99 - Transcripciones de YouTube", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://localhost:3000/*", "https://wanda99.com/*"], "js": ["content.js"], "run_at": "document_start"}]}