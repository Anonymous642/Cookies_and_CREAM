{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess Puzzle Counter", "version": "1.0.0", "description": "Displays an accurate count of how many chess puzzles you've completed today on chess.com \u2014 works for both app and browser.", "permissions": ["storage", "alarms"], "host_permissions": ["*://*.chess.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.chess.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.chess.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}