{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Aarticulate", "version": "1.0.3", "description": "Transform simple prompts into professional AI requests for ChatGPT, Claude & more. Privacy-focused with user consent.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://*.openai.com/*", "https://*.chatgpt.com/*", "https://*.claude.ai/*", "https://*.bard.google.com/*", "https://*.copilot.microsoft.com/*", "https://api.aarticulate.io/*", "https://*.aarticulate.com/*", "https://*.lemonsqueezy.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.openai.com/*", "https://*.chatgpt.com/*", "https://*.claude.ai/*", "https://*.bard.google.com/*", "https://*.copilot.microsoft.com/*"], "js": ["api-client.js", "ai-enhancer.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "Prompt Enhancer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["api-client.js", "ai-enhancer.js", "icons/*.png"], "matches": ["https://*.openai.com/*", "https://*.chatgpt.com/*", "https://*.claude.ai/*", "https://*.bard.google.com/*", "https://*.copilot.microsoft.com/*"]}], "commands": {"enhance-prompt": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Enhance current prompt"}}}