{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curious Characters", "short_name": "Curious Characters", "description": "Interrobangs and their type. A curated palette of rare punctuation marks with the history behind each one.", "version": "1", "action": {"default_popup": "popup.html", "default_title": "Curious Characters"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"insert-interrobang": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Insert interrobang"}, "insert-em-dash": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Insert em dash"}, "insert-ellipsis": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Insert ellipsis"}, "insert-section": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Insert section sign"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}