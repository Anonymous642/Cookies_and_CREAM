{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Secure Alley - ChatGPT Data Leak Protection", "description": "Secure Alley Chrome Extension provides a privacy guard that protects you against sharing sensitive information with ChatGPT.", "version": "0.1.6", "homepage_url": "https://www.thesecurealley.com", "privacy_policy": "https://www.thesecurealley.com/privacy-policy", "action": {"default_icon": "Image.png", "default_popup": "src/popup/popup.html"}, "host_permissions": ["https://chat.openai.com/*", "http://localhost:3001/*", "https://secure-alley-dashboard.vercel.app/*", "http://127.0.0.1:5000/*"], "icons": {"16": "Image-16.png", "48": "Image-48.png", "128": "Image.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["src/content.js"]}], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["Image.png"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}], "permissions": ["storage", "activeTab"]}