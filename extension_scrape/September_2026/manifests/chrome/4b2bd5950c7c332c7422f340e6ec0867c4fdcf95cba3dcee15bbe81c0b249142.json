{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PickMyCard \u2014 Which card should I use?", "version": "1.3.0", "description": "Shows which of your credit cards earns the most at the store you are shopping on, plus an overlay right on the checkout page.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "Which card should I use?", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Which card should I use?"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}