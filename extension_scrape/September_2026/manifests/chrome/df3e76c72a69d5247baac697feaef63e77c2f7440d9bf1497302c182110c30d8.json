{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipKey - Smart URL Navigator", "version": "1.5", "description": "\ud83d\ude80 Turn clipboard text into custom URLs instantly with keyboard shortcuts. Perfect for support teams, order tracking, and more!", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "clipboardRead", "scripting", "contextMenus", "notifications"], "host_permissions": ["<all_urls>", "https://clipkey-analytics.juanramoncano-tech.workers.dev/*", "https://*.workers.dev/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"open-url-with-clipboard-1": {"suggested_key": {"default": "Ctrl+Shift+Space", "windows": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open URL 1 with clipboard content"}, "open-url-with-clipboard-2": {"suggested_key": {"default": "Ctrl+Shift+1", "windows": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Open URL 2 with clipboard content"}, "open-url-with-clipboard-3": {"suggested_key": {"default": "Ctrl+Shift+2", "windows": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Open URL 3 with clipboard content"}, "open-url-with-clipboard-4": {"suggested_key": {"default": "Ctrl+Shift+E", "windows": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open URL 4 with clipboard content"}}}