{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Job Resume Online - AI Autofill", "version": "3.8.2", "description": "Fill job application forms from a locally saved resume profile, with optional on-device AI when Chrome supports it.", "homepage_url": "https://jobresume.online", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "sidePanel", "scripting", "contextMenus", "alarms", "notifications"], "host_permissions": ["https://boards-api.greenhouse.io/*", "https://api.lever.co/*", "https://api.ashbyhq.com/*", "https://remotive.com/*", "https://jobicy.com/*", "https://remoteok.com/*", "https://himalayas.app/*", "https://www.arbeitnow.com/*", "https://www.themuse.com/*", "https://data.usajobs.gov/*", "https://extensionpay.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Job Resume Online - AI Autofill", "default_popup": "popup/popup.html"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "background.js"}, "commands": {"autofill": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Autofill current job application"}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}]}