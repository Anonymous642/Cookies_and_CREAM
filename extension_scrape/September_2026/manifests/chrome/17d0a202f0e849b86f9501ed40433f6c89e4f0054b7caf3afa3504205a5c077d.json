{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipboard / Snippet Manager", "version": "1.0.0", "description": "A powerful clipboard + snippet manager with categories, search, and one-click insertion.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/16.png", "32": "assets/icons/32.png", "128": "assets/icons/128.png"}}, "background": {"service_worker": "background/background.js"}, "commands": {"open_command_palette": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open the snippet command palette"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/insert.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["command_palette/palette.css"], "matches": ["<all_urls>"]}]}