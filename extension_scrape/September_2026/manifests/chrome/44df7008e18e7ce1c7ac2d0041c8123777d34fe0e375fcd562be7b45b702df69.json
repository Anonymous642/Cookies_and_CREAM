{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube PiP Pop Out", "version": "1.0.1", "description": "Open multiple YouTube videos in floating popup windows. Full player controls, any size \u2014 the PiP upgrade you actually wanted.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "YouTube PiP Pop Out", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["activeTab", "notifications", "windows", "scripting", "tabCapture", "storage"], "host_permissions": ["*://*.youtube.com/*"], "commands": {"open-stretched-player": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open current YouTube video as popout"}}, "web_accessible_resources": [{"resources": ["player.html"], "matches": ["*://*.youtube.com/*"]}]}