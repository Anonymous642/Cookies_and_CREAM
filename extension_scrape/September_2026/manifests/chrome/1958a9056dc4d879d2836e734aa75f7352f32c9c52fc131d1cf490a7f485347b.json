{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CareerDoc", "version": "1.0.0", "description": "Capture, sync, and autofill job applications \u2014 powered by CareerDoc", "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"], "host_permissions": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*", "https://www.indeed.com/*", "https://indeed.com/*", "https://*.greenhouse.io/*", "https://*.myworkdayjobs.com/*", "https://jobs.lever.co/*", "https://*.lever.co/*", "https://jobs.ashbyhq.com/*", "https://*.ashbyhq.com/*", "https://careers.smartrecruiters.com/*", "https://*.smartrecruiters.com/*", "https://*.hrpartner.io/*", "*://*/jobs/*", "http://localhost:8000/*", "https://careerdoc.app/*"], "content_scripts": [{"matches": ["http://localhost:8000/*", "https://careerdoc.app/*"], "js": ["web-bridge.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "CareerDoc", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["selectors.json"], "matches": ["<all_urls>"]}]}