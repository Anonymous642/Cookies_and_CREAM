{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadFlow - Bionic Speed Reader Pro", "short_name": "ReadFlow", "version": "2.0.0", "description": "Read 2-3x faster: Bionic Reading, RSVP Speed Reader, Read Aloud, Reader Mode, focus tools, highlights and reading goals.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "ReadFlow \u2014 Speed Reader Pro"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/defaults.js", "shared/icons.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "exclude_matches": ["*://mail.google.com/*", "*://docs.google.com/*"]}], "web_accessible_resources": [{"resources": ["content/ui.css"], "matches": ["http://*/*", "https://*/*"]}], "options_page": "options/options.html", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "commands": {"toggle-bionic": {"suggested_key": {"default": "Alt+B", "mac": "MacCtrl+B"}, "description": "Toggle Bionic Reading"}, "toggle-reader": {"suggested_key": {"default": "Alt+R", "mac": "MacCtrl+R"}, "description": "Toggle Reader Mode"}, "start-rsvp": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+S"}, "description": "Start RSVP Speed Reader (uses selection if any)"}, "toggle-tts": {"suggested_key": {"default": "Alt+A", "mac": "MacCtrl+A"}, "description": "Read page aloud / stop"}, "toggle-progress": {"description": "Toggle Reading Progress Bar"}, "toggle-linefocus": {"description": "Toggle Line Focus"}, "toggle-darkmode": {"description": "Toggle Dark Mode"}, "toggle-autoscroll": {"description": "Toggle Auto-Scroll"}}}