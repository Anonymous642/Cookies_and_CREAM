{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TalentBrief", "description": "Import LinkedIn candidates into TalentBrief with one click", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["cookies", "tabs", "storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://www.talentbrief.io/*", "https://talentbrief.io/*", "https://dev.talentbrief.io/*"], "externally_connectable": {"matches": ["https://*.talentbrief.io/*", "https://talentbrief.io/*"]}, "web_accessible_resources": [{"resources": ["icon/talentbrief.png", "icon/talentbrief-dark.png"], "matches": ["https://www.linkedin.com/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["https://www.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "TalentBrief", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content-scripts/content.js"]}]}