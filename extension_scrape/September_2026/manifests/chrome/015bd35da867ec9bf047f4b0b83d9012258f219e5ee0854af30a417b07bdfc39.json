{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReadThis - Text to Speech Reader", "short_name": "ReadThis", "version": "3.4.1", "description": "Read any webpage aloud, now with natural voices that run on your device. Skip citations, highlighting, focus mode & shortcuts.", "author": "Alzayat Saleh", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "ReadThis - Click to read this page"}, "permissions": ["activeTab", "storage", "contextMenus", "scripting", "offscreen"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "include_globs": ["*.pdf", "*.pdf?*", "*.pdf#*"], "js": ["src/modules/pdf.worker.min.js", "src/modules/pdf.min.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/player.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "commands": {"toggle-reading": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Start/Stop reading the page"}, "read-selection": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Read selected text"}}}