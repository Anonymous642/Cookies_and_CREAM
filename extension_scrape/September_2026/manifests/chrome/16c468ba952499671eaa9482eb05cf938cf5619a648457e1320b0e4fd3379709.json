{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PrivyExtract", "version": "0.5.1", "description": "Local, private AI extraction and summaries powered by Chrome Built-in AI, Ollama, and LM Studio.", "action": {"default_title": "PrivyExtract"}, "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"], "host_permissions": ["http://127.0.0.1:11434/*", "http://localhost:11434/*", "http://127.0.0.1:1234/*", "http://localhost:1234/*"], "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "js/service_worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/panel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; frame-src 'none'; base-uri 'none'; form-action 'none'"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"summarize-page": {"suggested_key": {"default": "Alt+S"}, "description": "Summarize current page with PrivyExtract"}, "summarize-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Summarize selected text with PrivyExtract"}}}