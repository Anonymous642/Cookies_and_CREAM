{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sourcely Connect", "version": "1.0.7", "homepage_url": "https://getsourcely.app/", "description": "Copy your Poshmark or Mercari session for Sourcely Post/Delist \u2014 no DevTools.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["cookies", "activeTab", "clipboardWrite", "storage", "webRequest", "scripting"], "host_permissions": ["https://poshmark.com/*", "https://www.poshmark.com/*", "https://www.mercari.com/*", "https://mercari.com/*", "https://*.mercari.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Sourcely Connect", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "externally_connectable": {"matches": ["https://getsourcely.app/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://getsourcely.app/*"], "js": ["safeChrome.js", "sourcelyPageBridge.js"], "run_at": "document_idle"}]}