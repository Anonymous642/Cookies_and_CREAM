{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Zendesk Talk Custom Ringtone", "version": "3.0.2", "manifest_version": 3, "description": "An extension to set a custom ringtone and webhook notifications for Zendesk Talk calls.", "permissions": ["scripting", "tabs", "storage", "offscreen"], "host_permissions": ["https://*.zendesk.com/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["ringtone.wav", "offscreen.html", "offscreen.js"], "matches": ["https://*.zendesk.com/*"]}], "content_scripts": [{"matches": ["https://*.zendesk.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}