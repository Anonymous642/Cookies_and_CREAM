{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whatsapp Translator", "version": "1.0.0", "description": "Translate WhatsApp Web messages in real time with bilingual chat view, 100+ language support, and private smooth translation.", "icons": {"16": "icons/icons16.png", "32": "icons/icons32.png", "48": "icons/icons48.png", "128": "icons/icons128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Whatsapp Translator - Immersive Translation", "default_popup": "popup.html", "default_icon": {"16": "icons/icons16.png", "32": "icons/icons32.png", "48": "icons/icons48.png", "128": "icons/icons128.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["languages.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}