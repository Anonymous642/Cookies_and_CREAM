{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VocabAI", "version": "1.3.1", "description": "AI-powered vocabulary learning from YouTube with smart detection, definitions, and bilingual support (English & Spanish)", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none';"}, "author": "VocabAI Team", "homepage_url": "https://github.com/gbossoption/vocabai-extension", "permissions": ["activeTab", "storage", "downloads"], "host_permissions": ["https://www.youtube.com/*", "https://api.dictionaryapi.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "action": {"default_popup": "popup.html", "default_title": "VocabAI"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["common_words.json", "idioms_db.json", "common_words_spanish.json", "idioms_db_spanish.json"], "matches": ["https://www.youtube.com/*"]}]}