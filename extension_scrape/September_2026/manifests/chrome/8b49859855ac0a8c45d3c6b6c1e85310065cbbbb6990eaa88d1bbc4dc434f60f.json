{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subtitle Auto-Translator for YouTube", "short_name": "Subtitle Translator", "version": "2.9.3", "description": "Bulk auto-translate YouTube subtitles to 230+ languages in 1 click. Multi-video queue, ~0.4s per language. Free.", "author": "Lab Tools", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "webRequest"], "host_permissions": ["https://studio.youtube.com/*", "https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://studio.youtube.com/*"], "js": ["injected.js", "click-simulator.js"], "world": "MAIN", "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["languages.json"], "matches": ["https://studio.youtube.com/*"]}], "action": {"default_title": "Subtitle Translator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}