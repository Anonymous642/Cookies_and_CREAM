{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager E+", "version": "1.0.0", "description": "\u5c08\u70ba\u89e3\u6c7a\u5206\u9801\u66ab\u5b58\u904e\u591a\u3001\u96e3\u4ee5\u7ba1\u7406\u800c\u8a2d\u8a08\u7684\u700f\u89bd\u5668\u64f4\u5145\u529f\u80fd\uff0c\u5354\u52a9\u6709\u6548\u4fdd\u5b58\u3001\u5206\u985e\u3001\u6aa2\u7d22\u8207\u7d71\u8a08\u5206\u9801\u8cc7\u8a0a\u3002", "permissions": ["tabs", "storage", "unlimitedStorage", "notifications", "windows"], "action": {"default_popup": "src/popup.html", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "assets/background.js", "type": "module"}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "src/*"], "matches": ["<all_urls>"]}], "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "\u5132\u5b58\u6240\u6709\u5206\u9801"}, "open-tab-list": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "\u958b\u555f\u5206\u9801\u5217\u8868"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}