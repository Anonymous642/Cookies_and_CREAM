{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Claude Assistant Tools", "short_name": "AI Tools", "version": "0.3.0", "description": "AI chat, prompt library, writing assistant, and page actions. Works with Claude, GPT, Grok, and 200+ OpenRouter models.", "minimum_chrome_version": "114", "author": "Claude Assistant Tools", "homepage_url": "https://extenzyhq.com/", "permissions": ["storage", "scripting", "activeTab", "tabs", "contextMenus", "notifications", "sidePanel", "alarms", "cookies"], "host_permissions": ["*://claude.ai/*", "*://www.youtube.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.x.ai/*", "https://openrouter.ai/*", "https://extenzyhq.com/*"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Claude Assistant Tools", "default_icon": {"16": "icons/16.png", "48": "icons/48.png"}}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["*://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://www.youtube.com/*"], "js": ["youtube-summary.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content-overlay.js", "writing-assistant.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Claude Assistant Tools"}, "ct-writing-assistant": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open the writing assistant on the focused text field"}}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["*://claude.ai/*", "<all_urls>"]}]}