{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hearald \u2014 Read Aloud for Pages & PDFs", "version": "0.4.6", "description": "Read web pages, PDFs and Google Docs aloud with natural voices on your device. Word-by-word highlighting. Free, private, offline.", "permissions": ["storage", "scripting", "activeTab", "offscreen", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Hearald \u2014 read this page", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"toggle-reader": {"suggested_key": {"default": "Alt+R"}, "description": "Open or close Hearald"}}, "web_accessible_resources": [{"resources": ["vendor/*", "icons/*", "pdf.html", "doc.html"], "matches": ["<all_urls>"]}]}