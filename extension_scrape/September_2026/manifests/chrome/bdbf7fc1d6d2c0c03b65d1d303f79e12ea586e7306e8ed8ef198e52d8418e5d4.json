{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ZenNotification", "description": "Never miss an important Zendesk update again.", "version": "1.0.0.6", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "24": "images/icon24.png", "32": "images/icon32.png"}}, "permissions": ["scripting", "storage", "notifications", "tabs"], "host_permissions": ["https://*.zendesk.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["alert.wav"], "matches": ["https://*.zendesk.com/*"]}]}