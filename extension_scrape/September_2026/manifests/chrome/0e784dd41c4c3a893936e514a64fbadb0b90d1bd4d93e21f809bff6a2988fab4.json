{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video PiP Overlay", "version": "0.1.0", "description": "Pop the playing tab video into a compact Picture-in-Picture window above other apps.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Video PiP Overlay (Alt+P)", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "commands": {"toggle-pip": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Enter or exit Picture-in-Picture for the playing video"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}