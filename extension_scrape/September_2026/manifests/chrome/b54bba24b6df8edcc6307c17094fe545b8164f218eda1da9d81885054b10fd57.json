{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClavisPass", "description": "Secure password manager extension for ClavisPass.", "version": "0.1.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ClavisPass", "default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"service_worker": "background/index.js", "type": "module"}, "permissions": ["storage", "tabs", "scripting", "nativeMessaging", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "fill-first-match": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Fill the first matching ClavisPass login"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/index.js"], "run_at": "document_idle", "all_frames": true}]}