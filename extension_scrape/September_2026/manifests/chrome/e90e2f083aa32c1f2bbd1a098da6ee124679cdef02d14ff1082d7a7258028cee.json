{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hubflo", "description": "Access your Hubflo data from anywhere with a convenient sidebar", "version": "1.9.2", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "default_title": "Open Hubflo"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["sidePanel", "storage", "contextMenus", "scripting"], "host_permissions": ["https://app.hubflo.com/*", "https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-scripts/gmail.js"], "css": ["content-scripts/gmail.css"], "run_at": "document_idle"}]}