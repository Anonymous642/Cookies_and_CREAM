{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlightCheck \u2013 Dein pers\u00f6nlicher Flugvergleich", "version": "1.0.1", "description": "Bewertet Fl\u00fcge auf Google Flights nach deinen W\u00fcnschen und zeigt gesch\u00e4tzte Gesamtkosten. Alles lokal, ohne Server.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.google.com/travel/*", "https://www.google.ch/travel/*", "https://www.google.de/travel/*", "https://www.google.at/travel/*", "https://www.google.fr/travel/*", "https://www.google.it/travel/*", "https://www.google.co.uk/travel/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "FlightCheck"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["https://www.google.com/travel/*", "https://www.google.ch/travel/*", "https://www.google.de/travel/*", "https://www.google.at/travel/*", "https://www.google.fr/travel/*", "https://www.google.it/travel/*", "https://www.google.co.uk/travel/*"], "js": ["shared/constants.js", "shared/time-utils.js", "shared/currency-utils.js", "shared/pricing.js", "shared/scoring.js", "shared/storage.js", "content/flight-parser.js", "content/flight-analyzer.js", "content/content-script.js"], "css": ["content/content-styles.css"], "run_at": "document_idle"}]}