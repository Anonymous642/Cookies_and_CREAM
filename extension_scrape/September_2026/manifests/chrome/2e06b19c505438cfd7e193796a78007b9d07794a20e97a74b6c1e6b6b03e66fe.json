{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapSelect", "version": "1.0", "description": "Capture multiple screenshots of a specific area on a webpage efficiently", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "SnapSelect"}, "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "web_accessible_resources": [{"resources": ["panel.html", "panel.js", "panel.css", "images/*"], "matches": ["<all_urls>"]}], "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Take a screenshot of the selected area"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle the SnapSelect panel"}}}