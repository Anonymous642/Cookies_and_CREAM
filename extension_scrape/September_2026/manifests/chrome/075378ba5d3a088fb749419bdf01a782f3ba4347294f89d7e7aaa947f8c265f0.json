{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speakerly: Read Aloud & Vocabulary Builder", "description": "Read webpages aloud with text to speech, translate and save words, then practice them with pronunciation and speaking drills.", "version": "3.1.9", "short_name": "Speakerly", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://getpronounce.com/", "action": {"default_title": "Speakerly", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "web_accessible_resources": [{"resources": ["panel-icon.png", "logo-flat.png", "images/voices/*.webp"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}], "permissions": ["tabs", "storage", "contextMenus", "scripting", "offscreen"], "commands": {"translate_selection": {"suggested_key": {"default": "Alt+T"}, "description": "Translate selection"}, "add_selection_to_words": {"suggested_key": {"default": "Alt+W"}, "description": "Add selection to Words"}, "read_selection": {"suggested_key": {"default": "Alt+R"}, "description": "Read selection aloud"}}, "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://app.getpronounce.com/*"]}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}