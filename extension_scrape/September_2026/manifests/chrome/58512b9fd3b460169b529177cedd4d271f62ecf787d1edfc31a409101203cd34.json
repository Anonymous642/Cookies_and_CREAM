{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URLScrub", "version": "1.2", "description": "Automatically removes tracking parameters, skips redirectors, and shields your privacy.", "permissions": ["storage", "tabs", "clipboardWrite", "scripting", "notifications", "contextMenus", "webNavigation", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "commands": {"copy_cleaned": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy cleaned link to clipboard"}, "bulk_clean": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Bulk clean links on page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}