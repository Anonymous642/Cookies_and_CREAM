{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Superhuman Docs Browser Extension", "short_name": "SH Docs", "description": "Superhuman Docs for Chrome: open one tab per doc and bookmark any web page to a Superhuman Docs table.", "version": "4.0.0", "icons": {"16": "assets/icon-128.png", "128": "assets/icon-128.png", "256": "assets/icon.png"}, "background": {"service_worker": "js/service_worker.js", "type": "module"}, "action": {"default_icon": "assets/icon.png", "default_title": "View your docs", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.coda.io/*", "https://docs.superhuman.com/*"], "js": ["js/content_script.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["cookies", "notifications", "scripting", "storage", "tabs", "webNavigation", "declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "host_permissions": ["*://*.coda.io/", "*://coda.io/", "*://docs.superhuman.com/"], "optional_host_permissions": ["*://docs.pp-sh.io/"]}