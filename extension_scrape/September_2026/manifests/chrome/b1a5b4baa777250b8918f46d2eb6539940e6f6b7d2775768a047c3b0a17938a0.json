{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZumiLabs OmniCapt: Full Page Screenshot & Recorder", "version": "4.5", "description": "Full page screenshot tool and screen recorder. Annotate, crop, and batch-capture a whole sitemap or open tabs. 100% local & private.", "homepage_url": "https://zumilabs.com/tools/omnicapt", "permissions": ["activeTab", "tabs", "tabGroups", "debugger", "scripting", "storage", "tabCapture", "offscreen", "downloads", "notifications", "clipboardWrite", "clipboardRead", "contextMenus"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ZumiLabs OmniCapt", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Open Recorder Popup"}, "stop-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Stop Recording and Save"}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause / Resume Recording"}, "annotate": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Open annotation toolbar on current page"}, "mute-mic": {"description": "Mute / Unmute Microphone"}, "mute-tab": {"description": "Mute / Unmute Tab Audio"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}