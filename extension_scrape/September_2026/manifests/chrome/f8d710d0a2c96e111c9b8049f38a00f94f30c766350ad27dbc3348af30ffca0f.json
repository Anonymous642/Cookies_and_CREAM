{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LoadOut: Project Workspaces, Tab Sessions & New Tab", "short_name": "LoadOut", "description": "Your projects, ready to work: a new tab with modes, one-click workspaces and one next step per project.", "homepage_url": "https://loadout.page", "version": "0.2.0", "permissions": ["storage", "tabs", "tabGroups", "contextMenus", "favicon", "idle", "alarms"], "optional_permissions": ["bookmarks", "history", "sessions"], "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "LoadOut", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "src/options/index.html", "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "capture-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save page to active project"}, "go-to-command-center": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Back to LoadOut (the project home tab)"}}, "omnibox": {"keyword": "lo"}}