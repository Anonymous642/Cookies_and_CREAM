{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WillItWiFi \u2014 Flight Wi-Fi badge", "description": "In-flight Wi-Fi probability inline on Google Flights. Click any flight for ratings, confidence, and reasoning on willitwifi.com.", "version": "0.1.0", "short_name": "WillItWiFi", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://www.google.com/travel/flights/*", "https://flights.google.com/*", "https://www.willitwifi.com/*"], "action": {"default_title": "WillItWiFi", "default_popup": "popup.html"}, "homepage_url": "https://www.willitwifi.com", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://flights.google.com/*", "https://www.google.com/travel/flights/*"], "run_at": "document_idle", "js": ["content-scripts/booking-sites.js"]}]}