{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Task Trail", "version": "1.0.0", "description": "Save websites with context, grouped by goals. Work on multiple topics, stop anytime, come back and remember everything.", "author": "Task Trail", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_title": "Task Trail - Open Goals"}, "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["storage", "activeTab", "tabs"], "commands": {"quick-save": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Quick save current page to selected goal"}, "save-with-note": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Save current page with a note"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "web_accessible_resources": []}