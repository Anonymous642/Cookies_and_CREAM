{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EchoLog AI Voice Assistant", "version": "0.9.4", "description": "EchoLog AI Voice Assistant: Improve web accessibility with voice commands for hands-free browsing and a better user experience.", "icons": {"48": "assets/EchoLog-Logo.png", "128": "assets/EchoLog-Logo.png"}, "permissions": ["storage", "tabs", "tts", "scripting"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.bundle.js"}, "action": {"default_title": "Toggle Wake Word On/Off", "browser_style": true, "default_icon": "assets/EchoLog-Logo.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["app.bundle.js"], "match_about_blank": true, "match_origin_as_fallback": true, "all_frames": true}], "web_accessible_resources": [{"resources": ["audio/click.ogg", "audio/detector.ts", "onboarding/onboard.html", "models/*", "*.wasm"], "matches": ["*://*/*"]}], "options_page": "onboarding/onboard.html", "commands": {"toggle-feature": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "On/Off the extension"}, "trigger_voice_assistant": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Trigger voice assistant manually"}, "stop_speaking": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Stop the speech mid-way"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; font-src 'self' data:;"}, "author": "EchoLog Team", "homepage_url": "https://echologai.github.io"}