{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabStash \u2014 Session Saver & Auto-Backup", "version": "0.2.1", "description": "Save, back up & restore tab sessions. Auto local backups, search, 1-click restore + optional cross-device cloud sync.", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_popup": "index.html", "default_title": "TabStash", "default_icon": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png"}}, "options_page": "options.html", "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms", "contextMenus"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open TabStash"}, "save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Stash all tabs in the current window"}}}