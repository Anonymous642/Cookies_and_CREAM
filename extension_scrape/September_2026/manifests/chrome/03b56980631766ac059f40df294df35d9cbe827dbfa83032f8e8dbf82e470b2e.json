{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Flow Sticky Notes", "version": "1.0.0", "description": "Add sticky notes to Salesforce Flow Builder to document sections of your flow.", "permissions": ["tabs", "cookies"], "host_permissions": ["https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.force.com/*"], "background": {"service_worker": "background/service-worker.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Flow Sticky Notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://*.salesforce.com/builder_platform_entity/flowBuilder.app*", "https://*.lightning.force.com/builder_platform_entity/flowBuilder.app*", "https://*.force.com/builder_platform_entity/flowBuilder.app*", "https://*.salesforce.com/builder_platform_entity/*", "https://*.lightning.force.com/builder_platform_entity/*", "https://*.salesforce.com/builder_platform_interaction/flowBuilder.app*", "https://*.lightning.force.com/builder_platform_interaction/flowBuilder.app*", "https://*.force.com/builder_platform_interaction/flowBuilder.app*", "https://*.trailblaze.lightning.force.com/builder_platform_interaction/*"], "js": ["content/content-script.js"], "css": ["styles/sticky-notes.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "styles/sticky-notes.css"], "matches": ["https://*.salesforce.com/*", "https://*.lightning.force.com/*", "https://*.force.com/*"]}]}