{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Pause/Resume for YouTube", "description": "Switch away \u2192 auto-pause YouTube. Come back \u2192 auto-resume (only if it was playing). Handles watch/shorts/embeds.", "version": "1.0.0", "permissions": ["tabs", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Auto Pause/Resume for YouTube", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["*://*.youtube.com/*"], "options_page": "options.html", "commands": {"toggle-extension-enabled": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Auto Pause/Resume"}}}