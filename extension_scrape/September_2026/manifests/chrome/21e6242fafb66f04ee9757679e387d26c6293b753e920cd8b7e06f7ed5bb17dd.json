{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JustScreengrab - 100% Free Full Page Screenshot Tool", "version": "1.6", "description": "Free full page screenshot tool. Capture, crop, blur private info, annotate, export to PNG, JPEG or PDF. No account, no watermark.", "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage", "clipboardWrite", "downloads"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Screenshot visible tab"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Select area and screenshot"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Full page screenshot"}, "open-onpage-editor": {"description": "Open on-page editor"}}}