{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFindr", "version": "0.9.3", "description": "A visual way to see, search and manage all your open tabs.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open TabFindr"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms"], "optional_permissions": ["tabGroups"], "optional_host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open or focus the TabFindr dashboard"}}, "minimum_chrome_version": "116"}