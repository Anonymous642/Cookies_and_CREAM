{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skyp", "version": "1.3.1", "description": "Export your LinkedIn connections, engagement, and Sales Navigator leads, then run email and LinkedIn campaigns with Skyp.", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "cookies"], "host_permissions": ["https://www.linkedin.com/*", "https://*.skyp.ai/*"], "action": {"default_popup": "popup.html", "default_title": "Skyp", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/mynetwork/invite-connect/connections/*", "https://www.linkedin.com/feed/*", "https://www.linkedin.com/posts/*", "https://www.linkedin.com/in/*/recent-activity/*", "https://www.linkedin.com/sales/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}