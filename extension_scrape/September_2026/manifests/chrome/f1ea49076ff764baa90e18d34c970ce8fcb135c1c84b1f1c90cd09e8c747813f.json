{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon.de Invoice Downloader", "version": "1.5.3", "description": "Download all your Amazon.de invoice PDFs for a chosen date range. Organizes by year and month.", "permissions": ["downloads", "storage", "tabs", "scripting", "activeTab"], "host_permissions": ["https://www.amazon.de/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Amazon.de Invoice Downloader", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.de/cpe/yourpayments/transactions*", "https://www.amazon.de/-/en/cpe/yourpayments/transactions*", "https://www.amazon.de/-/de/cpe/yourpayments/transactions*"], "js": ["content_amazon.js"], "run_at": "document_idle"}]}