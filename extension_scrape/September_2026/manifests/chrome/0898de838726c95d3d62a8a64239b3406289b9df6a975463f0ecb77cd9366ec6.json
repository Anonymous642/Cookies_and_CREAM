{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Figmaster", "short_name": "Figmaster", "version": "1.0.0", "description": "Capture any element or full page on the web and paste it into Figma as editable layers.", "author": "Figmaster", "permissions": ["activeTab", "scripting", "clipboardWrite", "offscreen", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Figmaster \u2014 capture for Figma", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open Figmaster"}, "pick-element": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Pick element and capture"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture the full page"}}, "web_accessible_resources": [{"resources": ["content/picker.css", "resources/figmaster-logo.png", "resources/fonts/OpenRunde-Regular.woff2", "resources/fonts/OpenRunde-Medium.woff2", "resources/fonts/OpenRunde-Semibold.woff2", "resources/fonts/OpenRunde-Bold.woff2"], "matches": ["<all_urls>"]}]}