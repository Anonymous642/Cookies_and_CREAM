{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tarchive - Group, Save, Reopen Tabs", "description": "Save, restore, and manage tab sessions to keep your workspace organized and clutter-free.", "version": "2.0.6", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "externally_connectable": {"matches": ["http://localhost:5173/*", "https://tarchive.stackbits.in/*", "http://tarchive.stackbits.in/*"]}, "action": {"default_popup": "popup.html", "default_icon": "icon/logo.png", "default_title": "Tarchive"}, "host_permissions": ["http://*/*", "https://*/*"], "permissions": ["tabs", "tabGroups", "sessions", "bookmarks", "storage"], "commands": {"addTabs": {"suggested_key": {"default": "Shift+Alt+A", "mac": "Shift+Alt+A"}, "description": "Add current tabs to bucket"}, "viewBuckets": {"suggested_key": {"default": "Shift+Alt+V", "mac": "Shift+Alt+V"}, "description": "View Buckets"}}, "background": {"service_worker": "background.js"}}