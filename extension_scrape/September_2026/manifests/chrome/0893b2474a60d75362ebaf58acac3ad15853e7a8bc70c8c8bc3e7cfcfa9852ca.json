{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gmail Receipt Tracker \u2014 Expenses & Invoices", "description": "Save Gmail receipts to a private expense ledger. Free 15/month. Pro: unlimited, tax CSV, and Google Sheets.", "version": "0.1.0", "short_name": "ReceiptStash", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["https://mail.google.com/*", "https://api.polar.sh/*"], "action": {"default_title": "Open ReceiptStash"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail.js"]}]}