{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Posty for LinkedIn", "version": "1.0.0", "description": "Generate and publish LinkedIn posts with Posty from linkedin.com", "permissions": ["storage", "cookies", "tabs", "scripting"], "host_permissions": ["https://posty.cloud/*", "https://www.posty.cloud/*", "https://www.linkedin.com/*"], "web_accessible_resources": [{"resources": ["icons/posty-extension-logo.png"], "matches": ["https://www.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content/linkedin-ui.js", "content/linkedin.js"], "css": ["content/linkedin.css"], "run_at": "document_idle"}, {"matches": ["https://posty.cloud/*", "https://www.posty.cloud/*"], "js": ["content/posty-sync.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Posty \u2014 click to open", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "popup/popup.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}