{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simplify 4 Me \u2014 Reading Assistant", "short_name": "Simplify 4 Me", "version": "3.0.0", "description": "Make difficult webpages easier to read with instant simplification, Quick Read, focus tools, and private on-device processing.", "permissions": ["storage", "contextMenus"], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Simplify 4 Me", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/defaults.js", "shared/simplify_engine.js", "shared/simplify_enhancements.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"simplify-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Simplify selected text"}, "quick-read": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open Quick Read"}, "focus-mode": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle Focus Mode"}}}