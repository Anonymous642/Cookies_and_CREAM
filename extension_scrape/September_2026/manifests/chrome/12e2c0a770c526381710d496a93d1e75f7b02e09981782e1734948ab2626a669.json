{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Aircut", "version": "1.0.8", "manifest_version": 3, "description": "Cuts autoplay, background waste, and digital noise - while keeping the content you actually want.", "permissions": ["storage", "scripting", "alarms", "tabs", "activeTab", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16_on.png", "32": "icons/icon32_on.png", "48": "icons/icon48_on.png", "128": "icons/icon128_on.png"}}, "icons": {"16": "icons/icon16_on.png", "32": "icons/icon32_on.png", "48": "icons/icon48_on.png", "128": "icons/icon128_on.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["<all_urls>"]}]}