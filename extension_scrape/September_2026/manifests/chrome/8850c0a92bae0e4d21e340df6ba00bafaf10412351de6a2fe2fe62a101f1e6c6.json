{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobLens \u2014 LinkedIn Truth Overlay", "version": "1.0.0", "description": "A 0\u2013100 score on every LinkedIn job: real comp, layoff history, posting age, competition, hiring intent. 100% on-device.", "author": "JobLens", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "JobLens", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "tabs"], "host_permissions": ["https://www.linkedin.com/*"], "web_accessible_resources": [{"resources": ["data/layoffs.json", "data/comp.json", "icons/*"], "matches": ["https://www.linkedin.com/*"]}]}