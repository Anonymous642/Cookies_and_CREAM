{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dropnito Scanner", "version": "0.64.0", "description": "Dropnito-Assistent: Amazon-Produkte finden und senden; auf eBay ASIN einblenden, Aufschlag, Festbetrag und Bestand \u00e4ndern.", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.amazon.de/*", "https://dropnito.de/*"], "action": {"default_title": "Dropnito Scanner", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.de/dp/*", "https://www.amazon.de/*/dp/*", "https://www.amazon.de/gp/product/*"], "js": ["visibility.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.amazon.de/*"], "exclude_matches": ["https://www.amazon.de/gp/css/*", "https://www.amazon.de/ap/*", "https://www.amazon.de/gp/buy/*", "https://www.amazon.de/cpe/*", "https://www.amazon.de/checkout/*"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}, {"matches": ["https://www.ebay.de/sh/ord*", "https://www.ebay.de/sh/lst/*", "https://www.ebay.de/cnt/*", "https://www.ebay.de/itm/*"], "js": ["ebay-orders.js"], "css": ["ebay-orders.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}