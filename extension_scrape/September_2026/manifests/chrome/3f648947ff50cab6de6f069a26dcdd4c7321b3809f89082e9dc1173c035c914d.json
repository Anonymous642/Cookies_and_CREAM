{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GapCap \u2013 Studio Collector", "version": "0.3.8", "description": "Sammelt Thumbnail-Impressionen + CTR aus YouTube Studio und Podcast-Kennzahlen aus Spotify for Creators und sendet sie an GapCap.", "permissions": ["storage", "alarms"], "host_permissions": ["https://studio.youtube.com/*", "https://creators.spotify.com/*", "https://gapcap.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}, {"matches": ["https://creators.spotify.com/*"], "js": ["spotify-content-script.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-script.js"], "matches": ["https://studio.youtube.com/*"]}, {"resources": ["spotify-page-script.js"], "matches": ["https://creators.spotify.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}