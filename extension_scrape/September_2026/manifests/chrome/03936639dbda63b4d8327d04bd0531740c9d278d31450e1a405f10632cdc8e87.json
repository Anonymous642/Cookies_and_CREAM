{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spoiler Shield for YouTube", "version": "1.0.0", "description": "Blurs YouTube thumbnails and titles that mention shows, movies, or terms you're avoiding spoilers for.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}