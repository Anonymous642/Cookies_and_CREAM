{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ping", "version": "1.2.5", "description": "Send personalized bulk emails from CSV/Google Sheets and track opens, clicks, and replies in Gmail.", "homepage_url": "https://getping.dev", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["identity", "storage", "activeTab", "tabs", "alarms"], "host_permissions": ["https://mail.google.com/*", "https://gmail.googleapis.com/*", "https://docs.google.com/*", "https://sheets.googleapis.com/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*", "https://api.getping.dev/*", "https://dev.getping.dev/*", "https://getping.dev/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Ping", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}