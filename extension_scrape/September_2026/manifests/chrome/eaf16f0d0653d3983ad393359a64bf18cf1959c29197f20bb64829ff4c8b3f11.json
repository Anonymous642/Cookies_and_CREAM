{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Retabtile", "version": "1.0.1", "description": "Retabtile - set the title of your browser tabs.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open Retabtile"}}}