{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrowseLatch: Website Rules", "version": "1.5.11", "description": "Choose which websites can open or be blocked with parent-protected settings.", "minimum_chrome_version": "102", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Manage BrowseLatch website rules"}, "options_page": "options.html", "declarative_net_request": {"rule_resources": [{"id": "deny_default", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["blocked.html", "styles.css", "blocked.js"], "matches": ["<all_urls>"]}]}