{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Warframe Wiki Redirect", "description": "This extension just redirects from the old Warframe Fandom Wiki to the new and maintained Official Warframe Wiki.", "version": "1.0", "manifest_version": 3, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://warframe.fandom.com/wiki/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect", "enabled": true, "path": "redirect.json"}]}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}