{"update_url": "https://clients2.google.com/service/update2/crx", "version": "3.0.2", "manifest_version": 3, "short_name": "Supercut", "name": "Supercut \u2013 Screen Recorder & Camera Capture", "description": "The fastest way to share your screen & camera to create professional-looking video for both internal and external communication", "minimum_chrome_version": "116", "homepage_url": "https://supercut.ai", "permissions": ["offscreen", "storage", "unlimitedStorage", "scripting", "tabs", "activeTab", "system.memory", "desktopCapture", "tabCapture"], "host_permissions": ["<all_urls>", "file:///"], "action": {"default_title": "Supercut", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"type": "module", "service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"0_toggle_tab": {"description": "Start or Stop Recording Tab", "suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+E"}}, "1_toggle_record": {"description": "Start or Stop Recording Display / Window", "suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+O"}}, "2_toggle_pause": {"description": "Pause / Resume Recording", "suggested_key": {"default": "Ctrl+Shift+P", "mac": "Alt+Shift+P"}}, "3_cancel_record": {"description": "Cancel Recording", "suggested_key": {"default": "Ctrl+Shift+C", "mac": "Alt+Shift+C"}}}, "content_scripts": [{"matches": ["https://supercut.ai/auth/extension/authorize*", "https://supercut.so/auth/extension/authorize*", "http://localhost:5173/auth/extension/authorize*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["popup.html", "settings.html", "install.html", "offscreen.html", "help.html", "tab-record.html", "camera.js", "camera.html", "chunks/*.js", "worker.js", "assets/*.css", "assets/*.html", "asset