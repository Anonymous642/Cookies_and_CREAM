{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Flowdex - Tab Switcher", "description": "Quickly find & switch open tabs & browser history with Flowdex. Enhance your Browse workflow with seamless navigation.", "version": "1.0", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["tabs", "activeTab", "windows", "history", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the extension popup"}}, "web_accessible_resources": [{"resources": ["libs/fuse.min.js"], "matches": ["<all_urls>"]}]}