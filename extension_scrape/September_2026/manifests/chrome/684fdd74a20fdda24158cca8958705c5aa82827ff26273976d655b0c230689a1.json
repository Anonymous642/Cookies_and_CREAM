{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "cURL to Py", "description": "DevTools panel: capture requests, convert cURL to Python/JS, copy cookies and headers, preview responses.", "version": "1.5.6", "minimum_chrome_version": "114", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "cURL to Py"}, "devtools_page": "devtools/devtools.html", "permissions": ["clipboardWrite", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["wasm/*.wasm", "converter.js", "convert-api.js"], "matches": ["<all_urls>"]}]}