{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusGuard", "version": "0.2.0", "description": "Helps manage online distractions and improve focus.", "permissions": ["storage", "tabs", "activeTab", "scripting", "notifications", "alarms"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["limitPage.html", "limitPage.js"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/focus-green16.png", "48": "images/focus-green48.png", "128": "images/focus-green128.png"}}, "icons": {"16": "images/focus-green16.png", "48": "images/focus-green48.png", "128": "images/focus-green128.png"}, "commands": {"toggle-focus-guard": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Toggle Focus Guard On/Off"}}}