{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Chat Hub", "version": "2.0.0", "description": "Quick-launch Google Chat in multiple formats. Includes notification badges, keyboard shortcuts, and session keepalive.", "permissions": ["tabs", "windows", "storage", "sidePanel", "notifications", "alarms", "contextMenus"], "host_permissions": ["https://chat.google.com/*"], "action": {"default_popup": "popup.html", "default_title": "Google Chat Hub", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.google.com/*"], "js": ["content/keepalive.js"], "run_at": "document_idle"}], "commands": {"launch-floating": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Google Chat in floating window"}, "launch-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open Google Chat in compact panel"}, "launch-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle Google Chat side panel"}, "launch-tab": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Open Google Chat in new tab"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "settings.html"}