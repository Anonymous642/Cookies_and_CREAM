{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatDock", "version": "0.2.0", "description": "Export AI conversations to Markdown, HTML, JSON, or plain text. Works on ChatGPT, Claude, and Gemini.", "permissions": ["activeTab", "clipboardWrite", "scripting"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["shared/formatter.js", "shared/exporter.js", "shared/html-exporter.js", "shared/text-exporter.js", "shared/json-exporter.js", "shared/widget.js", "content/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["shared/formatter.js", "shared/exporter.js", "shared/html-exporter.js", "shared/text-exporter.js", "shared/json-exporter.js", "shared/widget.js", "content/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["shared/formatter.js", "shared/exporter.js", "shared/html-exporter.js", "shared/text-exporter.js", "shared/json-exporter.js", "shared/widget.js", "content/gemini.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-widget": {"suggested_key": {"default": "Alt+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Open ChatDock export panel"}, "quick-copy": {"description": "Quick copy conversation as Markdown"}}}