{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BTC Denominator", "version": "2.0.0", "description": "Converts all currency amounts on any webpage to their Bitcoin equivalent at the current BTC price.", "icons": {"48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png", "256": "images/icon-256.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.coingecko.com/*", "https://api.coindesk.com/*", "https://api.coinbase.com/*", "https://mempool.space/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "images/icon-48.png", "96": "images/icon-96.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}