{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PeakSync Video Capture", "description": "Send a video you are watching to your PeakSync account for script generation.", "version": "0.2.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "contextMenus", "storage", "alarms", "tabCapture", "offscreen"], "optional_host_permissions": ["https://*/*"], "host_permissions": ["https://peaksync.net/*", "https://www.peaksync.net/*", "https://api.peaksync.net/*"], "externally_connectable": {"matches": ["https://peaksync.net/*", "https://*.peaksync.net/*"]}, "action": {"default_title": "PeakSync", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Send the current video to PeakSync"}}, "web_accessible_resources": [{"resources": ["handoff.html"], "matches": ["https://peaksync.net/*", "https://*.peaksync.net/*"]}], "background": {"service_worker": "background.js"}}