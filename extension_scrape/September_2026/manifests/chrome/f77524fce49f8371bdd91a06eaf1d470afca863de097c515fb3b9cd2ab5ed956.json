{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Free International Shipping Highlighter (FISH) for Amazon", "short_name": "FISH for Amazon", "version": "0.0.4.6", "description": "Highlights Amazon products with free international delivery. Additionally, you can hide products that do not offer free shipping.", "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "FISH", "default_popup": "popup.html"}, "options_page": "popup.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+O", "windows": "Alt+O", "mac": "Command+O", "chromeos": "Alt+O", "linux": "Alt+O"}}}, "background": {"service_worker": "background.min.js"}, "host_permissions": ["https://www.amazon.com/*", "https://*.amazon.com/*"], "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://*.amazon.com/*", "*://www.amazon.com/*"], "run_at": "document_idle", "match_about_blank": false, "all_frames": true, "js": ["content.min.js"], "css": ["content.css"]}]}