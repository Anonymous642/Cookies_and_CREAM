{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Phrase Flip", "version": "0.9.1", "description": "Flip sentences on the page into another language using on-device translation.", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "popup/options.html", "open_in_tab": false}, "background": {"service_worker": "background.js"}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png", "1024": "images/icon-1024.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png", "1024": "images/icon-1024.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://phraseflip.com/*", "*://www.phraseflip.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}