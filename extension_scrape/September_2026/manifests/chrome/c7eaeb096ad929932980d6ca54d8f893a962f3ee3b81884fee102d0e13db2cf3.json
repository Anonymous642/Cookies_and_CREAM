{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pixlift - Copy images from Google Docs", "version": "1.3.0", "description": "Pixlift pulls the original, full-resolution images out of a Google Doc and copies them to the clipboard as PNG, or downloads them.", "permissions": ["activeTab", "scripting", "clipboardWrite", "contextMenus"], "host_permissions": ["https://docs.google.com/*", "https://*.googleusercontent.com/*"], "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Pixlift - copy an image from this doc", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-images": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the image gallery for the current doc"}}}