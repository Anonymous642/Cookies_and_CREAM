{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleanPix", "version": "1.0.0", "description": "Turn Google Images into your free, high-quality image bank. No watermarks, no paywalls \u2014 just great photos.", "permissions": ["storage"], "host_permissions": ["https://www.google.com/*", "https://*.google.com/*"], "content_scripts": [{"matches": ["https://www.google.com/*", "https://*.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "CleanPix"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["welcome.html", "icon128.png"], "matches": ["<all_urls>"]}]}