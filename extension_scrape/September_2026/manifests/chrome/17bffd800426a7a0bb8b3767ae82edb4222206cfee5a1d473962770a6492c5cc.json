{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Youtube AI Helper", "version": "1.0.0", "manifest_version": 3, "description": "Helper tool to download video transcript, summarize content, chat with AI, search keywords in videos and put marker on progress bar.", "permissions": ["storage"], "host_permissions": ["https://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/watch*"], "js": ["aiUtil.js", "content.js", "util.js", "transcriptUtil.js", "markerUtil.js"]}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://*.youtube.com/*"]}], "action": {"default_icon": {"16": "assets/logo.png", "24": "assets/logo.png", "32": "assets/logo.png"}, "default_title": "Youtube AI Marker", "default_popup": "popup.html"}}