{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Trulith \u2013 AI Media Detector", "version": "3.1.0", "description": "Right-click any image or video to check if it's AI-generated using Trulith's detector.", "permissions": ["contextMenus", "activeTab", "storage", "sidePanel"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "app/index.html?panel=1"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Trulith \u2013 AI Media Detector"}, "icons": {"16": "asset-logos/trulith_logo_16.png", "32": "asset-logos/trulith_logo_32.png", "48": "asset-logos/trulith_logo_48.png", "128": "asset-logos/trulith_logo_128.png"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/twitter.js"], "css": ["content-scripts/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["content-scripts/instagram.js"], "css": ["content-scripts/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/youtube-shorts.js"], "css": ["content-scripts/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["asset-logos/*"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*"]}]}