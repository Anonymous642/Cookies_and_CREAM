{"manifest_version": 3, "name": "Gripe - Comment & Review Any Website, Webpage or User", "short_name": "Gripe Reviews", "version": "1.3.8", "author": "Gripe", "homepage_url": "https://trygripe.com", "description": "See what real people think, right on the page. Comment, review & react to any webpage or website. Works with Chrome, IE, and more.", "icons": {"16": "icons/icon_16_g.png", "48": "icons/icon_48_g.png", "128": "icons/icon_128_g.png"}, "action": {"default_icon": {"48": "icons/icon_48_g.png"}, "default_title": "No comments found"}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "host_permissions": ["https://trygripe.com/", "https://accounts.trygripe.com/"], "update_url": "https://clients2.google.com/service/update2/crx", "web_accessible_resources": [{"resources": ["icons/*.png", "images/*.png", "images/*.jpg", "images/*.svg", "css/*.css", "webfonts/*.woff2"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["css/override_hc.css"], "all_frames": false, "run_at": "document_end"}]}