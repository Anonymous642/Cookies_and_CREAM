{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reynard AI \u2014 Capture, Dictate & Lip Read", "version": "1.7.11", "description": "Capture chats from 16+ AI tools, dictate via Whisper, and lip-read on webcam (Pro). One workspace, every AI.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "notifications", "tabs", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://x.ai/*", "https://chat.deepseek.com/*", "https://www.midjourney.com/*", "https://suno.ai/*", "https://leonardo.ai/*", "https://runwayml.com/*", "https://app.heygen.com/*", "https://elevenlabs.io/*", "https://notion.so/*", "https://gamma.app/*", "https://poe.com/*", "https://huggingface.co/*", "https://reynardai.com/*", "https://www.reynardai.com/*", "https://app.reynardai.com/*", "https://reynard.ai/*", "https://www.reynard.ai/*", "https://*.lovableproject.com/*", "https://*.lovable.app/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://x.ai/*", "https://chat.deepseek.com/*", "https://www.midjourney.com/*", "https://suno.ai/*", "https://leonardo.ai/*", "https://runwayml.com/*", "https://app.heygen.com/*", "https://elevenlabs.io/*", "https://notion.so/*", "https://gamma.app/*", "https://poe.com/*", "https://huggingface.co/*"], "js": ["content-script.js", "voice-input.js", "lip-reading.js"], "css": ["content-style.css"], "run_at": "document_idle"}, {"matches": ["https://reynardai.com/*", "https://www.reynardai.com/*", "https://app.reynardai.com/*", "https://reynard.ai/*", "https://www.reynard.ai/*", "https://*.lovableproject.com/*", "https://*.lovable.app/*"], "js": ["session-sync.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"capture": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Quick-capture current tab to Reynard workspace"}, "dictate": {"suggested_key": {"default": "Alt+E", "mac": "Alt+E"}, "description": "Toggle Silent Dictate on supported AI tools"}, "lipread": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Toggle Silent Lip Read (Pro) on supported AI tools"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Open Reynard popup"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}