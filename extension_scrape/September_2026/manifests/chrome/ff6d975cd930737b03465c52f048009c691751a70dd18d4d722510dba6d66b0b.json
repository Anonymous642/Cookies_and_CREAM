{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TrustShield - Secure Browsing Assistant", "description": "Native-feeling browser trust layer for safe browsing actions.", "version": "1.0.1", "icons": {"16": "brand/trustshield-icon.png", "32": "brand/trustshield-icon.png", "48": "brand/trustshield-icon.png", "128": "brand/trustshield-icon.png"}, "action": {"default_title": "TrustShield", "default_popup": "popup.html", "default_icon": {"16": "brand/trustshield-icon.png", "32": "brand/trustshield-icon.png", "48": "brand/trustshield-icon.png", "128": "brand/trustshield-icon.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["blocked.html", "warning.html", "sandbox.html", "icons/*.png", "brand/*.png"], "matches": ["<all_urls>"]}]}