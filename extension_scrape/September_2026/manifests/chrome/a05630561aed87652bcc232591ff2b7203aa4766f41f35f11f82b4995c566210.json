{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gemini Export Pro \u2014 PDF & Word", "version": "1.2.3", "description": "Export Gemini chats to PDF or Word (.docx). Preserves tables, code, math and images.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://gemini.google.com/*", "https://aistudio.google.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Gemini Export Pro"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"], "js": ["lib/utils.js", "lib/dom.js", "lib/extractor.js", "lib/exporters.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"]}], "commands": {"export-conversation": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Export full Gemini conversation"}}}