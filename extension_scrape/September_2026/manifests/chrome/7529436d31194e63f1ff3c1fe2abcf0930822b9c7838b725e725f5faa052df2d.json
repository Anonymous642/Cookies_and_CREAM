{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ForgeGate", "description": "Explainable browsing and action control.", "version": "1.0.4", "manifest_version": 3, "action": {"default_title": "ForgeGate"}, "background": {"service_worker": "src/background.js"}, "permissions": ["tabs", "windows", "storage", "scripting", "webNavigation", "webRequest", "downloads"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["pages/drawer.html", "pages/drawer-redirect.js", "ui/*", "ui/_framework/*", "ui/_content/*/*", "ui/css/*", "ui/js/*"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}