{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Blurify children", "description": "Protect children by blocking search keywords and blurring sensitive images locally.", "version": "1.3.0", "manifest_version": 3, "permissions": ["storage", "alarms"], "host_permissions": ["http://*/*", "https://*/*", "https://blurify-backend-production.up.railway.app/*"], "background": {"service_worker": "dist/background.bundle.js"}, "options_page": "options.html", "action": {"default_title": "Blurify", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["google-guard.js"], "run_at": "document_start"}, {"matches": ["https://*/*", "http://*/*"], "js": ["dist/content.bundle.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["model/*", "blocked.html", "blocked.js", "dist/background.bundle.js", "dist/options.bundle.js"], "matches": ["https://*/*", "http://*/*"]}]}