{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Logically AI \u2014 Research Assistant", "description": "Chat about any page with citations from your library, the web and 200M+ papers. Reads the page you are on (text only).", "version": "2.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus", "alarms", "tabGroups"], "host_permissions": ["https://api.logically.app/*"], "optional_host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://logically.app/*"]}, "action": {"default_title": "Logically AI", "default_popup": "popup.html"}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+L"}, "description": "Open the Logically AI side panel"}, "save-page": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Add this page to your Logically library"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://logically.app/*"], "run_at": "document_idle", "js": ["content-scripts/bridge.js"]}]}