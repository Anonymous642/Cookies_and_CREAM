{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkMemo", "version": "0.1.1", "description": "Save and find links instantly. One keystroke from anywhere in Chrome.", "action": {"default_title": "Open LinkMemo (Alt+L)"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["sidePanel", "storage", "tabs", "activeTab", "contextMenus", "identity"], "host_permissions": ["https://linkmemo.app/*", "https://*.supabase.co/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+L", "mac": "Alt+L"}, "description": "Toggle the LinkMemo side panel"}, "save-current-tab": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Save the current tab to LinkMemo"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}