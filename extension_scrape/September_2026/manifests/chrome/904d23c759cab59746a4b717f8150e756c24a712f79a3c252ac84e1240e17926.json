{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Arxivio", "version": "1.0.0", "description": "Smart arXiv discovery, reading library, and research workstation.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["*://arxiv.org/*", "*://*.arxiv.org/*"], "commands": {"open-library": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Open Arxivio"}}, "action": {"default_title": "Open Arxivio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://arxiv.org/list/*", "*://arxiv.org/abs/*", "*://arxiv.org/find/*", "*://arxiv.org/search/*", "*://arxiv.org/archive/*", "*://*.arxiv.org/list/*", "*://*.arxiv.org/abs/*", "*://*.arxiv.org/find/*", "*://*.arxiv.org/search/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}