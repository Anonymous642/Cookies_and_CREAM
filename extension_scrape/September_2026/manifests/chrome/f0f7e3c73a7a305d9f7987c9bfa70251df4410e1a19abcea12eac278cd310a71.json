{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpsKey \u2014 Browser DevOps CLI", "short_name": "OpsKey", "description": "A keyboard-first command palette for DevOps, IT, and engineering workflows. Run URL, HTTP, and clipboard commands in Chrome.", "version": "0.1.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Open OpsKey palette"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the OpsKey command palette"}, "open-clipboard": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open OpsKey in clipboard history mode"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}}}, "permissions": ["storage", "tabs", "scripting", "activeTab", "clipboardRead"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}