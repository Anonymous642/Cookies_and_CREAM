{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ThinkMode+", "version": "1.0.2", "minimum_chrome_version": "111", "description": "Automatically enables extended thinking on ChatGPT. Set it once, never click the Think button again. Claude & Gemini coming soon.", "permissions": ["storage", "notifications", "tabs", "identity"], "host_permissions": ["https://chatgpt.com/*", "*://*.thinkmodeplus.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "settings/settings.html", "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content/chatgpt.js", "content/ui-injector.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["content/precision-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.thinkmodeplus.com/*"], "js": ["content/sync-auth.js"], "run_at": "document_start"}], "commands": {"toggle-all": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Toggle ThinkMode+ on/off for all platforms"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}