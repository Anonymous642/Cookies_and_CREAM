{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tidyfold: Folders & Search for ChatGPT", "description": "Organize ChatGPT chats into folders and subfolders. Local-first and private: no account, no cloud, no tracking.", "version": "0.1.0", "short_name": "Tidyfold", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "homepage_url": "https://tidyfold.github.io", "background": {"service_worker": "background.js"}, "action": {"default_title": "Tidyfold", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "run_at": "document_idle", "js": ["content-scripts/chatgpt.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/chatgpt.css"], "use_dynamic_url": true, "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}]}