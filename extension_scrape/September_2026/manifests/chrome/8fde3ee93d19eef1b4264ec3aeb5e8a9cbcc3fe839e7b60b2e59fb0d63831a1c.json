{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comment Exporter for TikTok", "version": "2.0.0", "description": "Export comments from TikTok videos to CSV or JSON formats effortlessly.", "permissions": ["storage", "webRequest", "scripting", "unlimitedStorage", "tabs"], "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "host_permissions": ["*://*.tiktok.com/*", "https://api2.amplitude.com/*", "https://api.eu.amplitude.com/*"], "background": {"service_worker": "src/background/index.js"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}}, "web_accessible_resources": [{"resources": ["src/injected/index.js", "src/injectedAlt/index.js"], "matches": ["*://*.tiktok.com/*"]}], "content_scripts": [{"js": ["src/content/watcher.js"], "matches": ["*://*.tiktok.com/*"], "run_at": "document_idle"}]}