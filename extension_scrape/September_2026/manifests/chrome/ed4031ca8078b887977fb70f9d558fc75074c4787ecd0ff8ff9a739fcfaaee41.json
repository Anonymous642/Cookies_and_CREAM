{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Teamenu", "version": "1.0.1", "description": "Access your personalized Teamenu - all your work apps, shared collections and links in one place. Requires a Teamenu subscription.", "homepage_url": "https://teamenu.net", "permissions": ["sidePanel", "storage", "contextMenus", "tabs", "omnibox", "tabGroups"], "host_permissions": ["https://*.teamenu.net/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Open Teamenu"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://*.teamenu.net/*"], "js": ["src/content/content.js"], "all_frames": true, "run_at": "document_start"}], "omnibox": {"keyword": "t"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Open Teamenu Side Panel"}}}