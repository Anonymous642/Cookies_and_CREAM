{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Growth Engine", "version": "1.2.11", "description": "Automatically track every post you see on X, unlock history, insights, and more.", "permissions": ["storage", "downloads", "unlimitedStorage", "alarms"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.xgrowthengine.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.xgrowthengine.com https://*.posthog.com"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/content.js"], "run_at": "document_start"}]}