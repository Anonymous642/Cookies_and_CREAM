{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StreamShield \u2013 Stream Ad Blocker", "short_name": "StreamShield", "version": "1.0.5", "description": "Watch Twitch and Kick ad-free with StreamShield. Automatic blocking, stream recovery, and whitelisting. Just install and enjoy!", "author": "StreamShield", "homepage_url": "https://www.stream-shield.tech/", "permissions": ["storage", "tabs", "contextMenus", "notifications", "declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "streamshield_ad_rules", "enabled": true, "path": "rules.json"}]}, "host_permissions": ["*://*.twitch.tv/*", "*://*.kick.com/*", "https://raw.githubusercontent.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "StreamShield \u2013 Stream Ad Blocker"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["inject.js", "watchdog.js"], "run_at": "document_start"}, {"matches": ["*://*.kick.com/*"], "js": ["kick-inject.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["injected/conflict-detector.js", "injected/vaft.js", "injected/vod-adblock.js", "injected/page-overlay.js", "icons/icon.svg"], "matches": ["*://*.twitch.tv/*"]}, {"resources": ["injected/kick-page.js"], "matches": ["*://*.kick.com/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open StreamShield"}}}