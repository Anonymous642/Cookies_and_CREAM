{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HaloTabs Pro", "version": "1.0", "description": "Save, organize and share tab workspaces while reducing memory usage.", "permissions": ["tabs", "storage", "alarms", "contextMenus", "windows", "notifications", "webNavigation", "scripting", "favicon", "declarativeNetRequest", "sidePanel", "offscreen", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "popup.html"}, "options_page": "options.html", "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_popup": "popup.html", "default_title": "HaloTabs Pro Beta", "default_icon": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}}, "web_accessible_resources": [{"resources": ["suspend.html", "suspend.js", "focus.html", "focus.js"], "matches": ["<all_urls>"]}], "commands": {"suspend-all": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend all inactive tabs (respects whitelist)"}, "force-suspend-current": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Command+Shift+F"}, "description": "Force suspend current tab (ignores whitelist)"}}}