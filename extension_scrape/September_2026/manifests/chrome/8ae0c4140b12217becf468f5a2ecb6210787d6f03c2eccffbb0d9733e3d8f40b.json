{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Detour", "version": "1.0.5", "description": "Replace distracting sites with your reading list. Build better browsing habits one article at a time.", "permissions": ["storage", "tabs", "bookmarks", "readingList", "alarms", "scripting"], "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "*://instagram.com/*", "*://www.instagram.com/*", "*://twitter.com/*", "*://www.twitter.com/*", "*://x.com/*", "*://facebook.com/*", "*://www.facebook.com/*", "*://reddit.com/*", "*://www.reddit.com/*", "*://tiktok.com/*", "*://www.tiktok.com/*"], "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*"], "exclude_matches": ["*://chrome.google.com/*", "*://chromewebstore.google.com/*"], "js": ["js/toast-system.js", "js/content.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://chrome.google.com/*", "*://chromewebstore.google.com/*"], "js": ["js/toast-system.js", "js/content-scroll-detector.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "options_page": "options.html", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "web_accessible_resources": [{"resources": ["images/*"], "matches": ["<all_urls>"]}], "author": "Triglavis LLC", "homepage_url": "https://triglavis.com/detour/privacy", "short_name": "Detour"}