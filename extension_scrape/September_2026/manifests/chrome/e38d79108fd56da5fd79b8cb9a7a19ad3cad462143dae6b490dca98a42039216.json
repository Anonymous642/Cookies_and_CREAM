{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "mocky", "version": "1.0.3", "description": "AI mockup generator. Create stunning UI mockups instantly with natural language - no design skills needed, works in your browser!", "permissions": ["activeTab", "storage", "sidePanel", "scripting", "tabs"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "mocky", "default_icon": {"128": "mocky_icon_128x128.png"}}, "icons": {"128": "mocky_icon_128x128.png"}, "side_panel": {"default_path": "index.html"}, "web_accessible_resources": [{"resources": ["assets/*", "content.css", "mockup-interactions.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}