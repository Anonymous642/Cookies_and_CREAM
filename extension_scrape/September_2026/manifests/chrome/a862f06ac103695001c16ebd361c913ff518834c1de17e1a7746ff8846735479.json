{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Cringe Blocker", "version": "0.1.2", "description": "Hide LinkedIn feed posts matching user-provided keywords.", "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.linkedin.com/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "background": {"service_worker": "src/service_worker.js"}, "options_page": "src/options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/utils.js", "src/content_script.js"], "run_at": "document_idle"}]}