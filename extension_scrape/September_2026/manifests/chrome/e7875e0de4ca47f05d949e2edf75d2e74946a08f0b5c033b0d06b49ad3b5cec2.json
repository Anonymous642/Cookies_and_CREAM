{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFlow - Tab Group Manager", "version": "1.0.1", "description": "Manage Chrome tab groups with a sleek side panel. Switch, search, and auto-group tabs effortlessly.", "permissions": ["tabs", "tabGroups", "storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["chrome://*/*", "chrome-extension://*/*", "https://chrome.google.com/*", "https://chromewebstore.google.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["side-panel.html", "assets/*"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Toggle the group switcher panel"}, "focus-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Focus search in the panel"}, "next-group": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Switch to next tab group"}, "prev-group": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Switch to previous tab group"}, "new-group": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Create new group from current tab"}, "open-settings": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open extension settings"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}