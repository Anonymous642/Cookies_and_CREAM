{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabs at a Glance", "description": "Tree-style tabs, browsing trails, spotlight search, action palette, and a powerful side panel. Modernize your Chrome.", "version": "1.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://glance.kunok.dev", "permissions": ["activeTab", "storage", "tabs", "favicon", "sidePanel", "sessions", "system.display", "bookmarks", "history", "tabGroups", "downloads", "webRequest", "cookies", "debugger", "topSites", "webNavigation", "scripting", "search"], "host_permissions": ["<all_urls>"], "commands": {"open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open command palette"}, "open-actions-palette": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open command palette in actions mode"}, "open-grid-overlay": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Open visual tab grid overlay"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Open side panel"}}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "Tabs at a Glance", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/command-palette.js", "content-scripts/content.js", "content-scripts/dev-snapshot.js", "content-scripts/grid-overlay.js"]}, {"matches": ["https://github.com/*"], "run_at": "document_idle", "js": ["content-scripts/github-pr-focus.js"]}]}