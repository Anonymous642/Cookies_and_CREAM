{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IELTS Memo", "version": "1.2.3", "description": "Hover any word to see IELTS synonyms and Band scores. Save words to your personal SRS flashcard deck.", "icons": {"32": "icons/icon-32.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "permissions": ["storage", "alarms", "scripting", "tabs", "contextMenus", "notifications", "windows"], "host_permissions": ["https://ieltsmemo.com/*", "https://www.ieltsmemo.com/*", "https://api.dictionaryapi.dev/*", "https://lingva.ml/*", "https://lingva.garudalinux.org/*", "https://api.mymemory.translated.net/*", "https://api.languagetool.org/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["cefr-data.json", "icons/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "IELTS Memo", "default_icon": {"32": "icons/icon-32.png", "128": "icons/icon-128.png"}}, "commands": {"toggle-scanner": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle IELTS synonym scanner on/off"}}}