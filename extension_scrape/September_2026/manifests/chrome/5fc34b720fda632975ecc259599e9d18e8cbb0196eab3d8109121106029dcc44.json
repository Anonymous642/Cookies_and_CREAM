{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Spotlight Search", "description": "Inspired from mac spotlight search, search tab easily with hotkeys option + T", "version": "1.1.1", "permissions": ["tabs", "commands", "windows", "scripting", "system.display", "activeTab"], "action": {"default_popup": "index.html", "default_icon": "icons/icon16.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"open-search": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Open tab search"}}, "web_accessible_resources": [{"resources": ["index.html", "img/favicon/favicon.svg"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png"}, "host_permissions": ["http://*/*", "https://*/*"]}