{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CalmBrowser", "version": "1.0.0", "description": "Calm, predictable browsing for autistic and sensory-sensitive users: pause motion, mute, declutter, focus. Saved per site.", "homepage_url": "https://www.nhrsoft.com", "permissions": ["storage", "scripting", "activeTab"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "CalmBrowser settings for this site"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["content/calm.css"], "js": ["shared/i18n.js", "content/content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"calm-mode": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "\"Too much\" button: instantly toggle your calmest settings on the current page"}}}