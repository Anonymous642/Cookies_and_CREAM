{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Disable Enter in ChatGPT", "version": "1.12", "description": "Prevents accidental sends in ChatGPT, Gemini, Claude, Copilot, Grok. Enter = newline, Ctrl+Enter = send.", "author": "Priit Kallas, Amperly AI", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://grok.com/*"], "js": ["content.js"], "run_at": "document_start"}]}