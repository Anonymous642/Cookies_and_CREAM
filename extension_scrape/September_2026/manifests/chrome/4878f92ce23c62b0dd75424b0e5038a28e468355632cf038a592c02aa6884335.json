{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Select Filter", "version": "0.0.2", "manifest_version": 3, "description": "An extension simplifies your <select>.", "icons": {"32": "icons/icon_32.png", "128": "icons/icon_128.png"}, "commands": {"show_filter": {"suggested_key": {"default": "Alt+F"}, "description": "run select filter on pager."}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}}}, "action": {"default_icon": "icons/icon_32.png"}, "permissions": ["tabs", "activeTab"], "host_permissions": ["http://*/", "https://*/", "file://*/"], "content_scripts": [{"all_frames": true, "matches": ["<all_urls>"], "js": ["insert-search-function.js"], "match_about_blank": true}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["insert-search-function.js"], "matches": ["*://*/*"]}], "background": {"service_worker": "background.js"}}