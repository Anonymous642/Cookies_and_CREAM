{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Bookmarks Extension", "description": "Save, organize, and search bookmarks with intelligent page crawling", "version": "1.0.6", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_title": "Sync Bookmarks"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/injections/twitter.js"], "run_at": "document_start"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["src/injections/instagram.js"], "run_at": "document_start"}], "permissions": ["alarms", "bookmarks", "activeTab", "scripting", "storage", "tabs", "contextMenus"], "host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["icon/*.png"], "matches": ["<all_urls>"]}]}