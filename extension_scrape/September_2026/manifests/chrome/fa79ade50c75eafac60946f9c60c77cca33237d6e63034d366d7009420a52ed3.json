{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GSC Removals Automator", "description": "Automate submitting URL removal requests in Google Search Console.", "version": "0.1.0", "action": {"default_title": "GSC Removals", "default_popup": "popup.html", "default_icon": {"16": "fav128.png", "32": "fav128.png", "128": "fav128.png"}}, "icons": {"128": "fav128.png"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "donate-qr.svg", "leoqr.png"], "matches": ["<all_urls>"]}], "permissions": ["scripting", "storage", "activeTab", "tabs"], "host_permissions": ["https://search.google.com/search-console/removals*"], "content_scripts": [{"matches": ["https://search.google.com/search-console/removals*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}