{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Excellent View AI", "version": "1.0.7", "description": "Free accessibility tools for dyslexia, color blindness & low vision. Optional Pro upgrades available.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Excellent View AI"}, "permissions": ["storage", "activeTab", "scripting", "tts", "contextMenus"], "background": {"service_worker": "js/background.js"}, "commands": {"toggle-reading-ruler": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle Reading Ruler"}, "toggle-dyslexia-font": {"suggested_key": {"default": "Alt+D"}, "description": "Toggle Dyslexia Font"}, "toggle-focus-mode": {"suggested_key": {"default": "Alt+F"}, "description": "Toggle Focus Mode"}, "read-selected-text": {"suggested_key": {"default": "Alt+T"}, "description": "Read Selected Text Aloud"}}, "web_accessible_resources": [{"resources": ["css/*"], "matches": ["<all_urls>"]}]}