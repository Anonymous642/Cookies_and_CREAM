{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Phos Cloud Session Sync", "version": "2.11", "description": "Sincroniza tu sesion de browser (cookies) hacia PhosFlow para que la automatizacion arranque ya autenticada, sin pedir login.", "permissions": ["cookies", "activeTab", "scripting", "alarms", "storage", "notifications"], "host_permissions": ["https://*.sharepoint.com/*", "https://*.microsoftonline.com/*", "https://*.office.com/*", "https://*.office365.com/*", "https://*.msftauth.net/*", "https://*.msauth.net/*", "https://*.microsoft.com/*", "https://*.windows.net/*", "https://flow.phos.ar/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://flow.phos.ar/*", "http://localhost/*"]}, "background": {"service_worker": "background.js"}, "storage": {"managed_schema": "managed_schema.json"}, "action": {"default_popup": "popup.html", "default_title": "Phos Cloud Session Sync"}}