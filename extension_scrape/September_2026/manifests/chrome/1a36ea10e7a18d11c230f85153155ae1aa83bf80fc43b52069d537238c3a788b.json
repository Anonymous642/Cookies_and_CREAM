{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SuperTabs: Alt+Tab for Browser Tabs - Instant Tab Switching", "version": "2025.1130.1612.0", "description": "Switch between tabs instantly with Ctrl+Q - like Alt+Tab for your browser. All features free forever!", "permissions": ["tabs", "storage", "commands", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "SUPERTABS"}, "commands": {"toggle-tabs": {"suggested_key": {"default": "Ctrl+Q", "mac": "Command+E"}, "description": "Toggle between current and last tab"}, "cycle-tabs-premium": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+E"}, "description": "Cycle through recent tabs"}}, "options_page": "options.html", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}