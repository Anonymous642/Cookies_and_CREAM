{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Bigeye", "description": "The Bigeye extension surfaces data quality information in the side panel for supported BI tools.", "manifest_version": 3, "version": "0.4.7", "minimum_chrome_version": "116", "background": {"service_worker": "service-worker.js", "type": "module"}, "host_permissions": ["https://*.bigeye.com/*"], "content_scripts": [{"matches": ["https://*.bigeye.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "Click to open panel"}, "permissions": ["sidePanel", "tabs", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*.woff2", "images/*.svg", "images/*.png", "images/background_new.webp", "icons/*.png"], "matches": ["*://*/*"]}]}