{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ActivityPulse Browser Companion", "version": "1.1.1", "description": "Sends the address and title of your active tab to the ActivityPulse app on this computer. It reads nothing else on the page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "ActivityPulse Browser Companion", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "incognito": "not_allowed", "permissions": ["tabs", "alarms"], "host_permissions": ["http://127.0.0.1:5321/*"]}