{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Indeks - Save & Organize Bookmarks", "description": "Save bookmarks from any page. Organize your reading with AI-powered clustering and semantic search.", "version": "1.1.0", "short_name": "Indeks", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "cookies"], "host_permissions": ["https://indeks.space/*", "https://api.indeks.space/*"], "externally_connectable": {"matches": ["https://indeks.space/*"]}, "commands": {"save-bookmark": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Indeks"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "indeks.space extension popup", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}}