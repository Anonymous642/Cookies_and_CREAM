{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Save as Shortcut", "description": "Offers the ability to save tab(s) and bookmarks as Internet shortcut files.", "icons": {"16": "images/icons/save/save_16.png", "48": "images/icons/save/save_48.png", "128": "images/icons/save/save_128.png"}, "version": "5.72.2300", "manifest_version": 3, "permissions": ["activeTab", "tabs", "contextMenus", "bookmarks", "storage", "scripting"], "action": {"default_icon": "images/icons/save/save_38.png", "default_title": "Save as Shortcut", "default_popup": "html/popup.html"}, "background": {"service_worker": "js/service_worker.js"}, "commands": {"saveAsShortcut_Single": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current tab as an Internet shortcut file."}, "saveAsShortcut_All": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save all tabs as Internet shortcut files."}}}