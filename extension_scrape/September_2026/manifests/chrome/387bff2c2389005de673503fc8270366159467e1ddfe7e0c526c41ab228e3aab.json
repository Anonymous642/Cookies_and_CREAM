{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zen Breath Supporter", "author": "Shunsuke", "version": "1.2", "description": "Breathing guide overlay for any webpage. Toggle per tab. Box, 4-7-8, Zen, Relax patterns. Customize shape, size, color, and position", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "permissions": ["storage", "activeTab", "scripting"], "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-zen": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Toggle Zen Breath Supporter (ON/OFF)"}}, "background": {"service_worker": "background.js"}}