{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WikiTok - Explore Wikipedia Articles In Any Webpage", "description": "Explore Wikipedia instantly without leaving your current page. Get quick, clean summaries right where you need them.", "version": "0.0.3", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://en.wikipedia.org/*", "https://wikimedia.org/*", "https://upload.wikimedia.org/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "web_accessible_resources": [{"resources": ["content/styles.css", "assets/svg/*.svg", "assets/icons/*.png"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_title": "WikiTok", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+W"}}}}