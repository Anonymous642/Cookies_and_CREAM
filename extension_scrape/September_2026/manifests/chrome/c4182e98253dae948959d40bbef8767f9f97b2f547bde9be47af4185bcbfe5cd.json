{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubmitIQ - Automated directory submissions", "short_name": "SubmitIQ", "version": "1.2", "version_name": "1.2", "description": "SubmitIQ is a SaaS that automates directory submissions with one-click form filling and smart tracking in one simple dashboard.", "icons": {"16": "img/logo-16x16.png", "24": "img/logo-24x24.png", "32": "img/logo-32x32.png", "48": "img/logo-48x48.png", "64": "img/logo-64x64.png", "96": "img/logo-96x96.png", "128": "img/logo-128x128.png"}, "author": {"name": "Ninble", "email": "info@submithq.com"}, "minimum_chrome_version": "94", "incognito": "spanning", "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["*://submitiq.com/submissions/*", "*://*.submitiq.com/submissions/*", "*://localhost/submitiq.com/submissions/*"], "js": ["js/submission.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://submitiq.com/submissions/*", "*://*.submitiq.com/submissions/*", "*://localhost/submitiq.com/submissions/*"], "js": ["js/mappings.js", "js/formfiller.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["cookies", "storage", "webRequest", "tabs", "declarativeNetRequest"], "host_permissions": ["https://*.submitiq.com/*", "http://localhost/*", "https://submitiq.com/*"], "action": {"default_title": "SubmitIQ", "default_icon": "img/logo-128x128.png"}, "homepage_url": "https://submitiq.com/", "web_accessible_resources": [{"resources": ["img/*.png", "js/mappings.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open SubmitIQ"}}}