{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Profile Lock", "description": "Lock browsing inside a Chrome profile with a local PIN and recovery code.", "version": "1.1.0", "author": "Yogesh Paliwal", "permissions": ["storage", "tabs", "idle", "alarms", "scripting"], "host_permissions": ["http://*/*", "https://prolock.cloud/*"], "background": {"service_worker": "service_worker.js"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "incognito": "split", "commands": {"panic-lock": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Instantly lock browsing"}}, "action": {"default_title": "Profile Lock", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content_script.js"], "run_at": "document_start"}]}