{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shorts2Video", "version": "1.0", "description": "This extension adds a 'Video' button to YouTube Shorts, allowing users to watch the short as a full video with a single click.", "permissions": ["tabs", "webNavigation"], "action": {"default_title": "Shorts2Video"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/shorts/*"], "js": ["content.js"], "run_at": "document_end"}]}