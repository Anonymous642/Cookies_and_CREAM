{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabs to Keep", "version": "0.1.3", "description": "Keep your tabs in a visual library, right on your New Tab page.", "icons": {"16": "icons/tab-room-16.png", "32": "icons/tab-room-32.png", "48": "icons/tab-room-48.png", "128": "icons/tabs-to-keep-128.png"}, "permissions": ["storage", "tabs", "scripting", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "assets/background.js", "type": "module"}, "chrome_url_overrides": {"newtab": "newtab-apple.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"], "run_at": "document_idle"}]}