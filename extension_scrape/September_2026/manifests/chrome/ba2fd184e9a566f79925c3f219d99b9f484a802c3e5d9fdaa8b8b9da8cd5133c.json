{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmark Folder Navigator", "version": "1.2.0", "description": "Navigate bookmarks in a folder. Premium unlocks recursive navigation and an optional in-page navigation banner.", "permissions": ["bookmarks", "storage", "scripting"], "optional_host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Bookmark Folder Navigator", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"previous-bookmark": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Open the previous bookmark in the selected folder"}, "next-bookmark": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Open the next bookmark in the selected folder"}}}