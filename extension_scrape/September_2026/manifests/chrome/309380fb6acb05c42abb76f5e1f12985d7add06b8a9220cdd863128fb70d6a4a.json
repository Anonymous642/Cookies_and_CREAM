{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SilentShield", "version": "1.0", "description": "Silently blocks popups, overlays, cookie banners, and other distractions.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.mybib.com/*", "*://mybib.com/*", "*://docs.google.com/forms/*"], "js": ["content.js"], "run_at": "document_idle"}]}