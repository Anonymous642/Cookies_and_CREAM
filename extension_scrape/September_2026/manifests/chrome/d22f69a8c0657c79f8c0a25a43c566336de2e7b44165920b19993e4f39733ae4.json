{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ytbychannel", "version": "1.0.0", "description": "Opens YouTube videos at ytbychannel.com, where the channel is in the URL, so a filter can allow one channel and block the rest.", "homepage_url": "https://ytbychannel.com", "minimum_chrome_version": "102", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "ytbychannel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "declarativeNetRequestWithHostAccess", "contextMenus"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.ytbychannel.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "exclude_matches": ["*://studio.youtube.com/*"], "js": ["src/parse.js", "src/settings.js", "src/content.js"], "run_at": "document_start", "all_frames": false}], "declarative_net_request": {"rule_resources": [{"id": "video-links", "enabled": true, "path": "rules.json"}, {"id": "video-links-music", "enabled": false, "path": "rules-music.json"}]}, "commands": {"open-current-video": {"suggested_key": {"default": "Alt+Y"}, "description": "Open the current YouTube video in ytbychannel"}}}