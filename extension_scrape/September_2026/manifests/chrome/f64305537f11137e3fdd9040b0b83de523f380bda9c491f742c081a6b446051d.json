{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Annotate & Study on Any Website | Overlay Notes", "description": "Draw, annotate & handwrite notes on any webpage while you study. Notes pin to the content, save per page, stay 100% local.", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Overlay Notes", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage"], "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle the Overlay Notes sketch canvas"}}, "web_accessible_resources": [{"resources": ["overlay.html", "toolbar.html", "help.html", "fonts/*", "*.woff2"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}