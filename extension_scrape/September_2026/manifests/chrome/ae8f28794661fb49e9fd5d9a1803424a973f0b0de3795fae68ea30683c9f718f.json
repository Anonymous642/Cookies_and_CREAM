{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Tag Replacer", "version": "1.2", "description": "Automatically adds or replaces the Amazon affiliate tracking ID.", "permissions": ["storage"], "host_permissions": ["https://www.amazon.com/*"], "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}, "default_popup": "popup.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://amazon.com/*"], "js": ["content.js"], "run_at": "document_start"}]}