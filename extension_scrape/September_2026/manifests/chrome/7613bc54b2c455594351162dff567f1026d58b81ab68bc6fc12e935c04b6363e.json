{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "My Job Seeker Application Assistant", "version": "1.21.0", "description": "Runs approved Auto-Apply jobs in Chrome and saves job postings to My Job Finder.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "alarms", "notifications", "storage", "scripting", "tabs", "sidePanel"], "host_permissions": ["https://myjobfinder.live/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "panel.html"}, "action": {"default_title": "Open application assistant", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://myjobfinder.live/*"], "js": ["handoff.js"], "run_at": "document_idle"}]}