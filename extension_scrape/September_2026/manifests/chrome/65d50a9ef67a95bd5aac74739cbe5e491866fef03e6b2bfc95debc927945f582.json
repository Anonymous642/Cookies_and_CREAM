{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeGuardian - YouTube Parental Control & Screen Time for Kids", "description": "Parental control for YouTube: block videos, set time limits, and more.", "version": "1.1", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "tabs", "scripting", "activeTab", "notifications"], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}], "host_permissions": ["*://*.youtube.com/*", "https://www.youtube.com/oembed*"]}