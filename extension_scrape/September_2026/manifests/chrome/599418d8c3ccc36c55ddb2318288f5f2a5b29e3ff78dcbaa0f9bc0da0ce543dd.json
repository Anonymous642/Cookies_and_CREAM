{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumipdf: All PDF Tools", "short_name": "Lumipdf", "version": "0.9.0", "description": "Every PDF tool you actually use, in one click: merge, sign, compress and capture, all on your device. No uploads, no account.", "minimum_chrome_version": "120", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Lumipdf", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel", "offscreen", "unlimitedStorage"], "optional_permissions": ["downloads", "tabs"], "host_permissions": [], "optional_host_permissions": ["<all_urls>"], "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Snapshot the full page to PDF"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Capture a region to PDF"}, "open-workspace": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Open the Lumipdf workspace"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}