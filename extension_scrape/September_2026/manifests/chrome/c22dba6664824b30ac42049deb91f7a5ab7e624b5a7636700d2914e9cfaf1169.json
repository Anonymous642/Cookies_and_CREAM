{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeScribe - Transcript Explorer for YouTube", "version": "1.0.1", "description": "Read, search, translate, and export YouTube transcripts in an interactive sidebar.", "permissions": ["activeTab", "scripting"], "host_permissions": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*", "https://*.googlevideo.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["inject.js", "promo-10sec.mp4"], "matches": ["https://*.youtube.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}