{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube PiP Pro", "version": "2.0.0", "description": "Enables Picture-in-Picture mode for YouTube videos with native integration", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.youtube.com/*"], "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "css": ["css/youtube-theme.css"], "js": ["js/content.js"], "all_frames": true, "run_at": "document_idle"}]}