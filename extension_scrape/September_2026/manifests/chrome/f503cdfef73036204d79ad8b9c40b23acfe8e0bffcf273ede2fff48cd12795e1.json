{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volleyball Hide Scores", "version": "1.3", "description": "Hide match scores and video lengths on volleybox.net, volleyballworld.com and VBTV. Watch replays spoiler-free.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://volleybox.net/*", "https://*.volleybox.net/*", "https://volleyballworld.com/*", "https://*.volleyballworld.com/*", "https://en.volleyballworld.com/*", "https://tv.volleyballworld.com/*"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://volleybox.net/*", "https://*.volleybox.net/*", "https://volleyballworld.com/*", "https://*.volleyballworld.com/*", "https://en.volleyballworld.com/*", "https://tv.volleyballworld.com/player?*"], "js": ["content.js"], "run_at": "document_start"}]}