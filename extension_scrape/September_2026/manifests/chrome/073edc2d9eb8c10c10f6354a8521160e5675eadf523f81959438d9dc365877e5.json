{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Glyde - Create Step by Step Guides & SOPs", "description": "AI-powered screen recorder that turns workflows into step-by-step guides and SOPs.", "version": "1.0.10", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["<all_urls>"], "permissions": ["alarms", "storage", "activeTab", "tabs", "scripting", "identity", "tabCapture", "offscreen", "sidePanel"], "web_accessible_resources": [{"resources": ["/assets/*", "icon-16.png", "icon-32.png", "icon-48.png", "icon-128.png", "offscreen.html", "permission.html", "sidebar-trigger.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "Glyde", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"start-stop-recording": {"suggested_key": {"default": "Shift+Alt+E", "mac": "Shift+Alt+E"}, "description": "Start or stop recording"}, "cancel-recording": {"suggested_key": {"default": "Shift+Alt+C", "mac": "Shift+Alt+C"}, "description": "Cancel recording"}, "pause-resume-recording": {"suggested_key": {"default": "Shift+Alt+P", "mac": "Shift+Alt+P"}, "description": "Pause or resume recording"}, "take-screenshot": {"suggested_key": {"default": "Shift+Alt+T", "mac": "Shift+Alt+T"}, "description": "Take a screenshot"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content-scripts/content.js"], "match_origin_as_fallback": true}]}