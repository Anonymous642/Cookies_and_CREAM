{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fact Checking AI Assistant", "version": "0.1.3", "description": "Fact checking assistant with no-key generator fallbacks and public evidence sources.", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "identity", "scripting", "storage"], "host_permissions": ["https://api.gdeltproject.org/*", "https://*.wikipedia.org/*", "https://www.wikidata.org/*", "https://api.openalex.org/*", "https://api.semanticscholar.org/*", "https://api.crossref.org/*", "https://export.arxiv.org/*", "https://api.duckduckgo.com/*", "https://eutils.ncbi.nlm.nih.gov/*", "https://kgsearch.googleapis.com/*", "https://apifreellm.com/*", "https://enter.pollinations.ai/*", "https://text.pollinations.ai/*", "https://gen.pollinations.ai/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "src/js/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https:;"}, "action": {"default_title": "Fact Checking AI Assistant", "default_icon": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png"}}, "commands": {"open_checker": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Fact Checking AI checker"}, "process_selection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open checker and process selected text"}}, "options_page": "public/options.html"}