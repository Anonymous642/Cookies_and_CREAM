{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Draftly for LinkedIn", "description": "Write LinkedIn comments in your own brand voice, powered by Draftly.", "version": "2.0.5", "icons": {"16": "icon/16.png", "24": "icon/24.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "minimum_chrome_version": "103", "host_permissions": ["*://*.linkedin.com/*"], "externally_connectable": {"matches": ["https://dashboard.draftly.so/*"]}, "action": {"default_title": "Draftly for LinkedIn", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://dashboard.draftly.so/extension/connect*"], "run_at": "document_idle", "js": ["content-scripts/connect.js"]}, {"matches": ["*://*.linkedin.com/*"], "run_at": "document_idle", "js": ["content-scripts/linkedin.js"]}, {"matches": ["*://www.linkedin.com/*"], "run_at": "document_idle", "js": ["content-scripts/messaging.js", "content-scripts/outreach.js"]}]}