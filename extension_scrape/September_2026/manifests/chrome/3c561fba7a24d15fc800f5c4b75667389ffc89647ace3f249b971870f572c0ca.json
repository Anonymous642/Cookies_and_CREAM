{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Odoo Debug & Quick Login Tool", "description": "Odoo Debug & Quick Login Tool", "version": "0.2.1", "action": {"default_title": "Odoo Debug & Quick Login Tool", "default_icon": {"16": "icon-normal-16.png", "32": "icon-normal-32.png", "48": "icon-normal-48.png", "128": "icon-normal-128.png"}}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["tabs"], "commands": {"set-debug": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Set Odoo mode to Debug"}, "set-assets": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Set Odoo mode to Assets"}, "set-normal": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Set Odoo mode to Normal"}}, "content_scripts": [{"matches": ["http://*/web/login*", "https://*/web/login*", "http://*/odoo/login*", "https://*/odoo/login*"], "js": ["login_as.js"], "css": ["login_as.css"], "run_at": "document_idle"}]}