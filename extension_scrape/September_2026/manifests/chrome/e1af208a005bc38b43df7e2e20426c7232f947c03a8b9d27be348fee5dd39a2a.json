{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pitchsail", "short_name": "Pitchsail", "icons": {"16": "icons/icon-16x16.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "permissions": ["storage", "cookies"], "host_permissions": ["https://api.pitchsail.com/*", "https://app.pitchsail.com/*", "*://*.linkedin.com/*"], "action": {"default_title": "Pitchsail", "default_popup": "www/index.html#/popup"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.pitchsail.com/*"], "js": ["content-script-pitchsail.js"]}, {"matches": ["https://www.linkedin.com/*"], "js": ["content-script-linkedin.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["assets/pitchsail.png", "www/*"], "matches": ["*://*.linkedin.com/*"]}, {"resources": ["dom.js"], "matches": ["https://app.pitchsail.com/*"]}], "description": "Pitchsail Browser Extension", "version": "1.3.0"}