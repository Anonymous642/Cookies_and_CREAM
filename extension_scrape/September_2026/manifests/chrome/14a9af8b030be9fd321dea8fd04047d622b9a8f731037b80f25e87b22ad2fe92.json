{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video AI Summarizer", "version": "2.0", "description": "Summarize YouTube and Bilibili videos with timestamped notes and configurable AI providers.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.bilibili.com/*", "https://*.hdslb.com/*", "https://api.bilibili.com/*", "https://api.deepseek.com/*", "https://chat.deepseek.com/*", "https://generativelanguage.googleapis.com/*", "https://gemini.google.com/*", "https://api.openai.com/*", "https://dashscope.aliyuncs.com/*", "https://api.anthropic.com/*", "https://api.moonshot.ai/*", "https://api.moonshot.cn/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}, {"matches": ["https://www.bilibili.com/*"], "js": ["content.js"], "css": ["bilibili_styles.css"], "run_at": "document_end"}, {"matches": ["https://gemini.google.com/app*"], "js": ["gemini_inject.js"], "run_at": "document_end"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["chatgpt_inject.js"], "run_at": "document_end"}, {"matches": ["https://chat.deepseek.com/*"], "js": ["deepseek_inject.js"], "run_at": "document_end"}, {"matches": ["https://www.youtube.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.bilibili.com/*"], "js": ["bilibili_inject.js"], "run_at": "document_start", "world": "MAIN"}]}