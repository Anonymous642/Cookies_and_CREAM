{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TapStack", "version": "1.22.4", "description": "Save browser work sessions and restore them later", "minimum_chrome_version": "120", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-src 'none'; base-uri 'self'; form-action 'self';"}, "permissions": ["tabs", "storage", "unlimitedStorage", "notifications", "contextMenus", "alarms"], "host_permissions": ["https://*.supabase.co/*"], "action": {"default_icon": "icons/icon16.png", "default_title": "TapStack - \u5de5\u4f5c\u4f1a\u8bdd\u4fdd\u9669\u7bb1"}, "web_accessible_resources": [{"matches": ["https://*.supabase.co/*"], "resources": ["src/auth/*.html"], "use_dynamic_url": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open tab manager"}, "save_all_tabs": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save all tabs"}, "save_current_tab": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save current tab"}}, "background": {"service_worker": "service-worker.js", "type": "module"}}