{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Design Analyzer - Extract Design Elements", "version": "1.0.0", "description": "Extract colors, fonts, spacing, shadows & effects from any website. Export to CSS, JSON, Figma, Sketch. One-click design analysis.", "author": "Design Tools Team", "homepage_url": "https://github.com/design-analyzer/extension", "permissions": ["activeTab", "scripting", "tabs", "storage"], "action": {"default_popup": "popup.html", "default_title": "Design Analyzer - Extract Design Elements"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["fullscreen.html", "fullscreen.css", "fullscreen.js"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "88", "short_name": "Design Analyzer"}