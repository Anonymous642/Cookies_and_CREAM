{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Preamble", "version": "0.1.0", "description": "The persistent context library you bring to every AI chat. Set it once, paste it anywhere.", "permissions": ["storage", "sidePanel"], "background": {"service_worker": "dist/background.js", "type": "module"}, "side_panel": {"default_path": "src/sidebar.html"}, "action": {"default_title": "Preamble \u2014 open library", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open-preamble": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open Preamble side panel"}}, "web_accessible_resources": [{"resources": ["src/sidebar.css", "dist/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}