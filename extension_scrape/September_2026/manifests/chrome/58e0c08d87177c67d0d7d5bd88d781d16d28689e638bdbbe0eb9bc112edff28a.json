{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QApturely (Test Smart Capture Fast )", "version": "1.3", "description": "Capture visible area, full page, or a selected area to generate test evidence in PPT format", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "downloads"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "commands": {"capture_visible": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capture Visible Area"}, "capture_selected": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Capture Selected Area"}, "show_text_input": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Show a text input for annotations."}}, "web_accessible_resources": [{"resources": ["images/icon16.png", "images/icon48.png", "images/icon128.png"], "matches": ["<all_urls>"]}]}