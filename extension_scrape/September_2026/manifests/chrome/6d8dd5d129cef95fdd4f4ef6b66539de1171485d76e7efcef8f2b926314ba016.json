{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reading Flow Extension", "version": "1.0.0", "description": "Enhance academic reading with focus lines, guided reading, and distraction elimination tools", "permissions": ["activeTab", "scripting"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Reading Flow Settings", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-focus-line": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle focus line reading mode"}}, "web_accessible_resources": [{"resources": ["src/fonts/OpenDyslexic-Regular.woff2", "src/fonts/OpenDyslexic-Bold.woff2", "src/fonts/OpenDyslexic-Italic.woff2", "src/fonts/OpenDyslexic-Bold-Italic.woff2"], "matches": ["*://*/*"]}], "minimum_chrome_version": "88"}