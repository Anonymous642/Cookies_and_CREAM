{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "key": "", "name": "Homie", "version": "2.82", "description": "The world is said to connect through six people. Chances are, your next big fish is already in your pond. Let us help you find them.", "icons": {"128": "icon128.png"}, "permissions": ["cookies", "storage", "background", "alarms", "activeTab"], "host_permissions": ["*://*.linkedin.com/*", "https://app.usehomie.com/*"], "content_scripts": [{"matches": ["*://*.linkedin.com/messaging/thread/new*"], "js": ["content.js"]}, {"matches": ["*://*.linkedin.com/*"], "js": ["content-profile.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["ghost-icon.svg"], "matches": ["*://*.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["*://usehomie.com/*", "*://*.usehomie.com/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icon128.png"}}}