{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Library", "version": "1.0.0", "description": "Simple prompt library for ChatGPT, Claude, etc. Local storage, no tracking, no ads. Export/import as JSON.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://grok.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://grok.com/*"], "js": ["lib/utils.js", "storage/storage-interface.js", "storage/local-storage.js", "content/content.js"], "css": ["content/content.css"]}], "web_accessible_resources": [{"resources": ["lib/icons.svg"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://grok.com/*"]}], "options_page": "options/options.html"}