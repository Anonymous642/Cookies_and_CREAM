{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SleepyTab", "version": "1.0.0", "description": "Snooze tabs and wake them up later automatically", "permissions": ["tabs", "alarms", "storage", "contextMenus", "notifications"], "action": {"default_popup": "src/popup.html", "default_title": "SleepyTab - View Snoozed Tabs"}, "background": {"service_worker": "src/background.js"}, "icons": {"16": "src/icons/icon-16.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["src/wake-up.html", "src/wake-up.js"], "matches": ["<all_urls>"]}]}