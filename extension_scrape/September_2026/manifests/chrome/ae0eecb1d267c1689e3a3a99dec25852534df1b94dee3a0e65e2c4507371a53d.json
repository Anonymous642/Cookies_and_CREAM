{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tabjay", "description": "Send links to Tabjay with a click, so you can stay in your flow and close your browser tabs with confidence.", "version": "4.0.1", "manifest_version": 3, "icons": {"16": "images/tabjay-extension-16x16.png", "32": "images/tabjay-extension-32x32.png", "48": "images/tabjay-extension-48x48.png", "128": "images/tabjay-extension-128x128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["images/*.png"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_title": "Tabjay", "default_popup": "index.html", "default_icon": {"16": "images/tabjay-extension-16x16.png", "24": "images/tabjay-extension-24x24.png", "32": "images/tabjay-extension-32x32.png"}}, "permissions": ["activeTab", "cookies"], "host_permissions": ["https://www.tabjay.com/*", "*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"}}