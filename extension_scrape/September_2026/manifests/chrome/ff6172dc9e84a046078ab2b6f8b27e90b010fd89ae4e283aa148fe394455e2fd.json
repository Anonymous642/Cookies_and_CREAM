{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Transcript Exporter", "version": "1.4.0", "description": "Export YouTube video, Shorts, playlist, channel, search & home-feed transcripts as text or Markdown. Bulk-export to a ZIP.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "dist/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["dist/content.js"], "css": ["dist/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "YT Transcript Exporter Settings"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}