{"manifest_version": 3, "name": "My Cursors - Custom Cursors", "description": "Add awesome cursors to your browser. Change the default cursor to a custom one. Create your own cursor with the constructor.", "version": "1.0.4", "icons": {"128": "icons/128.png"}, "update_url": "https://clients2.google.com/service/update2/crx", "homepage_url": "https://mycursors.com/", "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://mycursors.com/*", "http://mycursors.com/*"], "js": ["exports.js", "shared/Canvas.js", "content-changecursor.js"], "run_at": "document_start"}, {"matches": ["https://mycursors.com/constructor/*"], "js": ["constructor.js"], "run_at": "document_start"}, {"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["storage", "unlimitedStorage", "scripting"], "host_permissions": ["*://*/*"], "action": {"default_title": "My Cursors", "default_popup": "index.html", "default_icon": "icons/128.png"}, "web_accessible_resources": [{"resources": ["cursors/*"], "matches": ["https://mycursors.com/*", "http://mycursors.com/*"]}]}