{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Open as Popup V3", "version": "1.4", "description": "Open the current tab or any link as a popup window.", "permissions": ["tabs", "contextMenus", "storage", "scripting", "system.display"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open as Popup", "default_icon": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open current tab as popup"}, "reopen-last-popup": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Reopen last popup URL"}}, "web_accessible_resources": [{"resources": ["helper.html"], "matches": ["<all_urls>"]}]}