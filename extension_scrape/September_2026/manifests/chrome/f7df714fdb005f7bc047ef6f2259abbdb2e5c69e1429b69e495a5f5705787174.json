{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Read Aloud Search Overlay (Dev)", "version": "0.1.3", "description": "Record audio, transcribe, and read aloud with hotkey controls", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "clar-fi", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+E"}, "description": "Toggle voice overlay"}, "start-read": {"suggested_key": {"default": "Alt+R"}, "description": "Start read aloud"}, "toggle-pause": {"suggested_key": {"default": "Alt+P"}, "description": "Pause or resume read aloud"}, "stop-read": {"suggested_key": {"default": "Alt+S"}, "description": "Stop read aloud"}}}