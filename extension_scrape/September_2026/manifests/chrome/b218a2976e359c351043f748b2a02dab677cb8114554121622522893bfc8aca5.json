{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpsTools SecretVault", "version": "1.0.0", "description": "Zero-knowledge password manager. Store passwords, API keys, and secrets with AES-256 encryption. Your data never leaves your device.", "homepage_url": "https://secretvault.opstools.dev", "permissions": ["activeTab", "storage", "clipboardWrite"], "host_permissions": ["https://secretvault-api.opstools.dev/*", "https://secretvault.opstools.dev/*", "http://localhost:8080/*", "http://localhost:5173/*"], "action": {"default_popup": "popup.html", "default_title": "SecretVault"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open SecretVault"}}}