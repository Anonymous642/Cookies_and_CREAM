{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UNIHODL \u2014 Save Tabs, Scroll & Sessions", "version": "2.4.4", "description": "Save your tabs, scroll position, and video timestamp \u2014 then resume the whole session in one click. Local-first, on-device AI.", "permissions": ["storage", "tabs", "scripting", "activeTab", "contextMenus", "unlimitedStorage", "alarms", "idle", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_title": "HODL this tab", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"hodl-current-tab": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "HODL the current tab"}}, "omnibox": {"keyword": "hodl"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["lib/gmail.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["dashboard/canvas.html", "dashboard/canvases.html", "dashboard/fork.html", "dashboard/teams.html", "dashboard/team-detail.html", "onboarding/index.html"], "matches": ["<all_urls>"]}], "protocol_handlers": [{"protocol": "web+unihodl", "name": "UNIHODL", "uriTemplate": "dashboard/fork.html?protocol=%s"}], "externally_connectable": {"matches": ["https://unihodl.app/*", "https://*.unihodl.app/*", "http://localhost:3000/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}