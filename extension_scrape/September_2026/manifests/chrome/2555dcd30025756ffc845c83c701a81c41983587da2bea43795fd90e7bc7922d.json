{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quick Note to Notion", "version": "1.0", "description": "Save any webpage and notes in one click. Grouped by date. Sync to Notion as clean markdown. Simple, private, and fast.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>", "https://api.notion.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Save URL & Notes"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.notion.com"}, "web_accessible_resources": [{"resources": ["table.html", "table.js", "settings.html", "settings.js", "notion.js"], "matches": ["<all_urls>"]}]}