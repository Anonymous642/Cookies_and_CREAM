{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSmart", "version": "1.2.0", "description": "Park tabs into a smart sidebar. Workspaces, snooze, share/export, color flags, and notifications when tabs are auto-parked.", "permissions": ["sidePanel", "tabs", "storage", "contextMenus", "alarms", "bookmarks", "notifications"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabSmart \u2014 Park this tab"}, "commands": {"park-tab": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Park the active tab"}, "park-all": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Park all tabs"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle TabSmart sidebar"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}