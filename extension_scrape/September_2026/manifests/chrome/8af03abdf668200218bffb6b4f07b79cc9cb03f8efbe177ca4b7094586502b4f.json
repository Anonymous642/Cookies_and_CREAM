{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Download Manager", "version": "2.0.0", "description": "Download Videos and Save Media to Cloud Storage.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}, "permissions": ["storage", "tabs", "scripting", "webRequest", "declarativeNetRequest", "downloads", "sidePanel", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"//": "The bridge script runs only on the savedvids website, making it more secure than using `<all_urls>`. Replace the match pattern with your actual domain.", "matches": ["https://savedvids.com/*", "https://*.savedvids.com/*", "http://localhost/*"], "js": ["content-script.js"], "run_at": "document_start"}], "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "savedvids", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}