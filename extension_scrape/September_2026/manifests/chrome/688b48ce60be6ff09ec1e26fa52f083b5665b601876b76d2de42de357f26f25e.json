{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HitReplAI \u2014 AI LinkedIn Comments", "version": "1.0.2", "description": "Generate AI LinkedIn comments in tones matched to your intent. 5 free/day, no account needed.", "homepage_url": "https://hitreplai.com", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs", "cookies"], "host_permissions": ["https://linkedin.com/*", "https://www.linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.twitter.com/*", "https://www.x.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://news.ycombinator.com/*", "https://github.com/*", "https://www.github.com/*", "https://api.hitreplai.com/*"], "commands": {"trigger-hitreplai": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Trigger HitReplAI on the focused text field"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://linkedin.com/*", "https://www.linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.twitter.com/*", "https://www.x.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://news.ycombinator.com/*", "https://github.com/*", "https://www.github.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://hitreplai.com/*"]}, "action": {"default_popup": "popup.html", "default_title": "HitReplAI"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon48.png"], "matches": ["https://linkedin.com/*", "https://www.linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.twitter.com/*", "https://www.x.com/*", "https://reddit.com/*", "https://www.reddit.com/*", "https://news.ycombinator.com/*", "https://github.com/*", "https://www.github.com/*"]}]}