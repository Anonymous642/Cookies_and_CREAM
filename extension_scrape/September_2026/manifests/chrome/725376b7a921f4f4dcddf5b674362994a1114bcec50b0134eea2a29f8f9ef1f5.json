{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bundole Extension", "description": "Save the page you are on to a Bundole board, with tags and a note.", "version": "0.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.bundole.com/*"], "externally_connectable": {"matches": ["https://www.bundole.com/*"]}, "action": {"default_title": "Add page to Bundole"}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to Bundole"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "web_accessible_resources": [{"resources": ["content-scripts/popover.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}