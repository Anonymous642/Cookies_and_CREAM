{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marian \u2014 highlight, note, and find again", "description": "Highlight any passage on any page, add notes, organize into collections, and search everything you have ever marked.", "version": "0.1.2", "short_name": "Marian", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "host_permissions": ["<all_urls>"], "permissions": ["storage", "contextMenus", "sidePanel", "activeTab", "scripting", "alarms", "tabs", "idle", "downloads", "unlimitedStorage"], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Marian \u2014 open library"}, "commands": {"highlight-selection": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Highlight the current selection"}, "save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save this page to Marian"}, "toggle-highlights": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Show / hide all highlights"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}