{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yolk Chrono", "description": "Time tracking for GitHub & Asana", "version": "0.5.2", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://github.com/*", "https://app.asana.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Yolk Chrono", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://app.asana.com/*"], "run_at": "document_idle", "js": ["content-scripts/asana.js"]}, {"matches": ["https://github.com/*"], "run_at": "document_idle", "js": ["content-scripts/github.js"]}]}