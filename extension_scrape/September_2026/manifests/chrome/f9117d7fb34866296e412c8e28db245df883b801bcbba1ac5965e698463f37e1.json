{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabOrganizer", "version": "1.0.0", "description": "Organize browser tabs into color-coded groups automatically - tame your tab chaos! \ud83d\uddc2\ufe0f", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "tabGroups"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"group-by-domain": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Group tabs by domain"}, "ungroup-all": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ungroup all tabs"}, "collapse-all": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Collapse all groups"}}}