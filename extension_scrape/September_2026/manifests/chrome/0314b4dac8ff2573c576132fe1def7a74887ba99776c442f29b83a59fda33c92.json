{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot Inbox", "version": "0.3.2", "description": "Capture full-tab or selected-area screenshots, record your screen, and manage everything from the side panel.", "permissions": ["activeTab", "scripting", "storage", "clipboardRead", "downloads", "sidePanel", "alarms", "offscreen"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Capture screenshot", "default_popup": "src/popup/popup.html"}, "side_panel": {"default_path": "src/sidepanel/sidepanel.html"}, "commands": {"capture-visible-tab": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Capture current visible tab"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture a selected area of the page"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}