{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Comment Scraper: TubeHarvest", "description": "Scrape and download YouTube comments to CSV. Extract up to 10,000 threaded comments from any video. One-time payment, no sub.", "version": "2.2.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "author": {"email": "contact@tubealfred.com"}, "homepage_url": "https://tubealfred.com", "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"], "host_permissions": ["https://tubealfred.com/*", "*://www.youtube.com/*"], "side_panel": {"default_path": "home.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TubeHarvest - Scrape YouTube Comments"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}