{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SheetXAI - AI Assistant for Google Sheets\u2122", "version": "1.1.62", "minimum_chrome_version": "116", "description": "Use AI to edit, analyze, automate, and bring web data into Google Sheets.", "permissions": ["storage", "activeTab", "scripting", "sidePanel", "webNavigation"], "host_permissions": ["https://docs.google.com/*", "https://iframe.sheetxai.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://iframe.sheetxai.com https://chatbot.sheetxai.com"}, "content_scripts": [{"matches": ["https://docs.google.com/spreadsheets/d/*", "https://docs.google.com/spreadsheets/u/*/d/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://docs.google.com/spreadsheets/d/*", "https://docs.google.com/spreadsheets/u/*/d/*"], "js": ["fallback.js"], "css": ["fallback.css"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "fonts/*"], "matches": ["<all_urls>"]}, {"resources": ["sidepanel.html"], "matches": ["https://docs.google.com/*"]}]}