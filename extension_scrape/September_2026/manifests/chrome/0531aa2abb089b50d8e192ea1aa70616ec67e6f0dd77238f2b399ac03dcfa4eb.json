{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AliBaba Data Extractor", "version": "1.1.2", "description": "Powerful AliBaba scraper for product data, search results, and supplier info. Export data to Excel, CSV, or JSON instantly.", "permissions": ["activeTab", "storage", "sidePanel", "alarms"], "host_permissions": ["https://*.alibaba.com/*", "https://raw.githubusercontent.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["sheet.js"], "matches": ["https://*.alibaba.com/*"]}], "action": {"default_title": "Open AliBaba Data Extractor"}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.alibaba.com/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}