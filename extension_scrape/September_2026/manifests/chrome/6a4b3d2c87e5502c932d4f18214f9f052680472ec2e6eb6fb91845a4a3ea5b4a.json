{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Autofill \u2014 formulaires Angular", "version": "1.0.1", "description": "Remplit automatiquement les champs d'un formulaire Angular (Material + natif) avec des valeurs de test coh\u00e9rentes.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Autofill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "commands": {"fill-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Remplir la page (Autofill)"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Ouvrir la popup Autofill"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["src/data/faker-be.js", "src/fill-engine.js", "src/discover.js", "src/semantics.js", "src/content.js"], "run_at": "document_idle", "all_frames": false}]}