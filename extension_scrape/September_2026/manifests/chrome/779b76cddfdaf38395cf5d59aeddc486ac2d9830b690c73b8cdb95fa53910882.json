{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextAI - Your Learning Companion", "description": "Transform any webpage or PDF into a private, context-aware knowledge base. Chat with your data locally and securely using ContextAI.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["http://localhost:1234/*", "http://localhost:8080/*"], "action": {}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "windows": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Activate the extension on this page"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["file:///*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["file:///*", "https://*/*"]}]}