{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit to PDF Saver", "version": "2.1", "description": "Capture the entire Reddit thread as a screenshot and save it as a PDF..", "permissions": ["activeTab", "downloads", "storage", "tabs"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "action": {"default_popup": "popup.html", "default_title": "Reddit PDF Saver"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}