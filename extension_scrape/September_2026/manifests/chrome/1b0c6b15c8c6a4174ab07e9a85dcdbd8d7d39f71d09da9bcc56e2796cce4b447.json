{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabzee - Tab Suspension & Memory Saver", "short_name": "Tabzee", "version": "1.0.0", "description": "Save Chrome memory and speed. Auto-suspend inactive tabs, protect media tabs, label tab contexts, and use profiles.", "author": "Tabzee", "permissions": ["tabs", "storage", "alarms", "contextMenus"], "optional_permissions": ["notifications"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Tabzee - Tab Management", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "settings/settings.html", "commands": {"sleep-all": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Sleep all tabs except current"}, "wake-all": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Alt+Shift+W"}, "description": "Wake all suspended tabs"}, "focus-mode": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle focus mode (suspend background tabs)"}, "sleep-background": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Sleep all background tabs"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.vimeo.com/*", "*://*.dailymotion.com/*", "*://*.twitch.tv/*", "*://*.netflix.com/*", "*://*.hulu.com/*", "*://*.disneyplus.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/gp/video/*", "*://*.hbomax.com/*", "*://*.max.com/*", "*://*.peacocktv.com/*", "*://*.paramountplus.com/*", "*://*.crunchyroll.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}