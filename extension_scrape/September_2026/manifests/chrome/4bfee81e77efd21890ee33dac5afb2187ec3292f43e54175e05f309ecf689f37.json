{"update_url": "https://clients2.google.com/service/update2/crx", "version": "3.0.1", "manifest_version": 3, "name": "Perception.ai Tutorial Recorder", "description": "A browser extension to create accessible tutorials from browser using AI.", "background": {"service_worker": "background.bundle.js"}, "action": {"default_popup": "popup.html", "default_icon": "Icon32.png"}, "icons": {"32": "Icon32.png", "128": "Icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "webNavigation", "tabs"], "externally_connectable": {"matches": ["https://*.perceptionai.in/*", "http://localhost/*"]}, "content_scripts": [{"matches": ["https://*.perceptionai.in/*"], "js": ["bridge.bundle.js"]}, {"matches": ["http://localhost/*"], "js": ["bridge.bundle.js"]}], "host_permissions": ["<all_urls>"]}