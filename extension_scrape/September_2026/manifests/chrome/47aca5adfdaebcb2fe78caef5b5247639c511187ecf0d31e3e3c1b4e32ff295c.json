{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scrawl \u2014 Draw on Any Page", "version": "1.0.0", "description": "A hand-drawn whiteboard for any page: sketch, add arrows, shapes and text, then export as PNG or SVG. 12 styles, fully offline.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Scrawl", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/lib/core/*.js", "src/lib/effects/*/index.js"], "matches": ["<all_urls>"]}], "commands": {"scrawl-toggle": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open or close the drawing canvas"}}}