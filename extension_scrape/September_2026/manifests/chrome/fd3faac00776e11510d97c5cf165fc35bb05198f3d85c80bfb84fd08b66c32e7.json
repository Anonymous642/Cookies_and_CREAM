{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Replies Scraper - Twitter Exporter", "description": "Fetch every reply to any X (Twitter) post and export them to CSV or JSON. Powered by the FetchLayer API.", "version": "1.0.0", "icons": {"16": "/icon/twitter/16.png", "32": "/icon/twitter/32.png", "48": "/icon/twitter/48.png", "96": "/icon/twitter/96.png", "128": "/icon/twitter/128.png"}, "permissions": ["storage", "sidePanel", "downloads"], "host_permissions": ["https://api.fetchlayer.dev/*", "https://fetchlayer.dev/*", "*://*.x.com/*", "*://*.twitter.com/*"], "externally_connectable": {"matches": ["https://fetchlayer.dev/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "FetchLayer", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}}