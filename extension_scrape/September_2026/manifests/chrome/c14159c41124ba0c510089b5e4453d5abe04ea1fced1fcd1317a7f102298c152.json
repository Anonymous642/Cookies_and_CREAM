{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusFort: Site Blocker & Focus Mode", "description": "Block distracting websites \u2014 unlimited & free, zero data collection. Focus sessions, strict mode & schedules for deep work.", "version": "0.1.0", "short_name": "FocusFort", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "declarativeNetRequest", "alarms", "activeTab"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "FocusFort", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube.js"]}]}