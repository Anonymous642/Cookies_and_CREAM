{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Language Switcher", "version": "1.1", "description": "Instantly fix text typed in the wrong language. Supports custom mappings, smart auto-detection, language cycles, and shortcuts.", "permissions": ["storage", "contextMenus", "webNavigation", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "commands": {"switch-language": {"suggested_key": {"default": "Ctrl+Space", "mac": "Command+Space"}, "description": "Switch language of selected text"}}, "options_page": "options.html", "action": {"default_title": "Language Switcher", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}