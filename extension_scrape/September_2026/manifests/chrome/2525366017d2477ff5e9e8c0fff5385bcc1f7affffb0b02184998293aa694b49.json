{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notate \u2014 Research Highlighter & Web Clipper with AI", "version": "1.2.7", "description": "Highlight webpages, PDFs & YouTube. AI explains your highlights or web page. Summarize Youtube with AI. Syncs to Notion & Obsidian.", "permissions": ["storage", "activeTab", "contextMenus", "identity", "tabs", "windows", "scripting", "downloads", "webNavigation"], "action": {"default_icon": {"16": "/dist/images/icon16-dark.png", "48": "/dist/images/icon48-dark.png", "128": "/dist/images/icon128-dark.png"}, "default_popup": "popup.html"}, "icons": {"16": "/dist/images/icon16-dark.png", "48": "/dist/images/icon48-dark.png", "128": "/dist/images/icon128-dark.png"}, "background": {"service_worker": "dist/background-loader.bundle.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_end"}, {"matches": ["https://notate.so/*", "https://www.notate.so/*", "http://localhost:3000/*"], "js": ["dist/bridge-content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dist/*", "auth-callback.html", "dist/assets/js/chat-sidebar/ChatSidebar.css", "pdf-viewer/*", "pdf-viewer/js/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://notate.so/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "host_permissions": ["<all_urls>"], "commands": {"create-highlight": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Create highlight from selected text"}, "create-note": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Create highlight with note from selected text"}, "create-ai-chat": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Start AI chat with selected text"}, "take-scre