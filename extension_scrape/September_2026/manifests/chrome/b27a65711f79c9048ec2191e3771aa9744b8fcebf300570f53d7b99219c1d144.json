{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebToolkit \u2013 Screenshot & Page Tools", "short_name": "WebToolkit", "version": "1.5.0", "description": "Screenshots & editor, tab/screen recording, offline pages, PDF, OCR, QR codes, table to CSV, colour picker, auto refresh & alerts.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WebToolkit", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "popup/popup.html"}, "options_ui": {"page": "pages/settings.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "pageCapture", "offscreen", "contextMenus", "debugger", "clipboardWrite", "sidePanel", "tabCapture", "notifications"], "host_permissions": ["<all_urls>"], "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current page for offline viewing"}, "screenshot-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Screenshot the visible area"}, "screenshot-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Screenshot the full page"}, "screenshot-area": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Screenshot a selected area"}, "save-pdf": {"description": "Save current page as PDF"}, "ocr-area": {"description": "Copy text from a selected area (OCR)"}, "color-picker": {"description": "Pick a colour from the page"}, "screenshot-element": {"description": "Screenshot a single element"}, "record-tab": {"description": "Start / stop recording this tab"}, "table-csv": {"description": "Export a table as CSV / copy for Excel"}, "scan-qr": {"description": "Scan a QR code on screen"}, "open-side-panel": {"description": "Open WebTo