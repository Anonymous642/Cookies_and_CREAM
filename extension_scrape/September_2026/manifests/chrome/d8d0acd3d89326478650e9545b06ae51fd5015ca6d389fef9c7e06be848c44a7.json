{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ColorGuard Gaming", "version": "1.0", "description": "Color blind assistant for web games with auto-detect, hotkeys, & more", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}], "commands": {"01-off": {"suggested_key": {"default": "Ctrl+Shift+0"}, "description": "Turn off all filters"}, "02-protanopia": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Protanopia mode"}, "03-deuteranopia": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Deuteranopia mode"}, "04-high-contrast": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "High Contrast mode"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}