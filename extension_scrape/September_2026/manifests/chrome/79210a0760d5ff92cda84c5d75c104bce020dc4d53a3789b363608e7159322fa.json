{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meat Spotter \u2014 Menu Highlighter", "version": "1.1.0", "description": "Highlights meat, seafood and hidden animal ingredients on a page, so the meat-free dishes on a menu are the ones left plain.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Meat Spotter", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-highlight": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Highlight meat words on this page (press again to clear)"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Open the Meat Spotter popup"}}}