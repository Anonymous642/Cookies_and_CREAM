{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spotify Pause+", "version": "1.0.0", "description": "Automatically pauses Spotify when YouTube or Twitter videos play audio. Features a floating PIP player for quick controls.", "icons": {"16": "ext-icon.png", "32": "ext-icon.png", "48": "ext-icon.png", "128": "ext-icon.png"}, "permissions": ["tabs", "storage", "activeTab", "scripting"], "host_permissions": ["https://open.spotify.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://twitter.com/*", "https://x.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://open.spotify.com/*"], "js": ["content/spotify-controller.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Spotify Pause+", "default_icon": {"16": "ext-icon.png", "32": "ext-icon.png", "48": "ext-icon.png", "128": "ext-icon.png"}}}