{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HTML to Figma \u2013 Capture Any Website as Editable Layers", "short_name": "HTML2Figma", "version": "1.03", "description": "Capture any webpage and paste it into Figma as real, editable frames and text \u2014 not a flat screenshot. Free Chrome extension.", "permissions": ["activeTab", "scripting", "debugger", "storage", "clipboardWrite", "offscreen", "identity", "unlimitedStorage"], "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-desktop": {"description": "Capture desktop view", "suggested_key": {"default": "Shift+Alt+D"}}, "capture-mobile": {"description": "Capture mobile view", "suggested_key": {"default": "Shift+Alt+M"}}}, "background": {"service_worker": "background.js", "type": "module"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentscript.js"]}]}