{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Diznote", "description": "Diznote - Screen Recorder", "version": "1.0.4", "icons": {"32": "icons/logo.png", "64": "icons/logo.png", "128": "icons/logo.png", "512": "icons/logo.png"}, "action": {"default_title": "Diznote", "default_popup": "popup.html"}, "permissions": ["desktopCapture", "activeTab", "tabs", "scripting", "storage", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"js": ["content.js"], "matches": ["*://*/*"], "run_at": "document_end"}]}