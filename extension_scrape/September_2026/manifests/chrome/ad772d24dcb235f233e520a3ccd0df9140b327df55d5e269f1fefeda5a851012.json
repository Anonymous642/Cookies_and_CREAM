{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub PR De-Clutterer", "version": "1.0.1", "description": "Clean up GitHub Pull Requests by hiding auto-generated files and highlighting complex code.", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "PR De-Clutterer Settings"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["scripts/content.js"]}], "permissions": ["storage", "activeTab"], "host_permissions": ["https://extensionpay.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}