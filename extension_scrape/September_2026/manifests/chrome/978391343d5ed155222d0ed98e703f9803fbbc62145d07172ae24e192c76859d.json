{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Share Pack", "version": "0.1.1", "description": "Collect tabs from the current window and package them for sharing.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs"], "host_permissions": ["https://tab-share-pack.tabshare.workers.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://tab-share-pack.tabshare.workers.dev/*"], "js": ["content-script.js"], "run_at": "document_start"}], "action": {"default_title": "Share selected tabs", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}