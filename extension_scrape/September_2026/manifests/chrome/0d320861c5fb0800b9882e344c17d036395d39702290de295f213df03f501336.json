{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Capture Shield", "version": "1.0.0", "description": "Hides emails, phones, cards, IPs and your own details on web pages before they reach a recording, stream or screen share.", "homepage_url": "https://webmaghrebi.com/CaptureShield/", "minimum_chrome_version": "111", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Capture Shield", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options/index.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "commands": {"toggle-panic": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Panic mode: maximum protection on/off"}, "toggle-protection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle Capture Shield protection"}, "toggle-site": {"description": "Toggle protection for the current site"}, "toggle-reveal": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Show or hide all masked balances and wallets on this page"}}}