{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "App Notes", "description": "Annotate elements on any website and export every note in one place.", "version": "0.1.2", "short_name": "App Notes", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "author": "Michael Ramos (@backnotprop)", "homepage_url": "https://github.com/plannotator/app-notes", "permissions": ["storage", "tabs", "webNavigation", "sidePanel"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle_annotation": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Toggle annotation mode"}, "open_side_panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open App Notes side panel"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "App Notes", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}