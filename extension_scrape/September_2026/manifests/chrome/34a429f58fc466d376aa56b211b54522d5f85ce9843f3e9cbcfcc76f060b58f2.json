{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Screenshot + Blur", "version": "1.0.0", "description": "Capture screenshots and quickly blur/redact sensitive information with auto-detection of PII. Privacy-first, local-only processing.", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "Smart Screenshot + Blur"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"], "host_permissions": ["<all_urls>"], "commands": {"capture-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open screenshot overlay"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.min.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/*.css", "assets/icons/*"], "matches": ["<all_urls>"]}], "default_locale": "en"}