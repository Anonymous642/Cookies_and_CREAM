{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptNest", "version": "2.2.0", "description": "Save and organize AI prompts. Type // in any chat to search and insert instantly. Categories, tags, search, cloud sync.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "PromptNest - Manage Your Prompts", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://gemini.google.com/*", "*://claude.ai/*", "*://copilot.microsoft.com/*", "*://chat.deepseek.com/*"], "js": ["assets/js/content.js", "assets/js/prompt-picker-insert.js", "assets/js/prompt-picker.js"], "css": ["assets/css/icon.css"], "run_at": "document_end"}], "background": {"service_worker": "assets/js/background.js"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "permissions": ["storage", "activeTab", "alarms", "contextMenus", "identity", "sidePanel"], "commands": {"open-promptnest": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open PromptNest"}, "quick-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Quick search prompts"}}, "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://gemini.google.com/*", "*://claude.ai/*", "*://copilot.microsoft.com/*", "*://chat.deepseek.com/*", "*://promptnest-api.promptnest-api.workers.dev/*"]}