{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobHook \u2014 AI Cover Letter Generator", "version": "1.0.0", "description": "Generate personalized cover letters from any job posting. AI-powered, ready to send, directly on LinkedIn, Indeed, and Glassdoor.", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*", "https://www.indeed.com/*", "https://www.glassdoor.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/job-apply/*"], "js": ["content/linkedin.js"], "css": ["content/widget.css"], "run_at": "document_idle"}, {"matches": ["https://www.indeed.com/viewjob*", "https://www.indeed.com/jobs*"], "js": ["content/indeed.js"], "css": ["content/widget.css"], "run_at": "document_idle"}, {"matches": ["https://www.glassdoor.com/job-listing/*"], "js": ["content/glassdoor.js"], "css": ["content/widget.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["content/widget.css"], "matches": ["https://www.linkedin.com/*", "https://www.indeed.com/*", "https://www.glassdoor.com/*"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}}