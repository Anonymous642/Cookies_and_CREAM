{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Claire \u2014 Distraction-free Google Ads", "version": "1.0.1", "description": "Declutter Google Ads \u2014 remove AI summaries, recommendation cards and promo nags for a calm, focused, distraction-free workspace.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://ads.google.com/*"], "background": {"service_worker": "service.js"}, "action": {"default_title": "Claire \u2014 Distraction-free Google Ads", "default_popup": "panel.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"toggle-claire": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Claire on or off"}}, "content_scripts": [{"matches": ["https://ads.google.com/*"], "css": ["hide.css"], "js": ["config.js", "observer.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'"}}