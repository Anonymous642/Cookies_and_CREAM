{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MULTIPIP \u2014 Multi-Video Picture-in-Picture Controller", "short_name": "MULTIPIP", "version": "1.0.5", "minimum_chrome_version": "116", "description": "Detect, control, and view multiple HTML videos with honest Picture-in-Picture capability fallbacks.", "permissions": ["favicon", "scripting", "storage", "tabs", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "optional_host_permissions": ["file:///*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "MULTIPIP", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+O"}}, "play-pause-all": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play or pause all videos in the configured scope"}, "mute-restore-all": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute or restore audio in the configured scope"}, "close-all-pip": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Close all MULTIPIP Picture-in-Picture viewers"}, "rescan-active-tab": {"description": "Rescan the active tab for videos"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}