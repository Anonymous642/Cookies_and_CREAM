{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteKeeper - Notes, To-Dos, Reminders & Lock", "description": "Quick notes, voice notes, checklists, reminders, locked notes & pop-out notes in a side panel. 100% private & offline.", "version": "1.0.2", "short_name": "NoteKeeper", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "scripting", "activeTab", "alarms", "offscreen"], "optional_permissions": ["notifications"], "optional_host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["note.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "NoteKeeper (notes side panel)"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}