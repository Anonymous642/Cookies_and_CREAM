{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmark Manager Pro", "version": "0.0.0.3", "description": "Effortless bookmark management! One-click to organize by date added & access Chrome's bookmark manager instantly. Simple & fast!", "author": "Plaguesfire", "permissions": ["bookmarks", "contextMenus"], "background": {"service_worker": "background/background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["about/about.html", "privacy/privacy.html", "updates/updates.html"], "matches": ["<all_urls>"]}]}