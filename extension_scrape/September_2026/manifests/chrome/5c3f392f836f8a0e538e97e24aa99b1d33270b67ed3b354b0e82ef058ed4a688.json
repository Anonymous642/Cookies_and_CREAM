{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SnapFlow", "description": "Capture screenshots, and history.", "version": "1.1.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "SnapFlow", "default_icon": "icons/icon32.png"}, "permissions": ["activeTab", "downloads", "storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["fullpage.js"]}], "commands": {"snapflow_screenshot": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Take a SnapFlow screenshot"}}}