{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StudyCog Web Capture", "version": "1.2.1", "description": "Capture selected text or an area of any web page straight into your StudyCog library.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "StudyCog Web Capture", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture screenshot - select an area of the page"}, "capture-text": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Capture text - save the highlighted text"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://studycog.co.uk/*", "https://www.studycog.co.uk/*"]}