{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BugBox", "description": "Faster feedback loops for vibe coders. Drag a box, talk your changes, and send it to your AI coding agent.", "version": "0.1.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "identity", "notifications"], "host_permissions": ["https://www.bugbox.ai/*"], "commands": {"toggle-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start or stop a BugBox recording session"}}, "web_accessible_resources": [{"resources": ["inspector.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "BugBox", "default_popup": "popup.html"}, "content_scripts": []}