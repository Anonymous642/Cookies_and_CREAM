{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Anvil: A Homebrew D&D Beyond Magic Items Importer", "short_name": "Anvil", "author": "Glendon Gengel", "version": "1.0.0", "description": "Load custom homebrew magic items into D&D Beyond directly from text.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.dndbeyond.com/*"], "action": {"default_popup": "popup.html", "default_title": "Import Magic Item"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.dndbeyond.com/*"], "css": ["content.css"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.dndbeyond.com/*"]}]}