{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Book", "version": "1.1.0", "description": "Fast tab marking with a dedicated focus window", "action": {"default_icon": {"128": "icon128.png"}, "default_popup": "action_popup.html"}, "background": {"service_worker": "background.js"}, "icons": {"128": "icon128.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage", "contextMenus", "sidePanel", "tabGroups"], "side_panel": {"default_path": "popup.html"}, "host_permissions": ["<all_urls>"], "commands": {"apply-marker": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "MacCtrl+Shift+D"}, "description": "Apply current marker"}, "remove-marker": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "MacCtrl+Shift+X"}, "description": "Remove marker"}, "toggle-focus": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Toggle focus mode"}, "clear-all-markers": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Clear all markers"}}}