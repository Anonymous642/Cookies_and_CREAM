{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "E-commerce Product Scraper", "version": "1.2", "description": "Extract product details and information from popular e-commerce websites.", "permissions": ["activeTab", "storage", "downloads", "clipboardWrite", "scripting"], "host_permissions": ["https://www.amazon.in/*", "https://www.amazon.com/*", "https://meesho.com/*", "https://www.ajio.com/*", "https://www.myntra.com/*", "https://www.shopsy.com/*", "https://www.shopsy.in/*", "https://shopsy.in/*", "https://appdeals.in/*", "https://www.appdeals.in/*", "https://*.flipkart.com/*", "https://hyugalife.com/*", "https://www.hyugalife.com/*"], "action": {"default_popup": "popup.html", "default_title": "Product Scraper"}, "content_scripts": [{"matches": ["https://shopsy.in/*", "https://www.shopsy.in/*"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["https://www.amazon.in/*", "https://www.amazon.com/*"], "js": ["content_amazon.js"], "run_at": "document_end"}, {"matches": ["https://appdeals.in/*", "https://www.appdeals.in/*"], "js": ["paste_appdeals.js"], "run_at": "document_idle"}, {"matches": ["https://www.flipkart.com/*", "https://flipkart.com/*"], "js": ["content_flipkart.js"], "run_at": "document_end"}, {"matches": ["https://www.meesho.com/*", "https://meesho.com/*"], "js": ["content_meesho.js"], "run_at": "document_end"}, {"matches": ["https://www.myntra.com/*", "https://myntra.com/*"], "js": ["content_myntra.js"], "run_at": "document_end"}, {"matches": ["https://hyugalife.com/*", "https://www.hyugalife.com/*"], "js": ["content_hyugalife.js"], "run_at": "document_end"}, {"matches": ["https://www.ajio.com/*", "https://ajio.com/*"], "js": ["content_ajio.js"], "run_at": "document_end"}]}