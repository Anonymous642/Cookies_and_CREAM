{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpeedChanger", "version": "0.1.0", "description": "Adjust HTML5 video playback speed on any site.", "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "SpeedChanger"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "commands": {"speed-up": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "Alt+Shift+Up"}, "description": "Increase playback speed"}, "speed-down": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "Alt+Shift+Down"}, "description": "Decrease playback speed"}, "speed-reset": {"suggested_key": {"default": "Alt+Shift+0", "mac": "Alt+Shift+0"}, "description": "Reset playback speed"}}}