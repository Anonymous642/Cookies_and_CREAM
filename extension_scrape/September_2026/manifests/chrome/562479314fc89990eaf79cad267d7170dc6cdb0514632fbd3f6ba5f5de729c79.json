{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bichig.mn (Latin to Mongolian Keyboard)", "short_name": "Bichig.mn", "version": "1.0.7", "description": "\u041b\u0430\u0442\u0438\u043d\u0430\u0430\u0441 \u041a\u0438\u0440\u0438\u043b-\u0440\u04af\u04af \u0445\u04e9\u0440\u0432\u04af\u04af\u043b\u044d\u0433\u0447 \u0443\u0445\u0430\u0430\u043b\u0430\u0433 \u041c\u043e\u043d\u0433\u043e\u043b \u0433\u0430\u0440. Latin to Cyrillic Mongolian keyboard", "author": "bichig.mn", "homepage_url": "https://bichig.mn", "icons": {"16": "icons/squareforDark@128.png", "48": "icons/squareforDark@128.png", "128": "icons/squareforDark@128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/squareforDark@48.png", "48": "icons/squareforDark@48.png"}, "default_title": "Bichig.mn (Latin to Cyrillic Mongolian Keyboard)"}, "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "match_about_blank": true, "all_frames": true, "js": ["js/core/exceptions.js", "js/core/latin-to-cyrillic.js", "js/core/input-engine.js", "js/ui/keyboard/virtualKeyboard.js", "content.js"], "css": ["css/style.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-mode": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle Cyrillic / Latin input mode"}, "toggle-harmony": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Toggle Vowel Harmony"}}}