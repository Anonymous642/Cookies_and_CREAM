{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TracePage PDF \u2013 Full Page Capture Receipts", "short_name": "TracePage", "version": "0.1.0", "description": "Capture visible or full webpages to paginated PDFs with URL, timestamp, and a local SHA-256 capture receipt.", "minimum_chrome_version": "109", "permissions": ["activeTab", "scripting", "downloads"], "action": {"default_title": "Capture this page with TracePage PDF", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}}