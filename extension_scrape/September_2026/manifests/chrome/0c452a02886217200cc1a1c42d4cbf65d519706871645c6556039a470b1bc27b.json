{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CaptionBridge - Dual Subtitles for YouTube", "short_name": "CaptionBridge", "description": "Show bilingual translated subtitles on YouTube videos and live streams using existing captions.", "version": "2.1.1", "action": {"default_title": "CaptionBridge", "default_popup": "extension/popup/popup.html", "default_icon": {"16": "extension/icons/icon-16.png", "32": "extension/icons/icon-32.png", "48": "extension/icons/icon-48.png", "128": "extension/icons/icon-128.png"}}, "icons": {"16": "extension/icons/icon-16.png", "32": "extension/icons/icon-32.png", "48": "extension/icons/icon-48.png", "128": "extension/icons/icon-128.png"}, "permissions": ["storage"], "background": {"service_worker": "extension/background/service-worker.js"}, "host_permissions": ["https://www.youtube.com/*", "https://translate.googleapis.com/*", "https://translate.google.com/*", "https://clients5.google.com/*", "https://translate.e7y.com/*", "http://localhost:8787/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["extension/content/content.js"], "css": ["extension/content/content.css"], "run_at": "document_idle"}]}