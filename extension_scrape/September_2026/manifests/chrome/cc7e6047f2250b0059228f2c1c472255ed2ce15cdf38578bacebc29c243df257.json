{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Device Simulator", "description": "Simulate mobile and tablet devices on any webpage with realistic device metrics and visual frames.", "version": "1.1", "permissions": ["scripting", "activeTab", "storage", "debugger", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["overlay.js", "devices.js", "icons/*.svg", "icons/*.png", "frames/*.png", "assets/*.png", "assets/*.svg"], "matches": ["<all_urls>"]}]}