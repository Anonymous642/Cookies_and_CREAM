{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MonkMode - Website Time Limiter", "version": "1.0.4", "description": "Set daily time limits for distracting websites. Automatically blocks sites when limits are exceeded.", "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting", "webNavigation", "tabs", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["https://monk-mode.lifestyle/*", "https://*.monk-mode.lifestyle/*", "<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://monk-mode.lifestyle/*", "https://*.monk-mode.lifestyle/*", "http://localhost:5175/*", "http://localhost:5176/*", "http://localhost:5177/*", "http://localhost:5178/*", "http://localhost:5173/*"], "js": ["src/content.js", "src/sync-listener.js", "src/auth-link.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "src/audio-helper.js", "blocked.html", "blocked.css", "blocked.js", "debug-timer.html", "privacy-policy.html"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": []}, "externally_connectable": {"matches": ["https://monk-mode.lifestyle/*", "https://*.monk-mode.lifestyle/*", "http://localhost:5175/*"]}, "homepage_url": "https://monk-mode.lifestyle/privacy-policy.html"}