{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Chat Manager", "version": "4.1.0", "description": "Manage ChatGPT chats with filters, CSV export, project protection, and safe bulk deletion with progress and pause/resume.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "ChatGPT Chat Manager", "default_popup": "popup.html"}, "permissions": ["tabs"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}