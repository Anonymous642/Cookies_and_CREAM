{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jamat Finder", "version": "1.2.0", "description": "Satirical local scorer: rates a social post 0-100 on Jamaat-style posting patterns. No servers, no tracking, no data collected.", "minimum_chrome_version": "111", "permissions": ["storage", "contextMenus", "scripting", "activeTab"], "action": {"default_title": "Jamat Finder \u2014 open scorer"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://*.facebook.com/*", "https://www.threads.net/*", "https://www.threads.com/*", "https://*.reddit.com/*", "https://www.linkedin.com/*", "https://www.youtube.com/*", "https://www.instagram.com/*", "https://bsky.app/*", "https://*.tiktok.com/*"], "js": ["src/lexicon.js", "src/scorer.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": false}]}