{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roadmap Studio Gemini Notebook Agent", "description": "Build personalized learning roadmaps in Gemini Notebook and sync them to Roadmap Studio.", "version": "1.0.2", "permissions": ["storage", "identity", "debugger", "alarms"], "host_permissions": ["https://notebook.google.com/*", "https://roadmapstudio.app/*", "https://mohs.eu.auth0.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["https://roadmapstudio.app/*"]}, "action": {"default_title": "Roadmap Studio Agent", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://notebook.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["prompts/*.txt", "contracts/*.txt"], "matches": ["https://notebook.google.com/*"]}], "homepage_url": "https://roadmapstudio.app"}