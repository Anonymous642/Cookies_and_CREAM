{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Streetfinder", "version": "1.0.1", "description": "A photographer\u2019s viewfinder on Street View: format, lens, rise and shift, level, grid, photo overlay, save the frame.", "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "activeTab", "downloads"], "host_permissions": ["https://www.google.com/maps/*", "https://www.google.it/maps/*", "https://www.google.ch/maps/*", "https://www.google.de/maps/*", "https://www.google.fr/maps/*", "https://www.google.es/maps/*", "https://www.google.co.uk/maps/*", "https://www.google.at/maps/*", "https://www.google.nl/maps/*"], "background": {"service_worker": "sw.js", "type": "module"}, "side_panel": {"default_path": "panel/panel.html"}, "action": {"default_title": "Streetfinder", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://www.google.it/maps/*", "https://www.google.ch/maps/*", "https://www.google.de/maps/*", "https://www.google.fr/maps/*", "https://www.google.es/maps/*", "https://www.google.co.uk/maps/*", "https://www.google.at/maps/*", "https://www.google.nl/maps/*"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"toggle-viewfinder": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Show or hide the frame"}, "save-frame": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the frame as a JPEG"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}