{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PopGuard \u2014 Pop-up & Ad Blocker", "version": "1.0.0", "description": "Blocks pop-ups, popunders, click-jacking overlays and floating ads \u2014 including the tabs streaming sites open when you press play.", "minimum_chrome_version": "111", "permissions": ["declarativeNetRequest", "webNavigation", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "worker/worker.js", "type": "module"}, "action": {"default_popup": "ui/popup.html", "default_title": "PopGuard", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "ui/options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open the PopGuard panel"}, "toggle-enabled": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Turn PopGuard on or off"}, "toggle-trust-site": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Trust or protect the current site"}, "dismiss-overlays": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Clear overlays and floating ads on this page"}, "open-last-blocked": {"description": "Open the most recently blocked pop-up"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "declarative_net_request": {"rule_resources": [{"id": "popups", "enabled": true, "path": "rules/popups.json"}, {"id": "ads", "enabled": true, "path": "rules/ads.json"}, {"id": "privacy", "enabled": true, "path": "rules/privacy.json"}, {"id": "annoyances", "enabled": true, "path": "rules/annoyances.json"}]}, "web_accessible_resources": [{"resources": ["rules/cosmetic/*.json"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}]}