{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Intelligent Marketplace Helper", "version": "0.1.0", "description": "Marks (never hides) Facebook Marketplace listings that match excluded subjects or word rules. Yellow = possible, red = strong match.", "permissions": ["storage", "offscreen"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "options_page": "src/options.html", "action": {"default_popup": "src/popup.html", "default_title": "Intelligent Marketplace Helper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*"], "js": ["src/matcher.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}