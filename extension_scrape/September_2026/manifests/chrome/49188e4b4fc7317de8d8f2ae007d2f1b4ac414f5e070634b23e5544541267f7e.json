{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fullary \u2014 AI Chat Memory & Workspace", "short_name": "Fullary", "version": "0.7.1", "minimum_chrome_version": "102", "incognito": "not_allowed", "description": "Turn selected messages on ChatGPT into an encrypted local library you can search, organize, revisit, export, and share.", "permissions": ["contextMenus", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://fullary.com/api/extension/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Fullary saved messages", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["helpers.js", "content.js"], "css": ["host-styles.css"], "run_at": "document_idle"}, {"matches": ["https://fullary.com/share/from-extension"], "js": ["fullary-share-bridge.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": false, "world": "ISOLATED"}, {"matches": ["https://fullary.com/extension/connect"], "js": ["fullary-extension-connect-bridge.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": false, "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["https://chatgpt.com/*"]}], "commands": {"toggle-fullary-drawer": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open or close the Fullary drawer"}}}