{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "API Sniffer Pro", "version": "2.5.1", "description": "Capture, search, export, and replay API calls (fetch & XHR). Live view, filters, curl export, sessions, dark mode.", "permissions": ["scripting", "storage", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "API Sniffer Pro"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page_hook.js"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}}