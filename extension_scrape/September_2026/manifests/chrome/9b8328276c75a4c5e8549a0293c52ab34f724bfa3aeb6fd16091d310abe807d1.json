{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scrapbook+", "description": "For Canvas8 members, use Scrapbook+ to boost your research; save web pages, videos and snippets, and explore related Canvas8 content", "version": "1.12.6", "icons": {"16": "icons/16.png", "24": "icons/24.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}, "permissions": ["scripting", "activeTab", "tabs", "storage", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Scrapbook+"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Trigger extension click"}}, "web_accessible_resources": [{"resources": ["assets/*", "content/*"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}