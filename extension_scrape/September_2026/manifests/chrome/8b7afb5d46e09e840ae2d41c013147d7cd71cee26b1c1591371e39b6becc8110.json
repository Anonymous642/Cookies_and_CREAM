{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Truly Authentication", "description": "Verify participant identity during video meetings", "version": "1.0.0", "icons": {"16": "icons/white/icon16.png", "48": "icons/white/icon48.png", "128": "icons/white/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/white/icon16.png", "48": "icons/white/icon48.png", "128": "icons/white/icon128.png"}, "default_title": "Truly Authentication"}, "permissions": ["storage", "activeTab", "tabs", "identity", "identity.email"], "host_permissions": ["https://meet.google.com/*", "https://zoom.us/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://zoom.us/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*"], "js": ["src/content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "truly_logo_white.png"], "matches": ["<all_urls>"]}]}