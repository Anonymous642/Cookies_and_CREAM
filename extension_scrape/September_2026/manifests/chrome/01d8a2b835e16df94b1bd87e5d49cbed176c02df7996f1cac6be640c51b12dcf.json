{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Dislike Counter & Rating Bar", "version": "1.0.0", "description": "Show YouTube dislike counts and a rating bar on video pages using the public Return YouTube Dislike API.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://returnyoutubedislikeapi.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "YouTube Dislike Counter & Rating Bar", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}