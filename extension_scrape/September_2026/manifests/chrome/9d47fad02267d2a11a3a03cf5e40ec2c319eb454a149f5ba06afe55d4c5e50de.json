{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stash Links - Bookmark Manager", "version": "2.0.0", "short_name": "Stash Links", "description": "Save and organize bookmarks from any webpage.", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Stash Links"}, "permissions": ["storage", "tabs", "activeTab", "contextMenus", "notifications"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "host_permissions": ["https://*.supabase.co/*"], "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["bookmarks.html", "profile.html"], "matches": ["<all_urls>"]}]}