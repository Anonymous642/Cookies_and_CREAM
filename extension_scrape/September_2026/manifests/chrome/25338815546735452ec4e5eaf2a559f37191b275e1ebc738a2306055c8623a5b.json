{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mindset", "version": "1.0.0", "author": "io.github.nesuwu", "description": "Auto-inject preset prompts into empty AI chats", "icons": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://gemini.google.com/*", "*://claude.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["platforms/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["*://gemini.google.com/*"], "js": ["platforms/gemini.js"], "run_at": "document_idle"}, {"matches": ["*://claude.ai/*"], "js": ["platforms/claude.js"], "run_at": "document_idle"}]}