{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TruRank Extension", "version": "2.0.0", "description": "Enhance your LinkedIn and Yelp experience with TruRank - Get instant rankings and insights for profiles and businesses", "author": "TruRank", "permissions": ["storage", "activeTab", "tabs", "scripting", "webNavigation"], "host_permissions": ["https://trurank.developable.app/*", "https://*.linkedin.com/*", "https://*.yelp.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.yelp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*.js"], "matches": ["<all_urls>"]}]}