{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabTidy - Auto Tab Organizer", "version": "1.0.0", "description": "Automatically group, name, and tidy your tabs. Find duplicates, search tabs, and see a summary of your tab chaos at a glance.", "permissions": ["tabs", "tabGroups", "storage"], "action": {"default_popup": "popup/popup.html", "default_title": "TabTidy", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"group-by-domain": {"suggested_key": {"default": "Alt+G"}, "description": "Group all tabs by domain"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}