{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MakiMode Helper", "version": "0.1.3", "description": "Applies MakiMode's site & feed blocking. Driven entirely by the MakiMode Mac app \u2014 no sign-in needed.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "offscreen"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "MakiMode Helper", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-blocker.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["content-youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.instagram.com/*"], "js": ["content-instagram.js"], "run_at": "document_start"}]}