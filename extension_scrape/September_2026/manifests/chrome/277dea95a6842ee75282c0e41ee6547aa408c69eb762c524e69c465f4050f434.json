{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social AI Reply - LinkedIn, X & Facebook", "short_name": "Social AI Reply", "version": "1.0.0", "description": "Generate authentic AI replies for LinkedIn, X (Twitter), and Facebook posts & comments. Supports Gemini, OpenAI, Groq & OpenRouter.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Social AI Reply Settings"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://*.linkedin.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*", "https://*.facebook.com/*", "https://facebook.com/*", "https://*.fb.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://api.groq.com/*", "https://openrouter.ai/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*", "https://*.facebook.com/*", "https://facebook.com/*", "https://*.fb.com/*"], "js": ["scripts/ai-service.js", "scripts/dom-utils.js", "scripts/content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "styles/*"], "matches": ["https://*.linkedin.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*", "https://*.facebook.com/*", "https://facebook.com/*", "https://*.fb.com/*"]}]}