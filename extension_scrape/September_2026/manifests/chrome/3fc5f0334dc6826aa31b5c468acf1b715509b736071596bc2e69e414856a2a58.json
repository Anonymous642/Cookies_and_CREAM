{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ESA Helper - ClassWallet Receipt Assistant", "short_name": "ESA Helper", "version": "1.3.7", "description": "Simplify ESA receipt submissions to ClassWallet with smart autofill, guided steps, packet tracking, and secure sign-in.", "author": "ESA Helper Team", "homepage_url": "https://esahelper.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "action": {"default_title": "ESA Helper - Open Side Panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs", "downloads"], "host_permissions": ["*://app.classwallet.com/*", "*://main-auth.classwallet.com/*", "*://*.classwallet.com/*", "*://*.esahelper.com/*", "*://backend.esahelper.com/*"], "background": {"service_worker": "background/service-worker.js"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["*://app.classwallet.com/*", "*://*.classwallet.com/*"], "js": ["content/page-controller.js"], "css": ["content/page-controller.css"], "run_at": "document_idle"}, {"matches": ["*://*.esahelper.com/*", "*://esahelper.com/*"], "js": ["content/esa-auth.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*", "sidepanel/*.css", "sidepanel/*.html", "content/*.css"], "matches": ["<all_urls>"]}]}