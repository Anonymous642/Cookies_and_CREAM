{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dep-Man Repository Analyzer", "version": "1.6.1", "description": "Analyze GitHub repositories with enhanced details, urgency indicators, and health scores", "homepage_url": "https://pack-man.tech", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://pack-man.tech/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "exclude_matches": ["https://github.com/settings/*", "https://github.com/notifications*", "https://github.com/marketplace*", "https://github.com/sponsors*", "https://github.com/*/*/issues*", "https://github.com/*/*/pull*", "https://github.com/*/*/pulls*", "https://github.com/*/*/actions*", "https://github.com/*/*/wiki*", "https://github.com/*/*/security*", "https://github.com/*/*/settings*", "https://github.com/*/*/discussions*", "https://github.com/*/*/projects*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_title": "Dep-Man GitHub Extension"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/packman_light.svg", "icons/packman_dark.svg"], "matches": ["https://github.com/*"]}]}