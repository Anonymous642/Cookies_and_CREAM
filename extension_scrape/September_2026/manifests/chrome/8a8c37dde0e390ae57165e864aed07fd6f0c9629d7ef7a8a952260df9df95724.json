{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kagi Translate", "description": "Use Kagi Translate within your browser", "version": "0.1.10", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "contextMenus", "cookies", "scripting", "notifications", "webNavigation"], "host_permissions": ["https://*/*", "http://*/*", "*://*/*"], "web_accessible_resources": [{"resources": ["roundcube-global-probe.js", "assets/lufga.css", "assets/fonts/*.woff"], "matches": ["*://*/*"]}, {"resources": ["content-scripts/content-features.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}, {"resources": ["content-scripts/media-custom-features.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}, {"resources": ["content-scripts/media-site-features.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}, {"resources": ["content-scripts/selection-features.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}, {"resources": ["content-scripts/site-features.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}], "default_locale": "en", "commands": {"translate_page": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Translate the entire page"}, "translate_selection": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Translate selected text"}, "define_selection": {"suggested_key": {"default": "Alt+D", "mac": "Alt+D"}, "description": "Define selected text"}, "proofread_selection": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Proofread selected text"}, "read_aloud": {"description": "Read the selection (or the page) aloud / play-pause"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Kagi Translate", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*