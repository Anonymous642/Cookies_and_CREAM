{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AgentOnWeb", "description": "Bring your local terminal and DSH workspace onto the website you are using.", "version": "0.2.0", "icons": {"16": "agentonweb-16.png", "32": "agentonweb-32.png", "48": "agentonweb-48.png", "128": "agentonweb-128.png"}, "minimum_chrome_version": "132", "permissions": ["alarms", "nativeMessaging", "cookies", "storage", "tabs", "declarativeNetRequestWithHostAccess"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+0", "mac": "MacCtrl+0"}, "description": "Show or hide AgentOnWeb"}, "mode-chill": {"suggested_key": {"default": "Alt+1", "mac": "MacCtrl+1"}, "description": "Switch to Chill mode"}, "mode-focus": {"suggested_key": {"default": "Alt+2", "mac": "MacCtrl+2"}, "description": "Switch to Focus mode"}, "mode-watch": {"suggested_key": {"default": "Alt+3", "mac": "MacCtrl+3"}, "description": "Switch to Watch mode"}}, "action": {"default_title": "Show / hide AgentOnWeb", "default_icon": {"16": "agentonweb-16.png", "32": "agentonweb-32.png"}}, "web_accessible_resources": [{"resources": ["native-surface.html"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/agentonweb.js"]}]}