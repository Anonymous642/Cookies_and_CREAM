{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Country Filter", "version": "1.0", "description": "Filter X.com posts based on user's 'Account Based In' location. Pro version available for unlimited countries.", "permissions": ["storage", "activeTab", "alarms", "tabs", "notifications"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://xcountryfilter.lemonsqueezy.com/*", "https://api.xcountryfilter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "X Country Filter Settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}