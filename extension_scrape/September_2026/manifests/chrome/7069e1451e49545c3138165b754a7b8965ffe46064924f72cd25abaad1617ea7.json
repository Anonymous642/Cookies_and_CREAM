{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SecondB YouTube Summarizer", "version": "0.0.9", "description": "Chrome extension to summarize YouTube videos with SecondB.ai", "author": "SecondB Team", "homepage_url": "https://secondb.ai", "permissions": ["storage", "tabs", "scripting", "cookies"], "host_permissions": ["https://*.youtube.com/*", "https://secondb.ai/*", "https://secondb.supabase.co/*", "https://api.secondb.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"]}], "action": {"default_popup": "popup.html", "default_title": "SecondB YouTube Summarizer"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}