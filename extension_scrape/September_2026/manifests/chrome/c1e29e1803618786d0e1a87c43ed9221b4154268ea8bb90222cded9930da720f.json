{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "phi-thread \u2014 Answer Router", "version": "0.3.0", "description": "Deep-links to the exact answer across SO, Reddit, HN, GitHub & the web. Connect, don't create.", "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://api.stackexchange.com/*", "https://www.reddit.com/*", "https://hn.algolia.com/*", "https://api.github.com/*", "https://html.duckduckgo.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://www.google.co.in/search*", "*://www.google.co.uk/search*", "*://www.google.ca/search*", "*://www.google.com.au/search*", "*://duckduckgo.com/*", "*://www.bing.com/search*"], "js": ["src/content-google.js"], "run_at": "document_idle"}, {"matches": ["*://stackoverflow.com/questions/*", "*://*.stackexchange.com/questions/*", "*://www.reddit.com/r/*/comments/*", "*://news.ycombinator.com/item*"], "js": ["src/content-platform.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open phi-thread search"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}