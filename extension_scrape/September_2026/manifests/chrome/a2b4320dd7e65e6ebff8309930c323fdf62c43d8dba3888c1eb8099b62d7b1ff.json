{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabHop", "version": "1.0.0", "description": "Switch tabs with customizable keyboard shortcuts. Command+Shift+Up/Down on Mac, Ctrl+Shift+Up/Down on Windows and Linux.", "background": {"service_worker": "background.js"}, "action": {"default_title": "TabHop", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"previous-tab": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Switch to the previous tab"}, "next-tab": {"suggested_key": {"default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Switch to the next tab"}, "first-tab": {"description": "Switch to the first tab"}, "last-tab": {"description": "Switch to the last tab"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}