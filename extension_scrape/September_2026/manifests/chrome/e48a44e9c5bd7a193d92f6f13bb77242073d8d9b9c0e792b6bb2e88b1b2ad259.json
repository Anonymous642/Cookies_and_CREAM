{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lintro", "description": "YouTube & Bilibili bilingual subtitle overlay with AI grammar analysis", "version": "0.6.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "offscreen", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube.com/*", "*://*.bilibili.com/*"], "declarative_net_request": {"rule_resources": [{"id": "subtitle_rules", "enabled": true, "path": "rules/subtitle-rules.json"}]}, "web_accessible_resources": [{"resources": ["extractor.js"], "matches": ["*://*.youtube.com/*", "*://*.bilibili.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Lintro", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.bilibili.com/video/*"], "js": ["content-scripts/bilibili.js"]}, {"matches": ["*://*.youtube.com/watch*"], "js": ["content-scripts/youtube.js"]}]}