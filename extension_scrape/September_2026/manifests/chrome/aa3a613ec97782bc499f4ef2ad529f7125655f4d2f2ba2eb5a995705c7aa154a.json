{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GemiNO", "description": "Disables Google Gemini's \"AI Overview\" by intercepting search requests. Take a break from the slow responses and misinformation.", "author": "Henry Morales", "version": "1.0.0", "manifest_version": 3, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.google.com/search"], "declarative_net_request": {"rule_resources": [{"id": "rules", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "16.png", "32": "32.png", "48": "48.png", "64": "64.png", "128": "128.png"}}