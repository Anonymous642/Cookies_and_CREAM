{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Amp \u2014 Volume Booster, EQ & Effects", "version": "1.4.2", "description": "Boost any tab's volume up to 600% and shape the sound with a 10-band EQ. Bass cut, limiter, and fun effects \u2014 on-device.", "permissions": ["tabCapture", "offscreen", "storage", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tab Amp", "default_icon": {"16": "icons/icon16-gray.png", "32": "icons/icon32-gray.png", "48": "icons/icon48-gray.png", "128": "icons/icon128-gray.png"}}, "background": {"service_worker": "background.js"}, "minimum_chrome_version": "119", "commands": {"volume-up": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "Alt+Shift+Up"}, "description": "Volume up"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "Alt+Shift+Down"}, "description": "Volume down"}, "toggle": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Turn on or off for this tab"}, "reset": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Reset volume and EQ"}}}