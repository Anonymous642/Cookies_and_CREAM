{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Intent App", "version": "1.0", "description": "Helps you be intentional about your social media usage by asking you to confirm your intent.", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "tabs", "storage"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.linkedin.com/*", "*://*.instagram.com/*", "*://*.quora.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*"], "js": ["src/content.js"]}], "web_accessible_resources": [{"resources": ["src/dialog.html"], "matches": ["<all_urls>"]}]}