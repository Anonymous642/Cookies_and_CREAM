{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feed Twin \u2014 X follow matcher", "version": "0.1.0", "description": "Compare who you follow on X with a friend's public follows, then follow the gap one human click at a time. Local & private.", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Feed Twin", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}