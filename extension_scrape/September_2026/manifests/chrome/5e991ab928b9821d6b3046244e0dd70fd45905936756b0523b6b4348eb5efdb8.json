{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Organic Typo", "version": "1.0.0", "description": "Simulate human-like typing of pasted text or code into any focused input field.", "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs"], "action": {"default_title": "Open Organic Typo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Organic Typo side panel"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}