{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuizHack", "description": "Pair QuizHack, solve full quiz pages, and apply answers from a double-click workflow.", "version": "1.1.9", "homepage_url": "https://quizhack.ai", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html", "default_title": "QuizHack"}, "externally_connectable": {"matches": ["https://quizhack.ai/*"]}, "commands": {"start-current-page": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Start QuizHack on the current page"}}, "web_accessible_resources": [{"resources": ["icons/brand-logo-transparent.png", "assets/glitchtip.js"], "matches": ["<all_urls>"]}]}