{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pixl Grid", "version": "1.5.8", "description": "Turn your new tab into a productivity dashboard: organize websites, save visual inspiration, manage tasks.", "homepage_url": "https://www.pixlgrid.io", "permissions": ["storage", "activeTab", "scripting", "notifications", "search", "history"], "host_permissions": ["https://www.pixlgrid.io/*", "https://pixlgrid.io/*"], "optional_host_permissions": ["<all_urls>"], "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.pixlgrid.io/*", "https://pixlgrid.io/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"bookmark-page": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Bookmark the current page to Pixl Grid"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Pixl Grid", "default_popup": "popup.html"}}