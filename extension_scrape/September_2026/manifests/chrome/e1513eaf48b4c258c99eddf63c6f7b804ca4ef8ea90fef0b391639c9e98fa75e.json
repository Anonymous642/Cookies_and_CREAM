{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageDiff", "version": "1.0.0", "description": "Select two areas on any webpage and instantly compare their differences.", "author": "yegecali", "homepage_url": "https://github.com/yegecali/pagediff-browser", "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png"}, "default_title": "PageDiff - Compare page areas"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "permissions": ["activeTab", "scripting", "sidePanel", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open PageDiff popup"}, "start_element_1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Start selecting Element 1"}, "start_element_2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Start selecting Element 2"}}}