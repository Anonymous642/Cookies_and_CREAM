{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GlideScroll", "version": "0.1.0", "description": "Smooth hands-free scrolling that pauses when you take control.", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup.html", "default_title": "GlideScroll", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "commands": {"toggle-scroll": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Start or pause scrolling"}, "stop-scroll": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Stop scrolling"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}