{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Capture & Recorder Pro", "version": "2.3.1", "description": "Capture full-page, region & element screenshots, record screen + webcam, blur, annotate, export PNG/JPG/PDF. 100% local.", "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Screen Capture & Recorder Pro", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the visible part of the page"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Capture the full (scrolling) page"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Select a region to capture"}, "start-recording": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the screen recorder"}}}