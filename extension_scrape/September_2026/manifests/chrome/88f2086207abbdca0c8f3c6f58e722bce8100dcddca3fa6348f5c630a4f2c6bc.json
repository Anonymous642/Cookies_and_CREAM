{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slacky", "description": "A better Slack experience on the web", "version": "1.1.3", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://ph.kirankunigiri.com;"}, "web_accessible_resources": [{"resources": ["settings.html"], "matches": ["*://*.slack.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Slacky Settings", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://github.com/*/*/pull/*"], "js": ["content-scripts/pr-github.js"]}, {"matches": ["*://app.graphite.com/github/pr/*"], "js": ["content-scripts/pr-graphite.js"]}, {"matches": ["*://*.slack.com/archives/*"], "js": ["content-scripts/redirect.js"]}, {"matches": ["*://*.slack.com/*"], "js": ["content-scripts/slack.js"]}]}