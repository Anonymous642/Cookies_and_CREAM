{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NetSuite Command Palette Search", "version": "0.0.12", "description": "Allows you to press CMD + K and open an enhanced search on NetSuite, faster and packed with more features!", "action": {"default_icon": "./assets/icon-512.png", "default_popup": "./dist/popup/index.html"}, "background": {"service_worker": "./dist/background/index.mjs"}, "icons": {"16": "./assets/icon-512.png", "48": "./assets/icon-512.png", "128": "./assets/icon-512.png"}, "permissions": ["activeTab", "tabs", "storage"], "content_scripts": [{"matches": ["https://*.app.netsuite.com/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["https://*.app.netsuite.com/*"]}, {"resources": ["dist/inject/inject.js"], "matches": ["https://*.app.netsuite.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}