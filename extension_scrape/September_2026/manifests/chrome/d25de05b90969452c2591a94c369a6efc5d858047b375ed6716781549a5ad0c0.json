{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabOrdo - Tab Manager & Organizer", "description": "Sort, group, deduplicate and manage your tabs with a command palette", "version": "0.8.0", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "minimum_chrome_version": "138", "permissions": ["tabs", "tabGroups", "bookmarks", "history", "storage", "alarms", "scripting", "activeTab", "readingList", "contextMenus", "sessions", "favicon", "sidePanel"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+E"}, "description": "Open TabOrdo command palette"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+E"}, "description": "Open TabOrdo dashboard (no search focus)"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "TabOrdo", "default_popup": "popup.html"}}