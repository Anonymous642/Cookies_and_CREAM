{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SubRead: your subtitles on YouTube", "short_name": "SubRead", "version": "0.2.0", "description": "Show your own .srt over a YouTube video, in time with it. Made for audiobooks with book-accurate subtitles from subread.space.", "homepage_url": "https://subread.space", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "SubRead", "default_popup": "popup.html"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/srt.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}