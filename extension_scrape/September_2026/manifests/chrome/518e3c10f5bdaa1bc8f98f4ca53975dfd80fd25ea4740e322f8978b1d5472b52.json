{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipSnap", "version": "1.0.0", "description": "Clip text and links with one click.", "permissions": ["contextMenus", "storage", "downloads", "alarms", "notifications", "activeTab"], "background": {"service_worker": "service-worker.js"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo-large-16.png", "32": "assets/logo-large-32.png", "48": "assets/logo-large-48.png", "128": "assets/logo-large-128.png"}}, "icons": {"16": "assets/logo-large-16.png", "32": "assets/logo-large-32.png", "48": "assets/logo-large-48.png", "128": "assets/logo-large-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:;"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open ClipSnap popup"}}}