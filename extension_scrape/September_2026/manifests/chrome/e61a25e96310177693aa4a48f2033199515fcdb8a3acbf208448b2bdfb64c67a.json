{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CIPX Toolkit", "description": "Inspect extension storage, page sessions, cookies, selectors, colors, and accessibility contrast in one developer toolkit.", "version": "2.1.0", "permissions": ["activeTab", "scripting", "storage", "cookies", "clipboardWrite", "sidePanel"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "devtools_page": "devtools.html", "side_panel": {"default_path": "index.html"}, "action": {"default_title": "Open CIPX Toolkit", "default_icon": "icon128.png"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"grab-selector": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle the CSS selector inspector on the active tab"}, "pick-color": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the eyedropper to pick a color"}}}