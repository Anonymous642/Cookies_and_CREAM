{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Patch Viewer", "description": "Shadow-DOM HUD for patch-notes navigation and change highlighting. Auto-shows on leagueoflegends.com domains.", "version": "0.1.0", "action": {"default_title": "Patch Viewer", "default_popup": "popup/popup.html"}, "permissions": ["storage"], "host_permissions": ["https://*.leagueoflegends.com/*", "https://leagueoflegends.com/*"], "content_scripts": [{"matches": ["https://*.leagueoflegends.com/*", "https://leagueoflegends.com/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["css/hud.css", "content/*.js", "tokenizer.worker.js", "settings/sites.json"], "matches": ["https://*.leagueoflegends.com/*", "https://leagueoflegends.com/*"]}], "background": {"service_worker": "background/background.js", "type": "module"}, "commands": {"toggle-hud": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle HUD visibility"}}, "options_page": "options/options.html"}