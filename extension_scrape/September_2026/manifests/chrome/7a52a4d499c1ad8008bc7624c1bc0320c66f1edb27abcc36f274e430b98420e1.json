{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MultiAI: Ask AI agent anything as you browse (GPT, Gemini, Claude & 4 more)", "short_name": "MultiAI", "version": "1.3.0", "description": "Chat with GPT, Claude, Gemini and more in Chrome's side panel. Ask about any page, compare answers, and use one multiai.co account.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "MultiAI", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["https://multiai.co/*"], "externally_connectable": {"matches": ["https://multiai.co/*"]}, "omnibox": {"keyword": "mai"}, "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the MultiAI panel"}, "ask-selection": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Ask MultiAI about the selected text"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}