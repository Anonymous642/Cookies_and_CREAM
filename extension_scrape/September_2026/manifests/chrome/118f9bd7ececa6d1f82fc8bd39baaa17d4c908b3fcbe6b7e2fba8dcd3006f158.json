{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlowBreaker", "description": "FlowBreaker adds mindful friction to distracting sites so you browse with intent, not impulse.", "version": "2.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["declarativeNetRequest", "storage", "alarms", "notifications"], "host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["friction.html", "assets/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "FlowBreaker Settings", "default_popup": "popup.html"}}