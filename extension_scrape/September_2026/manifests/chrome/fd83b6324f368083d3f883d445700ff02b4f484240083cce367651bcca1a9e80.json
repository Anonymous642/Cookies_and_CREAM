{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Don't Feed Me", "version": "1.4.9.1", "description": "Remove algorithmic feeds from YouTube, X, and LinkedIn. Everything else works. Feed when you choose.", "permissions": ["storage", "alarms"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "web_accessible_resources": [{"resources": ["grem-transparent.png"], "matches": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.linkedin.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["css/youtube.css"], "js": ["js/shared.js", "js/youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "css": ["css/twitter.css"], "js": ["js/shared.js", "js/twitter.js"], "run_at": "document_start"}, {"matches": ["*://*.linkedin.com/*"], "css": ["css/linkedin.css"], "js": ["js/shared.js", "js/linkedin.js"], "run_at": "document_start"}]}