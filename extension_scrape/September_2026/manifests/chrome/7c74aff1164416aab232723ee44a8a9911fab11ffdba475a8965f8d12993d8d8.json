{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube URL Extractor \u2014 Playlist & Channel Links to CSV", "version": "1.2.2", "description": "Extract all video links & titles from YouTube playlists, channels & search. Copy or export to CSV. Works with NotebookLM.", "permissions": ["storage", "scripting"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}