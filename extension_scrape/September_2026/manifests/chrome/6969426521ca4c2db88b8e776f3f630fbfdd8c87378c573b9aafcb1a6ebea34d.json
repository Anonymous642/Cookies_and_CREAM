{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skimbox - Gmail Summarizer", "version": "1.0.0", "description": "Instant Gmail thread summaries in Chrome's side panel. On-device AI: no API key, and emails never leave your computer.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://mail.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["config.js", "content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Skimbox (Ctrl+M)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-summary": {"suggested_key": {"default": "Ctrl+M", "mac": "MacCtrl+M"}, "description": "Open or close Skimbox"}}}