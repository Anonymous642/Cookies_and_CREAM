{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SwiftConfirm Connect", "version": "0.3.0", "description": "Highlight load details anywhere - load boards, emails, PDFs - and send them straight into SwiftConfirm.", "minimum_chrome_version": "120", "action": {"default_popup": "popup.html", "default_title": "SwiftConfirm Connect"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications", "alarms"], "content_scripts": [{"matches": ["https://swiftconfirm.net/*"], "js": ["session-sync.js"], "run_at": "document_idle"}]}