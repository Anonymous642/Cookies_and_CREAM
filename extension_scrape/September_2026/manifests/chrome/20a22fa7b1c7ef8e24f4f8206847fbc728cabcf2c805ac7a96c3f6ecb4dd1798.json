{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CartSift \u2014 Shopping Filter for Amazon", "short_name": "CartSift", "version": "0.2.0", "description": "Unofficial Amazon.com filter that runs locally for recognized-brand preferences, labeled ads, and visible review-evidence controls.", "homepage_url": "https://www.masturbyte.com/cartsift/", "minimum_chrome_version": "120", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "CartSift \u2014 Shopping Filter for Amazon", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.amazon.com/s*", "https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*", "https://www.amazon.com/product-reviews/*"], "js": ["data/brands.js", "shared/defaults.js", "shared/normalize.js", "shared/classifier.js", "shared/storage.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}