{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SaveLink", "version": "1.3.1", "description": "Private, fast, and powerful link manager", "homepage_url": "https://github.com/Martinek16/SaveLink", "options_ui": {"page": "index.html", "open_in_tab": true}, "permissions": ["storage", "unlimitedStorage", "activeTab", "contextMenus", "notifications", "tabs", "scripting", "bookmarks"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_end"}], "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current page to SaveLink"}, "save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+Z"}, "description": "Save all tabs to SaveLink"}, "open-savelink": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Open SaveLink extension"}}, "action": {"default_popup": "popup.html", "default_title": "SaveLink", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: https://*.google.com https://*.gstatic.com; style-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}