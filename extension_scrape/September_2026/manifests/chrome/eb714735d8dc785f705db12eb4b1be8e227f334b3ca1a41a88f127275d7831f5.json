{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Draw & Highlight on Webpage \u2013 Mark & Annotate", "version": "1.1.0", "description": "Draw, highlight and annotate directly on any webpage or PDF in real-time. Persistent annotations, shapes, screenshots and more.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage", "activeTab", "sidePanel", "contextMenus", "tabs", "downloads", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_title": "Draw & Highlight"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Toggle Draw & Highlight"}, "undo": {"suggested_key": {"default": "Ctrl+Z"}, "description": "Undo last stroke"}, "redo": {"suggested_key": {"default": "Ctrl+Y"}, "description": "Redo last stroke"}, "save-screenshot": {"suggested_key": {"default": "Ctrl+S"}, "description": "Save screenshot"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*", "content/content.css"], "matches": ["<all_urls>"]}]}