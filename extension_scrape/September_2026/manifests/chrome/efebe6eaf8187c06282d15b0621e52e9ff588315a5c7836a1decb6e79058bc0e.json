{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabPortal", "version": "1.0.0", "description": "Generate QR codes for the current tab URL to easily open pages on your phone.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabPortal - QR Code for this tab"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Open TabPortal"}}, "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["lib/qrcode.min.js"], "matches": ["<all_urls>"]}]}