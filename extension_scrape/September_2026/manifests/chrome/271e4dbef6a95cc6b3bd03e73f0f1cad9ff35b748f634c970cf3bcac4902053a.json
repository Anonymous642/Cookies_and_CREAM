{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTNoBar - Spoiler-Free YouTube Player", "version": "1.0.0", "description": "Hide YouTube progress bar & video duration for a pure, spoiler-free viewing experience.", "author": "YTNoBar", "icons": {"16": "images/off_16.png", "48": "images/off_48.png", "128": "images/off_128.png"}, "action": {"default_popup": "popup.html", "default_title": "YTNoBar", "default_icon": {"16": "images/on_16.png", "48": "images/on_48.png", "128": "images/on_128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}