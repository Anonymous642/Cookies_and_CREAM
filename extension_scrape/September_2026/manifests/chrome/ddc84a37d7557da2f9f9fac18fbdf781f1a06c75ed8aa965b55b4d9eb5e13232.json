{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Vault", "description": "Repositorio de prompts con inserci\u00f3n directa en ChatGPT, Claude y Gemini.", "version": "0.1.13", "permissions": ["storage", "activeTab"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://ai.google.com/*", "https://manus.im/*", "https://*.manus.im/*", "https://copilot.microsoft.com/*", "https://www.bing.com/*"], "action": {"default_popup": "popup.html", "default_title": "Prompt Vault", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://ai.google.com/*", "https://manus.im/*", "https://*.manus.im/*", "https://copilot.microsoft.com/*", "https://www.bing.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+P"}, "description": "Abrir Prompt Vault"}, "new-prompt": {"suggested_key": {"default": "Alt+N"}, "description": "Abrir editor de Nuevo Prompt"}}}