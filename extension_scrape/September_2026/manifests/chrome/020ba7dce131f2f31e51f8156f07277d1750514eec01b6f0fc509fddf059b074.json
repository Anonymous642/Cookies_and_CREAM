{"manifest_version": 3, "name": "FIS Task Automation", "version": "6.1.0", "description": "Add-on for enabling web automation tasks. This web extension is compatible with FIS Task Automation for version 6.1.0 or later", "background": {"service_worker": "js/background.js"}, "icons": {"16": "images/FISTaskAutomation.png", "48": "images/FISTaskAutomation.png", "128": "images/FISTaskAutomation.png"}, "permissions": ["browsingData", "nativeMessaging", "tabs", "background", "scripting", "debugger"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"js": ["js/msgport.js", "js/content.js"], "matches": ["http://*/*", "https://*/*", "file://*/*"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "update_url": "https://clients2.google.com/service/update2/crx"}