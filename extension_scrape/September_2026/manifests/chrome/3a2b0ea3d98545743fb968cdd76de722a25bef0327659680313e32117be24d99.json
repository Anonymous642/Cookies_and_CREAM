{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebStep Notes", "version": "1.5.0", "description": "Record automatic clicks, take notes, and send selections to AIs.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus", "identity"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open WebStep Notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidebar.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}