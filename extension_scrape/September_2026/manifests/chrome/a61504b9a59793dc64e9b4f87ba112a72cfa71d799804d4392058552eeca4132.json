{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tagst \u2014 bookmark and note manager with tags", "description": "Tagst is a simple and power bookmark and note manager built around tags. Private, Fast and local-first. No account required.", "version": "1.0.5", "externally_connectable": {"matches": ["https://a.tagst.app/*"]}, "action": {"default_popup": "/index.html?dialog-pages=new-note&view-mode=popup"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "/index.html?view-mode=sidebar"}, "permissions": ["activeTab", "storage", "contextMenus", "sidePanel"], "optional_permissions": ["scripting", "bookmarks", "tabs"], "optional_host_permissions": ["<all_urls>"], "commands": {"add-note": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Add note"}, "open-search": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open search"}, "open-sidebar": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open sidebar"}}, "icons": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}}