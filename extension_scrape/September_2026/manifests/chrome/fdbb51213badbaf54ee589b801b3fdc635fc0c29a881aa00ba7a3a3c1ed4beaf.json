{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Artlist Media Keys", "version": "1.1", "description": "Control the Artlist.io player with hardware media keys, plus a shortcut to add the current track to favorites.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://artlist.io/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "tabs"], "commands": {"add-to-favorite": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Add current Artlist track to favorites"}}}