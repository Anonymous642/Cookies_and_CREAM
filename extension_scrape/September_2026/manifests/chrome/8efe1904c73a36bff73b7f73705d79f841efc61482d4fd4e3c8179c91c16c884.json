{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Music Scrobbler", "version": "1.1.0", "description": "Scrobbles YouTube Music to Last.fm and optionally shares now playing to a local Discord bridge.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://music.youtube.com/*", "https://ws.audioscrobbler.com/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "YouTube Music Scrobbler"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://music.youtube.com/*"]}]}