{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript & AI Summary - EasyTranscriber", "version": "1.1.2", "description": "Get YouTube transcripts, AI summaries, and summarize articles or webpages, with follow-up chat, timestamped notes & Notion export.", "permissions": ["storage", "alarms", "scripting", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://easytranscriber.com/*", "https://www.easytranscriber.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "YouTube Transcript & AI Summary - EasyTranscriber"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/markdown-renderer.js", "content/languages.js", "content/panel-core.js", "content/content.js"], "css": ["content/buttons.css"], "run_at": "document_idle"}, {"matches": ["https://easytranscriber.com/*", "https://www.easytranscriber.com/*"], "js": ["content/auth-listener.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png", "content/panel.css"], "matches": ["<all_urls>"]}]}