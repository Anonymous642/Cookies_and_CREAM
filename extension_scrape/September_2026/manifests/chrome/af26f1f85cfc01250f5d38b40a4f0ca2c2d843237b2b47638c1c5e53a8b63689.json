{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Change Default Search Engine \u2014 Search Manager", "version": "1.3.0", "description": "Easily manage and switch your default search engine between Google, Bing, DuckDuckGo, Yahoo, Brave and more in one click.", "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"search_provider": {"name": "Search Manager", "keyword": "search.oake.life", "search_url": "https://search.oake.life/api/search?q={searchTerms}", "favicon_url": "https://search.oake.life/favicon.ico", "encoding": "UTF-8", "is_default": true}}, "permissions": ["storage", "search", "declarativeNetRequest"], "host_permissions": ["https://search.oake.life/*", "https://*.google.com/*", "https://*.bing.com/*", "https://*.yahoo.com/*", "https://*.duckduckgo.com/*", "https://*.brave.com/*", "https://*.ecosia.org/*", "https://*.yandex.com/*", "https://*.yandex.ru/*", "https://*.startpage.com/*", "https://*.qwant.com/*", "https://*.searx.me/*", "https://*.baidu.com/*", "https://*.ask.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Change Default Search Engine \u2014 Search Manager"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Search Manager popup"}, "switch_to_google": {"description": "Switch default search to Google"}, "switch_to_bing": {"description": "Switch default search to Bing"}, "switch_to_duckduckgo": {"description": "Switch default search to DuckDuckGo"}, "switch_to_brave": {"description": "Switch default search to Brave Search"}, "cycle_next_engine": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Cycle to next search engine"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/goog