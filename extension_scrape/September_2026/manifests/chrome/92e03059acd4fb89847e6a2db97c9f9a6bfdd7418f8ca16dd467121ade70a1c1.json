{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tomato-meter - YouTube Video Ratings", "version": "1.5.0", "description": "Rate YouTube videos with tomatoes or stars! See community ratings with fun animations.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.youtube.com/*", "https://tomato-meter-server.herokuapp.com/*"], "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css", "animations.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tomato-meter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["animations.css", "content.css"], "matches": ["https://*.youtube.com/*"]}]}