{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SlashGo Links", "description": "go/ links for your whole team. Resolve and create go/<name> shortcuts from any page.", "version": "1.4.2", "icons": {"16": "public/logo-16.png", "48": "public/logo-48.png", "128": "public/logo-128.png"}, "action": {"default_icon": {"16": "public/logo-16.png", "48": "public/logo-48.png", "128": "public/logo-128.png"}, "default_popup": "src/popup/index.html"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "activeTab", "contextMenus", "alarms", "storage"], "storage": {"managed_schema": "managed-schema.json"}, "host_permissions": ["https://slashgo.io/*", "https://www.google.com/*", "https://www.google.co.uk/*", "https://www.google.ca/*", "https://www.google.com.au/*", "https://www.google.de/*", "https://www.google.fr/*", "https://www.bing.com/*", "http://go/*", "https://go/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect-go-links", "enabled": true, "path": "rules.json"}]}, "omnibox": {"keyword": "go"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open SlashGo quick-link popup"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}}