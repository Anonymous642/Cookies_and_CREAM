{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StickLy", "short_name": "StickLy", "version": "1.2.3", "description": "Private notes, checklists, tasks and reminders. Save text from any page and stick notes over your tabs. Nothing leaves your device.", "icons": {"16": "icons/stickly-16.png", "32": "icons/stickly-32.png", "48": "icons/stickly-48.png", "96": "icons/stickly-96.png", "128": "icons/stickly-128.png"}, "action": {"default_title": "StickLy", "default_popup": "src/ui/popup.html", "default_icon": {"16": "icons/stickly-16.png", "32": "icons/stickly-32.png"}}, "background": {"service_worker": "src/background/background.js", "type": "module"}, "options_ui": {"page": "src/ui/options.html", "open_in_tab": true}, "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "contextMenus", "scripting", "clipboardWrite", "offscreen"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open StickLy"}, "save-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save selected text as a note"}}, "minimum_chrome_version": "116"}