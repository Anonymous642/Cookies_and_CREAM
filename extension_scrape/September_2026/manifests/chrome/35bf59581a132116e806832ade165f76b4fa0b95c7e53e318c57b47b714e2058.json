{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyncBooking Automation", "version": "2.0.8", "description": "Sync bookings, check-in messages and city tax between Booking.com, Airbnb, VRBO and SyncBooking.", "permissions": ["storage", "tabs", "scripting", "downloads", "debugger", "alarms", "tabGroups"], "host_permissions": ["https://admin.syncbooking.com/*", "https://admin.booking.com/*", "https://*.booking.com/*", "https://www.airbnb.it/*", "https://www.airbnb.com/*", "https://www.vrbo.com/*", "https://web.whatsapp.com/*", "https://syncbooking.com/*", "https://sosfatture.syncbooking.com/*"], "externally_connectable": {"matches": ["https://admin.syncbooking.com/*", "http://localhost/*", "http://127.0.0.1/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SyncBooking Automation", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://admin.booking.com/*", "https://*.booking.com/*"], "js": ["content/booking.js"], "run_at": "document_idle"}, {"matches": ["https://www.airbnb.it/*", "https://www.airbnb.com/*"], "js": ["content/airbnb.js"], "run_at": "document_idle"}, {"matches": ["https://www.vrbo.com/*"], "js": ["content/vrbo.js"], "run_at": "document_idle"}, {"matches": ["https://web.whatsapp.com/*"], "js": ["whatsapp-send.js"], "run_at": "document_idle"}]}