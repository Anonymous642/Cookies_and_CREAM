{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub PR Focus", "version": "0.8.0", "description": "Focus GitHub pull request diffs with category filters and split line counts.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "Configure GitHub PR Focus"}, "background": {"service_worker": "src/background.js"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["src/filters.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}]}