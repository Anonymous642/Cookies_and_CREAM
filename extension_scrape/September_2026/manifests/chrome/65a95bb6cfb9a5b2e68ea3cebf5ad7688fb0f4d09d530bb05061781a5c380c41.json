{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Speed Controller", "version": "1.4.0", "description": "Control video playback speed on any website. Set custom speeds per site, remember preferences, and manage all videos from one popup.", "permissions": ["activeTab", "storage", "tabs", "scripting", "webNavigation", "favicon", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/index.js", "type": "module"}, "options_page": "src/settings/index.html", "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "images/logo-16.png", "48": "images/logo-48.png", "128": "images/logo-128.png"}}, "icons": {"16": "images/logo-16.png", "48": "images/logo-48.png", "128": "images/logo-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/index.js"], "run_at": "document_start", "all_frames": true}], "commands": {"increase-speed": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Increase video playback speed"}, "decrease-speed": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Decrease video playback speed"}}}