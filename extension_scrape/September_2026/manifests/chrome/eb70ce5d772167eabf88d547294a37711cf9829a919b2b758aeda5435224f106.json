{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Codeforces Problem Setter", "version": "1.2.0", "description": "Instant client-side filtering for Codeforces submissions with rating, tags, dates, and solved-state filters.", "icons": {"128": "icons/icon128.png", "480": "icons/icon480.png"}, "host_permissions": ["*://codeforces.com/*"], "action": {"default_title": "Codeforces Problem Setter", "default_icon": {"128": "icons/icon128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://codeforces.com/status*", "*://codeforces.com/submissions/*", "*://codeforces.com/profile/*/submissions*"], "js": ["content.js"], "run_at": "document_idle"}]}