{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MemoryLane", "description": "Today, what did I do? MemoryLane turns your browsing into a daily work diary, generated by AI. Local-first, private by default.", "version": "1.0.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "sidePanel", "tabs", "offscreen", "alarms", "idle"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/sidepanel/index.html"}, "action": {"default_title": "MemoryLane \u2014 Today, what did I do?", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "cross_origin_opener_policy": {"value": "same-origin"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "externally_connectable": {"matches": ["https://lane.stackfield.org/*"]}, "minimum_chrome_version": "116"}