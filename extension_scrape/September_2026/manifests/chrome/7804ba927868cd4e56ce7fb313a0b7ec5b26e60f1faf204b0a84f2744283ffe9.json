{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gloss \u2014 Your web, annotated & shared.", "version": "1.3.1", "description": "Your personal knowledge layer for the internet. Highlight, note, and draw on any page \u2014 then share your screen live.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "notifications", "downloads", "unlimitedStorage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icons/*", "src_services_exportService_ts/*", "src_services_importService_ts/*", "vendors-*/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/index.js"], "run_at": "document_idle", "all_frames": false}], "background": {"service_worker": "background/index.js"}, "action": {"default_popup": "popup/index.html", "default_title": "Gloss", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "dashboard/index.html", "commands": {"toggle-annotation-mode": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Toggle annotation mode on the current page"}, "quick-note": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Create a quick note on the current page"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open the Gloss dashboard"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}