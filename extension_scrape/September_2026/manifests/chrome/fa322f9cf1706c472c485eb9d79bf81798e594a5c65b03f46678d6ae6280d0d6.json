{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FluxTube \u2013 Focus & Cleanup Tools for YouTube", "version": "3.2.0", "description": "Ultimate Mod for Youtube: Remove distracting elements (like shorts,feed etc), Cinema Mode, Grayscale and boost productivity.", "icons": {"16": "assets/images/icon-16.png", "48": "assets/images/icon-48.png", "128": "assets/images/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/images/icon-16.png", "48": "assets/images/icon-48.png", "128": "assets/images/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_start"}]}