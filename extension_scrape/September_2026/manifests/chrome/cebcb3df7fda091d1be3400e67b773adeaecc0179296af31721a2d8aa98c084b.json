{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickSnap", "version": "1.0.2", "description": "Your Marketing Toolbox Light - Manage links and snippets", "permissions": ["storage", "clipboardWrite", "activeTab", "tabs", "contextMenus", "scripting", "notifications", "commands", "downloads"], "action": {"default_popup": "popup.html", "default_title": "QuickSnap - Your Marketing Toolbox"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"quick_add_snippet": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save selected text or link to QuickSnap"}}, "web_accessible_resources": [{"resources": ["tools.json"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}