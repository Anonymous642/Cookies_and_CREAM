{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StageSync - Staging to Prod Config Sync", "version": "1.2.0", "description": "1-click configuration and form migration from Staging to Production. Includes built-in interactive simulator and Jira audit logs.", "permissions": ["activeTab", "storage", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"}, "web_accessible_resources": [{"resources": ["playground/*", "scripts/content.js", "icons/*"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "scripts/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-config": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture configuration from current page"}, "apply-config": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Apply saved configuration to current page"}}}