{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Parentech: Parental Control & Site Blocker", "version": "1.0.2", "homepage_url": "https://parentech.app", "description": "Block sites and searches, set class and free-time schedules, see screen time, calm YouTube. One PIN, one console on your phone.", "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs", "idle", "identity", "scripting"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["yt.js"], "css": ["yt.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["blocked.html", "icons/icon128.png"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Parentech", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}