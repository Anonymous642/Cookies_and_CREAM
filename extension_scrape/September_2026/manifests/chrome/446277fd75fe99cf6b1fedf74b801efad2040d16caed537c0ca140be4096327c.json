{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pagerama \u2014 Full Page Screenshot", "short_name": "Pagerama", "version": "0.1.0", "description": "Panoramic screenshots of entire webpages \u2014 long pages, sticky headers, lazy content. Captured and edited 100% on your device.", "minimum_chrome_version": "114", "homepage_url": "https://pagerama-github-io.pagerama.workers.dev/", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "action": {"default_title": "Pagerama \u2014 capture this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture the full page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible viewport"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}