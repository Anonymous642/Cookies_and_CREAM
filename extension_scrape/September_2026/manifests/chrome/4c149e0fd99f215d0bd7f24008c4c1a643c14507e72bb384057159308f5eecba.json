{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etsy Competitor Researcher", "version": "1.2.0", "description": "Extract public Etsy listing data locally and export it as CSV.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "downloads", "storage"], "host_permissions": ["https://www.etsy.com/*", "https://www.etsy.de/*"], "action": {"default_title": "Etsy Competitor Researcher", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.etsy.com/*", "https://www.etsy.de/*"], "js": ["content.js"], "run_at": "document_idle"}]}