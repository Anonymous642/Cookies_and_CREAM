{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SMS Portal Helper (Banglar Sikhsha SMS Portal Assistance)", "version": "2.2.1", "description": "Auto-fill grades and remarks for LPCD/HPRC report cards on Banglar Sikhsha SMS Portal. Saves teachers valuable time.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"fill-grades": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Fill grades on current page"}, "fill-remarks": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Fill remarks on current page"}, "undo-action": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Undo last fill action"}}}