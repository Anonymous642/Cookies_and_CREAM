{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReviewInsight - Fake Review Detector & Price Tracker", "version": "1.0.0", "description": "Instantly detect fake Amazon reviews with AI-powered analysis. Track price history, spot manipulation, and shop smarter on Amazon.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.amazon.de/*", "*://*.amazon.fr/*"], "action": {"default_popup": "popup.html", "default_title": "ReviewInsight", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.amazon.com/dp/*", "*://*.amazon.com/gp/product/*", "*://*.amazon.com/*/dp/*", "*://*.amazon.co.uk/dp/*", "*://*.amazon.ca/dp/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}