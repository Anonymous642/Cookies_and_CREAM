{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HN Comment Links", "version": "1.1.2", "description": "List all hyperlinks appearing inside Hacker News comment bodies on item pages.", "permissions": ["activeTab", "tabs", "clipboardWrite"], "host_permissions": ["https://news.ycombinator.com/*"], "icons": {"48": "icons/icon-gray-48.png", "128": "icons/icon-gray-128.png"}, "action": {"default_title": "HN Comment Links", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-gray-48.png", "128": "icons/icon-gray-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/item*"], "js": ["content.js"], "run_at": "document_idle"}]}