{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Spotlight", "version": "1.0.0", "description": "Save bookmarks and search everything \u2014 saved links, browser bookmarks, open tabs, and history \u2014 with a Spotlight-style overlay.", "permissions": ["storage", "bookmarks", "tabs", "history", "scripting", "activeTab", "favicon"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/overlay.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "commands": {"open-spotlight": {"suggested_key": {"default": "Ctrl+Shift+U", "windows": "Ctrl+Shift+U", "linux": "Ctrl+Shift+U", "chromeos": "Ctrl+Shift+U", "mac": "Alt+Shift+G"}, "description": "Open Web Spotlight search"}, "save-bookmark": {"suggested_key": {"default": "Ctrl+Shift+Y", "windows": "Ctrl+Shift+Y", "linux": "Ctrl+Shift+Y", "chromeos": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Save the current page as a bookmark"}}}