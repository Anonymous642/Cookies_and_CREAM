{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "watchLess - Search & Summarize YouTube", "version": "1.0.5", "description": "Search inside any YouTube video and jump to the exact moment. Get answers with timestamps. Free to try \u2014 no account needed.", "permissions": ["activeTab", "tabs", "scripting", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://watchless.ai/*", "https://us.i.posthog.com/*"], "action": {"default_title": "watchLess - Toggle sidebar", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "sw.js"}, "web_accessible_resources": [{"resources": ["src/popup/index.html"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}