{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI News Feed", "version": "1.0.0", "description": "A daily.dev-style new tab feed of the latest AI news from TechCrunch, The Verge, VentureBeat, and Ars Technica.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open AI News Feed", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage"], "host_permissions": ["https://techcrunch.com/*", "https://www.theverge.com/*", "https://theverge.com/*", "https://venturebeat.com/*", "https://arstechnica.com/*", "https://feeds.arstechnica.com/*"]}