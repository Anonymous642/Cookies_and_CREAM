{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SkipScary - Scary Scene Skipper", "version": "1.6.0", "description": "Parental controls to automatically skip unwanted scenes on Netflix, Disney+, and Amazon Prime Video.", "permissions": ["storage", "activeTab", "tabs", "sidePanel"], "host_permissions": ["https://*.netflix.com/*", "https://*.disneyplus.com/*", "https://*.primevideo.com/*", "https://*.amazon.com/gp/video/*", "https://*.amazon.co.uk/gp/video/*", "https://api.themoviedb.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.netflix.com/*", "https://*.disneyplus.com/*", "https://*.primevideo.com/*", "https://*.amazon.com/gp/video/*", "https://*.amazon.co.uk/gp/video/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://*.primevideo.com/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*"], "js": ["amazon-frame.js"], "all_frames": true, "run_at": "document_idle"}], "side_panel": {"default_path": "popup.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://*.netflix.com/*", "https://*.disneyplus.com/*", "https://*.primevideo.com/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*"]}]}