{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Magic Glass Subtitles", "version": "0.3.0", "description": "Professional-quality subtitle translations overlaid on Netflix, Crunchyroll, Disney+, and video pages, powered by Magic Glass.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["cookies", "storage", "activeTab", "scripting", "alarms"], "host_permissions": ["https://*.netflix.com/*", "https://*.crunchyroll.com/*", "https://*.bamgrid.com/*", "https://*.dssott.com/*", "https://*.disneyplus.com/*", "https://magicglass.ai/*"], "background": {"service_worker": "sw.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Magic Glass Subtitles", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.netflix.com/*"], "js": ["netflix-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.netflix.com/*"], "js": ["overlay.js"], "run_at": "document_idle"}, {"matches": ["https://*.crunchyroll.com/*"], "js": ["crunchyroll-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["https://*.crunchyroll.com/*"], "js": ["overlay.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://*.disneyplus.com/*"], "js": ["disneyplus-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.disneyplus.com/*"], "js": ["overlay.js"], "run_at": "document_idle"}]}