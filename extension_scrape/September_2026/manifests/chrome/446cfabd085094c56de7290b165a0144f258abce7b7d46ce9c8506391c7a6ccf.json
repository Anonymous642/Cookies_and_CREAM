{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipnosis", "description": "Shift+Click YouTube videos to open in Gemini AI for instant analysis or chat.", "version": "1.0.1", "icons": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["scripting", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://gemini.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Clipnosis", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}