{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No Cache Reload", "description": "Hard-reload bypassing the cache, and inspect or delete cookies, local storage and session storage for the current site.", "version": "1.3", "permissions": ["activeTab", "scripting", "browsingData", "cookies", "storage", "contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "No Cache Reload", "default_icon": {"16": "icons/icon16.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "commands": {"hard-reload": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Hard reload (bypass cache) \u2014 no popup"}, "clear-and-reload": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Clear the selected data for this site, then hard reload"}, "reload-all-tabs": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Hard reload every tab in this window"}}, "icons": {"16": "icons/icon16.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}