{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Coreshi for Crunchyroll \u2014 Anime Episode Tracker", "version": "1.4.4", "manifest_version": 3, "description": "Track your anime progress on Crunchyroll and sync it to Coreshi", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://www.crunchyroll.com/*", "https://coreshi.com/*", "https://api.coreshi.com/*", "https://*.supabase.co/*"], "content_scripts": [{"matches": ["https://www.crunchyroll.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Coreshi for Crunchyroll", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "externally_connectable": {"matches": ["https://coreshi.com/*", "https://www.coreshi.com/*"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}