{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Petdex Snippet", "description": "Manage, search, and copy reusable text snippets with Petdex pets.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "sidePanel"], "host_permissions": ["https://petdex.crafter.run/*", "https://*.r2.dev/*"], "action": {"default_title": "Petdex Snippet", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "web_accessible_resources": [{"resources": ["pets/*"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}], "commands": {"open-snippet-panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Petdex Snippet search panel"}, "copy-recent-snippet": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Copy recent Petdex Snippet"}, "toggle-floating-pet": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Toggle Petdex floating pet"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}