{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Light Dark Color Scheme Toggle", "version": "1.0.0", "description": "Set light or dark per site using Chrome's real color scheme preference. No color inversion, no injected themes.", "minimum_chrome_version": "125", "permissions": ["scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Light Dark Color Scheme Toggle", "default_icon": {"16": "icons/sun-16.png", "24": "icons/sun-24.png", "32": "icons/sun-32.png"}}, "commands": {"toggle": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle this site's color scheme"}, "toggle-global": {"description": "Toggle the default color scheme (all unpinned sites)"}, "unpin-site": {"description": "Clear this site's override (follow the default)"}, "follow-system": {"description": "Follow the system color scheme"}}, "icons": {"16": "icons/moon-16.png", "32": "icons/moon-32.png", "48": "icons/moon-48.png", "128": "icons/moon-128.png"}}