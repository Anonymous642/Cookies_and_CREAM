{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recapio \u2014 AI Notes for Course Videos", "version": "1.0.0", "description": "Timestamped notes + AI summaries and flashcards for Udemy, Coursera and YouTube lectures. Click a timestamp to jump back.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Recapio \u2014 notes for this video", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.udemy.com/*", "https://*.coursera.org/*", "https://*.youtube.com/*"], "js": ["content/platforms.js", "content/export.js", "content/panel.js"], "css": ["content/panel.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab"], "host_permissions": ["https://recapio-api.vercel.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}