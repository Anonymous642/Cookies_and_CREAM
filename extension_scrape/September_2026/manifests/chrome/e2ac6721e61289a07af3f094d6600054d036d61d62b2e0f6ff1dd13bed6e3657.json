{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feedback Catcher", "version": "1.4.0", "description": "Collect visual UI feedback from any web page \u2014 click an element, write a note, export for AI or to files (text, URL, screenshot).", "permissions": ["storage", "activeTab", "downloads", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Feedback Catcher", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "all_frames": false, "js": ["icons.js", "shared.js", "content.js"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["fonts/inter-400.woff2", "fonts/inter-500.woff2", "fonts/inter-600.woff2"], "matches": ["<all_urls>"]}], "commands": {"toggle-comment-mode": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Command+Shift+E"}, "description": "Toggle comment mode"}}}