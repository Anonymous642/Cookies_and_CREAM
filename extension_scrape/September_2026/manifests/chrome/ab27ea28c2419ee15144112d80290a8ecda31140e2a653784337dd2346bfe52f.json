{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VolumeX - Volume Booster", "version": "1.0.5", "description": "Boost and control tab volume up to 600% with per-tab controls, EQ, presets, shortcuts, and site memory.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "VolumeX - Volume Booster"}, "background": {"service_worker": "background.js"}, "permissions": ["tabCapture", "offscreen", "storage", "tabs"], "commands": {"volume-up": {"suggested_key": {"default": "Alt+Up", "windows": "Alt+Up", "mac": "Alt+Up", "linux": "Ctrl+Shift+Up"}, "description": "Increase volume by 10%"}, "volume-down": {"suggested_key": {"default": "Alt+Down", "windows": "Alt+Down", "mac": "Alt+Down", "linux": "Ctrl+Shift+Down"}, "description": "Decrease volume by 10%"}, "toggle-mute": {"suggested_key": {"default": "Alt+M", "windows": "Alt+M", "mac": "Alt+M", "linux": "Alt+M"}, "description": "Mute / unmute current tab"}}, "minimum_chrome_version": "116"}