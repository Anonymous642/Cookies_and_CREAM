{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UI Bug Detector", "version": "1.0.0", "description": "Visually detect UI bugs in user-selected sections of a web page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "activeTab", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["selector.js", "bugReport.js"], "matches": ["http://*/*", "https://*/*"]}]}