{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Test Capture", "description": "Never lose a bug to \"cannot reproduce\" again. Capture test logs automatically, replay any session, and get AI failure diagnosis.", "version": "1.0.6", "icons": {"16": "icon-16.png", "32": "icon-32.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "desktopCapture", "tabCapture", "offscreen", "scripting", "webRequest", "debugger", "<all_urls>"], "host_permissions": ["<all_urls>"], "commands": {"start-tab-recording": {"suggested_key": {"default": "Alt+Shift+Space", "mac": "Alt+Shift+Space"}, "description": "Record Current Tab"}, "start-screen-recording": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Record Entire Screen"}, "take-screenshot": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Take Screenshot"}, "instant-replay": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Instant Replay"}}, "action": {"default_icon": "icon.png", "default_title": "Test Capture", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["*.js", "*.css", "*.svg", "*.png", "icon.png", "icon-16.png", "icon-32.png", "icon-128.png", "offscreen.html", "pip.html", "mic-permission.html", "onboarding.html", "assets/lottie/images/*.png"], "matches": ["*://*/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>", "http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "testsigmainc@gmail.com", "strict_min_version": "109.0"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>", "http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}