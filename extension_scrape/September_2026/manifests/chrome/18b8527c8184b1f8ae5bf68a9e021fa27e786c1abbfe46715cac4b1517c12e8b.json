{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager (Task Manager for Chrome)", "version": "1.0.1", "description": "Manage tabs and windows, detect and control audio playback, and recover closed sessions, all with a seamless user experience.", "permissions": ["storage", "tabs", "windows", "sessions", "alarms", "background"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tab Manager"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+M", "mac": "Command+M"}, "description": "Open Tab Manager"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}