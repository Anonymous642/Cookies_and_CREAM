{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pause & Breathe", "description": "Encourages mindful browsing by adding a short delay with a breathing exercise before accessing selected websites.", "icons": {"16": "icon16.png"}, "version": "1.0", "permissions": ["storage"], "host_permissions": ["*://*.facebook.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["breathing.css"], "js": ["content.js"], "run_at": "document_start"}]}