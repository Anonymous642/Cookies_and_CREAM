{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProposalLift Open Source", "version": "0.1.1", "description": "Draft Upwork proposals against your own self-hosted ProposalLift server. You always submit manually.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "ProposalLift", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "109", "permissions": ["storage", "identity"], "content_scripts": [{"matches": ["https://www.upwork.com/nx/proposals/job/*/apply*"], "js": ["content_script.js"], "run_at": "document_idle"}]}