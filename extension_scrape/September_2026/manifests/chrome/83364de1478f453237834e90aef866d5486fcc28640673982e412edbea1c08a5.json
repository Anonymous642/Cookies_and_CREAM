{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TabDuck", "description": "AI assistant that groups your Chrome tabs based on their content, keeping existing groups intact.", "version": "0.1.0", "manifest_version": 3, "icons": {"16": "favicon.png", "32": "favicon.png", "128": "favicon.png"}, "action": {"default_popup": "popup.html", "default_title": "TabDuck", "default_icon": {"16": "favicon.png", "32": "favicon.png"}}, "permissions": ["tabs", "tabGroups", "storage"], "host_permissions": ["https://tabduck.co/*"], "background": {"service_worker": "background.js", "type": "module"}}