{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhisperBro - Voice Typing on Any Website", "version": "1.0.0", "description": "Click any form field, hit the shortcut, and speak to type.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://localhost:7777/*", "https://whisperbro.com/*"], "background": {"service_worker": "src/background.js"}, "web_accessible_resources": [{"resources": ["src/config/config_dev.json", "src/config/config_prod.json"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "WhisperBro", "default_icon": {"16": "icons/whisperbro-icon-16.png", "32": "icons/whisperbro-icon-32.png", "48": "icons/whisperbro-icon-48.png", "128": "icons/whisperbro-icon-128.png"}}, "icons": {"16": "icons/whisperbro-icon-16.png", "32": "icons/whisperbro-icon-32.png", "48": "icons/whisperbro-icon-48.png", "128": "icons/whisperbro-icon-128.png"}, "commands": {"start_recording": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X", "windows": "Ctrl+Shift+X", "linux": "Ctrl+Shift+X"}, "description": "Start voice typing"}}}