{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meet Recordly", "version": "1.0.0", "description": "Record Google Meet locally \u2014 the meeting tab or your whole screen, everyone's audio and your microphone, with a caption transcript.", "homepage_url": "https://github.com/meetrecordly/meetrecordly", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "downloads", "alarms", "tabs", "activeTab", "notifications"], "host_permissions": ["https://meet.google.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Meet Recordly", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/options/options.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://meet.google.com/*"], "js": ["capture-handle.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording (asks which surface)"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause or resume the current recording"}, "add-marker": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mark this moment in the current recording"}}}