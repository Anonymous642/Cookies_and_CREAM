{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Privacy Suite Extension for WhatsApp Web", "version": "1.9.2", "description": "Granular privacy controls for WhatsApp Web: blur sensitive info, unblur on hover, and more. 100% local, zero external dependencies.", "author": "ALI RAZA <sudo.aliraza@gmail.com>", "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://web.whatsapp.com/*"], "background": {"service_worker": "src/background.js"}, "commands": {"panic-mode": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Ctrl+Shift+Z"}, "description": "Toggle panic mode (hide all content)"}, "toggle-blur": {"suggested_key": {"default": "Ctrl+Z", "mac": "Ctrl+Z"}, "description": "Toggle blur (reveal all / blur all)"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["src/page-notify.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN"}, {"matches": ["https://web.whatsapp.com/*"], "js": ["src/utils.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"matches": ["https://web.whatsapp.com/*"], "resources": ["src/styles.css", "src/popup.html", "src/popup.js", "icons/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "WhatsApp Privacy Suite", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}