{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReviewGrab - Review Exporter for Amazon", "description": "Export Amazon product reviews to CSV: ratings, titles, review text, dates, image & video URLs. Bulk store scan on Pro.", "version": "1.8.0", "permissions": ["scripting", "downloads", "tabs", "storage"], "host_permissions": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.it/*", "https://www.amazon.es/*", "https://www.amazon.co.jp/*", "https://www.amazon.com.au/*", "https://www.amazon.in/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ReviewGrab"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}