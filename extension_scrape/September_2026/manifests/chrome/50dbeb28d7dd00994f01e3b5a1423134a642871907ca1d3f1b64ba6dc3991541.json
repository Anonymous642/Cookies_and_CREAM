{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Music Mode for YouTube\u2122 - Ad-Free Audio & Focus", "short_name": "Music Mode+", "version": "1.0", "description": "Transform YouTube into a background music player. Hide videos, block distractions, and set a sleep timer for focused listening.", "permissions": ["storage", "tabs", "notifications", "alarms"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon/icon48.png", "100": "icon/icon100.png", "128": "icon/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "host_permissions": ["*://*.youtube.com/*"], "icons": {"48": "icon/icon48.png", "100": "icon/icon100.png", "128": "icon/icon128.png"}}