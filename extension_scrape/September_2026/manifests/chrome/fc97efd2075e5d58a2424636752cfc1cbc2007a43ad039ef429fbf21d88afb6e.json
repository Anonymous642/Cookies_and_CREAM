{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal Notes", "version": "1.0.0", "description": "Floating sticky notes that persist across tabs. Supports markdown, rename, delete, and a global visibility toggle.", "permissions": ["storage", "scripting", "tabs"], "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "Universal Notes"}, "background": {"service_worker": "service_worker.js", "type": "module"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "commands": {"toggle-sticky-notes": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle notes panel visibility"}}, "web_accessible_resources": [{"resources": ["content/marked.esm.min.js", "content/dompurify.es.mjs", "content/markdown.css", "content/content.css"], "matches": ["<all_urls>"]}]}