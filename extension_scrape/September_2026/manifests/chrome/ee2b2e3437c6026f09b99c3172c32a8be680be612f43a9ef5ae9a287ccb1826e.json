{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HTML2Prompt", "short_name": "HTML2Prompt", "version": "1.1.0", "description": "Pick any component on any website and copy it as a faithful prompt: HTML and CSS snapshot, design tokens and screenshot.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "HTML2Prompt", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "debugger"], "commands": {"start-picker": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Pick a component to copy"}, "capture-page": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Copy the whole page as a prompt"}}}