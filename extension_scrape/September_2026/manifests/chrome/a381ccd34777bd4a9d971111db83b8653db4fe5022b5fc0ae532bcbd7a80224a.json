{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFader: Per-Tab Volume Control", "description": "Per-tab audio control: see what's playing, mute any tab, set a volume per site. 100% local, no tracking.", "version": "1.0.1", "short_name": "TabFader", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/orlandogp/tabfader", "permissions": ["tabs", "storage", "scripting"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "TabFader", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_popup": "popup.html"}, "commands": {"toggle-mute-active": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute/unmute the active tab"}}, "background": {"service_worker": "background.js"}, "content_scripts": []}