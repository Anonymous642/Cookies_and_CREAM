{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bloki", "version": "1.2.0", "description": "Blocks YouTube videos and Shorts labeled as AI-generated or synthetically altered.", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png"}, "default_title": "Bloki"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["dist/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "web_accessible_resources": [{"resources": ["assets/icons/*"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}