{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AccessiWeb", "version": "1.1.2", "description": "Accesibilidad web avanzada: dislexia, daltonismo, alto contraste, motor, TTS y OCR. Sin servidores externos.", "permissions": ["storage", "tts", "activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background/service-worker.js"}, "commands": {"toggle-tts": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle text-to-speech"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Toggle floating accessibility panel"}, "toggle-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle Focus Mode"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["vendor/tesseract.min.js", "vendor/tesseract/*"], "matches": ["<all_urls>"], "use_dynamic_url": true}]}