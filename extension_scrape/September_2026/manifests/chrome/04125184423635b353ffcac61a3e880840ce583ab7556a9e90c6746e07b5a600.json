{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "palbench save watcher", "version": "0.2.6", "description": "Reads your Palworld Level.sav every 30s and keeps your palbench box current. Reads only, never writes. Windows saves only.", "host_permissions": ["file:///*", "https://palbench.com/*", "https://sync.palbench.com/*"], "permissions": ["alarms", "storage"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "bg.js", "type": "module"}, "content_scripts": [{"matches": ["https://palbench.com/*", "file:///*/palbreeder.html"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "palbench save watcher", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}