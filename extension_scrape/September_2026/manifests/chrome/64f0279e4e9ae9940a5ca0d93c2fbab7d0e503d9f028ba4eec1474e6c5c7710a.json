{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Content Extractor", "version": "1.0.1", "description": "Extracts and tracks LinkedIn post data from a profile's Recent Activity page or a single post, ready to copy into a spreadsheet.", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "scripting", "webNavigation"], "host_permissions": ["https://www.linkedin.com/*", "https://media.licdn.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "LinkedIn Content Extractor", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*/recent-activity/all", "https://www.linkedin.com/in/*/recent-activity/all/"], "js": ["common/extractor.js", "common/settings-panel.js", "posts-list/state.js", "posts-list/checkpoint.js", "posts-list/scan.js", "posts-list/panel-render.js", "posts-list/config-io.js", "posts-list/content.js"], "css": ["common/panel-ui.css", "posts-list/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/posts/*", "https://www.linkedin.com/feed/update/*"], "js": ["common/extractor.js", "common/settings-panel.js", "posts-single/state.js", "posts-single/panel.js", "posts-single/content.js"], "css": ["common/panel-ui.css", "posts-single/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["config.json"], "matches": ["https://www.linkedin.com/*"]}]}