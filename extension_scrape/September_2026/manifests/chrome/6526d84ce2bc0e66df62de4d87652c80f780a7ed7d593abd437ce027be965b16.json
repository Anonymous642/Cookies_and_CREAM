{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Minimalist Tab Manager", "version": "1.0", "description": "Automatically archives and closes tabs that exceed your limit to keep your browser fast and focused. Save and restore sessions.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["tabs", "storage", "notifications", "unlimitedStorage"], "host_permissions": ["<all_urls>"]}