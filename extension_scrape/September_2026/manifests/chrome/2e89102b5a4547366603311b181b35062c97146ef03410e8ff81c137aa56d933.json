{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Read It Later", "short_name": "readitlater", "description": "Save pages to read later and quickly open your list.", "version": "2.1", "icons": {"32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "action": {"default_title": "Read It Later", "default_popup": "popup.html"}, "permissions": ["storage", "tabs", "contextMenus"], "background": {"service_worker": "service_worker.js", "type": "module"}, "omnibox": {"keyword": "read"}, "options_page": "options.html", "commands": {"add-current-tab": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Add current tab to Read It Later"}, "open-list": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open full list page"}}}