{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Frosted", "description": "Your feed, filtered. Blurs cringe posts on LinkedIn.", "version": "1.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "sidePanel"], "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_title": "Frosted", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}