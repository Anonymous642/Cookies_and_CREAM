{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clone", "version": "1.0.5", "description": "Extract web page context into AI-ready markdown: tech stack, design tokens, structure, and readable content locally.", "permissions": ["activeTab", "storage", "downloads", "contextMenus"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["libs/technologies.js", "libs/readability.js", "libs/turndown.js", "utils/config.js", "utils/token-counter.js", "utils/tech-detector.js", "utils/color-classifier.js", "utils/design-extractor.js", "utils/font-detector.js", "utils/component-detector.js", "utils/structure-mapper.js", "utils/table-extractor.js", "utils/content-extractor.js", "utils/tailwind-generator.js", "utils/export-manager.js", "utils/api-detector.js", "utils/behavior-detector.js", "utils/flow-mapper.js", "utils/responsive-analyzer.js", "utils/context-formatters.js", "utils/context-builder.js", "libs/html2canvas.min.js", "utils/screenshot-compressor.js", "utils/screenshot-capture.js", "utils/font-inspector.js", "content_script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["preview/*"], "matches": ["<all_urls>"]}], "commands": {"extract": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Extract page context"}}, "minimum_chrome_version": "116", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}