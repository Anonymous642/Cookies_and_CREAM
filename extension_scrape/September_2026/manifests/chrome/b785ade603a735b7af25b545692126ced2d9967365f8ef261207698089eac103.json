{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CQwerty Shield", "version": "1.2.0", "description": "See the security grade for every website you visit. SSL, DMARC, and HTTP headers \u2014 one click.", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://api.cqwerty.com/*", "https://cqwerty.com/*", "https://*.cqwerty.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://cqwerty.com/*", "https://*.cqwerty.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Check the security of the current site"}}}