{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AslGrab", "version": "2.5.4", "description": "Chrome extension for e-commerce professionals. Collect ASINs, filter products and store the products you find.", "permissions": ["storage", "activeTab", "tabs", "bookmarks", "alarms", "scripting", "unlimitedStorage"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "https://www.ebay.com/*", "https://aslacademy.io/*", "https://aslscout.com/*", "https://app.aslscout.com/*", "https://app.asldrop.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*"], "js": ["content.js", "content_amazon.js"], "run_at": "document_end"}, {"matches": ["https://www.amazon.com/*"], "js": ["content_address.js"]}, {"matches": ["https://www.ebay.com/itm/*", "https://www.ebay.com/sch/*"], "js": ["content_ebay.js"]}, {"matches": ["https://aslscout.com/*", "https://app.aslscout.com/*"], "js": ["aslscout_bridge.js"], "run_at": "document_start"}, {"matches": ["https://app.asldrop.com/*"], "js": ["asldrop_bridge.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/ebay-search-icon.png", "fonts/*.woff2"], "matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*"]}, {"resources": ["images/amazon-search-icon.png"], "matches": ["https://www.ebay.com/*"]}]}