{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Dark Mode Google Drive", "version": "1.0.1", "description": "Activate this extension to enable a dark mode theme exclusively for Google Drive.", "manifest_version": 3, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["content.js"], "css": ["styles/buttons.css"]}], "icons": {"128": "images/icon.png"}, "action": {"default_icon": "images/icon.png"}, "permissions": ["storage", "notifications", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["styles/darkmode.css", "images/icon.png"], "matches": ["https://drive.google.com/*"]}]}