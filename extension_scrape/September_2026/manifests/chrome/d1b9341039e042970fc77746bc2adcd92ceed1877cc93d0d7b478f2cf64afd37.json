{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Music Mode", "version": "1.0.0", "description": "Hides video visuals on YouTube and YouTube Music while keeping audio and UI intact.", "icons": {"16": "icon/icon-16.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "action": {"default_icon": {"16": "icon/icon-16.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}}, "commands": {"toggle-music-mode": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Toggle Music Mode"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://music.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}