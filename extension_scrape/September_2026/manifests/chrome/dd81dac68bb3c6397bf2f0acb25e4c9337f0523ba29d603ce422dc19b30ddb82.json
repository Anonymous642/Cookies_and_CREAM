{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Feed Filter", "description": "Semantic content filter for Reddit \u2014 hides posts matching your own rules, entirely client-side.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "offscreen"], "host_permissions": ["*://*.reddit.com/*", "https://extensionpay.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://extensionpay.com"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Reddit Feed Filter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content-scripts/content.js"]}]}