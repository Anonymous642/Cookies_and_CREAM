{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etymon", "short_name": "Etymon", "version": "0.1.4", "description": "Trace the origin of a selected word without sending the page around it.", "minimum_chrome_version": "116", "incognito": "not_allowed", "permissions": ["storage", "contextMenus", "sidePanel", "identity", "scripting", "activeTab"], "host_permissions": ["https://etymon-ai.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Trace a word with Etymon", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "panel.html"}, "commands": {"trace-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Trace the selected word with Etymon"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"}, "web_accessible_resources": [{"resources": ["fonts/noto-serif-latin.woff2", "fonts/noto-serif-greek.woff2"], "matches": ["http://*/*", "https://*/*"]}]}