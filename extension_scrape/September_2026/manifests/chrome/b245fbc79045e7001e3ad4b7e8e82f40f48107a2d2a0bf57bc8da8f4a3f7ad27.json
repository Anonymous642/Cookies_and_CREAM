{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zautomatic Apply \u2014 AI CV Tailor & Job Application Autofill", "short_name": "Zautomatic Apply", "version": "1.0.0", "description": "Tailor CVs and cover letters with your chosen AI, then review and fill job applications. Your data stays in Chrome.", "minimum_chrome_version": "120", "permissions": ["storage", "unlimitedStorage", "downloads", "debugger", "webNavigation", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://accounts.google.com/*"], "js": ["filler.js", "portal-content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Zautomatic Apply", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "options_page": "dashboard/index.html", "commands": {"capture-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the active job or form page"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Open Zautomatic Apply"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; frame-src 'self' blob: data:; img-src 'self' data: blob:; font-src 'self' data:"}}