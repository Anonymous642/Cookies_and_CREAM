{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SunoFlow Connector", "version": "1.0.0", "description": "Securely connect your Suno account to SunoFlow. Log in to Suno as usual \u2014 the extension links your session to SunoFlow.", "permissions": ["cookies", "tabs", "storage", "scripting"], "host_permissions": ["https://suno.com/*", "https://*.suno.com/*", "https://sunoflow.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "SunoFlow \u2014 connect Suno", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://sunoflow.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}