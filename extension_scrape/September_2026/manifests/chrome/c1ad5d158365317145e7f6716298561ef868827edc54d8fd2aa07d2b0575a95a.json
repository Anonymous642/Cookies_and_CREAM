{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VidSeen", "version": "1.2.31", "description": "Record your screen or screenshot this tab, then share a link and see who watched.", "action": {"default_popup": "popup.html", "default_title": "VidSeen"}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "desktopCapture", "offscreen", "storage", "identity", "tabs", "clipboardWrite", "scripting"], "host_permissions": ["https://app.vidseen.com/*", "https://login.vidseen.com/*", "https://*.blob.core.windows.net/*"], "commands": {"screenshot": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Screenshot this tab"}, "record": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Record screen, window, or tab"}, "screenshot-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Screenshot the full page"}}}