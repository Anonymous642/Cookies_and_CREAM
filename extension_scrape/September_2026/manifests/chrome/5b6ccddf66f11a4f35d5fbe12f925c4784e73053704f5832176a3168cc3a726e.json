{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QR Code Allrounder \u2013 Scanner & Generator", "short_name": "QR Allrounder", "version": "2.0.1", "description": "Scan QR codes & barcodes via camera, upload, or on-page. Generate custom QR codes and turn results into one-tap smart actions.", "author": "Suryagopal Dhara", "homepage_url": "https://suryacreates.com/sponsor", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "QR Code Allrounder \u2014 Scan, Generate & Auto-Detect"}, "background": {"service_worker": "background/background.js"}, "permissions": ["activeTab", "scripting", "storage", "commands", "tabs", "contextMenus", "clipboardWrite"], "optional_host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/scanner.bundle.js", "lib/actions.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"toggle-region-scan": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Draw a region on screen to scan for QR/barcodes"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}