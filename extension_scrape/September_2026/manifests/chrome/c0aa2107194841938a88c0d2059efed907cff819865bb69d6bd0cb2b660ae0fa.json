{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Sounds disabler for play-cs.com", "description": "An extension to mute sounds on play-cs.com by sTh", "author": "sTh", "version": "1.1.1", "manifest_version": 3, "icons": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "action": {"default_title": "Sounds disabler", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/logo-16.png"}}, "permissions": ["tabs", "activeTab"], "content_security_policy": {}, "host_permissions": ["https://game.play-cs.com/"], "background": {"service_worker": "src/service-worker.js"}, "web_accessible_resources": [{"resources": ["src/reload.js"], "matches": ["https://game.play-cs.com/*"]}], "content_scripts": [{"js": ["src/foreground.js"], "matches": ["https://game.play-cs.com/*"], "run_at": "document_start"}]}