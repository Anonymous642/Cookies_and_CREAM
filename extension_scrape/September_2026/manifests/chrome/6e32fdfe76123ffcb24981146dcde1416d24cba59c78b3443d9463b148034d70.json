{"update_url": "https://clients2.google.com/service/update2/crx", "name": "IUM4Cloud Forge Browser Extensions", "short_name": "IUMBrowser", "description": "IUM4Cloud Forge Browser extensions to extend Atlassian cloud functionality", "version": "1.1.3", "manifest_version": 3, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.atlassian.net/*", "https://*.atlassian.net/servicedesk/*", "https://*.atlassian.net/wiki/*", "https://*.atl-paas.net/*", "https://*.cdn.prod.atlassian-dev.net/*", "https://admin.atlassian.com/*", "https://id.atlassian.com/join/user-access*"], "js": ["content.js"], "all_frames": true, "run_at": "document_end"}], "content_security_policy": {"extension_pages": "connect-src 'self' https://*.atlassian.net; default-src 'self'; script-src 'self'; object-src 'self'; img-src * data:; style-src 'self' 'unsafe-inline'; style-src-elem 'self' https://cdn.jsdelivr.net 'unsafe-inline';"}, "permissions": ["storage", "tabs", "webRequest", "webNavigation"], "host_permissions": ["https://connect-cdn.atl-paas.net/*", "https://*.atl-paas.net/*", "https://*.cdn.prod.atlassian-dev.net/*", "https://admin.atlassian.com/*", "https://id.atlassian.com/*", "https://*.atlassian.net/*"], "icons": {"16": "/images/logo16.png", "32": "/images/logo32.png", "48": "/images/logo48.png", "128": "/images/logo128.png"}}