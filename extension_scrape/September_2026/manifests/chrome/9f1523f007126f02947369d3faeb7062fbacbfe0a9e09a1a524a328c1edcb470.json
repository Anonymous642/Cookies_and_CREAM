{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cell Row Column Highlighter for Spreadsheets", "short_name": "Cell Highlighter", "version": "1.0.0", "description": "Highlight the active row, column or cell in Google Sheets and Excel. Pick any color, per-spreadsheet and per-tab settings.", "homepage_url": "https://sheetcity.com/products/cell-row-column-highlighter/", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/spreadsheets/d/*", "https://*.officeapps.live.com/x/*"], "js": ["scripts/shared/settings.js", "scripts/content/locators/SheetsActiveCellLocator.js", "scripts/content/locators/ExcelActiveCellLocator.js", "scripts/content/HighlighterApp.js", "scripts/content/main.js"], "all_frames": true, "run_at": "document_idle"}], "action": {"default_title": "Cell Row Column Highlighter"}, "side_panel": {"default_path": "pages/sidepanel.html"}, "background": {"service_worker": "scripts/background.js"}, "permissions": ["storage", "sidePanel"], "commands": {"toggleRow": {"description": "Toggle row highlight"}, "toggleColumn": {"description": "Toggle column highlight"}, "toggleBoth": {"description": "Toggle crosshair (row + column)"}}}