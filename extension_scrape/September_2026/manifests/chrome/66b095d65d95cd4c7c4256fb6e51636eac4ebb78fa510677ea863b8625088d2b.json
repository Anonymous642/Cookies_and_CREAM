{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PhraseInsight: Expand Vocabulary While Reading", "short_name": "PhraseInsight", "version": "1.0.7", "description": "Seamlessly learn languages for FREE by expanding vocabulary and understanding contextual meanings while reading on web.", "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "host_permissions": ["http://mafishere.pythonanywhere.com/*", "https://mafishere.pythonanywhere.com/*"], "permissions": ["commands", "storage"], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*.woff", "fonts/*.woff2"], "matches": ["<all_urls>"]}], "commands": {"open_popup": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Open popup by pressing Alt+Shift+R"}}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "css": ["styles/styles.css"]}]}