{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Display tumblr images natively in browser", "short_name": "tumblrImgNat", "description": "Displays tumblr image links directly in the browser by modifying the HTTP Accept header.", "version": "1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "author": "Jonathan Kay", "homepage_url": "https://jonathankay.com/tumblrimgbrowser/", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.media.tumblr.com/*", "*://*.tumblrusercontent.com/*", "*://assets.tumblr.com/*"], "declarative_net_request": {"rule_resources": [{"id": "tumblrimgrules", "enabled": true, "path": "rules.json"}]}}