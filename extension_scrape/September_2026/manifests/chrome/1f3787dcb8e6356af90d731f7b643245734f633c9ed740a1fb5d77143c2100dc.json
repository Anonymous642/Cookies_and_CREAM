{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Incognito Saver", "version": "0.5.5", "description": "Save & Restore Incognito Tabs", "action": {"default_icon": "assets/icon-512.png", "default_popup": "dist/popup/index.html"}, "options_ui": {"page": "dist/options/index.html", "open_in_tab": true}, "background": {"service_worker": "dist/background/index.mjs"}, "icons": {"16": "assets/icon-512.png", "48": "assets/icon-512.png", "128": "assets/icon-512.png"}, "permissions": ["tabs", "storage", "scripting", "contextMenus", "sidePanel", "alarms"], "optional_permissions": ["notifications"], "host_permissions": ["https://www.youtube.com/*", "https://incognito-saver.pages.dev/*", "https://incognito-saver.inkmate.top/*", "https://saver.inkmate.top/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"open-options": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Incognito Saver Vault (dashboard)"}, "toggle-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle side panel"}}, "side_panel": {"default_path": "dist/sidepanel/index.html"}}