{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SafePaste AI - Privacy Shield", "version": "2.3.0", "description": "Prevents data leaks. Auto-masks API Keys, Tokens, Passwords, PII & Database URIs in text and files before sharing with AI platforms.", "permissions": ["storage"], "host_permissions": ["https://*.chatgpt.com/*", "https://*.claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*", "https://*.deepseek.com/*", "https://*.poe.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat*", "https://*.github.com/*", "https://*.mistral.ai/*", "https://*.blackbox.ai/*", "https://*.groq.com/*", "https://extensionpay.com/*"], "commands": {"open-workspace": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open SafePaste Workspace"}, "toggle-protection": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Toggle Protection On/Off"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-off.png", "48": "icon-off.png", "128": "icon-off.png"}}, "icons": {"16": "icon-on.png", "48": "icon-on.png", "128": "icon-on.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.chatgpt.com/*", "https://*.claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*", "https://*.deepseek.com/*", "https://*.poe.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat*", "https://*.github.com/*", "https://*.mistral.ai/*", "https://*.groq.com/*", "https://*.blackbox.ai/*"], "js": ["ExtPay.js", "redactor.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["ExtPay.js"], "matches": ["https://extensionpay.com/*"]}]}