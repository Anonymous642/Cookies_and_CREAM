{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Flow: Voice Dictation Optimizer for Claude, ChatGPT, Gemini", "version": "1.1.0", "description": "Turn messy voice dictations into clean, effective prompts for Claude, ChatGPT, Gemini, and Meta AI. Built for Wispr Flow users.", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://claude.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://meta.ai/*", "https://www.meta.ai/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.groq.com/*"], "action": {"default_popup": "popup.html", "default_title": "Prompt Flow", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://meta.ai/*", "https://www.meta.ai/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"optimize-and-insert": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Optimize the current prompt and replace it in the chat input"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}