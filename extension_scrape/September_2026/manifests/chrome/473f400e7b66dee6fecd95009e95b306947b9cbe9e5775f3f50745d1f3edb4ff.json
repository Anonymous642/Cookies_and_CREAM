{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Basedball", "version": "0.1.4", "description": "Giving you the ability to watch 15 games per day without missing a single pitch!", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.mlb.com/*", "https://statsapi.mlb.com/*", "https://sync.basedball.pro/*"], "content_scripts": [{"matches": ["https://www.mlb.com/*"], "js": ["scripts/contentMain.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["scripts/*.js", "assets/*.json", "styles/*.css"], "matches": ["https://www.mlb.com/*"]}]}