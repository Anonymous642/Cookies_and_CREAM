{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkToChat (for Twitch)", "description": "Send the active tab's URL straight to your Twitch chat, right from your browser toolbar.", "version": "1.0.0", "icons": {"16": "/icons/icon-16.png", "32": "/icons/icon-32.png", "48": "/icons/icon-48.png", "128": "/icons/icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "identity", "scripting", "alarms"], "host_permissions": ["https://id.twitch.tv/*", "https://api.twitch.tv/*"], "action": {"default_popup": "popup.html", "default_title": "LinkToChat"}, "options_ui": {"page": "options.html"}, "commands": {"send-link": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open LinkToChat to send the current link"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://id.twitch.tv https://api.twitch.tv;"}, "background": {"service_worker": "background.js"}}