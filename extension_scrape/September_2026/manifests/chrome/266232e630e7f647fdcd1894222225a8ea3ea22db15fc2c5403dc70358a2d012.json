{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ApplyFuel", "description": "You shouldn't have to apply 50 times alone. Tailored CV, real cover letter, and every form answer \u2014 in 60 seconds.", "version": "1.3.0", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "key": "", "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting", "clipboardRead", "identity"], "optional_host_permissions": ["https://*/*"], "action": {"default_title": "ApplyFuel", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "commands": {"open-panel": {"suggested_key": {"default": "Alt+S", "mac": "Command+Shift+S"}, "description": "Open ApplyFuel panel"}, "extract-job": {"suggested_key": {"default": "Alt+E", "mac": "Command+Shift+E"}, "description": "Extract job from current page"}, "generate-email": {"suggested_key": {"default": "Alt+G", "mac": "Command+Shift+G"}, "description": "Generate email"}, "copy-email": {"description": "Copy last generated email"}, "home": {"suggested_key": {"default": "Alt+H", "mac": "Command+Shift+H"}, "description": "Go to Home (dashboard)"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}