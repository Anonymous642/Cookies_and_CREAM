{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yohling: Learn Mandarin With Manhua", "version": "0.8.2", "description": "Passive Mandarin vocabulary acquisition while reading manhua. Hover any Chinese word for pinyin, meaning, and save.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "offscreen"], "host_permissions": ["https://yohling-worker.yohling.workers.dev/*", "https://yohling.com/*"], "action": {"default_popup": "popup.html", "default_title": "Yohling"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["vendor/*", "tess/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}