{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot Tool", "version": "1.0", "description": "Capture screenshots of the visible area, selected area, or the full webpage.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Take Screenshot", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the visible area of the page"}, "capture-selected": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Capture a selected area of the page"}}}