{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabWorker Relay", "description": "Run your agent's browser tasks in tabs you authorize. Review access, confirm sensitive actions, and stop any job.", "version": "0.1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "125", "permissions": ["storage", "alarms", "debugger"], "host_permissions": ["https://*/*", "http://127.0.0.1/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}, "action": {"default_title": "TabWorker Relay", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}}