{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slides Timer", "version": "1.0.1", "description": "Live timer overlay for Google Slides presentations with countdown, stopwatch, and wall clock modes.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://docs.google.com/presentation/*/present*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/presentation/*"], "js": ["src/timer-engine.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "src/popup.html", "default_title": "Slides Timer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-timer": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start/pause timer"}, "reset-timer": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Reset timer"}}, "web_accessible_resources": [{"resources": ["shared/*"], "matches": ["https://docs.google.com/*"]}], "homepage_url": "https://github.com/yourusername/slides-timer", "minimum_chrome_version": "109"}