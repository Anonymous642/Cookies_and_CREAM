{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CFX Concussion Companion", "description": "Track concussion symptoms in a short daily check-in and make web pages easier on your senses. Your data stays on your device.", "version": "0.1.0", "short_name": "CFX Companion", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "alarms", "notifications", "idle", "scripting", "activeTab"], "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "Open CFX Concussion Companion"}, "commands": {"toggle-comfort": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Turn comfort mode on or off for this site"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}