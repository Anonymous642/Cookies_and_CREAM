{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlitzReels - Save video moments", "description": "Save YouTube timestamps and notes. Find your saved moments in the BlitzReels popup and return to the original video.", "version": "1.4.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "homepage_url": "https://blitzreels.com", "minimum_chrome_version": "127", "permissions": ["storage"], "action": {"default_title": "BlitzReels - Saved moments", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/youtube.js"], "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["content-scripts/youtube.css"], "use_dynamic_url": true, "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}]}