{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmarcs", "short_name": "Bookmarcs", "description": "A bookmark sidebar for Chrome. A pin is a tab with a home, and home is one click back. Your open tabs sit right underneath.", "version": "1.5.8", "minimum_chrome_version": "116", "action": {"default_title": "Bookmarcs \u2014 pins that know home", "default_icon": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}}, "icons": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"toggle-sidebar": {"description": "Open or hide Bookmarcs sidebar", "suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}}}, "externally_connectable": {"matches": ["https://bookmarcs.app/*", "https://www.bookmarcs.app/*", "https://bookmarcs-www.adaptrex.workers.dev/*"]}, "permissions": ["storage", "tabs", "windows", "sidePanel", "cookies", "scripting", "favicon"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["https://bookmarcs-api.adaptrex.workers.dev/*", "https://clerk.bookmarcs.app/*", "https://accounts.bookmarcs.app/*", "https://*.clerk.com/*"]}