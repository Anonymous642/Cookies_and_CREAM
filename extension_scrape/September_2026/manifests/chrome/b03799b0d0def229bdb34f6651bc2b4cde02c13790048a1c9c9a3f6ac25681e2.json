{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paneward \u2014 Browser Privacy Lock", "short_name": "Paneward", "version": "1.0.1", "description": "Cover open Chrome web pages with a password or PIN. Auto-lock when idle or on startup.", "minimum_chrome_version": "121", "homepage_url": "https://paneward.bhavik.id/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Paneward", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "permissions": ["storage", "idle", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/lock-curtain.js"], "run_at": "document_start", "all_frames": false}], "commands": {"lock-browser": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock browsing now"}}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://paneward-relay.panewardnew.workers.dev; object-src 'none'; base-uri 'none'; form-action 'none'"}, "optional_permissions": ["notifications"]}