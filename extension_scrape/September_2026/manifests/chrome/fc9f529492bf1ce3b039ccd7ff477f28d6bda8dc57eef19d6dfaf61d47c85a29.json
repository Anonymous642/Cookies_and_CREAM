{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Explayn \u2014 highlight to understand", "version": "1.15.0", "description": "Highlight anything on any page for an instant explanation, or have it read aloud with each word lit up as it is spoken.", "permissions": ["storage", "contextMenus", "scripting", "activeTab", "sidePanel", "nativeMessaging"], "host_permissions": ["<all_urls>", "https://www.explayn.com.au/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["speech.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Explayn", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_page": "options.html", "side_panel": {"default_path": "panel.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"ask": {"description": "Ask Explayn anything \u2014 a question of your own, nothing need be selected"}, "explain-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+MacCtrl+E"}, "description": "Explain the highlighted text"}, "screenshot-screen": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+MacCtrl+A"}, "description": "Screenshot the whole screen"}, "screenshot-region": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+MacCtrl+S"}, "description": "Screenshot a selected area"}, "read-aloud": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+MacCtrl+R"}, "description": "Read the highlighted text aloud \u2014 or the whole page"}, "read-region": {"description": "Read a selected area of the screen aloud"}, "lucid-mode": {"description": "Explayn mode \u2014 point at anything, even words you can\u2019t select, and ask about it"}}, "optional_host_permissions": ["https://*/*", "http://*/*"]}