{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Message Bookmark for ChatGPT", "version": "1.1.0", "description": "Bookmark ChatGPT messages and snippets. Save and navigate bookmarks directly inside the ChatGPT interface.", "minimum_chrome_version": "110", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["utils/uuid.js", "utils/storage.js", "utils/configService.js", "utils/messageModel.js", "utils/messageRegistry.js", "utils/healthMonitor.js", "utils/dom.js", "utils/navigation.js", "contentScript.js"], "css": ["styles.css", "pill.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon_white.svg"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}