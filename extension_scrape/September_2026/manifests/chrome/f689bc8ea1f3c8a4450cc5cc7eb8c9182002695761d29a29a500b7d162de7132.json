{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "G-Route - Auto Google Account Switcher", "version": "2.3.1", "description": "Set default Google accounts per service. YouTube \u2192 personal, Drive \u2192 work. Never click 'Switch account' again.", "permissions": ["storage", "declarativeNetRequest", "tabs", "scripting", "cookies"], "declarative_net_request": {"rule_resources": []}, "host_permissions": ["*://*.google.com/*", "*://gmail.com/*", "*://*.gmail.com/*", "*://*.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}}