{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Obsidian Task Manager Plugin - Browser Extension", "version": "1.0.3", "description": "Create Obsidian Task Manager tasks from webpages, selected text, and Gmail emails.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Create Obsidian task", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "contextMenus", "notifications"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/common.js", "content/gmail.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}