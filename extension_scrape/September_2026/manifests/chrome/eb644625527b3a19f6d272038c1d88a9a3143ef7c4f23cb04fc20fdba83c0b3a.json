{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabManager", "version": "1.0.0", "description": "Suspend tabs into an organized stash with smart categorization, fast fuzzy search, and optional Notion sync.", "permissions": ["tabs", "storage", "activeTab", "scripting", "alarms"], "host_permissions": ["https://*.workers.dev/*", "https://api.notion.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "commands": {"stash-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Stash the current tab"}}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}}