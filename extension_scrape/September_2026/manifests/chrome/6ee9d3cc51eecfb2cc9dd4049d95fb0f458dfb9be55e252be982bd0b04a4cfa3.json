{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Class Countdown Timer", "version": "1.5.3", "description": "A countdown timer extension for tracking class times.", "icons": {"128": "icon.png"}, "action": {"default_popup": "popup.html", "default_title": "Timer Settings"}, "permissions": ["storage"], "host_permissions": ["https://timeapi.io/*", "https://api.fontsource.org/*"], "background": {"service_worker": "background.js"}, "commands": {"open-timer": {"suggested_key": {"mac": "Command+Shift+Y", "windows": "Ctrl+Shift+Y", "linux": "Ctrl+Shift+Y", "default": "Ctrl+Shift+Y"}, "description": "Open timer window"}, "edit-timer": {"suggested_key": {"mac": "Command+Shift+D", "windows": "Ctrl+Shift+D", "linux": "Ctrl+Shift+D", "default": "Ctrl+Shift+D"}, "description": "Edit timer"}}}