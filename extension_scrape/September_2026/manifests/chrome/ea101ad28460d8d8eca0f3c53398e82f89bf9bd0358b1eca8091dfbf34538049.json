{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrandBeacon", "short_name": "BrandBeacon", "description": "Automatically engage with viral posts in your brand voice and run LinkedIn outreach campaigns \u2014 all on autopilot.", "version": "1.0.1", "homepage_url": "https://www.brandbeacon.dev", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "BrandBeacon"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/platforms/twitter/index.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content-scripts/platforms/instagram/index.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["content-scripts/platforms/linkedin/index.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["content-scripts/platforms/tiktok/index.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "tabs", "sidePanel", "alarms", "notifications"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*", "https://www.tiktok.com/*", "https://tiktok.com/*", "https://www.brandbeacon.dev/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}