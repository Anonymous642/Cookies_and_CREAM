{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Sidebar Controller + Persistent Window", "version": "1.0.0", "description": "Control ChatGPT or Grok in a persistent popup window with keyboard shortcuts and dock mode", "permissions": ["tabs", "storage", "windows", "system.display", "sidePanel"], "host_permissions": ["https://chatgpt.com/*", "https://grok.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://chat.deepseek.com/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AI Sidebar Controller"}, "commands": {"toggle-persistent-window": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "Toggle or focus persistent window"}, "toggle-dock-mode": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Toggle Dock Mode on/off"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}