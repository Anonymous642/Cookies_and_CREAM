{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReturnKit Capture", "version": "0.4.1", "description": "Save links, selected text and whole pages to your ReturnKit Capture inbox: one click, a right-click, or Alt+Shift+S.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to ReturnKit", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"save-to-returnkit": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current page to ReturnKit"}}, "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://api.returnkit.life/*", "https://returnkit.life/*", "https://www.returnkit.life/*"], "content_scripts": [{"matches": ["https://returnkit.life/*", "https://www.returnkit.life/*"], "js": ["connect.js"], "run_at": "document_idle"}]}