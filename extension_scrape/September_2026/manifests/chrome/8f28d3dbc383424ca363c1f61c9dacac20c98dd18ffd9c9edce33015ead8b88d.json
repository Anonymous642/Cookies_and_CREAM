{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Video Shutoff", "version": "1.0.0", "description": "Black out the YouTube video while audio and controls keep working. Click the toolbar icon to toggle.", "author": {"email": "reidghomola@gmail.com"}, "homepage_url": "https://github.com/ReidHomola/yt-video-shutoff", "permissions": ["storage"], "action": {"default_title": "Toggle YT Video Shutoff", "default_icon": {"16": "icons/icon16-off.png", "48": "icons/icon48-off.png", "128": "icons/icon128-off.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}