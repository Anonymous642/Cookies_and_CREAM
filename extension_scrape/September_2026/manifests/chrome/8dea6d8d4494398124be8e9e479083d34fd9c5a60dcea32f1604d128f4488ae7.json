{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RunnieResume", "version": "0.1.2", "description": "Import LinkedIn profiles and tailor resumes with RunnieResume.", "homepage_url": "https://runnieresume.com", "action": {"default_title": "RunnieResume", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-180.png", "128": "icon-180.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-180.png", "128": "icon-180.png"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "tabs", "activeTab", "sidePanel"], "host_permissions": ["https://*.linkedin.com/*", "https://linkedin.com/*", "https://runnieresume.com/*", "https://www.runnieresume.com/*"], "externally_connectable": {"matches": ["https://runnieresume.com/*", "https://www.runnieresume.com/*"]}, "content_scripts": [{"matches": ["https://*.linkedin.com/in/*", "https://linkedin.com/in/*"], "js": ["content-script.js"]}]}