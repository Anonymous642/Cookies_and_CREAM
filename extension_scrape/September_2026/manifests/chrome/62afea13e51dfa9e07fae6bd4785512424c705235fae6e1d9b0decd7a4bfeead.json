{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecruiterFocus - LinkedIn Feed Blocker", "version": "1.0.0", "description": "Block LinkedIn's distracting feed and replace it with a recruiter-focused to-do list. Stay productive while sourcing top talent.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "RecruiterFocus"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}