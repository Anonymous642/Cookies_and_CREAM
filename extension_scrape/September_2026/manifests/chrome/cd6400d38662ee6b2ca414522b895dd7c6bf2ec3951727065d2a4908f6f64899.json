{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TaskLock - Tab Locker & Productivity", "version": "1.0.0", "description": "Ultimate productivity: Lock tabs, block distracting sites, focus timer, analytics. Boost focus and eliminate distractions!", "permissions": ["tabs", "storage", "notifications", "declarativeNetRequest", "alarms", "commands"], "host_permissions": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.reddit.com/*", "*://*.pinterest.com/*", "*://*.linkedin.com/*", "*://*.snapchat.com/*", "*://*.twitch.tv/*", "*://*.spotify.com/*", "*://*.hulu.com/*", "*://*.disneyplus.com/*", "*://*.amazon.com/*", "*://*.ebay.com/*", "*://*.walmart.com/*", "*://*.target.com/*", "*://*.bestbuy.com/*", "*://*.cnn.com/*", "*://*.bbc.com/*", "*://*.fox.com/*", "*://*.msnbc.com/*", "*://*.reuters.com/*", "*://*.bloomberg.com/*", "*://*.wsj.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TaskLock", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "declarative_net_request": {"rule_resources": [{"id": "blocking_rules", "enabled": true, "path": "rules.json"}]}, "commands": {"toggle_focus_mode": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle focus mode"}, "start_timer": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Start/pause timer"}, "lock_current_tab": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock current tab"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}