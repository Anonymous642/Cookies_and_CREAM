{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tempo Fly", "version": "1.0.0", "description": "Adjust tempo and pitch in semitones on YouTube Music. Detect BPM & key. Drop air horns, sirens, and more.", "permissions": ["storage", "tabCapture", "offscreen", "activeTab"], "host_permissions": ["https://music.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tempo Fly", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}