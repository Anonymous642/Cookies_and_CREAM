{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GentuCopy", "version": "3.1", "description": "Captures patient data from Gentu and copies to clipboard in various formats.", "permissions": ["activeTab"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.gentu.io/*", "https://gentucopy.vercel.app/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"copyPatientData": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Copy Patient Details #1"}, "copyInterviewerName": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Copy Inteleviewer Name"}, "copyInterviewerDOB": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Copy Inteleviewer DOB"}, "copyMobileInternational": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Command+Shift+4"}, "description": "Copy Mobile (International)"}}}