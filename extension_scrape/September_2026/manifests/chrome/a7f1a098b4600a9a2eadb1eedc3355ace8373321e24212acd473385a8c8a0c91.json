{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BucketLinks \u2013 Save Anything, Anywhere", "short_name": "BucketLinks", "version": "1.0.0", "description": "Save products from your favorite shopping sites into beautiful visual buckets. India's smartest wishlist extension.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "BucketLinks"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["*://*.amazon.in/*", "*://*.amazon.com/*", "*://*.flipkart.com/*", "*://*.myntra.com/*", "*://*.meesho.com/*", "*://*.nykaa.com/*", "*://*.ajio.com/*", "*://*.snapdeal.com/*", "*://*.ebay.com/*", "*://*.etsy.com/*"], "js": ["scripts/content.js"], "css": ["styles/content.css"]}], "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.amazon.in/*", "*://*.amazon.com/*", "*://*.flipkart.com/*", "*://*.myntra.com/*", "*://*.meesho.com/*", "*://*.nykaa.com/*", "*://*.ajio.com/*", "*://*.snapdeal.com/*", "*://*/*"], "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"save-to-bucket": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Save current page to BucketLinks"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+B"}}}}