{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SAT Toll Booth", "version": "1.0.0", "description": "Block social media until you answer SAT vocabulary questions. Earn your scroll time.", "permissions": ["storage"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*"], "js": ["words.js", "content.js"], "css": ["content.css"], "run_at": "document_start"}], "options_page": "settings/settings.html", "action": {"default_popup": "settings/settings.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["sticky.png"], "matches": ["<all_urls>"]}]}