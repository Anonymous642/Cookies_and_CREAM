{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Oria", "short_name": "Oria", "version": "1.0.5", "description": "The AI that understands your web pages and PDFs and generates summaries, explanations, podcasts, flashcards and much more.", "action": {"default_title": "Oria"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https: http: data: blob:;"}, "permissions": ["storage", "scripting", "tabs", "webRequest", "offscreen"], "host_permissions": ["*://*/*"], "optional_host_permissions": ["file:///*"], "content_scripts": [{"matches": ["*://*/*", "file:///*"], "js": ["content-bootstrap.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"pf-ask": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Ouvrir Oria (ancienne commande)"}, "toggle-panel": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Ouvrir/fermer le panneau Oria"}}, "web_accessible_resources": [{"resources": ["pdfjs/*", "tesseract/*", "tesseract/tessdata/*", "libs/**/*", "content.js", "chunks/*", "offscreen.html", "offscreen.js", "viewer.html", "viewer.js", "auth-callback.html", "auth-callback.js"], "matches": ["*://*/*", "file:///*"]}]}