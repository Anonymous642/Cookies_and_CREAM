{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Backlink Inspector", "description": "Inspect backlinks, link attributes, visibility, and plain-text mentions on the current page.", "version": "1.0.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "minimum_chrome_version": "114", "permissions": ["scripting", "storage", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Inspect backlinks", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}