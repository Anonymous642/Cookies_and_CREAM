{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Duplicator: Custom URL Parameters", "description": "Duplicate the current tab with custom URL parameters.", "version": "7.6.0", "action": {"default_popup": "index.html", "default_icon": "icons/logo128x128.png", "default_title": "Tab Duplicator: Custom URL Parameters"}, "side_panel": {"default_path": "index.html?context=sidepanel"}, "icons": {"16": "icons/logo16x16.png", "32": "icons/logo32x32.png", "48": "icons/logo48x48.png", "128": "icons/logo128x128.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "sidePanel"], "commands": {"_execute_action": {"suggested_key": {"windows": "Ctrl+Shift+L", "mac": "Command+Shift+L", "chromeos": "Ctrl+Shift+L", "linux": "Ctrl+Shift+L"}}}}