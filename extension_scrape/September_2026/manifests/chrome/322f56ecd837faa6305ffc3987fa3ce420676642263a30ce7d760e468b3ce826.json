{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat Memory Transfer", "version": "1.1.0", "description": "Transfer a ChatGPT conversation into a new persistent chat.", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "action": {"default_popup": "popup.html", "default_title": "Chat Memory Transfer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["auto-import.js"], "run_at": "document_idle"}]}