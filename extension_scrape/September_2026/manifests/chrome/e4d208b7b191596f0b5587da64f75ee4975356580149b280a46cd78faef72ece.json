{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Shorts to Standard", "version": "1.0.2", "description": "Automatically converts YouTube Shorts URLs to standard YouTube watch URLs", "permissions": ["declarativeNetRequest", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YouTube Shorts Converter"}, "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect_shorts", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}