{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Streamwise Inspector", "short_name": "SW Inspector", "description": "Validate Streamwise tags in one click and inspect tag details, custom events, and tracking setup on any webpage, directly in Chrome", "version": "1.0.2", "icons": {"48": "toolbox/images/icon_48.png", "128": "toolbox/images/icon_128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["injected/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["*://*.neodatagroup.com/*"]}, "action": {"default_icon": "toolbox/images/icon_128.png", "default_popup": "popup/popup.html"}, "background": {"service_worker": "toolbox/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"all_frames": false, "js": ["toolbox/content.js"], "matches": ["<all_urls>"], "run_at": "document_start"}]}