{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Mark-Up-Timer - Markdown Timestamp Stopwatch", "short_name": "Mark-Up-Timer", "description": "Capture timestamped review notes on any page and copy a clean Markdown checklist. State stays local.", "version": "1.1.2", "manifest_version": 3, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png", "512": "icons/512.png"}, "action": {"default_title": "Mark\u2011Up\u2011Timer", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background/bg.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.gumroad.com"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://gumroad.com/*", "https://*.gumroad.com/*", "https://uncommonweather.com/*", "https://*.uncommonweather.com/*"], "js": ["legal/config.js", "legal/content-gate.js", "lib/timer-core.js", "content/timer.js"], "css": ["content/timer.css"], "run_at": "document_idle"}], "permissions": ["clipboardWrite", "storage", "alarms"], "host_permissions": ["https://api.gumroad.com/*"], "commands": {"toggle-timer": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Show or hide Mark-Up-Timer on the active page"}}, "minimum_chrome_version": "109", "author": "Uncommon Weather LLC", "homepage_url": "https://www.uncommonweather.com/products/markup-timer.html", "externally_connectable": {"matches": ["https://www.uncommonweather.com/legal/consent-bridge.html"], "accepts_tls_channel_id": false}}