{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Personalize AI Chat", "description": "Personalize your AI chat experience with reading themes, custom fonts, image embedding, TOC sidebar, wide mode, and export options.", "version": "2.0", "action": {"default_title": "Personalize AI Chat"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "downloads", "storage"], "commands": {"export-chat": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Export chat to Markdown, HTML, JSON, or PDF"}, "toggle-wide": {"suggested_key": {"default": "Ctrl+Shift+W", "mac": "MacCtrl+Shift+W"}, "description": "Toggle full-width chat layout"}, "toggle-toc": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Toggle Table of Contents sidebar"}}, "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["fonts/*.woff2", "lib/html2pdf.bundle.min.js"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"]}]}