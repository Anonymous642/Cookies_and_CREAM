{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Save to Azri", "description": "Select text on any page and save it as an Azri flashcard.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "identity"], "host_permissions": ["https://mcp.azri.app/*", "https://azri.app/*"], "minimum_chrome_version": "102", "action": {"default_title": "Save to Azri", "default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_popup": "popup.html"}, "commands": {"save-selection": {"suggested_key": {"default": "Alt+S"}, "description": "Save the selected text to Azri"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}