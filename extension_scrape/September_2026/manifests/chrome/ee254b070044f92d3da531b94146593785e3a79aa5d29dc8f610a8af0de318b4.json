{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tag Assistant search filter", "description": "Add input filter for tags and variables in Google Tag Assistant window. Make it easy to search for relevant tags and variables.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Click to add filters to Google Tag Assistant"}, "background": {"service_worker": "src/service_worker.js"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://tagassistant.google.com/*"], "content_scripts": [{"matches": ["https://tagassistant.google.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}