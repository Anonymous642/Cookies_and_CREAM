{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Too Many Tabs Optimizer", "version": "1.3.1", "description": "If you always end up with 30+ tiny unreadable tabs eating your RAM... this tool automatically deals with the tabs you forgot about.", "permissions": ["tabs", "storage", "alarms", "activeTab", "tabGroups", "scripting", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.bundle.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/unsaved-state-detector.bundle.js"], "run_at": "document_idle"}], "action": {"default_title": "Too Many Tabs Optimizer", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png"}}, "commands": {"tmt-suspend-tab": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Suspend or unsuspend current tab"}, "tmt-sort-tabs": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Sort tabs by usage"}, "tmt-group-tabs": {"suggested_key": {"default": "Ctrl+Shift+G"}, "description": "Group tabs"}, "tmt-ungroup-tabs": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Ungroup all tabs"}}}