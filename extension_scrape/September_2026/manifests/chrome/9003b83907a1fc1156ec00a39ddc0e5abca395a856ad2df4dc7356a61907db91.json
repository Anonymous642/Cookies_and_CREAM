{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nemos: Save Anything", "version": "1.1.2", "description": "Save links, articles, and pages to your Nemos second brain. Organize into folders, add notes and tags.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "tabs", "sidePanel", "alarms"], "host_permissions": ["https://*/*", "https://api.apple-cloudkit.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/chrome/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "exclude_matches": ["https://*.apple.com/*", "https://*.apple-cloudkit.com/*", "https://*.icloud.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}, {"matches": ["https://nemosapp.com/ck-callback", "https://nemosapp.com/ck-callback/", "https://nemosapp.com/ck-callback?*", "https://nemosapp.com/ck-callback/?*"], "js": ["ck-callback-bridge.js"], "run_at": "document_start"}], "options_page": "src/chrome/options/index.html", "side_panel": {"default_path": "src/chrome/sidepanel/index.html"}, "commands": {"save-to-nmos": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Nemos"}}}