{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NDEV: Task Tracker", "description": "A task tracker extension, designed for quick task tracking", "version": "0.6.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["commands", "sidePanel", "storage"], "web_accessible_resources": [{"resources": ["models/universal-sentence-encoder/*"], "matches": ["<all_urls>"]}], "commands": {"open-new-task-popup": {"suggested_key": {"default": "Alt+Up", "mac": "Command+Up"}, "description": "Open add new Task popup"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}}