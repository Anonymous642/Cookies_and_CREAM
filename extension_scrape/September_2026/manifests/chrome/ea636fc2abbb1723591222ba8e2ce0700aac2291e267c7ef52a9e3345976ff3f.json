{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cloudlaya AI \u2014 Side Panel Assistant", "version": "1.2.1", "description": "Chat with DeepSeek, OpenAI, Claude, Gemini and more in a clean Chrome side panel.", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus", "downloads"], "host_permissions": ["http://*/*", "https://*/*", "https://api.deepseek.com/*", "https://api.openai.com/*", "https://openrouter.ai/*", "https://api.groq.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/panel.html"}, "action": {"default_title": "Open Cloudlaya AI", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the AI side panel"}, "ask-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Ask about the selected text on the page"}}}