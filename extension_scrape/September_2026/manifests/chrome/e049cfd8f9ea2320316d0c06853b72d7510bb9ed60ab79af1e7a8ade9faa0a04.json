{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "theoremEd", "version": "1.0.0", "description": "A math tutor that reads the problem you're stuck on and refuses to give you the answer.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "storage", "activeTab"], "optional_host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://theoremed.com/*", "https://www.theoremed.com/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Open theoremEd"}, "commands": {"look": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open theoremEd and look at this tab"}}}