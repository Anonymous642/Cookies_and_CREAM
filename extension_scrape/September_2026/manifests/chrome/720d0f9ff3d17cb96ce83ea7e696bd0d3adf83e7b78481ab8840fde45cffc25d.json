{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QA Evidence Pack", "version": "0.2.0", "description": "Capture a private, structured manual QA session and export the evidence locally.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "downloads", "sidePanel"], "action": {"default_title": "Open QA Evidence Pack", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "popup.html"}, "commands": {"capture-step": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture a page-state step"}, "mark-pass": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Mark the session passed"}, "mark-fail": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Mark the session failed"}}, "background": {"service_worker": "service-worker.js", "type": "module"}}