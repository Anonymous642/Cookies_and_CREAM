{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "I Remember: bug replay for QA", "short_name": "I Remember", "version": "1.0.0", "description": "Can't remember the steps? I do. Save the last 30s of your test as video, repro steps, console errors and network logs.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "I Remember", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "scripting", "webRequest", "webNavigation", "downloads", "storage", "activeTab"], "host_permissions": ["<all_urls>"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start / stop recording the current tab"}, "save-replay": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the last N seconds (default length from settings)"}}}