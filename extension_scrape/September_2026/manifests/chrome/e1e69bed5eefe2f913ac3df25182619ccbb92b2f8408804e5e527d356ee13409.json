{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Resume", "version": "1.0.0", "description": "Automatically track unfinished YouTube videos and organize them in folders.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "YT Resume", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}