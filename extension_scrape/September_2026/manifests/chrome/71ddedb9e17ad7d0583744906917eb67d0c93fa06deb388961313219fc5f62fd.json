{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Synergy - Web to Figma", "version": "1.1.7", "description": "Export the current page to .figh format for import into Figma using the Synergy plugin.", "permissions": ["activeTab", "scripting", "windows", "debugger", "downloads"], "host_permissions": ["*://*/*", "file:///*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png", "icons/icon128.png", "icons/w-icon128.png"], "matches": ["<all_urls>"]}]}