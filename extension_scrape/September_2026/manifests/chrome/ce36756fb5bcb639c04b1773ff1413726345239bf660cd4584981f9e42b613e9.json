{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TagBoost - Listing Text Optimizer", "version": "1.5.3", "description": "Generate better listing text from a product image: title, description and tags. Designed for Etsy and Redbubble sellers.", "permissions": ["tabs", "activeTab", "storage", "windows", "commands", "system.display"], "host_permissions": ["https://*.etsy.com/*", "https://*.redbubble.com/*", "https://api.openai.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TagBoost"}, "content_scripts": [{"matches": ["https://*.redbubble.com/*", "https://*.etsy.com/*"], "js": ["scripts/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup.html", "scripts/popup.js", "scripts/config.js", "styles/*.css", "images/*.jpg", "images/*.png", "videos/*.mp4"], "matches": ["<all_urls>"]}], "icons": {"48": "assets/TB_Logo48.png", "128": "assets/TB_Logo128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}