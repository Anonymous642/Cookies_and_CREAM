{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "React-DomPicker", "version": "1.2.3", "description": "Click any UI element to instantly jump to its React source code in VS Code. Perfect for React + Tailwind + ShadCN projects.", "author": "Rajitha Disanayaka", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/inactive-16.png", "32": "icons/inactive-32.png", "48": "icons/inactive-48.png"}, "default_title": "React-DomPicker (Click to toggle)", "default_popup": ""}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "commands": {"toggle-picker": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle React-DomPicker on/off"}}, "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "js": ["hook-installer.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}