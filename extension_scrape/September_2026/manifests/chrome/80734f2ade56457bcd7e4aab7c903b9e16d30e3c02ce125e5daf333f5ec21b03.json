{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Capture Studio Pro", "short_name": "Capture Studio Pro", "version": "1.0.0", "description": "Capture, convert et annote n'importe quelle page web en PDF ou image haute qualit\u00e9 \u2014 100% local, sans serveur, sans tracking.", "author": "Web Capture Studio Pro", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Web Capture Studio Pro"}, "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "options_page": "options/options.html", "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage", "tabs", "clipboardWrite", "contextMenus"], "host_permissions": ["<all_urls>"], "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture compl\u00e8te de la page"}, "capture-area": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capture d'une zone"}, "open-editor": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Ouvrir l'\u00e9diteur"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sauvegarde rapide"}}, "web_accessible_resources": [{"resources": ["editor/*", "lib/*", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}