{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FFPC Projections Overlay", "version": "1.2.0", "description": "Overlays your own model's projections as tags on the FFPC draft room player pool, with a panel to choose which metrics to show.", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.aws.dfsdashboard.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "DFS Dashboard \u2014 Projections", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.myffpc.com/*", "https://myffpc.com/*"], "js": ["data.js", "dfs-api.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}