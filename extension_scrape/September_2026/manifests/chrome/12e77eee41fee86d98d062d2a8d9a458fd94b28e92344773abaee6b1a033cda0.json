{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Proofy - Review Importer", "description": "Import your G2 and Trustpilot reviews into Proofy as testimonials.", "version": "0.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "tabs"], "host_permissions": ["https://www.g2.com/products/*", "https://*.trustpilot.com/review/*", "https://images.g2crowd.com/*", "https://lh3.googleusercontent.com/*", "https://user-images.trustpilot.com/*", "https://api-proofy.aivo.one/*", "https://app.proofy.aivo.one/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://app.proofy.aivo.one/extension/pair*"], "all_frames": false, "js": ["content-scripts/pairing.js"]}, {"matches": ["https://*.trustpilot.com/review/*", "https://www.g2.com/products/*"], "js": ["content-scripts/reviews.js"]}]}