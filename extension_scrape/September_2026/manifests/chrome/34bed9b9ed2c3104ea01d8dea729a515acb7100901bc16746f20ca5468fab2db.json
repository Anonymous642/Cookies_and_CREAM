{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Case Converter", "version": "1.0.0", "description": "A simple tool to quickly convert text between uppercase, lowercase, title case, and sentence case.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "contextMenus", "clipboardWrite", "activeTab"], "background": {"service_worker": "background.js"}, "commands": {"convert-uppercase": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Convert selected text to UPPERCASE"}, "convert-lowercase": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Convert selected text to lowercase"}, "convert-titlecase": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Convert selected text to Title Case"}, "convert-auto": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Auto-detect and convert text case"}}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}