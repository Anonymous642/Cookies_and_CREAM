{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Squrlio", "version": "1.1.3", "description": "Stash web research into organized projects. Export as letterheaded PDFs \u2014 built for AEC designers and specifiers.", "author": "Tim Hutch", "homepage_url": "https://squrlio.com", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Squrlio \u2014 open side panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup/popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "tabs", "contextMenus", "clipboardWrite", "sidePanel"], "host_permissions": ["<all_urls>"], "commands": {"capture-description": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Capture highlighted text as Item Description"}, "capture-detail": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Add highlighted text as Item Detail"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture an image region"}, "capture-partnum": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Append highlighted text to Part Number"}}, "web_accessible_resources": [{"resources": ["content/overlay.css", "export/print.html", "export/print.css", "export/print.js", "lib/storage.js"], "matches": ["<all_urls>"]}]}