{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DevNews Radar - Dev News & Tech Watch", "description": "Tech watch for developers: RSS/Atom news, relevance filtering, notes, reading goals, and a visual knowledge map.", "version": "2.5.7", "permissions": ["storage", "alarms", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://news.ycombinator.com/*", "https://www.infoq.com/*", "https://feed.infoq.com/*", "https://techcrunch.com/*", "https://github.blog/*", "https://feeds.feedburner.com/*", "https://blog.jetbrains.com/*", "https://stackoverflow.blog/*", "https://www.theartofcodebook.com/*", "https://theartofcodebook.com/*", "https://www.youtube.com/*", "https://youtube.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open DevNews Radar"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"note-to-journal": {"suggested_key": {"default": "Alt+J"}, "description": "Noter dans le journal / Save to Journal"}}}