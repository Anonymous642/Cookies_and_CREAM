{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AllWeather - Weather Dashboard & Forecasts", "version": "1.0.0", "description": "Free weather dashboard with 16-day forecast, air quality, pollen, radar maps, and a floating weather bar on every page.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "AllWeather"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/weather-bar.js"], "css": ["content/weather-bar.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}