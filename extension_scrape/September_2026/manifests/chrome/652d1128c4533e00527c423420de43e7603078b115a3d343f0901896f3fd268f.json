{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeSteps \u2014 YouTube Visual Notes", "short_name": "TubeSteps", "version": "0.1.5", "description": "Save YouTube tutorial frames, timestamps and captions as local step-by-step notes.", "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "TubeSteps", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"capture-step": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save the current YouTube step"}}, "options_page": "settings.html", "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.youtube.com/*"]}]}