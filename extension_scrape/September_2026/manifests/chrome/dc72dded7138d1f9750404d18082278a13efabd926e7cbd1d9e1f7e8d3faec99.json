{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sippy \u2014 Drink Water Reminder", "version": "1.0.0", "description": "A friendly on-screen buddy who walks in to remind you to drink water. Snooze, log a glass, set your own timings & daily goal.", "permissions": ["alarms", "storage", "notifications", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Sippy \u2014 Drink Water Reminder", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["assets/reminder-girl.webm", "assets/reminder-man.webm"], "matches": ["<all_urls>"]}]}