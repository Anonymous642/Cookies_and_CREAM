{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focusii - Block YouTube, X & Instagram Distractions", "version": "1.5", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "description": "Remove distractions from YouTube, X and Instagram and stay locked in.", "action": {"default_popup": "popup.html"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*"], "web_accessible_resources": [{"resources": ["content.js", "twitter.js", "instagram.js", "pro-indicator.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["twitter.js"], "run_at": "document_end"}, {"matches": ["*://*.instagram.com/*"], "js": ["instagram.js"], "run_at": "document_end"}, {"matches": ["*://*.reddit.com/*"], "js": ["pro-indicator.js"], "run_at": "document_end"}]}