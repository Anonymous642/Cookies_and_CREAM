{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnipNote", "version": "1.1.0", "description": "High-performance screenshot notebook and markdown notes", "permissions": ["sidePanel", "storage", "tabs", "activeTab", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"capture-full-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture screenshot (Window or Full Page)"}, "capture-partial-screenshot": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Capture partial screenshot (drag to select area)"}}, "action": {"default_title": "SnipNote", "default_icon": {"16": "icons/logo-16.png", "48": "icons/logo-48.png"}}, "icons": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}