{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discord Message Translator", "version": "1.0.1", "description": "Adds a 'Translate to English' button to Discord messages on discord.com.", "icons": {"128": "icon.png"}, "background": {"service_worker": "background.js"}, "permissions": ["storage"], "host_permissions": ["https://discord.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*"], "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}