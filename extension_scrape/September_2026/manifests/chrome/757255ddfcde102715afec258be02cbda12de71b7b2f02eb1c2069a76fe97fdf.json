{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "demofable recorder", "version": "1.4.0", "description": "Records a product demo (screen, mic, clicks, navigation) for demofable to auto-edit into a polished walkthrough.", "homepage_url": "https://demofable.com", "permissions": ["tabCapture", "activeTab", "storage", "offscreen", "webNavigation", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "demofable", "default_popup": "launcher.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"stop-recording": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Stop the current demofable recording"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume the current demofable recording"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["pause-clock.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://demofable.com/extension/connect*"], "js": ["content-connect.js"], "run_at": "document_idle"}]}