{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Audible Keys", "version": "1.0.0", "description": "Keyboard shortcuts for the Audible web player: play, skip, speed, chapters, bookmarks. Screen-reader friendly.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.audible.co.uk/*", "https://*.audible.com/*"], "content_scripts": [{"matches": ["https://*.audible.co.uk/webplayer*", "https://*.audible.com/webplayer*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"a-play-pause": {"description": "Play / pause"}, "b-seek-forward": {"description": "Forward 30 seconds"}, "c-seek-back": {"description": "Back 30 seconds"}, "d-next-chapter": {"description": "Next chapter"}, "e-prev-chapter": {"description": "Previous chapter"}, "f-volume-up": {"description": "Volume up"}, "g-volume-down": {"description": "Volume down"}, "h-speed-up": {"description": "Increase speed"}, "i-speed-down": {"description": "Decrease speed"}, "j-reset-speed": {"description": "Reset speed to normal"}, "k-add-bookmark": {"description": "Add a bookmark"}}}