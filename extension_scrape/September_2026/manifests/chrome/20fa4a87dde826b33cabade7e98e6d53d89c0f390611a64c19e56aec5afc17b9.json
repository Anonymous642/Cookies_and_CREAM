{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Learnijoy \u2014 study mode for YouTube & Instagram", "short_name": "Learnijoy", "version": "1.0.2", "description": "Turn YouTube and Instagram into class-wise learning feeds during study hours, or keep study mode always on.", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://www.instagram.com/*", "https://learnitube-ai.learnitube-ai-worker.workers.dev/*", "https://learnijoy.com/*", "https://*.learnijoy.com/*"], "externally_connectable": {"matches": ["https://learnijoy.com/*", "https://www.learnijoy.com/*", "https://school.learnijoy.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://i.ytimg.com data:; font-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["lib/activation.js", "youtube/early.js"], "css": ["youtube/early.css"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["lib/defaults.js", "youtube/yt-dom.js", "youtube/brand.js", "youtube/feed.js", "youtube/filter.js", "youtube/main.js"], "css": ["youtube/content.css"], "run_at": "document_end"}, {"matches": ["https://www.instagram.com/*"], "js": ["instagram/interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*"], "js": ["lib/activation.js", "instagram/early.js"], "css": ["instagram/early.css"], "run_at": "document_start"}, {"matches": ["https://www.instagram.com/*"], "js": ["lib/defaults.js", "instagram/dom.js", "instagram/brand.js", "instagram/feed.js", "instagram/filter.js", "instagram/main.js"], "css": ["instagram/content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons