{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WithoutX", "version": "1.6.1", "description": "Stay focused, break free from addiction. Block distracting sites, track your streak, and get support when you need it most.", "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "cookies"], "host_permissions": ["https://withoutx.org/*", "https://withoutx-staging.org/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "block_rules", "enabled": true, "path": "rules/block_rules.json"}]}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "content/incognito-warning.css", "icons/*"], "matches": ["<all_urls>"]}]}