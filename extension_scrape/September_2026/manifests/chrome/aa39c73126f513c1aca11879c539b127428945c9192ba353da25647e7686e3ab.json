{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vydcut \u2014 YouTube Video Summarizer", "description": "Get key takeaways from any YouTube video in 2 minutes. Cut to what matters.", "version": "1.0.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://vydcut.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["i18n.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"summarize": {"suggested_key": {"default": "Alt+S"}, "description": "Summarize current video"}}}