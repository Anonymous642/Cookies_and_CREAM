{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RedactBeforeSend", "description": "Redact PII locally before pasting customer data into AI tools, support chats, and external forms.", "version": "0.2.0", "permissions": ["activeTab", "clipboardWrite", "contextMenus", "downloads", "storage"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "action": {"default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "RedactBeforeSend", "default_popup": "popup.html"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"service_worker": "src/background.js"}, "commands": {"redact-selection": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Redact the selected text and copy it"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/redactor.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}]}