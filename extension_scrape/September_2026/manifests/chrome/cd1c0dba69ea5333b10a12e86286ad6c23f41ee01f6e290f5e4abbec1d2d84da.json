{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Input Shield AI", "version": "1.0.0", "description": "Automatically protect privacy in LLM interactions by removing sensitive data.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://chatgpt.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*"], "js": ["content.js"], "css": ["content/content.css"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'none'"}, "action": {"default_popup": "popup/popup.html", "default_title": "Input Shield AI"}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["models/*", "*.wasm", "icons/icon16.png", "icons/icon48.png"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*"]}]}