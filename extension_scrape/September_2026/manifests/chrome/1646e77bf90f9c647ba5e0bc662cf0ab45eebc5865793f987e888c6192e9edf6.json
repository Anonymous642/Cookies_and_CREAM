{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Shield Pro \u2014 Ad Blocker for YouTube", "version": "2.0.0", "description": "Advanced YouTube Ad Blocker. Blocks video ads, banners, overlays, pre-rolls & mid-rolls. Lightning fast. Zero ads. Pure YouTube.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://*.googlevideo.com/*", "https://*.doubleclick.net/*", "https://*.google.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "css": ["blocker.css"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YT Shield Pro"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocker.css"], "matches": ["https://www.youtube.com/*"]}]}