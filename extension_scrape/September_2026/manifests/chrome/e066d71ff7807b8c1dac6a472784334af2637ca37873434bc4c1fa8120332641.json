{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitch Viewer Count Hider", "version": "1.0", "description": "Simply hides the viewer count on Twitch streams with channel-specific settings. For streamers who don't want to see their numbers.", "permissions": ["storage"], "host_permissions": ["https://*.twitch.tv/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://*.twitch.tv/*"], "js": ["content.js"], "css": ["styles.css"]}]}