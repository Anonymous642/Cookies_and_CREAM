{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy Clickable Path for Google Drive\u2122", "version": "1.03", "description": "Adds a 'Copy Clickable Path' option to the Google Drive context menu.", "permissions": ["contextMenus", "identity", "storage"], "host_permissions": ["https://drive.google.com/*", "https://docs.google.com/*", "https://www.googleapis.com/*"], "action": {"default_title": "Copy Clickable Path of Selected File"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://drive.google.com/*", "https://docs.google.com/*"], "js": ["content_script.js"], "all_frames": true, "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}