{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteWise \u2013 Clipboard Manager & Intelligent Pasting", "description": "Clipboard manager with history and AI-powered pasting. Use OptionPaste for quick pasting and IntelliPaste for smart auto-fill.", "version": "1.0.2", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["clipboardRead", "clipboardWrite", "storage", "activeTab", "tabs", "webNavigation", "sidePanel", "offscreen"], "commands": {"intellipaste": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "IntelliPaste: Smart form filling"}, "optionpaste": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "OptionPaste: Show clipboard overlay"}}, "action": {"default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "default_title": "PasteWise"}, "side_panel": {"default_path": "sidepanel.html"}, "web_accessible_resources": [{"resources": ["content.js", "tailwind.min.css", "offscreen.html", "offscreen.js"], "matches": ["https://*/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/content.js"]}]}