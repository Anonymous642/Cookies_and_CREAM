{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Key Mode", "description": "Keyboard-driven command palette for Chrome tab and tab group management", "version": "0.3.1", "icons": {"128": "icon/128.png"}, "permissions": ["tabs", "tabGroups", "activeTab", "scripting", "storage", "windows", "bookmarks"], "optional_host_permissions": ["<all_urls>"], "commands": {"key-mode": {"suggested_key": {"default": "Alt+G", "mac": "Option+G"}, "description": "Open Key Mode command palette"}, "scroll-down": {"suggested_key": {"default": "Alt+J", "mac": "Alt+J"}, "description": "Scroll active tab down"}, "scroll-up": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "Scroll active tab up"}, "group-next": {"description": "Navigate to next tab group in current window"}, "group-prev": {"description": "Navigate to previous tab group in current window"}, "tab-next": {"description": "Navigate to next tab in current active group"}, "tab-prev": {"description": "Navigate to previous tab in current active group"}, "tab-1": {"description": "Focus tab 1 in group"}, "tab-2": {"description": "Focus tab 2 in group"}, "tab-3": {"description": "Focus tab 3 in group"}, "tab-4": {"description": "Focus tab 4 in group"}, "tab-5": {"description": "Focus tab 5 in group"}, "tab-6": {"description": "Focus tab 6 in group"}, "tab-7": {"description": "Focus tab 7 in group"}, "tab-8": {"description": "Focus tab 8 in group"}, "tab-9": {"description": "Focus tab 9 in group"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Key Mode", "default_popup": "popup.html"}}