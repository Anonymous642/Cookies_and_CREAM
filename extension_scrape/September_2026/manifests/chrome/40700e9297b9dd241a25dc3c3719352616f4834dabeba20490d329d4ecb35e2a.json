{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabagotchi Pet", "version": "1.1", "description": "A cute virtual pet that lives in your browser tabs \u2014 manage tabs, earn rewards, and watch your pet grow!", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["storage", "tabs", "notifications", "tabGroups", "windows"], "chrome_url_overrides": {"newtab": "newTab.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["images/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open/close the Tab Manager panel"}, "cleanup-duplicates": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Clean up all duplicate tabs"}}}