{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeSync", "version": "1.0.3", "description": "TubeSync lets you set playback speeds, control captions per channel, and enjoy a personalized YouTube watching experience.", "permissions": ["activeTab", "scripting", "tabs", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "js/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://youtu.be/*"], "js": ["js/contentScript.js"], "run_at": "document_idle"}]}