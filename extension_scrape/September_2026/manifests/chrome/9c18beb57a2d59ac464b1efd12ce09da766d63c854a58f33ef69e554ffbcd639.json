{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Memrynote Web Clipper", "description": "Save the page you are reading to Memrynote as a readable note.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["http://127.0.0.1/*"], "optional_host_permissions": ["*://*/*"], "commands": {"capture-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture this page to Memrynote"}}, "browser_specific_settings": {"gecko": {"id": "web-clipper@memrynote.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Memry", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}