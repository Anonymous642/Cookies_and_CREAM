{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vimarks", "short_name": "Vimarks", "version": "1.1.0", "description": "A vim-style command palette for bookmarks, history, and web search.", "homepage_url": "https://gitlab.com/barbaris/vimarks", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "Vimarks", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Open Vimarks"}}, "permissions": ["bookmarks", "history", "storage", "scripting", "activeTab", "search"], "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "fuzzy.js"], "matches": ["<all_urls>"]}]}