{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Query Extractor", "version": "1.1.3", "description": "Automatically extracts and captures search queries from ChatGPT, Claude, and Perplexity", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["debugger", "tabs", "clipboardWrite", "offscreen", "storage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://chatgptextractor.web.app/*", "https://*.firebaseapp.com/*", "https://*.googleapis.com/*", "https://*.cloudfunctions.net/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "AI Query Extractor", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "externally_connectable": {"matches": ["https://chatgptextractor.web.app/*", "https://*.firebaseapp.com/*"]}, "web_accessible_resources": [{"resources": ["success.html", "popup.html", "icons/assets/*.webp"], "matches": ["<all_urls>"]}]}