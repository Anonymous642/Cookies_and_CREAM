{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FrameDeck", "version": "1.1.0", "description": "Use webpages as a slide deck, even when they block embedding. Rotate through tabs with separate timing for each page.", "permissions": ["tabs", "storage", "alarms", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FrameDeck: rotate your tabs"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-rotation": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle tab rotation play/pause"}, "next-tab": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Switch to next tab in rotation"}, "prev-tab": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Switch to previous tab in rotation"}}, "minimum_chrome_version": "120", "optional_host_permissions": ["http://*/*", "https://*/*"]}