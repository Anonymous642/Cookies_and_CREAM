{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SeatInfo: Live Seat Maps for Flight Search", "description": "See live, to-scale seat maps while comparing flights on Google Flights, right in your browser's side panel.", "version": "1.0.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_locale": "en", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage"], "host_permissions": ["https://seatinfo.com/*"], "action": {"default_title": "Open SeatInfo", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle the SeatInfo panel"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://flights.booking.com/*"], "run_at": "document_idle", "js": ["content-scripts/booking.js"]}, {"matches": ["https://www.expedia.co.in/*", "https://www.expedia.com/*"], "run_at": "document_idle", "js": ["content-scripts/expedia.js"]}, {"matches": ["https://www.google.com/travel/flights*"], "run_at": "document_idle", "js": ["content-scripts/gflights.js"]}, {"matches": ["https://www.kayak.com/flights/*"], "run_at": "document_idle", "js": ["content-scripts/kayak.js"]}, {"matches": ["https://www.momondo.com/flight-search/*"], "run_at": "document_idle", "js": ["content-scripts/momondo.js"]}, {"matches": ["https://www.skyscanner.co.in/*", "https://www.skyscanner.com/*", "https://www.skyscanner.net/*"], "run_at": "document_idle", "js": ["content-scripts/skyscanner.js"]}]}