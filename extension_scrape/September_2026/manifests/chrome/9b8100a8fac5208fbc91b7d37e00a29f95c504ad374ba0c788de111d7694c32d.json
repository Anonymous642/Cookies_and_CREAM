{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kalpana Image Catcher", "description": "Catch images from any webpage, download them, or sync directly into your Kalpana canvas and workspace.", "version": "0.1.0", "short_name": "Image Catcher", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "homepage_url": "https://kalpana.one", "permissions": ["activeTab", "tabs", "downloads", "sidePanel", "scripting", "storage", "identity"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Kalpana Image Catcher", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*/*", "file://*/*"], "exclude_matches": ["*://*.app.kalpana.one/*", "*://app.kalpana.one/*"], "js": ["content-scripts/content.js"]}]}