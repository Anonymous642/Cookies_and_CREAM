{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fathom", "version": "0.2.0", "description": "See folder sizes in Google Drive and find what is actually using your storage. No login, zero setup, runs on-device.", "minimum_chrome_version": "116", "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "panel/index.html"}, "action": {"default_title": "Fathom"}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["content/session-bridge.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://drive.google.com/*"], "js": ["content/reveal.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "unlimitedStorage", "sidePanel", "alarms"], "optional_permissions": ["identity"], "host_permissions": ["https://drive.google.com/*"], "optional_host_permissions": ["https://www.googleapis.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}