{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "attuned", "version": "1.0.1", "description": "Real-time classroom status indicator for students", "permissions": ["identity", "identity.email", "storage", "activeTab", "idle", "scripting", "notifications"], "host_permissions": ["http://localhost:4000/*", "http://localhost:4001/*", "https://attuned-broker.onrender.com/*", "https://attuned-ai-server.onrender.com/*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_popup": "popup.html", "default_title": "attuned - Classroom Status"}, "commands": {"toggle-good": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Set status to Good"}, "toggle-confused": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Set status to Confused"}, "toggle-stuck": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Set status to Stuck"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}