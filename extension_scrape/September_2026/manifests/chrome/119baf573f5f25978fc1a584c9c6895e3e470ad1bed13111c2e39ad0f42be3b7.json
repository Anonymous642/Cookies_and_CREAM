{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlightGlass Google Flights", "description": "Google Flights decision workspace: true cost, connection risk, comfort and schedule quality. Local-first, optional AI.", "version": "0.21.6", "short_name": "FlightGlass", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "114", "permissions": ["storage", "sidePanel", "contextMenus", "alarms"], "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open the FlightGlass panel"}}, "host_permissions": ["https://www.google.com/travel/flights*", "https://www.google.com/travel/explore*"], "optional_host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.groq.com/*", "https://api.deepseek.com/*", "https://api.minimax.io/*", "https://api.minimax.chat/*", "http://localhost/*", "http://127.0.0.1/*", "https://www.google.com/search*"], "optional_permissions": ["scripting"], "action": {"default_title": "FlightGlass"}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/travel/flights*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://www.google.com/travel/explore*"], "run_at": "document_idle", "js": ["content-scripts/explore.js"]}]}