{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProductBridge", "description": "Create feedback posts from anywhere", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "cookies"], "host_permissions": ["https://*.productbridge.io/*"], "web_accessible_resources": [{"resources": ["icon/16.png"], "matches": ["https://*.productbridge.io/*", "http://localhost:*/*"]}], "action": {"default_popup": "popup.html", "default_title": "ProductBridge"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.productbridge.io/auth/extension-login*"], "run_at": "document_idle", "js": ["content-scripts/auth-listener.js"]}]}