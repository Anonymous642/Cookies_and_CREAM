{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Graveyard", "version": "1.0.0", "description": "A quiet place for noisy tabs. Bury tabs you don't need right now and restore them later \u2014 everything stays local on your device.", "action": {"default_popup": "index.html", "default_title": "Tab Graveyard", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab"], "commands": {"bury-current-tab": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Bury the current tab"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}