{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TierMakerPro", "description": "Open TierMakerPro make-list in a Chrome side panel with a mobile-friendly layout.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["sidePanel", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://tiermakerpro.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open TierMakerPro", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://tiermakerpro.com/make-list/*"], "js": ["content/upload-compressor.js"], "all_frames": true, "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "allow_make_list_iframe", "enabled": true, "path": "rules/allow_make_list_iframe.json"}]}}