{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CardBeast - CardMarket Bulk Lister", "version": "1.0.2", "description": "Lists your CardBeast-scanned cards on CardMarket from a CSV, at a natural human pace, with a dry-run to check every match first.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "CardBeast - CardMarket Bulk Lister", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.cardmarket.com/*/*/Stock/ListingMethods/ListMixedProducts*"], "js": ["lib/shared.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo.png", "icons/cardmarket-logo.png"], "matches": ["*://*.cardmarket.com/*"]}]}