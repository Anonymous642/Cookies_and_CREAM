{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Visual Detox", "short_name": "Detox", "version": "1.6", "default_locale": "en", "description": "Soften your browsing experience \u2014 swap unwanted images with kittens, puppies, ponies, and more..", "permissions": ["storage"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_title": "Visual Detox"}, "web_accessible_resources": [{"resources": ["images/kitten/*", "images/puppy/*", "images/duckling/*", "images/pony/*", "images/landscape/*"], "matches": ["<all_urls>"]}]}