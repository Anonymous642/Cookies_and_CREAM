{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Split Workspace", "version": "0.1.0", "description": "Arrange multiple browser windows into saved, restorable multi-screen workspaces.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "tabs", "system.display"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Split Workspace", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "options_page": "editor.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}}}}