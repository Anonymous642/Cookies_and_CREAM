{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptDeck: Prompt Manager for ChatGPT, Claude & Gemini", "version": "0.6.0", "description": "Save prompts and insert them into ChatGPT, Claude or Gemini in one keystroke. Command palette, fill-in variables, all local.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "externally_connectable": {"matches": ["https://getpromptdeck.netlify.app/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "PromptDeck"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the PromptDeck palette"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}