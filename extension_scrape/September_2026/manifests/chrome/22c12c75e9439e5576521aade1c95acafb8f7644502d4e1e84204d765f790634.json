{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ORY Sourcing", "version": "1.3.1", "description": "Source a LinkedIn candidate into Orythara \u2014 auto-detect the profile, review, pick a job and services pillar, then add to your CRM.", "storage": {"managed_schema": "policy.json"}, "permissions": ["storage", "activeTab", "scripting", "downloads"], "host_permissions": ["https://www.linkedin.com/*", "https://*.licdn.com/*", "https://app.orythara.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Add candidate to Orythara", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["src/popup/popup.html", "src/popup/popup.css", "src/popup/popup.js", "src/ui/tokens.css", "src/ui/fonts/montserrat-latin-var.woff2"], "matches": ["https://www.linkedin.com/*"]}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["src/content/interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/talent/*"], "js": ["src/lib/selectors.js", "src/lib/calling-codes.js", "src/content/scraper.js", "src/content/content.js"], "run_at": "document_idle"}], "optional_host_permissions": ["https://*/*", "http://localhost/*"]}