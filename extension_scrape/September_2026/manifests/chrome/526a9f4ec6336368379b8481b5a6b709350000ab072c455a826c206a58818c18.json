{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TheWCAG Evidence Capture", "short_name": "TheWCAG", "description": "Mark accessibility barriers on a webpage and turn exact evidence into reviewable findings.", "version": "1.3.0", "homepage_url": "https://app.thewcag.com/chrome-accessibility-extension", "incognito": "not_allowed", "minimum_chrome_version": "116", "permissions": ["activeTab", "alarms", "offscreen", "scripting", "sidePanel", "storage", "tabCapture", "unlimitedStorage"], "optional_permissions": ["nativeMessaging"], "optional_host_permissions": ["https://app.thewcag.com/*"], "externally_connectable": {"matches": ["https://app.thewcag.com/*"]}, "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Mark an accessibility issue", "default_popup": "popup.html"}, "commands": {"capture-element": {"suggested_key": {"default": "Alt+Shift+E", "windows": "Alt+Shift+E", "linux": "Alt+Shift+E", "chromeos": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Capture a component"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+G", "windows": "Alt+Shift+G", "linux": "Alt+Shift+G", "chromeos": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Capture a region"}, "capture-page": {"suggested_key": {"default": "Alt+Shift+F", "windows": "Alt+Shift+F", "linux": "Alt+Shift+F", "chromeos": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture the visible page"}, "record-interaction": {"suggested_key": {"default": "Alt+Shift+I", "windows": "Alt+Shift+I", "linux": "Alt+Shift+I", "chromeos": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Start or stop current-tab interaction recording"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}}