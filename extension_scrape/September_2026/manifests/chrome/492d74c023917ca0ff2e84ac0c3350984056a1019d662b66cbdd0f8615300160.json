{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URLCheck", "description": "Shows the real destination of the current page in large, high-contrast text.", "version": "0.2.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["webNavigation", "webRequest", "tabs", "storage", "alarms"], "host_permissions": [], "optional_host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["fonts/*", "entitlement-jwks.json"], "matches": ["<all_urls>"]}], "commands": {"summon-bubble": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Summon the URLCheck on the current tab"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "URLCheck", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}