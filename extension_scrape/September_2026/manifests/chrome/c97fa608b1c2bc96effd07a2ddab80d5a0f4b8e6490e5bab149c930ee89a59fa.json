{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmark.new", "version": "0.5.6", "description": "Save tabs to Bookmark.new, search your library from the omnibox, and resurface related saves on any page.", "homepage_url": "https://bookmark.new/chrome-extension", "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_title": "Save to Bookmark.new", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "omnibox": {"keyword": "bm"}, "permissions": ["activeTab", "storage", "contextMenus", "alarms", "scripting", "tabs", "sidePanel"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["https://www.bookmark.new/*", "https://bookmark.new/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Bookmark.new save popup"}, "save-page": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Silently save the current tab"}, "toggle-related-overlay": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle related saves overlay on this page"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Open Bookmark.new side panel"}}, "minimum_chrome_version": "116"}