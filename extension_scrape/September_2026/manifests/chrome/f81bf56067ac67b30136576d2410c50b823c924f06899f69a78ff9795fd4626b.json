{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DiagEZ for Mermaid Live", "version": "0.3.2", "description": "Turn Mermaid Live diagrams into embeddable DiagEZ SVG and PNG URLs.", "homepage_url": "https://diagez.com/", "minimum_chrome_version": "88", "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://mermaid.live/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Create a DiagEZ image URL", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}