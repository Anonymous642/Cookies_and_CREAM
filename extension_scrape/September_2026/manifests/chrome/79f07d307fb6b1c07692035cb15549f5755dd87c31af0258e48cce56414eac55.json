{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Open Multi Tabs", "version": "1.0.4", "description": "Paste a list of URLs and open them all at once. Save presets, set delays, open in new window or incognito.", "action": {"default_popup": "popup.html", "default_title": "Open Multi Tabs"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "contextMenus"], "incognito": "split", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-batch": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open the most recent batch of URLs"}}}