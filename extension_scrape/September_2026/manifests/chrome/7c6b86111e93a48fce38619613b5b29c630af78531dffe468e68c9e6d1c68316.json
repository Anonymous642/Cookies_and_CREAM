{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Resume Inspector", "description": "Capture job postings from the current tab and analyze them in Resume Inspector.", "version": "0.1.2", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html", "default_title": "Analyze with Resume Inspector"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://www.resumeinspector.com/*", "https://app.resumeinspector.com/*"], "content_scripts": [{"matches": ["https://www.resumeinspector.com/*", "https://app.resumeinspector.com/*"], "js": ["app-bridge.js"], "run_at": "document_idle"}]}