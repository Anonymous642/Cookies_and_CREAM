{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Workflow Search", "version": "1.3.0", "description": "Fuzzy-search the workflow sidebar on GitHub Actions. No more clicking \"Show more workflows\".", "homepage_url": "https://github.com/royreznik/github-workflow-search", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "GitHub Workflow Search", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}