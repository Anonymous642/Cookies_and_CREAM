{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "A/B/C Test Saver", "description": "Offline archive for YouTube A/B/C test results, titles, and thumbnails.", "version": "1.0.0", "action": {"default_title": "A/B/C Test Saver", "default_popup": "popup/popup.html"}, "options_page": "archive/archive.html", "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://i.ytimg.com/*", "https://*.ytimg.com/*", "https://studio.youtube.com/*"], "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["src/storage.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png"], "matches": ["https://studio.youtube.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}