{"update_url": "https://clients2.google.com/service/update2/crx", "name": "OratioAI - Speech to Text & AI Voice Chat", "description": "Type anywhere using your voice with OratioAI. Converse with ChatGPT using dictation.", "version": "0.23.0", "manifest_version": 3, "permissions": ["notifications", "storage", "activeTab", "tabs", "offscreen", "webNavigation", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "OratioAI - Speech to Text & AI Voice Chat", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "commands": {"toggle-dictation": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Start/Stop dictation"}, "toggle-stt": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Start/Stop Speech-to-Text"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dictation.html", "welcome.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}