{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Litmark", "version": "1.0.1", "description": "Highlight text on any website and have it reappear when you revisit. Manage all your saved highlights in one place.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Litmark \u2014 manage saved highlights", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["colors.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}]}