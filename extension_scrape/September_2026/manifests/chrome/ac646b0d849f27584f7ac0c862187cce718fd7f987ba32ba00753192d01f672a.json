{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Legal Sensus Chrome Extension", "version": "1.0.5", "description": "Open PDFs directly in the Legal Sensus web app with ease!", "icons": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}, "permissions": ["storage", "cookies", "tabs", "activeTab", "scripting"], "host_permissions": ["*://*/*.pdf", "https://app.legalsensus.com/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "defaultPopup.html", "default_icon": {"16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/icon128.png", "icons/LS_logo_no_background.png", "styles/*.css", "content.js", "styles/*", "*.js", "*.css"], "matches": ["<all_urls>"]}]}