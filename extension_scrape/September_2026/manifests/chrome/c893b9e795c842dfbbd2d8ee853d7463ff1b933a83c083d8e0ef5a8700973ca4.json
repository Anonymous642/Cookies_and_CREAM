{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Modo Simple: texto m\u00e1s grande y lectura f\u00e1cil", "version": "1.2.1", "description": "Texto m\u00e1s grande, mejor contraste, lectura en voz alta, menos distracciones y una lupa de verdad. Gratis y sin recopilar datos.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Modo Simple"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"alternar-modo": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Activar o desactivar Modo Simple"}, "alternar-lupa": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Mostrar u ocultar la lupa"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}