{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Xeet Video Saver", "description": "Queue and batch-download X/Twitter videos and animated GIFs in your chosen quality.", "version": "1.3.0", "short_name": "Xeet Saver", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "storage"], "commands": {"download-hovered-video": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Download the currently hovered video"}}, "action": {"default_title": "Xeet Video Saver", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"]}], "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}