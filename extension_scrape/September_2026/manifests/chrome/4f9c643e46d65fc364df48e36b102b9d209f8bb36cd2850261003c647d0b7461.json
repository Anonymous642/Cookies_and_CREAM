{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RotCure", "version": "1.0.3", "description": "Reduce distraction on YouTube and Instagram with redirects, feed controls, reel limits, and daily time limits.", "icons": {"16": "icons/rotcure-16.png", "32": "icons/rotcure-32.png", "48": "icons/rotcure-48.png", "128": "icons/rotcure-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://www.instagram.com/*", "*://instagram.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["youtube-shorts-hide.js", "usage-limit.js", "shorts-limit.js"], "run_at": "document_start"}, {"matches": ["*://www.instagram.com/*", "*://instagram.com/*"], "js": ["usage-limit.js", "instagram-reels-limit.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["shorts-limit-bridge.js"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "RotCure", "default_icon": {"16": "icons/rotcure-16.png", "32": "icons/rotcure-32.png"}}}