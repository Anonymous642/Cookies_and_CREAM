{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Plugly", "version": "1.0.0", "description": "A bold, elegant control center for your Chrome extensions \u2014 instant on/off, search, profiles, and 8 languages.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://plugly.pages.dev/", "minimum_chrome_version": "102", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Plugly", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["js/ExtPay.js"], "run_at": "document_start"}], "host_permissions": ["https://extensionpay.com/*"], "permissions": ["management", "storage", "commands", "tabs", "alarms"], "commands": {"enable-all-extensions": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Enable all extensions"}, "disable-all-extensions": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Disable all extensions"}, "speed-mode": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Run Speed Mode (Plugly Pro)"}, "apply-last-profile": {"description": "Apply last-used profile (Plugly Pro)"}, "open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open Command Palette"}}}