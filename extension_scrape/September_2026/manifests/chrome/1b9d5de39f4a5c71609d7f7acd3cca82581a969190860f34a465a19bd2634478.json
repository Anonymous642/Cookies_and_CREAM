{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SaXa", "version": "1.6.0", "description": "Reads like/bookmark/follow/reply state on X and confirms your action was done. No cookies, no passwords \u2014 only boolean flags.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:;"}, "permissions": ["storage", "activeTab", "sidePanel"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://twitsaxa.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "SaXa", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}