{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Lag Remover", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "description": "Solves the lag issue in big chats. Deletes older ChatGPT turns from the DOM. Fast prune, eager detach, and optional auto-reload", "permissions": ["storage", "tabs"], "host_permissions": ["*://chatgpt.com/*", "*://*.chatgpt.com/*", "*://chat.openai.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "ChatGPT Lag Remover", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://*.chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}