{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shiori \u2014 Tab Manager & Session Saver", "description": "Save tabs in one click, free memory, restore anytime. Local-first tab manager with search, side panel, folders & optional AI.", "version": "0.2.0", "short_name": "Shiori", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "114", "homepage_url": "https://www.extensionsbyselfhood.com", "permissions": ["tabs", "storage", "unlimitedStorage", "sidePanel", "alarms", "activeTab", "contextMenus", "offscreen"], "optional_permissions": ["bookmarks"], "host_permissions": ["https://api.x.ai/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.mistral.ai/*", "https://openrouter.ai/*", "https://api.together.xyz/*", "https://api.deepseek.com/*"], "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Shiori", "default_popup": "popup.html", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "commands": {"open-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open the Shiori side panel"}, "save-window": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save the current window"}}, "background": {"type": "module", "service_worker": "background.js"}}