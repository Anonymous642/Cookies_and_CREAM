{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Multi-LLM Hub", "version": "1.8", "description": "Sync prompts across ChatGPT, Gemini, Claude, DeepSeek and Perplexity.", "permissions": ["tabs", "windows", "storage", "activeTab", "system.display", "notifications"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://chat.deepseek.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Multi-LLM Hub", "default_icon": {"128": "ICON.png"}}, "icons": {"128": "ICON.png"}, "commands": {"toggle-sync": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle sync on/off"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://chat.deepseek.com/*", "https://www.perplexity.ai/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}