{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Notes AI - Summary, Transcript & Key Moments Generator", "description": "Analyze YouTube videos with transcripts, metadata insights, and optional AI notes in a clean report.", "version": "1.1.1", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "downloads", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://openrouter.ai/*", "https://www.googleapis.com/*"], "action": {"default_title": "YouTube Notes AI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "settings.html", "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}]}