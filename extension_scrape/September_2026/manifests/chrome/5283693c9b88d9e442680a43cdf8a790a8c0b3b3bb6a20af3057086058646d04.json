{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FakeScan \u2014 AI Fake Review Detector", "version": "1.0.0", "description": "Detect fake reviews on Amazon. AI trust scores, red flags, and buying recommendations on product pages.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.ca/*", "https://*.amazon.co.jp/*", "https://fakescan.site/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com/dp/*", "https://*.amazon.com/*/dp/*", "https://*.amazon.com/gp/product/*", "https://*.amazon.co.uk/dp/*", "https://*.amazon.co.uk/*/dp/*", "https://*.amazon.de/dp/*", "https://*.amazon.de/*/dp/*", "https://*.amazon.ca/dp/*", "https://*.amazon.ca/*/dp/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}