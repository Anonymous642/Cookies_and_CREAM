{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Orpheus", "version": "0.3.0", "description": "Orpheus is a browser audio enhancement extension that gives you greater control over how you listen.", "icons": {"16": "orpheus16.png", "32": "orpheus32.png", "48": "orpheus48.png", "128": "orpheus128.png"}, "permissions": ["scripting", "activeTab", "tabs", "storage"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Orpheus - Browser Audio Enhancement", "default_icon": {"16": "orpheus16.png", "32": "orpheus32.png", "48": "orpheus48.png", "128": "orpheus128.png"}}, "web_accessible_resources": [{"resources": ["orpheus.html"], "matches": ["https://www.youtube.com/*"]}]}