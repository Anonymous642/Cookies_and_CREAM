{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Volume Booster 600% \u2013 Sound Booster for YouTube & Spotify", "version": "2.2.0", "description": "Boost tabs up to 600% with EQ, voice clarity, site memory, multi-tab control, plus Pro Smart Volume and Night Shield.", "permissions": ["activeTab", "tabs", "tabCapture", "offscreen", "storage", "alarms"], "host_permissions": ["https://*.workers.dev/*", "https://www.google-analytics.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["normalizer-processor.js", "offscreen.html"], "matches": ["<all_urls>"]}], "commands": {"boost-up": {"suggested_key": {"default": "Alt+Up"}, "description": "Increase volume by 10%"}, "boost-down": {"suggested_key": {"default": "Alt+Down"}, "description": "Decrease volume by 10%"}, "toggle-mute": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle mute"}}}