{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TripClip", "version": "0.2.0", "description": "Recorta an\u00fancios de hospedagem do Airbnb, Booking e Hoteis.com e organiza em pastas de viagem.", "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "tabs"], "host_permissions": ["https://*.airbnb.com/*", "https://*.airbnb.com.br/*", "https://*.booking.com/*", "https://*.hoteis.com/*", "https://*.hotels.com/*"], "action": {"default_title": "Salvar hospedagem", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}