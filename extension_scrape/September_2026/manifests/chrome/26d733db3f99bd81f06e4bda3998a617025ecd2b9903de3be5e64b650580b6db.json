{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClickUp Comment Guard", "version": "1.1", "description": "Prevents data loss in ClickUp comments by auto-saving drafts when Esc is pressed.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://*.clickup.com/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "ClickUp Comment Guard", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://app.clickup.com/*", "https://*.clickup.com/*"], "js": ["src/content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}