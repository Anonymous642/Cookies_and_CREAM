{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GroupCal - Calendar Groups Manager", "version": "1.0.0", "description": "Toggle multiple Google Calendar subscriptions on/off with one click for easier calendar management.", "permissions": ["storage", "tabs"], "host_permissions": ["https://calendar.google.com/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["content/content.js"]}], "action": {"default_popup": "popup/popup.html", "default_title": "GroupCal - Manage Calendar Groups"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "assets/GroupCalLogo.png", "48": "assets/GroupCalLogo.png", "128": "assets/GroupCalLogo.png"}, "author": "Davide Crescentini", "homepage_url": "https://github.com/dadecresce/groupcal"}