{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Recruit Wizard", "description": "Recruit Wizard's Browser Extension lets you easily link profiles from LinkedIn to a record in Recruit Wizard.", "version": "6.9.3", "manifest_version": 3, "permissions": ["cookies", "activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://recruitwizard.app/*", "https://*.linkedin.com/*"], "action": {"default_title": "Recruit Wizard Extension", "default_icon": {"16": "images/Icon-16.png", "32": "images/Icon-32.png", "64": "images/Icon-64.png", "128": "images/Icon-128.png"}}, "icons": {"16": "images/Icon-16.png", "32": "images/Icon-32.png", "64": "images/Icon-64.png", "128": "images/Icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"service_worker": "js/background.js", "type": "module"}, "options_ui": {"page": "js/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["js/contentScript.js"], "run_at": "document_end", "all_frames": false}]}