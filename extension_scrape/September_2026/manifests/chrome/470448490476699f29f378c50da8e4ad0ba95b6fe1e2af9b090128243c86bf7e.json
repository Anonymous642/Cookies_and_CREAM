{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "REMINDER PRO", "description": "Popup based professional scheduler extension with pop-up notifications, local alerts, and sound.", "version": "0.1.0", "action": {"default_title": "REMINDER PRO", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["alarms", "notifications", "storage", "offscreen", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["offscreen.html", "assets/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"], "run_at": "document_idle"}]}