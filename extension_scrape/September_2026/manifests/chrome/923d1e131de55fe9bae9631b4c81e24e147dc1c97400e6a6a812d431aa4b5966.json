{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Download All Images", "version": "1.0", "manifest_version": 3, "description": "Install this extension to quickly download all images from any webpage with a single click.", "action": {"default-icon": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}}, "icons": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}, "permissions": ["storage", "activeTab", "notifications", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["zip-lib.js", "jszip.min.js"], "matches": ["<all_urls>"]}]}