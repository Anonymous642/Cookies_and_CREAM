{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenAsGuest \u2013 Shared Link Access Checker", "short_name": "OpenAsGuest", "version": "0.1.1", "description": "Check whether Google Drive and Dropbox file links open without signing in before you send them.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://drive.google.com/*", "https://accounts.google.com/*", "https://dropbox.com/*", "https://www.dropbox.com/*", "https://*.dropboxusercontent.com/*"], "incognito": "not_allowed", "background": {"service_worker": "sw.js"}, "action": {"default_title": "Check a Drive or Dropbox file link as guest", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html"}}