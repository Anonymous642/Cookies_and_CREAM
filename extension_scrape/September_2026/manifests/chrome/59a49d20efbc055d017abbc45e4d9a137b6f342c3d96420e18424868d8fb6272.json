{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MINTRA - Focus Timer", "version": "1.0.0", "description": "A minimalist, floating Pomodoro focus timer that stays visible across all tabs.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16_v2.png", "32": "icons/icon32_v2.png", "48": "icons/icon48_v2.png", "128": "icons/icon128_v2.png"}}, "icons": {"16": "icons/icon16_v2.png", "32": "icons/icon32_v2.png", "48": "icons/icon48_v2.png", "128": "icons/icon128_v2.png"}, "commands": {"toggle-timer": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start/Pause timer"}, "reset-timer": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Reset timer"}, "skip-phase": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Skip to next phase"}, "toggle-overlay": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle overlay visibility"}}}