{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FoundKeep \u2014 Save what matters", "version": "1.0.3", "description": "Save readable pages, screenshots, highlights, images and notes with original source details in a private, searchable library.", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "alarms", "sidePanel"], "host_permissions": ["https://foundkeep.app/*"], "optional_host_permissions": ["<all_urls>", "http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "FoundKeep", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["src/twitter.js", "src/dock/dock.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/review.html", "src/note.html"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "externally_connectable": {"matches": ["https://foundkeep.app/*", "https://atlas.notpritam.in/*"]}, "commands": {"region-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Screenshot a region to FoundKeep"}, "full-page-screenshot": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Screenshot to FoundKeep (full page or a region)"}, "save-highlight": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Save the selected text to FoundKeep"}}, "optional_permissions": ["bookmarks"]}