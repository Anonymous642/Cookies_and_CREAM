{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Rewind: Post History Tracker", "version": "1.0", "description": "Captures posts you've scrolled past on X (formerly Twitter)", "permissions": ["storage"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "https://api.fontshare.com/"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://*.twitter.com/*", "*://*.x.com/*"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}