{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Tuner", "version": "1.2.0", "description": "Controle a velocidade (at\u00e9 8x), o volume (at\u00e9 600%), o tempo e o picture-in-picture dos v\u00eddeos de qualquer site.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Video Tuner \u2014 configura\u00e7\u00e3o"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"speed-up": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Aumentar velocidade"}, "speed-down": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Diminuir velocidade"}, "speed-reset": {"suggested_key": {"default": "Ctrl+Shift+0"}, "description": "Resetar velocidade"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}