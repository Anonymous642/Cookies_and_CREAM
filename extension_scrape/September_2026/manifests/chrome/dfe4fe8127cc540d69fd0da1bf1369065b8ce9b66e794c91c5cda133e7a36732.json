{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Conventional Comments", "version": "1.1.3", "description": "Rewrite GitHub comments into Conventional Comments format using Gemini AI.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://github.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_title": "Conventional Comments", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["extension-storage.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}