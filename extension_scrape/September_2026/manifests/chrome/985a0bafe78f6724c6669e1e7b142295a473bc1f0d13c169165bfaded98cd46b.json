{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Workbench", "version": "2.2.0", "description": "A side panel for your projects, reusable snippets, and notes\u2014search everything, capture from the web, data stays on your device.", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Workbench"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"open-workbench": {"suggested_key": {"default": "Alt+Shift+W", "mac": "MacCtrl+Shift+W"}, "description": "Open Workbench sidebar"}, "quick-capture": {"suggested_key": {"default": "Alt+Shift+N", "mac": "MacCtrl+Shift+N"}, "description": "Quick capture (note, link, or tabs)"}, "toggle-unified-search": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Search everything in Workbench"}, "save-note": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save open Workbench note"}}, "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "tabs", "sidePanel", "contextMenus", "scripting", "activeTab"], "host_permissions": ["<all_urls>"]}