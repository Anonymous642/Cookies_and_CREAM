{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Highlight Anything - Web Highlighter & Annotator", "description": "Highlight web text, add tagged notes, export notes, and sync them with WebDAV and Notion.", "version": "0.3.4", "minimum_chrome_version": "116", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["alarms", "storage", "activeTab", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*", "https://api.notion.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Open highlights", "default_icon": {"16": "assets/icons/icon-disabled-16.png", "32": "assets/icons/icon-disabled-32.png", "48": "assets/icons/icon-disabled-48.png", "128": "assets/icons/icon-disabled-128.png"}}, "options_page": "src/options/options.html", "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/shared/note-format.js", "src/content/content-script.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}]}