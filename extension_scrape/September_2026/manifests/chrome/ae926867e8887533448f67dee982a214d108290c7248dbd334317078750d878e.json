{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Subtitle (Transcribe/Translate)", "version": "0.1.0", "description": "Transcribe & translate a YouTube URL via local backend.", "action": {"default_title": "YT Subtitle", "default_popup": "popup.html"}, "options_page": "options.html", "permissions": ["tabs", "storage"], "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}