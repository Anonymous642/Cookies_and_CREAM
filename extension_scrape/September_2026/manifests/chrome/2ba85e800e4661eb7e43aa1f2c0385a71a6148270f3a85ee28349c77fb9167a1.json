{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinguaLens", "description": "See some words from your decks while you browse. Import from Anki or Skritter, and review with spaced repetition.", "version": "1.0.9", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "cookies"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.lingualens.app https://*.ingest.us.sentry.io http://127.0.0.1:8765 http://localhost:8765"}, "browser_specific_settings": {"gecko": {"id": "lingualens@lingualens.app", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}, "strict_min_version": "113.0"}}, "commands": {"toggle-replacements": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Toggle LinguaLens replacements on/off"}, "open-settings": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open LinguaLens settings"}}, "externally_connectable": {"matches": ["https://lingualens.app/*", "https://www.lingualens.app/*"]}, "background": {"type": "module", "service_worker": "background.js"}, "action": {"default_title": "LinguaLens", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://lingualens.app/extension/auth-callback*"], "run_at": "document_idle", "js": ["content-scripts/auth-callback.js"]}, {"matches": ["https://lingualens.app/billing/success*"], "run_at": "document_start", "js": ["content-scripts/checkout-success.js"]}, {"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"], "world": "ISOLATED"}, {"matches": ["<all_ur