{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TubeDiary", "version": "1.50", "description": "Use the TubeDiary extension to automatically track your YouTube video consumption.", "manifest_version": 3, "author": "WenQiang Liu", "action": {"default_popup": "popup.html", "default_title": "TubeDiary"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*", "https://www.youtu.be/*", "https://jquery.com/*"], "permissions": ["tabs", "scripting", "activeTab", "storage", "notifications", "webNavigation", "http://*/", "https://*/"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}}