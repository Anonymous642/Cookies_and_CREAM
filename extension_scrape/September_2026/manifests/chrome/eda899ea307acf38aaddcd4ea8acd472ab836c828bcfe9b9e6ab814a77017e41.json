{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hover Translate", "version": "1.1.0", "description": "Instantly translate any text on any webpage by hovering over it. Supports 100+ languages with multiple translation providers.", "author": "Hover Translate Team", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Hover Translate"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://translate.googleapis.com/*", "https://translate.google.com/*", "https://clients5.google.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*", "https://api.mymemory.translated.net/*", "https://api.cognitive.microsofttranslator.com/*", "https://libretranslate.com/*"], "commands": {"toggle-translation": {"suggested_key": {"default": "Alt+T", "windows": "Alt+T", "mac": "Alt+T"}, "description": "Toggle translation on/off"}, "toggle-replace-mode": {"suggested_key": {"default": "Alt+R", "windows": "Alt+R", "mac": "Alt+R"}, "description": "Switch to replace text mode"}, "toggle-tooltip-mode": {"suggested_key": {"default": "Alt+O", "windows": "Alt+O", "mac": "Alt+O"}, "description": "Switch to tooltip mode (original text)"}, "copy-translation": {"suggested_key": {"default": "Alt+C", "windows": "Alt+C", "mac": "Alt+C"}, "description": "Copy last translation to clipboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches