{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KairoTabs", "short_name": "KairoTabs", "description": "Clear tabs. Keep focus. Local-first intelligent tab management for Chrome.", "version": "1.0.0", "minimum_chrome_version": "116", "permissions": ["tabs", "tabGroups", "storage", "alarms", "sidePanel"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "KairoTabs", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_page": "options/options.html", "commands": {"open-command-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Tab Search"}, "group-tabs": {"description": "Group Tabs"}, "remove-duplicates": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Remove Duplicates"}, "suspend-inactive": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend Inactive Tabs"}, "open-tab-map": {"description": "Open Tab Map"}, "toggle-deep-work": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle Deep Work Mode"}, "open-timeline": {"description": "Open Tab Timeline"}}}