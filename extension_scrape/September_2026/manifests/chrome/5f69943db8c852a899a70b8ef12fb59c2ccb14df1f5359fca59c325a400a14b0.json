{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pocket Watch Saver", "version": "1.0.2", "description": "Save YouTube videos to Pocket Watch on your Mac \u2014 one click from the page or context menu. Pocket Watch must be open.", "permissions": ["activeTab", "tabs", "contextMenus", "notifications", "scripting", "offscreen", "storage"], "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_title": "Save to Pocket Watch"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png", "icons/icon128.png"], "matches": ["https://www.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"]}]}