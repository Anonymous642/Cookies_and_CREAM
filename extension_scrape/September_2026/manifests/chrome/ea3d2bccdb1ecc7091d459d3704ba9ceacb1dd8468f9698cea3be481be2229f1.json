{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Refresh Timer for gov.il", "version": "1.0", "description": "Refreshes gov.il pages at random intervals and resets timer on user interaction.", "icons": {"16": "icons/inactive.png", "48": "icons/inactive.png", "128": "icons/inactive.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/inactive.png", "48": "icons/inactive.png", "128": "icons/inactive.png"}}, "permissions": ["tabs", "alarms"], "host_permissions": ["*://*.gov.il/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.gov.il/*"], "js": ["content.js"], "run_at": "document_start"}]}