{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rainbow Sudoku", "description": "Play interactive Sudoku puzzles with rainbow colors!", "version": "1.1.26", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://rainbowsudoku.com/*"], "background": {"service_worker": "background.min.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; media-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/puzzles/*.json", "assets/sounds/*.mp3"], "matches": ["<all_urls>"]}]}