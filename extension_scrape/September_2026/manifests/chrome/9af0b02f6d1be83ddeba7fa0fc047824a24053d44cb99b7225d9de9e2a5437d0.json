{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "and.software", "version": "0.1.0", "description": "Capture pages, snippets, images, and marked-up screenshots into your and.software collections.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "contextMenus", "storage", "sidePanel", "identity"], "background": {"service_worker": "sw.js", "type": "module"}, "action": {"default_title": "Save to and.software", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"save-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save selection to and.software"}, "markup-screenshot": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Draw on the page and capture a screenshot"}, "quick-task": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Create a task"}}}