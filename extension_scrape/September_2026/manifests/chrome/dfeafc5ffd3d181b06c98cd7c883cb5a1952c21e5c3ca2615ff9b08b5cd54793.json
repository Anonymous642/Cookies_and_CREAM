{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CBH NextGen Connector", "version": "1.23.0", "description": "Validates ICD-10 codes and auto-fills encounter details on NextGen Office claims, using your Clinic Billing Helper account.", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/background.js"}, "options_page": "options/options.html", "side_panel": {"default_path": "popup/popup.html?panel=1"}, "permissions": ["storage", "activeTab", "sidePanel", "downloads"], "commands": {"run-autofill": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Run Claim Assist on the current NextGen claim"}}, "host_permissions": ["https://*.healthfusionclaims.com/*", "https://*.nextgenoffice.cloud/*", "https://clinic-billing-helper.vercel.app/*"], "optional_host_permissions": ["http://localhost/*"], "content_scripts": [{"matches": ["https://*.healthfusionclaims.com/*", "https://*.nextgenoffice.cloud/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.healthfusionclaims.com/*", "https://*.nextgenoffice.cloud/*"], "js": ["content/page-bridge.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://reports.healthfusionclaims.com/*", "https://reports.nextgenoffice.cloud/*"], "js": ["content/reports.js"], "css": ["lib/theme.css", "content/reports.css"], "run_at": "document_idle"}, {"matches": ["https://reports.healthfusionclaims.com/*", "https://reports.nextgenoffice.cloud/*"], "js": ["content/reports-bridge.js"], "world": "MAIN", "run_at": "document_idle"}]}