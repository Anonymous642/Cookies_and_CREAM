{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice Dictation for Every Web App \u2013 Rubil", "version": "1.5.2", "description": "Rubil: formats your words for Gmail, Slack, Notion, Jira, Teams + more. Never rewrites, never invents. Audio never stored.", "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "offscreen", "cookies", "clipboardRead", "clipboardWrite", "notifications"], "host_permissions": ["<all_urls>", "https://*.supabase.co/*", "https://rubil.io/*", "https://www.rubil.io/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' https://download.rubil.io; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;"}, "background": {"service_worker": "background.bundle.js"}, "externally_connectable": {"matches": ["https://www.rubil.io/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Toggle Rubil"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Rubil menu"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Start or stop recording"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.bundle.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["ui/widget.css", "ui/fonts/*", "icons/*", "lib/offscreen.html", "welcome/pin-demo.webp", "welcome/welcome.html", "welcome/welcome.css", "welcome/welcome.js"], "matches": ["<all_urls>"]}]}