{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Case Converter", "version": "1.1", "description": "Convert text case anywhere \u2014 right-click or use keyboard shortcuts. lowercase, UPPERCASE, Title Case, Sentence case and more.", "permissions": ["contextMenus", "scripting", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"toLower": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Convert to lowercase"}, "toUpper": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Convert to UPPERCASE"}, "toTitle": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Convert to Title Case"}, "toSentence": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Convert to Sentence case"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}