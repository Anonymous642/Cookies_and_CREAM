{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NxaTel - Click-to-Call, SMS & WhatsApp", "version": "1.0.2", "description": "Turn Chrome into your business phone, click to call, send SMS, and message on WhatsApp from one place.", "icons": {"16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png"}, "action": {"default_title": "NxaTel - Click-to-Call, SMS & WhatsApp"}, "permissions": ["storage", "activeTab", "notifications", "offscreen", "alarms", "tabs", "windows", "scripting"], "host_permissions": ["http://*/*", "https://*/*", "https://*.nxa.tel/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+N"}, "description": "Open the Nxatel Dialer"}, "ans_end_call-cmd": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Answer or end the active call"}, "mute-call-cmd": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute/Unmute the active call"}, "hold-call-cmd": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hold/Resume the active call"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://*.nxa.tel:* https://*.nxa.tel:*"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["assets/*", "index.html", "styles.css"], "matches": ["http://*/*", "https://*/*"]}]}