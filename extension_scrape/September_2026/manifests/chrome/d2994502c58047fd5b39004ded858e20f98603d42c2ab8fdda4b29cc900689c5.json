{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReviewHarvest - Amazon Review Exporter", "description": "Export Amazon product reviews to Judge.me-compatible CSV or JSON. Local, private, and login-free.", "version": "1.0.5", "icons": {"16": "icons/reviewharvest-color-16.png", "32": "icons/reviewharvest-color-32.png", "48": "icons/reviewharvest-color-48.png", "128": "icons/reviewharvest-color-128.png"}, "permissions": ["activeTab", "storage", "downloads"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.co.jp/*", "https://*.amazon.in/*", "https://*.amazon.nl/*", "https://api.tryreviewharvest.com/*"], "action": {"default_title": "ReviewHarvest", "default_icon": {"16": "icons/reviewharvest-grey-16.png", "32": "icons/reviewharvest-grey-32.png", "48": "icons/reviewharvest-grey-48.png", "128": "icons/reviewharvest-grey-128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.ca/*", "https://*.amazon.co.jp/*", "https://*.amazon.co.uk/*", "https://*.amazon.com.au/*", "https://*.amazon.com/*", "https://*.amazon.de/*", "https://*.amazon.es/*", "https://*.amazon.fr/*", "https://*.amazon.in/*", "https://*.amazon.it/*", "https://*.amazon.nl/*"], "js": ["content-scripts/amazon.js"]}]}