{"manifest_version": 3, "name": "Nesktop", "version": "0.10.0", "description": "Nesktop new tab workspace, page saver, and optional browser data integration.", "action": {"default_popup": "popup.html", "default_title": "Nesktop"}, "background": {"service_worker": "background.js"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png", "1024": "icons/icon1024.png"}, "optional_permissions": ["bookmarks", "topSites", "tabs"], "options_page": "options.html", "permissions": ["storage", "activeTab"], "content_scripts": [{"js": ["config.js", "browser-api.js", "diagnostics.js", "content-script.js"], "matches": ["https://nesktop.com/*"], "run_at": "document_idle"}], "host_permissions": ["https://nesktop.com/*", "https://api.nesktop.com/*"], "externally_connectable": {"matches": ["https://nesktop.com/*"]}, "key": "", "update_url": "https://clients2.google.com/service/update2/crx"}