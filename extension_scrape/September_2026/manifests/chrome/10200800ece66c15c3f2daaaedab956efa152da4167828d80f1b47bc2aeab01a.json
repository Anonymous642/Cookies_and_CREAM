{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CSES to GitHub Pusher", "version": "1.1", "description": "Automatically pushes accepted CSES submissions to GitHub.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://cses.fi/*", "https://api.github.com/*"], "action": {"default_popup": "popup.html", "default_title": "Configure CSES Pusher", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://cses.fi/problemset/result/*"], "js": ["content.js"]}]}