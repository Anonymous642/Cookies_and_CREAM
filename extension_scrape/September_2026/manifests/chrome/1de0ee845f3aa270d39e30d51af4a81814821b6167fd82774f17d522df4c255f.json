{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subi", "version": "0.1.206", "description": "AI bilingual subtitles and click explanations for YouTube.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage", "webRequest"], "host_permissions": ["https://api.subititles.com/*", "https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://api.subititles.com/api/auth/success*"], "js": ["auth-success.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page-bridge.js", "assets/logo.png", "assets/settings-icons/*.png", "assets/help/word-explanation-example.webp"], "matches": ["https://www.youtube.com/*"]}], "background": {"service_worker": "background.js"}}