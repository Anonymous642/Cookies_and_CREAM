{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CI Echo Subtitles", "version": "1.10.0", "description": "Live translated subtitles for Google Slides. The slide shrinks to fit, so nothing is covered. Pause without leaving your slides.", "permissions": ["storage"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/presentation/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://ci-echo.org/*", "https://ci-echo.songdo-technology.workers.dev/*"], "js": ["bridge.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "CI Echo Subtitles"}, "web_accessible_resources": [{"resources": ["overlay.html"], "matches": ["https://docs.google.com/*"]}], "background": {"service_worker": "sw.js"}, "commands": {"toggle-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Pause or resume the live translation"}}}