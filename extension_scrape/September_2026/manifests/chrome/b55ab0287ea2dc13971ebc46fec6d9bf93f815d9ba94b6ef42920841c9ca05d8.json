{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shorfle", "version": "2.2.0", "description": "Auto-advance YouTube Shorts, TikTok & Instagram Reels \u2014 control videos with hotkeys even while another window is focused.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Shorfle"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/common.js", "src/platforms/youtube.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*"], "js": ["src/common.js", "src/platforms/tiktok.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["src/common.js", "src/platforms/instagram.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "tabs", "nativeMessaging"], "host_permissions": ["https://www.youtube.com/*", "https://www.tiktok.com/*", "https://www.instagram.com/*"]}