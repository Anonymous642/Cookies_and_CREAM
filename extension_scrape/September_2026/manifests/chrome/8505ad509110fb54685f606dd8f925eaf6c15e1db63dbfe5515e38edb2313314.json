{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube AdBlock - Coffee Break for YouTube", "description": "Coffee Break for YouTube is an ad blocker / skipper built for YouTube with comprehensive filter list protection.", "homepage_url": "https://coffee-break.org", "author": "Coffee Break for YouTube", "version": "1.6.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Coffee Break for YouTube", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "scripting", "activeTab", "webNavigation", "tabs"], "host_permissions": ["*://*/*"], "declarative_net_request": {"rule_resources": [{"id": "coffee-break-filters", "enabled": true, "path": "filters/merged.json"}]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://*.youtube.com/*"], "js": ["content/youtubeAdBlocker.js"], "css": ["content/youtube.css"], "run_at": "document_start"}, {"matches": ["*://*/*"], "exclude_matches": ["*://www.youtube.com/*", "*://*.youtube.com/*"], "js": ["content/genericCosmetic.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["*"], "matches": ["<all_urls>"], "all_frames": true, "extension_ids": ["*"]}], "background": {"service_worker": "background.js"}, "offline_enabled": true}