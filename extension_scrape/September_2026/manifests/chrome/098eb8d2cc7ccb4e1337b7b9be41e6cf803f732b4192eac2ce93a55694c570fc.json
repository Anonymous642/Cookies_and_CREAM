{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickDo", "version": "1.3.2", "description": "A minimalist task manager extension with reminders, clickable links, and multiline support", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "QuickDo: Add a task"}, "background": {"service_worker": "background/worker.js"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus", "notifications", "alarms", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Open QuickDo"}, "add_task": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Quick add task"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "author": "AlgeriaToGlobe", "homepage_url": "https://github.com/AlgeriaToGlobe/quickdo-extension"}