{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Seenwhere", "description": "Remember what you saw and where it came from.", "version": "0.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "150", "permissions": ["activeTab", "scripting", "storage", "offscreen"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "cross_origin_opener_policy": {"value": "same-origin"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "action": {"default_title": "Capture with Seenwhere", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "commands": {"capture-selection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Capture a selection from the active page"}}, "background": {"service_worker": "background.js"}}