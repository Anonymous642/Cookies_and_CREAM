{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IndexNow Submitter - Instant URL & Sitemap Indexing Bing", "version": "1.0.5", "description": "Instant indexing Bing, Yandex, Naver, Seznam & Yep. Submit whole sitemap or pasted URL list with IndexNow, in one click.", "permissions": ["storage", "tabs"], "host_permissions": ["https://api.indexnow.org/*", "https://www.bing.com/*", "https://yandex.com/*", "https://search.seznam.cz/*", "https://searchadvisor.naver.com/*", "https://indexnow.yep.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open IndexNow Submitter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "scripts/background.js"}, "commands": {"submit-current-page": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Submit the current page to IndexNow"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}