{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Thomann Wishlist Copier", "version": "1.0.0", "description": "Copy your Thomann wishlist items (title, image, count, cost) to clipboard with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "clipboardWrite"], "content_scripts": [{"matches": ["*://*.thomann.de/*/wishlist.html*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}