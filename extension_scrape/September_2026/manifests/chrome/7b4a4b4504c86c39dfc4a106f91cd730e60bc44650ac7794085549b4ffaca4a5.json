{"manifest_version": 3, "name": "ChatGPT Performance Optimizer", "version": "1.0.6", "description": "Optimizes ChatGPT performance on long conversations via DOM windowing and lazy loading.", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "ChatGPT Performance Optimizer"}, "commands": {"toggle-optimizer": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle optimizer on/off"}}, "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "options_page": "options.html", "homepage_url": "https://github.com/your-repo", "update_url": "https://clients2.google.com/service/update2/crx", "web_accessible_resources": [{"resources": ["icon_*.png"], "matches": ["<all_urls>"]}], "author": "ChatGPT Optimizer Dev", "offline_enabled": true}