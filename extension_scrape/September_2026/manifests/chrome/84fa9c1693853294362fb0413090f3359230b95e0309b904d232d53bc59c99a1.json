{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkPilot \u2014 Smart Commenting", "version": "0.6.0", "description": "Post your LinkPilot-generated comments to LinkedIn in one click, from your own session. No API limits, no bans.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://*.link-pilot.com/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "LinkPilot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://*.link-pilot.com/*", "http://localhost:3000/*"], "js": ["content-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content-linkedin.js"], "run_at": "document_idle"}]}