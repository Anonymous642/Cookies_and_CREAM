{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Night PDF: Smart Dark Mode for PDFs", "short_name": "Night PDF", "author": "Midhunan", "version": "1.0.0", "description": "Read PDFs in true dark mode without lag or color distortion. Features draggable Focus Curtains to hide blinding borders.", "minimum_chrome_version": "102", "offline_enabled": true, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Night PDF", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*/*.pdf", "*://*/*.pdf?*", "*://*/*.PDF", "*://*/*.PDF?*", "*://docs.google.com/viewer*", "*://docs.google.com/*/pdf*", "file://*/*.pdf", "file://*/*.PDF"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "permissions": ["storage", "tabs"], "host_permissions": ["*://*/*.pdf", "*://*/*.pdf?*", "*://*/*.PDF", "*://*/*.PDF?*", "*://docs.google.com/viewer*", "*://docs.google.com/*/pdf*", "file://*/*.pdf", "file://*/*.PDF"], "commands": {"toggle-night-mode": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Toggle Night PDF mode"}}}