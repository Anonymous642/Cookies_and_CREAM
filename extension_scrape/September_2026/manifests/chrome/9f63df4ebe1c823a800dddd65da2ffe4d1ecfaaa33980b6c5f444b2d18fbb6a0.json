{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Googify", "description": "Type :goog: or :evilgoog: anywhere to drop a goog.", "version": "1.0.0", "icons": {"16": "/icons/icon16.png", "48": "/icons/icon48.png", "128": "/icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "goog", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["assets/goog.png", "assets/evilgoog.png"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}