{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "izyLocal - Local SEO Rank Tracker for Google Maps, GBP & GMB", "short_name": "izyLocal", "version": "1.0.4", "description": "Track your Google Business Profile (GBP/GMB) rankings on Maps. Visualize local SEO with an interactive grid overlay.", "author": "izyLocal", "homepage_url": "https://izylocal.com", "permissions": ["activeTab", "storage", "identity"], "host_permissions": ["https://www.google.com/maps/*", "https://maps.google.com/*", "https://api.izylocal.com/*", "https://*.supabase.co/*"], "action": {"default_popup": "popup.html", "default_title": "izyLocal"}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://maps.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["google-g-2025.png"], "matches": ["https://www.google.com/*", "https://maps.google.com/*"]}]}