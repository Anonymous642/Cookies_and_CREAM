{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "App/API Version to GitHub", "description": "Instantly jump from deployed version strings to their GitHub commits. Great for tracking what's running in production.", "version": "4.0.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "author": "Aren Patel", "homepage_url": "https://github.com/aren55555/version-chrome-ext", "permissions": ["activeTab", "storage"], "action": {"default_title": "App/API Version to GitHub", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}