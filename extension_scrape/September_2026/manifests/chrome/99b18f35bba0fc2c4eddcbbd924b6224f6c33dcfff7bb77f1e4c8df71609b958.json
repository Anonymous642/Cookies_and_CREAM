{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Curvora \u2014 Vectorize any image", "version": "1.0.2", "description": "Right-click any image on the web and turn it into a clean vector file. The image is read in your browser and never uploaded.", "homepage_url": "https://curvora.online", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open Curvora"}, "background": {"service_worker": "background.js"}, "permissions": ["contextMenus", "scripting", "activeTab"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["https://curvora.online/*"], "content_scripts": [{"matches": ["https://curvora.online/*"], "js": ["content.js"], "run_at": "document_start"}]}