{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Skip Reels & Shorts", "version": "1.1.5", "description": "Automatically scrolls to the next video after YouTube Shorts, Instagram Reels, Facebook Reels, or TikToks finish playing once.", "permissions": ["storage", "downloads"], "background": {"service_worker": "background.js", "type": "module"}, "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["ai-compat.js", "content-scripts/common.js", "content-scripts/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["ai-compat.js", "content-scripts/common.js", "content-scripts/instagram.js"], "run_at": "document_idle"}, {"matches": ["*://*.facebook.com/*"], "js": ["ai-compat.js", "content-scripts/common.js", "content-scripts/facebook.js"], "run_at": "document_idle"}, {"matches": ["*://*.tiktok.com/*"], "js": ["ai-compat.js", "content-scripts/common.js", "content-scripts/tiktok.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-global": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Auto-Skip ON/OFF"}, "skip-next": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Skip to Next Video"}, "lock-video": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Lock Current Video"}}, "web_accessible_resources": [{"resources": ["obs-overlay.html", "obs-overlay.css", "obs-overlay.js", "presets-data.js", "ai-compat.js"], "matches": ["<all_urls>"]}]}