{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Transcriba", "description": "Transcreve reuni\u00f5es do Google Meet/Teams pelas legendas (com nomes) e baixa o arquivo ao terminar \u2014 tudo local, sem servidor.", "version": "0.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Transcriba", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://meet.google.com/*", "*://teams.live.com/*", "*://teams.microsoft.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}