{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ArchivedSnap", "version": "2.0.0", "description": "Save pages to web archives or retrieve cached snapshots. Supports Archive.today, Wayback Machine, and more.", "homepage_url": "https://github.com/eterradas/open-archived", "permissions": ["activeTab", "contextMenus", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Archive This Page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"archive-page": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Archive the current page"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Archive the current page (toolbar button)"}}}