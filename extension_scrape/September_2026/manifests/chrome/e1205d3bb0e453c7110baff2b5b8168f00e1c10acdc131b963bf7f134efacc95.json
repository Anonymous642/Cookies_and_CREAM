{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clientflow \u2014 Freelancer CRM", "version": "1.3.0", "description": "Freelancer CRM inside your browser. One-click client capture from Upwork, Fiverr, LinkedIn, Gmail & X. Never miss a follow-up.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://www.upwork.com/*", "https://www.fiverr.com/*", "https://www.linkedin.com/*", "https://mail.google.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.supabase.co/*"], "background": {"service_worker": "dist/background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.upwork.com/*"], "js": ["dist/content/upwork.js"], "css": ["styles/sidebar.css"], "run_at": "document_idle"}, {"matches": ["https://www.fiverr.com/*"], "js": ["dist/content/fiverr.js"], "css": ["styles/sidebar.css"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["dist/content/linkedin.js"], "css": ["styles/sidebar.css"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["dist/content/gmail.js"], "css": ["styles/sidebar.css"], "run_at": "document_idle"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["dist/content/twitter.js"], "css": ["styles/sidebar.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}