{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DeMasque - Safe URL Detector", "version": "1.1.0", "description": "Detect safe and unsafe URLs and highlight them in your browser.", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "permissions": [], "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:5000/*"], "commands": {"highlight-links": {"suggested_key": {"default": "Ctrl+M"}, "description": "Activate the content script on the current tab."}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}