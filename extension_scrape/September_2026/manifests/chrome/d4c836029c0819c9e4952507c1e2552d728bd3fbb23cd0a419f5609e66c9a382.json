{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Element Inspector on Hover", "version": "1.4.5", "description": "Hover any element to inspect box model, fonts, colors, WCAG contrast, grid/flex overlays, design tokens and more.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Element Inspector", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Toggle Element Inspector (popup)"}, "toggle-inspector": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Activate / deactivate Element Inspector"}, "toggle-measure": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle measure mode"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "options_page": "options.html", "devtools_page": "devtools.html", "web_accessible_resources": [{"resources": ["panel.html", "panel.js"], "matches": ["<all_urls>"]}]}