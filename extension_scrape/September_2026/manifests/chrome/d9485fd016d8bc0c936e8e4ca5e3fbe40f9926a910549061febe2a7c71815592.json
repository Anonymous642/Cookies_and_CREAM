{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Epoclip", "version": "1.0.0", "description": "Save and organize YouTube video clips seamlessly", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://*.youtube.com/*"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content/styles.css"], "js": ["content/script.js"]}], "commands": {"save-clip": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "MacCtrl+Shift+X", "chromeos": "Ctrl+Shift+X", "linux": "Ctrl+Shift+X", "windows": "Ctrl+Shift+X"}, "description": "Save current video clip"}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://*.youtube.com/*"]}]}