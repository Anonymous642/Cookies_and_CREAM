{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Click by Voice", "version": "0.35.0", "description": "This Chrome browser extension provides support for activating links and other HTML elements using voice commands.", "permissions": ["clipboardRead", "clipboardWrite", "storage", "offscreen", "webNavigation"], "icons": {"16": "images/icon_16.png", "48": "images/icon_48.png", "128": "images/icon_128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"38": "images/icon_38.png", "48": "images/icon_48.png", "128": "images/icon_128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Activate (e.g., click or focus) a hint"}, "blur": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Blur (remove keyboard focus from elements)"}, "execute_command_from_clipboard": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Activate (e.g., click or focus) a hint specified by clipboard"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/jquery-3.7.1.min.js", "content_scripts/utilities.js", "content_scripts/batching_updates.js", "content_scripts/HintManager.js", "content_scripts/Dom_walk.js", "content_scripts/activate.js", "content_scripts/add_hint.js", "content_scripts/find_hint.js", "content_scripts/hints.js", "content_scripts/content_script.js"], "css": ["content_scripts/show_hints.css"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "background": {"service_worker": "background/background.js", "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}