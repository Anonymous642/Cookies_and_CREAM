{"update_url": "https://clients2.google.com/service/update2/crx", "name": "LaterLinks", "description": "Avoid a cluttered browser window by saving links and sessions to view later with one time access!", "version": "0.3.0", "manifest_version": 3, "minimum_chrome_version": "88", "background": {"service_worker": "background-service-worker.js"}, "icons": {"16": "img/icon_16.png", "32": "img/icon_32.png", "64": "img/icon_64.png", "128": "img/icon_128.png"}, "permissions": ["storage", "activeTab", "bookmarks", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "action": {"default_icon": "img/icon_32.png", "default_popup": "popup.html"}}