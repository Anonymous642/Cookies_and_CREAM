{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Plately Auto Shopper", "version": "1.4.1", "description": "Auto-fill your Walmart and Amazon carts, and save specific products to your Plately catalog with one click.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://www.walmart.com/*", "https://www.costco.com/*", "https://www.amazon.com/*", "https://plately.instarep.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.walmart.com/*"], "js": ["content-walmart.js"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.com/*"], "js": ["content-amazon.js"], "run_at": "document_idle"}, {"matches": ["https://www.walmart.com/ip/*", "https://www.costco.com/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*"], "js": ["product-pill.js"], "run_at": "document_idle"}, {"matches": ["https://plately.instarep.io/*"], "js": ["content-plately.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["https://www.walmart.com/*", "https://www.costco.com/*", "https://www.amazon.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "Plately", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}