{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartSend", "description": "Translate WhatsApp, Telegram, and Facebook Messenger Web messages before they are sent.", "version": "0.0.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "permissions": ["storage", "scripting", "sidePanel"], "host_permissions": ["https://web.whatsapp.com/*", "https://web.telegram.org/*", "https://www.facebook.com/*", "https://*.salesmartly.com/*", "https://easytrans.top/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.salesmartly.com/*", "https://web.telegram.org/*", "https://web.whatsapp.com/*", "https://www.facebook.com/messages/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"], "world": "ISOLATED"}]}