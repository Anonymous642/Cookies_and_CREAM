{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inbox", "description": "Link your X/Twitter account to Inbox.", "version": "0.9.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Open Inbox"}, "permissions": ["storage", "cookies", "declarativeNetRequest", "webRequest"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.linkedin.com/*", "*://*.tweetdm.com/*", "https://inboxapp.com/*"], "externally_connectable": {"matches": ["https://inboxapp.com/*"]}, "web_accessible_resources": [{"resources": ["portal.json"], "matches": ["https://inboxapp.com/*"]}, {"resources": ["content-scripts/content.css"], "matches": ["https://x.com/*"]}], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://x.com/*"], "exclude_matches": ["https://x.com/i/oauth2/*"], "js": ["content-scripts/content.js"]}]}