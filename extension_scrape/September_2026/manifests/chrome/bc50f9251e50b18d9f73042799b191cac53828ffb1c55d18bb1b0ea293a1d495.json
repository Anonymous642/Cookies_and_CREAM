{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TrustCheck", "version": "0.3", "description": "Analyze YouTube videos for credibility and identify potential scams before you waste time or money.", "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://*.trustcheck.dev/*", "https://api.trustcheck.dev/*", "https://trustcheck.dev/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["scripts/content.js"]}], "web_accessible_resources": [{"resources": ["icons/*", "images/*", "styles/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.trustcheck.dev https://api.trustcheck.dev"}}