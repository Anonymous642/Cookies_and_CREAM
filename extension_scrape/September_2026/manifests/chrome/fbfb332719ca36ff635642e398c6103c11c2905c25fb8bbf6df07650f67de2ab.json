{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptNest: AI Prompt Manager for ChatGPT, Gemini, Claude & Copilot", "version": "0.2.5", "description": "Stop retyping prompts. Save, organize & insert AI prompts in one click \u2014 with fill-in {variables}, folders, chains & search.", "permissions": ["storage", "clipboardWrite", "activeTab", "sidePanel", "declarativeContent", "contextMenus", "identity"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "side_panel": {"default_path": "src/popup.html"}, "action": {"default_icon": "icons/icon48.png", "default_title": "Open PromptNest"}, "commands": {"open-search": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open PromptNest and focus the search bar"}}, "oauth2": {"client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "externally_connectable": {"matches": ["https://prompt-nest.github.io/*"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["src/content.js"]}], "background": {"service_worker": "src/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["src/popup.html", "src/styles.css", "src/config.js", "src/storage.js", "src/popup.js", "src/sheets.js", "vendor/lucide.min.js", "vendor/papaparse.min.js", "vendor/lz-string.min.js", "src/starter-pack.json"], "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"]}]}