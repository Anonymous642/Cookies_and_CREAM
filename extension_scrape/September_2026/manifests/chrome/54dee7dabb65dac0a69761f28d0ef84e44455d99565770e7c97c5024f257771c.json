{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vocabely: Smart Vocabulary Helper", "version": "1.2", "description": "Vocabely: Translate and save vocabulary from any webpage. Link with the app (Vocabely) for full functionality.", "action": {"default_popup": "index.html", "default_icon": "icons/icon.png"}, "host_permissions": ["<all_urls>", "file:///*"], "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}, "permissions": ["scripting", "contextMenus", "activeTab", "storage", "clipboardRead"], "web_accessible_resources": [{"resources": ["public/*", "popup.html", "alert.html", "icons/*.png"], "matches": ["<all_urls>"]}], "commands": {"translate_selected_text": {"suggested_key": {"default": "Alt+C"}, "description": "Translate selected text."}, "add_word_to_vocabely": {"suggested_key": {"default": "Alt+V"}, "description": "Add selected text/word to Vocabely."}}}