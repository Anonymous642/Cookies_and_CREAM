{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mindful Screen Time", "version": "3.1.0", "version_name": "3.1.0 \u2014 Persuasion Update", "description": "Block social media until you convince an AI you need it. Not a timer. Not a blocker. A conversation that holds you accountable.", "author": "Mindful", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "notifications", "webNavigation", "alarms", "offscreen"], "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.linkedin.com/*", "*://*.snapchat.com/*", "*://*.pinterest.com/*", "https://mindful-screen-web-time.vercel.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Mindful Screen Time", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.linkedin.com/*", "*://*.snapchat.com/*", "*://*.pinterest.com/*"], "js": ["site-map.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": []}