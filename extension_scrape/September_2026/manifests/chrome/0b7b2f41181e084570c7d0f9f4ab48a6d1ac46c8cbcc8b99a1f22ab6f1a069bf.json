{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CamCloak \u2013 hide facecams on YouTube", "short_name": "CamCloak", "version": "1.1.0", "description": "Finds and hides the facecam in YouTube videos: blur, pixelate, blend or black it out. Remembers it per video, channel or everywhere.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "offscreen"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "CamCloak", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"], "js": ["src/shared.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}], "externally_connectable": {"matches": ["https://camcloak-api.camcloak.workers.dev/*"]}, "commands": {"toggle-masks": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hide or show masks on the current video"}, "edit-masks": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Draw or edit masks on the current video"}, "detect-facecam": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Find the facecam on the current video and hide it"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: https://camcloak-api.camcloak.workers.dev"}}