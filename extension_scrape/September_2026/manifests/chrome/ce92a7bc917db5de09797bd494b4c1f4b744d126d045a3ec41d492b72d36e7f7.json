{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Refresh on Idle", "version": "1.2", "description": "Refreshes web pages automatically after inactivity at user-defined intervals.", "author": "Kodigen (info@kodigen.com)", "permissions": ["storage", "activeTab"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Refresh on Idle", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}