{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Exporter Pro", "version": "1.0.0", "description": "Export conversations from ChatGPT, Claude, Gemini, and more to PDF, Markdown, TXT, HTML, and JSON with images.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "js": ["content-scripts/extractor.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["lib/*", "styles/*"], "matches": ["<all_urls>"]}]}