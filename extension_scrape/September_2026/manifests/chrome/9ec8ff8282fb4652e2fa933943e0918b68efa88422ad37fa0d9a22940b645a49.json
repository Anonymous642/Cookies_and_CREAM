{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ConvoBrains Meeting Capture", "version": "0.3.0", "description": "Detect Google Meet / Zoom meetings and upload recordings to ConvoBrains.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "tabCapture", "offscreen", "activeTab", "sidePanel", "identity"], "host_permissions": ["https://*.convobrains.com/*", "https://meet.google.com/*", "https://*.zoom.us/*"], "web_accessible_resources": [{"resources": ["config.json"], "matches": ["<all_urls>"]}], "action": {"default_title": "ConvoBrains Meeting Capture", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}