{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Such Summary", "version": "2.1.1", "description": "Progressive summarisation for web pages, PDFs, Google Docs, YouTube videos and Gmail emails. Just press Option + S.", "permissions": ["activeTab", "storage", "scripting", "identity"], "host_permissions": ["https://api.anthropic.com/*", "https://summariser.hartreeworks.org/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "commands": {"summarize-current-page": {"suggested_key": {"default": "Alt+S", "mac": "Option+S"}, "description": "Summarise current article"}}, "web_accessible_resources": [{"resources": ["styles/*", "lib/*"], "matches": ["<all_urls>"]}]}