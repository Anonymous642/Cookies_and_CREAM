{"update_url": "https://clients2.google.com/service/update2/crx", "name": "EzReply - AI Writing Assistant for X, LinkedIn & Reddit", "manifest_version": 3, "version": "1.0.16", "description": "Generate replies & DMs for X, LinkedIn & Reddit. Great for cold outreach, marketing & engagement.", "permissions": ["storage", "sidePanel", "scripting", "tabs"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open EzReply side panel"}}, "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://pro.x.com/*", "https://ezreply.co/*", "https://api.ezreply.co/*", "https://www.linkedin.com/*", "https://www.reddit.com/*"], "externally_connectable": {"matches": ["https://ezreply.co/*", "https://api.ezreply.co/*", "http://localhost:3000/*", "http://localhost:3001/*"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://pro.x.com/*"], "js": ["inject.js", "x-inject.js"], "css": ["css/inject.css"]}, {"matches": ["https://www.linkedin.com/*"], "js": ["linkedin-inject.js"], "css": ["css/inject.css"]}, {"matches": ["https://www.reddit.com/*"], "js": ["reddit-inject.js"], "css": ["css/inject.css"]}], "web_accessible_resources": [{"resources": ["icons/button.svg", "icons/button_error.svg"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://pro.x.com/*", "https://www.linkedin.com/*", "https://www.reddit.com/*"]}]}