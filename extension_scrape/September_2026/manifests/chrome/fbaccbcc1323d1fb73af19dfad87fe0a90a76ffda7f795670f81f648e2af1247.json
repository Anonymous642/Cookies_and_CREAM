{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Text Summary", "version": "2.5", "description": "Extract clean, readable content from web pages then make summary of it", "permissions": ["identity", "identity.email", "scripting", "activeTab", "storage", "tabs", "webNavigation"], "host_permissions": ["http://localhost:8000/*", "https://*/*", "http://*/*"], "action": {"default_title": "Text Summary", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["sidebar.html", "sidebar.css", "images/icon48.png", "utility.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["utility.js", "content.js"], "css": ["styles.css"], "run_at": "document_start"}]}