{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timestamps for YouTube", "description": "Add timestamps to YouTube videos", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage"], "action": {"default_title": "Timestamps for YouTube"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icon/128.png", "icon/icon-white.png"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://www.youtube.com/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T"}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content-scripts/content.js"]}]}