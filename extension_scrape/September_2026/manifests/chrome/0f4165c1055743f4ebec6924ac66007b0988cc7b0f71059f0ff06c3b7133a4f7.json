{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Conversense Onboarding", "version": "1.0.0", "description": "Sync your LinkedIn session with Conversense to simplify onboarding and avoid repeated captchas.", "permissions": ["cookies", "storage", "tabs", "webNavigation"], "host_permissions": ["https://conversense.io/*", "https://www.linkedin.com/*", "https://linkedin.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://conversense.io/*"], "js": ["content.js"], "run_at": "document_idle"}]}