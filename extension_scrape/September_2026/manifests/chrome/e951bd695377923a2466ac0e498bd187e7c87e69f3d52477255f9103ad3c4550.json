{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Afiplace Importer", "version": "1.42.1", "description": "Importa produtos de marketplaces como Mercado Livre, Shopee e outros para o Afiplace, que cria e publica seus an\u00fancios de afiliado.", "permissions": ["activeTab", "storage", "cookies", "clipboardRead", "tabs", "offscreen", "declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": [{"id": "afp_frame_headers", "enabled": true, "path": "rules_frame_headers.json"}]}, "host_permissions": ["https://*.mercadolivre.com.br/*", "https://api.mercadolibre.com/*", "https://*.shopee.com.br/*", "https://*.amazon.com.br/*", "https://*.aliexpress.com/*", "https://*.shein.com/*", "https://*.temu.com/*", "https://afiplace.site/*", "https://*.afiplace.site/*", "https://link.amazon/*", "https://amzn.to/*", "https://a.co/*", "https://meli.la/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/icon-white.png", "icons/icon32.png", "icons/logo-mark.png"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "Importar para Afiplace", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.mercadolivre.com.br/*", "https://produto.mercadolivre.com.br/*", "https://lista.mercadolivre.com.br/*"], "js": ["content-ml-keepalive.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["https://www.mercadolivre.com.br/*", "https://produto.mercadolivre.com.br/*", "https://lista.mercadolivre.com.br/*"], "js": ["shared-button-style.js", "content-ml.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*"], "exclude_matches": ["https://affiliate.shopee.com.br/*"], "js": ["content-shopee-keepalive.js", "content-shopee-apibridge.js"], "run_at": "document_s