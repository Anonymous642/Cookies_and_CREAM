{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Cringe-o-meter", "description": "Tired of seeing cringe content on LinkedIn? This extension automatically evaluates every post you see.", "version": "1.3.6", "icons": {"16": "img/logo-16.png", "32": "img/logo-34.png", "48": "img/logo-48.png", "128": "img/logo-128.png"}, "permissions": ["storage"], "host_permissions": ["https://cringe-o-meter.com/*", "https://backend.cringe-o-meter.com/*"], "action": {"default_popup": "popup.html", "default_title": "Cringe-o-meter Settings"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "all_frames": true, "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}