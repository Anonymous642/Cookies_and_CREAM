{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KlikNote", "description": "Capture ideas at the speed of thought. KlikNote is a local-first, blazing-fast note-taking app. Think, note, klik!", "version": "1.1.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "notifications", "activeTab", "scripting", "identity", "alarms"], "commands": {"_execute_action": {"description": "Open KlikNote popup", "suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "save-highlight": {"description": "Save highlighted text to KlikNote", "suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "KlikNote", "default_popup": "popup.html"}}