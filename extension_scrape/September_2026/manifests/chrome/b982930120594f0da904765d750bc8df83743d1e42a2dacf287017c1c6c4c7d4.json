{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecordooStudio \u2014 Screen Recorder & Editor", "short_name": "RecordooStudio", "version": "1.0.1", "description": "Record your tab, an area, the screen, a window or your camera \u2014 edit with zooms, blur, annotations, export to MP4, WebM or GIF.", "author": "HisyarDigital", "minimum_chrome_version": "116", "permissions": ["activeTab", "tabs", "tabCapture", "desktopCapture", "offscreen", "storage", "unlimitedStorage", "scripting", "downloads", "contextMenus", "alarms", "notifications"], "optional_permissions": ["identity"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "RecordooStudio", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/overlay.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/*", "icons/*", "fonts/*", "editor/*", "pages/*", "lib/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or stop recording"}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume recording"}, "cancel-recording": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Cancel recording"}, "recording-panel": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Show the recording panel on the page"}, "toggle-draw": {"description": "Toggle the drawing tools"}}, "content_security_policy": {"extension_pages": "scr