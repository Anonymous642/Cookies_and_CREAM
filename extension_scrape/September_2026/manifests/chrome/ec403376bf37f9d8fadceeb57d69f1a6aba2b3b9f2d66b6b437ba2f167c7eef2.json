{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CrackGPT \u2014 AI Assessment Assistant", "version": "1.4.1", "description": "Ask anything about the page you're studying. Get instant MCQ answers, explanations, and step-by-step solutions powered by CrackGPT.", "homepage_url": "https://crackgpt.in/crackgpt-extension", "author": "Recforge International", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open CrackGPT Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/pageContext.js", "content/markdown.js", "content/agentActions.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "scripting", "sidePanel", "tabCapture"], "host_permissions": ["https://api.openai.com/*", "https://*.googleapis.com/*", "https://crackgpt.in/*", "http://*/*", "https://*/*"], "externally_connectable": {"matches": ["https://crackgpt.in/*", "https://www.crackgpt.in/*", "http://localhost/*", "http://127.0.0.1/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.googleapis.com https://accounts.google.com https://api.openai.com"}, "web_accessible_resources": [{"resources": ["icons/icon48.png", "auth.html", "auth.js", "lib/firebaseConfig.js", "lib/firebaseAuth.js", "lib/openaiKey.js"], "matches": ["http://*/*", "https://*/*"]}]}