{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TranslateMate AI: Chat Translator for Any Website", "version": "1.9.0", "description": "Translate as you type: write in your language, send in theirs. AI chat translator for WhatsApp Web, Gmail, Slack, Intercom & more.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "commands": {"toggle-translation": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle Chat Translator on/off"}, "translate-selection": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Ctrl+Shift+T"}, "description": "Translate Selection"}, "close-overlay": {"description": "Close Overlay"}, "tone-professional": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Ctrl+Shift+P"}, "description": "Shift to Professional"}, "tone-casual": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Ctrl+Shift+C"}, "description": "Shift to Casual"}, "tone-friendly": {"description": "Shift to Friendly"}}, "host_permissions": ["<all_urls>", "https://*.workers.dev/*", "https://api.openai.com/*", "https://api.anthropic.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}]}