{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Transmate Pro - Realtime Message Translator & Random Auto Reloader", "description": "Translate your messages across platforms like Fiverr, Upwork, Freelancer, and more. Auto-refresh pages within custom time intervals.", "version": "1.0.1", "icons": {"16": "icon16.png", "19": "icon19.png", "32": "icon32.png", "38": "icon38.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://*.fiverr.com/*", "https://*.freelancer.com/*", "https://*.upwork.com/*", "https://*.linkedin.com/*", "https://*.behance.net/*", "https://dribbble.com/*", "https://*.whatsapp.com/*", "https://*.telegram.org/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.fiverr.com/orders/*", "https://www.fiverr.com/inbox/*", "https://www.freelancer.com/messages/*", "https://www.upwork.com/ab/messages/*", "https://www.linkedin.com/messaging/*", "https://www.behance.net/inbox/*", "https://dribbble.com/messages/*", "https://web.whatsapp.com/*", "https://web.telegram.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "19": "icon19.png", "32": "icon32.png", "38": "icon38.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["imgs/*.png"], "matches": ["<all_urls>"]}]}