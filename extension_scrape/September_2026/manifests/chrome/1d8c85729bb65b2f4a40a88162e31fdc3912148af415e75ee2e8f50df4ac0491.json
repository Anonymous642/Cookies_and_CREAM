{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Delay", "version": "1.2", "description": "Delays your Twitter/X feed by a custom number of minutes.", "permissions": ["storage"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}