{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookify", "short_name": "Bookify", "version": "3.2.0", "description": "Smart bookmark management with intelligent search, folder organization, CSV/JSON import/export, reading list, and modern interface", "author": "Bookify Team", "homepage_url": "https://github.com/bookify-extension", "icons": {"16": "icons/bookifylogo.png", "32": "icons/bookifylogo.png", "48": "icons/bookifylogo.png", "128": "icons/bookifylogo.png"}, "permissions": ["bookmarks", "storage", "notifications", "contextMenus", "downloads", "activeTab"], "commands": {"quick-bookmark": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Quick bookmark current page"}, "bookmark-to-folder": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Bookmark current page to specific folder"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "index.html", "default_title": "Bookify - Bookmark Manager", "default_icon": {"16": "icons/bookifylogo.png", "32": "icons/bookifylogo.png", "48": "icons/bookifylogo.png", "128": "icons/bookifylogo.png"}}, "minimum_chrome_version": "88"}