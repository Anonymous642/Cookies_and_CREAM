{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NJ Wordstat Helper \u2014 \u042f\u043d\u0434\u0435\u043a\u0441.Wordstat", "short_name": "NJ Wordstat", "version": "1.3.1", "description": "\u0421\u0431\u043e\u0440 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0440\u0430\u0437, \u0447\u0430\u0441\u0442\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0438 \u043c\u0438\u043d\u0443\u0441-\u0441\u043b\u043e\u0432 \u0438\u0437 \u042f\u043d\u0434\u0435\u043a\u0441.Wordstat \u0441 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u043e\u0439, \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u043c \u0438 AI-\u043f\u043e\u0434\u0431\u043e\u0440\u043e\u043c \u043c\u0438\u043d\u0443\u0441-\u0441\u043b\u043e\u0432.", "permissions": ["storage", "unlimitedStorage", "tabs", "clipboardWrite", "sidePanel", "scripting"], "host_permissions": ["https://wordstat.yandex.ru/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["https://wordstat.yandex.ru/*"], "js": ["src/content/index.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "side_panel": {"default_path": "src/sidebar/index.html"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "NJ Wordstat Helper"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"add-all": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432\u0441\u0435 \u0444\u0440\u0430\u0437\u044b \u0441\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b"}, "copy-phrases": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "\u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0444\u0440\u0430\u0437\u