{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Quoter: Clear Email Replies in 1 Second", "version": "1.0", "description": "Quote & reply to specific points in email with a single, glorious click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "The Quoter: Clear Email Replies in 1 Second"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/mail/*", "https://outlook.office.com/mail/*", "https://www.icloud.com/mail/*", "https://icloud.com/mail/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "host_permissions": ["https://mail.google.com/", "https://outlook.live.com/", "https://outlook.office.com/", "https://www.icloud.com/", "https://icloud.com/"], "permissions": ["contextMenus"], "background": {"service_worker": "background.js"}, "commands": {"quick-quote": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Quote selected text instantly."}}}