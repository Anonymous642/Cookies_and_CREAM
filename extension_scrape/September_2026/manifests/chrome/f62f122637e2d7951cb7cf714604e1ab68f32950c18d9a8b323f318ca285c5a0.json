{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Admunio \u2014 AI Data Leak Protection and Prevention", "short_name": "Admunio", "description": "Prevents data leaks to AI tools like ChatGPT, Gemini, and Claude. Runs 100% locally\u2014your data never leaves your device.", "version": "1.0.0", "action": {"default_title": "Admunio", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["storage", "unlimitedStorage", "offscreen"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["transformers/*.wasm", "transformers/*.mjs", "chunks/*"], "matches": ["<all_urls>"]}], "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://admunio.com"}