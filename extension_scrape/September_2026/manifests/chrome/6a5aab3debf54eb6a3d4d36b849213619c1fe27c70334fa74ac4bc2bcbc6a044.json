{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nyx: Dark Mode & Font Changer", "version": "1.0.0", "description": "Lightweight dark mode & custom font changer. Reduce eye strain, dim screen & force dark theme on all websites. Dyslexia friendly.", "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["inject.css"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle Nyx Dark Mode globally"}}, "web_accessible_resources": [{"resources": ["inject.css", "fonts/OpenDyslexic-Regular.woff2"], "matches": ["<all_urls>"]}]}