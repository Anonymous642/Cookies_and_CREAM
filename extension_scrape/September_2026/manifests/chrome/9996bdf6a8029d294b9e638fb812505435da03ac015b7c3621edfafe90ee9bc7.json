{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whisperian \u2014 Read Aloud", "version": "1.3.0", "description": "Read any web page aloud with live word-level highlighting and click-to-skip, powered by the Vaani TTS API.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Whisperian \u2014 read this page aloud", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "commands": {"toggle-read": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Read selection or page aloud / play-pause"}, "stop-read": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Stop reading"}, "next-block": {"suggested_key": {"default": "Alt+Period", "mac": "Alt+Period"}, "description": "Skip to next block"}, "prev-block": {"suggested_key": {"default": "Alt+Comma", "mac": "Alt+Comma"}, "description": "Go back to previous block"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "offscreen", "contextMenus"], "host_permissions": ["https://vaani.akl773.com/*"], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["fonts/EBGaramond.woff2", "fonts/Figtree.woff2"], "use_dynamic_url": false}]}