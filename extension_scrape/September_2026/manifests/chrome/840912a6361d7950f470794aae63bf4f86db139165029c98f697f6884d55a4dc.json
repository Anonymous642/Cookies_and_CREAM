{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "resetWeb - Visual Feedback for resetDocs", "version": "1.0.0", "description": "Add comments and create tasks directly on any live website. Integrated with resetDocs for seamless team collaboration.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "storage", "notifications", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "resetWeb - Add Feedback"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/styles.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-comment-mode": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C", "linux": "Alt+C"}, "description": "Toggle comment mode to place pins"}}, "web_accessible_resources": [{"resources": ["assets/*", "content/ui/*", "public/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}