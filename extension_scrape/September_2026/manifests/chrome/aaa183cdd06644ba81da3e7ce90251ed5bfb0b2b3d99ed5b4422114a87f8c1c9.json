{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Redreach - Reddit DM Automation", "description": "Redreach is a browser extension that allows you to automate your Reddit messaging outreach.", "version": "1.0.5", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "activeTab", "cookies"], "host_permissions": ["*://www.reddit.com/*", "*://chat.reddit.com/*", "http://localhost:8000/*", "https://redreach.ai/*", "http://localhost:1338/*", "https://redreach-strapi-production.up.railway.app/*"], "web_accessible_resources": [{"resources": ["sidebar.html", "redreach_logo_black.png"], "matches": ["*://www.reddit.com/*", "*://chat.reddit.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://chat.reddit.com/*", "*://www.reddit.com/*"], "js": ["content-scripts/content.js"]}]}