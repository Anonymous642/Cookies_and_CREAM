{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Idea Vault", "version": "1.0.2", "description": "Capture and track your LLM conversations for idea development", "permissions": ["storage", "activeTab", "alarms", "notifications"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.com/*", "https://x.ai/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content-scripts/base.js", "content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/base.js", "content-scripts/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/base.js", "content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content-scripts/base.js", "content-scripts/perplexity.js"], "run_at": "document_idle"}, {"matches": ["https://grok.com/*", "https://x.ai/*"], "js": ["content-scripts/base.js", "content-scripts/grok.js"], "run_at": "document_idle"}], "action": {"default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-current": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture current conversation"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Open Idea Vault popup"}}}