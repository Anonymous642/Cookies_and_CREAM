{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "rating-viewer", "version": "1.0.0", "description": "Color-code ratings on Letterboxd film posters and Crunchyroll anime cards.", "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Rating Viewer settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://letterboxd.com/*", "https://www.letterboxd.com/*"], "js": ["settings.js", "rating-parser.js", "content.js"], "css": ["style.css"], "run_at": "document_idle"}, {"matches": ["https://crunchyroll.com/*", "https://www.crunchyroll.com/*"], "js": ["settings.js", "crunchyroll-parser.js", "crunchyroll-content.js"], "css": ["crunchyroll.css"], "run_at": "document_idle"}]}