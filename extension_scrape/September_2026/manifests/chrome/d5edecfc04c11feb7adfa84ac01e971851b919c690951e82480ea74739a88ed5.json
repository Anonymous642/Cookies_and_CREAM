{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScrollSay - AI Comment Assistant", "version": "1.0.2", "description": "Generate intelligent comments on social media posts with AI assistance", "permissions": ["storage", "activeTab"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' https://scrollsay.com; base-uri 'self';"}, "host_permissions": ["https://*.linkedin.com/*", "https://api.scrollsay.com/*", "https://api-dev.scrollsay.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["constants.js", "utils/storage.js", "utils/i18n.js", "utils/api-signature.js", "utils/analytics.js", "utils/device-fingerprint.js", "utils/auth-service.js", "utils/ai-client.js", "utils/css-variables.js", "content/platform-handlers/linkedin.js", "ui/overlay.js", "content/content-script.js"], "css": ["ui/variables.css", "ui/overlay.css"], "run_at": "document_idle"}, {"matches": ["https://*.execute-api.us-east-2.amazonaws.com/*", "https://*.amazonaws.com/*"], "js": ["constants.js", "utils/api-config.js", "content/auth-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "ScrollSay Settings"}, "icons": {"16": "icons/scroll-say-logo.png", "32": "icons/scroll-say-logo.png", "48": "icons/scroll-say-logo.png", "128": "icons/scroll-say-logo.png"}, "web_accessible_resources": [{"resources": ["ui/*", "icons/*", "locales/*", "popup/components/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://api.scrollsay.com/*", "https://api-dev.scrollsay.com/*", "https://*.amazonaws.com/*"]}}