{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mendal", "version": "1.0.0", "description": "AI-based social media feed filter. Focus on what matters.", "author": "Mendal Team", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.linkedin.com/*"], "background": {"service_worker": "background/index.js", "type": "module"}, "action": {"default_popup": "index.html", "default_title": "Mendal - Focus Your Feed"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content/x.js"], "run_at": "document_idle"}, {"matches": ["*://*.linkedin.com/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://router.huggingface.co"}, "web_accessible_resources": []}