{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BuddyWolfy Extension", "description": "Instantly analyze, translate and save vocabulary from any webpage. Build your personal word bank while browsing.", "version": "0.9.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://buddywolfy.com/*"], "externally_connectable": {"matches": ["https://buddywolfy.com/*", "http://localhost:3000/*"]}, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "default_title": "BuddyWolfy Extension", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["wolfy-blue.svg", "wolfy-icon.svg", "fonts/*.ttf"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}