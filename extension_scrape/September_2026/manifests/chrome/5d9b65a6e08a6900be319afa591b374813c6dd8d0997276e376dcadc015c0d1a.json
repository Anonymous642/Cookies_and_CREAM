{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LogiScan \u2014 analyser une annonce", "version": "2.1.0", "description": "Analyse l'annonce immobili\u00e8re que vous consultez, dans la page : adresse probable, prix compar\u00e9 aux ventes voisines, risques.", "homepage_url": "https://logiscan.fr/extension", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["src/detection.js", "src/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Analyser cette annonce avec LogiScan", "default_icon": {"16": "icons/icone-16.png", "32": "icons/icone-32.png", "48": "icons/icone-48.png", "128": "icons/icone-128.png"}}, "web_accessible_resources": [{"resources": ["src/panneau.html", "src/panneau.css", "src/panneau.js", "src/service.js", "src/apercu.js", "brand/logo-horizontal-sombre.svg", "brand/logo-symbole-blanc.svg", "fonts/plus-jakarta-sans-latin.woff2"], "matches": ["https://*/*", "http://*/*"], "use_dynamic_url": true}], "icons": {"16": "icons/icone-16.png", "32": "icons/icone-32.png", "48": "icons/icone-48.png", "128": "icons/icone-128.png"}}