{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Matters", "version": "2.0", "description": "Instantly jump to your most-used tabs by domain, with tab cycling, groups, keyboard shortcuts, and a smart priority list.", "permissions": ["tabs", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Click to jump to a domain tab", "default_icon": {"16": "Icons/TabMatters2_16.png", "32": "Icons/TabMatters2_32.png", "48": "Icons/TabMatters2_48.png", "128": "Icons/TabMatters2_128.png"}}, "icons": {"16": "Icons/TabMatters2_16.png", "32": "Icons/TabMatters2_32.png", "48": "Icons/TabMatters2_48.png", "128": "Icons/TabMatters2_128.png"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"Show-Options": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Go to settings page"}, "Navigate-To-Tab": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Jump to Tab"}}}