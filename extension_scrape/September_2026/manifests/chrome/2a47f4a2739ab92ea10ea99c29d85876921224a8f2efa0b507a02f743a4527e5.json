{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Big 5 Archive", "description": "Automatically redirects articles from the big 5 newspapers (WSJ, NYT, WaPo, USAT, LAT) to archive.is", "version": "0.4.1", "permissions": ["webRequest", "storage", "tabs"], "host_permissions": ["*://*.wsj.com/*", "*://*.nytimes.com/*", "*://*.theathletic.com/*", "*://*.washingtonpost.com/*", "*://*.usatoday.com/*", "*://*.latimes.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}