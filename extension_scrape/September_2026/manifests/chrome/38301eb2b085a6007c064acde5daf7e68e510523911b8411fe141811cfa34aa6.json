{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Covered - Fetch Movie/TV/Book Poster Cover Image Search", "short_name": "Covered", "version": "1.1.0", "description": "Find and copy poster/cover image URLs from TMDB & Open Library (with optional Google Books fallback). Bookmark your favorites.", "icons": {"175": "app-icon2-175.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["storage", "contextMenus", "clipboardWrite", "activeTab", "scripting", "tabs"], "options_page": "settings.html", "host_permissions": ["https://api.themoviedb.org/*", "https://image.tmdb.org/*", "https://openlibrary.org/*", "https://covers.openlibrary.org/*", "https://www.googleapis.com/books/*"], "background": {"service_worker": "bg.js", "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+P"}, "description": "Open Covered"}}, "web_accessible_resources": [{"resources": ["bookmarks.html", "bookmarks.css", "bookmarks.js", "settings.html", "settings.css", "settings.js"], "matches": ["<all_urls>"]}]}