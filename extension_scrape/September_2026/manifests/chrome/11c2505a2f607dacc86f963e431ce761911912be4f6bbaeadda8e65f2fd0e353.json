{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextSnap: Screenshots & AI Visual Feedback", "version": "1.2.1", "description": "Element-snapping screenshot tool with AI visual feedback queue \u2014 capture, annotate, and collect UI feedback.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "clipboardWrite", "commands", "downloads", "scripting", "storage"], "commands": {"take-screenshot": {"suggested_key": {"mac": "Command+Shift+2", "default": "Ctrl+Shift+2"}, "description": "Enter screenshot mode"}, "enter-comment-mode": {"suggested_key": {"mac": "Command+Shift+1", "default": "Ctrl+Shift+1"}, "description": "Enter comment mode"}}, "background": {"service_worker": "background/service_worker.js", "type": "module"}, "action": {"default_title": "ContextSnap", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["content_scripts/content-0.css"], "matches": ["<all_urls>"]}]}