{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Go Shortcuts", "version": "1.6.2", "description": "Keyboard-driven URL navigation. Type goto, press Tab, then a shortcut name to jump instantly. Supports search terms, aliases & sync.", "permissions": ["storage", "tabs", "tabGroups", "alarms"], "host_permissions": ["https://api.lemonsqueezy.com/*"], "omnibox": {"keyword": "goto"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Go Shortcuts", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"open-default": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Open the default shortcut URL"}, "open-options": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Open the Go Shortcuts options page"}}}