{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot Engine", "version": "2.5.5", "author": "Ali Ahmad", "description": "Capture full pages, selected areas, or the visible viewport, then edit, copy, or save locally.", "minimum_chrome_version": "102", "permissions": ["activeTab", "alarms", "clipboardWrite", "downloads", "scripting", "storage", "unlimitedStorage"], "action": {"default_title": "Screenshot Engine", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open or close the capture menu"}, "capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Capture the complete page"}, "capture-area-selection": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Capture a selected area of the page"}, "capture-visible-area": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Capture just the visible area"}}, "background": {"service_worker": "service-worker.js"}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' blob: data:"}}