{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Comp Buddy - Instant Comps When Buying Live", "version": "2.8.8", "description": "Instant comps while you buy live. Scan any item on Whatnot, see recent eBay sold prices, and never overpay in a live sale again.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.whatnot.com/*", "https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.ebay.com/*", "https://*.ebay.co.uk/*", "https://*.shopify.com/*", "https://cardcomp-worker.billy-f04.workers.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.whatnot.com/*", "https://*.whatnot.com/live/*", "https://*.ebay.com/*", "https://*.ebay.co.uk/*", "https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.shopify.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/logo.png", "icons/ebay.png", "icons/cardladder.svg"], "matches": ["<all_urls>"]}], "commands": {"snip-item": {"suggested_key": {"default": "Alt+S"}, "description": "Snip an item from screen"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}