{"update_url": "https://clients2.google.com/service/update2/crx", "name": "tabmgmt", "short_name": "tabmgmt", "description": "Close/gather same-domain tabs and move tabs with keyboard shortcuts.", "version": "0.1.2", "manifest_version": 3, "permissions": ["tabs"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"close-tabs": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Close same-domain tabs"}, "gather-tabs": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Gather same-domain tabs around active tab"}, "move-tab-left": {"suggested_key": {"default": "Alt+Shift+Left", "mac": "Ctrl+Command+Left"}, "description": "Move tab left"}, "move-tab-right": {"suggested_key": {"default": "Alt+Shift+Right", "mac": "Ctrl+Command+Right"}, "description": "Move tab right"}, "gather-tabs-all": {"description": "Gather all tabs by domain"}, "move-tab-start": {"description": "Move tab to start"}, "move-tab-end": {"description": "Move tab to end"}}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}}