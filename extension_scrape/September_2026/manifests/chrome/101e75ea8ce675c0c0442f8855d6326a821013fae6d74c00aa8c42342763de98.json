{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindHunt AI - LinkedIn Profile Importer", "version": "2.2.1", "description": "Import LinkedIn profiles directly to MindHunt AI kanban board", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.linkedin.com/*", "https://*.mindhuntai.com/*", "https://www.google-analytics.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/in/*"], "js": ["content/linkedin-scraper.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}