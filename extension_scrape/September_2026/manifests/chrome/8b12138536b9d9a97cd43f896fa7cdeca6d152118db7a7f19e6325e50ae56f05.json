{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JumpTab", "version": "1.0.0", "description": "Hold Ctrl, tap Q to jump between your 5 most recent tabs.", "permissions": ["tabs", "storage", "scripting", "favicon"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "JumpTab \u2014 Ctrl+Q to cycle recent tabs"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["overlay.js"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"]}], "commands": {"cycle-forward": {"suggested_key": {"mac": "MacCtrl+Q"}, "description": "Cycle forward through recent tabs"}, "cycle-backward": {"suggested_key": {"mac": "MacCtrl+Shift+Q"}, "description": "Cycle backward through recent tabs"}}}