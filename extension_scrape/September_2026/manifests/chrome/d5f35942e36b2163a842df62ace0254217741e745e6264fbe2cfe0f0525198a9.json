{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TokTranscript \u2014 TikTok Transcript Extractor", "version": "1.0.0", "description": "Extract any TikTok video transcript in one click. AI transcript, auto-translate, viral hook breakdown.", "permissions": ["storage"], "host_permissions": ["https://www.tiktok.com/*", "https://toktranscript.com/*", "https://*.toktranscript.com/*"], "content_scripts": [{"matches": ["https://www.tiktok.com/*"], "js": ["page_helper.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://toktranscript.com/*", "https://*.toktranscript.com/*"], "js": ["config.js", "token-bridge.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TokTranscript", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.tiktok.com/*"]}]}