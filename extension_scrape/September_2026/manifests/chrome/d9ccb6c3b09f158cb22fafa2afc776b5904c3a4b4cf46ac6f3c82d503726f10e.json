{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ella: AI Creator Workspace & Video Editor", "version": "2.0.11", "description": "Generate, edit, and export video using the best AI models without juggling tabs, tools, or workflows.", "icons": {"48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["index.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "toggle ella"}, "commands": {"toggleSidebar": {"description": "Toggle the Ella panel", "suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}}, "toggleFullWidth": {"description": "Toggle Ella full width", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "captureScreenshot": {"description": "Capture a screenshot to Ella", "suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}}}, "background": {"service_worker": "background.js", "type": "module"}}