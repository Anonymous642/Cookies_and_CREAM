{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AslanDeck", "version": "2.0.0", "description": "Professional design inspection toolkit for web developers - extract colors, fonts, CSS, and assets.", "action": {"default_title": "AslanDeck - Design Tools", "default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "index.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["index.html", "assets/*", "icons/*", "fonts/*"], "matches": ["<all_urls>"]}]}