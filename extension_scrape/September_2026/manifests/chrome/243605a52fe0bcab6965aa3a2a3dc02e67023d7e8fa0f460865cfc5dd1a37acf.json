{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WiFi & Filter Guard v1.0", "version": "1.1", "description": "Blocks Chromebook when WiFi is off or content filter is unreachable. Blocks Canva video embeds.", "permissions": ["declarativeNetRequest", "alarms", "storage", "webNavigation", "identity", "identity.email"], "host_permissions": ["https://www.gstatic.com/*", "https://connectivitycheck.gstatic.com/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://*.canva.com/*", "https://*.canva-apps.com/*", "https://*.canvausercontent.com/*"], "js": ["canva-block.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "canva_ruleset", "enabled": true, "path": "canva_rules.json"}]}, "storage": {"managed_schema": "managed_schema.json"}, "icons": {"48": "icon48.png", "128": "icon128.png"}}