{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TrustCheck \u2014 Fake Review Detector for Amazon & Google", "version": "1.0.2", "description": "Spot fake reviews on Amazon, Google Maps, Trustpilot & Yelp. AI trust scores protect you from manipulated ratings.", "permissions": ["activeTab"], "host_permissions": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*", "https://www.google.com/maps/*", "https://maps.google.com/*", "https://www.trustpilot.com/*", "https://www.yelp.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*"], "js": ["analyzer.js", "content_amazon.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/maps/*", "https://maps.google.com/*"], "js": ["analyzer.js", "content_google.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.trustpilot.com/*"], "js": ["analyzer.js", "content_trustpilot.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://www.yelp.com/*"], "js": ["analyzer.js", "content_yelp.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Open TrustCheck"}}}