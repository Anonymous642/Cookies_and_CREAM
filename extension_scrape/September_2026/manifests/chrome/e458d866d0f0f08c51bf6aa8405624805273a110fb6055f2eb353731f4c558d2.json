{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Transcript Summarizer (Chrome)", "version": "2.0", "description": "Extracts and summarizes transcripts from YouTube and Vimeo using Gemini AI.", "permissions": ["storage", "scripting", "activeTab", "webRequest", "downloads"], "host_permissions": ["*://*.youtube.com/*", "*://*.vimeo.com/*", "*://player.vimeo.com/*", "https://*.googleapis.com/*"], "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*", "*://player.vimeo.com/video/*"], "js": ["content-scripts/summary-panel.js"], "all_frames": true}, {"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*"], "js": ["content-scripts/youtube-main-world.js"], "world": "MAIN"}, {"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*"], "js": ["content-scripts/youtube.js"]}, {"matches": ["*://player.vimeo.com/video/*"], "js": ["content-scripts/vimeo.js"], "all_frames": true}]}