{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Alt Inspector \u2013 Alt-Text Overlay", "version": "1.1.0", "description": "Zeigt Alt-Texte aller Bilder an, markiert fehlende Alt-Attribute und erzeugt CSV- & PDF-Reports.", "action": {"default_title": "Alt Inspector", "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Alt-Inspector Overlay ein-/ausblenden"}}, "web_accessible_resources": [{"resources": ["contentScript.js", "icons/*.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}