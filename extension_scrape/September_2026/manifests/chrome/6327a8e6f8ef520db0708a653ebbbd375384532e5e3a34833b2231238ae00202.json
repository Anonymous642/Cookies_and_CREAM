{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShopSaver", "version": "2.0.1", "description": "Auto-save your Shopify changes before you leave the current page. Resolves the small annoyance of forgetting to hit the Save button.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://*.myshopify.com/*", "https://admin.shopify.com/*"], "content_scripts": [{"matches": ["https://*.myshopify.com/admin/*", "https://admin.shopify.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html"}