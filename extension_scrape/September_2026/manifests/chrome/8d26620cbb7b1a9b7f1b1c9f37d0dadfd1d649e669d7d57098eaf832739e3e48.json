{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GPT Defender", "version": "0.1.3", "description": "Detect sensitive data in ChatGPT input and request user consent before making corrections.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "offscreen", "identity", "identity.email", "alarms", "declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "chatgpt_iframe_rules", "enabled": false, "path": "chatgpt-rules.json"}]}, "host_permissions": ["https://www.gptdefender.ai/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://api.ipinfo.io/*", "https://ipapi.co/*", "https://amplitude.com/*", "https://*.amplitude.com/*", "https://huggingface.co/*", "https://*.huggingface.co/*"], "background": {"service_worker": "assets/background.js", "type": "module"}, "action": {"default_title": "GPT Defender", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"], "js": ["assets/content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"], "js": ["assets/chatgptBridge.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.gptdefender.ai/welcome", "http://localhost:3000/welcome"], "js": ["assets/welcomeContent.js"], "run_at": "document_idle"}], "key": ""}