{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CyberDeck - Secure Browsing & Privacy Toolkit", "version": "1.0.1", "default_locale": "en", "description": "Enhance your online security. Scan URLs for threats, verify connection speed, and block invisible trackers.", "icons": {"16": "assets/icons/icon.png", "48": "assets/icons/icon.png", "128": "assets/icons/icon.png"}, "permissions": ["activeTab", "storage", "declarativeNetRequest", "privacy", "browsingData"], "host_permissions": ["https://www.1secmail.com/*", "https://api.pwnedpasswords.com/*", "https://speed.cloudflare.com/*", "http://127.0.0.1:5001/*", "*://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["features/shield/tracker_detector.js"], "run_at": "document_end"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": false, "path": "features/adblock/rules.json"}]}, "action": {"default_popup": "ui/popup/popup.html"}, "background": {"service_worker": "background.js"}}