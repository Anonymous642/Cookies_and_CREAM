{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Recorder Plus", "short_name": "Recorder", "version": "1.0.0", "description": "Record your screen with an on-page control bar and camera bubble. Trim, crop, download MP4, or share a private link.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Screen Recorder Plus"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"open-recorder": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Show the recorder controls on this page"}}, "minimum_chrome_version": "116", "permissions": ["offscreen", "tabCapture", "downloads", "storage", "scripting", "tabs", "alarms", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["camera/camera.html", "overlay/overlay.css"], "matches": ["<all_urls>"]}]}