{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LLM Privacy Shield", "version": "1.0.1", "description": "Chrome extension that intercepts and redacts sensitive data before messages are sent to LLM chat interfaces", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://huggingface.co/chat/*", "https://chat.mistral.ai/*", "https://poe.com/*", "https://perplexity.ai/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://huggingface.co/chat/*", "https://chat.mistral.ai/*", "https://poe.com/*", "https://perplexity.ai/*"], "js": ["content_interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://copilot.microsoft.com/*", "https://huggingface.co/chat/*", "https://chat.mistral.ai/*", "https://poe.com/*", "https://perplexity.ai/*"], "js": ["content_ui.js"], "run_at": "document_idle"}], "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}