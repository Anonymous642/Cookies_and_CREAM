{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sheet Viewer", "version": "2.8", "description": "Auto-render markdown from Lark Sheet/Google Sheets/Tencent Docs cells in the side panel.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "clipboardRead", "sidePanel"], "host_permissions": ["https://*.feishu.cn/*", "https://*.larksuite.com/*", "https://*.larkoffice.com/*", "https://docs.google.com/spreadsheets/*", "https://docs.qq.com/*", "https://*.doubao.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open Sheet Viewer"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "sandbox": {"pages": ["canvas-sandbox.html"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';", "sandbox": "sandbox allow-scripts; default-src 'none'; img-src data: http: https:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src data:;"}, "content_scripts": [{"matches": ["https://*.feishu.cn/*", "https://*.larksuite.com/*", "https://*.larkoffice.com/*", "https://docs.google.com/spreadsheets/*", "https://docs.qq.com/*", "https://*.doubao.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}