{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebWizKit", "description": "Multiple useful tools: Copy Multi Link, Dark Mode, Image Tools (Edit & Screenshot), Eyedropper, CSS Inspector, Tech Stack Detector.", "version": "0.1.1", "icons": {"128": "images/icons/icon-192x192.png", "256": "images/icons/icon-384x384.png", "512": "images/icons/icon-512x512.png"}, "action": {"default_title": "WebWizKit", "default_popup": "src/popup/popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "clipboardWrite", "activeTab", "scripting", "tabs", "offscreen"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/copyMultiLink.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["content/darkMode.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["content/colorPicker.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["content/cssInspector.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["content/imageTools.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["content/techDetector.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["content/volumeControl.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["content/ocrTool.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["images/*", "tesseract/*"], "matches": ["<all_urls>"]}]}