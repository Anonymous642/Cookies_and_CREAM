{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn CV AI Assistant", "version": "1.1", "description": "Analyze your match for job vacancies using AI and increase your chances of getting hired.", "action": {"default_icon": "icons/v2/icon48.png", "default_popup": "popup/popup.html", "default_title": "LinkedIn CV AI Assistant"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.linkedin.com/*"], "background": {"service_worker": "background/background.js", "type": "module"}, "icons": {"16": "icons/v2/icon16.png", "48": "icons/v2/icon48.png", "128": "icons/v2/icon128.png"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*"], "js": ["scripts/marked.min.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/**/*.png", "popup/lib/pdf.min.js", "popup/lib/pdf.worker.min.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}