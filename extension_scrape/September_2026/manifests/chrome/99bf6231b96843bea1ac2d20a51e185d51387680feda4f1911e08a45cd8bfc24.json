{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReachButler - Grow on LinkedIn", "version": "1.4.0", "description": "Grow on LinkedIn with automated outreach, smart connection requests, AI-powered comments, and multi-step follow-up campaigns.", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://www.linkedin.com/*", "https://reachbutler.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/preload/custom-invite/*", "https://www.linkedin.com/mynetwork/invite-connect/connections/*", "https://www.linkedin.com/messaging/*", "https://www.linkedin.com/messages/*", "https://www.linkedin.com/search/results/people/*", "https://www.linkedin.com/sales/search/people/*", "https://www.linkedin.com/feed/*", "https://www.linkedin.com/posts/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.linkedin.com/*"]}], "externally_connectable": {"matches": ["https://reachbutler.com/*"]}}