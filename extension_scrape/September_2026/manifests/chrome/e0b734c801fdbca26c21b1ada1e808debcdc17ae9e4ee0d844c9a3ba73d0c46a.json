{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Video Speed & Skip Control", "version": "1.0.0", "description": "A privacy-first video controller for custom playback speeds, smart skipping, and keyboard shortcuts.", "permissions": ["storage"], "action": {"default_title": "Smart Video Controls", "default_popup": "src/popup.html"}, "background": {"service_worker": "src/background.js"}, "commands": {"increase-speed": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Increase video speed"}, "decrease-speed": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Decrease video speed"}, "skip-forward": {"suggested_key": {"default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Skip video forward"}, "skip-backward": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Skip video backward"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}], "options_page": "src/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}