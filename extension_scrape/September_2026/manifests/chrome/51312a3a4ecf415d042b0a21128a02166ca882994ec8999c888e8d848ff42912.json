{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whatsapp Data Extractor", "description": "A local, privacy-focused browser extension to extract WhatsApp Web contacts and group data directly from the browser's IndexedDB.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["*://web.whatsapp.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://web.whatsapp.com/*"], "js": ["content-scripts/content.js"]}]}