{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subvertadown ESPN Draft Sync", "description": "Sync live ESPN fantasy football draft picks to TapThatDraft and see your pick priorities in Chrome's side panel.", "version": "1.1.34", "minimum_chrome_version": "114", "permissions": ["storage", "sidePanel"], "optional_permissions": ["notifications"], "host_permissions": ["https://fantasy.espn.com/*", "https://subvertadown.com/*"], "externally_connectable": {"matches": ["https://subvertadown.com/*"]}, "icons": {"16": "src/assets/icon-16.png", "32": "src/assets/icon-32.png", "48": "src/assets/icon-48.png", "128": "src/assets/icon-128.png"}, "content_scripts": [{"matches": ["https://fantasy.espn.com/*"], "js": ["src/content.js"], "run_at": "document_start"}], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Open ESPN Draft Sync", "default_icon": {"16": "src/assets/icon-16.png", "32": "src/assets/icon-32.png"}}, "side_panel": {"default_path": "src/sidepanel.html"}, "web_accessible_resources": [{"resources": ["src/espnDraftParser.js", "src/injected.js"], "matches": ["https://fantasy.espn.com/*"]}]}