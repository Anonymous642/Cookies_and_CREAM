{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Velocity: Command Palette for ClickUp", "version": "0.1.0", "description": "Jump to any ClickUp list, view, or action with your keyboard. A command palette with saved views for the ClickUp web app.", "action": {"default_popup": "popup.html", "default_title": "Velocity for ClickUp"}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["storage", "activeTab"], "host_permissions": ["https://app.clickup.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://app.clickup.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}