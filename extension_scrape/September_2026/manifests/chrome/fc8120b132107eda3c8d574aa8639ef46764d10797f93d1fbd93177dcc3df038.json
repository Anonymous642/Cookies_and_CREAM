{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Political Tweet Filter", "version": "1.0.0", "description": "Filter political tweets using local ML inference. Privacy-focused with blur and click-to-reveal.", "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://api.anthropic.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/content-script.js"], "css": ["styles/overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["models/*", "worker/*"], "matches": ["https://twitter.com/*", "https://x.com/*"]}], "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options/options.html"}