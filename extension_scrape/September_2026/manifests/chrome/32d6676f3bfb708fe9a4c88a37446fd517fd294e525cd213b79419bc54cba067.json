{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meadow Web Capture", "version": "0.2.0", "description": "Capture images, videos, and screenshots from the web into Meadow.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "activeTab", "tabs", "scripting", "storage"], "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*", "https://api.x.com/*", "https://x.com/*", "https://twitter.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-capture.js"], "run_at": "document_idle"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-x.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open Meadow capture card"}}, "web_accessible_resources": [{"resources": ["icons/icon32.png", "assets/avatar.png", "assets/avatar-square.png"], "matches": ["<all_urls>"]}], "action": {"default_title": "Meadow Capture", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}