{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slumber Tab Suspender & Memory Saver", "version": "1.0.1", "description": "Rest your tabs. Reclaim your RAM. Native Chrome tab suspension \u2014 no tracking, no telemetry, tabs restore instantly on click.", "permissions": ["tabs", "storage", "alarms", "idle", "contextMenus", "system.memory"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/slumber16x16.png", "48": "icons/slumber48x48.png", "128": "icons/slumber128x128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/slumber16x16.png", "48": "icons/slumber48x48.png", "128": "icons/slumber128x128.png"}, "commands": {"suspend-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend the current tab"}, "suspend-all-inactive": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Suspend all inactive tabs"}, "restore-all-suspended": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Restore all suspended tabs"}, "undo-last-suspension": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Undo last suspension"}}, "web_accessible_resources": [{"resources": ["suspended/suspended.html"], "matches": ["http://*/*", "https://*/*"]}]}