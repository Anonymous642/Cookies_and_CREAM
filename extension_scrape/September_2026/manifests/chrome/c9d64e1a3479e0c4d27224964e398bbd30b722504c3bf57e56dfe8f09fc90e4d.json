{"update_url": "https://clients2.google.com/service/update2/crx", "name": "MCM Connect - Cloud Phone System", "description": "UCaaS Dialer is a Chrome extension that adds a click-to-call icon in Zoho CRM, opening a popup to start calls instantly.", "version": "1.0", "manifest_version": 3, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://*.zoho.com/*", "https://*.zendesk.com/*", "https://*.pipedrive.com/*"], "content_scripts": [{"matches": ["https://*.zoho.com/*", "https://*.zendesk.com/*", "https://*.pipedrive.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png"], "matches": ["<all_urls>"]}]}