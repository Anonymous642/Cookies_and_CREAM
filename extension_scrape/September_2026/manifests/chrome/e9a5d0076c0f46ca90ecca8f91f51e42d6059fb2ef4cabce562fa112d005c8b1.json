{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URL Shortener by Linko \u2014 Custom Links, QR Codes & Bulk", "version": "1.4.0", "description": "Shorten URLs in one click, generate QR codes, and bulk-shorten. Right-click, press Ctrl+Shift+L, or use the address bar.", "author": "Linko", "homepage_url": "https://linko.me", "action": {"default_popup": "lib/popup.html", "default_title": "Linko \u2014 Shorten this page", "default_icon": {"16": "assets/media/favicon.png", "32": "assets/media/favicon.png", "48": "assets/media/favicon.png", "128": "assets/media/favicon.png"}}, "icons": {"16": "assets/media/favicon.png", "32": "assets/media/favicon.png", "48": "assets/media/favicon.png", "128": "assets/media/favicon.png"}, "background": {"service_worker": "assets/js/background.js"}, "options_ui": {"page": "lib/options.html", "open_in_tab": true}, "permissions": ["tabs", "storage", "activeTab", "contextMenus", "notifications", "offscreen", "clipboardWrite"], "host_permissions": ["https://linko.me/*"], "commands": {"shorten-current-tab": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Shorten the current tab and copy the link"}}, "omnibox": {"keyword": "linko"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}