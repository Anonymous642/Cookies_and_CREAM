{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NanoFocus: Instant Page TLDR", "short_name": "NanoFocus", "version": "0.3.2", "description": "One-click TLDR for any article using on-device Gemini Nano. Private, fast, no servers.", "author": "Loophead Labs LLC", "homepage_url": "https://nanofocus.app", "minimum_chrome_version": "138", "permissions": ["activeTab", "tabs", "scripting", "sidePanel", "storage", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Summarize this page", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["lib/Readability.js", "content/extractor.js"], "matches": ["<all_urls>"]}]}