{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TLDW - Chat With Youtube Videos", "description": "The better way to extract useful insights from Youtube videos by directly chatting with the contents of the video.", "version": "0.0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://*.clerk.accounts.dev https://clerk.tldw.dev;"}, "action": {"default_title": "Chat with YouTube video", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "permissions": ["sidePanel", "storage", "cookies", "tabs"], "host_permissions": ["https://*.clerk.accounts.dev/*", "https://clerk.tldw.dev/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}