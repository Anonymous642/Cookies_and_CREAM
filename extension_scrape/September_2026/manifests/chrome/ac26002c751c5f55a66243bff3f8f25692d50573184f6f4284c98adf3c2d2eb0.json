{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoFyll", "version": "1.0", "description": "Auto-fills forms with random or custom data", "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "dist/images/icon-16.png", "32": "dist/images/icon-32.png", "48": "dist/images/icon-48.png", "128": "dist/images/icon-128.png"}, "action": {"default_icon": "dist/images/icon-48.png", "default_popup": "dist/popup/popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["dist/generators/helpers.js", "dist/generators/person.js", "dist/generators/contact.js", "dist/generators/work.js", "dist/generators/finance.js", "dist/generators/misc.js", "dist/generators/index.js", "dist/analyze/labels.js", "dist/analyze/guess.js", "dist/analyze/formDetect.js", "dist/autofill/customFill.js", "dist/autofill/randomFill.js", "dist/main.js", "content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab"], "commands": {"generate_credentials": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Generate random credentials for the current form"}, "generate_custom_credentials": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Generate custom credentials for the current form"}}}