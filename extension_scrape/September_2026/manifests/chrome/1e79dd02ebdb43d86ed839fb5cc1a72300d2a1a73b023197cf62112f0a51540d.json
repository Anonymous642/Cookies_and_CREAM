{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Echo - Text to Speech", "version": "1.0.3", "description": "Convert selected text to speech", "permissions": ["contextMenus", "storage", "offscreen", "activeTab", "tabs", "scripting"], "host_permissions": ["https://echo-license-validator.kanisverma.workers.dev/*", "https://buy.polar.sh/*", "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*", "https://cdn.jsdelivr.net/*"], "commands": {"transcribe-text": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Transcribe selected text"}, "pause-play-speech": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Pause/resume current speech"}, "stop-speech": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Stop current speech"}, "start-new-speech": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Start new speech from selected text"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TTS Settings"}, "icons": {"16": "assets/icon16-circular.png", "48": "assets/icon48-circular.png", "128": "assets/icon128-circular.png"}, "web_accessible_resources": [{"resources": ["offscreen.html", "success.html", "config.js", "floating-pill.js", "kokoro-model/*"], "matches": ["<all_urls>"]}]}