{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Falsify - AI Fact Checker for Websites, YouTube, TikTok & Instagram Reels", "version": "1.0.0", "description": "Fact check articles and videos with AI. Claims on a webpage are underlined true, false or disputed, with citations to the sources.", "permissions": ["activeTab", "storage", "identity"], "host_permissions": ["https://falsify-backend.vercel.app/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Falsify", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"fact-check-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Fact-check current page"}, "open-history": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Check history"}, "toggle-highlighter": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Highlighter mode"}, "open-settings": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Support & feedback"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["yt-timedtext-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["vendor/readability.js", "vendor/block-format.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}