{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenhot - Full Page Screenshot, Annotate & Batch Capture", "short_name": "Screenhot", "description": "Full page screenshot tool. Capture, annotate, split into multiple images or batch capture all tabs. Free, private, no upload.", "version": "1.1.0", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "offscreen", "downloads", "clipboardWrite"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "assets/background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Capture with Screenhot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"quick-capture": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Capture with the last used Screenhot settings"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture the full page"}, "capture-visible-area": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-split-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture the page as multiple images"}, "capture-region": {"description": "Capture a region or element"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}