{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebPins - Pin thoughts to the internet", "version": "1.0.0", "description": "Drop small, map-style pins on any webpage to attach personal notes exactly where your attention was.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "WebPins"}, "commands": {"drop-pin": {"suggested_key": {"default": "Alt+P", "windows": "Alt+P", "mac": "Alt+P"}, "description": "Drop a pin at cursor location"}, "toggle-pins": {"suggested_key": {"default": "Alt+V", "windows": "Alt+V", "mac": "Alt+V"}, "description": "Toggle pins visibility"}, "pin-jump": {"suggested_key": {"default": "Alt+J", "windows": "Alt+J", "mac": "Alt+J"}, "description": "Quick jump to any pin"}, "global-search": {"suggested_key": {"default": "Alt+S", "windows": "Alt+S", "mac": "Alt+S"}, "description": "Search all your pins"}}, "web_accessible_resources": [{"resources": ["icons/*", "welcome.html", "welcome.js"], "matches": ["<all_urls>"]}]}