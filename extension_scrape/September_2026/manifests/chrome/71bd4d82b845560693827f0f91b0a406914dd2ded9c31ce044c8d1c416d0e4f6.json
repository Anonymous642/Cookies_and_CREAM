{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Untapper Influencer Marketing", "description": "Instagram, TikTok, and X (Twitter) analytics dashboard for influencer marketing professionals.", "version": "2.1.3", "permissions": ["activeTab", "storage", "tabs", "scripting"], "host_permissions": ["*://*.untapper.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.linkedin.com/*", "*://*.threads.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Run Untapper Metrics", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://x.com/*"]}], "content_scripts": [{"matches": ["https://www.tiktok.com/*"], "js": ["tiktok-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*"], "js": ["instagram-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://x.com/*"], "js": ["x-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}