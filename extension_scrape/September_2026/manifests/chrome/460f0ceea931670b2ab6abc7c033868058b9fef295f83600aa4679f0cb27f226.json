{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Notes", "short_name": "YT Notes", "version": "1.1.0", "description": "Timestamped YouTube notes with auto-pause. Elegant dark sidebar. Export to Notion, Markdown, and Obsidian.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://api.notion.com/*", "https://readwise.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "YT Notes", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["contentScript.js"], "css": ["sidebar.css"], "run_at": "document_idle"}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Toggle YT Notes sidebar"}}, "minimum_chrome_version": "114"}