{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blurbi \u2014 AI Product Description Generator", "version": "1.0.0", "description": "Generate optimised product descriptions for eBay, Etsy, Amazon, Shopify and more. One click, instant listings.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://www.etsy.com/*", "https://sellercentral.amazon.com/*", "https://*.myshopify.com/*", "https://www.depop.com/*", "https://blurbi.ai/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Blurbi", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://www.etsy.com/*", "https://sellercentral.amazon.com/*", "https://*.myshopify.com/*", "https://www.depop.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background/service-worker.js"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}