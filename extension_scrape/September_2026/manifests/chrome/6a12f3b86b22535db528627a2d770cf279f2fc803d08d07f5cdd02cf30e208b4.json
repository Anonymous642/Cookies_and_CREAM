{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bulk Resume/CV Downloader for Indeed", "version": "1.1.0", "description": "Bulk download resumes and CVs from your Indeed.com applicant lists. Save time by automating repetitive downloads with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs"], "host_permissions": ["*://*.indeed.com/*"], "content_scripts": [{"matches": ["*://*.indeed.com/candidates*", "*://*.indeed.com/jobs/*/applicants/*"], "js": ["content_scripts/content_indeed_candidates.js"], "run_at": "document_end"}, {"matches": ["*://*.indeed.com/candidates/view*", "*://*.indeed.com/jobs/*/applicants/view/*", "*://*.indeed.com/hire/*/application/*"], "js": ["content_scripts/content_indeed_applicant.js"], "run_at": "document_end"}]}