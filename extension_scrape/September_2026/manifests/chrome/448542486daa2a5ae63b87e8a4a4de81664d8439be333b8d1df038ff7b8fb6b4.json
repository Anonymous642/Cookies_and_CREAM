{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReproLens", "version": "0.11.0", "description": "Capture bugs with a click or a full-page scan, then export straight to your team's issue tracker. Local-first. No AI, no tracking.", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "downloads", "sidePanel", "offscreen", "tabCapture", "userScripts", "declarativeNetRequestWithHostAccess", "contextMenus", "tabGroups", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "panel/panel.html"}, "devtools_page": "devtools/devtools.html", "action": {"default_popup": "popup/popup.html", "default_title": "ReproLens"}, "commands": {"activate-picker": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Mark an element as a bug (opens the picker on the current tab)"}, "run-scan": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Scan the current page for issues"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}