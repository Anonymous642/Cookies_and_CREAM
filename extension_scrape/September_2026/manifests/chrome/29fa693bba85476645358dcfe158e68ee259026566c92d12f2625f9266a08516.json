{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipTune \u2014 Audio Playlist for Short Video", "short_name": "ClipTune", "version": "1.0.0", "description": "Save the audio from short videos into a local playlist you can shuffle, loop and play in the background. Nothing leaves your PC.", "minimum_chrome_version": "116", "permissions": ["storage", "unlimitedStorage", "offscreen"], "host_permissions": ["https://*.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["src/content/hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://www.instagram.com/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "src/popup/popup.html", "default_title": "ClipTune"}, "commands": {"save-audio": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save audio from the reel currently in view"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}