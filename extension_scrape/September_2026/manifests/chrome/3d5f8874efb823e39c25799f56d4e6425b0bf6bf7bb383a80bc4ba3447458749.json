{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "URLinc", "version": "2.1.1", "description": "Save videos, photos, audio, bookmarks, and email folders to your URLinc vault \u2014 one click from any page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to URLinc"}, "permissions": ["activeTab", "tabs", "scripting", "notifications", "storage", "alarms", "webNavigation", "contextMenus"], "host_permissions": ["https://www.urlinc.us/*", "https://urlinc.us/*", "https://storage.googleapis.com/*", "https://tubitv.com/*", "https://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"silent-save": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Silently save the current page to URLinc"}}, "background": {"service_worker": "background.js"}}