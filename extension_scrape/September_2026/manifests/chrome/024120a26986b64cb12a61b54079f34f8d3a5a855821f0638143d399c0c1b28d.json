{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Robin CRM Extension", "version": "1.0.0", "description": "Detects the opportunity on screen in Connective CRM, collects its data, and hands it to Robin on brokerpedia.com.au.", "icons": {"16": "icons/icon16.png", "48": "icons/icon64.png", "128": "icons/icon128.png"}, "permissions": ["storage", "unlimitedStorage", "webRequest", "tabs"], "host_permissions": ["*://*.connective.com.au/*", "*://brokerpedia.com.au/*", "*://*.brokerpedia.com.au/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://crm.connective.com.au/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["*://crm.connective.com.au/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true}, {"matches": ["*://brokerpedia.com.au/robinai/*", "*://*.brokerpedia.com.au/robinai/*"], "js": ["receive.js"], "run_at": "document_start"}], "action": {"default_title": "Robin CRM Extension"}}