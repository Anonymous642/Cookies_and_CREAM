{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Applicant Tracking System - Recruiter Assistant", "version": "1.5.3", "description": "Companion to our HubSpot-based ATS \u2014 source candidates from LinkedIn, Wellfound, GitHub and more. Account required.", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open or close the ATS Assistant sidebar"}}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.wellfound.com/*", "https://*.github.com/*"], "js": ["content-scripts/injector.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/hubspot-sprocket.svg"], "matches": ["https://*.linkedin.com/*", "https://*.wellfound.com/*", "https://*.github.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}