{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lens URL Safety Checker", "version": "1.9.5", "description": "Checks URL safety and provides visual feedback.", "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus", "notifications", "alarms", "identity"], "host_permissions": ["https://127.0.0.1:62873/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://lens.pahilabs.com/*", "https://dev.lens.pahilabs.com/*"]}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}