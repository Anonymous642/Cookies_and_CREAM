{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Helpperr", "version": "1.0.0", "description": "Record and share step-by-step workflow guides in seconds.", "permissions": ["scripting", "storage", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/worker.js"}, "content_scripts": [{"matches": ["https://www.helpperr.com/*", "https://helpperr.com/*"], "js": ["src/content/authBridge.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.helpperr.com;"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "incognito": "not_allowed", "minimum_chrome_version": "116"}