{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Game Site Monitor", "version": "1.6.1", "description": "Monitor game sites for new content through Google search, compare game trends, and track updates across multiple gaming platforms.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel", "alarms", "notifications"], "host_permissions": ["https://www.google.com/*", "https://sitemap.one/*", "https://www.google-analytics.com/*"], "action": {"default_title": "Game Site Monitor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["content.js"]}], "side_panel": {"default_path": "sidebar/sidebar.html"}}