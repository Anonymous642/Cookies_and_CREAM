{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabby", "version": "0.2.1", "description": "Use your ChatGPT or Gemini session from Chrome's side panel.", "minimum_chrome_version": "116", "permissions": ["sidePanel", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Tabby", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K", "windows": "Ctrl+Shift+K"}}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "declarative_net_request": {"rule_resources": [{"id": "strip_frame_headers", "enabled": true, "path": "rules.json"}]}}