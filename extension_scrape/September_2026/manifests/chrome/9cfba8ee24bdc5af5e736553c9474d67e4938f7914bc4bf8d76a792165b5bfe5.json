{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Backscroll: History & Bookmark Search", "description": "Search your browsing history and bookmarks by what you remember. Find any page you actually read. Private, fully on device.", "version": "0.1.3", "icons": {"16": "icons/action-blue-16.png", "32": "icons/action-blue-32.png", "48": "icons/action-blue-48.png", "128": "icons/action-blue-128.png"}, "permissions": ["storage", "unlimitedStorage", "tabs", "offscreen", "scripting", "idle", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "omnibox": {"keyword": "bs"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"}, "action": {"default_title": "Backscroll", "default_icon": {"16": "icons/action-black-16.png", "32": "icons/action-black-32.png", "48": "icons/action-black-48.png", "128": "icons/action-black-128.png"}, "default_popup": "popup.html"}, "commands": {"open-overlay": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Backscroll search overlay"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}