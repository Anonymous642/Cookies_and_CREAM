{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scholar GitHub Linker", "version": "1.0.0", "description": "Exposes instant upload/view triggers for academic PDFs to your private GitHub repository.", "permissions": ["storage", "alarms", "contextMenus", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://scholar.google.com/*", "https://api.github.com/*", "https://github.com/*", "https://raw.githubusercontent.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://scholar.google.com/*"], "css": ["shared.css"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["viewer.html", "viewer.js"], "matches": ["https://scholar.google.com/*", "https://api.github.com/*"]}]}