{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlowWorks Flyover", "short_name": "Flyover", "version": "1.0.0", "description": "Fly over any address in 3D \u2014 from any webpage. One click to launch a photorealistic flyover of any location on Earth.", "permissions": ["activeTab", "scripting", "storage", "notifications"], "host_permissions": ["https://flyover.flowworks.tech/*", "https://maps.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FlowWorks Flyover"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"fly-to-current": {"suggested_key": {"default": "Alt+F", "mac": "MacCtrl+Shift+F"}, "description": "Fly to the current page location"}}}