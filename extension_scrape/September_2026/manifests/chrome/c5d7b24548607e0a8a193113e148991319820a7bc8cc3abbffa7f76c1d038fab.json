{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMind", "description": "Save tabs before you close them.", "version": "0.1.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "TabMind", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["tabs", "activeTab", "storage", "scripting", "sidePanel"], "side_panel": {"default_path": "options.html?surface=sidepanel"}, "optional_permissions": ["bookmarks", "history"], "host_permissions": ["https://tabs.dueqo.com/*"]}