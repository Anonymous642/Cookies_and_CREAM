{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Feed Cleaner \u2014 Hide Influencers", "version": "1.0.0", "description": "Block specific accounts from your X, YouTube, and Instagram feeds with one click.", "permissions": ["storage"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*", "*://*.instagram.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://*.twitter.com/*", "*://x.com/*", "*://*.x.com/*"], "js": ["content/common.js", "content/twitter.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/common.js", "content/youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.instagram.com/*"], "js": ["content/common.js", "content/instagram.js"], "run_at": "document_idle"}]}