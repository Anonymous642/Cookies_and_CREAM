{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shelfy.Today", "version": "1.2.0", "description": "Save and organize web content", "icons": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to Shelfy"}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "tabs", "contextMenus", "notifications", "alarms", "identity", "history", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"save-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in current window"}}}