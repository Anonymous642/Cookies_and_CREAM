{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AdSloth \u2014 Meta Ad Library helper", "description": "Lets the AdSloth web app fetch Meta Ad Library data from your own browser, so it never gets rate-limited.", "version": "0.1.0", "short_name": "AdSloth", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "cookies", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.facebook.com/*"], "declarative_net_request": {"rule_resources": [{"id": "facebook_origin_rewrite", "enabled": true, "path": "rules/facebook-origin-rewrite.json"}]}, "browser_specific_settings": {"gecko": {"id": "extension@adsloth.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"type": "module", "service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.adsloth.com/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/content.js"]}]}