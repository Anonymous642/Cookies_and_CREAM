{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Chrome Tab Capture Extension for Replay Video Capture", "description": "Records the tab in an offscreen document and sends the recording to Replay Video Capture", "version": "1.0.1", "manifest_version": 3, "minimum_chrome_version": "116", "action": {"default_icon": {"16": "icons/not-recording16.png", "32": "icons/not-recording32.png", "48": "icons/not-recording48.png", "128": "icons/not-recording.png"}, "default_popup": "popup.html", "default_title": "Click here to start recording"}, "background": {"service_worker": "service-worker.js"}, "permissions": ["tabCapture", "offscreen", "activeTab", "notifications", "downloads", "storage", "nativeMessaging"], "host_permissions": ["http://127.0.0.1/*"]}