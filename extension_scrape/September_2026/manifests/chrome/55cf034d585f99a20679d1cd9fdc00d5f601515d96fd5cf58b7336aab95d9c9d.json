{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PubSpace Chrome Extension", "version": "0.9.10", "description": "Publish any HTML page to your PubSpace with one click.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://pubspace.ai/*", "https://*.pubspace.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["file:///*.html", "file:///*.htm"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://*.pubspace.ai/dashboard*", "https://*.pubspace.ai/onboarding*"], "js": ["auth.js"], "run_at": "document_idle"}, {"matches": ["https://pubspace.ai/login", "https://*.pubspace.ai/login"], "js": ["logout.js"], "run_at": "document_idle"}]}