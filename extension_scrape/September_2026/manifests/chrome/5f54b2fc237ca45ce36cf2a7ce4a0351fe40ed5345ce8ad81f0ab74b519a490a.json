{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grande Assistant", "description": "Add items from Taobao / Tmall to your Grande buyout cart.", "version": "0.1.0", "icons": {"48": "assets/icon-48.png", "128": "assets/icon-128.png", "192": "assets/icon-192.png"}, "action": {"default_title": "Grande", "default_popup": "popup/popup.html"}, "permissions": ["storage", "identity"], "host_permissions": ["https://grande.delivery/*", "https://*.tmall.com/*", "https://*.taobao.com/*"], "background": {"service_worker": "background/service_worker.js", "type": "module"}, "web_accessible_resources": [{"resources": ["shared/storage.js", "assets/icon-48.png", "assets/icon-128.png", "assets/icon-192.png"], "matches": ["https://*.tmall.com/*", "https://*.taobao.com/*"]}], "content_scripts": [{"matches": ["https://*.tmall.com/*", "https://*.taobao.com/*"], "js": ["content/content_script.js"], "run_at": "document_idle"}]}