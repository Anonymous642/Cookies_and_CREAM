{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voomly Subtitle Enabler", "version": "1.0.0", "description": "Detect videos in a Voomly folder and enable subtitles one by one.", "permissions": ["activeTab", "sidePanel", "scripting", "webRequest", "storage", "identity"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://api.voomly.com/*", "https://app.voomly.com/*", "https://api.extensionlogin.com/*", "https://www.googleapis.com/*", "https://accounts.google.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://app.voomly.com/folder/*"], "js": ["content.js"], "run_at": "document_idle"}]}