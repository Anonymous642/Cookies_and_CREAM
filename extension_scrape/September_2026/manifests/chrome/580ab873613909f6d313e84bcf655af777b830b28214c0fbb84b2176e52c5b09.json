{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Note Clipper", "version": "0.3.34", "description": "Clip Bilibili, YouTube, and article pages into notes for popular tools.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["activeTab", "clipboardWrite", "declarativeNetRequest", "downloads", "downloads.open", "scripting"], "host_permissions": ["*://*.bilibili.com/*", "*://*.hdslb.com/*", "*://*.youtube.com/*", "*://youtube.com/*", "*://youtu.be/*", "*://video.google.com/*", "https://*.substack.com/*", "https://substack.com/*"], "action": {"default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}, "default_popup": "popup.html", "default_title": "Web Note Clipper"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.bilibili.com/*", "*://*.youtube.com/*", "*://youtube.com/*", "*://youtu.be/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}