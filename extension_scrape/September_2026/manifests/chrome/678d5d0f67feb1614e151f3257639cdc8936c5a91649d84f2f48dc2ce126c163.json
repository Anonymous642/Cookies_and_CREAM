{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Search", "version": "1.1.1", "description": "Skip the YouTube homepage. Jump straight to search results.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "YouTube Search"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open YouTube Search popup"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"]}