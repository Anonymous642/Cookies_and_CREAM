{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Layout Fixer \u2014 fix wrong-keyboard typos", "version": "1.2.0", "description": "Wrong keyboard layout? Fix the gibberish in place with Alt+T. Greek, Russian & Arabic, auto-detected. Offline & private.", "minimum_chrome_version": "96", "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Layout Fixer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["layouts.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"fix-current-field": {"suggested_key": {"default": "Alt+T"}, "description": "Fix the text in the focused field"}}}