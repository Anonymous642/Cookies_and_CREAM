{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeetLoop", "version": "1.0.0", "description": "Records your LeetCode submissions \u2014 including fails and retries \u2014 and schedules spaced-repetition reviews where you struggle.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://leetcode.com/*", "https://api.leetloop.dev/*", "https://leetloop.dev/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://leetcode.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://leetloop.dev/*"], "js": ["web-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "LeetLoop"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}