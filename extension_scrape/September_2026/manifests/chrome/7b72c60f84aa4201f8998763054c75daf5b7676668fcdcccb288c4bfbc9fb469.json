{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Keyhop \u2014 Keyboard Navigation", "version": "1.0.8", "description": "Navigate any page from the keyboard. Keyhop asks for no site access until you turn it on for a site.", "minimum_chrome_version": "119", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Keyhop", "default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "scripting"], "optional_permissions": ["sessions"], "host_permissions": ["*://*/*"], "commands": {"toggle-site": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Turn Keyhop on or off for this site"}, "activate-once": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Use Keyhop on this page just for now"}}}