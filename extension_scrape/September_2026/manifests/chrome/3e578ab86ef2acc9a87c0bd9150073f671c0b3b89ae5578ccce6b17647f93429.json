{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "No Reddit Translate", "version": "1.0.0", "description": "Automatically removes Reddit's ?tl= translation parameter so you can always read posts in their original language.", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://*.reddit.com/*"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "No Reddit Translate", "default_popup": "popup.html"}, "author": "Facu", "homepage_url": "https://github.com/facuHannoch/no-reddit-translation.git"}