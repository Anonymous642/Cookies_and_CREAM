{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Summary Box", "description": "Read less, know more. An agent that reads the web for you and condenses it to what matters.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "tabs"], "optional_permissions": ["history"], "host_permissions": ["*://*/*"], "externally_connectable": {"matches": ["https://summarybox.com/*", "https://*.summarybox.com/*"]}, "action": {"default_title": "Summary Box, your brief"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*/*"]}]}