{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tilt Control \u2014 Chess Focus", "description": "Detects tilt patterns on chess.com and lichess. Hides ELO after loss streaks. Keeps you rational.", "version": "1.0.0", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.chess.com/game/*", "https://www.chess.com/play/*", "https://lichess.org/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.chess.com/game/*", "https://www.chess.com/play/*", "https://lichess.org/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["overlay.css"], "matches": ["https://www.chess.com/*", "https://lichess.org/*"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}