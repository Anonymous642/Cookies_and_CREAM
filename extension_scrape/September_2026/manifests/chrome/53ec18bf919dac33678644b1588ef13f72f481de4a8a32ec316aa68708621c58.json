{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Barless WP - Hide WordPress Admin Bar / Toolbar Toggle", "description": "Hide or show the WordPress admin bar (toolbar) instantly with a one-click toggle. Remembers your preference per site.", "version": "1.0.2", "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle WordPress admin bar", "default_icon": {"16": "icons/visible-16.png", "32": "icons/visible-32.png", "48": "icons/visible-48.png", "128": "icons/visible-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}]}