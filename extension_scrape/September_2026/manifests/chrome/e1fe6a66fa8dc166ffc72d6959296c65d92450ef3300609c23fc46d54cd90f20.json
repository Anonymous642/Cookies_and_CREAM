{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZevRecords - Record Google Meet locally", "version": "1.2.0", "description": "Automatically records Google Meet calls locally (tab video, remote audio, and your microphone). No account, no upload, no limits.", "minimum_chrome_version": "116", "permissions": ["tabCapture", "offscreen", "storage", "downloads", "contextMenus", "sidePanel"], "host_permissions": ["https://meet.google.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or stop recording the current Google Meet call"}}, "action": {"default_title": "ZevRecords: open panel / start recording", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}