{"name": "iRIS - Reverse Image Search (Hotkeys)", "version": "1.5.0", "author": "Moth", "description": "Search images through custom search engines. Right click & navigate through context menu. Use hotkeys for quicker access.", "update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "options_page": "popup.html", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png", "200": "icons/icon200.png", "400": "icons/icon400.png"}}, "commands": {"allEngines": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Search with all engines"}, "googlelens": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Search with Google Lens"}, "tineye": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Search with Tineye"}, "yandex": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Search with Yandex"}, "google": {"NO-suggested-key": {}, "description": "Search with Google Legacy Image Search (via ImgOps)"}, "bing": {"NO-suggested-key": {}, "description": "Search with Bing"}, "tracemoe": {"NO-suggested-key": {}, "description": "Search with TraceMoe"}, "iqdb": {"NO-suggested-key": {}, "description": "Search with IQDB"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "piggybank.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["*://imgops.com/*"], "js": ["curtain.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png", "200": "icons/icon200.png"}}