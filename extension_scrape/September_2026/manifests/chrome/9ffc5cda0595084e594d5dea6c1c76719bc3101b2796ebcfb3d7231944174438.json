{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoleSwitch: NetSuite Page Retainer", "version": "1.0.1", "description": "RoleSwitch keeps your current NetSuite page when switching roles, preventing redirects to the home screen.", "permissions": ["cookies", "tabs", "webRequest", "webNavigation", "storage", "scripting", "activeTab", "alarms"], "host_permissions": ["*://*.netsuite.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.netsuite.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "RoleSwitch: NetSuite Page Retainer", "default_popup": "popup.html"}, "icons": {"16": "icons/netSuiteRoleSwap.png", "48": "icons/netSuiteRoleSwap.png", "128": "icons/netSuiteRoleSwap.png"}}