{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "STACKTABS", "description": "Save, organize and restore tabs and windows exactly where you left off. Local session manager with spaces, reminders and quick save.", "version": "1.0.4", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup/popup.html"}, "background": {"service_worker": "background/serviceWorker.js", "type": "module"}, "permissions": ["tabs", "storage", "notifications", "alarms"], "web_accessible_resources": [{"resources": ["dashboard/blocked.html", "dashboard/blocked.js", "dashboard/blocked.css"], "matches": ["chrome-extension://*/*", "https://stacktabs.xyz/*"]}], "externally_connectable": {"matches": ["https://stacktabs.github.io/*", "https://*.github.io/*"]}, "commands": {"save-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tab"}, "save-window": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Command+Shift+A"}, "description": "Save current window"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Command+Shift+E"}, "description": "Quick save all windows (Pro)"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Command+Shift+D"}, "description": "Open StackTabs Dashboard"}}}