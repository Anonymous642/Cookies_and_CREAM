{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Tab Reminder", "version": "1.2", "description": "Instantly save a tab - Get notified later", "permissions": ["storage", "tabs", "activeTab", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Smart Tab reminder"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "commands": {"quick-save-reminder": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Command+Shift+R"}, "description": "Quickly save a reminder for chosen time"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}