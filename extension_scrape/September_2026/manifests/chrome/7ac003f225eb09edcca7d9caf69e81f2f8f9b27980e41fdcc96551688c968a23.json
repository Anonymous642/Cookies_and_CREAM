{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Delegation Doc \u2014 SOP & Task Recorder for Virtual Assistants", "short_name": "Delegation Doc", "version": "1.0.1", "description": "Record a browser task once, then hand your VA a clean step-by-step SOP. Screenshots and notes stay on your machine.", "author": "Virtual-Staffing.com", "homepage_url": "https://virtual-staffing.com?utm_source=chrome_extension&utm_medium=sop_footer", "minimum_chrome_version": "116", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_title": "Delegation Doc \u2014 record a task", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "downloads"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop recording a task"}}, "offline_enabled": true}