{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etsy \u2192 POD Order Sync", "short_name": "POD Sync", "version": "1.0.0", "description": "Sends orders from Etsy Shop Manager to your print-on-demand provider (Podbul, Printful, Printify, Gelato or your own) as JSON.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Send orders to your POD provider", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "options/options.html", "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.etsy.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "content_scripts": [{"matches": ["https://www.etsy.com/your/orders/*", "https://www.etsy.com/*/your/orders/*"], "js": ["content/labels.js", "content/address.js", "content/scraper.js", "content/content.js"], "run_at": "document_idle"}]}