{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yandex PDF Navigator", "version": "4.1", "description": "Navigate through PDF files in Yandex Disk folders seamlessly", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://disk.360.yandex.ru/*", "https://docs.360.yandex.ru/*"], "content_scripts": [{"matches": ["https://disk.360.yandex.ru/client/disk/*"], "js": ["folder-script.js"], "css": ["folder-style.css"]}, {"matches": ["https://docs.360.yandex.ru/docs/view*"], "js": ["content-script.js"], "css": ["content-style.css"]}], "background": {"service_worker": "background.js"}, "commands": {"next-pdf": {"suggested_key": {"default": "Ctrl+Right"}, "description": "Next PDF"}, "prev-pdf": {"suggested_key": {"default": "Ctrl+Left"}, "description": "Previous PDF"}}, "action": {"default_popup": "popup.html"}}