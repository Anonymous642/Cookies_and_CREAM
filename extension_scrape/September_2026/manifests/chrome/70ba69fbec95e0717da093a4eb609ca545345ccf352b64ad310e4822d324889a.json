{"update_url": "https://clients2.google.com/service/update2/crx", "name": "ENforcer", "description": "Per-tab English mode for multilingual site testing. Overrides navigator.language and Accept-Language header on the active tab only.", "version": "3.0", "manifest_version": 3, "permissions": ["scripting", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle ENforcer (English Mode)", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}}