{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "120", "name": "SelfSM Capture & Chloe", "description": "Give posts, selections, and pages to Chloe and turn them into on-brand replies, drafts, or saved material.", "version": "1.0.2", "action": {"default_title": "SelfSM Capture & Chloe"}, "side_panel": {"default_path": "panel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus", "alarms"], "host_permissions": ["https://api.selfsm.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "commands": {"open-chloe": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Chloe in the SelfSM side panel"}, "send-selection-to-chloe": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Send the selected text to Chloe"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}