{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecipeCart", "version": "1.0.0", "description": "Select recipes, compare store prices, and add all ingredients to your grocery cart in one click.", "homepage_url": "https://github.com/nickvan23/recipecart", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.amazon.com/*", "*://*.walmart.com/*", "*://*.kroger.com/*", "https://api-lime-omega.vercel.app/*"], "action": {"default_popup": "popup.html", "default_title": "RecipeCart", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["config.js", "content/amazon.js"], "run_at": "document_idle"}, {"matches": ["*://*.walmart.com/*"], "js": ["config.js", "content/walmart.js"], "run_at": "document_idle"}, {"matches": ["*://*.kroger.com/*"], "js": ["config.js", "content/kroger.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:"}}