{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Text Formatter", "version": "1.0.0", "description": "Format and paste text into WhatsApp Web with proper formatting. Right-click on the input box and select 'Paste Formatted Text'.", "permissions": ["contextMenus", "activeTab", "clipboardRead", "clipboardWrite", "scripting"], "host_permissions": ["https://web.whatsapp.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["formatter.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"pasteFormatted": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Paste formatted text into WhatsApp Web"}}}