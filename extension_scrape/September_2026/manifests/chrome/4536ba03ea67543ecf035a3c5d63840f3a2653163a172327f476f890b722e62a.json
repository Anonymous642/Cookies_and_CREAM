{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PaliMall \u2014 Product Importer", "version": "1.1.0", "description": "One-click import of Amazon and Meesho products into PaliMall as drafts.", "permissions": ["storage"], "host_permissions": ["https://meesho.com/*", "https://www.meesho.com/*", "https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.de/*", "https://*.amazon.ae/*", "https://palimall.com/*", "http://palimall.com/*", "https://palimall.in/*", "http://palimall.in/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "PaliMall Amazon Importer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.com.au/*", "https://*.amazon.de/*", "https://*.amazon.ae/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.meesho.com/*", "https://meesho.com/*"], "js": ["meesho.js", "meesho-content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}