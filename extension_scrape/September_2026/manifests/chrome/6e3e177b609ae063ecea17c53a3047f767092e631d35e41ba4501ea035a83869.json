{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Multi-Login Manager", "short_name": "MultiLogin", "description": "Manage multiple isolated login sessions for the same website, from one browser.", "version": "0.1.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/proxy-main.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN"}], "permissions": ["storage", "unlimitedStorage", "cookies", "tabs", "tabGroups", "webNavigation", "contextMenus", "notifications", "alarms", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"open-last-profile": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open last used profile"}, "open-profile-search": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open profile search popup"}, "cycle-profile-tabs": {"suggested_key": {"default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Jump to next tab from the same profile in this window"}}, "minimum_chrome_version": "116"}