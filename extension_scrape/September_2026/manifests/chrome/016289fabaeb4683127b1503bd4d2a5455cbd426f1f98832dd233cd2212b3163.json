{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RapidTags for YouTube", "version": "0.1.0", "description": "Generate YouTube tags and hashtags without leaving YouTube.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "RapidTags", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "host_permissions": ["https://rapidtag.app/*", "https://*.youtube.com/*", "https://youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}