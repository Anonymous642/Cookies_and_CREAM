{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedGuard", "version": "1.0.1", "description": "LinkedIn invite tracker and safety dashboard \u2014 protect your account from bans.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*", "https://*.supabase.co/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "index.html", "default_title": "LinkedGuard", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "externally_connectable": {"matches": ["https://linkedguard.app/*", "https://www.linkedguard.app/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://*.supabase.co"}}