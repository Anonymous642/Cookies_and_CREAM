{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "View on CMC", "version": "0.7.2", "description": "Finds EVM and Solana contract addresses on any page and shows the token's price, liquidity and contract risk from CoinMarketCap.", "minimum_chrome_version": "111", "permissions": ["storage", "contextMenus", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'none'; frame-ancestors 'none'"}, "host_permissions": ["https://*.coinmarketcap.com/*"], "background": {"service_worker": "src/background/service_worker.js"}, "action": {"default_title": "View on CMC", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://coinmarketcap.com/*", "*://*.coinmarketcap.com/*"], "js": ["src/shared/namespace.js", "src/shared/base58.js", "src/shared/format.js", "src/shared/chains.js", "src/shared/detect.js", "src/shared/extract.js", "src/shared/links.js", "src/shared/settings.js", "src/content/ui.js", "src/content/content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-on-site": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Turn detection on or off for the current site"}}}