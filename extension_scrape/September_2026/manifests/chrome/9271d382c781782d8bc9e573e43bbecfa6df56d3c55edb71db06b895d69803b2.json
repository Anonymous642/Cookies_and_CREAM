{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DraftWarden", "version": "0.1.0", "description": "Flags common contract risks in Google Docs, Notion, and PDF viewers \u2014 on-device, no upload.", "permissions": ["sidePanel", "activeTab", "scripting", "storage"], "host_permissions": ["https://docs.google.com/*", "https://*.notion.so/*", "https://*.notion.site/*", "https://*.pdfjs/*", "https://mozilla.github.io/pdf.js/*"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open DraftWarden", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "side-panel.html"}, "content_scripts": [{"matches": ["https://docs.google.com/*", "https://*.notion.so/*", "https://*.notion.site/*", "https://*.pdfjs/*", "https://mozilla.github.io/pdf.js/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}