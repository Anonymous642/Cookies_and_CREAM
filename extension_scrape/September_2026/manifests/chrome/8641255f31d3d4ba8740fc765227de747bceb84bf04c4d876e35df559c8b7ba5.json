{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabsEasy", "description": "Find and organize tabs, block distracting sites, and track focus breaks\u2014all locally in your browser.", "version": "0.3.1", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "TabsEasy", "default_popup": "search.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "background": {"service_worker": "service-worker.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:;"}, "incognito": "not_allowed", "commands": {"open-tab-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open TabsEasy search"}}, "permissions": ["tabs", "storage", "favicon"]}