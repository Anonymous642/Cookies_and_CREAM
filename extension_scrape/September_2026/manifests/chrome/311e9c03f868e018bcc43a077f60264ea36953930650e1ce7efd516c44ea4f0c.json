{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Split View Shortcuts", "version": "1.0.0", "description": "Customizable keyboard shortcuts for Chrome's Split View: close, separate, swap, and reload panes.", "minimum_chrome_version": "140", "permissions": ["tabs", "storage"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "background": {"service_worker": "service-worker.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Split View Shortcuts", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"close-left-tab": {"suggested_key": {"default": "Alt+W"}, "description": "Close left Split view"}, "close-right-tab": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Close right Split view"}, "separate-tabs": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Separate Split views"}, "swap-tabs": {"suggested_key": {"default": "Alt+U"}, "description": "Swap left and right Split views"}, "switch-focus": {"description": "Switch focus between views"}, "reload-left-tab": {"description": "Reload left Split view"}, "reload-right-tab": {"description": "Reload right Split view"}}}