{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptGrade", "version": "1.0.0", "description": "Grade and optimize AI prompts as you type. Like Grammarly, but for AI prompts.", "icons": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "PromptGrade", "default_icon": {"16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js"}}