{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spotlight Capture - Interactive Tour Builder", "description": "Record step-by-step interactive tours from any web page. Capture elements, annotate screenshots, and publish to Scaleflex Spotlight.", "version": "1.0.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "scripting", "webNavigation", "tabs", "alarms"], "host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["editor.html", "favicon.png", "chunks/*", "assets/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Start/stop recording"}, "capture-fullscreen": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Capture full viewport (no region)"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Spotlight Capture", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}