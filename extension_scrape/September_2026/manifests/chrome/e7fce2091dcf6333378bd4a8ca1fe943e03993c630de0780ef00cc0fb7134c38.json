{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Docs Shortcuts", "version": "1.0.0", "description": "Custom keyboard shortcuts for Google Docs \u2014 bind any menu action to a key combination.", "permissions": ["storage", "activeTab"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["actions.js", "content.js"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://docs.google.com/*"]}], "options_page": "options.html", "commands": {"image-behind-text": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Set image wrapping to Behind text"}, "image-in-front": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Set image wrapping to In front of text"}, "image-wrap-text": {"suggested_key": {"default": "Alt+Shift+W", "mac": "Alt+Shift+W"}, "description": "Set image wrapping to Wrap text"}, "image-inline": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Alt+Shift+I"}, "description": "Set image wrapping to Inline"}}}