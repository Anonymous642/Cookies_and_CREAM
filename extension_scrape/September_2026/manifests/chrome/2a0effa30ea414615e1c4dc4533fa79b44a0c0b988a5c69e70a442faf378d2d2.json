{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Purefacts", "version": "0.1.1", "description": "Send news articles to Purefacts for fact-check analysis.", "permissions": ["storage", "tabs", "notifications"], "host_permissions": ["https://purefacts.no/*", "https://purefacts.org/*", "http://localhost:3000/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Analyze with Purefacts", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "theme_icons": [{"light": "icons/icon-light-16.png", "dark": "icons/icon-dark-16.png", "size": 16}, {"light": "icons/icon-light-32.png", "dark": "icons/icon-dark-32.png", "size": 32}, {"light": "icons/icon-light-48.png", "dark": "icons/icon-dark-48.png", "size": 48}, {"light": "icons/icon-light-128.png", "dark": "icons/icon-dark-128.png", "size": 128}]}, "options_page": "options.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://purefacts.no/extension/connect*", "https://purefacts.org/extension/connect*", "https://purefacts.no/renefakta/stats-next/extension/connect*", "https://purefacts.org/renefakta/stats-next/extension/connect*", "http://localhost:3000/extension/connect*", "http://localhost:3000/renefakta/stats-next/extension/connect*"], "js": ["content-connect.js"], "run_at": "document_idle"}]}