{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AI Homework Helper - Double Check AI", "description": "Never miss a homework question again with the help of AI.", "version": "1.0.3", "manifest_version": 3, "permissions": ["storage", "unlimitedStorage", "commands", "tabs", "activeTab", "contextMenus", "webNavigation", "contextMenus", "cookies"], "host_permissions": ["*://www.doublecheckme.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' 'unsafe-inline';"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "/pages/popup.html", "default_title": "Double Check AI"}, "icons": {"128": "images/enabled.png"}, "commands": {"enableExtension": {"suggested_key": {"default": "Ctrl+E", "mac": "Command+E"}, "description": "Enable/Disable Extension"}}, "web_accessible_resources": [{"resources": ["images/*", "fonts/*.ttf", "pages/*", "css/*", "mathjax/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "match_about_blank": true, "all_frames": true}]}