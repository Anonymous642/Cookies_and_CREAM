{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CapReply", "version": "1.0.0", "description": "Capture part of a webpage and prepare reply suggestions from screenshot context.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://capreply-license-api.kervonixhq.workers.dev/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "CapReply", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-chatgpt.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}