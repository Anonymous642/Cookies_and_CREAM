{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Form Rescue \u2013 Save & Restore Forms", "short_name": "Form Rescue", "version": "1.0.1", "description": "Save form entries on this device and restore them when needed.", "permissions": ["activeTab", "storage", "alarms", "scripting", "contextMenus"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "assets/background.js", "type": "module"}, "action": {"default_title": "Form Rescue", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-bold-16.png", "32": "icons/icon-bold-32.png", "48": "icons/icon-bold-48.png", "128": "icons/icon-bold-128.png"}}, "commands": {"restore-current-page": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Restore saved fields on this page"}, "open-recovery-center": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open saved drafts"}}, "icons": {"16": "icons/icon-bold-16.png", "32": "icons/icon-bold-32.png", "48": "icons/icon-bold-48.png", "128": "icons/icon-bold-128.png"}, "minimum_chrome_version": "120", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}