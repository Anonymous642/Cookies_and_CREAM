{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AIDomo - AIChecklist Assistant", "version": "1.4.0", "description": "AI assistant and image clipper for AIChecklist.io. Voice commands, clip images, create folders, and manage tasks.", "permissions": ["activeTab", "storage", "scripting", "tabs", "contextMenus"], "host_permissions": ["https://aichecklist.io/*", "https://*.aichecklist.io/*", "https://*.replit.app/*", "<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AIDomo - AIChecklist"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_end"}, {"matches": ["https://calendar.google.com/*"], "js": ["src/gcal-content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open AIDomo"}, "toggle_voice_bar": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Toggle AIDomo voice bar"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}