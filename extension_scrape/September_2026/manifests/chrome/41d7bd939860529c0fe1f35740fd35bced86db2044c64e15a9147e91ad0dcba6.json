{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Last Tab", "version": "1.0.3", "description": "Simple keyboard shortcuts to switch between recent tabs. Alt+Q toggles last two tabs. Perfect Alt+Tab alternative.", "permissions": ["activeTab", "storage", "alarms", "windows"], "background": {"service_worker": "background.js"}, "commands": {"switch-to-last-tab": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Toggle between last two tabs"}, "cycle-backward": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Cycle backward through tab history (older)"}, "cycle-forward": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Cycle forward through tab history (newer)"}}, "action": {"default_title": "Simple Last Tab - Click to toggle between last two tabs"}}