{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spoiler Shield", "version": "1.0.0", "description": "Block spoilers on Twitter, Reddit, and YouTube by removing posts containing your keywords", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "alarms", "webNavigation"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["*://*.reddit.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "default_locale": "en"}