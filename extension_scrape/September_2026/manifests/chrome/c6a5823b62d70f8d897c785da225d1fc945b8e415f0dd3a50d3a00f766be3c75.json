{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kron Web Password Filler", "version": "1.2.0", "description": "Fills web login forms with credentials from your Kron PAM Password Vault.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "alarms", "cookies", "declarativeNetRequestWithHostAccess", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16-gray.png", "32": "icons/icon32-gray.png", "48": "icons/icon48-gray.png", "128": "icons/icon128-gray.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/tokens.js", "content/glyphs.js", "content/dom.js", "content/anchor.js", "content/detect.js", "content/state.js", "content/fill.js", "content/dropdown.js", "content/badge.js", "content/main.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon32.png", "icons/icon32-gray.png", "icons/icon32-lock.png"], "matches": ["<all_urls>"]}]}