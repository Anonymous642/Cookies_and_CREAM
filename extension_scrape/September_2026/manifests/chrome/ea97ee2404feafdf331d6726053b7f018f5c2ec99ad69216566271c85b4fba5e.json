{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Note Up", "version": "1.1.1", "description": "Magic pen for any web page: hand-drawn arrows, vanishing or permanent ink, and a focus spotlight that blurs all but your cursor.", "permissions": ["storage", "scripting", "downloads", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Note Up", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-pen": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle pen (Pro)"}, "toggle-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle focus spotlight (Pro)"}, "undo-stroke": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Undo last stroke (Pro)"}, "export-png": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Export annotated page as PNG (Pro)"}, "toggle-arrow": {"description": "Toggle arrow (Pro)"}, "toggle-laser": {"description": "Toggle laser pointer (Pro)"}, "cycle-color": {"description": "Next ink color (Pro)"}, "clear-page": {"description": "Clear drawings on this page (Pro)"}, "toggle-toolbar": {"description": "Show/hide the on-page toolbar (Pro)"}}}