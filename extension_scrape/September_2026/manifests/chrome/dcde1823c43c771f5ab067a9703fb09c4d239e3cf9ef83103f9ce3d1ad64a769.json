{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Data Extractor for Amazon & Lead Scraper", "version": "1.0.0", "description": "Extract product details, search results, and reviews from Amazon. Export to Excel, CSV, or JSON.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.ca/*", "https://*.amazon.in/*"], "action": {"default_title": "Open Amazon Data Extractor"}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.ca/*", "*://*.amazon.in/*"], "js": ["part1_message_handler.js", "part2_search_scraper.js", "part3_product_and_review_scraper.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}}