{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Readable IMSLP PDFs", "description": "Automatically gives IMSLP PDF downloads readable, user-configurable names from score metadata.", "version": "1.2.1", "minimum_chrome_version": "112", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Readable IMSLP PDFs", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.imslp.org/wiki/*", "https://*.imslp.eu/wiki/*"], "js": ["lib/naming.js", "content.js"], "run_at": "document_idle"}]}