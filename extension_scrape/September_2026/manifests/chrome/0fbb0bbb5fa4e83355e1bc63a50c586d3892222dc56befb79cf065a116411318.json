{"manifest_version": 3, "version": "1.0.1", "name": "Classy Art Search", "description": "Change default search in address bar to Classy Art Search.", "icons": {"128": "128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://bestclassyart.com/*"], "chrome_settings_overrides": {"search_provider": {"name": "Classy Art Search", "keyword": "bestclassyart.com", "search_url": "https://bestclassyart.com/search?q={searchTerms}", "favicon_url": "https://bestclassyart.com/favicon.ico", "encoding": "UTF-8", "is_default": true}}, "declarative_net_request": {"rule_resources": [{"id": "ruleset", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js"}, "update_url": "https://clients2.google.com/service/update2/crx"}