{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Store Mate: App Store Connect Agent", "version": "1.18", "description": "Store Mate, an extension for App Store Connect, streamlines app submissions and boosts productivity.", "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["https://appstoreconnect.apple.com/*", "https://storemate.app/*"], "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "images/icon-128.png"}, "web_accessible_resources": [{"resources": ["images/icon-128.png", "images/ChevronDown.svg", "images/ChevronDownGreen.svg", "images/Import.svg", "images/Export.svg", "images/Check.svg", "images/Warn.svg", "images/CheckCircle.svg", "images/Close.svg", "images/CloseCircle.svg", "images/CloseRed.svg", "images/InfoGray.svg", "images/CSVFile.svg", "images/PencilLine.svg", "images/Zoom.svg", "images/Alert.svg", "images/ActivityIndicator.svg", "fonts/Averta-Regular.otf", "fonts/Averta-Semibold.otf", "fonts/Averta-Bold.otf"], "matches": ["<all_urls>"]}], "background": {"service_worker": "scripts/serviceWorker.js", "type": "module"}, "externally_connectable": {"matches": ["https://storemate.app/*"]}, "key": "", "content_scripts": [{"js": ["scripts/contentScript.js"], "matches": ["https://appstoreconnect.apple.com/*"]}]}