{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HonestGuard", "version": "2.1", "description": "HonestGuard ensures safe browsing by allowing access only to approved websites, protecting children\u2019s online experiences.", "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_icon": {"16": "images/2-shield_16.png", "48": "images/2-shield_48.png", "128": "images/2-shield_128.png"}, "default_title": "Whitelist Enforcer"}, "icons": {"16": "images/2-shield_16.png", "48": "images/2-shield_48.png", "128": "images/2-shield_128.png"}, "minimum_chrome_version": "88", "web_accessible_resources": [{"resources": ["blocked.html", "blocked.css"], "matches": ["<all_urls>"]}], "commands": {"open-options": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open HonestGuard Options"}}}