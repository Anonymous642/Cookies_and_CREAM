{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Superidea - Save to Library", "version": "1.0.1", "description": "Save any content to your Superidea library - links, quotes, social posts. One click from any page.", "permissions": ["activeTab", "contextMenus", "cookies", "scripting", "storage", "tabs"], "host_permissions": ["https://app.superidea.ai/*", "https://superidea.ai/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.instagram.com/*", "https://*.linkedin.com/*", "https://*.reddit.com/*", "https://*.tiktok.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/light/icon16.png", "32": "icons/light/icon32.png", "48": "icons/light/icon48.png", "128": "icons/light/icon128.png"}}, "icons": {"16": "icons/dark/icon16.png", "32": "icons/dark/icon32.png", "48": "icons/dark/icon48.png", "128": "icons/dark/icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content/branding.js", "content/youtube.js"], "run_at": "document_idle"}, {"matches": ["https://*.twitter.com/*", "https://*.x.com/*"], "js": ["content/branding.js", "content/twitter.js"], "run_at": "document_idle"}, {"matches": ["https://*.linkedin.com/*"], "js": ["content/branding.js", "content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://*.reddit.com/*"], "js": ["content/branding.js", "content/reddit.js"], "run_at": "document_idle"}, {"matches": ["https://*.tiktok.com/*"], "js": ["content/branding.js", "content/tiktok.js"], "run_at": "document_idle"}, {"matches": ["https://*.instagram.com/*"], "js": ["content/branding.js", "content/instagram.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.instagram.com/*", "https://*.linkedin.com/*", "h