{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Speed Controller", "version": "1.0.0", "description": "Control video playback speed on any website with keyboard shortcuts and easy controls", "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"increase-speed": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Increase video speed"}, "decrease-speed": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Decrease video speed"}, "reset-speed": {"suggested_key": {"default": "Ctrl+Shift+0"}, "description": "Reset video speed to 1x"}}}