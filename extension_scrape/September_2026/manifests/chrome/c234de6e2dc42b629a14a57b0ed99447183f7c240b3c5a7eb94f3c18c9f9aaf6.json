{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BookHQ QuickCopy", "version": "1.2.2", "description": "Quickly copy Amazon listing details like title, ASIN, author, price, BSR, reviews, description, and author bio.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.amazon.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_title": "BookHQ QuickCopy", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/icon32.png"], "matches": ["*://www.amazon.com/*"]}]}