{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PDF Sort", "version": "1.0.0", "description": "Interactive sorting and navigation for structured PDF content \u2014 action logs, history blocks, and tables.", "permissions": ["activeTab", "sidePanel"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*.pdf", "https://*/*.pdf?*", "http://*/*.pdf", "http://*/*.pdf?*", "file:///*/*.pdf"], "js": ["content-script.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "extension/panel-ui/panel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "PDF Sort"}, "web_accessible_resources": [{"resources": ["pdf.worker.min.mjs"], "matches": ["<all_urls>"]}]}