{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DevAutOps Vault", "version": "4.4.3", "description": "Secure DevAutOps credential storage, exact-domain login saving and opt-in autofill for HTTPS websites.", "minimum_chrome_version": "116", "permissions": ["storage", "activeTab", "tabs", "alarms", "scripting", "cookies", "notifications", "idle"], "host_permissions": ["https://*/*"], "storage": {"managed_schema": "managed_schema.json"}, "action": {"default_popup": "index.html", "default_title": "DevAutOps Vault", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["lib/browser-api.js", "content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "commands": {"fill-credentials": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fill credentials on this page"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}}