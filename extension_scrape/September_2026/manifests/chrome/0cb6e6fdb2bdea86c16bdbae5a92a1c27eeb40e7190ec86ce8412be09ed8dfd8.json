{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoiceType \u2014 Speech to Text Anywhere", "version": "2.0.0", "description": "Type with your voice anywhere. Wake word, multi-language, voice commands, silence detection, history & settings.", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "VoiceType"}, "options_page": "settings.html", "commands": {"toggle-listening": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle speech recognition"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}