{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShieldBlur", "version": "1.1.0", "description": "Real-time privacy protection for screen shares and recordings", "permissions": ["activeTab", "storage"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/models.js", "src/blur-manager.js", "src/detection-module.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "commands": {"toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Toggle blur activation"}, "increase-intensity": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Increase blur intensity"}, "decrease-intensity": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Decrease blur intensity"}, "clear-all-blurs": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Clear all blur areas"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}