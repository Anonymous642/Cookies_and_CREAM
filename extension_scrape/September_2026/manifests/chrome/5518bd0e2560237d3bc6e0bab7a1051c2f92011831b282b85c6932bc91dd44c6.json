{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GravaSafe \u2014 Gravador de Tela com Prote\u00e7\u00e3o de Dados", "version": "1.9.16", "description": "Grave sua tela em at\u00e9 4K no Pro, com c\u00e2mera e microfone, e proteja CPF, e-mail e outros dados sens\u00edveis, inclusive em PDFs.", "permissions": ["storage", "activeTab", "tabs", "declarativeNetRequest", "scripting", "tabCapture", "offscreen", "downloads", "audioCapture", "videoCapture", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "GravaSafe", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["src/licenca/plano.js", "src/patterns.js", "src/pdf-mask.js", "src/content.js"], "css": ["src/content.css"]}, {"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["recorder/dock.js"]}], "web_accessible_resources": [{"resources": ["viewer/*", "vendor/*", "src/patterns.js", "src/licenca/plano.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "commands": {"toggle-mask": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Ativar/desativar a m\u00e1scara de dados"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Iniciar/parar a grava\u00e7\u00e3o de tela"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pausar/retomar a grava\u00e7\u00e3o"}}}