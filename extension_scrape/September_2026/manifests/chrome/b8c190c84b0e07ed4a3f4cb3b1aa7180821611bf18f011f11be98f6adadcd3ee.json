{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Refresh & Clear Data - Tab Reloader", "version": "2.2", "description": "Automatically reload tabs (Hard Refresh) and clear cache/cookies on a set interval. Protect privacy and boost performance.", "icons": {"16": "icon16.png", "32": "icon48.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "browsingData", "storage", "alarms"], "action": {"default_popup": "popup.html", "default_title": "Auto Refresh & Clear Data"}, "background": {"service_worker": "background.js"}, "commands": {"command-refresh": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Refresh Tab(s)"}, "command-clear": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Clear Data"}}}