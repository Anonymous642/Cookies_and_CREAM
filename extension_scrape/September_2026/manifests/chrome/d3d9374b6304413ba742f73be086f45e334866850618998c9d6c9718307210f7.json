{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Character Count \u2014 Quick & Accurate", "short_name": "Char Count", "description": "Instantly count characters, words, lines, bytes & reading time. Paste or type. 100% private and offline.", "version": "1.0.2", "action": {"default_title": "Character Count", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "clipboardRead", "clipboardWrite", "contextMenus", "notifications", "scripting", "activeTab"], "background": {"service_worker": "service_worker.js", "type": "module"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Character Count"}}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"}}