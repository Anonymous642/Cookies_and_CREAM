{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSnooze \u2014 Tab Suspender & Session Manager", "short_name": "TabSnooze", "version": "0.1.2", "default_locale": "en", "description": "Free your RAM. Auto-suspend inactive tabs, save named sessions, and sync across devices. Built for Chrome MV3.", "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "TabSnooze"}, "options_page": "options/options.html", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["tabs", "storage", "alarms", "activeTab"], "commands": {"suspend-current-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Suspend the current tab"}, "restore-current-tab": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Restore the current tab"}, "suspend-all-tabs": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Suspend all inactive tabs"}}, "web_accessible_resources": [{"resources": ["suspension-page/suspended.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}