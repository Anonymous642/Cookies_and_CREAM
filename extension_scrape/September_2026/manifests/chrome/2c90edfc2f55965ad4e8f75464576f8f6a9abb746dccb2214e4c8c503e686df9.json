{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PennyOCR Snip", "version": "0.3.0", "description": "Turn screenshots, charts, scans, and images into clean text or Markdown. Try 3 free snips monthly\u2014no account needed.", "permissions": ["activeTab", "scripting", "contextMenus", "storage"], "host_permissions": ["https://api.pennyocr.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "PennyOCR Snip \u2014 Alt+Shift+P to snip"}, "commands": {"snip-region": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Snip a region and OCR it (Mac: Option+Shift+P)"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}