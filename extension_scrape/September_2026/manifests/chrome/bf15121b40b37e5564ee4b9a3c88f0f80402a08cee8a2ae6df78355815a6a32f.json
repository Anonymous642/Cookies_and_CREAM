{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Relai Clipper", "version": "0.1.0", "description": "Select a web source and send its text, source details, and screenshot to your Relai Inbox for review.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://relai.football/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Clip to Relai", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://relai.football/*"], "js": ["relai-bridge.js"], "run_at": "document_start"}]}