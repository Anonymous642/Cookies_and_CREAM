{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat Zoom \u2014 ChatGPT & Claude", "version": "1.0.0", "description": "Zoom out the chat/content column of ChatGPT and Claude so more is visible at once, while the sidebar stays full-size.", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Chat Zoom", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"zoom-out": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Zoom chat out (smaller \u2014 more fits)"}, "zoom-in": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Zoom chat in (larger)"}, "toggle": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "Toggle chat zoom on/off"}}}