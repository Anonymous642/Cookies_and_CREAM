{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook Cleaner Pro", "version": "6.0", "description": "Masque Stories, Reels, pubs et contenu sensible sur Facebook. Filtrage par mots-cl\u00e9s et compteurs dynamiques.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.facebook.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-green-16.png", "32": "icons/icon-green-32.png", "48": "icons/icon-green-48.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-green-16.png", "32": "icons/icon-green-32.png", "48": "icons/icon-green-48.png", "128": "icons/icon-green-128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.facebook.com/*"]}]}