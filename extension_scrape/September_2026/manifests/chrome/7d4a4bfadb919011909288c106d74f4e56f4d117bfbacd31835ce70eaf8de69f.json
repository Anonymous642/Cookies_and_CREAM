{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenshotPop", "version": "1.1.0", "description": "Capture screenshots from your browser and instantly send them to the ScreenshotPop editor", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://screenshotpop.com/*", "http://localhost:3000/*"]}, "action": {"default_popup": "popup.html", "default_title": "ScreenshotPop - Capture & Animate", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://screenshotpop.com/editor*", "http://localhost:3000/editor*"], "js": ["inject.js"], "run_at": "document_start"}], "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture a region of the screen"}}}