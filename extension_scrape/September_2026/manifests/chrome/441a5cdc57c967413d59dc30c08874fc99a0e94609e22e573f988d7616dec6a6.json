{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmarks Music Player", "version": "5.8.0", "description": "Play YouTube links from a selected bookmarks folder with a compact mini player, auto-next, shuffle, repeat, and fallback playback.", "permissions": ["bookmarks", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "sidePanel", "storage", "tabs"], "host_permissions": ["https://*.ytimg.com/*", "https://i.ytimg.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://noembed.com/*", "https://www.youtube-nocookie.com/*", "https://www.youtube.com/*", "https://youtu.be/*", "https://youtube.com/*"], "background": {"service_worker": "service-worker.js"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Bookmarks Music Player controls", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; img-src 'self' https://i.ytimg.com https://*.ytimg.com https://noembed.com data:; connect-src https://noembed.com;"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://youtu.be/*"], "js": ["youtube-control.js"], "run_at": "document_idle"}]}