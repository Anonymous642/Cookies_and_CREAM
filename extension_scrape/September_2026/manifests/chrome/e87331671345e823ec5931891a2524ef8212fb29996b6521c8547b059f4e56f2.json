{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GOG Price on Steam", "version": "1.0.0", "description": "Shows the current GOG price (incl. discount) directly on Steam store pages, with a link to the GOG page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://catalog.gog.com/*"], "content_scripts": [{"matches": ["https://store.steampowered.com/app/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}