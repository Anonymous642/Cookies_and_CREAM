{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mio Bookmark", "version": "0.1.0", "description": "A visual bookmark manager to organize bookmarks your way.", "permissions": ["bookmarks", "storage", "sidePanel", "tabs"], "background": {"service_worker": "background.js"}, "commands": {"toggle-side-panel": {"suggested_key": {"default": "Alt+B", "mac": "Option+B"}, "description": "Toggle open/close side panel"}, "save-current-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page"}}, "action": {"default_title": "Mio Bookmark", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "logo/mio_16.png", "32": "logo/mio_32.png", "48": "logo/mio_48.png", "128": "logo/mio_128.png"}}