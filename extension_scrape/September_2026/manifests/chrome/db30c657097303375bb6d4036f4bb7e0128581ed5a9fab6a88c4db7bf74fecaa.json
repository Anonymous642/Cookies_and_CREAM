{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shop Llama: Stephanie's Deal Finder", "version": "1.1.0", "description": "While you shop Amazon, Stephanie points you to Shop Llama's hand-picked deals for what you're viewing. Opens on shopllama.shop.", "homepage_url": "https://shopllama.shop", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Shop Llama Deal Finder", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://shopllama.shop/*"], "content_scripts": [{"matches": ["*://www.amazon.com/*", "*://smile.amazon.com/*"], "js": ["content/categories.js", "content/content.js"], "css": ["content/panel.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/stephanie-wow.png", "content/stephanie-wave.png", "icons/icon48.png"], "matches": ["<all_urls>"]}]}