{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartTab - AI Tab Manager", "version": "1.0.0", "description": "AI tab manager: smart grouping, tab snooze, spaces, focus mode, AI search & summarize, dark mode.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "favicon", "notifications", "topSites", "contextMenus"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["src/ExtPay.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Open SmartTab popup"}, "smart-group": {"suggested_key": {"default": "Ctrl+Shift+G"}, "description": "Smart Group tabs"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Open Dashboard"}, "close-duplicates": {"description": "Close duplicate tabs"}, "search-tabs": {"description": "Search tabs"}, "save-session": {"description": "Save current session"}}}