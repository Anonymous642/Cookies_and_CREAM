{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReviewExport for Amazon", "version": "0.1.0", "description": "Export an Amazon product's reviews to CSV \u2014 free when they're already in our library. Not affiliated with Amazon.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "ReviewExport", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://reviewexport.com/*"], "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.co.jp/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*", "*://*.amazon.ae/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*", "*://*.amazon.in/*", "*://*.amazon.sa/*"], "js": ["lib.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}