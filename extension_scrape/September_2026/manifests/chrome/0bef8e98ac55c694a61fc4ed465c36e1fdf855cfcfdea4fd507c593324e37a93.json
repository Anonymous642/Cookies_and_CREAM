{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tutela AI Redactor: Protect Private Data in AI Chats", "version": "0.2.0", "description": "On-device AI automatically detects and redacts PII in prompts and uploads. Works with ChatGPT, Claude, Gemini, Copilot, and more.", "permissions": ["storage", "tabs", "scripting", "unlimitedStorage", "identity", "alarms", "offscreen"], "host_permissions": ["https://tutela-billing.vercel.app/*"], "externally_connectable": {"matches": ["https://tutela-billing.vercel.app/*"]}, "background": {"service_worker": "background-main.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["inject-net.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://gemini.google.com/*"], "js": ["inject-gemini.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://m365.cloud.microsoft/*", "https://gemini.google.com/*", "https://grok.com/*", "https://www.grok.com/*"], "js": ["tutela-colors.js", "global-memory.js", "recognizers.js", "presets.js", "site-adapters.js", "usage.js", "content.js"], "css": ["modal.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Tutela AI Settings"}, "web_accessible_resources": [{"resources": ["settings.html", "categories.html", "usage.html", "pdf-viewer.html", "pdf-viewer.js", "tutela-colors.js", "global-memory.js", "recognizers.js", "site-adapters.js", "usage.js", "excel-viewer.html", "excel-viewer.js", "lib/*", "lib/pdfjs/*", "ort-wasm-simd-threaded.wasm", "ort-wasm-simd-threaded.mjs", "em-pthread.js", "model_fp16.onnx", "model_fp32.skeleton.bin", "model_fp32.recipe.json", "upcast-model.js", "tokenizer/*", "pdf.worker.js", "cmaps/*"], "match