{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Meeting Agent", "version": "1.0.6", "description": "Capture live Google Meet, Teams, or Zoom audio in Chrome and stream it to AI Meeting Agent without a bot joining the call.", "action": {"default_title": "AI Meeting Agent", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabCapture", "offscreen", "storage", "tabs", "alarms", "windows"], "host_permissions": ["https://*.nervesparks.com/*", "https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.live.com/*"], "optional_host_permissions": ["http://localhost:8010/*", "http://127.0.0.1:8010/*"], "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["content/meeting.js"], "run_at": "document_idle"}]}