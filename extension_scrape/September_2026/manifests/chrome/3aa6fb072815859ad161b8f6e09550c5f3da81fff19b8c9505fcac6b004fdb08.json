{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UnAI Search", "version": "1.0.0", "description": "Automatically adds &udm=14 to Google search URLs to disable AI features", "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "128": "img/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "img/icon16.png", "32": "img/icon32.png", "128": "img/icon128.png"}, "default_title": "Anti-AI Google Search"}, "permissions": ["webNavigation", "tabs", "storage"], "host_permissions": ["*://*.google.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["img/icon32.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.google.com/search*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}]}