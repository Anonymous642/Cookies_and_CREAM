{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Foot Scroll", "description": "Take control of your web experience with foot-operated scrolling buttons.", "version": "1.0.1", "manifest_version": 3, "icons": {"16": "assets/icons/icon_16.png", "32": "assets/icons/icon_32.png", "64": "assets/icons/icon_64.png", "126": "assets/icons/icon_126.png", "256": "assets/icons/icon_256.png", "512": "assets/icons/icon_512.png"}, "minimum_chrome_version": "111", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Foot Scroll", "default_popup": "views/popup/popup.html"}, "commands": {"scroll-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Scroll the active page up"}, "scroll-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Scroll the active page down"}, "scroll-left": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Scroll the active page left"}, "scroll-right": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Scroll the active page right"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_end", "all_frames": false, "js": ["scripts/constants.js", "scripts/db/local.js", "scripts/content/siteSelectors.js", "scripts/ui/settingsPanel.js", "scripts/content/mainContent.js"]}], "web_accessible_resources": [{"resources": ["views/popup/popup.html", "views/popup/popup.css", "assets/icons/*"], "matches": ["http://*/*", "https://*/*"]}]}