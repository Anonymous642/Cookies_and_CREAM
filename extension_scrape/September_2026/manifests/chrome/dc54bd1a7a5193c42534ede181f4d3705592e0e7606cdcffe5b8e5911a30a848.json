{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yonder \u2014 Inline Currency, Unit, Time Zone & Translation", "version": "1.2.5", "default_locale": "en", "description": "Highlight any price, measurement, time or foreign text to convert or translate it instantly. On-device, private, 13 languages.", "permissions": ["storage", "contextMenus", "alarms"], "host_permissions": ["https://open.er-api.com/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Yonder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/lib/i18n.js", "src/lib/currency.js", "src/lib/units.js", "src/lib/timezone.js", "src/lib/translate.js", "src/lib/parser.js", "src/lib/spell.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["src/data/words.txt", "src/data/misspellings.txt"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}