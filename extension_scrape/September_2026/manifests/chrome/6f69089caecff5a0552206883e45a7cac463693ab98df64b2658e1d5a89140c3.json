{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Chat Exporter", "description": "Export AI chat history from ChatGPT, Claude, Gemini, Genspark. Multiple formats. Privacy-first design.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads"], "action": {"default_title": "Export Chat", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "dist/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://www.genspark.ai/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*"], "js": ["dist/wasmBridge.js", "dist/content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["dist/wasm/*", "dist/wasmBridge.js"], "matches": ["https://chatgpt.com/*", "https://www.genspark.ai/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://*/*", "http://*/*"]}]}