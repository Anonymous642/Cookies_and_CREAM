{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Dislike Viewer", "version": "2.1.0", "description": "See the dislike count on YouTube videos and Shorts, right on the dislike button. Toggle on/off from the popup.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*", "https://returnyoutubedislikeapi.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "AION YouTube Dislike Viewer"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["privacy.html", "privacy.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}}