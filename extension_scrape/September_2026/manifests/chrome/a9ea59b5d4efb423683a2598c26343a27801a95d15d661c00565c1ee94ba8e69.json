{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Organikly: Smart Bookmark Manager & Auto Folders", "short_name": "Organikly", "version": "1.0.4", "description": "Auto-sort bookmarks into nested folders. A smart bookmark manager that organizes saved links by site and topic \u2014 no manual filing.", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "sidePanel", "bookmarks"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidebar.html"}, "action": {"default_title": "Save to Organikly", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["sidebar.html", "sidebar.js", "styles.css", "parser.js", "support.html", "assets/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Save current page (or open library on chrome:// pages)"}}}