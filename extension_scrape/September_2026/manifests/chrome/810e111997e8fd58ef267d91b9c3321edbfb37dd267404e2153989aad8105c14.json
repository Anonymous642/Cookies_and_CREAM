{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapPage Pro - Full Page Screen Capture & PDF", "version": "0.2.2", "description": "Capture entire webpages instantly. High-res scrolling screenshot and seamless PDF export with zero recurring subscriptions.", "author": "TriByte Labs", "homepage_url": "https://tribytelabs.com", "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage"], "action": {"default_popup": "src/popup/popup.html", "default_title": "SnapPage Pro", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open SnapPage Pro"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture full page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture selected region"}}, "options_page": "src/settings/settings.html"}