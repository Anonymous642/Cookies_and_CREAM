{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WhatsApp Contact Exporter", "version": "1.0.0", "description": "Extract contacts from WhatsApp Web based on selected labels", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "WhatsApp Contact Exporter"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://web.whatsapp.com/*"], "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js", "export-utils.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["export-utils.js"], "matches": ["https://web.whatsapp.com/*"]}]}