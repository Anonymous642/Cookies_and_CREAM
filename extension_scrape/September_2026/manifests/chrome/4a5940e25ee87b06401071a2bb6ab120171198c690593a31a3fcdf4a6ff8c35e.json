{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Highlighter", "description": "Highlight text, save it locally, and view it in a sidebar.", "version": "1.5.0", "permissions": ["storage", "activeTab", "contextMenus", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Web Highlighter", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidebar.html"}, "commands": {"highlight-last": {"suggested_key": {"default": "Alt+H"}, "description": "Highlight with the last color used"}, "open-sidebar": {"suggested_key": {"default": "Alt+S"}, "description": "Open the sidebar"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"}}