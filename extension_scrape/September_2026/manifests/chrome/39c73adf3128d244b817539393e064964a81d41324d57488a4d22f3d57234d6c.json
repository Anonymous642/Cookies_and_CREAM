{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "browse.love bookmarks", "version": "0.1.2", "description": "Scrape your X bookmarks locally and upload them to browse.love.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://browse.love/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "browse.love", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}