{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeDrop", "version": "1.0.1", "description": "Transfer code context to AI assistants like Claude and Gemini. Package folders/files for protocol-validated code workflows.", "author": "CodeDrop Forensic Group", "homepage_url": "https://codedrop.codes", "permissions": ["storage", "clipboardWrite", "clipboardRead"], "host_permissions": ["https://extensionpay.com/*", "https://codedrop-api.virtual-reality-cyberspace.workers.dev/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_popup": "src/app/app.html", "default_icon": {"16": "icons/free/box-blue-16.png", "48": "icons/free/box-blue-48.png", "128": "icons/free/box-blue-128.png"}}, "side_panel": {"default_path": "src/app/app.html"}, "icons": {"16": "icons/free/box-blue-16.png", "48": "icons/free/box-blue-48.png", "128": "icons/free/box-blue-128.png"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/app/welcome.html", "src/app/preflight_standalone.html", "src/app/folder_picker.html", "src/app/history_window.html", "src/app/utilities.html", "src/app/claude_stats.html", "src/app/bugReport.html", "src/app/faq_window.html", "src/app/keyboard_shortcuts.html", "src/app/unknown_ext_companion.html", "src/libs/*", "src/models/**/*", "icons/**/*"], "matches": ["https://extensionpay.com/*"]}]}