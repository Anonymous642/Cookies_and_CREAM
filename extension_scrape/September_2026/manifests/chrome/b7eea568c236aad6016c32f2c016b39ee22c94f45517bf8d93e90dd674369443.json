{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StreamSkin", "version": "1.1.0", "description": "Restyle YouTube to look like Netflix, Amazon Prime Video, or Hulu.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "action": {"default_popup": "src/popup.html", "default_title": "StreamSkin", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["src/skins.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_start"}]}