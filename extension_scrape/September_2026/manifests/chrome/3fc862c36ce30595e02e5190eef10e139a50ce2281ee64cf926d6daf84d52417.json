{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Butterfly Security", "version": "1.0.0", "description": "Snapshot and diff your Okta configuration before making changes. A safety net for your identity provider.", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["scripting", "tabs", "sidePanel", "storage"], "host_permissions": ["https://*.okta.com/*", "https://*.okta-emea.com/*", "https://*.oktapreview.com/*", "https://*.trexcloud.com/*", "https://butterflysecurity.org/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.okta.com/*", "https://*.okta-emea.com/*", "https://*.oktapreview.com/*", "https://*.trexcloud.com/*"], "js": ["content/injector.js", "content/bulk-operations.js", "content/ai-advisor.js", "content/impact-analyzer.js", "content/change-watcher.js", "content/health-score.js", "content/command-palette.js", "content/identity-xray.js", "content/export-everything.js", "content/annotations.js", "content/unified-bar.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/index.html"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png"}, "default_title": "Butterfly Security"}, "web_accessible_resources": [{"resources": ["assets/*", "lib/*"], "matches": ["https://*.okta.com/*", "https://*.okta-emea.com/*", "https://*.oktapreview.com/*", "https://*.trexcloud.com/*"]}]}