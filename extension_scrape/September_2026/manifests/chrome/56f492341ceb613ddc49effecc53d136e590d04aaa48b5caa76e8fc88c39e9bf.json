{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "German Newsreader", "version": "1.24", "description": "Read German news aloud with instant translation, plus dual German/English subtitles on YouTube videos.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "sidePanel", "storage"], "host_permissions": ["*://*.vajo.com/*", "*://*.youtube.com/*"], "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Open German Newsreader"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["youtube-subtitles.js"], "run_at": "document_idle"}]}