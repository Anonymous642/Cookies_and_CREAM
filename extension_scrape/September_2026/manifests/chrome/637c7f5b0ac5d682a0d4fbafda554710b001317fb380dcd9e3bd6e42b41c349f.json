{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Monochrome Sites", "short_name": "Monochrome", "version": "1.1.0", "description": "Turn chosen websites grayscale. Per-site, per-tab, or everywhere. No tracking, no network requests.", "minimum_chrome_version": "119", "permissions": ["storage", "scripting"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "ui/popup.html", "default_title": "Monochrome Sites", "default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "icons": {"16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}}, "toggle-tab": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Toggle grayscale for the current tab"}}}