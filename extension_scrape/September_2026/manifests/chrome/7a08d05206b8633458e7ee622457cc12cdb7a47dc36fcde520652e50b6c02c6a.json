{"update_url": "https://clients2.google.com/service/update2/crx", "name": "EmailScout - Email Finder, Scraper & Extractor", "description": "Powerful Email Extractor & Scraper for Sales & Marketing", "version": "3.0.2", "manifest_version": 3, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "images/favicons/enabled/icon-16.png", "32": "images/favicons/enabled/icon-32.png", "48": "images/favicons/enabled/icon-48.png", "128": "images/favicons/enabled/icon-128.png"}, "badge_background_color": "#1878f3", "badge_text_color": "#ffffff"}, "permissions": ["activeTab", "storage", "clipboardWrite", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+E", "mac": "Alt+Shift+E"}, "description": "Activate the extension"}, "select_all_emails": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Select all emails"}, "select_none_emails": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Deselect all emails"}, "copy_to_clipboard": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy selected emails to clipboard"}}, "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "images/favicons/enabled/icon-16.png", "32": "images/favicons/enabled/icon-32.png", "48": "images/favicons/enabled/icon-48.png", "128": "images/favicons/enabled/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["images/*", "images/icons/*"], "matches": ["<all_urls>"]}]}