{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "chathider", "description": "Turns supported AI chat pages into a document-style workspace.", "version": "0.2.3", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://www.claude.ai/*", "https://grok.com/*", "https://www.grok.com/*", "https://x.com/*", "https://twitter.com/*"], "action": {"default_title": "chathider", "default_popup": "popup.html", "default_icon": {"16": "chathider-icon-16.png", "32": "chathider-icon-32.png", "48": "chathider-icon-48.png", "128": "chathider-icon-128.png"}}, "icons": {"16": "chathider-icon-16.png", "32": "chathider-icon-32.png", "48": "chathider-icon-48.png", "128": "chathider-icon-128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://www.claude.ai/*", "https://grok.com/*", "https://www.grok.com/*", "https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["content.css", "docs-favicon.svg", "docs-favicon.ico", "vendor/docs/*", "vendor/docs-shell.html", "vendor/katex/*", "vendor/katex/fonts/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://www.claude.ai/*", "https://grok.com/*", "https://www.grok.com/*", "https://x.com/*", "https://twitter.com/*"]}]}