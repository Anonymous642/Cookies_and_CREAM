{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Marklight \u2014 Bookmark Launcher", "short_name": "Marklight", "version": "2.3.12", "key": "", "description": "Save any page with Ctrl+Shift+S (Cmd on Mac). Organize into workspaces. Launch with Ctrl+K. Free account at marklight.app required.", "homepage_url": "https://marklight.app", "minimum_chrome_version": "110", "permissions": ["activeTab", "storage", "notifications", "identity", "scripting"], "optional_permissions": ["tabs"], "host_permissions": ["https://marklight.app/*", "https://api.marklight.app/*"], "content_scripts": [{"matches": ["https://marklight.app/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Save bookmark to Marklight", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"save-bookmark": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Marklight"}}, "background": {"service_worker": "background.js", "type": "classic"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}