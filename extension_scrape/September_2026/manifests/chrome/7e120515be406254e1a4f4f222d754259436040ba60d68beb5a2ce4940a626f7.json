{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AIKapoy - AI Reply Generator", "short_name": "AIKapoy", "version": "1.9.0", "description": "AIKapoy generates AI-powered reply suggestions from highlighted text on supported messaging and social platforms.", "icons": {"16": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-16x16.png", "32": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-32x32.png", "48": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-48x48.png", "128": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-128x128.png"}, "permissions": ["storage", "alarms", "activeTab", "scripting"], "host_permissions": ["https://www.aikapoy.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "AIKapoy", "default_popup": "popup.html", "default_icon": {"16": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-16x16.png", "32": "images/AIKapoy-light-logo-pack/aikapoy-ak-light-32x32.png"}}, "commands": {"generate-reply": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open AIKapoy and run the last quick action when text or a highlight is available"}}, "web_accessible_resources": [{"resources": ["images/AIKapoy-light-logo-pack/aikapoy-ak-light-64x64.png", "content.css"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://www.aikapoy.com/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}