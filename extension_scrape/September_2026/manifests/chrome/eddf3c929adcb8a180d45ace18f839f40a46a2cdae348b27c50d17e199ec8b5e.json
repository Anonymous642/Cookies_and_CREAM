{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AliExpress Coin Link Resolver", "version": "0.2.5", "description": "Redirects AliExpress mobile-only product pages to the standard product URL so you can open them on desktop. Local-only, no tracking.", "minimum_chrome_version": "118", "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["https://m.aliexpress.com/*", "https://www.aliexpress.com/*"], "declarative_net_request": {"rule_resources": [{"id": "coin_link_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.us/item/*"], "js": ["toast.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}