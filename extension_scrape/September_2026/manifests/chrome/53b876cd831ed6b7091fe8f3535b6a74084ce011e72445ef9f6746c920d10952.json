{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GoDoor", "version": "0.2.0", "description": "Click the icon on a Zillow listing: save it to your GoDoor research board and see what it rents for.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_title": "GoDoor: show the badge on this listing", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["content/ds.css"], "matches": ["https://www.zillow.com/*", "https://zillow.com/*"]}], "externally_connectable": {"matches": ["https://godoor.co/*", "https://www.godoor.co/*", "http://localhost:3458/*", "http://localhost:3456/*"]}}