{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeProxy Switcher", "version": "1.6.3", "description": "A simple proxy switcher for Chrome that supports PAC and manual configurations with multiple slots.", "permissions": ["proxy", "storage", "webRequest", "activeTab"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/le16.png", "32": "images/le32.png", "128": "images/le128.png"}}, "icons": {"16": "images/le16.png", "32": "images/le32.png", "128": "images/le128.png"}, "web_accessible_resources": [{"resources": ["pac_viewer.html", "pac_viewer.js"], "matches": ["<all_urls>"]}]}