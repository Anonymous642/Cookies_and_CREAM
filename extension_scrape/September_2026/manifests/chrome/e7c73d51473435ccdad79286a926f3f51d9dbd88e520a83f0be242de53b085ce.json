{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OmniCurrency", "version": "1.0.0", "description": "Convert prices into your currency. Page text stays on your device.", "homepage_url": "https://hjcyberx.com", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.frankfurter.app/latest*", "https://latest.currency-api.pages.dev/v1/currencies/*", "https://open.er-api.com/v6/latest/*"], "action": {"default_title": "OmniCurrency", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["currencies.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true, "world": "ISOLATED"}]}