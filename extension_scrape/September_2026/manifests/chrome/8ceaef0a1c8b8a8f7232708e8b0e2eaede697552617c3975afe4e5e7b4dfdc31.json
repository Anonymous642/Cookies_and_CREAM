{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlixSkip \u2014 Auto Skip Streaming Intros", "version": "2.0.0", "description": "Auto-skip intros, recaps, credits & 'Are you still watching?' prompts on Netflix and Crunchyroll. Zero clicks. 100% free & private.", "author": "Nazeef Masood", "homepage_url": "https://nazeefmasood.github.io/flixskip-website/", "permissions": ["storage"], "host_permissions": ["*://*.netflix.com/*", "*://*.crunchyroll.com/*"], "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["scripts/core/settings.js", "scripts/core/engine.js", "scripts/sites/netflix.js", "scripts/sites/crunchyroll.js", "scripts/content.js"], "css": ["styles/overlay.css"], "run_at": "document_idle"}, {"matches": ["*://*.crunchyroll.com/*"], "js": ["scripts/core/settings.js", "scripts/core/engine.js", "scripts/sites/netflix.js", "scripts/sites/crunchyroll.js", "scripts/content.js"], "css": ["styles/overlay.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "flixskip@extension.dev", "strict_min_version": "109.0"}}, "web_accessible_resources": [{"resources": ["styles/overlay.css"], "matches": ["*://*.netflix.com/*", "*://*.crunchyroll.com/*"]}], "offline_enabled": true}