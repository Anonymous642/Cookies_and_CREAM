{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebiSticky", "version": "2.0.6", "description": "Create sticky notes for text selections and store them locally on any website.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "scripting", "activeTab", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Add note"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle panel"}, "export-notes": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Export notes"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "WebiSticky - Add note", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["modules/utils.js", "modules/storage.js", "modules/styles.js", "modules/highlight.js", "modules/ui.js", "content-script.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}