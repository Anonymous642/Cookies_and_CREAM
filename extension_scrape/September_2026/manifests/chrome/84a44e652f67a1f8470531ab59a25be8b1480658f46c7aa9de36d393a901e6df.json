{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Superjoin - AI Assistant for Google Sheets", "description": "Your AI genie inside Google Sheets. Clean data, build dashboards, write formulas & automate anything with just plain English", "version": "0.0.24", "icons": {"16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png", "64": "icon-64.png", "128": "icon-128.png"}, "permissions": ["tabs", "storage"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'  https://*.posthog.com https://*.superjoin.ai;"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://docs.google.com/*"]}, {"resources": ["content-scripts/custom-instructions.css"], "matches": ["*://docs.google.com/*"]}, {"resources": ["content-scripts/data-preview.css"], "matches": ["*://docs.google.com/*"]}, {"resources": ["content-scripts/sidebar.css"], "matches": ["*://docs.google.com/*"]}, {"resources": ["content-scripts/superjoin-pricing.css"], "matches": ["*://docs.google.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Superjoin", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://app.superjoin.ai/api-redirect/*"], "run_at": "document_start", "js": ["content-scripts/callback.js"]}, {"matches": ["*://docs.google.com/spreadsheets/*"], "js": ["content-scripts/custom-instructions.js", "content-scripts/data-preview.js", "content-scripts/sidebar.js", "content-scripts/superjoin-pricing.js"]}, {"matches": ["*://*.superjoin.ai/*"], "run_at": "document_idle", "js": ["content-scripts/setup-extension.js"]}]}