{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Realistic Typer", "version": "1.2.0", "description": "Simulates realistic human typing from pasted text with speed control, typo simulation, natural pauses and anti-detection timing.", "permissions": ["activeTab", "scripting", "storage", "clipboardRead"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Realistic Typer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"start-typing": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Start realistic typing in the focused field"}, "pause-typing": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Pause or resume typing"}, "stop-typing": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "MacCtrl+Shift+X"}, "description": "Stop typing immediately"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}