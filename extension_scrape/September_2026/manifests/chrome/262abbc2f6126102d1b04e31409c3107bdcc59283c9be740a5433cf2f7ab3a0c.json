{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StatWP - WordPress plugin & theme statistics", "version": "0.2.0", "description": "WordPress.org plugin and theme stats inline: download velocity, freshness, search position.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "alarms", "notifications", "contextMenus", "cookies"], "host_permissions": ["https://api.wordpress.org/*", "https://www.statwp.com/*", "https://statwp.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://wordpress.org/plugins/*", "https://*.wordpress.org/plugins/*", "https://wordpress.org/themes/*", "https://*.wordpress.org/themes/*", "https://wordpress.org/support/plugin/*", "https://*.wordpress.org/support/plugin/*", "https://wordpress.org/support/theme/*", "https://*.wordpress.org/support/theme/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/mark.png"], "matches": ["https://*.wordpress.org/*"]}], "omnibox": {"keyword": "sw"}, "action": {"default_popup": "src/popup.html", "default_title": "StatWP"}, "short_name": "StatWP"}