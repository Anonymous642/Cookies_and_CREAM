{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "96Note", "version": "1.0.0", "description": "Save text, links, and tabs with notes. Data stored in GitHub Gist.", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://api.github.com/*", "https://gist.github.com/*"], "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Open Panel in new tab"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_title": "96Note"}, "icons": {"16": "public/icons/icon-16.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'"}}