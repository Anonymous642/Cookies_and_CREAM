{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Tabpeek", "description": "Hover-to-preview for Chrome tab groups. Instantly preview and switch tabs in a group.", "version": "1.0.0", "manifest_version": 3, "minimum_chrome_version": "114", "permissions": ["tabs", "tabGroups", "sidePanel", "commands"], "side_panel": {"default_path": "side_panel.html"}, "action": {"default_title": "Click to open Tabpeek", "default_icon": {"16": "/images/Tabpeek_logo_no_background.png", "32": "/images/Tabpeek_logo_no_background.png", "48": "/images/Tabpeek_logo_no_background.png", "128": "/images/Tabpeek_logo_no_background.png"}}, "icons": {"16": "/images/Tabpeek_logo_no_background.png", "32": "/images/Tabpeek_logo_no_background.png", "48": "/images/Tabpeek_logo_no_background.png", "128": "/images/Tabpeek_logo_no_background.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["images/default-favicon.png"], "matches": ["<all_urls>"]}], "commands": {"reload": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Reload the extension"}}}