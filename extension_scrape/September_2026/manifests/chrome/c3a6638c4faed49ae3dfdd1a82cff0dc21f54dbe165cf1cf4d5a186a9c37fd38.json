{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ShortRio - Link Shortener", "version": "1.0.0", "description": "Quickly shorten URLs with ShortRio. Right-click to shorten, instantly copy shortened links.", "permissions": ["storage", "activeTab", "contextMenus", "clipboardRead", "clipboardWrite"], "commands": {"shorten-current-url": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Shorten current page URL"}}, "action": {"default_popup": "popup.html", "default_title": "ShortRio - URL Shortener", "default_icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background.js"}, "host_permissions": ["https://shortrio.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}