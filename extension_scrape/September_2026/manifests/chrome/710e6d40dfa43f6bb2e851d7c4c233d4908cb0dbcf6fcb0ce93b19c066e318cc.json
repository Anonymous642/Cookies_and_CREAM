{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Listing Autofill for Meesho \u2013 by InfigrowAI", "version": "2.2.33", "description": "Save reusable product variants for any Meesho category and autofill them into the supplier 'Add Product' form with one click.", "permissions": ["storage", "activeTab", "scripting", "notifications", "identity"], "host_permissions": ["https://supplier.meesho.com/*", "https://shop.infigrowai.com/*", "https://accounts.google.com/*", "https://identitytoolkit.googleapis.com/*"], "action": {"default_title": "Meesho Autofill", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "commands": {"run-autofill": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Autofill using the last-used Meesho variant"}}, "content_scripts": [{"matches": ["https://supplier.meesho.com/*"], "js": ["meesho-page-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://supplier.meesho.com/*"], "js": ["content.js", "meesho-image-upload.js"], "run_at": "document_idle"}, {"matches": ["https://infigrowai.com/*"], "js": ["website-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://infigrowai.com/tools/meesho-bulk-tool/*"], "js": ["catalog-builder-bridge.js"], "run_at": "document_start"}]}