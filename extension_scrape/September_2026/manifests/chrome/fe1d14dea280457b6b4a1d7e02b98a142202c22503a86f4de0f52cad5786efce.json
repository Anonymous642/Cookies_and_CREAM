{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gato \u2014 Translate & Learn in Context", "description": "Learn languages while you browse \u2014 select text for translations, pronunciation, grammar notes, and spaced repetition.", "version": "2.0.1", "icons": {"16": "icon/icon-16.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "alarms", "notifications", "sidePanel"], "host_permissions": ["https://gato.giupana.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["cat-icon.png"], "matches": ["<all_urls>"]}], "commands": {"_execute_side_panel": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Open the translation side panel"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Gato", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://gato.giupana.com/*"], "run_at": "document_idle", "js": ["content-scripts/auth-bridge.js"]}]}