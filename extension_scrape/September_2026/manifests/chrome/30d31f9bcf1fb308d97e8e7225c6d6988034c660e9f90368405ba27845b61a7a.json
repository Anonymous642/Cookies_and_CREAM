{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScanExtension - E-Book & PDF Scanner", "version": "1.4.8", "description": "Automated page scanning, high-resolution capture, and searchable PDF generation for web-based e-books and documents.", "author": "Vox Curiosa", "homepage_url": "https://voxcuriosa.no/scanner/", "permissions": ["activeTab", "tabs", "scripting", "storage"], "host_permissions": ["<all_urls>"], "commands": {"start_stop_scan": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Start or stop scanning"}, "open_gallery": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Command+Shift+G"}, "description": "Open scan gallery and review"}, "snipping_tool": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Quick Snippet Tool (Crop active tab)"}, "desktop_snipping_tool": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Full Screen / Desktop Snipping Tool (Capture outside Chrome)"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/jspdf.umd.min.js", "lib/storage.js", "icons/*", "review/*", "editor/*", "help/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}