{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VocaCards Capture", "version": "0.1.2", "description": "Save a word you highlighted in Chrome, with the sentence around it, straight to VocaCards on your phone.", "permissions": ["contextMenus", "activeTab", "scripting", "storage", "alarms"], "optional_host_permissions": ["https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "action": {"default_title": "VocaCards Capture", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"capture-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the highlighted word to VocaCards"}}}