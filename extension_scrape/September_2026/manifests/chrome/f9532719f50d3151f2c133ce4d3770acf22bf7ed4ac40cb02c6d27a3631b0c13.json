{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Automatic Link Checker", "version": "1.0.0", "description": "Highlight links by type (dofollow, nofollow, sponsored, UGC) with per-type controls. Does not run on search engine results pages.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://www.google.com/search*", "https://www.bing.com/search*", "https://search.yahoo.com/*", "https://www.yahoo.com/search*", "https://duckduckgo.com/?*", "https://www.baidu.com/s*", "https://www.yandex.com/search*", "https://yandex.ru/search*"], "js": ["content.js"], "run_at": "document_idle"}]}