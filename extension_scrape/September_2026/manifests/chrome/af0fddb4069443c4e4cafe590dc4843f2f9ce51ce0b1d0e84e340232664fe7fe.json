{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "lnksbot", "version": "1.0.1", "description": "Save links from any page to lnksbot.com", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["activeTab", "storage", "tabs", "contextMenus", "notifications", "bookmarks", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png"}}, "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["https://lnksbot.com/*", "https://www.lnksbot.com/*"], "js": ["js/content-script.js"], "run_at": "document_start"}], "commands": {"save-current-link": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Save the current tab to lnksbot"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co https://*.supabase.in"}}