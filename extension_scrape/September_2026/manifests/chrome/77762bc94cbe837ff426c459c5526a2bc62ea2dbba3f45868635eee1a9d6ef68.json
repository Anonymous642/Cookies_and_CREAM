{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ghost Hand", "version": "0.3.0", "description": "Attach a Chrome tab, or auto-capture all tabs, so Ghost agents can drive them", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*", "file://*/*", "ws://127.0.0.1:2370/*", "wss://app-dev.artale.io/*", "wss://app.artale.io/*", "ws://localhost:8090/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Ghost Hand", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}