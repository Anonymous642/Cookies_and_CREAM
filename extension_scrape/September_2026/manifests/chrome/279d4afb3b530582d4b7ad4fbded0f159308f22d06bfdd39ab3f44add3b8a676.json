{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Summarizer", "description": "Summarize selected text or entire pages into concise, configurable summaries.", "version": "1.1.2", "action": {"default_title": "AI Summarizer - Summarize selected text", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "icons": {"16": "icons/icon-128.png", "32": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}, "commands": {"summarize-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize selected text"}, "summarize-page": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Summarize entire page"}}}