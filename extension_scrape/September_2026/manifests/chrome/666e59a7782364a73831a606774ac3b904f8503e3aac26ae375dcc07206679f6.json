{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voice AI Assistant", "version": "1.0.1", "author": "Asif Mithawala", "description": "Voice-activated Google Search and ChatGPT assistant with hands-free control", "icons": {"16": "icons/voice-ai-16.png", "48": "icons/voice-ai-48.png", "96": "icons/voice-ai-96.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; font-src 'self' data:;"}, "host_permissions": ["https://chatgpt.com/*"], "permissions": ["tabs", "storage", "activeTab", "scripting"], "action": {"default_icon": "icons/voice-ai-96.png", "default_title": "Toggle Wake Word On/Off", "browser_style": true}, "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "css": ["content/content.css"]}, {"matches": ["https://chatgpt.com/*"], "js": ["content/chatgpt-listener.js"], "run_at": "document_start"}], "commands": {"openChatGPT": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Open ChatGPT Voice Mode"}, "toggleMic": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Toggle Microphone On/Off"}}, "web_accessible_resources": [{"resources": ["audio/*"], "matches": ["<all_urls>"]}]}