{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapText Pro \u2014 Screenshot to Text (OCR)", "version": "1.0.1", "description": "Instantly extract text from any screenshot or screen region using on-device OCR.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SnapText Pro \u2014 Extract Text from Screen"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "storage", "contextMenus", "sidePanel", "clipboardRead", "scripting"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "popup/popup.html?sidepanel=true"}, "commands": {"capture-full-tab": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Capture full tab and extract text"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Select area and extract text"}}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content/content.css"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}