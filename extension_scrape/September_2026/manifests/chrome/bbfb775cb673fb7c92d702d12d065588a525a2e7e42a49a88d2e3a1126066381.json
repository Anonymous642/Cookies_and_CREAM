{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoFlow: Text Expander & Snippets Autofill", "version": "1.2.0", "description": "Lightning-fast text snippets & autofill. Insert saved templates anywhere with one shortcut.", "permissions": ["storage", "activeTab", "contextMenus", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Autoflow", "default_popup": "popup/popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "commands": {"open-snippet-panel": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open snippet selector"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["panel.html", "dock.html", "editor.html", "popup/popup.html", "icons/*.svg"], "matches": ["<all_urls>"]}]}