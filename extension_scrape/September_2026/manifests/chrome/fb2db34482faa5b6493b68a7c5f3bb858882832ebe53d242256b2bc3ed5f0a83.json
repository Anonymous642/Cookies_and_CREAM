{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Audio Only Mode for YouTube\u2122", "short_name": "Audio Only Mode", "version": "1.0.0", "description": "Hide video & thumbnails, keep the audio. Smart music detection, data saving, distraction-free YouTube & YouTube Music.", "minimum_chrome_version": "121", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "declarativeNetRequest"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*", "*://www.youtube-nocookie.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Audio Only Mode for YouTube\u2122", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-tab": {"suggested_key": {"default": "Ctrl+M", "mac": "MacCtrl+M"}, "description": "Enable / disable Audio Only Mode for this tab"}, "toggle-video": {"suggested_key": {"default": "Alt+M"}, "description": "Hide / show the video on the current page"}, "toggle-thumbnails": {"suggested_key": {"default": "Alt+T"}, "description": "Hide / show thumbnails"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"], "js": ["content/youtube.js"], "css": ["content/styles.css"], "all_frames": true, "run_at": "document_start"}, {"matches": ["*://music.youtube.com/*"], "js": ["content/music.js"], "css": ["content/styles.css"], "run_at": "document_start"}, {"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*", "*://www.youtube-nocookie.com/*"], "js": ["content/injected.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}]}