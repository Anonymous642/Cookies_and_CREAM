{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DullFeed", "description": "Take control of your digital habits through mindful nudges and blocking.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["alarms", "storage", "scripting"], "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "DullFeed", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}