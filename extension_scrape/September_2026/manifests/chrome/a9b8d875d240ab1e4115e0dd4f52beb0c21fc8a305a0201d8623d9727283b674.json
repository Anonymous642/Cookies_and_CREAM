{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Txtshell Capture", "version": "0.2.0", "description": "Capture thoughts and links to Txtshell", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Txtshell Capture", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["activeTab", "scripting", "tabs", "storage"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://txtshell.com/*", "https://www.txtshell.com/*"], "content_scripts": [{"matches": ["https://txtshell.com/*", "https://www.txtshell.com/*"], "js": ["content.js"], "run_at": "document_start"}]}