{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Foxus - Focus Mode for X", "description": "Stop doom-scrolling. Focus on one tweet at a time with a cinematic blur effect.", "version": "1.0.0", "short_name": "Foxus", "icons": {"16": "/icon/icon-16.png", "48": "/icon/icon-48.png", "128": "/icon/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"], "web_accessible_resources": [{"resources": ["foxus.css"], "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Foxus Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content-scripts/content.js"]}]}