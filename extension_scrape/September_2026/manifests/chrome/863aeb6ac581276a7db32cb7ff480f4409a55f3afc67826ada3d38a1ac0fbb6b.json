{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web2PDF - Webpage to PDF Converter", "version": "1.0.0", "description": "Convert any web page into a downloadable PDF with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Convert to PDF"}, "permissions": ["activeTab", "scripting", "downloads", "storage", "debugger", "contextMenus", "notifications"], "commands": {"convert-to-pdf": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Convert current page to PDF"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "options.html", "host_permissions": ["<all_urls>"]}