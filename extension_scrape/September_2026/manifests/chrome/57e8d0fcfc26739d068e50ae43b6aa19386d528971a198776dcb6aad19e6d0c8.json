{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cookie Watcher", "version": "0.3.0", "description": "Shows the value of a cookie.", "icons": {"16": "icons/neutral/icon-16.png", "32": "icons/neutral/icon-32.png", "48": "icons/neutral/icon-48.png", "128": "icons/neutral/icon-128.png"}, "action": {"default_title": "env cookie value", "default_popup": "popup.html", "default_icon": {"16": "icons/neutral/icon-16.png", "32": "icons/neutral/icon-32.png", "48": "icons/neutral/icon-48.png"}}, "permissions": ["cookies", "tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}]}