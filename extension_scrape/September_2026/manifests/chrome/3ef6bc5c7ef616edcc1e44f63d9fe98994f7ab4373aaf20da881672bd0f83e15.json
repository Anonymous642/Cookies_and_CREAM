{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReAPI Extension", "description": "Bypass CORS when using ReAPI.com explorer.", "version": "0.0.24", "externally_connectable": {"matches": ["https://*.reapi.com/*", "https://*.reapi.io/*", "http://*.reapi.com/*", "http://*.reapi.io/*", "http://local.reapi.io:3000/*"]}, "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["http://local.reapi.io:3000/*", "https://*.reapi.com/*", "https://*.reapi.io/*"], "js": ["js/content_script.js"]}], "permissions": ["cookies", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "reapi", "enabled": true, "path": "rules/reapi.json"}, {"id": "withCredentials", "enabled": false, "path": "rules/reapi-withCredentials.json"}]}}