{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Advanced Tab Manager", "version": "1.0.0", "description": "Search, group, deduplicate and balance tabs across windows. Save sessions, mute audio, bulk bookmark. Nothing leaves your browser.", "minimum_chrome_version": "114", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "bookmarks", "contextMenus", "sidePanel", "favicon"], "background": {"service_worker": "dist/background/service-worker.js", "type": "module"}, "action": {"default_title": "Tab Manager", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open_side_panel": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Tab Manager Side Panel"}}}