{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Connection Request Agent & linkedin automation tools", "version": "1.0.2", "description": "Collect LinkedIn profiles from URLs or email-based Google search and send personalized connection requests.", "icons": {"16": "Website-trimmer.png", "32": "Website-trimmer.png", "48": "Website-trimmer.png", "128": "Website-trimmer.png"}, "permissions": ["storage", "tabs", "scripting", "sidePanel"], "host_permissions": ["https://www.linkedin.com/*", "https://www.google.com/*", "https://websitetrimmer.com/*"], "action": {"default_title": "WebsiteTrimmer LinkedIn Agent v-import", "default_icon": {"16": "Website-trimmer.png", "32": "Website-trimmer.png", "48": "Website-trimmer.png", "128": "Website-trimmer.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["auth.html"], "matches": ["https://websitetrimmer.com/*"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://www.google.com/*", "https://websitetrimmer.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}