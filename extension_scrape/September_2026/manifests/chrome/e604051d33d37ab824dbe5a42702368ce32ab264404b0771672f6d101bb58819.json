{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FirstTab - Visually Switch and Manage Your Tabs", "version": "1.36", "description": "Allows for visual tab and recent document selection. Provides instant search across your work. Helps organize tabs to avoid chaos.", "permissions": ["tabs", "tabGroups", "windows", "storage", "scripting", "system.display", "history", "favicon"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Show All Tabs"}, "commands": {"next-tab": {"suggested_key": {"default": "Alt+Q"}, "description": "Switch tab"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://firsttab.io/*"]}}