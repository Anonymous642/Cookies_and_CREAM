{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Manager: Auto-Group & Chrome Tab Search", "version": "1.0.7", "description": "Organize your tabs easily with Free Tab Group. A simple, free solution to group tabs and keep your workspace tidy.", "default_locale": "en", "permissions": ["tabs", "tabGroups", "storage", "webNavigation", "sessions"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Open search mode"}}}