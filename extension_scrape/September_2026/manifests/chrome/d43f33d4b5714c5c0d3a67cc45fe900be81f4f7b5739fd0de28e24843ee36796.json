{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NetSuite Dependency Tree", "version": "3.0.3", "description": "Visualize NetSuite transaction dependencies. View, open, or delete related transactions.", "host_permissions": ["https://*.netsuite.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; upgrade-insecure-requests"}, "content_scripts": [{"matches": ["https://*.netsuite.com/app/accounting/transactions/*", "https://*.netsuite.com/app/common/search/search.nl*"], "js": ["constants.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"matches": ["https://*.netsuite.com/*"], "resources": ["inject.js"], "use_dynamic_url": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}