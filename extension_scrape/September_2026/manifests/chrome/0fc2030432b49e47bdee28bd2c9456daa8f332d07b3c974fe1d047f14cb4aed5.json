{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VB Notes - YouTube Notes Pro", "version": "1.0.3", "description": "Take beautiful notes with screenshots while watching YouTube videos", "permissions": ["identity", "storage", "activeTab", "tabs", "downloads"], "host_permissions": ["https://www.youtube.com/*", "https://vimeo.com/*", "https://vbnotes.com/*"], "externally_connectable": {"matches": ["https://vbnotes.com/*"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://vimeo.com/*"], "js": ["config.js", "indexeddb-storage.js", "quill.min.js", "content.js"], "css": ["quill.snow.css", "content.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "VB Notes"}, "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Take screenshot and add to notes"}, "toggle-notes": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Toggle notes panel"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}