{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Unseen: YouTube Watch History Control", "version": "1.0.0", "description": "Prevent specific videos from appearing in your YouTube watch history based on your custom keywords.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Unseen"}, "permissions": ["declarativeNetRequest", "storage", "webNavigation"], "host_permissions": ["*://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.youtube.com/*"]}]}