{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabFlow \u2014 Smart Tab Groups", "version": "1.0.0", "description": "Group tabs by domain, save sessions, kill duplicates, and navigate fast.", "permissions": ["tabs", "tabGroups", "storage", "alarms"], "action": {"default_popup": "popup.html", "default_title": "TabFlow", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"group-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Group all tabs by domain"}, "close-duplicates": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Close duplicate tabs"}, "save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open TabFlow popup"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}