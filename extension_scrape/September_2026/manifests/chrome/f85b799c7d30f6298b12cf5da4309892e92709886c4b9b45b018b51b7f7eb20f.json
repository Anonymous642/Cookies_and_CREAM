{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabMaster \u2013 Tab Group Manager & Auto-Archive", "version": "1.3.0", "description": "Manage Chrome tabs with tab groups, session saving, auto archive and bookmarks. Stay organized and productive.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "bookmarks"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TabMaster", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open TabMaster popup"}, "group-tabs": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Group tabs by site"}, "save-session": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current window as a session"}, "suspend-idle": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Suspend inactive tabs"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}