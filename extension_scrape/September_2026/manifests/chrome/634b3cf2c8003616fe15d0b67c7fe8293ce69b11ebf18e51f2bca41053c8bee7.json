{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IELTS Studio Web Clipper", "short_name": "IELTS Clipper", "description": "Import visible articles, archived copies, and captioned YouTube videos into IELTS Studio.", "version": "0.1.12", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["https://archive.md/*", "https://archive.ph/*", "https://archive.is/*", "https://archive.today/*", "https://archive.fo/*", "https://archive.li/*", "https://archive.vn/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Import to IELTS Studio", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "externally_connectable": {"matches": ["https://app.ieltsstudio.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}