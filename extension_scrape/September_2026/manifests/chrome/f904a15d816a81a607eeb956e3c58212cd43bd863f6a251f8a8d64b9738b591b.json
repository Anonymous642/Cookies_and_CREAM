{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Calm Read", "version": "1.3.3", "description": "Local reader for the current article. Free: size, paper, sepia. Pro: night, look memory, page notes, and ExtHub sync.", "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs"], "host_permissions": ["<all_urls>", "https://exthub.app/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://exthub.app/*"], "js": ["exthub-handoff.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["lib/calm-read-look.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/fonts/*.woff2"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"enter-reader": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Enter Calm Read"}, "exit-reader": {"description": "Exit Calm Read"}}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}