{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Einsols VTT Connector", "version": "0.5.2", "description": "Forward dice rolls and share feats / spells / items from Einsols character sheets to Foundry VTT and Roll20 in real-time", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://play.einsolsrazor.com/*", "https://character-ui.onrender.com/*", "https://einsolsrazor.com/*", "https://www.einsolsrazor.com/*"], "optional_host_permissions": ["https://*.foundryvtt.com/*", "https://*.forge-vtt.com/*", "https://*.moltenhosting.com/*", "https://app.roll20.net/*", "http://localhost/*", "https://localhost/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://play.einsolsrazor.com/*", "https://character-ui.onrender.com/*", "https://einsolsrazor.com/*", "https://www.einsolsrazor.com/*", "http://localhost:3000/*", "http://localhost:3001/*", "http://localhost:5000/*"], "js": ["shared/constants.js", "content/einsols-listener.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/foundry-page-script.js", "content/roll20-page-script.js"], "matches": ["<all_urls>"]}]}