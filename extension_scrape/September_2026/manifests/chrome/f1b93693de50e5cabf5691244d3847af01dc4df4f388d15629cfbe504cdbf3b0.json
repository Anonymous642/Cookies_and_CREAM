{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subwise - Subscription Manager", "version": "1.0.3", "description": "Track, manage, and get reminded about your subscriptions. Never get charged unexpectedly again.", "permissions": ["storage", "notifications", "activeTab", "alarms", "scripting", "tabs"], "host_permissions": ["https://usesubwise.com/*", "*://netflix.com/*", "*://spotify.com/*", "*://apple.com/*", "*://amazon.com/*", "*://adobe.com/*", "*://microsoft.com/*", "*://google.com/*", "*://youtube.com/*", "*://hulu.com/*", "*://disneyplus.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.netflix.com/*", "https://*.spotify.com/*", "https://*.apple.com/*", "https://*.amazon.com/*", "https://*.disneyplus.com/*", "https://*.hulu.com/*", "https://*.adobe.com/*", "https://*.microsoft.com/*", "https://*.google.com/*", "https://*.zoom.us/*"], "js": ["content-script.js"], "run_at": "document_end"}, {"matches": ["https://usesubwise.com/auth/*"], "js": ["auth-handler.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Subwise", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["injected-script.js"], "matches": ["<all_urls>"]}, {"resources": ["sounds/*"], "matches": ["<all_urls>"]}]}