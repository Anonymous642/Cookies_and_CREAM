{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slop Blocker for LinkedIn", "version": "0.5.0", "description": "Tags and blocks AI slop in your LinkedIn feed with your own TypeSafe key. Custom categories, no server, all in your browser.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "options_page": "options.html", "permissions": ["storage", "contextMenus", "notifications"], "host_permissions": ["https://www.linkedin.com/*", "https://api.typesafe.ai/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/feed*", "https://www.linkedin.com/"], "js": ["content.js", "tagger.js"], "css": ["styles.css", "tagger.css"], "run_at": "document_idle"}]}