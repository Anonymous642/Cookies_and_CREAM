{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub File Tree", "version": "1.0.2", "description": "Adds a file tree sidebar to GitHub compare views \u2014 just like the PR view.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://github.com/*"]}], "options_page": "options.html", "content_scripts": [{"matches": ["https://github.com/*/*/compare/*"], "js": ["icons.js", "templates.js", "dist/content.bundle.js"], "css": ["filetree.css"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://github.com/*", "https://live.dodopayments.com/*", "https://api.github.com/"]}