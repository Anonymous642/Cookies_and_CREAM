{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dark UX", "author": "Nova HG", "version": "2.0.0", "description": "Modo oscuro (Dark Mode) universal para la web. Protege tu vista, ahorra bater\u00eda y ajusta el brillo y contraste al instante.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>", "*://*.extensionpay.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Dark Mode (Ctrl+Shift+D)"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Activar/desactivar modo oscuro"}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "css": ["content/dark-mode.css"], "js": ["content/content.js"], "run_at": "document_start"}], "background": {"service_worker": "background/service-worker.js"}, "options_page": "options/options.html"}