{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Klunk Score for Used Car Sites", "description": "See the Klunk Score on every Carvana, AutoTrader, and Cars.com listing. Free reliability data sourced from NHTSA owner complaints.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.carvana.com/*", "https://www.autotrader.com/*", "https://www.cars.com/*"], "action": {"default_title": "Klunk", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.autotrader.com/*", "https://www.cars.com/*", "https://www.carvana.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}