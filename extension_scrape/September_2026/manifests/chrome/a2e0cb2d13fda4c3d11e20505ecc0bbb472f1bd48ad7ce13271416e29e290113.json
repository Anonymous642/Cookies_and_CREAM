{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TYShort Blocker", "version": "1.0.0", "description": "Block YouTube Shorts completely. Remove Shorts from feeds, prevent access to Shorts videos, and redirect to YouTube homepage.", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://www.youtube.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "TYShort Blocker - Block YouTube Shorts", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "author": "loadingzone8868@gmail.com"}