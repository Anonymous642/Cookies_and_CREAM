{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClippyCV \u2014 Match Your Resume to the Job", "version": "1.0.0", "description": "Match your resume to the job posting you're viewing and tailor it with ClippyCV.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ClippyCV", "default_popup": "src/popup/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "identity", "sidePanel"], "host_permissions": ["https://www.clippycv.com/*"], "optional_host_permissions": ["https://*/*"], "side_panel": {"default_path": "src/sidepanel/index.html"}, "minimum_chrome_version": "114", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open ClippyCV"}}}