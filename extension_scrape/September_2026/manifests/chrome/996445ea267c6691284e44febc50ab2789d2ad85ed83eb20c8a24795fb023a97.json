{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MultiTV", "version": "0.3.13", "description": "Open the current YouTube or Kick page in MultiTV. Adds an inline action on supported pages and a toolbar popup.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://kick.com/*", "https://www.kick.com/*", "https://multitv.efekan.xyz/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "MultiTV", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "web_accessible_resources": [{"resources": ["assets/mtv-mark.svg", "assets/icon-16.png", "assets/icon-32.png", "assets/icon-48.png", "assets/icon-128.png", "assets/icon-512.png"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://kick.com/*", "https://www.kick.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "https://kick.com/*", "https://www.kick.com/*"], "js": ["i18n.js", "content.js"], "run_at": "document_idle"}]}