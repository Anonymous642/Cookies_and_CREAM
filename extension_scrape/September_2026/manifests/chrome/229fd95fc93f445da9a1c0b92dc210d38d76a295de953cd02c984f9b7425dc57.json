{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sticky Notes", "version": "1.3.0", "description": "Ajoutez des post-it personnalisables sur vos pages web, avec sauvegarde locale, rappels, images et gestionnaire int\u00e9gr\u00e9.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "contextMenus", "notifications", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Sticky Notes"}, "options_page": "options.html", "commands": {"add-note": {"suggested_key": {"default": "Alt+N"}, "description": "Ajouter un post-it"}, "toggle-visibility": {"suggested_key": {"default": "Alt+H"}, "description": "Masquer/Afficher les notes"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["i18n.js", "content.js"], "run_at": "document_end"}]}