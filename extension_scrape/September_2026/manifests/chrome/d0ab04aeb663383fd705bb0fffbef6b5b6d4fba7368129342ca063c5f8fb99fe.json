{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub PR Exporter", "version": "1.3.0", "description": "Extract and export GitHub Pull Requests with advanced filtering and data analysis.", "author": "SoftHeartEngineer", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "host_permissions": ["https://github.com/*", "https://api.github.com/*"], "permissions": ["storage", "tabs", "sidePanel", "activeTab"], "content_scripts": [{"matches": ["https://github.com/*/pulls*", "https://github.com/*/pull/*"], "js": ["content.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidebar.html"}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "GitHub PR Exporter v1.3.0", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*", "*.css", "*.html"], "matches": ["https://github.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "88", "offline_enabled": true}