{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pluck \u2014 YouTube Transcripts & Notes to Notion", "description": "Save YouTube transcripts, screenshots & timestamps to Notion \u2014 fullscreen notes, zero tab-switching.", "version": "26.8.15.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "storage", "identity", "activeTab", "scripting", "declarativeNetRequest"], "host_permissions": ["https://api.notion.com/*", "https://*.youtube.com/*", "https://*.notion.so/*", "https://*.notion.com/*"], "action": {"default_title": "Notion YouTube Sync", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"capture_selection": {"suggested_key": {"default": "Alt+C", "mac": "MacCtrl+C"}, "description": "Capture selected text to Notion"}, "take_timestamped_note": {"suggested_key": {"default": "Alt+N", "mac": "MacCtrl+N"}, "description": "Take timestamped note to Notion"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube-content.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-main.js"], "world": "MAIN"}]}