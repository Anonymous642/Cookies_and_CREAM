{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Forkads Capture", "description": "Captura la imagen de cualquier producto y genera su landing page en Forkads con un clic.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "120", "permissions": ["storage"], "action": {"default_title": "Forkads Capture", "default_popup": "popup.html"}, "commands": {"capture-focused-image": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Enviar a Forkads la imagen enfocada"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "all_frames": false, "exclude_matches": ["https://app.forkads.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}