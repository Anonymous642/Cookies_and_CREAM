{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Dual-Band Compressor", "description": "Per-tab two-band audio compressor with in-page processing, preserving media keys.", "version": "1.5.0", "manifest_version": 3, "action": {"default_title": "Dual-Band Compressor", "default_popup": "popup.html"}, "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icon16.png", "32": "icon32.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.js", "styles.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-enabled": {"description": "Toggle compression on/off"}, "open-popout": {"description": "Open popout window"}, "toggle-bypass": {"description": "Compatibility: toggles compression (inverse of bypass)"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "host_permissions": ["<all_urls>"]}