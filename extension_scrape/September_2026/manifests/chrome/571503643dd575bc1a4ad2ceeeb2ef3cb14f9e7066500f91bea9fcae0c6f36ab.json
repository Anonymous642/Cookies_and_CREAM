{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Foldsmith \u2014 Folders for GitHub Actions", "short_name": "Foldsmith", "version": "0.1.0", "description": "Group GitHub Actions workflows into collapsible folders, straight from their names. No token, no server, no data collected.", "homepage_url": "https://github.com/AxeForging/foldsmith", "permissions": ["storage"], "action": {"default_title": "Foldsmith", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://github.com/*/*/actions", "https://github.com/*/*/actions/*"], "js": ["content/index.js"], "css": ["content/sidebar.styles.css"], "run_at": "document_idle"}]}