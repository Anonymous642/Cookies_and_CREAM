{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Maha Dev", "version": "1.3.1", "description": "Free all-in-one browser extension for web developers \u2014 inspect, edit, capture, SEO, assets, responsive preview, and more.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Maha Dev", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "browsingData", "downloads", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "frame_embed", "enabled": true, "path": "rules/frame-embed.json"}]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/inspector.js", "content/assets-ui.js", "content/content.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "pages/*", "lib/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-inspector": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Toggle Inspector"}, "toggle-eyedropper": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle Color Eyedropper"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture visible screenshot"}}}