{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "xPlayrate", "description": "Control playback speed on any video site. Your speed is remembered per site, so reloads and new episodes never reset it.", "version": "1.1.0", "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "main.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "xPlayrate \u2014 video speed"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "commands": {"speed-up": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Speed up by 0.25\u00d7"}, "speed-down": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Slow down by 0.25\u00d7"}, "speed-reset": {"description": "Reset speed to 1\u00d7"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}