{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Offprint", "description": "Any page out as clean Markdown, YouTube transcripts, full-page screenshots or offline reader HTML. Optional on-device AI.", "version": "0.2.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "tabs", "downloads", "storage", "contextMenus", "notifications", "debugger", "nativeMessaging", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Offprint", "default_popup": "popup.html"}, "commands": {"convert-active-tab": {"description": "Save the active tab as Markdown", "suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}