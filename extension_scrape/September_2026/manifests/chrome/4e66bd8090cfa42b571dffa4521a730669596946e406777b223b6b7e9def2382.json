{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Curator - Smart Tab Manager", "version": "1.0.1", "description": "Smart tab manager that finds unused tabs, detects duplicates, and lets you save tabs for later.", "permissions": ["tabs", "storage", "alarms", "contextMenus", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Tab Curator"}, "commands": {"toggle-protect": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Protect or unprotect the current tab"}, "close-expired": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Close all expired tabs"}, "save-tab": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current tab for later"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}