{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteFlix", "version": "1.1.0", "description": "Timestamped YouTube notes \u2014 build a library across every video you watch.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "NoteFlix Library"}, "background": {"service_worker": "background/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://m.youtube.com/watch*"], "js": ["lib/time.js", "lib/storage.js", "content/content.js"], "css": ["content/panel.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}