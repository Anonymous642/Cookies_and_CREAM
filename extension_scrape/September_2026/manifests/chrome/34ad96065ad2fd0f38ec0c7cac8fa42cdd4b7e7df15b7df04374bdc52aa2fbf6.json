{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SoundStamper", "version": "1.0", "description": "Save and annotate timestamps in SoundCloud tracks to revisit your favorite moments", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["*://*.soundcloud.com/*"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.soundcloud.com/*"], "js": ["content.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/soundstamper16.png", "32": "icons/soundstamper32.png", "48": "icons/soundstamper48.png", "128": "icons/soundstamper128.png"}}