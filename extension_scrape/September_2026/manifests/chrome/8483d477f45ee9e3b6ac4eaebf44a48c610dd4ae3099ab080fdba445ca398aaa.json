{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebSong: a melody from any website", "description": "Turns a page into a short melody made from its web address. Press Alt+M to play; the same address always plays the same tune.", "version": "0.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "offscreen"], "optional_permissions": ["tabs"], "commands": {"play-song": {"suggested_key": {"default": "Alt+M"}, "description": "Play the current site's song"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "WebSong", "default_popup": "popup.html"}}