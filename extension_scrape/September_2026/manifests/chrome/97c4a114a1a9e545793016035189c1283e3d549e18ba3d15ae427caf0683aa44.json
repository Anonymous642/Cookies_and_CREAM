{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ApplyCandid", "version": "1.2.8", "description": "AI-powered job application assistant for LinkedIn, Indeed, and Naukri. Auto-scores, tailors resume, and applies to matching jobs.", "permissions": ["storage", "sidePanel", "activeTab", "scripting", "alarms", "webNavigation", "identity"], "host_permissions": ["https://www.linkedin.com/*", "https://www.naukri.com/*", "https://*.indeed.com/*", "<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.naukri.com/*"], "js": ["content/naukri.js"], "run_at": "document_idle"}, {"matches": ["https://*.indeed.com/*"], "js": ["content/indeed.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "externally_connectable": {"matches": ["https://applycandid.com/*"]}, "web_accessible_resources": [{"resources": ["lib/pdfjs/pdf.worker.min.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}