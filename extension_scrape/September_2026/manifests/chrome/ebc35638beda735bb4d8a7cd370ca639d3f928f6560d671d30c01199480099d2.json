{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lingopede Browser Companion", "description": "Translate any word on the web and save it as a flashcard. Clickable captions on YouTube and Netflix.", "version": "1.0.2", "short_name": "Lingopede", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "lingopede@lingopede.xyz", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}, "action": {"default_title": "Lingopede", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "scripting", "cookies", "contextMenus"], "host_permissions": ["https://lingopede.xyz/*", "*://*.youtube.com/*", "*://*.netflix.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.netflix.com/*"], "run_at": "document_idle", "js": ["content-scripts/netflix.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}