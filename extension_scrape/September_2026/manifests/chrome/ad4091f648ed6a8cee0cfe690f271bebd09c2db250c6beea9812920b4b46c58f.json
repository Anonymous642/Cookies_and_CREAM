{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Price Drop \u2014 Track prices, never overpay", "short_name": "PriceDrop", "description": "Track product prices on Amazon, eBay, Zalando, MediaMarkt, Otto. Get alerts when prices drop. 90-day history. Free for 5 products.", "version": "1.1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Price Drop"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.uk/*"], "js": ["content/common.js", "content/amazon.js"], "css": ["content/pricedrop.css"], "run_at": "document_idle"}, {"matches": ["*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.co.uk/*"], "js": ["content/common.js", "content/ebay.js"], "css": ["content/pricedrop.css"], "run_at": "document_idle"}, {"matches": ["*://*.zalando.de/*", "*://*.zalando.com/*"], "js": ["content/common.js", "content/zalando.js"], "css": ["content/pricedrop.css"], "run_at": "document_idle"}, {"matches": ["*://*.mediamarkt.de/*", "*://*.saturn.de/*"], "js": ["content/common.js", "content/mediamarkt.js"], "css": ["content/pricedrop.css"], "run_at": "document_idle"}, {"matches": ["*://*.otto.de/*"], "js": ["content/common.js", "content/otto.js"], "css": ["content/pricedrop.css"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.uk/*", "*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.co.uk/*", "*://*.zalando.de/*", "*://*.zalando.com/*", "*://*.mediamarkt.de/*", "*://*.saturn.de/*", "*://*.otto.de/*", "https://extensionpay.com/*"]}