{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PinDrop \u2014 Pinterest Media Downloader", "version": "2.0.0", "description": "Download any Pinterest video or image with a single click. A download button on every pin \u2014 just click and save. Powered by PinDrop.", "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["*://*.pinimg.com/*", "*://*.pinterest.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}