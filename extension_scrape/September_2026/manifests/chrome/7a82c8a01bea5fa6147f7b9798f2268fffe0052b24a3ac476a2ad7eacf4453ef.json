{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bottled Inbox", "short_name": "Bottled", "description": "Desktop alerts for new mail on your custom domain, an unread badge, and one-click access to your Bottled inbox.", "version": "1.0.12", "author": "Bottled (bottled.email)", "homepage_url": "https://bottled.email", "permissions": ["alarms", "notifications", "storage", "contextMenus", "tabs"], "host_permissions": ["https://bottled.email/*"], "content_scripts": [{"matches": ["https://bottled.email/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["detect.js"], "run_at": "document_start"}], "action": {"default_title": "Bottled Inbox (Alt+Shift+B)", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icon16.png"], "matches": ["https://bottled.email/*", "http://localhost/*", "http://127.0.0.1/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+B", "mac": "MacCtrl+Shift+B"}, "description": "Open Bottled Inbox"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}