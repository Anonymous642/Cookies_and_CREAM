{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Universal Video Downloader", "version": "4.0.1", "default_locale": "en", "description": "Capture and download videos from TikTok, Twitter/X, Douyin, and other platforms.", "permissions": ["webRequest", "declarativeNetRequest", "downloads", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.douyin.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["inject-twitter.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.tiktok.com/*"], "js": ["inject-tiktok.js"], "run_at": "document_start", "world": "MAIN"}]}