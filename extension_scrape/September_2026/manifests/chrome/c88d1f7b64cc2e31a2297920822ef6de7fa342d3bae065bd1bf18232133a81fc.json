{"update_url": "https://clients2.google.com/service/update2/crx", "name": "inControl", "version": "1.0.0", "description": "Stay focused by blocking distracting websites with flexible temporary access when needed", "manifest_version": 3, "author": "M. Fasi ur Rehman", "homepage_url": "https://github.com/fasi96/inControl", "permissions": ["storage", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["block-memes/*", "blocked.html", "blocked.js", "blocked-ui.js", "blocked-messages.js", "blocked.css", "popup.css"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js", "type": "module"}}