{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "JobConnect - The AI-Powered Job Fit Finder", "version": "1.0.0", "description": "Instantly analyzes job listings on Indeed, LinkedIn, ZipRecruiter, Glassdoor, and Hiring.Cafe to find your best matches.", "permissions": ["storage", "alarms", "contextMenus"], "host_permissions": ["https://www.indeed.com/*", "https://www.linkedin.com/*", "https://www.ziprecruiter.com/*", "https://www.glassdoor.com/*", "https://hiring.cafe/*"], "icons": {"16": "icons/JobConnect_Logo.png", "48": "icons/JobConnect_Logo.png", "128": "icons/JobConnect_Logo.png"}, "action": {"default_icon": {"16": "icons/JobConnect_Logo.png", "48": "icons/JobConnect_Logo.png", "128": "icons/JobConnect_Logo.png"}, "default_popup": "popup/popup.html"}, "options_page": "popup/popup.html", "content_scripts": [{"matches": ["https://www.indeed.com/jobs*", "https://www.indeed.com/viewjob*", "https://www.linkedin.com/jobs/*", "https://www.ziprecruiter.com/jobs*", "https://www.ziprecruiter.com/jobs/*", "https://www.ziprecruiter.com/jobs-search*", "https://www.ziprecruiter.com/c/*", "https://www.ziprecruiter.com/candidate/*", "https://www.glassdoor.com/Job/*", "https://www.glassdoor.com/job-listing/*", "https://hiring.cafe/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background/background.js"}, "web_accessible_resources": [{"resources": ["content/*"], "matches": ["<all_urls>"]}]}