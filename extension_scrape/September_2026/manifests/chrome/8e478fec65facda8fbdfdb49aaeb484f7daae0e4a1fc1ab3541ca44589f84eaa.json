{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Optimsy - The Etsy AI Assistant", "description": "Revolutionize your Etsy shop with AI-powered SEO, dynamic listing generation, and market analysis right inside your browser.", "version": "0.3.5", "action": {"default_popup": "popup.html", "default_title": "Optimsy Studio"}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "dist/background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "identity", "sidePanel"], "host_permissions": ["https://etsy.com/*", "https://www.etsy.com/*", "https://www.optimsy.com/*", "https://*.supabase.co/*", "https://*.supabase.in/*"], "content_scripts": [{"matches": ["https://etsy.com/listing/*/edit*", "https://www.etsy.com/listing/*/edit*", "https://etsy.com/your/shops/*/listings*", "https://www.etsy.com/your/shops/*/listings*", "https://etsy.com/your/shops/*/listing-editor*", "https://www.etsy.com/your/shops/*/listing-editor*"], "js": ["dist/content/etsy-listing.js"], "run_at": "document_idle"}]}