{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "blurGPT", "version": "1.0.0", "description": "Blur chat history titles on ChatGPT, Claude, and Gemini for screen-sharing privacy.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs"], "background": {"service_worker": "background.js"}, "commands": {"toggle-global-blur": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Toggle global blur on/off"}}, "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}