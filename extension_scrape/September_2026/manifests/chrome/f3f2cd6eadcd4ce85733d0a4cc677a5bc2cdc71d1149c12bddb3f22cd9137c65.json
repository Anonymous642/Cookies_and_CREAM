{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Math Agent", "short_name": "MathAgent", "version": "0.1.0", "description": "Screenshot any math/science problem to get a step-by-step solution, or let MathAgent auto-solve a whole quiz page.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Math Agent \u2014 open side panel", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "options_page": "options/options.html", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"capture-region": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture a screen region and solve it"}, "autosolve-page": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Detect questions on the current page and autosolve"}, "pick-question": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Point at a single question and solve it"}, "toggle-side-panel": {"description": "Toggle the Math Agent side panel"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/overlay.js", "content/autosolve.js", "content/picker.js"], "css": ["content/overlay.css", "content/autosolve.css", "content/picker.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/overlay.css", "content/autosolve.css", "content/picker.css", "icons/*"], "matches": ["<all_urls>"]}]}