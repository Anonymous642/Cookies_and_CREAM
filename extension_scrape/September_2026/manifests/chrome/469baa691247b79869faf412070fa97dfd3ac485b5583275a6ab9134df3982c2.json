{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat2MD \u2014 Save ChatGPT chats as Markdown", "version": "0.1.0", "description": "Export any ChatGPT conversation to a clean Markdown file. Code blocks, tables and LaTeX survive. Runs entirely on your machine.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Save this chat as Markdown", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["downloads", "activeTab", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "web_accessible_resources": [{"resources": ["src/lib/*.js"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}