{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkPurifier \u2014 OneClick Tools", "description": "Remove tracking parameters from URLs and copy a clean link with one click. Privacy-first, no accounts, no telemetry.", "version": "1.0.0", "action": {"default_title": "LinkPurifier", "default_popup": "public/popup.html", "default_icon": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}}, "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "permissions": ["activeTab", "clipboardWrite", "storage", "scripting"], "optional_permissions": ["contextMenus"], "background": {"service_worker": "background.js", "type": "module"}, "offscreen_documents": [{"url": "src/background/offscreen.html", "reason": "CLIPBOARD", "matches": ["*://*/*", "chrome://*/*"], "justification": "Write cleaned URLs to clipboard from background (keyboard shortcut/context menu)"}], "commands": {"copy-clean-link": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Copy clean link for the active tab"}}}