{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Web Voice Shortcuts", "version": "1.4.0", "description": "Voice shortcuts for ChatGPT: ALT (\u2325) + SPACE to start, ENTER to submit, ESC to cancel dictation", "author": "Bilgin Ibryam (@bibryam)", "homepage_url": "https://github.com/bibryam/chatgpt-dictate?temporary-chat=true&", "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*"], "options_page": "options.html", "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Open ChatGPT with Auto-Dictate", "default_icon": "images/icon.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Space", "mac": "Alt+Shift+Space"}}}, "background": {"service_worker": "background.js"}, "short_name": "ChatGPT Web Voice Shortcuts", "minimum_chrome_version": "88"}