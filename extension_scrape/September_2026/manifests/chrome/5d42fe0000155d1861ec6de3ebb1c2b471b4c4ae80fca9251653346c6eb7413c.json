{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Incognito One-Click - Open Tabs in Incognito", "version": "2.0.0", "description": "Open any tab in an incognito window in one click. Reuses your open incognito window, moves tabs both ways. No data access.", "minimum_chrome_version": "109", "homepage_url": "https://volume-booster.org/incognito/", "incognito": "spanning", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Open this tab in Incognito", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/content.js"], "run_at": "document_idle", "all_frames": false}], "optional_permissions": ["history"], "commands": {"_execute_action": {"description": "Open the Incognito One-Click popup"}, "open-in-incognito": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Open this tab in an incognito window"}, "move-to-incognito": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Move this tab to incognito (closes the original)"}, "new-incognito-window": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Open a blank incognito window"}, "close-all-incognito": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Close all incognito windows"}}}