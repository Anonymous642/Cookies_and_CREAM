{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lite Bookmark Manager", "version": "1.0.0", "default_locale": "en", "description": "Organize, search and clean up your bookmarks fast. Find duplicates and broken links. 100% local \u2014 no account, no data collected.", "homepage_url": "https://emproit.com", "minimum_chrome_version": "114", "offline_enabled": true, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "ui/popup.html", "default_title": "Lite Bookmark Manager", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "ui/options.html", "permissions": ["bookmarks", "storage", "favicon", "activeTab"], "optional_host_permissions": ["*://*/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "__MSG_cmdOpenPopup__"}, "save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "__MSG_cmdSaveTab__"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}