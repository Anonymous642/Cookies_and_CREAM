{"update_url": "https://clients2.google.com/service/update2/crx", "name": "FocusTube", "description": "Hides YouTube's sidebar and comments for a clean, distraction-free viewing experience. Focus only on the video content.", "version": "0.1.1", "manifest_version": 3, "icons": {"16": "icon-16.png", "32": "icon-32.png", "64": "icon-64.png", "128": "icon-128.png"}, "permissions": ["storage", "scripting", "management", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "options_page": "options.html", "background": {"service_worker": "background.js"}, "action": {"default_title": "FocusTube", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["contentScript.js"], "all_frames": true, "exclude_globs": ["chrome://extensions/*"], "run_at": "document_idle"}]}