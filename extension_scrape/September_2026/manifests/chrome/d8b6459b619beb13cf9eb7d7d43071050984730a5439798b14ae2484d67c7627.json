{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ad Blocker for Chrome", "version": "1.0.1", "description": "Blocks ads/trackers with open-source lists (StevenBlack + EasyList). Network + CSS blocking, live badge, allowlist.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Ad Blocker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "webNavigation", "webRequest", "contextMenus", "notifications", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "ad_hosts", "enabled": true, "path": "rules/network-rules.json"}]}, "web_accessible_resources": [{"resources": ["rules/cosmetic.css", "rules/cosmetic-selectors.json"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "js": ["src/content.js"], "run_at": "document_start"}], "commands": {"toggle-block": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Enable/disable ad blocking on this site"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}