{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KB URL COPY", "version": "2.0", "description": "Easily copy formatted URLs and titles from Broadcom KB and TechDocs articles.", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab"], "content_scripts": [{"matches": ["*://knowledge.broadcom.com/*", "*://techdocs.broadcom.com/*"], "js": ["kb-url-content.js"], "run_at": "document_idle"}]}