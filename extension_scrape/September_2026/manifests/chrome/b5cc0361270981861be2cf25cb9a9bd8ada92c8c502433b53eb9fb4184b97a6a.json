{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notion Saver \u2014 URL & Summary", "version": "1.1.1", "description": "Send current page URL + locally summarized content to Notion.", "action": {"default_popup": "popup/popup.html", "default_title": "Send to Notion"}, "options_page": "options/options.html", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>", "https://api.notion.com/*"], "icons": {"128": "assets/icon128.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}]}