{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StoreTabs - Memory Saver & Tab Manager", "description": "Collapse all open tabs into a clean, searchable list to save memory, organize tab groups, and restore when needed.", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "StoreTabs", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "default_popup": "popup.html"}, "permissions": ["tabs", "storage", "contextMenus", "tabGroups"], "commands": {"collapse-tabs": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Option+Shift+C"}, "description": "Collapse all tabs in current window into a group"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Option+Shift+D"}, "description": "Open StoreTabs Dashboard"}}, "background": {"service_worker": "background.js"}}