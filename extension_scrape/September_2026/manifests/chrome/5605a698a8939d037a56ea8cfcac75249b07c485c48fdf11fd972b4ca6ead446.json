{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DelinkedIn", "version": "2.3.8", "description": "Translate job listings to reveal what they actually mean, decoding corporate jargon with just the right amount of humor.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png", "192": "images/icon192.png"}, "permissions": ["storage"], "host_permissions": ["https://api.delinkedin.com/*"], "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*", "*://*.linkedin.com/job/*", "*://*.linkedin.com/*/jobs/*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "web_accessible_resources": [{"resources": ["images/*.png", "images/*.jpg", "images/*.jpeg", "images/*.svg", "images/*.gif"], "matches": ["https://*.linkedin.com/*"]}]}