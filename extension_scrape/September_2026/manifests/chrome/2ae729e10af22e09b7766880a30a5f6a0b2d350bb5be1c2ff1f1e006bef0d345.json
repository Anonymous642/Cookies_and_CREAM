{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lasga", "version": "1.3", "description": "Effortlessly manage tabs. Copy/close tabs with smart filters, or open bulk URLs from your clipboard.", "permissions": ["tabs", "storage", "scripting", "commands", "clipboardWrite", "clipboardRead", "offscreen", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"copy-urls": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Copy URLs"}, "copy-and-close-tabs": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Copy URLs and close tabs"}, "close-tabs": {"suggested_key": {"default": "Ctrl+Shift+I"}, "description": "Close tabs"}, "open-urls-from-clipboard": {"suggested_key": {"default": "Ctrl+Shift+O"}, "description": "Open URLs from clipboard"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["toast.css"], "matches": ["<all_urls>"]}]}