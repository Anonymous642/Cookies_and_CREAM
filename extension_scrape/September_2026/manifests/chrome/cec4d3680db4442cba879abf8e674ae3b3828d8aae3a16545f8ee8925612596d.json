{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VeriClick", "version": "1.0.29", "description": "Know if a link is safe before you click. Instant trust scores on every link \u2014 stop phishing and scams before they start.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs", "windows", "alarms"], "host_permissions": ["https://api.vericlick.io/*"], "background": {"service_worker": "dist/background/index.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle"}], "action": {"default_title": "VeriClick", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options.html", "externally_connectable": {"matches": ["https://vericlick.io/*", "https://*.vericlick.io/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"]}, "web_accessible_resources": [{"resources": ["vericlick-logo.svg", "icons/icon-16.png", "icons/icon-48.png", "icons/icon-128.png"], "matches": ["<all_urls>"]}]}