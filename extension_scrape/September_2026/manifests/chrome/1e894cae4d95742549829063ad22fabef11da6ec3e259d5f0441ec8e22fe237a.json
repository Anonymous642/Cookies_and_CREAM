{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Minimal Network - Remove YouTube Shorts & Recommended, Clean X (Twitter)", "version": "4.0.1", "description": "Remove YouTube Shorts & recommended videos. Clean the X (Twitter) feed: For You tab, trends, retweets. Hide any element, any site.", "permissions": ["storage", "alarms", "scripting", "activeTab"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://www.google-analytics.com/*", "https://api.minnet.tech/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Minimal Network", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/shared.js", "content/focus.js", "content/twitter.js"], "css": ["styles/twitter-minimal.css"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/shared.js", "content/focus.js", "content/youtube.js"], "css": ["styles/youtube-minimal.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["styles/*"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://www.youtube.com/*", "https://youtube.com/*"]}]}