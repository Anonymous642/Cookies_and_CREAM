{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Mute Audio Ads on Accuradio & Spotify", "description": "Mutes audio on Accuradio and Spotify. Users can toggle muting for each site, A widget will be shown on the page to indicate status.", "version": "2.0", "manifest_version": 3, "background": {"service_worker": "scripts/serviceWorker.js"}, "permissions": ["storage", "scripting"], "host_permissions": ["*://*.spotify.com/*", "https://www.accuradio.com/*"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "128": "images/128.png"}, "default_title": "Toggle Muting Ads"}, "content_scripts": [{"js": ["scripts/utils.js", "scripts/content.js"], "matches": ["https://www.accuradio.com/*", "*://open.spotify.com/*"]}]}