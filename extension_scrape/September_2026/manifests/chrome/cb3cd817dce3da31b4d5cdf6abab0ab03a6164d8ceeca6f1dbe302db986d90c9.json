{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cordy", "description": "Modern AI-powered browser extension with intelligent chat management and seamless web integration", "version": "2.5.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting", "contextMenus", "offscreen", "alarms", "favicon", "tabGroups", "search"], "optional_permissions": ["browsingData", "history", "bookmarks"], "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["content-ui.js", "content-scripts/content-ui.css", "assets/content-ui.css", "icon/logo.png", "fonts/*.woff2"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Cordy - AI Assistant & Tools"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "__MSG_manifest_commandExecuteAction__"}, "toggle-sidepanel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "__MSG_manifest_commandToggleSidepanel__"}, "toggle-command-palette": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "__MSG_manifest_commandToggleCommandPalette__"}, "collect-current-window": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "__MSG_manifest_commandCollectTabs__"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "default_locale": "en", "minimum_chrome_version": "148", "background": {"type": "module", "service_worker": "background.js"}}