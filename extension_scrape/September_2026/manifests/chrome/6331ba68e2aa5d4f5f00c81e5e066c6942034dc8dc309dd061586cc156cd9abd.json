{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coursified \u2014 YouTube to Course", "version": "1.0.1", "description": "Turn any YouTube video into a structured course with AI-generated quizzes, notes, and assessments.", "permissions": ["activeTab", "tabs", "cookies", "storage", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://coursified.app/*", "https://*.coursified.app/*", "http://localhost/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://coursified.app/*", "https://*.coursified.app/*", "http://localhost/*"], "js": ["marker.js"], "run_at": "document_start"}], "externally_connectable": {"matches": ["https://coursified.app/*", "https://*.coursified.app/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}