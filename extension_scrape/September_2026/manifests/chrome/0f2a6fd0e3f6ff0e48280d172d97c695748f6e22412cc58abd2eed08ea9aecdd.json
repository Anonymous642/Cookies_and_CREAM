{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LLM Context Clipper", "version": "0.1.0", "description": "Clip page selections into one structured markdown context pack, ready to paste into an LLM.", "homepage_url": "https://moailoops.com/llm-context-clipper", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "contextMenus", "offscreen"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Context pack", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"matches": [], "resources": ["src/content.js", "src/reader.js"], "use_dynamic_url": false}], "commands": {"clip-element": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Pick an element and append it to the context pack"}, "export-pack": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Copy the whole context pack to the clipboard"}}}