{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AILesson \u2014 Learn AI in the Sidebar", "version": "1.0.0", "description": "Learn AI alongside your work. Browse AILesson courses, interactive lessons, and prompt recipes in Chrome's side panel.", "minimum_chrome_version": "116", "homepage_url": "https://ailesson.io", "permissions": ["sidePanel", "storage"], "host_permissions": ["https://ailesson.io/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open AILesson", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://ailesson.io/*"], "js": ["bridge.js"], "all_frames": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-src https://ailesson.io; base-uri 'none';"}}