{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Brimmer \u2014 Recipe Clipper & Cart Fill", "version": "0.7.0", "description": "Clip recipes into Brimmer, and fill your online-store cart from an order. No setup \u2014 it uses your signed-in Brimmer session.", "action": {"default_popup": "popup.html", "default_title": "Brimmer", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "tabs", "declarativeNetRequest", "storage"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "optional_host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["https://brimmer.nl/*", "https://app.brimmer.nl/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js", "app-api.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "recipe-clipper@brimmer", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}