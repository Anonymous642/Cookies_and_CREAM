{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Talentis", "description": "Talentis Browser Extension", "version": "2.0.152", "manifest_version": 3, "permissions": ["activeTab", "webRequest", "downloads", "storage", "tabs", "identity", "webNavigation", "scripting", "alarms"], "host_permissions": ["https://*.talentis.global/", "https://*.talentis.global/*", "https://*.linkedin.com/", "https://*.linkedin.com/*", "https://linkedin.com/", "https://linkedin.com/*", "https://localhost/*", "https://www.google.com/*", "*://*.chromiumapp.org/"], "action": {"default_popup": "src/popup.html"}, "icons": {"16": "img/extension-16.png", "32": "img/extension-32.png", "48": "img/extension-48.png", "128": "img/extension-128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"run_at": "document_end", "matches": ["https://linkedin.com/*", "https://linkedin.com/", "https://*.linkedin.com/", "https://*.linkedin.com/*"], "js": ["src/content/content.js"], "css": ["style.css"]}, {"run_at": "document_end", "matches": ["https://www.google.com/*", "https://linkedin.com/*", "https://linkedin.com/", "https://*.linkedin.com/", "https://*.linkedin.com/*"], "js": ["src/content/google-search/google-content.js"]}, {"run_at": "document_idle", "matches": ["https://*/*", "http://localhost:3000/*"], "js": ["src/content/dom-scraper/dom-scraper.js"]}], "web_accessible_resources": [{"resources": ["img/*.png", "img/*.svg", "src/popup.html"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://*.talentis.global/", "https://*.talentis.global/*"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}