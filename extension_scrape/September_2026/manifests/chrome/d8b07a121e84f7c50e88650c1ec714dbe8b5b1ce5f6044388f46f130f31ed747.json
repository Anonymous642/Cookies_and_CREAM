{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CS2 inventory steam extension", "short_name": "CS2 Inventory", "description": "CS2 inventory tool with real-time pricing, case statistics, float/pattern detection, and quick selling.", "version": "1.0.4", "action": {"default_title": "SMT V4", "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "clipboardWrite", "scripting", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": [{"id": "csfloat_rules", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/SMT_16x16.png", "32": "icons/SMT_32x32.png", "48": "icons/SMT_48x48.png", "128": "icons/SMT_128x128.png"}, "content_scripts": [{"matches": ["https://steamcommunity.com/*"], "js": ["core/constants.js", "core/utils.js", "core/cache.js", "parsers/special-skins.js", "parsers/item-parser.js", "api/skinport.js", "api/steam.js", "api/csfloat.js", "inventory/badges.js", "inventory/cards.js", "inventory/grid.js", "sidebar/stickers.js", "sidebar/sidebar.js", "navigation-sidebar.js", "main.js", "history/detector.js", "history/parser.js", "history/stats.js", "history/loader.js", "history/ui.js", "history/main.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "host_permissions": ["https://steamcommunity.com/*", "https://api.skinport.com/*", "https://api.csfloat.com/*"], "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["https://steamcommunity.com/*"]}]}