{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT \u2192 Google Drive Logger", "version": "1.0.1", "description": "Automatically save your ChatGPT conversations to Google Drive as Markdown.", "permissions": ["storage", "identity"], "host_permissions": ["https://www.googleapis.com/*", "https://accounts.google.com/*", "https://*.googleusercontent.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "options.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "oauth2": {"client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file", "https://www.googleapis.com/auth/drive.appdata"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}