{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartBrowse Portal", "version": "1.0.8", "description": "Controlled Chrome navigation with persistent sidebar and autofill.", "permissions": ["declarativeNetRequest", "storage", "tabs", "webNavigation", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "popup/popup.html", "default_title": "SmartBrowse", "default_icon": {"16": "icons/smartbrowse16.png", "32": "icons/smartbrowse32.png", "48": "icons/smartbrowse48.png", "128": "icons/smartbrowse128.png"}}, "icons": {"16": "icons/smartbrowse16.png", "48": "icons/smartbrowse48.png", "128": "icons/smartbrowse128.png"}, "web_accessible_resources": [{"resources": ["content/sidebar.html", "content/sidebar.css", "icons/*.png", "popup/blocked.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}