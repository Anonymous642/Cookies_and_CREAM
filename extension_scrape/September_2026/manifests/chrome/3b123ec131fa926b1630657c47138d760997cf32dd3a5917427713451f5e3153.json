{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zeranda \u2014 Bills, Deliveries & Alerts for Gmail", "description": "See the bills, subscriptions, deliveries and alerts Zeranda found in your inbox \u2014 right inside Gmail. Scanning stays server-side.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "notifications", "sidePanel", "scripting"], "host_permissions": ["https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["icon/*.png", "fonts/*.woff2", "nav-icons/*.svg", "action-icons/*.svg"], "matches": ["https://mail.google.com/*"]}], "action": {"default_title": "Zeranda"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_end", "js": ["content-scripts/gmail.js"]}]}