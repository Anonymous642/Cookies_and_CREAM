{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MediaPilot \u2013 AI Music Remover, Speed & Focus Mode", "version": "0.3.1", "description": "Remove music or noise with local AI \u2014 playback speed, Focus Mode, Volume Boost, Hide Video, Auto Scroll. Distraction-free.", "permissions": ["tabCapture", "offscreen", "activeTab", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared-site.js", "content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "cross_origin_embedder_policy": {"value": "require-corp"}, "cross_origin_opener_policy": {"value": "same-origin"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Alt+F", "mac": "Alt+F"}, "description": "Toggle Focus Mode"}, "toggle-music-remover": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Toggle MediaPilot"}}}