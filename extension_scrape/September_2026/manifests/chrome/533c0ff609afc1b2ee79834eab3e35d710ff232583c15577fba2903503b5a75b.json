{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Keyboard Converter", "version": "1.0.2", "description": "Fix keyboard layout mismatches between languages. Automatically detects and corrects text typed in the wrong keyboard layout.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "clipboardRead", "clipboardWrite", "webNavigation", "unlimitedStorage"], "host_permissions": ["https://*.google.com/*", "https://docs.google.com/*", "https://mail.google.com/*", "https://drive.google.com/*", "https://sheets.google.com/*", "https://slides.google.com/*", "https://forms.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "19": "images/toolbar-icon.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png", "256": "images/icon256.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.google.com/*", "https://docs.google.com/*", "https://mail.google.com/*", "https://drive.google.com/*", "https://sheets.google.com/*", "https://slides.google.com/*", "https://forms.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["images/*", "content.js"], "matches": ["https://*.google.com/*", "https://docs.google.com/*", "https://mail.google.com/*", "https://drive.google.com/*", "https://sheets.google.com/*", "https://slides.google.com/*", "https://forms.google.com/*"]}], "commands": {"convert-text": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Convert text between Hebrew and English keyboard layouts"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}