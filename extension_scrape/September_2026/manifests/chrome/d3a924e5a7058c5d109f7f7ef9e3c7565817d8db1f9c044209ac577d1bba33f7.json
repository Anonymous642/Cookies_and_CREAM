{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Twitch Hover To Expand", "description": "Keeps Twitch's left sidebar closed and opens it on hover.", "version": "0.1.0", "permissions": ["tabs", "storage"], "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Twitch Hover To Expand", "default_popup": "popup/popup.html"}, "commands": {"toggle-side-nav": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Toggle Twitch left sidebar"}}}