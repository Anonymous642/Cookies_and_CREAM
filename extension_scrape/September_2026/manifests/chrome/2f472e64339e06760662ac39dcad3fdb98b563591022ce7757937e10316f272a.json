{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "API Pilot - FREE and Open Source API Interceptor, Mocker & Tester", "version": "2.0.2", "description": "Intercept, modify, & mock HTTP requests with ease. A free, open-source dev tool for API development, testing, and debugging.", "permissions": ["declarativeNetRequest", "storage", "unlimitedStorage", "sidePanel", "tabs", "cookies", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "assets/icons/icon.png", "48": "assets/icons/icon.png", "128": "assets/icons/icon.png"}}, "side_panel": {"default_path": "sidebar/index.html"}, "icons": {"16": "assets/icons/icon.png", "48": "assets/icons/icon.png", "128": "assets/icons/icon.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["interceptor.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}