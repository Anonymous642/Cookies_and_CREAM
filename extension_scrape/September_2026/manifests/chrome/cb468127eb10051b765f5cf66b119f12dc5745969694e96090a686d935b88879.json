{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtune", "version": "1.0", "description": "Transform YouTube videos into an immersive cinema experience with audio mode, ambient effects, and video controls.", "permissions": ["activeTab", "scripting", "storage", "notifications"], "host_permissions": ["https://itunes.apple.com/*", "https://musicbrainz.org/*", "https://en.wikipedia.org/*"], "action": {"default_title": "Activate Youtune Cinema Mode (Ctrl+Shift+L)", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Activate or deactivate Youtune Cinema Mode"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["modules/effects/main.css"], "matches": ["https://www.youtube.com/*"]}]}