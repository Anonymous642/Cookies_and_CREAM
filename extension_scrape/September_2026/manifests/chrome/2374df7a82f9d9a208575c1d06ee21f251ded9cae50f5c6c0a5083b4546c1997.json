{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Link Organizer", "description": "Save and categorize your links manually and automatically with ease.", "version": "1.0.0", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/16.png", "48": "assets/icons/48.png"}}, "permissions": ["activeTab", "storage", "tabs", "contextMenus", "bookmarks"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icons/16.png", "48": "assets/icons/48.png", "128": "assets/icons/128.png"}, "commands": {"save-current-link": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Save current page to Smart Link Organizer"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/icons/16.png", "assets/icons/48.png", "assets/icons/128.png"], "matches": ["<all_urls>"]}]}