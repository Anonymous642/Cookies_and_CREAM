{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Player - Picture in Picture (PiP)", "version": "1.0.2", "description": "Watch videos in a floating Picture-in-Picture window while multitasking. Works on streaming platforms and web video players.", "permissions": ["activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Picture in Picture (Alt+P)"}, "commands": {"toggle-pip": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle Picture-in-Picture mode"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}