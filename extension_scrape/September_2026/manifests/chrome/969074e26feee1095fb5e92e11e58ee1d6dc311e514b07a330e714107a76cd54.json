{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vi Voice - Voice Input Assistant", "version": "1.6.0", "description": "Speech-to-text dictation with AI punctuation. Voice typing in 11 languages. Instant transcription. GDPR compliant & private.", "homepage_url": "https://vi-voice.com/", "permissions": ["storage", "activeTab", "clipboardWrite", "alarms", "tabs"], "host_permissions": ["https://api.openai.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "exclude_matches": ["*://*.gov/*", "*://paypal.com/*", "*://*.paypal.com/*", "*://stripe.com/*", "*://*.stripe.com/*"], "js": ["security.js", "punctuation-engine.js", "tips-banner.js", "content.js"], "css": ["styles.css"], "run_at": "document_end", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/microphone.svg", "icons/play.svg", "icons/stop.svg"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Space", "mac": "MacCtrl+Space"}, "description": "Start/stop voice recording"}, "clear-text": {"suggested_key": {"default": "Ctrl+Delete", "mac": "MacCtrl+Delete"}, "description": "Clear transcribed text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}