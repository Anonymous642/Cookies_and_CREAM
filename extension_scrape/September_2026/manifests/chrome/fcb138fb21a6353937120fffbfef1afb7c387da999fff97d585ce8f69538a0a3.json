{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Rainbow Tab Organizer", "version": "2.6", "description": "Colorful tab manager with domain color-coding, smart sorting, UI scaling, and a persistent 'Bucket' to save tabs for later.", "minimum_chrome_version": "114", "permissions": ["tabs", "storage", "sidePanel", "sessions", "favicon", "bookmarks"], "host_permissions": ["https://api.lemonsqueezy.com/*"], "icons": {"16": "rainbow_tab_pro_16x16.png", "32": "rainbow_tab_pro_32x32.png", "48": "rainbow_tab_pro_48x48.png", "128": "rainbow_tab_pro_128x128.png"}, "action": {"default_title": "Click to open Rainbow Tab Organizer", "default_icon": {"16": "rainbow_tab_pro_16x16.png", "32": "rainbow_tab_pro_32x32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "commands": {"_execute_side_panel": {"suggested_key": {"default": "Alt+R"}, "description": "Open Rainbow Tab Organizer"}, "cycle-filtered-tabs-forward": {"suggested_key": {"default": "Alt+Q"}, "description": "Cycle forward through filtered tabs"}, "cycle-filtered-tabs-backward": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Cycle backward through filtered tabs"}}}