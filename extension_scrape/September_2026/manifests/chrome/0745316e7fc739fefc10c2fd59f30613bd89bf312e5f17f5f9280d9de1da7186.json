{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Timo \u2014 Your day, already organized", "short_name": "Timo", "version": "1.1.0", "description": "New tab shows what will move today. Capture tasks from any page, record a meeting or call for AI notes, join the next meeting.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Timo", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["identity", "storage", "contextMenus", "alarms", "activeTab", "scripting", "offscreen", "tabCapture"], "host_permissions": ["https://timonow.com/*"], "commands": {"quick-capture": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Capture the current page or selection into Timo"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}