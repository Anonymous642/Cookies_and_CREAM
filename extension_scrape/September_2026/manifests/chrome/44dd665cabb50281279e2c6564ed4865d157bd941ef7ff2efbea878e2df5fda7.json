{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumyna - Dual Subtitles & Language Learner", "version": "1.3", "description": "Double subtitles on YouTube with common phrase grouping for English learning.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "cookies"], "background": {"service_worker": "src/background.js"}, "host_permissions": ["*://*.youtube.com/*", "https://*.googlevideo.com/*", "https://video.google.com/*", "https://translate.googleapis.com/*", "*://*.lumyna-xi.vercel.app/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Dual Subtitles", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/globals.js", "src/utils/helpers.js", "src/utils/api.js", "src/core/fetcher.js", "src/core/supabase.js", "src/core/sync.js", "src/ui/dictionary.js", "src/ui/learning-mode.js", "src/ui/practice-mode.js", "src/ui/settings.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/inject.js", "icons/icon48.svg"], "matches": ["*://*.youtube.com/*"]}]}