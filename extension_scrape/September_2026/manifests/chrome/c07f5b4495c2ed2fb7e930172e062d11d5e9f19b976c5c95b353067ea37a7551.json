{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SkipFrog for YouTube", "short_name": "SkipFrog", "description": "Skip and loop custom segments in YouTube videos. Perfect for skipping unwanted tracks in long compilation or mix videos.", "version": "2.2", "manifest_version": 3, "action": {"default_popup": "popup.html", "default_icon": {"16": "frog-16.png", "32": "frog-32.png"}}, "icons": {"16": "frog-16.png", "32": "frog-32.png", "48": "frog-48.png", "128": "frog-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["frog-16.png"], "matches": ["https://www.youtube.com/*"]}]}