{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VN: Gen AI Production Tools", "description": "Prompt tools and copyright/brand scoring for AI images, inline on Fal, Replicate, and Midjourney.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "cookies", "sidePanel", "contextMenus", "activeTab"], "commands": {"enhance-prompt": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "VN: enhance the prompt on this page"}, "open-panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "VN: open the panel"}}, "host_permissions": ["https://fal.ai/*", "https://*.fal.ai/*", "https://replicate.com/*", "https://*.replicate.com/*", "https://midjourney.com/*", "https://*.midjourney.com/*", "https://app.vn.ai/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "VN: Gen AI Production Tools", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://*.fal.ai/*", "https://fal.ai/*"], "run_at": "document_idle", "js": ["content-scripts/fal.js"]}, {"matches": ["https://midjourney.com/*", "https://www.midjourney.com/*"], "run_at": "document_idle", "js": ["content-scripts/midjourney.js"]}, {"matches": ["https://*.replicate.com/*", "https://replicate.com/*"], "run_at": "document_idle", "js": ["content-scripts/replicate.js"]}, {"matches": ["https://app.vn.ai/*"], "run_at": "document_end", "js": ["content-scripts/vn-auth.js"]}]}