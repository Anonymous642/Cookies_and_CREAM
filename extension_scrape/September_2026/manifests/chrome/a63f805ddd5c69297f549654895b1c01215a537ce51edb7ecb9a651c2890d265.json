{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FlashSnippet", "version": "2.0.1", "description": "Turn shortcuts into full replies on Instagram, Gmail, WhatsApp Web and more. Fast text expansion with inline AI.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "FlashSnippet", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "dashboard.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open FlashSnippet"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}