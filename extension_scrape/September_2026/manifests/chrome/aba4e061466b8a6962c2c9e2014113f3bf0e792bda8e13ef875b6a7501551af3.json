{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BidPacer", "version": "1.13.5", "icons": {"128": "icon128.png"}, "description": "BidPacer helps you craft cover letters and tailor your resume, then fetches Upwork, Freelancer and Guru job results.", "host_permissions": ["https://www.upwork.com/*", "https://www.freelancer.com/*", "https://www.guru.com/*", "https://*.bidpacer.ai/*", "https://*.bidpacer.com/*", "http://localhost/*"], "permissions": ["scripting", "storage", "debugger", "cookies", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://*.bidpacer.ai/*", "https://*.bidpacer.com/*", "http://localhost:3000/*", "http://localhost:3457/*", "http://127.0.0.1:3000/*"]}, "content_scripts": [{"matches": ["https://www.upwork.com/nx/proposals/job/*"], "js": ["apply_autofill.js"], "run_at": "document_idle"}, {"matches": ["https://www.freelancer.com/projects/*"], "js": ["freelancer_autofill.js"], "run_at": "document_idle"}, {"matches": ["https://*.bidpacer.ai/*", "https://*.bidpacer.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bp_bridge.js"], "run_at": "document_start"}]}