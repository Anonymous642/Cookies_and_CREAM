{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Automation Tools - Image Workflow", "description": "Free local batch image prompt automation, image editing workflows, and downloads for ChatGPT.", "version": "0.1.11", "minimum_chrome_version": "116", "permissions": ["debugger", "downloads", "scripting", "sidePanel", "storage", "tabs", "tts"], "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_title": "ChatGPT Automation Tools - Image Workflow", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"], "js": ["src/content/chatgpt-automation.js"], "run_at": "document_start"}]}