{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notesnip YouTube Summary", "description": "Summarize YouTube videos into Notesnip notes without leaving the video page.", "version": "0.1.0", "icons": {"16": "/icons/icon16.png", "32": "/icons/icon32.png", "48": "/icons/icon48.png", "128": "/icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://notesnip.com/*", "https://*.notesnip.com/*"], "action": {"default_title": "Notesnip", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://m.youtube.com/*", "https://www.youtube.com/*"], "js": ["content-scripts/youtube-summary.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/youtube-summary.css"], "use_dynamic_url": true, "matches": ["https://m.youtube.com/*", "https://www.youtube.com/*"]}]}