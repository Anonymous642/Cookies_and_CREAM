{"update_url": "https://clients2.google.com/service/update2/crx", "name": "wscaduniverse GO", "description": "Add a context menu option to selected text and search in wscaduniverse.com by this text.", "manifest_version": 3, "version": "3.0.2", "homepage_url": "https://www.wscaduniverse.com", "default_locale": "en", "action": {"default_popup": "index.html", "default_icon": {"16": "/images/icon16.png", "32": "/images/icon32.png", "48": "/images/icon48.png", "128": "/images/icon128.png"}, "default_title": "WSCAD Universe GO"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"search_part_wsu": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Search selected text on wscaduniverse.com."}, "search_part_api": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "\"Search part\" from selected text."}, "add_part_to_list": {"suggested_key": {"default": "Ctrl+Shift+6", "mac": "Command+Shift+6"}, "description": "Add selected text to \"Search list\"."}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open WSU Go extension."}}, "permissions": ["contextMenus", "activeTab", "tabs", "storage", "nativeMessaging", "scripting"], "host_permissions": ["https://*/*"], "externally_connectable": {"matches": ["https://*.wscaduniverse.com/*", "http://*.wscaduniverse.local/*", "https://*.wscad-service.com/*"]}, "web_accessible_resources": [{"matches": ["https://*.wscaduniverse.com/*", "http://*.wscaduniverse.local/*", "https://*.wscad-service.com/*"], "resources": ["/data/ext_status.json"]}], "icons": {"16": "/images/icon16.png", "32": "/images/icon32.png", "48": "/images/icon48.png", "128": "/images/icon128.png"}}