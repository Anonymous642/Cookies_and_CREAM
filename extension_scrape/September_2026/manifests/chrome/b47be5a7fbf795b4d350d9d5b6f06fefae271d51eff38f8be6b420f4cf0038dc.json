{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Product Scraper", "version": "2.3.3", "description": "Capture Amazon product data (India, US, UK, Canada), export to CSV/JSON, send to your API, or unlock unlimited saves via purchase.", "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["*://*.amazon.in/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "https://www.nimmutechnologies.com/*"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Amazon Product Scraper", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.amazon.in/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*"], "js": ["storage.js", "export.js", "content.js"], "run_at": "document_idle"}], "commands": {"scrape-product": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Scrape the current product page and add it to the saved list"}, "send-to-api": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Send all saved products to the configured API, one by one"}, "remove-last-item": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Remove the most recently captured product from the saved list"}}}