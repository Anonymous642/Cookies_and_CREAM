{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shinkai Sky: weather at a glance", "version": "1.1.1", "description": "A calm weather widget for today and the next 24 hours: it reads the forecast for you, so you know when to head outside. No account.", "action": {"default_popup": "popup.html", "default_title": "Shinkai Sky", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "sw.js"}, "permissions": ["storage", "alarms", "geolocation"], "host_permissions": ["https://weather.tinytoolsstack.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://weather.tinytoolsstack.com"}}