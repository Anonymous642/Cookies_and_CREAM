{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stacks - Save Tabs, Open Later", "version": "0.2.0", "description": "Save all tabs as a collection, and reopen them later. Simple, local, and free.", "action": {"default_popup": "popup.html", "default_icon": "icons/icon128.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage"], "background": {"service_worker": "background.js"}, "commands": {"open_manager": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open the Stacks manager page"}, "save_current_window": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current window as a collection"}}}