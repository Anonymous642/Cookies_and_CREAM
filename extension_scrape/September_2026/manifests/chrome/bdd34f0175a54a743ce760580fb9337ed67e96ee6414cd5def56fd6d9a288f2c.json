{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Google Meet - File Transfer", "version": "1.0.1", "description": "This extension is to send files when in a google meet", "manifest_version": 3, "author": "shravan", "action": {"default_icon": {"16": "icons/icon-1.png"}}, "permissions": ["scripting", "activeTab", "storage", "tabs"], "host_permissions": ["https://meet.google.com/*"], "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}