{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NotebookLM YouTube Turbo", "version": "0.0.0.1", "description": "Effortlessly paste multiple YouTube URLs into NotebookLM and save time! Ideal for creators and lifelong learners!", "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://notebooklm.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/playlist*", "https://www.youtube.com/results?search_query*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://notebooklm.google.com/*"], "js": ["notebooklm.js"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}