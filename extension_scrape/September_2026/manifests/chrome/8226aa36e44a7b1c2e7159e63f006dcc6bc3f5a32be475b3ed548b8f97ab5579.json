{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Design Audit", "version": "2.5.0", "description": "Audit any website's design: tokens, colors, typography, icons, grid, spacing and WCAG accessibility. Exports HTML and SVG reports.", "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads", "sidePanel"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js"}, "action": {"default_title": "Open Design Audit"}, "side_panel": {"default_path": "src/ui/sidepanel/sidepanel.html"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content-script.js"], "run_at": "document_idle"}]}