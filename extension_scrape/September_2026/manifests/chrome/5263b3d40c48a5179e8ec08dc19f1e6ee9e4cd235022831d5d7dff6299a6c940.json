{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DilbiiTab: Smart Tab Manager", "description": "Your browser, with a memory. Save sessions, track your time, and never lose a tab again.", "version": "1.0.1", "permissions": ["tabs", "storage", "tabGroups", "alarms", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "widget.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "suspended.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+D"}, "description": "Toggle DilbiiTab"}, "command-palette": {"suggested_key": {"default": "Alt+K"}, "description": "Open command palette"}}}