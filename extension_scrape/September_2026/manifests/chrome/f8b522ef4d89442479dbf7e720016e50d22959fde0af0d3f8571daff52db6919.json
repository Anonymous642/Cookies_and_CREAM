{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Easy", "version": "1.0.0", "description": "Expand short #hashtags into full AI prompt templates anywhere on the web.", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_title": "Prompt Easy", "default_popup": "popup.html", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*", "https://x.ai/*", "https://grok.x.ai/*"], "commands": {"expand-shortcode": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Expand the last #shortcut near the cursor"}}, "background": {"service_worker": "service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*", "https://x.ai/*", "https://grok.x.ai/*"], "js": ["storage.js", "content_script.js"], "run_at": "document_idle"}], "options_page": "options.html"}