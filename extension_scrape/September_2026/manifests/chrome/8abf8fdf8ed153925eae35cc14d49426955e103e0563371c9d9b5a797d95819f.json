{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WikiClip", "version": "1.4", "description": "Clip any page, link, or selection into your WikiClip library \u2014 right-click, keyboard shortcut, or one click.", "permissions": ["activeTab", "storage", "scripting", "tabs", "identity", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "commands": {"clip-current-page": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Clip the current page to WikiClip"}}, "action": {"default_popup": "popup.html", "default_title": "WikiClip", "default_icon": {"16": "images/icon16.png", "24": "images/icon24.png", "32": "images/icon32.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["script/content.js"]}], "background": {"service_worker": "script/background.js"}}