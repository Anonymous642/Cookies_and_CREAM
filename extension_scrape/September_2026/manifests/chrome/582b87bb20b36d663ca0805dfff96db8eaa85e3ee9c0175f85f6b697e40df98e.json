{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Form Autofill Assistant", "description": "Intelligently detect and autofill forms with realistic, validation-safe data in one click.", "version": "1.0.1", "minimum_chrome_version": "114", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "Form Autofill Assistant", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "commands": {"smart-qa-fill-form": {"description": "Fill form on current page", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "smart-qa-clear-form": {"description": "Clear form on current page", "suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}