{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabbyGuard: Browser Lock Without Closing Tabs", "description": "Hide and password-lock your Chrome session without closing, moving, or recreating your tabs.", "version": "0.1.4", "short_name": "TabbyGuard", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "256": "icon/256.png"}, "minimum_chrome_version": "116", "action": {"default_title": "TabbyGuard", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "permissions": ["storage", "idle", "windows", "tabs", "sessions", "contextMenus", "tabGroups", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"}, "commands": {"tg-emergency-guard": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Emergency lock"}}, "background": {"service_worker": "background.js"}}