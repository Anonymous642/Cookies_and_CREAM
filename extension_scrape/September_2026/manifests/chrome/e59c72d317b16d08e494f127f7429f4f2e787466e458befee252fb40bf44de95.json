{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ArcCapture - Screen Recorder", "short_name": "ArcCapture", "version": "1.0.0", "minimum_chrome_version": "116", "description": "Fast, private, local-first screen recorder. Record your tab, window, or full screen with camera and audio. No forced cloud upload.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_page": "options.html", "permissions": ["storage", "unlimitedStorage", "activeTab", "offscreen", "tabCapture", "desktopCapture", "downloads", "scripting"], "host_permissions": ["https://extensionpay.com/*"], "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "externally_connectable": {"matches": ["https://extensionpay.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' blob: data:"}, "commands": {"start-recording": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Start or stop recording"}, "pause-recording": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Pause or resume recording"}, "cancel-recording": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Cancel recording"}}}