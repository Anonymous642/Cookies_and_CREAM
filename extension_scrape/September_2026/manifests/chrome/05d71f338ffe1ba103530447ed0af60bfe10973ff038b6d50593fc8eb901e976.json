{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Browse Anything: AI Browser Agent", "version": "0.3.0", "description": "An AI browser agent capable of autonomous browsing, scraping and more.", "author": "Browse Anything", "homepage_url": "https://www.browseanything.io", "minimum_chrome_version": "120", "action": {"default_title": "Browse Anything"}, "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"_execute_action": {"description": "Toggle Browse Anything side panel", "suggested_key": {"default": "Alt+B", "mac": "Alt+B"}}}, "permissions": ["sidePanel", "tabs", "tabGroups", "scripting", "storage", "debugger", "alarms", "downloads", "tabCapture", "offscreen", "activeTab"], "host_permissions": ["<all_urls>"], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "sandbox": {"pages": ["src/sandbox/runner.html"]}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://platform.browseanything.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:;", "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'none'; object-src 'none';"}}