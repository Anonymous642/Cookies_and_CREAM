{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FastLinkIt \u2014 URL Shortener & QR Generator", "short_name": "FastLinkIt", "version": "1.0.0", "description": "Shorten URLs, generate QR codes, and manage your links directly from your browser. Right-click any link or use the toolbar popup.", "homepage_url": "https://flnk.it", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "FastLinkIt"}, "options_page": "options/options.html", "background": {"service_worker": "background/service-worker.js"}, "permissions": ["storage", "contextMenus", "activeTab", "notifications", "clipboardWrite"], "host_permissions": ["https://flnk.it/*", "https://*.flnk.it/*"], "content_scripts": [{"matches": ["https://flnk.it/*", "https://*.flnk.it/*"], "js": ["background/content-script.js"], "run_at": "document_idle"}], "commands": {"shorten-current": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Shorten current page URL"}, "qr-current": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Generate QR code for current page"}}}