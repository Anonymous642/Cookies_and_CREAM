{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fly-by Comments for YouTube", "version": "1.1", "description": "Make timestamped YouTube comments come to life with fly-by effects! Experience reactions while watching your favorite videos.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js"}, "commands": {"toggle-flyby": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Toggle Flyby Comments On/Off"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["page-script.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}