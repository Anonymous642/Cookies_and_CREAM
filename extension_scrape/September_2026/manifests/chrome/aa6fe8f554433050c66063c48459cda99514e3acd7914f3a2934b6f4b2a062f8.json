{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GeoGuessr Plonk It Checker", "version": "1.12", "description": "Adds a button to check the correct country on Plonkit.net after making a guess in GeoGuessr", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab"], "host_permissions": ["https://www.geoguessr.com/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.geoguessr.com/*"]}], "content_scripts": [{"matches": ["https://www.geoguessr.com/*"], "js": ["countryMapping.js", "contentScript.js"], "run_at": "document_end"}]}