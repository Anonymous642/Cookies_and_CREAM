{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Guidyy Recorder", "description": "Record clicks, typing, and screenshots on sites you choose to auto-create step-by-step guides and interactive demos.", "version": "1.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Guidyy", "default_popup": "popup.html"}, "permissions": ["tabs", "scripting", "storage", "sidePanel", "webNavigation", "tabCapture", "offscreen"], "optional_host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://www.guidyy.com/*", "https://guidyy.com/*"]}, "web_accessible_resources": [{"resources": ["rrweb-canvas-worker.js", "fonts/*"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}}