{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Udemy Time Remaining", "version": "3.0.3", "description": "Chrome extension that modifies the Udemy course page, displaying the time remaining after each section", "author": "Diego de Blas Mateo", "action": {"default_popup": "index.html", "default_title": "Udemy Time Remaining", "default_icon": "udemy-time-remaining-logo-16x16.png"}, "icons": {"16": "udemy-time-remaining-logo-16x16.png", "48": "udemy-time-remaining-logo-48x48.png", "128": "udemy-time-remaining-logo-128x128.png"}, "permissions": ["storage"], "content_scripts": [{"world": "MAIN", "js": ["app.js"], "css": ["app.css"], "matches": ["https://www.udemy.com/course/*/learn/*"]}], "externally_connectable": {"matches": ["https://*.udemy.com/*"]}, "background": {"service_worker": "service_worker.js"}}