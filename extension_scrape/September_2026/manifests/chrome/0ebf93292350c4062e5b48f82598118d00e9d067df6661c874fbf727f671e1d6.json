{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "amem Clipper", "version": "0.3.2", "description": "Capture any page as an AI-summarised node in your local wiki. Rich extraction on Claude / ChatGPT / Gemini; article mode elsewhere.", "permissions": ["storage", "activeTab", "scripting", "sidePanel", "alarms", "tabs", "tabGroups", "tabCapture", "offscreen", "contextMenus", "downloads", "favicon"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "amem \u2014 capture this page"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"open_sidepanel": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open amem Clipper sidepanel"}}, "content_scripts": [{"matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*"], "js": ["content-scripts/arxiv-autocapture.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["offscreen.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}