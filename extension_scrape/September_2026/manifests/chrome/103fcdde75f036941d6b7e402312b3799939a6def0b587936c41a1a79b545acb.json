{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SmartFind", "version": "1.0.0", "description": "Find anything on a page - handles typos, different spellings & more. Your searches stay private on your computer.", "minimum_chrome_version": "88", "permissions": ["activeTab", "storage", "scripting", "contextMenus"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "service-worker-loader.js"}, "action": {"default_title": "SmartFind - Click to search"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle SmartFind panel"}, "next-result": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Jump to next search result"}, "previous-result": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Jump to previous search result"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["welcome.html", "options.html", "options.js"], "use_dynamic_url": false}], "options_page": "options.html"}