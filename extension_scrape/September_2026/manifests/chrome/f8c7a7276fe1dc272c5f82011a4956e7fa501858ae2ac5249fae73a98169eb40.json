{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FileConcat Clipper: threads, chats and transcripts to Markdown", "description": "Save ChatGPT, Claude and Gemini chats, Reddit threads, YouTube transcripts and any article as Markdown for your LLM.", "version": "0.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "sidePanel"], "host_permissions": ["<all_urls>"], "action": {"default_title": "FileConcat Clipper"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://news.ycombinator.com/*", "http://localhost/*", "https://fileconcat.com/*"], "run_at": "document_idle", "js": ["content-scripts/article.js"]}, {"matches": ["*://chatgpt.com/*"], "run_at": "document_idle", "js": ["content-scripts/chatgpt.js"]}, {"matches": ["*://claude.ai/*"], "run_at": "document_idle", "js": ["content-scripts/claude.js"]}, {"matches": ["http://localhost/*", "https://fileconcat.com/*"], "run_at": "document_idle", "js": ["content-scripts/fileconcat.js"]}, {"matches": ["*://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gemini.js"]}, {"matches": ["*://news.ycombinator.com/*"], "run_at": "document_idle", "js": ["content-scripts/hn.js"]}, {"matches": ["*://*.reddit.com/*"], "run_at": "document_idle", "js": ["content-scripts/reddit.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}