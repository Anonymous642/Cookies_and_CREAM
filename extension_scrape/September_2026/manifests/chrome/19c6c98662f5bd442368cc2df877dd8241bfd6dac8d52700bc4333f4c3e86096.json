{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floatlane \u2014 Picture-in-Picture", "short_name": "Floatlane", "version": "0.11.2", "description": "Keep videos floating while you browse. Works with major streaming sites and most HTML5 video players.", "minimum_chrome_version": "134", "permissions": ["storage", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Floatlane", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["assets/icon-32.png"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"float-current-video": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Float the current video"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}