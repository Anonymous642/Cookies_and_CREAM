{"update_url": "https://clients2.google.com/service/update2/crx", "name": "QuickSwitch", "version": "3.2", "description": "Speed dial for chrome", "manifest_version": 3, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["./build/content-script/script.js"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "commands": {"toggle-app": {"suggested_key": {"default": "Alt+J", "windows": "Alt+J", "linux": "Alt+J", "mac": "Alt+J"}, "description": "Toggle 'Quick switch' window"}, "cycle-same-domain-tabs": {"suggested_key": {"default": "Alt+Shift+K", "windows": "Alt+Shift+K", "linux": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Cycle between same domain tabs"}, "cycle-favorite-tabs": {"suggested_key": {"default": "Alt+K", "windows": "Alt+K", "linux": "Alt+K", "mac": "Alt+K"}, "description": "Cycle between favorite tabs"}, "sort-tabs": {"suggested_key": {"default": "Alt+Shift+J", "windows": "Alt+Shift+J", "linux": "Alt+Shift+J", "mac": "Alt+Shift+J"}, "description": "Sort tabs alphabetically by url"}}, "chrome_url_overrides": {"newtab": "build/new-tab/index.new-tab.html"}}