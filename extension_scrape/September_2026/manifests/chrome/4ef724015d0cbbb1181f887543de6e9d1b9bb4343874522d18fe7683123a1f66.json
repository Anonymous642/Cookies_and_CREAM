{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Kindle 2 Notion", "description": "Chrome Extension that exports your Kindle highlights into Notion.", "version": "1.0.0", "manifest_version": 3, "icons": {"16": "k2n16.png", "48": "k2n48.png", "128": "k2n128.png"}, "action": {"default_popup": "popup.html", "default_title": "React Extension", "default_icon": "k2n128.png"}, "permissions": ["storage", "cookies", "tabs", "activeTab"], "options_page": "options.html", "background": {"service_worker": "background.js"}, "host_permissions": ["https://*.notion.so/*", "https://read.amazon.com/*", "https://kindle2notion.bitemuse.dev/api/*"], "content_scripts": [{"matches": ["https://read.amazon.com/notebook*"], "js": ["contentScript.js"]}]}