{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkSight \u2014 Markdown Viewer & Editor", "version": "2.3.0", "description": "Renders .md files with formatting, live editor, syntax highlighting, TOC, dark mode, and export to PDF/Word/HTML.", "permissions": ["activeTab", "storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["file:///*/*.md", "file:///*/*.markdown", "file:///*/*.mdown", "file:///*/*.mkd"], "js": ["lib/marked.min.js", "lib/purify.min.js", "lib/highlight.min.js", "lib/html2pdf.bundle.min.js", "content.js"], "css": ["styles.css", "lib/highlight-github.min.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "commands": {"toggle-edit": {"suggested_key": {"default": "Ctrl+E", "mac": "Command+E"}, "description": "Toggle edit mode"}, "save-file": {"suggested_key": {"default": "Ctrl+S", "mac": "Command+S"}, "description": "Save current file"}, "export-menu": {"suggested_key": {"default": "Ctrl+P", "mac": "Command+P"}, "description": "Open export menu"}}, "web_accessible_resources": [{"resources": ["lib/*", "*.css", "demo.html", "demo-page.js"], "matches": ["<all_urls>"]}]}