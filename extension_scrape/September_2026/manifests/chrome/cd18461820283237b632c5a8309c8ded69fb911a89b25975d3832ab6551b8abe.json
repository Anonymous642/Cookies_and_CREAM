{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptDeck \u2014 Prompts for ChatGPT, Claude, Gemini, Grok & DeepSeek", "version": "1.1.0", "description": "One prompt library across ChatGPT, Claude, Gemini, Grok and DeepSeek. Slash-insert, variables, local-first. No account, no ads.", "permissions": ["storage", "contextMenus"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "PromptDeck", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://chat.deepseek.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the PromptDeck palette"}}}