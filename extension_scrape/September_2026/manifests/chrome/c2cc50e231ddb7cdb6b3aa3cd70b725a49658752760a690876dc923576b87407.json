{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Broken Link Scanner", "version": "3.2.5", "description": "Checks links on the active page and records details about the ones returning 404, 410, or 5xx status codes.", "permissions": ["scripting", "storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Broken Link Scanner", "default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["*://*.google.com/url*"], "js": ["google_redirect_bypass.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://*.google.com/*", "*://*.bing.com/*", "*://*.chatgpt.com/*", "*://*.perplexity.io/*", "*://*.claude.ai/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}