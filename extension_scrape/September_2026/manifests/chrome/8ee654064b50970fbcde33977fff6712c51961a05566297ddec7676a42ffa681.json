{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Translator Plus", "version": "2.2.2", "description": "Translate selected text and OCR from images and PDFs", "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>", "file://*/*"], "js": ["pdfjs/web/pdf-lib.min.js", "sentry.min.js", "content.js", "navbar.js"], "css": ["styles.css"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "action": {"default_popup": "settings.html"}, "options_page": "settings.html", "background": {"service_worker": "background.js"}, "commands": {"trigger-ocr": {"suggested_key": {"default": "Alt+C"}, "description": "Trigger OCR and text translation"}}, "web_accessible_resources": [{"resources": ["pdfjs/*", "styles.css"], "matches": ["<all_urls>"]}]}