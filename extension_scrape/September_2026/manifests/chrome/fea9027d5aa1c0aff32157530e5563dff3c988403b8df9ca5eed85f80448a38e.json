{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dust2 Market Plugin", "short_name": "Dust2", "version": "1.0.3", "description": "A simple chrome extension to aid trading on Dust2 Market, powered by TradeOS, for game items like Counter Strike 2 skins", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.steamcommunity.com/*", "*://*.steampowered.com/*", "https://dust2.fun/*", "https://*.tradeos.xyz/*"], "externally_connectable": {"matches": ["*://*.steamcommunity.com/*", "https://dust2.fun/*", "https://*.tradeos.xyz/*"]}, "web_accessible_resources": [{"resources": ["src/version.txt"], "matches": ["https://dust2.fun/*", "https://*.tradeos.xyz/*"]}], "declarative_net_request": {"rule_resources": [{"id": "steamcommunity_ruleset", "enabled": true, "path": "src/steamcommunity_ruleset.json"}]}}