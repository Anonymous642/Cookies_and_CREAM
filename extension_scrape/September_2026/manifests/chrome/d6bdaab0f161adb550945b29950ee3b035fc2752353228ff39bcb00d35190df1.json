{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X Traduz", "version": "1.0.0", "description": "Traduz automaticamente posts do X (Twitter) para portugu\u00eas brasileiro. Interface simples, cache inteligente e suporte a doa\u00e7\u00f5es PIX.", "author": "Alonso Freitas Leite", "homepage_url": "https://github.com/alonsofreitasleite/x-tradutor-automatico", "short_name": "X Traduz", "permissions": ["activeTab", "storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://translate.googleapis.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "X Traduz", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "minimum_chrome_version": "88", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}