{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Layout Buddy \u2013 CSS Inspector & Screen Ruler", "version": "0.1.0", "description": "Inspect CSS, measure spacing, test responsive layouts, and annotate screenshots\u2014right on any webpage.", "permissions": ["activeTab", "scripting", "debugger", "sidePanel", "storage", "clipboardWrite"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Toggle Layout Buddy", "default_icon": {"16": "icons/inactive-icon.png", "24": "icons/inactive-icon.png", "32": "icons/inactive-icon.png", "48": "icons/inactive-icon.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/inactive-icon.png", "24": "icons/inactive-icon.png", "32": "icons/inactive-icon.png", "48": "icons/inactive-icon.png", "128": "icons/inactive-icon.png"}, "web_accessible_resources": [{"resources": ["icons/cursor.svg", "icons/devices.svg", "icons/comment.svg", "icons/x-ray.svg", "icons/screenshot.svg", "icons/screenshot-selected.svg", "icons/screenshot-visible.svg", "icons/screenshot-undo.svg", "icons/screenshot-arrow.svg", "icons/screenshot-square.svg", "icons/screenshot-text.svg", "icons/screenshot-close.svg", "icons/screenshot-command.svg", "icons/screenshot-shift.svg", "icons/minus.svg", "icons/plus.svg", "icons/close.svg"], "matches": ["<all_urls>"]}], "commands": {"toggle-inspector": {"suggested_key": {"default": "Alt+Shift+I", "mac": "Command+Shift+I"}, "description": "Toggle Layout Buddy on the current page"}, "screenshot-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the visible part of the current page"}, "screenshot-selected": {"suggested_key": {"default": "Ctrl+S", "mac": "Command+S"}, "description": "Capture a selected area of the current page"}}}