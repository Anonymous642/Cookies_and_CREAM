{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scam Shield", "version": "1.0.1", "description": "Warns when a page shows patterns common in romance, crypto, and investment scams.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "src/background.js"}, "action": {"default_title": "Scam Shield", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/risk-engine.js", "src/content.js"], "run_at": "document_idle"}]}