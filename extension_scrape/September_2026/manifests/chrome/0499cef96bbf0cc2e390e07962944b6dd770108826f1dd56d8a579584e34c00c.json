{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gaveki Focus Shield", "version": "1.2.5", "description": "Blocks distracting websites during Gaveki focus sessions. Works with the Gaveki ADHD focus app at gaveki.com/app.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png", "default_title": "Gaveki Focus Shield"}, "background": {"service_worker": "background.js"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage"], "host_permissions": ["https://gaveki.com/*", "https://www.gaveki.com/*"], "content_scripts": [{"matches": ["https://gaveki.com/app", "https://gaveki.com/app/", "https://gaveki.com/app/*", "https://www.gaveki.com/app", "https://www.gaveki.com/app/", "https://www.gaveki.com/app/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}