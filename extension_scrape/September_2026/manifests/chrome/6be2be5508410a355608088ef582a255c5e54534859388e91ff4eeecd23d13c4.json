{"update_url": "https://clients2.google.com/service/update2/crx", "name": "URSS Feeds Discovery", "version": "1.1", "description": "Discovers RSS feeds advertised on webpages and allow to open them directly. Requires the app \"URSS Feeds Reader\" to be installed.", "author": "Jereck.NET Consulting", "homepage_url": "https://www.jereck.net/Consulting/Projects/URSS-Feeds-Reader/", "manifest_version": 3, "icons": {"16": "img/icon_16.png", "32": "img/icon_32.png", "48": "img/icon_48.png", "128": "img/icon_128.png"}, "action": {"default_icon": {"16": "img/no_feeds_16.png", "24": "img/no_feeds_24.png", "32": "img/no_feeds_32.png"}, "default_title": "No RSS feeds found on this page"}, "permissions": ["storage", "alarms", "idle"], "host_permissions": ["http://localhost/urss/*"], "background": {"service_worker": "js/service_worker.js"}, "content_scripts": [{"js": ["js/discovery.js", "js/document_end.js"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_end"}]}