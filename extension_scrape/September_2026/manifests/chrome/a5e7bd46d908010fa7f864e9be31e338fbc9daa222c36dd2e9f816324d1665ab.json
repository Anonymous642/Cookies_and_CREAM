{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chat GPS: chat outline for navigating Chat GPT", "description": "Adds a minimap and chat ouline to Chatgpt. Helps users navigate through long chats. Bookmark your favourite chats.", "version": "3.0.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage"], "commands": {"toggle-ui": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle UI state"}, "next-chat": {"suggested_key": {"default": "Alt+Down", "mac": "Alt+Down"}, "description": "Navigate to next chat"}, "previous-chat": {"suggested_key": {"default": "Alt+Up", "mac": "Alt+Up"}, "description": "Navigate to previous chat"}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Chat GPS", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "exclude_matches": ["https://chatgpt.com/codex/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}]}