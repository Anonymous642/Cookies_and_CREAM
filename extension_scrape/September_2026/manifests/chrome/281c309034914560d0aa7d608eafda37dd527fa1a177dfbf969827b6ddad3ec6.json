{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Social Cross-Poster", "version": "1.5.0", "description": "Write once, cross-post to Facebook, X, LinkedIn, Bluesky and UpScrolled from tabs you're logged into. No APIs, no passwords.", "action": {"default_title": "Social Cross-Poster - open composer"}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://*.facebook.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.linkedin.com/*", "https://bsky.app/*", "https://upscrolled.com/*", "https://api.freemius.com/*"], "optional_host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.mistral.ai/*", "https://openrouter.ai/*", "https://api.openai.com/*"], "content_scripts": [{"matches": ["https://*.facebook.com/*"], "js": ["content/debug-banner.js", "content/facebook.js"], "run_at": "document_idle"}, {"matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"], "js": ["content/debug-banner.js", "content/x.js"], "run_at": "document_idle"}, {"matches": ["https://*.linkedin.com/*"], "js": ["content/debug-banner.js", "content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://bsky.app/*"], "js": ["content/debug-banner.js", "content/bluesky.js"], "run_at": "document_idle"}, {"matches": ["https://upscrolled.com/*"], "js": ["content/debug-banner.js", "content/upscrolled.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}