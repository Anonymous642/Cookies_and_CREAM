{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn URL Extractor", "description": "Collect visible LinkedIn people-search profile URLs into a deduped CSV dataset with optional pagination.", "version": "1.0.0", "permissions": ["downloads", "scripting", "storage", "tabs"], "host_permissions": ["https://www.linkedin.com/search/results/people/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_title": "LinkedIn URL Extractor", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/search/results/people/*"], "js": ["content.js"], "run_at": "document_idle"}]}