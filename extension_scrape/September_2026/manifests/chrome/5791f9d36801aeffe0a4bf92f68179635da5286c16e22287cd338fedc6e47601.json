{"manifest_version": 3, "name": "HubCar Turo Sync", "description": "Assisted Turo reservation receipt sync for HubCar.", "version": "0.6.29", "minimum_chrome_version": "120", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "HubCar Turo Sync", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "side_panel": {"default_path": "src/popup.html"}, "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://turo.com/us/en/trips/*", "https://www.turo.com/us/en/trips/*", "https://turo.com/us/en/reservation/*", "https://www.turo.com/us/en/reservation/*", "https://turo.com/us/en/vehicles/listings*", "https://www.turo.com/us/en/vehicles/listings*"], "js": ["src/content-turo.js"], "run_at": "document_idle"}], "host_permissions": ["https://turo.com/*", "https://www.turo.com/*", "https://api.hubcar.rent/*"], "permissions": ["activeTab", "alarms", "scripting", "sidePanel", "storage", "tabs", "webNavigation"], "update_url": "https://clients2.google.com/service/update2/crx"}