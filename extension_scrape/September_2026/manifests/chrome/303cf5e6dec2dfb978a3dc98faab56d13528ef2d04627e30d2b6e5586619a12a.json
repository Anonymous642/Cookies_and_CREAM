{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Silence Is Golden", "version": "0.1.0", "description": "Mute streaming ads with a silvery-gold quote overlay. Configurable sites and shortcut.", "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://www.netflix.com/*", "https://netflix.com/*", "https://*.youtube.com/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "icons": {"16": "dist/assets/icon-16.png", "48": "dist/assets/icon-48.png", "128": "dist/assets/icon-128.png"}, "action": {"default_title": "Silence Is Golden", "default_popup": "dist/popup/popup.html", "default_icon": {"16": "dist/assets/icon-16.png", "48": "dist/assets/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.netflix.com/*", "https://netflix.com/*", "https://*.youtube.com/*"], "js": ["dist/contentEntry.js"], "run_at": "document_idle"}]}