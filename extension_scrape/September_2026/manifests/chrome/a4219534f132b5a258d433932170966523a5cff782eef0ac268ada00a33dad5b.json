{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Visual Diff Checker for GitHub & Bitbucket", "short_name": "Diff Checker", "version": "0.1.0", "description": "Enhanced visual diff viewer for GitHub & Bitbucket PRs. Compare images, code & files side-by-side with advanced tools.", "author": "Visual-diff", "homepage_url": "https://visual-diff.com", "permissions": ["activeTab", "storage"], "background": {"service_worker": "src/background.js", "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html"}, "host_permissions": ["https://github.com/*", "https://*.githubusercontent.com/*", "https://media.githubusercontent.com/*", "https://viewscreen.githubusercontent.com/*", "https://bitbucket.org/*"], "content_scripts": [{"matches": ["*://github.com/*/*/pull/*", "*://bitbucket.org/*/*/pull-requests/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["*://viewscreen.githubusercontent.com/diff/img*"], "js": ["src/iframe-content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["assets/*", "src/diff.worker.js", "src/iframe-content.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}