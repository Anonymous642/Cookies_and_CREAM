{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinterest Native Scheduler - Niche Traffic Kit", "version": "1.0.3", "description": "This extension helps you schedule your pins on Pinterest with their native scheduler and view your scheduled pins in a calendar view", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://localhost:5006/*", "https://api.nichetraffickit.com/*"], "action": {"default_popup": "popup.html", "default_title": "Nichetraffickit - Pinterest Native Schedule"}, "content_scripts": [{"matches": ["*://*.pinterest.com/*/scheduled-pins/"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}, {"matches": ["*://*.pinterest.com/pin-builder/*"], "js": ["pin-builder-content.js"], "run_at": "document_end"}, {"matches": ["*://*.pinterest.com/pin-creation-tool*"], "js": ["pin-creation-tool.js"], "run_at": "document_end"}, {"matches": ["*://*.pinterest.com/*"], "js": ["schedule-icon.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}