{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kosher Video Slideshow - YouTube & Drive", "version": "4.4", "description": "Plays audio normally while showing video as slideshow, distraction-free viewing on YouTube and Google Drive.", "author": "Aron Dirnfeld <dirnfeldaron@gmail.com>", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["*://www.youtube.com/*", "https://drive.google.com/*", "https://*.youtube.googleapis.com/*", "https://*.googlevideo.com/*", "https://*.google.com/*", "https://*.supabase.co/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["youtube-content.js"], "run_at": "document_end"}, {"matches": ["https://drive.google.com/*"], "js": ["drive-content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Video Slideshow Mode"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://drive.google.com/*", "https://*.youtube.googleapis.com/*", "https://*.googlevideo.com/*", "https://*.google.com/*"]}]}