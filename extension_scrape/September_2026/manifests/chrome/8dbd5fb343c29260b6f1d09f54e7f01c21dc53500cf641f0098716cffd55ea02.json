{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YTMark - YouTube Bookmarks & Clips", "description": "Bookmark moments and clip the best parts of YouTube videos. Trim, loop and share clips, and jump back anytime.", "version": "0.3.4", "short_name": "YTMark", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://ytmark.com/*", "https://www.ytmark.com/*"], "action": {"default_title": "YTMark"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.ytmark.com/*", "https://ytmark.com/*"], "run_at": "document_start", "js": ["content-scripts/web.js"]}, {"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/youtube.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/youtube.css"], "use_dynamic_url": true, "matches": ["https://www.youtube.com/*"]}]}