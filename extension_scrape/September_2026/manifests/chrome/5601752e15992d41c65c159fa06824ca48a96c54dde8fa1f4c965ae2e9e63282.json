{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StayAwake", "short_name": "StayAwake", "version": "1.2.0", "description": "Prevent your system from sleeping. One click or set a countdown timer \u2014 30 min to 8 hours. Tracks total uptime.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["power", "storage", "alarms", "offscreen"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "StayAwake", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}