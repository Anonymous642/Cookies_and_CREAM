{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinterest Fullscreen", "version": "1.0", "description": "Transform Pinterest into a fullscreen, distraction-free viewing experience", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "Pinterest Fullscreen", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}