{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoleReady Job Capture & Autofill", "description": "Save job postings to RoleReady and review autofill suggestions on application forms.", "version": "1.0.0", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["activeTab", "storage", "scripting", "tabs", "downloads"], "host_permissions": ["https://app.roleready.me/*"], "action": {"default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "RoleReady"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+Shift+J", "mac": "Alt+Shift+J"}, "description": "Toggle RoleReady job capture overlay"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}]}