{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Autoclicker", "version": "1.0.1", "homepage_url": "https://autoclickr.com/", "description": "Autoclicker for Chrome helps you automate clicks on your Chrome browser.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Autoclicker"}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage"], "commands": {"toggle-clicking": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C", "windows": "Alt+Shift+C", "linux": "Alt+Shift+C", "chromeos": "Alt+Shift+C"}, "description": "Start / stop clicking on the current tab"}}}