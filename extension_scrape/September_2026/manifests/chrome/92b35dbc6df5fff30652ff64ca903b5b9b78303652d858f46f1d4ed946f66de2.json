{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IndiePump Creator Finder", "version": "0.6.0", "description": "Save the creators you find while researching, on your own device. Connect IndiePump to write each one a message about your game.", "permissions": ["contextMenus", "scripting", "activeTab", "storage"], "optional_host_permissions": ["https://indiepump.space/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "IndiePump Creator Finder", "default_icon": {"16": "icons/ip-16.png", "32": "icons/ip-32.png", "48": "icons/ip-48.png", "128": "icons/ip-128.png"}}, "icons": {"16": "icons/ip-16.png", "32": "icons/ip-32.png", "48": "icons/ip-48.png", "128": "icons/ip-128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}