{"name": "FindsMate - OOPBuy Spreadsheet and Pop-up Remover", "version": "1.0.4", "manifest_version": 3, "description": "Oopbuy shopping copilot: blocks risk popups, converts agent links, and unlocks QC galleries.", "update_url": "https://clients2.google.com/service/update2/crx", "icons": {"48": "assets/icon48.png", "128": "assets/icon48.png"}, "action": {"default_title": "FindsMate", "default_popup": "src/index.html"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://oopbuy.com/*", "*://*.oopbuy.com/*", "*://m.oopbuy.com/*", "*://webapi.oopbuy.com/*"], "js": ["src/content.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset1", "enabled": true, "path": "config/ruleset.json"}]}, "permissions": ["declarativeNetRequest"], "host_permissions": ["https://oopbuy-api.vercel.app/*", "*://oopbuy.com/*", "*://*.oopbuy.com/*", "*://m.oopbuy.com/*", "*://webapi.oopbuy.com/*"]}