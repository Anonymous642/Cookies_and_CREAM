{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Markdown clipboard", "version": "1.0", "manifest_version": 3, "description": "Convert selected text to markdown format, copy to clipboard, and download the converted markdown text", "action": {"default_icon": "/images/clipboard.png", "default_popup": "/popup/popup.html", "default_locale": "zh_TW"}, "permissions": ["clipboardWrite", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"16": "/images/clipboard-16.png", "32": "/images/clipboard-32.png", "48": "/images/clipboard-48.png", "128": "/images/clipboard-128.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["/images/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}