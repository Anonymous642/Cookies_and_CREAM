{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Pauser", "version": "1.0.0", "description": "Single click the icon to play/pause the leftmost YouTube tab, double click to skip. The icon shows elapsed time and video length.", "author": "Matthew Zirbel", "permissions": ["storage", "tabs"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["scripts/content.js"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"toggle_playing": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Play/pause the first YouTube video"}, "skip": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Skip to the next YouTube video"}}, "background": {"service_worker": "scripts/background.js"}, "action": {"default_icon": {"16": "images/icon.png", "32": "images/icon.png"}}, "icons": {"16": "images/icon.png", "48": "images/Extension_Icon.png", "128": "images/Extension_Icon.png"}}