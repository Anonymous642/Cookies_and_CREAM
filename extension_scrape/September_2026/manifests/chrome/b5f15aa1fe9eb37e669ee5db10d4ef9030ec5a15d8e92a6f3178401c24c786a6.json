{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prompt Saver", "version": "1.1.0", "description": "Save and manage prompts from AI platforms", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://chatgpt.com/*", "*://gemini.google.com/*", "*://claude.ai/*"], "action": {"default_popup": "src/popup/index.html"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://gemini.google.com/*", "*://claude.ai/*"], "js": ["assets/content.js"]}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}