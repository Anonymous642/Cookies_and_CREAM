{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenShot & Screen Recorder", "version": "1.0.2", "description": "Capture visible area, full-page scrolling screenshots, crop selected areas, and record screen/tab video with audio.", "permissions": ["activeTab", "scripting", "downloads", "tabs", "storage", "desktopCapture", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ScreenShot & Screen Recorder"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content-script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open ScreenSnap Popup"}, "capture_area": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S", "windows": "Alt+Shift+S"}, "description": "Capture Selected Area (Snipping Tool)"}, "capture_visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture Visible Viewport"}, "capture_fullpage": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Capture Full Page Scrolling"}}, "web_accessible_resources": [{"resources": ["admin/*", "utils/*", "editor/*", "icons/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["*://localhost/*", "*://127.0.0.1/*", "https://*/*"]}}