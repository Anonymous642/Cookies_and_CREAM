{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cliipyy \u2014 Screen Recorder & Instant Share Link", "description": "Record your screen, a tab or your webcam, then share a link instantly. The upload runs while you record \u2014 no waiting on stop.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://cliipyy.com/*", "https://*.cliipyy.com/*"], "action": {"default_title": "Cliipyy", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "commands": {"toggle-pause": {"suggested_key": {"default": "Alt+P"}, "description": "Pause / resume recording"}, "stop-recording": {"suggested_key": {"default": "Alt+S"}, "description": "Stop recording"}, "toggle-bubble": {"suggested_key": {"default": "Alt+B"}, "description": "Hide / show the webcam bubble"}, "show-controls": {"suggested_key": {"default": "Alt+C"}, "description": "Show the recording controls"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}