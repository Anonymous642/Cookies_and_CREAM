{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Typing Simulator", "version": "1.0", "description": "Simulates human typing from clipboard content", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["clipboardRead", "activeTab", "storage", "scripting"], "host_permissions": ["https://etnalabs.ch/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"simulate-typing": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Start typing from clipboard"}}}