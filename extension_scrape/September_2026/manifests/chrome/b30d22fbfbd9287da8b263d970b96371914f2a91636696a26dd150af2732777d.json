{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Serene", "version": "1.0.1", "description": "A calm, minimal new tab page. Large clock, date, and one question: what's your focus today?", "permissions": ["storage", "alarms"], "host_permissions": ["https://api.open-meteo.com/*", "https://extensionpay.com/*"], "background": {"service_worker": "background/service-worker.js"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "options_page": "options/options.html", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://extensionpay.com"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}