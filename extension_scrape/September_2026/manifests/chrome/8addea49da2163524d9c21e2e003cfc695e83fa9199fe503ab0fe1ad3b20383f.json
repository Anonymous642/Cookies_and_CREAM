{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Textquill \u2014 Image to Text OCR & Grammar Check", "version": "2.2.0", "minimum_chrome_version": "109", "description": "Extract text from images & screenshots, then fix grammar and translate \u2014 all on-device. Private OCR + offline grammar check.", "author": "shahithakurisundar@gmail.com", "homepage_url": "https://textquill.app", "icons": {"16": "public/icons/icon-16.png", "32": "public/icons/icon-32.png", "48": "public/icons/icon-48.png", "128": "public/icons/icon-128.png"}, "action": {"default_title": "Textquill \u2014 OCR & Grammar Check", "default_popup": "src/popup/popup.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage", "offscreen", "tts"], "host_permissions": ["<all_urls>"], "commands": {"area-select": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Select an area to OCR"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["tesseract/*", "tesseract/lang/*", "paddle/*", "ort/*", "pdf/*", "bergamot/*", "bergamot/worker/*", "harper/*", "src/offscreen/offscreen.html"], "use_dynamic_url": false}]}