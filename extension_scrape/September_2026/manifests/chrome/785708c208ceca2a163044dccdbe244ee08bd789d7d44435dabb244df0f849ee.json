{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LitFlo", "version": "1.0.0", "description": "Save papers from PubMed, ArXiv, Semantic Scholar and more directly to your LitFlo account to improve your personalised digest.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://litflo.ai/*"], "action": {"default_popup": "popup.html", "default_title": "LitFlo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://pubmed.ncbi.nlm.nih.gov/*", "https://pmc.ncbi.nlm.nih.gov/articles/*", "https://arxiv.org/abs/*", "https://arxiv.org/pdf/*", "https://www.semanticscholar.org/paper/*", "https://www.biorxiv.org/content/*", "https://www.medrxiv.org/content/*", "https://*.nature.com/articles/*", "https://*.springer.com/article/*", "https://www.sciencedirect.com/science/article/*", "https://www.frontiersin.org/articles/*", "https://pubs.acs.org/doi/*", "https://pubs.rsc.org/en/content/articlelanding/*", "https://onlinelibrary.wiley.com/doi/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}