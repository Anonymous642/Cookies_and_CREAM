{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Todo Boom", "version": "0.2.1", "description": "Gmail task capture with side panel: tasks, speed dial, memory, cheat sheets, and local backup. Alpha.", "permissions": ["storage", "sidePanel", "activeTab", "tabs"], "host_permissions": ["https://mail.google.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/index.html"}, "action": {"default_title": "Open Todo Boom", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Open Todo Boom side panel"}, "add-gmail-task": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Add current Gmail email as task"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}