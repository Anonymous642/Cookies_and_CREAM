{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Domain Insights for Search", "version": "1.0.0", "description": "Show domain age (years/months/days) and highlight chosen domain extensions directly in Google, Bing and DuckDuckGo search results.", "permissions": ["storage"], "host_permissions": ["https://www.google.com/*", "https://www.bing.com/*", "https://duckduckgo.com/*", "https://rdap.org/*", "https://*.rdap.org/*", "https://rdap.verisign.com/*", "https://rdap.nominet.uk/*"], "action": {"default_popup": "popup.html", "default_title": "Domain Insights for Search", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.bing.com/search*", "https://duckduckgo.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}