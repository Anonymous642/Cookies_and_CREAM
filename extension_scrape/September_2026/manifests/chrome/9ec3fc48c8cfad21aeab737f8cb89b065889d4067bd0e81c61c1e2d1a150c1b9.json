{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AMZ Product Analyzer", "short_name": "APA", "version": "2.0.1", "description": "Amazon product research sheet for sellers & dropshippers. Scrape prices, BSR, sales data, ratings and export to CSV instantly.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "html/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AMZ Product Analyzer"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://www.amazon.com/*"], "background": {"service_worker": "js/background.js"}, "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["content/amazon.js"], "run_at": "document_idle"}]}