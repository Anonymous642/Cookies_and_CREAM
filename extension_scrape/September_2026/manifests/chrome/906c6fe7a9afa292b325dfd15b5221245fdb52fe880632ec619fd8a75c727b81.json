{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Any2Ebook: Web to Ebook Collector (EPUB/Kindle)", "description": "Convert tabs, bookmarks, and URLs into EPUB ebooks with one click. Works with the Any2Ebook desktop app.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Any2Ebook: Web to Ebook Collector (EPUB/Kindle)"}, "side_panel": {"default_path": "sidepanel.html"}, "permissions": ["tabs", "activeTab", "scripting", "storage", "sidePanel", "bookmarks"], "host_permissions": ["http://localhost:8080/*", "<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}