{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AirWave - Floating Radio Player", "description": "Floating radio with draggable glass UI, search, favorites, and filters.", "version": "1.1.2", "minimum_chrome_version": "109", "permissions": ["activeTab", "declarativeNetRequest", "offscreen", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*", "https://*.api.radio-browser.info/*", "https://*.googleusercontent.com/*", "https://docs.google.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Toggle AirWave Radio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-player": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Toggle AirWave radio"}, "toggle-play-pause": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Play/Pause current station"}}, "web_accessible_resources": [{"resources": ["Injector.js", "Offscreen/offscreen.html", "Offscreen/Offscreen.js", "src/*", "src/Vendor/*", "icons/*"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "rules_1", "enabled": true, "path": "Rules/Rules_1.json"}]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; media-src * data: blob:;"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}