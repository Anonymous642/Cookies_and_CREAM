{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZalipOff: Website Blocker & Focus Coach - Stop Doomscrolling", "version": "0.28.0", "description": "A focus-first browser companion that blocks distracting URLs during focus sessions.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["scripting", "storage", "idle", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http: https:;"}, "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/focus-blocker.js"], "all_frames": false, "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["assets/focus-nudge.js"], "all_frames": false, "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/*/*.avif", "images/*/icon-16.png", "images/*/icon-16-inactive.png", "images/*/icon-32.png", "images/*/icon-32-inactive.png", "images/speech-bubble-fill.svg", "images/speech-bubble.svg"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_title": "ZalipOff: focus mode off", "default_popup": "popup.html", "default_icon": {"16": "images/action/coach-toolbar-16-inactive.png", "20": "images/action/coach-toolbar-20-inactive.png", "24": "images/action/coach-toolbar-24-inactive.png", "32": "images/action/coach-toolbar-32-inactive.png"}}}