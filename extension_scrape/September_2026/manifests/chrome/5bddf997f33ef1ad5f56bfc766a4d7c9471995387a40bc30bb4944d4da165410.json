{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Media Downloader for X (Twitter)", "description": "One click, no Ads, no watermarks. Download videos and images from X (Twitter) with ease.", "short_name": "Media Downloader", "homepage_url": "https://x-downloader.com/", "version": "1.0.0", "author": "extension@x-downloader.com", "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://x-downloader.com/*"], "js": ["content-script.js"], "css": ["css/content-script.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_title": "X Downloader", "default_icon": "images/logo/icon-128.png", "default_popup": "popup.html"}, "icons": {"16": "images/logo/icon-16.png", "32": "images/logo/icon-32.png", "48": "images/logo/icon-48.png", "128": "images/logo/icon-128.png"}, "permissions": ["cookies", "downloads", "storage"], "host_permissions": ["https://*.twitter.com/*", "https://*.x.com/*", "https://*.x-downloader.com/*"]}