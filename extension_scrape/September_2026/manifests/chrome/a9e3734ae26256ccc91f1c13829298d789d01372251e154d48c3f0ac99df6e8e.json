{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Basecamp Sprint Board", "version": "1.0.3", "description": "Sprint board for Basecamp: merge projects by name, track Current vs Spill Over, filter by assignee, view your tasks.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://3.basecamp.com/*", "https://app.basecamp.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://3.basecamp.com/*", "https://app.basecamp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Open Sprint Board (Ctrl+Shift+B)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-board": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "MacCtrl+Shift+B"}, "description": "Open or close the Sprint Board"}}}