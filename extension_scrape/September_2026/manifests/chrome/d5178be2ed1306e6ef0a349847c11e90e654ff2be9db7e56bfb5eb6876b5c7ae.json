{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Survey Auto-Chooser", "version": "1.0.2", "description": "Auto-selects Neutral/middle options on surveys. Privacy-focused, runs only on enabled domains.", "action": {"default_title": "Survey Auto-Chooser", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://docs.google.com/forms/*", "https://forms.office.com/*", "https://*.typeform.com/*", "https://*.qualtrics.com/*", "https://*.surveymonkey.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/forms/*", "https://forms.office.com/*", "https://*.typeform.com/*", "https://*.qualtrics.com/*", "https://*.surveymonkey.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"run_survey": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Run auto-chooser on current page"}, "undo_changes": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Undo last changes"}, "fill_na_only": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Fill N/A only"}}}