{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PasteAnywhere", "version": "1.1", "description": "Save text snippets and paste them anywhere with a right-click - no focus loss, instant productivity.", "author": "Habibur Rahman", "permissions": ["storage", "contextMenus", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/new-icon.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/new-icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}