{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MindCanvas Web Clipper", "version": "1.0.3", "description": "Save web content directly to your MindCanvas workspace with a right-click", "permissions": ["contextMenus", "activeTab", "storage", "notifications", "scripting", "tabs"], "host_permissions": ["*://mindcanvas.app/*", "https://mindcanvas.app/*"], "background": {"service_worker": "background/background.js"}, "content_scripts": [{"matches": ["*://mindcanvas.app/*", "*://app.mindcanvas.app/*"], "js": ["content/content.js"], "css": ["content/content.css"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_popup": "popup/popup.html", "default_title": "MindCanvas Web Clipper", "default_icon": {"16": "assets/mindcanvas-icon-16.png", "48": "assets/mindcanvas-icon-48.png", "128": "assets/mindcanvas-icon-128.png"}}, "icons": {"16": "assets/mindcanvas-icon-16.png", "48": "assets/mindcanvas-icon-48.png", "128": "assets/mindcanvas-icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://mindcanvas.app/*", "*://app.mindcanvas.app/*"]}], "homepage_url": "https://mindcanvas.app"}