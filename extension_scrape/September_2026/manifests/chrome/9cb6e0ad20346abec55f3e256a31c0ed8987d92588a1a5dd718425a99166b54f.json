{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "iCloud Find My GPS Logger", "version": "1.0", "description": "Logs device movements from iCloud Find My and exports to GPX files", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["https://www.icloud.com/*", "https://*.icloud.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.icloud.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://www.icloud.com/*"]}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}