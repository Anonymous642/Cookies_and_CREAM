{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fresh Start \u2014 Instagram Bulk Block", "version": "1.2.0", "description": "Scrape an Instagram profile's followers/following and bulk block them with human-like delays. Use at your own risk.", "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies", "sidePanel"], "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*", "https://api.gumroad.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Fresh Start", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}