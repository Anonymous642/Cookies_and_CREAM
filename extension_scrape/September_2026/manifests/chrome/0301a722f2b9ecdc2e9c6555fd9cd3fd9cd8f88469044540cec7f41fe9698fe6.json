{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FormKeeper", "version": "1.0.0", "description": "Auto-saves what you type into web forms and lets you recover it. 100% local \u2014 nothing ever leaves your device.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "FormKeeper \u2014 saved form data", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}], "commands": {"save-now": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "FormKeeper: Save the current form now"}, "restore-last": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "FormKeeper: Restore the last saved data on this page"}, "open-dashboard": {"description": "FormKeeper: Open the dashboard"}}}