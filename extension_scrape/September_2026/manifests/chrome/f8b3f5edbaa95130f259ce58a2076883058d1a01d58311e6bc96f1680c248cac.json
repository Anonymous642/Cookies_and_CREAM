{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContactOut Collector", "version": "2.3", "description": "Collect and export contact info from ContactOut. Simple or Advanced mode for recruitment-ready CSV exports.", "permissions": ["activeTab", "storage", "downloads"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["https://contactout.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}