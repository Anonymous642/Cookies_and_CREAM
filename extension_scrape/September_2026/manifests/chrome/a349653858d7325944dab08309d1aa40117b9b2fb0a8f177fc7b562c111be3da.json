{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkBurst - Open All The Links!", "version": "1.2.0", "description": "Bulk open links on a page. Drag to select, filter using regex or css, open in the background, de-dupe, and more.", "permissions": ["scripting", "activeTab", "tabs", "storage"], "action": {"default_title": "LinkBurst - Open All The Links!", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js"}, "commands": {"drag-select": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Drag-select links on the current page"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}