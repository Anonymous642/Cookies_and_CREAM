{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AINS Book Log Assistant", "version": "0.1.0", "description": "Auto-fills AInS NILAM book records from a title/author. Review each field before pushing \u2014 it never submits for you.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "AINS Book Log Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/index.html"}, "options_page": "options/index.html", "background": {"service_worker": "background/service-worker.js"}, "permissions": ["storage", "sidePanel", "activeTab"], "host_permissions": ["https://ains.moe.gov.my/*", "https://www.googleapis.com/*", "https://openlibrary.org/*", "https://generativelanguage.googleapis.com/*"], "content_scripts": [{"matches": ["https://ains.moe.gov.my/record/add/book*"], "js": ["content/content-script.js"], "run_at": "document_idle"}]}