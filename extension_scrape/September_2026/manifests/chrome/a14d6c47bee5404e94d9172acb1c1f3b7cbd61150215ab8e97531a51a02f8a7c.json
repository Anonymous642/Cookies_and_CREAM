{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BlurPane", "description": "Blur, pixelate, or black out anything before screen sharing. Save per-site rules, profiles, export redacted PNGs. 100% local.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "sidePanel", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_title": "BlurPane"}, "commands": {"toggle-panic": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Panic \u2014 instantly blur the whole page"}, "clear-all": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Clear all blurs on the page"}}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}