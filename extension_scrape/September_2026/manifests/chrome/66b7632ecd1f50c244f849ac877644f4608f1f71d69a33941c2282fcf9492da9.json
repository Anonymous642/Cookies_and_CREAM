{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Limewyre Extension", "version": "1.0.3", "description": "Your Smart Memory Companion", "action": {"default_title": "Open Limewyre", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["*://*.amazonaws.com/*", "https://api.limewyre.com/*", "https://ipapi.co/*", "https://app.limewyre.com/*"], "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open Limewyre Side Panel"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}