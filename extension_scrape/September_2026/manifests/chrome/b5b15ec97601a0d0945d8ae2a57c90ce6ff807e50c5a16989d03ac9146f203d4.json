{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DanPicBook Listening Lab", "version": "0.9.15", "description": "Reads the Danish subtitles already on YouTube, DR TV, Netflix and Disney+ and shows them word by word with a translation.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "DanPicBook Listening Lab \u2014 click to start subtitles", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://relay.danpicbook.com/*"], "background": {"service_worker": "bg.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://*.dr.dk/*", "https://dr.dk/*", "https://*.netflix.com/*", "https://*.disneyplus.com/*"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["yt-intercept.js"], "run_at": "document_start", "world": "MAIN"}]}