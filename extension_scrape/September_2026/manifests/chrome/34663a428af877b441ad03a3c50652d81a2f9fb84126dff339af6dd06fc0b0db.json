{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DesignAlign", "version": "1.0.1", "description": "A tool to help with positioning on webpages using image overlays and customizable grids", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_title": "Click to toggle DesignAlign", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["http://*/*", "https://*/*", "file://*/*"]}]}