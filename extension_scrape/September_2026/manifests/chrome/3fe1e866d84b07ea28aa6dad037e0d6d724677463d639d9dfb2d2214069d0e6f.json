{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WP Detector", "version": "2.1.3", "description": "A powerful browser extension to detect WordPress themes, plugins, page builders, and server information from any website.", "permissions": ["activeTab", "scripting", "storage", "tabs", "favicon"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "WP Detector"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "run_at": "document_end"}]}