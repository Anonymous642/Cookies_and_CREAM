{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Facebook Group & Page Post Scraper \u2013 Export to JSON/CSV", "version": "1.0.0", "description": "Scrape posts from any Facebook group or Page. Export comments, reactions, images, links to JSON or CSV. 100% local & private.", "permissions": ["activeTab", "storage", "scripting", "alarms", "unlimitedStorage", "downloads"], "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://m.facebook.com/*", "https://live.dodopayments.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://m.facebook.com/*"], "js": ["quota.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}