{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scroll shot", "description": "Advanced full-page screenshot capture extension with intelligent content detection and privacy-first design", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "downloads", "storage", "offscreen", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture full page screenshot"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area screenshot"}, "open-popup": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open screenshot popup"}}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}