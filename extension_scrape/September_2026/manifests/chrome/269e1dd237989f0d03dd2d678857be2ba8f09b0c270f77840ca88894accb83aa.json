{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CloudSurf: Browser Agent", "short_name": "CloudSurf", "version": "1.0.1", "description": "Helps you find the needle in a haystack -- for example, you can use it to search for the best product out of 50+ options.", "action": {"default_icon": {"16": "images/cloudsurf2_16.png", "32": "images/cloudsurf2_32.png", "48": "images/cloudsurf2_48.png", "128": "images/cloudsurf2_128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScripts/forceCurrentTab.js"]}], "permissions": ["activeTab", "scripting", "storage", "tabs", "debugger", "sidePanel"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "sidepanel.html", "default_icon": {"16": "images/cloudsurf2_16.png", "32": "images/cloudsurf2_32.png"}}, "web_accessible_resources": [{"resources": ["styles/base.css", "styles/auth.css"], "matches": ["<all_urls>"]}]}