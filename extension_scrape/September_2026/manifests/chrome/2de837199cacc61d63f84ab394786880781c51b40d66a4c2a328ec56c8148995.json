{"update_url": "https://clients2.google.com/service/update2/crx", "name": "FullScreenie: Screenshot & Annotate", "version": "2.3.2", "description": "Capture full-page or visible-area screenshots, annotate, and copy or save.", "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "commands": {"capture-opposite": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Capture opposite mode (full page / visible area)"}, "capture-custom-area": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Capture custom area"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Capture screenshot"}}, "manifest_version": 3, "permissions": ["storage", "contextMenus", "downloads", "notifications", "scripting", "activeTab", "unlimitedStorage"], "host_permissions": ["https://share.fullscreenie.com/*"], "action": {"default_icon": {"128": "icons/icon-128.png"}, "default_title": "Capture Screenshot"}, "background": {"service_worker": "src/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "web_accessible_resources": [{"resources": ["ui/fonts/*.woff2"], "matches": ["<all_urls>"]}]}