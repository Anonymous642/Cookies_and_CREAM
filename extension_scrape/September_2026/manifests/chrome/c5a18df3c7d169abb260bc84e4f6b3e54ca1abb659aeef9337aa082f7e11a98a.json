{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Music Dislike (One-Click + Hotkey)", "version": "1.10.2", "description": "Like (O), dislike (E), or play/pause (P) YouTube Music with shortcuts or menu.", "permissions": ["tabs", "scripting", "contextMenus"], "host_permissions": ["*://music.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "YouTube Music controls", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"like-song": {"suggested_key": {"default": "Ctrl+Shift+O"}, "description": "Like current song"}, "dislike-song": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Dislike current song"}, "toggle-playback": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Play/Pause current song"}}}