{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "arXiv Companion: HTML & alphaXiv", "short_name": "arXiv Companion", "version": "1.11.1", "description": "Switch arXiv to alphaXiv, ar5iv HTML or Semantic Scholar. Clean tab titles, rename PDFs, copy BibTeX. No account.", "permissions": ["activeTab", "storage", "declarativeNetRequestWithHostAccess", "scripting", "downloads", "notifications"], "host_permissions": ["https://arxiv.org/*", "https://www.arxiv.org/*", "https://alphaxiv.org/*", "https://www.alphaxiv.org/*", "https://api.alphaxiv.org/*", "https://api.semanticscholar.org/*", "https://www.google-analytics.com/*"], "action": {"default_title": "Switch to alphaXiv/arXiv (Alt+Shift+X)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://arxiv.org/pdf/*", "*://www.arxiv.org/pdf/*"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"switch-paper": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Switch the current paper between arXiv and the selected destination"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}