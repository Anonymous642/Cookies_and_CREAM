{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NetSuite - Record Tagger", "version": "2.6.4", "description": "Show configurable tags on NetSuite records (fields, styles, icons, conditions). Form/JSON setup, local save, import/export.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "NetSuite Record Tagger"}, "content_scripts": [{"matches": ["https://*.netsuite.com/*", "https://*.app.netsuite.com/*", "http://*.netsuite.com/*", "http://*.app.netsuite.com/*"], "js": ["config.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "host_permissions": ["https://*.netsuite.com/*", "https://*.app.netsuite.com/*", "https://cdn.jsdelivr.net/*"], "permissions": ["storage"]}