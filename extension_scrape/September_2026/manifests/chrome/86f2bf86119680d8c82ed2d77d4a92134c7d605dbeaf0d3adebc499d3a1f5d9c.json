{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess.com Focus Mode", "version": "1.0.0", "description": "Strips away everything on Chess.com except the board, clocks, and controls. Press N for a distraction-free, fullscreen game.", "permissions": ["scripting", "activeTab"], "host_permissions": ["*://*.chess.com/*"], "action": {"default_title": "Toggle Focus Mode (Alt+F)"}, "commands": {"toggle-focus": {"suggested_key": {"default": "Alt+F", "mac": "Alt+F"}, "description": "Toggle Chess.com Focus Mode"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.chess.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}