{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumi", "description": "Visual Prompt Builder - What You See is What You Prompt", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "scripting"], "action": {"default_title": "Open Lumi"}, "commands": {"toggle-lumi": {"suggested_key": {"default": "Alt+L", "mac": "Alt+L"}, "description": "Toggle Lumi sidebar"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}