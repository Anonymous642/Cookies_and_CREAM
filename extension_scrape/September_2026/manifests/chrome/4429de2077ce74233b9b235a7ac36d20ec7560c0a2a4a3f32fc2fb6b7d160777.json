{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EcomSapio", "description": "Right-click selected text, images, links, or pages and save them to the correct Google Sheet tab using AI.", "version": "1.0.4", "minimum_chrome_version": "116", "homepage_url": "https://www.ecomsapio.com", "permissions": ["contextMenus", "storage", "activeTab", "tabs", "notifications", "alarms", "scripting", "identity", "sidePanel"], "optional_permissions": ["bookmarks"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://www.ecomsapio.com/*", "https://ecomsapio.com/*"], "background": {"service_worker": "background.js"}, "commands": {"quick-save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to your brain"}, "quick-save-selection": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Save the selected text to your brain"}}, "action": {"default_title": "EcomSapio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}