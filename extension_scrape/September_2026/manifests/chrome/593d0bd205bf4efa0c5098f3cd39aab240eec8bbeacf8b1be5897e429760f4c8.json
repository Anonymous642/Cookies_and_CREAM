{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TimeForge - Auto Time Tracker + Invoices", "short_name": "TimeForge", "version": "1.0.4", "description": "Auto-track billable time, review local sessions, and create PDF invoices. Free for 2 clients; Lifetime unlocks more.", "homepage_url": "https://www.uncommonweather.com/products/timeforge.html", "minimum_chrome_version": "114", "incognito": "split", "author": "Uncommon Weather LLC", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "action": {"default_popup": "popup.html", "default_title": "TimeForge", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "alarms", "idle"], "host_permissions": ["https://api.gumroad.com/*"], "commands": {"toggle-tracking": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Toggle tracking for the current site (if it matches a configured client)"}}, "externally_connectable": {"matches": ["https://www.uncommonweather.com/legal/consent-bridge.html"], "accepts_tls_channel_id": false}}