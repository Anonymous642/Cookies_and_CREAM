{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Cutter Workspace", "version": "0.1.1", "description": "Cut YouTube clips from transcripts with all external YouTube requests routed through the background worker.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.comprehensiveinput.com/*", "https://www.api.comprehensiveinput.com/*", "https://comprehensiveinput.com/*", "https://www.comprehensiveinput.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://*.youtube.com/*"], "action": {"default_title": "YouTube Cutter"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}