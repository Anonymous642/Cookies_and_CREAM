{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LocalDictate \u2014 Private Offline Voice Typing", "short_name": "LocalDictate", "version": "1.0.4", "description": "Voice typing that never leaves your device. Whisper runs in your browser \u2014 press a hotkey, speak, and text lands in any field.", "author": "LocalDictate contributors", "homepage_url": "https://github.com/wushu75/LocalDictate", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "LocalDictate \u2014 start dictating", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_page": "src/options/options.html", "permissions": ["storage", "offscreen", "activeTab", "clipboardWrite"], "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*", "https://*.huggingface.co/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}], "commands": {"toggle-dictation": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Start or stop dictation"}, "cancel-dictation": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Cancel dictation and discard the current utterance"}}, "web_accessible_resources": [{"resources": ["icons/*.png", "icons/*.svg", "src/content/content.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://huggingface.co https://*.hf.co https://*.huggingface.co"}}