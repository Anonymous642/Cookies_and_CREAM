{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Superpowers for Discord", "version": "1.0.0", "description": "Search any Discord conversation, hide the sidebars and headers, blur private chats, and insert saved text with a short trigger.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_title": "Superpowers for Discord", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://discord.com/channels/*"], "js": ["assets/content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "settings/index.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://discord.com/channels/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "save-hovered-message": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the Discord message under the cursor"}, "open-dashboard": {"description": "Open the Superpowers dashboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}}