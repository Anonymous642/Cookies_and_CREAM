{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess Bot Coach", "version": "0.6.1", "description": "Local chess learning coach for supported study modes on Chess.com.", "minimum_chrome_version": "114", "permissions": ["sidePanel", "tabs", "scripting"], "host_permissions": ["https://chess.com/*", "https://www.chess.com/*", "https://*.chess.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Chess Bot Coach | for Chess.com"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://chess.com/*", "https://www.chess.com/*", "https://*.chess.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}