{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapGleam - Screenshot & Full Page Capture", "short_name": "SnapGleam", "version": "1.10.4", "description": "Capture an area, element, scrollable content, full page, or visible screen locally in your browser.", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "downloads", "offscreen", "clipboardWrite", "contextMenus"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "SnapGleam", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "options_page": "src/options/options.html", "commands": {"capture-area": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+A"}, "description": "Capture an area"}, "capture-element": {"suggested_key": {"default": "Alt+Shift+E", "mac": "MacCtrl+Shift+E"}, "description": "Capture an element"}, "capture-full-page": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Capture the full page"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Capture the visible screen"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"}, "host_permissions": ["file:///*"]}