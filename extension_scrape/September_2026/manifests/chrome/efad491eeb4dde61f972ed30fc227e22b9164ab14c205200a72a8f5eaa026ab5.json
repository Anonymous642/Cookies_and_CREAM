{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SideChat - Chatrooms for ChatGPT", "version": "2.0.1", "description": "Real-time chat with others currently using ChatGPT. Ephemeral rooms based on your current chat topics and context.", "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["src/content.js"], "css": ["src/ui/panel.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["src/ui/panel.html", "assets/*"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}]}