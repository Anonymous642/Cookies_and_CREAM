{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Link-eriser", "version": "1.0", "description": "Randomly plays a zedla-esque audio file when any link is clicked on a page, or when a tab is closed.", "icons": {"16": "icons/icon-256.png", "24": "icons/icon-256.png", "48": "icons/icon-256.png", "64": "icons/icon-256.png", "128": "icons/icon-256.png", "256": "icons/icon-256.png"}, "permissions": ["storage", "activeTab", "offscreen"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Link-eriser Settings", "default_icon": {"16": "icons/icon-256.png", "24": "icons/icon-256.png", "48": "icons/icon-256.png", "64": "icons/icon-256.png", "128": "icons/icon-256.png", "256": "icons/icon-256.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["audio/*.wav"], "matches": ["<all_urls>"]}]}