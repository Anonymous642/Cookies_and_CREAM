{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tool Hut", "short_name": "Tool Hut", "version": "1.0.1", "description": "Every project's tools, one click away. Save any dashboard to Tool Hut and open your projects' dashboards from the toolbar.", "homepage_url": "https://toolhut.app", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Tool Hut", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "storage", "favicon"], "content_scripts": [{"matches": ["https://toolhut.app/*"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Tool Hut"}}}