{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sonora \u2014 Browser Media Cockpit", "version": "0.1.0", "description": "Control every audible browser tab \u2014 YouTube, podcasts, web radio \u2014 from one focused cockpit.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_title": "Sonora media cockpit", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "permissions": ["tabs", "storage", "scripting", "commands", "alarms"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/media-controller.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "commands": {"toggle-playback": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle play/pause on the active Sonora source"}, "switch-source": {"suggested_key": {"default": "Alt+S"}, "description": "Switch Sonora to the next audible tab"}}}