{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Draw On Any Web Page ", "version": "1.0", "manifest_version": 3, "description": "Use this extension to draw on any webpage like freehand, rectangle, circle, undo, print, line, and clear options", "action": {"default-icon": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}}, "icons": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}, "permissions": ["storage", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}