{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IssueDrop \u2014 Create Jira issues from any page", "version": "1.0.0", "description": "The fast Issue Collector alternative: turn any web page into a Jira issue with its URL, selected text and a screenshot.", "author": "Taffara", "homepage_url": "https://taffara.framer.website", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Create a Jira issue from this page"}, "options_page": "options.html", "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://*.atlassian.net/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+J"}, "description": "Open IssueDrop popup"}}}