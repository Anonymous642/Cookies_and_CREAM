{"name": "iSmart Profile Scanner", "description": "This extension will scan content from web profile page also assign job from extension.", "version": "3.3.21", "update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://stackoverflow.com/*", "http://localhost:8080/RecWeb/*", "https://www.xing.com/*"], "run_at": "document_end", "css": ["sweetalert.css", "selectize.default.css", "font-awesome.css"], "js": ["jquery-1.10.2.min.js", "aes-3.1.1.js", "content_script.js"]}], "browser_action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "icons": {"32": "icon.png", "38": "icon.png", "48": "icon.png"}, "permissions": ["tabs", "storage", "activeTab", "runtime", "offscreen", "scripting", "action"], "host_permissions": ["*://*.linkedin.com/*", "*://*.monster.com/*", "*://*.naukri.com/*", "*://*.timesjobs.com/*", "*://*.dice.com/*", "*://*.careerbuilder.com/*", "*://*.xing.com/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["jquery-1.10.2.min.js", "sweetalert.min.js", "selectize.default.css", "selectize.min.js", "fonts/FontAwesome.otf", "fonts/fontawesome-webfont.eot", "fonts/fontawesome-webfont.svg", "fonts/fontawesome-webfont.ttf", "fonts/fontawesome-webfont.woff", "fonts/fontawesome-webfont.woff2", "cs.js", "sweetalert.css"], "matches": ["https://*/*"]}], "action": {"default_popup": "popup.html"}}