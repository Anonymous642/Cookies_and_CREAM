{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ListForge Marketplace Companion", "short_name": "ListForge", "version": "1.1.22", "description": "Publish ListForge listings to Facebook Marketplace and Poshmark, with optional marketplace research as you browse.", "permissions": ["storage", "tabs", "cookies", "scripting", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://*.ebay.com/*", "https://*.amazon.com/*", "https://*.mercari.com/*", "https://*.facebook.com/*", "https://*.poshmark.com/*", "https://listforge-production-uploads.s3.us-east-1.amazonaws.com/*", "https://api.list-forge.ai/*"], "externally_connectable": {"matches": ["https://app.list-forge.ai/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://*.ebay.com/itm/*", "https://*.ebay.com/sch/*", "https://*.ebay.com/b/*", "https://*.amazon.com/*/dp/*", "https://*.amazon.com/dp/*", "https://*.amazon.com/s/*", "https://*.mercari.com/item/*", "https://*.mercari.com/search/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/create-listing*", "https://www.poshmark.com/create-listing*"], "js": ["poshmark-publisher.js"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/listing/*", "https://www.poshmark.com/listing/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://poshmark.com/edit-listing/*", "https://www.poshmark.com/edit-listing/*"], "js": ["poshmark-takedown.js"], "run_at": "document_idle"}, {"matches": ["https://app.list-forge.ai/*"], "js": ["app-bridge.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}