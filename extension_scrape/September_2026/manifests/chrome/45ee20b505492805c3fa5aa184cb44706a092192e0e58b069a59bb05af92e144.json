{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MarkIt - Read It Later & AI Bookmark Manager", "version": "1.1.0", "description": "Save any page, post or image to read it later. AI sorts your library so you can find it again by just asking.", "homepage_url": "https://mark-it.co", "permissions": ["activeTab", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://mark-it.co/*", "https://www.mark-it.co/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-url": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Save current page to MarkIt"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}