{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VidMate - Free Video Downloader", "version": "2.0.0", "description": "Download videos from any website for free. Detects videos on any webpage and adds a one-click download button.", "permissions": ["downloads", "downloads.open", "storage", "sidePanel", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": [{"resources": ["popup.html"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+D", "windows": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open VidMate Downloader"}, "open-downloader": {"suggested_key": {"default": "Ctrl+Shift+D", "windows": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open downloader and start download"}}}