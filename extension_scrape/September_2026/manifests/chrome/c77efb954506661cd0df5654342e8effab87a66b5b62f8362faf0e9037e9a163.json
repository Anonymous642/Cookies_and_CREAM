{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Thumb Remix", "version": "1.0.0", "description": "Generate professional AI prompts for YouTube thumbnails. seamless workflow for creating concepts from video context & references.", "permissions": ["storage", "sidePanel", "activeTab", "scripting"], "host_permissions": ["https://youtube.com/*", "https://*.youtube.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://grok.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://youtube.com/*", "https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "AI Thumb Remix", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "ui/sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles/globals.css", "styles/content.css"], "matches": ["https://youtube.com/*", "https://*.youtube.com/*"]}]}