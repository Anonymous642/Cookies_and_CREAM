{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tweet Wipe", "short_name": "TweetWipe", "description": "Mass delete your own posts on X (Twitter) with filters and dry-run support.", "version": "1.4.21", "minimum_chrome_version": "114", "permissions": ["storage", "tabs", "scripting", "power"], "host_permissions": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Tweet Wipe", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}