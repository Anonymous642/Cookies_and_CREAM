{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChromeShift - Multi-Monitor Chrome Window Splitter", "version": "1.0.0", "description": "Split Chrome windows across multiple monitors with precision", "permissions": ["system.display", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "commands": {"split-left": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Snap window to left half"}, "split-right": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Snap window to right half"}, "split-top": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Snap window to top half"}, "split-bottom": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Snap window to bottom half"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}