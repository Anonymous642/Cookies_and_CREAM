{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "eBay Item Specifics Extractor", "version": "1.0", "description": "Extract item specifics from eBay listings", "permissions": ["storage", "scripting", "activeTab", "tabs", "contextMenus", "commands"], "host_permissions": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://*.linnworks.net/*"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://*.linnworks.net/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"extract-specifics": {"suggested_key": {"default": "Ctrl+D"}, "description": "Extract specifics from eBay"}, "paste-specifics": {"suggested_key": {"default": "Ctrl+F"}, "description": "Paste specifics to Linnworks"}}}