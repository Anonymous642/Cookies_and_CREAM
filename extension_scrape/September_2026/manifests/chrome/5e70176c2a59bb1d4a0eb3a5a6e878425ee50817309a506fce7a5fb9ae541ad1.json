{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AO3 Find That Bookmark! (Deleted Works)", "version": "1.4.0", "description": "Tracks AO3 bookmarks locally and shows which bookmarked works have been deleted in a private, separate view.", "permissions": ["alarms", "notifications"], "host_permissions": ["*://archiveofourown.org/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "AO3 Lost and Found", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://archiveofourown.org/users/*"], "js": ["modules/constants.js", "modules/bookmark-parser.js", "modules/injection-manager.js", "bookmarks-injector.js"], "run_at": "document_idle"}]}