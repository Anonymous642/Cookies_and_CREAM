{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddit Growth Assistant", "short_name": "RGA", "version": "0.1.2", "description": "Scores Reddit posts, drafts compliant reply suggestions, and tracks manual community interactions.", "action": {"default_popup": "src/popup/index.html", "default_title": "Reddit Growth Assistant"}, "options_page": "src/options/index.html", "background": {"service_worker": "assets/background.js", "type": "module"}, "permissions": ["storage"], "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["assets/content.js"], "css": ["assets/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}