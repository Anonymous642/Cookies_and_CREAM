{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "UglyTube", "version": "1.4.7", "description": "Makes YouTube ugly on purpose: greyscale thumbnails, no brand red, a watch-time counter, and switches to strip Shorts and feeds.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "UglyTube", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/looks.js", "src/timer.js", "src/content.js"], "css": ["src/ugly.css"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["src/quality.js"], "world": "MAIN", "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "homepage_url": "https://tutorialtube.online"}