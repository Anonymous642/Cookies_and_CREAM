{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Engaged Views for YouTube", "version": "1.0.5", "description": "Adds a lightweight engaged-view estimate beside public YouTube view counts.", "permissions": ["storage"], "action": {"default_title": "Engaged views", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://youtube.com/*", "https://*.youtube.com/*"], "exclude_matches": ["https://music.youtube.com/*", "https://studio.youtube.com/*"], "css": ["styles.css"], "js": ["estimator.js", "content.js"], "run_at": "document_idle"}]}