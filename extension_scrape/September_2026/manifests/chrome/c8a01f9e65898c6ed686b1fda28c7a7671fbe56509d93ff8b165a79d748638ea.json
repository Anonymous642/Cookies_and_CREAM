{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pause Looper for Language Reactor", "version": "1.0.0", "description": "When turned on, automatically presses 'S' every time you pause the video on YouTube or Netflix.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Pause Looper"}, "commands": {"toggle-pause-looper": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Turn Pause Looper on/off"}}}