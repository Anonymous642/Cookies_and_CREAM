{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goto - URL Shortcuts", "version": "1.0.0", "description": "Create custom URL shortcuts for quick navigation. Type g/example in your browser to redirect to the URL.", "author": "Prasanjit Singh", "homepage_url": "https://goto.app", "permissions": ["declarativeNetRequest", "activeTab"], "host_permissions": ["http://g/*", "https://g/*", "http://go/*", "https://go/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Create Goto Shortcut"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}