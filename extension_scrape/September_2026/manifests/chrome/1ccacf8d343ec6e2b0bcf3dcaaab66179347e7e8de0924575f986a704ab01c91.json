{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QAKit", "version": "1.0.6", "description": "QAKit \u00e2\u20ac\u201d All-in-one toolkit for QA engineers & developers: inspect, capture, audit, mock requests, manage cookies & storage.", "author": "Prem Nepak", "homepage_url": "https://github.com/premnepak/qakit", "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies", "debugger", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "windows", "contextMenus"], "optional_permissions": ["downloads"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["inspector.js", "console-shim.js", "analytics-interceptor.js", "spell-bundle.js", "pagescripts.js", "env-marker.js", "json-diff-tool.html", "json-diff-tool.js", "text-compare.html", "text-compare.js", "privacy-policy.html", "help.html", "changelog.html", "markup.html", "markup.js", "markup.css"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"toggle-inspector": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Toggle Element Inspector"}, "toggle-spacing": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Spacing Inspector"}, "capture-region": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Capture region screenshot"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page screenshot"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}