{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatExpand", "version": "1.1.0", "description": "Expand AI. Not the interface. Customize text size and content width on ChatGPT, Claude, Gemini, Perplexity, and Grok.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://*.chatgpt.com/*", "https://*.chat.openai.com/*", "https://*.claude.ai/*", "https://*.gemini.google.com/*", "https://*.perplexity.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.chatgpt.com/*", "https://*.chat.openai.com/*", "https://*.claude.ai/*", "https://*.gemini.google.com/*", "https://*.perplexity.ai/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"increase_text_size": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase text size of AI responses"}, "decrease_text_size": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease text size of AI responses"}, "increase_width": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Increase content width"}, "decrease_width": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Decrease content width"}}}