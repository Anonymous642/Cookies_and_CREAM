{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Recorder Pro", "version": "3.0.0", "description": "Record your screen with drawing tools, webcam overlay, and audio mixing", "permissions": ["activeTab", "scripting", "storage", "tabs", "desktopCapture"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"service_worker": "background/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/backgrounds/*.jpg", "assets/tfjs/selfie_landscape/*"], "matches": ["<all_urls>"]}]}