{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Ad Blocker for JioHotstar By Folner", "version": "1.1.0", "description": "Blocks known JioHotstar ad requests, hides sponsored banners, and shows what it blocked today.", "manifest_version": 3, "minimum_chrome_version": "111", "background": {"service_worker": "background/background.js"}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://*.hotstar.com/*"], "declarative_net_request": {"rule_resources": [{"id": "hotstar_ads", "enabled": true, "path": "rules/hotstar-ads.json"}]}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}, "default_popup": "popup/popup.html", "default_title": "Blocking on JioHotstar is on for all tabs"}, "content_scripts": [{"matches": ["*://*.hotstar.com/*"], "js": ["content/hotstar.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.hotstar.com/*"], "js": ["content/ad-request-monitor.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}]}