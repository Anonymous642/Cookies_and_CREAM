{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Frame Grabber: Video Screenshot", "short_name": "Frame Grabber", "version": "1.2.0", "description": "Screenshot the exact frame of any video with one keypress. PNG, JPG or WebP, named from title, timestamp and resolution.", "author": "Rahul Gautam", "minimum_chrome_version": "116", "permissions": ["storage", "downloads", "scripting", "activeTab", "clipboardWrite", "offscreen"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Frame Grabber \u2014 capture video frame", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["shared.js", "lib/metadata.js", "content/capture.js"], "css": ["content/overlay.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"capture-frame": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture the current video frame"}, "capture-frame-copy": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture frame to clipboard only"}}}