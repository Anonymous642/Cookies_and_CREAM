{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PaperLens", "version": "1.6.0", "description": "Highlight anything in a research paper: in-context AI explanations, related papers, structure maps, and cross-paper Q&A.", "homepage_url": "https://github.com/Arnavtaduvayi/paper-lens", "permissions": ["storage", "contextMenus"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.semanticscholar.org/*", "http://127.0.0.1/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "background": {"service_worker": "background/index.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/*.js"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_title": "PaperLens \u2014 toggle sidebar", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle the PaperLens sidebar"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}