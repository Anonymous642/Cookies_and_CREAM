{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HelpDesk AI - Support Reply Generator", "version": "1.0.1", "description": "Write perfect customer support replies instantly. Works with Zendesk, Freshdesk, Intercom, and Help Scout.", "homepage_url": "https://startvest.ai/tools/helpdesk-ai", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["*://*.zendesk.com/*", "*://*.freshdesk.com/*", "*://*.intercom.io/*", "*://*.helpscout.net/*", "*://*.helpscout.com/*", "https://app-tsv-02.azurewebsites.net/*", "https://api.startvest.ai/*"], "externally_connectable": {"matches": ["https://startvest.ai/*", "https://www.startvest.ai/*"]}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://*.zendesk.com/*", "*://*.freshdesk.com/*", "*://*.intercom.io/*", "*://*.helpscout.net/*", "*://*.helpscout.com/*"], "js": ["content-script.js"], "css": ["content-style.css"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "HelpDesk AI"}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Open HelpDesk AI"}, "generate-reply": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate reply for current ticket"}}}