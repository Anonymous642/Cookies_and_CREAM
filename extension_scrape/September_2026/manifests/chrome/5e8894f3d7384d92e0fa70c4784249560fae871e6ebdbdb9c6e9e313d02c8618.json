{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Navi Lyrics: Synced Lyrics for YouTube Music", "version": "1.6.4", "description": "Floating synced lyrics for YouTube Music, Spotify & Apple Music. Live translation, 7 themes, click-to-seek & offline cache.", "default_locale": "en", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://music.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*", "https://lrclib.net/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "dist/background.bundle.js"}, "action": {"default_title": "View Lyrics", "default_popup": "popup.html", "default_icon": "icons/icon32.png"}, "content_scripts": [{"matches": ["https://music.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*"], "js": ["dist/content.bundle.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles.css", "pip.html", "styles.crt-amber.css", "pip.crt-amber.html", "styles.y2k.css", "pip.y2k.html", "styles.eink.css", "pip.eink.html", "styles.ascii.css", "pip.ascii.html", "styles.arcade.css", "pip.arcade.html", "fonts/*"], "matches": ["https://music.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open floating lyrics"}}}