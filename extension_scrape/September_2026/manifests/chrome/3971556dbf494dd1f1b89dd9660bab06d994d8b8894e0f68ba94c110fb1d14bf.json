{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GiffPop \u2014 GIF Keyboard for the Web", "description": "Drop GIFs into any comment section \u2014 real GIFs where supported, text-art version where they're not. One shortcut.", "version": "0.1.19", "permissions": ["storage", "clipboardWrite", "clipboardRead", "alarms"], "host_permissions": ["https://giffpop.com/*", "https://*.linkedin.com/*", "https://static.klipy.com/*", "https://i.klipy.com/*", "https://media*.klipy.com/*", "https://media*.giphy.com/*", "https://i.giphy.com/*"], "background": {"service_worker": "src/background.js"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_title": "GiffPop", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "web_accessible_resources": [{"resources": ["assets/icon16.png", "assets/icon32.png", "assets/icon48.png", "assets/icon128.png"], "matches": ["<all_urls>"]}], "options_page": "src/options.html", "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["src/linkedin-trusted-types.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"open-gif-anywhere": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open GIF search near the focused text input"}}}