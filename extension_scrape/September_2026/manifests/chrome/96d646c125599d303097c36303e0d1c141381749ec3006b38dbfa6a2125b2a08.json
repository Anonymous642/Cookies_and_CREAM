{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextRouter Lite", "version": "1.0.1", "description": "Capture, edit, organize, and send text to supported AI chats from a Chrome side panel.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus", "scripting", "sidePanel", "activeTab"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://youtube.com/watch*", "https://*.youtube.com/watch*"], "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Open TextRouter Lite", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"paste-current-hotkey": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Paste current TextRouter Lite tab into the active page"}, "send-current-to-ai-hotkey": {"description": "Send the current TextRouter Lite tab to the active supported AI chat"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://youtube.com/watch*", "https://*.youtube.com/watch*"], "js": ["injectors/injector-dom-utils.js", "injectors/inject-chatgpt.js", "injectors/inject-claude.js", "injectors/inject-gemini.js", "injectors/inject-perplexity.js", "content-injection.js", "content.js"], "css": ["overlay.css"], "run_at": "document_idle"}]}