{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabulink", "description": "Copy (subset) of open tabs to your clipboard in a hyperlink format.", "author": "Alexis Carras <alexisjcarras@gmail.com>", "version": "0.4.0", "homepage_url": "https://github.com/aicarras/tab-to-link", "action": {"default_popup": "./popup/index.html", "default_icon": "./images/tabulink_logo_3.png"}, "permissions": ["tabs", "clipboardWrite"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}