{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Whole Page Screenshot - Full Page Screen Capture", "version": "1.0.1", "description": "Full-page screenshots in one click. Scrolling capture, annotations, blur, crop, and export to PNG, JPG & PDF.", "permissions": ["activeTab", "storage", "unlimitedStorage", "tabs", "downloads", "contextMenus", "scripting"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible tab"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}, "capture-save": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture & Save to Downloads"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}