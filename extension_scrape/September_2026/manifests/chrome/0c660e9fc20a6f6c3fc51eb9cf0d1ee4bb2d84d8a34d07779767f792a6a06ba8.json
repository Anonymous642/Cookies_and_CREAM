{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sound Controller for Chrome", "version": "1.3.1", "description": "Boost any tab's volume past 100%, enhance dialogue/bass, or turn one down from a cross-tab mixer \u2014 works inside iframes too.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Sound Controller", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus", "notifications", "offscreen", "tabCapture"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "js": ["src/content.js"], "run_at": "document_start"}], "commands": {"volume-up": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Increase volume"}, "volume-down": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Decrease volume"}, "volume-mute": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Mute / unmute"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}