{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TextualChef: Plain Text Recipes", "version": "1.0.0", "description": "Finds the recipe on the page and opens it as plain text. Ingredients and steps, nothing else. Keep what you cook in TextualChef.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "TextualChef", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://textualchef.com/*", "*://*.textualchef.com/*"], "js": ["shared/const.js", "content/detect.js", "content/content.js"], "run_at": "document_idle"}]}