{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KeepRec \u2014 Screen Recorder", "version": "0.5.0", "description": "Beautiful screen recordings with auto-zoom and click effects. Your videos never leave your computer. No watermark, no subscription.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "KeepRec Screen Recorder", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open KeepRec"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["recorder.html", "review.html", "camera.html"], "matches": ["<all_urls>"]}]}