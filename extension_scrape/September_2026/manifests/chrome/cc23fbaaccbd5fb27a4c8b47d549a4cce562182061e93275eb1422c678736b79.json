{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sporas \u2014 Captura desde Instagram, TikTok y YouTube", "version": "0.9.2", "description": "Analiza videos sin salir de la red: lee stats y transcript de Instagram, TikTok y YouTube y los trae a Sporas con tu cuenta.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.youtube.com/*", "https://app.sporas.co/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Sporas", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content/parse.js", "content/instagram.js", "content/sort.js"], "css": ["content/instagram.css"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*"], "js": ["content/common.js", "content/tiktok.js", "content/sort-generic.js"], "css": ["content/instagram.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["content/common.js", "content/youtube.js", "content/sort-generic.js"], "css": ["content/instagram.css"], "run_at": "document_idle"}, {"matches": ["https://app.sporas.co/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content/connect.js"], "run_at": "document_idle"}]}