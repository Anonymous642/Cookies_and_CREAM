{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Impulse Price Checker", "description": "While shopping on eBay, this extension can use the current product you're on and find similar listings and their prices. ", "version": "1.0.1", "manifest_version": 3, "action": {"default_popup": "popup/popup.html", "default_icon": "images/money.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://www.ebay.com/*", "https://ebay.com/*"], "js": ["src/content.js"]}], "host_permissions": ["https://www.ebay.com/*", "https://ebay.com/*"]}