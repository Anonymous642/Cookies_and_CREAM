{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Email Scraper", "version": "1.0.1", "description": "Scrape emails from YouTube profiles based on keywords", "permissions": ["storage", "activeTab", "scripting", "downloads", "tabs"], "host_permissions": ["https://www.google.com/*", "https://*.youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}}, "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "content_scripts": [{"matches": ["https://www.google.com/search*"], "js": ["content.js"], "run_at": "document_idle"}]}