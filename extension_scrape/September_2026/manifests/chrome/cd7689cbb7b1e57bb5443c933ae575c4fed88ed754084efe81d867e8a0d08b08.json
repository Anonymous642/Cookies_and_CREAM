{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Email Detective for Gmail: Identify ESPs & Check Authentication", "description": "See which ESP sent any email in Gmail. Detects 190+ providers and shows SPF/DKIM/DMARC authentication.", "version": "2.1.181", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://detective.emailtooltester.com/*"]}, "permissions": ["storage", "scripting"], "optional_permissions": ["downloads"], "optional_host_permissions": ["https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["icon16.png", "icon48.png", "icon128.png", "icons/d/*"], "matches": ["https://mail.google.com/*"]}]}