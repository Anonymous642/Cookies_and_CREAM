{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CHAT GPT SS HELPER", "version": "0.2.1", "description": "By: James Akgonul - Take screenshots in tabs that automaticaly upload to a selected chatGPT tab", "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "action": {"default_title": "ChatGPT Helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "commands": {"armed_hotkey": {"suggested_key": {"mac": "Command+Shift+Z", "default": "Ctrl+Shift+Z"}, "description": "Run action when extension is connected"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["contentScript.js"], "run_at": "document_start"}]}