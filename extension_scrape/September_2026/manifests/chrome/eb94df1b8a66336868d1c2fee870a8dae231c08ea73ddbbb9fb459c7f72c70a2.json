{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Voccle - YouTube Word Capture", "version": "1.0.1", "description": "Highlight any word on YouTube subtitles to instantly see its meaning and save it as a flashcard to your Voccle deck.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "storage", "scripting", "cookies"], "host_permissions": ["https://*.youtube.com/*", "https://*.voccle.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["dist/src/content.js"], "css": ["content.css"]}], "background": {"service_worker": "dist/background.js"}}