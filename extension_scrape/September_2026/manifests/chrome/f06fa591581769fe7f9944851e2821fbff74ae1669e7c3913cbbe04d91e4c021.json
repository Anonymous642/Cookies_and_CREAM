{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "yttranscript.dev \u2014 YouTube Transcript", "version": "1.0.3", "description": "One-click transcripts for YouTube: timestamps, AI summaries on the web, SRT/VTT export. Free to start.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "sidePanel"], "host_permissions": ["https://yttranscript.dev/*", "https://www.youtube.com/*", "https://youtube.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open transcript panel"}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/embed/*", "https://www.youtube.com/v/*"], "js": ["content.js"], "run_at": "document_idle"}], "key": ""}