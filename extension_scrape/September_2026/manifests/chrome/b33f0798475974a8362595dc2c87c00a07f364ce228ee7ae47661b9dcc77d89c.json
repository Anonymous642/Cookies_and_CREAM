{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabkit - AI Bookmark Manager", "version": "0.2.1", "description": "AI-powered new tab. Save bookmarks with auto-tags, global search, quick access, and trending Discover \u2014 all in one place.", "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "bookmarks", "activeTab", "tabs", "scripting", "search", "identity", "alarms", "favicon", "unlimitedStorage"], "host_permissions": ["https://api.tabkit.app/*", "https://*.gstatic.com/*"], "externally_connectable": {"matches": ["https://tabkit.app/*"]}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; object-src 'none'; connect-src https://api.tabkit.app https://oauth2.googleapis.com https://*.gstatic.com"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Open Tabkit Popup"}, "global-search": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Open Tabkit Search"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}