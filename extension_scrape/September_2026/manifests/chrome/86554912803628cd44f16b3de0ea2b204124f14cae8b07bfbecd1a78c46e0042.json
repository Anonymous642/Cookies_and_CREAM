{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Amazon Review Scraper", "version": "3.0.0", "description": "Extract Amazon product reviews as CSV. Runs extraction in a hidden background tab \u2014 never interrupts your browsing.", "permissions": ["activeTab", "storage", "tabs", "notifications", "scripting"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*"], "action": {"default_popup": "popup.html", "default_title": "Amazon Review Scraper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.in/*", "https://*.amazon.co.uk/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}