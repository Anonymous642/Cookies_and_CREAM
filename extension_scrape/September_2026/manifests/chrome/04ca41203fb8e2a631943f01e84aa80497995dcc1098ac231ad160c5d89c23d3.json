{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "InterviewsPilot - Job Search Tracker, Fit Evaluation & Autofill", "short_name": "InterviewsPilot", "version": "1.0.1", "description": "Save jobs from career sites to InterviewsPilot, AI job application tracker with resume builder, cover letters, and interview prep.", "homepage_url": "https://www.interviewspilot.com", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://app.interviewspilot.com/*"], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Save to InterviewsPilot", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}, "content_scripts": [{"matches": ["https://app.interviewspilot.com/applications/capture*"], "js": ["src/capture-bridge.js"], "run_at": "document_idle"}]}