{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PrintxPDF: Print Web Pages Clean", "short_name": "PrintxPDF", "version": "1.0.1", "description": "Opens the page you are reading in PrintxPDF, which strips it down to the article so you can print it or save a clean PDF.", "minimum_chrome_version": "116", "homepage_url": "https://printxpdf.com", "permissions": ["activeTab", "contextMenus", "storage", "scripting", "clipboardWrite", "downloads"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_title": "Clean this page for printing", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"clean-current-page": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}, "description": "Clean the current page for printing"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}