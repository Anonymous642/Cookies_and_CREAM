{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Screenshot - Full-Resolution Frame Capture", "short_name": "YT Screenshot", "version": "1.0.1", "description": "Capture the current frame of any YouTube video with one click, as a file or straight to your clipboard.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "YouTube Screenshot", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/action-16.png", "24": "icons/action-24.png", "32": "icons/action-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "popup/popup.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"], "js": ["content/bootstrap.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/*.js", "shared/*.js"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"]}], "commands": {"capture-frame": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture the current video frame"}}, "permissions": ["storage", "clipboardWrite"]}