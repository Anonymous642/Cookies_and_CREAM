{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmark King \u2013 Save & Return to Text Instantly", "description": "Save and scroll to highlighted text anywhere on your current or previous pages! \u2014 works even on ChatGPT!", "version": "1.3.2", "permissions": ["storage", "tabs", "activeTab", "contextMenus", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "action": {"default_popup": "popup.html", "default_title": "View Bookmarks", "default_icon": "icons/icon48.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["prompt.html", "prompt.js"], "matches": ["<all_urls>"]}], "commands": {"bookmark-selection": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Bookmark selected text"}, "open-popup": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Bookmark King popup"}}}