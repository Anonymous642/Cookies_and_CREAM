{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContentEngine \u2014 Capture Ideas", "version": "2.0.0", "description": "Capture ideas, articles, and quotes to ContentEngine from any webpage. Generate blog posts and LinkedIn content with one click.", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://content.sairo.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "options_page": "options.html", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content-styles.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open ContentEngine popup"}, "capture-selection": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick-save selected text as Brain Idea"}}}