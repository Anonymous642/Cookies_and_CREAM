{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OverlayQR", "version": "1.2.2", "description": "Decode QR codes & barcodes from any image, and generate QR codes from selected text or hovered links \u2014 instantly.", "permissions": ["activeTab", "storage", "clipboardWrite", "clipboardRead", "scripting", "contextMenus", "sidePanel", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open OverlayQR", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "side_panel": {"default_path": "sidebar/index.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/index.html", "open_in_tab": true}, "commands": {"start-snap": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start area snap to decode QR"}}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://codingfrontend.in/*"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}