{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speedify", "version": "2.0.0", "description": "Advanced speed control for ANY video or audio across all major platforms", "permissions": ["activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Speedify", "default_icon": {"16": "icons/Speedify.png", "32": "icons/Speedify.png", "48": "icons/Speedify.png", "128": "icons/Speedify.png"}}, "icons": {"16": "icons/Speedify.png", "32": "icons/Speedify.png", "48": "icons/Speedify.png", "128": "icons/Speedify.png"}, "commands": {"speed_up": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Speed up media"}, "speed_down": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Speed down media"}, "speed_reset": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Reset speed to 1x"}, "toggle_play": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Play/Pause media"}}, "web_accessible_resources": [{"resources": ["*"], "matches": ["<all_urls>"]}]}