{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ApplyAI \u2013 Job Tracker", "version": "1.0.0", "description": "Save jobs from LinkedIn, Indeed, Greenhouse, Lever, Workday and more to your ApplyAI tracker in one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "ApplyAI \u2013 Save this job"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*", "https://*.indeed.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.myworkdayjobs.com/*", "https://*.glassdoor.com/job-listing/*", "https://*.glassdoor.com/Jobs/*", "https://*.wellfound.com/jobs/*", "https://*.angel.co/jobs/*", "https://*.ashbyhq.com/*", "https://*.smartrecruiters.com/*", "https://*.jobvite.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.myworkdayjobs.com/*", "https://*.glassdoor.com/*", "https://*.wellfound.com/*", "https://*.angel.co/*", "https://*.ashbyhq.com/*", "https://*.smartrecruiters.com/*", "https://*.jobvite.com/*", "http://localhost:5000/*", "https://*/*"]}