{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabSwitch - Jump to Any Tab Instantly", "version": "1.0.0", "description": "2 keystrokes to any tab. Press hotkey, type letter, switch. Works with 100+ tabs. 100% local, zero data collection.", "permissions": ["tabs", "tabGroups", "storage", "scripting", "activeTab", "management", "notifications"], "commands": {"activate-tabswitch": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S", "windows": "Alt+S", "linux": "Alt+S"}, "description": "Activate TabSwitch overlay"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/settings.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "default_title": "TabSwitch Settings"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}