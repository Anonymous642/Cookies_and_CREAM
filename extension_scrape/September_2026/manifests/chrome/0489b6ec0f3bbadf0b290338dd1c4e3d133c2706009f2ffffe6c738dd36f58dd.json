{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClickShield \u2014 Ad & Popup Blocker", "version": "1.0.3", "description": "Blocks ads, trackers, and the pop-up/pop-under tabs that hijack your clicks. Built on EasyList and EasyPrivacy.", "minimum_chrome_version": "121", "homepage_url": "https://github.com/Chavagov123/clickshield", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "easylist", "enabled": true, "path": "rulesets/easylist.json"}, {"id": "easyprivacy", "enabled": true, "path": "rulesets/easyprivacy.json"}, {"id": "unbreak", "enabled": true, "path": "rulesets/unbreak.json"}, {"id": "custom", "enabled": true, "path": "rulesets/custom.json"}]}, "web_accessible_resources": [{"resources": ["shared/popup-domains.json"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/popup-guard-main.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_about_blank": true}, {"matches": ["<all_urls>"], "js": ["content/popup-guard-bridge.js", "content/cosmetic.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}]}