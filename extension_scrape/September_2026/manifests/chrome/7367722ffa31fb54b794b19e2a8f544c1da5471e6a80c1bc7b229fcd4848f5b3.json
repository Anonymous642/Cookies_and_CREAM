{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkTiles", "version": "3.9.0", "minimum_chrome_version": "116", "description": "Organize your bookmarks in a tile-based dashboard", "icons": {"16": "app/icon16.png", "48": "app/icon48.png", "128": "app/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "LinkTiles"}, "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current tab to Quick Save"}, "open-quick-save": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Quick save with project picker"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open LinkTiles dashboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"}, "permissions": ["activeTab", "contextMenus", "alarms", "storage"], "externally_connectable": {"matches": ["https://linktiles.app/*"]}, "optional_permissions": ["bookmarks", "tabs"], "background": {"service_worker": "background.js"}}