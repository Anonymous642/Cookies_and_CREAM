{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ThemeWand", "description": "Instantly preview color palettes on any webpage", "version": "1.0.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["http://localhost:3009/*", "https://themewand.com/*"]}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "ThemeWand - Click to toggle sidebar"}, "web_accessible_resources": [{"resources": ["icon48.png"], "matches": ["<all_urls>"]}], "commands": {"next-theme": {"suggested_key": {"default": "Ctrl+Shift+Right", "mac": "Command+Shift+Right"}, "description": "Next theme"}, "prev-theme": {"suggested_key": {"default": "Ctrl+Shift+Left", "mac": "Command+Shift+Left"}, "description": "Previous theme"}, "toggle-enable": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle enable"}, "reset-theme": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "Reset theme"}}, "background": {"service_worker": "background.js"}, "content_scripts": []}