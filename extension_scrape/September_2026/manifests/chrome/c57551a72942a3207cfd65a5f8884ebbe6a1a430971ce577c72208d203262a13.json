{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reline", "version": "0.1.0", "description": "Adds speaker names to Reline meeting transcripts by reading who speaks in Google Meet, Microsoft Teams and Zoom. Requires Reline.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Reline Speaker Tags", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "alarms"], "host_permissions": ["http://127.0.0.1:8788/*"], "background": {"service_worker": "background.js"}, "externally_connectable": {"matches": ["https://*.reline.so/*"]}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://*.zoom.us/wc/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]}