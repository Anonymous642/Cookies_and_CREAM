{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Linea - Dyslexia and ADHD", "description": "Dyslexia & ADHD reading aid: reveal one sentence per tap, calm the page, and tune fonts, spacing & text size to fit you.", "version": "1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "action": {"default_title": "Linea - Dyslexia and ADHD", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["fonts/*", "dict/*", "orb.png"], "matches": ["http://*/*", "https://*/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}