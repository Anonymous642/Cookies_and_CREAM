{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CopiaLiteral", "description": "Selecciona texto en pantalla, lo reconoce localmente y lo copia sin reinterpretarlo.", "version": "1.3.0", "minimum_chrome_version": "116", "permissions": ["activeTab", "clipboardWrite", "offscreen", "scripting", "storage"], "background": {"service_worker": "background.js", "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CopiaLiteral: copiar texto", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"capture-visible-tab": {"suggested_key": {"default": "Alt+2", "mac": "Command+Shift+2"}, "description": "Copiar texto de la pesta\u00f1a visible con CopiaLiteral"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; worker-src 'self'"}}