{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ProxySwitcher - Burp Suite Proxy Manager", "version": "2.1.0", "description": "One-click proxy switching for Burp Suite, ZAP and custom proxies. Dark/Light theme, usage stats, config export/import.", "permissions": ["proxy", "storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-proxy": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle proxy on/off"}, "next-profile": {"suggested_key": {"default": "Alt+N"}, "description": "Switch to next profile"}}}