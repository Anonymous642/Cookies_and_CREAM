{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapMark \u2014 Screenshot & Annotate", "version": "1.1.0", "description": "Capture the visible area, a selected region, or the full page, then mark it up with arrows, shapes, text, blur, and crop.", "default_locale": "en", "permissions": ["activeTab", "downloads", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the visible area"}, "capture-selection": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Capture a selected region"}}}