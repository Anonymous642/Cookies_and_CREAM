{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AroSync \u2014 eBay & Facebook Listing Tool", "version": "1.0.0", "description": "Copy eBay listings to Facebook Marketplace, or import any eBay listing straight into your own eBay store \u2014 all in one click.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "AroSync", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["storage", "contextMenus", "notifications"], "host_permissions": ["https://www.ebay.com/*", "https://www.facebook.com/*", "https://i.ebayimg.com/*", "https://app.arosync.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.ebay.com/itm/*"], "js": ["content-ebay.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/marketplace/create/*"], "js": ["content-facebook.js"], "run_at": "document_idle"}, {"matches": ["https://app.arosync.ai/products/*", "https://app.arosync.ai/new*", "http://localhost:3000/products/*", "http://localhost:3000/new*"], "js": ["content-arosync.js"], "run_at": "document_idle"}]}