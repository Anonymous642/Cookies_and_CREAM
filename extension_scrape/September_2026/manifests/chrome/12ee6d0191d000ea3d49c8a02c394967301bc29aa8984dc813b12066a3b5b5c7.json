{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart Gmail Data Classifier", "description": "This Extension helps classify your emails by adding the required tags: Internal, External, Confidential etc while sending the emails", "version": "1.1", "permissions": ["storage", "scripting", "activeTab", "identity", "identity.email"], "host_permissions": ["https://mail.google.com/*", "https://script.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Smart Gmail Data Classifier"}, "icons": {"16": "icons/smart_gmail_data_classifier_icon16.png", "32": "icons/smart_gmail_data_classifier_icon32.png", "48": "icons/smart_gmail_data_classifier_icon48.png", "128": "icons/smart_gmail_data_classifier_icon128.png"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["smart_gmail_data_classifier.png", "ums_logo.png"], "matches": ["https://mail.google.com/*"]}]}