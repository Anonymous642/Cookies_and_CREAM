{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitCoder", "description": "Automatically sync accepted LeetCode solutions to GitHub.", "version": "1.0.2", "permissions": ["storage"], "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://leetcode.com/*"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}