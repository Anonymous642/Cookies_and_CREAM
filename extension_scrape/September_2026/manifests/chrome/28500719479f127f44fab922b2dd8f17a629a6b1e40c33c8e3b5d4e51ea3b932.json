{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Txtii X Reply Assistant", "version": "0.1.1", "description": "AI-powered reply generator for X. Find high-potential tweets, generate sharp replies, and grow your following faster.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.openai.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Txtii Reply", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"]}]}