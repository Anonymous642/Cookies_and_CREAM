{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Panic Button Extension", "version": "1.0.0", "description": "Privacy-focused extension with emergency button to instantly close all tabs and redirect to a safe default page.", "permissions": ["tabs", "storage", "contextMenus", "scripting"], "optional_permissions": ["activeTab"], "host_permissions": ["https://*.supabase.co/*", "https://checkout.stripe.com/*", "https://extensionpay.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_end"}, {"matches": ["https://extensionpay.com/*"], "js": ["src/vendor/ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/assets/*", "src/popup/privacy-policy.html", "src/popup/privacy-policy.js"], "matches": ["<all_urls>"]}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Panic Button Extension Settings", "default_icon": {"16": "src/assets/icon16.png", "48": "src/assets/icon48.png", "128": "src/assets/icon128.png"}}, "commands": {"open-settings": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Open Panic Button settings"}}, "icons": {"16": "src/assets/icon16.png", "48": "src/assets/icon48.png", "128": "src/assets/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; connect-src https://extensionpay.com"}}