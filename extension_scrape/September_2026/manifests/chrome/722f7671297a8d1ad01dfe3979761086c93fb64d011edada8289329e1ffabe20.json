{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Traffic Type Marker", "description": "The extension allows you to set a traffic_type flag in your browser's session storage for specific websites.", "version": "2.0", "manifest_version": 3, "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Traffic Type Marker", "default_popup": "src/html/popup.html"}, "background": {"service_worker": "src/js/background.js"}, "web_accessible_resources": [{"resources": ["src/css/*"], "matches": ["<all_urls>"]}]}