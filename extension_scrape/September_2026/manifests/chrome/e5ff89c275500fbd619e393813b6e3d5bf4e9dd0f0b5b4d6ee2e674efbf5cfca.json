{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Action Cursor for Google Docs", "version": "0.1.0", "description": "Animated smear cursor for Google Docs.", "permissions": ["storage"], "action": {"default_title": "Action Cursor", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.jpeg", "48": "icons/icon48.jpeg", "128": "icons/icon128.jpeg"}}, "icons": {"16": "icons/icon16.jpeg", "32": "icons/icon32.jpeg", "48": "icons/icon48.jpeg", "128": "icons/icon128.jpeg"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*", "https://docs.google.com/*/d/*"], "js": ["gdocs-action-cursor.js"], "run_at": "document_idle"}]}