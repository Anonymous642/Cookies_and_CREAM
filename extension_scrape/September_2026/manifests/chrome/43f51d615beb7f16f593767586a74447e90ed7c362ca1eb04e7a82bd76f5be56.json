{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Real Timestamps", "version": "1.0.0", "description": "Replace GitHub's relative times (e.g. '3 days ago') with the actual date and time in your local time zone. Fully customizable.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "GitHub Real Timestamps", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["format.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}