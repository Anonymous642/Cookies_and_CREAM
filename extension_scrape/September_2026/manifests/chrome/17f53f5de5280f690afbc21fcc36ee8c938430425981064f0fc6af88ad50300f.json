{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouDecide", "description": "A popup after each impulsive video click asks you to type your intention. Forces you to pause and think if you really want to watch.", "version": "1.0.7", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "YouDecide", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "all_frames": false, "exclude_matches": ["*://music.youtube.com/*", "*://studio.youtube.com/*", "*://tv.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://*.youtube.com/*", "*://youtube.com/*"]}]}