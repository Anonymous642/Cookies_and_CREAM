{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DemoStacker", "version": "2.2.1", "description": "Capture any web app screen for your DemoStacker demos", "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabCapture", "offscreen", "desktopCapture"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://app.demostacker.com/*", "https://*.demostacker.com/*", "http://localhost/*"]}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "panel/panel.html"}, "commands": {"capture-screen": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capture a screen into the active demo session"}}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}