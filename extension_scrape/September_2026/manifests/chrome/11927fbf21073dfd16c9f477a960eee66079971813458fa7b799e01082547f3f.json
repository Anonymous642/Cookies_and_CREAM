{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Tab Master", "version": "1.2.0", "description": "AI Tab Master - Intelligent tab management and switching", "permissions": ["tabs", "tabGroups", "storage", "commands", "webNavigation", "windows", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>", "https://www.aitabmaster.com/*"], "background": {"service_worker": "background.js"}, "commands": {"1-switch-to-last-tab": {"suggested_key": {"default": "Alt+Space"}, "description": "Switch to the recently opened tab"}, "2-switch-to-last-window": {"suggested_key": {"default": "Alt+F"}, "description": "Switch window shortcut (Premium feature)"}, "3-toggle-all-groups": {"suggested_key": {"default": "Alt+X"}, "description": "Expand/collapse all tab groups (Premium feature)"}, "4-quick-open-pages": {"suggested_key": {"default": "Alt+O"}, "description": "Quick open pages (Premium feature)"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/SwitchTabLogo16.png", "48": "images/SwitchTabLogo48.png", "128": "images/SwitchTabLogo128.png"}}, "icons": {"16": "images/SwitchTabLogo16.png", "48": "images/SwitchTabLogo48.png", "128": "images/SwitchTabLogo128.png"}, "web_accessible_resources": [{"resources": ["tab_organizer.html", "split_view.html", "welcome.html", "welcome.js", "images/*", "videos/*", "assets/*", "background.js"], "matches": ["<all_urls>"]}]}