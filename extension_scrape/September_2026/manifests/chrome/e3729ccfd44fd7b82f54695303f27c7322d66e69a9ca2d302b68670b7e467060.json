{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SocialClipper \u2014 Social Bookmark Manager", "description": "Save whole posts \u2014 text, images and video \u2014 to your own device. No account, no limit.", "version": "0.4.1", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "action": {"default_title": "SocialClipper", "default_icon": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://*.linkedin.com/*", "https://*.instagram.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.reddit.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://socialclipper.io/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content-scripts/instagram.js"]}, {"matches": ["*://*.linkedin.com/*"], "js": ["content-scripts/linkedin.js"]}, {"matches": ["*://*.reddit.com/*"], "js": ["content-scripts/reddit.js"]}, {"matches": ["*://*.tiktok.com/*"], "js": ["content-scripts/tiktok.js"]}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content-scripts/twitter.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube.js"]}]}