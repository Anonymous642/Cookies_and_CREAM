{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TopShelf", "description": "Pin webpages beside your writing. Highlight, cite, and paste from source articles without switching tabs.", "version": "1.0.0", "permissions": ["sidePanel", "activeTab", "tabs", "storage", "clipboardWrite", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "sidepanel/index.html"}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "TopShelf", "default_popup": "popup/popup.html"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle TopShelf panel"}, "pin-current-tab": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Pin current page to TopShelf"}, "copy-with-citation": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Copy selection with citation"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}