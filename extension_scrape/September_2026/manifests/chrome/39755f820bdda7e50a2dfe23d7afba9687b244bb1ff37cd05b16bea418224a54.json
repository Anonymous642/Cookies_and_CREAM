{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ScreenCapture Pro", "version": "1.0.2", "description": "Advanced screenshot tool with annotations, full page capture, and area selection.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "downloads", "clipboardWrite"], "action": {"default_popup": "popup.html", "default_title": "ScreenCapture Pro", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["overlay.html", "annotation-editor.js", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page screenshot"}, "capture-visible-area": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible area"}, "select-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Select custom area to capture"}}}