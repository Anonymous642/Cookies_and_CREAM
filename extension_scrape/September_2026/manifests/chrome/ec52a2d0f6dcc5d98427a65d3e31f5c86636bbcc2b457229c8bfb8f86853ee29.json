{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slide Tabs \u2014 Auto-hiding vertical tabs", "version": "1.1.0", "description": "Auto-hiding vertical tabs. Move the cursor to the edge and the tab sidebar slides in as an overlay.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "favicon", "sidePanel"], "host_permissions": ["<all_urls>"], "chrome_url_overrides": {"newtab": "newtab.html"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Slide Tabs \u2014 open tab sidebar", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": []}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle the overlay tab sidebar"}}}