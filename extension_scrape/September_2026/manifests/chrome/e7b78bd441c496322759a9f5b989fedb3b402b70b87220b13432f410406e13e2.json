{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Screen Recorder", "short_name": "Screen Recorder", "version": "2.5.8", "description": "Record any tab or screen with auto spotlight on clicks, beautiful backgrounds, browser frames, and one-click MP4 export.", "author": "ikai design", "homepage_url": "https://simple-screen-recorder.com", "permissions": ["scripting", "activeTab", "downloads", "tabs", "storage"], "host_permissions": ["http://*/*", "https://*/*", "file://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "service-worker.js"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Simple Screen Recorder", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"stop-recording": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Stop recording"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "minimum_chrome_version": "116"}