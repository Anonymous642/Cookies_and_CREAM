{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Link Extractor and Analyzer", "version": "1.0", "description": "Extract and analyze links from web pages with security features and detailed reporting", "author": "Francesco Curr\u00e0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon-128.png", "default_title": "Link Extractor and Analyzer"}, "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self'; base-uri 'self'; form-action 'none';"}}