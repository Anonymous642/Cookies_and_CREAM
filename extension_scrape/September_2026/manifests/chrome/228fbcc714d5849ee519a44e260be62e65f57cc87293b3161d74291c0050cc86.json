{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CVCircle Job Tracker", "version": "1.1.1", "description": "Seamlessly capture, track, and manage job applications from any job posting website", "permissions": ["storage", "cookies", "tabs", "activeTab", "scripting", "sidePanel", "alarms"], "host_permissions": ["https://www.cvcircle.io/*", "https://*.linkedin.com/jobs/*", "https://*.indeed.com/*", "https://*/*"], "background": {"service_worker": "background/background.js", "type": "module"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "popup/popup.html"}, "content_scripts": [{"matches": ["https://*.linkedin.com/jobs/*", "https://*.indeed.com/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/*.js", "logo.png"], "matches": ["<all_urls>"]}]}