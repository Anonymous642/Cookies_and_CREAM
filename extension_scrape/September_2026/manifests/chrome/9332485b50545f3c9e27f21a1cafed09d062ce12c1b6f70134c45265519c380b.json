{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SecuriScan - Web Security Analyzer", "version": "1.5.0", "description": "Lightweight security scanner that analyzes websites for common vulnerabilities, trackers, and security misconfigurations", "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "commands": {"scan-current-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Scan current page with SecuriScan"}, "open-side-panel": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open SecuriScan side panel"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/vulnerability-database.js", "src/content.js"], "run_at": "document_idle"}]}