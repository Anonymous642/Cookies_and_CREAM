{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ListBuddy Helper", "version": "0.3.5", "description": "Browser-side helper for ListBuddy. Reads Amazon product pages to feed your eBay arbitrage tools.", "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"], "host_permissions": ["*://*.amazon.com/*", "https://api.listbuddy.org/*"], "action": {"default_popup": "popup.html", "default_title": "ListBuddy Helper"}, "background": {"service_worker": "background.js"}, "icons": {"128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}