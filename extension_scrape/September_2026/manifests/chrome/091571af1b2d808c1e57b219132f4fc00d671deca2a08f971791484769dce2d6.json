{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EspoCRM for Gmail", "description": "Connect Gmail to your EspoCRM instance", "version": "1.0.25", "icons": {"16": "icon-16.png", "24": "icon-24.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "scripting", "windows", "tabs", "sidePanel"], "host_permissions": ["https://mail.google.com/*", "https://mails.arctenic.com/*"], "web_accessible_resources": [{"resources": ["sidepanel.html"], "matches": ["https://mail.google.com/*"]}], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-scripts/content.js"]}]}