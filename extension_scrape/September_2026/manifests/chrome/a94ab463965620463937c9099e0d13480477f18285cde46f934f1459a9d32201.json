{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Word Seeker \u2014 Search in any YouTube video", "short_name": "YT Word Seeker", "version": "2.0.0", "description": "Search any word in a YouTube video transcript and jump to that exact moment. Integrated directly in the sidebar.", "author": "Daisuki", "permissions": ["storage", "webRequest"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://ytwordseeker.up.railway.app/*"], "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["src/content.js"], "css": ["src/panel.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "type": "classic"}, "web_accessible_resources": [{"matches": ["https://www.youtube.com/*"], "resources": ["scripts/getPlayerResponse.js"], "use_dynamic_url": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "YT Word Seeker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "homepage_url": "https://youtubeseeker.netlify.app"}