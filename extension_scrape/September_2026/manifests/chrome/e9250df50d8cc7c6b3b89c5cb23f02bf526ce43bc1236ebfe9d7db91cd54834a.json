{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TheosWorld Chat Administrator", "version": "1.1.0", "minimum_chrome_version": "116", "description": "Sign in once with an emailed OTP for 7 days of quick access to the chat.theosworld.ca admin panel and Admin Agent.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TheosWorld Chat Administrator"}, "side_panel": {"default_path": "agent.html"}, "commands": {"open-agent-panel": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Open the Admin Agent side panel"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "tabs", "scripting", "sidePanel"], "host_permissions": ["https://chat.theosworld.ca/*"]}