{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickReply Vault", "version": "1.0.0", "description": "Insert reusable message templates instantly on Gmail, LinkedIn, WhatsApp and Outlook. Save time with 1-click replies.", "action": {"default_title": "QuickReply Vault", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://mail.google.com/*", "https://www.linkedin.com/*", "https://web.whatsapp.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}