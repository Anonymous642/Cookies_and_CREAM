{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Radio & YouTube Media Player", "short_name": "Media R&Y Player", "version": "0.0.23", "description": "Play YouTube, radio stations, and streams in the background with customizable playlists and more.", "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}, "description": "Activate the extension"}}, "icons": {"16": "images/logo-16.png", "32": "images/logo-32.png", "48": "images/logo-48.png", "128": "images/logo-128.png"}, "permissions": ["alarms", "notifications", "offscreen", "storage", "declarativeNetRequest"], "host_permissions": ["http://all.api.radio-browser.info/json/servers", "https://www.youtube.com/*", "https://music.youtube.com/*", "https://youtu.be/*", "https://*/*"], "action": {"default_title": "Radio & YouTube Music Player", "default_popup": "popup/popup.html"}, "options_ui": {"open_in_tab": true, "page": "options/options.html"}, "options_page": "options/options.html", "content_scripts": [{"js": ["contentScript.js"], "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "run_at": "document_end"}], "declarative_net_request": {"rule_resources": [{"id": "youtube_referer_modifier", "enabled": true, "path": "youtube_referer_rules.json"}]}}