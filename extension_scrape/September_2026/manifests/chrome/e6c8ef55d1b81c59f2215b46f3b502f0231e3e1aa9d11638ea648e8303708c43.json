{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kyra", "version": "0.1.1", "description": "Captures Gmail messages that need a reply and hands them to the Kyra app running on your Mac. Your data stays on your device.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "nativeMessaging"], "host_permissions": ["https://mail.google.com/*"], "externally_connectable": {"matches": ["http://localhost/*"]}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["lib/item.js", "lib/dedupe.js", "hosts/gmail.js", "gmail_compose.js"]}]}