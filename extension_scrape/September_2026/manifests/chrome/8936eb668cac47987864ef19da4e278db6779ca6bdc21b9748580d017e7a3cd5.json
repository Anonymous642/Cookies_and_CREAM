{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QatchThem for LinkedIn", "version": "1.1.3", "description": "Add LinkedIn profiles to your QatchThem account and run user-scheduled outreach sequences from your QatchThem dashboard.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://qatchthem.com/*", "https://www.qatchthem.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["content.js"], "css": ["sidebar.css"], "run_at": "document_idle"}, {"matches": ["https://qatchthem.com/*", "https://www.qatchthem.com/*"], "js": ["detector.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "QatchThem"}, "web_accessible_resources": [{"resources": ["automator.js"], "matches": ["https://www.linkedin.com/*"]}, {"resources": ["detector.js"], "matches": ["https://qatchthem.com/*", "https://www.qatchthem.com/*"]}]}