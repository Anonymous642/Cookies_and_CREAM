{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Job Tracker", "version": "1.0.0", "description": "Shows LinkedIn job status banners from a user-selected note.txt file and tracks previously viewed jobs.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/extension_icon_16.png", "48": "icons/extension_icon_48.png", "128": "icons/extension_icon_128.png"}, "action": {"default_title": "LinkedIn Job Tracker", "default_popup": "popup.html", "default_icon": {"16": "icons/extension_icon_16.png", "48": "icons/extension_icon_48.png", "128": "icons/extension_icon_128.png"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*"], "js": ["content.js"], "run_at": "document_end"}]}