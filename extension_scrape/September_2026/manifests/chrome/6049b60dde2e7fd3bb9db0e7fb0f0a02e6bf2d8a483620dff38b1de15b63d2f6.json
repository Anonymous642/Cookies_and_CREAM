{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hire10x", "description": "Import recruiter-selected candidate profiles from LinkedIn, Google X-Ray, and Cutshort into Hire10x.", "version": "9.3.5", "icons": {"16": "icon32.png", "32": "icon32.png", "48": "icon32.png", "128": "icon32.png"}, "minimum_chrome_version": "114", "action": {"default_title": "Open Hire10x", "default_icon": {"16": "icon32.png", "32": "icon32.png", "48": "icon32.png", "128": "icon32.png"}}, "permissions": ["tabs", "activeTab", "scripting", "cookies", "storage", "alarms", "sidePanel"], "host_permissions": ["https://www.google.com/*", "https://www.linkedin.com/*", "https://cutshort.io/*", "https://r.my.jobin.cloud/*", "https://my.jobin.cloud/*", "https://securetoken.googleapis.com/*", "https://hire10xapi.10xscale.ai/*", "https://hire10x.10xscale.ai/*", "https://app.hire10x.ai/*", "https://hire10xprod.web.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://hire10x.10xscale.ai/*", "https://app.hire10x.ai/*", "https://hire10xprod.web.app/*"]}, "storage": {"sessionStorage": true}, "background": {"type": "module", "service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://cutshort.io/profile/candidate-search/*"], "run_at": "document_start", "js": ["content-scripts/cutshort.js"], "world": "ISOLATED"}]}