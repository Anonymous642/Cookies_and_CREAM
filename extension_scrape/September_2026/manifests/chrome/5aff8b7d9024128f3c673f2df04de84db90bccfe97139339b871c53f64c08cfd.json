{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Super Bookmark Groups", "version": "1.1.3", "description": "Manage bookmark groups, open or close them with a single click.", "permissions": ["tabs", "storage", "favicon", "contextMenus", "scripting"], "optional_host_permissions": ["*://*/tco/superpage/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open_group_1": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Open group 1 (top pinned group)"}, "close_group_1": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Close group 1 (top pinned group)"}, "save_window_as_group": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current window as a group"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}