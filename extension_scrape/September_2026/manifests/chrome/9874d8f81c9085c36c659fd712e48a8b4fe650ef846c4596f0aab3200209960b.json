{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "IMS Workspace", "description": "Side panel with internal links, saved messages, reminders and IMS candidate search. Everything stays on this machine.", "version": "1.0.1", "version_name": "1.0.1 beta", "permissions": ["sidePanel", "storage", "alarms", "notifications", "contextMenus", "scripting", "webNavigation", "downloads"], "host_permissions": ["https://ims.inno.ws/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://chat.google.com/*", "https://mail.google.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "IMS Workspace"}, "side_panel": {"default_path": "sidebar/sidebar.html"}, "content_scripts": [{"matches": ["https://chat.google.com/*", "https://mail.google.com/*"], "js": ["content/capture.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "minimum_chrome_version": "123"}