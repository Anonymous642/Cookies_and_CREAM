{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TintTaster", "description": "Pick any color from any page with EyeDropper or precision loupe. Copy HEX/RGB/HSL, export, and check WCAG contrast.", "version": "1.3.0", "action": {"default_popup": "popup/popup.html", "default_title": "TintTaster"}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "commands": {"pick-color": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Option+Shift+C"}, "description": "Pick a color from the current page"}}, "minimum_chrome_version": "95"}