{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Input Buddy", "description": "InputBuddy aims to remove repetitive typing from forms. Save common label + answer pairs and InputBuddy will auto-fill them.", "version": "1.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "author": {"email": "zexovon@gmail.com"}, "license": "GPL-3.0-or-later", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Input Buddy", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}