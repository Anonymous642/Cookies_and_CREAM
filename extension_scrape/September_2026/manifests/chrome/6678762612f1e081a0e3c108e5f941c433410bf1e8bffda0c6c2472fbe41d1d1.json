{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FactCheckIt", "version": "1.6", "description": "Fact-check any webpage or YouTube video, or validate any product or service \u2014 generates AI-ready prompts copied to your clipboard", "minimum_chrome_version": "102", "permissions": ["activeTab", "storage", "clipboardWrite", "scripting", "contextMenus"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "FactCheckIt", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "options_page": "options/options.html", "commands": {"factcheck": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fact-check current page (opens FactCheckIt)"}, "validate": {"description": "Validate product/service on current page (opens FactCheckIt)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}