{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Click Doc Builder - Screenshot & Annotation Tool", "version": "1.0.0", "description": "Record clicks, capture screenshots, add annotations and mosaics. Create step-by-step documentation with live sidebar preview.", "permissions": ["activeTab", "storage", "unlimitedStorage", "downloads", "sidePanel"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Click Doc Builder - Start Recording", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Toggle recording on/off"}, "open-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the documentation sidebar"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "homepage_url": "https://github.com/yourusername/click-doc-builder", "author": "Your Name", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';"}}