{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Open on Desktop for Box", "short_name": "Auto Open Desktop", "version": "1.0.0", "description": "Automatically opens Box files in your desktop apps instead of the web preview. Not affiliated with Box, Inc.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Auto Open on Desktop settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://app.box.com/*", "https://*.app.box.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}