{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabito", "version": "1.4.0", "description": "Search tabs. Jump to live calls. Dedup + group. Save sessions. Hand off to phone via QR. Zero host permissions.", "permissions": ["tabs", "alarms", "storage", "tabGroups", "sessions", "notifications", "scripting"], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Tabito"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"jump-to-call": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Jump to a live call tab (Meet, Zoom, Teams, WhatsApp)"}}}