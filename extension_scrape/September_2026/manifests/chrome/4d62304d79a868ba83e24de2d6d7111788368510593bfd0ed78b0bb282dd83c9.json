{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChessBreak - Chess Puzzles While Browsing", "description": "ChessBreak opens a Chess puzzle every few websites to keep you sharp. Need help? Contact us at ChessPauseContactUs@gmail.com.", "version": "2.0.1", "permissions": ["tabs", "storage", "activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "logos/ChessPauseLogo16.png", "48": "logos/ChessPauseLogo48.png", "128": "logos/ChessPauseLogo128.png"}}, "icons": {"16": "logos/ChessPauseLogo16.png", "48": "logos/ChessPauseLogo48.png", "128": "logos/ChessPauseLogo128.png"}, "content_scripts": [{"matches": ["https://chessbreakpuzzles.onrender.com/*"], "js": ["content.js"]}], "content_security_policy": {"script-src": ["'self'"], "script-src-elem": ["'self'"], "object-src": "'self'"}}