{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "name": "Kitsumi", "version": "7.5.59", "description": "YouTube/Anime/Netflix subtitle overlay with dictionaries, Anki mining, 46 languages support", "author": "Kitsumi", "homepage_url": "https://kitsumi.org", "action": {"default_popup": "popup.html", "default_title": "Kitsumi", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "background": {"service_worker": "sw.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["lib/yt-page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.netflix.com/*"], "js": ["lib/nfx-page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.crunchyroll.com/*"], "js": ["lib/cr-page-bridge.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "lib/subtitle-parser.js", "lib/deinflect.js", "lib/tokenizer.js", "lib/dictstate.js", "lib/optcache.js", "lib/epparse.js", "lib/selection.js", "lib/substate.js", "lib/spadetect.js", "lib/mining.js", "lib/fshost.js", "lib/recorder.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"quick-mine-current-subtitle": {"description": "Kitsumi: quick-mine the current subtitle"}, "toggle-current-site-allowlist": {"description": "Kitsumi: add/remove current site from the auto-load allowlist"}}, "web_accessible_resources": [{"resources": ["sounds/*", "spa-bridge.js", "lib/asr-worklet.js"], "matches": ["<all_urls>"]}], "permissions": ["storage", "tabs", "activeTab", "unlimitedStorage", "contextMenus", "offscreen"], "host_permissions": ["<all_urls>"], "minimum_chrome_version": "109"}