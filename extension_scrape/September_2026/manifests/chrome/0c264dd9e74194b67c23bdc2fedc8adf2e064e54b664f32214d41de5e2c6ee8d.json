{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pinterest Slideshow", "version": "0.2.0", "description": "Adds a Slideshow button to Pinterest boards and plays the pins full screen.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Pinterest Slideshow", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage"], "content_scripts": [{"matches": ["*://*.pinterest.com/*", "*://*.pinterest.ca/*", "*://*.pinterest.co.uk/*", "*://*.pinterest.fr/*", "*://*.pinterest.de/*", "*://*.pinterest.es/*", "*://*.pinterest.it/*", "*://*.pinterest.com.au/*", "*://*.pinterest.com.mx/*", "*://*.pinterest.jp/*", "*://*.pinterest.se/*", "*://*.pinterest.ch/*", "*://*.pinterest.at/*", "*://*.pinterest.nz/*", "*://*.pinterest.ie/*", "*://*.pinterest.pt/*", "*://*.pinterest.dk/*", "*://*.pinterest.ph/*", "*://*.pinterest.cl/*", "*://*.pinterest.info/*"], "js": ["lib/images.js", "lib/pinterest.js", "content/slideshow.js", "content/board-button.js"], "css": ["content/slideshow.css", "content/board-button.css"], "run_at": "document_idle"}], "commands": {"toggle-slideshow": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle the slideshow on the current tab"}}}