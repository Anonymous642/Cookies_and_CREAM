{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Todo List", "version": "1.0.0", "description": "Manage your todos with popup, keyboard shortcuts, and side panel", "permissions": ["storage", "sidePanel"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T", "mac": "MacCtrl+T"}, "description": "Open todo popup"}, "open-sidepanel": {"suggested_key": {"default": "Alt+S", "mac": "MacCtrl+S"}, "description": "Open todo side panel"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}