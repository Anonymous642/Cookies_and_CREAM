{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ad Break \u2014 Mute Twitch Ads & Auto-Switch", "short_name": "Ad Break", "version": "1.10.1", "description": "Twitch ads mute themselves and tab headers show the time left. Auto switches to other open streams when an ad plays.", "author": "Kydev", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.twitch.tv/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Ad Break", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["popup.html"], "matches": ["*://*.twitch.tv/*"]}], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["quality-pref.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.twitch.tv/*"], "js": ["player-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}]}