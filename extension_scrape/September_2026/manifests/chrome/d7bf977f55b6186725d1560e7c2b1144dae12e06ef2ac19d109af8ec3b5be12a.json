{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "babblevoice Desktop for Google Chrome\u2122", "short_name": "babblevoice Desktop", "description": "Use this extension to easily click to dial through babblevoice. For info please visit: https://www.babblevoice.com/", "version": "4.00", "permissions": ["declarativeContent", "tabs", "contextMenus", "cookies", "storage"], "host_permissions": ["https://www.babblevoice.com/a/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": "icon_16.png"}, "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "content_scripts": [{"matches": ["*://*/*", "file://*/*"], "js": ["content.js"]}], "externally_connectable": {"matches": ["*://*.babblevoice.com/*"]}}