{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Boogie - A Unique Way to Surf The Web", "version": "1.0.0", "description": "Discover random interesting websites with a single click", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Boogie - Random Website Discovery"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.svg", "icons/*.png"], "matches": ["<all_urls>"]}]}