{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pop to Pane", "version": "1.0.0", "description": "Pop the current tab into a clean, chrome-less popup window for desktop monitoring panes. Reuses your existing login/session.", "permissions": ["contextMenus", "activeTab", "storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Pop into clean pane", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"pop-to-pane": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Pop the current tab into a clean pane"}}}