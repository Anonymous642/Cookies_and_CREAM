{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KP.Media \u2014 Page Jump", "version": "1.0.0", "description": "Jump straight to any page number in a paginated URL. For sites sorted by date with no date filter.", "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "Page Jump (Alt+Shift+J)"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+J"}}, "back": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Jump back (size set in the popup)"}, "forward": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Jump forward (size set in the popup)"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}