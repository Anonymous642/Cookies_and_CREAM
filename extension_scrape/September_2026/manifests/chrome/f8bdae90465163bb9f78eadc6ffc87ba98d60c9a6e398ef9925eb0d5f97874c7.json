{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Salesforce Lightning/Classic Switcher", "version": "1.0", "description": "Switch between Salesforce Lightning and Classic for the current record", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab"], "host_permissions": ["*://*.salesforce.com/*", "*://*.force.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["*://*.salesforce.com/*", "*://*.force.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://*.salesforce.com/*", "*://*.force.com/*"]}]}