{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tuckit \u2014 drag a timer out of any page", "version": "0.1.0", "description": "Drag a timer out of the edge of any page. Pull to set the time, let go to start, or run a whole Pomodoro session.", "minimum_chrome_version": "116", "permissions": ["storage", "alarms", "notifications", "offscreen", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Tuckit", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"quick-entry": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open the command bar"}, "full-screen": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open or collapse full screen"}, "toggle-hide": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hide or show the puck"}}}