{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OpenRead \u2014 Local Bilingual Translation", "description": "Bilingual whole-page translation for web pages, PDFs and EPUBs, entirely on your own machine. No account, no API key, no setup.", "version": "2.23.0", "short_name": "OpenRead", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "138", "permissions": ["storage", "activeTab", "declarativeNetRequest", "contextMenus"], "commands": {"translate-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Translate the current selection"}, "translate-page": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Translate the whole page (again to undo)"}, "translate-input": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Translate what you are typing"}}, "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["pdfjs/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "OpenRead", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_end", "js": ["content-scripts/content.js"], "match_origin_as_fallback": true}]}