{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RewardedTV Netflix Helper", "description": "Connect your Netflix watch history to RewardedTV after you sign in normally in Chrome.", "version": "0.2.7", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "RewardedTV Netflix", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["cookies", "storage", "tabs", "alarms", "scripting"], "host_permissions": ["https://www.netflix.com/*", "https://netflix.com/*", "https://*.netflix.com/*", "https://rewardedtv.plink.com/*"], "externally_connectable": {"matches": ["https://rewardedtv.plink.com/*"]}, "content_scripts": [{"matches": ["https://rewardedtv.plink.com/*"], "js": ["content-bridge.js"], "run_at": "document_start"}]}