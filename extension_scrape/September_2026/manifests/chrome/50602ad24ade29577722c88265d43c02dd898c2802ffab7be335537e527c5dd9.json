{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mind the Tab", "version": "1.1.0", "description": "Stick a note on any web page. Come back later, your note's still there. Notes stay on your device.", "permissions": ["storage", "contextMenus", "scripting", "activeTab"], "background": {"service_worker": "src/sw.js"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["src/store.js", "src/content/emoji-picker.js", "src/content/Note.js", "src/content/boot.js"]}], "web_accessible_resources": [{"resources": ["src/content/overlay.css", "src/content/emoji-data.json"], "matches": ["<all_urls>"]}], "commands": {"add-note": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Add a sticky note to this page"}, "toggle-notes": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Hide or show all sticky notes on this page"}}}