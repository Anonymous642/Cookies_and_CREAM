{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Afflow - AliExpress & Amazon Product Importer", "version": "1.2.1", "description": "Import AliExpress and Amazon products directly to your Afflow system with one click", "permissions": ["storage"], "host_permissions": ["https://*.aliexpress.com/*", "https://*.amazon.com/*", "https://*.amazon.es/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.it/*", "https://*.amazon.co.jp/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.aliexpress.com/item/*.html*", "https://*.aliexpress.us/item/*.html*"], "js": ["shared/utils.js", "content/scraper.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.aliexpress.com/w/*", "https://*.aliexpress.us/w/*", "https://*.aliexpress.com/wholesale*", "https://*.aliexpress.us/wholesale*", "https://*.aliexpress.com/store/*", "https://*.aliexpress.us/store/*"], "js": ["shared/utils.js", "content/list-scraper.js", "content/list-content.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.com/*/dp/*", "https://*.amazon.com/dp/*", "https://*.amazon.es/*/dp/*", "https://*.amazon.es/dp/*", "https://*.amazon.co.uk/*/dp/*", "https://*.amazon.co.uk/dp/*", "https://*.amazon.de/*/dp/*", "https://*.amazon.de/dp/*", "https://*.amazon.fr/*/dp/*", "https://*.amazon.fr/dp/*", "https://*.amazon.it/*/dp/*", "https://*.amazon.it/dp/*", "https://*.amazon.co.jp/*/dp/*", "https://*.amazon.co.jp/dp/*"], "js": ["shared/utils.js", "content/amazon-scraper.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}