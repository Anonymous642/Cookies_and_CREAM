{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lillabr", "version": "1.0.2", "description": "Capture a page or selected element from Chrome and bring supported content into Figma as editable layers.", "homepage_url": "https://lillabr.com/", "minimum_chrome_version": "120", "action": {"default_title": "Lillabr \u2014 show or hide the capture bar", "default_icon": {"16": "icons/icon16.png", "32": "icons/calm32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/calm32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["scripting", "downloads", "clipboardWrite", "offscreen", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"pick-element": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Pick an element to capture"}, "capture-viewport": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Capture what is on screen"}, "capture-page": {"description": "Capture the full loaded page"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"]}]}