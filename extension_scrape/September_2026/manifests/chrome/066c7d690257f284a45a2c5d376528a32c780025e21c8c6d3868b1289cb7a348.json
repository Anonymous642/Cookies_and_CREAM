{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coolbar \u2014 Canvas assignments, study planner & memory", "description": "Pulls your Canvas and Gradescope assignments into a planner that fits your week, preps you for exams, and remembers what you read.", "version": "1.17.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://coolbar.com/extension", "action": {"default_title": "Coolbar", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms", "notifications", "tabs"], "host_permissions": ["https://coolbar.com/*"], "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save this page to Coolbar"}, "highlight-selection": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Highlight the selected text with Coolbar"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://coolbar.com/*"], "run_at": "document_idle", "js": ["content-scripts/connect.js"]}, {"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://*.instructure.com/*", "https://bcourses.berkeley.edu/*", "https://canvas.emory.edu/*", "https://canvas.tufts.edu/*", "https://courseworks2.columbia.edu/*", "https://www.gradescope.com/*"], "run_at": "document_idle", "js": ["content-scripts/portal.js"]}]}