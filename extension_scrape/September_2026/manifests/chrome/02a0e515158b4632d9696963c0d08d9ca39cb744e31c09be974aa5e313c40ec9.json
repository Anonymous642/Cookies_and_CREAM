{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Website Blocker: Open Source & Ad-Free", "version": "1.5", "description": "This extension blocks website based on a list and time of the day. It is ad-free & completely open source & ad-free.", "permissions": ["webNavigation", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/48x48.png", "96": "icons/96x96.png"}, "action": {"default_popup": "popup.html", "default_title": "Simple Website Timed Blocker", "default_icon": {"48": "icons/48x48.png", "96": "icons/96x96.png", "128": "icons/128x128.png"}}}