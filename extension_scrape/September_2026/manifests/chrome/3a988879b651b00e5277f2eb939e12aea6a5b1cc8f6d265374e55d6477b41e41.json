{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteHere: Webpage Notes", "short_name": "NoteHere", "description": "Organize your workflow with notes that stay where you need them.", "version": "1.0.1", "icons": {"16": "logo-16.png", "32": "logo-32.png", "48": "logo-48.png", "128": "logo-128.png"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_title": "Open NoteHere for This Page", "default_popup": "popup.html", "default_icon": {"16": "toolbar-16.png", "19": "toolbar-19.png", "32": "toolbar-32.png", "38": "toolbar-38.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared.js", "sounds.js", "editor.bundle.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["gelpen.medium.ttf", "audio/*.wav"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}