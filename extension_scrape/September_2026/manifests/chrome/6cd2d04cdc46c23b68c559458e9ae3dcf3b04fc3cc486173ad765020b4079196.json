{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Digital Wellness Suite Website Tracker", "version": "1.1", "description": "Reports the currently focused tab's domain to the local Digital Wellness Suite app.", "permissions": ["tabs", "alarms", "webNavigation", "storage"], "host_permissions": ["http://127.0.0.1/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["interstitial.html", "interstitial.js"], "matches": ["http://*/*", "https://*/*"]}]}