{"update_url": "https://clients2.google.com/service/update2/crx", "name": "BuildBetter.ai - AI for Product Team", "version": "1.0", "manifest_version": 3, "description": "Quick access to the BuildBetter call recorder built for product teams. Usable with Google Meets, Zoom, MS Team, and Webex.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "notifications"], "host_permissions": ["https://app.buildbetter.app/*", "https://auth.buildbetter.app/*", "https://meet.google.com/*", "https://*.webex.com/*", "https://*.zoom.us/*", "https://*.teams.microsoft.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src https://app.buildbetter.app https://auth.buildbetter.app; style-src 'self' 'unsafe-inline'; frame-src https://app.buildbetter.app; default-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.buildbetter.app/desktop/tray*"], "js": ["content.js"], "css": ["content.css"], "all_frames": true, "run_at": "document_start", "match_about_blank": true, "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "chrome_style": false}}