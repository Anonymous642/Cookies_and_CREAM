{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabCraft", "version": "0.1.0", "description": "Free tab manager with smart features and organization tools.", "permissions": ["tabs", "storage", "activeTab", "alarms", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "TabCraft - Manage Your Tabs", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-current-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all current tabs"}, "open-tabcraft": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open TabCraft popup and focus search"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Open TabCraft dashboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/*", "shared/*", "docs/*"], "matches": ["<all_urls>"]}]}