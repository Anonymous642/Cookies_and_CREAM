{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sold History Tracker for eBay", "version": "1.4.3", "description": "eBay sold-history tracker with cache, Start/Pause, live 24H\u201330D counters, smart cooldowns & filtered visual search.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://www.ebay.co.uk/*", "https://www.ebay.com/*", "https://www.ebay.com.au/*", "https://www.ebay.de/*", "https://www.ebay.fr/*", "https://www.ebay.it/*", "https://www.ebay.es/*", "https://www.ebay.ca/*", "https://www.aliexpress.com/*", "https://aliexpress.com/*"], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+C", "windows": "Alt+C", "mac": "Alt+C", "chromeos": "Alt+C", "linux": "Alt+C"}, "description": "Open Sold History Tracker"}, "open-settings": {"suggested_key": {"default": "Alt+S", "windows": "Alt+S", "mac": "Alt+S", "chromeos": "Alt+S", "linux": "Alt+S"}, "description": "Open Settings"}}, "content_scripts": [{"matches": ["https://www.ebay.co.uk/itm/*", "https://www.ebay.com/itm/*", "https://www.ebay.com.au/itm/*", "https://www.ebay.de/itm/*", "https://www.ebay.fr/itm/*", "https://www.ebay.it/itm/*", "https://www.ebay.es/itm/*", "https://www.ebay.ca/itm/*"], "js": ["utils.js", "history-parser.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.ebay.co.uk/sch/*", "https://www.ebay.com/sch/*", "https://www.ebay.com.au/sch/*", "https://www.ebay.de/sch/*", "https://www.ebay.fr/sch/*", "https://www.ebay.it/sch/*", "https://www.ebay.es/sch/*", "https://www.ebay.ca/sch/*", "https://www.ebay.co.uk/str/*", "https://www.ebay.com/str/*", "https://www.ebay.co.uk/usr/*", "https://www.ebay.com/usr/*"], "js": ["utils.js", "history-parser.js", "store.js"], "css": ["store.css"], "run_at": "document_idle"}, {"matches": ["https://www.ebay.co.uk/bin/purchaseHistory*", "https://www.ebay.com/bin/pur