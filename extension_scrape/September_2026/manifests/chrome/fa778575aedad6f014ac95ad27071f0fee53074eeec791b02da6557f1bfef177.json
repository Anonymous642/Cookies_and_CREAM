{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TecInt-FetchLite", "version": "1.62.0", "description": "Webseiten als Bild erfassen und mit Anmerkungen versehen. Arbeitet vollst\u00e4ndig lokal.", "background": {"service_worker": "background.js"}, "browser_specific_settings": {"gecko": {"id": "fetchlite@tecint.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "safari": {"strict_min_version": "16.4"}, "gecko_android": {"strict_min_version": "140.0"}}, "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage", "tabs", "contextMenus", "alarms"], "optional_permissions": ["pageCapture"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "optionen/optionen.html", "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Sichtbaren Bereich erfassen"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Gesamte Seite erfassen (Auto-Scroll)"}, "capture-selection": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Ausschnitt ausw\u00e4hlen und erfassen"}, "open-editor": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Editor \u00f6ffnen"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["images/logo_dialog.png"], "matches": ["<all_urls>"]}], "homepage_url": "https://fetch.tecint.de", "optional_host_permissions": ["<all_urls>"]}