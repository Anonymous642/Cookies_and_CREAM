{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hedwig Companion", "version": "0.4.2", "description": "Colin takes meeting notes automatically in Google Meet, Zoom, Teams and Webex. No bot joins your call.", "action": {"default_title": "Hedwig Companion \u2014 automatic meeting notes (click to pause)"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "offscreen", "scripting", "storage", "tabCapture"], "host_permissions": ["*://*.google.com/*", "https://*.zoom.us/*", "https://zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.webex.com/*", "https://www.hedwig-ai.com/*", "https://hedwig-ai.com/*", "http://localhost:8080/*"], "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content-meet.js"], "run_at": "document_idle"}, {"matches": ["https://*.zoom.us/wc/*", "https://zoom.us/wc/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.webex.com/*"], "js": ["content-conf.js"], "run_at": "document_idle"}, {"matches": ["https://www.hedwig-ai.com/*", "https://hedwig-ai.com/*", "http://localhost:8080/*"], "js": ["content-hedwig.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}