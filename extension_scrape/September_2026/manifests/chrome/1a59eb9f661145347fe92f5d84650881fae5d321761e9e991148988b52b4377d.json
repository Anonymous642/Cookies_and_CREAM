{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Blurify", "description": "Blocks Google searches by keywords and optionally blurs sensitive images locally.", "version": "1.2.1", "manifest_version": 3, "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "action": {"default_title": "Blurify", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["google-guard.js"], "run_at": "document_start"}, {"matches": ["https://*/*", "http://*/*"], "js": ["dist/content.bundle.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["model/*", "blocked.html", "blocked.js"], "matches": ["https://*/*", "http://*/*"]}]}