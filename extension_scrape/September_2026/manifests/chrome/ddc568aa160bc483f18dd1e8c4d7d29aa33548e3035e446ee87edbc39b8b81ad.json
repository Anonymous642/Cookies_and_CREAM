{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lupfy Lupa", "version": "5.1.3", "description": "Pesquisa de mercado da Lupfy dentro do Mercado Livre, da Amazon e da Shopee: mercado do termo, raio-x do an\u00fancio e margem real.", "permissions": ["storage", "scripting", "sidePanel"], "host_permissions": ["https://api.mercadolibre.com/*", "https://lista.mercadolivre.com.br/*", "https://www.mercadolivre.com.br/*", "https://produto.mercadolivre.com.br/*", "https://www.amazon.com.br/*", "https://shopee.com.br/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel/index.html"}, "content_scripts": [{"matches": ["https://lista.mercadolivre.com.br/*", "https://www.mercadolivre.com.br/*", "https://produto.mercadolivre.com.br/*", "https://www.amazon.com.br/*", "https://shopee.com.br/*"], "js": ["lib/util.js", "lib/brand.js", "lib/pricing.js", "lib/ml.js", "lib/amazon.js", "lib/amazon-fees.js", "lib/shopee.js", "content/overlay.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://lupfyapp.com/*", "https://*.lupfyapp.com/*", "http://localhost:*/*"]}, "action": {"default_title": "Abrir a Lupfy Lupa", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["https://*.mercadolivre.com.br/*", "https://www.amazon.com.br/*", "https://shopee.com.br/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}