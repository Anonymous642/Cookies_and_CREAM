{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mybrary - Save Links Instantly", "version": "1.0.2", "description": "Save links to your Mybrary digital library with one click. Auto-extract metadata and organize into collections.", "permissions": ["activeTab", "tabs", "contextMenus", "storage", "notifications"], "host_permissions": ["https://appauth.mybrary.ai/*"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Save to Mybrary", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png"}}, "options_page": "src/options/index.html", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "commands": {"save-current-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Mybrary"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}}}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["src/content/*"], "use_dynamic_url": false}]}