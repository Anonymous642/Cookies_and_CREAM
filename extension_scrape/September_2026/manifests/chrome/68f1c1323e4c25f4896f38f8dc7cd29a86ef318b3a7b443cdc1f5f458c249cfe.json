{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CloudStation", "version": "1.2.0", "description": "Sync your browser login sessions to CloudStation sandbox. One click \u2014 your agents can use your accounts.", "permissions": ["cookies", "scripting", "activeTab", "storage"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.github.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "https://app.cloud-station.io/*", "https://api.cloud-station.io/*", "*://*.usecloudstation.com/*"], "background": {"service_worker": "dist/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://app.cloud-station.io/*", "*://*.usecloudstation.com/*"], "js": ["dist/app-installed-signal.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CloudStation", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}