{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClearFeed - Focus & Time Tracker", "description": "Reduce distractions on YouTube and track your usage time. Hide shorts, comments, recommendations, and thumbnails to maintain focus.", "version": "1.0.0", "short_name": "ClearFeed", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "homepage_url": "https://clearfeed.app", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "ClearFeed", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/content.js"]}]}