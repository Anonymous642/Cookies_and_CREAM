{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CanDoYa - Tool Search", "short_name": "CanDoYa", "version": "1.0.0", "description": "Search every free CanDoYa tool from a side panel in any tab. Favorites and recents stay in sync with candoya.com.", "minimum_chrome_version": "116", "homepage_url": "https://candoya.com/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CanDoYa tool search", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "permissions": ["sidePanel", "storage"], "host_permissions": ["https://candoya.com/*"], "omnibox": {"keyword": "cd"}, "commands": {"open-panel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open CanDoYa tool search"}}, "content_scripts": [{"matches": ["https://candoya.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}