{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StepSkript \u2014 Step-by-Step Guide Recorder", "short_name": "StepSkript", "version": "1.0.1", "description": "Record your clicks and turn them into editable step-by-step guides. 100% local.", "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "StepSkript Recorder"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"stop-recording": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Stop recording and open editor"}}, "web_accessible_resources": [{"resources": ["editor.html", "privacy.html"], "matches": ["<all_urls>"]}]}