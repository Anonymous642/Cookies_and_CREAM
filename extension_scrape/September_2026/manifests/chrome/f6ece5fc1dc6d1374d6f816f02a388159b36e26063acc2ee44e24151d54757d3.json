{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptZap: AI Prompt Security & Enhancer", "short_name": "PromptZap", "version": "1.7.0", "description": "Catches API keys, passwords & PII the moment you hit send on ChatGPT, Claude, Gemini & Grok \u2014 and rewrites prompts expert-level.", "permissions": ["storage", "sidePanel", "contextMenus"], "side_panel": {"default_path": "sidepanel/index.html"}, "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://grok.x.ai/*", "https://x.com/*", "https://api.openai.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://grok.x.ai/*", "https://x.com/*"], "js": ["content.js"], "css": ["assets/content.css"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"trigger-enhancement": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Enhance active prompt"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}