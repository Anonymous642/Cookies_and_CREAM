{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Old Google Icons", "version": "1.1.0", "description": "Restores the pre-2026 Google Workspace icons (Gmail, Drive, Docs, Calendar, etc.) \u2014 undoing the May 2026 gradient redesign.", "minimum_chrome_version": "108", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.google.com/*", "*://*.gstatic.com/*", "*://*.googleusercontent.com/*"], "declarative_net_request": {"rule_resources": [{"id": "icon_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.google.com/*", "*://docs.google.com/*", "*://drive.google.com/*", "*://mail.google.com/*", "*://calendar.google.com/*", "*://meet.google.com/*", "*://chat.google.com/*", "*://keep.google.com/*", "*://vids.google.com/*", "*://voice.google.com/*", "*://tasks.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["icons/*.svg", "icons/*.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/extension-16.png", "48": "icons/extension-48.png", "128": "icons/extension-128.png"}, "action": {"default_title": "Old Google Icons \u2013 active", "default_icon": {"16": "icons/extension-16.png", "48": "icons/extension-48.png", "128": "icons/extension-128.png"}}}