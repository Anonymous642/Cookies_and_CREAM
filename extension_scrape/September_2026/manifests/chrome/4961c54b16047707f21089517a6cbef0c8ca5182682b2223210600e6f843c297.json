{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vroom Reposter", "version": "1.1.4", "description": "List cars from any dealership inventory website to Facebook Marketplace and Kijiji. Fills the listing and photos; you press Publish.", "permissions": ["storage", "tabs", "scripting", "alarms", "notifications", "sidePanel", "unlimitedStorage", "activeTab"], "host_permissions": ["https://*.vroommotors.ca/*", "https://prod.pictures.autoscout24.net/*", "https://*.facebook.com/*", "https://*.kijiji.ca/*", "https://*.kijijiautos.ca/*", "https://api.anthropic.com/*", "https://extensionpay.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "panel/panel.html"}, "action": {"default_title": "Vroom Reposter", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.vroommotors.ca/*"], "js": ["lib/dom.js", "content/vroom.js"], "run_at": "document_idle"}, {"matches": ["https://*.facebook.com/*"], "js": ["lib/dom.js", "lib/groups.js", "content/facebook.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://*.kijiji.ca/*", "https://*.kijijiautos.ca/*"], "js": ["lib/dom.js", "content/kijiji.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}], "optional_host_permissions": ["<all_urls>"]}