{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Snappy Screenshot Capture", "version": "1.0.0", "description": "Capture full-page screenshots, record tab video+audio, and manage settings via Admin.", "permissions": ["tabs", "scripting", "downloads", "debugger", "activeTab", "contextMenus", "storage", "tabCapture", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Snappy Screenshot Capture", "default_icon": {"16": "icons/icon48.png", "48": "icons/icon64.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon48.png", "48": "icons/icon64.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "admin.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["sounds/camera.mp3"], "matches": ["<all_urls>"]}], "commands": {"capture-photo": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Capture screenshot (uses Admin setting: Full page or Visible area)"}, "open-admin": {"suggested_key": {"default": "Ctrl+Shift+A"}, "description": "Open Admin page"}, "toggle-video": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Start/Stop tab video recording"}}}