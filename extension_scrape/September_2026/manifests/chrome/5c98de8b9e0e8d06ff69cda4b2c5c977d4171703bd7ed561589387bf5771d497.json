{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Color Picker \u2013 Eye Dropper & Palette Generator", "description": "Pick colors, generate palettes, export to JSON/CSS/ASE.", "version": "1.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "downloads", "tabs"], "host_permissions": ["https://tally.so/*", "http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"service_worker": "background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://tally.so"}, "web_accessible_resources": [{"resources": ["icons/*", "popup/popup.html"], "matches": ["chrome-extension://*/*"]}]}