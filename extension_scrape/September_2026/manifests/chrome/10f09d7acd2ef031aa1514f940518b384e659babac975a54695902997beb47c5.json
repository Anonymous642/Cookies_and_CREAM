{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Coutiq \u2014 Try On Anything", "short_name": "Coutiq", "description": "Right-click any image on the web to virtually try it on or save it to your Coutiq closet. Syncs with the Coutiq mobile app.", "version": "0.3.2", "minimum_chrome_version": "116", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open Coutiq side panel", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "popup/popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "contextMenus", "storage", "unlimitedStorage", "identity", "scripting", "notifications", "sidePanel"], "host_permissions": ["https://api.getcoutiq.com/*", "https://getcoutiq.com/*", "https://storage.googleapis.com/*"], "web_accessible_resources": [{"resources": ["assets/*", "assets/fonts/*", "assets/mascots/*", "icons/*", "viewer/viewer.html"], "matches": ["<all_urls>"]}]}