{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Make Opaque", "version": "1.2", "description": "Eliminate screen clutter and guide your eyes with a customizable reading overlay. Perfect for deep focus, ADHD, and reading fatigue.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "Make Opaque", "default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "background.js"}, "commands": {"toggle-active": {"suggested_key": {"default": "Alt+O", "mac": "Alt+O"}, "description": "Enable or disable Make Opaque"}, "toggle-lock": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Lock or unlock the opening"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}