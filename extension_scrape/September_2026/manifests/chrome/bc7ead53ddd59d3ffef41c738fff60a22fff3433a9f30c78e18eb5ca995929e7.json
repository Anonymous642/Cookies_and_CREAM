{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickQR", "version": "1.0", "description": "Generate QR codes for the current tab's URL", "permissions": ["activeTab"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/qr_share.png", "48": "icons/qr_share128x128.png", "128": "icons/qr_share1280x800.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}]}