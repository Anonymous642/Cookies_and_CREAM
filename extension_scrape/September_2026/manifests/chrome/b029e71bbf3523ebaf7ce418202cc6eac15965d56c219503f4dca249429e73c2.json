{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Mealist Recipe Manager", "version": "1.0.0", "description": "Save recipes from any website with Mealist", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["http://recipe-manager.test/*", "https://my.mealistapp.com/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*.ttf", "lib/*"], "matches": ["<all_urls>"]}]}