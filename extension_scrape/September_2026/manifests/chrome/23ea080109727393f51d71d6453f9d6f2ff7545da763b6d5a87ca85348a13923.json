{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PageCrawl - Website Change Monitor", "version": "1.6.0", "description": "Monitor any website for changes. Track prices, content updates, and visual changes directly from your browser.", "author": "PageCrawl.io", "homepage_url": "https://pagecrawl.io", "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "storage"], "externally_connectable": {"matches": ["https://pagecrawl.io/*"]}, "host_permissions": ["https://pagecrawl.io/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "src/background/background-chrome.js"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "src/options/options.html", "web_accessible_resources": [{"resources": ["src/content/overlay.css", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}}}, "content_scripts": [{"matches": ["https://pagecrawl.io/app/extension/auth/*"], "js": ["src/content/auth-bridge.js"], "run_at": "document_start"}]}