{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HorizantalTabs \u2014 Horizontal Tab Bar & Search", "version": "1.4.2", "description": "Too many Chrome tabs? Keep every title readable in a horizontal tab bar with search, drag, groups, pins, and one-click switching.", "permissions": ["tabs", "activeTab", "tabGroups", "storage", "scripting", "favicon"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["floater.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["nudge-toast.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "license.js"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Open HorizantalTabs popup"}, "toggle_floater": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Toggle floating tab bar"}, "toggle_presenter": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Toggle Presenter Mode"}}}