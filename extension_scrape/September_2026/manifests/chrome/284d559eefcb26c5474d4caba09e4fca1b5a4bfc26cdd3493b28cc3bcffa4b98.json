{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YOMI \u2014 Japanese Reader", "short_name": "YOMI", "version": "1.0.0", "minimum_chrome_version": "116", "description": "Read selected Japanese with local furigana and Kana or Romaji conversion.", "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_title": "Open YOMI Reader", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"read-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Read the current Japanese selection in YOMI"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}