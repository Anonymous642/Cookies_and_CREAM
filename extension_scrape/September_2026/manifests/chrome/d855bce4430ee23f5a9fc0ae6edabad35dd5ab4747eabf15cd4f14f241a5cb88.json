{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Token Tracker", "version": "1.3.0", "description": "Track ChatGPT token usage and costs in real-time", "icons": {"128": "icons/icon.png"}, "action": {"default_title": "ChatGPT Token Tracker", "default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon.png"}}, "permissions": ["storage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://*.azure-automation.net/*", "https://*.logic.azure.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/content.js"], "run_at": "document_start"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/widget.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["content/inject.js"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]}]}