{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StarDeck", "version": "0.1.1", "description": "Browse, tag, sort, and view your GitHub stars.", "permissions": ["storage", "sidePanel"], "host_permissions": ["https://api.github.com/*", "https://github.com/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_title": "StarDeck", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open-stardeck": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open StarDeck side panel"}}, "side_panel": {"default_path": "popup/popup.html"}, "options_ui": {"page": "options/settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content/github.js"], "css": ["content/github.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}