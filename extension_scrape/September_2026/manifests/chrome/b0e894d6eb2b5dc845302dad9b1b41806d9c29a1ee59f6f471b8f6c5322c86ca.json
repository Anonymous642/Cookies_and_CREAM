{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Enhanced Marinara\u2122: Pomodoro\u00ae Assistant", "description": "Pomodoro\u00ae time management assistant, polished and enhanced.", "version": "1.2.1", "author": "Burak Kadir Er | Ksenofanex", "homepage_url": "https://github.com/Ksenofanex/enhanced-marinara", "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": "images/browser-action.png", "default_popup": "popup.html"}, "icons": {"16": "images/16.png", "48": "images/48.png", "128": "images/128.png"}, "commands": {"toggle-timer": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Start, pause, or resume the timer"}, "start-focus": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Start a focus session"}, "stop-timer": {"description": "Stop the current timer"}, "open-history": {"description": "Open Pomodoro history"}}, "background": {"service_worker": "js/background.js"}, "permissions": ["alarms", "storage", "contextMenus", "notifications", "offscreen"], "web_accessible_resources": [{"resources": ["phaseComplete.html", "offscreen.html", "images/*", "audio/*"], "matches": ["chrome-extension://*/*"]}]}