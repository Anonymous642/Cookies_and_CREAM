{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The Side Quest", "short_name": "Desktop personalized wallpapers", "version": "2.1", "description": "Personalize your new tab with beautiful wallpapers and videos from Pinterest and Unsplash.", "author": "The Side Quest", "permissions": ["storage", "alarms", "activeTab"], "host_permissions": ["https://*.pinterest.com/*", "https://i.pinimg.com/*", "https://*.pinimg.com/*", "https://*.googleusercontent.com/*", "https://unsplash.com/*", "https://images.unsplash.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: http: data: blob:; media-src 'self' https: http: data: blob:;"}, "action": {"default_popup": "popup.html", "default_title": "Pinterest Aesthetic Wallpapers", "default_icon": {"48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.pinterest.com/*"], "js": ["pinterest-content-script.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://unsplash.com/*"], "js": ["unsplash-content-script.js"], "run_at": "document_end", "all_frames": false}], "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon48.png", "48": "icons/icon48.png", "128": "icons/icon48.png"}, "web_accessible_resources": [{"resources": ["viewer.html", "inject-interceptor.js", "data/base-collections.json", "images/*"], "matches": ["<all_urls>"]}]}