{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GuardianBlock", "version": "1.2", "description": "A simple URL and keyword blocker.", "permissions": ["webRequest", "storage", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "images/*"], "matches": ["<all_urls>"]}]}