{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SimpliSnap - Minimalist Screenshot Tool", "version": "1.1.0", "description": "Capture visible tab, full page, or custom area and copy directly to clipboard.", "permissions": ["activeTab", "scripting", "contextMenus", "notifications", "offscreen", "clipboardWrite", "debugger", "storage", "downloads"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"capture_visible": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Capture visible tab"}, "capture_full": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Capture full page"}, "capture_area": {"suggested_key": {"default": "Alt+Shift+3"}, "description": "Capture selected area"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}