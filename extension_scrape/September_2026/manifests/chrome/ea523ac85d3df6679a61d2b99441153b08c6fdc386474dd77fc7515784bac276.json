{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PureScreen \u2014 Screen Recorder & Webcam", "description": "Record your screen, a window, or a tab with a webcam bubble, mic, and system audio. Private, processed on your device.", "version": "1.0.1", "short_name": "PureScreen", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["offscreen", "storage", "unlimitedStorage", "tabs"], "minimum_chrome_version": "116", "action": {"default_title": "PureScreen \u2014 Screen Recorder & Webcam", "default_popup": "recorder.html"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Start or stop recording"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Command+Shift+P"}, "description": "Pause or resume recording"}}, "background": {"service_worker": "background.js"}}