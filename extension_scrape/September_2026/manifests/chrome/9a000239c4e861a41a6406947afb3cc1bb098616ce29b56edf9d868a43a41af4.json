{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Budolinks Save", "version": "1.0.0", "description": "Save links to your hub from any tab\u2014turn them into a link-in-bio or mini storefront you can share anywhere.", "action": {"default_title": "Save to Budolinks", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://budolinks.com/*", "https://www.budolinks.com/*", "http://localhost:3000/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "externally_connectable": {"matches": ["https://budolinks.com/*", "https://www.budolinks.com/*", "http://localhost:3000/*"]}}