{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AmaDrop Price Tracker", "description": "Track Amazon prices and get notified on any price drops or set custom targets!", "version": "1.0.0", "icons": {"16": "icons/AmaDrop-16.png", "48": "icons/AmaDrop-48.png", "128": "icons/AmaDrop-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Amazon Price Tracker"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.com.au/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "notifications", "offscreen", "identity"], "host_permissions": ["*://*.amazon.com/", "*://*.amazon.com.au/", "*://*.amazon.co.uk/", "*://*.amazon.ca/", "*://charts.camelcamelcamel.com/"]}