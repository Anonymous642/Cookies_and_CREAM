{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Post Chatter", "version": "1.1.0", "description": "Adds a 'Discuss with ChatGPT' button to posts on LinkedIn, X, and Reddit so you can discuss them in ChatGPT with one click.", "permissions": ["storage", "clipboardWrite"], "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.reddit.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Post Chatter settings"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}