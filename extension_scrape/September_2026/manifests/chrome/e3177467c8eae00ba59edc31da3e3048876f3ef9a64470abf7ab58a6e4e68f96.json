{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tredy - AI Browser Safety & Productivity", "description": "Monitor browser actions against your policies, contracts, regulations, and sensitive-data rules.", "version": "0.8.16", "permissions": ["activeTab", "management", "scripting", "sidePanel", "storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Tredy", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Tredy native side panel"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/shared/extensionApi.js", "content/shared/featureRegistry.js", "content/shared/commandBus.js", "content/shared/placement.js", "content/shared/surfaceManager.js", "content/surfaces/selection/toolbar.js", "content/surfaces/security/review.js", "content/surfaces/search/answer.js", "content/surfaces/search/card.js", "content/surfaces/link/preview.js", "content/surfaces/image/tools.js", "content/surfaces/context/chip.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["sidepanel.html", "sidepanel.css", "sidepanel.js", "tredy-logo.png", "tredy-header-logo.png", "selection-icon.png", "icon-16.png", "icon-32.png", "icon-48.png", "icon-128.png"], "matches": ["http://*/*", "https://*/*"]}]}