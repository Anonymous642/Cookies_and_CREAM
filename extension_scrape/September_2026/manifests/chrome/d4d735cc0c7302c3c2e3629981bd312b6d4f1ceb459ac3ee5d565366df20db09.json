{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Conicia Chart Companion", "version": "0.7.0", "description": "Opens the Conicia dashboard for the patient whose chart you're viewing in PracticeQ, SimplePractice, or TherapyNotes.", "permissions": ["storage"], "optional_host_permissions": ["https://intakeq.com/*", "https://*.practiceq.com/*", "https://secure.simplepractice.com/*", "https://www.therapynotes.com/*"], "externally_connectable": {"matches": ["https://clinician.conicia.com/*", "https://dashboard.conicia.com/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Conicia Chart Companion", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}