{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Promptbolt", "version": "1.0.4", "description": "Save, organize, and quickly reuse your AI prompts from a convenient side panel.", "homepage_url": "https://promptbolt.app/", "permissions": ["sidePanel", "storage", "scripting", "tabs"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Open Promptbolt"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "index.html"}, "commands": {"prompt-slot-1": {"suggested_key": {"default": "Ctrl+1", "mac": "Command+1"}, "description": "Run prompt #1 (by list order)"}, "prompt-slot-2": {"suggested_key": {"default": "Ctrl+2", "mac": "Command+2"}, "description": "Run prompt #2 (by list order)"}, "prompt-slot-3": {"suggested_key": {"default": "Ctrl+3", "mac": "Command+3"}, "description": "Run prompt #3 (by list order)"}, "open-promptbolt": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open Promptbolt side panel"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}