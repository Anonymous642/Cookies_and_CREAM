{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BIMUSIC Bilibili Importer", "version": "0.1.0", "description": "Import Bilibili videos and collections into the local BIMUSIC app.", "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "permissions": [], "host_permissions": ["http://127.0.0.1:43124/*", "https://api.bilibili.com/*", "https://space.bilibili.com/*", "https://www.bilibili.com/video/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["https://space.bilibili.com/*", "https://www.bilibili.com/*"]}], "content_scripts": [{"matches": ["https://space.bilibili.com/*/favlist*", "https://www.bilibili.com/video/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}