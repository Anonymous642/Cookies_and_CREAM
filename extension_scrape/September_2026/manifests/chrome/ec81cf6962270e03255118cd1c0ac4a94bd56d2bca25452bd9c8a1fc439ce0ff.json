{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Drive Folder Cloner", "version": "1.0.1", "description": "Clone entire Google Drive folder structures instantly with one click.", "author": "Drive Cloner", "permissions": ["identity", "storage", "alarms", "notifications", "contextMenus"], "host_permissions": ["https://drive.google.com/*", "https://docs.google.com/*", "https://responsible-commitment-production-4d03.up.railway.app/*"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "action": {"default_popup": "popup/index.html", "default_title": "Drive Folder Cloner", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["content/content-script.js"], "css": ["content/content-styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png", "content/content-styles.css"], "matches": ["https://drive.google.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}