{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoilaCapture", "version": "1.0.0", "description": "Capture a full-page screenshot, stitch it into one image, and download as PNG or PDF.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Full Page Screenshot (Alt+Shift+P)"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"capture": {"suggested_key": {"default": "Alt+Shift+P", "windows": "Alt+Shift+P", "mac": "Alt+Shift+P", "linux": "Alt+Shift+P"}, "description": "Capture full page screenshot"}}, "web_accessible_resources": [{"resources": ["capture.html", "capture.css", "capture.js", "sortable.min.js"], "matches": ["<all_urls>"]}]}