{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptStash: AI Prompt Manager for ChatGPT, Claude & Gemini", "version": "1.0.5", "description": "Save, organize & insert your AI prompts in one keystroke. A fast, private, local-first prompt manager for ChatGPT, Claude & Gemini.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "PromptStash", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js"}, "permissions": ["storage"], "host_permissions": ["https://extensionpay.com/*"], "commands": {"open-picker": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the prompt picker"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://poe.com/*"], "js": ["src/storage.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["src/ExtPay.js"], "run_at": "document_start"}], "options_page": "src/options.html", "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["<all_urls>"]}]}