{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Recent Tabs Picker", "version": "1.0.0", "description": "Press Alt+Q to switch between your recently used tabs with a thumbnail picker \u2014 just like Alt+Tab, but for browser tabs.", "permissions": ["tabs", "storage", "scripting", "favicon"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["overlay/overlay.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Recent Tabs Picker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"open-switcher": {"suggested_key": {"default": "Alt+Q"}, "description": "Open the recent tabs switcher"}}, "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"]}]}