{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Graphite PR Tools \u2014 Open in GitHub & Copy Links", "version": "1.2.0", "description": "Open any Graphite PR on GitHub, copy shareable PR links for Slack or Teams, and toggle between Graphite and GitHub in one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://app.graphite.com/*", "https://app.graphite.dev/*", "https://github.com/*/pull/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}