{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Pixilart Gallery Exporter", "author": "drewpixelart@gmail.com", "version": "1.1.1", "description": "Creates a .zip of the user's gallery on pixilart.com. Please note this is an unofficial creation with no afiliation to Pixilart", "icons": {"16": "icon.png", "32": "icon.png", "64": "icon.png", "128": "icon.png"}, "action": {"default_popup": "index.html", "default_title": "Gallery Exporter"}, "permissions": ["storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "content_scripts": "script-src 'self' https://cdnjs.cloudflare.com/; object-src 'self'"}, "content_scripts": [{"matches": ["https://www.pixilart.com/*"], "js": ["content.js"], "run_at": "document_start"}]}