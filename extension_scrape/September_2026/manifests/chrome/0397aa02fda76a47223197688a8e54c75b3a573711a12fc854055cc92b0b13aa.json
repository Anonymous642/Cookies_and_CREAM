{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Flex Web To AE", "version": "1.0.3", "description": "Capture any live web page and send it to After Effects as native, editable text and vector layers.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Send this page to After Effects", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["capture_engine.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"send-to-ae": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Send the current page to After Effects"}, "toggle-button": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Show or hide the on-page Send to AE button"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}