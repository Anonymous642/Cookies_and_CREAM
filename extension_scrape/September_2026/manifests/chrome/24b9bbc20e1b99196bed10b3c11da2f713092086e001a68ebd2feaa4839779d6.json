{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Notes extension for each website (Context separated)", "description": "Save notes tied to each website. Open the panel, type\u2014saved automatically. No account, no cloud; everything stays in your browser.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}