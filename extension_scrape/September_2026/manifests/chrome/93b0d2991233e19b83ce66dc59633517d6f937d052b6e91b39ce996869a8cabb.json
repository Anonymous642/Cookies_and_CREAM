{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ghost Gemini - Launch Gemini with Short cut Key", "version": "1.1.0", "description": "Native Gemini Experience in your Side Panel", "icons": {"16": "icon128.png", "48": "icon128.png", "128": "icon128.png"}, "permissions": ["sidePanel", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "contextMenus", "storage"], "host_permissions": ["https://gemini.google.com/*"], "side_panel": {"default_path": "panel.html"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "assets/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["assets/content.js"], "all_frames": true, "run_at": "document_end"}], "action": {"default_title": "Open GhostGemini", "default_icon": "icon128.png"}, "commands": {"open_side_panel": {"suggested_key": {"default": "Ctrl+J", "mac": "Command+J"}, "description": "Open GhostGemini Side Panel"}}}