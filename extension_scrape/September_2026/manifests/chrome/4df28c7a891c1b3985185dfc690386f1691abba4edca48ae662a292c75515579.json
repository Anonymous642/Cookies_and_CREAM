{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Post Formatter", "version": "1.0.10", "default_locale": "en", "description": "Format LinkedIn text with bold, italic, underline, bullet points, and emojis using a selection toolbar.", "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "LinkedIn Formatter Dashboard"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["toolbar.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "toolbar.css"], "matches": ["<all_urls>"]}]}