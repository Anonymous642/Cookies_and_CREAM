{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LingoFlow: Auto Inline Translator", "version": "1.4", "description": "Auto-translate text directly inside any chat or input field without switching tabs. Powered by AI", "permissions": ["storage", "activeTab", "scripting", "identity"], "host_permissions": ["https://*/*", "http://localhost/*", "https://generativelanguage.googleapis.com/*", "https://api.deepl.com/*", "https://api-free.deepl.com/*", "https://openrouter.ai/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://oauth2.googleapis.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/app-config.js", "content/content.js"], "all_frames": true, "run_at": "document_idle"}], "commands": {"translate-active-input": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Translate the focused editable field"}, "translate-selection": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Translate selected text on the page"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}