{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Readiant", "version": "0.1.0", "homepage_url": "https://studioonelabs.com/readiant", "description": "Reader-side accessibility overlay. Local-first: all reading transforms and system text-to-speech run on your device, free forever.", "minimum_chrome_version": "116", "action": {"default_title": "Readiant", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "options_page": "src/options/options.html", "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["src/content/content.css", "fonts/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-reading": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle Reading / Original view on this site"}, "toggle-tts": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play / pause reading aloud"}}}