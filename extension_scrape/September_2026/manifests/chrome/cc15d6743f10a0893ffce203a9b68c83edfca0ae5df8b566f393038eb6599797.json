{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AdsClap - Elegibility Checker", "description": "This extension checks if a website is elegible to receive an MCM Google AdManager agreement invitation from AdsClap", "version": "2.0.2", "manifest_version": 3, "icons": {"48": "img/logo-128.png", "128": "img/logo-128.png"}, "permissions": ["scripting", "tabs"], "host_permissions": ["http://localhost:3000/*", "https://adsclap.com/*", "https://preview.adsclap.com/*", "https://admanager.google.com/*", "https://payments.google.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["http://localhost:3000/*", "https://adsclap.com/*", "https://preview.adsclap.com/*"], "js": ["content/website-bridge.js"], "css": ["styles.css"]}, {"matches": ["https://admanager.google.com/*"], "js": ["content/admanager.js"], "css": ["styles.css"]}, {"matches": ["https://payments.google.com/payments/u/*/timelineview*"], "js": ["content/payment-iframe.js"], "all_frames": true}], "web_accessible_resources": [{"resources": ["content/admanager.js", "content/payment-iframe.js", "content/website-bridge.js", "background.js", "styles.css"], "matches": ["http://localhost:3000/*", "https://admanager.google.com/*", "https://payments.google.com/*", "https://adsclap.com/*", "https://preview.adsclap.com/*"]}]}