{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Spotlight Search: Cross-window Tab Search, Navigation and Management", "short_name": "Tab Spotlight Search", "version": "1.2.0", "description": "Search, Navigate & Manage Tabs Across Windows Instantly. #NoTabLeftBehind", "author": "Aniket Singh", "homepage_url": "https://github.com/anikxtsingh", "permissions": ["tabs", "scripting", "sessions", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Open Tab Spotlight Search"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"open-spotlight": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open Tab Spotlight Search"}}}