{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Yump! YouTube Jumplist with Watch Counter", "version": "1.1", "description": "Add YouTube videos to a fast-access jumplist that remembers what you\u2019ve watched and how many times.", "icons": {"128": "images/icon128.png"}, "action": {"default_popup": "popup/popup.html"}, "permissions": ["scripting", "storage", "identity", "identity.email"], "options_page": "options/options.html", "background": {"service_worker": "service_worker.js", "type": "module"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "css": ["yumpbar/yumpbar.css"], "js": ["yumpbar/yumpbar.js"], "run_at": "document_idle"}]}