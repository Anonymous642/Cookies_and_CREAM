{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BOSS Workload", "short_name": "BOSS Workload", "description": "Capture pages into BOSS Workload, or jump straight to the SPA.", "version": "1.7.1", "homepage_url": "https://workload.bosslogics.com/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "tabs", "scripting", "contextMenus", "clipboardWrite", "tabCapture", "offscreen", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://workload.bosslogics.com/*", "https://api.workload.bosslogics.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "BOSS Workload", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"file-bug": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "File a bug with the current page captured"}, "select-region": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Select a region of the page and copy to clipboard"}, "record-video": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Record a short video of the current tab"}}, "content_scripts": [{"matches": ["https://workload.bosslogics.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://workload.bosslogics.com/*"], "js": ["content-error-toast.js"], "run_at": "document_idle", "all_frames": false}]}