{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Code2Commit", "version": "1.0.1", "description": "Push LeetCode solutions to GitHub", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["storage", "identity", "cookies"], "host_permissions": ["*://leetcode.com/*", "*://api.github.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://leetcode.com/problems/*"], "js": ["content.js"]}]}