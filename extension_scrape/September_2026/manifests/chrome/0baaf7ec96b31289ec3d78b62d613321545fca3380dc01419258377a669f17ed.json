{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnippKit Saver", "version": "2.1", "description": "Right-click to save selected code to SnippKit.", "permissions": ["contextMenus", "storage", "scripting", "activeTab"], "commands": {"save_to_snippkit": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save selected code to SnippKit"}}, "host_permissions": ["https://snippkit.com/*", "https://www.snippkit.com/*"], "externally_connectable": {"matches": ["https://snippkit.com/*", "https://www.snippkit.com/*"]}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["src/*", "src/*/*", "src/ui/*", "src/shared/*", "icons/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}