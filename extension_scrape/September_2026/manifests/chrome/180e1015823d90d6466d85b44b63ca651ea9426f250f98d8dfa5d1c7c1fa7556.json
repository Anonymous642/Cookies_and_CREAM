{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spotify-Web Playback Controller", "version": "2026.8.10", "description": "Complete Spotify-Web playback control with track navigation, volume and keyboard control.", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["https://open.spotify.com/*", "https://accounts.spotify.com/*"], "action": {"default_popup": "popup.html", "default_title": "Spotify-Web Playback Controller", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "sw.js", "type": "module"}, "web_accessible_resources": [{"resources": ["dashboard.html", "onboarding.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://open.spotify.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"next-track": {"suggested_key": {"default": "Shift+Alt+Right"}, "description": "Next track", "global": false}, "prev-track": {"suggested_key": {"default": "Shift+Alt+Left"}, "description": "Previous track", "global": false}, "play-pause": {"suggested_key": {"default": "Shift+Alt+Up"}, "description": "Play/Pause", "global": false}, "pause": {"suggested_key": {"default": "Shift+Alt+Down"}, "description": "Pause", "global": false}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}