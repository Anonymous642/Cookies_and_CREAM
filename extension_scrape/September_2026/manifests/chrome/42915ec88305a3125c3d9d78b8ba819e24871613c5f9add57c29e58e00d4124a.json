{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Batch Collector for Mobbin", "description": "Automatically collect and batch download design screens from Mobbin Flows pages. Export as ZIP files ready to import into Figma.", "version": "0.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "activeTab", "storage", "downloads"], "host_permissions": ["https://mobbin.com/*"], "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}