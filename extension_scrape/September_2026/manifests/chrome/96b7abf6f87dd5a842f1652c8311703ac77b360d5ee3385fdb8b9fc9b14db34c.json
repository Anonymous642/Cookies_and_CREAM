{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Footprint \u2014 See who's tracking you and what they earn", "short_name": "Footprint", "version": "1.0.0", "description": "See every Site Tracker, what each one earns from you, and how it compares to other averages. 100% offline & Private.", "homepage_url": "https://github.com/your-org/privacy-inspector", "author": "Footprint Team", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "scripting", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/tracker-detector.js"], "run_at": "document_start"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Footprint", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "declarative_net_request": {"rule_resources": [{"id": "tracker_blocklist", "enabled": true, "path": "rules/tracker_blocklist.json"}]}, "web_accessible_resources": [{"resources": ["src/lib/*"], "matches": ["<all_urls>"]}], "minimum_chrome_version": "88"}