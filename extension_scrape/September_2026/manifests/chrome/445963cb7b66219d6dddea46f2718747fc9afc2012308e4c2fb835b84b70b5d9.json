{"update_url": "https://clients2.google.com/service/update2/crx", "background": {"service_worker": "background.js"}, "commands": {"nvimify": {"description": "Turn the currently focused element into a Neovim iframe.", "suggested_key": {"default": "Ctrl+E"}}, "send_C-n": {"description": "Send Ctrl-n to firenvim."}, "send_C-t": {"description": "Send Ctrl-t to firenvim."}, "send_C-w": {"description": "Send Ctrl-w to firenvim."}, "toggle_firenvim": {"description": "Toggle Firenvim in the current tab."}}, "content_scripts": [{"all_frames": true, "js": ["content.js"], "match_about_blank": true, "matches": ["<all_urls>"], "run_at": "document_start"}], "description": "Turn your browser into a Neovim GUI.", "icons": {"16": "firenvim16.png", "48": "firenvim48.png", "128": "firenvim128.png"}, "manifest_version": 3, "name": "Firenvim", "options_ui": {"page": "options.html"}, "permissions": ["alarms", "nativeMessaging", "scripting", "storage"], "version": "0.2.17", "web_accessible_resources": [{"resources": ["index.html"], "matches": ["<all_urls>"]}], "action": {"default_icon": "firenvim128.png", "default_popup": "browserAction.html", "default_title": "Firenvim"}, "host_permissions": ["<all_urls>", "file:///*"]}