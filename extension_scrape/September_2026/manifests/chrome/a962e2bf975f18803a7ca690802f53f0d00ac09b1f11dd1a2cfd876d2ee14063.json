{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VooMessage", "version": "1.7", "description": "Send LinkedIn messages and connection request on the fly.", "key": "", "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage"], "host_permissions": ["https://*.linkedin.com/*"], "externally_connectable": {"matches": ["https://voomessage.com/*"]}, "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["utils/*.js", "config.js", "messenger.js"], "matches": ["https://*.linkedin.com/*"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js", "linkedin-panel.js"], "run_at": "document_idle"}]}