{"update_url": "https://clients2.google.com/service/update2/crx", "name": "AceSkin Marketplace Trade Manager", "version": "1.0.10", "description": "Automates Steam trade offers for AceSkin marketplace transactions", "manifest_version": 3, "permissions": ["cookies", "storage", "declarativeNetRequestWithHostAccess", "alarms"], "host_permissions": ["*://steamcommunity.com/*", "*://api.steampowered.com/*", "https://www.ace.skin/*", "https://*.ace.skin/*"], "background": {"service_worker": "dist/background.js"}, "externally_connectable": {"matches": ["https://www.ace.skin/*", "https://*.ace.skin/*"]}, "declarative_net_request": {"rule_resources": [{"id": "steamcommunity_ruleset", "enabled": true, "path": "steamcommunity_ruleset.json"}]}, "icons": {"16": "src/icon-16.png", "32": "src/icon-32.png", "48": "src/icon-48.png", "128": "src/icon-128.png"}, "action": {"default_title": "AceSkin Marketplace Trade Manager", "default_popup": "popup.html", "default_icon": {"16": "src/icon-16.png", "32": "src/icon-32.png", "48": "src/icon-48.png", "128": "src/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.ace.skin/*", "https://ace.skin/*", "https://*.ace.skin/*"], "js": ["dist/content.js"], "run_at": "document_start"}]}