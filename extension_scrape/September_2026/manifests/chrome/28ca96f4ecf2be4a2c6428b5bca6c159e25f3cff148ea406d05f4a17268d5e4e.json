{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ghanari AI", "version": "1.2.29", "description": "Records Google Meet tab audio and generates a Persian transcript, meeting minutes, and action items with a customized LLM.", "permissions": ["tabCapture", "offscreen", "storage", "notifications", "unlimitedStorage", "tabs", "identity", "alarms", "scripting"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.ghanari-ai.ir/*"], "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"]}], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "\u0634\u0631\u0648\u0639 / \u067e\u0627\u06cc\u0627\u0646 \u0636\u0628\u0637 \u062c\u0644\u0633\u0647"}}, "externally_connectable": {"matches": ["https://api.ghanari-ai.ir/*", "https://ghanari-ai.ir/*", "https://*.ghanari-ai.ir/*"]}}