{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NAI Global Privacy Control Signal", "version": "1.0", "description": "Use the Global Privacy Control signal to automatically make opt-out requests as you browse the web.", "permissions": ["activeTab", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "declarativeNetRequestFeedback"], "host_permissions": ["*://*/*"], "action": {"default_area": "navbar", "default_popup": "index.html", "default_title": "GPC Control"}, "content_scripts": [{"js": ["scripts/injectScript.js"], "matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}], "icons": {"16": "gpc-logo.png", "48": "gpc-logo.png", "128": "gpc-logo.png"}, "background": {"service_worker": "scripts/worker.js"}, "web_accessible_resources": [{"resources": ["index.html", "scripts/enableGPC.js"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "secgpcrules", "enabled": false, "path": "scripts/secgpcrules.json"}]}}