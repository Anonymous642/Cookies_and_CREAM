{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Deeplet - Focus Mode", "version": "1.0.2", "description": "Blocks all sites except user-defined whitelist.", "icons": {"16": "icons/icon16.jpeg", "48": "icons/icon48.jpeg", "128": "icons/icon128.jpeg"}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "backgroundjs.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.jpeg", "48": "icons/icon48.jpeg", "128": "icons/icon128.jpeg"}}, "web_accessible_resources": [{"resources": ["top_domains.json"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["*://deeplet.net/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentjs.js"], "run_at": "document_start"}]}