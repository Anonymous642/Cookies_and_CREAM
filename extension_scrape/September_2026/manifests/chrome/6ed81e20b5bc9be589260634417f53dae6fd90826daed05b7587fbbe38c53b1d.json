{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatBlock Twitch", "version": "2.2", "description": "Ayuda a controlar tus mensajes en Twitch. Autoblock chat con advertencias y audio opcional.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pop_sound.mp3"], "matches": ["<all_urls>"]}], "host_permissions": ["*://*.twitch.tv/*"]}