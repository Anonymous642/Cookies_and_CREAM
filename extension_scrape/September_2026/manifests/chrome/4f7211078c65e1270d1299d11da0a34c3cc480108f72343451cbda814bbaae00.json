{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab to Group", "version": "1.1.1", "description": "Move current tab into one of 5 configurable tab groups using keyboard shortcuts.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}, "commands": {"move-to-group-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Move current tab to Group 1"}, "move-to-group-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Move current tab to Group 2"}, "move-to-group-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Move current tab to Group 3"}, "move-to-group-4": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Command+Shift+4"}, "description": "Move current tab to Group 4"}, "move-to-group-5": {"description": "Move current tab to Group 5"}}}