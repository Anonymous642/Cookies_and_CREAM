{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Cascade Reading", "version": "1.0.4", "manifest_version": 3, "description": "Reformats article text into a cascading, indented layout that makes reading faster and easier on the eyes.", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["loading.gif", "logo_small.png", "popup_banner.png", "content.css", "cascade_style.css", "css/*.css", "fonts.css", "fonts/*.woff2", "shadow.css", "content.js.LICENSE.txt", "popup.js.LICENSE.txt", "background.js.LICENSE.txt", "readability.js.LICENSE.txt", "goldenSites.json", "api.json"], "matches": ["<all_urls>"]}], "permissions": ["storage", "contextMenus", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Cascade Reading", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "commands": {"cascade": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle Cascade Reading on the current page"}, "reload": {"description": "Reload the extension (development helper)"}}}