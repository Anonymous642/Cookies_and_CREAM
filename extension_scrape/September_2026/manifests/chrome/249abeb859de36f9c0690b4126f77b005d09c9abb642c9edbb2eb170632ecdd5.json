{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VeruVault", "version": "0.2.0", "description": "Fill credentials from your VeruVault password manager. Everything is decrypted in the extension; VeruSuite never sees a key.", "minimum_chrome_version": "116", "background": {"service_worker": "background/worker.js", "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "VeruVault", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "alarms", "storage"], "host_permissions": ["https://vault.verusuite.com/*", "https://verusuite.com/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "all_frames": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}