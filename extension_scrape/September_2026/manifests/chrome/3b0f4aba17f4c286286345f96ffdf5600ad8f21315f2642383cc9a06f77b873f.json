{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CleanWatch", "version": "1.23.0", "description": "Reduce distractions, Shorts, and algorithmic suggestions on YouTube", "permissions": ["storage", "scripting", "declarativeNetRequest", "contextMenus", "alarms"], "host_permissions": ["*://*.youtube.com/*", "https://cleanwatch.365devnet.eu/*", "https://sponsor.ajay.app/*"], "optional_host_permissions": ["https://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_page": "settings.html", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["block.css"], "js": ["defaults.js", "i18n-content.js", "content.js"], "run_at": "document_start", "world": "ISOLATED"}, {"matches": ["*://*.youtube.com/*"], "js": ["defaults.js", "content-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://www.youtube.com/live_chat*", "*://www.youtube.com/live_chat_replay*"], "js": ["defaults.js", "livechat.js"], "run_at": "document_idle", "all_frames": true, "world": "ISOLATED"}], "declarative_net_request": {"rule_resources": [{"id": "ad_block_rules", "enabled": true, "path": "rules.json"}]}, "commands": {"toggle-cinema": {"suggested_key": {"default": "Alt+C", "mac": "MacCtrl+Shift+C"}, "description": "Toggle cinema mode"}, "toggle-related": {"suggested_key": {"default": "Alt+R", "mac": "MacCtrl+Shift+R"}, "description": "Toggle related videos"}}}