{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoiceDraft - Voice Memo Transcription", "version": "1.0.0", "description": "Capture audio from any browser tab and transform it into structured notes, emails, and action items using AI.", "homepage_url": "https://voicedraft-api.com", "permissions": ["activeTab", "tabCapture", "storage", "contextMenus", "offscreen", "notifications", "tabs", "sidePanel", "alarms"], "host_permissions": ["https://voicedraft-api.com/*", "https://*.r2.cloudflarestorage.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "default_title": "VoiceDraft"}, "icons": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "content_scripts": [{"matches": ["https://*.zoom.us/*", "https://meet.google.com/*", "https://teams.microsoft.com/*"], "js": ["src/content/meeting-detector.js"], "run_at": "document_idle"}, {"matches": ["https://voicedraft-api.com/extension-auth-complete*"], "js": ["src/content/auth-capture.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/icons/*"], "matches": ["https://*.zoom.us/*", "https://meet.google.com/*", "https://teams.microsoft.com/*"]}], "side_panel": {"default_path": "src/popup/side-panel.html"}, "options_page": "src/popup/options.html"}