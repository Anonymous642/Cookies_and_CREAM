{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EtsyAlert \u2014 New Listing Notifier", "version": "1.0.4", "description": "Get instant desktop alerts when new Etsy listings match your search. Never miss a rare find, vintage piece, or handmade drop again.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://www.etsy.com/*", "https://i.etsystatic.com/*", "https://propfirmpinescripts.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.etsy.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}