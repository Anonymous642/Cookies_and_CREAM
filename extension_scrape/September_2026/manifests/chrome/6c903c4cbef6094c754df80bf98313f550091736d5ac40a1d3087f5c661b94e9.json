{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easy Tab Switcher", "version": "1.0.4", "description": "Switch between recent tabs with keyboard shortcuts, like browser history but for tabs!", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Tab Switcher Settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"previous-tab": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "To previous tab"}, "next-tab": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "To next tab"}}}