{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Issue Notes", "description": "Add personal notes to GitHub issues and PRs", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.github.com/*"], "version_name": "1.0.0-build.0", "background": {"service_worker": "background.js"}, "action": {"default_title": "GitHub Issue Notes", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://github.com/*/*/issues/*", "https://github.com/*/*/pull/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}