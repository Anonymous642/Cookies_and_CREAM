{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VibeMind: Podcast Notes for Obsidian", "description": "VibeMind turns Spotify & YouTube transcripts into structured Obsidian notes and saves them to your local Vault in one click.", "version": "0.0.2", "icons": {"128": "icon/128.png"}, "permissions": ["activeTab", "storage", "webRequest", "webRequestAuthProvider", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*", "*://*.ytimg.com/*", "*://open.spotify.com/*", "*://spclient.wg.spotify.com/*", "*://api.spotify.com/*"], "action": {"default_icon": {"128": "icon/128.png"}, "default_title": "VibeMind", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://open.spotify.com/episode/*"], "run_at": "document_idle", "js": ["content-scripts/spotify.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}