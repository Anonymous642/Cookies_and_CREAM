{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WPTA - Translator Assistant for WordPress Projects", "short_name": "WPTA", "version": "1.0.2", "description": "Helps WordPress translators find and monitor new strings in contributed projects.", "default_locale": "en", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://profiles.wordpress.org/*", "https://translate.wordpress.org/*"], "action": {"default_icon": {"16": "images/icon/icon_green_16.png", "32": "images/icon/icon_green_32.png", "48": "images/icon/icon_green_48.png", "128": "images/icon/icon_green_128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://profiles.wordpress.org/*"], "js": ["content-script.js"]}], "icons": {"16": "images/icon/icon_green_16.png", "32": "images/icon/icon_green_32.png", "48": "images/icon/icon_green_48.png", "128": "images/icon/icon_green_128.png"}, "web_accessible_resources": [{"resources": ["main.html", "main.js", "main.css", "images/*"], "matches": ["<all_urls>"]}]}