{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ultra Smooth Autoscroll", "version": "1.0", "description": "Smooth autoscrolling with keyboard shortcuts.", "permissions": ["activeTab", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-scroll-down": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Toggle autoscroll down"}, "toggle-scroll-up": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Toggle autoscroll up"}}}