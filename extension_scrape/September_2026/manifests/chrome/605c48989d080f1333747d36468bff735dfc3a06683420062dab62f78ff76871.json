{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Classic Roblox Branding Switcher", "description": "Restore the classic ROBLOX logo and favicon on Roblox with a simple toggle and preset selector.", "version": "1.0.1", "action": {"default_title": "Classic Roblox Branding Switcher", "default_popup": "src/popup/popup.html"}, "icons": {"16": "src/assets/favicons/classic-favicon.png", "32": "src/assets/favicons/classic-favicon.png", "48": "src/assets/favicons/classic-favicon.png", "128": "src/assets/favicons/classic-favicon.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["https://*.roblox.com/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/assets/logos/*", "src/assets/favicons/*"], "matches": ["https://*.roblox.com/*"]}]}