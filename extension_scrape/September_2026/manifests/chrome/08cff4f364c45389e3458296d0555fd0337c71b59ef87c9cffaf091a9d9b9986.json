{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ArkTabs: Intelligent Spotlight Tabs Manager", "version": "3.0.9", "description": "Find and manage tabs with adaptive habit learning algorithm like AI. Fuzzy find, live previews, workspaces, automation and more.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "tabGroups", "storage", "bookmarks", "history", "sessions", "alarms", "favicon"], "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png"}}, "host_permissions": [], "commands": {"open_tab_switcher": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Open ArkTabs tab switcher"}, "toggle_mru": {"suggested_key": {"default": "Alt+L"}, "description": "Toggle between current and last-used tab"}, "cycle_mru_next": {"suggested_key": {"default": "Alt+J"}, "description": "Cycle to next MRU tab"}, "cycle_mru_prev": {"suggested_key": {"default": "Alt+K"}, "description": "Cycle to previous MRU tab"}}}