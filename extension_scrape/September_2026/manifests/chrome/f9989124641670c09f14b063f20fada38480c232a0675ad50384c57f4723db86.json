{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Desktab - Quick visual tab manager", "version": "1.4.0", "description": "Tame tab clutter instantly. Visual grid to switch, search, mute, and close tabs with Cmd+. Includes light/dark theme settings.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Toggle DeskTab overlay"}}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Toggle DeskTab (Ctrl+.)"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "content/*.js"], "matches": ["<all_urls>"]}]}