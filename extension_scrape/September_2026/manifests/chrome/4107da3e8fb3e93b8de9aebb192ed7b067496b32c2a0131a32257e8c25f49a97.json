{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabVault", "version": "1.0.2", "description": "Never lose your tabs again. Save, sync, and restore browser sessions with cloud backup.", "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "default_title": "TabVault \u2014 Save your tabs"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabs", "storage", "downloads", "activeTab", "scripting", "windows", "alarms"], "host_permissions": ["<all_urls>"], "commands": {"save_all_tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs in current window to vault"}, "save_current_tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save current active tab to vault"}, "open_dashboard": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open the TabVault dashboard"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}