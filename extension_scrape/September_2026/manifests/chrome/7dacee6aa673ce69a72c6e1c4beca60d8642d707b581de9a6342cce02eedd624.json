{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PostThisDraft", "version": "1.0.0", "description": "Turn rough technical notes into polished LinkedIn posts, without leaving LinkedIn.", "permissions": ["storage", "activeTab", "contextMenus", "unlimitedStorage", "favicon"], "host_permissions": ["https://www.linkedin.com/*", "https://postformatter-backend.vercel.app/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}]}