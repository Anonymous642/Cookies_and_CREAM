{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Easync Product ID Collector with US States Checker", "version": "1.1", "description": "Collect product IDs and variations from Amazon, with ability to check availability across all US states", "permissions": ["activeTab", "storage", "scripting", "downloads", "clipboardWrite", "alarms"], "host_permissions": ["https://*.amazon.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://*.amazon.com/ 'self'"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://*.amazon.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/studying.png", "48": "icons/studying.png", "128": "icons/studying.png"}}, "content_scripts": [{"matches": ["https://*.amazon.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/studying.png", "48": "icons/studying.png", "128": "icons/studying.png"}}