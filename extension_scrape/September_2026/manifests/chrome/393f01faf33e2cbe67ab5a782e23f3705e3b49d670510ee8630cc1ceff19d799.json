{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SitePause - Block and Delay Addictive Sites", "version": "2.1.0", "description": "Boost your productivity with an intentional, customizable pause before opening distracting websites. Regain your focus.", "action": {"default_popup": "popup.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "webNavigation", "tabs", "storage"], "host_permissions": ["*://*/*"], "icons": {"16": "public/icon16.png", "32": "public/icon32.png", "48": "public/icon48.png", "128": "public/icon128.png"}, "web_accessible_resources": [{"resources": ["friction.html"], "matches": ["<all_urls>"]}]}