{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FS Economy Panel", "version": "1.0.0", "description": "Proivdes a panel for viewing FS Economy and exporting to targeted flight planners.", "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["https://*.fseconomy.net/*", "https://dispatch.simbrief.com/*"], "background": {"service_worker": "src/background/service_worker.js"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-24-inactive.png", "24": "icons/icon-24-inactive.png", "32": "icons/icon-32-inactive.png"}}, "icons": {"16": "icons/icon-24.png", "32": "icons/icon-32.png", "48": "icons/icon-64.png", "128": "icons/icon-256.png"}, "content_scripts": [{"matches": ["https://*.fseconomy.net/*"], "js": ["src/content/fse.js"], "run_at": "document_idle"}, {"matches": ["https://*.fseconomy.net/airport.jsp*"], "js": ["src/content/fse_airport.js"], "run_at": "document_idle"}, {"matches": ["https://*.fseconomy.net/*"], "js": ["src/content/fse_theme.js"], "run_at": "document_start"}, {"matches": ["https://dispatch.simbrief.com/*"], "js": ["src/content/simbrief.js"], "run_at": "document_idle"}]}