{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Launcher", "version": "1.0.1", "description": "Quick access to ChatGPT, Gemini, and Mistral with keyboard shortcuts and search. Launch your favorite AI instantly from Chrome.", "permissions": ["activeTab", "storage", "windows"], "omnibox": {"keyword": "ai"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://chat.mistral.ai/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"open-ai-direct": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open AI directly"}, "open-ai-search": {"suggested_key": {"default": "Ctrl+K", "mac": "Command+K"}, "description": "Open AI search launcher"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}