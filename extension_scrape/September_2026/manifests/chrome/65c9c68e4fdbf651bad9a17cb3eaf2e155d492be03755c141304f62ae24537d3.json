{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Grami \u2014 AI Grammar Fixer & Chat Assistant", "version": "1.2.3", "description": "AI grammar fixer \u2014 correct spelling and grammar in Chrome's side panel and on any website. https://grami.chat", "minimum_chrome_version": "114", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Grami side panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "sidebar/sidebar.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/content-reader.js", "content-bridge.js"], "run_at": "document_idle"}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Grami side panel"}, "fix-selection": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fix grammar for selected text"}, "reply-selection": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Generate replies for selected text"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://grami.chat/*", "http://localhost:3000/*"]}}