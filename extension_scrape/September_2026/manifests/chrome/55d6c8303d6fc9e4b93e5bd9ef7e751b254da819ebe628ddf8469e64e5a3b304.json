{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Platform Hub", "version": "1.0.1", "description": "Unified access to ChatGPT, Claude, Leonardo AI and other AI platforms with advanced folder management and productivity features", "author": "AI Platform Hub Team", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "tabs"], "host_permissions": ["*://*.openai.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://app.leonardo.ai/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["*://*.openai.com/*", "https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["ai-hub-v2.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["https://claude.ai/*"], "js": ["content/claude-inject.js"], "run_at": "document_end"}, {"matches": ["https://app.leonardo.ai/*"], "js": ["content/leonardo-inject.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "AI Platform Hub", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}