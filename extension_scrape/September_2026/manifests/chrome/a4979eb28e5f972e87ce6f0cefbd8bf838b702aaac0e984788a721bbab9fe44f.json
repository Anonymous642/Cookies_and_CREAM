{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SpecClip", "version": "2.1.0", "description": "Save product specs from any website to Google Sheets. Built for interior designers creating specification books.", "permissions": ["activeTab", "notifications", "scripting", "storage", "tabs"], "host_permissions": ["https://*/*"], "action": {"default_title": "Clip product to spec book", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_page": "settings.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://idco.studio", "author": "IDCO Studio", "short_name": "SpecClip", "web_accessible_resources": [{"resources": ["icons/logo.svg"], "matches": ["<all_urls>"]}]}