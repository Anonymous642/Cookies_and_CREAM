{"update_url": "https://clients2.google.com/service/update2/crx", "name": "MockFlow Clippy", "description": "Clip any webpage, then import it into MockFlow as images, videos, bookmarks, docs, color palettes, wireframes or AI boards", "version": "3.0.0", "manifest_version": 3, "icons": {"16": "images/plugin/icon-16.png", "32": "images/plugin/icon-32.png", "48": "images/plugin/icon-48.png", "128": "images/plugin/icon-128.png"}, "externally_connectable": {"matches": ["https://*.mockflow.com/*"]}, "web_accessible_resources": [{"resources": ["ui/*", "images/*", "js/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "images/plugin/icon-16.png", "32": "images/plugin/icon-32.png", "48": "images/plugin/icon-48.png", "128": "images/plugin/icon-128.png"}, "default_title": "MockFlow Clippy"}, "commands": {"stop-clip-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Stop the video clip recording"}, "clip-page": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clip this page as the kind chosen in Clippy"}}, "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "contextMenus"]}