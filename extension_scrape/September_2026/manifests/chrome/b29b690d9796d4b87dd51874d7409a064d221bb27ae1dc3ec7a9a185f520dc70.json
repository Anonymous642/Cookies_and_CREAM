{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cadence \u2014 University Schedule Assistant", "description": "Import your university schedule once, keep it correct all term. Local-first, multi-university.", "version": "1.2.0", "short_name": "Cadence", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting"], "optional_permissions": ["alarms", "notifications", "identity"], "optional_host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*", "https://www.ratemyprofessors.com/*"], "action": {"default_title": "Cadence", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://calcentral.berkeley.edu/*", "https://my.ucdavis.edu/*", "https://schedulebuilder.ucdavis.edu/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}