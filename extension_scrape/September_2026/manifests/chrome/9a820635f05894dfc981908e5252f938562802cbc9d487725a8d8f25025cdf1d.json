{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "XENON local shopper", "version": "0.1.17", "description": "Read-only discovery for XENONTCG. Finds public card listings in your browser. Never buys cards or reads passwords or autofill.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "scripting", "tabs", "windows"], "host_permissions": ["https://www.ebay.co.uk/*", "https://www.fanaticscollect.com/*", "https://collectorcrypt.com/*", "https://goldin.co/*"], "background": {"service_worker": "worker.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "XENON local shopper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://xenontcg.com/*", "https://www.xenontcg.com/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": false}]}