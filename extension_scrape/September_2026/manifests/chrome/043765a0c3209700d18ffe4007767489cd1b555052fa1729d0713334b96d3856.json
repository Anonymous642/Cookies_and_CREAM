{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZippyNotes: YouTube Notes & AI Summaries", "description": "Take timestamped notes on YouTube, generate AI notes, and save videos to your personal learning library.", "version": "1.0.0", "permissions": ["tabs", "sidePanel"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://zippynotes.co/*", "https://api.zippynotes.co/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://www.youtube.com/*"], "js": ["content-scripts/content.js"]}]}