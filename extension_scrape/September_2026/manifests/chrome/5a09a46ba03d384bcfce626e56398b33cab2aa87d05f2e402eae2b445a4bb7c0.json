{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapShot Pro", "version": "1.1.0", "description": "Full-page screenshots, annotations & screen recording. Capture, mark up and save any page locally.", "author": "Excess Pro Net LLC", "homepage_url": "https://excesspronet.com", "minimum_chrome_version": "116", "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "tabCapture", "offscreen", "unlimitedStorage"], "host_permissions": ["https://api.freemius.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "SnapShot Pro", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.freemius.com; img-src 'self' data: blob:; media-src 'self' data: blob:"}, "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Capture visible area"}, "capture-fullpage": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Capture full page"}}}