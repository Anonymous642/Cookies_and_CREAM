{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtube Block", "version": "1.4.0", "description": "Blocks YouTube and YouTube Music. Both can be unlocked by manually entering a randomized code.", "action": {"default_popup": "popup.html", "default_title": "Youtube Block", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["declarativeNetRequest", "storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.ytimg.com/*", "*://*.googlevideo.com/*"], "background": {"service_worker": "background.js"}, "options_page": "blocked.html", "declarative_net_request": {"rule_resources": [{"id": "youtube_ruleset", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.css", "blocked.js", "icons/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}