{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Giant & Stop & Shop Coupon Clicker", "version": "1.2.0", "description": "Automatically clips all coupons on Giant Food and Stop & Shop's coupon pages with advanced features and settings.", "permissions": ["scripting", "tabs", "storage", "notifications", "contextMenus"], "host_permissions": ["https://giantfood.com/*", "https://www.giantfood.com/*", "https://www.stopandshop.com/*", "https://stopandshop.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "logo.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "logo.png"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["logo.png", "stopshop.png"], "matches": ["https://giantfood.com/*", "https://www.giantfood.com/*", "https://www.stopandshop.com/*", "https://stopandshop.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Toggle coupon clipping"}}}