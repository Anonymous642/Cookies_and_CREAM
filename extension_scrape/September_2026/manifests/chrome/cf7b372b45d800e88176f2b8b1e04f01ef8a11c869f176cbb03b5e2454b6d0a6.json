{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AiBlock for YouTube", "version": "1.1.6", "description": "Block YouTube channels that use AI-generated content", "icons": {"48": "icons/AiBlock_ico2_48tp.png", "96": "icons/AiBlock_ico2_96tp.png"}, "permissions": ["storage", "contextMenus", "notifications", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://raw.githubusercontent.com/*", "https://api.aisloplist.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["browser-polyfill.min.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/AiBlock_ico2_48tp.png", "96": "icons/AiBlock_ico2_96tp.png"}, "default_title": "AI Channel Blocker"}, "background": {"service_worker": "background.js"}, "commands": {"submit-channel": {"description": "Submit the channel under the cursor to the community list"}, "blacklist-channel": {"description": "Add the channel under the cursor to your blocklist"}, "warnlist-channel": {"description": "Add the channel under the cursor to your warnlist"}, "whitelist-channel": {"description": "Add the channel under the cursor to your whitelist"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.youtube.com/*"]}]}