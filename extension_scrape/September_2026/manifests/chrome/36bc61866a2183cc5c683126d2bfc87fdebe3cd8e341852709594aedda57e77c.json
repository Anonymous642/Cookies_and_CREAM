{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Hyperchill Website Blocker", "version": "1.0.3", "description": "Blocks distracting websites and syncs with the Hyperchill.io web application", "permissions": ["storage", "declarativeNetRequest", "webNavigation", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "dist/background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["dist/blocked.html", "dist/blocked.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"]}], "action": {"default_popup": "dist/popup.html", "default_icon": {"16": "dist/icons/icon16.png", "48": "dist/icons/icon48.png", "128": "dist/icons/icon128.png"}}, "options_page": "dist/options.html"}