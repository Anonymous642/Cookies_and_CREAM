{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PostHeap", "version": "1.0.1", "description": "Back up your own Instagram saved posts to your own PostHeap library. Never asks for your Instagram password.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.instagram.com/*", "https://postheap.vercel.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "PostHeap Sync", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.instagram.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "ISOLATED"}, {"matches": ["https://postheap.vercel.app/*"], "js": ["bridge.js"], "run_at": "document_idle", "world": "ISOLATED"}]}