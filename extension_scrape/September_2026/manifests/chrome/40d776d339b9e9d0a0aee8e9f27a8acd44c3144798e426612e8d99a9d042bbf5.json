{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SnapFind - Product Search Via Pic", "version": "1.1.1", "description": "Right-click the image to search for it and quickly find the purchase link for the corresponding product.", "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://lens.gowu8.net/*"], "background": {"service_worker": "background.js"}, "commands": {"trigger-screenshot": {"suggested_key": {"default": "Alt+S", "mac": "Option+S"}, "description": "Activate screenshot search to find similar items"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png"}}}