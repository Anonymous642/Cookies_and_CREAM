{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy Tabs", "description": "Copy selected tabs or every tab in the focused window.", "version": "1.0.0", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["clipboardWrite", "offscreen", "tabs"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Copy Tabs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"copy-selected-tabs": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Copy selected tabs"}, "copy-window-tabs": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Copy all tabs in the focused window"}}}