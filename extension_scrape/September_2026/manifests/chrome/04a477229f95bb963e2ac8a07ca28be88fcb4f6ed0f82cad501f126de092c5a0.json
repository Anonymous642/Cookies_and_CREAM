{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PastePilot", "version": "1.0.4", "description": "Invisible AI agent for LeetCode, Google Forms, and more\u2014generates and types answers with hotkeys.", "action": {"default_title": "PastePilot", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "webNavigation"], "host_permissions": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://api.openai.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"solve-leetcode": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Solve current LeetCode problem"}, "start-typing": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Arm key-gated typing with the last generated or provided text"}}}