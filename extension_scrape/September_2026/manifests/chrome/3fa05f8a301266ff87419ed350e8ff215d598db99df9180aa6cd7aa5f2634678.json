{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClientSafe AI", "version": "1.0.8", "description": "Warns before possible sensitive data is sent into supported AI chat tools. Local-only scanning for professionals.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage"], "background": {"service_worker": "src/background.js"}, "action": {"default_title": "ClientSafe AI", "default_popup": "pages/popup.html"}, "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "minimum_chrome_version": "114", "homepage_url": "https://chriswmccabe.wordpress.com/clientsafe-ai/", "incognito": "not_allowed"}