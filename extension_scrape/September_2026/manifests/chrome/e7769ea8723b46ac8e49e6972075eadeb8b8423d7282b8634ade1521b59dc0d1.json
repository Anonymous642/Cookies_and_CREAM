{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CVpraDEV para LinkedIn", "description": "Importa a vaga aberta no LinkedIn para o fluxo de geracao de CV do CVpraDEV e alimenta o portal de vagas dev.", "version": "0.3.1", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://www.linkedin.com/*", "https://cvpradev.com.br/*", "https://*.cvpradev.com.br/*"], "optional_host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/cvpradev-button.png"], "matches": ["https://www.linkedin.com/*"]}], "options_page": "options.html", "action": {"default_title": "CVpraDEV", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}}