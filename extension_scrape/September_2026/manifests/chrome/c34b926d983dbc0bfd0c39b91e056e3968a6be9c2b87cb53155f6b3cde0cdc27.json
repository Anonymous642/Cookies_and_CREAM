{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Website Copier", "description": "Copy any website to fully offline HTML \u2014 a single page, linked pages, or an entire site. Ink-on-white, Geist-inspired UI.", "version": "1.0.40", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "downloads", "identity", "offscreen", "scripting", "sidePanel", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Website Copier", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "panel/sidepanel.html"}, "web_accessible_resources": [{"resources": ["panel/oauth.html", "panel/oauth.js"], "matches": ["<all_urls>"]}]}