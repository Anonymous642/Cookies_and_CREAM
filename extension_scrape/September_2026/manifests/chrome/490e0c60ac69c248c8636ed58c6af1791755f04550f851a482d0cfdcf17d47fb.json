{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CommerceIQ Insights", "description": "CommerceIQ's official browser extension helps you get insights on your Amazon Business without leaving the product detail page (PDP)", "version": "2.0.15", "short_name": "CIQ Insights", "icons": {"16": "icons/IQ_16.png", "32": "icons/IQ_32.png", "48": "icons/IQ_48.png", "128": "icons/IQ_128.png"}, "action": {"default_title": "CommerceIQ", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/IQ_16.png", "32": "icons/IQ_32.png", "48": "icons/IQ_48.png", "128": "icons/IQ_128.png"}}, "background": {"service_worker": "background/background.js"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["cookies", "unlimitedStorage", "storage", "tabs"], "host_permissions": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.uk/*", "https://www.amazon.fr/*", "https://www.amazon.de/*", "https://www.amazon.es/*", "https://www.amazon.it/*", "https://www.amazon.com.mx/*", "https://www.amazon.nl/*", "https://www.amazon.pl/*", "https://www.amazon.com.au/*", "https://www.amazon.in/*", "*://*.commerceiq.ai/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "externally_connectable": {"matches": ["*://*.commerceiq.ai/*"]}, "incognito": "not_allowed", "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.uk/*", "https://www.amazon.fr/*", "https://www.amazon.de/*", "https://www.amazon.es/*", "https://www.amazon.it/*", "https://www.amazon.com.mx/*", "https://www.amazon.nl/*", "https://www.amazon.pl/*", "https://www.amazon.com.au/*"], "run_at": "document_end", "js": ["page_injects/index.js"], "css": ["page_injects/index.css"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}