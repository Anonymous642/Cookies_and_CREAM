{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Entity Search for Salesforce", "description": "Search anything quickly in your Salesforce Org", "version": "2.0.3", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "search_multi.js"}, "action": {"default_popup": "popup.html"}, "options_page": "options_multi.html", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.lightning.force.com/*"], "content_scripts": [{"matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.lightning.force.com/*"], "js": ["linkify_salesforce_ids.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Entity Search popup"}}}