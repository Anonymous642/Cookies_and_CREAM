{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vox Issue", "short_name": "Vox Issue", "version": "1.4.0", "description": "Screenshots in. GitHub issues out. Capture a page, mark it up, dictate the bug, file an issue an AI agent can fix.", "permissions": ["activeTab", "scripting", "tabs", "sidePanel", "storage", "unlimitedStorage", "alarms", "clipboardWrite"], "host_permissions": ["<all_urls>", "https://api.github.com/*", "https://raw.githubusercontent.com/*", "https://api.anthropic.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Vox Issue", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "side_panel": {"default_path": "sidebar.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/platform.js", "lib/CaptureFormatting.js", "content.js"], "run_at": "document_end", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["images/*", "media/*"], "matches": ["<all_urls>"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}