{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SyncDial - Speed Dial for Chrome Bookmarks", "version": "1.0.7", "description": "Fast, minimal speed dial new tab that is your Chrome bookmarks: two-way synced dials, folders, thumbnails and a save-page shortcut.", "permissions": ["bookmarks", "storage", "favicon", "tabs", "scripting", "activeTab", "unlimitedStorage"], "host_permissions": ["https://s.wordpress.com/*"], "optional_host_permissions": ["<all_urls>"], "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "action": {"default_title": "Save page to Speed Dial"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to a Speed Dial folder"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}