{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Colab Notifier", "version": "1.0.1", "description": "Get real-time notifications on your phone when a Google Colab notebook fails or disconnects from the runtime.", "action": {"default_popup": "src/popup.html", "default_title": "Colab Notifier", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://colab.research.google.com/*", "https://api.telegram.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["https://colab.research.google.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}