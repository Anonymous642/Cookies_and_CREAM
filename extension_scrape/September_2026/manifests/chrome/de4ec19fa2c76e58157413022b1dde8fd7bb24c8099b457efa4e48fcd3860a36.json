{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Slatify - YouTube Notes & Screenshot Note Taking", "version": "1.0.14", "description": "Take timestamped YouTube lecture notes with screenshots, drawings, and PDF export.", "permissions": ["storage", "commands", "unlimitedStorage"], "host_permissions": ["https://www.youtube.com/*", "https://leetcode.com/*"], "action": {"default_popup": "index.html", "default_icon": {"16": "slatelogo.png", "48": "slatelogo.png", "128": "slatelogo.png"}}, "icons": {"16": "slatelogo.png", "48": "slatelogo.png", "128": "slatelogo.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://leetcode.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["overlay.html", "assets/*", "slatelogo.png"], "matches": ["https://www.youtube.com/*", "https://leetcode.com/*"]}], "commands": {"toggle-overlay": {"suggested_key": {"default": "Alt+H"}, "description": "Show or hide Slatify overlay"}, "toggle-text-note": {"suggested_key": {"default": "Alt+T"}, "description": "Toggle text note"}, "save-note": {"suggested_key": {"default": "Alt+S"}, "description": "Save current note"}, "toggle-blank-canvas": {"suggested_key": {"default": "Alt+C"}, "description": "Toggle blank canvas"}, "open-dashboard": {"description": "Open dashboard"}}}