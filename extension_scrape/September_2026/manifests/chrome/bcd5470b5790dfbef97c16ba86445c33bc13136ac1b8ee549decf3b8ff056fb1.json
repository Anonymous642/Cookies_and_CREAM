{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneTask \u2014 stay focused", "version": "2.4.0", "description": "Stay focused on what matters most. A minimalist floating task bar + manager that keeps your #1 task always visible on every page.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "src/panel/panel.html", "default_title": "OneTask Manager", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "commands": {"toggle-taskbar-visibility": {"suggested_key": {"mac": "Command+Shift+O", "default": "Ctrl+Shift+O"}, "description": "Toggle OneTask bar visibility"}, "toggle-taskbar-visibility-alt": {"suggested_key": {"mac": "Command+Shift+Y", "default": "Ctrl+Shift+Y"}, "description": "Toggle OneTask bar visibility (alt)"}}, "background": {"service_worker": "src/background/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/taskbar.js", "src/content/hotkeys-fallback.js"], "css": ["src/content/taskbar.css"], "run_at": "document_idle"}], "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "default_locale": "en"}