{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabRecorder", "version": "1.0.0", "description": "Record your Chrome tab or screen. Fully on-device \u2014 nothing leaves your browser.", "permissions": ["tabCapture", "desktopCapture", "offscreen", "storage", "downloads", "activeTab", "tabs"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabRecorder"}, "background": {"service_worker": "background.js"}, "options_page": "options/options.html", "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle recording on/off"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}