{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Locator Lens", "description": "Pick elements on any page and generate QA-friendly locators for Playwright, Cypress, Selenium, CSS, and XPath.", "version": "0.4.0", "permissions": ["activeTab", "storage", "clipboardWrite"], "background": {"service_worker": "src/background.js"}, "commands": {"start-pick": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Start element picker"}, "copy-best": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy best locator"}}, "action": {"default_title": "Locator Lens", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/shared/settings.js", "src/locator/constants.js", "src/locator/escaping.js", "src/locator/dom-utils.js", "src/locator/naming.js", "src/locator/context.js", "src/renderers/playwright.js", "src/renderers/cypress.js", "src/renderers/selenium.js", "src/renderers/raw.js", "src/renderers/index.js", "src/locator/match-state.js", "src/locator/selectors.js", "src/locator/descriptors.js", "src/locator/language.js", "src/locator/analysis.js", "src/ui/state.js", "src/ui/picker.js", "src/ui/panel.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}