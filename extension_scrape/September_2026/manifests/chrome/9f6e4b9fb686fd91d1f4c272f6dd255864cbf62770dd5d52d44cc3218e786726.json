{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Offer.discount Coupon Finder", "description": "Automatic coupon finder that saves you money at checkout.", "version": "1.0", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' 'unsafe-inline' localhost/;"}, "permissions": ["activeTab", "tabs"], "background": {"service_worker": "background.min.js"}, "icons": {"16": "assets/icon_16x16.png", "32": "assets/icon_32x32.png", "180": "assets/icon_180x180.png"}, "action": {"default_icon": {"16": "assets/icon_16x16.png", "32": "assets/icon_32x32.png"}, "default_popup": "assets/popup.html"}, "host_permissions": ["*://*/*", "*://*.localhost/*"], "web_accessible_resources": [{"resources": ["content.js"], "matches": ["*://*/*", "*://*.localhost/*"]}], "content_scripts": [{"matches": ["*://*/*", "*://*.localhost/*"], "js": ["content.min.js"]}]}