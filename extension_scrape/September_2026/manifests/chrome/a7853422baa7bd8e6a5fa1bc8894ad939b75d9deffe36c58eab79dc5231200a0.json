{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Blur", "description": "Blur ChatGPT chat titles and content to protect your privacy during screen sharing, capturing, or recording.", "version": "1.1.5", "icons": {"16": "assets/icon2.png", "48": "assets/icon2.png", "128": "assets/icon2.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icon2.png", "48": "assets/icon2.png", "128": "assets/icon2.png"}}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["src/content.js"], "css": ["styles/styles.css"], "run_at": "document_idle"}], "commands": {"toggle-blur": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Toggle blur on/off"}}}