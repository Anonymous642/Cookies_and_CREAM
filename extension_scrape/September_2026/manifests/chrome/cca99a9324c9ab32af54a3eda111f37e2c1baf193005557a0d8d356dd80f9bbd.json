{"update_url": "https://clients2.google.com/service/update2/crx", "name": "SimpleMemoPad", "version": "1.7.0", "manifest_version": 3, "minimum_chrome_version": "116", "description": "A simple memo pad. Keep autosaved notes in tabs, in a popup or the side panel.", "icons": {"16": "img/icon/16.png", "48": "img/icon/48.png", "128": "img/icon/128.png"}, "action": {"default_icon": {"16": "img/icon/16.png", "32": "img/icon/32.png"}, "default_title": "MemoPad", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "MacCtrl+Shift+Z"}}}, "background": {"service_worker": "js/background.js"}, "side_panel": {"default_path": "popup.html?mode=panel"}, "permissions": ["storage", "sidePanel"]}