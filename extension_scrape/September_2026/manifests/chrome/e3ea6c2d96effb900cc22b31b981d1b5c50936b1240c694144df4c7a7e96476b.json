{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Roblox Quick Start Link Generator", "description": "Adds a link to Roblox game pages to copy the direct start URL.", "version": "1.0.1", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://www.roblox.com/games/*"], "js": ["content.js"]}], "action": {"default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "permissions": ["clipboardWrite"], "web_accessible_resources": [{"resources": ["link.svg"], "matches": ["https://www.roblox.com/*"]}], "host_permissions": ["https://www.roblox.com/games/*"]}