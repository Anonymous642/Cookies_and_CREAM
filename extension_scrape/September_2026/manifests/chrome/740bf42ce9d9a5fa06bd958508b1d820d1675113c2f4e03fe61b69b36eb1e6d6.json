{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Scroll \u2014 Shorts & Reels", "version": "1.2.1", "description": "Automatically advances to the next YouTube Short or Instagram Reel when playback ends.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.instagram.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Auto Scroll \u2014 Shorts & Reels", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/comment-guard.js", "content/youtube.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["content/comment-guard.js", "content/instagram.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}