{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Suspend Tabs - Memory Saver", "description": "Automatically suspends inactive tabs to free memory, speed up Chrome, and extend battery life. No data collection.", "version": "2.5", "icons": {"128": "icone/icone_128.png"}, "action": {"default_popup": "popExtension/popExtension.html", "default_icon": {"128": "icone/icone_128.png"}}, "background": {"service_worker": "background.js"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms", "contextMenus", "downloads", "system.memory"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "Optinal/options.html", "open_in_tab": true}, "commands": {"suspend-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend the current tab"}, "suspend-all-window": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Suspend all background tabs in the current window"}}}