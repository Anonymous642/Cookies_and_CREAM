{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Truck \u2014 Save, Encrypt & Sync Tabs", "version": "1.0.9", "description": "Save your open tabs in one click \u2014 encrypted on your device, synced across browsers in your own Google Drive. No account needed.", "homepage_url": "https://tabtruck.co", "permissions": ["tabs", "storage", "identity", "alarms", "contextMenus", "bookmarks"], "host_permissions": ["https://www.googleapis.com/*", "https://accounts.google.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Tab Truck", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "options.html", "incognito": "spanning", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open the Tab Truck popup"}, "save-window": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save all tabs in this window"}, "save-selected": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Save the selected tab(s)"}, "open-manager": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open the tab manager"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}