{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reading Spotlight", "version": "1.0.1", "description": "Focus on what you're reading with a customizable spotlight overlay that dims distractions", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/storage.js", "content.js"], "css": ["styles/content.css"], "run_at": "document_end"}], "options_page": "options.html", "commands": {"toggle-spotlight": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle spotlight on/off"}, "increase-size": {"suggested_key": {"default": "Ctrl+Shift+I"}, "description": "Increase spotlight size"}, "decrease-size": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Decrease spotlight size"}}}