{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReelSync Popout for Instagram", "version": "0.4.11", "minimum_chrome_version": "116", "description": "Pop out the active Reel, auto-advance at the end, and use keyboard or separate previous/next mouse controls.", "permissions": ["scripting", "storage"], "host_permissions": ["https://www.instagram.com/*"], "background": {"service_worker": "background.js"}, "commands": {"background-previous-reel": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Previous Reel in the active ReelSync popout", "global": true}, "background-next-reel": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Next Reel in the active ReelSync popout", "global": true}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "ReelSync Popout", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}]}