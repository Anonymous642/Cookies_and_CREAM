{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AttendanceX", "version": "0.1.0", "description": "Track Google Classroom attendance directly from your Google Meet calls.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://meet.google.com/*", "https://app.attendancex.io/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "AttendanceX \u2014 open attendance panel", "default_popup": "panel.html"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}