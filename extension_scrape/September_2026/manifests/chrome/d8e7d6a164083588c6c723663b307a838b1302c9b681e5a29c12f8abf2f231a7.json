{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zitto the Sleepy Cat - YouTube Blocker", "version": "2.1", "description": "A gamified YouTube blocker with a sleeping cat that earns fish tokens", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtu.be/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtu.be/*"], "js": ["YoutubeNuke.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Sleepy Cat Status"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["ControlPanel.html"], "matches": ["*://*.youtube.com/*", "*://*.youtu.be/*"]}], "content_security_policy": {"extension_pages": "default-src 'self'; object-src 'self'; style-src 'unsafe-inline';"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}}}}