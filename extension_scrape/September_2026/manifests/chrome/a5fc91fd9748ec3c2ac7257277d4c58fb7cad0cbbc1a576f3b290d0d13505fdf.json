{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Orbits", "version": "1.1.0", "description": "Replace Chrome's tab bar with a vertical tabs sidebar and organized Spaces for context-based browsing.", "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "bookmarks", "favicon", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "action": {"default_title": "Orbits", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"switch-space-prev": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Switch to previous space"}, "switch-space-next": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Switch to next space"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Toggle side panel"}, "toggle-pin": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Pin/unpin side panel"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}