{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CodeSpeak: AI Code Explainer & Speaker", "version": "1.0.3", "description": "\ud83e\udd16 Explains and speaks code using AI models.", "permissions": ["contextMenus", "scripting", "activeTab", "storage", "sidePanel"], "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/", "https://ai-code-explainer-new.ai-code-explainer.workers.dev/"], "background": {"service_worker": "background.js"}, "action": {"default_title": "AI Code Explainer"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "side_panel": {"default_path": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"explain-code": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Explain selected code"}, "quick-speak": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick speak selected text (no AI)"}, "open-options": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open options panel"}}, "web_accessible_resources": [{"resources": ["welcome.html"], "matches": ["<all_urls>"]}]}