{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Smart AD/Tab Blocker", "version": "1.2.1", "description": "Blocks any new tab from opening based on custom rules.", "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "commands": {"block_and_close_tab": {"description": "Block the current tab's domain and close the tab.", "suggested_key": {"default": "Ctrl+X", "mac": "Command+X"}}, "toggle_whitelist_only_mode": {"description": "Toggle Whitelist Only Mode on/off.", "suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}}, "unblock_and_reopen_last_tab": {"description": "Unblock the domain and reopen the last tab closed by the extension.", "suggested_key": {"default": "Ctrl+Z", "mac": "Command+Z"}}, "whitelist_current_tab": {"description": "Add the current tab's domain to the whitelist.", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "storage", "activeTab", "contextMenus", "webNavigation"]}