{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VA Companion", "version": "0.3.0", "description": "A privacy-first companion dashboard for VA.gov claim and appeal status data.", "action": {"default_title": "VA Companion", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.va.gov/*"], "js": ["content-script.js"], "run_at": "document_start"}], "host_permissions": ["https://www.va.gov/*", "https://api.va.gov/*"], "permissions": ["activeTab", "sidePanel", "storage", "tabs"], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"matches": ["*://www.va.gov/*"], "resources": ["page-bridge.js"]}]}