{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NightShield: Blue Light Filter", "version": "1.0.0", "description": "Reduce eye strain and sleep disruption with a one-click blue light filter for night-time browsing.", "action": {"default_icon": {"16": "icons/styled-icon-off-16.png", "32": "icons/styled-icon-off-32.png", "48": "icons/styled-icon-off-48.png", "128": "icons/styled-icon-off-128.png"}, "default_title": "Toggle blue filter", "default_popup": "popup.html"}, "background": {"service_worker": "service-worker.js"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "commands": {"toggle_overlay": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle the blue light reduction overlay"}}}