{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Momentum OS - Tab Session Manager", "short_name": "Momentum", "description": "Automatically organize tabs into work sessions, save checkpoints, restore tab groups, and resume work without losing context.", "version": "0.2.0", "minimum_chrome_version": "121", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Momentum", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "options_page": "src/options/index.html", "permissions": ["sidePanel", "storage", "tabs", "tabGroups", "alarms"], "optional_permissions": ["notifications"], "optional_host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.deepseek.com/*", "https://api.groq.com/*", "https://openrouter.ai/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the Momentum side panel"}, "save-checkpoint": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Save a checkpoint of the active session"}, "restore-last-session": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Restore the last saved session"}, "move-tab-to-session": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Move the current tab into the focused session"}}}