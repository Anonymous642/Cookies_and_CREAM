{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Kobo eBook to PDF Downloader", "version": "2.2.0", "description": "Capture screenshots from Kobo ePub reader pages and generate a single PDF document", "permissions": ["activeTab", "downloads", "storage", "unlimitedStorage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Kobo eBook to PDF Downloader"}, "content_scripts": [{"matches": ["*://*.kobo.com/*", "*://read.kobo.com/*", "*://*.rakuten.co.jp/*", "*://*.kobobooks.com/*", "*://preview-readingservices.kobo.com/*", "*://getbook.kobo.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}