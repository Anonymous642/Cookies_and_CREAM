{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Subtitle Learning Assistant", "version": "1.0.0", "description": "Capture subtitles while watching foreign videos, click to translate, and build your vocabulary", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://subtitle-translate-api.vercel.app/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"], "js": ["translate-config.js", "vocabulary.js", "sidebar.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Subtitle Learning Assistant", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["popup.html", "translate-config.js"], "matches": ["<all_urls>"]}]}