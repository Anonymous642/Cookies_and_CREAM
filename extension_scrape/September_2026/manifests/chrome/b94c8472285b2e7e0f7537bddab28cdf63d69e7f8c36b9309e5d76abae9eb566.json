{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DontLook - Privacy Blur for AI & Notifications", "version": "1.1.0", "description": "Blur ChatGPT & Gemini conversations and push notifications (WhatsApp, Slack, Telegram, Discord, Gmail) for screen sharing & privacy.", "icons": {"128": "assets/icon128_inactive.png"}, "permissions": ["activeTab", "storage", "contentSettings"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/content/ai/chatgpt.js"], "css": ["styles/global.css", "styles/chatgpt.css"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["src/content/ai/gemini.js"], "css": ["styles/global.css", "styles/gemini.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["src/content/push/notifInterceptor.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["src/content/push/stateBridge.js"], "run_at": "document_start"}], "action": {"default_title": "Toggle Privacy Blur", "default_popup": "src/popup/popup.html", "default_icon": {"128": "assets/icon128_inactive.png"}}, "background": {"service_worker": "src/background/background.js"}, "commands": {"toggle-all-privacy": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Toggle all privacy protections on/off"}}}