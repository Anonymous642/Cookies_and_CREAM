{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Nemo \u2014 Don't lose what you just typed", "version": "1.14.0", "description": "Nemo protects what you type so you can recover it after a crash, closed tab, or reload. Your data never leaves your browser.", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "all_frames": false, "js": ["src/shared/constants.js", "src/shared/utils.js", "src/security/sensitive-field-detector.js", "src/security/site-rules.js", "src/fingerprint/field-fingerprint.js", "src/fingerprint/form-fingerprint.js", "src/fingerprint/display-metadata.js", "src/storage/settings-storage.js", "src/storage/draft-storage.js", "src/storage/pending-recovery-storage.js", "src/content/field-detector.js", "src/content/form-detector.js", "src/content/autosave.js", "src/content/mutation-observer.js", "src/content/restore.js", "src/content/restore-toast.js", "src/content/content.js"]}], "web_accessible_resources": [{"resources": ["assets/images/nemo-logo.png", "assets/images/mnemosyne-bg.png"], "matches": ["<all_urls>"]}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_page": "src/settings/settings.html"}