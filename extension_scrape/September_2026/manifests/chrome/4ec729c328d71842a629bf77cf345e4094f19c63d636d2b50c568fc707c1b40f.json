{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptPacker \u2014 Page-to-Prompt Context Grabber", "short_name": "PromptPacker", "version": "1.0.0", "description": "Grab the current page or your selection as clean, formatted context and send it to ChatGPT, Claude, Grok, or Gemini in one click.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "PromptPacker \u2014 grab this page as AI context"}, "options_page": "options/options.html", "background": {"service_worker": "background/background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen", "unlimitedStorage", "notifications"], "commands": {"grab-context": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Grab page/selection as context and copy it"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open PromptPacker popup"}}}