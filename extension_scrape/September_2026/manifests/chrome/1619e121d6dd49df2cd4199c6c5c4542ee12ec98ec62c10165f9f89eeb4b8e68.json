{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Insighter", "version": "1.0.1", "description": "Resumos inteligentes de v\u00eddeos do YouTube com IA", "permissions": ["activeTab", "storage", "notifications", "tabs", "scripting", "cookies"], "host_permissions": ["https://www.youtube.com/*", "http://localhost:4200/*", "https://api.ainsighter.com.br/*", "https://ainsighter.com.br/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content-scripts/youtube-inject.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["http://localhost:4200/*", "https://ainsighter.com.br/*"], "js": ["content-scripts/portal-bridge.js"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "ng-Insighter", "default_icon": {"16": "/assets/icons/icon-16.png", "32": "/assets/icons/icon-32.png", "48": "/assets/icons/icon-48.png", "128": "/assets/icons/icon-128.png"}}, "icons": {"16": "/assets/icons/icon-16.png", "32": "/assets/icons/icon-32.png", "48": "/assets/icons/icon-48.png", "128": "/assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "content-scripts/*"], "matches": ["https://www.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'"}}