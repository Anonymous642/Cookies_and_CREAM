{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copiee - Clipboard Manager", "description": "Powerful clipboard manager with cloud sync, code detection, search, secret vault & many more features.", "version": "1.0.0", "icons": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "permissions": ["storage", "clipboardRead", "clipboardWrite", "offscreen"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Copiee - Clipboard Manager", "default_popup": "popup.html", "default_icon": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}}, "web_accessible_resources": [{"resources": ["offscreen.html"], "matches": ["https://auth.copiee.tech/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}