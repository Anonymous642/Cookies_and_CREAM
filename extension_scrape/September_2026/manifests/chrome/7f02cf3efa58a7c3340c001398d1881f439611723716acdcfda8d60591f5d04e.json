{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Suno Korean Localizer", "version": "0.1.3", "description": "Translate Suno UI into Korean with a global localization engine.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["https://suno.com/*", "https://help.suno.com/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_title": "Suno Korean Localizer", "default_popup": "src/ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_page": "src/ui/options.html", "content_scripts": [{"matches": ["https://suno.com/*", "https://help.suno.com/*"], "js": ["src/content/bootstrap.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/*.js", "src/i18n/*.js", "src/rules/*.js"], "matches": ["https://suno.com/*", "https://help.suno.com/*"]}]}