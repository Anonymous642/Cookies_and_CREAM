{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Reddily", "_env": "production", "version": "1.1.7", "description": "Extract market research insights from Reddit threads", "permissions": ["activeTab", "storage", "scripting", "alarms"], "host_permissions": ["*://*.reddit.com/*", "https://reddily.io/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://reddily.io/*"], "js": ["content/content.js"], "run_at": "document_start"}, {"matches": ["*://*.reddit.com/search*", "*://*.reddit.com/r/*"], "js": ["content/reddit-search.js"], "run_at": "document_idle"}, {"matches": ["*://*.reddit.com/answers*"], "js": ["content/reddit-answers.js"], "run_at": "document_idle"}]}