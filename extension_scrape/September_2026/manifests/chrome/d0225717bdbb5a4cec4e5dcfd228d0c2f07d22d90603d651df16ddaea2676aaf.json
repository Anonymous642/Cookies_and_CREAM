{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X-Ticker: Instant Hover Charts for Crypto Twitter", "short_name": "X-Ticker", "version": "2.4.0", "description": "Hover any crypto cashtag on X (Twitter) \u2014 $BTC, $SOL, $ETH \u2014 and see a live TradingView chart instantly. No tabs, no clicks.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["translations.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}