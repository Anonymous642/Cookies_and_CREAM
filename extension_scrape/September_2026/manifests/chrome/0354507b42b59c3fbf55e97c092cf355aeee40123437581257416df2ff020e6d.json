{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Discord-Conversation-Exporter", "version": "1.1.0", "description": "Capture Discord chat logs within a specified date range or message selection and export them formatted into Notion.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://discord.com/*", "https://api.notion.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://discord.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}