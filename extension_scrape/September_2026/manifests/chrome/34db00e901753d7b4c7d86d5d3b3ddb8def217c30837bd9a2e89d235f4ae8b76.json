{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SoundCloud & YouTube to Audio Scout - Track Identifier", "version": "2.3.3", "description": "Identify tracks in SoundCloud and YouTube DJ mixes. Scan what's playing in real time, or send a mix to Audio Scout in one click.", "homepage_url": "https://audioscout.io", "permissions": ["storage", "cookies", "tabCapture", "offscreen", "activeTab", "scripting"], "host_permissions": ["https://soundcloud.com/*", "https://*.soundcloud.com/*", "https://youtube.com/*", "https://*.youtube.com/*", "https://audioscout.io/*", "https://*.audioscout.io/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*", "https://youtube.com/*", "https://*.youtube.com/*"], "js": ["clipboard-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*", "https://youtube.com/*", "https://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/beatport-logo.png"], "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*", "https://youtube.com/*", "https://*.youtube.com/*"]}]}