{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Moonbow Sync", "version": "1.2.0", "description": "Moonbow Sync \u2014 paste notes, map goals, import baselines, and re-auth reports into your clinic EHR. Review before saving.", "homepage_url": "https://moonbow.app/sync-extension", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "alarms", "storage", "tabs"], "host_permissions": ["*://*.centralreach.com/*", "*://*.motivity.net/*", "*://*.hirasmus.com/*", "https://moonbow.app/*", "https://www.moonbow.app/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://www.googleapis.com/*", "https://www.google.com/*", "https://www.gstatic.com/*"], "action": {"default_title": "Open Moonbow Sync", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js", "type": "module"}, "externally_connectable": {"matches": ["https://moonbow.app/*", "https://www.moonbow.app/*"]}, "content_scripts": [{"matches": ["*://*.centralreach.com/*", "*://*.motivity.net/*", "*://*.hirasmus.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-32.png"], "matches": ["*://*.centralreach.com/*", "*://*.motivity.net/*", "*://*.hirasmus.com/*"]}]}