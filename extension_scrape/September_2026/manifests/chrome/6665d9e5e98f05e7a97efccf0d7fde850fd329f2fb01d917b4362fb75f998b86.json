{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Quarlo Job Saver", "version": "1.0.63", "description": "Save job postings to Quarlo with one click. Works on LinkedIn, Handshake, and Indeed.", "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs"], "host_permissions": ["https://www.linkedin.com/jobs/*", "https://*.joinhandshake.com/stu/jobs/*", "https://*.joinhandshake.com/jobs/*", "https://www.indeed.com/*", "https://indeed.com/*", "https://quarlo.co/*", "https://www.quarlo.co/*", "http://localhost:3000/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16-inactive.png", "48": "icons/icon-48-inactive.png", "128": "icons/icon-128-inactive.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "src/background/service-worker.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://*.joinhandshake.com/*", "https://www.indeed.com/*", "https://indeed.com/*"], "js": ["src/content/utils.js", "src/content/site-configs.js", "src/content/parser-engine.js", "src/content/remote-config.js", "src/content/active-indicator.js", "src/content/index.js"], "run_at": "document_idle"}, {"matches": ["https://quarlo.co/*", "https://www.quarlo.co/*", "http://localhost:3000/*"], "js": ["src/content/quarlo-auth.js"], "run_at": "document_idle"}, {"matches": ["https://quarlo.co/*", "https://www.quarlo.co/*", "http://localhost:3000/*"], "js": ["src/content/injected-auth.js"], "run_at": "document_start", "world": "MAIN"}]}