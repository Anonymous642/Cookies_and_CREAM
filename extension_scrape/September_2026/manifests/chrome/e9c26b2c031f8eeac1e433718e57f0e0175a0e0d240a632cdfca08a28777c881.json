{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "__MSG_appName__", "version": "1.0.2", "default_locale": "en", "description": "__MSG_appDesc__", "$comment_permissions": "No host permissions, and no declared content script. The inspector is injected with scripting + activeTab when the user clicks the toolbar icon, so Specly can read a page only on the tab the user pointed it at, and only after they pointed it there.", "permissions": ["activeTab", "scripting", "sidePanel", "downloads"], "action": {"default_title": "__MSG_actionTitle__", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background.js", "type": "module"}, "side_panel": {"default_path": "panel/panel.html"}, "commands": {"inspect": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "__MSG_cmdInspect__"}}, "web_accessible_resources": [], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}