{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZYNKIN", "version": "1.0.7", "description": "ZYNKIN \u2014 connect your LinkedIn, X and Instagram sessions so ZYNKIN can post your comments from the cloud.", "permissions": ["storage", "alarms", "tabs", "cookies", "scripting"], "host_permissions": ["https://*.linkedin.com/*", "https://*.x.com/*", "https://*.instagram.com/*", "https://app.zynkin.com/*"], "externally_connectable": {"matches": ["https://app.zynkin.com/*"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://app.zynkin.com/*"], "js": ["content/dashboard.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}}