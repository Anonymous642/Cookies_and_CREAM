{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Link Saver", "description": "A browser extension that lets you easily save and organize your favorite links in one place.", "version": "1", "icons": {"16": "/images/16.png", "48": "/images/48.png", "128": "/images/128.png"}, "action": {"default_popup": "index.html", "default_title": "Link Saver"}, "background": {"service_worker": "background.js", "env": {"DEBUG": true, "LINK_SAVER_STORAGE_NAME": "link_saver", "LINK_SAVER_GROUP_STORAGE_NAME": "link_saver_groups"}}, "permissions": ["tabs", "storage", "unlimitedStorage", "contextMenus"], "web_accessible_resources": [{"resources": ["full-page.html"], "matches": ["<all_urls>"]}]}