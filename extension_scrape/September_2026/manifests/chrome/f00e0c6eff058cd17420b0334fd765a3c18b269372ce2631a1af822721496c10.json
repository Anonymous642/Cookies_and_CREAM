{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lumotext \u2014 Text to Speech Reader", "version": "1.4.1", "description": "Read aloud any webpage, document or email with natural AI voices or free device voices. Word-by-word highlighting, up to 4x speed.", "permissions": ["storage", "scripting", "contextMenus", "sidePanel", "offscreen"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://lumotext.com/*", "https://www.lumotext.com/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Lumotext \u2014 Text to Speech", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://docs.google.com/document/*"], "js": ["docs-mark.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://docs.google.com/document/*"], "js": ["docs-annotate.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["<all_urls>"], "exclude_matches": ["https://lumotext.com/*", "https://www.lumotext.com/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"], "js": ["hotkeys.js", "cloud.js", "page-markdown.js", "content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://lumotext.com/*", "https://www.lumotext.com/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"], "js": ["sync-bridge.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"open-player": {"description": "Open Lumotext on this page"}, "toggle-focus": {"description": "Focus mode on / off"}, "toggle-play": {"suggested_key": {"default": "Alt+Shift