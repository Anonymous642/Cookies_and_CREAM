{"manifest_version": 3, "name": "KeyController Plugin", "description": "Allow to sign filtering by URL // Permite la firma filtrando por URL", "update_url": "https://clients2.google.com/service/update2/crx", "version": "3.0", "background": {"service_worker": "service_worker.js"}, "action": {"default_icon": "icon48.png", "default_title": "KeyController URL Plugin"}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "tabs", "nativeMessaging", "webRequest"], "host_permissions": ["https://*/", "*://*/*"], "web_accessible_resources": [{"resources": ["icon48.png", "icon128.png"], "matches": ["<all_urls>"]}]}