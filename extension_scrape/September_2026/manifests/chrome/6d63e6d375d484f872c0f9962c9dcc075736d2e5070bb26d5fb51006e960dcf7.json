{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RecruitBPM", "description": "RecruitBPM chrome extension enables recruiters to extract candidates & contacts from linkedin, gmail, outlook, dice and monster.", "version": "4.5.0", "short_name": "RecruitBPM", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://* data: blob: filesystem:;"}, "action": {"default_icon": {"256": "icon-256.png"}, "default_title": "RecruitBPM"}, "permissions": ["tabs", "storage", "activeTab", "scripting", "background"], "icons": {"256": "icon-256.png"}, "host_permissions": ["https://outlook.office.com/*", "https://outlook.live.com/*", "https://mail.google.com/*", "https://mail-attachment.googleusercontent.com/*", "https://www.linkedin.com/*", "https://hiring.monster.com/*", "https://www.dice.com/*"], "background": {"service_worker": "js/background.js"}, "web_accessible_resources": [{"resources": ["popup.html"], "matches": ["<all_urls>"]}]}