{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReplayIQ", "version": "1.0", "description": "Record and replay web interactions with screenshot capabilities. Features keyboard shortcuts for screenshots and recording controls.", "permissions": ["tabs", "activeTab", "scripting", "storage", "commands"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_popup_width": 400, "default_popup_height": 600, "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"take-screenshot": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Take screenshots at configured resolutions"}, "take-single-screenshot": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Take single screenshot at configured resolutions"}, "toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle recording state"}}, "web_accessible_resources": [{"resources": ["images/hand-icon.png"], "matches": ["<all_urls>"]}]}