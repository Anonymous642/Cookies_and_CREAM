{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipppy \u2014 Save to your collections", "version": "0.3.4", "description": "One-click save of pages, links, images, and selections to Clipppy from anywhere on the web.", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://clipppy.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Save to Clipppy", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to Clipppy"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}