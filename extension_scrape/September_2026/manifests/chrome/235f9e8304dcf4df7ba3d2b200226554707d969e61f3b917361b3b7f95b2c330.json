{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Poshlister \u2014 Poshmark listing assistant", "version": "1.0.0", "description": "Fills Poshmark's create-listing form from listings you reviewed in Poshlister. You always click List yourself.", "permissions": ["storage"], "host_permissions": ["https://poshmark.com/*", "https://*.public.blob.vercel-storage.com/*", "https://poshlister.app/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Poshlister", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://poshmark.com/*"], "js": ["fill.js", "content.js"], "run_at": "document_idle"}]}