{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TalentXchange", "version": "1.0", "description": "A Chrome extension that helps recruiters source and manage candidates from LinkedIn profiles", "permissions": ["activeTab", "scripting", "storage", "sidePanel", "background"], "host_permissions": ["https://api.talentxchange.org/*", "https://*.linkedin.com/*", "http://localhost:3030/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Click to open panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "panel.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/in/*"], "js": ["content/content-profile.js"]}, {"matches": ["*://*.linkedin.com/company/*"], "js": ["content/content-company.js"]}, {"matches": ["http://localhost:3000/*", "https://www.talentxchange.org/*"], "js": ["content/content-login.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}