{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chomp - Tab Monster", "short_name": "Chomp", "version": "1.1.0", "description": "A little creature that lives in your browser and eats your stale tabs.", "permissions": ["tabs", "activeTab", "storage", "sidePanel", "alarms", "notifications", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/chomp-16.png", "48": "icons/chomp-48.png", "128": "icons/chomp-128.png"}}, "icons": {"16": "icons/chomp-16.png", "48": "icons/chomp-48.png", "128": "icons/chomp-128.png"}, "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "homepage_url": "https://www.chomptabs.com"}