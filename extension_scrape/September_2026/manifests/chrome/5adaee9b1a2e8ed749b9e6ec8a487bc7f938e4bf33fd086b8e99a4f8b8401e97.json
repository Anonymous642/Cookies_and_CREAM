{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Transcript Extractor", "description": "Extract clean transcript text and timestamped lines from the active YouTube video.", "version": "0.1.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "YouTube Transcript", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://youtu.be/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "host_permissions": ["https://mintapi.dev/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://youtu.be/*"], "permissions": ["activeTab", "tabs"]}