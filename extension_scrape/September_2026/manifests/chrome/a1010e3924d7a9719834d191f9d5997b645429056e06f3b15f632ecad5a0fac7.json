{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Cooldown \u2014 Pause before you send", "version": "0.5.3", "description": "Smart cooldown before sending impulsive messages on social and email platforms. Stop regret messages.", "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*", "https://old.reddit.com/*", "https://new.reddit.com/*", "https://web.whatsapp.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*", "https://extensionpay.com/*"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"quick-pause": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Pause Cooldown 15 minutes"}, "toggle-enabled": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Activer / d\u00e9sactiver Cooldown"}, "panic-pause": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Mode panique : pause 24h"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["lib/extpay.js", "content/shared.js", "content/pro.js", "content/twitter.js"], "css": ["content/modal.css"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://new.reddit.com/*"], "js": ["lib/extpay.js", "content/shared.js", "content/pro.js", "content/reddit.js"], "css": ["content/modal.css"], "run_at": "document_idle"}, {"matches": ["https://web.whatsapp.com/*"], "js": ["lib/extpay.js", "con