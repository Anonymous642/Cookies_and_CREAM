{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WorldClock", "version": "1.4.4", "description": "Live timezone clocks on every page, plus a meeting planner that finds the best overlap across your zones.", "permissions": ["storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "WorldClock"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "options_ui": {"page": "settings.html", "open_in_tab": true}, "commands": {"toggle-pill": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Show or hide the WorldClock pill bar"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}