{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dualogues: Your Navigator for ChatGPT", "description": "Navigate long AI chats with a quiet trackline, outlines, and one-click jumps. Find the right round without endless scrolling.", "version": "0.2.0.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.google-analytics.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.google-analytics.com;"}, "web_accessible_resources": [{"resources": ["chatgpt-network-bridge.js"], "matches": ["https://chatgpt.com/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["https://chatgpt.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}