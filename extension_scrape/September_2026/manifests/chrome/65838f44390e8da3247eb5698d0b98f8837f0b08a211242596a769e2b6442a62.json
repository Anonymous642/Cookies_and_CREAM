{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Foqux - Spaced Repetition Smart Task Manager", "version": "1.0.1", "description": "Manage tasks and habits using spaced repetition and Pomodoro timers.", "permissions": ["storage", "tabs", "contextMenus", "alarms", "notifications", "declarativeNetRequest"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Spaced Repetition"}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "privacy-policy.html", "design-system.css", "pages-shared.css", "scripts/page-frame-helper.js", "lib/chart.min.js"], "matches": ["<all_urls>"]}, {"resources": ["*.html", "*.js", "*.css", "modules/*.js", "ui-controllers/*.js"], "matches": ["chrome-extension://*/*"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Spaced Repetition"}}}