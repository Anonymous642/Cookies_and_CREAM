{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "CartCandy - Save and Share Your Shopping Carts", "version": "1.0.0", "description": "Save, track, and share your online shopping carts across different websites. Click the extension to capture your cart!", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "alarms"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.ebay.com/*", "*://*.ebay.ca/*", "*://*.target.com/*", "*://*.walmart.com/*", "*://*.nike.com/*", "*://*.apple.com/*", "*://*.shein.com/*", "*://*.us.shein.com/*", "https://cart-candy-api.onrender.com/api/v1/*", "https://cart-candy-web.onrender.com/*", "http://localhost:8080/*", "http://localhost:4000/*"], "action": {"default_popup": "index.html", "default_title": "CartCandy - Save Your Cart", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.ebay.com/*", "*://*.ebay.ca/*", "*://*.target.com/*", "*://*.walmart.com/*", "*://*.nike.com/*", "*://*.apple.com/*", "*://*.shein.com/*", "*://*.us.shein.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Open CartCandy to save your cart"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}