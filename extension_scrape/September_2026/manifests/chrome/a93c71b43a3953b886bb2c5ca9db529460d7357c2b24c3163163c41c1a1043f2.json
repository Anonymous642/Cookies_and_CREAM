{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ABAIQ - AI Session Notes for ABA", "version": "5.3.5", "key": "", "description": "AI-powered session notes for RBTs & BCBAs. Smart Graphs with forecast. Works with any EMR.", "minimum_chrome_version": "120", "permissions": ["activeTab", "clipboardWrite", "tabs", "storage", "sidePanel", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "side_panel": {"default_path": "sidepanel.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src * data:"}, "background": {"service_worker": "background.js"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "ABAIQ", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Toggle ABAIQ sidebar"}, "improve-selection": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Improve selected text"}, "autocomplete-details": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Autocomplete session details"}, "generate-draft": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Generate note draft"}}, "content_scripts": [{"matches": ["https://abaiq.ai/*", "https://*.abaiq.ai/*"], "js": ["content-abaiq.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "exclude_matches": ["*://*.officepuzzle.com/*", "*://officepuzzle.com/*"], "js": ["content-selection.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}]}