{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Productivity Assistant", "version": "1.2.0", "description": "Local AI writing assistant. Draft replies, brief yourself on any page, keep your own context. Runs on your machine via LM Studio.", "permissions": ["activeTab", "storage", "sidePanel", "contextMenus", "notifications", "alarms"], "host_permissions": ["http://localhost:1234/*", "http://127.0.0.1:1234/*"], "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/page-extractor.js", "content/button-injector.js", "content/floating-menu.js"], "run_at": "document_idle"}], "side_panel": {"default_path": "sidepanel/index.html"}, "background": {"service_worker": "worker.js", "type": "module"}, "action": {"default_title": "Open AI Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}