{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "version": "4.2.0", "name": "Sesh - Tabs, Sessions & RAM Saver", "short_name": "Sesh", "description": "Vertical tabs, sessions, and a RAM saver. Close windows without losing tabs. Up to 77% less RAM, 94% less CPU.", "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "action": {"default_popup": "src/pages/popup/index.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png"}}, "side_panel": {"default_path": "src/pages/panel/index.html"}, "chrome_url_overrides": {"newtab": "src/pages/newtab/index.html"}, "icons": {"128": "icon-128.png"}, "permissions": ["tabs", "storage", "bookmarks", "favicon", "sidePanel", "history", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S"}, "description": "Open or close Sesh"}, "switch-to-last-tab": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Switch to last tab"}, "switch-to-last-window": {"suggested_key": {"default": "Alt+W", "mac": "Option+W"}, "description": "Switch to last window"}}}