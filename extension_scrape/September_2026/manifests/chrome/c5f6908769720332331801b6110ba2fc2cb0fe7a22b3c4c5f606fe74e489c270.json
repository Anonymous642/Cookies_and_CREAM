{"update_url": "https://clients2.google.com/service/update2/crx", "name": "eBook Scraper", "version": "1.3.1", "description": "Save eBook pages as a PDF", "manifest_version": 3, "background": {"service_worker": "js/eventPage.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"512": "icon-512.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png", "512": "icon-512.png"}, "permissions": ["tabs", "declarativeContent", "storage", "unlimitedStorage", "webRequest"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["*://*.proquest.com/*", "*://*.proquest.com/*", "*://www.jstor.org/"]}