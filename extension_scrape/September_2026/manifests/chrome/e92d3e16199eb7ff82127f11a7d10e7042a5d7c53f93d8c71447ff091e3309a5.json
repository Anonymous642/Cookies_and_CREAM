{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Add QR Code Generator Icon Back To Address Bar", "description": "A Extension To Add QR Code Generator Icon Back To Address Bar", "version": "1.6.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["activeTab", "storage"], "action": {"default_popup": "popup.html", "default_title": "Add QR Code Generator Icon Back To Address Bar"}, "options_ui": {"open_in_tab": true, "page": "configuration.html"}, "commands": {"show-qrcode": {"suggested_key": {"mac": "Alt+Shift+Q", "default": "Alt+Shift+Q"}, "description": "Show QR code for current page"}}, "web_accessible_resources": [{"resources": ["wasm/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"service_worker": "background.js"}}