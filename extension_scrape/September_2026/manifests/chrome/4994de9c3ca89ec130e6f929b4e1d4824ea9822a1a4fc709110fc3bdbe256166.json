{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bondery Extension", "description": "Import contacts from social media directly to Bondery Webapp", "version": "1.10.1", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Bondery Extension", "default_popup": "popup.html"}, "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*", "https://*.linkedin.com/*", "https://app.usebondery.com/*", "https://api.usebondery.com/*"], "permissions": ["storage", "identity", "alarms"], "web_accessible_resources": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "resources": ["instagram-interceptor.js"]}, {"resources": ["content-scripts/instagram.css"], "use_dynamic_url": true, "matches": ["https://instagram.com/*", "https://www.instagram.com/*"]}, {"resources": ["content-scripts/linkedin.css"], "use_dynamic_url": true, "matches": ["https://*.linkedin.com/*", "https://linkedin.com/*", "https://www.linkedin.com/*"]}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://instagram.com/*", "https://www.instagram.com/*"], "run_at": "document_start", "js": ["content-scripts/instagram.js"]}, {"matches": ["https://*.linkedin.com/*", "https://linkedin.com/*", "https://www.linkedin.com/*"], "run_at": "document_start", "js": ["content-scripts/linkedin.js"]}, {"matches": ["http://localhost/*", "https://app.usebondery.com/*"], "run_at": "document_idle", "js": ["content-scripts/webapp.js"]}]}