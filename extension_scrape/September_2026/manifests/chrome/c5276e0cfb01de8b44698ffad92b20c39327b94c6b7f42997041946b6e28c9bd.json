{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PowerDialer AI: Parallel Dial & Click to Call", "description": "Click-to-dial on any site or CRM. Build call lists, run Power & Parallel Dialing, sync with HubSpot, Salesforce & more.", "version": "2.5.0", "icons": {"16": "icons/powerdialer-icon.png", "32": "icons/powerdialer-icon.png", "48": "icons/powerdialer-icon.png", "128": "icons/powerdialer-icon.png"}, "permissions": ["storage", "cookies", "tabs", "scripting", "system.display", "alarms", "offscreen"], "host_permissions": ["https://backend.leadconnectorhq.com/*", "https://services.leadconnectorhq.com/*", "https://*.leadconnectorhq.com/*", "https://*.msgsndr.com/*", "https://clerk.powerdialer.ai/*", "https://heroic-bengal-5.clerk.accounts.dev/*", "https://app.powerdialer.ai/*", "https://dev.powerdialer.ai/*", "https://api.powerdialer.ai/*", "https://api-staging.powerdialer.ai/*"], "externally_connectable": {"matches": ["https://app.gohighlevel.com/*", "https://*.msgsndr.com/*"]}, "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "PowerDialer", "default_icon": "icons/powerdialer-icon.png"}, "commands": {"hangup-call": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Hang up the current call"}, "mute-toggle": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Toggle microphone mute"}, "session-toggle": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Pause or resume dialing session"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*/*"], "run_at": "document_start", "js": ["content-scripts/ghl-interceptor.js", "content-scripts/odoo-interceptor.js"], "world": "MAIN"}, {"matches": ["https://*/*"], "run_at": "document_idle", "js": ["content-scripts/ghl.js", "content-scripts/odoo.js"]}]}