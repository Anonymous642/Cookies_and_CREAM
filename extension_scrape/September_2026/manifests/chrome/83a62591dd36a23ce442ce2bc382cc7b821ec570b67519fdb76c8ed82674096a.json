{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "A2F \u2014 Any HTML/Website to Figma", "version": "1.0.2", "description": "Capture any web page, pasted HTML, or a URL and rebuild it as editable Figma layers. Pairs with the A2F Figma plugin.", "icons": {"16": "icons/h2f-16.png", "32": "icons/h2f-32.png", "48": "icons/h2f-48.png", "128": "icons/h2f-128.png"}, "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "dist/background.js"}, "action": {"default_icon": {"16": "icons/h2f-16.png", "32": "icons/h2f-32.png", "48": "icons/h2f-48.png", "128": "icons/h2f-128.png"}, "default_popup": "src/popup/index.html", "default_title": "A2F"}, "commands": {"capture-page": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Capture the current page to the Figma clipboard"}}}