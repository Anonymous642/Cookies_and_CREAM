{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SuiteLedger \u2014 NetSuite Project Tracker", "version": "1.5.1", "description": "Track NetSuite fields, forms, workflows, templates, bins, RF-SMART functions, scripts, and more.", "minimum_chrome_version": "116", "permissions": ["storage", "sidePanel", "activeTab", "scripting", "clipboardWrite"], "content_scripts": [{"matches": ["https://*.netsuite.com/app/common/custom/*", "https://*.netsuite.com/app/common/scripting/*", "https://*.netsuite.com/app/common/workflow/*", "https://*.netsuite.com/app/common/search/search.nl*", "https://*.netsuite.com/app/setup/role.nl*", "https://*.netsuite.com/app/setup/customrole.nl*", "https://*.netsuite.com/app/crm/common/merge/emailtemplate.nl*", "https://*.netsuite.com/app/*/bin.nl*", "https://*.netsuite.com/app/site/hosting/scriptlet.nl*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}], "action": {"default_title": "Open SuiteLedger", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "index.html?panel=1"}, "options_ui": {"page": "index.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}