{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Search for Focus", "version": "1.1.3", "description": "Don't fall into the rabbit hole of endless videos. Search YouTube with filters and AI summaries outside YouTube app to stay focused.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": [], "host_permissions": ["https://www.youtube.com/*", "https://www.googleapis.com/*", "https://us-central1-qtube-b26ed.cloudfunctions.net/*"], "action": {"default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["viewer.html", "viewer.js", "viewer.css"], "matches": ["<all_urls>"]}]}