{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auto Cartify \u2014 AI Shopping Assistant", "description": "AI shopping assistant: paste a list, it searches Amazon.in and adds items to your cart. Never clicks Buy Now or payment buttons.", "version": "1.1.0", "short_name": "Auto Cartify", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "author": {"email": "pranavsharma12354@gmail.com"}, "homepage_url": "https://cartify.p2pnexus.tech", "action": {"default_title": "Open Auto Cartify", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "permissions": ["storage", "sidePanel", "scripting", "tabs", "activeTab"], "host_permissions": ["https://www.amazon.in/*", "https://cartify.p2pnexus.tech/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "side_panel": {"default_path": "sidepanel.html"}, "commands": {"immediate-cancel": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Immediately cancel any in-progress Auto Cartify run"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the Auto Cartify side panel"}}, "minimum_chrome_version": "114", "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.amazon.in/*"], "run_at": "document_idle", "js": ["content-scripts/amazon.js"]}]}