{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NetworkHQ \u2014 Connect and import leads from LinkedIn", "description": "Connect your LinkedIn accounts to NetworkHQ in one click, extract leads from LinkedIn and sync them to your NetworkHQ workspace.", "version": "0.2.3", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["cookies"], "host_permissions": ["https://sneak.networkhq.io/*", "https://app.networkhq.io/*", "https://www.linkedin.com/*", "https://linkedin.com/*", "http://localhost/*"], "externally_connectable": {"matches": ["https://sneak.networkhq.io/*", "https://app.networkhq.io/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"]}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.linkedin.com/*"]}], "action": {"default_title": "NetworkHQ LinkedIn Connector", "default_popup": "panel.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/linkedin.js"]}]}