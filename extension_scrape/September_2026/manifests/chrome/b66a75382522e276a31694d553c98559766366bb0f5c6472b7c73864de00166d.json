{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZenLite - Facebook Post Scheduler", "description": "Easily manage and schedule your Facebook Marketplace posts with ZenLite. Post smarter, faster, and hassle-free!", "version": "0.3.0", "author": "Vishy & ZenLite Team", "permissions": ["scripting", "activeTab", "storage", "alarms"], "icons": {"48": "zenLiteLogoPlugin.png"}, "action": {"default_popup": "popup.html", "default_icon": "zenLiteLogoPlugin.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://www.facebook.com/marketplace/*"], "js": ["contentscript.js"], "run_at": "document_idle"}], "host_permissions": ["https://www.facebook.com/*", "https://www.facebook.com/marketplace/*", "https://api.zenlitepro.com/*", "https://zenliteinventory.s3.amazonaws.com/*", "https://zenliteinventory.s3.us-west-1.amazonaws.com/*"]}