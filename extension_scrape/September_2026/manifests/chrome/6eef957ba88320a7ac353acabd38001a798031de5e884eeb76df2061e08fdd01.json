{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "QuickNotes", "version": "0.1.7", "description": "Local-first side-panel notes for developers with optional cloud sync.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "sidePanel", "activeTab", "scripting", "identity"], "optional_host_permissions": ["https://api.github.com/*", "https://github.com/*", "https://accounts.google.com/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "QuickNotes", "default_icon": {"16": "icon16.png", "32": "icon32.png"}, "default_popup": "src/popup.html"}, "web_accessible_resources": [{"resources": ["icon16.png", "icon32.png", "icon48.png", "icon128.png"], "matches": ["<all_urls>"]}], "side_panel": {"default_path": "src/sidepanel.html"}, "commands": {"open-mini-editor": {"suggested_key": {"default": "Ctrl+Q", "mac": "Command+Shift+Y"}, "description": "Open QuickNotes mini editor"}, "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open QuickNotes side panel"}}}