{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Blurify", "version": "2.0.0", "description": "Easily blur sensitive content, personal information, and distracting elements while browsing the web", "permissions": ["activeTab", "storage", "scripting", "notifications"], "action": {"default_title": "Blurify", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content-script.js"], "css": ["content-styles.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["content-styles.css", "index.js", "main.js", "assets/*", "onboarding.html"], "matches": ["https://*/*", "http://*/*"]}], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle Blurify"}, "blur-tool": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Select Blur Tool"}, "highlight-tool": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Select Highlight Tool"}, "erase-tool": {"suggested_key": {"default": "Alt+E", "mac": "Alt+E"}, "description": "Select Eraser Tool"}}}