{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Affiliate Link Inspector", "version": "1.1.0", "minimum_chrome_version": "114", "description": "Check affiliate links before you publish: Amazon tags, short links, redirects, duplicates and paid-link rel attributes.", "permissions": ["activeTab", "scripting", "storage", "downloads", "contextMenus", "sidePanel", "webRequest"], "background": {"service_worker": "background.js"}, "commands": {"toggle-highlight": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Toggle green highlight on all affiliate links"}}, "optional_host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.es/*", "https://*.amazon.it/*", "https://*.amazon.nl/*", "https://*.amazon.se/*", "https://*.amazon.co.jp/*", "https://*.amazon.in/*", "https://*.amazon.com.au/*", "https://*.amazon.com.mx/*", "https://*.amazon.com.br/*", "https://amzn.to/*", "https://a.co/*", "https://amzn.eu/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Affiliate Link Inspector", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "popup/popup.html?sidepanel=1"}, "options_page": "settings/settings.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}