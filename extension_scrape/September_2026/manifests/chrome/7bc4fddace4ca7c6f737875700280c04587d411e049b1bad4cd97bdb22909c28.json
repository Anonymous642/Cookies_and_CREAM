{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Overflow Sender", "version": "0.8.1", "description": "Send Overflow's Instagram outreach from your own browser session \u2014 no private API, no proxy.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "storage", "alarms", "scripting", "webNavigation"], "host_permissions": ["https://www.instagram.com/*", "https://app.overflowthrive.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://app.overflowthrive.com/*"], "js": ["connect-bridge.js"], "run_at": "document_idle"}]}