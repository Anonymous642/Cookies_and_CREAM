{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ASUP Recorder", "version": "1.0", "description": "Record user interactions on a webpage.", "permissions": ["activeTab", "tabs", "scripting", "storage"], "background": {"service_worker": "/scripts/background.js"}, "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "/images/favicon.png", "48": "/images/favicon.png", "128": "/images/icon.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["/scripts/content.js"]}]}