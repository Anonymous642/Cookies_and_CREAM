{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Frameport - Full Page Screenshot & Screen Resizer", "version": "1.7.2", "description": "Capture a full page screenshot at any resolution, or grab a region. Resize tabs to test responsive sites. No watermark, 100% local.", "permissions": ["activeTab", "debugger", "tabs", "downloads", "storage", "scripting", "offscreen", "notifications", "clipboardWrite", "system.display"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Frameport"}, "background": {"service_worker": "background.js", "type": "module"}, "commands": {"toggle-emulation": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Toggle emulation with the last used resolution"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible area"}, "capture-full": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture the full page"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture a selected region"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}