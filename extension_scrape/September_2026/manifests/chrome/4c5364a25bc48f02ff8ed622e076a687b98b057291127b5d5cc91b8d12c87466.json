{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YT Invert", "version": "1.3.2", "description": "Inverts the colors of YouTube videos and thumbnails. The same toggle also inverts Google Maps, images and video anywhere.", "permissions": ["storage", "contextMenus"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "YT Invert (click to toggle)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"], "css": ["invert.css"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}, {"matches": ["<all_urls>"], "css": ["invert_images.css", "invert_maps.css", "invert_page.css"], "js": ["content_images.js", "content_maps.js", "content_page.js"], "all_frames": true, "run_at": "document_start"}]}