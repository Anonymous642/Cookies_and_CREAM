{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZenFlow: The Focus Companion", "version": "1.3", "description": "Blocks distracting scrolls on social media to help you focus.", "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.web.telegram.org/*", "*://*.web.whatsapp.com/*", "*://*.snapchat.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.web.telegram.org/*", "*://*.web.whatsapp.com/*", "*://*.snapchat.com/*"], "js": ["content.js", "youtube-advanced.js"], "css": ["styles.css"]}]}