{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabOrganizer \u2013 Tab & Session Manager", "version": "1.0.0", "description": "Save browser sessions, group tabs by domain and restore in one click. Tab manager for Chrome power users. Never lose your work again", "author": "TabOrganizer Pro", "permissions": ["tabs", "tabGroups", "storage", "alarms", "contextMenus", "notifications"], "host_permissions": ["https://api.lemonsqueezy.com/*"], "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_title": "TabOrganizer Pro"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "open-popup": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Open TabOrganizer Pro"}}, "default_locale": "en", "web_accessible_resources": [{"resources": ["assets/images/*"], "matches": ["<all_urls>"]}]}