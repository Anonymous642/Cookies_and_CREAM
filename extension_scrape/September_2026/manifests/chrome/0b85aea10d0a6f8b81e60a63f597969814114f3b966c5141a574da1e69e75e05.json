{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Kraiken.ai - AI Prompt Manager & Library", "description": "Organize your prompt library into nested folders and instantly insert custom prompt templates into any AI tool or web workspace.", "version": "4.0.0", "manifest_version": 3, "minimum_chrome_version": "114", "icons": {"16": "kraiken.png", "48": "kraiken.png", "128": "kraiken.png"}, "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting", "clipboardWrite"], "host_permissions": ["https://kraiken.ai/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Open Kraiken.ai Sidebar", "default_icon": "kraiken.png"}, "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["kraiken-tree.js", "kraiken-tree.css", "kraiken.png"], "matches": ["<all_urls>"]}], "commands": {"toggle_sidebar": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle the Kraiken.ai sidebar"}}}