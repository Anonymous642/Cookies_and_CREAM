{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "KAM Post Generator", "version": "1.0.0", "description": "Generate on-brand replies and standalone posts for X using customizable profiles, license keys, and credits.", "permissions": ["storage", "scripting", "activeTab", "contextMenus", "clipboardWrite"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://script.google.com/*"], "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "action": {"default_title": "KAM Post Generator", "default_popup": "popup.html", "default_icon": {"16": "logo.png", "32": "logo.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}]}