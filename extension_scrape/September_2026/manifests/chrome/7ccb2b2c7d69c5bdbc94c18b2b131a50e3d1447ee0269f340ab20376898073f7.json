{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AutoClicker", "version": "2.0.1", "description": "Simple auto-clicker: pick a target, set speed, go.", "permissions": ["storage", "tabs", "scripting", "debugger", "sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "AutoClicker", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "commands": {"toggle-clicker": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Toggle auto-clicking on/off"}}}