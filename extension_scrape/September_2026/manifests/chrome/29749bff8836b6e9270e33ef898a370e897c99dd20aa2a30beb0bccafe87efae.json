{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PF Transcription", "version": "1.0.0", "description": "Send Google Meet details and show toast notifications.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["activeTab"], "host_permissions": ["https://meet.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}