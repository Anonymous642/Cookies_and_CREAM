{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "GitHub Project Intelligence", "short_name": "GPI", "version": "1.0.0", "description": "Analyse un repository GitHub (stack, architecture, s\u00e9curit\u00e9) et g\u00e9n\u00e8re un prompt structur\u00e9 pour construire un nouveau projet.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "GitHub Project Intelligence"}, "options_page": "src/options/options.html", "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["src/content/github-content.js"], "css": ["src/content/github-ui.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/utils/i18n.js"], "matches": ["https://github.com/*"]}], "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://api.github.com/*", "https://raw.githubusercontent.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Ouvrir GitHub Project Intelligence"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}