{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "HIVE AI Detector for Chrome", "version": "1.0.0", "description": "Use this extension to detect AI-generated text and images instantly with just a click.", "action": {"default_title": "HIVE AI Detector for Chrome", "default_popup": "popup.html", "default_icon": {"32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}}, "icons": {"32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}, "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "permissions": ["storage", "contextMenus", "notifications"], "web_accessible_resources": [{"resources": ["icons/*", "popup.html", "popup.js"], "matches": ["*://*/*"]}], "commands": {"detect-selected-text": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Detect AI content in selected text"}, "toggle-auto-detection": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Toggle automatic AI detection"}}}