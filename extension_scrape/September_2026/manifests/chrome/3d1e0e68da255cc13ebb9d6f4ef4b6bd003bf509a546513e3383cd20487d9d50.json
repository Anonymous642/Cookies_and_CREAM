{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Floating Tab Navigator", "version": "1.0", "description": "A floating bar that displays icons of open tabs for easy navigation with a single click. Beta Version.", "permissions": ["activeTab", "storage"], "optional_permissions": ["tabs"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/default-icon16.png", "32": "icons/default-icon32.png", "48": "icons/default-icon48.png", "128": "icons/default-icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "icons": {"16": "icons/default-icon16.png", "32": "icons/default-icon32.png", "48": "icons/default-icon48.png", "64": "icons/default-icon64.png", "128": "icons/default-icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "default_locale": "en"}