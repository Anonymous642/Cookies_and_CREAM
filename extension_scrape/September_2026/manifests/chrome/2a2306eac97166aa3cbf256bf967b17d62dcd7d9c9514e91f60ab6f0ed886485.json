{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clear Cache & Reload for Arc, Helium, Chrome and other Chromium Browsers", "short_name": "Cache Reload", "version": "1.2.0", "description": "Clear the current site's cache & service workers, then hard-reload every file fresh from the server. One click, key or menu.", "permissions": ["browsingData", "activeTab", "storage", "contextMenus", "scripting", "tabs", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Clear Cache & Reload this site", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"clear-and-reload": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Clear cache & hard reload the current tab"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}