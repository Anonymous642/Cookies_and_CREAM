{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "WebSnap", "version": "1.5", "description": "\u7f51\u9875\u622a\u56fe\u3001\u81ea\u52a8\u547d\u540d\u3001\u622a\u56fe\u7ba1\u7406\u7684Chrome\u6269\u5c55", "permissions": ["activeTab", "downloads", "storage", "tabs", "scripting"], "host_permissions": ["file://*", "https://api.notion.com/*", "https://ocr.tencentcloudapi.com/*"], "action": {"default_popup": "popup.html", "default_title": "WebSnap"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "commands": {"capture-normal": {"suggested_key": {"default": "Ctrl+Shift+7", "mac": "Command+Shift+7"}, "description": "\u9875\u9762\u5feb\u7167"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8"}, "description": "\u957f\u622a\u56fe"}, "capture-area": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "\u533a\u57df\u622a\u56fe"}, "open-history": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "Command+Shift+0"}, "description": "\u5386\u53f2\u8bb0\u5f55"}}}