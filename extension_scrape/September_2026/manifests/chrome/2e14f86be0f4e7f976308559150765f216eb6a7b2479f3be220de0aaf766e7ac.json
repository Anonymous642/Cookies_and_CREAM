{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Distill", "version": "1.0.1", "description": "Distill web pages into clean, LLM-ready markdown \u2014 works on any page, even behind login walls.", "permissions": ["activeTab", "contextMenus", "clipboardWrite", "storage"], "optional_permissions": ["tabs"], "background": {"service_worker": "background/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"quick-convert": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Quick convert page to clipboard"}, "convert-selection": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Convert selection to clipboard"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}