{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Live Streaming Downloader", "version": "1.0", "manifest_version": 3, "description": "Use this extension to download live streams from Twitch.tv, Loco.com, and more in one click.", "action": {"default-icon": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}}, "icons": {"16": "icons/Icon.png", "32": "icons/Icon.png", "64": "icons/Icon.png", "128": "icons/Icon.png"}, "permissions": ["downloads", "tabs", "activeTab", "windows", "webRequest", "storage", "notifications", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"], "run_at": "document_start"}]}