{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Meeting Auto Recorder", "version": "0.2.1", "description": "Local recorder for Google Meet and Zoom web calls. Saves audio captions automatically and supports click-start video capture.", "permissions": ["activeTab", "downloads", "offscreen", "storage", "tabs", "tabCapture"], "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://app.zoom.us/*"], "background": {"service_worker": "background.js", "type": "module"}, "commands": {"stop-and-save": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Stop and save the active meeting recording"}, "start-video-capture": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Start video capture for the active Meet or Zoom tab"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["page-audio-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.zoom.us/*", "https://app.zoom.us/*"], "js": ["page-audio-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://meet.google.com/*"], "js": ["content-meet.js"], "run_at": "document_idle"}, {"matches": ["https://*.zoom.us/*", "https://app.zoom.us/*"], "js": ["content-zoom.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Meeting Auto Recorder"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["vendor/ffmpeg/**"], "matches": ["<all_urls>"]}]}