{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipFlow - Clipboard History Manager", "short_name": "ClipFlow", "version": "1.0.0", "description": "Save everything you copy. Search your clipboard history instantly and paste any clip again. Private and stored on your device.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "clipboardWrite", "alarms"], "host_permissions": ["https://fondationdtm.org/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/capture-content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "src/popup/popup.html", "default_title": "ClipFlow - Clipboard History"}, "options_page": "src/options/options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V", "windows": "Ctrl+Shift+V"}, "description": "Open ClipFlow popup"}}}