{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AskLater Box", "version": "0.4.5", "description": "Save quotes while reading. Turn scattered thoughts into clean AI follow-up prompts. Local-first, no upload, no AI API.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "AskLater Box"}, "permissions": ["storage", "contextMenus"], "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_origin_as_fallback": true, "js": ["src/i18n.js", "src/license.js", "src/storage.js", "src/exporter.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content.css"], "matches": ["<all_urls>"]}], "commands": {"save-selection": {"suggested_key": {"default": "Alt+S", "windows": "Alt+S", "mac": "Alt+S"}, "description": "Save current selection to AskLater"}, "toggle-sidebar": {"suggested_key": {"default": "Alt+A"}, "description": "Toggle the AskLater sidebar"}}}