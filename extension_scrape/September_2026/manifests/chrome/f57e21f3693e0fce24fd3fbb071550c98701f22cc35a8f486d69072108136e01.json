{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Comment Exporter", "version": "1.0", "description": "Automatically scrolls through YouTube comments and exports them to CSV", "permissions": ["activeTab", "scripting", "downloads"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}, "host_permissions": ["*://*.youtube.com/*"]}