{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Tunnel", "version": "0.1.1", "description": "Forwards webhooks from Request Catcher to localhost with faithful HTTP replay of methods, headers, and body.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Tab Tunnel", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.requestcatcher.com/*"], "js": ["src/inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.requestcatcher.com/*"], "js": ["src/content.js"], "run_at": "document_start", "world": "ISOLATED"}]}