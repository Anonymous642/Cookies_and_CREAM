{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Radial New Tab", "version": "2.5", "description": "Wallpapers, shortcut grid and folders, web/AI access (ChatGPT/Gemini temp chats), floating quick access anywhere.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "96": "assets/icon96.png", "128": "assets/icon128.png"}, "permissions": ["storage", "scripting", "contextMenus", "tabs", "favicon", "search", "windows"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Radial New Tab"}, "web_accessible_resources": [{"resources": ["assets/*.svg"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js"}, "commands": {"focus-search": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Focus the input bar"}, "toggle-floating-search": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle floating quick access bar"}}, "chrome_url_overrides": {"newtab": "newtab.html"}}