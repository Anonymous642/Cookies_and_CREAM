{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Vim for YouTube", "description": "Browse YouTube feeds with Vim keybindings. Navigate videos, open them, and save them to Watch Later without a mouse.", "version": "1.0", "short_name": "Vim YouTube", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "homepage_url": "https://vimforyoutube.app/", "permissions": ["storage"], "action": {"default_title": "Vim for YouTube", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "run_at": "document_idle", "css": ["content-scripts/youtube.css"], "js": ["content-scripts/youtube.js"]}]}