{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PagePair Translate", "short_name": "PagePair\u7ffb\u8bd1", "version": "0.2.0", "description": "Bilingual webpage translation that keeps original English visible with paired translations and vocabulary.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://translate.googleapis.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "PagePair"}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "options_page": "src/options/options.html", "commands": {"toggle-bilingual-mode": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Toggle bilingual webpage translation"}, "translate-full-page": {"suggested_key": {"default": "Alt+W", "mac": "Alt+W"}, "description": "Translate the full webpage"}}}