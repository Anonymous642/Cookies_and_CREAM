{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fast4MP", "version": "5.2.1", "description": "Marketplace automation tools for Facebook Marketplace sellers, tailored for Sharetown workflows.", "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://www.fbsbx.com/*", "https://app.sharetown.io/*", "https://9roa2qwu7e.execute-api.us-west-1.amazonaws.com/*"], "permissions": ["tabs", "scripting", "storage", "alarms", "unlimitedStorage", "activeTab", "windows", "sidePanel", "notifications"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Fast4MP", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "homepage_url": "https://krash2501-cmyk.github.io/fast4mp-site/", "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*", "https://app.sharetown.io/*", "https://m.facebook.com/marketplace/*"], "js": ["mediaDB.js", "content/shared_scrapers.js", "content/dom_helpers.js", "content/from_published_scraper.js", "content/scrape_actions.js", "content/event_bridge.js", "content/content_selling.js", "content/content_main.js"], "run_at": "document_idle", "all_frames": false, "match_about_blank": false}], "web_accessible_resources": [{"resources": ["popup.html", "styles.css", "images/*"], "matches": ["https://www.facebook.com/*", "https://app.sharetown.io/*"]}, {"resources": ["content/bridge_page.js"], "matches": ["https://www.facebook.com/*"]}], "commands": {"toggle-pin-panel": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Fast4MP pinned side panel"}}}