{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tiuke \u2014 Captura de conversaciones", "version": "0.7.2", "description": "Captura tus reuniones (Meet, Teams) y tus chats de venta (WhatsApp, LinkedIn) y los analiza en Tiuke. Sin bot en la llamada.", "permissions": ["storage", "tabCapture", "offscreen"], "host_permissions": ["https://tiuke.vercel.app/*", "https://sonar-flame.vercel.app/*", "https://web.whatsapp.com/*", "https://www.linkedin.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"js": ["meet-hooks.js"], "matches": ["https://meet.google.com/*"], "run_at": "document_start", "world": "MAIN"}, {"js": ["pb.js", "meet-bridge.js"], "matches": ["https://meet.google.com/*"], "run_at": "document_start"}, {"js": ["teams-hooks.js"], "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"], "run_at": "document_start", "world": "MAIN"}, {"js": ["teams-bridge.js"], "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"], "run_at": "document_start"}, {"js": ["written-ui.js", "whatsapp.js"], "matches": ["https://web.whatsapp.com/*"], "run_at": "document_idle"}, {"js": ["written-ui.js", "linkedin.js"], "matches": ["https://www.linkedin.com/messaging/*", "https://www.linkedin.com/sales/*"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Tiuke", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}