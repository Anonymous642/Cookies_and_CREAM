{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ContextPack", "version": "1.0.0", "description": "Attach reusable context blocks to every AI prompt. Set your role, preferences, and instructions once \u2014 use everywhere.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.x.com/*", "https://chat.deepseek.com/*"], "background": {"service_worker": "background/service_worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.x.com/*", "https://chat.deepseek.com/*"], "js": ["content/injector.js"], "css": ["styles/injector.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"toggle-context": {"suggested_key": {"default": "Alt+X"}, "description": "Toggle context pack overlay"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}