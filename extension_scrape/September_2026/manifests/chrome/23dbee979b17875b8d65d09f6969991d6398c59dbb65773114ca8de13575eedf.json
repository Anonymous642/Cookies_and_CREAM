{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GoldPhish", "description": "AI-powered phishing detection extension.", "version": "0.1.3", "manifest_version": 3, "action": {"default_title": "GoldPhish", "default_popup": "popup.html", "default_icon": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "icons": {"16": "icons/logo-16.png", "32": "icons/logo-32.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "permissions": ["activeTab", "storage", "notifications", "alarms"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://goldphish-backend.fly.dev/*"], "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-base.js", "content-gmail.js"], "run_at": "document_idle"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content-base.js", "content-outlook.js"], "run_at": "document_idle"}]}