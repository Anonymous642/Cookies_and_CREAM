{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StudyFlow AI", "version": "1.2.1", "description": "Highlight text on any webpage and instantly generate AI summaries for better studying.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "commands": {"generate-summary": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Generate AI summary of highlighted text"}}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "StudyFlow AI - Summarize highlighted text"}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["overlay.js", "api.js", "analytics.js"], "matches": ["<all_urls>"]}]}