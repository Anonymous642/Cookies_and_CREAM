{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabswish", "version": "1.1.2", "description": "Cmd+Tab for Chrome tabs. Instantly switch and search your open tabs.", "permissions": ["tabs", "storage", "history"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}}, "quick-switch": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Switch to the previous tab"}}, "action": {"default_title": "Tabswish", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}