{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Queue", "version": "1.3", "description": "Queue prompts and send them sequentially on ChatGPT, Gemini, and Claude.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://gemini.google.com/*"], "css": ["content-ui.css"], "js": ["utils/gemini-adapter.js", "content.js"]}, {"matches": ["https://chatgpt.com/*"], "css": ["content-ui.css"], "js": ["utils/chatgpt-adapter.js", "content.js"]}, {"matches": ["https://claude.ai/*"], "css": ["content-ui.css"], "js": ["utils/claude-adapter.js", "content.js"]}]}