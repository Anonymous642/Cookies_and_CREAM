{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoteFlow \u2014 Minimal Fast Notes", "version": "1.0.0", "description": "A premium, minimal, fast, offline-first note-taking workspace that lives inside the browser.", "author": "NoteFlow Team", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "NoteFlow Quick Notes", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "contextMenus"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Open NoteFlow popup"}, "quick-capture": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick Capture selected text"}}}