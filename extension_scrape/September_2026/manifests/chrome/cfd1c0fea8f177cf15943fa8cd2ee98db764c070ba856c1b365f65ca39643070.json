{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dark Veil", "version": "1.3.0", "description": "Dark mode for any website. Photos and videos keep their real colours.", "author": {"email": "667ccgliese@gmail.com"}, "homepage_url": "https://github.com/carviort/dark-veil", "minimum_chrome_version": "111", "permissions": ["storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup/popup.html", "default_title": "Dark Veil", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/config.js", "src/content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "commands": {"toggle-site": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Activar o desactivar Dark Veil en este sitio"}}}