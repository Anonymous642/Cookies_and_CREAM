{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MapAlign for SAP Cloud Integration", "version": "2.0", "description": "Seamlessly integrates a layout button next to Simulate in CPI.", "permissions": ["scripting", "storage"], "host_permissions": ["https://*.hana.ondemand.com/*", "https://*.sap.com/*"], "commands": {"trigger-align": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Run MapAlign on the current mapping"}, "trigger-undo": {"suggested_key": {"default": "Alt+Z", "mac": "Alt+Z"}, "description": "Undo the last MapAlign layout"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.hana.ondemand.com/*", "https://*.sap.com/*"], "js": ["content.js"], "all_frames": true}]}