{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LiaKidsFilter", "version": "1.0.2", "description": "Filters inappropriate content on Netflix in real-time - mutes audio and replaces bad words in subtitles. Supports Hebrew & English.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.netflix.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.netflix.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "LiaKidsFilter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://www.netflix.com/*"]}]}