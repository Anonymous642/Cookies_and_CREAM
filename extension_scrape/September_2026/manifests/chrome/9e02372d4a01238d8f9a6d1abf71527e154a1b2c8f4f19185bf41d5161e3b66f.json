{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sticky Notes for Chrome", "version": "1.0.0", "description": "Capture ideas, pin notes on webpages, and stay organized with reminders, folders, and simple note tools.", "minimum_chrome_version": "120", "permissions": ["notifications", "alarms", "contextMenus", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service_worker.js", "type": "module"}, "action": {"default_title": "Sticky Notes for Chrome", "default_popup": "pages/popup.html"}, "options_page": "pages/options.html", "commands": {"create-note": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Create a new sticky note"}, "open-dashboard": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the NeoSticky dashboard"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["pages/*", "assets/*", "src/*"], "matches": ["<all_urls>"]}]}