{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SkimFast \u2014 X & Twitter Thread Reader", "description": "Open any X (Twitter) post's full reply thread in a popover \u2014 read it in your feed. No new tab, no clicking back and forth.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "SkimFast", "default_popup": "popup.html"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://x.com/*", "*://twitter.com/*", "https://api.polar.sh/*"], "web_accessible_resources": [{"resources": ["xhr-hook.js", "logo.png"], "matches": ["*://x.com/*", "*://twitter.com/*"]}, {"resources": ["content-scripts/x.css"], "use_dynamic_url": true, "matches": ["*://twitter.com/*", "*://x.com/*"]}], "commands": {"open-centered-skim": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Skim the tweet in the middle of your screen"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "run_at": "document_start", "js": ["content-scripts/x.js"]}]}