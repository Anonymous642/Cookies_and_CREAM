{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Shootsta - Screen Recording", "version": "1.3.5", "description": "Local screen recording with your camera in one click. Save and download an mp4 instantly.", "permissions": ["storage", "offscreen", "scripting", "notifications"], "minimum_chrome_version": "116", "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/service-worker.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared/logger.js", "shared/modal.js", "content/content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"start-stop-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start or stop recording"}, "pause-resume": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pause or resume recording"}, "open-library": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Open recordings library"}}, "web_accessible_resources": [{"resources": ["camera-bubble/camera-bubble.html", "camera-bubble/camera-bubble.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}