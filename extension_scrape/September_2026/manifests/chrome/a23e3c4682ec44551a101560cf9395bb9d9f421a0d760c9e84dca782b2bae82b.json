{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "VoicePal Extractor", "description": "Bring your own LinkedIn, X and Substack posts into VoicePal so your drafts sound like you.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "action": {"default_title": "VoicePal Extractor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["content-scripts/linkedin.js"]}, {"matches": ["https://*.substack.com/*"], "js": ["content-scripts/substack.js"]}, {"matches": ["https://app.voicepal.me/*"], "js": ["content-scripts/voicepal-connect.js"]}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/x.js"]}]}