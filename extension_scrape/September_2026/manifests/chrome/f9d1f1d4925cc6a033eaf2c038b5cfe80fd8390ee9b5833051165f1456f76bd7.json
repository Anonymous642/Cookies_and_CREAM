{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Busy Site Auto Opener", "version": "2.1.0", "description": "Automatically retry a busy website in the current tab until it responds, then notify you.", "permissions": ["storage", "scripting", "notifications"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_title": "Busy Site Auto Opener"}, "background": {"service_worker": "service-worker.js", "type": "module"}, "commands": {"start-auto": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Start auto-opening the busy site"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}