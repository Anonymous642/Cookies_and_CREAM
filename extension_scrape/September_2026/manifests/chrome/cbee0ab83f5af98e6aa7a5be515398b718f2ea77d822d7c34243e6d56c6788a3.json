{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Franker Translator", "version": "1.0.3", "description": "Translate selected text inline, on-device or with your Google Cloud API key.", "icons": {"16": "icons/franker-extension-logo-16.png", "32": "icons/franker-extension-logo-32.png", "48": "icons/franker-extension-logo-48.png", "128": "icons/franker-extension-logo-128.png"}, "background": {"service_worker": "js/background.js"}, "action": {"default_popup": "popup.html", "default_title": "Franker Translator - Quick Translate", "default_icon": {"16": "icons/franker-extension-logo-16.png", "32": "icons/franker-extension-logo-32.png", "48": "icons/franker-extension-logo-48.png", "128": "icons/franker-extension-logo-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "css": ["css/content.css"], "js": ["js/i18n.js", "js/utils.js", "js/ai.js", "js/core.js", "js/content.js"], "all_frames": true}], "web_accessible_resources": [{"resources": ["css/*", "icons/*"], "matches": ["<all_urls>"]}], "permissions": ["contextMenus", "scripting", "storage", "activeTab"], "host_permissions": ["https://translation.googleapis.com/*", "file:///*"], "commands": {"translate_selection": {"description": "Translate selected text", "suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F", "windows": "Ctrl+Shift+F", "linux": "Ctrl+Shift+F", "chromeos": "Ctrl+Shift+F"}}, "clean_page": {"description": "Hide/Clear all translations on page", "suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X", "windows": "Ctrl+Shift+X", "linux": "Ctrl+Shift+X", "chromeos": "Ctrl+Shift+X"}}}}