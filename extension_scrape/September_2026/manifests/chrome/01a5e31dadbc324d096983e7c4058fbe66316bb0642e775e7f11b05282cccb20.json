{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Panely", "version": "1.1.6", "description": "A stackable sidebar: Bookmarks Bar, open tabs, and a task checklist. Resize, collapse, reorder or hide each pane. Syncs everywhere.", "minimum_chrome_version": "116", "permissions": ["bookmarks", "tabs", "storage", "sidePanel"], "side_panel": {"default_path": "sidebar/panel.html"}, "action": {"default_title": "Open Panely sidebar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"service_worker": "background.js"}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Open the Panely sidebar"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}