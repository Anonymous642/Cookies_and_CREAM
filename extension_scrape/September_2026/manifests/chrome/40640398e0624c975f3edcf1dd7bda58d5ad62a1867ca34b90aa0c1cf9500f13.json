{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RoyaltyPeek \u2014 KDP Royalty Estimator", "version": "1.0.0", "description": "Shows a rough KDP royalty estimate overlay on Amazon book pages. Reads only the open page; sends no data anywhere.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://api.lemonsqueezy.com/*"], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["config.js", "estimator.js", "content.js"], "css": ["overlay.css"], "run_at": "document_idle"}]}