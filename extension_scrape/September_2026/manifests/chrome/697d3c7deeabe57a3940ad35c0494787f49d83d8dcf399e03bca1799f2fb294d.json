{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ReClyp - Elegant Screen recordings and Video Editor", "description": "Record your screen, edit with cuts & zoom, and export in seconds", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabCapture", "tabs", "activeTab"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "web_accessible_resources": [{"resources": ["preview.html", "icon/*"], "matches": ["<all_urls>"]}, {"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start/Stop recording"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}