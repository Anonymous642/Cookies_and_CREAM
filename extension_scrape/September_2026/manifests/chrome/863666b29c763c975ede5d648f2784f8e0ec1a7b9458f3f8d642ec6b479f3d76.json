{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Chess Lab \u2014 Review this game", "version": "1.0.2", "description": "Adds a \"Review in Chess Lab\" button to Lichess and Chess.com game pages. Unofficial; not affiliated with Lichess or Chess.com.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Chess Lab \u2014 set review site", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://lichess.org/*"], "js": ["src/config.js", "src/lichess.js"], "run_at": "document_idle"}, {"matches": ["https://www.chess.com/*", "https://chess.com/*"], "js": ["src/config.js", "src/chesscom.js"], "run_at": "document_idle"}, {"matches": ["https://playchesslab.com/*", "https://www.playchesslab.com/*"], "js": ["src/bridge.js"], "run_at": "document_idle"}]}