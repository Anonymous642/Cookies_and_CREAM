{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouTube Focus Mode", "version": "1.5", "description": "Smart auto-focus on YouTube with scroll-friendly design. Hide distractions when playing, peek sidebar on hover, and sticky player.", "permissions": ["scripting", "activeTab"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle YouTube Focus Mode"}}}