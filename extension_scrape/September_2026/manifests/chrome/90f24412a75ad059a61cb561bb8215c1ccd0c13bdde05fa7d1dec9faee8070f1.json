{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "True Job Fit - AI Job Coach for LinkedIn", "version": "2.9.0", "description": "AI job coach built around your resume. Match scores, ATS keywords, gap coaching, cover letters, interview prep - inside LinkedIn.", "permissions": ["storage", "activeTab", "tabs", "scripting", "offscreen"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://www.linkedin.com/*", "https://tjf-proxy.truejobfit.workers.dev/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}, "description": "Toggle the True Job Fit panel"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/jobs-tracker/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background/background.js"}, "web_accessible_resources": [{"resources": ["demo/demo.html", "demo/demo.js", "demo/demo.css", "demo/demo-data.js"], "matches": ["https://www.linkedin.com/*"]}]}