{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screen Timer", "version": "1.0.1", "description": "A simple and powerful timer to track your focus time manually or automatically by website, with notifications.", "author": "dgdev", "permissions": ["notifications", "storage", "scripting", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Start your screen timer!"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["sounds/timesup.mp3"], "matches": ["<all_urls>"]}]}