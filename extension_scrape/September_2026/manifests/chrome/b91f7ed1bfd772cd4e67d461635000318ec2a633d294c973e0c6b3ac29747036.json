{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BQ Smart Tab Renamer (Gemini)", "version": "1.1", "description": "Automatically renames 'Untitled query' tabs in BigQuery using the user's Google-authenticated Gemini API access.", "permissions": ["storage", "activeTab", "identity"], "oauth2": {"client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/cloud-platform", "openid", "email", "profile"]}, "host_permissions": ["https://console.cloud.google.com/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "BQ Smart Tab Renamer"}, "content_scripts": [{"matches": ["https://console.cloud.google.com/bigquery*"], "js": ["content_script.js"], "run_at": "document_idle"}]}