{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Clipboard History Manager - Secure, Fast, and Open Source", "description": "Offline, privacy-focused clipboard history manager with search, folders, favorites, pinned items, and a quick paste overlay.", "author": "Ahmed Raza", "version": "1.0.1", "minimum_chrome_version": "114", "permissions": ["storage", "clipboardWrite", "contextMenus", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Clipboard History Manager - Secure, Fast, and Open Source", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "side_panel": {"default_path": "panel/panel.html"}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "options_page": "options/options.html", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"open_popup": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open SMART Clipboard Manager"}, "open_clipboard_overlay": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Open SMART clipboard history overlay"}, "paste_item_1": {"suggested_key": {"default": "Alt+Shift+1"}, "description": "Paste most recent clipboard item"}, "paste_item_2": {"suggested_key": {"default": "Alt+Shift+2"}, "description": "Paste 2nd most recent clipboard item"}, "paste_item_3": {"description": "Paste 3rd most recent clipboard item"}}, "web_accessible_resources": [{"resources": ["content-overlay.css"], "matches": ["<all_urls>"]}]}