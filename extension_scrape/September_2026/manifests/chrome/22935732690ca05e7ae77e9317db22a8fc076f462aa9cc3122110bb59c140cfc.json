{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ranksy - Shopify App Store Intelligence", "description": "View rankings, reviews, and analytics for any Shopify app directly on the App Store.", "version": "1.5.8", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["identity", "storage", "sidePanel"], "host_permissions": ["https://apps.shopify.com/*", "https://ranksyapp.com/*", "https://*.ranksyapp.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["*://apps.shopify.com/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["*://apps.shopify.com/*"]}]}