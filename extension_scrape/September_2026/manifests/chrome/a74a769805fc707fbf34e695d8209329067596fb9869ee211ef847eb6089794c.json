{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paste Assistant", "version": "1.3", "description": "Copie le titre de l'article avec un lien 'voir en ligne' dans le presse-papiers.", "permissions": ["activeTab", "clipboardWrite", "scripting"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "Paste Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"copy-article-link": {"suggested_key": {"default": "Alt+X", "mac": "Alt+X"}, "description": "Copier titre + lien 'voir en ligne' (format Word)"}, "copy-plain-link": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Copier titre + URL brut (texte simple)"}}}