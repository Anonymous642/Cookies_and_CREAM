{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Octocopy", "description": "Copy GitHub PR details into your clipboard.", "version": "1.2.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["clipboardWrite", "storage", "contextMenus"], "host_permissions": ["https://github.com/*", "https://api.github.com/*", "http://localhost:3000/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Octocopy Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://app.graphite.com/github/pr/*", "*://github.com/*/*/pull/*"], "js": ["content-scripts/content.js"]}]}