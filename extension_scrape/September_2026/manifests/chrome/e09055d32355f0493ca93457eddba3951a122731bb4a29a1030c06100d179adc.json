{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Minzo - URL Shortener", "version": "1.5", "description": "Shorten URLs, generate QR codes, and track clicks in real time directly from your browser.", "permissions": ["activeTab", "storage", "contextMenus", "clipboardRead", "notifications"], "host_permissions": ["https://minzo.link/usethisapi/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "minzo-16x16.png", "48": "minzo-48x48.png", "128": "minzo-128x128.png"}}, "icons": {"16": "minzo-16x16.png", "48": "minzo-48x48.png", "128": "minzo-128x128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Open Minzo and shorten current page"}, "shorten-current": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Shorten current page URL silently"}}}