{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Leveo: Job Search Command Center", "version": "2.1.7", "description": "Your AI-powered job search command center \u2014 pipeline tracking, smart coaching, resume analysis, outreach drafting, and career tools.", "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel", "contextMenus", "identity"], "host_permissions": ["https://*/*"], "action": {"default_title": "Open Leveo"}, "side_panel": {"default_path": "index.html"}, "commands": {"grab-from-page": {"suggested_key": {"default": "Alt+G"}, "description": "Grab data from the current page"}, "open-pipeline": {"suggested_key": {"default": "Alt+P"}, "description": "Open pipeline view"}, "run-fit-check": {"suggested_key": {"default": "Alt+F"}, "description": "Run fit check on current job"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.greenhouse.io/*", "*://boards.greenhouse.io/*", "*://*.lever.co/*", "*://jobs.lever.co/*"], "js": ["contentScript.js"], "run_at": "document_end", "all_frames": false}], "background": {"service_worker": "background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "web_accessible_resources": [{"resources": ["pdf.worker.min.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}