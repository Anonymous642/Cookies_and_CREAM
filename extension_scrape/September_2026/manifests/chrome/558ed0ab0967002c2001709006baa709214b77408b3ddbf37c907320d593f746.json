{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "X2PIC", "version": "2.0.2", "description": "Capture any X (Twitter) post as a single PNG, including long posts. Unofficial tool, not affiliated with X Corp.", "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "alarms", "storage"], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Screenshot a post on this page"}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "background": {"service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "resources": ["icons/*"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}