{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ChatGPT Conversations Mover", "description": "Export ChatGPT conversations from personal and Team workspaces. All processing happens locally in your browser.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "background": {"service_worker": "background.js"}, "action": {"default_title": "chat-mover", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}