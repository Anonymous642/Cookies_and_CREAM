{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Assistant", "version": "1.1", "description": "A Chrome extension to help with LinkedIn interactions", "icons": {"16": "images/default_avatar.png", "32": "images/default_avatar.png", "48": "images/default_avatar.png", "128": "images/default_avatar.png"}, "action": {"default_title": "LinkedIn Assistant", "default_popup": "sidepanel.html", "default_icon": {"16": "images/default_avatar.png", "32": "images/default_avatar.png", "48": "images/default_avatar.png", "128": "images/default_avatar.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "sidePanel"], "host_permissions": ["https://*.linkedin.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.linkedin.com/ https://*.firebaseio.com/ https://*.googleapis.com/ https://*.cloudfunctions.net/"}, "web_accessible_resources": [{"resources": ["images/*", "css/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/feed/update/*"], "js": ["feed-scraper-content.js"], "run_at": "document_idle"}]}