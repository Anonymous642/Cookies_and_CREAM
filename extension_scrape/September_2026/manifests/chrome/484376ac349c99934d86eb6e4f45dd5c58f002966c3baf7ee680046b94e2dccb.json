{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClipCite \u2014 Citation Generator & Web Clipper", "description": "Citation generator and web clipper: cite any page in BibTeX or APA and save a clean Markdown clip to Notion or Obsidian.", "version": "1.2.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["activeTab", "storage"], "host_permissions": ["https://extensionpay.com/*", "https://api.crossref.org/*", "https://doi.org/*", "https://api.notion.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "ClipCite", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}, {"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}]}