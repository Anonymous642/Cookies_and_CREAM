{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Presence for Chrome", "version": "0.7.0", "description": "Automatically updates Presence for supported browser meetings, 3CX calls, and recording or streaming studios.", "permissions": ["storage", "alarms", "notifications", "scripting", "tabs", "offscreen"], "optional_host_permissions": ["https://*/*"], "host_permissions": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.streamyard.com/*", "https://*.riverside.fm/*", "https://*.riverside.com/*", "https://*.restream.io/*", "https://studio.youtube.com/*", "https://presence.arronhartt.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["meet.js"], "run_at": "document_idle"}, {"matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["teams.js"], "run_at": "document_idle"}, {"matches": ["https://*.streamyard.com/*", "https://*.riverside.fm/*", "https://*.riverside.com/*", "https://*.restream.io/*", "https://studio.youtube.com/*"], "js": ["streaming.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Presence for Chrome", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "options.html", "commands": {"quick-private": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Set Presence to Busy for 15 minutes"}, "clear-quick-status": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Clear the quick Presence status"}}}