{"update_url": "https://clients2.google.com/service/update2/crx", "name": "GutCheck", "description": "GutCheck helps you reduce impulse buying on Amazon and find alternate shopping options.", "version": "0.1", "manifest_version": 3, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "content_scripts": [{"matches": ["*://www.amazon.com/*/dp/*", "*://www.amazon.com/dp/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}