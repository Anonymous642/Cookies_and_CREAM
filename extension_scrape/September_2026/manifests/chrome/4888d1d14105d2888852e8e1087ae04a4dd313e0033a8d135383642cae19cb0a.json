{"manifest_version": 3, "version": "1.0.5", "name": "Animal Search Now", "description": "Extension adding Animal Now search engine to Chrome.", "icons": {"128": "128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://animaltabnow.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset", "enabled": true, "path": "rules.json"}]}, "chrome_settings_overrides": {"search_provider": {"name": "Animal Tab Now", "keyword": "animaltabnow.com", "search_url": "https://animaltabnow.com/search?q={searchTerms}", "favicon_url": "https://animaltabnow.com/favicon.ico", "encoding": "UTF-8", "is_default": true}}, "background": {"service_worker": "background.js"}, "update_url": "https://clients2.google.com/service/update2/crx"}