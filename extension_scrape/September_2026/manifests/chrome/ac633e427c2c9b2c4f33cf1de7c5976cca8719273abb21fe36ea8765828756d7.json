{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Veo Flow API \u2014 Google Flow API Manager", "version": "2.2.4", "description": "Auto-injects managed Google API access when you open Google Flow. Requires a Veo Flow API account.", "permissions": ["cookies", "tabs", "storage", "activeTab", "alarms", "browsingData", "management"], "host_permissions": ["https://flow.google.com/*", "https://*.flow.google.com/*", "https://www.google.com/*", "https://google.com/*", "https://*.google.com/*", "https://veoflowapi.com/*", "https://www.veoflowapi.com/*", "https://ultraflow.replit.app/*", "https://*.replit.app/*", "https://*.replit.dev/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://flow.google.com/*"], "js": ["persistent_lock.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://flow.google.com/*"], "js": ["header_lock.js"], "run_at": "document_start"}, {"matches": ["https://flow.google.com/*"], "js": ["project_filter.js"], "run_at": "document_idle"}, {"matches": ["https://flow.google.com/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["https://flow.google.com/*"], "js": ["video_charge.js"], "run_at": "document_idle"}, {"matches": ["https://www.google.com/*", "https://google.com/*"], "js": ["account_switcher_hide.js"], "run_at": "document_idle"}, {"matches": ["https://veoflowapi.com/*", "https://www.veoflowapi.com/*", "https://ultraflow.replit.app/*", "https://*.replit.app/*", "https://*.replit.dev/*"], "js": ["site_bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}