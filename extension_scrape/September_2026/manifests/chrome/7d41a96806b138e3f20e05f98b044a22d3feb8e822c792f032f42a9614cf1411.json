{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fynd", "version": "3.0.0", "description": "Find, organize and edit your bookmarks faster.", "author": "Sanoop Sivan", "homepage_url": "https://github.com/sanoopsivan/pinpoint", "permissions": ["bookmarks", "storage", "tabs", "sidePanel", "activeTab"], "side_panel": {"default_path": "dist/sidepanel.html"}, "commands": {"quick-save-bookmark": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open the Fynd quick save popup"}, "quick-search-bookmarks": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Search bookmarks (open search popup)"}}, "action": {"default_title": "Open Fynd - Find it fast", "default_popup": "dist/popup.html", "default_icon": {"16": "assets/fynd-icon-16.png", "32": "assets/fynd-icon-32.png", "48": "assets/fynd-icon-48.png", "128": "assets/fynd-icon-128.png"}}, "options_page": "dist/main.html", "background": {"service_worker": "background.js"}, "icons": {"16": "assets/fynd-icon-16.png", "32": "assets/fynd-icon-32.png", "48": "assets/fynd-icon-48.png", "128": "assets/fynd-icon-128.png"}, "web_accessible_resources": [{"resources": ["help.js", "assets/*"], "matches": ["<all_urls>"]}]}