{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Promptlator", "version": "3.0.0", "description": "Translate your thoughts into perfect prompts. AI-powered intent detection and enhancement for ChatGPT and other LLMs.", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "sidePanel", "contextMenus"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://generativelanguage.googleapis.com/*"], "optional_host_permissions": ["https://claude.ai/*", "https://gemini.google.com/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "side_panel": {"default_path": "sidepanel/index.html"}, "action": {"default_title": "Promptlator", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle prompt library panel"}, "enhance-prompt": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Manually trigger prompt enhancement"}}, "web_accessible_resources": [{"resources": ["ui/styles/*.css", "assets/icons/*", "assets/images/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}]}