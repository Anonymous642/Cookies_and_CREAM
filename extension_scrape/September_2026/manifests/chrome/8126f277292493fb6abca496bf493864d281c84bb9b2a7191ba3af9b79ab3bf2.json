{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "RepoWiki", "description": "Open any GitHub repo in DeepWiki, CodeWiki, and more", "version": "1.0.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "tabs"], "action": {"default_title": "RepoWiki", "default_popup": "popup.html"}, "commands": {"open-pinned-wiki": {"suggested_key": {"default": "Alt+W"}, "description": "Open repo in pinned wiki provider"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://github.com/*/*"], "js": ["content-scripts/content.js"]}]}