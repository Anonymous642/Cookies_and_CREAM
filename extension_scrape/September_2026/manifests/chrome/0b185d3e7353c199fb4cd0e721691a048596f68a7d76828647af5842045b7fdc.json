{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bookmend - AI Bookmark Manager, Search & Chat", "description": "AI bookmark manager: tags, summarizes and files each page you save. Chat with your bookmarks and get answers with sources. Free AI.", "version": "1.1.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel"], "host_permissions": ["https://dashboard.bookmend.app/*"], "optional_permissions": ["tabs", "bookmarks"], "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "Bookmend", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Open Bookmend"}, "save-page": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save the page you're on"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://dashboard.bookmend.app/*"], "run_at": "document_start", "js": ["content-scripts/bridge.js"]}]}