{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Easy Screen Recorder", "description": "An easier to use screen recorder extension.", "version": "1.0.1.0", "version_name": "1.0.1", "manifest_version": 3, "action": {"default_icon": {"16": "assets/favicon-16.png", "32": "assets/favicon-32.png", "48": "assets/favicon-48.png", "128": "assets/favicon-128.png"}, "default_title": "Easy Screen Recorder", "default_popup": "src/popup/index.html"}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "offline_enabled": true, "permissions": ["tabCapture", "activeTab", "tabs", "offscreen", "identity", "storage", "scripting", "desktopCapture", "unlimitedStorage", "downloads"], "oauth2": {"client_id": "751960820358-fg4kuaig6ld2eobjefrj3q79g52ikeco.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "file_system_provider_capabilities": {"configurable": true, "watchable": false, "multiple_mounts": true, "source": "file"}, "commands": {"_execute_action": {"suggested_key": {"chromeos": "Alt+Shift+R", "linux": "Alt+Shift+R", "mac": "Alt+Shift+R", "windows": "Alt+Shift+R"}}, "settings": {"description": "Show Settings tab", "suggested_key": {"default": "Alt+Shift+D"}}, "start-pause-recording": {"description": "Start/Stop a Recording", "suggested_key": {"chromeos": "Alt+Shift+S", "linux": "Alt+Shift+S", "mac": "Alt+Shift+S", "windows": "Alt+Shift+S"}}, "stop-recording": {"description": "Pause a Recording", "suggested_key": {"chromeos": "Alt+Shift+P", "linux": "Alt+Shift+P", "mac": "Alt+Shift+P", "windows": "Alt+Shift+P"}}}, "content_security_policy": {"extension_page": "script-src 'self' 'unsafe-eval'; object-src 'self'"}, "host_permissions": ["<all_urls>", "*://.sychev.xyz/"], "externally_connectable": {"matches": ["https://www.sychev.xyz/*"]}, "icons": {"16": "assets/favicon-16.png", "32": "assets/favicon-32.png", "48": "assets/favicon-48.png", "128": "assets/favicon-128.png"}}