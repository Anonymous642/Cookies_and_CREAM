{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Main AI \u2014 Document Risk Analyzer", "short_name": "Main AI", "version": "1.0.1", "description": "Analyze any document for hidden risks before you sign. Leases, contracts, NDAs, job offers, and terms of service \u2014 instant findings.", "_audit_note_2026_05_27": "v0.1.2 \u2014 icons/ directory now populated (icon-16/32/48/128.png, generated from main-ai-logo.png). Before this, the manifest referenced an icons/ directory that wasn't in the repo, blocking Chrome Web Store submission. Version bumped from 0.1.1 so existing installs pick up both the icons and any cached previous-version differences.", "permissions": ["contextMenus", "activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://mainai.live/*", "https://www.mainai.live/*", "https://mainai.netlify.app/*", "https://app.docusign.com/*", "https://docusign.com/*", "https://app.hellosign.com/*", "https://sign.dropbox.com/*", "https://documentcloud.adobe.com/*", "https://adobesign.com/*", "https://app.pandadoc.com/*", "https://app.signnow.com/*", "https://ironcladapp.com/*"], "action": {"default_popup": "popup.html", "default_title": "Main AI \u2014 Analyze this page", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["auth.js", "content.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://mainai.live/*", "https://www.mainai.live/*", "https://mainai.netlify.app/*"]}, "homepage_url": "https://mainai.live", "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}