{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sage: Pomodoro Focus & Study Timer, Website Blocker", "short_name": "Sage", "version": "1.0.9", "description": "Pomodoro focus & study timer. Block distracting websites, build working sessions for deep work, and track your focus.", "permissions": ["storage", "alarms", "idle", "notifications", "offscreen", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "chrome_url_overrides": {"newtab": "src/newtab/newtab.html"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["assets/*", "src/blocked/blocked.html", "src/newtab/newtab.html", "src/scheduler/scheduler.html", "src/premium/premium.html", "src/welcome/welcome.html"], "use_dynamic_url": false}]}