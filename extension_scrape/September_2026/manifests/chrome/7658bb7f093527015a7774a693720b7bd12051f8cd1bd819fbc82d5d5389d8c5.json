{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AskOnce - One Question, All AI", "version": "1.2.0", "description": "30% better task success rate! Send one question to multiple AI services, avoid hallucination & get all AIs working for you for free!", "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel", "notifications"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://www.google.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "AskOnce - One Question, All AI", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "side_panel": {"default_path": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*"], "js": ["content-scripts/perplexity.js"], "run_at": "document_idle"}], "options_page": "options.html", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "welcome.html", "welcome.css", "welcome.js"], "matches": ["<all_urls>"]}], "commands": {"open_popup": {"suggested_key": {"default": "Alt+Q", "mac": "Command+Shift+W"}, "description": "Open AskOnce chat popup"}}}