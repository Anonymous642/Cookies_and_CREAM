{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "116", "name": "XSaved \u2014 Bookmark Manager for X (Twitter)", "version": "1.0.21", "version_name": "0.110.1", "description": "Organize, search, and export your X (Twitter) bookmarks. The bookmark manager X never built. Free, local-first, private.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "unlimitedStorage", "cookies", "tabs", "downloads", "contextMenus", "offscreen", "identity", "alarms"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://api.xsaved.com/*"], "background": {"type": "module", "service_worker": "service-worker.js"}, "externally_connectable": {"matches": ["https://auth.xsaved.com/*"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_popup": "src/ui/popup.html", "default_title": "XSaved v2 - Local-First Bookmark Manager"}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["early-interceptor.js"], "run_at": "document_start"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["src/utils/theme-integration.js", "content.js"], "css": ["src/ui/styles.css", "src/ui/theme-sync.css"]}], "web_accessible_resources": [{"resources": ["icons/*", "src/ui/*", "fonts/*", "embedding-worker.js", "page-script.js", "fetch-interceptor.js"], "matches": ["https://twitter.com/*", "https://x.com/*", "<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Open XSaved popup"}}}