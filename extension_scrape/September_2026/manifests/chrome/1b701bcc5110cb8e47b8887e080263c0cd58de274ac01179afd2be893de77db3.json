{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "twiddle", "version": "0.1.6", "description": "Stop pasting screenshots into your agent. Tweak any live page like Figma, then copy the exact change \u2014 in that page\u2019s own tokens.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "twiddle \u2014 click to turn on/off", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-spec-lens": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Twiddle on the current tab"}}}