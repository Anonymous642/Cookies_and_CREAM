{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Font Detector", "version": "1.0", "description": "Identify any font on any webpage instantly. Click to inspect font family, size, weight & color. The easiest web font finder.", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}