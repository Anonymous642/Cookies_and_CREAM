{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Deeevas Capture", "version": "0.1.0", "description": "Collect everything for your next project. URLs, images and videos, straight to Deeevas.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "contextMenus"], "host_permissions": ["https://deeevas.com/*", "https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["context-point.js"], "run_at": "document_start"}], "background": {"service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Collect this page to Deeevas"}}, "action": {"default_title": "Collect this page to Deeevas", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}