{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Virtual Mouse Jiggler", "version": "2.1.0", "description": "Keep your computer active automatically. Prevent going idle and maintain your online presence effortlessly.", "author": "Payton Young", "homepage_url": "https://virtualmousejiggler.com", "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms", "idle"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "92": "icons/icon92.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["notify-hook.js"], "run_at": "document_start", "world": "MAIN"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "92": "icons/icon92.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "logo.png"], "matches": ["<all_urls>"]}]}