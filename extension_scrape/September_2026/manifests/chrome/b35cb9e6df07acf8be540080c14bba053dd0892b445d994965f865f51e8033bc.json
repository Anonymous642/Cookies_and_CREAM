{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lullpage \u2013 Pastel, Sepia & Dark Mode for Any Website", "short_name": "Lullpage", "version": "2.0.0", "description": "Pastel, sepia & dark themes for any website. Keeps logos and brand colors, adds warm light, night schedule. 100% private.", "author": "Lullpage", "key": "", "permissions": ["storage", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Lullpage \u2013 comfortable colors"}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open Lullpage"}, "toggle-enabled": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Turn Lullpage on / off"}, "next-theme": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Switch to the next theme"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["themes.js", "content.js"], "run_at": "document_start", "all_frames": false}]}