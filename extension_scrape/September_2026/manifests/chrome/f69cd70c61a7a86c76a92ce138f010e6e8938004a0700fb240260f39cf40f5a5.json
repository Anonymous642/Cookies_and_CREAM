{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PriceWatch PRO - Smart Price Tracker", "version": "1.0.0", "description": "Track prices across Amazon, eBay, Walmart & more. Get alerts when prices drop. Never overpay again!", "permissions": ["activeTab", "storage", "alarms", "notifications"], "host_permissions": ["https://www.amazon.com/*", "https://www.ebay.com/*", "https://www.walmart.com/*", "https://www.bestbuy.com/*", "https://www.target.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.ebay.com/*", "https://www.walmart.com/*"], "js": ["content.js"]}], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}