{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Henad Recorder", "version": "0.3.3", "description": "Records the call you are already in and sends it to Henad, which writes up what was said.", "permissions": ["activeTab", "storage", "tabCapture", "offscreen"], "host_permissions": ["https://henad.work/*", "https://henad.m19182.dev/*", "http://localhost/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Henad Recorder", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["src/call-page.js"], "run_at": "document_idle"}, {"matches": ["https://henad.work/meetings/connect*", "https://henad.m19182.dev/meetings/connect*", "http://localhost/meetings/connect*"], "js": ["src/connect-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "minimum_chrome_version": "116"}