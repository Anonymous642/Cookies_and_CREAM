{"update_url": "https://clients2.google.com/service/update2/crx", "name": "UyConverter", "version": "1.1.4", "manifest_version": 3, "description": "This extension converts content of current tab from uy to uls and from uls to uy", "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting"], "optional_host_permissions": ["https://*/*", "http://*/*"]}