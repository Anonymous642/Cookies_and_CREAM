{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PulseTimer - Sleek Focus & Alarm", "description": "A sleek, distraction-free countdown timer & alarm for deep work, focus sessions, and daily reminders.", "version": "1.0.2", "icons": {"16": "icon/icon-16.png", "32": "icon/32.png", "48": "icon/icon-48.png", "96": "icon/96.png", "128": "icon/icon-128.png"}, "permissions": ["alarms", "storage", "notifications"], "action": {"default_icon": "icon/icon-128.png", "default_title": "PulseTimer - Sleek Focus & Alarm", "default_popup": "popup.html"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+L", "mac": "MacCtrl+L"}, "description": "Toggle Countdown Alarm Panel"}}, "background": {"service_worker": "background.js"}}