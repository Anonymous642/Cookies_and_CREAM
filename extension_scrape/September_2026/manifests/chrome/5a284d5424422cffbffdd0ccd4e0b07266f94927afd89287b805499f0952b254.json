{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sort Reel - Instagram, TikTok & Facebook", "description": "Sort Instagram Reels, Posts, TikToks & Facebook Reels by views, likes, comments, shares, and saves", "version": "1.0.1", "permissions": ["activeTab", "tabs", "storage", "webNavigation", "downloads"], "host_permissions": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://facebook.com/*", "https://contai.io/sortreel/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "Icons/icon16.png", "48": "Icons/icon48.png", "128": "Icons/icon128.png"}}, "icons": {"16": "Icons/icon16.png", "48": "Icons/icon48.png", "128": "Icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "css": ["Animate/animate.css"], "js": ["Instagram/init_sortfeed_instagram.js", "Instagram/inject_instagram_script.js", "Instagram/show_overlay_banner.js"], "run_at": "document_start"}, {"matches": ["https://www.tiktok.com/*"], "css": ["Animate/animate.css"], "js": ["Tiktok/init_sortfeed_tiktok.js", "Tiktok/inject_tiktok_script.js", "Tiktok/show_overlay_banner_tiktok.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://www.facebook.com/*"], "css": ["Animate/animate.css"], "js": ["Facebook/init_sortfeed_facebook.js", "Facebook/inject_facebook_script.js", "Facebook/show_overlay_banner_facebook.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["Icons/*.png", "Instagram/script_instagram.js", "Tiktok/script_tiktok.js", "Facebook/script_facebook.js"], "matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.facebook.com/*"]}]}