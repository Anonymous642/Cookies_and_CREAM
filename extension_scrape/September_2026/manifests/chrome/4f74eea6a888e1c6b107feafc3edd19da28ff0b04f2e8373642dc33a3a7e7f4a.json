{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Demopup Capture", "version": "0.6.4", "description": "Capture any web page as a Demopup screen", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "host_permissions": ["https://app.demopup.com/*"], "action": {"default_title": "Demopup Capture \u2014 click to toggle the capture panel", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.demopup.com/*"], "js": ["sanitize.js", "serializer.js", "content.js"], "run_at": "document_idle"}], "commands": {"capture-screen": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture this screen into the demo session"}}}