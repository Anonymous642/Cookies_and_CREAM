{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tidy \u2014 bulk delete old Facebook posts, comments & likes", "version": "1.0.1", "description": "Bulk delete old Facebook posts, comments and likes from your own browser. No password, nothing uploaded \u2014 you stay in control.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Tidy", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}