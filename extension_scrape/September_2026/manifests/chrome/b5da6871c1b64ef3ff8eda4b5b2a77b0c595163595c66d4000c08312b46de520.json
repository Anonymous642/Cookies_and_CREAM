{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PhishPurge", "version": "4.6", "description": "Detect & destroy phishing, classify emails by threat level", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://mail.one.com/*", "https://www.stop-it.be/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "PhishPurge", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://mail.one.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}