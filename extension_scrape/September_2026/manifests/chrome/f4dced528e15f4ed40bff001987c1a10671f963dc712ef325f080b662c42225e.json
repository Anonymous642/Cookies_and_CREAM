{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PowerMemory", "version": "0.9.2", "description": "Save text from Gemini, Perplexity & Copilot to your PowerMemory vault, and inject saved memories back into prompts.", "permissions": ["alarms", "storage", "identity", "notifications"], "host_permissions": ["https://powermemory.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "background": {"service_worker": "bg/service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "js": ["content/orchestrator.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "ui/popup.html", "default_title": "PowerMemory", "default_icon": {"16": "public/icon-16.png", "32": "public/icon-32.png", "48": "public/icon-48.png", "128": "public/icon-128.png"}}, "icons": {"16": "public/icon-16.png", "32": "public/icon-32.png", "48": "public/icon-48.png", "128": "public/icon-128.png"}, "commands": {"save-to-vault": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Save current AI message to PowerMemory vault"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}