{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Windowsill", "version": "0.2.1", "description": "Windowsill saves a window's tabs to a list, one list per window. Keep work and personal windows separate.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "favicon"], "action": {"default_popup": "popup.html", "default_title": "Windowsill", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "commands": {"shelve-window": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Close all tabs in this window and add them to its list"}, "show-shelf": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Show this window's list"}}}