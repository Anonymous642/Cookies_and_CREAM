{"update_url": "https://clients2.google.com/service/update2/crx", "name": "WhatsApp theme manager", "permissions": ["activeTab", "declarativeContent", "scripting", "storage"], "version": "1.08", "manifest_version": 3, "description": "Conveniently switch between light and dark themes on Whatsapp Web.", "background": {"service_worker": "background.js"}, "action": {"default_title": "Whatsapp theme manager", "default_popup": "home.html", "default_icon": {"16": "images/whave16.png", "32": "images/whave32.png", "48": "images/whave48.png", "128": "images/whave128.png"}}, "icons": {"16": "images/whave16.png", "32": "images/whave32.png", "48": "images/whave48.png", "128": "images/whave128.png"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "run_at": "document_idle", "js": ["theme.js"]}]}