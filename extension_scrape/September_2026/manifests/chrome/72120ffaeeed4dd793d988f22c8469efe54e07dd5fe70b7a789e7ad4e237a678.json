{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gumhop", "description": "Turn thoughts into scheduled tasks with AI, save any page, and check off your lists \u2014 without leaving your tab.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "activeTab"], "action": {"default_title": "Gumhop", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+G"}, "description": "Open the Gumhop popup"}}, "externally_connectable": {"matches": ["https://www.gumhop.com/*", "https://gumhop.com/*"]}, "background": {"service_worker": "background.js"}}