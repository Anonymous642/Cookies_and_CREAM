{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Goglo AI - Creative Assistant", "description": "Remove image backgrounds and move creative ideas into Goglo AI workflows.", "version": "0.1.0", "short_name": "Goglo AI", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "116", "permissions": ["activeTab", "contextMenus", "sidePanel", "storage"], "optional_host_permissions": ["https://gogloai.com/*"], "action": {"default_title": "Goglo AI", "default_popup": "popup.html"}, "commands": {"open-goglo-assistant": {"suggested_key": {"default": "Alt+G", "mac": "Alt+G"}, "description": "Open Goglo AI assistant"}}, "web_accessible_resources": [{"resources": ["icon/32.png"], "matches": ["http://*/*", "https://*/*"]}], "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}