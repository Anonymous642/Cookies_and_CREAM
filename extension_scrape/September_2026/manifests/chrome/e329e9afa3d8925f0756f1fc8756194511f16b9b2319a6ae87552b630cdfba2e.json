{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Find My Bookmarks: Search Your Bookmarks", "short_name": "Find My Bookmarks", "version": "1.3.1", "manifest_version": 3, "description": "Find your bookmarks for the current website, automatically.", "minimum_chrome_version": "120", "permissions": ["bookmarks", "tabs", "storage", "sidePanel"], "host_permissions": ["https://www.google-analytics.com/*"], "background": {"service_worker": "js/background.js", "type": "module"}, "options_page": "options.html", "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_title": "Find My Bookmarks", "default_icon": "img/icon.png"}, "icons": {"16": "img/icon.png", "48": "img/icon48.png", "64": "img/icon64.png", "128": "img/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}