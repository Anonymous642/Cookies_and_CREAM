{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabs to Nap", "version": "1.1.5", "description": "Pone tus pesta\u00f1as a dormir para darle un respiro a tu RAM.", "default_locale": "en", "action": {"default_popup": "popup.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["tabs", "storage", "alarms", "contextMenus"], "host_permissions": ["<all_urls>"], "commands": {"suspend-current-tab": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Suspender la pesta\u00f1a actual"}, "suspend-other-tabs-in-window": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Suspender las otras pesta\u00f1as en la ventana"}, "suspend-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Suspender todas las pesta\u00f1as en todas las ventanas"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "128": "icon128.png"}}