{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusGuard \u2014 Block Distractions & Focus", "version": "1.0.0", "description": "Block distracting sites. YouTube Shorts always blocked. Every video needs a real reason before it plays. Reclaim your focus.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.twitch.tv/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "FocusGuard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}