{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dommedia Sign-in Guard for Gemini", "short_name": "Sign-in Guard", "version": "0.1.0", "description": "Blocks access to Google Gemini unless a Google account is signed in. Not affiliated with or endorsed by Google.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "incognito": "split", "minimum_chrome_version": "120", "permissions": ["cookies", "webNavigation", "tabs", "declarativeNetRequest", "storage"], "host_permissions": ["https://*.google.com/*"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Dommedia Sign-in Guard for Gemini", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png"}}, "declarative_net_request": {"rule_resources": [{"id": "block", "enabled": true, "path": "rules/block.json"}]}, "web_accessible_resources": [{"resources": ["pages/blocked.html"], "matches": ["https://gemini.google.com/*", "https://bard.google.com/*"]}]}