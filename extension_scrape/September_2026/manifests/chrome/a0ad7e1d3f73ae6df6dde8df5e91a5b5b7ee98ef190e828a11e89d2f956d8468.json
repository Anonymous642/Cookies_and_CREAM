{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Etsy & Amazon Competitor Data Exporter", "version": "1.1.0", "description": "Export product data and competitor research from Etsy and Amazon search pages with a single click to CSV.", "permissions": ["storage"], "host_permissions": ["https://*.etsy.com/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.it/*", "https://*.amazon.ca/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.es/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://*.etsy.com/*", "https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.it/*", "https://*.amazon.ca/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.es/*"], "js": ["scripts/config.js", "scripts/parser_etsy.js", "scripts/parser_amazon.js", "scripts/content.js"], "css": ["scripts/content.css"], "run_at": "document_end"}, {"matches": ["https://extensionpay.com/*"], "js": ["scripts/lib/ExtPay.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "products-download-csv@yourdomain.example", "strict_min_version": "109.0"}}}