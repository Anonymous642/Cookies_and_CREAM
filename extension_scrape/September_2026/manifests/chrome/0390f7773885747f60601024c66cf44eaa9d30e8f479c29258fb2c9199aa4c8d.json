{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptQA Recorder", "version": "5.0.0", "description": "Record browser flows \u00b7 inspect elements with the locator picker \u00b7 AI test authoring \u00b7 export Playwright, Cypress or Selenium", "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "downloads"], "host_permissions": ["<all_urls>", "https://www.google-analytics.com/*"], "action": {"default_icon": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "default_title": "Open PromptQA Recorder"}, "side_panel": {"default_path": "sidepanel/sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "commands": {"toggle-picker": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Toggle the locator picker on the active tab"}}}