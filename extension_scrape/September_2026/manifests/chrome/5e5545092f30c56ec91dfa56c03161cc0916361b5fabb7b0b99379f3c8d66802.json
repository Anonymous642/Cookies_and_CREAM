{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Instagram Auto Unfollower", "version": "1.1", "description": "Extensi\u00f3n para dejar de seguir en Instagram con comportamiento humano simulado.", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["https://www.instagram.com/*"], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["appSettings.json"], "matches": ["https://www.instagram.com/*"]}], "action": {"default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}