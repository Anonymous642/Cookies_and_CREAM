{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "YouShant", "version": "1.0.0", "description": "YouTube opens only for a video you clicked from Google Search. Feeds, shorts and channels stay shut.", "permissions": ["webNavigation", "storage", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.youtubekids.com/*", "*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.ie/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.co.in/*"], "background": {"service_worker": "background.js"}, "declarative_net_request": {"rule_resources": [{"id": "embeds", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.ie/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.co.in/*"], "js": ["content-google.js"], "run_at": "document_start", "all_frames": false}], "options_page": "options.html", "action": {"default_title": "YouShant", "default_popup": "options.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}