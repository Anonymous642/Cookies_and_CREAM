{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FullCapture - Full Page Screen Capture", "short_name": "FullCapture", "version": "1.0.1", "description": "Capture a full page screenshot of your current browser window with one click. Free, offline, with a built-in editor.", "author": "FullCapture", "minimum_chrome_version": "109", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "FullCapture - Take a full page screenshot", "default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "downloads", "unlimitedStorage", "contextMenus"], "commands": {"capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the full page"}, "capture-visible": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Capture the visible part only"}}, "options_page": "pages/options.html", "web_accessible_resources": [{"resources": ["pages/*", "icons/*"], "matches": ["<all_urls>"]}]}