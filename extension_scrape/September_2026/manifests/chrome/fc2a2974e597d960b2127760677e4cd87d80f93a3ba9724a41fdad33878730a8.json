{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FrameDrop", "description": "Copy the current web page body into Figma as editable layers.", "version": "0.1.0", "minimum_chrome_version": "102", "permissions": ["activeTab", "scripting"], "background": {"service_worker": "background.js"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Choose a FrameDrop capture mode", "default_popup": "capture-menu.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"capture-current-layout": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Copy the current page layout for Figma"}, "capture-expanded-layout": {"suggested_key": {"default": "Alt+Shift+G", "mac": "Alt+Shift+G"}, "description": "Copy the page with scrollable sections expanded for Figma"}}}