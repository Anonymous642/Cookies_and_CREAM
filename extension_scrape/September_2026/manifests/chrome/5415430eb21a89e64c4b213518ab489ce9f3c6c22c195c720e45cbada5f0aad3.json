{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZTools - Text & Utility Tools", "description": "Utility tools: text processors, encoders, generators, formatters. Local-first and privacy-focused. More at ztools.zaions.com", "version": "1.5.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "author": "Ahsan Mahmood <aoneahsan@gmail.com>", "homepage_url": "https://ztools.zaions.com", "permissions": ["storage", "contextMenus", "clipboardWrite", "clipboardRead", "notifications", "sidePanel", "offscreen"], "host_permissions": [], "action": {"default_title": "ZTools", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Open ZTools popup"}, "open-favorites": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open favorites"}, "open-sidebar": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open side panel"}, "transform-clipboard": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Transform clipboard content"}}, "omnibox": {"keyword": "zt"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}