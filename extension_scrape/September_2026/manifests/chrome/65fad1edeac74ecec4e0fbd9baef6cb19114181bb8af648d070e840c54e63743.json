{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Fieldy", "description": "Bring speaker names from Google Meet and Microsoft Teams into your Fieldy meeting transcripts.", "version": "0.2.2", "icons": {"32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}, "minimum_chrome_version": "120", "key": "", "host_permissions": ["http://127.0.0.1:43183/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Fieldy", "default_icon": {"32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}]}