{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "OneReply \u2014 AI Email Replies for Gmail", "description": "Reply to emails 10x faster. AI generates context-aware replies and polishes your drafts \u2014 right inside Gmail.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["pageWorld.js"], "matches": ["https://mail.google.com/*"]}], "commands": {"generate-reply": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Generate AI reply"}, "polish-draft": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Polish current draft"}}, "externally_connectable": {"matches": ["https://onereply.xyz/*"]}, "incognito": "not_allowed", "background": {"service_worker": "background.js"}, "action": {"default_title": "ONEREPLY", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}