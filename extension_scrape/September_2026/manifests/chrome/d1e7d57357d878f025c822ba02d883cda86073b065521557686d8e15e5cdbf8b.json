{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "The 725 Club: SNES Game Price Tracker", "version": "1.0.1", "description": "Track SNES & Super Famicom prices from Buyee (Japan), Mercari US & eBay US", "permissions": ["storage", "activeTab"], "host_permissions": ["https://buyee.jp/*", "https://*.mercari.com/*", "https://*.ebay.com/*", "https://the725club.com/*"], "web_accessible_resources": [{"resources": ["utils/*.js", "content/extractors/*.js", "content/*.js"], "matches": ["https://buyee.jp/*", "https://*.mercari.com/*", "https://*.ebay.com/*"]}], "content_scripts": [{"matches": ["https://buyee.jp/item/*", "https://*.mercari.com/item/*", "https://www.mercari.com/*/item/*", "https://*.ebay.com/itm/*", "https://www.ebay.com/itm/*"], "js": ["utils/storage.js", "utils/parser.js", "content/extractors/buyee.js", "content/extractors/mercari_us.js", "content/extractors/ebay_us.js", "content/extractors/index.js", "content/ui.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "options_page": "options/options.html"}