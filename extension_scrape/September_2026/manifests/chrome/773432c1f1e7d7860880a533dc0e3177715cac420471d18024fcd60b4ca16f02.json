{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "A11y Live - Accessibility Testing Tool", "version": "1.0.0", "description": "Real-time accessibility testing tool that monitors DOM changes and provides instant feedback on WCAG compliance violations.", "author": "Kvnq Poza", "homepage_url": "https://a11y-live.js.org/", "permissions": ["activeTab", "scripting", "storage"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "A11y Live - Accessibility Testing", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["extension-compatibility.js", "src/core/*.js", "src/ui/*.js", "content.js"], "matches": ["<all_urls>"]}]}