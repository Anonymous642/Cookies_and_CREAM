{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtube BETTER Summary By EffycentAI", "version": "1.0.3", "description": "It extracts the transcript from YouTube and sends it to ChatGPT automatically.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://chat.openai.com/*", "*://chatgpt.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle"}], "icons": {"128": "icons/icon128.png"}, "action": {"default_icon": "icon.png", "default_title": "YouTube Transcript to ChatGPT"}, "web_accessible_resources": [{"resources": ["logo.png", "config.png"], "matches": ["<all_urls>"]}]}