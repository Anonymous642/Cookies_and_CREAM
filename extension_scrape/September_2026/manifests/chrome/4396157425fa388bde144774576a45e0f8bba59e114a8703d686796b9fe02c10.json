{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Doom Scroll Blocker", "version": "1.0.2", "description": "Block doom scrolling with an overlay image that fades in after 1 minute. No more than 2 minutes of social media!", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.reddit.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}