{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Google Photos New Tab: Focus Timer, Website Blocker & Gratitude", "version": "1.0.0", "description": "Your photos on every new tab, plus a focus timer, a website blocker that closes work email after hours, and daily gratitude.", "permissions": ["storage", "unlimitedStorage", "alarms", "favicon", "bookmarks", "history", "topSites", "scripting", "identity"], "host_permissions": ["https://photos.google.com/*", "https://*.googleusercontent.com/*", "https://*.usercontent.google.com/*", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://photo-vibes-api.batchtools.workers.dev/*", "https://photo-vibes-api-prod.batchtools.workers.dev/*"], "background": {"service_worker": "background.js", "type": "module"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "optional_host_permissions": ["<all_urls>"]}