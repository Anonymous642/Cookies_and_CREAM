{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Litancy - Bilingual Subtitles for YouTube & DailyWire", "version": "1.0.0", "description": "Bilingual YouTube subtitles: original captions plus a translated line. Supports DailyWire. Click a word to translate it.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://clients5.google.com/*", "https://translate.googleapis.com/*", "https://lingva.ml/*", "https://api.mymemory.translated.net/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "src/popup.html", "default_title": "Litancy"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/youtube-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.dailywire.com/*", "https://dailywire.com/*"], "js": ["src/dailywire-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.dailywire.com/*", "https://dailywire.com/*"], "js": ["src/content.js"], "css": ["src/overlay.css"], "run_at": "document_idle"}]}