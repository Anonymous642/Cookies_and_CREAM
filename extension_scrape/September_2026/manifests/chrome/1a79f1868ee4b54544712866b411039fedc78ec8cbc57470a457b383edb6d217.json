{"update_url": "https://clients2.google.com/service/update2/crx", "name": "FlowerArchitect Dress Capture", "version": "1.0.0", "manifest_version": 3, "description": "User-initiated screenshot capture & cropping tool for loading inspiration images into FlowerArchitect.com for floral color matching", "permissions": ["tabs", "activeTab", "storage"], "homepage_url": "https://flowerarchitect.com", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["<all_urls>"], "action": {"default_title": "FlowerArchitect Capture", "default_popup": "popup.html"}, "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["https://www.flowerarchitect.com/*", "https://app.flowerarchitect.com/*", "https://www.davidsbridal.com/*", "https://davidsbridal.com/*", "https://*.davidsbridal.com/*", "https://www.facebook.com/*", "https://*.facebook.com/*", "https://www.instagram.com/*", "https://*.instagram.com/*", "https://www.pinterest.com/*", "https://pinterest.com/*", "https://*.pinterest.com/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}