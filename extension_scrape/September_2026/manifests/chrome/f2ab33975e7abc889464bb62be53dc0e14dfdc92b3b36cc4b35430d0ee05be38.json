{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "minimum_chrome_version": "116", "name": "ANTI Day", "version": "0.2.3", "description": "Your calendars and an optional AI assistant in a Chrome side panel.", "icons": {"16": "icons/anti-day-16.png", "32": "icons/anti-day-32.png", "48": "icons/anti-day-48.png", "64": "icons/anti-day.png", "128": "icons/anti-day-128.png"}, "permissions": ["sidePanel", "identity", "storage", "alarms"], "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"], "optional_host_permissions": ["https://openrouter.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "side_panel": {"default_path": "panel.html"}, "action": {"default_title": "ANTI Day", "default_icon": {"16": "icons/anti-day-16.png", "32": "icons/anti-day-32.png", "48": "icons/anti-day-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open the panel (built-in action shortcut)"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle the panel (custom handler)"}}, "content_security_policy": {"extension_pages": "default-src 'self'; connect-src https://www.googleapis.com https://oauth2.googleapis.com https://openrouter.ai"}}