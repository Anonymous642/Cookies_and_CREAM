{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MillionReply - Facebook Messenger Auto-Reply", "version": "1.0.0", "description": "AI-powered Facebook Messenger automation: auto-reply to DMs and Marketplace conversations in Messenger.", "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "permissions": ["storage", "tabs", "notifications", "alarms"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://app.millionreply.com/*"], "js": ["contentScript.js"], "run_at": "document_start"}, {"matches": ["https://www.facebook.com/*", "https://facebook.com/*"], "js": ["fbCookieReader.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/messages*", "https://facebook.com/messages*"], "js": ["messengerContent.js"], "run_at": "document_idle"}], "action": {"default_title": "MillionReply", "default_icon": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}}, "host_permissions": ["https://www.facebook.com/*", "https://appserver.millionreply.com/*", "https://app.millionreply.com/*"]}