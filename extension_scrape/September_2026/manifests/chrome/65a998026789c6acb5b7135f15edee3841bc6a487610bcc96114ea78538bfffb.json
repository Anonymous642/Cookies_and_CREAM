{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Abacus", "version": "0.1.25", "description": "Abacus timer controls for Asana. Timer state remains safely stored in Abacus.", "minimum_chrome_version": "114", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "background": {"service_worker": "serviceWorker.js"}, "content_scripts": [{"matches": ["https://app.asana.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Abacus", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "side_panel": {"default_path": "panel.html"}, "permissions": ["storage", "alarms", "idle", "notifications", "sidePanel"], "host_permissions": ["https://app.asana.com/*", "http://localhost/*", "https://*.test/*", "https://abacus.steadfastcollective.com/*"]}