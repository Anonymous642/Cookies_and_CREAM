{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NanoTab", "version": "0.5.0", "description": "NanoTab saves, groups, and restores tabs from a focused new tab page.", "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "tabs", "favicon"], "host_permissions": ["http://*/*", "https://*/*"], "optional_permissions": ["bookmarks"], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}