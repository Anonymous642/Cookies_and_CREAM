{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tab Groups Pro", "version": "1.2.0", "description": "Advanced tab management with auto-grouping, recovery, export/import, and bulk operations. Never rebuild your workspace again.", "permissions": ["tabs", "storage", "sessions", "contextMenus", "notifications", "commands"], "action": {"default_popup": "popup.html", "default_title": "Tab Groups - Save & Restore"}, "background": {"service_worker": "background.js"}, "commands": {"quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Quick save current tabs"}, "quick-restore": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Restore last saved group"}, "open-favorite-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Open 1st favorite/most-used group"}, "open-favorite-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Open 2nd favorite/most-used group"}}, "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "host_permissions": ["<all_urls>"]}