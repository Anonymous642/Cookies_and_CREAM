{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Bonsai - Tree Style Tab Manager & Sessions", "version": "3.0.1", "minimum_chrome_version": "114", "description": "Tabs as a tree in a floating panel. Nest, drag, search, save sessions, and browse without leaving anything in history.", "author": "treetabextension", "homepage_url": "https://github.com/TreeTab/TreeTabExtension", "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "scripting", "system.display"], "optional_permissions": ["history"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/index.js"}, "action": {"default_popup": "pages/popup/index.html", "default_title": "Bonsai", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Show or hide the Bonsai panel"}, "toggle-houdini": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Turn Houdini Mode on or off"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["pages/sidepanel/index.html", "pages/sidepanel/index.js", "pages/sidepanel/index.css", "assets/bmc-button.png"], "matches": ["http://*/*", "https://*/*"]}]}