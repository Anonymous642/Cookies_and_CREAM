{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Video Sync", "version": "0.1.14", "description": "Helps you synchronize two videos in different tabs.", "action": {"default_title": "Video Sync"}, "background": {"service_worker": "dist/background.js"}, "permissions": ["tabs", "storage"], "commands": {"video-sync-play": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Play all videos in the current room"}, "video-sync-pause": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Pause all videos in the current room"}, "video-sync-toggle": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Toggle play/pause for all videos in the current room"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["dist/content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://*.netflix.com/*"], "js": ["dist/netflix-bridge.js"], "run_at": "document_idle", "world": "MAIN"}], "options_ui": {"page": "sessions.html", "open_in_tab": true}}