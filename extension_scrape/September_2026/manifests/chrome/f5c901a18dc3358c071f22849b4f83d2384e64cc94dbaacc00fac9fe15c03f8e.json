{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EditHelper", "version": "1.1.4", "description": "Universal text edit helpers: lower<->UPPER toggle, trim, and Hangul<->Eng typo conversion.", "action": {"default_title": "EditHelper", "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting"], "background": {"service_worker": "service_worker.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"case-toggle": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle case: lower <-> UPPER"}, "trim-edges": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Trim leading/trailing whitespace"}, "eng-to-kor": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Auto-convert Korean/English typing (2-beolsik)"}, "kor-to-eng": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Auto-convert Korean/English typing (2-beolsik)"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}