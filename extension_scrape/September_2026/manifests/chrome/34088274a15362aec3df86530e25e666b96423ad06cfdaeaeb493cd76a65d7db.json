{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Push Note", "version": "1.0.2", "description": "Send notes from any Chrome tab to your phone, end-to-end encrypted. Requires the Push Note Android app on Premium.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Push Note"}, "background": {"service_worker": "background/service-worker.js", "type": "module"}, "permissions": ["storage"], "host_permissions": ["https://*.googleapis.com/*", "https://*.firebaseio.com/*", "https://*.cloudfunctions.net/*", "https://firebaseinstallations.googleapis.com/*"], "commands": {"open-compose": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Open Push Note to send a note"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}