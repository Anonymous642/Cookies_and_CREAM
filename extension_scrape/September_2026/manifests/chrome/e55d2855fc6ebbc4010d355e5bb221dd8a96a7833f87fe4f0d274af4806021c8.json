{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Gleamr: Save Articles & Read Later", "version": "1.1.2", "description": "Pocket alternative: save articles to a reading library with full-text search, tags, and JSON export. One-click Pocket import.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://gleamr.io/*", "https://api.gleamr.io/*"], "background": {"service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://gleamr.io/extension-auth*"], "js": ["utils/constants.js", "utils/logger.js", "content/auth-relay.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_title": "Save to Gleamr", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "commands": {"save-article": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current article to Gleamr"}}, "web_accessible_resources": [{"resources": ["assets/icons/*"], "matches": ["https://gleamr.io/*"]}]}