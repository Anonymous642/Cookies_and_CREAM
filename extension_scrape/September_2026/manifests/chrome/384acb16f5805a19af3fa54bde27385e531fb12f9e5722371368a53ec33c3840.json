{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Lock In: Focus & Be Productive", "version": "1.0", "description": "Block distracting social media sites to help you stay focused and achieve your goals.", "permissions": ["storage"], "host_permissions": ["https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://*.x.com/*", "https://x.com/*", "https://www.x.com/*", "https://*.reddit.com/*", "https://*.netflix.com/*", "https://*.linkedin.com/*", "https://*.instagram.com/*", "https://mail.google.com/*"], "icons": {"16": "logo16.png", "32": "logo32.png", "48": "logo48.png", "128": "logo128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "logo16.png", "32": "logo32.png", "48": "logo48.png", "128": "logo128.png"}}, "content_scripts": [{"matches": ["https://*.facebook.com/*"], "js": ["content/facebook.js"]}, {"matches": ["https://*.youtube.com/*"], "js": ["content/youtube.js"]}, {"matches": ["https://twitter.com/*", "https://www.twitter.com/*", "https://x.com/*", "https://www.x.com/*"], "js": ["content/twitter.js"], "run_at": "document_idle"}, {"matches": ["https://*.reddit.com/*"], "js": ["content/reddit.js"]}, {"matches": ["https://*.netflix.com/*"], "js": ["content/netflix.js"]}, {"matches": ["https://*.linkedin.com/*"], "js": ["content/linkedin.js"]}, {"matches": ["https://*.instagram.com/*"], "js": ["content/instagram.js"]}, {"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"]}]}