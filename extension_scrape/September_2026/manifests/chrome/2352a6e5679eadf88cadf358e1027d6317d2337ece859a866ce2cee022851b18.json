{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StockWatch", "version": "1.0.0", "description": "Watch Amazon stock and prices from your own browser. Get desktop and Telegram alerts when stock or price changes.", "minimum_chrome_version": "116", "permissions": ["storage", "alarms", "notifications", "offscreen"], "host_permissions": ["https://www.amazon.com/*", "https://stockwatch-backend-2.onrender.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*"], "js": ["parser.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "StockWatch", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}