{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "StepDeck Studio", "version": "1.2.4.500", "minimum_chrome_version": "114", "web_accessible_resources": [{"resources": ["lib/quill.min.js", "lib/quill.snow.css", "logo.png", "export/export-entry.js", "export/render-rtf.js", "export/export-model-builder.js", "export/export-template-resolver.js", "export/export-default-template.js"], "matches": ["<all_urls>"]}], "description": "Create step-by-step guides from browser work\u2014capture screenshots + notes and export to RTF. 100% local, privacy-first.", "author": "Nelson Pereira <developer@stepdeckstudio.com>", "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs", "offscreen", "sidePanel"], "host_permissions": ["<all_urls>", "https://license.stepdeckstudio.com/*"], "side_panel": {"default_path": "sidepanel/panel.html"}, "background": {"service_worker": "sw.js"}, "action": {"default_title": "StepDeck Studio - Click to activate", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture screenshot"}, "pause": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Pause/Resume capture"}, "finish": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Finish and export session"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}