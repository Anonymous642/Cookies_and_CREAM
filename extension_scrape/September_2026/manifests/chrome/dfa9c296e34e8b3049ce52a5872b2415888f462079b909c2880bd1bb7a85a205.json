{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Chess Auto Review", "description": "Extension to get latest game review from chess.com, using wintrcat's Game Report or Lichess. Automates clicks.", "version": "1.0.2", "manifest_version": 3, "permissions": ["activeTab"], "host_permissions": ["https://*.wintrcat.uk/*", "https://www.chess.com/*", "https://lichess.org/*"], "action": {"default_popup": "index.html", "default_icon": "icon48.png"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://chess.wintrcat.uk/*", "https://www.chess.com/*", "https://lichess.org/*"], "js": ["automate.js", "newwindow.js"]}]}