{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prizm Prompt", "description": "Create, improve, and organize your prompts\u2014then put them to work.", "version": "2.1.7", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["storage", "contextMenus", "identity", "sidePanel"], "host_permissions": ["*://*/*"], "action": {"default_title": "Prizm Prompt", "default_popup": "popup.html"}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"optimize-focused-input": {"suggested_key": {"default": "Alt+J", "windows": "Alt+J", "mac": "Command+J"}, "description": "__MSG_optimizeFocusedInput__"}, "save-selected-prompt": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "__MSG_saveSelectedPrompt__"}}, "background": {"service_worker": "background.js"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}