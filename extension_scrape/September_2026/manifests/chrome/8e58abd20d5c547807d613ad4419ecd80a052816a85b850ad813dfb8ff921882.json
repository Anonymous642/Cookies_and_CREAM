{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Wallchemy Helper", "description": "Adds a button to wallhaven.cc thumbnails to set the wallpaper with the wallchemy CLI app", "version": "1.0", "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "permissions": ["storage"], "background": {"service_worker": "background.js"}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "content_scripts": [{"js": ["content.js"], "css": ["style.css"], "matches": ["https://*.wallhaven.cc/*"]}]}