{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "DelPhish - Phishing Detector", "version": "1.1.4", "description": "Free URL check from the popup. Pro plan unlocks right-click analysis and Gmail/Outlook inline scanning.", "permissions": ["contextMenus", "activeTab", "storage", "scripting"], "host_permissions": ["https://delphish.app/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}