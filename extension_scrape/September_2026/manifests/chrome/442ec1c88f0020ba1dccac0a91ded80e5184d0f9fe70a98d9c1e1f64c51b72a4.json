{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Secure Browser Lock: Chrome Profile Lock", "short_name": "SecureProfile", "version": "1.0.6", "author": "shariar99", "description": "Professional security for your Chrome profile with 4-step PIN protection and a secure vault for private data.", "permissions": ["storage", "idle", "notifications", "history", "tabs", "alarms"], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"quick-lock": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock browser immediately"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}