{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Prana Focus - Block Websites + Pomodoro for Better Focus", "description": "Block or allow sites, set custom schedules, and redirect your focus to what matters \u2014 all from your browser.", "version": "1.0.9", "short_name": "Prana Focus", "homepage_url": "https://www.pranafocus.com", "icons": {"16": "prana_logo_300.png", "48": "prana_logo_300.png", "128": "prana_logo_300.png"}, "permissions": ["tabs", "storage", "declarativeNetRequest", "alarms", "notifications", "webNavigation"], "action": {"default_popup": "popup.html", "default_title": "Prana Focus"}, "web_accessible_resources": [{"resources": ["public/*.jpg", "options.html"], "matches": ["<all_urls>"]}], "options_page": "options.html", "background": {"service_worker": "background.js"}, "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "externally_connectable": {"matches": ["https://prana-focus-dev.web.app/*", "https://www.pranafocus.com/*"]}}