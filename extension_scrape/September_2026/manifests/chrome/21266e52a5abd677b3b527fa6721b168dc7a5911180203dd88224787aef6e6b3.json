{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Youtube Video Scheduler", "description": "A browser extension to schedule youtube videos, get playback speed of videos, youtube-shorts controller.", "version": "0.2.4", "icons": {"16": "/icon/icon-16.png", "32": "/icon/icon-32.png", "48": "/icon/icon-48.png", "96": "/icon/icon-96.png", "128": "/icon/icon-128.png"}, "permissions": ["activeTab", "tabs", "storage", "alarms", "notifications"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "Youtube Video Scheduler", "default_popup": "popup.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch?*"], "js": ["content-scripts/duration.js"]}, {"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/scheduler.js", "content-scripts/youtube-shorts.js"]}, {"css": ["./content-scripts/scheduler.css"], "matches": ["https://www.youtube.com/*"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content-scripts/scheduler.css"], "matches": ["https://www.youtube.com/*"]}, {"resources": ["content-scripts/youtube-shorts.css"], "matches": ["https://www.youtube.com/*"]}], "commands": {"toggle-dashboard": {"suggested_key": {"default": "Ctrl+I", "mac": "Command+I"}, "description": "Toggle the schedule dashboard", "global": true}}}