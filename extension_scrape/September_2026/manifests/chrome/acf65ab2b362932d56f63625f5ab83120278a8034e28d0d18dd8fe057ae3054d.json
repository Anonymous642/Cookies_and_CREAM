{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Speed Button for YouTube", "description": "Add a native-style speed menu button to the YouTube player and remember your preferred playback rate.", "version": "1.0.0", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/speed.png"], "matches": ["https://www.youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}