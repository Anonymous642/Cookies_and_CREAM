{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Capture Screen Workbench", "description": "Capture the current page as a stitched full-page screenshot with fixed layout awareness.", "version": "0.2.0", "manifest_version": 3, "permissions": ["activeTab", "downloads", "scripting", "sidePanel", "storage", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_title": "Capture page", "default_popup": "src/popup.html"}, "options_page": "src/options.html", "side_panel": {"default_path": "src/sidepanel.html"}, "web_accessible_resources": [{"resources": ["src/styles.css", "src/preview.html", "src/preview.js"], "matches": ["<all_urls>"]}], "commands": {"capture_current_page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the current page immediately"}}}