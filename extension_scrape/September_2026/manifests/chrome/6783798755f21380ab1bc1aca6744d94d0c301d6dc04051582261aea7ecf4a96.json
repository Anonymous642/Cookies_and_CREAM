{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "B Agent", "version": "0.113.3", "homepage_url": "https://bagents.io", "description": "Your voice runs the browser: speak commands on any site, dictate into any field, control pages with hand gestures.", "permissions": ["storage", "offscreen", "activeTab", "sidePanel", "tabCapture", "scripting", "tabs", "tts", "alarms"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"service_worker": "dist/background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/mic-on-16.png", "32": "icons/mic-on-32.png", "48": "icons/mic-on-48.png", "128": "icons/mic-on-128.png"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "commands": {"toggle-dictation": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Start or stop dictating into the focused text box"}}, "action": {"default_title": "B Agent \u2014 idle\n\nClick once  \u2192  talk to B Agent (dictate into the focused box)\nDouble-click  \u2192  open the B Agent side panel\nRight-click \u2192 Options  \u2192  pair, settings\n\nShortcut: \u2318\u21e71 / Ctrl+Shift+1", "default_icon": {"16": "icons/mic-off-16.png", "32": "icons/mic-off-32.png", "48": "icons/mic-off-48.png", "128": "icons/mic-off-128.png"}}}