{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Watchwell: YouTube Language Filter", "description": "A customizable, community-powered content filtering layer for YouTube.", "version": "3.2", "icons": {"16": "icons/themes/classic-16.png", "32": "icons/themes/classic-32.png", "48": "icons/themes/classic-48.png", "128": "icons/themes/classic-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://cleantube.heyrivo.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Watchwell", "default_icon": {"16": "icons/themes/classic-16.png", "32": "icons/themes/classic-32.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content-loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content.js", "assets/*.js", "assets/*.woff", "assets/*.woff2"], "matches": ["https://www.youtube.com/*"]}]}