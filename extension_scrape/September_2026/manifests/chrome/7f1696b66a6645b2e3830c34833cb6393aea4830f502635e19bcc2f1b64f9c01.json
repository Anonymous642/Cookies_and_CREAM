{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LeadHunter - Email Lead Generator", "version": "1.0.0", "description": "Generate targeted email leads from Google search and social media platforms", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "scripting", "alarms", "cookies"], "host_permissions": ["http://leadhunter.sites.bd/*", "https://leadhunter.sites.bd/*", "https://www.google.com/*", "https://www.google.com.bd/*", "https://*.google.com/*", "https://*.recaptcha.net/*", "https://www.facebook.com/*", "https://www.linkedin.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker.js"}, "content_scripts": [{"matches": ["https://www.google.com/*", "https://www.google.com.bd/*", "https://*.google.com/*"], "js": ["content-scripts/google-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*"], "js": ["content-scripts/facebook-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/*"], "js": ["content-scripts/linkedin-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/twitter-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["content-scripts/instagram-scraper.js"], "run_at": "document_idle"}]}