{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "eFinSidekick", "version": "1.2.5", "description": "Instantly match profiles to eFinancialCareers candidates. Get verified CVs, contact info, and AI sourcing insights in one click.", "default_locale": "en", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["cookies", "storage"], "host_permissions": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.efinancialcareers.com/*", "https://efinancialcareers.com/*"], "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.efinancialcareers.com/*"], "js": ["content.js"], "css": ["styles/global-custom.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["icons/*.png", "assets/*", "_locales/*", "_locales/en/messages.json", "_locales/fr/messages.json", "_locales/de/messages.json"], "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.efinancialcareers.com/*"]}]}