{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Uma Keep \u2022 Pick up where you left off", "version": "1.2.0", "minimum_chrome_version": "120", "description": "Keep useful pages and notes. Save project sessions and schedule reminders that appear automatically.", "permissions": ["storage", "contextMenus", "tabs", "alarms", "notifications"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "app.html?popup=1", "default_title": "Uma Keep", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"save-current": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save the current page"}, "open-workspace": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Open Uma Keep"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "omnibox": {"keyword": "uma"}}