{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "MailConnector", "version": "1.2.20", "description": "Connect Gmail with your CRM for email tracking, template insertion, and calendar scheduling, enhancing communication efficiency.", "permissions": ["storage", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "host_permissions": ["https://mail.google.com/", "https://outlook.live.com/", "https://outlook.office.com/", "https://outlook.office365.com/", "https://app.connector.email/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-loader.js"]}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content-loader.js"]}, {"matches": ["https://app.connector.email/auth/crm/ext-callback*"], "js": ["ghl-auth-callback-handler.js"], "run_at": "document_end"}, {"matches": ["https://app.connector.email/auth/google/ext-callback*"], "js": ["google-auth-callback-handler.js"], "run_at": "document_end"}, {"matches": ["https://app.connector.email/auth/microsoft/ext-callback*"], "js": ["microsoft-auth-callback-handler.js"], "run_at": "document_end"}, {"matches": ["https://app.connector.email/*"], "js": ["dashboard-bridge.js"], "run_at": "document_end"}], "background": {"service_worker": "background/index.js", "type": "module"}, "externally_connectable": {"matches": ["https://app.connector.email/*"]}, "web_accessible_resources": [{"resources": ["icons/*", "content/*", "gmail/*", "outlook/*"], "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://app.connector.email/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}