{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Clone with DevPod", "description": "Clone a repository with DevPod in one click! Adds DevPod buttons to Github repositories and pull requests.", "version": "0.3.4", "manifest_version": 3, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_popup": "src/popup.html"}, "background": {"service_worker": "src/background.js"}, "permissions": ["webNavigation", "activeTab"], "content_scripts": [{"matches": ["https://github.com/*", "https://gitlab.com/*"], "js": ["src/pages/Content.js"]}]}