{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PermLens \u2014 Access Debugger for Salesforce", "version": "1.0.0", "description": "Explain and compare Salesforce user access: object CRUD, field-level security, permission sets and record access, with export.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open PermLens", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "type": "module"}, "side_panel": {"default_path": "src/sidepanel/panel.html"}, "permissions": ["cookies", "storage", "activeTab", "tabs", "sidePanel"], "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.salesforce-setup.com/*", "https://*.my.salesforce.com/*", "https://*.lightning.force.com/*"], "content_scripts": [{"matches": ["https://*.lightning.force.com/*"], "js": ["src/content/inject.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/inpage/*"], "matches": ["https://*.lightning.force.com/*"]}]}