{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Dictabot Controller", "version": "1.2", "description": "Control voice recording in Dictabot using a global keyboard shortcut. Toggle recording from any app without switching tabs.", "permissions": ["activeTab", "scripting", "tabs", "clipboardWrite"], "host_permissions": ["http://localhost:5000/*", "https://*.replit.dev/*", "https://*.replit.app/*", "https://dictabot.ai/*", "https://*.dictabot.ai/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Dictabot Controller"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+MacCtrl+A"}, "description": "Toggle voice recording on/off", "global": true}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "externally_connectable": {"matches": ["http://localhost:5000/*", "https://*.replit.dev/*", "https://*.replit.app/*", "https://dictabot.ai/*", "https://*.dictabot.ai/*"]}}