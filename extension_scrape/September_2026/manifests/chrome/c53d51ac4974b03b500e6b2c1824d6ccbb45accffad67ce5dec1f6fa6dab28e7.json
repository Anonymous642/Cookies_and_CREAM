{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Skermo", "short_name": "Skermo", "description": "Registra lo schermo, la finestra o una scheda Chrome e salva video compressi.", "minimum_chrome_version": "116", "version": "1.0.0", "permissions": ["activeTab", "tabCapture", "desktopCapture", "offscreen", "storage", "downloads"], "host_permissions": ["https://europe-west1-skermo-recorder.cloudfunctions.net/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Skermo", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/floating-widget.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Avvia o interrompe la registrazione"}, "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Mette in pausa o riprende la registrazione"}, "toggle-mic": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Attiva o disattiva il microfono"}, "toggle-camera": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Mostra o nasconde la webcam"}}}