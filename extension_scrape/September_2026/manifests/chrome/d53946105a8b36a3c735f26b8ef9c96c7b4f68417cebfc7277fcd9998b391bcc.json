{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Soodo \u2014 Quick Capture", "version": "0.0.3", "description": "Capture time-sensitive thoughts while you work: tasks, region screenshots, voice notes and page links \u2014 synced to your Soodo lists.", "minimum_chrome_version": "116", "action": {"default_popup": "index.html", "default_title": "Soodo", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus"], "optional_host_permissions": ["<all_urls>"], "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Capture a region with Soodo"}}}