{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TabControl FS", "version": "1.2.2", "description": "Switch tabs instantly with Alt+PageUp/PageDown. Fast, lightweight navigation with a built-in switch counter. Works in fullscreen.", "minimum_chrome_version": "88", "permissions": ["storage", "activeTab"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "TabControl FS", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "commands": {"next-tab": {"suggested_key": {"default": "Alt+PageDown", "windows": "Alt+PageDown", "mac": "Alt+PageDown", "linux": "Alt+PageDown", "chromeos": "Alt+PageDown"}, "description": "Switch to next tab", "global": true}, "prev-tab": {"suggested_key": {"default": "Alt+PageUp", "windows": "Alt+PageUp", "mac": "Alt+PageUp", "linux": "Alt+PageUp", "chromeos": "Alt+PageUp"}, "description": "Switch to previous tab", "global": true}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}