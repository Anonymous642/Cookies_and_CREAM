{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Klipt \u2014 Social Media Clipper", "version": "1.0.1", "description": "Save social media posts to your Mac with one click. On-device AI auto-tags and searches them. Private, offline, no cloud.", "permissions": ["activeTab", "storage", "nativeMessaging", "alarms", "contextMenus"], "host_permissions": ["http://127.0.0.1:21453/*"], "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://discord.com/*", "https://web.telegram.org/*", "https://www.facebook.com/*", "https://www.threads.net/*", "https://www.threads.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.substack.com/*", "https://medium.com/*", "https://*.medium.com/*", "https://www.patreon.com/*"], "js": ["content-script.js"], "css": ["klipt-content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Open Klipt", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"clip-current-page": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Clip current page to Klipt"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}