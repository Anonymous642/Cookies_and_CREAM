{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Copy Text From Images & Screenshots", "short_name": "CopyText OCR", "version": "1.0.0", "description": "Copy text from images, screenshots, PDFs & webpages with fast offline OCR. Private \u2014 everything stays on your device.", "minimum_chrome_version": "116", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Copy Text From Images & Screenshots"}, "background": {"service_worker": "background.js", "type": "module"}, "options_ui": {"page": "app/app.html", "open_in_tab": true}, "permissions": ["contextMenus", "storage", "offscreen", "scripting", "clipboardWrite", "clipboardRead", "notifications"], "host_permissions": ["<all_urls>"], "commands": {"capture-region": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Capture an area of the screen and copy its text"}, "capture-visible": {"suggested_key": {"default": "Alt+Shift+V", "mac": "Alt+Shift+V"}, "description": "Capture the visible page and copy its text"}, "open-library": {"description": "Open the text library"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}