{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Auto Connect (Open Beta)", "version": "1.9.8", "description": "Auto-connects to recruiters on LinkedIn after applying. Opens People page, sends up to 5 invites, with optional auto-close.", "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "permissions": ["storage"], "host_permissions": ["*://www.linkedin.com/*", "*://*.welcometothejungle.com/*", "*://*.supabase.co/*"], "background": {"service_worker": "bg.js"}, "action": {"default_title": "LinkedIn Auto Connect", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["content-linkedin-jobs.js"], "run_at": "document_idle"}, {"matches": ["*://*.welcometothejungle.com/*"], "js": ["content-wttj-apply.js"], "run_at": "document_idle"}, {"matches": ["*://www.linkedin.com/company/*/people*"], "js": ["content-people.js"], "run_at": "document_idle"}]}