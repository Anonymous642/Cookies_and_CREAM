{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PromptVault", "version": "1.0.0", "description": "Save, organize, and instantly insert prompts into any AI platform. Sync across devices with one click.", "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.x.com/*", "https://chat.deepseek.com/*"], "background": {"service_worker": "background/service_worker.js"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://grok.x.com/*", "https://chat.deepseek.com/*"], "js": ["content/injector.js"], "css": ["styles/injector.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"open-vault": {"suggested_key": {"default": "Alt+V"}, "description": "Open prompt vault overlay"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}