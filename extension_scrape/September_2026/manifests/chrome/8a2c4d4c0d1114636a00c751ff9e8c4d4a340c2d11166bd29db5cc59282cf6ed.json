{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Task-focused Tab Manager for Trello", "short_name": "task-focused-trello", "version": "0.1.1", "description": "Remember and restore all browser tabs opened alongside a Trello card.", "author": "Schwinl", "homepage_url": "https://www.schwinl.net/task-focused-tabs-for-trello-chrome-extension/", "icons": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png"}, "default_title": "Task-focused Tab Manager for Trello"}, "background": {"service_worker": "js/background.js", "type": "module"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://trello.com/*"], "externally_connectable": {"matches": ["https://trello.com/*"]}, "web_accessible_resources": [{"resources": ["icon*.png", "debug.html", "js/debug.js"], "matches": ["https://trello.com/*"]}], "minimum_chrome_version": "88", "incognito": "split", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "options_page": "config.html"}