{"update_url": "https://clients2.google.com/service/update2/crx", "name": "TeamPassword", "version": "4.1.36", "manifest_version": 3, "homepage_url": "https://app.teampassword.com", "description": "Password sharing for collaborative teams.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "build/background.js", "type": "module"}, "action": {"default_icon": "images/icon38.png", "default_title": "TeamPassword", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["build/passkey_interceptor.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["build/inject.js"], "run_at": "document_idle", "all_frames": true}], "permissions": ["tabs", "clipboardWrite", "cookies", "storage", "offscreen", "alarms"], "web_accessible_resources": [{"resources": ["images/icon16.png"], "matches": ["<all_urls>"], "use_dynamic_url": true}], "host_permissions": ["http://localhost:3000/", "http://app.teampassword.test:3000/", "https://app.teampassword.com/"]}