{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spectator Zen for Twitch", "description": "Reduce distractions on Twitch with a simple Zen Mode toggle for spectators.", "version": "1.0.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Spectator Zen", "default_popup": "popup/popup.html"}, "permissions": ["storage"], "host_permissions": ["https://*.twitch.tv/*"], "content_scripts": [{"matches": ["https://*.twitch.tv/*"], "js": ["content/zen.js"], "css": ["content/zen.css"], "run_at": "document_idle"}], "commands": {"toggle-zen": {"suggested_key": {"default": "Alt+Z"}, "description": "Toggle Zen Mode"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open Spectator Zen popup"}}, "background": {"service_worker": "background.js"}}