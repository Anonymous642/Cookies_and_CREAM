{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ZAlgo - Engagement Quality Scores", "version": "0.1.1", "description": "Estimated engagement quality scores from public signals with local-only analytics. Compatible with x.com. No affiliation.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["scoring.js", "content.js"], "run_at": "document_idle"}]}