{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "ClickSnap - Full-Page Screenshot & Annotation Studio", "short_name": "ClickSnap", "version": "1.0.1", "author": "Sarangan Raviraj & Sahana Ravichandran", "homepage_url": "https://clicksnap.live", "description": "Capture visible screen, full webpage, or custom area with professional stitching, annotations, blur, framing, and instant export.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "ClickSnap - Capture Screenshot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "unlimitedStorage"], "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "side_panel": {"default_path": "src/sidepanel/index.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open ClickSnap popup"}, "capture_visible": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible viewport"}, "capture_fullpage": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full scrolling page"}, "capture_area": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Capture selected area"}}, "web_accessible_resources": [{"resources": ["icons/*", "content/*", "assets/*"], "matches": ["<all_urls>"]}]}