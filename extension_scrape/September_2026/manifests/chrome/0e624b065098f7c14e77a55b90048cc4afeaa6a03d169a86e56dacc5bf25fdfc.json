{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Uptime Guard - Website Uptime Monitor", "description": "Monitor your websites uptime from the toolbar. Get instant alerts when your site goes down.", "version": "1.0.0", "icons": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "permissions": ["alarms", "notifications", "storage"], "host_permissions": ["https://uptimeguard.online/api/*"], "default_locale": "en", "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}}