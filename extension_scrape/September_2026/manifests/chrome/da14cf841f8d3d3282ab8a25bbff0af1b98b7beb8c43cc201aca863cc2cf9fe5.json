{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Steam Listing Highlighter", "description": "Highlight a specific listing on the Steam Community Market.", "version": "2.3", "manifest_version": 3, "icons": {"16": "icons/icon128.png", "32": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://steamcommunity.com/market/*"], "action": {"default_popup": "popup.html", "default_title": "Steam Listing Highlighter"}, "content_scripts": [{"matches": ["https://steamcommunity.com/market/listings/*"], "js": ["highlightListing.js"], "run_at": "document_end"}]}