{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Jobla Assisted Apply", "version": "0.2.0", "description": "Fills applications in your logged-in browser using Jobla. Review answers and submit yourself. No auto-submit, no Puppeteer.", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Jobla Assisted Apply"}, "content_scripts": [{"matches": ["https://jobseeker.jobla.ai/*", "https://beta.jobseeker.jobla.ai/*", "http://localhost:*/*"], "js": ["src/bridge.js"], "run_at": "document_idle"}]}