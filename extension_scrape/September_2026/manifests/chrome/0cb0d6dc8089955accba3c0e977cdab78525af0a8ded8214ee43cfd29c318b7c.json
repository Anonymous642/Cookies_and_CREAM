{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Auris - Your AI's Voice Layer", "version": "0.4.2", "description": "Reads ChatGPT, Claude, and other AI chats aloud in real time as they stream. Hands-free text to speech, on-device.", "permissions": ["storage", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://chat.deepseek.com/*", "https://grok.com/*", "https://chat.mistral.ai/*", "https://meta.ai/*", "https://www.meta.ai/*", "https://aistudio.google.com/*", "https://huggingface.co/chat/*", "https://live.dodopayments.com/*", "https://test.dodopayments.com/*"], "optional_host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://poe.com/*", "https://chat.deepseek.com/*", "https://grok.com/*", "https://chat.mistral.ai/*", "https://meta.ai/*", "https://www.meta.ai/*", "https://aistudio.google.com/*", "https://huggingface.co/chat/*"], "js": ["src/speech.js", "src/segmenter.js", "src/adapters.js", "src/player.js", "src/main.js"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "commands": {"read-latest": {"suggested_key": {"default": "Alt+A"}, "description": "Read the latest AI response (or selected text)"}, "toggle-pause": {"suggested_key": {"default": "Alt+P"}, "description": "Pause or resume speech"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}