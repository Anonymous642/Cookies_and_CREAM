{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Simple Dark Mode", "version": "1.1.7", "description": "Simple dark mode for any website \u2014 one click from the toolbar. Easier reading at night. No signup, no data collected.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "src/background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/debug.js", "src/force-dark.css.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_start"}], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Simple Dark Mode \u2014 OFF (click to enable)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["scripting", "activeTab", "storage"]}