{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Cyberscience Tab Manager", "description": "Smart, intuitive tab management which lets you quickly search, close, suspend, move, mute", "version": "2.0.1", "manifest_version": 3, "background": {"service_worker": "version/com/cyberscience/tab-and-window-manager/service-worker/main-worker.js", "type": "module"}, "permissions": ["storage", "tabs", "unlimitedStorage", "commands", "favicon", "alarms"], "optional_permissions": ["scripting", "downloads", "offscreen"], "action": {}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+M"}}, "move_manager_to_window": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Move the tab manager to the current window"}, "global_open_manager": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Open the tab manager from any application", "global": true}}, "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"]}], "icons": {"16": "version/img/extension_icon16x16.png", "32": "version/img/extension_icon32x32.png", "48": "version/img/extension_icon48x48.png", "64": "version/img/extension_icon64x64.png", "128": "version/img/extension_icon128x128.png"}, "optional_host_permissions": ["*://*/*/cqhtml/*"]}