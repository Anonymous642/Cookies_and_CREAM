{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Zotref Checker", "version": "0.1.17", "description": "Marks items already in Zotero on Google Scholar and adds optional action/search buttons.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["http://localhost:23119/*", "http://127.0.0.1:23119/*"], "optional_host_permissions": ["https://*/*"], "background": {"service_worker": "background.js"}, "options_page": "options.html", "content_scripts": [{"matches": ["https://scholar.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}