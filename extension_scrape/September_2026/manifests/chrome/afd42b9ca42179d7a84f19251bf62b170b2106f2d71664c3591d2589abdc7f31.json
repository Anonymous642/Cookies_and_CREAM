{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Screenshot YouTube+", "version": "1.0.2", "description": "Advanced screenshot tool for YouTube with annotations, burst mode, and customization", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "downloads", "offscreen", "contextMenus"], "host_permissions": ["https://www.youtube.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["ui/button.css"], "run_at": "document_idle"}], "action": {"default_popup": "history/gallery.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "commands": {"capture-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture screenshot"}, "burst-mode": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Start burst mode capture"}, "open-gallery": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open screenshot gallery"}}, "web_accessible_resources": [{"resources": ["ui/annotation.html"], "matches": ["<all_urls>"]}]}