{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "SeaDee SnapExport", "version": "1.0.5", "description": "Local webpage export tool \u2014 capture the full page and download it as PNG, JPG, or multi-page PDF with date and time stamp.", "action": {"default_popup": "popup.html", "default_title": "SeaDee SnapExport", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"export-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Export the current page"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}