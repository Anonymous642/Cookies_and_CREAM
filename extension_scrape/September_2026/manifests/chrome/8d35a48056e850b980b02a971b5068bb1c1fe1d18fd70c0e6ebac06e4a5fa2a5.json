{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Stop Doom Scrolling on YouTube", "version": "1.0.0", "description": "Detects and helps prevent doom scrolling on YouTube, especially for Shorts. Alerts you when you're binging on short-form content.", "background": {"service_worker": "background.js"}, "icons": {"16": "icons/blacktube.png", "48": "icons/blacktube.png", "128": "icons/blacktube.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/blacktube.png", "48": "icons/blacktube.png", "128": "icons/blacktube.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage"]}