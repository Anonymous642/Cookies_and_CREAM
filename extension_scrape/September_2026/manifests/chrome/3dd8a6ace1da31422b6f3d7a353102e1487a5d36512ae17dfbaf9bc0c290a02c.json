{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PDF to Base64 Converter", "version": "1.0.0", "description": "Convert PDF files to Base64 encoding locally in your browser. Privacy-focused, no server uploads.", "permissions": ["storage", "downloads", "contextMenus"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "PDF to Base64 Converter"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options.html", "commands": {"open-converter": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open PDF to Base64 Converter"}, "copy-base64": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy Base64 to clipboard"}}, "background": {"service_worker": "background.js"}, "web_accessible_resources": [{"resources": ["converter.html", "converter.js", "converter-styles.css"], "matches": ["<all_urls>"]}]}