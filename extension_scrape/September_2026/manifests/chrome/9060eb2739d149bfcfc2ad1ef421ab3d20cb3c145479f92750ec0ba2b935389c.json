{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "PlaylistGrab: YouTube Playlist Export, Import & Transfer", "description": "Export, import & transfer YouTube playlists to CSV/JSON \u2014 with a per-video report of what actually landed.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "scripting", "sidePanel"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_title": "PlaylistGrab"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "run_at": "document_start", "js": ["content-scripts/extpay.js"]}, {"matches": ["https://www.youtube.com/*"], "js": ["content-scripts/youtube.js"]}]}