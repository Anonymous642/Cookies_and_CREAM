{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scrolladex", "version": "3.6", "description": "Enhance LinkedIn and Salesforce with notes, interactions, follow-ups, plus a tabbed dashboard, all stored in Firebase.", "icons": {"48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://*.linkedin.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*", "https://firestore.googleapis.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "dashboard.html", "default_icon": "icon.png"}, "options_page": "dashboard.html", "web_accessible_resources": [{"resources": ["popup.html", "dashboard.html", "icon.png", "firebase-config.js", "firestore-utils.js", "popup.js", "dashboard.js"], "matches": ["https://*.linkedin.com/*", "https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*"]}]}