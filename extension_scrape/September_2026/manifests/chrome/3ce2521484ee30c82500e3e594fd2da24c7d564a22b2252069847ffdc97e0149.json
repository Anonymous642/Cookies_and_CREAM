{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "TubeNotes", "version": "0.1.0", "description": "Create timestamped notes directly on YouTube videos. A powerful study and productivity tool for active learning.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://lmdwszoohbwurepcaxdo.functions.supabase.co/*"], "action": {"default_title": "TubeNotes", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "css": ["tubenotes.css"]}]}