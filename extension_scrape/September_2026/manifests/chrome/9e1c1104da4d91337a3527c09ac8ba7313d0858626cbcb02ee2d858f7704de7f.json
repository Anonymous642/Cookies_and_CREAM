{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Capture Recorder", "version": "1.3.1", "description": "\u672c\u5730\u622a\u56fe\u4e0e\u5f55\u5c4f\u5de5\u5177\u3002\u65e0\u9700\u8d26\u6237\uff0c\u4e0d\u4e0a\u4f20\u5185\u5bb9\u3002\u652f\u6301\u53ef\u89c1\u533a\u57df\u3001\u5168\u7f51\u9875\u3001\u9009\u533a\u622a\u56fe\uff0c\u4ee5\u53ca\u684c\u9762/\u6807\u7b7e\u9875/\u6444\u50cf\u5934\u5f55\u5c4f\u3002", "minimum_chrome_version": "116", "incognito": "not_allowed", "permissions": ["activeTab", "scripting", "storage", "tabCapture"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "\u622a\u56fe\u4e0e\u5f55\u5c4f", "default_icon": {"32": "assets/icon-32.png", "64": "assets/icon-64.png", "128": "assets/icon-128.png", "256": "assets/icon-256.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png", "256": "assets/icon-256.png"}, "options_page": "options.html", "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "\u622a\u53d6\u53ef\u89c1\u533a\u57df"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "\u622a\u53d6\u9009\u533a"}, "record-toggle": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "\u5f00\u59cb\u6216\u505c\u6b62\u5f55\u5c4f"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' blob:; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"}}