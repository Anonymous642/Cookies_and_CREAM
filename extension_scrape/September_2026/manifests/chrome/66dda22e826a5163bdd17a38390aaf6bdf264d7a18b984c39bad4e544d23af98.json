{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Ache - demand finder", "version": "1.0.0", "description": "Judge whether a forum thread is a real recurring pain and whether anyone in it is ready to pay. Requires your own API key.", "minimum_chrome_version": "105", "permissions": ["storage", "activeTab", "scripting", "alarms"], "host_permissions": ["https://*.reddit.com/*", "https://*.quora.com/*", "https://discord.com/*", "https://*.facebook.com/*", "https://news.ycombinator.com/*", "https://*.discourse.org/*", "https://api.typesafe.ai/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Ache", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.reddit.com/*", "https://*.quora.com/*", "https://discord.com/*", "https://*.facebook.com/*", "https://news.ycombinator.com/*", "https://*.discourse.org/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"service_worker": "background.js"}, "commands": {"judge-this-thread": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Judge the thread on this page"}, "scan-comments": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Mark comments that carry buying intent"}}}