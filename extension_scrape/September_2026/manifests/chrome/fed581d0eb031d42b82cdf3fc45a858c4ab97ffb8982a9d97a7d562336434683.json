{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Spotlight Tab", "description": "Quickly search and switch between open tabs. Supports fuzzy search through titles, URLs and tab groups.", "version": "0.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["tabs", "tabGroups"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Q"}, "description": "Open Spotlight Tab"}}, "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html"}}