{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Color Dropper", "version": "1.5.0", "description": "An easy-to-use eyedropper tool that automatically copies the Hex Code of the desired color.", "homepage_url": "https://colordropper.xyz", "minimum_chrome_version": "116", "background": {"service_worker": "service_worker.js"}, "action": {"default_title": "Color Dropper: click to pick a color, right-click for history & settings", "default_icon": {"48": "assets/48-color.png", "128": "assets/128-color.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "externally_connectable": {"matches": ["https://colordropper.xyz/*"]}, "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus"], "icons": {"48": "assets/48-color.png", "128": "assets/128-color.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E"}}, "open-panel": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Open Color Dropper panel"}}, "content_scripts": [{"matches": ["https://colordropper.xyz/*"], "js": ["site.js"], "run_at": "document_idle"}]}