{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Paste Better - Clipboard History, Easy Paste from Keyboard Shortcut", "description": "Save copied browser text locally and paste previous snippets with a shortcut.", "version": "1.0.0", "short_name": "Paste Better", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {"default_title": "Paste Better"}, "permissions": ["sidePanel"], "host_permissions": ["http://*/*", "https://*/*"], "side_panel": {"default_path": "sidepanel.html"}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}