{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Web Highlighter and Sticky Notes - Markd", "short_name": "Markd", "version": "2.2.2", "version_name": "2.2.2", "description": "Highlight web pages, add sticky notes, save bookmarks, and organize private research with tags, projects, search, and local backups.", "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite", "scripting", "sidePanel"], "host_permissions": ["<all_urls>"], "minimum_chrome_version": "114", "background": {"service_worker": "background.js", "type": "module"}, "commands": {"highlight-selection": {"suggested_key": {"default": "Alt+H"}, "description": "Highlight selected text"}, "create-sticky-note": {"suggested_key": {"default": "Alt+S"}, "description": "Add a sticky note"}}, "action": {"default_title": "Open Markd controls", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "workspace/index.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared/lucide-icons.js", "shared/theme.js", "content/activation-notice.js", "content/anchor.js", "content/content.js"], "css": ["content/highlight.css"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["content/content.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}