{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Arcus", "version": "0.7.3", "description": "A command bar for your tabs.", "permissions": ["tabs", "history", "favicon", "storage", "scripting", "activeTab"], "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "background": {"service_worker": "service-worker-loader.js", "type": "module"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["_favicon/*"], "use_dynamic_url": false}], "action": {"default_title": "Arcus", "default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-command-bar": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle the Arcus command bar"}, "copy-url": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy the current tab's URL"}, "edit-url": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Edit the current URL in the command bar"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}}}}