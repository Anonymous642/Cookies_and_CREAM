{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NoMoScroll", "description": "Control scrolling on distracting websites to prevent doomscrolling", "version": "3.0.0", "icons": {"16": "icon/16.jpg", "32": "icon/32.jpg", "48": "icon/48.jpg", "96": "icon/96.jpg", "128": "icon/128.jpg"}, "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["<all_urls>", "https://nomoscroll-backend-nomoscroll.asia-south1.run.app/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_title": "NoMoScroll"}, "commands": {"toggle-pomodoro": {"suggested_key": {"default": "Alt+Shift+P", "windows": "Alt+Shift+P", "mac": "Alt+Shift+P", "linux": "Alt+Shift+P"}, "description": "Start or stop the Pomodoro timer"}}, "content_scripts": [{"matches": ["file://*/*", "http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}