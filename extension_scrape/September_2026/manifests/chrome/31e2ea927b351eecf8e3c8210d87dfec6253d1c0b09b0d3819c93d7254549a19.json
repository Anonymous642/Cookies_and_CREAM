{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "FocusFlow", "version": "1.0.1", "description": "Pomodoro focus timer with dynamic website blocking and local stats.", "action": {"default_title": "FocusFlow", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "background": {"service_worker": "background.js", "type": "module"}, "options_page": "options.html", "permissions": ["storage", "alarms", "declarativeNetRequest", "contextMenus"], "host_permissions": ["https://*/*", "http://*/*"], "optional_permissions": ["notifications"], "commands": {"ff_start_default": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start Focus (default minutes)"}, "ff_stop": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop session"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}