{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Scenify", "version": "0.9.4", "description": "Drag a box around any image on the web and see it as a 3D scene you can look around.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "permissions": ["activeTab", "scripting", "storage", "offscreen", "unlimitedStorage"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Scenify \u2014 drag a region into 3D", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["http://*/*", "https://*/*"]}], "commands": {"capture-region": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Drag-select a region and see it in 3D"}}}