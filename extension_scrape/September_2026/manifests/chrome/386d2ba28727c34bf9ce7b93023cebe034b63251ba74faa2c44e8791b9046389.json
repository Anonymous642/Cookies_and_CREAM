{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Context Capture Saver", "description": "Save page content and YouTube transcripts as JSON files or SQLite.", "version": "1.4.2", "default_locale": "en", "permissions": ["activeTab", "clipboardRead", "contextMenus", "notifications", "offscreen", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Context Capture Saver", "default_popup": "src/popup.html"}, "web_accessible_resources": [{"resources": ["src/content-main.js", "src/content-metadata.js", "src/bubble-settings.js", "src/notification-strings.js", "src/url-helpers.js", "src/annotation-review.js", "src/content-page-extract.js", "src/content-message-router.js", "src/content-ui-styles.js", "src/content-youtube-transcript.js", "src/content-selection-bubble.js", "src/content-notes-panel.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"save-selection": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Shift+Command+D"}, "description": "Save page content (or transcript on YouTube)"}, "save-selection-with-comment": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Shift+Command+C"}, "description": "Save page content with a note (or transcript on YouTube)"}, "add-highlight": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Shift+Command+H"}, "description": "Add selected text as a queued highlight"}, "add-note": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Shift+Command+N"}, "description": "Add selected text as a queued note"}}, "options_page": "src/options.html"}