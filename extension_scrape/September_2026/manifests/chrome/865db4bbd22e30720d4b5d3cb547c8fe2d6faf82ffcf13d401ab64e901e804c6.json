{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Premium Themes, Dark Mode, and Live UI Editor for Google Gemini | Anwingels", "version": "2.1.0", "description": "Customize Google Gemini UI with animated premium themes, a live style editor, custom dark mode colors, and adjustable font settings.", "author": "Vadym Trebushnyi(CepeshRC)", "permissions": ["storage", "tabs", "sidePanel", "alarms", "notifications"], "host_permissions": ["https://gemini.google.com/*", "https://business.gemini.google/*", "https://extensionpay.com/*"], "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "popup.html"}, "action": {"default_popup": "popup.html", "default_title": "Open Anwingels"}, "content_scripts": [{"matches": ["https://gemini.google.com/*", "https://business.gemini.google/*"], "js": ["content.js"], "css": ["anwingels-injector.css"], "run_at": "document_start"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "mac": "MacCtrl+Shift+A"}, "description": "Open Anwingels Panel"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["themes/*.css", "assets/fonts/montserrat/*.ttf", "assets/fonts/orbitron/*.ttf", "assets/fonts/inter/*.ttf", "anwingels.html", "anwingels.css", "anwingels.js", "icons/icon128.png", "ExtPay.js", "success/*"], "matches": ["https://gemini.google.com/*", "https://business.gemini.google/*"]}]}