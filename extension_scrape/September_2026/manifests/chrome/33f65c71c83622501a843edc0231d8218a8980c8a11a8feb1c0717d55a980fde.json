{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Psympl Extension", "version": "1.0.4", "description": "Analyze content against financial psychographic segments and find matching contacts with Psympl.", "author": "Deepak Anandrao", "icons": {"16": "assets/images/logos/psympl-logo-16x16.png", "32": "assets/images/logos/psympl-logo-32x32.png", "48": "assets/images/logos/psympl-logo-48x48.png", "64": "assets/images/logos/psympl-logo-64x64.png", "128": "assets/images/logos/psympl-logo-128x128.png"}, "web_accessible_resources": [{"resources": ["assets/images/logos/psympl-logo-light-blue.svg", "assets/images/logos/psympl-logo-dark-blue.svg", "assets/images/logos/psympl-logo-16x16.png", "assets/images/logos/psympl-logo-32x32.png", "assets/images/logos/psympl-logo-48x48.png", "assets/images/logos/psympl-logo-64x64.png", "assets/images/logos/psympl-logo-128x128.png", "content-scripts/*.html"], "matches": ["<all_urls>"]}], "action": {"default_icon": "assets/images/logos/psympl-logo-32x32.png"}, "side_panel": {"default_path": "index.html"}, "permissions": ["storage", "tabs", "activeTab", "clipboardRead", "clipboardWrite", "sidePanel"], "host_permissions": ["http://*/", "https://*/"], "externally_connectable": {"matches": ["https://app.psympl.com/*", "https://dev.psympl.com/*", "http://localhost/*", "http://localhost:*/*"]}, "background": {"service_worker": "service-worker.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+U", "mac": "Command+U"}}}}