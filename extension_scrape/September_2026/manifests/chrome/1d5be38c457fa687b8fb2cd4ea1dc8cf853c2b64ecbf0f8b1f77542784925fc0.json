{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LetItSnow \u2014 Snowfall on any web page", "description": "Gentle snowfall over every page you browse. Five seasonal themes or any emoji, adjustable density and speed, per-site off switch.", "version": "1.2", "background": {"service_worker": "/background.js"}, "icons": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}, "action": {"default_title": "LetItSnow", "default_popup": "popup.html", "default_icon": {"16": "/icon-16.png", "32": "/icon-32.png", "48": "/icon-48.png", "128": "/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["/content.js"]}], "permissions": ["activeTab", "storage", "tabs", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "options_page": "options.html"}