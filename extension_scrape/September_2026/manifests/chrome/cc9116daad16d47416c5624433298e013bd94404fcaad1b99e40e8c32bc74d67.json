{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI Prompt Vault", "version": "1.3.1", "description": "Save & reuse your best AI prompts in 1 click. Works with ChatGPT, Claude, Gemini & Perplexity. Your data stays 100% on your device.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://x.com/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://notebooklm.google.com/*", "https://pay.extensionpay.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "AI Prompt Vault", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://x.com/*", "https://chat.deepseek.com/*", "https://chat.mistral.ai/*", "https://copilot.microsoft.com/*", "https://notebooklm.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Open AI Prompt Vault"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}