{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Visual Browser Memory - Photographic History", "version": "1.0.0", "description": "Find the thing you remember seeing (charts, code, products, colors) instead of just URLs.", "permissions": ["tabs", "sidePanel", "storage"], "host_permissions": ["<all_urls>", "file:///*"], "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js"}, "action": {"default_title": "Open Visual Browser Memory", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "side_panel": {"default_path": "sidepanel/panel.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open Visual Memory Gallery"}, "spotlight-search": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open Visual Memory Spotlight"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}