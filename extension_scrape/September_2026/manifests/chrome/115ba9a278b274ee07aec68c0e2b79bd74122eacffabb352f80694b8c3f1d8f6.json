{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EdCatalyst AI Reader", "version": "2.6.0", "description": "Reads questions from your screen and answers them using Claude, OpenAI, Gemini or Groq. Built for EdCatalyst", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://api.groq.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "commands": {"capture-and-answer": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Capture screen area and get AI answer"}, "answer-selected-text": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Answer selected text on page"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}