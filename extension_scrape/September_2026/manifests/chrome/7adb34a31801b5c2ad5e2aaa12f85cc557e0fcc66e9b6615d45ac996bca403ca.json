{"update_url": "https://clients2.google.com/service/update2/crx", "name": "Fluentify - Improve Text", "description": "Right-click selected text to improve grammar instantly.", "version": "2015.8.0", "manifest_version": 3, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*", "https://api.mistral.ai/*"], "background": {"service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["shared/*.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png"}, "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png"}, "default_title": "Fluentify", "default_popup": "popup.html"}, "options_page": "options.html", "commands": {"improve-selected-text": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Improve selected text with AI"}}}