{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Tabi - Command Bar for Chrome: Search and Rename Tabs, Productivity Tools", "version": "0.3", "description": "Tabi is a command bar for Chrome that allows you to rename tabs, search tabs and bookmarks, and use quick tools from one place.", "permissions": ["tabs", "tabGroups", "windows", "scripting", "bookmarks", "storage", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Tabi"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup.html", "popup.js", "style.css"], "matches": ["<all_urls>"]}], "commands": {"open-command-bar": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+K"}, "description": "Open Tabi Search"}}}