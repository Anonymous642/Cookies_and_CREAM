{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Sci Fig Downloader", "description": "View and download original figures and supplementary files from science journal websites.", "version": "0.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "declarativeNetRequestWithHostAccess", "downloads", "storage"], "host_permissions": ["https://pubs.acs.org/*", "https://onlinelibrary.wiley.com/*"], "declarative_net_request": {"rule_resources": [{"id": "acs_si_pdf_inline", "enabled": true, "path": "rules/acs-si-pdf-inline.json"}, {"id": "wiley_si_referrer", "enabled": true, "path": "rules/wiley-si-referrer.json"}]}, "background": {"service_worker": "background.js"}, "action": {"default_title": "Sci Fig Downloader", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.onlinelibrary.wiley.com/*", "https://*.science.org/*", "https://*.sciencedirect.com/*", "https://academic.oup.com/*", "https://nature.com/*", "https://onlinelibrary.wiley.com/*", "https://pdf.sciencedirectassets.com/*", "https://pnas.org/*", "https://pubs.acs.org/*", "https://pubs.rsc.org/*", "https://www.nature.com/*", "https://www.pnas.org/*"], "js": ["content-scripts/content.js"]}]}