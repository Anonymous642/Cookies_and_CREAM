{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "EasyReplier", "version": "1.0.1", "description": "AI-powered X reply & engagement optimizer. Turn tweets into high-impact replies.", "icons": {"16": "images/extension-icon-16.png", "24": "images/extension-icon-24.png", "32": "images/extension-icon-32.png", "48": "images/extension-icon-48.png", "128": "images/extension-icon.png"}, "permissions": ["storage"], "background": {"service_worker": "background.js"}, "host_permissions": ["https://easyreplier.com/*", "https://twitter.com/*", "https://x.com/*", "https://www.twitter.com/*", "https://www.x.com/*"], "action": {"default_title": "EasyReplier", "default_popup": "popup.html", "default_icon": {"16": "images/extension-icon-16.png", "24": "images/extension-icon-24.png", "32": "images/extension-icon-32.png", "48": "images/extension-icon-48.png", "128": "images/extension-icon.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://www.twitter.com/*", "https://www.x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}