{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Focusly \u2014 Website Blocker for Focus", "description": "Friction-based approach to stop doomscrolling. Not a blocker \u2014 a focus companion. Helpful for ADHD and distraction control.", "version": "0.1.0", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "alarms", "scripting"], "optional_permissions": ["notifications"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "Focusly", "default_popup": "popup.html"}, "content_scripts": [], "web_accessible_resources": [{"resources": ["content-scripts/overlay.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}