{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "AI MultiChat Panel", "version": "1.0.3", "description": "Chrome extension to send prompts to multiple AI models at the same time with parallel processing.", "author": "Carlos Polanco", "permissions": ["tabs", "storage", "activeTab", "scripting", "sidePanel", "tabGroups"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.ai/*", "https://chat.deepseek.com/*", "https://deepseek.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat*", "https://chat.mistral.ai/*", "https://mistral.ai/*"], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"service_worker": "background.js"}, "side_panel": {"default_path": "ui/sidepanel.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.ai/*", "https://chat.deepseek.com/*", "https://deepseek.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://www.bing.com/chat*", "https://chat.mistral.ai/*", "https://mistral.ai/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_title": "AI MultiChat Panel", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}}