{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "NetSuite Account Presence", "version": "1.3.4", "description": "Track which teammate is using each shared NetSuite account, with name and IP.", "author": "Clemen Canaria <clemen@canariawerx.com>", "permissions": ["storage", "alarms", "tabs", "notifications", "identity"], "host_permissions": ["https://api.ipify.org/*", "https://api64.ipify.org/*", "https://api.jsonbin.io/*", "https://*.netsuite.com/*", "https://*.app.netsuite.com/*", "https://*.suitetalk.api.netsuite.com/*", "https://*.restlets.api.netsuite.com/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "NetSuite Account Presence", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.netsuite.com/*", "https://*.app.netsuite.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}