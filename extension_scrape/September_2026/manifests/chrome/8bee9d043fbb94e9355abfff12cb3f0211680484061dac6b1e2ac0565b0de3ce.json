{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "BrandFilter - E-commerce Brand Exclusion", "version": "1.0.1", "description": "Exclude specific brands from e-commerce search results", "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"], "host_permissions": ["*://*.amazon.com/*", "*://*.flipkart.com/*", "*://*.walmart.com/*", "*://*.ebay.com/*", "*://*.tatacliq.com/*", "*://*.luxury.tatacliq.com/*", "*://*.myntra.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.flipkart.com/*", "*://*.walmart.com/*", "*://*.ebay.com/*", "*://*.tatacliq.com/*", "*://*.luxury.tatacliq.com/*", "*://*.myntra.com/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["<all_urls>"]}]}