{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Codeur AutoApply", "version": "1.1.0", "description": "Auto-apply to dev projects on codeur.com with AI-generated proposals powered by Mistral.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "tabs", "scripting", "notifications", "offscreen"], "host_permissions": ["https://www.codeur.com/*", "https://api.mistral.ai/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.codeur.com/projects*"], "js": ["content-projects.js"], "run_at": "document_idle"}, {"matches": ["https://www.codeur.com/projects/*/offers/new*"], "js": ["content-offer-form.js"], "run_at": "document_idle"}], "action": {"default_title": "Codeur AutoApply", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}