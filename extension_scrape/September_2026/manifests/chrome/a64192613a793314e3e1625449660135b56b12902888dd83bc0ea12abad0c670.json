{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "LinkedIn Job Metrics", "description": "An interactive and efficent dashboard for viewing Linkedin Job application stats!", "author": "Daniel Alfaro", "version": "1.0.1", "permissions": ["scripting", "cookies", "tabs", "storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": "icons/bar-chart-128.png"}, "icons": {"16": "icons/bar-chart-16.png", "48": "icons/bar-chart-48.png", "128": "icons/bar-chart-128.png"}, "host_permissions": ["https://www.linkedin.com/*"], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content-script.js"]}]}