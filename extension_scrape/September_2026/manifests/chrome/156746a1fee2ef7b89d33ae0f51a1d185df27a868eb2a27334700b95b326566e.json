{"update_url": "https://clients2.google.com/service/update2/crx", "manifest_version": 3, "name": "Inspira: Screenshot, Web Clipper & Design Inspiration Copilot", "description": "Capture & Create: Web Images & Regional Screenshots Seamlessly Collected via Plugin\u2014Unleash Your Creativity on PromeAI", "version": "2.2.0", "icons": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["contextMenus", "storage", "scripting", "tabs", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icon/icon16.png", "32": "icon/icon32.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "default_title": "Open Inspira"}, "web_accessible_resources": [{"resources": ["icon/*"], "matches": ["*://*/*"]}, {"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"create-screenshot": {"suggested_key": {"default": "Ctrl+Shift+2", "chromeos": "Ctrl+Shift+2", "linux": "Ctrl+Shift+2", "mac": "Command+Shift+2", "windows": "Ctrl+Shift+2"}, "description": "Create regional screenshot"}}, "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}