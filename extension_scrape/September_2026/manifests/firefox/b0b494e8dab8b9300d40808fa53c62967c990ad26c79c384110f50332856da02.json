{"manifest_version": 2, "name": "Download Desk Manager Browser Integration", "version": "0.2.0", "description": "Adds Download Desk Manager controls to public direct browser downloads and video files.", "browser_specific_settings": {"gecko": {"id": "downloaddesk@barmaja.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "storage", "webRequest", "webNavigation", "http://127.0.0.1:8765/*", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["video-controls.js"], "all_frames": true, "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Download Desk Manager", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}