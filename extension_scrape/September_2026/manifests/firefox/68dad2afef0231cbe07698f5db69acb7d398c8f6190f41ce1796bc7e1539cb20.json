{"manifest_version": 3, "name": "Tab Tint", "version": "1.1.0", "description": "Give the current tab a bright, numbered favicon so look-alike tabs are easy to spot.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Mark this tab", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-tint@ainorthstar.tech", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}