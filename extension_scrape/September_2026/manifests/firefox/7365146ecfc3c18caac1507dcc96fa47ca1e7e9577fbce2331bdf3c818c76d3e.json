{"manifest_version": 2, "name": "PlayCS", "description": "PlayCS extension", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "playcs@no-data", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "PlayCS", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://play-cs.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}