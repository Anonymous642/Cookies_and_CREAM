{"manifest_version": 3, "name": "CSS Sonar - Visual UI Inspector", "short_name": "CSS Sonar", "version": "1.0.0", "description": "Stop digging through cluttered DevTools. See UI layouts, box models, and CSS properties instantly on the page.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "assets/favicon-16x16.png", "32": "assets/favicon-32x32.png", "192": "assets/android-chrome-192x192.png", "512": "assets/android-chrome-512x512.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "CSS Sonar", "default_icon": {"16": "assets/favicon-16x16.png", "32": "assets/favicon-32x32.png"}}, "commands": {"toggle-css-sonar": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "MacCtrl+Shift+X"}, "description": "Toggle CSS Sonar"}}, "web_accessible_resources": [{"resources": ["content/overlay.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "css-sonar@hardiksehgal.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}