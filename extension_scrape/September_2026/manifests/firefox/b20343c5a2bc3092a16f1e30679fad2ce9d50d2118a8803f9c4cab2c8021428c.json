{"manifest_version": 2, "name": "Rereda LinkedIn Assistant", "version": "1.1", "description": "Track your LinkedIn profile analytics automatically", "browser_specific_settings": {"gecko": {"id": "linkedin-assitant@rereda.com"}}, "permissions": ["alarms", "storage", "tabs", "notifications"], "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["http://localhost/*", "https://dashboard.rereda.com/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "js": ["install-bridge.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": "icon.svg", "default_title": "Rereda LinkedIn Assistant"}, "icons": {"48": "icon.svg"}}