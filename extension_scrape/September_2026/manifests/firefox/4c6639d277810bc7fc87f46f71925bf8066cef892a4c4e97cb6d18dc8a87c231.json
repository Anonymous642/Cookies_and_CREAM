{"manifest_version": 2, "name": "TabMaster - Tab Search", "version": "1.1.0", "description": "Search and navigate through your open tabs quickly. Find and close duplicate tabs.", "author": "Your Name", "homepage_url": "https://github.com/yourusername/tabmaster", "browser_specific_settings": {"gecko": {"id": "tabmaster-search@yourdomain.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs"], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "TabMaster", "default_popup": "popup/popup.html"}}