{"manifest_version": 2, "name": "SVT-kvalle", "description": "Adds manual video quality selection to the dash.js player on svtplay.se and svt.se", "version": "0.0.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "web_accessible_resources": ["dashjs-mod.js"], "browser_specific_settings": {"gecko": {"id": "@svt-kvalle", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "SVT-kvalle", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.svt.se/*", "*://*.svtplay.se/*"], "js": ["content-scripts/content.js"]}]}