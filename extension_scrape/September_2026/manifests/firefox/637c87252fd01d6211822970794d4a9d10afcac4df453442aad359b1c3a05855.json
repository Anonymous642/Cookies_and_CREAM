{"manifest_version": 3, "name": "noted.", "version": "1.0.0", "description": "A minimal, elegant note-taking extension that saves your thoughts with the context of where they came from.", "permissions": ["storage", "tabs", "activeTab", "notifications"], "host_permissions": ["https://extensionpay.com/*"], "background": {"scripts": ["ExtPay.js", "browser-polyfill.js", "background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content/content.js"]}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:; connect-src 'self' https://extensionpay.com"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Open Noted."}}, "web_accessible_resources": [{"resources": ["ExtPay.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "noted@example.com", "strict_min_version": "109.0"}}}