{"manifest_version": 3, "name": "passgen++", "version": "1.0", "description": "Generate secure passwords between 1 and 50 characters using uppercase, lowercase, numbers, and symbols.", "action": {"default_popup": "popup.html"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["clipboardWrite", "contextMenus", "activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon-16.png", "icon-32.png", "icon-48.png", "icon-128.png", "icon.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "passgenplusplus@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}}