{"manifest_version": 2, "name": "Best Homepage Ever: Custom New Tab Launcher", "author": "Justin Carver", "version": "4.0", "description": "Automatically sets Best Homepage Ever as your homepage and default new tab page.", "icons": {"16": "images/16x16.png", "32": "images/32x32.png", "48": "images/48x48.png", "64": "images/64x64.png", "128": "images/128x128.png"}, "permissions": ["storage", "menus"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/16x16.png", "32": "images/32x32.png", "48": "images/48x48.png", "64": "images/64x64.png", "128": "images/128x128.png"}, "default_title": "BestHomepageEver"}, "chrome_settings_override": {"homepage": "https://besthomepageever.com"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["js/background.js"]}, "browser_specific_settings": {"gecko": {"id": "new-tab-launcher@besthomepageever.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}