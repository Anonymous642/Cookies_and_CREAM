{"manifest_version": 3, "name": "Komod", "version": "0.1.3", "description": "Fast, low-overhead new tab replacement: bookmarks as drawers, search-first.", "browser_specific_settings": {"gecko": {"id": "komod@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["bookmarks", "storage", "alarms", "unlimitedStorage"], "host_permissions": ["https://picsum.photos/*", "https://fastly.picsum.photos/*", "https://loremflickr.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "action": {"default_title": "Komod", "default_popup": "newtab.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}