{"manifest_version": 2, "name": "Fork to Gitea", "version": "1.0.0", "description": "Adds a button on GitHub repository pages to fork/migrate repos to your Gitea or Codeberg instance.", "author": "Eliott", "permissions": ["storage", "activeTab", "https://github.com/*", "<all_urls>"], "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "content_scripts": [{"matches": ["https://github.com/*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": false, "browser_style": true}, "options_page": "options.html", "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "browser_specific_settings": {"gecko": {"id": "fork-to-gitea@lab48.be", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}