{"manifest_version": 2, "name": "Hunter - AI Job Application Assistant", "version": "1.1.0", "description": "Intelligent job application assistant that analyzes jobs, calculates relevancy scores, generates cover letters, and helps apply to jobs across LinkedIn, Naukri, Indeed, and more.", "author": "Hunter", "homepage_url": "https://github.com/user/hunter-extension", "browser_specific_settings": {"gecko": {"id": "hunter-job-assistant@extension.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/hunter-16.svg", "32": "icons/hunter-32.svg", "48": "icons/hunter-48.svg", "128": "icons/hunter-128.svg"}, "permissions": ["activeTab", "storage", "tabs", "downloads", "<all_urls>"], "browser_action": {"default_icon": {"16": "icons/hunter-16.svg", "32": "icons/hunter-32.svg"}, "default_title": "Hunter - Job Application Assistant", "default_popup": "popup/popup.html"}, "background": {"scripts": ["lib/pdf-lib.min.js", "background/ai-service.js", "background/storage-service.js", "background/background.js"]}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*.naukri.com/*", "*://*.indeed.com/*", "*://*.reddit.com/*", "*://*/*"], "js": ["content/dom-analyzer.js", "content/job-extractor.js", "content/auto-apply.js", "content/batch-apply.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": ["icons/*", "lib/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}}