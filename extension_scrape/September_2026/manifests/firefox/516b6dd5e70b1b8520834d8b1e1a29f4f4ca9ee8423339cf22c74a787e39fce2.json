{"manifest_version": 3, "name": "CookieTrail", "description": "Track domain connections", "version": "0.5", "permissions": ["webRequest", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/serviceWorker.js"]}, "action": {"default_title": "Open CookieTrail"}, "web_accessible_resources": [{"resources": ["src/tab/tab.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "cookie-trail@dmj.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}