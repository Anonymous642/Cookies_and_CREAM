{"manifest_version": 3, "name": "Auto Refresh Plus | Page Monitor", "version": "1.0.0", "description": "Automatically refresh web pages at defined intervals with advanced page monitoring and content detection features.", "author": "Mukesh Kumar Makwana", "homepage_url": "https://github.com/mkblackhat1", "browser_specific_settings": {"gecko": {"id": "auto-refresh-plus@mkblackhat1", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Auto Refresh Plus | Page Monitor"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["tabs", "storage", "alarms", "notifications", "scripting", "contextMenus", "webNavigation", "activeTab"], "host_permissions": ["<all_urls>"], "commands": {"start-interval-refresh": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start Time Interval refresh"}, "start-random-refresh": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start Random Interval refresh"}, "start-countdown-mode": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Start Timer/Countdown mode"}, "stop-all-refresh": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Stop all refresh"}}, "web_accessible_resources": [{"resources": ["sounds/*", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}