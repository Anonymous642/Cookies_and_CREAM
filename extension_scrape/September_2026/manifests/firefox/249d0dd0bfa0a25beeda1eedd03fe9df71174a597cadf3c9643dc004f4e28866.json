{"manifest_version": 2, "name": "SubVoice", "description": "Read YouTube subtitles aloud with local or online text-to-speech voices while you watch.", "version": "0.1.0", "permissions": ["storage", "https://www.youtube.com/*", "https://translate.google.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "SubVoice", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "Contact@admin.io.vn", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}