{"manifest_version": 2, "name": "Browser Pong", "version": "1.0", "description": "Mini Pong in your browser tabs. Ball state syncs across tabs via extension iframe localStorage.", "permissions": ["activeTab", "<all_urls>", "storage", "tabs"], "browser_action": {"default_title": "Browser Pong"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_end"}], "chrome_url_overrides": {"newtab": "newtab.html"}, "applications": {"gecko": {"id": "browserpong@example.com"}}}