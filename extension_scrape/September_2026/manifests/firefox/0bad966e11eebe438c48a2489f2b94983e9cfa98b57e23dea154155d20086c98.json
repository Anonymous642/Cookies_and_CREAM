{"manifest_version": 3, "name": "X.com Daily Limit", "version": "2.0", "description": "Limits the X feed to a custom number of posts.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "x-daily-limit@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://x.com/*", "*://*.twitter.com/*", "*://twitter.com/*"], "js": ["content.js"]}]}