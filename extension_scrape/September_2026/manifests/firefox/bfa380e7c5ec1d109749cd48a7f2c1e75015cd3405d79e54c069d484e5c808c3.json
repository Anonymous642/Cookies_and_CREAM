{"manifest_version": 3, "name": "onHover \u2014 Developer Toolkit", "short_name": "onHover", "version": "1.0.3", "description": "25+ dev tools in one click: inspect elements, pick colors, screenshots, API tester, SEO analyzer, fonts & more \u2014 no DevTools needed.", "homepage_url": "https://onhover.in", "minimum_chrome_version": "88", "browser_specific_settings": {"gecko": {"id": "extension@onhover.in", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": []}}}, "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "scripting", "clipboardWrite", "cookies", "browsingData", "tabCapture", "offscreen", "downloads", "debugger"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "index.html", "default_title": "onHover \u2014 Developer Toolkit", "default_icon": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}}, "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["modules/utils.js", "modules/assets.js", "modules/inspector.js", "modules/seo.js", "modules/screenshot.js", "modules/colorToolbar.js", "modules/captureToolbar.js", "modules/perf.js", "modules/consolepanel.js", "content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["modules/sitemap.js", "modules/json.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["responsive.html", "sitemap-formatter.html", "sitemap-formatter.js", "json-formatter.html", "json-formatter.js", "src/insights-report.html", "src/devtools.html", "fonts/*"], "matches": ["<all_urls>"]}]}