{"manifest_version": 2, "name": "Nutildah Postflyer", "version": "2.1", "description": "Displays Post Health Score directly within the Bitcointalk forum.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Nutildah Postflyer"}, "permissions": ["*://postflayer.onrender.com/*", "https://postflayer.onrender.com/*", "*://bitcointalk.org/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://bitcointalk.org/index.php?topic=*", "https://bitcointalk.org/index.php?topic=*"], "js": ["content.js"]}, {"matches": ["*://postflayer.onrender.com/*", "https://postflayer.onrender.com/*"], "js": ["autofill.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "postflyer@nutildah.com", "strict_min_version": "100.0", "data_collection_permissions": {"required": ["none"]}}}}