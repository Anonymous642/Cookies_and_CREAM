{"manifest_version": 3, "name": "Linkoteka", "version": "1.2", "description": "Save and import Firefox bookmarks into Linkoteka", "browser_specific_settings": {"gecko": {"id": "linkoteka@linkoteka.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "permissions": ["bookmarks", "storage", "tabs"], "host_permissions": ["https://linkoteka.com/*"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Linkoteka", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}}