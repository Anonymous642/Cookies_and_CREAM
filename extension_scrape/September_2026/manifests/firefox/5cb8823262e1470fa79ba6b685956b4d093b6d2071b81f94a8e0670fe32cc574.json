{"name": "Knowledge Tree", "version": "1.0.0.5", "manifest_version": 3, "description": "Can add custom functionality to Jira", "browser_specific_settings": {"gecko": {"id": "knowledge-tree@marcvannieuwenhuijzen.nl", "strict_min_version": "91.0"}}, "icons": {"128": "icons/extension_logo-128x128.png"}, "action": {"default_popup": "popup/popup.html"}, "permissions": ["activeTab", "scripting"], "web_accessible_resources": [{"resources": ["fonts/*.ttf", "fonts/*.TTF"], "matches": ["https://*.atlassian.net/*", "https://*.visualstudio.com/*", "https://dev.azure.com/*"]}], "content_scripts": [{"matches": ["https://*.atlassian.net/wiki/spaces/*", "https://*.atlassian.net/wiki/create-content/*", "https://*.visualstudio.com/*/_wiki/*", "https://dev.azure.com/ls-group/*/_wiki/*"], "css": ["/css/confluence_styles-firefox.css", "/css/confluence_styles-shared.css"], "js": ["/js/generate-note-id.js", "/js/add-note-create-button-to-jira.js", "/js/change-favicon.js"]}]}