{"manifest_version": 2, "name": "Osama's Nastaliq Renderer", "version": "2.0.14", "description": "Renders Urdu text in the traditional Nastaliq calligraphic script using the Gulzar font, preserving the beauty of Urdu typography across websites.", "permissions": ["storage", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Osama's Nastaliq Renderer"}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "css": ["styles/nastaliq.css"], "run_at": "document_start", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["fonts/*", "styles/nastaliq.css"], "browser_specific_settings": {"gecko": {"id": "nastaliq@osama.dev", "strict_min_version": "80.0"}}}