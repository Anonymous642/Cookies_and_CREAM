{"manifest_version": 2, "name": "Coin Ticker", "description": "A minimal crypto ticker in the browser: watchlist, daily change coloring and a badge with the price you care about.", "version": "1.1.4.1", "browser_specific_settings": {"gecko": {"id": "{d766b466-fb46-44b5-9070-430e00df4cd4}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "images/icon-32.png", "48": "images/icon-48.png", "64": "images/icon-64.png", "96": "images/icon-96.png", "128": "images/icon-128.png"}, "permissions": ["storage", "https://api.coingecko.com/*"], "background": {"scripts": ["scripts/core.js", "scripts/background.js"]}, "browser_action": {"default_title": "Coin Ticker", "default_popup": "scripts/popup.html", "default_icon": {"32": "images/icon-32.png", "48": "images/icon-48.png", "64": "images/icon-64.png", "96": "images/icon-96.png", "128": "images/icon-128.png"}}}