{"manifest_version": 2, "name": "Eye Scroll", "version": "1.0", "description": "Scroll webpages by looking at the top or bottom of the screen using eye tracking", "browser_specific_settings": {"gecko": {"id": "eye-scroll@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>", "webRequest", "webRequestBlocking"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": ["webgazer.js", "tracker.js"]}