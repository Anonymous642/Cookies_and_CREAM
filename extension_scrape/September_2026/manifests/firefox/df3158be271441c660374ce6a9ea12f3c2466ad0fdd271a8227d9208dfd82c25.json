{"manifest_version": 2, "name": "Duplicate Tab Highlighter", "version": "1.0.1", "description": "Your tabs are quietly cloning themselves. This finds the duplicates, lights them up in the tab bar, and closes the copies \u2014 keeping the original or your latest, your call. One-click Undo if you regret everything.", "permissions": ["tabs", "storage", "sessions"], "background": {"scripts": ["background.js"]}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle the Duplicate tabs sidebar"}}, "sidebar_action": {"default_title": "Duplicate tabs", "default_panel": "popup/popup.html?sidebar=1", "default_icon": "icons/icon.svg", "open_at_install": false}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Duplicate tabs", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "duplicate-tab-highlighter@strahil.local", "data_collection_permissions": {"required": ["none"]}}}}