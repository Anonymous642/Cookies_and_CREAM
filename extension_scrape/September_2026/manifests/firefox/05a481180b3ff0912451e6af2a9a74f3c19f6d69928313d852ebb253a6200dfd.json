{"manifest_version": 3, "name": "CelestialLeads Instagram Auto-Send v2", "version": "2.1.0", "description": "Automatically send pre-generated Instagram DMs on behalf of CelestialLeads users.", "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://celestialeads.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://celestialeads.com/*"], "js": ["bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "autosend-v2@celestialeads.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}