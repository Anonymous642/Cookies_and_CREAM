{"manifest_version": 3, "name": "Dictionary on Click", "version": "0.2.0", "description": "Double-click any word to see its definition. Reliable, free, no API keys.", "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Dictionary on Click", "default_popup": "popup/index.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "permissions": ["storage", "tabs"], "web_accessible_resources": [{"resources": ["audio/speak.html"], "matches": ["<all_urls>"]}], "host_permissions": ["*://*.wiktionary.org/*", "*://*.wikipedia.org/*", "*://upload.wikimedia.org/*", "https://api.dictionaryapi.dev/*", "https://api.datamuse.com/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "type": "module", "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "dictionary-on-click@bishwo-dahal.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}