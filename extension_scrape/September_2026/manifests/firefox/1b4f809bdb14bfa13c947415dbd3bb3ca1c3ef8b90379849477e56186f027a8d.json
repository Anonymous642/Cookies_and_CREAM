{"manifest_version": 3, "name": "CaptchaAccess \u2013 Accessibilit\u00e9 CAPTCHA", "short_name": "CaptchaAccess", "version": "2.2.5", "description": "R\u00e9sout automatiquement les CAPTCHA inaccessibles via Google Gemini. Cr\u00e9\u00e9 par HBA.", "author": "HBA", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus", "clipboardWrite", "alarms"], "host_permissions": ["https://generativelanguage.googleapis.com/*"], "action": {"default_title": "CaptchaAccess \u2013 Ouvrir la configuration"}, "commands": {"open-config": {"suggested_key": {"default": "Ctrl+Shift+F6"}, "description": "Ouvrir la configuration CaptchaAccess (Ctrl+Maj+F6)"}, "solve-now": {"suggested_key": {"default": "Ctrl+Shift+F7"}, "description": "R\u00e9soudre le CAPTCHA sur la page actuelle (Ctrl+Maj+F7)"}, "toggle-extension": {"suggested_key": {"default": "Ctrl+Shift+F8"}, "description": "Activer ou d\u00e9sactiver CaptchaAccess (Ctrl+Maj+F8)"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://claude.ai/*", "*://*.anthropic.com/*", "*://chat.openai.com/*", "*://gemini.google.com/*", "*://mail.google.com/*", "*://outlook.live.com/*", "*://outlook.office.com/*", "*://twitter.com/*", "*://x.com/*", "*://facebook.com/*", "*://linkedin.com/*", "*://github.com/*", "*://docs.google.com/*", "*://drive.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["config.html", "icons/*.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "captchaaccess@hba.fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}