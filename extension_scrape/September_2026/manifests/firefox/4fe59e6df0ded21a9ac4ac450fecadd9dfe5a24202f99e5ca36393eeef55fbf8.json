{"manifest_version": 3, "name": "Easy Shop", "version": "0.2.0", "description": "Simplify the amazon shopping experience by removing bloated content", "homepage_url": "https://github.com/subrat-lima/easy-shop", "browser_specific_settings": {"gecko": {"id": "{0d9b2ee7-adc6-4d4d-a1f6-811281652854}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "icons": {"32": "icons/easy-32.png", "64": "icons/easy-64.png", "128": "icons/easy-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"32": "icons/easy-32.png", "64": "icons/easy-64.png", "128": "icons/easy-128.png"}}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.in/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.co.jp/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*", "*://*.amazon.com.mx/*", "*://*.amazon.nl/*", "*://*.amazon.se/*", "*://*.amazon.pl/*", "*://*.amazon.sg/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.eg/*", "*://*.amazon.com.tr/*"], "css": ["css/ads.css", "css/mrp.css", "css/deal.css", "css/stats.css"], "js": ["content.js"], "run_at": "document_start"}]}