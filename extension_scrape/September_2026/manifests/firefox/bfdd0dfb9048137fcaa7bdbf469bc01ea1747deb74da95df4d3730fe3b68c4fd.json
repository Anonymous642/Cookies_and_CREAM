{"manifest_version": 3, "name": "Red-Block", "version": "2.0.0", "description": "Blocks the search and content from the homepage of reddit to allow you to be locked in on what you actually want to see", "host_permissions": ["https://www.reddit.com/*"], "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.reddit.com/*"], "js": ["content.js"]}], "action": {"default_title": "Click to view more options", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "red-block@extension.com"}}}