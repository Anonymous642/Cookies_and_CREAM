{"manifest_version": 3, "name": "TextTrellis AI", "version": "1.2.0", "description": "Summarize, translate, explain, and improve text using your signed-in ChatGPT session.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["activeTab", "alarms", "menus", "notifications", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*"], "background": {"scripts": ["dist/background.js"]}, "action": {"default_icon": "icons/icon.svg", "default_popup": "popup/popup.html", "default_title": "Ask ChatGPT about this page"}, "commands": {"open-action-popup": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Open the TextTrellis AI action popup"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["dist/chatgpt-content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "text-trellis-ai@extension.grubtrade", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}}