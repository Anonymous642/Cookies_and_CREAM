{"manifest_version": 2, "name": "Page Peek: Quick Save & Info", "version": "1.0.0", "description": "One-click fetches the current tab\u2019s title, URL, and selection length; optionally save pages to a personal list.", "browser_specific_settings": {"gecko": {"id": "page-peek@example.com", "strict_min_version": "91.0"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Page Peek", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "storage"], "content_security_policy": "script-src 'self'; object-src 'self'"}