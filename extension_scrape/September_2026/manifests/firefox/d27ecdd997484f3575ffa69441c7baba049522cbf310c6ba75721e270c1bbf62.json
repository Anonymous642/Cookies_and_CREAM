{"manifest_version": 2, "name": "Udemy Course Downloader", "version": "3.2", "description": "Download videos and text content from Udemy courses", "browser_specific_settings": {"gecko": {"id": "udemy-downloader@extension", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage", "activeTab", "https://www.udemy.com/course/*", "https://*.udemycdn.com/*", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.udemy.com/course/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}