{"manifest_version": 2, "name": "Fichas de Nimb para Roll20", "version": "0.1.0", "description": "Importa suas fichas de Tormenta 20 do Fichas de Nimb para a ficha oficial Jogo do Ano no Roll20.", "homepage_url": "https://fichasdenimb.com.br", "content_scripts": [{"matches": ["https://app.roll20.net/editor*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": ["page.js"], "permissions": ["storage", "https://fichas-backend.fly.dev/*", "https://securetoken.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "roll20@fichasdenimb.com.br", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}