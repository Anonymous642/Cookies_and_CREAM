{"manifest_version": 3, "name": "Blocklang", "version": "1.6.0", "description": "Filter out unwanted domains or languages from your Google and Bing search results. Fully customizable. Private. No tracking.", "icons": {"128": "icons/icon.png"}, "content_scripts": [{"matches": ["*://*.google.com/*", "*://*.bing.com/*"], "js": ["content_dom.js"], "run_at": "document_end"}], "permissions": ["storage", "tabs", "scripting", "notifications"], "browser_specific_settings": {"gecko": {"id": "filtersearch@yourdomain.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "host_permissions": ["https://*/*", "http://*/*", "https://api.blocklang.org/*"], "web_accessible_resources": [{"resources": ["lang.js", "scam-protection.js"], "matches": ["<all_urls>"]}], "author": "contact@blocklang.org"}