{"manifest_version": 3, "name": "yooloop", "description": "A browser extension for YouTube that adds subtitle interaction and video looping features.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "192": "icon/192.png", "512": "icon/512.png"}, "permissions": ["webRequest", "storage"], "host_permissions": ["https://www.youtube.com/watch?v=*"], "web_accessible_resources": [{"matches": ["https://www.youtube.com/*"], "resources": ["injected.js"]}, {"resources": ["content-scripts/content.css"], "matches": ["https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "noodlefreeze@gmail.com", "strict_min_version": "109.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/watch?v=*"], "js": ["content-scripts/content.js"]}]}