{"manifest_version": 3, "name": "WatchCat", "description": "WatchCat tracks screen time and sets limits. Free mode stays local; paid account sync is optional and consent-based.", "version": "2.2.1", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "alarms", "identity"], "optional_permissions": [], "optional_host_permissions": ["https://api.getwatchcat.com/*"], "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*"], "incognito": "not_allowed", "web_accessible_resources": [{"resources": ["icon128.png"], "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*"]}], "browser_specific_settings": {"gecko": {"id": "{47c6310a-be17-496b-bb45-c332ec064ec5}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "personallyIdentifyingInfo", "technicalAndInteraction", "browsingActivity", "websiteContent", "websiteActivity"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "WatchCat", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.netflix.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "all_frames": false, "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}