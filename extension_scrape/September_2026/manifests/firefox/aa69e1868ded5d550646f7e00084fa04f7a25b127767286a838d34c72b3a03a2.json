{"manifest_version": 3, "name": "NiFi Companion", "version": "1.0.2", "description": "Sidekick for NiFi boxes and API calls.", "browser_specific_settings": {"gecko": {"id": "nifi-companion@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-bridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["http://*/*", "https://*/*"]}], "sidebar_action": {"default_title": "NiFi Companion", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "default_panel": "popup.html", "open_at_install": false}, "action": {"default_title": "NiFi Companion", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}}