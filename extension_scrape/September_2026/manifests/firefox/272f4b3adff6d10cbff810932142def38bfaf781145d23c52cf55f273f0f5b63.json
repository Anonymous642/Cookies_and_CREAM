{"manifest_version": 3, "name": "Web Cleanup Console", "version": "1.0.0", "description": "A safety-first account cleanup console for supported social platforms.", "action": {"default_title": "Web Cleanup Console", "default_popup": "popup/index.html"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://discord.com/*", "https://discordapp.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "content_scripts": [{"matches": ["https://discord.com/*", "https://discordapp.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "assets/icon.png", "128": "assets/icon.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "web-cleanup-console@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}