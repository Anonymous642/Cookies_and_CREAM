{"manifest_version": 3, "name": "Krib Inzicht", "version": "1.4.1", "description": "Toont buurtinformatie, de verkoopgeschiedenis van de woning, verkochte huizen in de buurt en WOZ-waarde ontwikkeling.", "icons": {"16": "files/logo-16.png", "32": "files/logo-32.png", "48": "files/logo-48.png", "128": "files/logo-blue.png"}, "permissions": ["storage"], "host_permissions": ["https://www.funda.nl/*", "https://krib.nl/*"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.funda.nl/detail/*", "https://www.funda.nl/en/detail/*"], "js": ["config.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["https://www.funda.nl/*"]}], "browser_specific_settings": {"gecko": {"id": "plugin@krib.nl", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}}}