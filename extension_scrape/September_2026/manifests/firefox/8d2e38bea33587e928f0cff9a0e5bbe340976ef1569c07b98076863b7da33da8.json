{"manifest_version": 2, "name": "No Distractions", "version": "0.1.0", "description": "Redireciona feeds e remove atalhos de distracao no Facebook, Instagram e LinkedIn.", "content_scripts": [{"matches": ["*://facebook.com/*", "*://*.facebook.com/*", "*://instagram.com/*", "*://*.instagram.com/*", "*://linkedin.com/*", "*://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": ["blocked.html"], "browser_specific_settings": {"gecko": {"id": "no-distractions@local", "data_collection_permissions": {"required": ["none"]}}}}