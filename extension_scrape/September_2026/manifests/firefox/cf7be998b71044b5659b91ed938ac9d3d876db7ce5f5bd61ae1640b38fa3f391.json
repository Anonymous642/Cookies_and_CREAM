{"manifest_version": 2, "name": "dxCapture", "description": "Capture screenshots and record your screen, then review, edit, and share securely in your dxCapture workspace.", "version": "1.0.0", "short_name": "dxCapture", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["storage", "tabs", "activeTab", "alarms", "https://capture.doxanh.dev/*"], "externally_connectable": {"matches": ["https://capture.doxanh.dev/*"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "capture@doxanh.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "dxCapture", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://capture.doxanh.dev/*"], "run_at": "document_start", "js": ["content-scripts/bridge.js"]}]}