{"manifest_version": 3, "name": "Discord Token Login", "short_name": "LHTokenLogin", "version": "1.0.1", "author": "Last Head", "description": "Lightweight extension that allows to login using Discord token, copy current accounts' token, and manage multiple accounts via tokens.", "icons": {"128": "logo.png"}, "action": {"default_popup": "index.html", "default_icon": "logo.png"}, "browser_specific_settings": {"gecko": {"id": "discord-token-login@lasthead.com", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["http://*.discord.com/*", "https://*.discord.com/*"]}