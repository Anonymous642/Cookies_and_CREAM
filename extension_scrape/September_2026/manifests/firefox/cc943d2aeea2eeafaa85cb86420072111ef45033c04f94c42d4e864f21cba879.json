{"manifest_version": 3, "name": "LinkForge", "version": "1.0", "description": "Shorten selected URLs on page via API; copy to clipboard.", "icons": {"64": "icon.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "linkforge@unique.com", "data_collection_permissions": {"required": ["none"]}}}}