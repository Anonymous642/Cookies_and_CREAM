{"manifest_version": 3, "name": "Image Downloader - PixFerry", "version": "1.0.1", "description": "Saves the full-size copy of any image a page is carrying, not the one the layout picked.", "browser_specific_settings": {"gecko": {"id": "pixferry@minorsoftware.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/settings.js", "src/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["src/settings.js", "src/background.js"]}, "action": {"default_title": "PixFerry: turn off for this site (Shift-click for settings)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Turn PixFerry on or off for this site"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}