{"manifest_version": 3, "name": "Scrollbar Fixer", "version": "1.0", "description": "Automatically shifts overlapping scrollbars slightly to make both visible and easy to use.", "author": "Francesco Cortini", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "scripting"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@scrollbar-fixer", "data_collection_permissions": {"required": ["none"], "optional": []}}}}