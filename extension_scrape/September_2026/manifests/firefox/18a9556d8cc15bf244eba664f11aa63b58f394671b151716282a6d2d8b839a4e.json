{"manifest_version": 3, "name": "Ampario \u2013 Kleinanzeigen Import", "version": "1.0.0", "description": "\u00dcbertrage deine Kleinanzeigen-Angebote zu Ampario \u2013 mit einem Klick.", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://www.kleinanzeigen.de/*", "https://ampario.com/*", "https://api.ampario.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@ampario.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.kleinanzeigen.de/s-anzeige/*", "https://www.kleinanzeigen.de/m-meine-anzeigen*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://ampario.com/*", "https://www.ampario.com/*"], "js": ["ampario-content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}