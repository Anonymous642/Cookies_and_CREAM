{"manifest_version": 3, "name": "Custom Clipboard Access", "description": "Let only user-approved sites read the clipboard without Firefox's paste confirmation.", "version": "1.0.0", "permissions": ["clipboardRead", "scripting", "storage"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"], "icons": {"32": "icons/icon.svg", "64": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_icon": "icons/icon.svg", "default_title": "Custom Clipboard Access"}, "background": {"scripts": ["shared.js", "background.js"]}, "options_ui": {"page": "options/index.html"}, "browser_specific_settings": {"gecko": {"id": "{6f3e4df2-5f1d-4a61-8a42-65f6d8fa7c58}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}