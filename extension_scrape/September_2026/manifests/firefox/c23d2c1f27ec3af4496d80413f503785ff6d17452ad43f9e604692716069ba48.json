{"manifest_version": 2, "name": "CleanTube \u2013 Stay Focused", "description": "Stay focused by removing short-form videos and distractions.", "version": "0.0.2", "permissions": ["storage", "*://www.youtube.com/*", "*://www.tiktok.com/*", "*://www.instagram.com/*"], "browser_specific_settings": {"gecko": {"id": "cleantube@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "collects_user_data": false, "collects_personal_data": false, "collects_health_data": false, "collects_financial_data": false, "collects_authentication_data": false, "collects_location_data": false, "collects_browsing_data": false, "collects_communication_data": false, "collects_other_data": false}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://www.tiktok.com/*", "*://www.instagram.com/*"], "js": ["index.js"], "run_at": "document_idle"}], "web_accessible_resources": ["CleanTube.html"]}