{"manifest_version": 3, "name": "Wikipedia Everywhere", "version": "1.0.0", "description": "Turn any text on the web into a Wikipedia preview.", "default_locale": "en", "permissions": ["storage"], "host_permissions": ["https://*.wikipedia.org/*"], "background": {"scripts": ["common/constants.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["common/constants.js", "common/i18n.js", "content/content.js"], "css": ["content/content.css"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {}, "browser_specific_settings": {"gecko": {"id": "wikipedia-everywhere@barricachlorissinica.com", "data_collection_permissions": {"required": ["none"]}}}}