{"manifest_version": 2, "name": "MakerMuse", "version": "0.1.0", "description": "Generate, review, and insert MakerWorld listing metadata.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "storage", "https://makerworld.com/*", "https://api.deepseek.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "http://localhost/*", "http://127.0.0.1/*"], "browser_specific_settings": {"gecko": {"id": "makermuse@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "browser_action": {"default_title": "MakerMuse", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "panel.html"}, "sidebar_action": {"default_title": "MakerMuse", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_panel": "panel.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["settings.js", "background.js"]}, "web_accessible_resources": ["page-bridge.js"], "content_scripts": [{"matches": ["https://makerworld.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle"}]}