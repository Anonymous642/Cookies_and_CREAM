{"manifest_version": 3, "name": "FeedBro", "short_name": "FeedBro", "description": "Follow feeds and read full articles in a reader page, right in your browser \u2014 synced with your FeedBro account.", "version": "0.5.5", "browser_specific_settings": {"gecko": {"id": "extension@feedbro.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "commands": {"open-reader": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open the FeedBro reader"}}, "content_scripts": [{"matches": ["https://feedbro.com/*"], "js": ["content/connect-bridge.js"], "run_at": "document_start"}], "permissions": ["storage", "activeTab", "scripting", "contextMenus", "alarms", "notifications"], "host_permissions": ["https://feedbro.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"]}