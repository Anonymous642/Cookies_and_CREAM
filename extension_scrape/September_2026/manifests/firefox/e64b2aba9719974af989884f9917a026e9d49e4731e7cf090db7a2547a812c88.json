{"manifest_version": 3, "name": "Gemini URL Prompt", "version": "1.0", "description": "Reads ?q= query from Gemini URL and auto-submits it.", "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "gemini-url-prompt-custom@local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}