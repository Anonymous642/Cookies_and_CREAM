{"manifest_version": 2, "name": "QuickSnip Sidebar", "version": "2.4.0", "description": "Instant sidebar search for QuickSnip.", "browser_specific_settings": {"gecko": {"id": "quicksnip-sidebar@vishal.config", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["clipboardRead", "clipboardWrite", "tabs", "activeTab", "*://*.google.com/*", "*://*.chatgpt.com/*", "*://*.gemini.google.com/*", "*://*.duckduckgo.com/*", "*://*.bing.com/*", "*://*.grok.com/*", "*://*.claude.ai/*", "webRequest", "webRequestBlocking"], "content_scripts": [{"matches": ["*://*.google.com/*", "*://*.chatgpt.com/*", "*://*.gemini.google.com/*", "*://*.duckduckgo.com/*", "*://*.bing.com/*", "*://*.grok.com/*", "*://*.claude.ai/*"], "js": ["darkreader.js", "dark-engine.js"], "run_at": "document_start", "all_frames": true}], "background": {"scripts": ["background.js"], "persistent": true}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+G"}, "description": "Toggle the QuickSnip sidebar."}, "quicksnip-search": {"suggested_key": {"default": "Alt+S"}, "description": "Trigger search from QuickSnip."}}, "sidebar_action": {"default_title": "QuickSnip Search", "default_panel": "sidebar.html", "default_icon": "icon.svg", "browser_style": false}}