{"manifest_version": 3, "name": "ReadingMode", "version": "1.0.0", "description": "Simple reading mode. Remove distractions and focus on content with clean layout.", "icons": {"48": "graphics/icon-48.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "action": {"default_icon": {"48": "graphics/icon-48.png", "96": "graphics/icon-96.png"}, "default_title": "ReadingMode", "default_popup": "settings/read.html"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "readingmode@focus.reader", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}