{"manifest_version": 3, "name": "Twitch Player Controls", "version": "1.0.11", "description": "Tastenkombinationen und erweiterte Steuerung f\u00fcr den Twitch Player", "permissions": ["storage"], "host_permissions": ["*://*.twitch.tv/*"], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "twitch-player-controls@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}