{"manifest_version": 3, "name": "YouTube Thumbnail Grabber Pro", "version": "1.1", "description": "Download YouTube video thumbnails in your preferred quality.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16_gray.png", "48": "icons/icon48_gray.png", "128": "icons/icon128_gray.png"}}, "permissions": ["activeTab", "clipboardWrite", "storage"], "host_permissions": ["https://*.youtube.com/*", "https://youtube.com/*", "https://img.youtube.com/*", "https://youtu.be/*"], "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+X"}, "description": "Open YouTube Thumbnail Grabber Pro"}}, "browser_specific_settings": {"gecko": {"id": "yt-thumbnail-grabber-pro@reda.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["utils.js"], "matches": ["https://*.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*"]}], "background": {"scripts": ["background.js"], "type": "module"}}