{"manifest_version": 3, "name": "Nesktop", "version": "0.10.0", "description": "Nesktop new tab workspace, page saver, and optional browser data integration.", "action": {"default_popup": "popup.html", "default_title": "Nesktop"}, "background": {"scripts": ["config.js", "browser-api.js", "diagnostics.js", "background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png", "1024": "icons/icon1024.png"}, "optional_permissions": ["bookmarks", "topSites", "tabs"], "options_page": "options.html", "permissions": ["storage", "activeTab"], "content_scripts": [{"js": ["config.js", "browser-api.js", "diagnostics.js", "content-script.js"], "matches": ["https://nesktop.com/*"], "run_at": "document_idle"}], "host_permissions": ["https://nesktop.com/*", "https://api.nesktop.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@nesktop.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["bookmarksInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}