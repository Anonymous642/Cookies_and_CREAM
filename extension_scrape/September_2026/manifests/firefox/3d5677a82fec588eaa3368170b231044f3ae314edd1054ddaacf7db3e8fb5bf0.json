{"manifest_version": 2, "name": "Reddit Photon & Raw Image Tools", "version": "1.4.0", "description": "Open Reddit archives and original image posts, with default-on raw Reddit image handling.", "browser_specific_settings": {"gecko": {"id": "reddit-photon@local.davis", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "webRequest", "webRequestBlocking", "https://reddit.com/media*", "https://*.reddit.com/media*", "https://i.redd.it/*", "https://preview.redd.it/*", "https://cf.preview.redd.it/*", "https://external-preview.redd.it/*", "https://external-i.redd.it/*"], "background": {"scripts": ["core.js", "background.js"], "persistent": false}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_action": {"default_title": "Reddit Photon tools", "default_popup": "popup.html", "default_icon": "icon.svg"}}