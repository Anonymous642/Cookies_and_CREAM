{"manifest_version": 3, "name": "Allah Reminder & Browsing Guard", "description": "Faith-based reminders in distracting feeds and local protection against explicit websites and search results.", "version": "1.0.8", "short_name": "Allah Reminder", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "webNavigation", "unlimitedStorage", "tabs"], "host_permissions": ["https://blocklistproject.github.io/*", "https://raw.githubusercontent.com/blocklistproject/*"], "action": {"default_title": "Allah Reminder & Browsing Guard", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none';"}, "browser_specific_settings": {"gecko": {"id": "allah-reminder-browsing-guard@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://bing.ca/search*", "*://bing.co.uk/search*", "*://bing.com/search*", "*://bing.fr/search*", "*://www.bing.ca/search*", "*://www.bing.co.uk/search*", "*://www.bing.com/search*", "*://www.bing.fr/search*"], "run_at": "document_idle", "js": ["content-scripts/bing-search.js"]}, {"matches": ["*://google.ca/search*", "*://google.co.uk/search*", "*://google.com.au/search*", "*://google.com/search*", "*://google.de/search*", "*://google.fr/search*", "*://www.google.ca/search*", "*://www.google.co.uk/search*", "*://www.google.com.au/search*", "*://www.google.com/search*", "*://www.google.de/search*", "*://www.google.fr/search*"], "run_at": "document_idle", "js": ["content-scripts/google-search.js"]}, {"matches": ["*://ca.search.yahoo.com/*", "*://duckduckgo.com/*", "*://ecosia.org/search*", "*://html.duckduckgo.com/*", "*://kagi.com