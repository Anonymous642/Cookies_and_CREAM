{"manifest_version": 2, "name": "X Region Blocker", "description": "Hide X/Twitter posts from accounts based in specific countries or regions.", "version": "1.0.0", "permissions": ["storage", "webRequest", "webRequestBlocking", "https://x.com/*", "https://twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["contentScript.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "X Region Blocker", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "x-region-blocker@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}