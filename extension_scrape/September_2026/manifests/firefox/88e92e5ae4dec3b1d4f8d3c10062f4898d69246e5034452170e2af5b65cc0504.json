{"manifest_version": 3, "name": "Clarity Block: Website Blocker", "version": "3.6.1", "description": "A premium distraction blocker to help you focus. Supports wildcards, custom redirects, active scheduling, and quotas.", "browser_specific_settings": {"gecko": {"id": "clarityblock@artiston2005.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "permissions": ["storage", "alarms", "notifications", "webRequest", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js", "scripts": ["background/background.js"], "type": "module"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup/popup.html", "default_title": "Clarity Block"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "options_ui": {"page": "dashboard/dashboard.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js"], "matches": ["<all_urls>"]}]}