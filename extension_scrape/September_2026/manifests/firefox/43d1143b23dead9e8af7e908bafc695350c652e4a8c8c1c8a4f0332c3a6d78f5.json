{"manifest_version": 3, "name": "YouTube Focus Guard", "version": "1.0.0", "description": "Blocks gaming, entertainment and live-stream videos on YouTube. Allows education videos freely; allows music videos for 10 minutes, then locks music for 30 minutes.", "browser_specific_settings": {"gecko": {"id": "youtube-focus-guard@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "YouTube Focus Guard", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["blocked.html", "inject.js"], "matches": ["*://*.youtube.com/*"]}], "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}