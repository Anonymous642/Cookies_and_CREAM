{"manifest_version": 2, "name": "Job Odyssey Capture", "version": "1.1.0", "description": "Capture any job posting to Job Odyssey \u2014 auto-detects job pages and prompts you to save.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "capture@jobodyssey.mpgink.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "Capture to Job Odyssey"}, "permissions": ["activeTab", "storage", "https://jobodyssey.mpgink.com/*", "https://*.myworkdayjobs.com/*", "https://boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*", "https://www.linkedin.com/*", "https://www.adzuna.com/*", "https://jobs.smartrecruiters.com/*", "https://*.jobvite.com/*", "https://*.icims.com/*", "https://*.bamboohr.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.myworkdayjobs.com/*/job/*", "https://boards.greenhouse.io/*/jobs/*", "https://jobs.lever.co/*/*", "https://jobs.ashbyhq.com/*/*", "https://www.linkedin.com/jobs/view/*", "https://www.adzuna.com/details/*", "https://www.adzuna.com/land/ad/*", "https://jobs.smartrecruiters.com/*/*", "https://*.jobvite.com/*/job/*", "https://*.icims.com/jobs/*", "https://*.bamboohr.com/careers/*"], "js": ["content.js"], "run_at": "document_idle"}]}