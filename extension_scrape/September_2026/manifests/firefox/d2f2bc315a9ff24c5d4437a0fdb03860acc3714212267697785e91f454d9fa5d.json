{"manifest_version": 2, "name": "radiofrance", "description": "Listen to music (FIP, Mouv, Musique) and news and broadcasts in French (Inter, Culture, Info) from radiofrance", "version": "1.6.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "content_scripts": [{"matches": ["*://*.radiofrance.fr/*"], "js": ["content-scripts/content.js"]}], "background": {"page": "player.html", "persistent": true}, "browser_specific_settings": {"gecko": {"id": "player@radiofrance.fr"}}, "browser_action": {"default_title": "radiofrance", "default_popup": "remote.html"}}