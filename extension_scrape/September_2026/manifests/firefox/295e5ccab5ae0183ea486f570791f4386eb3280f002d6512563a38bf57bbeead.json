{"manifest_version": 3, "name": "MeowTube: Custom Backgrounds & Blocker", "version": "1.3", "browser_specific_settings": {"gecko": {"id": "yt-focus-background@yourname.local", "strict_min_version": "109.0"}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}