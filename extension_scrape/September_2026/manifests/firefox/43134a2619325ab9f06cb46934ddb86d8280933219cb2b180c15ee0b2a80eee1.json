{"name": "PostureMinder", "version": "2.1.3", "manifest_version": 3, "author": "Sheryl Lun", "description": "Reminds you to sit up straight with pop-up notifications at specified time intervals.", "icons": {"128": "img/spine.png"}, "browser_specific_settings": {"gecko": {"id": "support@postureminder.app"}}, "permissions": ["alarms", "notifications", "storage"], "background": {"scripts": ["service_worker.js"], "type": "module"}, "action": {"default_title": "PostureMinder", "default_icon": "img/spine.png", "default_popup": "popout.html"}}