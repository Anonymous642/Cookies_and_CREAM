{"manifest_version": 3, "name": "MyACCA Progress Ring", "version": "1.0", "description": "Brings back the circular progress indicator on the MyACCA student portal. Unofficial and not affiliated with ACCA.", "homepage_url": "https://github.com/h4di-4li/acca-progress-ring", "browser_specific_settings": {"gecko": {"id": "acca-progress-ring@h4di-4li", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://accaportal.accaglobal.com/", "https://accaportal.accaglobal.com/default.aspx", "https://accaportal.accaglobal.com/qualification-progress/*"], "js": ["content-script.js"], "css": ["content-styles.css"], "run_at": "document_end"}]}