{"manifest_version": 3, "name": "VGC Score for Steam", "version": "0.1.4", "description": "Shows the VideoGamesCritic VGC Score on Steam game pages.", "homepage_url": "https://github.com/Rafacv23/videogamescritic-steam-extension", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "VGC Score for Steam", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/parse-vgc.js", "background.js"]}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*", "https://store.steampowered.com/*/app/*"], "js": ["lib/parse-vgc.js", "lib/widget.js", "content.js"], "run_at": "document_idle"}], "host_permissions": ["https://videogamescritic.com/*", "https://store.steampowered.com/*"], "browser_specific_settings": {"gecko": {"id": "vgc-score-for-steam@rafacv23", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}