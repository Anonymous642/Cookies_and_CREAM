{"manifest_version": 3, "name": "FluxGet - Download with FluxGet", "version": "0.2.46", "description": "Send browser downloads and supported media to the FluxGet desktop download manager.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "contextMenus", "cookies", "downloads", "notifications", "storage", "tabs", "webRequest", "webRequestBlocking"], "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:47824/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Download with FluxGet", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "fluxget@fluxget.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:47824"}}