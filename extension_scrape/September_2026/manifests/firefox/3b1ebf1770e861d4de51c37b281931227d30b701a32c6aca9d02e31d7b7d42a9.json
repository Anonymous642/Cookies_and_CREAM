{"manifest_version": 2, "name": "CleanTube", "version": "1.0", "description": "Removes clutter buttons and menu options from the YouTube player \u2014 Audio Track, Ambient Mode, Voice Boost, Stable Volume, Annotations and more.", "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "cleantube@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}