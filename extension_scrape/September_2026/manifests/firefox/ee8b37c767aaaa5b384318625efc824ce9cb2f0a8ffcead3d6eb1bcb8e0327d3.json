{"manifest_version": 3, "name": "PopBlock", "version": "1.7.4", "description": "Blocks pop-ups, new tabs, and cross-domain navigation from link clicks (including hijacked/overlay-redirected clicks) before it happens \u2014 search engine result links still work normally. Toggle on/off from the toolbar menu, or whitelist specific sites to allow their links through.", "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "manage.html", "open_in_tab": true}, "background": {"scripts": ["whitelist-utils.js", "default-whitelist.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["page-block-open.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["whitelist-utils.js", "overlay-guard.js", "proactive-overlay-guard.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "action": {"default_title": "PopBlock", "default_popup": "popup.html", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "popblock@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}