{"manifest_version": 3, "name": "FocusBlock", "version": "1.0.0", "description": "Block distracting websites to boost productivity. Focus modes, Pomodoro timer, and statistics. No API key needed!", "icons": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_icon": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png"}, "default_title": "FocusBlock - Stay Focused", "default_popup": "src/popup/popup.html"}, "background": {"scripts": ["src/background/background.js"]}, "permissions": ["storage", "webRequest", "tabs"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "focusblock@productivity.focus", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}