{"manifest_version": 3, "name": "Repo Folders for GitHub", "version": "1.0.4", "description": "Organise tes repos GitHub dans des dossiers imbriqu\u00e9s, avec drag & drop et recherche instantan\u00e9e.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs"], "action": {"default_title": "Repo Folders", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["src/lib/api.js", "src/lib/model.js", "src/lib/store.js", "src/content/scrape.js", "src/content/panel.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "repo-folders@codexastudio.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["src/background.js"]}}