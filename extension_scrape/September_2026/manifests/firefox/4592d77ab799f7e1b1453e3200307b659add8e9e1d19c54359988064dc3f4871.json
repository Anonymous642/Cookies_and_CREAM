{"manifest_version": 3, "name": "IG SaveSort", "version": "0.3", "description": "Compare and sort your Instagram saved collections side-by-side", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://www.instagram.com/*", "https://api.gumroad.com/*"], "browser_specific_settings": {"gecko": {"id": "igsavesort@bgmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "IG SaveSort", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["compare.html", "assets/icons/icon128.png"], "matches": ["<all_urls>"]}]}