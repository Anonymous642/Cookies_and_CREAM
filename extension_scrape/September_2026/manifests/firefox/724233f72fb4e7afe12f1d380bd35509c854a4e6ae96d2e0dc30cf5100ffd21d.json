{"manifest_version": 2, "name": "BlockGuard", "version": "1.0.0", "description": "Bloquea sitios web de tu elecci\u00f3n con una lista negra personalizable. Redirige a una p\u00e1gina de bloqueo personalizada cuando intentas acceder a un sitio bloqueado. Compatible con modo inc\u00f3gnito. Los datos se almacenan localmente y no se env\u00edan a ning\u00fan servidor.", "author": "BlockGuard", "homepage_url": "https://github.com/blockguard/blockguard", "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs", "<all_urls>"], "incognito": "spanning", "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "BlockGuard - Gestor de sitios bloqueados", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["blocked.html"], "browser_specific_settings": {"gecko": {"id": "blockguard@blockguard.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}