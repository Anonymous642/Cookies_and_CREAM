{"manifest_version": 3, "name": "Tanuki Image Translator", "version": "1.0.4", "description": "Translate manga, manhwa, webtoons, comics, screenshots, and image text on webpages with one click.", "permissions": ["activeTab", "scripting", "storage", "webNavigation"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/dark/icon-16.png", "32": "icons/dark/icon-32.png", "48": "icons/dark/icon-48.png", "128": "icons/dark/icon-128.png"}}, "icons": {"16": "icons/dark/icon-16.png", "32": "icons/dark/icon-32.png", "48": "icons/dark/icon-48.png", "128": "icons/dark/icon-128.png"}, "web_accessible_resources": [{"resources": ["popup/popup.html"], "matches": ["https://checkout.stripe.com/*"]}, {"resources": ["icons/light/*", "icons/dark/*"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "tanuki-image-translator@tanuki-translate", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent", "websiteActivity"]}}}}