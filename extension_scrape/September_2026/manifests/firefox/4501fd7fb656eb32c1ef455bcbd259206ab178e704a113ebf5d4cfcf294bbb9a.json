{"manifest_version": 2, "name": "Google Calendar Drop Import", "version": "2.0.0", "description": "Drag .ics calendar files from your desktop onto Google Calendar to import them through Google's own Import page, choosing which calendar they go into.", "browser_specific_settings": {"gecko": {"id": "{77fb0027-8ded-4e34-b49e-3415966748d4}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}