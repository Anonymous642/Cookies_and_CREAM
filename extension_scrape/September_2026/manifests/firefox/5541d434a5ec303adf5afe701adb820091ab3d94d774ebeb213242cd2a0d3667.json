{"manifest_version": 2, "name": "Bionic Text", "version": "0.1.1", "description": "Free, open-source bionic-style text formatting: bolds the start of each word to guide your eyes. Toggle per site or globally.", "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bionic-text@fkontic", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}]}