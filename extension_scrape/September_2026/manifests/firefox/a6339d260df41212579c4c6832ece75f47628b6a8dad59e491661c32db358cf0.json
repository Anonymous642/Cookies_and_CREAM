{"manifest_version": 2, "name": "WhatsApp Privacy Blur", "version": "1.0", "description": "Borra mensagens e m\u00eddia do WhatsApp Web para privacidade em espa\u00e7os p\u00fablicos", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "wa-privacy-blur@ext", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "css": ["content.css"]}], "browser_action": {"default_popup": "popup.html", "default_title": "WhatsApp Privacy", "default_icon": {"48": "icons/icon.svg"}}, "commands": {"toggle-blur": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Ativar/desativar todos os efeitos de blur"}}, "background": {"scripts": ["background.js"], "persistent": false}}