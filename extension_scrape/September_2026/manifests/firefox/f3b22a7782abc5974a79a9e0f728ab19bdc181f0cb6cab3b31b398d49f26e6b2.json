{"manifest_version": 3, "name": "Google Flights Extras", "version": "1.2", "description": "Adds penalty dollars to Google Flights results based on your personal preferences.", "permissions": ["storage"], "host_permissions": ["*://*.google.com/travel/flights*"], "content_scripts": [{"matches": ["*://*.google.com/travel/flights*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Google Flights Extras", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "google-flights-extra-filters@montaballer", "data_collection_permissions": {"required": ["none"], "optional": []}}}}