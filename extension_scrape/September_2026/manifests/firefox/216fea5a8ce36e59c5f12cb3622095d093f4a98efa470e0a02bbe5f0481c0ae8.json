{"manifest_version": 3, "name": "Roblox Badge Restorer", "version": "1.0.0", "description": "Restores missing legacy badges to Roblox profiles, new badges like 'UGC Creator', and brings back the classic badge culture.", "browser_specific_settings": {"gecko": {"id": "kannot.badge.restorer@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.roblox.com/*", "*://*.rolimons.com/*"], "action": {"default_title": "Roblox Badge Restorer", "default_icon": "badges/admin.png"}, "icons": {"128": "badges/admin.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["badge_data.js", "api_logic.js", "settings.js", "content.js"], "css": ["style.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/*", "badges/*"], "matches": ["<all_urls>"]}]}