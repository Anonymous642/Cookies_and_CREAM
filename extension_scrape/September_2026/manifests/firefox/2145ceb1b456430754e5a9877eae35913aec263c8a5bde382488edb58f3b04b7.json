{"manifest_version": 3, "name": "Ask ChatGPT Sidebar (Unofficial)", "version": "0.4.0", "description": "Highlight webpage text, right-click Ask ChatGPT, and use your own customizable prompt in Firefox's sidebar.", "permissions": ["menus", "storage"], "action": {"default_title": "Toggle ChatGPT Sidebar", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "Ask ChatGPT", "default_panel": "sidebar.html", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "open_at_install": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle the ChatGPT sidebar"}}, "browser_specific_settings": {"gecko": {"id": "ask-chatgpt-sidebar@kchi.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}