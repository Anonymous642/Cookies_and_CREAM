{"manifest_version": 3, "name": "Paiprus Browser Research", "description": "Run user-requested web research in your browser and return readable, cited sources to Paiprus.", "version": "0.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["https://www.google.com/*", "https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://paiprus.com/*", "https://www.paiprus.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start"}], "action": {"default_title": "Paiprus Browser Research", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "browser-research@paiprus.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}