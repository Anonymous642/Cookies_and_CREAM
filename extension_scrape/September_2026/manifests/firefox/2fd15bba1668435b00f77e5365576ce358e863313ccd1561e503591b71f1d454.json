{"manifest_version": 3, "name": "Shortless", "version": "0.1.2", "description": "Hides YouTube Shorts \u2013 completely, or allowing only Shorts from channels you subscribe to. When logged out, all Shorts are hidden.", "homepage_url": "https://github.com/Digitmedia-de/Shortless", "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "background": {"scripts": ["src/background/worker.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "css": ["src/content/hide-shorts.css"], "js": ["src/common/settings.js", "src/content/subs.js", "src/content/main.js"], "run_at": "document_start"}], "action": {"default_title": "Shortless", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "shortless@digitmedia.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}