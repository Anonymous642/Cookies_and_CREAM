{"manifest_version": 3, "name": "MailAssist", "version": "0.1.3", "description": "E-Mail-Analyse und Antwortvorschl\u00e4ge f\u00fcr Gmail Web", "browser_specific_settings": {"gecko": {"id": "mailassist@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personalCommunications", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "activeTab", "clipboardWrite"], "host_permissions": ["https://mail.google.com/*", "https://mailassist-api.frabi.net/*", "http://localhost:7100/*", "http://127.0.0.1:7100/*"], "background": {"scripts": ["src/background/background.js"]}, "action": {"default_title": "MailAssist", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content/gmail.js"], "run_at": "document_idle"}]}