{"manifest_version": 3, "name": "PasswordGenerator", "version": "1.0.0", "description": "Generate strong passwords with customizable options. Check password strength, copy to clipboard, and view history.", "icons": {"48": "password-icons/icon-48.png", "96": "password-icons/icon-96.png", "128": "password-icons/icon-128.png"}, "action": {"default_popup": "password-ui/popup.html", "default_title": "PasswordGenerator"}, "permissions": ["storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "passwordgenerator@password.tool", "data_collection_permissions": {"required": ["none"]}}}}