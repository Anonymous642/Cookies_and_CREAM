{"manifest_version": 3, "name": "ValueSort - Supermarket Unit Price Sorter", "version": "1.1.4", "description": "Sort supermarket search results by unit price to find the best value groceries!", "permissions": ["storage"], "host_permissions": ["https://www.tesco.com/*", "https://groceries.morrisons.com/*", "https://www.asda.com/*"], "content_scripts": [{"matches": ["https://www.tesco.com/*"], "js": ["CombinedContentScript.js", "TescoContentScript.js"], "run_at": "document_end"}, {"matches": ["https://groceries.morrisons.com/*"], "js": ["CombinedContentScript.js", "MorrisonsContentScript.js"], "run_at": "document_end"}, {"matches": ["https://www.asda.com/*"], "js": ["CombinedContentScript.js", "AsdaContentScript.js"], "run_at": "document_end"}], "icons": {"128": "icons/ValueSortLogo.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "icons/ValueSortLogo.png"}}, "browser_specific_settings": {"gecko": {"id": "store-priceperunit@dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}