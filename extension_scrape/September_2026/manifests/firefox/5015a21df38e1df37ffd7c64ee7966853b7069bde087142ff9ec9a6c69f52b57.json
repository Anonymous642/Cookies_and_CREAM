{"name": "Lovli", "description": "Make your URLs beautiful with Lovli, the lovable URL shortener", "version": "1.0.0", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "@lovli", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": "assets/icons/icon-128.png"}, "background": {"scripts": ["assets/javascript/background.js"], "type": "module"}, "permissions": ["activeTab", "contextMenus"], "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}