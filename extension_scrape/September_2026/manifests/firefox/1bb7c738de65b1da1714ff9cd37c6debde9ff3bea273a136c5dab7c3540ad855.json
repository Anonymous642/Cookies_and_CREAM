{"manifest_version": 3, "name": "Lexpad", "version": "0.1.1", "description": "Add the words you meet on any page to your Lexpad notebook, with the meaning shown as you add.", "homepage_url": "https://lexpad.app", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Lexpad", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "contextMenus"], "host_permissions": ["https://api.lexpad.app/*"], "browser_specific_settings": {"gecko": {"id": "extension@lexpad.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}