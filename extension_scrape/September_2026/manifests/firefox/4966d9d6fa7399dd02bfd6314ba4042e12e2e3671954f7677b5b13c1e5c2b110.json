{"manifest_version": 3, "name": "Web Content Scraper", "version": "1.0.2", "description": "Extract structured content from any webpage", "author": "kiarash@kiarashbashokian.com", "homepage_url": "https://kiarashbashokian.com/", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16x16.png", "32": "icons/icon32x32.png", "48": "icons/icon48x48.png", "128": "icons/icon128x128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "web-content-scraper@kiarashbashokian.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}