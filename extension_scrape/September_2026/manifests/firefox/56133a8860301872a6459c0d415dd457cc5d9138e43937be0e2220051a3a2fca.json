{"manifest_version": 3, "name": "ZirconSound", "description": "This is an extension for the Discord bot ZirconSound", "version": "2.0.3", "browser_specific_settings": {"gecko": {"id": "{2a14e725-0d43-4e0b-a514-6358ecd4b2c0}"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["identity", "activeTab", "tabs"], "host_permissions": ["https://discord.com/*", "https://api.zirconfusion.com/*"], "action": {"default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["framework/*", "content/*"], "matches": ["<all_urls>"]}]}