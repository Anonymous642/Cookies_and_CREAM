{"manifest_version": 3, "name": "HN Follow/Block", "version": "2.1.0", "description": "Follow users and block annoying commenters on Hacker News. See your personalized feed of posts and comments from users you follow.", "permissions": ["storage"], "host_permissions": ["https://hacker-news.firebaseio.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content_script.js"], "css": ["styles.css"]}], "web_accessible_resources": [{"resources": ["myfeed.html"], "matches": ["https://news.ycombinator.com/*"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "hn-follow-block@example.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}, "author": "Nick Jasuja", "homepage_url": "https://www.linkedin.com/in/nikhilesh/"}