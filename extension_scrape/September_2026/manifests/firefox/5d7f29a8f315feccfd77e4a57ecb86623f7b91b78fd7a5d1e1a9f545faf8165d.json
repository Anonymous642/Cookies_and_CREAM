{"manifest_version": 3, "name": "Viewer Sort for Twitch", "version": "1.0.0", "description": "Automatically sort Twitch categories and live channels by viewer count, highest first.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "viewer-sort@twitch-viewer-sort.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"], "js": ["content.js"], "run_at": "document_start"}]}