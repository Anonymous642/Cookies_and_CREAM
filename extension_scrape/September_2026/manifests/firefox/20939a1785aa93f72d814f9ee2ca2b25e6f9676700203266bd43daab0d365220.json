{"manifest_version": 2, "name": "Session Minder", "version": "0.2.3", "description": "Export ChatGPT session history from Firefox into a local CSV file.", "permissions": ["history", "downloads", "storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Session Minder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "session-minder@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}