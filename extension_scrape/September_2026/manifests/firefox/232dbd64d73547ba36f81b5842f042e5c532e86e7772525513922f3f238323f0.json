{"manifest_version": 3, "name": "LKTips", "version": "5.1", "description": "Instantly view Sinhala meaning of English words by hovering over them or searching directly", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["dictionary.json"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "lktips@firefox.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}