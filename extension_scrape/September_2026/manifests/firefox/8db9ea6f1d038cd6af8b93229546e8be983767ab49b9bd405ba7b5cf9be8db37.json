{"manifest_version": 2, "name": "Dark by Eyed\u2122", "browser_specific_settings": {"gecko": {"id": "dark-by-eyed@aploi.de"}}, "author": "Carlo Esposito - Aploide", "version": "1.0", "description": "Enjoy the web better by having dark mode everywhere.", "icons": {"48": "icons/48.png", "96": "icons/96.png", "256": "icons/256.png"}, "permissions": ["storage", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"48": "icons/48.png", "96": "icons/96.png", "256": "icons/256.png"}, "default_title": "Dark Settings", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dark.js"], "run_at": "document_start"}]}