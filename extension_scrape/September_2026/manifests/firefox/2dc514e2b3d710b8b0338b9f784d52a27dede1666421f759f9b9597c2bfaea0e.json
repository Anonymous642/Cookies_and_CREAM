{"manifest_version": 3, "name": "CiteScope PDF Reader", "version": "1.1.3", "description": "Read scientific PDFs with clickable citation previews, abstracts, references, search, themes, and citation export.", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["webRequest", "webRequestBlocking", "storage", "downloads", "clipboardWrite", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open CiteScope", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "citescope-pdf-reader@local.invalid", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}