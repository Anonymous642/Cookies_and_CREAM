{"manifest_version": 2, "name": "I JUST WANT TO WATCH VIDEOS", "version": "1.14", "description": "Removes unwanted YouTube UI elements", "browser_specific_settings": {"gecko": {"id": "youtube-fixer-public@lomanto.cc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "I JUST WANT TO WATCH VIDEOS", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "options.html"}, "options_ui": {"page": "options.html", "browser_style": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}