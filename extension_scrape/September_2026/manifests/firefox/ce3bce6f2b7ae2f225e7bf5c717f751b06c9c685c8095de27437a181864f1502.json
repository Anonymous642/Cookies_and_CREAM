{"manifest_version": 3, "name": "Lemmy Deep Lighthouse", "version": "1.3.11", "description": "Bridge your own Reddit posts to Lemmy. Review and publish your content across communities with full control over what gets posted.", "icons": {"48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["*://*.reddit.com/*", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content_scripts/reddit.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon.svg", "icons/icon-128.png"], "matches": ["*://*.reddit.com/*"]}], "browser_specific_settings": {"gecko": {"id": "lemmy-deep-lighthouse@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}