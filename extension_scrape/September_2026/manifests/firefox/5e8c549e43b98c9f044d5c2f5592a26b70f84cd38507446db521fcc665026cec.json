{"name": "Wooflang Extension", "description": "Add new words to your Wooflang account on every website", "version": "1.1.4", "manifest_version": 3, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://wooflang.com/*"], "action": {"default_title": "Wooflang"}, "content_security_policy": {"extension_pages": "default-src 'self'; connect-src https://wooflang.com;"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "service.wooflang@gmail.com", "strict_min_version": "102.0"}, "gecko_android": {"strict_min_version": "113.0"}}, "icons": {"16": "images/wooflang.png", "32": "images/wooflang.png", "48": "images/wooflang.png", "128": "images/wooflang.png"}}