{"manifest_version": 2, "name": "CF Upsolve Tracker", "version": "1.2", "description": "Shows problems you upsolved after each Codeforces contest, right on the contests page.", "browser_specific_settings": {"gecko": {"id": "cf-upsolve-tracker@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://codeforces.com/*", "storage"], "content_scripts": [{"matches": ["https://codeforces.com/contests*", "https://codeforces.com/"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "CF Upsolve Tracker", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}