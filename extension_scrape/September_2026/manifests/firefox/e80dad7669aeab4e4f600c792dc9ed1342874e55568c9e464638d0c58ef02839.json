{"manifest_version": 3, "name": "Insta Search", "version": "1.0", "description": "Search Instagram accounts", "browser_specific_settings": {"gecko": {"id": "igsearch.null@gmail.comzzz"}}, "icons": {"96": "insta_search.png"}, "permissions": ["activeTab", "cookies", "storage"], "host_permissions": ["*://*.instagram.com/*"], "background": {"service_worker": "bg.js", "scripts": ["bg.js"]}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["igsearch.js"]}], "action": {"default_popup": "form.html"}, "web_accessible_resources": [{"resources": ["results.html"], "matches": ["*://*.instagram.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}