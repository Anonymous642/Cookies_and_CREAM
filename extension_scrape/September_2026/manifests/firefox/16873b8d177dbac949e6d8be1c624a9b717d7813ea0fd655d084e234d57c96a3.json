{"name": "Speed Control", "short_name": "speed-control", "version": "0.1.7", "manifest_version": 2, "description": "Speed up and slow down HTML5 audio/video with shortcuts", "browser_specific_settings": {"gecko": {"id": "{34935565-80aa-4ac2-a645-530178683b3b}", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "options_ui": {"page": "preferences.html", "open_in_tab": false}, "content_scripts": [{"all_frames": true, "matches": ["http://*/*", "https://*/*", "file:///*"], "match_about_blank": true, "exclude_matches": ["https://plus.google.com/hangouts/*", "https://hangouts.google.com/*", "https://meet.google.com/*"], "css": ["main.css"], "js": ["main.js"]}], "web_accessible_resources": ["main.css", "shadow.css"]}