{"manifest_version": 3, "name": "B Capture Shot", "version": "1.0.1", "description": "Capture the active tab as a screenshot: full page, visible area, or selection. Preview, crop, draw, and save.", "author": "Bahad\u0131r B. Bekdemir", "icons": {"48": "images/logo/b-capture-shot-48.png", "96": "images/logo/b-capture-shot-96.png", "128": "images/logo/b-capture-shot-128.png"}, "permissions": ["activeTab", "tabs", "scripting", "downloads", "storage"], "action": {"default_icon": {"48": "images/logo/b-capture-shot-48.png", "96": "images/logo/b-capture-shot-96.png", "128": "images/logo/b-capture-shot-128.png"}, "default_title": "Take screenshot", "default_popup": "popup/popup.html"}, "background": {"service_worker": "scripts/background.js", "scripts": ["scripts/background.js"]}, "web_accessible_resources": [{"resources": ["images/icons/*"], "matches": ["<all_urls>"]}], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Capture visible area screenshot"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page screenshot"}}, "browser_specific_settings": {"gecko": {"id": "b-capture-shot@bcaptureshot", "strict_min_version": "121.0"}, "gecko_android": {}}}