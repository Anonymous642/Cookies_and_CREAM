{"manifest_version": 3, "name": "Quick Control Video Extension", "version": "1.1.0", "description": "Play, pause, and seek videos across any tab using keyboard shortcuts.", "permissions": ["scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quick-control-video@9uifranco", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "Quick Control Video"}, "commands": {"play-pause": {"description": "Toggle play/pause on playing videos"}, "seek-backward": {"description": "Seek backward 5 seconds"}, "seek-forward": {"description": "Seek forward 5 seconds"}, "volume-up": {"description": "Increase volume by 10%"}, "volume-down": {"description": "Decrease volume by 10%"}, "toggle-mute": {"description": "Toggle mute/unmute on videos"}}}