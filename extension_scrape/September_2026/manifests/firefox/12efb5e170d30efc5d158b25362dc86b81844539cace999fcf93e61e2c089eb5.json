{"manifest_version": 3, "name": "SummaryTube - YouTube Video Summarizer", "version": "1.0.0", "description": "Get instant AI-powered summaries of any YouTube video with key moments and Q&A", "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48-white.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "storage", "identity", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.summarytube.com/*", "https://*.googleapis.com/*", "https://fonts.gstatic.com/*"], "web_accessible_resources": [{"resources": ["assets/icons/icon48.png", "assets/icons/icon48-white.png"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_start", "all_frames": false}], "background": {"scripts": ["./src/background/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "summarytube@summarytube.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}