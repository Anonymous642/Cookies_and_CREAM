{"manifest_version": 3, "name": "AuraStream - Bilingual Subtitle & Dictionary", "version": "1.0.0", "description": "Translates streaming video subtitles in real-time, displays bilingual overlays, and provides hover-based dictionary lookup with vocabulary tracking.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>", "https://translate.googleapis.com/*", "https://api.dictionaryapi.dev/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": "icon.svg"}, "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "aurastream@bilingual-subtitle.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}