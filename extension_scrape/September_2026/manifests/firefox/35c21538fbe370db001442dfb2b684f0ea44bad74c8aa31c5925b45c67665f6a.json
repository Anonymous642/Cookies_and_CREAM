{"manifest_version": 3, "name": "Repeat Last Action", "version": "0.1.0", "description": "Remembers your last action (browser action or on-page click chain) and repeats it with a keyboard shortcut.", "browser_specific_settings": {"gecko": {"id": "repeat-last-action@helixcraft.pages.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared/fingerprint.js", "content-script.js"], "all_frames": true, "match_about_blank": false, "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Repeat Last Action", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"repeat-last-action": {"suggested_key": {"default": "Alt+R"}, "description": "Repeat last action"}, "record-start-stop": {"suggested_key": {"default": "Alt+S"}, "description": "Start/stop recording (macro mode)"}, "record-pin": {"suggested_key": {"default": "Alt+P"}, "description": "Pin/unpin last action (pin mode)"}}}