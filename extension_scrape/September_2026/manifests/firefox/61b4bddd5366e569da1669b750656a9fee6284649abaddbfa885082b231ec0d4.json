{"manifest_version": 2, "name": "Grabbit", "version": "2.2.0", "description": "Grab the video you are watching. Runs a local yt-dlp backend - nothing leaves your machine.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*", "http://127.0.0.1:8765/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["common.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Grabbit - download this video", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "yt-floating-downloader@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}