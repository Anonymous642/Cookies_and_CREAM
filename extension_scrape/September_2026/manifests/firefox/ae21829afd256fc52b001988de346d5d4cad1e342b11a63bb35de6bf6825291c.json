{"manifest_version": 3, "name": "MonChart | Data Table Miner", "version": "2.2.5", "description": "Turn any HTML table into an interactive chart. Edit live, clean data with AI, export to Excel or PNG, and save to monchart.com.", "browser_specific_settings": {"gecko": {"id": "support@monchart.com", "strict_min_version": "109.0"}}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "commands": {"toggle-feature": {"description": "Toggle table scan on or off", "suggested_key": {"default": "Ctrl+Shift+Y"}}}, "content_scripts": [{"js": ["firefoxFetchPatch.js", "dist/bundle.js"], "matches": ["<all_urls>"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'self'; connect-src 'self' https://api.monchart.com/;"}, "host_permissions": ["https://api.monchart.com/*", "https://monchart.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "contextMenus", "cookies", "storage"], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["dist/bundle.js", "icons/icon16.png", "icons/icon48.png", "icons/icon128.png"]}]}