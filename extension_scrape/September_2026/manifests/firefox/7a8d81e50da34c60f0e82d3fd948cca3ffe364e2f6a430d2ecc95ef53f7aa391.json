{"manifest_version": 3, "name": "URLSafe \u2014 URL Scanner", "short_name": "URLSafe", "version": "2.0.0", "description": "Scan URLs for phishing/malware using VirusTotal and urlscan.io", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://www.virustotal.com/*", "https://urlscan.io/*", "<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "URLSafe Scanner", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "urlsafe@example.com", "strict_min_version": "109.0"}}}