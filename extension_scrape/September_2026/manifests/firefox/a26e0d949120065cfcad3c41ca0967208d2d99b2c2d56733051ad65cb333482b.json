{"manifest_version": 2, "name": "BookHive", "version": "1.3.0", "description": "A standalone bookmark manager with website snapshots. Save, tag, search, and browse your bookmarks with HTML snapshots \u2014 all stored locally in your browser.", "icons": {"48": "icons/bookhive-48.png", "96": "icons/bookhive-96.png"}, "permissions": ["activeTab", "storage", "tabs", "downloads", "alarms", "menus", "notifications", "<all_urls>"], "browser_action": {"default_icon": {"48": "icons/bookhive-48.png", "96": "icons/bookhive-96.png"}, "default_title": "BookHive - Open Dashboard"}, "commands": {"save-bookmark": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Save current page as bookmark"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open BookHive dashboard"}}, "background": {"scripts": ["db.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "BookHive@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}