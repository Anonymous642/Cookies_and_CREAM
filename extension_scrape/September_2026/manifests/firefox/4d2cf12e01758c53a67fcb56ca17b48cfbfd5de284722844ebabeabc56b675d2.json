{"manifest_version": 3, "name": "Aspect Inspector", "version": "1.0.0", "author": "Stewart Zollinger", "homepage_url": "https://github.com/stewartzollinger/Aspect-Inspector", "description": "Highlight an element and display its rendered dimensions and aspect ratio.", "permissions": ["activeTab", "scripting"], "icons": {"32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Aspect Inspector", "default_icon": {"32": "icons/32.png"}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "browser_specific_settings": {"gecko": {"id": "aspect-inspector@stewartzollinger.com", "data_collection_permissions": {"required": ["none"]}}}}