{"manifest_version": 2, "name": "SwiftSign LinkedIn Signature Generator", "version": "1.0.0", "description": "Extract LinkedIn profiles and create professional email signatures in 12 seconds. Auto-deploy to Gmail, Outlook, and more.", "permissions": ["activeTab", "storage", "identity", "tabs", "cookies", "*://linkedin.com/*", "*://www.linkedin.com/*", "*://www.getswiftsign.com/*", "*://getswiftsign.com/*", "*://api.getswiftsign.com/*", "https://www.googleapis.com/*", "https://graph.microsoft.com/*"], "background": {"scripts": ["lib/platform-api.js", "lib/template-manager.js", "lib/auth-manager.js", "lib/swiftsign-api.js", "lib/email-deployer.js", "lib/linkedin-scraper.js", "background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://linkedin.com/*", "*://www.linkedin.com/*"], "js": ["content/linkedin-detector.js"], "css": ["content/swiftsign-styles.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "SwiftSign LinkedIn Extractor", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "browser_style": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["templates/*", "assets/*", "icons/*", "lib/*"], "browser_specific_settings": {"gecko": {"id": "swiftsign@getswiftsign.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}