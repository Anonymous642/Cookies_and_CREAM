{"manifest_version": 3, "name": "AO3 Kudos Checker", "version": "1.0.9", "description": "Check whether you've left kudos on AO3 works \u2014 even while logged out.(Need to log in to view locked fics though)", "browser_specific_settings": {"gecko": {"id": "ao3-kudos-checker@ao3kudoschecker", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://archiveofourown.org/*"], "content_scripts": [{"matches": ["https://archiveofourown.org/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_title": "AO3 Kudos Checker"}, "background": {"scripts": ["src/background.js"], "service_worker": "src/background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}