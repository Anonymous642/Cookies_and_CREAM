{"manifest_version": 2, "name": "CF Solve Count Hider", "version": "1.0.0", "description": "Hides the number of people who have solved problems on Codeforces \u2014 works during contests too.", "browser_specific_settings": {"gecko": {"id": "cf-solve-hider@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "*://codeforces.com/*", "*://*.codeforces.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://codeforces.com/*", "https://*.codeforces.com/*", "http://codeforces.com/*", "http://*.codeforces.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}