{"manifest_version": 3, "name": "Feather for X", "version": "0.1.0", "description": "Feather's actions, right in the X action row. Create, download or export without leaving the timeline.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["downloads"], "host_permissions": ["https://video.twimg.com/*"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/page-hook.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/page-hook.js"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "browser_specific_settings": {"gecko": {"id": "feather@feathershots.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}