{"manifest_version": 3, "name": "SideReacts", "version": "1.0.0", "description": "Real-time reactions while watching YouTube and Netflix", "browser_specific_settings": {"gecko": {"id": "sidereacts@sidereacts.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["authenticationInfo", "personallyIdentifyingInfo", "searchTerms", "technicalAndInteraction"]}}}, "permissions": ["storage", "identity", "tabs", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.netflix.com/*", "https://sidereacts.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "SideReacts", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/runtime.js", "content/shared.js", "content/panel-host.js", "content/youtube.js"], "css": ["content/floating-button.css", "content/panel-host.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/keyboard-guard-page.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.netflix.com/*"], "js": ["content/runtime.js", "content/shared.js", "content/panel-host.js", "content/netflix.js"], "css": ["content/floating-button.css", "content/panel-host.css"], "run_at": "document_idle"}, {"matches": ["https://www.netflix.com/*"], "js": ["content/keyboard-guard-page.js"], "run_at": "document_idle", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["sidepanel/*", "icons/*"], "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"]}]}