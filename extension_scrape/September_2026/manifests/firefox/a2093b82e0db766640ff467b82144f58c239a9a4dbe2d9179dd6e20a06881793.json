{"manifest_version": 2, "name": "PromptReuse", "version": "1.0.0", "description": "Text expander \u2014 save prompts, addresses, and any text with shortcuts. Tab to expand, Ctrl+Space to search.", "browser_specific_settings": {"gecko": {"id": "promptreuse@extension", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "clipboardWrite"], "background": {"scripts": ["utils/storage.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/storage.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "PromptReuse"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}