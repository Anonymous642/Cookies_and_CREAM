{"manifest_version": 3, "name": "MDL Scores for AvistaZ", "version": "1.1.6", "description": "Shows MyDramaList scores on AvistaZ movie and TV detail and browse pages.", "incognito": "not_allowed", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_icon": "icons/icon.svg", "default_title": "AvistaZ MDL Scores", "default_popup": "popup.html"}, "permissions": ["storage"], "host_permissions": ["https://mydramalist.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://avistaz.to/tv/*", "https://avistaz.to/movie/*", "https://avistaz.to/tv-shows*", "https://avistaz.to/movies*"], "css": ["content.css"], "js": ["score-colors.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "avistaz-mdl-scores@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}