{"manifest_version": 2, "name": "Tab Saver", "version": "1.1", "description": "Save current tab and open later", "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "tab-saver@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "commands": {"save-current-tab": {"suggested_key": {"default": "Alt+Q"}, "description": "Save current tab"}}}