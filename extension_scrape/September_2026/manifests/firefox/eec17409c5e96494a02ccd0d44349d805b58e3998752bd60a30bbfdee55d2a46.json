{"manifest_version": 3, "name": "HearSub for Firefox", "short_name": "HearSub", "default_locale": "en", "version": "0.0.13", "description": "__MSG_extensionDescription__", "action": {"default_title": "HearSub for Firefox", "default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "identity", "webRequest"], "host_permissions": ["https://*.youtube.com/*", "https://*.googlevideo.com/*", "https://hearsub.ai/*", "https://www.hearsub.ai/*"], "background": {"scripts": ["assets/offscreen.js", "assets/background.js"], "type": "module"}, "externally_connectable": {"matches": ["https://hearsub.ai/*", "https://www.hearsub.ai/*"]}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["assets/inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.youtube.com/*"], "js": ["assets/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["index.html", "assets/*.js", "assets/*.css", "icons/*.png"], "matches": ["https://*.youtube.com/*"]}], "version_name": "0.0.13", "browser_specific_settings": {"gecko": {"id": "hearsub@hearsub.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent", "websiteActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}