{"manifest_version": 3, "name": "Brand Consistency Checker", "version": "1.0.0", "description": "Analyze websites for brand guideline compliance. Check fonts, colors, spacing, and logo usage. Generate detailed reports for designers and marketing teams.", "author": "Your Name", "browser_specific_settings": {"gecko": {"id": "brand-consistency@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Brand Consistency Checker", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/analyzer.js"], "css": ["content/analyzer.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "commands": {"analyze-page": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Analyze current page for brand consistency"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}