{"manifest_version": 2, "name": "Full Page to Clipboard", "version": "1.5.0", "description": "Capture the entire scrollable page and copy it straight to the clipboard with one keystroke.", "permissions": ["<all_urls>", "tabs", "clipboardWrite"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Copy full-page screenshot to clipboard"}, "commands": {"capture-full-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Copy full-page screenshot to clipboard"}}, "browser_specific_settings": {"gecko": {"id": "fullpage-clipboard@local.extension", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}