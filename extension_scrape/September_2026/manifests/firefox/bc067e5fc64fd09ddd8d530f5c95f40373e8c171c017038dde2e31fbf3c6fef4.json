{"manifest_version": 3, "name": "Text Highlighter & Bullet Points", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "web-highlighter-extension@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "description": "Highlight text on any webpage and convert them into bullet points.", "permissions": ["storage", "activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Toggle Highlighter", "default_icon": {"128": "icon.png"}}, "icons": {"128": "icon.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"]}]}