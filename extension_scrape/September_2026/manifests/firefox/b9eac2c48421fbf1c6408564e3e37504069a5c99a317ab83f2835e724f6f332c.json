{"manifest_version": 2, "name": "Gemini Keyboard Shortcuts", "version": "1.1", "description": "Adds configurable keyboard shortcuts to Google Gemini's web interface. Customize your focus trigger key in settings.", "browser_specific_settings": {"gecko": {"id": "gemini-keyboard-shortcuts@example.com"}}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://gemini.google.com/*", "file:///*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-128.png"}, "web_accessible_resources": ["content.js"]}