{"manifest_version": 2, "name": "Assistente de C\u00f3pia", "version": "2.10.1", "description": "Serve para copiar a formata\u00e7\u00e3o de textos para editores HTML. Feita a c\u00f3pia de um texto qualquer (editor de documentos ou outra fonte), a extens\u00e3o acessa a vers\u00e3o HTML do texto e formata\u00e7\u00e3o e disponibiliza para que o usu\u00e1rio possa colar esse conte\u00fado em algum editor HTML.", "icons": {"48": "icons/icone_inativo.png"}, "browser_action": {"default_icon": "icons/icone_inativo.png", "default_title": "Inativo (clique para ativar)", "default_popup": "popup/popup_extensao.html"}, "content_scripts": [{"matches": ["*://pjehomologacao.trt13.jus.br/*", "*://pjebugfix.trt13.jus.br/*", "*://pjevalidacao.trt13.jus.br/*", "*://pjeadm.trt13.jus.br/*", "*://pje.trt13.jus.br/*"], "js": ["assistente.js"]}], "options_ui": {"page": "popup/popup_extensao.html", "open_in_tab": true, "browser_style": true}, "permissions": ["activeTab", "contextMenus", "clipboardWrite", "clipboardRead", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "assistente_de_copia.labor@trt13.jus.br"}}, "background": {"scripts": ["background/background.js", "background/menu-contexto.js"]}}