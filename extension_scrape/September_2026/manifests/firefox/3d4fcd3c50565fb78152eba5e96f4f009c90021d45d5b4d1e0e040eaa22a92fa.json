{"manifest_version": 2, "name": "CSV Inline Viewer for Firefox", "version": "1.4", "description": "Abre archivos CSV en una vista amigable dentro de Firefox en lugar de descargarlos autom\u00e1ticamente. No recopila datos.", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "CSV Inline Viewer"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "web_accessible_resources": ["viewer.html", "viewer.js", "viewer.css"], "browser_specific_settings": {"gecko": {"id": "csv-inline-viewer@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}