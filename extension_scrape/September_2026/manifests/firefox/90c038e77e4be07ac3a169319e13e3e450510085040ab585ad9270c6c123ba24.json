{"manifest_version": 3, "name": "CopyMe", "version": "1.0", "description": "A simple notepad extension to copy and organize URLs", "permissions": ["storage", "tabs", "contextMenus", "clipboardWrite", "downloads"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/copy.png", "48": "icons/copy.png", "128": "icons/copy.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/copy.png", "48": "icons/copy.png", "128": "icons/copy.png"}, "commands": {"copy-current-tab": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Copy current tab URL to CopyMe"}}, "browser_specific_settings": {"gecko": {"id": "copynotepad@example.com"}}}