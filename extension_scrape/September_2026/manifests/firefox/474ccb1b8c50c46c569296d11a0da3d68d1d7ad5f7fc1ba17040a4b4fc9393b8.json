{"manifest_version": 3, "name": "PhishGuard AI", "version": "3.2.1", "description": "Offline AI phishing detector. Scans links & messages on-device - no data leaves your browser.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "PhishGuard AI - Quick Analysis"}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "permissions": ["activeTab", "storage", "scripting", "contextMenus", "notifications"], "commands": {"scan-current-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Scan the current tab with PhishGuard"}}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "{5ECEB6B6-6AF9-47EB-BD6B-FE77E70C9B96}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}