{"manifest_version": 2, "name": "Compressr", "description": "Keeps browser audio at one comfortable volume. Levels quiet dialogue, tames sudden loud bursts. Fully local.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "activeTab", "https://api.compressr.io/*"], "commands": {"toggle-processing": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Toggle Compressr for this tab"}}, "browser_specific_settings": {"gecko": {"id": "compressr@compressr.io", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["worklets/*.js"], "content_security_policy": "script-src 'self'; object-src 'none'; connect-src https://api.compressr.io", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Loading\u2026", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}