{"manifest_version": 3, "name": "Star Filter for Amazon", "version": "1.3.0", "description": "Filter Amazon search results by star rating (4.0+ up to 5.0) and review count with sliders. Not affiliated with Amazon.", "author": "JuanTan", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "5omjkni8n@mozmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "action": {"default_title": "Star Filter for Amazon", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.es/*", "*://*.amazon.it/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*", "*://*.amazon.nl/*", "*://*.amazon.se/*"], "js": ["content.js"], "run_at": "document_idle"}]}