{"manifest_version": 2, "name": "Outline Nav", "version": "2.1.4", "description": "Navigate long articles by their heading structure. Generates an indented outline from h1\u2013h6, lets you search headings, and scrolls to the one you pick with a quick highlight.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{a096342a-c53e-4fc0-b709-35c67116a3a4}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Outline Nav", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}