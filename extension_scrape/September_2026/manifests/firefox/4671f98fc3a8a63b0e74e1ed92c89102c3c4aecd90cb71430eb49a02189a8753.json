{"manifest_version": 3, "name": "Shortcut Manager", "version": "1.0.0", "description": "Manage your shortcuts and bookmarks with categories, export/import functionality, and offline support.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "notifications", "contextMenus"], "host_permissions": ["https://www.googleapis.com/*", "https://api.dropboxapi.com/*", "https://content.dropboxapi.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Shortcut Manager"}, "background": {"scripts": ["background.js"]}, "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["modules/*.js", "dashboard/dashboard.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"open-shortcut-manager": {"suggested_key": {"default": "Alt+S"}, "description": "Open Shortcut Manager"}, "add-current-page": {"suggested_key": {"default": "Alt+A"}, "description": "Add current page to shortcuts"}}, "browser_specific_settings": {"gecko": {"id": "shortcut-manager@musrafkhan.com", "strict_min_version": "67.0", "data_collection_preferences": {"telemetry": false, "personalization": false}}}, "author": "Musraf Khan", "homepage_url": "https://22cy033.netlify.app/"}