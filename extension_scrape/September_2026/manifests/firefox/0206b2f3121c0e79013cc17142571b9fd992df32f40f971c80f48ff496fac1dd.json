{"manifest_version": 2, "name": "Volume Booster", "version": "1.0.0", "description": "Amplify the volume of any tab in your browser. Boost the audio output of videos, music, and other media content beyond the default limits.", "icons": {"48": "icons/volume-icon.svg", "96": "icons/volume-icon.svg"}, "permissions": ["storage", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Volume Booster", "default_icon": {"48": "icons/volume-icon.svg", "96": "icons/volume-icon.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@volume-booster-1000", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}