{"manifest_version": 3, "name": "Auto-Archive", "version": "0.1.2", "description": "Automatically opens news articles as their latest archive.ph snapshot. Auto-redirects an editable list of sites; manual archive/live-view controls in the extension menu.", "browser_specific_settings": {"gecko": {"id": "auto-archive@katmoda.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Auto-Archive", "default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options/options.html"}, "content_scripts": [{"matches": ["*://archive.ph/*", "*://archive.today/*", "*://archive.is/*", "*://archive.li/*", "*://archive.md/*", "*://archive.vn/*", "*://archive.fo/*"], "js": ["content/archive-detect.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}