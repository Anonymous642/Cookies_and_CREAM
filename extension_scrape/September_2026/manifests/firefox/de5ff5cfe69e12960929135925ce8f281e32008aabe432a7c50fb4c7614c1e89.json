{"manifest_version": 3, "name": "X Autofill", "version": "1.1.0", "description": "Click any field on any site, save a value for it once, and X Autofill fills it in automatically every time you return.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "X Autofill"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "x-autofill@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}