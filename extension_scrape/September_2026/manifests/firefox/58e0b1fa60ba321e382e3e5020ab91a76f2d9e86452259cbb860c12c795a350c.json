{"manifest_version": 2, "name": "AI Task Reminder", "description": "Reminds you when AI (ChatGPT, Gemini) finishes generating a response.", "version": "1.0.0", "icons": {"16": "/icon16.png", "48": "/icon48.png", "128": "/icon128.png"}, "permissions": ["storage", "notifications", "*://chatgpt.com/*", "*://gemini.google.com/*", "*://chat.openai.com/*"], "browser_specific_settings": {"gecko": {"id": "ai-task-reminder@charsama.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "AI Reminder Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://gemini.google.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}