{"manifest_version": 3, "name": "Business Finder (Google Places)", "version": "1.2.0", "description": "Find nearby businesses via Google Places API and export organized results.", "permissions": ["geolocation", "storage", "downloads", "tabs"], "host_permissions": ["https://maps.googleapis.com/*", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Business Finder"}, "browser_specific_settings": {"gecko": {"id": "businessfinder@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo", "searchTerms", "websiteContent"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}