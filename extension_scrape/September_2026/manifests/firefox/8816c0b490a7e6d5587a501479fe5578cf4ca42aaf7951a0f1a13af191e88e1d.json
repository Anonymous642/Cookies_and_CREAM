{"manifest_version": 3, "name": "Just Track 'Em All", "version": "1.1.4", "description": "Mostra se un prodotto Amazon \u00e8 tracciato su Just Track 'Em All e il suo limite di prezzo.", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.amazon.it/*", "https://www.amazon.fr/*", "https://www.amazon.es/*", "https://www.amazon.de/*", "https://raw.githubusercontent.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.amazon.it/*", "https://www.amazon.fr/*", "https://www.amazon.es/*", "https://www.amazon.de/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icon48.png"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "trackemall@justtrack.it"}}}