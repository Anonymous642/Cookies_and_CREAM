{"manifest_version": 3, "name": "EzRecruit Autofill", "version": "0.1.0", "description": "One-click autofill of candidate details into client ATS forms (Workday) from EzRecruit.", "browser_specific_settings": {"gecko": {"id": "ezrecruit-autofill@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.myworkday.com/*", "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.workday.com/*", "https://*.recruit-easy.ai/*", "https://theglove.ezrecruit.ai/*", "https://*.ezrecruit.ai/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.myworkday.com/*", "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.workday.com/*"], "js": ["content/content.js", "content/float-panel.js"], "run_at": "document_idle"}, {"matches": ["https://*.recruit-easy.ai/*", "https://theglove.ezrecruit.ai/*", "https://*.ezrecruit.ai/*"], "js": ["content/ezrecruit.js", "content/float-panel.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/*", "icons/*"], "matches": ["https://*.myworkday.com/*", "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.workday.com/*", "https://*.recruit-easy.ai/*", "https://theglove.ezrecruit.ai/*", "https://*.ezrecruit.ai/*"]}]}