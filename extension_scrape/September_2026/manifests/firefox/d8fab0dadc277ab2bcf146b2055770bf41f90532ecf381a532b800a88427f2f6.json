{"manifest_version": 2, "name": "Sanctuar", "description": "A secure, privacy-focused local vault for managing and organizing your browser bookmarks.", "version": "0.9.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "<all_urls>"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';", "browser_specific_settings": {"chrome": {"id": "@sanctuar"}, "gecko": {"id": "@sanctuar", "data_collection_permissions": {"required": ["none"]}}, "edge": {"id": "@sanctuar"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Secure Bookmarks Vault", "default_popup": "popup.html"}}