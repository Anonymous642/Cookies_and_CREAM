{"manifest_version": 3, "name": "YouTube Channel Filter", "version": "1.9.0", "description": "Hide recommendations from channels you choose on YouTube.", "permissions": ["storage", "tabs"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"], "action": {"default_title": "YouTube Channel Filter", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"], "js": ["identity.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-channel-filter@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}