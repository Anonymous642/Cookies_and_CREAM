{"manifest_version": 2, "name": "YouTube Cuota", "version": "2.3.0", "description": "Control inteligente de tu consumo de YouTube.", "browser_specific_settings": {"gecko": {"id": "youtube-cuota@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "alarms", "webRequest", "webRequestBlocking", "tabs", "*://www.youtube.com/*", "*://youtube.com/*", "*://www.googleapis.com/*"], "background": {"scripts": ["core/storage.js", "core/youtube-api.js", "core/quota-engine.js", "core/discovery-engine.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["core/storage.js", "core/quota-engine.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon.svg"}, "default_title": "YouTube Cuota"}, "web_accessible_resources": ["dashboard/*", "pages/*", "core/*", "icons/*"]}