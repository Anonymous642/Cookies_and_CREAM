{"manifest_version": 3, "name": "Dual Subtitles for Netflix", "version": "0.1.1", "description": "Stack a second subtitle language over Netflix with custom styling. Not affiliated with Netflix.", "browser_specific_settings": {"gecko": {"id": "dual-subtitles-netflix@addons.mozilla.org", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["storage"], "host_permissions": ["*://*.netflix.com/*"], "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["parser.js", "content.js"], "css": ["overlay.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Dual Subtitles for Netflix", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}}