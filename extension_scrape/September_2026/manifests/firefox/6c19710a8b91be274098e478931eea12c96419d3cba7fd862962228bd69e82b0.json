{"manifest_version": 2, "name": "Knowledge Retention Predictor", "version": "1.3", "description": "Predicts long-term knowledge retention based on browsing and learning behavior.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "background": {"scripts": ["predictorEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Knowledge Retention Predictor"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Knowledge-Retention-Predictor", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}