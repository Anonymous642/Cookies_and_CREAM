{"manifest_version": 3, "name": "ScoutWise - AI Shopping Assistant", "version": "1.1.0", "description": "Opinionated AI shopping assistant that answers 'Should I buy this, and if not, what should I buy instead?'", "browser_specific_settings": {"gecko": {"id": "scoutwise@hasimax.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://scoutwise.hasimax.com;"}, "background": {"scripts": ["assets/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_title": "ScoutWise Shopping Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "sidepanel/index.html", "default_title": "ScoutWise Shopping Assistant", "default_icon": "icons/icon48.png"}, "web_accessible_resources": [{"resources": ["sidepanel/index.html", "icons/icon16.png", "icons/icon48.png", "icons/icon128.png", "assets/sidepanel.js", "assets/*.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}