{"manifest_version": 2, "name": "Deepseek", "version": "1.2.1", "description": "Sidebar button to open your chosen URL. Includes header rewrite so Deepseek loads in the sidebar. Now with icons.", "applications": {"gecko": {"id": "deepseek-sidebar@example.com", "strict_min_version": "106.0"}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_title": "Deepseek", "default_panel": "sidebar.html", "open_at_install": true}, "browser_action": {"default_title": "Deepseek", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}}