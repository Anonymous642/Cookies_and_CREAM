{"manifest_version": 2, "name": "AnchorNotes \u2014 Notes for Any Web App", "version": "5.0.0", "description": "Personal and admin-managed notes on any web form field. Zero layout impact.", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-anchornotes": {"suggested_key": {"default": "Alt+N"}, "description": "AnchorNotes ein/ausschalten"}}, "browser_specific_settings": {"gecko": {"id": "anchornotes@myanchornotes.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "authenticationInfo"]}}}}