{"manifest_version": 3, "name": "Twitch Ad Blocker", "version": "1.0.2", "browser_specific_settings": {"gecko": {"id": "twitch-ad-blocker@masterhaxs", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "This blocks ads and auto claims bonus chest on Twitch. Build by MasterHaxs.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://*.twitch.tv/*", "https://twitch.tv/*"], "declarative_net_request": {"rule_resources": [{"id": "twitch_ads", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["https://*.twitch.tv/*", "https://twitch.tv/*"], "js": ["inject.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page.js"], "matches": ["https://*.twitch.tv/*", "https://twitch.tv/*"]}], "action": {"default_popup": "popup.html", "default_title": "Twitch Ad Blocker", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}}