{"manifest_version": 3, "name": "Multi Copy Paste", "version": "1.0.0", "description": "Copiez plusieurs \u00e9l\u00e9ments et collez-les en une seule fois", "browser_specific_settings": {"gecko": {"id": "multi-copy-paste@example.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "activeTab", "clipboardWrite", "clipboardRead"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Multi Copy Paste"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"add-to-clipboard": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Ajouter la s\u00e9lection \u00e0 la liste de copie"}, "paste-all": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Coller tous les \u00e9l\u00e9ments copi\u00e9s"}}}