{"manifest_version": 3, "name": "BeYourself - Cognitive Firewall", "version": "1.0", "description": "Analyse locale du contenu web via IA.", "author": "Sankwak", "browser_specific_settings": {"gecko": {"id": "beyourself@sankwak.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}