{"manifest_version": 2, "name": "PATER - Focus Guardian", "version": "0.7.9.1", "description": "Meta-iterative distraction blocker by Freedom Academy", "author": "Freedom Academy <mail@freedomacademy.app>", "homepage_url": "https://www.freedomacademy.app", "permissions": ["tabs", "webNavigation", "webRequest", "webRequestBlocking", "storage", "alarms", "nativeMessaging", "declarativeNetRequest", "contextMenus", "<all_urls>"], "incognito": "spanning", "commands": {"save-session": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current tabs as a session"}, "restore-session": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Restore the last saved session"}, "toggle-blocking": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle blocking on/off"}, "quick-block-url": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Add current site to blocklist"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "web_accessible_resources": ["blocked.html", "blocked.css", "blocked.js", "i18n.js", "icons/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pater@freedomacademy.app", "strict_min_version": "136.0", "data_collection_permissions": {"required": ["none"]}}}}