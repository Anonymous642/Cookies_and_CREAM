{"manifest_version": 2, "name": "Cloudflare Cache Purger", "version": "1.3", "description": "Purge Cloudflare cache for current page", "permissions": ["storage", "activeTab", "https://api.cloudflare.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}], "browser_action": {"default_popup": "popup.html", "default_title": "CF Cache Purger"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "cf-cache-purger@srpc.com", "data_collection_permissions": {"required": ["none"]}}}}