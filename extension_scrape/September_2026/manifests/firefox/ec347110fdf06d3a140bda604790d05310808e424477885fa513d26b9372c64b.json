{"manifest_version": 3, "name": "SearchMaster", "version": "1.0", "description": "Compare results from different search engines side-by-side", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "searchmaster@example.com"}}, "permissions": ["storage", "tabs", "webRequest"], "host_permissions": ["*://*.google.com/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}