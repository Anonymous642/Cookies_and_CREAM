{"manifest_version": 3, "name": "NYMIQ \u2013 Protection de vos informations", "version": "2.8.3", "description": "NYMIQ vous aide \u00e0 utiliser une adresse email prot\u00e9g\u00e9e, un num\u00e9ro prot\u00e9g\u00e9 et des informations adapt\u00e9es lorsque vous remplissez des formulaires en ligne. Compatible avec Firefox sur ordinateur et Android.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "NYMIQ \u2013 Prot\u00e9ger mes informations", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "browser-shield@nymiq.fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "homepage_url": "https://nymiq.fr/"}