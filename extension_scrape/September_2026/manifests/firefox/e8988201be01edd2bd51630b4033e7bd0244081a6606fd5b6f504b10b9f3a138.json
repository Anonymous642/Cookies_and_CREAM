{"manifest_version": 3, "name": "Mahiru GIF Extension", "version": "1.0", "description": "Copy GIFs from gif.mahiru.fr and share them easily on Discord.", "browser_specific_settings": {"gecko": {"id": "gif-mahiru-extension@mahiru.fr", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://gif.mahiru.fr/*", "https://discord.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "css": ["content.css"]}]}