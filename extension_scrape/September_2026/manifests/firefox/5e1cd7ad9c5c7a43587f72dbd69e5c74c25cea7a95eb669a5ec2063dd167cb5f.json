{"manifest_version": 2, "name": "Tab Anchor", "version": "2.1", "description": "Persistent Tab Renamer. Based on RTT. Privacy-first: no data collection. https://github.com/svyatoslavpodolskii/TabAnchor/blob/main/PRIVACY.md", "author": "Svyatoslav Podolskiy", "homepage_url": "https://github.com/svyatoslavpodolskii/TabAnchor", "permissions": ["activeTab", "tabs", "menus", "storage", "<all_urls>", "sessions"], "icons": {"48": "icon.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["tab_anchor.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "tabanchor@svyatoslavpodolskii.com", "data_collection_permissions": {"required": ["none"]}}}}