{"manifest_version": 2, "name": "djset-webtools", "description": "YouTube \u2194 1001tracklists integration for DJ set listeners", "version": "0.4.0", "icons": {"16": "icon/16-dark.png", "32": "icon/32-dark.png", "48": "icon/48-dark.png", "96": "icon/96-dark.png", "128": "icon/128-dark.png"}, "permissions": ["storage", "https://www.youtube.com/*", "https://www.1001tracklists.com/*"], "web_accessible_resources": ["icon/*"], "browser_specific_settings": {"gecko": {"id": "@djw.smol.tech", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://www.1001tracklists.com/tracklist/*"], "run_at": "document_idle", "js": ["content-scripts/tracklists.js"]}, {"matches": ["*://www.youtube.com/watch*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}], "browser_action": {"default_icon": {"16": "icon/16-dark.png", "32": "icon/32-dark.png", "48": "icon/48-dark.png", "128": "icon/128-dark.png"}}}