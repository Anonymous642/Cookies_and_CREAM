{"manifest_version": 3, "name": "ScreenCapture", "version": "1.0.0", "description": "Simple screenshot tool. Capture visible area of current tab and download as PNG image.", "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "action": {"default_icon": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}, "default_title": "ScreenCapture", "default_popup": "interface/cap.html"}, "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "screencapture@screenshot.tool", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}