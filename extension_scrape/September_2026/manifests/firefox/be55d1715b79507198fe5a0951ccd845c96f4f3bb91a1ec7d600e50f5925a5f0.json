{"manifest_version": 3, "name": "Rank-O-Saur - SEO Extension", "version": "4.4", "default_locale": "en", "description": "Your all-in-one SEO browser extension for content, language, crawling, indexing, links, ai search and structured data.", "browser_specific_settings": {"gecko": {"id": "rankosaur@rankosaur.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["searchTerms"]}}}, "background": {"scripts": ["compat.js", "background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "sidebar_action": {"default_title": "Rank-O-Saur", "default_panel": "popup.html?mode=sidebar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "open_at_install": false}, "permissions": ["tabs", "scripting", "storage", "clipboardWrite", "webRequest", "webRequestBlocking", "webNavigation", "contextMenus", "unlimitedStorage"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*.google.com/search*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "compat.js", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Open Rankosaur"}, "toggle-js": {"suggested_key": {"default": "Alt+J", "mac": "Alt+J"}, "description": "Toggle JavaScript On/Off"}}}