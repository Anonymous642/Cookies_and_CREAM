{"manifest_version": 3, "name": "HideMyBrowser", "version": "1.4", "description": "Hide your browser and OS. Pick any popular browser; HideMyBrowser rewrites the HTTP User-Agent and the JavaScript navigator so sites cannot detect your real setup. Turn it off and it does nothing at all.", "browser_specific_settings": {"gecko": {"id": "hidemybrowser@local.addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["profiles.js", "background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "action": {"default_title": "HideMyBrowser", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}