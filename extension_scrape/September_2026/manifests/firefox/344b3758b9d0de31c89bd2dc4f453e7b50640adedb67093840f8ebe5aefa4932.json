{"manifest_version": 3, "name": "Teletabby", "version": "0.1.0", "description": "Opens video-conferencing links in a window that fills the screen you choose, instead of wherever you happen to be browsing.", "homepage_url": "https://tangled.org/robin.berjon.com/teletabby", "browser_specific_settings": {"gecko": {"id": "teletabby@berjon.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "webNavigation"], "background": {"scripts": ["common.js", "background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Teletabby settings", "default_icon": "icons/teletabby.svg"}, "icons": {"48": "icons/teletabby.svg", "96": "icons/teletabby.svg"}}