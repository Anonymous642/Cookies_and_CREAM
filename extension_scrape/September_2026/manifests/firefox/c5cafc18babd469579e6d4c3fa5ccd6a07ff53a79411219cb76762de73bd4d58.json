{"manifest_version": 3, "name": "IDInfo \u2014 Social Profile ID Lookup", "short_name": "IDInfo", "version": "1.1.1", "description": "Click the IDInfo icon on any supported social profile to open its numeric ID page on idinfo.ws \u2014 Facebook, Instagram, X, TikTok, YouTube, GitHub, Threads, and Telegram.", "author": "IDInfo (idinfo.ws)", "homepage_url": "https://idinfo.ws", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Open this profile on IDInfo (idinfo.ws)", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "permissions": ["activeTab", "tabs"], "browser_specific_settings": {"gecko": {"id": "idinfo@idinfo.ws", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}