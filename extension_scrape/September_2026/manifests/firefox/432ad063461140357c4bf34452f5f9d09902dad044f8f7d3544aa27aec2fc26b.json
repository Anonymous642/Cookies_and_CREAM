{"manifest_version": 2, "name": "Reddit Summarizer", "description": "Inject a floating control on Reddit threads, summarize visible content, and reopen the matching ChatGPT conversation.", "version": "0.1.0", "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage", "*://*.reddit.com/*", "*://chat.openai.com/*", "*://chatgpt.com/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "{b47bbe7f-cd04-4cb1-adb5-221403651de5}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Reddit Summarizer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"], "run_at": "document_idle", "js": ["content-scripts/chatgpt.js"]}, {"matches": ["*://*.reddit.com/*"], "run_at": "document_idle", "js": ["content-scripts/reddit.js"]}]}