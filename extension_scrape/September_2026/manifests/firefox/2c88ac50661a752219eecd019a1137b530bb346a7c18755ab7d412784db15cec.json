{"manifest_version": 3, "name": "LonelyPass", "version": "1.0", "description": "Generate deterministic secure passwords based on master password and security questions.", "action": {"default_popup": "guide.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["libs/tldts.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "lonelypass@example.com", "strict_min_version": "109.0"}}}