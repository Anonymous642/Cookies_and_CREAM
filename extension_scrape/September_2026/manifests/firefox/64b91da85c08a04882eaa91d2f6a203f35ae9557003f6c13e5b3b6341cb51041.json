{"manifest_version": 3, "name": "TDGR Bandai Connect", "version": "1.1.5", "description": "Links your Bandai TCG+ account to TDGR (tdgr.org) and imports your exburst.dev collection and decklists.", "permissions": ["storage"], "host_permissions": ["https://www.bandai-tcg-plus.com/*", "https://tdgr.org/*", "https://www.tdgr.org/*", "https://exburst.dev/*", "https://*.exburst.dev/*"], "browser_specific_settings": {"gecko": {"id": "bandai-connect@tdgr.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "TDGR Bandai Connect"}, "content_scripts": [{"matches": ["https://www.bandai-tcg-plus.com/*"], "js": ["content-bandai.js"], "run_at": "document_idle"}, {"matches": ["https://tdgr.org/*", "https://www.tdgr.org/*"], "js": ["content-tdgr.js"], "run_at": "document_idle"}, {"matches": ["https://exburst.dev/*", "https://*.exburst.dev/*"], "js": ["content-exburst-page.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://exburst.dev/*", "https://*.exburst.dev/*"], "js": ["content-exburst.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}