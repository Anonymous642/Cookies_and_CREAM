{"manifest_version": 3, "name": "Compendro", "version": "1.0.11", "description": "Save pages to your Compendro reading queue", "permissions": ["activeTab", "contextMenus", "notifications", "storage", "scripting"], "optional_host_permissions": ["https://app.compendro.com/*"], "content_scripts": [{"matches": ["https://app.compendro.com/extension-auth*"], "js": ["content-handoff.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "action": {"default_icon": "icons/icon-48.png", "default_title": "Save to Compendro"}, "options_page": "options.html", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@compendro.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"], "optional": []}}}}