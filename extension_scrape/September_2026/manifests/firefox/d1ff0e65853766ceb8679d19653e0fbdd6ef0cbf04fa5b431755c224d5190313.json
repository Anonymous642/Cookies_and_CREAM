{"manifest_version": 2, "name": "FxPeek - Currency Converter | Bank Rates", "description": "Automatically detect and convert prices on any webpage with an instant hover tooltip and built-in converter.", "version": "1.0.6", "short_name": "FxPeek", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "activeTab", "scripting", "search", "menus", "https://api.getfxpeek.com/*", "https://getfxpeek.com/*", "https://www.getfxpeek.com/*"], "optional_permissions": ["notifications", "http://*/*", "https://*/*", "https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*"], "browser_specific_settings": {"gecko": {"id": "fxpeek@getfxpeek.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle FxPeek on/off"}, "cycle-target": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Cycle primary target currency"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "FxPeek", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://getfxpeek.com/pro/success*", "https://www.getfxpeek.com/pro/success*"], "run_at": "document_idle", "js": ["content-scripts/pro-success.js"]}], "content_security_policy": "script-src 'self'; object-src 'self'"}