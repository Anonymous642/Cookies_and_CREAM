{"manifest_version": 3, "name": "Django DevBar", "version": "1.4.2", "description": "View Django DevBar metrics in browser DevTools: database queries, response times, and duplicate queries.", "homepage_url": "https://github.com/amureki/django-devbar", "devtools_page": "devtools.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "django-devbar@amureki.me", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}