{"manifest_version": 3, "name": "Berlin Kulturaggregator", "version": "1.4.6", "description": "Zeigt auf Abruf Ausstellungen, klassische Konzerte und Kinofilme in Berlin f\u00fcr die n\u00e4chsten 4 Wochen, inkl. Ticketlinks.", "action": {"default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}}, "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["alarms", "storage"], "host_permissions": ["https://www.visitberlin.de/*", "https://www.berlin.de/*", "https://www.songkick.com/*"], "background": {"scripts": ["background.js"], "type": "classic"}, "browser_specific_settings": {"gecko": {"id": "berlin-kulturaggregator@example.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}}