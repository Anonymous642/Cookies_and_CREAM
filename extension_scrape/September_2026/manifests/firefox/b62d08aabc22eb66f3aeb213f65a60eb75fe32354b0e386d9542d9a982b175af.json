{"manifest_version": 2, "name": "FocusGuard", "version": "5.0", "description": "Block doomscrolling with advanced controls", "browser_specific_settings": {"gecko": {"id": "vistahista1@gmail.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "tabs", "alarms", "scripting", "activeTab", "*://*/*"], "background": {"page": "background.html"}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "DoomScroll Blocker"}, "options_page": "options/options.html", "web_accessible_resources": ["lib/chart.js"], "icons": {"48": "icon48.png", "128": "icon128.png"}, "content_security_policy": "script-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; object-src 'self'"}