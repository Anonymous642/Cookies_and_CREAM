{"manifest_version": 2, "name": "Total Recall", "version": "1.1.0", "description": "Private web memory that saves pages you actually read, with full-text search and offline reader.", "permissions": ["storage", "unlimitedStorage"], "omnibox": {"keyword": "r"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "total-recall@nicepkg.dev", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}}