{"manifest_version": 2, "name": "Butter", "version": "1.7.0", "description": "Smooth, private, yours. Blocks ads and trackers, hardens Firefox, sleeps idle tabs. Zero telemetry. Add \"Butter Home\" for the matching new tab page.", "author": "Butter", "browser_specific_settings": {"gecko": {"id": "{9b4e2c5a-6f1d-4a3e-9c0b-2f7d8e1a5b3c}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/butter-16.png", "32": "icons/butter-32.png", "48": "icons/butter-48.png", "96": "icons/butter-96.png", "128": "icons/butter-128.png"}, "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "webNavigation", "tabs", "storage", "unlimitedStorage", "privacy", "dns", "alarms"], "background": {"page": "background/background.html", "persistent": true}, "browser_action": {"default_icon": {"16": "icons/butter-16.png", "32": "icons/butter-32.png", "48": "icons/butter-48.png"}, "default_title": "Butter", "default_popup": "popup/popup.html", "browser_style": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true, "browser_style": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/cosmetic.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/cookies.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Open Butter"}, "sleep-other-tabs": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Put all other tabs to sleep"}, "toggle-site": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause / resume Butter on this site"}}}