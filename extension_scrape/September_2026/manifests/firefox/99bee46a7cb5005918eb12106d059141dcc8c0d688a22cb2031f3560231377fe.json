{"name": "Markdown Clipboard", "version": "0.2.1", "description": "Convert HTML on your clipboard or on a page to Markdown with one click. Formats lists, links, images, and selections.", "manifest_version": 3, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Convert clipboard HTML to Markdown"}, "commands": {"copy-selection-as-md": {"description": "Copy selection as Markdown"}, "convert-clipboard-as-md": {"description": "Convert clipboard HTML to Markdown"}}, "permissions": ["contextMenus", "activeTab", "scripting", "clipboardRead", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "markdown-clipboard@ckaeser.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}