{"manifest_version": 2, "name": "Fancy names", "description": "An extension to add fancy name effects for Twitch", "version": "0.1.2", "icons": {"16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png", "256": "icon-256.png"}, "browser_specific_settings": {"gecko": {"id": "fancy-names@owochle.app", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}], "permissions": ["https://fancynames.owochle.app/*"]}