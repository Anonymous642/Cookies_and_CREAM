{"manifest_version": 3, "name": "GetTimetracker Add-on", "version": "0.1.2", "description": "Start and stop time logs.", "permissions": ["storage", "tabs", "alarms"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "host_permissions": ["https://app.gettimetracker.app/*", "https://api.gettimetracker.app/*"], "action": {"default_title": "GetTimetracker", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "192": "icons/icon-192.png"}}, "content_scripts": [{"matches": ["https://app.gettimetracker.app/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page_bridge.js"], "matches": ["https://app.gettimetracker.app/*"]}], "browser_specific_settings": {"gecko": {"id": "gettimetracker@gettimetracker.app", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "192": "icons/icon-192.png"}}