{"manifest_version": 2, "name": "PageMind AI", "version": "1.0.0", "description": "Reads questions on any page, deep web-searches them, and delivers AI-powered answers instantly.", "author": "PageMind AI", "browser_specific_settings": {"gecko": {"id": "@pagemind-ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "PageMind AI"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "PageMind AI", "default_icon": {"48": "icons/icon48.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open PageMind AI Sidebar"}}}