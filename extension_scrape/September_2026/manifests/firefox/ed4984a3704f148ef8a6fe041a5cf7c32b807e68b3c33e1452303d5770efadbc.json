{"manifest_version": 3, "name": "AI Context Sync", "description": "Stores reusable text snippets in the browser and inserts a selected snippet into the chat input of supported AI assistant websites when the user presses a keyboard shortcut.", "version": "0.1.0", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "permissions": ["storage", "clipboardWrite", "scripting"], "optional_host_permissions": ["https://*/*"], "commands": {"open-picker": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the snippet picker"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"}, "web_accessible_resources": [{"resources": ["picker-loader.js"], "matches": ["https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "ai-context-sync@thinkdare.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}