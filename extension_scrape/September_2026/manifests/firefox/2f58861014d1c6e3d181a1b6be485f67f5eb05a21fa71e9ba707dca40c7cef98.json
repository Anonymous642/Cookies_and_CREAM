{"manifest_version": 3, "name": "Clever Checker", "version": "0.3.4", "description": "Check grammar, AI writing, plagiarism and readability, or rewrite text, on any page. Results from cleverchecker.com.", "permissions": ["contextMenus", "storage", "activeTab", "scripting", "clipboardRead", "clipboardWrite"], "action": {"default_title": "Clever Checker"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"scripts": ["compat.js", "config.js", "selection.js", "api.js", "background.js"]}, "sidebar_action": {"default_panel": "panel.html", "default_title": "Clever Checker", "default_icon": "assets/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "cleverchecker@cleverchecker.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "host_permissions": ["https://cleverchecker.com/*"], "homepage_url": "https://cleverchecker.com"}