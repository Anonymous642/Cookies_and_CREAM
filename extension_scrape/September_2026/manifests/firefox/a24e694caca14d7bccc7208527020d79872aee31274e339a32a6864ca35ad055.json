{"manifest_version": 2, "name": "Learning Velocity Tracker", "version": "1.3", "description": "Measures learning velocity during browsing sessions and provides productivity insights.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "background": {"scripts": ["velocityEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "browser_action": {"default_popup": "popup.html", "default_title": "Learning Velocity Tracker"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Learning-Velocity-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}