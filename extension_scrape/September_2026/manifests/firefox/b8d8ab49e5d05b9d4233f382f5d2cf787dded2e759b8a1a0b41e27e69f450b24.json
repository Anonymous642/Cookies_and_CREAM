{"manifest_version": 3, "name": "The Nag", "version": "1.0.0", "description": "Stop multitasking. One task at a time with timed sub-steps and post-task reflection.", "browser_specific_settings": {"gecko": {"id": "the-nag@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "alarms", "notifications", "tabs"], "background": {"scripts": ["service-worker.js"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}