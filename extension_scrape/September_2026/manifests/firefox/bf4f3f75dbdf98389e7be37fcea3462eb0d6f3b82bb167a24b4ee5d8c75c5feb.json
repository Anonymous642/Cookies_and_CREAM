{"manifest_version": 3, "name": "ccCraft", "version": "1.7.5", "description": "AI-crafted YouTube subtitles: extract captions and translate them into any language with Gemini, GPT or NVIDIA NIM.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://*.youtube.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://integrate.api.nvidia.com/*", "https://translate.googleapis.com/*", "https://translate.google.com/*", "https://dashscope-intl.aliyuncs.com/*", "https://dashscope.aliyuncs.com/*"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"]}, "action": {"default_title": "ccCraft", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/inject-main.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/content.js"], "css": ["src/overlay.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "cccraft@longhairbewareofthecrows.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}}