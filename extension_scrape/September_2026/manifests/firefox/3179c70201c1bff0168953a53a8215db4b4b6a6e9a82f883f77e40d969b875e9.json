{"manifest_version": 3, "name": "PDF Merge - Combine Files Locally", "short_name": "PDF Merge", "version": "1.0.0", "description": "Merge PDF files entirely in your browser. No account, no upload, no cloud - your files never leave your device.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "background.js", "scripts": ["vendor/ExtPay.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "pdf-merge@quoray.com", "data_collection_permissions": {"required": ["financialAndPaymentInfo"]}}}}