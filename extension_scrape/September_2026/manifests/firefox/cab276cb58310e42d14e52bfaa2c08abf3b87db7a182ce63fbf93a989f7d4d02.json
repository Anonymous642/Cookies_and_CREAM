{"manifest_version": 2, "name": "SubMute \u2014 Toolbar Mute", "short_name": "SubMute Toolbar", "version": "1.3.2", "description": "Top-right toolbar to mute the subreddit of the post under your cursor. Draggable fixed-size box with popup to manage muted subs.", "permissions": ["storage", "tabs", "*://*.reddit.com/*"], "browser_specific_settings": {"gecko": {"id": "submute@suds.v2"}}, "browser_action": {"default_title": "SubMute", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}