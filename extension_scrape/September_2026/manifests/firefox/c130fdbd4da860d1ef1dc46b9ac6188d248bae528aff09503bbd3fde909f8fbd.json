{"manifest_version": 3, "name": "WASA - WA SuperApp", "short_name": "WASA", "version": "2.0.0", "description": "Bulk message sender for WhatsApp Web. Type contacts in CSV format, compose your message with [nama] variable, and blast away with randomized delays.", "browser_specific_settings": {"gecko": {"id": "wasa@firefox.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "activeTab", "storage", "scripting", "downloads"], "host_permissions": ["*://web.whatsapp.com/*"], "content_scripts": [{"matches": ["*://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "WASA", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["license.js", "background.js"]}, "web_accessible_resources": [{"resources": ["lib/wa-js.js", "wpp-bridge.js"], "matches": ["*://web.whatsapp.com/*"]}]}