{"manifest_version": 3, "name": "TrueLayr - Extension", "version": "1.0.0", "description": "Capture any live or staging page and send to TrueLayr desktop.", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "512": "icons/icon512.png"}, "browser_specific_settings": {"gecko": {"id": "truelayr@truelayr.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}