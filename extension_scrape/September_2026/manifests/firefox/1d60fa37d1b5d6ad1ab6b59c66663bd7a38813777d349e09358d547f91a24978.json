{"manifest_version": 2, "name": "Link tracer", "version": "2.0.0", "description": "Simple extension that tracks which links open your links", "permissions": ["storage", "tabs", "webNavigation", "unlimitedStorage"], "browser_specific_settings": {"gecko": {"id": "@link-tracer", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity"], "optional": []}}}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Open link history"}}