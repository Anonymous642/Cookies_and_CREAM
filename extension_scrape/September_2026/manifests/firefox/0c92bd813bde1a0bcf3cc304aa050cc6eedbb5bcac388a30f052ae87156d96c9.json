{"manifest_version": 2, "name": "Selection Helper Sidebar", "version": "1.0", "description": "Send selected text to an assistant service and show responses in a sidebar or popup.", "permissions": ["storage", "activeTab", "tabs", "contextMenus", "https://api.openai.com/*"], "background": {"scripts": ["src/common/browser-shim.js", "src/common/defaults.js", "src/background/background.js"], "persistent": false}, "sidebar_action": {"default_title": "Selection Helper", "default_panel": "src/ui/sidebar/sidebar.html", "default_icon": {"16": "assets/icons/helper-16.png", "32": "assets/icons/helper-32.png"}}, "browser_action": {"default_title": "Selection Helper", "default_popup": "src/ui/popup/popup.html", "default_icon": {"16": "assets/icons/helper-16.png", "32": "assets/icons/helper-32.png"}}, "icons": {"16": "assets/icons/helper-16.png", "32": "assets/icons/helper-32.png", "48": "assets/icons/helper-48.png", "96": "assets/icons/helper-96.png", "128": "assets/icons/helper-128.png"}, "options_ui": {"page": "src/ui/options/options.html", "browser_style": true, "open_in_tab": true}, "commands": {"run-openai-on-selection": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Command+Shift+M"}, "description": "Send selected text to the helper"}, "toggle-auto-trigger": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle automatic sending"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/common/browser-shim.js", "src/content/contentScript.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "browser_specific_settings": {"gecko": {"id": "addons-mozilla@javan.de", "data_collection_permissions": {"required": ["none"], "optional": []}}}}