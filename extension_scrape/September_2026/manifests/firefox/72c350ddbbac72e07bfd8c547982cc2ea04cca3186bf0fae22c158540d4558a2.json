{"manifest_version": 3, "name": "Swisscows.VPN", "description": "This browser extension simplifies access to the Swisscows VPN server.", "version": "2.0.8", "icons": {"16": "favicon-16.png", "32": "favicon-32.png", "48": "favicon-48.png", "128": "favicon-128.png"}, "action": {"default_icon": {"16": "favicon-16.png", "32": "favicon-32.png"}, "default_title": "Swisscows VPN", "default_popup": "popup.html"}, "permissions": ["identity", "proxy", "storage", "webRequest", "webRequestAuthProvider"], "host_permissions": ["<all_urls>"], "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "swisscows.vpn@swisscows.ch", "strict_min_version": "91.1.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}}