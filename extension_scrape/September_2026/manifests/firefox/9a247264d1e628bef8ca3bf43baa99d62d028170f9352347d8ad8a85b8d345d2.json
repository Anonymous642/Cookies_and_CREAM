{"manifest_version": 3, "name": "Clickable Channels for YouTube", "short_name": "Clickable Channels", "description": "Makes channel names clickable on YouTube video lists, playlists, and optional live stream chat.", "version": "1.3.7", "author": "Clickable Channels for YouTube", "homepage_url": "https://github.com/your-org/clickable-channels-for-youtube", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "clickable-channels-for-youtube@addons.example", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Clickable Channels for YouTube", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}