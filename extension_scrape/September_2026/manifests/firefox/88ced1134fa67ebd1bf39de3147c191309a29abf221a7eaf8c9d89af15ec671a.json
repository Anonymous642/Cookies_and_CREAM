{"manifest_version": 2, "name": "History Puzzle", "version": "1.0", "description": "Turns recent visited sites into a jigsaw-like puzzle using site favicons or snapshots.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["history", "tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "History Puzzle", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "historypuzzle@example.com"}}}