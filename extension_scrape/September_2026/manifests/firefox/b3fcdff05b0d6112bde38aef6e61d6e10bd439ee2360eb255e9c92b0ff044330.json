{"manifest_version": 2, "name": "DS4 Prompt Partner", "version": "1.0.3", "description": "One-click prompt mode injection for DeepSeek V4 (flash 1730) \u2014 analysis, roleplay, socratic, code-only and more. Reduces prompt fatigue with slash-commands, hotkeys, context menus and auto-detect.", "permissions": ["activeTab", "storage", "contextMenus", "clipboardWrite", "https://chat.deepseek.com/*"], "browser_specific_settings": {"gecko": {"id": "ds4-prompt-partner@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["default-modes.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://chat.deepseek.com/*"], "js": ["default-modes.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_popup": "popup.html", "default_title": "DS4 Prompt Partner", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"insert-last-used-mode": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Insert the last-used mode's prompt block"}, "cycle-modes": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Cycle to the next mode and insert it"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}