{"manifest_version": 2, "name": "Thought Dependency Mapper", "version": "1.3", "description": "A Firefox extension to map, visualize, and analyze dependencies between thoughts, notes, and ideas.", "browser_action": {"default_icon": "icons/logo_64.png", "default_title": "Thought Dependency Mapper", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "storage", "notifications", "contextMenus"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Thought-Dependency-Mapper", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}