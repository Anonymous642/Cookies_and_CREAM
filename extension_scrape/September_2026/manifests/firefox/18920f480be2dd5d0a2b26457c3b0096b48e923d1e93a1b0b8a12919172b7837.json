{"manifest_version": 3, "name": "ExplainTheVid", "version": "1.0.6", "description": "Explain YouTube videos with AI - generate chapters and chat about video content", "browser_specific_settings": {"gecko": {"id": "explainvid@explainthe.vid", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icon.ico", "48": "icon.ico", "128": "icon.ico"}, "permissions": ["storage", "activeTab", "tabs", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open Explain the Vid"}, "sidebar_action": {"default_title": "ExplainTheVid", "default_panel": "src/sidebar/index.html", "default_icon": "icon.ico"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}