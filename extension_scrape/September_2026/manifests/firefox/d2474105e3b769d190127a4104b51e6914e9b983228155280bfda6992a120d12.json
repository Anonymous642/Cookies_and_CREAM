{"manifest_version": 2, "name": "YouTube to Gemini", "version": "1.0.2", "description": "Adds a button to the corner of every YouTube thumbnail that sends that video's link straight to Gemini.", "browser_specific_settings": {"gecko": {"id": "yt-to-gemini@alex.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "clipboardWrite"], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://m.youtube.com/*", "*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content/youtube.js"], "css": ["content/youtube.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://gemini.google.com/*"], "js": ["content/gemini.js"], "run_at": "document_idle"}]}