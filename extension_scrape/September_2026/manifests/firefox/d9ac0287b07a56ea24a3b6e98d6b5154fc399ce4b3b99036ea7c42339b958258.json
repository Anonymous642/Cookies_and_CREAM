{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "toledo-pdf-viewer@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "name": "Toledo Ultra PDF viewer", "version": "1.0", "description": "Easily open PDF files on Toledo in a new tab with one click \u2014 no need to download first.", "content_scripts": [{"matches": ["https://ultra.edu.kuleuven.cloud/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["images/pdflogo.svg"], "matches": ["https://ultra.edu.kuleuven.cloud/*"]}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Toledo Ultra PDF viewer", "default_popup": "popup.html", "default_icon": {"16": "images/pdflogo16.png", "48": "images/pdflogo48.png", "128": "images/pdflogo128.png"}}, "permissions": ["storage", "tabs"], "icons": {"16": "images/pdflogo16.png", "48": "images/pdflogo48.png", "128": "images/pdflogo128.png"}}