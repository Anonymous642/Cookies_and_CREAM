{"manifest_version": 3, "name": "TabStash", "version": "1.10.9", "description": "Stash open tabs into one page. Encrypted local storage; optional portable encrypted vault via native tool. Icon badge shows tool status.", "browser_specific_settings": {"gecko": {"id": "tabstash-firefox@silverrabbit.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "storage", "unlimitedStorage", "nativeMessaging", "alarms", "menus"], "action": {"default_title": "Stash all tabs"}, "background": {"scripts": ["vault-store.js", "background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "incognito": "spanning"}