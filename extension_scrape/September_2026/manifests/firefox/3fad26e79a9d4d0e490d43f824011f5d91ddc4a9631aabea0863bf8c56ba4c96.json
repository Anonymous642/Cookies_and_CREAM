{"manifest_version": 3, "name": "SPQ GST Automation", "version": "0.54.0", "description": "Automates GST portal login, navigation and report downloads, driven by the SPQ desktop app and web app.", "background": {"service_worker": "background/service_worker.js", "scripts": ["background/service_worker.js"], "type": "module"}, "permissions": ["storage", "tabs", "alarms", "cookies", "downloads", "declarativeNetRequestWithHostAccess", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"}, "host_permissions": ["https://*.gst.gov.in/*", "https://www.gst.gov.in/*", "https://services.gst.gov.in/*", "https://return.gst.gov.in/*", "https://payment.gst.gov.in/*", "https://reg.gst.gov.in/*", "https://refund.gst.gov.in/*", "https://statement.gst.gov.in/*", "http://localhost:5200/*", "https://localhost:7000/*", "https://localhost:7010/*", "http://localhost:6162/*", "https://localhost:6162/*", "https://rack.speqtagst.com/*", "https://gstr2b.gst.gov.in/*", "https://gstr1a.gst.gov.in/*", "https://returns2.gst.gov.in/*"], "content_scripts": [{"matches": ["https://www.gst.gov.in/*", "https://services.gst.gov.in/*", "https://return.gst.gov.in/*", "https://payment.gst.gov.in/*", "https://reg.gst.gov.in/*", "https://refund.gst.gov.in/*", "https://statement.gst.gov.in/*"], "js": ["content-scripts/gst-portal.js"], "run_at": "document_start"}, {"matches": ["https://services.gst.gov.in/*", "https://return.gst.gov.in/*"], "css": ["content-scripts/download-panel.css"], "js": ["content-scripts/download-panel.js"], "run_at": "document_idle"}, {"matches": ["https://services.gst.gov.in/*", "https://return.gst.gov.in/*"], "js": ["content-scripts/move-main.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/blazor-bridge.js"], "run_at": "document_start"}], "action": {"default_popup": "ui/popup/popup.html", "default_title": "SPQ GST Automati