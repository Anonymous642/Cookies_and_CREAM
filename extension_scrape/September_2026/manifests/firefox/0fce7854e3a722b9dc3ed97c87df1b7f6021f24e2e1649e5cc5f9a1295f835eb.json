{"manifest_version": 3, "name": "CayTTer", "version": "1.0", "description": "A simple, minimal Twitter theme.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://x.com/*"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*"], "css": ["styles.css"], "js": ["popup.js", "settings.js"]}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "caytter@yourdomain.com", "strict_min_version": "109.0"}}}