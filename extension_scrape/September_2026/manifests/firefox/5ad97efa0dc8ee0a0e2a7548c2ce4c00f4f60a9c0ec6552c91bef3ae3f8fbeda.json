{"manifest_version": 2, "name": "YouTube Timeout", "version": "2.1.0", "description": "Every YouTube tab gets a 5-minute lock before it loads and again every 30 minutes of usage. One video per unlock: the tab closes when it ends, and leaving early resets you into another lock.", "author": "Your Name Here", "homepage_url": "https://github.com/your-username/yt-timeout", "browser_specific_settings": {"gecko": {"id": "yt-timeout@your-domain.example", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "webNavigation", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Timeout", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "web_accessible_resources": ["timeout.html"]}