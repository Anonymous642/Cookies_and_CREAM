{"manifest_version": 3, "name": "Sitation", "version": "0.1.5", "description": "Pin contextual comments to live webpages.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Sitation", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://sitation.io/*"], "js": ["auth-bridge.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "sitation-extension@jeremiah.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personalCommunications", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}