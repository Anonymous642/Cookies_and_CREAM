{"manifest_version": 2, "name": "retire.js", "description": "Scanning website for vulnerable js libraries", "version": "2.3.2", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "@retire.js", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "121.0"}}, "permissions": ["<all_urls>", "webRequest", "tabs"], "browser_action": {"default_icon": "icons/icon48.png", "default_title": "retire.js", "default_popup": "popup.html"}, "content_security_policy": "script-src 'self'; object-src 'self'", "background": {"page": "background.html", "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "run_at": "document_start"}]}