{"manifest_version": 3, "name": "ChatGPT Widescreen", "version": "1.2.1", "description": "A minimal Firefox extension that widens the ChatGPT chat layout on chatgpt.com using CSS only.", "author": "Arne, with support from ChatGPT", "homepage_url": "https://chatgpt.com/", "browser_specific_settings": {"gecko": {"id": "chatgpt-widescreen@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "css": ["widescreen.css"], "run_at": "document_start"}]}