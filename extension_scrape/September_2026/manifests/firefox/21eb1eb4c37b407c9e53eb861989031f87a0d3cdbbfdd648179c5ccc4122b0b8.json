{"manifest_version": 2, "name": "Recherche BIB CNRS depuis un lien (DOI)", "version": "1.2", "description": "Clic droit sur un lien pour rechercher automatiquement un DOI sur bib.cnrs.fr", "permissions": ["contextMenus", "tabs", "activeTab", "https://bib.cnrs.fr/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://bib.cnrs.fr/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "icons/icon-32.png"}, "browser_specific_settings": {"gecko": {"id": "bibsearch@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}