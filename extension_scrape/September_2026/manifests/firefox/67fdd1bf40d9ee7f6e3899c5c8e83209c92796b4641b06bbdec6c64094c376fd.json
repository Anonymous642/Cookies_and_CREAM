{"manifest_version": 3, "name": "BSync", "description": "Interactive browser sync overlay built with WXT and Preact.", "version": "0.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_title": "BSync", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:* wss://*;"}, "browser_specific_settings": {"gecko": {"id": "bsync@badtochka", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}]}