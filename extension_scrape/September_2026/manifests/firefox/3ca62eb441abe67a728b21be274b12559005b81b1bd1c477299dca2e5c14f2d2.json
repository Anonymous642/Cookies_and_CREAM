{"manifest_version": 3, "name": "Themify", "version": "1.44.5", "description": "Convert webpages into installable WordPress themes (.zip) with faithful animations. Runs 100% locally. Use only with permission.", "permissions": ["activeTab", "scripting", "downloads", "tabs", "windows", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["lib/jszip.min.js", "license.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "themify@REPLACE-WITH-YOUR-DOMAIN-OR-EMAIL", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}