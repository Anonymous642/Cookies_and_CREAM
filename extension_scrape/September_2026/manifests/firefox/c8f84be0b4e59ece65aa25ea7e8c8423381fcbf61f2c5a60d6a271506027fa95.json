{"manifest_version": 3, "name": "WISEPIM - Product Scraper & Importer", "version": "1.2.0", "description": "Import products into WISEPIM from any webshop page. Pick what you want and it lands in your catalog.", "homepage_url": "https://wisepim.com", "action": {"default_popup": "popup.html", "default_title": "Import to WISEPIM", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://wisepim.com/*"], "content_scripts": [{"matches": ["https://wisepim.com/*"], "js": ["pair-bridge.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "wisepim@wisepim.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}