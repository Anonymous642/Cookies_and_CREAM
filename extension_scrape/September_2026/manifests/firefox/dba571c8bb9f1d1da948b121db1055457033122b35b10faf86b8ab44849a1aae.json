{"manifest_version": 3, "name": "clip2md", "version": "1.0.6", "description": "Clip2MD \u4e00\u952e\u526a\u85cf\u5168\u7f51\u5185\u5bb9\u4e3a\u7eaf\u51c0Markdown\uff0c\u81ea\u52a8\u540c\u6b65\u81f3Obsidian\uff0c\u8ba9\u6bcf\u4e00\u6b21\u6d4f\u89c8\u90fd\u6c89\u6dc0\u4e3a\u4f60\u7684\u79c1\u4eba\u77e5\u8bc6\u8d44\u4ea7\u3002", "browser_specific_settings": {"gecko": {"id": "clip2md@bilong.org", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "storage", "clipboardWrite", "alarms", "contextMenus", "scripting"], "host_permissions": ["https://api.clip2md.cn/*", "https://static.clip2md.cn/*", "https://clip2md-prod-input.tos-cn-beijing.volces.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://clip2.md;"}, "background": {"scripts": ["lib/browser-polyfill.js", "background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["build-info.json", "icons/icon48.png"], "matches": ["<all_urls>"]}]}