{"manifest_version": 3, "name": "Stake Blur", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "blur@stake.com", "strict_min_version": "58.0"}}, "description": "Blurs any instance of 'Stake' in links or headings on stake.com and stake.us", "permissions": ["scripting"], "host_permissions": ["https://stake.com/*", "https://stake.us/*"], "content_scripts": [{"matches": ["https://stake.com/*", "https://stake.us/*"], "js": ["background.js"], "run_at": "document_idle"}], "icons": {"48": "StakeBlur-48.png"}}