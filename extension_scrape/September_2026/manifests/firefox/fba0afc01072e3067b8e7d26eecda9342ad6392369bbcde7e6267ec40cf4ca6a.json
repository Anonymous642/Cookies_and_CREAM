{"manifest_version": 3, "name": "Kipass", "version": "1.0.0", "description": "Ouvre vos coffres KeePass (.kdbx) dans le navigateur, remplit vos identifiants, synchronise en WebDAV. Tout reste local.", "default_locale": "fr", "action": {"default_popup": "popup/popup.html", "default_title": "Kipass", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "commands": {"fill-best": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Remplir le meilleur identifiant pour cette page"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "kipass@kinevia.com", "data_collection_permissions": {"required": ["none"]}}}}