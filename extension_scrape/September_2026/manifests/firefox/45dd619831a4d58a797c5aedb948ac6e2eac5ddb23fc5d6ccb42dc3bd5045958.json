{"manifest_version": 3, "name": "Auto Cleanup Brain", "version": "1.3", "description": "Detects browser clutter and recommends cleanup actions using local intelligence.", "permissions": ["tabs", "storage", "notifications", "downloads", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Auto Cleanup Brain"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Auto-Cleanup-Brain", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}