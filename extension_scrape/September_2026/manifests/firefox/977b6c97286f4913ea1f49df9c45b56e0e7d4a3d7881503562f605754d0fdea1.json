{"manifest_version": 2, "name": "Font Resizer", "version": "1.0", "description": "T\u0103ng/gi\u1ea3m c\u1ee1 ch\u1eef c\u1ee7a trang hi\u1ec7n t\u1ea1i (h\u1eefu \u00edch khi \u0111\u1ecdc). Kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u.", "permissions": ["tabs", "activeTab", "storage"], "browser_action": {"default_title": "Font Resizer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@font-resizer", "data_collection_permissions": {"required": ["none"]}}}}