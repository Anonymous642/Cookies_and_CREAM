{"manifest_version": 3, "name": "YouTube Notes", "version": "1.1", "description": "Aggiunge un editor di note personalizzato sotto i video di YouTube.", "browser_specific_settings": {"gecko": {"id": "youtube-notes@example.com", "strict_min_version": "109.0"}}, "icons": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}]}