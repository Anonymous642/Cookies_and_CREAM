{"manifest_version": 3, "name": "Litfinds Rep Multi-Tool", "short_name": "Litfinds Multi-Tool", "version": "1.0.0", "description": "Shopping companion for LitFinds & LitBuy: converts prices, views warehouse QC photos, redirects links, and bypasses popups.", "browser_specific_settings": {"gecko": {"id": "litfinds-extension@litfinds.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["*://*.1688.com/*", "*://*.taobao.com/*", "*://*.weidian.com/*", "*://*.yupoo.com/*", "*://*.litbuy.com/*", "*://*.litfinds.site/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Litfinds Rep Multi-Tool", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.1688.com/*", "*://*.taobao.com/*", "*://*.weidian.com/*", "*://*.yupoo.com/*", "*://*.litbuy.com/*", "*://*.litfinds.site/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["assets/*", "assets/buttons/*", "assets/agents/*", "content/content.css"], "matches": ["*://*.1688.com/*", "*://*.taobao.com/*", "*://*.weidian.com/*", "*://*.yupoo.com/*", "*://*.litbuy.com/*", "*://*.litfinds.site/*"]}], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}