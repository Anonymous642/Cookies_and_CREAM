{"manifest_version": 3, "name": "WikiCheck", "version": "1.2.0", "description": "Analysiert die Qualit\u00e4t und Vertrauensw\u00fcrdigkeit von Wikipedia-Artikeln direkt im Browser.", "permissions": ["storage"], "host_permissions": ["https://*.wikipedia.org/*", "https://en.wikipedia.org/w/api.php", "https://de.wikipedia.org/w/api.php", "https://api.wikimedia.org/*"], "browser_specific_settings": {"gecko": {"id": "wikicheck@nicohoffmann.dev", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "src/background/service-worker.js", "scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*.wikipedia.org/wiki/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "icons": {"16": "icons/16x16_Logo_WikiCheck.png", "32": "icons/32x32_Logo_WikiCheck.png", "48": "icons/48x48_Logo_WikiCheck.png", "128": "icons/128x128_Logo_WikiCheck.png"}}