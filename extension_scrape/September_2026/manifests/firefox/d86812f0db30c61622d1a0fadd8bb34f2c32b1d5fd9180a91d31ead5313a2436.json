{"manifest_version": 3, "name": "DealerHive Lead 360", "description": "Shows DealerHive call intelligence for the lead open in VinSolutions.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "cookies"], "host_permissions": ["*://*.coxautoinc.com/*", "https://apps.vinmanager.com/*", "https://*.insighthive.ai/*"], "web_accessible_resources": [{"resources": ["sidepanel.html"], "matches": ["https://vinsolutions.app.coxautoinc.com/*", "https://apps.vinmanager.com/*"]}], "action": {"default_title": "DealerHive Lead 360", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://*.insighthive.ai;"}, "browser_specific_settings": {"gecko": {"id": "vinbridge@dealerhive.ai", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo", "authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://apps.vinmanager.com/*", "https://vinsolutions.app.coxautoinc.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}