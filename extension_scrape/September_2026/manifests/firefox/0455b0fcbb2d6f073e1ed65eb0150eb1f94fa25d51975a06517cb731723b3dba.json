{"manifest_version": 3, "name": "Pwdly", "version": "2.7", "description": "Non-intrusive zero-knowledge password manager built for teams. Easily autofill credentials and organize passwords in your browser.", "browser_specific_settings": {"gecko": {"id": "extension@pwdly.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; frame-src https://dash.pwdly.app; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["vendor/buffer.min.js", "vendor/engine.js", "background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-bundle.js"], "run_at": "document_idle", "exclude_matches": ["https://dash.pwdly.app/*"]}]}