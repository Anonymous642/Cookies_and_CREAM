{"manifest_version": 2, "name": "1-click block redditors", "description": "Block a Redditor the exact moment you see his or her hot take.", "version": "0.2.0", "icons": {"128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "reddit-quick-block@danielh-official.github.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Quick Block", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://reddit.com/*", "*://sh.reddit.com/*", "*://www.reddit.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}