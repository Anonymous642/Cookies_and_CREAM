{"manifest_version": 3, "name": "Twitter Filter", "version": "1.1.2", "description": "Filter content on Twitter", "permissions": ["storage"], "host_permissions": ["*://twitter.com/*", "*://x.com/*"], "browser_specific_settings": {"gecko": {"id": "fourierproject@addons", "strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["global_rank.txt"], "matches": ["*://twitter.com/*", "*://x.com/*"]}]}