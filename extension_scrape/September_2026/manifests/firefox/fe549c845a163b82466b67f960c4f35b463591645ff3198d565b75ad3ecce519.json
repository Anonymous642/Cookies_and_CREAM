{"manifest_version": 3, "name": "TABDROP", "version": "0.1.0", "description": "Group current-window Firefox tabs into native, named tab groups using local editable rules.", "permissions": ["tabs", "tabGroups", "storage"], "action": {"default_title": "TABDROP", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tabdrop@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}