{"manifest_version": 3, "name": "RewardSensei: Household Rewards Tracker", "version": "1.0.3", "description": "Sync supported offers for free. Pro adds automatic benefit tracking plus manual and optional automatic offer activation.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "rewardsensei@rewardsensei.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "financialAndPaymentInfo", "authenticationInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "alarms", "scripting", "declarativeNetRequest"], "host_permissions": ["https://*.americanexpress.com/*", "https://*.chase.com/*", "https://*.citi.com/*", "https://*.citibank.com/*", "https://www.thankyou.com/*", "https://*.bankofamerica.com/*", "https://*.capitalone.com/*", "https://pbxglgmeieopwwkprkxc.supabase.co/*"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "capital_one_headers", "enabled": true, "path": "rules/capital-one.json"}]}, "content_scripts": [{"matches": ["https://*.americanexpress.com/*", "https://*.chase.com/*", "https://*.citi.com/*", "https://*.citibank.com/*", "https://*.bankofamerica.com/*", "https://*.capitalone.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_title": "RewardSensei", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}}