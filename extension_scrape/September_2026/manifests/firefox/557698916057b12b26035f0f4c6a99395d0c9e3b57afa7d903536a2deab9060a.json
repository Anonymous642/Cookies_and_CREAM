{"manifest_version": 2, "name": "Reddtastic Dedup", "version": "1.0.0", "description": "Filtra i repost duplicati su Reddtastic, mostrando solo la prima occorrenza di ogni contenuto.", "author": "Andonio", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": "icons/icon48.png", "default_popup": "popup.html", "default_title": "Reddtastic Dedup"}, "content_scripts": [{"matches": ["*://www.reddtastic.com/*", "*://reddtastic.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["storage", "*://www.reddtastic.com/*", "*://reddtastic.com/*"], "browser_specific_settings": {"gecko": {"id": "reddtastic-dedup@andonio", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}