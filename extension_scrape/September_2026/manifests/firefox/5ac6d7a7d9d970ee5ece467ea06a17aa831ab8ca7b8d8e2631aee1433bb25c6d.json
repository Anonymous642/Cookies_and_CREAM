{"manifest_version": 3, "name": "Focus Glass", "version": "1.0.0", "description": "A calm, photorealistic focus timer where time fills a glass of water to cultivate serene focus.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "notifications"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "focusglass@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}