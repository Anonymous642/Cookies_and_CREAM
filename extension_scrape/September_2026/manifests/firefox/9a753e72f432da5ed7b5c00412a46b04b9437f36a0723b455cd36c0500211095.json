{"manifest_version": 2, "name": "MakerWorld Cash USD to GBP", "version": "2.3.2", "description": "Automatically converts USD values to their GBP equivalents on MakerWorld Cash Redemption, Redeem History, and Creator Center Income pages while leaving points totals unchanged.", "permissions": ["storage", "activeTab", "https://api.frankfurter.dev/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://makerworld.com/*", "https://www.makerworld.com/*", "https://*.makerworld.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "browser_action": {"default_title": "MakerWorld USD to GBP", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "makerworld-usd-to-gbp@matrixite.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": ["assets/redeem-cash-pound.png"]}