{"manifest_version": 3, "name": "Daily Browsing Report", "version": "1.0.0", "description": "Private, local-only daily report of your browsing: total time, time by category, top sites by duration and by visits, and an hour-by-hour timeline.", "browser_specific_settings": {"gecko": {"id": "daily-browsing-report@moecui22.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "idle", "alarms", "notifications"], "background": {"scripts": ["src/lib/api.js", "src/lib/format.js", "src/lib/categories.js", "src/lib/store.js", "src/background/tracker.js"]}, "action": {"default_title": "Daily Browsing Report", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}