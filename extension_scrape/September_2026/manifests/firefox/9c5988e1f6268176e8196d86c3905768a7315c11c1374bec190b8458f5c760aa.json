{"manifest_version": 2, "name": "No LinkedIn Feed", "version": "1.0.0", "description": "Replaces the LinkedIn home feed with a cat or dog of the day. Jobs, messaging, notifications and profiles keep working.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "https://cataas.com/*", "https://dog.ceo/*", "https://images.dog.ceo/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": ["pet.html", "pet.js", "pet.css"], "browser_action": {"default_title": "No LinkedIn Feed", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "no-linkedin-feed@waldomiro", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}