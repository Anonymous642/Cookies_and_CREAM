{"manifest_version": 3, "name": "Stream for Friends", "version": "0.5.0", "description": "Videos gemeinsam schauen: private R\u00e4ume, synchrone Wiedergabe und Chat.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png", "256": "icon-256.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Stream for Friends \u00f6ffnen", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png", "256": "icon-256.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["invite.js"], "all_frames": false, "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["player.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' data:; connect-src wss: ws://localhost:* ws://127.0.0.1:* https: http://localhost:* http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "crwatchparty@local.roman", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personalCommunications", "personallyIdentifyingInfo", "websiteActivity"]}}}}