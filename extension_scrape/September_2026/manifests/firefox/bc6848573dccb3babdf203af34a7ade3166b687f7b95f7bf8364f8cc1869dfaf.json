{"manifest_version": 3, "name": "Social Video Controls", "version": "1.1", "description": "Adds volume and play/pause controls to videos on Facebook, Instagram, and TikTok.", "browser_specific_settings": {"gecko": {"id": "social-video-controls@bobbite.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*"], "css": ["styles.css"], "js": ["content.js"], "all_frames": true}]}