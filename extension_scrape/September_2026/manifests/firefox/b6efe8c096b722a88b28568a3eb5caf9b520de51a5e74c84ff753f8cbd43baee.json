{"manifest_version": 2, "name": "Currency Converter on Hover", "version": "1.1.0", "description": "Hover over any price on a webpage to see it converted to your preferred currency.", "browser_specific_settings": {"gecko": {"id": "currency-convertor@gabrielsoftware.uk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "Currency Converter", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content/content.js"], "css": ["content/content.css"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background/background.js"], "persistent": false}, "content_security_policy": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src https://open.er-api.com; img-src 'self'", "web_accessible_resources": ["fonts/*.woff2", "fonts/fonts.css"]}