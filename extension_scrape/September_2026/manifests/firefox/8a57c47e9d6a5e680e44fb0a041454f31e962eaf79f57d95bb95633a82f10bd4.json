{"manifest_version": 3, "name": "Onpoint Earning Assistant", "version": "1.0.2", "description": "Never miss an opportunity to earn Onpoints and redeem gift vouchers.", "permissions": ["storage", "cookies", "tabs", "alarms", "scripting", "windows"], "host_permissions": ["http://localhost:3000/*", "http://localhost:5173/*", "http://localhost:8000/*", "https://on-points.com/*"], "action": {"default_popup": "index.html", "default_icon": {"16": "onpoint-block.png", "48": "onpoint-block.png", "128": "onpoint-block.png"}}, "icons": {"16": "onpoint-block.png", "48": "onpoint-block.png", "128": "onpoint-block.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["onpoint-logo.png", "onpoint-block.png", "chunks/*.js", "assets/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["categoryWidgetInjector.js"], "run_at": "document_idle"}, {"matches": ["*://*.google.com/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*"], "js": ["serpInjector.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "extension@on-points.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}