{"manifest_version": 3, "name": "YouTube Borderless Windowed", "browser_specific_settings": {"gecko": {"id": "addon@YouTubeBorderlessWindowed.com", "strict_min_version": "58.0"}}, "version": "1.1", "description": "Toggle YouTube video to windowed fullscreen and optionally default to it. Customizable hotkey is available.", "permissions": ["storage", "scripting"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["style.css"]}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"48": "icon.png"}}