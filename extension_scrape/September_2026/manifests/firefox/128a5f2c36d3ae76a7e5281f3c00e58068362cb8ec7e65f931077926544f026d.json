{"manifest_version": 2, "name": "Transcript Grab for YouTube", "version": "1.1.0", "description": "Grab any YouTube transcript in one click. Fast API-based extraction.", "author": "DV", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "clipboardWrite", "*://*.youtube.com/*"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_popup": "popup.html", "default_title": "Grab YouTube Transcript"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "transcript-grab@dv.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}