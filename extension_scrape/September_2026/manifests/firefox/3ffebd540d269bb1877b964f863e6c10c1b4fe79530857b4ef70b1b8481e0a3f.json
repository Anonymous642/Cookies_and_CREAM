{"manifest_version": 3, "name": "ShiftQR", "description": "Hold Shift, Get QR", "version": "1.0.3", "icons": {"16": "/icon-on-light-16.png", "48": "/icon-on-light-48.png", "128": "/icon-on-light-128.png"}, "browser_specific_settings": {"gecko": {"id": "firefox@shiftqr.com"}}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "ShiftQR", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["*://*/*"]}]}