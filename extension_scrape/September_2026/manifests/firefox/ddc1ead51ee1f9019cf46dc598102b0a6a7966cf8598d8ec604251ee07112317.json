{"manifest_version": 3, "name": "Sellasistant", "version": "3.0.1", "description": "Rozszerzenie u\u0142atwiaj\u0105ce prac\u0119 z Sellasistem", "permissions": ["storage"], "host_permissions": ["https://*.sellasist.pl/*", "https://app.responso.com/*", "https://app.helpratchet.com/*"], "browser_specific_settings": {"gecko": {"id": "sellasistant@oh1.ovh", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "options_page": "options.html", "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.sellasist.pl/admin/returns/edit/*"], "js": ["returns.js"], "run_at": "document_idle"}, {"matches": ["https://*.sellasist.pl/admin/catalog_products/edit/*"], "js": ["product.js"], "run_at": "document_idle"}, {"matches": ["https://*.sellasist.pl/admin/catalog_products*", "https://*.sellasist.pl/admin/catalog_productsets"], "js": ["products.js"], "run_at": "document_idle"}, {"matches": ["https://*.sellasist.pl/admin/shipments_manager/*"], "js": ["shipments.js"], "run_at": "document_idle"}, {"matches": ["https://*.sellasist.pl/admin/barcodes*"], "all_frames": true, "js": ["packing.js"], "run_at": "document_end"}, {"matches": ["https://*.sellasist.pl/admin/orders/edit/*"], "js": ["order.js"], "run_at": "document_idle"}, {"matches": ["https://*.sellasist.pl/admin/orders/edit*"], "exclude_matches": ["https://*.sellasist.pl/admin/orders/edit/*"], "js": ["orders.js"], "run_at": "document_idle"}, {"matches": ["https://app.responso.com/ticket/*", "https://app.helpratchet.com/ticket/*"], "js": ["utils.js", "responso.js"], "run_at": "document_idle"}, {"matches": ["https://erli.pl/manager-sklepu/*"], "js": ["utils.js", "erli.js"], "run_at": "document_idle"}]}