{"manifest_version": 3, "name": "Yocoolab - Feedback for builders and Agents", "version": "1.9.200", "description": "Pin feedback on any live site - localhost, staging or production - and send it to Claude Code, Cursor or your agent via MCP.", "permissions": ["storage", "activeTab", "tabs", "scripting", "notifications", "alarms", "contextMenus"], "background": {"scripts": ["src/background.js"], "service_worker": "src/background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Yocoolab panel"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/yocoolab-ds.iife.js", "src/design-tools-lib.js", "src/design-panel.js", "src/comments-ui.js", "styles/tokens.css", "styles/components.css", "styles/comments-skin.css", "sticky-prompt.html", "src/sticky-prompt.js", "sketch/*", "sketch/fonts/*", "sketch/fonts/*/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "yocoolab@yocoolab.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}, "host_permissions": ["http://*/*", "https://*/*"]}