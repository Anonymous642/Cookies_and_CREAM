{"manifest_version": 2, "name": "Kleingarten-Finder Berlin", "description": "Sucht t\u00e4glich (oder per Klick) nach Hinweisen auf freie Kleingarten/Schrebergarten-Pl\u00e4tze in Berlin und meldet Funde.", "version": "1.0.5", "browser_action": {"default_title": "Kleingarten-Finder Berlin", "default_popup": "popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "permissions": ["alarms", "notifications", "storage", "<all_urls>"], "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "kleingarten-finder@remko", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}