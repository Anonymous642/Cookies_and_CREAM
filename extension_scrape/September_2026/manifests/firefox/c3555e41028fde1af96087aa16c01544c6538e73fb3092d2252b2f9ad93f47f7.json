{"manifest_version": 3, "name": "GhostDraft", "version": "1.1.0", "description": "A privacy-focused safety net for commenters. Auto-saves text from any field locally \u2014 zero AI, zero data collection.", "author": "GhostDraft", "browser_specific_settings": {"gecko": {"id": "ghostdraft-extension@mozilla.addons", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["storage_manager.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "GhostDraft", "default_icon": "icons/ghost48.svg"}, "icons": {"48": "icons/ghost48.svg", "128": "icons/ghost128.svg"}}