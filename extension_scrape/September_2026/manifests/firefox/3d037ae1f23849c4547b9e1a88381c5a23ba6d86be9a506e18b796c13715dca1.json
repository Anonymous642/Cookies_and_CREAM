{"manifest_version": 3, "name": "YouTube Auto Speed", "version": "1.0", "description": "Automatically sets YouTube video speed", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-speed@piky.com", "data_collection_permissions": {"required": ["none"], "data_categories": []}}}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}]}