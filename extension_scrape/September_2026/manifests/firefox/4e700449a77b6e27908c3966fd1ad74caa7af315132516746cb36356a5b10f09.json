{"manifest_version": 3, "name": "Vocabinski", "version": "1.0.1", "description": "Vocabulary builder that analyzes words with AI and saves them for Anki.", "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["https://api.openai.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup_menu.html", "default_title": "Vocabinski - My Vocabulary", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "vocabinski@vocabinski.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}