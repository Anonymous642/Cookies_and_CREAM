{"manifest_version": 3, "name": "Share to Petals", "version": "1.5.1", "description": "Add posts from Facebook, Instagram, X \u2014 anywhere \u2014 to your Petals garden. Glows pink when a page can be picked.", "permissions": ["tabs", "contextMenus", "scripting", "activeTab", "storage", "alarms"], "host_permissions": ["https://petals.blog/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "share@petals.blog", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://*.twitter.com/*", "https://bsky.app/*", "https://reddit.com/*", "https://*.reddit.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://facebook.com/*", "https://*.facebook.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Share this page to Petals", "default_icon": {"16": "icons/petal-gray-16.png", "32": "icons/petal-gray-32.png", "48": "icons/petal-gray-48.png", "128": "icons/petal-gray-128.png"}}, "icons": {"16": "icons/petal-16.png", "32": "icons/petal-32.png", "48": "icons/petal-48.png", "128": "icons/petal-128.png"}}