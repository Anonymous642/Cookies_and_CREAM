{"manifest_version": 2, "name": "Local AI Tab Grouper", "version": "0.1.1", "description": "Uses a local Ollama model to organize the current Firefox window into named tab groups.", "permissions": ["tabs", "tabGroups", "storage", "http://localhost:11434/*", "http://127.0.0.1:11434/*"], "browser_action": {"default_title": "Group tabs with Ollama", "default_icon": {"16": "icons/stars-16.png", "32": "icons/stars-32.png", "48": "icons/stars-48.png", "64": "icons/stars-64.png", "128": "icons/stars-128.png"}}, "icons": {"16": "icons/stars-16.png", "32": "icons/stars-32.png", "48": "icons/stars-48.png", "64": "icons/stars-64.png", "128": "icons/stars-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "local-ai-tab-grouper@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}