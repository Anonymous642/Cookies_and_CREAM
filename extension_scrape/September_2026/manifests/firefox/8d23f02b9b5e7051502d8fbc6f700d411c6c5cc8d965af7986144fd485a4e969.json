{"manifest_version": 2, "name": "HTTPS Request Capture", "version": "1.0", "description": "Capture and display HTTPS requests in Firefox", "icons": {"48": "icon.png", "96": "icon.png"}, "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage"], "browser_specific_settings": {"gecko": {"id": "https-request-capture@example.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "icon.png", "default_title": "HTTPS Request Capture", "default_popup": "popup.html"}}