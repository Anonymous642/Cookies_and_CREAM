{"manifest_version": 2, "name": "TabCanopy", "version": "1.3.0", "description": "Groups tabs by domain into folder dropdowns in your toolbar.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_popup": "popup/popup.html", "default_title": "TabCanopy"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "permissions": ["tabs", "storage", "activeTab", "alarms"], "commands": {"jump-to-meet": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Jump to active Google Meet tab"}}, "browser_specific_settings": {"gecko": {"id": "tab-folders@local", "strict_min_version": "91.0"}}}