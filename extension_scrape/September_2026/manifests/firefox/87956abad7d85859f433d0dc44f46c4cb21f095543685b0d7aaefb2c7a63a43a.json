{"manifest_version": 3, "name": "StateShift", "version": "1.0.0", "description": "A browser-based cognitive state rebalancing system.", "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "idle"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_end"}], "action": {"default_popup": "index.html", "default_title": "StateShift"}, "browser_specific_settings": {"gecko": {"id": "stateshift@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' https://upload.wikimedia.org data:; img-src 'self' data:;"}, "web_accessible_resources": [{"resources": ["index.html", "extracted-*.js", "_next/*", "fonts/*"], "matches": ["<all_urls>"]}]}