{"manifest_version": 2, "name": "TabBeep \u2014 \u00c2m b\u00e1o t\u1eaft/m\u1edf tab \u00e2m", "version": "1.0.0", "description": "Ph\u00e1t \u00e2m ng\u1eafn khi tab chuy\u1ec3n tr\u1ea1ng th\u00e1i playing audio <-> muted. Cho ph\u00e9p b\u1eadt/t\u1eaft, ch\u1ecdn m\u1eabu ti\u1ebfng, l\u1ecdc domain.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "<all_urls>"], "background": {"page": "background.html", "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "TabBeep", "default_icon": "icons/icon-48.png", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@tabbeep.thuytrang", "strict_min_version": "68.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": "script-src 'self'; object-src 'self';"}