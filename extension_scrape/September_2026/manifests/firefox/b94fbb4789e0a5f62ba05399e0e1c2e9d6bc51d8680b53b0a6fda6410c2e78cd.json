{"manifest_version": 3, "name": "Live Sync \u2014 YouTube sem delay", "short_name": "Live Sync", "version": "1.0.0", "description": "Reduz o atraso das transmiss\u00f5es ao vivo do YouTube acelerando o player de forma sutil at\u00e9 alcan\u00e7ar o ao vivo.", "browser_specific_settings": {"gecko": {"id": "youtube-live-sync@ulpionetto", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["src/inject.js"], "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"]}], "action": {"default_title": "Live Sync", "default_popup": "src/popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "commands": {"jump-to-live": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Pular direto para o ao vivo"}, "toggle-enabled": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Ligar/desligar o Live Sync"}}}