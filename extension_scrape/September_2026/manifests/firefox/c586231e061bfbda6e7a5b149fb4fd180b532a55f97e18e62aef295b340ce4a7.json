{"manifest_version": 2, "name": "Betsurf", "version": "1.0", "description": "Maximize your odds of winning by finding the best odds", "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": ["inject.html", "inject.css", "imgs/*", "website/*"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "support@betsurf.se"}}}