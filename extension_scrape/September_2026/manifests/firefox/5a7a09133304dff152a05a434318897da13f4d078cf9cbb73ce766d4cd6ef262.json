{"manifest_version": 3, "name": "YouTune - Enhancer For YouTube", "version": "1.1.0", "description": "Customize YouTube playback, volume, quality, controls, appearance, cinema mode, and mini player.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "action": {"default_title": "Open YouTune settings", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"scripts": ["background.js"]}, "options_page": "popup.html", "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["codec-main.js", "player-main.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["settings-schema.js", "content.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtune-enhancer@zentryqb.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}