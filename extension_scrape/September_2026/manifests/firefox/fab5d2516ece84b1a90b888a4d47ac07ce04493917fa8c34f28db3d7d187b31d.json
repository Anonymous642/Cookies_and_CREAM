{"manifest_version": 3, "name": "JSK Multi URL Opener", "description": "Paste, generate, organize and open batches of links safely. No tracking, minimal permissions.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "alarms"], "optional_permissions": ["bookmarks", "clipboardRead"], "optional_host_permissions": ["https://api.jskapps.com/*"], "commands": {"_execute_action": {"description": "Open JSK Multi URL Opener"}}, "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "multi-url-opener@jskapps.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "JSK Multi URL Opener", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "JSK Multi URL Opener"}}