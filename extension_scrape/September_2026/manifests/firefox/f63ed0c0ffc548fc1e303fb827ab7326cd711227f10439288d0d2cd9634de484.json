{"manifest_version": 3, "name": "A1 Reader Mode Reading List", "short_name": "A1 Reader", "version": "0.1.0", "description": "Extract a readable view of the current page and keep a small local reading list without remote calls.", "homepage_url": "https://a1local.com.au/extensions/reader-mode-reading-list/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "A1 Reader Mode Reading List", "default_popup": "popup.html"}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "reader-mode-reading-list@a1local.com.au", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}