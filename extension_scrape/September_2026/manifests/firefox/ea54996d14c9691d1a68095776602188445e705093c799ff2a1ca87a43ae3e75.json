{"manifest_version": 3, "name": "TinEye API Search", "version": "2.0.6", "description": "This is the official TinEye API Firefox extension.", "browser_specific_settings": {"gecko": {"id": "support@tineye.com", "strict_min_version": "112.0"}}, "icons": {"16": "assets/tineye16.png", "48": "assets/tineye48.png", "128": "assets/tineye128.png"}, "action": {"default_icon": {"16": "assets/tineye16.png", "48": "assets/tineye48.png", "128": "assets/tineye128.png"}}, "permissions": ["menus", "storage", "scripting", "activeTab"], "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options.html"}, "homepage_url": "https://tineye.com", "web_accessible_resources": [{"resources": ["assets/*.png"], "matches": ["<all_urls>"]}]}