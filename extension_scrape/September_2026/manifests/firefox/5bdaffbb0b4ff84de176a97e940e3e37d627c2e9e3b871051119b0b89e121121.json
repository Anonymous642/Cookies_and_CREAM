{"manifest_version": 3, "name": "Steam Revenue Calculator", "description": "This plugin shows the game's revenue inside the Steam store page.", "version": "1.0.8", "browser_specific_settings": {"gecko": {"id": "steam-revenue-calculator@steamrevenue.addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["content-script.js"], "matches": ["*://store.steampowered.com/app/*", "*://store.steampowered.com/agecheck/app/*"], "run_at": "document_end", "all_frames": false}], "host_permissions": ["*://store.steampowered.com/*"], "icons": {"128": "icon128.png"}}