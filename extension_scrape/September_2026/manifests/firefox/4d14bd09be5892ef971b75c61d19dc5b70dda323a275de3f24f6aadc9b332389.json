{"manifest_version": 3, "name": "Maski", "description": "Create a Maski email alias and put it in the signup form you are on.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "clipboardWrite"], "host_permissions": ["https://api.maski.dev/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open Maski"}}, "browser_specific_settings": {"gecko": {"id": "extension@maski.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Maski", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://maski.dev/connect-extension*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/maski-connect.js"]}, {"matches": ["<all_urls>"], "all_frames": false, "exclude_matches": ["https://maski.dev/*"], "js": ["content-scripts/maski-fill.js"]}]}