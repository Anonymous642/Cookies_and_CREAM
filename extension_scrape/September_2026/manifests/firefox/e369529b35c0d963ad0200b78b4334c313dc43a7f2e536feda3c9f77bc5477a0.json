{"manifest_version": 3, "name": "YouTube Subtitle Downloader", "version": "1.2.4", "description": "Download subtitles (Closed Captions) from YouTube videos with one click as SRT files.", "browser_specific_settings": {"gecko": {"id": "{0c59c9dc-d586-48f7-ac51-078cf3ebd8bf}", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["downloads", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.googlevideo.com/*", "*://googlevideo.com/*"], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.youtube.com/*", "*://youtube.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "YouTube Subtitle Downloader", "default_icon": {"16": "icon-16.png", "48": "icon-48.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}}