{"manifest_version": 2, "name": "Eco Shopping Helper", "version": "1.3", "description": "Manually track eco-friendly product and brand information while shopping online.", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Eco Shopping Helper", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Eco-Shopping-Helper", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}