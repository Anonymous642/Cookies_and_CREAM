{"manifest_version": 2, "name": "Bandcamp Dig", "description": "Dig better on Bandcamp. Sort items in playlists, track new releases, provide dark mode and more.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "*://*.bandcamp.com/*"], "web_accessible_resources": ["retrieve-tracks.js", "player-interact.js", "dark-mode.css"], "browser_specific_settings": {"gecko": {"id": "bandcamp-dig@barnemax", "data_collection_permissions": {"required": ["none"], "collected": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Bandcamp Dig", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.bandcamp.com/*"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}