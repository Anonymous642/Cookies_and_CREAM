{"manifest_version": 2, "name": "yubal", "description": "Send YouTube URLs to your yubal instance", "version": "0.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "homepage_url": "https://yubal.guillevc.dev", "permissions": ["storage", "activeTab", "tabs"], "browser_specific_settings": {"gecko": {"id": "yubal@guillevc.xyz", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "yubal", "default_popup": "popup.html"}}