{"manifest_version": 3, "name": "NoMoreTabs", "version": "4.2", "description": "Stop websites from opening unwanted new tabs. Includes iframe and shadow-dom protection.", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["inject.js", "fake_domains.json"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "nomoretabs@malitool.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}