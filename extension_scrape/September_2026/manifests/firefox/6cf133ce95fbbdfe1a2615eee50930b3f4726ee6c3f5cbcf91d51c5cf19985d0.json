{"manifest_version": 2, "name": "LinkedIn to CSV Exporter", "version": "1.0.0", "description": "Extract LinkedIn profile data and export to CSV", "permissions": ["storage", "activeTab", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["content/content.js"], "css": ["content/content.css"]}], "background": {"scripts": ["background/background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "linkedin-to-csv-exporter@example.com"}}}