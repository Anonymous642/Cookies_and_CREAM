{"manifest_version": 2, "name": "Auto-Mute Manager", "version": "1.0.0", "description": "Remembers muted websites and automatically re-mutes them when tabs are opened.", "permissions": ["tabs", "storage", "webNavigation"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/mute-16.png", "32": "icons/mute-32.png", "48": "icons/mute-48.png"}}, "icons": {"16": "icons/mute-16.png", "32": "icons/mute-32.png", "48": "icons/mute-48.png", "96": "icons/mute-96.png"}, "browser_specific_settings": {"gecko": {"id": "auto-mute-manager@nonsketchyextensions.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}