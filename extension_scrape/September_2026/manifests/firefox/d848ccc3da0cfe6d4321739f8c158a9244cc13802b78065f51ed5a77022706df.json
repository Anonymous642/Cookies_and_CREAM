{"manifest_version": 3, "name": "IMDB Copy", "version": "1.1.0", "description": "One-click copy of Movie Title (Year) [ttID] from any IMDb title page to your clipboard.", "icons": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "permissions": ["clipboardWrite", "activeTab", "scripting", "storage"], "host_permissions": ["*://*.imdb.com/title/tt*"], "content_scripts": [{"matches": ["*://*.imdb.com/title/tt*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_icon": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "default_popup": "popup.html", "default_title": "IMDB Copy"}, "browser_specific_settings": {"gecko": {"id": "imdb-copy@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}