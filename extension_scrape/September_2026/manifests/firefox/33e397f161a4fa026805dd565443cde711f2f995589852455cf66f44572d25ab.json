{"manifest_version": 3, "name": "IITG AutoLogin", "description": "Automatically log into the IITG network with this extension. No more manual logins or keeping tabs open every time!", "version": "1.0.2", "background": {"scripts": ["background.js"]}, "action": {"default_popup": "Popup.html"}, "options_page": "Options.html", "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["*://agnigarh.iitg.ac.in/*"], "icons": {"128": "Icons/icon_active2.png"}, "browser_specific_settings": {"gecko": {"id": "autologin@dedsec.com", "data_collection_permissions": {"required": ["none"]}}}}