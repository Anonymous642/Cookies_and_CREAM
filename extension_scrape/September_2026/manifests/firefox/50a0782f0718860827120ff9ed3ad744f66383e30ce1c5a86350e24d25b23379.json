{"manifest_version": 3, "name": "Image Picker for OBS", "version": "1.3.0", "description": "Pick images from any web page and send them straight to OBS.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "obs-image-picker@ceddini", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Image Picker for OBS", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"pick-image": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Pick an image to send to OBS"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}}