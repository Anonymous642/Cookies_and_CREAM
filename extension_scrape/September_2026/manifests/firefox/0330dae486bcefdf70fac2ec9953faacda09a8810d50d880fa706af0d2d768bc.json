{"manifest_version": 2, "name": "Move Reminder", "version": "3.1", "description": "A gentle chime that nudges you to get up and move \u2014 on your schedule, at your volume.", "browser_specific_settings": {"gecko": {"id": "move-reminder@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "storage", "notifications"], "background": {"scripts": ["chime.js", "background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "Move Reminder", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}