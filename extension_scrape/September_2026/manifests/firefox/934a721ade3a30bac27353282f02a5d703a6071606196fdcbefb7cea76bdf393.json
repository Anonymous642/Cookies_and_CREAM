{"manifest_version": 2, "name": "Spectral RS Wiki Price Display", "version": "1.1.8", "description": "Displays item IDs from ely.gg on RuneScape Wiki pages.", "browser_specific_settings": {"gecko": {"id": "spectral-wiki-price@ely.gg", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://*/*", "http://*/*"], "icons": {"64": "img/64.png", "128": "img/128.png"}, "browser_action": {"default_icon": "img/64.png", "default_title": "Configure Spectral Extension", "default_popup": "options.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://runescape.wiki/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["new_data.json", "presets.json"]}