{"manifest_version": 3, "name": "RE-Pilot", "version": "1.2.0", "description": "Scrape Zillow and StreetEasy listings and generate high-end property descriptions with Claude.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://*.zillow.com/*", "https://*.streeteasy.com/*", "https://worker.repilotapp.com/*"], "action": {"default_popup": "popup.html", "default_title": "RE-Pilot", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.zillow.com/*", "https://*.streeteasy.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "re-pilot@repilot.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}