{"manifest_version": 3, "name": "KOSHTA JI", "version": "0.3.0", "description": "Automates MP Forest safari slot selection on forest.mponline.gov.in.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://forest.mponline.gov.in/*", "https://mponline.gov.in/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "booknow-square.png", "32": "booknow-square.png", "48": "booknow-square.png", "128": "booknow-square.png"}, "action": {"default_icon": {"16": "booknow-square.png", "32": "booknow-square.png"}, "default_popup": "popup.html", "default_title": "MP Forest Auto Booking"}, "content_scripts": [{"matches": ["https://forest.mponline.gov.in/*", "https://mponline.gov.in/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page-confirm-bridge.js"], "matches": ["https://forest.mponline.gov.in/*"]}], "browser_specific_settings": {"gecko": {"id": "koshta-ji-forest-booking@ritesh.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}