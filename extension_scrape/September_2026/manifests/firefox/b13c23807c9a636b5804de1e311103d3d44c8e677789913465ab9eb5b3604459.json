{"manifest_version": 2, "name": "Roblox Asset Downloader", "version": "1.3.0", "description": "A Firefox extension to download Roblox assets (images, decals, models, etc) by ID.", "browser_specific_settings": {"gecko": {"id": "robloxassetdownloader@mitsikdev.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": []}}}, "browser_action": {"default_popup": "index.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["downloads", "storage", "https://assetdelivery.roblox.com/*", "https://thumbnails.roblox.com/*", "https://www.roblox.com/*"]}