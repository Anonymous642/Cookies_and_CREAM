{"manifest_version": 2, "name": "Centris addon", "version": "1.0", "description": "Computes the rentability of a property on Centris.ca by calculating the cash flow from the price, the rent, and the expenses.", "icons": {"48": "icons/centris_icon.ico"}, "permissions": ["activeTab"], "browser_action": {"default_icon": "icons/centris_icon.ico", "default_title": "Centris addon", "default_popup": "popup/index.html"}, "content_scripts": [{"matches": ["https://www.centris.ca/*"], "js": ["content_scripts/centris.js"]}], "browser_specific_settings": {"gecko": {"id": "@centris-addon", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}