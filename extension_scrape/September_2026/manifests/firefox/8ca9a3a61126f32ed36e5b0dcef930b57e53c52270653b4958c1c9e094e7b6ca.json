{"manifest_version": 2, "name": "Input Buddy", "description": "InputBuddy aims to remove repetitive typing from forms. Save common label + answer pairs and InputBuddy will auto-fill them.", "version": "1.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "author": "Dante R", "license": "GPL-3.0-or-later", "permissions": ["storage", "tabs", "<all_urls>"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}, "id": "{7faf9e4c-d698-407c-9668-8176fd484bac}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Input Buddy", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"]}