{"manifest_version": 3, "name": "YouTube Zen", "version": "1.0.2", "description": "Windowed fullscreen for YouTube: auto-enter, player button, controls hidden until clicked. Minimal and local.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "css": ["zen.css"], "run_at": "document_idle"}], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "{c3eae54a-5aba-4668-a44d-7c13d8e9dd9d}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}