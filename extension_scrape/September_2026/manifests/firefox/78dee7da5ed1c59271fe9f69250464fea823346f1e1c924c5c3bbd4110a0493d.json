{"manifest_version": 2, "name": "Uverest", "description": "Try clothes on yourself while you shop, powered by Uverest.", "version": "0.1.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "downloads", "https://api.uverest.com/*", "https://cognito-idp.us-east-1.amazonaws.com/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "uverest-extension@uverest.com", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content-scripts/content.js"]}, {"matches": ["https://*.goat.com/*"], "run_at": "document_idle", "js": ["content-scripts/goat-signals.js"], "world": "MAIN"}, {"matches": ["https://*.saksfifthavenue.com/*"], "run_at": "document_idle", "js": ["content-scripts/saks-signals.js"], "world": "MAIN"}, {"matches": ["https://uverest.com/*"], "js": ["content-scripts/uverest-sync.js"]}, {"matches": ["https://*.zara.com/*"], "run_at": "document_idle", "js": ["content-scripts/zara-signals.js"], "world": "MAIN"}], "web_accessible_resources": ["content-scripts/content.css"], "browser_action": {"default_title": "Uverest \u2014 try it on"}}