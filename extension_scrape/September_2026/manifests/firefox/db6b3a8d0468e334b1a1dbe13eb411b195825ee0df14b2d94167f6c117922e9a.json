{"manifest_version": 2, "name": "Random Curiosity Button", "version": "1.3", "description": "Click a button to receive a random curiosity prompt and spark learning.", "permissions": ["storage"], "browser_action": {"default_title": "Random Curiosity Button", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Random-Curiosity-Button", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}