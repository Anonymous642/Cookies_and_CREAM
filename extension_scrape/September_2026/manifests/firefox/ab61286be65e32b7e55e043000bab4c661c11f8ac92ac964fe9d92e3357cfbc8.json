{"manifest_version": 3, "name": "Twitch Multi-Chat Broadcaster", "version": "1.3", "description": "Send preset messages to all open Twitch chat tabs using OAuth.", "icons": {"128": "icon.jpg"}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.twitch.tv/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "preferred_environment": ["service_worker", "document"], "type": "classic"}, "action": {"default_popup": "popup.html", "default_title": ""}, "browser_specific_settings": {"gecko": {"id": "twitch-broadcaster@321extensions.co.uk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}