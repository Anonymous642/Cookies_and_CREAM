{"manifest_version": 3, "name": "Artistic Reality's AI Blacklist for Artists", "version": "1.0", "description": "A browser extension that alerts artists to websites that use their art.", "permissions": ["activeTab", "webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "Blacklist@artistic-reality.com", "strict_min_version": "109.0"}}, "host_permissions": ["https://ai.artistic-reality.com/*", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}