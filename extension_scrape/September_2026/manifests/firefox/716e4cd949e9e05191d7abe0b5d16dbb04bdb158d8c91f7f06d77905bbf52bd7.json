{"manifest_version": 3, "name": "Intention", "version": "1.0.5", "description": "Use Instagram intentionally. Feed scrolling gets interrupted, and closing your last Instagram tab logs you out automatically.", "permissions": ["browsingData", "cookies", "tabs", "storage"], "host_permissions": ["https://*.instagram.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Intention", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "welcome.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "intention-instagram@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}