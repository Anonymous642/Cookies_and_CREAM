{"manifest_version": 2, "name": "RepoSnatcher", "version": "1.0", "description": "Coleta URLs de reposit\u00f3rios GitHub diretamente das p\u00e1ginas de busca e facilita o download", "icons": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "48": "icons/icon-48.png"}, "permissions": ["activeTab", "storage", "tabs"], "content_scripts": [{"matches": ["*://github.com/*", "*://*.github.com/*"], "js": ["github-enhancer.js"], "css": ["github-enhancer.css"]}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "48": "icons/icon-48.png"}, "default_title": "RepoSnatcher", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "reposnatcher@seuprojeto.local", "strict_min_version": "91.0"}}}