{"manifest_version": 3, "name": "Nook", "version": "1.0.0", "description": "Save bookmarks to your self-hosted Nook instance", "browser_specific_settings": {"gecko": {"id": "nook@surajsbmn.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "contextMenus", "tabs"], "background": {"service_worker": "background/service-worker.js", "scripts": ["background/service-worker.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"]}], "commands": {"save-bookmark": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Save current page to Nook"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}