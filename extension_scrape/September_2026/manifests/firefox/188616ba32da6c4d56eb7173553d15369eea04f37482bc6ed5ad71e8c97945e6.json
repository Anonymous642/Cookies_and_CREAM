{"manifest_version": 3, "name": "Pod Your Way \u2014 Save to Podcast", "version": "0.2.1", "description": "Turn the article you're reading into an episode on your personal Pod Your Way podcast feed.", "permissions": ["activeTab", "scripting", "storage", "notifications"], "host_permissions": ["https://podyourway.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Save to Pod Your Way", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@podyourway.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}