{"manifest_version": 3, "name": "Siplet Radar Extension", "version": "1.2.0", "icons": {"48": "assets/siplet_logo_48.png", "128": "assets/siplet_logo_128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://backend.siplet.cc/*", "https://*.faceit.com/*"], "action": {"default_popup": "popup.html", "default_title": "Siplet Radar Extension"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.faceit.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://*.faceit.com/*"]}], "browser_specific_settings": {"gecko": {"id": "siplet-radar@local.ext", "data_collection_permissions": {"required": ["none"]}}}}