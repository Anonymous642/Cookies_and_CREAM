{"manifest_version": 2, "name": "JavaScript Permission Matrix", "version": "1.8.3.7", "description": "Put JavaScript features and Web APIs under your full control with JavaScript Permission Matrix (formerly JS Restrictions).", "icons": {"32": "icon.png"}, "background": {"scripts": ["common.js", "main.js"]}, "permissions": ["<all_urls>", "activeTab", "storage", "tabs", "unlimitedStorage", "webRequest"], "options_ui": {"page": "options.html"}, "browser_action": {"browser_style": true, "default_icon": {"32": "icon.png"}, "default_title": "JavaScript Permission Matrix", "default_popup": "popup.html"}, "web_accessible_resources": ["/inject.js"], "applications": {"gecko": {"id": "JSRestriction@anon", "strict_min_version": "59.0"}}}