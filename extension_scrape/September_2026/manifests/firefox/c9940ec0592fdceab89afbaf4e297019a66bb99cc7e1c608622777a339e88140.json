{"manifest_version": 3, "name": "CopyClean Pro", "version": "3.0.1", "description": "\u0423\u043c\u043d\u043e\u0435 \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u043e\u0447\u0438\u0441\u0442\u043a\u0430 \u0438 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u0435 \u0442\u0435\u043a\u0441\u0442\u0430 \u0441 \u0441\u0430\u0439\u0442\u043e\u0432", "browser_specific_settings": {"gecko": {"id": "copyclean@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "downloads", "activeTab", "scripting", "notifications", "tabs", "*://archive.org/*"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["archive-org-downloader.js", "background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"extract_content": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0447\u0438\u0442\u0430\u043b\u043a\u0443"}, "download_content": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "\u0421\u043a\u0430\u0447\u0430\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u043d\u0442"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/cleaner.js", "utils/markdown.js", "utils/history.js", "content.js"], "css": ["styles/reader.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles/*", "icons/*"], "matches": ["<all_urls>"]}]}