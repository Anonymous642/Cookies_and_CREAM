{"manifest_version": 2, "name": "Shortcut Manager", "version": "1.0.0", "description": "Manage your shortcuts and bookmarks with categories, export/import functionality, and offline support.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "notifications", "contextMenus", "identity", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Shortcut Manager"}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_security_policy": "script-src 'self'; object-src 'self'", "commands": {"open-shortcut-manager": {"suggested_key": {"default": "Alt+S"}, "description": "Open Shortcut Manager"}, "add-current-page": {"suggested_key": {"default": "Alt+A"}, "description": "Add current page to shortcuts"}}, "applications": {"gecko": {"id": "shortcut-manager@example.com", "strict_min_version": "67.0"}}, "author": "Musraf Khan", "homepage_url": "https://22cy033.netlify.app/"}