{"manifest_version": 3, "name": "SnipText", "version": "1.0.1", "description": "Snip any area of a webpage and extract text using OCR.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background/background.js", "scripts": ["background/background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "SnipText", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/snip.js"], "css": ["content/snip.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/*", "offscreen/*"], "matches": ["<all_urls>"]}], "commands": {"activate-snip": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Activate snippet tool"}}, "browser_specific_settings": {"gecko": {"id": "sniptext@snippet-extractor", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}