{"manifest_version": 3, "name": "Anti-Scam Shield", "version": "1.0", "description": "Detects and warns against online scams inside your browser and email.", "permissions": ["tabs", "activeTab", "scripting", "storage", "alarms"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://mail.google.com/*", "*://*.live.com/*", "*://*.outlook.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "antiscamshield@safeguard.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}