{"manifest_version": 3, "name": "Kadolijst.nl", "version": "1.0.0", "description": "Voeg kado's toe aan je kadolijst vanaf elke webshop", "browser_specific_settings": {"gecko": {"id": "addon@kadolijst.nl", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "authenticationInfo"]}}}, "permissions": ["activeTab", "scripting", "storage", "notifications"], "host_permissions": ["https://api.kadolijst.nl/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "default-src 'self'; img-src 'self' https://*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src https://api.kadolijst.nl"}}