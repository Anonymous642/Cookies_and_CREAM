{"manifest_version": 2, "name": "Therian/Otherkin Captcha", "version": "1.0.12", "description": "Replace \"I'm a human\" \"I'm not a robot\" with something more Therian/Otherkin-friendly. Covers reCAPTCHA, hCaptcha, Cloudflare Turnstile, Microsoft CAPTCHA, Friendly Captcha, and ALTCHA.", "icons": {"48": "icons/logo-48px.png", "96": "icons/logo-96px.png", "128": "icons/logo-128px.png", "512": "icons/logo-512px.png"}, "permissions": ["storage"], "browser_action": {"default_popup": "popup.html", "default_title": "Therian Captcha", "default_icon": "icons/logo-96px.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "therian-captcha@yokarion", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}