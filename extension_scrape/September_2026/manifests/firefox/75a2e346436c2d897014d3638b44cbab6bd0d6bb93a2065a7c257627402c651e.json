{"manifest_version": 3, "name": "Instagram Customizer", "version": "1.0", "description": "Instagram\u306e\u8981\u7d20\u3092\u975e\u8868\u793a\u306b\u3067\u304d\u308b\u62e1\u5f35\u6a5f\u80fd", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "\u8a2d\u5b9a\u3092\u958b\u304f"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "css": ["style.css"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "instagram-customizer@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}}