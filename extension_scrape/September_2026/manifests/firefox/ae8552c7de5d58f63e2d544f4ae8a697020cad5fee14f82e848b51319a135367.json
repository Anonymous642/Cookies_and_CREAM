{"manifest_version": 3, "name": "GlassBar \u2014 Ask AI about this page", "version": "0.4.1", "description": "A frosted-glass bottom bar to chat with Claude, GPT, Gemini, or any OpenAI-compatible model about whatever page you're on.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*", "https://api.x.ai/*", "https://api.groq.com/*", "https://api.deepseek.com/*", "https://extensionpay.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "scripts": ["ExtPay.js", "providers.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "glassbar@local.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "GlassBar", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"toggle-bar": {"suggested_key": {"default": "Alt+J"}, "description": "Show / hide the GlassBar bar"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["bar-ui.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}]}