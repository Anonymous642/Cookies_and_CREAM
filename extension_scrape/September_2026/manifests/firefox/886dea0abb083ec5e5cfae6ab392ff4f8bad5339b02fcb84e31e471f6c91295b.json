{"manifest_version": 3, "name": "WebPresenter - Assistant de pr\u00e9sentation Web", "version": "1.1.0", "description": "Cette extension permet de cr\u00e9er des mod\u00e8les de pr\u00e9sentation (sous forme de \"slides\") pour le web. Vous pouvez mettre en \u00e9vidence, num\u00e9roter, d\u00e9crire des \u00e9l\u00e9ments et dessiner directement sur une page web afin de faciliter la pr\u00e9sentation ou la formation directement sur un ou plusieurs sites web.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "web_accessible_resources": [{"resources": ["popup/popup.html", "popup/popup.js", "html2canvas.min.js", "styles.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["html2canvas.min.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_title": "WebPresenter", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg"}}, "icons": {"16": "icons/WebPresenterx16.png", "48": "icons/WebPresenterx48.png", "128": "icons/WebPresenterx128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "webpresenter@mallaury.be", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "websiteActivity"]}}}}