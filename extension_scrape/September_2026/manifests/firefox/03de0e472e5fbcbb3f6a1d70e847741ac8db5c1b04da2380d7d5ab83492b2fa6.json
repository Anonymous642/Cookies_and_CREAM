{"manifest_version": 3, "name": "Thunderstore Team Selector", "version": "1.1", "description": "Adds a team select menu instead of going to your first team.", "permissions": ["cookies", "storage"], "host_permissions": ["https://thunderstore.io/*", "https://new.thunderstore.io/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://thunderstore.io/*"], "js": ["content.js"]}, {"matches": ["https://new.thunderstore.io/*"], "js": ["new_content.js"]}], "icons": {"128": "Icon.png"}, "browser_specific_settings": {"gecko": {"id": "@thunderstore-team-viewer.atomictyler", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}}