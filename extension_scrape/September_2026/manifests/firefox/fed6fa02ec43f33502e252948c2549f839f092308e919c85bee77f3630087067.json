{"manifest_version": 3, "name": "One-Line Journal", "version": "1.1.0", "description": "A minimal, calming journal for capturing your thoughts, one line at a time", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "One-Line Journal"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://www.google-analytics.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}, "description": "Open One-Line Journal"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "one-line-journal@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}