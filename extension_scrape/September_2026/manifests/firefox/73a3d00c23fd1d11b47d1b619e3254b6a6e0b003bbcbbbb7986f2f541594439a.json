{"manifest_version": 2, "name": "9PM Link Opener", "version": "3.0", "description": "Opens links at 9 PM Eastern automatically.", "permissions": ["alarms", "storage", "tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "9pmopener@links", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}