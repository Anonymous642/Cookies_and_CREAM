{"manifest_version": 3, "name": "Not for You", "description": "Removes algorithmic and suggested content from social media sites.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "homepage_url": "https://notforyou.app", "permissions": ["storage", "declarativeNetRequest", "alarms"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://www.instagram.com/*", "*://instagram.com/*", "*://x.com/*", "*://twitter.com/*", "*://www.tiktok.com/*", "*://tiktok.com/*", "*://www.facebook.com/*", "*://facebook.com/*", "*://www.reddit.com/*", "*://reddit.com/*", "*://www.linkedin.com/*", "*://linkedin.com/*", "*://www.threads.com/*", "*://threads.com/*", "*://www.threads.net/*", "*://threads.net/*"], "browser_specific_settings": {"gecko": {"id": "extension@notforyou.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Not for You", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://facebook.com/*", "*://www.facebook.com/*"], "run_at": "document_start", "js": ["content-scripts/facebook.js"]}, {"matches": ["*://instagram.com/*", "*://www.instagram.com/*"], "run_at": "document_start", "js": ["content-scripts/instagram.js"]}, {"matches": ["*://linkedin.com/*", "*://www.linkedin.com/*"], "run_at": "document_start", "js": ["content-scripts/linkedin.js"]}, {"matches": ["*://reddit.com/*", "*://www.reddit.com/*"], "run_at": "document_start", "js": ["content-scripts/reddit.js"]}, {"matches": ["*://threads.com/*", "*://threads.net/*", "*://www.threads.com/*", "*://www.threads.net/*"], "run_at": "document_start", "js": ["content-scripts/threads.js"]}, {"matches": ["*://tiktok.com/*", "*://www.tiktok.com/*"], "run_at": "document_start", "js": ["content-scripts/tiktok.js"]}, {"matches": ["*://twitter.com/*", "*://x.com/*"], "run_at