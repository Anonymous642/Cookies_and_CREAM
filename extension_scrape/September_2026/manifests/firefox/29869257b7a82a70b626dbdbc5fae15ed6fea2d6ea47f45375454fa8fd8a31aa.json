{"manifest_version": 3, "name": "Image Album Creator", "version": "1.0.0", "description": "Select images on any web page, create an album, compress and upload to ImgBB, then send to upanh.me API.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "downloads", "scripting", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "preferred_environment": ["document", "service_worker"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "image-album-creator@yourdomain.com", "strict_min_version": "109.0"}}}