{"manifest_version": 3, "name": "Tab Time Machine", "version": "0.1.0", "description": "Saves and restores tab sessions", "browser_specific_settings": {"gecko": {"id": "tab-time-machine@fuyula.dev", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "src/background/index.js", "scripts": ["src/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/index.js"]}], "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"]}