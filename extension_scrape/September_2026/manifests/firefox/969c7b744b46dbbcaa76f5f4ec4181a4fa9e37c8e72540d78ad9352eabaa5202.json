{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "youtube-ui-cleaner@noshorts.nickmikheev", "data_collection_permissions": {"required": ["none"]}}}, "name": "YouTube UI Cleaner", "version": "1.0.0", "description": "Automatically hides YouTube Shorts content without any configuration", "author": "Developer", "homepage_url": "https://github.com/yourusername/youtube-ui-cleaner", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "permissions": ["activeTab", "storage"], "host_permissions": ["*://www.youtube.com/*"]}