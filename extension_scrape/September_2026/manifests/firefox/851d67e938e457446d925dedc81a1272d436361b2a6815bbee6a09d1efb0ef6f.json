{"manifest_version": 2, "name": "Adv-Microslop", "description": "The customized version of an extension that converts Microsoft to Microslop", "version": "1.0.6", "short_name": "Adv-Microslop", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "adv-microslop@ellosan", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "*://*/*"], "browser_action": {"default_title": "Adv-Microslop config", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}