{"manifest_version": 3, "name": "Cheapest Item Finder", "version": "1.0", "description": "Finds the cheapest price for a product on Amazon.", "permissions": ["activeTab", "scripting"], "host_permissions": ["https://www.amazon.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "cheapest-item-finder@yourdomain.com"}}}