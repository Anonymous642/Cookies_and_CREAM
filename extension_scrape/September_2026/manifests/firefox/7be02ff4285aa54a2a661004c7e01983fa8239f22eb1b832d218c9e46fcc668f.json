{"manifest_version": 3, "name": "Save to Knowgraphy", "description": "Save what you're reading to Knowgraphy \u2014 including the rendered page, so paywalled and JS-heavy articles arrive whole.", "version": "0.1.7", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://knowgraphy.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Save to Knowgraphy", "default_icon": {"16": "icon/ink-dark/16.png", "32": "icon/ink-dark/32.png", "48": "icon/ink-dark/48.png"}, "theme_icons": [{"light": "icon/ink-light/16.png", "dark": "icon/ink-dark/16.png", "size": 16}, {"light": "icon/ink-light/32.png", "dark": "icon/ink-dark/32.png", "size": 32}, {"light": "icon/ink-light/48.png", "dark": "icon/ink-dark/48.png", "size": 48}]}, "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save this page to Knowgraphy"}}, "browser_specific_settings": {"gecko": {"id": "{f3ee5067-ae14-4235-b7d2-5ff791fe62d6}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content-scripts/hackernews.js"]}, {"matches": ["https://lobste.rs/*"], "js": ["content-scripts/lobsters.js"]}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-scripts/twitter.js"]}]}