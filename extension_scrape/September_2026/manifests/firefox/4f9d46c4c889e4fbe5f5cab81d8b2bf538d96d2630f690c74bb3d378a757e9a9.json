{"manifest_version": 2, "name": "QR Toolkit", "version": "1.0.2.3", "description": "Turn text, links, or the page you are on into a QR code and save it as a PNG. Pick an error-correction level, generate from a right-click on selections or the page, and read QR codes from images via the context menu.", "icons": {"32": "images/icon-32.png", "48": "images/icon-48.png", "64": "images/icon-64.png", "96": "images/icon-96.png", "128": "images/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{1af3c15b-9817-4f99-b9fb-508f66e8917b}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "activeTab", "tabs", "notifications", "<all_urls>"], "background": {"scripts": ["app/qrcode.js", "app/background.js"]}, "browser_action": {"default_title": "QR Toolkit", "default_popup": "app/popup.html", "default_icon": {"32": "images/icon-32.png", "48": "images/icon-48.png", "64": "images/icon-64.png"}}}