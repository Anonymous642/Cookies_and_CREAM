{"manifest_version": 3, "name": "Descargador YT", "version": "1.0.0", "description": "Agrega un boton de descarga en YouTube que envia el video al descargador local (yt-dlp).", "permissions": ["storage"], "host_permissions": ["http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "descargador-yt@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "options.html", "default_title": "Descargador YT"}, "options_ui": {"page": "options.html", "open_in_tab": true}}