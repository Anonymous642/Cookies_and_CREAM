{"manifest_version": 2, "name": "Atil's M3U8 Detector", "version": "1.0", "description": "Detects M3U8 video streams and sends them to the video downloader script", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "tabs", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "M3U8 Detector", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "atils-m3u8-detector@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}