{"manifest_version": 3, "name": "Discord Token Manager", "version": "1.1", "description": "A minimalist, cozy-themed extension for power users.", "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}, "permissions": ["scripting", "activeTab"], "host_permissions": ["https://discord.com/*"], "browser_specific_settings": {"gecko": {"id": "discord-manager@pumpellocsak", "strict_min_version": "142.0", "data_collection_permissions": {"on_by_default": false, "required": ["none"]}}}}