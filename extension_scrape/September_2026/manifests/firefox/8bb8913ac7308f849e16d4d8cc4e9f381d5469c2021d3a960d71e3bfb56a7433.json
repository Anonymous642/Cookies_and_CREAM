{"manifest_version": 2, "name": "Easy 3-2-1 Revolver", "version": "1.1.3", "description": "Automatically rotate through open tabs. For signage, office displays, metrics and more.", "permissions": ["alarms", "activeTab", "storage", "tabs", "contextMenus"], "browser_specific_settings": {"gecko": {"id": "tabrotator@cpwgames.com", "strict_min_version": "79.0"}}, "browser_action": {"default_icon": {"32": "images/revolver_t_32.png", "48": "images/revolver_t_48.png", "128": "images/revolver_t_128.png"}, "default_title": "Easy 3-2-1 Revolver: Tab Rotation", "default_popup": "popup.html"}, "background": {"scripts": ["browser-polyfill.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content.js"]}], "web_accessible_resources": ["images/*"], "icons": {"32": "images/revolver_t_32.png", "48": "images/revolver_t_48.png", "128": "images/revolver_t_128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'", "minimum_chrome_version": "88", "author": "3-2-1 Extensions & Discord Bots"}