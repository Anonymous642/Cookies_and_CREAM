{"manifest_version": 3, "name": "CompilaCIE - Auto-compilazione", "description": "Legge la CIE dal lettore e compila in automatico i campi del tuo gestionale web. Basta mappare i campi una volta.", "version": "0.2.8", "action": {"default_title": "CompilaCIE", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "browser_specific_settings": {"gecko": {"id": "compilacie@compilacie.it", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}