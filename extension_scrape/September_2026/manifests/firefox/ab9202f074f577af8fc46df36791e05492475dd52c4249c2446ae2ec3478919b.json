{"manifest_version": 3, "name": "BabaSitaRam Pro Password Manager", "version": "5.31.0", "description": "AES-256 encrypted password manager with autofill, two-factor authentication, secure backups, and local vault storage.", "permissions": ["bookmarks", "storage", "unlimitedStorage", "clipboardWrite", "downloads", "alarms", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_start"}, {"matches": ["<all_urls>"], "js": ["share-inject.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["share.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';"}, "browser_specific_settings": {"gecko": {"id": "babasitaram-vault@babasitaram.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}}}