{"manifest_version": 3, "name": "IPONZ Linker", "version": "2.2.1", "description": "Create permanent links to searches on any of the IPONZ registers.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}, "action": {"default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}, "default_popup": "popup.html"}, "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "@iponz-linker", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["http://iponz.link/?*", "https://iponz.link/?*"], "js": ["url-content-script.js"], "run_at": "document_start"}, {"matches": ["https://app.iponz.govt.nz/app/Extra/IP/*"], "js": ["proxy-click.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://app.iponz.govt.nz/app/Extra/IP/*"], "js": ["mappings.js", "search-content-script.js"], "run_at": "document_end"}]}