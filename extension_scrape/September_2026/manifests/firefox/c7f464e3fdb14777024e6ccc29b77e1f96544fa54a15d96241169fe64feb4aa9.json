{"manifest_version": 2, "name": "Wrap", "version": "0.3.0", "description": "Capture and re-inject AI chat context locally.", "homepage_url": "https://github.com/Penitant/wrap-ext-release", "permissions": ["storage", "nativeMessaging", "notifications", "https://chatgpt.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*"], "background": {"scripts": ["dist/background/service-worker.js"]}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Wrap", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "wrap@getwrap.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["dist/content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["dist/content-scripts/claude.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*"], "js": ["dist/content-scripts/perplexity.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["dist/content-scripts/gemini.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}