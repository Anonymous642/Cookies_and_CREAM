{"manifest_version": 3, "name": "Igloo: AI Focus for YouTube", "version": "1.5.0", "description": "Start a task, set a timer, and let AI filter distracting YouTube recommendations and Shorts so you actually stay focused.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background/sw.js"], "type": "module"}, "options_page": "options/index.html", "commands": {"toggle-enabled": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle Igloo on/off"}}, "content_scripts": [{"matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/bootstrap.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://focuslens-api.insipidrust.workers.dev/*", "https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"], "web_accessible_resources": [{"resources": ["icons/Igloo.png", "icons/Logo4.png", "icons/Logo5.png"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "igloo@visualbite.net", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}}}}