{"manifest_version": 3, "name": "Mask Mate - Screen & Privacy Redactor", "version": "1.1.36", "description": "Highlight, blur, black out, or replace sensitive info on any webpage before taking screenshots.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup/popup.html", "default_title": "Mask Mate Control Panel", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start", "all_frames": false}], "background": {"scripts": ["background/background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-maskmate-panel": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Open/Close Mask Mate Control Panel"}, "toggle-inspect": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Start/Stop Redactor Inspector"}, "toggle-live-typing": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Toggle Stealth Live Typing Mask"}}, "browser_specific_settings": {"gecko": {"id": "maskmate@getmaskmate.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}