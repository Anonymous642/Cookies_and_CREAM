{"manifest_version": 2, "name": "YouTube Auto Refresh", "version": "1.0", "description": "Automatically refreshes YouTube videos once upon initial load", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_end"}], "permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-auto-refresh@example.com", "data_collection_permissions": {"required": ["none"]}}}}