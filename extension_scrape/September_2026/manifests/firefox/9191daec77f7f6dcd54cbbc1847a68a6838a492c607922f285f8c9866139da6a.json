{"manifest_version": 3, "name": "PasteNest", "version": "1.0", "description": "A modern clipboard manager for Firefox.", "permissions": ["storage", "clipboardRead"], "browser_specific_settings": {"gecko": {"id": "pastenest@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}