{"manifest_version": 3, "name": "Smart Form Autofill", "version": "2.4.0", "description": "AI-powered autofill across websites with multi-profile support.", "browser_specific_settings": {"gecko": {"id": "smart-form-autofill@priyanshuvishwakarma", "strict_min_version": "109.0"}}, "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "assets/logo_16.png", "32": "assets/logo_32.png", "48": "assets/logo_48.png", "128": "assets/logo_128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/logo_16.png", "32": "assets/logo_32.png", "48": "assets/logo_48.png", "128": "assets/logo_128.png"}}, "background": {"scripts": ["browser-poly.js", "background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["browser-poly.js", "content.js"], "run_at": "document_idle"}]}