{"manifest_version": 3, "name": "C64Cade Ultimate Bridge", "version": "1.0.1", "description": "Connect C64Cade to Commodore 64 Ultimate, Ultimate 64, or a real C64 with Ultimate 2+ cart to launch games and track achievements.", "permissions": ["storage"], "optional_host_permissions": ["http://*/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://c64cade.com/*", "https://www.c64cade.com/*"], "js": ["src/content-script.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/page-bridge.js"], "matches": ["https://c64cade.com/*", "https://www.c64cade.com/*"]}], "options_page": "src/options.html", "action": {"default_title": "C64Cade Ultimate Bridge", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "ultimate-bridge@c64cade.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}