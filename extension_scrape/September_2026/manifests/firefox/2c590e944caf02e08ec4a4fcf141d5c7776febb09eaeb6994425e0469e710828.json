{"manifest_version": 3, "name": "Reddit Removed Posts Viewer", "version": "1.1.5", "description": "View removed/deleted Reddit posts and comments using Arctic Shift archive. Works on /new pages and user profiles.", "permissions": [], "host_permissions": ["https://old.reddit.com/*", "https://arctic-shift.photon-reddit.com/*"], "content_scripts": [{"matches": ["https://old.reddit.com/r/*/new", "https://old.reddit.com/r/*/new/", "https://old.reddit.com/r/*/new/*", "https://old.reddit.com/user/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "reddit-removed-viewer@photon-shift.extensions", "strict_min_version": "109.0"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}}