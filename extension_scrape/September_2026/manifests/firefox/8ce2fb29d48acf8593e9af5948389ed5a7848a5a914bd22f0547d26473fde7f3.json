{"manifest_version": 3, "name": "Tanoth Companion", "version": "3.6.3", "description": "Voidsmith Industries companion extension for Tanoth 3.6.3.", "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://*.tanoth.gameforge.com/*", "https://voidsmithindustries.com/*", "https://media.moddb.com/*", "https://pp-api.sokin.xyz/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.tanoth.gameforge.com/main/client/*"], "js": ["suffix-observer-bootstrap.js"], "run_at": "document_start"}, {"matches": ["https://*.tanoth.gameforge.com/main/client/*"], "js": ["i18n-literals-core.js", "i18n-literals-settings.js", "i18n-literals-detail.js", "i18n-patterns.js", "i18n.js", "content-isolated.js", "dungeon-intelligence-core.js", "tanoth-runtime.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-automation": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start or stop Tanoth Companion automation"}, "toggle-logs": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Toggle the Actions and Logs panel"}, "assess-equip": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Run Auto-Equip assessment now"}}, "browser_specific_settings": {"gecko": {"id": "tanoth-companion@voidsmithindustries.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity", "websiteContent"]}}}}