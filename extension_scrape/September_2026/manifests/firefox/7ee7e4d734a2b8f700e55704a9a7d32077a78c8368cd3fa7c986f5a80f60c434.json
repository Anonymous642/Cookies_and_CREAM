{"manifest_version": 2, "name": "Streamer Mode for Lichess", "description": "Hide every Lichess username while streaming. You become Streamer, your opponent Opponent \u2014 stop stream-sniping in one click.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "commands": {"toggle-streamer-mode": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Streamer Mode for Lichess on/off"}}, "browser_specific_settings": {"gecko": {"id": "lichess-streamer-mode@cadenmackenzie", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Streamer Mode for Lichess", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.lichess.org/*", "*://lichess.org/*"], "run_at": "document_start", "js": ["content-scripts/lichess.js"]}]}