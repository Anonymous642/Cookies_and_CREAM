{"manifest_version": 2, "name": "Shazam-lite (Recognize from Tab)", "version": "1.0.0", "description": "Lightweight identify button: grab a short audio snippet from the active tab, compute a simple fingerprint (spectral heuristic), match against a local mini DB, and show title/artist if found.", "permissions": ["activeTab", "storage", "tabs", "downloads"], "browser_action": {"default_popup": "popup.html", "default_title": "Shazam-lite"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icon.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "shazamlite@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}