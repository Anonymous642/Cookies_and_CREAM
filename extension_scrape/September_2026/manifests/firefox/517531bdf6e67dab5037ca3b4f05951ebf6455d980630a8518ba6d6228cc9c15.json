{"manifest_version": 2, "name": "GH Highlight Me", "description": "Highlights your GitHub username and custom identifiers on issues, PRs, comments, reviews, and commits.", "version": "1.1.0", "permissions": ["activeTab", "storage", "https://github.com/*"], "browser_specific_settings": {"gecko": {"id": "gh-highlight-me@nalbam.github.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["highlight.css"], "run_at": "document_end"}], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "GH Highlight Me"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}