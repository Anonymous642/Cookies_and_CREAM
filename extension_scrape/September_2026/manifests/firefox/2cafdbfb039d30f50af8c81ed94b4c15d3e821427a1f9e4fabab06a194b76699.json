{"manifest_version": 3, "name": "Tab Picker", "version": "1.3.3", "author": "gstaha", "description": "Puts a keyboard mark on every tab in the window. Press the shortcut, press the mark, you are there. One keystroke, however many tabs are open.", "browser_specific_settings": {"gecko": {"id": "tab-picker@gstaha", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "scripting", "storage", "activeTab"], "background": {"scripts": ["marks.js", "picker.js", "background.js"]}, "commands": {"pick-tab": {"suggested_key": {"default": "Alt+A"}, "description": "Show the tab marks and pick a tab"}}, "action": {"default_title": "Tab Picker", "default_popup": "popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}