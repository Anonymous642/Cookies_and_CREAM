{"manifest_version": 2, "name": "Private Redirector", "version": "2.0.2", "description": "Route selected sites to Private Windows, redirect URLs, block links, and keep matching URLs out of your normal Firefox session.", "permissions": ["webRequest", "webRequestBlocking", "tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://facebook.com/*", "*://*.facebook.com/*", "*://fb.com/*", "*://*.fb.com/*", "*://m.me/*", "*://*.m.me/*", "*://messenger.com/*", "*://*.messenger.com/*"], "js": ["content-facebook.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}, "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "private-redirector@example.local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}