{"manifest_version": 2, "name": "Unforge", "version": "1.0.1", "description": "Extension for the Unforge authentication platform. It enables Unforge session information to be displayed in Google Calendar.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Unforge"}, "background": {"scripts": ["browser-polyfill.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["browser-polyfill.js", "content.js"]}], "permissions": ["activeTab", "storage", "https://api.unforge.co/*"], "web_accessible_resources": ["SpaceGrotesk-VariableFont_wght.ttf"], "browser_specific_settings": {"gecko": {"id": "firefox-browser-extension@unforge.co", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}