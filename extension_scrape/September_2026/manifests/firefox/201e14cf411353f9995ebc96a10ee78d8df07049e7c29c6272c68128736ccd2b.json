{"manifest_version": 3, "name": "SlashGo Links", "description": "go/ links for your whole team. Resolve and create go/<name> shortcuts from any page.", "version": "1.3.1", "icons": {"48": "public/logo.png"}, "action": {"default_icon": {"48": "public/logo.png"}, "default_popup": "src/popup/index.html"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "activeTab", "contextMenus", "alarms"], "host_permissions": ["https://slashgo.io/*", "https://www.google.com/*", "https://www.google.co.uk/*", "https://www.google.ca/*", "https://www.google.com.au/*", "https://www.google.de/*", "https://www.google.fr/*", "https://www.bing.com/*", "http://go/*", "https://go/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect-go-links", "enabled": true, "path": "rules.json"}]}, "omnibox": {"keyword": "go"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Open SlashGo quick-link popup"}}, "background": {"type": "module", "scripts": ["service-worker-loader.js"]}, "browser_specific_settings": {"gecko": {"id": "slashgo@slashgo.io", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}}