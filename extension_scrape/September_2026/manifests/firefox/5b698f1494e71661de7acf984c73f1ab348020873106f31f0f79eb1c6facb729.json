{"manifest_version": 3, "name": "Tab Transfer", "version": "1.0", "description": "Save and sync your open tabs.", "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "tabtransfer@tabtransfer.org", "strict_min_version": "109.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/ttlogo1.png"}}, "icons": {"128": "icons/ttlogo1.png"}, "web_accessible_resources": [{"resources": ["home.html", "signup.html"], "matches": ["<all_urls>"]}]}