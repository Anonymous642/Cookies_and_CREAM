{"manifest_version": 3, "name": "Lionwheel - Customer Notes (Cloud)", "version": "0.1.0", "description": "Permanent customer notes synced via Supabase.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Lionwheel Notes", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "alarms"], "host_permissions": ["https://members.lionwheel.com/*", "https://*.supabase.co/*"], "browser_specific_settings": {"gecko": {"id": "lionwheel-notes-cloud@anipet.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}, "gecko_android": {"strict_min_version": "121.0"}}, "content_scripts": [{"matches": ["https://members.lionwheel.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "options_page": "options.html", "web_accessible_resources": [{"resources": ["content.css"], "matches": ["https://members.lionwheel.com/*"]}]}