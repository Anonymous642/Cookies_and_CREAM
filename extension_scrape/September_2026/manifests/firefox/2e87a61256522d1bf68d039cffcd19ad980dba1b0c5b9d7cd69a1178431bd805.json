{"manifest_version": 3, "name": "Sugoi Manga Translator", "version": "1.1.3", "description": "Translate manga images on any webpage using Sugoi Manga Translator", "permissions": ["storage", "tabs", "downloads", "scripting", "activeTab", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>", "https://us.i.posthog.com/*"], "browser_specific_settings": {"gecko": {"id": "sugoi-manga-translator@sugoitoolkit.com", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}