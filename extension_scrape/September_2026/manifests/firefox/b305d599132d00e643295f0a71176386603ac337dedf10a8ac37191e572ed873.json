{"manifest_version": 2, "name": "LinkedIn Company Website Opener", "version": "1.0", "description": "Opens a company's website from its LinkedIn page.", "permissions": ["activeTab", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Open Company Website", "default_icon": "icons/icon.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/company/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "{62dcbdba-2bf1-41f9-a485-b40f75d1c2ab}"}}}