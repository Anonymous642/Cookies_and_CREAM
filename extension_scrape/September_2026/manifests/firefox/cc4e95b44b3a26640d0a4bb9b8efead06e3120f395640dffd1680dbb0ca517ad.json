{"manifest_version": 2, "name": "Chat Index \u2014 federicocalo.dev", "description": "Cartelle e ricerca full-text nel corpo delle conversazioni AI (ChatGPT, Claude, Gemini). Indicizzazione automatica e locale, 100% offline, zero telemetria.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "unlimitedStorage", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "browser_specific_settings": {"gecko": {"id": "chat-index@federicocalo.dev", "strict_min_version": "109.0"}}, "data_collection_permissions": {"required": ["none"]}, "browser_action": {"default_title": "Chat Index", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}