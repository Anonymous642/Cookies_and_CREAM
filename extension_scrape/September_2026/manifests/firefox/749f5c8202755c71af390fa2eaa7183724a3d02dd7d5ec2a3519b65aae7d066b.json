{"manifest_version": 3, "version": "6.19.3", "name": "CthulhuJs (Anti-Fingerprint)", "description": "Generate a new fingerprint with one click, and each window can be a different browser", "homepage_url": "https://lxs2000.github.io/cthulhurs-doc/dist/zh/", "default_locale": "en", "permissions": ["storage", "tabs", "cookies", "activeTab", "background", "scripting", "webNavigation", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "icons": {"16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png"}, "content_scripts": [], "background": {"scripts": ["background/background.js"]}, "action": {"default_icon": "assets/logo.png", "default_popup": "index.html"}, "web_accessible_resources": [{"resources": ["img/*", "icon/*", "js/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self'; child-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "lxs001221@gmail.com", "strict_min_version": "58.0"}}}