{"manifest_version": 3, "name": "Basalt", "version": "2.0.5", "description": "Passw\u00f6rter und Passkeys aus der Basalt-Desktop-App im Browser nutzen", "homepage_url": "https://github.com/basalt-app/basalt", "browser_specific_settings": {"gecko": {"id": "@basalt-browser", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Basalt", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["nativeMessaging", "activeTab", "scripting", "storage", "webRequest", "webRequestAuthProvider"], "optional_permissions": ["privacy"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["page-script.js"], "matches": ["http://*/*", "https://*/*"]}]}