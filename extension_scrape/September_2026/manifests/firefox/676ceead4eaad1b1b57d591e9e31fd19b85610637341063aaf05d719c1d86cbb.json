{"manifest_version": 3, "name": "User Auto Fill Extension", "version": "1.0.1", "description": "Automatically fill forms with saved data", "browser_specific_settings": {"gecko": {"id": "user-auto-fill@yourdomain.com"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}