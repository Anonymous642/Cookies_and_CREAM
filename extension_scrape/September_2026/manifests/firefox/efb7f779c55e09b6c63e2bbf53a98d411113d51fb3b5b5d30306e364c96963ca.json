{"manifest_version": 2, "name": "Grok Response Notifier", "version": "1.2", "description": "Plays a soft ping when Grok finishes a response on x.com or grok.com, using partial SVG path selectors. Requires user to enable audio via the popup.", "icons": {"128": "icon.png"}, "permissions": ["notifications", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://grok.com/*"], "js": ["content.js"]}], "web_accessible_resources": ["beep.mp3"], "browser_specific_settings": {"gecko": {"id": "grok-response-notifier@example.com"}}}