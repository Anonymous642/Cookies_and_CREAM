{"manifest_version": 3, "name": "Gfycat Resurrected", "version": "1.0", "description": "Redirect gfycat urls to Web Archive versions.", "author": "boiledpotato23", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["webNavigation", "storage"], "browser_specific_settings": {"gecko": {"id": "gfycat-resurrected@boiledpotato23", "strict_min_version": "129.0"}, "gecko_android": {"id": "gfycat-resurrected@boiledpotato23", "strict_min_version": "129.0"}}, "content_scripts": [{"js": ["content.js"], "matches": ["https://web.archive.org/web/*"]}], "background": {"scripts": ["worker.js"], "service_worker": "worker.js"}, "action": {"default_title": "Gfycat Resurrected", "default_popup": "popup/popup.html", "default_icon": "images/icon.png"}}