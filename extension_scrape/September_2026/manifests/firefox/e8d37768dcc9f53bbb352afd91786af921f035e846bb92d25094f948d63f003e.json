{"manifest_version": 2, "name": "Correctify", "version": "1.6", "description": "Le correcteur IA instantan\u00e9 pour Firefox. S\u00e9lectionnez n'importe quel texte (champ, zone de texte, \u00e9diteur riche, mail en ligne) et corrigez-le par clic droit. La langue est d\u00e9tect\u00e9e automatiquement.", "permissions": ["activeTab", "storage", "menus", "contextMenus", "scripting", "<all_urls>", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://api.mistral.ai/*", "https://openrouter.ai/*", "https://correctify.fr/*"], "background": {"scripts": ["i18n.js", "catalog.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Correctify", "default_icon": {"128": "icons/icon.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.png", "128": "icons/icon.png"}, "web_accessible_resources": ["icons/icon.png"], "browser_specific_settings": {"gecko": {"id": "Correctify@Anonyma", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}