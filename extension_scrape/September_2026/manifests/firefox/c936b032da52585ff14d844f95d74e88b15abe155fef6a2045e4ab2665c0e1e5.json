{"manifest_version": 3, "name": "Reddit Speed Bump", "version": "1.1", "permissions": ["scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "speed-bump@example.com", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://*.reddit.com/*"], "description": "Requires a 10-second hold to access Reddit homepages.", "action": {"default_popup": "options.html"}, "options_page": "options.html", "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_start"}]}