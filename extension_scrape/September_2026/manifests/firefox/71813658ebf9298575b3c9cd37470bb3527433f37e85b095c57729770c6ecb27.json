{"manifest_version": 3, "name": "WeatherLens", "version": "1.0.0", "description": "Beautiful weather app with stunning glassmorphism UI, animated backgrounds, 7-day forecasts, and detailed metrics. Your weather companion.", "icons": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_icon": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png"}, "default_title": "WeatherLens - Beautiful Weather", "default_popup": "src/components/popup.html"}, "permissions": ["storage", "geolocation"], "host_permissions": ["https://api.openweathermap.org/*"], "browser_specific_settings": {"gecko": {"id": "weatherlens@weather.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}