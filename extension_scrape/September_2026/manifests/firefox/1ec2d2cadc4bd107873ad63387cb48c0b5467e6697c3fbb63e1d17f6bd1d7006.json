{"manifest_version": 3, "name": "Seep - Language Learning", "description": "Learn Chinese by browsing the Internet. Seep brings comprehensible input and immersion directly to you.", "version": "1.0.8.1", "browser_specific_settings": {"gecko": {"id": "seep@seeplearning.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "alarms", "scripting", "contextMenus"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["seep.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["content/*.js", "content/util/*.js", "content/page/*.js", "content/prefs/*.js", "content/auth/*.js", "content/tutorial/*.js", "content/vocab/*.js", "content/segmentation/*.js", "content/render/*.js", "content/cross-inline/*.js", "content/settings-panel/*.js", "content/sidebar/*.js", "dictionary/*.js", "event-log/*.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Seep", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "host_permissions": ["<all_urls>"]}