{"manifest_version": 3, "name": "MorseCode", "version": "1.0.0", "description": "Morse code translator. Translate between text and Morse code easily.", "icons": {"48": "morse-icons/icon-48.png", "96": "morse-icons/icon-96.png", "128": "morse-icons/icon-128.png"}, "action": {"default_icon": {"48": "morse-icons/icon-48.png", "96": "morse-icons/icon-96.png"}, "default_title": "MorseCode", "default_popup": "morse-ui/translator.html"}, "permissions": ["clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "morsecode@morse.translator", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}