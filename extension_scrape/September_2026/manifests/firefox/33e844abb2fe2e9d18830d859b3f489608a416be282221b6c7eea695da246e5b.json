{"manifest_version": 2, "name": "Focus Marathon \u2014 Study Timer & Tracker", "short_name": "Focus Marathon", "version": "1.0.0", "description": "A YPT-style study timer: track subjects, block distractions, plan your day, and see your progress daily to yearly.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"page": "background.html", "persistent": true}, "commands": {"toggle-timer": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Start/stop timer for your last-used subject"}}, "permissions": ["storage", "alarms", "notifications", "webRequest", "webRequestBlocking", "<all_urls>"], "web_accessible_resources": ["blocked.html", "blocked.css"], "browser_specific_settings": {"gecko": {"id": "focus-marathon@local.study-extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}