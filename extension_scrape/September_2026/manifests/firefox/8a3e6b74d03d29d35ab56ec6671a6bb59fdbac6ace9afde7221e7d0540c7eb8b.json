{"manifest_version": 3, "name": "Safer2Search", "version": "1.0.0", "short_name": "Safer2Search", "description": "This extension sets your search to Safer2Search to provide you with a one click safe search and browsing experience.", "icons": {"16": "./assets/images/16x16.png", "96": "./assets/images/96x96.png", "128": "./assets/images/128x128.png"}, "background": {"page": "page.html"}, "browser_specific_settings": {"gecko": {"id": "info@redrootltd.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "cookies"], "host_permissions": ["*://*.safer2searchapp.com/*", "*://*.yahoo.com/*"], "action": {"default_icon": {"16": "./assets/images/16x16.png"}, "default_popup": "switch.html", "default_title": "Safer2Search"}, "chrome_settings_overrides": {"homepage": "https://www.safer2searchapp.com", "search_provider": {"name": "Safer2Search", "keyword": "Safer2Search", "search_url": "https://search.yahoo.com/search?p={searchTerms}&vm=r", "suggest_url": "https://sug.safer2searchapp.com/complete/search?q={searchTerms}&client=firefox&ie=utf-8&oe=utf-8&hl=en-US", "encoding": "UTF-8", "is_default": true}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "homepage_url": "https://www.safer2searchapp.com/"}