{"manifest_version": 3, "name": "Edge Tools Bridge", "description": "Relays cross-origin HTTP requests for the Edge Tools website so browser tools can reach the internet.", "version": "0.2.4", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["<all_urls>"], "permissions": ["declarativeNetRequestWithHostAccess", "webRequest", "webRequestBlocking"], "content_scripts": [{"matches": ["https://edge-tools.xyz/*", "https://app.edgetools.io/*"], "js": ["content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bridge@edge-tools.xyz", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}