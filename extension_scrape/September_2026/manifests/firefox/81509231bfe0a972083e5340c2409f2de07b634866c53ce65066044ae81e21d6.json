{"manifest_version": 3, "name": "Easy Link for Etsy", "version": "1.0.0", "description": "Copies a short, tracking-free link from Etsy listing, shop and search pages.", "browser_specific_settings": {"gecko": {"id": "{5987044a-85b3-4805-822e-f1e3e12176dd}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.etsy.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}