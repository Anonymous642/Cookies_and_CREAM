{"manifest_version": 3, "name": "Site Watch Dog", "version": "1.0.0", "description": "Track time spent on websites and get alerts when you exceed usage limits. Browsing data is stored locally.", "browser_specific_settings": {"gecko": {"id": "sitewatchdog@sitewatchdog.co.za", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "tabs", "alarms", "notifications"], "host_permissions": ["https://api.sitewatchdog.co.za/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}