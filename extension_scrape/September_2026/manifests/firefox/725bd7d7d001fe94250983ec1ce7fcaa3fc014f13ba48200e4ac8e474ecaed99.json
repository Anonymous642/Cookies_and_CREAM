{"manifest_version": 3, "name": "Hacker Space", "short_name": "Hacker Space", "version": "1.4.0", "description": "Replace your new tab with a random Hacker News story and a short AI summary.", "browser_specific_settings": {"gecko": {"id": "hacker-space@tinkerers.space", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "host_permissions": ["https://hn.tinkerers.space/*", "https://hacker-news.firebaseio.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}