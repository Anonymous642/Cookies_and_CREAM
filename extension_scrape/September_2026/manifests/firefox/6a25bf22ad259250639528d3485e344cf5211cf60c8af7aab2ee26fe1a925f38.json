{"manifest_version": 3, "name": "YTM Song Filter", "version": "1.0.4", "description": "Automatically skip YouTube Music tracks containing user-specified keywords.", "browser_specific_settings": {"gecko": {"id": "ytmsongfilter@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://music.youtube.com/*"], "action": {"default_popup": "popup.html"}, "icons": {"48": "icons/ytmsfilterlogo48.png", "96": "icons/ytmsfilterlogo96.png"}, "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["ytmsongfilter.js"]}]}