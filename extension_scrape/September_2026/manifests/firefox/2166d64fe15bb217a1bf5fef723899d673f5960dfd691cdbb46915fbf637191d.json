{"manifest_version": 3, "name": "SaveClipX: Video Downloader and Transcript", "version": "1.0.0", "description": "Save the video you are watching in one click, or turn it into audio or a written transcript.", "permissions": ["activeTab", "contextMenus", "storage", "tabs", "notifications", "alarms"], "host_permissions": ["https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.threads.com/*", "https://*.threads.net/*", "https://*.douyin.com/*", "https://*.snapchat.com/*", "https://*.linkedin.com/*", "https://*.vimeo.com/*", "https://*.dailymotion.com/*", "https://*.rumble.com/*", "https://*.tumblr.com/*", "https://*.pinterest.com/*", "https://*.bilibili.com/*", "https://b23.tv/*", "https://bilibili.tv/*", "https://*.bilibili.tv/*", "https://*.reddit.com/*", "https://saveclipx.com/*", "https://*.saveclipx.com/*"], "action": {"default_popup": "popup.html", "default_title": "Save with SaveClipX", "default_icon": {"128": "icon-128.png"}}, "background": {"scripts": ["config.js", "quotes.js", "nudges.js", "background.js"]}, "content_scripts": [{"matches": ["https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.threads.com/*", "https://*.threads.net/*", "https://*.douyin.com/*", "https://*.snapchat.com/*", "https://*.linkedin.com/*", "https://*.vimeo.com/*", "https://*.dailymotion.com/*", "https://*.rumble.com/*", "https://*.tumblr.com/*", "https://*.pinterest.com/*", "https://*.bilibili.com/*", "https://b23.tv/*", "https://bilibili.tv/*", "https://*.bilibili.tv/*", "https://*.reddit.com/*"], "js": ["menu.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://saveclipx.com/*", "https://*.saveclipx.com/*"], "js": ["verify.js"], "run_at": "document_start", "all_frames": false}], "icons": {"128": "icon-128.png", "512": "icon-512.png"}, "commands": {