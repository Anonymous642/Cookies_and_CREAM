{"manifest_version": 3, "name": "BotScore", "description": "Score how well pages work for bots and LLM crawlers. Audits run locally in your browser.", "version": "1.0.6", "icons": {"16": "icon/BotScore_Logo-16.png", "32": "icon/BotScore_Logo-32.png", "48": "icon/BotScore_Logo-48.png", "96": "icon/BotScore_Logo-96.png", "128": "icon/BotScore_Logo-128.png"}, "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open BotScore"}, "browser_specific_settings": {"gecko": {"id": "botscore@botscore.io", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": {"16": "icon/BotScore_Logo-16.png", "32": "icon/BotScore_Logo-32.png"}, "default_title": "BotScore", "open_at_install": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}