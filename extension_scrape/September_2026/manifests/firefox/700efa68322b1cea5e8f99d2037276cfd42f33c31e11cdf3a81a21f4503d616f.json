{"manifest_version": 3, "name": "Moodchat", "version": "1.4.1", "description": "Native Firefox sidebar for AI chat providers with element picker context capture.", "browser_specific_settings": {"gecko": {"id": "moodchat@moodinfinite", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content/toolbar.js"], "css": ["content/toolbar.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/picker.css", "content/toolbar.css"], "matches": ["<all_urls>"]}], "sidebar_action": {"default_title": "Moodchat", "default_panel": "sidebar.html", "default_icon": "icons/icon.svg", "open_at_install": true}, "action": {"default_title": "Open Moodchat sidebar", "default_icon": "icons/icon.svg", "theme_icons": [{"light": "icons/icon-light-16.png", "dark": "icons/icon-dark-16.png", "size": 16}, {"light": "icons/icon-light-32.png", "dark": "icons/icon-dark-32.png", "size": 32}, {"light": "icons/icon-light-48.png", "dark": "icons/icon-dark-48.png", "size": 48}, {"light": "icons/icon-light-64.png", "dark": "icons/icon-dark-64.png", "size": 64}, {"light": "icons/icon-light-96.png", "dark": "icons/icon-dark-96.png", "size": 96}]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}