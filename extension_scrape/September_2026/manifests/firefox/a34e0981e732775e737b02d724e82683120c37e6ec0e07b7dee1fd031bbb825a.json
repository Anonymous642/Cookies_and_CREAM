{"manifest_version": 2, "name": "Wikipedia search engine", "version": "1.1", "description": "Adds a search engine that searches wikipedia.org", "homepage_url": "https://github.com/HarryWhitehorn/firefox-wikipedia-search", "icons": {"48": "icons/wiki_icon-48.png", "96": "icons/wiki_icon-96.png", "128": "icons/wiki_icon-128.png"}, "browser_specific_settings": {"gecko": {"strict_min_version": "65.0", "id": "{a606270a-d15a-4b8d-84cc-c0ce9c97e19e}"}}, "chrome_settings_overrides": {"search_provider": {"name": "Wikipedia", "search_url": "https://en.wikipedia.org/w/index.php?search={searchTerms}", "keyword": "wiki", "favicon_url": "https://en.wikipedia.org/static/favicon/wikipedia.ico", "is_default": false, "encoding": "UTF-8"}}}