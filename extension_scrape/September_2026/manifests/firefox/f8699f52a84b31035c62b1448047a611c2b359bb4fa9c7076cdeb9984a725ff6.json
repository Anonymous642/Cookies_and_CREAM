{"manifest_version": 2, "name": "Profile Analyzer", "version": "1.3", "description": "Analyze public profile pages and provide basic insights such as activity level, keywords, and engagement signals.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Profile Analyzer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Profile-Analyzer", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}