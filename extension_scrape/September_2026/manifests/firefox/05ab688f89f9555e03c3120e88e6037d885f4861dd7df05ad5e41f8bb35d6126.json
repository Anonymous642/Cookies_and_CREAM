{"manifest_version": 3, "name": "Stay Audible for TikTok", "version": "1.0.2", "description": "Keeps TikTok audio playing when its window or tab is not focused.", "browser_specific_settings": {"gecko": {"id": "stay-audible@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://*.tiktok.com/*"], "action": {"default_title": "Stay Audible", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.tiktok.com/*"], "js": ["stay-audible.js"], "run_at": "document_start", "world": "MAIN"}]}