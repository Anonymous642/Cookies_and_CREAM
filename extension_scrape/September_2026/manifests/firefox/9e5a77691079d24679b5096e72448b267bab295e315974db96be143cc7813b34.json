{"manifest_version": 2, "name": "SlyKiwi \u2014 Creator Analytics & Post Scoring", "description": "Score your posts before publishing, see which tags actually perform, and which ones pair well together.", "version": "0.11.3", "icons": {"16": "icon-16.png", "32": "icon-16.png", "48": "icon-48.png", "96": "icon-48.png", "128": "icon-128.png", "256": "icon-128.png"}, "permissions": ["storage", "https://fansly.com/*", "https://slykiwi.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@slykiwi.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "web_accessible_resources": ["icon-16.png", "icon-48.png", "icon-128.png"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "SlyKiwi", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://fansly.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["https://slykiwi.com/*"], "run_at": "document_idle", "js": ["content-scripts/slykiwi-bridge.js"]}]}