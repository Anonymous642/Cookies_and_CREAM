{"manifest_version": 2, "name": "DDG Guilt Trip", "description": "Reminds you to try privacy alternatives when using specific DuckDuckGo !bangs like !g or !yt.", "version": "0.1.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "permissions": ["storage", "webNavigation", "*://duckduckgo.com/*"], "browser_specific_settings": {"gecko": {"id": "ddg-guilt-trip@teismar.github.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "DDG Guilt Trip", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.reddit.com/*", "*://*.wikipedia.org/*", "*://amazon.com/*", "*://github.com/*", "*://google.at/*", "*://google.com/*", "*://www.amazon.com/*", "*://www.github.com/*", "*://www.google.at/*", "*://www.google.com/*", "*://www.google.de/*", "*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content-scripts/content.js"]}]}