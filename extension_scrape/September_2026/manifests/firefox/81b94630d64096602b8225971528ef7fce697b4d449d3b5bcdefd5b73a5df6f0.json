{"manifest_version": 2, "name": "YT Dynamic Playlist", "version": "1.0", "description": "Manage YouTube tabs as a dynamic playlist.", "permissions": ["tabs", "storage", "*://www.youtube.com/*"], "browser_action": {"default_title": "YT Dynamic Playlist", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "ytdynamicplaylist@natvalentine", "data_collection_permissions": {"required": ["none"], "optional": []}}}}