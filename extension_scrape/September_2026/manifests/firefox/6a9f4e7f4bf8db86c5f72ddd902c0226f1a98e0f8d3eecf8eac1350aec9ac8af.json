{"manifest_version": 2, "name": "Sync Simple TODO List", "version": "0.1.1", "description": "A minimal TODO list that syncs across machines via Google Drive.", "browser_specific_settings": {"gecko": {"id": "sync-simple-todo@mwodtke.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["browser-shim.js", "config.js", "auth-firefox.js", "drive-sync.js", "background.js"], "persistent": true}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "identity", "https://www.googleapis.com/drive/v3/*", "https://www.googleapis.com/upload/drive/v3/*", "https://oauth2.googleapis.com/*"]}