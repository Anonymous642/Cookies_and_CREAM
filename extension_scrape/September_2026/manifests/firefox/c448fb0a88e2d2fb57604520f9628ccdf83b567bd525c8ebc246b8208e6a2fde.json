{"manifest_version": 3, "name": "Searched", "version": "0.2.4", "description": "Companion extension for the Searched party trivia game. When you opt in, it scans the last 30 days of your Google search history locally for question-style searches, shows them to you in the popup, and contributes them to your game room.", "browser_specific_settings": {"gecko": {"id": "searched@searched.vercel.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}, "gecko_android": {"strict_max_version": "1.0"}}, "action": {"default_popup": "popup.html"}, "permissions": ["history", "storage"], "host_permissions": ["https://searched.vercel.app/*"], "background": {"scripts": ["historyFilter.js", "firefox/history.firefox.js", "firefox/background.firefox.js"]}, "content_scripts": [{"matches": ["https://searched.vercel.app/*"], "js": ["content.js"], "run_at": "document_start"}]}