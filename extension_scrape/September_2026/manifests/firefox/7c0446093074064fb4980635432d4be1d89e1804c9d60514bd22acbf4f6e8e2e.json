{"manifest_version": 3, "name": "Search Filter Pro", "version": "1.2.3", "description": "Excludes unwanted domains from search results.", "browser_specific_settings": {"gecko": {"id": "search-filter-pro@yourdomain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {"default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"], "type": "module"}, "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["https://www.google.com/*", "https://www.bing.com/*", "https://duckduckgo.com/*"]}