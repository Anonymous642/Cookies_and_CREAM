{"manifest_version": 2, "name": "WordPress Admin Bar Toggle", "version": "1.0", "description": "Toggle the WordPress admin bar visibility with a single click!", "author": "Bart Wiggers", "background": {"scripts": ["lib/main.js"], "persistent": false}, "browser_action": {"default_icon": {"24": "img/icon24.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "default_title": "WP Admin Bar Toggle"}, "content_scripts": [{"matches": ["*://*/*"], "css": ["lib/hide-admin-bar.css"], "js": ["lib/content-script.js"], "run_at": "document_start"}], "icons": {"24": "img/icon24.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "permissions": ["storage", "*://*/*", "tabs"], "web_accessible_resources": ["img/icon24.png", "img/icon48.png", "img/icon128.png", "img/icon24_red.png", "img/icon48_red.png", "img/icon128_red.png"], "short_name": "WP Admin Bar Toggle", "applications": {"gecko": {"id": "wordpress-admin-bar-toggle@bartwiggers.com"}}}