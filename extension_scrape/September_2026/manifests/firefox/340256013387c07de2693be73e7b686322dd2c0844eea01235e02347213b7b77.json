{"manifest_version": 3, "name": "Workday Chime", "version": "1.0.0", "description": "Schedule recurring Firefox notifications within selected hours and weekdays.", "permissions": ["alarms", "notifications", "storage"], "background": {"scripts": ["schedule-core.js", "background.js"]}, "action": {"default_title": "Open Workday Chime", "default_popup": "popup.html", "default_icon": {"48": "assets/icon.svg", "96": "assets/icon.svg"}}, "icons": {"48": "assets/icon.svg", "96": "assets/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "workday-chime@local.tools", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}