{"manifest_version": 3, "name": "European Providers Checker + Alternatives", "version": "1.0.1", "description": "Check if the website you're visiting is from a European provider. If not, it shows European alternatives.", "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["*://europeanproviders.eu/*", "*://www.europeanproviders.eu/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16_grey.png", "32": "images/icon32_grey.png", "48": "images/icon48_grey.png", "128": "images/icon128_grey.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "images/icon16_grey.png", "32": "images/icon32_grey.png", "48": "images/icon48_grey.png", "128": "images/icon128_grey.png"}, "browser_specific_settings": {"gecko": {"id": "gecko-noreply@europeanproviders.eu", "strict_min_version": "109.0"}, "gecko_android": {"id": "gecko-noreply@europeanproviders.eu", "strict_min_version": "109.0"}}}