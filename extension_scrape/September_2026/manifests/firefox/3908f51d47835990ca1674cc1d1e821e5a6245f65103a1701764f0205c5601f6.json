{"manifest_version": 3, "name": "Parcelwright", "version": "1.0.0", "description": "Stage links, preview deterministic filenames, and dispatch controlled download batches.", "permissions": ["downloads", "tabs", "storage", "contextMenus", "activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open Parcelwright"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "parcelwright@workingmatter.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}