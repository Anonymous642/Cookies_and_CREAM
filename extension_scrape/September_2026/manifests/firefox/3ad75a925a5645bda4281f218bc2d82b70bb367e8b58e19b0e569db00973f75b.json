{"manifest_version": 2, "name": "Shell Tab", "version": "1.1.0", "description": "Opens the system shell in a Firefox tab (multi\u2011terminal, split view, copy/paste, colour, RTL).", "icons": {"48": "icon48.svg", "96": "icon96.svg"}, "permissions": ["nativeMessaging", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Open Shell Tab", "default_icon": {"48": "icon48.svg"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}}, "browser_specific_settings": {"gecko": {"id": "shell-tab-ovadm@myshelltab.org"}}, "web_accessible_resources": ["xterm.js", "xterm.css", "fit.js", "terminal.js", "style.css", "about.html", "about.css"]}