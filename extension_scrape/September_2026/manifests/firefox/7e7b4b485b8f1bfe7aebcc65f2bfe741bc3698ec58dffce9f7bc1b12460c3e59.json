{"manifest_version": 3, "name": "Browser Data Cleaner", "version": "3.2.0", "description": "Automatically clean browser data on schedule or on demand (Firefox / Mullvad Browser build)", "browser_specific_settings": {"gecko": {"id": "browser-data-cleaner@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["browsingData", "storage", "alarms", "notifications", "history", "cookies", "tabs", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"clear-data-now": {"description": "Clear browser data immediately"}}, "incognito": "spanning", "host_permissions": ["<all_urls>"]}