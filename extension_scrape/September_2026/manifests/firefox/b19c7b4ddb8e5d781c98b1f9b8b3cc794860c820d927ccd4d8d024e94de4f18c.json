{"manifest_version": 3, "name": "WordReplace", "version": "1.0.0", "description": "Simple word replacer. Find and replace words on any webpage instantly.", "icons": {"48": "res/icon-48.png", "96": "res/icon-96.png", "128": "res/icon-128.png"}, "action": {"default_icon": {"48": "res/icon-48.png", "96": "res/icon-96.png"}, "default_title": "WordReplace", "default_popup": "panel/word.html"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "wordreplace@text.modifier", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}