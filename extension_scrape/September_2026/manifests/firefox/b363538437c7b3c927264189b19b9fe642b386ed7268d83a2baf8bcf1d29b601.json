{"manifest_version": 3, "name": "LinkedIn AI Slop Detector", "version": "1.1.0", "description": "Detects AI-generated content on LinkedIn posts based on linguistic patterns and assigns slop ratings", "browser_specific_settings": {"gecko": {"id": "{cad4ea74-8d02-41ae-9bed-c8d622ead36e}"}}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["*://*.linkedin.com/*"], "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "AI Slop Detector", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["*://*.linkedin.com/*"]}]}