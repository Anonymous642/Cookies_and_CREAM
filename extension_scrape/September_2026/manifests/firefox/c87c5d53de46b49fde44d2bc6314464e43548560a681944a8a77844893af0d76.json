{"manifest_version": 2, "name": "Old Reddit Subscriber Counter", "version": "1.0", "description": "Displays the subscriber count on bestreddit pages.", "browser_specific_settings": {"gecko": {"id": "@old-reddit-subscriber-counter", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "64": "icons/icon-64.png"}, "permissions": ["storage", "*://old.reddit.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://old.reddit.com/r/*", "*://old.reddit.com/comments/*"], "js": ["content.js"]}]}