{"manifest_version": 3, "name": "Cloud Basha App Builder", "version": "1.1.5", "description": "Turn app ideas from ChatGPT, Claude, or Gemini into deployed applications with CloudBasha.", "permissions": ["storage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://cloudbasha.com/*", "https://www.cloudbasha.com/*", "https://cloudbashaai-prd.web.app/*", "https://stg.cloudbasha.com/*"], "background": {"scripts": ["background.js"], "type": "classic"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["codebridge.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://cloudbasha.com/*", "https://www.cloudbasha.com/*", "https://cloudbashaai-prd.web.app/*", "https://stg.cloudbasha.com/*"], "js": ["sessionSync.js"], "run_at": "document_idle"}], "action": {"default_title": "Cloud Basha App Builder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/cloudbasha-logo.png", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "cloudbasha-builder@cloudbasha.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications", "websiteActivity", "websiteContent"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}}