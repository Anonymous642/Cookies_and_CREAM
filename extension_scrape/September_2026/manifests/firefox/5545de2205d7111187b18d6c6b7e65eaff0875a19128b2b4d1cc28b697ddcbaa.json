{"manifest_version": 3, "name": "Smart Auto Refresh (Pro)", "version": "2.1", "description": "Advanced auto-refresher with per-tab control, multi-tab mode, and human-like behavior simulation.", "browser_specific_settings": {"gecko": {"id": "smart-auto-refresh-pro@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["tabs", "storage", "scripting", "alarms", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}