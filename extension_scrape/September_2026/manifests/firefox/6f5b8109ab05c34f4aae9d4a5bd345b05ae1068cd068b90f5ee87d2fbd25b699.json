{"manifest_version": 2, "name": "YouTube Anti/Translate", "description": "YouTube Anti/Translate: reproduce YouTube con audio original o doblaje sincronizado al idioma que elijas.", "version": "0.6.0", "short_name": "Anti/Translate", "icons": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "64": "icon/icon-64.png", "96": "icon/icon-96.png", "128": "icon/icon-128.png"}, "permissions": ["storage", "*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*"], "browser_specific_settings": {"gecko": {"id": "yt-anti-translate@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://m.youtube.com/*", "*://www.youtube.com/*", "*://youtu.be/*", "*://youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}