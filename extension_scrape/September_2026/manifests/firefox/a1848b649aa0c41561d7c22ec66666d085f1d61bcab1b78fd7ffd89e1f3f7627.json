{"manifest_version": 3, "name": "Understory", "version": "1.0.0", "description": "Ask your own local AI about the page you are reading. Shows you exactly what text it extracted first, so it never answers from the navigation menu. Nothing leaves your machine.", "browser_specific_settings": {"gecko": {"id": "understory@crownmediacreative.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "Read this page with Understory", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "sidebar_action": {"default_title": "Understory", "default_panel": "sidebar/panel.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}