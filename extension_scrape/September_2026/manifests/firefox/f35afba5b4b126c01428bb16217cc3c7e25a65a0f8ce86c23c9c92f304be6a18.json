{"manifest_version": 2, "name": "Timeline Notes for YouTube", "version": "1.0.0", "description": "Movable, resizable window for timestamped notes on YouTube. Click a note to jump to that time. Unofficial; not affiliated with YouTube.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "youtube-notes@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content/store.js", "content/thumbnail.js", "content/panel.js", "content/content.js"], "css": ["content/styles.css"], "run_at": "document_idle"}]}