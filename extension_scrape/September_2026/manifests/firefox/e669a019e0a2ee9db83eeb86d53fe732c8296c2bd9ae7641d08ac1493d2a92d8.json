{"manifest_version": 3, "name": "Steam E-Ink Mode", "version": "2.1.1", "description": "A paper-like, touch-friendly monochrome reading mode for E-Ink tablets. Tuned for the Steam Store, optionally usable on any site.", "permissions": ["storage", "scripting"], "host_permissions": ["*://*.steampowered.com/*", "*://*.steamcommunity.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Steam E-Ink Mode", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "content_scripts": [{"matches": ["*://*.steampowered.com/*", "*://*.steamcommunity.com/*"], "css": ["css/eink-theme.css", "css/sites/steam.css"], "js": ["content/eink-boot.js", "content/eink-adapters.js", "content/eink-engine.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "steam-eink-mode@local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}, "gecko_android": {}}}