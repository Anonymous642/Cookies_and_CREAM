{"manifest_version": 3, "name": "NestarioTabs", "version": "1.4.2", "description": "Organize tabs into workspaces, save and recover sessions, focus, search everything, and manage your browser with AI.", "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "identity", "contextMenus", "scripting", "activeTab", "idle"], "host_permissions": ["https://nestariotabs.com/*"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "nestariotabs@nestariotabs.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "browsingActivity", "websiteContent", "authenticationInfo"]}}}, "commands": {"save-current-window": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current window as a session"}, "open-manager": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the full session manager (side panel)"}, "exit-focus": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Leave Focus Mode"}}, "content_scripts": [{"matches": ["https://nestariotabs.com/s/*"], "js": ["src/content/sharePage.js"], "run_at": "document_idle"}], "sidebar_action": {"default_panel": "src/manager/index.html", "default_title": "NestarioTabs", "default_icon": "icons/icon32.png", "open_at_install": false}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}