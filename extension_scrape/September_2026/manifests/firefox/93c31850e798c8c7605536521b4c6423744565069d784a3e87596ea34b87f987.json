{"manifest_version": 2, "name": "Abdal Anti Fingerprint", "version": "1.66.0", "description": "Advanced browser fingerprint protection that dynamically changes your digital fingerprint to prevent tracking", "author": "Ebrahim Shafiei (EbraSha)", "homepage_url": "https://github.com/EbraSha/abdal-anti-fingerprint", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "permissions": ["storage", "tabs", "activeTab", "webRequest", "webRequestBlocking", "<all_urls>", "unlimitedStorage", "cookies"], "background": {"scripts": ["js/background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content-script.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": ["js/injected-script.js", "test-fingerprint.html", "cookie-killer-test.html"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Abdal Anti Fingerprint", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "applications": {"gecko": {"id": "abdal-anti-fingerprint@ebrasha.com", "strict_min_version": "79.0"}}}