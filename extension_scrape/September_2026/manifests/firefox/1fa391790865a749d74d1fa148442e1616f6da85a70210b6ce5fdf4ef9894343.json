{"manifest_version": 2, "name": "Hacker News TrustSpark", "version": "1.0.7", "description": "Trust signals for Hacker News users", "permissions": ["storage", "*://news.ycombinator.com/*", "*://hacker-news.firebaseio.com/*", "*://hn.algolia.com/*"], "icons": {"48": "icons/y48.svg", "96": "icons/y96.svg"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/y18.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://news.ycombinator.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "trustspark@trustspark.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"id": "trustspark@trustspark.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}