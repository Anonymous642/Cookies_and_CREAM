{"manifest_version": 2, "name": "TinyCaptioner", "version": "1.0", "description": "Quick offline heuristic summary of short audio snippets from page audio elements (Speech / Music / Silence).", "browser_action": {"default_popup": "popup.html", "default_title": "TinyCaptioner"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@tinycaptioner", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}