{"manifest_version": 2, "name": "YouTube Blur", "version": "1.0", "description": "A Firefox extension to blur YouTube thumbnails and titles.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "{2f9f3bf7-6d9c-4372-974e-8ca8d4883e73}"}}}