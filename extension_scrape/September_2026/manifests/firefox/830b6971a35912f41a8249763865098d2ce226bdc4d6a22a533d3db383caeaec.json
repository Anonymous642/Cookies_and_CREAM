{"manifest_version": 3, "name": "BOM Secure Redirect", "version": "1.3.0", "description": "The BOM (Bureau of Meteorology) homepage redirect to legacy reg.bom.gov.au site", "icons": {"32": "icon.svg", "64": "icon.svg"}, "background": {"scripts": ["background.js"]}, "permissions": ["declarativeNetRequestWithHostAccess", "storage"], "host_permissions": ["*://www.bom.gov.au/*", "*://bom.gov.au/*"], "browser_specific_settings": {"gecko": {"id": "bom-secure-redirect@bgh.io"}}, "options_ui": {"page": "options.html"}, "declarative_net_request": {"rule_resources": [{"id": "rules-legacy", "enabled": true, "path": "rules-legacy.json"}]}}