{"manifest_version": 2, "name": "NurseJobPilot", "description": "NHS job application assistant for UK nurses", "version": "1.0.1", "icons": {"128": "icon-128.png"}, "permissions": ["storage", "activeTab", "https://*.nhsjobs.com/*", "https://*.jobs.nhs.uk/*", "https://*.trac.jobs/*", "https://www.healthjobsuk.com/*", "https://www.nursingnetuk.com/*", "https://www.nurses.co.uk/*", "https://www.healthjobs.co.uk/*", "https://www.socialcare.co.uk/*", "https://www.bupacareservices.co.uk/*", "https://www.barchester.com/*"], "web_accessible_resources": ["icon-dark.png", "icon-light.png", "logo-light.png", "logo-dark.png"], "externally_connectable": {"matches": ["https://nursejobpilot.com/*", "http://localhost:5173/*", "http://localhost:5174/*"]}, "browser_specific_settings": {"gecko": {"id": "nursejobpilot@nursejobpilot.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "NurseJobPilot"}, "content_scripts": [{"matches": ["https://*.jobs.nhs.uk/*", "https://*.nhsjobs.com/*", "https://*.trac.jobs/*", "https://www.barchester.com/*", "https://www.bupacareservices.co.uk/*", "https://www.healthjobs.co.uk/*", "https://www.healthjobsuk.com/*", "https://www.nurses.co.uk/*", "https://www.nursingnetuk.com/*", "https://www.socialcare.co.uk/*"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_icon": {"128": "icon-128.png"}}}