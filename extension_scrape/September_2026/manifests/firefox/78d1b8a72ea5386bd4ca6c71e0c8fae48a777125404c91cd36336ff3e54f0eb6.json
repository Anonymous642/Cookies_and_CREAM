{"manifest_version": 3, "name": "Finance Video Tracker", "version": "1.1.0", "description": "Remembers finance/investing YouTube videos and channels you watch, with auto-detection.", "browser_specific_settings": {"gecko": {"id": "finance-video-tracker@tsa.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "downloads"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Finance Video Tracker", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}