{"manifest_version": 3, "name": "MTIGA: Make The Internet Great Again", "version": "0.3.5", "description": "A community-powered 'Nudging Friend' that protects you from scams and technical decay.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "html/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"type": "module", "scripts": ["js/background.js"]}, "permissions": ["activeTab", "storage", "alarms", "scripting", "tabs"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["js/content.js"]}], "host_permissions": ["https://maketheinternetgreatagain.help/*", "http://localhost/*"], "browser_specific_settings": {"gecko": {"id": "sentinel@maketheinternetgreatagain.help", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "author": "Johannes"}