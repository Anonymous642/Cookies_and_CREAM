{"manifest_version": 2, "name": "Fix IMDB", "version": "2.3.4", "description": "Improves IMDB title and name pages: hides clutter, shows cast sorted by star meter, and shows filmography sorted by vote count.", "permissions": ["activeTab", "*://*.imdb.com/*", "*://api.graphql.imdb.com/*"], "background": {"scripts": ["src/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.imdb.com/title/tt*", "*://*.imdb.com/name/nm*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "fix-imdb@jeffraider", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}