{"manifest_version": 3, "name": "DisTube - Free Media Tools", "version": "1.0.1", "description": "Integration of the Distube Video Downloader tool inside its supported platforms.", "permissions": ["tabs"], "host_permissions": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://www.tiktok.com/*", "https://tiktok.com/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "DisTube - Free Media Tools"}, "content_scripts": [{"matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/reel/*", "https://instagram.com/reel/*", "https://www.instagram.com/reels/*", "https://instagram.com/reels/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "distube-extension@distu.be", "data_collection_permissions": {"required": ["websiteActivity"]}}}}