{"manifest_version": 3, "name": "Slate Outliner (Clipper)", "version": "0.50.0", "description": "Clip the selection on a page into today's Slate journal.", "browser_specific_settings": {"gecko": {"id": "clipper@slate.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "nativeMessaging"], "background": {"scripts": ["background.js"], "persistent": false}, "action": {"default_title": "Clip to Slate", "default_popup": "popup.html", "default_icon": {"32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png"}}, "icons": {"32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png"}}