{"manifest_version": 3, "name": "Google Keep Image Cache", "version": "0.2", "description": "Caches images from Google Keep locally, to speed up browsing", "host_permissions": ["https://keep.google.com/*", "https://lh3.googleusercontent.com/keep-bbsk/*"], "permissions": ["webRequest", "webRequestBlocking", "unlimitedStorage", "storage", "tabs"], "icons": {"48": "icons/icon_48.png", "64": "icons/icon_64.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "keepimagecache@mdavis.xyz"}}}