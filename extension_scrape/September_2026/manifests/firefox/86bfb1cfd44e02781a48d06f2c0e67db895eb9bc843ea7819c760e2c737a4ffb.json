{"manifest_version": 3, "name": "QuickTab", "version": "1.0.0", "description": "Set a custom URL for new tabs with URL bar ready for immediate typing", "author": "Okan Binli", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "optional_permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "default-src 'self'; frame-src http: https: data:; style-src 'self' 'unsafe-inline';"}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "quicktab@okan.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}