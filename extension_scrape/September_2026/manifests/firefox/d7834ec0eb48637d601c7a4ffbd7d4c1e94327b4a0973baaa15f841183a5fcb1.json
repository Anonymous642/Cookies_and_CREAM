{"manifest_version": 3, "name": "Font Changer", "version": "1.0", "description": "Zenkaku Gothic\u306b\u5f37\u5236\u7684\u306b\u5909\u66f4\u3059\u308b\u62e1\u5f35\u6a5f\u80fd\u3067\u3059\u3002", "permissions": ["activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://www.google.com/*", "https://ja.wikipedia.org/*", "https://x.com/*", "https://music.youtube.com/*", "https://www.bing.com/*", "https://note.com/*", "https://discord.com/*", "https://chatgpt.com/*", "https://editor.note.com/*", "https://laws.e-gov.go.jp/*", "https://k-tai.watch.impress.co.jp/*", "https://pc.watch.impress.co.jp/*", "https://forest.watch.impress.co.jp/*", "https://www.perplexity.ai/*", "https://fonts.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "a.nickel.orbit@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "websiteContent": {"description": "Applies Zen Kaku Gothic New font styling to webpage text for readability. No page data is stored or transmitted.", "required": false, "dataTypes": ["Rendered text on web pages"]}, "storage": {"description": "No user data is stored. The extension does not save settings or preferences.", "required": false, "dataTypes": ["None"]}, "browsingActivity": {"description": "Used only to apply font styling on listed sites. Does not track or log browsing activity.", "required": false, "dataTypes": ["Visited domain names (for styling only)"]}}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.google.com/*", "https://ja.wikipedia.org/*", "https://x.com/*", "https://music.youtube.com/*", "https://www.bing.com/*", "https://note.com/*", "https://discord.com/*", "https://chatgpt.com/*", "https://editor.note.com/*", "https://laws.e-gov.go.jp/*", "https://k-tai.watch.impress.co.jp/*", "https://pc.watch.impress.co.jp/*", "https://forest.watch.impress.co.jp/*", "https://www.perplexity.ai/*"], "css": ["mystyle.css"], "js": ["content.js"], "run_at": "document_start"}]}