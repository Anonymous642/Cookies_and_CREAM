{"manifest_version": 3, "name": "AI Code Chunk Paster", "version": "1.1.0", "description": "Paste long code into Claude or ChatGPT in small line-based chunks while preserving every newline.", "permissions": ["activeTab", "scripting", "storage", "clipboardRead", "clipboardWrite"], "action": {"default_title": "AI Code Chunk Paster", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open AI Code Chunk Paster"}}, "browser_specific_settings": {"gecko": {"id": "claude-code-chunk-paster@local.example", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}