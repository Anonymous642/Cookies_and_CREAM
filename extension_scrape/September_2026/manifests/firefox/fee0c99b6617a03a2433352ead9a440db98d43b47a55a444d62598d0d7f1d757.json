{"manifest_version": 2, "name": "ChatGPT PlantUML Diagram Generator", "version": "1.0", "description": "Generate PlantUML diagrams from chatGPT canvas", "permissions": ["activeTab", "storage", "https://www.plantuml.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Generate PlantUML diagram", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"generate-diagram": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Generate and display PlantUML diagram in the chatGPT canvas"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "chatgpt-plantuml-diagram-generator@example.com", "strict_min_version": "79.0"}}}