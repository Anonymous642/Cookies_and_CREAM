{"manifest_version": 3, "name": "YouTube Channel Blocker/Hider", "version": "2.0", "description": "Block YouTube channels so you never see their content.", "permissions": ["storage"], "icons": {"32": "images/block_ico.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["images/block_icon.png"], "matches": ["https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "youtubehider@bme.com"}}}