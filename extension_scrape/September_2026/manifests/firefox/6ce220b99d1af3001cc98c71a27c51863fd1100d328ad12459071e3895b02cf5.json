{"manifest_version": 3, "name": "Sooner or Later", "version": "3.0.0", "description": "Maintain a queue of pages to read sooner or later. Push the current tab to the front or back of the queue, pop the next page.", "permissions": ["storage", "bookmarks", "activeTab", "notifications"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"push-sooner": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Add the current tab to the front of the queue (read it sooner)"}, "push-later": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Add the current tab to the back of the queue (read it later)"}, "pop-page": {"suggested_key": {"default": "Ctrl+Shift+O"}, "description": "Open the next page from the reading queue"}}, "browser_specific_settings": {"gecko": {"id": "soonerorlater@lesica.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}