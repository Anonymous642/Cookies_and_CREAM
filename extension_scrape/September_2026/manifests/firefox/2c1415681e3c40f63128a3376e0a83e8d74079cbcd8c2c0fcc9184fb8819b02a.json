{"manifest_version": 3, "name": "Video Saver for X/Twitter", "version": "1.0.0", "description": "Detects videos on X/Twitter as you browse and lets you save them in the highest quality available.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Video Saver for X/Twitter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content/content-script.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["content/page-hook.js"], "matches": ["*://*.twitter.com/*", "*://*.x.com/*"]}], "browser_specific_settings": {"gecko": {"id": "video-saver-x-twitter@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}