{"manifest_version": 2, "name": "limito", "description": "Browser extension to help Canadian user aggregate registered account contribution room", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["webRequest", "storage", "cookies", "https://my.wealthsimple.com/*", "https://*.royalbank.com/*", "https://*.rbcroyalbank.com/*", "https://*.ams-sga.cra-arc.gc.ca/*", "https://*.canadalife.com/*", "https://easyweb.td.com/*", "https://*.questrade.com/*", "https://*.bmoinvestorline.com/*", "https://*.bmosmartfolio.com/*", "https://*.tangerine.ca/*", "https://*.interactivebrokers.com/*", "http://127.0.0.1/*", "http://localhost/*", "https://limito.ca/*"], "web_accessible_resources": ["icon/*.png"], "browser_specific_settings": {"gecko": {"id": "limito@limito.ca", "strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.ams-sga.cra-arc.gc.ca/*", "*://*.bmoinvestorline.com/*", "*://*.bmosmartfolio.com/*", "*://*.canadalife.com/*", "*://*.interactivebrokers.com/*", "*://*.questrade.com/*", "*://*.rbcroyalbank.com/*", "*://*.royalbank.com/*", "*://*.tangerine.ca/*", "*://easyweb.td.com/*", "*://my.wealthsimple.com/*"], "all_frames": true, "js": ["content-scripts/content.js"]}, {"matches": ["*://*.limito.ca/*", "*://127.0.0.1/*", "*://localhost/*"], "run_at": "document_start", "js": ["content-scripts/limito-web.js"]}]}