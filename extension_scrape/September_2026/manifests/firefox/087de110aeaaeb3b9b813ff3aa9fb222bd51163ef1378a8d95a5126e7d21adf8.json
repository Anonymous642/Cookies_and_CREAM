{"manifest_version": 3, "name": "Tab Unifier", "version": "3.0", "description": "Limit the number of duplicate tabs per site (e.g. allow 3 YouTube tabs, but only 1 of everything else).", "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tab-unifier@local-dev-extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}