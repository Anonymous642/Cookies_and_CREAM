{"manifest_version": 2, "name": "Aalto Login", "version": "1.0.5", "description": "Unofficial extension that automatically completes Aalto SSO login flows.", "icons": {"16": "icons/aalto-16.png", "32": "icons/aalto-32.png", "48": "icons/aalto-48.png", "96": "icons/aalto-96.png", "128": "icons/aalto-128.png"}, "permissions": ["storage", "https://mycourses.aalto.fi/*", "https://plus.cs.aalto.fi/*", "https://sisu.aalto.fi/*", "https://version.aalto.fi/*", "https://*.zulip.cs.aalto.fi/*", "https://*.zulip.aalto.fi/*", "https://idp.aalto.fi/*", "https://fs.aalto.fi/*", "https://haka.funet.fi/*", "https://login.microsoftonline.com/*"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "browser_action": {"default_title": "Aalto Login", "default_icon": {"16": "icons/aalto-16.png", "32": "icons/aalto-32.png", "48": "icons/aalto-48.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mycourses.aalto.fi/*", "https://plus.cs.aalto.fi/*", "https://sisu.aalto.fi/*", "https://version.aalto.fi/*", "https://*.zulip.cs.aalto.fi/*", "https://*.zulip.aalto.fi/*", "https://idp.aalto.fi/*", "https://fs.aalto.fi/*", "https://haka.funet.fi/*", "https://login.microsoftonline.com/*"], "js": ["browser-polyfill.js", "totp.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "aaltologin@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}