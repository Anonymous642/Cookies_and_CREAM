{"manifest_version": 2, "name": "ZX Sound Detector", "version": "2.0", "description": "Lists all tabs with media and provides play/pause/mute controls.", "permissions": ["tabs", "activeTab", "<all_urls>"], "web_accessible_resources": ["content/*"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "ZX Sound Detector"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/skipTrack.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "@zx-sound-detector", "data_collection_permissions": {"required": ["none"]}}}}