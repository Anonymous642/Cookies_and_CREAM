{"manifest_version": 2, "name": "Book-to-Movie Finder", "version": "1.3", "description": "Track books and their movie or TV adaptations locally in your browser.", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Book-to-Movie Finder", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Book-to-Movie-Finder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}