{"manifest_version": 2, "name": "VNPAY Signer", "description": "Browser extension for CA signing", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["nativeMessaging", "storage", "alarms", "https://s3-hni.sds.vnpaycloud.vn/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "app-publisher@vnpay.vn", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "VNPAY Sign Extension", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}