{"manifest_version": 3, "name": "Article Age: Postimees, Delfi, \u00d5htuleht & ERR", "version": "2.0.8", "description": "Shows how old each front-page article on postimees.ee, delfi.ee, ohtuleht.ee and err.ee actually is, so recycled/bumped stories are easy to spot.", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "article-age@sinine.eu", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.postimees.ee/*", "*://*.delfi.ee/*", "*://*.ohtuleht.ee/*", "*://*.err.ee/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Article Age settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg"}}, "content_scripts": [{"matches": ["*://*.postimees.ee/*", "*://*.delfi.ee/*", "*://*.ohtuleht.ee/*", "*://*.err.ee/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}