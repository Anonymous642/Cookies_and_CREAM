{"manifest_version": 2, "name": "YouTube Sidebar Toggler", "version": "1.1", "description": "Toggle the YouTube sidebar using a keyboard shortcut.", "permissions": ["activeTab", "https://www.youtube.com/*"], "background": {"scripts": ["background.js"]}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Toggle the YouTube sidebar"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "youtube-sidebar-toggler@hasan", "data_collection_permissions": {"required": ["none"]}}}}