{"manifest_version": 3, "name": "YouTube Quality Guard", "version": "1.0.0", "description": "Erzwingt bevorzugte YouTube-Qualit\u00e4t, Playergr\u00f6\u00dfe, Lautst\u00e4rke, Stummschaltung, Playback-Speed und blendet st\u00f6rende Overlays aus.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "YouTube Quality Guard", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["src/content/youtube-controller.js"], "css": ["src/content/youtube-controller.css"], "run_at": "document_idle", "all_frames": true}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "youtube-quality-guard@theglorysaint.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}