{"manifest_version": 3, "name": "Pomodoro Tracker", "version": "1.1.0", "description": "A simple Pomodoro timer to help you stay focused and track your productivity sessions.", "browser_specific_settings": {"gecko": {"id": "pomodoro-tracker@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/clock.png", "32": "assets/clock.png", "48": "assets/clock.png", "128": "assets/clock.png"}}, "background": {"scripts": ["src/background.js"], "type": "module"}, "permissions": ["storage", "alarms"]}