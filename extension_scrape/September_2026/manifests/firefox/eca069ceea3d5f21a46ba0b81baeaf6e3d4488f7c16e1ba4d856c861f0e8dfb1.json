{"manifest_version": 2, "name": "Monochrome Moment", "version": "1.0", "description": "Turn the current page into monochrome (black & white) for 1 second when the toolbar button is clicked.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Monochrome Moment"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "monochromemoment@example.com"}}}