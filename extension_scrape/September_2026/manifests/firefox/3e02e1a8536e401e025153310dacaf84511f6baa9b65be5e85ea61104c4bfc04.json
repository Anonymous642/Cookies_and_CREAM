{"manifest_version": 3, "name": "Block Fuzz", "short_name": "Block Fuzz", "version": "3.5.0", "description": "A focused Facebook and Instagram blocker that keeps messages, optional Stories, and authentication flows accessible while redirecting distracting browsing to a customizable focus page.", "permissions": ["webNavigation", "storage"], "host_permissions": ["*://*.instagram.com/*", "*://*.facebook.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.instagram.com/*", "*://*.facebook.com/*"], "js": ["guard.js"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "settings.html", "open_in_tab": true}, "action": {"default_title": "Block Fuzz", "default_popup": "popup.html", "default_icon": {"16": "icons/block-fuzz.svg", "32": "icons/block-fuzz.svg", "64": "icons/block-fuzz.svg"}}, "icons": {"16": "icons/block-fuzz.svg", "32": "icons/block-fuzz.svg", "48": "icons/block-fuzz.svg", "96": "icons/block-fuzz.svg"}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}, "browser_specific_settings": {"gecko": {"id": "{cbaaad2f-f831-4bcb-bad3-171210796eef}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}