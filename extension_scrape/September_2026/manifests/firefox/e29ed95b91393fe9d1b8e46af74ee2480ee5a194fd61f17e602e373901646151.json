{"manifest_version": 2, "name": "YouTube Embed Redirect", "homepage_url": "https://github.com/relikd/youtube-embed-redirect", "version": "1.0", "description": "Immediatelly redirect any youtube watch/shorts URL to its embed equivalent (upon visit).", "icons": {"32": "icon.svg", "48": "icon.svg", "64": "icon.svg", "96": "icon.svg"}, "permissions": ["storage", "webRequest", "webRequestBlocking", "webNavigation", "https://www.youtube.com/shorts*", "https://www.youtube.com/watch*", "https://www.youtube.com/embed*", "https://www.youtube-nocookie.com/embed/*"], "background": {"scripts": ["shared.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*"], "js": ["modify-embed-links.js"], "run_at": "document_idle"}], "options_ui": {"page": "settings.html"}, "browser_action": {"default_title": "Choose redirect URL", "default_popup": "settings.html?v=popup"}, "browser_specific_settings": {"gecko": {"id": "youtube-embed-redirect@relikd", "data_collection_permissions": {"required": ["none"]}}}}