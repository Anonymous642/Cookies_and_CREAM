{"manifest_version": 2, "name": "DuckDuck Go Search Result Navigator", "version": "1.0", "description": "An extension that lets you tab through the results of a DuckDuckGo search", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "ddg-navigator@example.com", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_location_data": false, "collects_health_data": false, "collects_financial_data": false, "collects_authentication_information": false, "collects_personal_communications": false, "collects_user_activity": false, "collects_website_content": false}}}, "content_scripts": [{"matches": ["https://duckduckgo.com/*"], "js": ["content.js"]}]}