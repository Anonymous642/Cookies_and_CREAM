{"manifest_version": 3, "name": "YouTube Shorts Blocker", "version": "1.0.3", "description": "Hides YouTube Shorts from YouTube pages.", "icons": {"48": "icons/48x48.png", "128": "icons/128x128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-shorts-blocker@eren", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_location": false, "collects_user_activity": false, "collects_health_info": false, "collects_financial_info": false, "collects_authentication_info": false}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}