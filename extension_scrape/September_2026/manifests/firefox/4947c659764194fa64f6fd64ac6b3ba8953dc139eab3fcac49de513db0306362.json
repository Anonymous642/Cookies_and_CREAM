{"manifest_version": 2, "name": "GiggukDB Anime Mentions", "description": "Shows anime mention markers and cards while you watch Gigguk videos on YouTube.", "version": "0.1.0", "short_name": "GiggukDB Mentions", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "homepage_url": "https://giggukdb.com/", "permissions": ["storage", "https://giggukdb.com/*"], "browser_specific_settings": {"gecko": {"id": "giggukdb-anime-mentions@giggukdb.com", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "GiggukDB Anime Mentions", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}