{"manifest_version": 3, "name": "TSB Quick Log for TradingView", "short_name": "TSB Quick", "version": "0.3.3", "description": "Save TradingView chart plans, setup evidence, screenshots, and trade context into Trader's Second Brain.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*.tradingview.com/*", "https://tradingview.com/*", "https://*.traderssecondbrain.com/*", "https://traderssecondbrain.com/*"], "content_scripts": [{"matches": ["https://*.tradingview.com/*", "https://tradingview.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["favicon.svg", "icons/icon-pwa.svg", "icons/mark.png"], "matches": ["https://*.tradingview.com/*", "https://tradingview.com/*"]}], "action": {"default_title": "Open TSB Quick Log", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "browser_specific_settings": {"gecko": {"id": "tradingview-capture@traderssecondbrain.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "financialAndPaymentInfo"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}