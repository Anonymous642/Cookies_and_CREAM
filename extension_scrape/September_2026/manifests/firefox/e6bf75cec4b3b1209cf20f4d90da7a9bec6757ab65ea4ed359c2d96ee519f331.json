{"manifest_version": 2, "name": "Scriptorium", "version": "1.0.0", "description": "Export Claude.ai conversations to Markdown or styled HTML. Five elegant themes: \u00c9clat, Auroralis, Papyrus, Terminal, Cin\u00e9mascope.", "icons": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "permissions": ["activeTab", "storage", "https://claude.ai/*"], "browser_action": {"default_title": "Exporter la conversation Claude", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["turndown.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@scriptorium-claude", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "developer": {"name": "Crrawler"}}