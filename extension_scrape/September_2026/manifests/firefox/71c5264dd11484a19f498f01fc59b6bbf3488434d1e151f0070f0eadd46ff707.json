{"manifest_version": 2, "name": "YouTube Shorts Blocker", "version": "1.0.0", "description": "Hide YouTube Shorts from your feed. Simple on/off toggle, no data collected.", "author": "Local", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_title": "YouTube Shorts Blocker"}, "browser_specific_settings": {"gecko": {"id": "youtube-shorts-blocker@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}