{"manifest_version": 3, "name": "YT History cleaner", "version": "1.0.2", "description": "YouTube History & Likes Cleaner.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "youtube-history-cleaner@local", "data_collection_permissions": {"required": ["none"]}}}}