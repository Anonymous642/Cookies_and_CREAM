{"manifest_version": 3, "name": "Cut2Style: Cashback & Rewards", "version": "1.0.0", "description": "Earn cashback at Cut2Style partner stores. Activate in one click and track every reward in your wallet.", "permissions": ["storage", "tabs", "notifications", "scripting", "alarms"], "host_permissions": ["https://api.cut2style.com/*", "https://app.cut2style.com/auths/extension-connect*"], "optional_host_permissions": ["https://*/*"], "browser_specific_settings": {"gecko": {"id": "extension@cut2style.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}, "safari": {"strict_min_version": "16.4"}}, "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://app.cut2style.com/auths/extension-connect*"], "js": ["src/connect.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Cut2Style: Cashback & Rewards", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}