{"manifest_version": 3, "name": "YouTube Note Taker Pro", "version": "2.5.0", "description": "Note, Auto-Pause, Search & Backup for YouTube.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "practicalhumanism@notepro.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png"}, "action": {"default_popup": "popup.html", "default_title": "Open Notes Dashboard"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["purify.min.js", "shared.js", "content.js"], "css": ["styles.css"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https://i.ytimg.com;"}, "background": {"scripts": ["purify.min.js", "shared.js", "features.js", "background.js"]}}