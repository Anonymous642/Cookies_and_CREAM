{"manifest_version": 2, "name": "TreeTabMarks", "description": "Turn tabs and bookmarks into a project explorer with TreeTabMarks", "version": "0.9.7", "browser_specific_settings": {"gecko": {"id": "treetabmarks@diginash.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "unlimitedStorage", "contextualIdentities", "cookies"], "browser_action": {"default_title": "Open TreeTabMarks", "default_icon": "image/icon.svg"}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open or focus the TreeTabMarks window"}}, "icons": {"48": "image/icon.svg", "96": "image/icon.svg", "128": "image/icon.svg"}, "background": {"type": "module", "scripts": ["background.js"]}, "web_accessible_resources": ["worker.js", "/image/*"]}