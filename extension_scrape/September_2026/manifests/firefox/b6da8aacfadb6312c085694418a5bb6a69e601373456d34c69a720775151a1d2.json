{"manifest_version": 2, "name": "Goofish Tradutor", "version": "2.0", "description": "Bloqueia popups de autentica\u00e7\u00e3o e traduz p\u00e1ginas do Goofish entre chin\u00eas, portugu\u00eas e ingl\u00eas.", "author": "Paulo", "homepage_url": "https://github.com/", "browser_specific_settings": {"gecko": {"id": "goofish-tradutor@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["https://www.goofish.com/*", "https://goofish.com/*", "https://translate.googleapis.com/*"], "content_scripts": [{"matches": ["https://www.goofish.com/*", "https://goofish.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}