{"manifest_version": 2, "name": "Facebook Messenger Sidebar", "version": "1.0.0", "description": "Ultra lightweight, robust, dynamic and resource-efficient Facebook Messenger docked to the Firefox sidebar.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "messenger-sidebar@addon.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "cookies", "webRequest", "webRequestBlocking", "*://*.messenger.com/*", "*://*.facebook.com/*", "*://*.fbcdn.net/*", "*://*.facebook.net/*"], "background": {"scripts": ["background/background.js"]}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Toggle Messenger Sidebar (Ctrl+Alt+M)"}, "sidebar_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Messenger", "default_panel": "sidebar/sidebar.html"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Alt+M", "mac": "Command+Alt+M"}, "description": "Toggle Messenger Sidebar"}, "toggle-suspend": {"suggested_key": {"default": "Ctrl+Alt+S", "mac": "Command+Alt+S"}, "description": "Toggle Messenger Sleep / Memory Saver Mode"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}}