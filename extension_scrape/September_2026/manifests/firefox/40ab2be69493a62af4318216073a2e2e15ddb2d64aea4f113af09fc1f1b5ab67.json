{"manifest_version": 3, "name": "OwnFeeds - Quick Save", "version": "1.1", "description": "Speichere den aktuellen Tab direkt in OwnFeeds.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://ownfeeds.com/*", "https://*/*", "http://localhost:3000/*"], "action": {"default_popup": "popup.html", "default_title": "Save to OwnFeeds", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "ownfeeds-quicksave@feedy.app", "data_collection_permissions": {"required": ["none"]}}}}