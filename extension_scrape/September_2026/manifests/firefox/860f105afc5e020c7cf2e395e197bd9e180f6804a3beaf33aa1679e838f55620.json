{"manifest_version": 3, "name": "Fontify - Web Font Customizer", "version": "1.0.0", "description": "Web sitelerinin font tipini, boyutunu ve stilini an\u0131nda \u00f6zelle\u015ftirin. H\u0131zl\u0131 s\u0131f\u0131rlama se\u00e7ene\u011fi i\u00e7erir.", "author": "Do\u011fukan Musluba\u015f", "developer": {"name": "Do\u011fukan Musluba\u015f", "url": "https://dogukanmuslubas.com"}, "browser_specific_settings": {"gecko": {"id": "fontify-customizer@dogukanmuslubas.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Fontify", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}