{"name": "Find My Bookmarks: Search Your Bookmarks", "short_name": "Find My Bookmarks", "version": "1.3.1", "manifest_version": 3, "description": "Find your bookmarks for the current website, automatically.", "browser_specific_settings": {"gecko": {"id": "find-my-bookmarks@usabilitycounts.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["bookmarks", "tabs", "storage"], "host_permissions": ["https://www.google-analytics.com/*"], "background": {"scripts": ["js/background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Find My Bookmarks", "default_icon": {"32": "img/icon.png", "48": "img/icon48.png", "64": "img/icon64.png"}}, "action": {"default_title": "Find My Bookmarks", "default_icon": {"32": "img/icon.png", "48": "img/icon48.png", "64": "img/icon64.png"}}, "icons": {"32": "img/icon.png", "48": "img/icon48.png", "64": "img/icon64.png", "128": "img/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}