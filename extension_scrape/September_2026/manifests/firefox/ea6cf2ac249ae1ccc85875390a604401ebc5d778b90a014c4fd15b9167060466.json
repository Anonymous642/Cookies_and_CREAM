{"manifest_version": 3, "name": "ColorPicker", "version": "1.0.0", "description": "Simple color picker tool. Pick colors, convert between HEX/RGB/HSL, and save your palette.", "icons": {"48": "imgs/icon-48.png", "96": "imgs/icon-96.png", "128": "imgs/icon-128.png"}, "action": {"default_icon": {"48": "imgs/icon-48.png", "96": "imgs/icon-96.png"}, "default_title": "ColorPicker", "default_popup": "ui/picker.html"}, "permissions": ["storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "colorpicker@design.simple", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}