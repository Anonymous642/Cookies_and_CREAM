{"manifest_version": 3, "name": "Custos - Deal Tracker for Firefox", "version": "0.9.0", "author": "Simplex Motus", "description": "Track product prices across online stores, get price-drop alerts, compare variants, and keep price history on your device.", "permissions": ["alarms", "notifications", "activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.in/*", "*://*.amazon.co.jp/*"], "js": ["content-amazon.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "custos-deal-tracker@simplexmotus.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}