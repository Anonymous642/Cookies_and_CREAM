{"manifest_version": 3, "name": "Snipe Alerts: Facebook Marketplace Monitor", "version": "1.6.41", "description": "Telegram alerts for cars, boats and more on Facebook Marketplace, the moment they list. Price drops and market value too.", "permissions": ["alarms", "storage", "unlimitedStorage", "notifications", "cookies", "tabs", "declarativeNetRequest", "scripting"], "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://web.facebook.com/*", "https://api.carsnipe.com/*"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://web.facebook.com/*"], "js": ["lib/fb-protocol.js", "lib/search-variants.js", "lib/device-params.js", "lib/page-scrape.js", "lib/seller-probe.js", "content/facebook.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*", "https://m.facebook.com/*", "https://web.facebook.com/*"], "js": ["lib/device-params.js", "content/telemetry-interceptor.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "carsnipe@carsnipe.com", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}}