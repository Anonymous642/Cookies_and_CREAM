{"manifest_version": 3, "name": "AmbientTwitch", "version": "0.1.1", "description": "Fill Twitch fullscreen black bars with blurred ambient light sampled from the stream.", "browser_specific_settings": {"gecko": {"id": "ambient-twitch@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["*://*.twitch.tv/*"], "action": {"default_title": "AmbientTwitch", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["shared/geometry.js", "shared/settings.js", "content/content.js"], "run_at": "document_idle"}]}