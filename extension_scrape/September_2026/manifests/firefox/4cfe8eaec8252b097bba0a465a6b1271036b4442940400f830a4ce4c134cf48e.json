{"name": "Homepagr", "version": "5.0", "manifest_version": 2, "short_name": "Homepagr.com browser extension", "description": "This extension sets your \"new tab\" page to your bookmarks, and allows you to save bookmarks from the toolbar.", "homepage_url": "https://www.homepagr.com", "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_icon": "icons/page-32.png"}, "background": {"scripts": ["bookmark.js"]}, "permissions": ["activeTab", "storage", "tabs"], "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "{b2f5fdea-73cb-44e5-971e-b5d4d91fb77f}"}}}