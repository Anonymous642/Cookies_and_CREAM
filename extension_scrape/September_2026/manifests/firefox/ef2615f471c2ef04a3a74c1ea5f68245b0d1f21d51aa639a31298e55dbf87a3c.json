{"manifest_version": 3, "name": "Domain IP Guard", "version": "1.1.1", "description": "Allows a chosen website only from an approved IP address", "permissions": ["webRequest", "webRequestBlocking", "storage"], "host_permissions": ["https://api.ipify.org/*", "https://api.myip.com/*", "https://ifconfig.me/*", "https://icanhazip.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "options_ui": {"page": "options.html"}, "icons": {"48": "icons/48.png", "96": "icons/96.png"}, "browser_specific_settings": {"gecko": {"id": "domain-ip-guard@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo"]}}}}