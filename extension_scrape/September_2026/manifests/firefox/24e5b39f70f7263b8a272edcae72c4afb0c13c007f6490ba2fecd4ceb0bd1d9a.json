{"manifest_version": 3, "name": "YouTube BounceBack", "version": "1.0.0", "description": "Instantly return to your comment after clicking a timestamp on YouTube.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "YouTube BounceBack Settings", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-bounceback@ignaciomarucco.com", "data_collection_permissions": {"required": ["none"]}}}}