{"manifest_version": 3, "name": "StreamRecorder Download Manager", "description": "A dedicated download manager for StreamRecorder.io.", "version": "0.1.8", "permissions": ["downloads", "storage", "tabs", "notifications"], "host_permissions": ["https://streamrecorder.io/*", "https://*.streamrecorder.io/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "action": {"default_title": "StreamRecorder Download Manager", "default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["https://streamrecorder.io/*", "https://*.streamrecorder.io/*"], "js": ["src/content.js"], "run_at": "document_start"}], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "download-manager@streamrecorder.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}