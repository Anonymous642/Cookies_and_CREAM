{"manifest_version": 3, "name": "BidJig: Automatic Price Comparison & Coupons", "version": "2.9.0", "description": "Bid low. Jig up. BidJig checks 200+ stores for a cheaper one, coupons and cashback.", "permissions": ["activeTab", "tabs", "storage", "scripting", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "BidJig \u2014 Find it cheaper"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Open the BidJig popup"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "bidjig@bidjig.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"], "optional": ["personallyIdentifyingInfo", "authenticationInfo", "technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}