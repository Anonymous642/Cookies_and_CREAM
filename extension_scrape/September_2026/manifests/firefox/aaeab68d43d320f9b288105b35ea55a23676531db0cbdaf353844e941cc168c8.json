{"manifest_version": 3, "name": "Twitch Switch", "description": "Automatically open, switch, and manage priority Twitch streams.", "version": "1.0.1", "icons": {"16": "icons/logo_16x16.png", "48": "icons/logo_48x48.png", "128": "icons/logo_128x128.png"}, "action": {"default_title": "Twitch Switch", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/index.js"]}, "permissions": ["storage", "identity", "alarms"], "host_permissions": ["*://*.twitch.tv/*", "https://api.twitch.tv/*", "https://id.twitch.tv/*"], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "twitch-switch@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}, "android": {"strict_min_version": "142.0"}}}}