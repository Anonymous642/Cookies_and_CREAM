{"manifest_version": 3, "name": "Ultima Linkshell", "version": "0.2.1", "description": "Link your tracker accounts to Ultima Hunt and get all relays in one place", "author": "Z'attana Belmont", "homepage_url": "https://ultimahunt.com", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://faloop.app/*", "https://ultimahunt.com/*"], "background": {"service_worker": "background.js", "scripts": ["socket.io.min.js", "background.js"]}, "content_scripts": [{"matches": ["https://faloop.app/*"], "js": ["content_faloop.js"]}, {"matches": ["https://ultimahunt.com/*"], "js": ["content_ultima.js"]}], "action": {"default_title": "Ultima Linkshell", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "ultima-linkshell@ultimahunt.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}