{"manifest_version": 3, "name": "NetSuite Field ID Helper", "version": "1.0.1", "description": "Tools for handling fields in NetSuite", "browser_specific_settings": {"gecko": {"id": "netsuite-field-helper@liaguerre.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.netsuite.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.netsuite.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}