{"manifest_version": 2, "name": "Fast New Tab by Maggew.com", "description": "Redirect the New Tab page to your favorite URL!", "version": "1.0", "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["webRequest", "webRequestBlocking", "storage", "<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "firefox.addon@maggew.com"}}, "chrome_url_overrides": {"newtab": "dummy.html"}, "content_security_policy": "script-src 'self'; object-src 'self';"}