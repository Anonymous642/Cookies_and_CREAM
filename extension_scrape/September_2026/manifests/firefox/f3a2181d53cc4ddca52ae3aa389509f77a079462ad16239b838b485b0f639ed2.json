{"manifest_version": 2, "name": "What The HEIC", "version": "0.1.0", "description": "Adds HEIC/HEIF image support to your browser via WebAssembly decoding. No native helpers required.", "browser_specific_settings": {"gecko": {"id": "what-the-heic@j-wass", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["<all_urls>", "storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "shared/popup.html", "default_title": "What The HEIC"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script-loader.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": ["wasm/heic_decode.wasm", "shared/*.js"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}