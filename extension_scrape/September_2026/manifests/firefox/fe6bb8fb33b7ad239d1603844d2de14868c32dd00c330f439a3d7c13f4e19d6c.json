{"manifest_version": 3, "name": "2FAu Authenticator", "version": "0.1.0", "description": "Store 2FA codes in an encrypted vault. Generate TOTP/HOTP locally and sync with the 2FAU desktop app for macOS, Windows and Linux.", "minimum_chrome_version": "116", "action": {"default_popup": "popup.html", "default_title": "2FAu"}, "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}}, "autofill": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Autofill the 2FA code for the current site into the focused field"}}, "permissions": ["storage", "contextMenus", "activeTab", "alarms", "scripting", "notifications"], "optional_host_permissions": ["http://127.0.0.1/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "browser_specific_settings": {"gecko": {"id": "firefox@2fau.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}}