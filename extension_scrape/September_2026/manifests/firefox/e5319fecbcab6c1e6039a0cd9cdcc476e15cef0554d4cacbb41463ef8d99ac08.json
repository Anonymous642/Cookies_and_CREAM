{"manifest_version": 3, "name": "ReadLater", "description": "Save it now. Actually read it later. A minimal, local-first reading queue.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "readlater@salikkhan.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "121.0"}}, "action": {"default_popup": "popup.html", "default_title": "ReadLater", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "contextMenus", "tabs", "scripting", "activeTab"], "host_permissions": [], "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Save the current page to ReadLater"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Open ReadLater popup"}}, "web_accessible_resources": [{"resources": ["content-script.js"], "matches": ["http://*/*", "https://*/*"]}]}