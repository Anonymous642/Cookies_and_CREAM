{"manifest_version": 3, "author": "Brave Software", "name": "Brave Search", "description": "Configures Brave Search as the default search engine.", "default_locale": "en_US", "icons": {"16": "icons/brave_16x16.png", "32": "icons/brave_32x32.png", "48": "icons/brave_48x48.png", "64": "icons/brave_64x64.png", "128": "icons/brave_128x128.png"}, "browser_specific_settings": {"gecko": {"id": "brave-search-extension@brave.com", "strict_min_version": "140.0"}, "gecko_android": {}}, "chrome_url_overrides": {"newtab": "newtab/index.html"}, "chrome_settings_overrides": {"search_provider": {"favicon_url": "icons/brave_64x64.png", "name": "Brave", "keyword": "@brave", "encoding": "UTF-8", "search_url": "https://search.brave.com/search?q={searchTerms}&source=extension-omni", "suggest_url": "https://search.brave.com/api/suggest?q={searchTerms}&source=extension-omni", "is_default": true}}, "version": "2.1.0"}