{"manifest_version": 2, "name": "Steam to GOG Indicator", "version": "1.1", "description": "Checks if a Steam game is also available on GOG and shows a link on the store page.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "steam-gog-indicator@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["*://catalog.gog.com/*"], "content_scripts": [{"matches": ["*://store.steampowered.com/app/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}