{"manifest_version": 3, "name": "Stuffstream", "version": "1.5.0", "description": "Capture video streams with their request headers and play them on an Android TV running the Stuffstream receiver. Nothing leaves your network.", "browser_specific_settings": {"gecko": {"id": "stuffstream@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "storage", "tabs", "tabHide"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Stuffstream", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}}