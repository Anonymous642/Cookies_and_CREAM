{"manifest_version": 3, "name": "JioHotstar Subtitle Customizer", "version": "1.0.0", "developer": {"name": "JioHotstar Subtitle Customizer"}, "homepage_url": "https://github.com", "description": "Customise subtitle font, size, opacity, padding, blur, shadow, border radius, and position on JioHotstar.", "permissions": ["storage"], "host_permissions": ["*://*.hotstar.com/*", "*://*.jiohotstar.com/*"], "browser_specific_settings": {"gecko": {"id": "jiohotstar-subtitle-customizer@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.hotstar.com/*", "*://*.jiohotstar.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}