{"manifest_version": 2, "name": "TabDJMixer", "version": "1.0.0", "description": "Tr\u1ed9n 2 tab nh\u1ea1c \u0111\u01a1n gi\u1ea3n: ch\u1ecdn hai tab \u0111ang ph\u00e1t v\u00e0 \u0111i\u1ec1u ch\u1ec9nh fade-left / fade-right b\u1eb1ng 1 thanh tr\u01b0\u1ee3t.", "permissions": ["tabs", "activeTab", "storage", "<all_urls>"], "browser_action": {"default_title": "TabDJMixer", "default_popup": "popup.html"}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@tabdjmixer.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}