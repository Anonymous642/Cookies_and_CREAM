{"manifest_version": 2, "name": "Arkan - URL Cleaner", "version": "1.2.3", "author": "Marcos Raimundo (euhe.in)", "description": "Remove par\u00e2metros de rastreio e redirecionamentos de tracking em tempo real, com modo conservador por padr\u00e3o e exclus\u00f5es seguras por site.", "homepage_url": "https://euhe.in", "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background/http-interceptor.js"]}, "browser_action": {"default_title": "Arkan - URL Cleaner", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "browser_style": false, "open_in_tab": true}, "icons": {"96": "icon.png"}, "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "arkan-no-tracking-url@euhe.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}