{"manifest_version": 2, "name": "Tab Switcher", "version": "1.3", "description": "Switch tabs with smart filtering and shortcuts.", "permissions": ["tabs", "storage"], "author": "abhi", "homepage_url": "https://github.com/LeonetKenner/tab-switcher/", "background": {"scripts": ["background.js"]}, "icons": {"48": "tabswitcherthing48x48.png", "96": "tabswitcherthing96x96.png", "128": "tabswitcherthing128x128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"tab-left": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Switch to previous tab"}, "tab-right": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Switch to next tab"}}, "browser_specific_settings": {"gecko": {"id": "tabswitcher@abhinet", "data_collection_permissions": {"required": ["none"], "optional": []}}}}