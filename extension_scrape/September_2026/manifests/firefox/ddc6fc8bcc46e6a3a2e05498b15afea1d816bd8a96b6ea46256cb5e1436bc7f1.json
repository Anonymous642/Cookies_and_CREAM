{"manifest_version": 3, "name": "BuyerGuard", "version": "1.0.0", "description": "Rate and review eBay buyers. Crowdsourced flairs warn sellers about problematic buyers.", "permissions": ["storage"], "host_permissions": ["https://buyerguard-api.romanbronze.com/*", "https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://www.ebay.de/*", "https://www.ebay.com.au/*", "https://www.ebay.ca/*", "https://www.ebay.fr/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "BuyerGuard"}, "content_scripts": [{"matches": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://www.ebay.de/*", "https://www.ebay.com.au/*", "https://www.ebay.ca/*", "https://www.ebay.fr/*"], "js": ["content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "buyerguard@buyerguard.com", "strict_min_version": "128.0", "data_collection_permissions": {"privacy_policy_url": "https://buyerguard-api.romanbronze.com/privacy", "required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteActivity"], "optional": []}}}}