{"manifest_version": 3, "name": "AniTracks", "version": "1.1.0", "description": "Offline-first AniList companion. Browse, edit, and sync your anime & manga library without ever waiting on a network request.", "browser_specific_settings": {"gecko": {"id": "anitracks@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "sidebar_action": {"default_title": "AniTracks", "default_panel": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "open_at_install": true}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["lib/dexie.min.js", "lib/db.js", "lib/anilist-api.js", "lib/sync-engine.js", "background.js"]}, "permissions": ["storage", "alarms", "identity"], "host_permissions": ["https://graphql.anilist.co/*", "https://anilist.co/*"]}