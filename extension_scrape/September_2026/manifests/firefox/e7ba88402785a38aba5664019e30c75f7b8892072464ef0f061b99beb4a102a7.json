{"manifest_version": 2, "name": "Safe Highlighter & Notes", "version": "1.0.0", "description": "Highlight paragraphs on demand and save a simple site-specific note. No remote code, no inline scripts, minimal permissions.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_icon": "icons/icon-48.png", "default_popup": "popup/popup.html", "default_title": "Safe Highlighter & Notes"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["storage", "activeTab"], "options_page": "options/options.html", "browser_specific_settings": {"gecko": {"id": "safe-highlighter-notes@example.com"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}