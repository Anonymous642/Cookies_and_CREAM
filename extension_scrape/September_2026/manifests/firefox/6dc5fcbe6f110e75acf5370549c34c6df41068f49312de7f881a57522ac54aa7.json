{"manifest_version": 2, "name": "Tangent", "description": "Select any text in a Claude answer and open a forked side-conversation in a floating popover \u2014 without muddying your main chat.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://claude.ai/*"], "browser_specific_settings": {"gecko": {"id": "tangent@fdosmith.dev", "strict_min_version": "117.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://claude.ai/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}