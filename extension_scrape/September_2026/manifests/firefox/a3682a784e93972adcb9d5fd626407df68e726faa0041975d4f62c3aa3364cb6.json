{"manifest_version": 2, "name": "Download Blinkist Summaries", "version": "2.0.0", "description": "Extract fully automated summaries on blinkist.com to the clipboard or download them as a file in Markdown format", "permissions": ["activeTab", "downloads", "tabs", "storage", "clipboardWrite"], "content_scripts": [{"matches": ["*://*.blinkist.com/*"], "js": ["utils.js", "content-script.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "blinkist-scraper@example.com", "strict_min_version": "102.0"}}}