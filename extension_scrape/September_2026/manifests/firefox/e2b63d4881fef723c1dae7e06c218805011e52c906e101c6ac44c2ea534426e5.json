{"manifest_version": 2, "name": "TabCopy Lite", "version": "1.0.0", "description": "Copy the current tab\u2019s title and URL in one click; optionally copy the current selection. No tracking, minimal permissions.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "TabCopy Lite", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": false}, "permissions": ["tabs", "storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "tabcopy-lite@example.com", "strict_min_version": "109.0"}}}