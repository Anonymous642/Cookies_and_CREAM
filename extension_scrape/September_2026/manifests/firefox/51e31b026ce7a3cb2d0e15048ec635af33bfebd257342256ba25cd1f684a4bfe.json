{"manifest_version": 3, "name": "Simple Companion Extension", "version": "1.3.3", "description": "Track items, materials, and NPC encounters on the SimpleMMO travel page.", "permissions": ["storage"], "host_permissions": ["https://web.simple-mmo.com/*"], "browser_specific_settings": {"gecko": {"id": "simplemmo-tracker@example.com", "strict_min_version": "142.0", "strict_min_version_android": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "favicon-16x16.png", "32": "favicon-32x32.png", "192": "android-chrome-192x192.png"}, "content_scripts": [{"matches": ["https://web.simple-mmo.com/travel*", "https://web.simple-mmo.com/npcs/attack*", "https://web.simple-mmo.com/abyss", "https://web.simple-mmo.com/abyss/*", "https://web.simple-mmo.com/abyss*"], "js": ["content-script.js"], "run_at": "document_end"}], "action": {"default_title": "Simple Companion Tracker", "default_popup": "popup.html", "default_icon": {"16": "favicon-16x16.png", "32": "favicon-32x32.png"}}}