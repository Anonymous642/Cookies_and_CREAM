{"manifest_version": 3, "name": "WhatsApp Contact Hider", "version": "1.0", "description": "Hide specific contacts/chats from your WhatsApp Web chat list.", "browser_specific_settings": {"gecko": {"id": "whatsapp-contact-hider@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["https://web.whatsapp.com/*"], "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "WhatsApp Contact Hider", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}