{"manifest_version": 3, "name": "ZapResumo", "version": "0.2.0", "description": "Resumo local e privado de mensagens visiveis no WhatsApp Web.", "action": {"default_popup": "popup/popup.html", "default_title": "ZapResumo"}, "background": {"scripts": ["src/background.js"]}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://web.whatsapp.com/*"], "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["src/utils.js", "src/messageExtractor.js", "src/contentScript.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "zapresumo@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}