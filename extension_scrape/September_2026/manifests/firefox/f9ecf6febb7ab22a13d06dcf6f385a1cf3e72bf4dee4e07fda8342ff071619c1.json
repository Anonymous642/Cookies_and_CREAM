{"manifest_version": 2, "name": "Break Reminder", "version": "1.9", "description": "Stay healthy at the screen with timed prompts to hydrate, move, and rest your eyes using the 20-20-20 rule. Each reminder has its own toggle and interval and fires as a desktop notification.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{ef7726d6-ddb7-4bf7-b9d4-8558b0558ae1}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "notifications", "storage"], "background": {"scripts": ["scripts/background.js"]}, "browser_action": {"default_title": "Break Reminder", "default_popup": "scripts/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}