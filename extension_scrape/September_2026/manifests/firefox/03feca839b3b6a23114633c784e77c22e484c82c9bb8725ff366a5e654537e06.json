{"manifest_version": 3, "name": "GitHub Stack Viewer", "version": "1.0.0", "description": "Visualize stacked PRs on GitHub by detecting branch chain relationships. Injects a stack widget into the PR sidebar showing the full chain with status indicators.", "permissions": ["storage"], "host_permissions": ["https://github.com/*", "https://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "github-stack-viewer@cassiechew", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*/pull/*"], "js": ["content-helpers.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "GitHub Stack Viewer"}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}