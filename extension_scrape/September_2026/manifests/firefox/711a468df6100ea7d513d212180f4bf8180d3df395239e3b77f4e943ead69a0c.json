{"manifest_version": 2, "name": "Distraction Source Identifier", "version": "1.3", "description": "Identify and analyze common sources of browser-based distractions.", "permissions": ["tabs", "storage", "activeTab", "alarms", "idle"], "background": {"scripts": ["utils.js", "storage.js", "distractionEngine.js", "background.js"]}, "browser_action": {"default_title": "Distraction Source Identifier", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Distraction-Source-Identifier", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}