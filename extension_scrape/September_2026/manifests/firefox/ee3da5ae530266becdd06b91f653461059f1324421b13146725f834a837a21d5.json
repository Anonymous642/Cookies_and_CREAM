{"manifest_version": 2, "name": "Panopto QuickCommenter", "version": "1.2", "description": "Quickly insert predefined comments into Panopto using a tiled layout.", "permissions": ["activeTab", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "ecpanopto-commenter@monash.edu"}}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*/Panopto/Pages/Viewer.aspx*"], "js": ["content_script.js"]}]}