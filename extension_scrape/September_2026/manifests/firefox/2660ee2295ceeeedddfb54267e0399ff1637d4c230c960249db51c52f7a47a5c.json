{"manifest_version": 2, "name": "Improved Initiative Importer for D&D Beyond", "description": "A cross browser extension that imports D&D Beyond StatBlocks into Improved Initiative", "version": "1.1.0", "icons": {"16": "icon/16.png", "19": "icon/19.png", "38": "icon/38.png", "64": "icon/64.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "extension@improved-initiative.com"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Send to Improved Initiative", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.dndbeyond.com/*"], "js": ["content-scripts/content.js"]}]}