{"manifest_version": 3, "name": "relai", "version": "1.5.1", "description": "Pin it. Hand it off. Ship it. Capture visual feedback on your sites as your relai user.", "action": {"default_popup": "popup.html", "default_title": "relai"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "optional_host_permissions": ["https://*/*", "http://*/*"], "commands": {"start-capture": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Start capturing a pin on this tab"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://relai.team/*", "https://*.relai.team/*"], "js": ["relay.js"], "run_at": "document_start"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "relai@relai.team", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo", "websiteActivity"]}}}}