{"manifest_version": 2, "name": "AITU LMS Week Downloader", "version": "1.1.1", "description": "Adds a Download button to every week/section on lms.astanait.edu.kz and saves that week's materials into a folder named after the course and section.", "browser_specific_settings": {"gecko": {"id": "aitu-lms-week-downloader@abay", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["downloads", "storage", "https://lms.astanait.edu.kz/*"], "content_scripts": [{"matches": ["https://lms.astanait.edu.kz/course/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": false, "browser_style": false}}