{"manifest_version": 3, "name": "Neuralyzer", "version": "1.0.1", "description": "Hide comments from blocked Reddit users and every reply beneath them.", "browser_specific_settings": {"gecko": {"id": "neuralizer@gioia.dev", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Neuralyzer \u2014 toggle blocked comments", "default_icon": {"16": "icons/icon-toolbar-light-16.png", "32": "icons/icon-toolbar-light-32.png", "48": "icons/icon-toolbar-light-48.png", "96": "icons/icon-toolbar-light-96.png", "128": "icons/icon-toolbar-light-128.png"}}, "content_scripts": [{"matches": ["https://old.reddit.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "js": ["src/adapters/old-reddit.js", "src/adapters/new-reddit.js", "src/content.js"], "run_at": "document_start"}], "permissions": ["storage"], "background": {"scripts": ["src/background.js"]}}