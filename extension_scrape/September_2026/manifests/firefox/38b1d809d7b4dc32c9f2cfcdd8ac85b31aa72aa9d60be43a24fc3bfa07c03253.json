{"manifest_version": 3, "name": "Tab Manager Pro", "version": "3.0.0", "browser_specific_settings": {"gecko": {"id": "tab-manager-pro@tabmanagerpro.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Beautiful tab manager with real suspend, sessions, and modern design", "permissions": ["tabs", "storage", "sidePanel", "tabGroups", "system.memory", "contextMenus"], "background": {"scripts": ["background.js"], "type": "module"}, "side_panel": {"default_path": "sidepanel.html"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open Tab Manager Pro"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Open Tab Manager Pro"}, "suspend-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Suspend current tab"}, "suspend-all-inactive": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Suspend all inactive tabs"}}}