{"manifest_version": 3, "name": "Citation Generator", "version": "1.0.1", "description": "Generate citations from web pages with automatic metadata extraction. Supports APA, MLA, Chicago, IEEE, Harvard, and BibTeX formats.", "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "citation-generator@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/date-parser.js", "lib/site-extractors.js"], "matches": ["<all_urls>"]}], "commands": {"cite-page": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Cite this page"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}