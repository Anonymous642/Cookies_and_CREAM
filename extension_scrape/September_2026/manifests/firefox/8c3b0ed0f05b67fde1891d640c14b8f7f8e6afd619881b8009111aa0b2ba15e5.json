{"manifest_version": 3, "name": "YouTube Music Mini Player", "version": "1.4.1", "description": "Control YouTube Music playback with a mini player overlay: album art, controls, volume, queue, lyrics, shortcuts, history, and themes.", "browser_specific_settings": {"gecko": {"id": "{d4881ae1-30f2-4c84-b0f3-63f206114966}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://music.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://music.youtube.com/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icons8-youtube-music-16.png", "48": "icons/icons8-youtube-music-48.png", "96": "icons/icons8-youtube-music-96.png", "128": "icons/icons8-youtube-music-128.png"}, "default_title": "YouTube Music Player"}, "icons": {"16": "icons/icons8-youtube-music-16.png", "48": "icons/icons8-youtube-music-48.png", "96": "icons/icons8-youtube-music-96.png", "128": "icons/icons8-youtube-music-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"play-pause": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Play / Pause current song"}, "next-song": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Next song"}, "previous-song": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Previous song"}, "toggle-like": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Like / Unlike current song"}}}