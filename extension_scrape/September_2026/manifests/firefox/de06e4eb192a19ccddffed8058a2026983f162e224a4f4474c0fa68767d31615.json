{"manifest_version": 3, "name": "Nowen Note Web Clipper", "version": "0.4.0", "description": "\u901f\u8bb0\u3001\u7f51\u9875\u6b63\u6587\u3001\u9009\u533a\u548c\u56fe\u7247\u4e00\u952e\u4fdd\u5b58\u5230 Nowen Note\u3002", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "background": {"type": "module", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [], "commands": {"clip-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "\u526a\u85cf\u5f53\u524d\u9875\u9762\uff08\u6b63\u6587\uff09"}, "clip-selection": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "\u526a\u85cf\u9009\u4e2d\u5185\u5bb9"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "nowen-clipper@nowen-note", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}