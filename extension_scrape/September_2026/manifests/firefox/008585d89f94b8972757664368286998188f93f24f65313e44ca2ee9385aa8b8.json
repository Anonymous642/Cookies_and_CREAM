{"manifest_version": 3, "name": "YouTube to VLC Streamer", "version": "1.1", "description": "Stream YouTube videos and playlists to VLC with 5.1 surround audio", "homepage_url": "https://github.com/yt-dlp/yt-dlp", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content/overlay.js"], "css": ["content/overlay.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "youtube-to-vlc@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}