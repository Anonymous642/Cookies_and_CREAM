{"manifest_version": 3, "name": "PDP Inspector", "version": "1.0.1", "description": "Inspect any product page's SEO metadata \u2014 canonical URL, hreflang alternates, and JSON-LD product data \u2014 in one click.", "browser_specific_settings": {"gecko": {"id": "pdp-inspector@yourdomain.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "PDP Inspector"}, "permissions": ["activeTab", "scripting", "contextMenus", "clipboardWrite"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}