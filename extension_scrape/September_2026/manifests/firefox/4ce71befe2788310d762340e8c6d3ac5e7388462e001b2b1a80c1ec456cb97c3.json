{"manifest_version": 3, "name": "Disable YouTube Paid Promotion", "version": "1.0.0", "description": "Hides (or defangs) 'Includes paid promotion' banners/badges on YouTube video pages and thumbnails.", "icons": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "developer": {"name": "yetbad", "url": "https://yetbad.com"}, "browser_specific_settings": {"gecko": {"id": "hide-youtube-paid-promotion@yetbad.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "css": ["hide.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Disable YouTube Paid Promotion", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "default_popup": "popup.html"}}