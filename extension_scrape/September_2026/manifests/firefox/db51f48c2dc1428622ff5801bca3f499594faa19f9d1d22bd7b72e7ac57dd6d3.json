{"manifest_version": 3, "name": "Traductor Material AI - Traducci\u00f3n de P\u00e1ginas", "version": "1.2.3", "description": "Traduce el contenido de cualquier p\u00e1gina en el lugar, como el traductor integrado del navegador, usando tu propio motor LLM (Ollama, LM Studio, KoboldCPP) compatible con OpenAI.", "browser_specific_settings": {"gecko": {"id": "traductor-material-ai@trnslator.vivecoded", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["engine.js", "background.js"], "persistent": false}, "action": {"default_popup": "popup.html", "default_title": "Traductor Material AI", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["engine.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}