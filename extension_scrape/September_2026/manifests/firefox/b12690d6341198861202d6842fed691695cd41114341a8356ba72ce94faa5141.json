{"manifest_version": 2, "name": "Volume Up! 600", "version": "1.0.0", "description": "Amplify audio and video volume up to 600% on any tab", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_title": "Volume Up! 600", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_end", "js": ["content/content.js"]}], "background": {"scripts": ["background/background.js"], "persistent": true}, "permissions": ["activeTab", "tabs", "storage"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+6"}}}, "browser_specific_settings": {"gecko": {"id": "volume-up-600@custom", "strict_min_version": "142.0", "data_collection_permissions": {"data_collection_enabled": false, "required": ["none"]}}}}