{"manifest_version": 3, "name": "Amazon Price Tracker", "version": "3.0", "description": "Tracks prices of Amazon products.", "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.ae/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon48.png"}}, "icons": {"48": "icons/icon48.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.ae/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "swishyas@outlook.com"}}}