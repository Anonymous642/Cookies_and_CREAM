{"manifest_version": 2, "name": "TST Tab Switcher", "version": "1.0.1", "description": "Adds Vimium-style keyboard shortcuts for switching tabs in Tree Style Tab", "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"]}], "commands": {"activate-tab-hints": {"suggested_key": {"default": "Alt+Q"}, "description": "Activate tab hint mode"}}, "applications": {"gecko": {"id": "tst-tab-switcher@example.com"}}, "browser_specific_settings": {"gecko": {"id": "tst-tab-switcher@example.com"}}, "web_accessible_resources": ["style.css"]}