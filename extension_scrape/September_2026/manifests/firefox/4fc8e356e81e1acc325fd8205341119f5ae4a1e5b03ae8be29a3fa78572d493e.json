{"manifest_version": 3, "name": "Wipe Site Data", "version": "2.0", "description": "Borra cookies, storage, cach\u00e9 y service workers del sitio actual (eTLD+1, incluye subdominios) con un clic.", "author": "adrianlois", "browser_specific_settings": {"gecko": {"id": "wipe-site-data@adrianlois", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Wipe Site Data", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/psl.js", "lib/wipe.js", "background.js"]}, "permissions": ["activeTab", "tabs", "cookies", "browsingData", "history", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"description": "Abrir popup de Wipe Site Data"}}}