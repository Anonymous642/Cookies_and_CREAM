{"manifest_version": 2, "name": "Deal Finder Zillow", "version": "1.0.2", "description": "Overlay EPA hazard sites and FEMA flood zones on Zillow, Redfin and Realtor.com listings. Know your property risks before you buy.", "browser_specific_settings": {"gecko": {"id": "dealfinderzillow@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "https://*.redfin.com/*", "https://*.zillow.com/*", "https://*.realtor.com/*", "https://nominatim.openstreetmap.org/*", "https://ofmpub.epa.gov/*", "https://hazards.fema.gov/*", "https://*.replit.app/*"], "content_scripts": [{"matches": ["https://*.redfin.com/*", "https://*.zillow.com/*", "https://*.realtor.com/*"], "css": ["styles/inject.css"], "js": ["utils/utils.js", "components/card.js", "content/common.js", "content/listing_page.js", "content/main.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": ["icons/*.png", "styles/*.css"], "content_security_policy": "script-src 'self'; object-src 'self'"}