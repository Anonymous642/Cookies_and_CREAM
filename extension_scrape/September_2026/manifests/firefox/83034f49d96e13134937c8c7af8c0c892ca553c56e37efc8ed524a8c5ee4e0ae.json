{"manifest_version": 3, "name": "Agaime", "version": "0.1.6", "description": "AI image upscaling via native desktop app", "permissions": ["storage", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "dist/src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "dist/src/options/index.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["onboarding/*"], "matches": ["<all_urls>"]}, {"resources": ["dist/content/*", "dist/onboarding/*", "dist/shared/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["dist/background/service-worker.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "agiame-local@upscaler.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}