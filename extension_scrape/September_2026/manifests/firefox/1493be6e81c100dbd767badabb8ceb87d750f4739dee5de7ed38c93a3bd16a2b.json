{"manifest_version": 3, "name": "Toggl Week Aggregator", "version": "1.1.1", "icons": {"128": "icons/icon128.png"}, "description": "Aggregate Toggl Track calendar durations by search term (current week view).", "browser_specific_settings": {"gecko": {"id": "toggl-week-aggregator@example.com", "strict_min_version": "109.0"}}, "permissions": [], "host_permissions": ["https://track.toggl.com/*", "https://app.track.toggl.com/*", "https://toggl.com/*"], "content_scripts": [{"matches": ["https://track.toggl.com/*", "https://app.track.toggl.com/*", "https://toggl.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}