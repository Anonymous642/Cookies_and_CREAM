{"manifest_version": 2, "name": "Mute Site", "version": "1.5.0", "description": "Allows to instantly mute/unmute websites.", "browser_specific_settings": {"gecko": {"id": "oconnerrev@gmail.com", "strict_min_version": "120.0"}}, "icons": {"48": "icons/unmute.svg", "96": "icons/unmute.svg"}, "permissions": ["tabs", "menus", "storage"], "browser_action": {"default_icon": "icons/unmute.svg", "default_title": "Muted Websites", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-mute": {"suggested_key": {"default": "Ctrl+Alt+M"}, "description": "Toggle mute/unmute for the current site"}}}