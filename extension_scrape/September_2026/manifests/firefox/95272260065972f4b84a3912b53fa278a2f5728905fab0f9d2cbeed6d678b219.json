{"manifest_version": 3, "name": "TabAutopilot \u2013 Smart Tab Manager & Tab Groups", "description": "Smart tab manager for Firefox: auto-group tabs into tab groups by topic, snooze tabs for later, hibernate inactive tabs to free memory, close duplicate tabs and save sessions as workspaces. 100% local \u2014 zero network requests.", "version": "0.8.8", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "alarms", "contextMenus", "sessions", "browsingData", "history", "tabGroups"], "browser_specific_settings": {"gecko": {"id": "tabautopilot-@mdrashid.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"group-all": {"suggested_key": {"default": "Alt+G"}, "description": "Auto-group all tabs"}, "close-duplicates": {"suggested_key": {"default": "Alt+D"}, "description": "Close all duplicate tabs"}, "save-workspace": {"suggested_key": {"default": "Alt+S"}, "description": "Save current workspace"}}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "TabAutopilot", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "TabAutopilot"}}