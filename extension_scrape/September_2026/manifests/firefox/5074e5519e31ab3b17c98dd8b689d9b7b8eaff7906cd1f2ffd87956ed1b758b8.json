{"manifest_version": 2, "name": "Smart Example Finder", "version": "1.3", "description": "Highlight a term and get a simple example to understand it better.", "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Find an Example", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Smart-Example-Finder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}