{"manifest_version": 3, "name": "Google Cal All Day Highlight", "version": "5.0", "description": "Tints every day covered by an all-day event marked Busy on Google Calendar, so the days you are actually booked stand out in any view.", "author": "Derek Larson", "browser_specific_settings": {"gecko": {"id": "{c7d63c9c-fbad-4cef-b0b4-e1a43de164f3}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "minimum_chrome_version": "111", "permissions": ["storage"], "host_permissions": ["https://calendar.google.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html", "default_title": "Google Cal All Day Highlight"}, "content_scripts": [{"matches": ["https://calendar.google.com/*"], "js": ["pageHook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://calendar.google.com/*"], "js": ["color.js", "contentScript.js"], "run_at": "document_start"}]}