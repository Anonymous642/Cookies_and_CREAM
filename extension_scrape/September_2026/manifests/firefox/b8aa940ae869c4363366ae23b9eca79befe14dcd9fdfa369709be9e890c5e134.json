{"manifest_version": 3, "name": "Kick Image Embedder", "version": "1.0", "description": "Embeds image links and improves image handling in Kick.com chat", "permissions": ["activeTab"], "icons": {"32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "kickimageembedder@example.com"}}, "content_scripts": [{"matches": ["*://kick.com/*"], "js": ["content.js"], "css": ["styles.css"]}]}