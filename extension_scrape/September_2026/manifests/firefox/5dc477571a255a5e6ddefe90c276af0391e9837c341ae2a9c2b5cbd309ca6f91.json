{"manifest_version": 3, "name": "WeatherQuick", "version": "1.0.0", "description": "Quick weather checker. Get current weather for any city with temperature and conditions.", "icons": {"48": "icons-weather/icon-48.png", "96": "icons-weather/icon-96.png", "128": "icons-weather/icon-128.png"}, "action": {"default_icon": {"48": "icons-weather/icon-48.png", "96": "icons-weather/icon-96.png"}, "default_title": "WeatherQuick", "default_popup": "display-ui/weather.html"}, "permissions": ["storage", "geolocation"], "browser_specific_settings": {"gecko": {"id": "weatherquick@forecast.check", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}