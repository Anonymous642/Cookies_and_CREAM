{"manifest_version": 3, "name": "WebTimeout", "version": "1.1.0", "author": "Jeewantha Lekamwasam", "description": "Block distracting websites on a schedule with a daily snooze allowance.", "homepage_url": "https://github.com/jeewanthakl/webtimeout", "browser_specific_settings": {"gecko": {"id": "webtimeout@jeewanthakl.gmail.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "alarms", "tabs", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/browser-polyfill.min.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js", "lib/browser-polyfill.min.js", "lib/pattern.js", "lib/schedule.js", "lib/snooze.js", "lib/storage.js", "lib/theme.js"], "matches": ["<all_urls>"]}]}