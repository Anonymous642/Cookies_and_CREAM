{"manifest_version": 3, "name": "GhostDocs - Screen & Secret Redactor", "version": "0.1.0", "description": "One hotkey to detect and blur API keys, tokens, emails, and sensitive credentials on any screen.", "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "ghostdocs@local-build.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Redact Secrets (Alt+G)"}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-redact": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Toggle redaction of sensitive credentials"}}}