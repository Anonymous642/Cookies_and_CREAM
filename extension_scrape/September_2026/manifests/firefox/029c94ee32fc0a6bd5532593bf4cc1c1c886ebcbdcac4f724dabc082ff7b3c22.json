{"manifest_version": 3, "name": "SpeedBang - Multiplatform Video Speed Booster", "version": "1.0.0", "description": "Universal video speed controller for all platforms. Control 0.25x to 16x speed with keyboard shortcuts and site memory.", "browser_specific_settings": {"gecko": {"id": "speedbang@synthralabs.com", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["styles/overlay.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "SpeedBang Speed Controller"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"speed_up": {"suggested_key": {"default": "Alt+Up"}, "description": "Increase video speed"}, "speed_down": {"suggested_key": {"default": "Alt+Down"}, "description": "Decrease video speed"}, "reset_speed": {"suggested_key": {"default": "Alt+R"}, "description": "Reset to normal speed"}}}