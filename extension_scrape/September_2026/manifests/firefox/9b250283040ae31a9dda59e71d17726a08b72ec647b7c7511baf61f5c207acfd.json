{"name": "nyatching-list", "description": "An extention to keep track of tv shows and movies that you are currently watching", "version": "2.0.1", "homepage_url": "https://github.com/v1nc3t/nyatching-list", "manifest_version": 3, "icons": {"16": "img/logo-16.png", "32": "img/logo-32.png", "48": "img/logo-48.png", "128": "img/logo-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": "img/logo-128.png"}, "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "web_accessible_resources": [{"matches": ["https://www.imdb.com/*"], "resources": ["img/logo-16.png", "img/logo-32.png", "img/logo-48.png", "img/logo-128.png"]}], "options_ui": {"page": "src/dashboard/dashboard.html", "open_in_tab": true}, "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://api.themoviedb.org/3/*", "https://www.imdb.com/*"], "browser_specific_settings": {"gecko": {"id": "nyatching-list@v1nc3t.github.io", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}