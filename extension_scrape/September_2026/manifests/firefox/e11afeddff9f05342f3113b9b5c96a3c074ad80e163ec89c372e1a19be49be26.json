{"manifest_version": 3, "name": "Brightery OTP Vault & Autofill", "description": "Scan QR codes, autofill OTP codes, and manage your 2FA accounts", "version": "2.0.2", "permissions": ["contextMenus", "scripting", "activeTab", "storage", "tabs", "clipboardWrite", "notifications", "webRequest", "webRequestBlocking"], "host_permissions": ["https://auth.brightery.com/*", "https://*/", "<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"200": "assets/icons/icon.png"}}, "icons": {"200": "assets/icons/icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["jsQR.js", "autofill_selector.js", "qr_scanner.js"]}], "web_accessible_resources": [{"resources": ["assets/*", "autofill_selector.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://auth.brightery.com/; font-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "otp-manager-autofill@brightery.com", "strict_min_version": "109.0"}}}