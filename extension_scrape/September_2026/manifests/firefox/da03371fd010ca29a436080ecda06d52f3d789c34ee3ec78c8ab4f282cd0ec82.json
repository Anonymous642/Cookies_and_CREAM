{"manifest_version": 3, "name": "Jelly2Anki", "version": "2.2.9", "description": "Mina oraciones en Jellyfin y en la web para Anki.", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "clipboardWrite"], "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1/*", "http://localhost/*", "http://*/*", "*://translate.googleapis.com/*", "*://chatgpt.com/*", "*://*.reddit.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "jelly2anki@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["<all_urls>"], "js": ["reddit_reader.js"], "css": ["reddit_reader.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/Roboto-Regular.ttf", "fonts/Roboto-Bold.ttf", "icons/crear_tarjeta_icono.png", "icons/configuracion.png", "icons/icon48.png", "jm_style.css"], "matches": ["*://*/*"]}]}