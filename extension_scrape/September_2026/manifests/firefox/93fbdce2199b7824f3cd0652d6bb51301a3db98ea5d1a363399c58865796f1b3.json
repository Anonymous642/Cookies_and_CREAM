{"manifest_version": 3, "name": "PicPicker", "version": "2.3.3", "description": "Privacy-first browser extension to extract all images from any webpage with one click", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "downloads"], "action": {"default_title": "PicPicker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"extract-images": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Extract images from the current page"}}, "browser_specific_settings": {"gecko": {"id": "picpicker@flesler.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}