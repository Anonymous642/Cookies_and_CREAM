{"manifest_version": 2, "name": "Unblur Glassdoor Reviews", "version": "1.0", "description": "Unblurs the reviews page on Glassdoor", "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@unblur-glassdoor", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "images/favicon-16x16.png", "32": "images/favicon-32x32.png", "48": "images/favicon.ico", "128": "images/apple-touch-icon.png", "192": "images/android-chrome-192x192.png", "512": "images/android-chrome-512x512.png"}, "browser_action": {"default_icon": {"48": "images/favicon.ico"}}, "permissions": ["tabs", "activeTab", "webNavigation"]}