{"manifest_version": 3, "name": "Duck Duck Mail", "version": "0.1", "description": "This extensions allows you to generate a private DuckDuckGo address send messages from it. You need to have your DuckDuckGo email configured at https://duckduckgo.com/email in order to use it.", "browser_specific_settings": {"gecko": {"id": "@duckduckmail", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options/options.html"}, "permissions": ["storage"], "host_permissions": ["https://quack.duckduckgo.com/api/email/addresses"]}