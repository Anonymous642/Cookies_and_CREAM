{"manifest_version": 3, "name": "CredenShare", "short_name": "CredenShare", "version": "0.1.0", "description": "Send credentials as end-to-end encrypted links from your toolbar, plus 15 developer tools that run offline.", "homepage_url": "https://credenshare.io", "permissions": ["storage", "cookies", "clipboardWrite"], "host_permissions": ["https://app.credenshare.io/*"], "action": {"default_title": "CredenShare", "default_popup": "popup/index.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["https://app.credenshare.io/*"], "js": ["content/app-bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "extension@credenshare.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}}