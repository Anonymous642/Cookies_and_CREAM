{"manifest_version": 2, "name": "TimeKeeper", "version": "1.0.1", "description": "Adds inline local time conversions next to recognizable date and time mentions.", "browser_specific_settings": {"gecko": {"id": "timekeeper@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "storage", "http://*/*", "https://*/*"], "browser_action": {"default_title": "TimeKeeper", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "background": {"scripts": ["src/timekeeper-core.js", "src/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["src/styles.css"], "js": ["src/timekeeper-core.js", "src/document-context.js", "src/content.js"], "run_at": "document_idle"}]}