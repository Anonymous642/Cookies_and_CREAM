{"manifest_version": 3, "name": "Audio Booster & Smoother", "description": "Boost site audio and toggle smoothing in real time.", "version": "4.4", "permissions": ["storage", "scripting"], "host_permissions": ["*://*/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Toggle Site Audio panel"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko_android": {"strict_min_version": "142.0"}, "gecko": {"id": "site-audio-tools@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}