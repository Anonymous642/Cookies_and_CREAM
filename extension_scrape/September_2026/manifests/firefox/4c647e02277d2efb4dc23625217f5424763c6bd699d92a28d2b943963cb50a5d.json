{"manifest_version": 2, "name": "LinkedIn Job Analytics", "description": "Show the hidden analytics behind LinkedIn Job Postings", "version": "0.1.0", "short_name": "LinkedIn Analytics", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["cookies", "storage", "*://*.linkedin.com/*"], "browser_specific_settings": {"gecko": {"id": "LinkedInJobAnalytics@parab.com"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "run_at": "document_end", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}