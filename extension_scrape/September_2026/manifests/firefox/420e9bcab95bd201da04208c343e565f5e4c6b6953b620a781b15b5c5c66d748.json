{"manifest_version": 2, "name": "Zad Academy Auto Login", "version": "1.0", "description": "Automatically logs in to Zad Academy", "permissions": ["storage", "*://login.zad-academy.com/*"], "content_scripts": [{"matches": ["*://login.zad-academy.com/login*"], "js": ["src/js/content.js"]}], "browser_action": {"default_popup": "src/html/popup.html", "default_icon": {"48": "src/icons/icon-48.svg", "96": "src/icons/icon-96.svg"}}, "options_ui": {"page": "src/html/options.html"}, "browser_specific_settings": {"gecko": {"id": "zad-auto-login@flacial.dev", "strict_min_version": "58.0"}}, "icons": {"48": "src/icons/icon-48.svg", "96": "src/icons/icon-96.svg"}}