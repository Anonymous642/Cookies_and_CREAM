{"manifest_version": 2, "name": "YouTube Subscriptions: Hide \"Top Picks\" Shelf", "version": "1.0.0", "description": "Hides the \"Top Picks\" shelf on YouTube Subscriptions (/feed/subscriptions).", "icons": {"48": "icons/48.png", "96": "icons/96.png"}, "browser_specific_settings": {"gecko": {"id": "yt-hide-top-picks@your-domain", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.youtube.com/feed/subscriptions*"], "js": ["content.js"], "run_at": "document_idle"}]}