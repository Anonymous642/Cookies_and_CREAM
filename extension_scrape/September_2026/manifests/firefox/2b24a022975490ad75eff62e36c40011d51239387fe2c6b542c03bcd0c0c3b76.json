{"manifest_version": 2, "name": "Summarize with Claude", "version": "1.2", "description": "Extract article text and send it to Claude.ai for summarization", "icons": {"48": "icon.png"}, "permissions": ["activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "summarize-with-claude@firefox", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "113.0"}}, "browser_action": {"default_icon": "icon.png", "default_title": "Summarize with Claude"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://claude.ai/*"], "js": ["autosubmit.js"], "run_at": "document_idle"}]}