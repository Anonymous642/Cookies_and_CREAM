{"manifest_version": 2, "name": "SURIV", "version": "0.1.1", "description": "SURIV \u2014 h\u1ec7 th\u1ed1ng b\u1ea3o v\u1ec7 web m\u00f4 ph\u1ecfng virus sinh h\u1ecdc, k\u00edch ho\u1ea1t th\u1ee7 c\u00f4ng theo t\u1eebng m\u1ee5c ti\u00eau ng\u01b0\u1eddi d\u00f9ng ch\u1ecdn. Kh\u00f4ng ph\u1ea3i malware, kh\u00f4ng t\u1ef1 nh\u00e2n b\u1ea3n, kh\u00f4ng t\u1ef1 ph\u00e1t t\u00e1n.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "tabs", "contextMenus", "storage"], "background": {"scripts": ["kernel.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "SURIV"}, "browser_specific_settings": {"gecko": {"id": "suriv@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}