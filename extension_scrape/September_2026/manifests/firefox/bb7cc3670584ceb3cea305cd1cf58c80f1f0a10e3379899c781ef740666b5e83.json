{"manifest_version": 3, "name": "Filtre YouTube", "version": "1.0", "description": "Bloque les vid\u00e9os YouTube si la cha\u00eene n'est pas dans votre liste blanche.", "browser_specific_settings": {"gecko": {"id": "ereng@filtre-youtube", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitch.tv/*", "*://suggestqueries.google.com/*"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}]}