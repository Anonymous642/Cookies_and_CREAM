{"manifest_version": 3, "name": "PeakURL", "version": "1.0.2", "description": "Create short links instantly with your self-hosted PeakURL install.", "homepage_url": "https://peakurl.org", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "PeakURL", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "storage", "contextMenus", "scripting", "clipboardWrite"], "host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "peakurl-firefox-addon@peakurl.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}