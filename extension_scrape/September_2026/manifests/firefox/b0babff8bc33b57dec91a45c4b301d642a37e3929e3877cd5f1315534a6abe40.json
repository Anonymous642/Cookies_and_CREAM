{"manifest_version": 3, "name": "LeadsHive \u2014 Google Maps Scraper", "version": "1.4.0", "description": "Scrape Google Maps search results (name, rating, address, phone, website, hours) and export to Excel, CSV, or Markdown. No limits, no signup.", "author": "Yahya Zekry", "homepage_url": "https://github.com/YahyaZekry", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Show/hide LeadsHive panel"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.google.com/maps*", "https://www.google.com/maps/*"], "js": ["lib/xlsx.full.min.js", "content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "leadshive@yahyazekry.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}