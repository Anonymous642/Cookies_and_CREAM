{"manifest_version": 2, "name": "Reddit Feed Blocker", "version": "1.0.1", "description": "Blocks unwanted subreddits in /r/popular and /r/all", "permissions": ["storage"], "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_popup": "popup/popup.html", "default_title": "Reddit Feed Blocker"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.reddit.com/r/popular*", "*://*.reddit.com/r/all*", "*://*.reddit.com/r/Popular*", "*://*.reddit.com/r/All*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "reddit-feed-blocker@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}