{"manifest_version": 3, "name": "Capturly - Mic & Camera Check", "short_name": "Capturly", "version": "2.12.0", "description": "Test your mic & camera quality before video calls. Get confidence that everyone can see and hear you.", "minimum_chrome_version": "121", "browser_specific_settings": {"gecko": {"id": "check@capturly.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Capturly - Check your setup", "theme_icons": [{"light": "icons/icon-16-light.png", "dark": "icons/icon-16.png", "size": 16}, {"light": "icons/icon-32-light.png", "dark": "icons/icon-32.png", "size": 32}]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Open Capturly Check"}}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"], "js": ["content-scripts/detector.js"], "css": ["content-scripts/overlay.css"], "run_at": "document_idle"}], "storage": {"managed_schema": "managed-schema.json"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}