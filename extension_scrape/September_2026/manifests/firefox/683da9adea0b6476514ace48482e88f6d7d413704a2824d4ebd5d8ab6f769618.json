{"manifest_version": 2, "name": "PipedPlayer", "version": "1.0.2", "description": "Redirects from Youtube to Piped", "icons": {"48": "icons/Piped-48.png"}, "browser_specific_settings": {"gecko": {"id": "PipedPlayer@jacoblightning3"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.youtube.com/watch?v=*", "*://*.youtube.com/shorts/*"], "js": ["PipedPlayer.js"]}], "browser_action": {"default_popup": "popup/popup.html"}}