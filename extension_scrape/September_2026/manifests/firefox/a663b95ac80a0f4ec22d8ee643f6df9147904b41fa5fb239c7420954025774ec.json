{"manifest_version": 3, "name": "P7M Extractor", "description": "Estrae e visualizza localmente i documenti contenuti nei file CAdES .p7m, inclusi gli allegati scaricati dai portali PEC.", "version": "1.0.3", "permissions": ["contextMenus", "scripting", "storage", "unlimitedStorage", "webRequest", "webRequestBlocking"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "P7M Extractor", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "browser_specific_settings": {"gecko": {"id": "p7m-extractor@flmlab.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "author": "Ferdinando La Mattina"}