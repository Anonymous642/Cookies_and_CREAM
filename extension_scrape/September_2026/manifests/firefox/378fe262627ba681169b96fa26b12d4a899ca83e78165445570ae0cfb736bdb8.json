{"manifest_version": 3, "name": "ViewPassword", "version": "1.1.0", "description": "Reveal passwords and copy values from password and select fields with one click. 100% local.", "author": "Nikba Creative Studio", "homepage_url": "https://www.nikba.com", "permissions": ["clipboardWrite", "storage", "activeTab"], "action": {"default_title": "ViewPassword", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"copy-focused-password": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy the value of the focused password or select field"}, "toggle-focused-password": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Show/hide the focused password field"}}, "browser_specific_settings": {"gecko": {"id": "viewpassword@nikba.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}