{"manifest_version": 3, "name": "Stock Ticker Dock Bar", "version": "1.0", "description": "Thanh dock theo d\u00f5i gi\u00e1 ch\u1ee9ng kho\u00e1n realtime.", "permissions": ["storage", "alarms"], "host_permissions": ["https://bgapidatafeed.vps.com.vn/*"], "icons": {"48": "icon48.png"}, "action": {"default_popup": "popup.html", "default_title": "C\u1ea5u h\u00ecnh m\u00e3 theo d\u00f5i", "default_icon": "icon48.png"}, "commands": {"toggle-ticker-bar": {"suggested_key": {"default": "Alt+S"}, "description": "\u1ea8n ho\u1eb7c hi\u1ec7n thanh Ticker Bar"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "stock-ticker-bar@thoai-local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_end"}]}