{"manifest_version": 2, "name": "Learnalist Reader", "description": "Grow your vocabulary while reading. Explore words in context, see what you know, and save new words to Learnalist.", "version": "0.1.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "permissions": ["storage", "tabs", "clipboardWrite", "identity", "contextMenus", "https://learnalist.net/*"], "browser_specific_settings": {"gecko": {"id": "pagewise@learnalist.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Learnalist Reader"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_title": "Open Learnalist Reader", "default_icon": {"16": "icon/16.png", "32": "icon/32.png"}}}