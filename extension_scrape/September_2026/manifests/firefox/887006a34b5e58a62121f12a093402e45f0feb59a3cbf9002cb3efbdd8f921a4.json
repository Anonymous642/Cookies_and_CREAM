{"manifest_version": 3, "name": "Bolded LinkedIn", "version": "0.2.0", "description": "Bold maker extension for LinkedIn that adds a bold toggle button beside the emoji button.", "browser_specific_settings": {"gecko": {"id": "bolded-linkedin-composer@example.local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/Bolded-48.png", "96": "icons/Bolded.svg"}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "all_frames": true, "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}