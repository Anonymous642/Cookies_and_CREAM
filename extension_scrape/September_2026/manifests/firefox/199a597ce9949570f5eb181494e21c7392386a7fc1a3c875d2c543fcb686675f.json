{"manifest_version": 2, "name": "Spoiler Shield for GTA 6", "version": "1.2.0", "description": "Automatically blurs GTA 6 spoilers \u2014 text, sentences and thumbnails. Protect your experience before launch.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_popup": "popup/popup.html", "default_title": "Spoiler Shield for GTA 6"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["blur.css"], "run_at": "document_idle", "all_frames": true}], "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "gta6-spoiler-shield@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}