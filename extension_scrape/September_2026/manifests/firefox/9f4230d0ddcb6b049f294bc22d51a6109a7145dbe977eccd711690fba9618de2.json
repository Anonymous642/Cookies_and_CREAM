{"manifest_version": 3, "name": "Max Skip Intro", "version": "1.0", "description": "Automatically skips intros on Max (HBO Max). Toggle on/off from the toolbar icon.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "max-skip-intro@firefox-addon", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_popup": "popup/popup.html", "default_title": "Max Skip Intro"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.max.com/*", "*://*.hbomax.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}