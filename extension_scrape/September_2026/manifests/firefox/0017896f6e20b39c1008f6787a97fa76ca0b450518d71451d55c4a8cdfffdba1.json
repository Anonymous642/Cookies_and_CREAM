{"manifest_version": 3, "name": "Voice Watch Connector", "description": "Connects Roblox voice chat status to the local Voice Watch desktop app.", "version": "0.1.6", "permissions": ["nativeMessaging", "storage"], "host_permissions": ["https://voice.roblox.com/*", "https://www.roblox.com/*", "https://users.roblox.com/*", "https://presence.roblox.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["service_worker.js"]}, "content_scripts": [{"matches": ["https://www.roblox.com/games/*"], "js": ["rejoin.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["rejoin_page.js"], "matches": ["https://www.roblox.com/*"]}], "action": {"default_title": "Voice Watch", "default_popup": "connect.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "voice-watch-connector@qxshio.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}