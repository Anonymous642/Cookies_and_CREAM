{"manifest_version": 3, "name": "YT channel switch", "version": "1.1", "browser_specific_settings": {"gecko": {"id": "YTchannelswitch@miseml.github"}}, "description": "Switch between left and right channels with keyboard shortcuts.", "icons": {"48": "icons/border-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["commands.js", "content_script.js"], "all_frames": true, "run_at": "document_start"}], "background": {"scripts": ["commands.js", "background.js"]}, "permissions": ["tabs"], "action": {"default_title": "YT channel switch", "default_popup": "index.html"}, "commands": {"active_tab_left_channel": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Play left channel only(mono)"}, "active_tab_right_channel": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Play right channel only(mono)"}, "active_tab_stereo": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Play stereo"}, "active_tab_mute": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Mute"}}}