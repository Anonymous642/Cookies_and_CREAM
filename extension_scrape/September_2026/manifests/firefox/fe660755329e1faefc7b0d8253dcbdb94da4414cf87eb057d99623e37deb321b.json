{"manifest_version": 2, "name": "Domain Tracker", "version": "0.1", "description": "Tracks active domains and sends to configurable API endpoint every 15 seconds", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "permissions": ["tabs", "storage", "http://*/", "https://*/", "<all_urls>"], "web_accessible_resources": ["control.html"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_title": "Domain Tracker - Open Control Panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "control.html", "open_in_tab": true}, "applications": {"gecko": {"id": "domain-tracker@tracker.com", "strict_min_version": "78.0"}}}