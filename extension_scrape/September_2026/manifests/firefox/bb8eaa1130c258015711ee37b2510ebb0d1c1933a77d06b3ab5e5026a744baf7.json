{"manifest_version": 3, "name": "CirqleSync", "version": "1.0.0", "description": "Capture a LinkedIn profile into your CRM with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "CirqleSync", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.linkedin.com/in/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/in/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "cirqlesync@cirqle.cards", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}}}}