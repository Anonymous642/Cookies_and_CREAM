{"manifest_version": 2, "name": "YouTube Speed Controller", "version": "1.3", "description": "Control YouTube playback speed from the extension popup and keyboard shortcuts", "browser_specific_settings": {"gecko": {"id": "@youtube-speed-controller-vatsaljf", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}}, "permissions": ["activeTab", "storage", "tabs"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["common.js", "content.js"], "run_at": "document_idle"}]}