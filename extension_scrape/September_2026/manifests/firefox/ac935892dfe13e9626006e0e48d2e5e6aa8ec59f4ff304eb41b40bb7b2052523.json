{"manifest_version": 2, "name": "Slow Social", "version": "1.0", "description": "Beat the doomscroll by making social media less appealing.", "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*"], "js": ["wait.js"], "css": ["slow.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "website-delay@example.com", "data_collection_permissions": {"required": ["none"]}}}}