{"manifest_version": 3, "name": "ToolsTray CORS & API Helper", "description": "Companion to the ToolsTray API Client. Sends requests a browser tab cannot: no CORS, all headers, real cookies, Digest auth.", "version": "1.0.3", "browser_specific_settings": {"gecko": {"id": "cors-helper@toolstray.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://toolstray.com/tools/api-client*"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["declarativeNetRequestWithHostAccess", "webRequest", "webRequestAuthProvider"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "ToolsTray CORS & API Helper", "default_popup": "grant.html"}}