{"manifest_version": 3, "name": "Launch Block for Imgur", "version": "1.0.0", "description": "Puts a covered launch button next to Imgur usernames. Lift the cover, press the button, and that user is blocked.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["cookies"], "host_permissions": ["https://imgur.com/*", "https://api.imgur.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://imgur.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "launch-block@diegomakesthings", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}