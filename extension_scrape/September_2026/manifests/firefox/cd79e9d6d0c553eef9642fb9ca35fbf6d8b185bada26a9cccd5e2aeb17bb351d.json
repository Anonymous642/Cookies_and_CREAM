{"name": "Touch-Base TUIO Bridge", "version": "1.1.0", "description": "Converts TUIO touches delivered via WebSockets to standard HTML 5 touches", "manifest_version": 2, "background": {"scripts": ["osc.js", "background.js"]}, "content_scripts": [{"all_frames": true, "js": ["content.js"], "matches": ["<all_urls>"], "run_at": "document_start"}], "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "64": "icon_64.png", "128": "icon_128.png"}, "web_accessible_resources": ["touchbase-touch-event-generator.js"], "options_ui": {"page": "options.html"}, "permissions": ["activeTab", "storage", "scripting", "tabs"], "browser_specific_settings": {"gecko": {"id": "updd-tuio-bridge@touch-base.com", "strict_min_version": "57.0"}}}