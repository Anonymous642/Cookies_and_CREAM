{"manifest_version": 3, "name": "Switch Channels", "version": "0.1.0", "browser_specific_settings": {"gecko": {"id": "{3f7d9b2e-8e1c-4d4a-9a66-2e6f1b9b6fd2}", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["browsingActivity"]}}}, "description": "Randomly switch TV channels on streaming platforms (Pluto, Tubi, Plex, etc.)", "permissions": ["storage", "alarms", "scripting", "tabs", "activeTab"], "host_permissions": ["*://*.pluto.tv/*", "*://*.tubitv.com/*", "*://*.plex.tv/*", "*://*.tvpass.org/*"], "background": {"scripts": ["src/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.pluto.tv/*", "*://*.tubitv.com/*", "*://*.plex.tv/*", "*://*.tvpass.org/*"], "js": ["src/adapters/plutotv.js", "src/adapters/tubitv.js", "src/adapters/generic.js", "src/content_script.js"], "run_at": "document_idle"}]}