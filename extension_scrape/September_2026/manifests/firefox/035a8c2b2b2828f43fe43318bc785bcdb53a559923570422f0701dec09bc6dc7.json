{"manifest_version": 3, "name": "InboxClean AI \u2014 Bulk Email Organizer", "version": "1.0", "description": "Clean your Gmail inbox locally. Keep the newest emails from your favorite senders, delete the old junk. 100% private.", "browser_specific_settings": {"gecko": {"id": "inboxclean@inboxclean.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["*://mail.google.com/*", "*://inboxclean.net/*"], "icons": {"128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "InboxClean AI", "default_icon": {"128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://inboxclean.net/*", "file:///*dashboard.html*"], "js": ["dashboard_sync.js"], "run_at": "document_idle"}]}