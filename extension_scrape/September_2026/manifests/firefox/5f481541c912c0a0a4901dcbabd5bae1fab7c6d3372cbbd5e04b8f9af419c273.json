{"manifest_version": 3, "name": "PopUp Fact Check for YouTube", "version": "2.0.28.1", "description": "Real-time fact-check bubbles on YouTube videos. Wire-service sources (AP, Reuters). Free, no credit card \u2014 one-click Google sign-in.", "browser_specific_settings": {"gecko": {"id": "extension@popupfactcheck.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["personallyIdentifyingInfo"]}}}, "permissions": ["identity", "storage", "webRequest"], "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "https://api.popupfactcheck.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://www.youtube.com/*"], "js": ["page-interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://youtube.com/*", "*://www.youtube.com/*"], "js": ["audio-transcriber.js", "transcript-preloader.js", "batch-processor.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "PopUp Fact Check for YouTube"}, "homepage_url": "https://www.popupfactcheck.com", "author": "PopUp Fact Check"}