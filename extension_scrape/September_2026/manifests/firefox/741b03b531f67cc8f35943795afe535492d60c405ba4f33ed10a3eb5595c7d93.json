{"manifest_version": 3, "name": "Earth View Neo", "version": "1.0.0", "description": "Experience a beautiful image from Google Earth every time you open a new tab.", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://www.gstatic.com/prettyearth/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "@earth-view-neo", "data_collection_permissions": {"required": ["none"]}}}}