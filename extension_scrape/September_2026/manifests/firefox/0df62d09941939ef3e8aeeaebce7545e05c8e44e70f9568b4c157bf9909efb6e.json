{"manifest_version": 2, "name": "Influencer Tracker", "version": "1.3", "description": "Track, save, and manage influencer profiles across platforms. Helps marketers monitor influencer pages, notes, and activity efficiently.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_title": "Influencer Tracker", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Influencer-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}