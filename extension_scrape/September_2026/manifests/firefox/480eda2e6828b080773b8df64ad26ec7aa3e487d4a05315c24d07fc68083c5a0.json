{"manifest_version": 3, "name": "Auto Tab Sorter", "version": "1.0.0", "description": "Automatically clusters tabs by website (domain) as soon as tabs are created or navigated, while respecting native Firefox tab groups.", "permissions": ["tabs", "tabGroups", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Auto Tab Sorter", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "auto-tab-sorter@local.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}