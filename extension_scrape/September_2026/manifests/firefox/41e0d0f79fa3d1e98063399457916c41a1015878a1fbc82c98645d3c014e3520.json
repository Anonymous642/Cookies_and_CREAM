{"manifest_version": 2, "name": "PhishArmor", "description": "AI-powered phishing & scam detection. Get a scam score for emails and webpages.", "version": "0.2.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "https://mail.google.com/*", "https://mail.yahoo.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://api.phisharmor.io/*"], "browser_specific_settings": {"gecko": {"id": "extension@phisharmor.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent", "websiteActivity", "authenticationInfo"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "PhishArmor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/gmail.js"]}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*"], "run_at": "document_idle", "js": ["content-scripts/outlook.js"]}, {"matches": ["https://mail.yahoo.com/*"], "run_at": "document_idle", "js": ["content-scripts/yahoo.js"]}]}