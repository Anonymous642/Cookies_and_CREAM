{"manifest_version": 2, "name": "Marie de' Medici Solitaire", "version": "5.0.0", "description": "A card divination tool. Arrange 36 playing cards by drag and drop, then run the collapse algorithm to reveal the pattern of your intentions. Supports English, Russian, Ukrainian, and Polish.", "browser_specific_settings": {"gecko": {"id": "medici-solitaire@extension", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_title": "Marie de' Medici Solitaire", "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "web_accessible_resources": ["gallery.html", "gallery.js", "i18n.js", "images/*.svg"]}