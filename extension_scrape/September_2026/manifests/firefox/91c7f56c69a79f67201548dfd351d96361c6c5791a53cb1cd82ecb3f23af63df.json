{"manifest_version": 3, "name": "Duck.AI Backup", "version": "2.2.1", "description": "Backup and export your Duck.AI conversations to Markdown files. Features auto-backup, version history, and Obsidian integration.", "permissions": ["storage", "activeTab", "scripting", "downloads", "alarms", "notifications"], "host_permissions": ["https://duck.ai/*", "https://*.duck.ai/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Duck.AI Backup", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://duck.ai/*", "https://*.duck.ai/*"], "js": ["chat-capture.js"], "run_at": "document_idle"}], "sidebar_action": {"default_title": "Duck.AI Import", "default_panel": "import.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["sidebar-capture.js"], "matches": ["https://duck.ai/*", "https://*.duck.ai/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "stefdesign@yandex.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}