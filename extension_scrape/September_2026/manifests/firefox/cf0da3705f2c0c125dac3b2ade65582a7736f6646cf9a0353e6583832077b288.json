{"manifest_version": 2, "name": "Multi Scout", "version": "1.1.0", "description": "Collect Taobao/Tmall product HTML and send directly to your Multi-Publisher \u2014 no clipboard needed.", "permissions": ["clipboardWrite", "tabs", "storage", "activeTab", "*://*.taobao.com/*", "*://*.tmall.com/*", "*://*/taobao-multi-publisher/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Multi Scout", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "browser_specific_settings": {"gecko": {"id": "multi-scout@firefox", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://*.taobao.com/*", "*://*.tmall.com/*"], "js": ["content_collector.js"], "run_at": "document_end"}, {"matches": ["*://*/taobao-multi-publisher/*"], "js": ["content_multi.js"], "run_at": "document_idle"}]}