{"manifest_version": 3, "name": "MxM In-Editor Formatter (EN)", "version": "1.2.8", "description": "Musixmatch Studio-only formatter. Injects floating tools directly into the editor. (Fix: ? + newline + 'Cause, plural numbers)", "author": "Richard Mangezi Muketa", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*"], "browser_specific_settings": {"gecko": {"id": "mxm-formatter@richie.dev", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}