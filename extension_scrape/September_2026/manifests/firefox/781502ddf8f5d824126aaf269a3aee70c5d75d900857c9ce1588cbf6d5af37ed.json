{"manifest_version": 3, "name": "We-Bo", "version": "1.2.1", "description": "Call worldwide with you We-Bo phone.", "permissions": ["tabs", "scripting"], "host_permissions": ["https://webophone.cloud/*", "https://*.webophone.cloud/*"], "browser_specific_settings": {"gecko": {"id": "{7f02cff0-9757-464a-9f0c-f22aeae24484}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon16-gray.png", "32": "icons/icon32-gray.png", "48": "icons/icon48-gray.png", "128": "icons/icon128-gray.png"}, "default_title": "Open We-Bo Phone."}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png"], "matches": ["<all_urls>"]}]}