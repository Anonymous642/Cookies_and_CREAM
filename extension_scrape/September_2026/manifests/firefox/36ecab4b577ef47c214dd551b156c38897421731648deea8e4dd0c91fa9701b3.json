{"manifest_version": 3, "name": "Czyste Wyniki + Kontrola Czasu", "version": "1.0.1", "description": "Blokuje 18+ (z allowlist\u0105), trackery/reklamy, limity czasu per domena z licznikiem w tytule karty oraz PIN do ustawie\u0144 (1 logowanie dziennie + blokada po 2 b\u0142\u0119dach).", "permissions": ["storage", "tabs", "idle", "declarativeNetRequest", "privacy"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["tab_timer.js"], "run_at": "document_idle"}, {"matches": ["*://www.youtube.com/*"], "js": ["youtube_watch.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@limiter-filtry-yt-edu-pass", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "Limiter i filtry"}}