{"manifest_version": 3, "name": "Roam Activity for Firefox", "version": "1.0.4", "description": "Shows configurable Roam activities while you are actively using matching websites.", "browser_specific_settings": {"gecko": {"id": "roam-activity-firefox@sprint-in.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteActivity"]}}}, "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["activity.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Roam Activity", "default_popup": "popup.html", "default_icon": "icons/roam-gold.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/roam-gold.png", "96": "icons/roam-gold.png"}}