{"manifest_version": 2, "name": "Mini Dark Mode", "version": "1.0.0", "description": "Toggle dark mode on any web page with one click. Per-site preferences are remembered.", "browser_specific_settings": {"gecko": {"id": "mini-dark-mode@MiniDarkMode", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "author": "YOUR_NAME_HERE", "homepage_url": "https://example.com/your-extension-home", "permissions": ["storage", "<all_urls>"], "browser_action": {"default_title": "Mini Dark Mode", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Toggle dark mode on the current tab"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}