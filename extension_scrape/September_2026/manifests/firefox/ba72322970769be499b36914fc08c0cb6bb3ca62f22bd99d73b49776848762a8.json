{"manifest_version": 2, "name": "ClickRemix", "version": "1.1.0", "description": "Personalize any website with just a prompt.", "permissions": ["activeTab", "storage", "<all_urls>", "tabs"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["logger.js", "ratelimit.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "clickremix@example.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}