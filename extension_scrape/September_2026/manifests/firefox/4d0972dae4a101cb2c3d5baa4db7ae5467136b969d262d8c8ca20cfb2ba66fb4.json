{"manifest_version": 3, "name": "MindfulTabs", "version": "1.0", "description": "Streamline your browsing: organize tabs, save sessions, activate focus mode, and get mindful breaks.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_page": "options.html", "background": {"scripts": ["services/background.js"]}, "permissions": ["tabs", "storage", "tabGroups", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "commands": {"toggle-popup": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open MindfulTabs popup"}}, "web_accessible_resources": [{"resources": ["alarm.mp3", "icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "mindfultabs@loopstates.com"}}}