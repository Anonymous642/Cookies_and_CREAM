{"manifest_version": 3, "name": "Tiny Minion", "version": "1.1", "description": "Generate Amazon Tiny URLs with a right-click", "browser_specific_settings": {"gecko": {"id": "tiny-minion@amazon.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "clipboardWrite", "scripting", "activeTab"], "host_permissions": ["https://tiny.amazon.com/*", "https://midway-auth.amazon.com/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}}