{"manifest_version": 3, "name": "Print\u00e3o: captura de p\u00e1gina inteira", "version": "1.8.0", "description": "Printa tudo: p\u00e1gina inteira, \u00e1rea vis\u00edvel ou uma regi\u00e3o. Editor com anota\u00e7\u00f5es e exporta\u00e7\u00e3o em PNG, JPG e PDF.", "permissions": ["activeTab", "scripting", "storage", "alarms"], "host_permissions": ["https://printao.com.br/*"], "background": {"scripts": ["config.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Print\u00e3o", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-full": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capturar p\u00e1gina inteira"}, "capture-quick": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Upload r\u00e1pido da \u00e1rea vis\u00edvel"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "printao@printao.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}