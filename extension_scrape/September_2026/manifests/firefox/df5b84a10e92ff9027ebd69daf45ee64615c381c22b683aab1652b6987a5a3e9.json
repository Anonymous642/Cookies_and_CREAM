{"manifest_version": 3, "name": "ChatGPT DB", "version": "1.0.0", "description": "Fast local title search and organizer for ChatGPT conversations.", "permissions": ["storage", "scripting"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "action": {"default_title": "Open ChatGPT DB", "default_area": "navbar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["scripts/background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["scripts/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "chatgpt-db@extension.local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}