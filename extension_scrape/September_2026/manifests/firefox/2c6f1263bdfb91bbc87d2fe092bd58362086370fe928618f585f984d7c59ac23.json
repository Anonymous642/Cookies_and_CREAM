{"manifest_version": 3, "name": "AI Summarizer", "version": "1.2.0", "description": "Summarizes web articles, YouTube videos, Hacker News threads, Amazon products, and LeetCode problems using user-selected AI providers (Claude, ChatGPT, Gemini, DeepSeek).", "permissions": ["activeTab", "scripting", "tabs", "storage"], "action": {"default_icon": "icon.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "browser_style": true}, "web_accessible_resources": [{"resources": ["Readability.js", "bots/*.js", "sites/*.js"], "matches": ["<all_urls>"]}], "host_permissions": ["https://claude.ai/*", "https://chat.deepseek.com/*", "https://chatgpt.com/*", "https://aistudio.google.com/*", "https://www.youtube.com/*", "https://news.ycombinator.com/*", "https://*.amazon.com/*", "https://leetcode.com/*", "https://*.leetcode.com/*"], "browser_specific_settings": {"gecko": {"id": "summary-article-ext@yourdomain.com", "strict_min_version": "109.0"}}}