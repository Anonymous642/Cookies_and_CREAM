{"manifest_version": 3, "name": "Excel Auto Filler", "version": "1.0", "description": "Auto-fill third-party websites using Excel data with intelligent form detection.", "browser_specific_settings": {"gecko": {"id": "excel-auto-filler@automation.extension", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "scripting", "storage", "tabs", "contextMenus", "webNavigation", "identity", "webRequest"], "host_permissions": ["<all_urls>", "https://graph.microsoft.com/*", "https://login.microsoftonline.com/*"], "action": {"default_title": "Excel Auto Filler", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "js": ["outlook-reader.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}