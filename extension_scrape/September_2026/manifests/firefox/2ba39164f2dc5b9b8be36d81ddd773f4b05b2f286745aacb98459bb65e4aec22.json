{"manifest_version": 3, "name": "ClipThoughts", "version": "1.1", "description": "Save the web to your ClipThoughts collections instantly. Clip articles, YouTube videos, research papers, and highlights \u2014 all in one place.", "homepage_url": "https://clipthoughts.com", "browser_specific_settings": {"gecko": {"id": "extension@clipthoughts.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"], "optional": []}}}, "permissions": ["activeTab", "tabs", "storage", "cookies", "scripting", "contextMenus"], "host_permissions": ["*://clipthoughts.com/*", "*://localhost/*", "<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "Save to ClipThoughts", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["content-scripts/youtube-notes.js"], "run_at": "document_end"}, {"matches": ["*://arxiv.org/abs/*", "*://arxiv.org/pdf/*", "*://pubmed.ncbi.nlm.nih.gov/*"], "js": ["content-scripts/arxiv-notes.js"], "run_at": "document_end"}, {"matches": ["<all_urls>"], "exclude_matches": ["*://www.youtube.com/*", "*://arxiv.org/*", "*://pubmed.ncbi.nlm.nih.gov/*", "*://localhost:3000/*", "*://clipthoughts.com/*"], "js": ["content-scripts/article-notes.js"], "run_at": "document_end"}]}