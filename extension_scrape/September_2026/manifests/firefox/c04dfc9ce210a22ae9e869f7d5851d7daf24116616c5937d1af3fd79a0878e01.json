{"manifest_version": 2, "name": "Clip and Tag", "version": "1.0.0", "description": "Clip, tag, and review your market research insights right in your browser. Fast, private, and entirely local.", "permissions": ["contextMenus", "storage", "activeTab", "notifications", "tabs", "downloads"], "background": {"scripts": ["utils/crypto.js", "background.js"], "persistent": false}, "commands": {"save-clip": {"suggested_key": {"default": "Alt+Shift+Y", "mac": "Alt+Shift+Y"}, "description": "Save highlighted insight"}, "quick-save-last-tag": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Quick save with last-used tag"}, "open-tagger": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Open the Tagger popup"}}, "browser_specific_settings": {"gecko": {"id": "insights@clip-and-tag"}}, "browser_action": {"default_icon": {"16": "icons/logo.svg", "48": "icons/logo.svg", "128": "icons/logo.svg"}}, "icons": {"16": "icons/logo.svg", "48": "icons/logo.svg", "128": "icons/logo.svg"}}