{"manifest_version": 3, "name": "AuthRelay", "short_name": "AuthRelay", "version": "0.1.0", "description": "Sign in with Google on desktop using your phone. Intercepts OAuth redirects and relays them to your mobile device.", "author": "AuthRelay Contributors", "homepage_url": "https://authrelay.app", "browser_specific_settings": {"gecko": {"id": "authrelay@nd.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "webNavigation"], "host_permissions": ["https://accounts.google.com/*", "https://firebaseinstallations.googleapis.com/*", "https://firebase.googleapis.com/*", "https://www.google-analytics.com/*", "https://analytics.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/service-worker.js"], "service_worker": "background/service-worker.js", "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}