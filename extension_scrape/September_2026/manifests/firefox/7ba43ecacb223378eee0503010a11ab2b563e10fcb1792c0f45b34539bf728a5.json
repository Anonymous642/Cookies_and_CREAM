{"name": "YouTube Rating Preview", "version": "6.1.6", "manifest_version": 2, "description": "YouTube Rating Preview is a Firefox extension that displays the likes and dislikes bar over every video thumbnail on YouTube. Instantly gauge a video's rating before deciding to watch it", "background": {"scripts": ["background.js"]}, "icons": {"16": "favicon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["script.js"]}], "permissions": ["*://*/*", "tabs", "contextMenus", "webRequest", "webRequestBlocking", "webNavigation"], "page_action": {"default_icon": {"19": "favicon19gray.png", "38": "favicon38gray.png"}, "default_title": "Ratings Preview settings", "default_popup": "popup.html"}, "options_ui": {"page": "popup.html", "open_in_tab": true, "chrome_style": false}, "browser_specific_settings": {"gecko": {"id": "{f69fb6ff-b396-42fc-95ad-b99892a61770}"}}}