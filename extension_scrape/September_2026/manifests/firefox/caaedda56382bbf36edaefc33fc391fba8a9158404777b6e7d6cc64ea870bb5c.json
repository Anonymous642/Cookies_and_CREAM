{"manifest_version": 2, "name": "Posture Alert", "version": "1.3", "description": "Reminds users to maintain good posture with periodic notifications.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_action": {"default_icon": "icons/logo_64.png", "default_title": "Posture Alert", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["notifications", "storage"], "browser_specific_settings": {"gecko": {"id": "@Posture-Alert", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}