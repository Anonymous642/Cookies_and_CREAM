{"manifest_version": 2, "name": "Guacamole Clipboard Bridge", "version": "5.15.1", "description": "Native copy and paste for HTML5 remote Sessions (Apache Guacamole) in Firefox. Works both ways. Can be restricted to your own domains. Compatible with common PSM/HTML5 gateways. Not affiliated with any vendor.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["clipboardRead", "clipboardWrite", "activeTab", "storage", "<all_urls>"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Guacamole Clipboard Bridge", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["early.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["match.js", "content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["inject.js"], "browser_specific_settings": {"gecko": {"id": "guacamole-clipboard-bridge@addons", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}