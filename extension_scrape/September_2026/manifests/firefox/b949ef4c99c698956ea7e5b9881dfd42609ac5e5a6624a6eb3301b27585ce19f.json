{"manifest_version": 3, "name": "TableGrab \u062c\u062f\u0648\u0644\u200c\u06af\u06cc\u0631", "version": "1.0.0", "description": "Firefox Extension that detects tables on web pages and exports them to Excel (XLSX), CSV, JSON, and HTML formats.", "author": "Ebtekareno Team - Hadi-pd", "homepage_url": "https://ebtekareno.ir", "default_locale": "fa", "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Table Grab", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "browser_style": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["lib/xlsx.full.min.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Firefox Extension that detects tables on web pages and exports them to Excel (XLSX), CSV, JSON, and HTML formats."}}, "browser_specific_settings": {"gecko": {"id": "table-exporter@hadipd", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}