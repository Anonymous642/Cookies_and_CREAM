{"manifest_version": 2, "name": "V2 Saver", "version": "1.3.0", "description": "Effortlessly save and organize web content with tags, descriptions, and quick actions. Now with incognito mode support!", "permissions": ["activeTab", "storage", "tabs", "clipboardWrite", "notifications", "menus"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "V2.png", "32": "V2.png", "48": "V2.png", "128": "V2.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open V2 Saver"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "v2saver@extension.firefox", "strict_min_version": "79.0"}}}