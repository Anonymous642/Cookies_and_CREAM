{"manifest_version": 3, "name": "Visual Annotation Tool", "version": "1.0.0", "description": "Draw, highlight, annotate, and capture screenshots on any webpage. Perfect for feedback, bug reports, and visual collaboration.", "author": "Your Name", "browser_specific_settings": {"gecko": {"id": "visual-annotation@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Visual Annotation Tool", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/annotation.js"], "css": ["content/annotation.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "commands": {"toggle-annotation": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Toggle annotation mode"}, "capture-screenshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture screenshot"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}