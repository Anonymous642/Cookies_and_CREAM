{"manifest_version": 3, "name": "Clatio \u2014 Understand any code instantly", "version": "1.0.0", "description": "Highlight any code on a page \u2014 get a super simple, no-jargon explanation instantly. No coding knowledge needed.", "permissions": ["contextMenus", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "clatio@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "commands": {"explain-selection": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Explain selected code"}}}