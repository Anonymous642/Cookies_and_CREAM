{"manifest_version": 3, "name": "bioniq", "version": "1.0.0", "description": "Dynamic bolding for Firefox - Read with enhanced text emphasis.", "author": "bioniq", "homepage_url": "https://github.com/kunalnaik/bioniq", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "64": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["storage", "activeTab", "scripting"], "action": {"default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}, "default_title": "bioniq", "default_popup": "popup/popup.html"}, "commands": {"toggle-bioniq": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Toggle bioniq on/off"}}, "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "bioniq@kunalnaik.dev", "data_collection_permissions": {"required": ["none"]}}}}