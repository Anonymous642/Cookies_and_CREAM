{"manifest_version": 2, "name": "AI Verdict", "description": "Compare 4 AI models side-by-side and get an intelligent consensus verdict.", "version": "1.1.9", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "declarativeNetRequest", "scripting", "https://*.chatgpt.com/*", "https://*.openai.com/*", "https://*.anthropic.com/*", "https://*.claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*", "https://www.google.com/s2/favicons?*", "https://aiverdict-license.raym0nd.com/*"], "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "aiverdict@aiverdict.io", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://www.google.com https://*.google.com https://*.gstatic.com https://*.chatgpt.com https://*.openai.com https://*.claude.ai https://*.anthropic.com https://*.perplexity.ai;", "declarative_net_request": {"rule_resources": [{"id": "chatgpt", "enabled": true, "path": "chatgpt.json"}, {"id": "gemini", "enabled": true, "path": "gemini.json"}, {"id": "claude", "enabled": true, "path": "claude.json"}, {"id": "perplexity", "enabled": true, "path": "perplexity.json"}, {"id": "frames", "enabled": true, "path": "x-frame-options.json"}]}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "run_at": "document_start", "js": ["content-scripts/chatgpt-runtime.js"], "world": "MAIN"}, {"matches": ["https://gemini.google.com/*"], "run_at": "document_start", "js": ["content-scripts/session-keepalive.js"], "world": "MAIN"}], "browser_action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}}