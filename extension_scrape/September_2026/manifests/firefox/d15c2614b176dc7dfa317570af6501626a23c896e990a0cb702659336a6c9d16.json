{"manifest_version": 2, "name": "Auto-Refresh Manager", "version": "2.4", "description": "Automatically refresh any website with a custom interval", "browser_specific_settings": {"gecko": {"id": "auto-refresh-manager@unicai.de", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/icon-red-16.png", "32": "icons/icon-red-32.png", "48": "icons/icon-red-48.png"}, "default_title": "Auto-Refresh Manager"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon-red-16.png", "32": "icons/icon-red-32.png", "48": "icons/icon-red-48.png", "96": "icons/icon-red-96.png"}}