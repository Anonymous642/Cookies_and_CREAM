{"manifest_version": 3, "name": "TapTapNotes PDF Dictionary", "description": "Read PDFs and look up selected words in a side dictionary pane.", "version": "0.2.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open TapTapNotes Reader", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "permissions": ["tabs", "storage"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "host_permissions": ["https://api.taptapnotes.com/*", "http://127.0.0.1:8787/*", "http://localhost:8787/*", "https://api.dictionaryapi.dev/*", "https://freedictionaryapi.com/*", "https://en.wiktionary.org/*", "https://de.wiktionary.org/*", "https://api.deepseek.com/*"], "browser_specific_settings": {"gecko": {"id": "taptapnotes@taptapnotes.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["searchTerms"], "optional": ["authenticationInfo"]}}}}