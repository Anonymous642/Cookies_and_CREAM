{"manifest_version": 2, "name": "Easy Youtube Unsubscribe", "version": "1.2", "description": "Makes it easier to unsubscribe from channels on Youtube.", "icons": {"48": "icons/yt.svg", "96": "icons/yt.svg"}, "permissions": ["activeTab"], "content_scripts": [{"matches": ["https://www.youtube.com/feed/channels"], "js": ["inject/injectfeed.js"], "css": ["inject/inject.css"], "run_at": "document_end"}, {"matches": ["https://www.youtube.com/watch?*"], "js": ["inject/injectwatch.js"], "css": ["inject/inject.css"]}, {"matches": ["https://www.youtube.com/shorts/*"], "js": ["inject/injectshorts.js"], "css": ["inject/inject.css"]}, {"matches": ["https://www.youtube.com/@*"], "js": ["inject/injectmain.js"], "css": ["inject/inject.css"]}], "browser_specific_settings": {"gecko": {"id": "youtube@ramzihijjawi.me"}}}