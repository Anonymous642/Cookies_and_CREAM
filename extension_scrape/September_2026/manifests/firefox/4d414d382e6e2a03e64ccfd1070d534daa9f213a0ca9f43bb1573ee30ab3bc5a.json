{"manifest_version": 3, "name": "Salesforce Case Queue Alert", "version": "1.0.6", "description": "Auto-refreshes Salesforce Lightning case queues/list views and plays an audio chime when a new case appears.", "browser_specific_settings": {"gecko": {"id": "case-queue-alert@addons.mozilla.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://*.lightning.force.com/*", "https://*.force.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.lightning.force.com/*", "https://*.force.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Salesforce Case Queue Alert", "default_area": "navbar", "default_icon": {"16": "icons/icon-16.png", "19": "icons/icon-19.png", "32": "icons/icon-32.png", "38": "icons/icon-38.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}