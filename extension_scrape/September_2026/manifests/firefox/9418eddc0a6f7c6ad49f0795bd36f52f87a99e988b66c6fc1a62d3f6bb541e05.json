{"manifest_version": 3, "name": "Reddit Streak Helper", "version": "3.2.1", "description": "A web extension that helps maintain a Reddit streak with a simple button to extend it to the next day - and an automated mode to do it for you.", "browser_specific_settings": {"gecko": {"id": "steaker@Almandin.dev", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "host_permissions": ["https://www.reddit.com/*"], "permissions": ["storage", "alarms"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Reddit Streak Helper", "default_popup": "dashboard.html"}, "content_scripts": [{"matches": ["https://www.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}