{"manifest_version": 3, "name": "ZenHighlight", "description": "Highlight in one drag. Optional sync to your company-os second brain.", "version": "2.4.2", "short_name": "ZenHighlight", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "contextMenus", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["sidepanel.html"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_title": "Turn the highlighter on"}, "commands": {"toggle-highlighter": {"suggested_key": {"default": "Alt+H"}, "description": "Highlighter on/off (while on, every drag highlights)"}, "open-panel": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Open the reading panel (and save the page)"}}, "browser_specific_settings": {"gecko": {"id": "pa@shawn.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "ZenHighlight", "open_at_install": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/history.js"], "world": "MAIN"}]}