{"manifest_version": 3, "name": "Local Agent", "version": "0.1.0", "description": "Local-first AI browser agent (Milestone 0 vertical slice) \u2014 talks to a local agent-core process over wss://localhost:8765 (self-signed, loopback-only), never to the cloud by default.", "browser_specific_settings": {"gecko": {"id": "local-agent@spark-7a5f.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "scripting", "alarms"], "host_permissions": ["wss://localhost/*", "wss://127.0.0.1/*", "*://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["src/background.js"], "type": "module"}, "action": {"default_title": "Local Agent (click to open/close the sidebar)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "sidebar_action": {"default_title": "Local Agent", "default_panel": "src/sidebar.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}