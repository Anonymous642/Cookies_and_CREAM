{"manifest_version": 3, "name": "AppsHunter.io \u2014 App Store companion", "description": "Shows price history, chart ranks and review insights from AppsHunter in a side panel.", "version": "0.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": [{"id": "appshunter", "enabled": true, "path": "rules.json"}]}, "host_permissions": ["https://appshunter.io/*", "https://apps.apple.com/*"], "action": {"default_title": "AppsHunter.io"}, "browser_specific_settings": {"gecko": {"id": "extension@appshunter.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "AppsHunter.io"}}