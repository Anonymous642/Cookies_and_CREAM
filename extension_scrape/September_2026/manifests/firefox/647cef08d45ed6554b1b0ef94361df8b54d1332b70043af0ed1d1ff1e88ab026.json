{"manifest_version": 3, "name": "AutoRefresh", "version": "1.0.0", "description": "Simple auto-refresh timer. Automatically refresh page at set intervals.", "icons": {"48": "res/icon-48.png", "96": "res/icon-96.png", "128": "res/icon-128.png"}, "action": {"default_icon": {"48": "res/icon-48.png", "96": "res/icon-96.png"}, "default_title": "AutoRefresh", "default_popup": "panel/refresh.html"}, "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "autorefresh@timer.reload", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["refresher/timer.js"]}}