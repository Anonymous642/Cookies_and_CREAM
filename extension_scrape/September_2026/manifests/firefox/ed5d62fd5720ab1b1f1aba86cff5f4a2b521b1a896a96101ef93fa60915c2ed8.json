{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "sinta-checker@example.com", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}, "name": "SINTA Checker", "version": "0.1.0", "description": "Menampilkan peringkat SINTA jurnal pada Google Scholar.", "content_scripts": [{"matches": ["https://scholar.google.com/scholar*", "https://scholar.google.co.id/scholar*", "https://scholar.google.com/citations*", "https://scholar.google.co.id/citations*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["data/*.json"], "matches": ["https://scholar.google.com/*", "https://scholar.google.co.id/*"]}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SINTA Checker", "default_popup": "popup/popup.html"}}