{"manifest_version": 3, "name": "AniList Quick Search", "version": "1.0.0", "description": "Right-click any selected text to instantly find and open the matching anime (or manga) on AniList.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "notifications", "storage"], "host_permissions": ["https://graphql.anilist.co/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "AniList Quick Search"}, "browser_specific_settings": {"gecko": {"id": "@hated.wtf", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}