{"manifest_version": 3, "name": "The Contextualizer", "version": "1.8.11", "description": "A satirical browser extension that adds clearly-humorous modifiers to news mentions of certain public figures as you browse.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["https://gist.githubusercontent.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "contextualizer@thecontextualizer.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}