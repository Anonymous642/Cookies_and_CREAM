{"manifest_version": 2, "name": "Jira Worklog Calendar", "description": "Shows your daily, weekly, and monthly worklog totals on Jira Cloud boards, issue pages, and other Jira app views.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "*://*.atlassian.net/*"], "browser_specific_settings": {"gecko": {"id": "jira-worklog-calendar@addon", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Worklog Calendar", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.atlassian.net/*"], "run_at": "document_idle", "js": ["content-scripts/jira-board.js"]}], "web_accessible_resources": ["content-scripts/jira-board.css"]}