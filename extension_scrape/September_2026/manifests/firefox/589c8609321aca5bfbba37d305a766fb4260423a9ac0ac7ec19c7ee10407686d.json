{"manifest_version": 3, "name": "Yotta-i Detector for Firefox", "version": "1.2.5", "description": "Extensi\u00f3n para Firefox que detecta fraudes e identifica p\u00e1ginas con contenido de phishing, ofuscamiento de c\u00f3digo malicioso, scams o ingenier\u00eda social.", "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs", "webNavigation", "webRequest"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["security.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "yotta-i-detector@sergioparadac.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors 'none'"}}