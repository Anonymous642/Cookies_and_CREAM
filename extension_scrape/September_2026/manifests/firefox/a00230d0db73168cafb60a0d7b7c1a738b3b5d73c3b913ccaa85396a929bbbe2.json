{"manifest_version": 3, "name": "Tab Overview", "version": "0.6.0", "description": "Panel inferior compacto con tus pesta\u00f1as. Barra que filtra y navega, reabrir pesta\u00f1a cerrada, silenciar audio y cerrar duplicadas. Usa los colores del tema de Firefox.", "browser_specific_settings": {"gecko": {"id": "tab-overview@jddar.dev", "strict_min_version": "115.0"}}, "permissions": ["tabs", "search", "theme", "sessions"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["overview.html", "overview.css", "overview.js", "icons/icon.svg"], "matches": ["<all_urls>"]}], "action": {"default_title": "Tab Overview (abrir/cerrar)"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "commands": {"open-overview": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Abrir/cerrar el panel de pesta\u00f1as"}}}