{"manifest_version": 2, "name": "Last.fm Artwork Upload Helper", "version": "1.2.8", "description": "Streamlines the process of uploading album artwork to Last.fm with visual missing artwork detection", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.last.fm/*", "https://covers.musichoarders.xyz/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Last.fm Artwork Upload Helper", "default_popup": "popup.html"}, "web_accessible_resources": ["icons/*"], "browser_specific_settings": {"gecko": {"id": "last.fm-artwork-helper@chr1sx", "strict_min_version": "109.0"}}}