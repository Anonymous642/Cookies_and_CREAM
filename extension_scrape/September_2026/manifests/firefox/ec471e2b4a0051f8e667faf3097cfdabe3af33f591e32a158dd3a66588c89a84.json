{"manifest_version": 3, "name": "SnapSize: Auto Resize for Exam Portals", "version": "1.0.0", "description": "Auto-detects photo/signature upload requirements on Indian exam portals and resizes images locally. No server. No privacy risk.", "browser_specific_settings": {"gecko": {"id": "snapsize@indianexamportals.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "scripting"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "SnapSize"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/portals.js", "utils/detector.js", "utils/resizer.js", "content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}