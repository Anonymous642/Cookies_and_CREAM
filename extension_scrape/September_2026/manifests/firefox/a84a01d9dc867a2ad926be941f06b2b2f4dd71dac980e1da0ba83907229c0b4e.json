{"manifest_version": 3, "name": "Coffee CRT \u2014 M365 Admin Theme", "version": "1.0.0", "description": "Retro coffee / CRT-phosphor skin for the Microsoft 365 admin center. Fixes hyperlink contrast and overall readability.", "browser_specific_settings": {"gecko": {"id": "coffee-crt@simon.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Coffee CRT", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://admin.cloud.microsoft/*", "https://*.admin.cloud.microsoft/*", "https://admin.microsoft.com/*", "https://*.admin.microsoft.com/*"], "css": ["theme.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["assets/cup.svg"], "matches": ["https://admin.cloud.microsoft/*", "https://*.admin.cloud.microsoft/*", "https://admin.microsoft.com/*", "https://*.admin.microsoft.com/*"]}]}