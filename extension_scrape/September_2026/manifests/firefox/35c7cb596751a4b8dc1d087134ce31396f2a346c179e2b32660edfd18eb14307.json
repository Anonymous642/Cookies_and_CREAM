{"manifest_version": 3, "name": "Dev Toolkit for Odoo", "short_name": "Odoo Toolkit", "version": "1.9.0", "description": "Odoo developer toolkit: debug switcher, field inspector, domain builder, record compare, barcodes, screenshots, recording.", "author": "Golam Mostafa", "homepage_url": "https://gmostafa1210.github.io", "browser_specific_settings": {"gecko": {"id": "dev-toolkit-for-odoo@gmostafa1210.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Dev Toolkit for Odoo", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "background": {"scripts": ["background.bundle.js"]}, "permissions": ["activeTab", "scripting", "storage"], "optional_permissions": ["tabs"], "optional_host_permissions": ["https://claude.ai/*", "http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["content/arch-bridge.js"], "matches": ["http://*/*", "https://*/*"]}], "devtools_page": "devtools/devtools.html", "commands": {"toggle-debug": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Toggle Odoo debug mode (press twice quickly for assets mode)"}, "full-page-capture": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture a full page screenshot"}, "toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start or stop screen recording"}}}