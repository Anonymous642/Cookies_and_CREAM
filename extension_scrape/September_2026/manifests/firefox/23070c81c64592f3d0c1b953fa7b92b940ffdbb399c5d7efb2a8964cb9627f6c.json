{"manifest_version": 3, "name": "SmartZoom Toggle", "description": "Instantly toggle high-resolution image previews and zoom levels on any website with a single hotkey or click.", "version": "1.0.0", "author": "DevLabs Studio", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "smartzoomtoggle@devlabsstudio.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}