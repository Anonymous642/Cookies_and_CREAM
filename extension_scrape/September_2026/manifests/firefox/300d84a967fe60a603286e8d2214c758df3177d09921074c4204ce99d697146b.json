{"manifest_version": 3, "name": "Image Zoom Lightbox", "description": "Open an image zoom lightbox with a configurable double-press shortcut while hovering an image.", "version": "2.1.3", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage"], "action": {"default_title": "Image Zoom Lightbox", "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "image-zoom-lightbox@jasminemixson.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["http://*/*", "https://*/*"]}]}