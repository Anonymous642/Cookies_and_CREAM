{"manifest_version": 2, "name": "Auto Transcript Generator", "version": "1.3", "description": "Automatically generate and export transcripts from online videos.", "permissions": ["activeTab", "storage", "tabs"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/logo_32.png", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}}, "browser_specific_settings": {"gecko": {"id": "@Auto-Transcript-Generator", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}