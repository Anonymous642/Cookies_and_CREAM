{"manifest_version": 3, "name": "Yochatto", "version": "0.4.4", "description": "Twitch chat, the way you want it: resizable chat, layouts, themes, fonts, a better emote picker and moderation shortcuts.", "permissions": ["storage", "alarms"], "host_permissions": ["*://*.twitch.tv/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Yochatto settings", "default_icon": {"16": "icons/toolbar-16.png", "32": "icons/toolbar-32.png", "48": "icons/toolbar-48.png"}, "theme_icons": [{"light": "icons/toolbar-light-16.png", "dark": "icons/toolbar-dark-16.png", "size": 16}, {"light": "icons/toolbar-light-32.png", "dark": "icons/toolbar-dark-32.png", "size": 32}, {"light": "icons/toolbar-light-48.png", "dark": "icons/toolbar-dark-48.png", "size": 48}]}, "web_accessible_resources": [{"resources": ["src/popup/*", "src/logs/*", "src/contact/*", "src/content/*.css", "icons/*"], "matches": ["*://*.twitch.tv/*"]}], "content_scripts": [{"matches": ["*://www.twitch.tv/*", "*://twitch.tv/*"], "js": ["src/content/fresh.js", "src/content/tips.js", "src/content/chat-resize.js", "src/content/chat-style.js", "src/content/context-menus.js", "src/content/third-party-emotes.js", "src/content/autocomplete.js", "src/content/helpers.js", "src/content/float.js"], "css": ["src/content/chat-resize.css", "src/content/chat-style.css"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://yochatto.com/contact*", "https://www.yochatto.com/contact*"], "js": ["src/content/contact-page.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yochatto@jaysem.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["src/background.js"]}}