{"manifest_version": 3, "name": "Ember \u2014 Strict Mode", "version": "1.0.0", "description": "Blocks distracting sites during your Ember Deep Work sessions \u2014 an optional companion to the timer, controlled entirely by you.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://snowy.vercel.app/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "permissions": ["storage", "declarativeNetRequest", "alarms"], "host_permissions": ["https://snowy.vercel.app/*", "https://*.supabase.co/*"], "browser_specific_settings": {"gecko": {"id": "ember-strict-mode@yourdomain.example", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}