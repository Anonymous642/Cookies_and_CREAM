{"manifest_version": 3, "name": "GetSwift", "version": "1.0.5", "description": "Right-click any image, video, audio, or link on any webpage and ship it straight to your GetSwift storage.", "homepage_url": "https://app.getswift.cloud", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "browser_specific_settings": {"gecko": {"id": "getswift@getswift.cloud", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "notifications", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://app.getswift.cloud/extension/connect*"], "js": ["content-connect.js"], "run_at": "document_idle"}], "action": {"default_title": "GetSwift", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U"}}}}