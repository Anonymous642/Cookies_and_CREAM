{"manifest_version": 3, "name": "Tip Translator", "version": "1.2.1", "description": "Quick text translation with multi-language interface support", "browser_specific_settings": {"gecko": {"id": "@tip-translator", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://libretranslate.de/*", "https://api.mymemory.translated.net/*"], "background": {"scripts": ["background/background.js"], "persistent": false}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["localization.js", "content/content.js"], "css": ["content/tooltip.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["content/tooltip.css", "localization.js"], "matches": ["<all_urls>"]}]}