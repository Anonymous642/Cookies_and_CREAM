{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "productivity-blocker@lachlanallison.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "name": "Department of Focus", "version": "1.0.0", "description": "Department of Focus \u2014 restrict distracting sites with schedules, allowances, and impulse-control challenges.", "permissions": ["storage", "tabs", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/blocking.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "new-tab-blocked.html", "new-tab-blocked.js"], "matches": ["<all_urls>"]}]}