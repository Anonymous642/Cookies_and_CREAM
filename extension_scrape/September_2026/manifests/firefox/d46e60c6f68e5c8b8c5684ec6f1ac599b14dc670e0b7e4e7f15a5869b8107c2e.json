{"manifest_version": 3, "name": "Custom New Tab Dashboard", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "new-tab-dashboard@yourgithubusername.com", "data_collection_permissions": {"required": ["locationInfo"], "optional": []}}}, "description": "A customizable dashboard with weather, clock, and pinned apps.", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["storage", "geolocation"], "host_permissions": ["https://api.open-meteo.com/*", "https://www.google.com/*"]}