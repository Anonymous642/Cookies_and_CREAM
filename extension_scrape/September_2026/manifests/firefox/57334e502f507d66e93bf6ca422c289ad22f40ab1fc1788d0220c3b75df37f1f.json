{"manifest_version": 3, "name": "Text to Speech", "version": "1.1.0", "description": "Read any selected text aloud. Uses your browser's built-in voices, or AI voices (opt-in). Free, no account.", "permissions": ["tts", "contextMenus", "storage", "activeTab", "scripting", "offscreen"], "host_permissions": ["https://ai-proxy-production-6b92.up.railway.app/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Text to Speech", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"speak-selection": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Read the currently selected text aloud"}}, "browser_specific_settings": {"gecko": {"id": "text-to-speech@extendforge.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}}