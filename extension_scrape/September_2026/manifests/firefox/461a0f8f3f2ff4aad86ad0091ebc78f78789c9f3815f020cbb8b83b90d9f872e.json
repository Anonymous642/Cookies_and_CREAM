{"manifest_version": 3, "name": "Ublok", "version": "1.0.6", "description": "Block ads, pop-ups, and trackers on every website you visit.", "minimum_chrome_version": "116", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "unlimitedStorage", "scripting", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/filter-parser.js", "src/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/page-guards.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}], "action": {"default_title": "Ublok", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "ads", "enabled": true, "path": "rules/ads.json"}, {"id": "trackers", "enabled": true, "path": "rules/trackers.json"}, {"id": "malware", "enabled": true, "path": "rules/malware.json"}, {"id": "social", "enabled": true, "path": "rules/social.json"}, {"id": "https", "enabled": true, "path": "rules/https.json"}, {"id": "locallang", "enabled": false, "path": "rules/locallang.json"}]}, "browser_specific_settings": {"gecko": {"id": "ublock@example.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}