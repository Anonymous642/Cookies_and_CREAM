{"manifest_version": 3, "name": "Lazada Buyer Order Exporter (Philippines)", "version": "1.1.5", "description": "Export your own Lazada buyer order history to a local archive and accounting-ready CSV, JSON and XLSX files.", "homepage_url": "https://git.jdneer.com/jd/firefox-lazada-order-exporter", "author": "JD Bungart", "browser_specific_settings": {"gecko": {"id": "lazada-order-exporter@jdneer.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"32": "ui/icons/icon-32.png", "48": "ui/icons/icon-48.png", "96": "ui/icons/icon-96.png", "128": "ui/icons/icon-128.png"}, "action": {"default_title": "Lazada Order Exporter", "default_popup": "ui/popup/popup.html", "default_icon": "ui/icons/icon.svg"}, "options_ui": {"page": "ui/dashboard/dashboard.html", "open_in_tab": true}, "background": {"scripts": ["background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://my.lazada.com.ph/*"], "js": ["content/order-list.js"], "run_at": "document_idle"}], "permissions": ["storage", "unlimitedStorage", "downloads", "tabs", "notifications"], "host_permissions": ["https://my.lazada.com.ph/*", "https://member.lazada.com.ph/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}