{"manifest_version": 2, "name": "Jazice - Tab Search", "version": "1.0.2", "description": "Press Cmd+Shift+Space (Ctrl+Shift+Space) to instantly search and jump between your open tabs, or Google anything new.", "browser_specific_settings": {"gecko": {"id": "jazice@ndinevski.com", "strict_min_version": "78.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Search tabs (Cmd+Shift+Space)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-palette": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open the tab search palette"}}, "permissions": ["activeTab", "tabs", "sessions", "history", "<all_urls>"], "web_accessible_resources": ["palette.html", "palette.css", "palette.js", "icons/*.png"]}