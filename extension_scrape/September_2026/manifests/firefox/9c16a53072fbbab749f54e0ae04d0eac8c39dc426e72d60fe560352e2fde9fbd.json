{"manifest_version": 3, "name": "Codeforces Problem Tags Hider", "version": "1.0.0", "description": "Hides the problem tags on Codeforces problem pages.", "browser_specific_settings": {"gecko": {"id": "codeforces-problem-tags-hider@example.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://codeforces.com/problemset/problem/*"], "js": ["content.js"], "run_at": "document_idle"}]}