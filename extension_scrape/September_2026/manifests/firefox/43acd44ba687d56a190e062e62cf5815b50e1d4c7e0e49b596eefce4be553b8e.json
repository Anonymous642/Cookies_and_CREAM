{"manifest_version": 3, "name": "DM Faster", "version": "0.3.369", "description": "Run Instagram, Facebook, and LinkedIn outreach from your own logged-in browser.", "permissions": ["storage", "tabs", "scripting", "alarms", "cookies", "webNavigation", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.instagram.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.linkedin.com/*", "https://app.dmfaster.com/*", "https://dmfaster.com/*"], "action": {"default_title": "DM Faster", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["worker-protocol.generated.js", "background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["facebook-listener-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["facebook-listener-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://www.instagram.com/*"], "js": ["instagram-restore-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://dmfaster.com/*", "https://app.dmfaster.com/*"], "js": ["site-bridge.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "rule", "enabled": true, "path": "facebook-header-rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "dm-faster@dmfaster.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}