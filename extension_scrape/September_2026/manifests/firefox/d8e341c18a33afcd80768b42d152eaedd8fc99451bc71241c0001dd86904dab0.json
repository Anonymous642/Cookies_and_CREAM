{"manifest_version": 3, "name": "Enhanced Bookmark Search", "version": "1.0.3", "description": "Powerful bookmark search with fuzzy matching, content indexing, and smart ranking", "icons": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "permissions": ["bookmarks", "storage", "tabs", "unlimitedStorage", "alarms"], "optional_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "action": {"default_popup": "src/ui/popup/popup.html", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png"}, "default_title": "Search Bookmarks"}, "options_ui": {"page": "src/ui/settings/settings.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Open bookmark search popup"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "enhanced-bookmark-search@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}