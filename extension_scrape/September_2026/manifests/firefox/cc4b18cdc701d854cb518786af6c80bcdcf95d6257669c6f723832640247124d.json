{"manifest_version": 3, "name": "ImgHarvest Pro", "version": "6.2.0", "description": "Download full-resolution images from any website. Supports Bing wallpapers, Google Images, Pinterest & all sites.", "browser_specific_settings": {"gecko": {"id": "imgharvest-pro@extension", "strict_min_version": "109.0"}, "gecko_android": {"strict_min_version": "120.0"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "activeTab", "scripting", "downloads", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "ImgHarvest Pro", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"scripts": ["bg.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}