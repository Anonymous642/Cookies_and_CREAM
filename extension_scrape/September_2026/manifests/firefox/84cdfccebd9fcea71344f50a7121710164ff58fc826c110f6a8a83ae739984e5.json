{"manifest_version": 3, "name": "InstaFlow \u2014 Auto Reel Scroller", "version": "1.0.0", "description": "Automatically scroll through Instagram Reels hands-free. Pause-aware, comment-aware, with speed control, sleep timer, and more.", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.instagram.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "instaflow-auto-scroll@qwertiian", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "InstaFlow \u2014 Auto Reel Scroller"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-auto-scroll": {"suggested_key": {"default": "Alt+Shift+R", "mac": "Alt+Shift+R"}, "description": "Toggle InstaFlow auto-scroll"}}}