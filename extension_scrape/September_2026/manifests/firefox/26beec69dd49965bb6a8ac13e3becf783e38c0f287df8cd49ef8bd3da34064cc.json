{"manifest_version": 3, "name": "Impulso \u2014 Nueva pesta\u00f1a con enfoque", "short_name": "Impulso", "version": "1.41.7", "description": "Dashboard de enfoque en espa\u00f1ol: reloj, enfoque del d\u00eda, tareas, clima, pomodoro, bloqueador de sitios, guardado de pesta\u00f1as y m\u00e1s. Gratis y tus datos son solo tuyos.", "background": {"scripts": ["fondo.js"]}, "action": {"default_title": "Abrir Impulso", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["geolocation", "tabs", "storage", "unlimitedStorage", "search", "notifications", "alarms", "scripting"], "host_permissions": ["<all_urls>"], "optional_permissions": ["topSites"], "commands": {"nueva-impulso": {"suggested_key": {"default": "Alt+T", "mac": "Command+E"}, "description": "Nueva pesta\u00f1a de Impulso (directa, sin destello)"}}, "browser_specific_settings": {"gecko": {"id": "impulso@urielsalcido", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}