{"manifest_version": 3, "name": "Job Tracker Extractor", "version": "1.0.0", "description": "Extract job applications from LinkedIn, Naukri, Wellfound, Internshala \u2013 unified format for MockMate", "author": "Shaik Fayaz", "browser_specific_settings": {"gecko": {"id": "fayaz03c9@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies"], "host_permissions": ["https://www.linkedin.com/jobs-tracker/*", "https://www.naukri.com/*", "https://www.wellfound.com/*", "https://wellfound.com/*", "https://internshala.com/*", "https://www.internshala.com/*", "http://localhost:5000/*", "http://localhost:5173/*"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs-tracker/*"], "js": ["content-linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.naukri.com/*"], "js": ["content-naukri.js"], "run_at": "document_start"}, {"matches": ["https://wellfound.com/*", "https://www.wellfound.com/*"], "js": ["content-wellfound.js"], "run_at": "document_start"}, {"matches": ["https://internshala.com/student/applications/*", "https://www.internshala.com/student/applications/*"], "js": ["content-internshala.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon16.png"}, "icons": {"16": "icons/icon16.png"}}