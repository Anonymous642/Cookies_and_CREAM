{"manifest_version": 3, "name": "Archive.is", "version": "1.2", "description": "Archives the current page on archive.is.", "icons": {"48": "icon.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": "icon.png", "default_title": "Archive.is"}, "permissions": ["activeTab", "storage"], "options_ui": {"page": "options.html"}, "web_accessible_resources": [{"resources": ["options.html", "options.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "archiveis@example.com", "data_collection_permissions": {"private_data": false, "personal_details": false, "content": false, "usage": false, "technical": false, "description": "This add-on does not collect any data.", "required": ["none"]}}}}