{"manifest_version": 2, "name": "Discord Themer", "version": "1.0.2", "description": "Inject CSS into Discord. Without the hassle of an entire mod!", "author": "awruff", "homepage_url": "https://codeberg.org/awruff/DiscordThemer", "permissions": ["storage", "*://discord.com/*", "*://canary.discord.com/*", "*://ptb.discord.com/*"], "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["*://discord.com/*", "*://canary.discord.com/*", "*://ptb.discord.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "@discord-themer", "data_collection_permissions": {"required": ["none"]}}}}