{"manifest_version": 3, "name": "QRCodeMaker", "version": "1.0.0", "description": "QR code generator. Create QR codes from text or URLs with customizable options.", "icons": {"48": "icon-images/icon-48.png", "96": "icon-images/icon-96.png", "128": "icon-images/icon-128.png"}, "action": {"default_icon": {"48": "icon-images/icon-48.png", "96": "icon-images/icon-96.png"}, "default_title": "QRCodeMaker", "default_popup": "ui-display/maker.html"}, "permissions": ["clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "qrcodemaker@qr.generator", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}