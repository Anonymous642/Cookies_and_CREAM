{"manifest_version": 3, "name": "Healthorbit AI", "version": "1.1.0", "description": "AI-powered healthcare assistant that records consultations, transcribes speech, generates clinical notes, and fills EHR forms.", "homepage_url": "https://www.healthorbit.ai", "author": "Healthorbit", "browser_specific_settings": {"gecko": {"id": "healthorbit-ai@healthorbit.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "healthInfo", "browsingActivity", "websiteActivity"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["index.html", "assets/*", "components/*", "icons/*", "src/services/*"], "matches": ["https://*/*", "http://*/*"]}], "icons": {"16": "assets/logo16.png", "32": "assets/logo32.png", "48": "assets/logo48.png", "128": "assets/logo128.png"}, "browser_action": {"default_icon": {"16": "assets/logo16.png", "32": "assets/logo32.png", "48": "assets/logo48.png", "128": "assets/logo128.png"}, "default_title": "Healthorbit AI - Medical Documentation Assistant"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}