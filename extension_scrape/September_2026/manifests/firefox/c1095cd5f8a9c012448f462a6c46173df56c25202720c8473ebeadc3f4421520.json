{"manifest_version": 3, "name": "Save to Kidube", "description": "Assign web videos to your kids' curated Kidube feeds.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://app.kidube.com/*"], "action": {"default_title": "Save to Kidube", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "save-to-kidube@kidube.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}