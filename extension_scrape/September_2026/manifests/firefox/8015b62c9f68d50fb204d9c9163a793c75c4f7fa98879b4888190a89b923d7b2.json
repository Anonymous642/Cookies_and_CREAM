{"manifest_version": 3, "name": "FoxyAI", "version": "1.1.0", "description": "Opens a sidebar with an iframe for local AI interface", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "icons": {"128": "foxy-ai-128.png", "256": "foxy-ai-256.png", "512": "foxy-ai.png"}, "background": {"scripts": ["foxy_ai.js"]}, "action": {"default_title": "Toggle Sidebar"}, "sidebar_action": {"default_title": "FoxyAI", "default_panel": "sidebar.html", "default_icon": "foxy-ai.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "options_ui": {"page": "options.html"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle the sidebar"}}, "browser_specific_settings": {"gecko": {"id": "alexfromapex@gmail.com"}}}