{"manifest_version": 3, "name": "Omnis", "version": "1.1.0", "description": "Capture links, text, and images to Omnis", "permissions": ["activeTab", "contextMenus", "storage", "notifications", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; img-src 'self' data: blob:;"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "omnis@omnis.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}