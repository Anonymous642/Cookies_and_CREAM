{"manifest_version": 2, "name": "Radarr Netflix Shell", "version": "1.0.0", "description": "A Netflix-style movie gallery that replaces the Radarr UI with filters, release info, and rich metadata", "browser_specific_settings": {"gecko": {"id": "radarr-netflix-shell@local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "https://api.themoviedb.org/*", "https://www.releases.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}}