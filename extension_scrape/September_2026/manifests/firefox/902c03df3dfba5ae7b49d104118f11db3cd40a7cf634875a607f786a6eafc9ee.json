{"manifest_version": 3, "name": "Pxi WebExt", "version": "0.0.2", "description": "[description]", "browser_specific_settings": {"gecko": {"id": "addon@pxi.com", "strict_min_version": "115.0"}}, "action": {"default_icon": "./assets/rocket-16.png", "default_popup": "./dist/popup/index.html"}, "options_ui": {"page": "./dist/options/index.html", "open_in_tab": true}, "background": {"scripts": ["dist/background/index.mjs"], "type": "module"}, "icons": {"16": "./assets/rocket-16.png", "48": "./assets/rocket-48.png", "128": "./assets/rocket-128.png"}, "permissions": ["tabs", "storage", "activeTab", "scripting"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*.zhoupu123.com/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["*://*.zhoupu123.com/*"]}], "content_security_policy": {"extension_pages": "default-src 'self'"}}