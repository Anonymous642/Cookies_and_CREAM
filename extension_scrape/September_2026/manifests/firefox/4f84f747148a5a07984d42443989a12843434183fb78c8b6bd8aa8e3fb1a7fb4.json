{"manifest_version": 2, "name": "PopupBlock", "version": "1.5", "description": "Bloquea popups.", "permissions": ["activeTab", "tabs", "<all_urls>", "scripting", "storage"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "index.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "popupblocker@blockpopup.pizza"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["cookie.js", "content.js"], "run_at": "document_end"}]}