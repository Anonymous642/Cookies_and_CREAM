{"manifest_version": 2, "name": "InTag - CRM for LinkedIn", "version": "2.2.2", "description": "Organize and manage your LinkedIn contacts with notes and custom tags. Your mini-CRM inside LinkedIn.", "default_locale": "it", "browser_specific_settings": {"gecko": {"id": "intag-crm@linkedin", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "https://*.linkedin.com/*", "https://*.supabase.co/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["i18n.js", "content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": ["styles.css", "InTag_Logo.png", "icon16.png", "icon48.png", "icon128.png"], "content_security_policy": "script-src 'self'; object-src 'self'"}