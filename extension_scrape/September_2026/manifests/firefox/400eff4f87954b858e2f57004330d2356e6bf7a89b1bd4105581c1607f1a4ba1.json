{"manifest_version": 3, "name": "Eclipse Foundation Community", "description": "Eclipse Foundation Community is a browser extension that enhances profile information for members of the Eclipse Foundation community on `eclipse.gitlab.org` and `github.com`.", "version": "0.0.1", "browser_specific_settings": {"gecko": {"id": "eclipse-foundation-community-browser-plugin@eclipse-foundation.org", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "js/background.js", "scripts": ["js/background.js"]}, "content_scripts": [{"world": "MAIN", "js": ["/js/main.js"], "matches": ["*://gitlab.eclipse.org/*"], "run_at": "document_start"}, {"js": ["/js/main.js"], "matches": ["*://github.com/eclipse-*"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "Eclipse Foundation Community"}, "host_permissions": ["*://gitlab.eclipse.org/*", "*://api.eclipse.org/*", "*://projects.eclipse.org/*", "*://github.com/*"], "permissions": ["contextMenus", "storage", "tabs"], "web_accessible_resources": [{"resources": ["js/main.js"], "matches": ["*://gitlab.eclipse.org/*", "*://github.com/*"]}]}