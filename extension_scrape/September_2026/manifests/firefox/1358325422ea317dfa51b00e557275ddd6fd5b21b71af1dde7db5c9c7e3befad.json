{"manifest_version": 3, "name": "Better Redmine", "description": "Browser extension that adds multiple improvements to Redmine.", "version": "1.0", "permissions": ["storage", "notifications"], "host_permissions": ["*://*.com/redmine/*", "*://*.org/redmine/*", "*://*.fr/redmine/*"], "options_ui": {"page": "settings.html", "browser_style": false, "open_in_tab": true}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"js": ["scripts/content-loader.js"], "css": ["css/common.css", "css/content.css"], "matches": ["*://*.com/redmine/*", "*://*.org/redmine/*", "*://*.fr/redmine/*"]}], "background": {"scripts": ["scripts/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "{1fd03456-9691-42f4-a504-2c1f78f5dd15}", "strict_min_version": "109.0"}}, "icons": {"128": "icon/better_redmine128.jpg"}, "web_accessible_resources": [{"resources": ["scripts/modules/*.js", "scripts/content-modular.js"], "matches": ["*://*.com/*", "*://*.org/*", "*://*.fr/*"]}]}