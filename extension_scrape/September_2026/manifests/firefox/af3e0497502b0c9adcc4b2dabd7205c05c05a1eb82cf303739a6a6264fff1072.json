{"manifest_version": 3, "name": "MaluRGB Watchtime", "version": "1.0.1", "description": "Conta seu tempo assistindo as lives da MaluRGB no Kick e envia para o site malurgb.com.br.", "permissions": ["tabs", "storage", "alarms", "scripting"], "host_permissions": ["*://*.kick.com/*", "*://malurgb.com.br/*", "*://www.malurgb.com.br/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.kick.com/*"], "js": ["content-kick.js"], "run_at": "document_idle"}, {"matches": ["*://malurgb.com.br/*", "*://www.malurgb.com.br/*"], "js": ["content-site.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "MaluRGB Watchtime", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "watchtime@malurgb.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": ["technicalAndInteraction"]}}}}