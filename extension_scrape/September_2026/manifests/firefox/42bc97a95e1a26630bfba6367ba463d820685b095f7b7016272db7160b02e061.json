{"manifest_version": 3, "name": "ContactLog", "version": "1.0.0", "description": "Add rich text notes to your LinkedIn\u2122 connections with cross-device sync", "browser_specific_settings": {"gecko": {"id": "contactlog@morrison.sg", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "clipboardWrite"], "host_permissions": ["*://*.linkedin.com/*", "*://*.supabase.co/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "setup/setup.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content/extract-profile.js"], "run_at": "document_idle"}]}