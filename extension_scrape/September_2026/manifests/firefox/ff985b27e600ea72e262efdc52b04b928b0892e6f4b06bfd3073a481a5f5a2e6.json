{"manifest_version": 3, "name": "Cognitive Automation Layer", "version": "1.3", "description": "Analyzes cognitive load and workflow interruptions to recommend automation opportunities locally.", "permissions": ["tabs", "storage", "notifications", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["cognitiveEngine.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Cognitive Automation Layer"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Cognitive-Automation-Layer", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}