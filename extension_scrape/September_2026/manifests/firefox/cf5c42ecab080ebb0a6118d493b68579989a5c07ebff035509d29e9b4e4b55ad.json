{"manifest_version": 3, "name": "SecureNotes Vault Web Clipper", "version": "1.1.0", "description": "Clip web pages securely to your end-to-end encrypted SecureNotes Vault. Zero-knowledge \u2014 your data never leaves unencrypted.", "browser_specific_settings": {"gecko": {"id": "clipper@securenotesvault.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["https://securenotesvault.com/*", "<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "SecureNotes Clipper"}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open SecureNotes Clipper"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}