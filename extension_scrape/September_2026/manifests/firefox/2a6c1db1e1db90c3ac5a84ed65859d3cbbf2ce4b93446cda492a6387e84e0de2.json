{"manifest_version": 3, "name": "ClipScout \u2014 Find, Watch & Save Videos", "version": "1.0.2", "description": "Scans the current page for playable video sources \u2014 including lazy-loaded and stream-based players \u2014 and lists them so you can watch, copy, or download, without interacting with the page itself.", "permissions": ["activeTab", "scripting", "downloads", "webRequest", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "action": {"default_popup": "popup.html", "default_title": "ClipScout", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "clipscout@clipscout.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}