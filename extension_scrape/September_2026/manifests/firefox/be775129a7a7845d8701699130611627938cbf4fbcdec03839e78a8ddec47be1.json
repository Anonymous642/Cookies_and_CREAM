{"manifest_version": 2, "name": "LifeBrowser Guard", "version": "0.4.0", "author": "Antonio", "description": "Blocco siti per adulti/azzardo, Focus Mode e strumenti di accountability (streak, journal, check-in) per Zen e Firefox.", "browser_specific_settings": {"gecko": {"id": "guard@lifebrowser.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/logo_48.png", "96": "icons/logo_96.png"}, "permissions": ["webRequest", "webRequestBlocking", "storage", "unlimitedStorage", "tabs", "theme", "<all_urls>"], "background": {"scripts": ["blocklist-data.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "LifeBrowser Guard", "default_icon": "icons/logo_48.png", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["blocklist-data.js", "content-filter.js"], "run_at": "document_idle"}], "web_accessible_resources": ["blocked.html", "blocked.css", "blocked.js", "icons/logo_48.png", "icons/logo_96.png", "icons/leaf.svg"]}