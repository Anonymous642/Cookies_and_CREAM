{"manifest_version": 3, "name": "Notelox: Password Manager, 2FA & Autofill", "short_name": "Notelox", "version": "2.0.6", "description": "Securely autofill passwords, 2FA codes, credit cards & identities. Syncs perfectly with your Notelox app for a complete secure vault.", "homepage_url": "https://app.notelox.com", "permissions": ["storage", "activeTab", "tabs", "privacy", "notifications", "alarms", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Notelox"}, "autofill": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Auto-fill login"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "extension@notelox.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "*.js", "*.css"], "matches": ["<all_urls>"]}]}