{"manifest_version": 3, "name": "CV Form Assistant", "version": "1.0.0", "description": "Select any question on a job application form and get an answer generated from your CV.", "browser_specific_settings": {"gecko": {"id": "cv-form-assistant@local.dev", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"]}}}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.moonshot.ai/*", "https://api.deepseek.com/*", "https://generativelanguage.googleapis.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "CV Form Assistant", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["pdf.worker.mjs"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}