{"manifest_version": 3, "name": "AutoAli by Coupanda", "version": "1.1", "description": "Automatically find and apply all possible Aliexpress coupons at checkout.", "icons": {"16": "logo16.png", "32": "logo32.png", "48": "logo48.png", "128": "logo128.png"}, "permissions": ["scripting", "tabs", "storage", "webNavigation"], "action": {"default_popup": "popup.html", "default_title": "AutoAli Coupon Helper"}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*.aliexpress.com/*", "https://coupanda.co/link/*"], "web_accessible_resources": [{"resources": ["modal.html", "modal.css"], "matches": ["https://*.aliexpress.com/*"]}], "browser_specific_settings": {"gecko": {"id": "autoali@coupanda.co", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}