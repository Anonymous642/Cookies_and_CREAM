{"manifest_version": 2, "name": "Czech Diacritics Helper", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "czech-diacritics@local.dev", "data_collection_permissions": {"required": ["none"]}}, "permissions": ["storage", "activeTab", "tabs", "contextMenus", "https://generativelanguage.googleapis.com/*"], "background": {"scripts": ["background.js"]}, "commands": {"convert-text": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Convert selected text to Czech with diacritics"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "options_ui": {"page": "options.html", "open_in_tab": true}}}