{"manifest_version": 2, "name": "NEXUS \u2014 Browser Suite Pro", "version": "2.0.0", "description": "Privacy shield, tab manager, reader mode, screenshot, notes, focus timer, vault, speed dial & dev tools.", "author": "NEXUS Suite", "icons": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.svg"}, "default_title": "NEXUS Suite"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "activeTab", "webRequest", "webRequestBlocking", "cookies", "downloads", "notifications", "alarms", "clipboardWrite", "clipboardRead", "browsingData", "history", "bookmarks", "sessions", "topSites", "<all_urls>"], "content_security_policy": "script-src 'self'; object-src 'self';", "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Open NEXUS"}, "capture-screenshot": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Take Screenshot"}, "toggle-reader": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle Reader Mode"}, "new-note": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Quick New Note"}, "toggle-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Toggle Focus Timer"}}, "browser_specific_settings": {"gecko": {"id": "nexus-suite@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}