{"manifest_version": 2, "name": "Tab Symphony", "version": "1.0", "description": "Plays different chords when switching tabs based on site theme (simple domain-based mapping).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Tab Symphony", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "tabsymphony@example.com"}}}