{"manifest_version": 2, "name": "Bookmarks New Tab Page", "description": "Replace your new tab with a dark bookmark dashboard. Navigate folders, open links, and customize your start page.", "version": "14.4.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/dracon-dev/nexus-new-tab", "permissions": ["storage", "tabs", "bookmarks"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "bookmarks-newtab@dracon.uk", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Bookmarks New Tab Page", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}}