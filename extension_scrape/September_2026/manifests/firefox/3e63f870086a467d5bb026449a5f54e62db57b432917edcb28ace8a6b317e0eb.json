{"manifest_version": 3, "name": "FZTab", "version": "1.0.3", "description": "A beautiful, minimalist new tab page replacement", "chrome_settings_overrides": {"homepage": "https://example.com"}, "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["activeTab", "storage", "unlimitedStorage", "http://*/*", "https://*/*", "tabs", "geolocation", "webRequest", "webRequestBlocking"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "FZTab@example.com", "strict_min_version": "58.0"}}}