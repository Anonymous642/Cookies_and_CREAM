{"manifest_version": 2, "name": "Tabari", "description": "Better Tabs management, search and utilities", "version": "0.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "34": "icon/34.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabs", "activeTab", "scripting", "storage", "alarms", "sessions"], "web_accessible_resources": ["content-scripts/content.css", "fonts/GeistPixel-Circle.woff2", "fonts/GeistPixel-Grid.woff2", "fonts/GeistPixel-Line.woff2", "fonts/GeistPixel-Square.woff2", "fonts/GeistPixel-Triangle.woff2"], "commands": {"toggle-spotlight": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle Tabari modal"}}, "browser_specific_settings": {"gecko": {"id": "tabari@jquub.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Tabari", "default_popup": "popup.html"}, "content_scripts": []}