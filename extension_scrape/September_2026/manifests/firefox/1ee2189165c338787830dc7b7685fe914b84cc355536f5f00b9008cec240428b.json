{"manifest_version": 2, "name": "Sound Collector", "version": "1.0.0", "description": "Thu th\u1eadp th\u00f4ng tin b\u00e0i h\u00e1t t\u1eeb trang c\u00f3 nh\u1ea1c v\u00e0 x\u00e2y th\u01b0 vi\u1ec7n c\u00e1 nh\u00e2n.", "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Sound Collector", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "sound-collector@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}