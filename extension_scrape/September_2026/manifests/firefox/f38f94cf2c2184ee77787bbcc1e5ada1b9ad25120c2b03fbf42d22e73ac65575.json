{"manifest_version": 3, "name": "Meric's FocusVault", "version": "1.0.1", "description": "Connects to the Meric's FocusVault native messaging host to block websites.", "permissions": ["nativeMessaging", "declarativeNetRequest", "alarms", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service_worker.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["redirect.html"], "matches": ["<all_urls>"]}], "action": {"default_icon": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "focusvault@meric", "strict_min_version": "109.0"}}}