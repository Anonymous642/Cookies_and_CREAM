{"manifest_version": 3, "name": "Tabby", "version": "1.0.0", "description": "A cat who lives in your toolbar and gets buried when you open too many tabs. Gentle nudges, one-tap tidying, and confetti when you dig her out.", "browser_specific_settings": {"gecko": {"id": "tabby@moecui22.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage"], "background": {"scripts": ["src/lib/api.js", "src/lib/mood.js", "src/lib/store.js", "src/background/tabby.js"]}, "action": {"default_title": "Tabby", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}