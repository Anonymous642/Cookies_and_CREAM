{"manifest_version": 3, "name": "Tik.Ninja for TikTok", "version": "1.1.0", "description": "View TikTok profiles, stories and videos anonymously via Tik.Ninja, plus one-click download buttons across TikTok.", "homepage_url": "https://tik.ninja", "browser_specific_settings": {"gecko": {"id": "extension@tik.ninja", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "storage", "contextMenus"], "host_permissions": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Tik.Ninja for TikTok", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}