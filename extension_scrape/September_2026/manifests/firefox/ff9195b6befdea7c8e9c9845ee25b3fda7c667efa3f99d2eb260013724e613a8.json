{"manifest_version": 3, "name": "ClipToAnki", "version": "0.1.2", "description": "Analyze English text, extract advanced vocabulary, and send selected notes to Anki via AnkiConnect.", "action": {"default_title": "ClipToAnki"}, "commands": {"open-cliptoanki": {"suggested_key": {"mac": "Alt+G", "windows": "Alt+G", "linux": "Alt+G", "default": "Alt+G"}, "description": "Open ClipToAnki and analyze clipboard text"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://api.openai.com/*", "http://localhost:8765/*", "http://127.0.0.1:8765/*"], "background": {"scripts": ["shared/builtInPresetPrompts.js", "shared/common.js", "background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "cliptoanki@aki.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}