{"manifest_version": 2, "name": "Tab Switcher", "version": "1.0", "description": "Navegue rapidamente entre abas com atalhos e busca.", "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "tab-switcher@rodrigo", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Tab Switcher"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"open-tab-search": {"suggested_key": {"default": "Alt+S"}, "description": "Abre a busca de abas"}, "go-to-tab-1": {"suggested_key": {"default": "Alt+1"}, "description": "Ir para aba favorita 1"}, "go-to-tab-2": {"suggested_key": {"default": "Alt+2"}, "description": "Ir para aba favorita 2"}, "go-to-tab-3": {"suggested_key": {"default": "Alt+3"}, "description": "Ir para aba favorita 3"}, "go-to-tab-4": {"suggested_key": {"default": "Alt+4"}, "description": "Ir para aba favorita 4"}, "go-to-tab-5": {"suggested_key": {"default": "Alt+5"}, "description": "Ir para aba favorita 5"}}}