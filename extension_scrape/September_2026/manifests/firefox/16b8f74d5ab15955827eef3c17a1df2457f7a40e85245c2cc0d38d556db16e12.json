{"manifest_version": 3, "name": "Zora on Twitter", "version": "0.4.0", "description": "Shows Zora creator coin info next to Twitter usernames in your feed.", "permissions": [], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://creatorsea.com/*", "https://www.creatorsea.com/*", "https://api-sdk.zora.engineering/*", "https://api.o1.exchange/*"], "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["zora-logo.svg", "wallet-bridge.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "twitter-zora-overlay@zora.co", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}