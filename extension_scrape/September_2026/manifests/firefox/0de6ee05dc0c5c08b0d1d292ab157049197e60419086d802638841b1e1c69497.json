{"manifest_version": 3, "name": "OpenThat.Link", "description": "Open links in your browser from Zapier, n8n, Make, or any webhook-capable tool.", "version": "1.0.1", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://openthat.link/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_icon": {"16": "/icon-toolbar/16.png", "32": "/icon-toolbar/32.png", "48": "/icon-toolbar/48.png", "128": "/icon-toolbar/128.png"}, "default_title": "OpenThat.Link", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "extension@openthat.link", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}