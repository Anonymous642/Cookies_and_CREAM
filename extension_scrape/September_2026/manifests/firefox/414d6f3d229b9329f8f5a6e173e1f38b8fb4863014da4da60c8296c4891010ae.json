{"manifest_version": 3, "name": "Uni Mannheim CAS Auto-Login", "version": "1.0.0", "description": "Automatically log into University of Mannheim CAS authentication system", "browser_specific_settings": {"gecko": {"id": "unima-cas-autologin@relay.datti.to", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://cas.uni-mannheim.de/*", "https://portal2.uni-mannheim.de/*"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://cas.uni-mannheim.de/cas/login*", "https://portal2.uni-mannheim.de/*"], "js": ["content-scripts/content-script.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}