{"manifest_version": 2, "name": "YouTube Screenshot Tool", "version": "1.2.9", "description": "Extract high-quality frames from YouTube videos without UI elements", "default_locale": "en", "permissions": ["activeTab", "storage", "clipboardWrite", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-frame-extractor@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["lib/browser-polyfill.js", "scripts/content.js"]}], "web_accessible_resources": ["assets/*", "lib/*", "scripts/*"], "background": {"scripts": ["scripts/background.js"]}, "commands": {"capture_frame": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Capture Video Frame"}}}