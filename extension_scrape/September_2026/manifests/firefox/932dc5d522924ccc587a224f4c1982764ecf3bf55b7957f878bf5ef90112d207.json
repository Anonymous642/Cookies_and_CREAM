{"manifest_version": 2, "name": "EPUB Collector", "version": "1.2", "description": "Saves the current page into a growing EPUB. Newest page first. Right-click the toolbar button to clear or re-download.", "permissions": ["activeTab", "downloads", "storage", "unlimitedStorage", "menus"], "browser_action": {"default_title": "Save page to EPUB"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "epub-collector@local", "data_collection_permissions": {"required": ["none"]}}}}