{"manifest_version": 3, "name": "AIDubber \u2014 Real-Time Video Dubbing", "version": "1.2", "description": "Doublez en direct vos cours Coursera, YouTube et DeepLearning.AI avec GPT-4o & Azure Neural TTS", "permissions": ["storage"], "host_permissions": ["https://aidubber.org/*", "https://*.aidubber.org/*", "https://*.coursera.org/*", "https://*.youtube.com/*", "https://*.deeplearning.ai/*"], "optional_host_permissions": ["http://127.0.0.1:8080/*", "http://localhost:8080/*", "https://*.openai.azure.com/*", "https://*.api.cognitive.microsoft.com/*", "https://*.tts.speech.microsoft.com/*", "https://api.cognitive.microsofttranslator.com/*"], "externally_connectable": {"matches": ["https://aidubber.org/*", "https://*.aidubber.org/*"]}, "content_scripts": [{"matches": ["https://*.coursera.org/*", "https://*.youtube.com/*", "https://*.deeplearning.ai/*"], "js": ["nonspeech.js", "speakers.js", "content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "AIDubber AI", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "aidubber-extension@aidubber.org", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["nonspeech.js", "cache.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": []}