{"manifest_version": 2, "name": "Tracker Scan", "version": "1.7", "description": "Reveal a website's hidden third parties. It inspects every resource a page loads, separates first-party from third-party domains, highlights known trackers, and rates the page's privacy from A to F.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{4a707aa0-bda7-4506-bd14-07aa91939c8a}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Tracker Scan", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}