{"manifest_version": 3, "name": "High Contrast - Eye Protection", "version": "1.0.2", "description": "A browser extension to enhance contrast and readability of web pages", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/highcontrast-16.png", "48": "icons/highcontrast-48.png", "128": "icons/highcontrast-128.png"}}, "icons": {"16": "icons/highcontrast-16.png", "48": "icons/highcontrast-48.png", "128": "icons/highcontrast-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "highcontrast.js"], "css": ["styles.css"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extensions-hcep@adolix.com", "strict_min_version": "58.0"}}}