{"manifest_version": 3, "name": "OpenGraph Sniffer MHL", "version": "1.0.0", "description": "Exposes page OpenGraph or Twitter Card tags, and lets you easily copy any of the metadata or thumbnails.", "author": "Marcin Orlowski", "homepage_url": "https://github.com/MarcinOrlowski/opengraph-sniffer-mhl", "browser_specific_settings": {"gecko": {"id": "opengraph-sniffer-mhl@marcinorlowski.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "img/icon.svg", "96": "img/icon.svg"}, "permissions": ["clipboardWrite", "downloads"], "host_permissions": ["*://*/*"], "background": {"scripts": ["lib/scan.js", "background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["lib/scan.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "page_action": {"default_icon": {"19": "img/icon.svg", "38": "img/icon.svg"}, "default_title": "OpenGraph Sniffer MHL", "default_popup": "popup/popup.html"}}