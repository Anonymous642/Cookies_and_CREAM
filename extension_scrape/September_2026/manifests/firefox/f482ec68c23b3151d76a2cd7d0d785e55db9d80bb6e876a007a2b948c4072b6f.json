{"manifest_version": 2, "name": "RemindMe", "version": "2.0.0", "description": "One-time reminders at exact date/time, or recurring interval reminders like drink water every 60 mins.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png"}, "default_title": "RemindMe"}, "background": {"scripts": ["background.js"], "persistent": true}, "permissions": ["alarms", "notifications", "storage"], "browser_specific_settings": {"gecko": {"id": "remindme2@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}