{"manifest_version": 3, "name": "Easy Redirector", "description": "Redirect yourself away from time-wasting websites", "version": "1.0.2", "browser_specific_settings": {"gecko": {"id": "easy-redirector@hugobarroca.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "alarms", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "options/options.html", "open_in_tab": true}}