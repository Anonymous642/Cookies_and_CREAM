{"manifest_version": 3, "name": "SkippyNet", "version": "1.0.0", "description": "Auto-skip intros, recaps & credits. Jump to the next episode instantly \u2014 no countdowns.", "homepage_url": "https://sohamverma.com/skippynet", "developer": {"name": "SkippyNet", "url": "https://sohamverma.com/skippynet"}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.netflix.com/*"], "content_scripts": [{"matches": ["*://*.netflix.com/watch/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "SkippyNet", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "skippynet@sohamverma.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}