{"manifest_version": 3, "name": "Evergreen", "description": "Sync bookmarks across browser profiles using a GitHub repo you own \u2014 Firefox, Chrome, and other Gecko or Chromium browsers.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "Evergreen", "default_popup": "popup.html"}, "permissions": ["bookmarks", "storage", "alarms"], "host_permissions": ["https://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "evergreen@coalescelabs.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["bookmarksInfo"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}