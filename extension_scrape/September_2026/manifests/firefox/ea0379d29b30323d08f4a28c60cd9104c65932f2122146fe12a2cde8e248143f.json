{"manifest_version": 3, "name": "MetaPrism Capture", "version": "1.0.0", "description": "Capture literature search results from Embase, Cochrane, Google Scholar, Ovid, and citation export files into MetaPrism.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "capture@metaprism.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "searchTerms", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup/popup.html", "default_title": "MetaPrism Capture", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "scripting"], "externally_connectable": {"matches": ["https://metaprism.io/*", "http://localhost:3737/*", "http://127.0.0.1:3737/*"]}, "host_permissions": ["https://metaprism.io/*", "https://metaprism.sourcectl.com/*", "http://localhost:3737/*", "http://127.0.0.1:3737/*", "https://*.embase.com/*", "https://*.elsevier.com/*", "https://*.cochranelibrary.com/*", "https://*.cochrane.org/*", "https://scholar.google.com/*", "https://*.ovid.com/*", "https://*.webofscience.com/*", "https://*.clarivate.com/*", "https://*.webofknowledge.com/*"], "content_scripts": [{"matches": ["https://*.embase.com/*", "https://*.elsevier.com/*", "https://*.cochranelibrary.com/*", "https://*.cochrane.org/*", "https://scholar.google.com/*", "https://*.ovid.com/*", "https://*.webofscience.com/*", "https://*.clarivate.com/*", "https://*.webofknowledge.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}