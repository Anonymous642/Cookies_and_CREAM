{"manifest_version": 2, "name": "Short-link direct navigation", "version": "1.0.0", "description": "Resolve known short links before Firefox navigates, preserving Android App Links.", "permissions": ["webRequest", "webRequestBlocking", "http://t.co/*", "https://t.co/*", "http://bit.ly/*", "https://bit.ly/*", "http://tinyurl.com/*", "https://tinyurl.com/*", "http://is.gd/*", "https://is.gd/*", "http://buff.ly/*", "https://buff.ly/*", "http://lnkd.in/*", "https://lnkd.in/*"], "background": {"scripts": ["shortlink.js", "background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "shortlink-direct-navigation@example.invalid", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}