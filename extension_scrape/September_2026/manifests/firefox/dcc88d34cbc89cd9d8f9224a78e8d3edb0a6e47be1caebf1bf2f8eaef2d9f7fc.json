{"manifest_version": 3, "name": "Tailchrome", "description": "Access your tailnet from your browser. Run a full Tailscale node per browser profile without affecting system networking.", "version": "0.1.14", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["<all_urls>"], "permissions": ["proxy", "storage", "nativeMessaging", "contextMenus", "alarms"], "action": {"default_icon": {"16": "icons/icon-16-offline.png", "32": "icons/icon-32-offline.png", "48": "icons/icon-48-offline.png", "128": "icons/icon-128-offline.png"}, "default_popup": "popup.html"}, "sidebar_action": {"default_panel": "popup.html", "default_title": "Tailchrome", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "tailchrome@tesseras.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": []}}}, "background": {"type": "module", "scripts": ["background.js"]}}