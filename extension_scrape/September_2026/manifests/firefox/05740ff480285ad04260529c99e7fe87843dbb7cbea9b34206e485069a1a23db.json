{"manifest_version": 3, "name": "Anti Bullying Filter", "version": "1.0", "description": "Blocks or warns about abusive words on social media sites.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.snapchat.com/*", "*://web.whatsapp.com/*", "*://*.telegram.org/*", "*://*.reddit.com/*"], "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.tiktok.com/*", "*://*.youtube.com/*", "*://*.snapchat.com/*", "*://web.whatsapp.com/*", "*://*.telegram.org/*", "*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Anti Bullying", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "anti-bullying-filter@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}