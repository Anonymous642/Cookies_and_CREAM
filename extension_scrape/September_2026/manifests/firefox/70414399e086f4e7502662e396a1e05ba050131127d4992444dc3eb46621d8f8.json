{"manifest_version": 3, "name": "Karmageddon for FACEIT", "version": "2.0.0", "description": "After each CS2 match, mark who's toxic and who's chill \u2014 because Karma never forgets", "homepage_url": "https://karmageddon.app", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "identity", "tabs"], "host_permissions": ["https://www.faceit.com/*", "https://open.faceit.com/*", "https://*.cloudfunctions.net/*", "https://*.googleapis.com/*", "https://*.firebaseio.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://open.faceit.com https://www.faceit.com https://*.cloudfunctions.net https://*.googleapis.com https://*.firebaseio.com;"}, "content_scripts": [{"matches": ["https://www.faceit.com/*"], "js": ["content.js"], "css": ["styles/rating.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Karmageddon", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["assets/icons/*.svg", "assets/unknown.svg"], "matches": ["https://www.faceit.com/*"]}], "browser_specific_settings": {"gecko": {"id": "karmageddon@faceit.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}