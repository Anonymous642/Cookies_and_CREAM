{"manifest_version": 2, "name": "FavTool", "version": "2.0.1", "description": "Add webpages to your favorites on FavTool.com. Subscribe and read RSS news feeds.", "permissions": ["activeTab", "tabs", "https://favtool.com/*", "http://favtool.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "FavTool"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "favtool@favtool.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}