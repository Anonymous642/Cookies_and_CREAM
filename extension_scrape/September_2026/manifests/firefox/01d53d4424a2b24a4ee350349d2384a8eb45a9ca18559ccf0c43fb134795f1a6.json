{"manifest_version": 3, "name": "Savetowatch", "version": "1.0", "description": "Save to watch YouTube where you left off. Free up browser memory and organize your video tabs in a beautiful dashboard.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Send YouTube tabs to Savetowatch", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["storage", "alarms", "notifications", "tabs", "scripting", "history", "contextMenus"], "host_permissions": ["*://*.youtube.com/*", "*://notebooklm.google.com/*", "*://*.dodopayments.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["youtube-injector.js"], "run_at": "document_end"}, {"matches": ["*://notebooklm.google.com/*"], "js": ["notebooklm-injector.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Savetowatch History", "default_icon": "icon16.png"}, "browser_specific_settings": {"gecko": {"id": "trysavetowatch@savetowatch.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}