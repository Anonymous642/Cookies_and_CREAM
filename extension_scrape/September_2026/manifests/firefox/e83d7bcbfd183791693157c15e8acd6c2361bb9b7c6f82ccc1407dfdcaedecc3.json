{"name": "MDRoblox", "description": "A cleaner and better Roblox UI.", "version": "1.0.7", "manifest_version": 3, "host_permissions": ["https://www.roblox.com/*", "https://users.roblox.com/*", "https://inventory.roblox.com/*", "https://games.roblox.com/v1/*"], "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["script/content.js"], "run_at": "document_start"}], "background": {"scripts": ["script/background.js"]}, "permissions": ["storage", "alarms"], "action": {"default_title": "Modern UI", "default_icon": {"16": "Icons/logo.png", "32": "Icons/logo.png"}}, "icons": {"16": "Icons/logo.png", "48": "Icons/logo.png", "128": "Icons/logo.png"}, "web_accessible_resources": [{"resources": ["Setting/index.html", "Icons/logo.png"], "matches": ["*://*.roblox.com/*"]}], "browser_specific_settings": {"gecko": {"id": "MDRoblox@gmail.com", "strict_min_version": "78.0"}}}