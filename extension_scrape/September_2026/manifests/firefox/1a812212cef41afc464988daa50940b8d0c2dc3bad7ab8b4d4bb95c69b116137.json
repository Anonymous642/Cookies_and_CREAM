{"manifest_version": 2, "name": "YouTube Player Pinner", "version": "1.1", "description": "YouTube\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u753b\u9762\u4e0a\u90e8\u306b\u30d4\u30f3\u7559\u3081\u3057\u3066\u3001\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u3066\u3082\u8ffd\u5f93\u3055\u305b\u308b\u30a2\u30c9\u30aa\u30f3\u3067\u3059\u3002", "browser_specific_settings": {"gecko": {"id": "youtube-player-pinner@addon.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["*://*.youtube.com/*", "storage"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "512": "icon512.png"}, "web_accessible_resources": ["icon48.png", "pin-icon.png"], "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}]}