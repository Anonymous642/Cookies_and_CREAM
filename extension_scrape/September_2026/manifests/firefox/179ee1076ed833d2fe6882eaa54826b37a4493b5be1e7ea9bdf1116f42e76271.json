{"manifest_version": 2, "name": "Bandcamp to Spotify, Apple Music & More", "description": "Find Bandcamp albums and tracks on Spotify, Apple Music, YouTube Music, Deezer and other streaming services in one click.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "version": "3.7", "permissions": ["storage", "tabs", "*://*.bandcamp.com/*", "*://*.vercel.app/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "Bandcamp to Spotify, Apple Music & More", "default_popup": "options.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.bandcamp.com/album/*"], "js": ["bc_inject_album.js"], "css": ["bc_styles.css"]}, {"matches": ["*://bandcamp.com/discover", "*://bandcamp.com/discover/*", "*://bandcamp.com/discover?*", "*://bandcamp.com/?g*"], "js": ["bc_inject_discover.js"], "css": ["bc_styles.css"]}, {"matches": ["*://*.bandcamp.com/track/*"], "js": ["bc_inject_track.js"], "css": ["bc_styles.css"]}], "web_accessible_resources": ["icons/*.svg", "*.png"], "browser_specific_settings": {"gecko": {"id": "hello.bbureau.bandcamp@gmail.com", "strict_min_version": "106.0"}}}