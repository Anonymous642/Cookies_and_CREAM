{"manifest_version": 3, "name": "QuickSub Switch", "description": "Instantly toggle subtitles on major streaming platforms with a single click or hotkey for an immersive viewing experience.", "version": "1.0.0", "author": "StreamEnhance Labs", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.hulu.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quicksubswitch@streamenhancelabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}