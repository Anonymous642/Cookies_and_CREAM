{"manifest_version": 2, "name": "RNLA - Read Now, Later, Always", "version": "1.0.5", "description": "Bookmarks that make sense. Save an article, video, website, or anything else and read it now, later, and always.", "browser_action": {"default_title": "Open RNLA", "default_popup": "popup.html", "default_icon": {"16": "icons/rnla-16.png", "32": "icons/rnla-32.png", "48": "icons/rnla-48.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["tabs", "contextMenus"], "web_accessible_resources": ["thumbs/*", "extra/*"], "icons": {"16": "icons/rnla-16.png", "32": "icons/rnla-32.png", "48": "icons/rnla-48.png", "96": "icons/rnla-96.png"}, "browser_specific_settings": {"gecko": {"id": "rnla@jeffjones", "data_collection_permissions": {"required": ["none"]}}}}