{"manifest_version": 3, "name": "Control Bar Styler", "version": "0.1.0", "description": "Replaces the native browser media player with custom design(overlay).", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "controlbarstyler@neocities.org", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": "assets/logo.png"}, "content_scripts": [{"matches": ["*://*/*.mp3", "*://*/*.wav", "*://*/*.ogg", "*://*/*.mp4", "*://*/*.webm", "*://*/*.mkv"], "js": ["patch.js"], "css": ["style.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["assets/**/*", "assets/assets.json"], "matches": ["<all_urls>"]}]}