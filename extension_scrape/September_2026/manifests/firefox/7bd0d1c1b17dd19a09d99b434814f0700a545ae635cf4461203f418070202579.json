{"manifest_version": 3, "name": "Reddit Finite Scroll", "version": "1.0.2", "description": "Limits reddit to a finite scroll - load posts in batches with a button", "permissions": ["scripting", "storage"], "host_permissions": ["*://www.reddit.com/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["*://www.reddit.com/*"], "js": ["content.js"], "css": ["styles/content.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "reddit-finite-scroll@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}