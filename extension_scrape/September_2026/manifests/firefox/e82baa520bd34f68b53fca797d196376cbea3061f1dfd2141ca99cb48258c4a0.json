{"manifest_version": 3, "name": "OctaEdge", "version": "1.2.7", "description": "OctaEdge", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "OctaEdge", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "cookies", "tabs", "notifications", "alarms", "scripting"], "host_permissions": ["https://*.linkedin.com/*", "http://localhost/*", "https://localhost/*", "https://*.octa-edge.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"], "js": ["linkedin-outreach-content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "octaedge-linkedin@octa-edge.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}