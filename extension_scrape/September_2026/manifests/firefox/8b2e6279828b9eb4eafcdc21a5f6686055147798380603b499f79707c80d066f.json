{"manifest_version": 2, "name": "Websperre", "version": "0.2.1", "description": "A website blocker to manage temptations.", "homepage_url": "https://github.com/websperre/websperre", "permissions": ["<all_urls>", "tabs", "storage", "webRequest", "webRequestBlocking"], "browser_action": {"default_title": "Websperre", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["blocked-request.js", "popup.js"]}], "web_accessible_resources": ["blocked-request.html"], "icons": {"48": "icons/websperre-48.png", "96": "icons/websperre-96.png"}, "browser_specific_settings": {"gecko": {"id": "{61f2a877-ef27-48e4-894f-db52e370a508}"}}}