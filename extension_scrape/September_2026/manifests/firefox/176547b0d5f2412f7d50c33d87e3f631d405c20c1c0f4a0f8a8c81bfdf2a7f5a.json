{"manifest_version": 3, "name": "Add to KickTheater", "version": "2.0", "description": "When on a Kick.com stream, click to add it to your KickTheater.", "homepage_url": "https://kicktheater.com", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs"], "host_permissions": ["*://kick.com/*", "*://kicktheater.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Add to KickTheater", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "add-to-kicktheater@kicktheater.com"}}}