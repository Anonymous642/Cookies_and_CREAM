{"manifest_version": 3, "name": "Cymbra Lingua", "description": "Lisez l'anglais sur le web : les mots inconnus surlign\u00e9s, et un pourcentage honn\u00eate. Hors ligne et priv\u00e9.", "permissions": ["activeTab", "storage", "scripting", "identity"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "action": {"default_popup": "popup.html", "default_title": "Cymbra Lingua", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"lingua-capture-selection": {"suggested_key": {"default": "Alt+L"}, "description": "Capturer la s\u00e9lection (mot ou expression) avec sa phrase"}, "lingua-toggle-drawer": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Ouvrir/fermer le panneau de r\u00e9vision sur la page"}, "lingua-side-panel": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Ouvrir le panneau lat\u00e9ral de r\u00e9vision"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["wasm/lingua_wasm.js", "wasm/lingua_wasm_bg.wasm", "assets/pack.lingua"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "lingua@cymbra.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent", "technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "version": "1.4.0", "host_permissions": ["https://api.cymbra.app/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}