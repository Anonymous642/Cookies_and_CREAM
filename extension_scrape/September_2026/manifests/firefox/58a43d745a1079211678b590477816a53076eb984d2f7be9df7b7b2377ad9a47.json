{"manifest_version": 3, "name": "BrainToll for YouTube", "version": "1.0.1", "description": "Focus blocker that makes you solve mental math exercises before (and periodically during) watching YouTube videos.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "braintoll-youtube@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "BrainToll for YouTube", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "exclude_matches": ["*://music.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}]}