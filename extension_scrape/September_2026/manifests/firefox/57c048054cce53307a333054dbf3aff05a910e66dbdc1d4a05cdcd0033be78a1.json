{"manifest_version": 3, "name": "Headless Fly - Reddit Scheduler", "version": "1.0.0", "description": "Schedule Reddit posts from your browser. Pre-fills forms at the perfect time. Free standalone or connect for more.", "permissions": ["storage", "alarms", "tabs", "activeTab", "notifications"], "host_permissions": ["https://old.reddit.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://*.headlessfly.com/*", "https://*.headlessfly.red/*"], "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["https://old.reddit.com/r/*/submit*", "https://old.reddit.com/submit*"], "js": ["content/reddit-old.js"], "run_at": "document_idle"}, {"matches": ["https://www.reddit.com/r/*/submit*", "https://www.reddit.com/submit*", "https://reddit.com/r/*/submit*", "https://reddit.com/submit*"], "js": ["content/reddit-new.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@headlessfly.red", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo"], "optional": []}}}}