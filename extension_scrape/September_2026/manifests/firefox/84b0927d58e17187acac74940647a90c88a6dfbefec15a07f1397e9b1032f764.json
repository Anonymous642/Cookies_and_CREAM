{"manifest_version": 3, "name": "Filters for GudFood", "version": "1.0.2", "description": "Adds price, nutrition and ingredient filters to the GudFood ordering page (orders.gudfood.com.ua). Also, adds a button to reorder a previous order.", "homepage_url": "https://github.com/JackRainy/GudFood-Filters", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://orders.gudfood.com.ua/*"], "content_scripts": [{"matches": ["https://orders.gudfood.com.ua/order*"], "js": ["src/content/filters.js", "src/content/reorder.js"], "css": ["src/content/filters.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "gudfood-filters@obysks", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}