{"manifest_version": 2, "name": "ts2kodi", "version": "2.0.1a", "description": "Scannt Webseiten nach Video-Quellen, inklusive HLS/m3u8-Streams, und sendet diese per JSON-RPC an eine konfigurierte Kodi-Instanz.", "homepage_url": "https://github.com/mclenburg/ts2kodi", "icons": {"48": "icons/ts2kodi48.png"}, "background": {"scripts": ["ts2kodi_bg.js"], "persistent": true}, "content_security_policy": "script-src 'self'; object-src 'self';", "permissions": ["storage", "activeTab", "notifications", "webRequest", "webNavigation", "<all_urls>"], "options_ui": {"page": "data/preferences.html", "open_in_tab": true, "browser_style": false}, "page_action": {"show_matches": ["<all_urls>"], "default_icon": "icons/ts2kodi48.png", "default_title": "ts2kodi \u2013 Video an Kodi senden"}, "browser_specific_settings": {"gecko": {"id": "ts2kodi-mclenburg-2026@github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}