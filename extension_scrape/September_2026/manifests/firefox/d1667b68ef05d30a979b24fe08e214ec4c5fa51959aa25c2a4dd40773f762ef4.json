{"manifest_version": 3, "name": "TunnelMind Surveillance Receipt", "version": "1.3.1", "description": "See what your browsing data is worth to surveillance companies. Everything runs locally \u2014 no data ever leaves your device.", "permissions": ["webNavigation", "webRequest", "storage", "tabs"], "host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://tunnelmind.ai/receipt*", "https://tunnelmind.ai/map*"], "js": ["content_bridge.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Surveillance Receipt", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "surveillance-receipt@tunnelmind.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}