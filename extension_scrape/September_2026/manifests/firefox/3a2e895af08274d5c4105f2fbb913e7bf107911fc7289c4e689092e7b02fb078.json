{"manifest_version": 3, "name": "Instagram Reels Filter", "version": "1.1", "description": "Filtra Reels de Instagram por cantidad de likes y comentarios.", "permissions": ["storage"], "host_permissions": ["*://www.instagram.com/*"], "content_scripts": [{"matches": ["*://www.instagram.com/*"], "js": ["utils.js", "content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "instagram-reels-filter@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_title": "Instagram Reels Filter", "default_icon": "icons/icon.svg"}}