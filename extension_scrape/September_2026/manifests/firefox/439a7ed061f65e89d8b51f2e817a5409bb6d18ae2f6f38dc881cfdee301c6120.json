{"manifest_version": 2, "name": "tabhaven", "version": "1.0.2", "description": "Save and organize tabs to tabhaven.com", "permissions": ["tabs", "contextMenus", "cookies", "notifications", "storage", "alarms", "unlimitedStorage", "https://tabhaven.com/*"], "background": {"scripts": ["config.js", "cache.js", "tabs-db.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "omnibox": {"keyword": "th"}, "browser_specific_settings": {"gecko": {"id": "hello@tabhaven.com", "strict_min_version": "109.0"}}, "commands": {"send-to-tabhaven": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current tab to tabhaven"}, "open-search": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open or focus tabhaven search"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}