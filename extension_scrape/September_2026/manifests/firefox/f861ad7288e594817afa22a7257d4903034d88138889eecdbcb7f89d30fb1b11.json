{"manifest_version": 3, "name": "Auxiliador de Postagens", "version": "1.1.0", "description": "Captura o link do v\u00eddeo aberto (X, TikTok, Instagram) e envia para o seu bot do Telegram.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://ext.nodebahia.com.br/*"], "browser_specific_settings": {"gecko": {"id": "auxiliador-postagens@bload.nodebahia.com.br", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteActivity", "authenticationInfo"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Auxiliador de Postagens", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}