{"manifest_version": 3, "name": "Snippet Expander", "version": "1.2", "description": "Type a short shortcut and instantly expand it into a full block of text, with line breaks preserved.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Snippet Expander", "default_popup": "popup.html", "default_icon": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "phrase-emoji@roman"}}}