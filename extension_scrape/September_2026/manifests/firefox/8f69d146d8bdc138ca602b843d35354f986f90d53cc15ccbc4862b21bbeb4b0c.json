{"manifest_version": 3, "name": "TrustGuard - Email Scam Detector", "version": "2.3.6", "description": "Automatically scans Gmail, Yahoo Mail, Outlook, AT&T/BellSouth, and other webmail for phishing and scam patterns.", "permissions": ["storage"], "host_permissions": ["https://mail.google.com/*", "https://mail.yahoo.com/*", "https://mail.yahoo.co.uk/*", "https://mail.yahoo.ca/*", "https://mail.yahoo.com.au/*", "https://overview.mail.yahoo.com/*", "https://currently.att.yahoo.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "TrustGuard", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://mail.yahoo.com/*", "https://mail.yahoo.co.uk/*", "https://mail.yahoo.ca/*", "https://mail.yahoo.com.au/*", "https://overview.mail.yahoo.com/*", "https://currently.att.yahoo.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.com/*"], "js": ["dist/content.js"], "css": ["styles/gmail-panel.css"], "run_at": "document_idle", "all_frames": true}], "incognito": "spanning", "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "trustguard@trustguard.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}