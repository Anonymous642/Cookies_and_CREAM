{"manifest_version": 3, "name": "AutoGroupie", "version": "1.0.3", "description": "Auto-organizes tabs into color-coded groups by URL rules. Supports wildcard, regex, domain suggestions, and manual regrouping.", "browser_specific_settings": {"gecko": {"id": "autogroupie@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html"}, "background": {"scripts": ["tabgroups.js"]}, "permissions": ["tabGroups", "storage", "tabs"]}