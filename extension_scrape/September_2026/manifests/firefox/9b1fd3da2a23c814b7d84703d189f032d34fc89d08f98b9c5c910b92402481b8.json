{"manifest_version": 3, "name": "Smart Form Filler", "version": "3.1.0", "description": "Fill forms in 1 click. Capture fields as profiles, auto-fill anywhere, or generate safe fake data \u2014 local only.", "permissions": ["storage", "scripting", "activeTab", "notifications", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup/popup-new.html"}, "options_ui": {"page": "options/settings.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open Smart Form Filler popup"}, "fill-fake-data": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Fill form with fake data"}, "capture-form": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capture current form as profile"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "browser_specific_settings": {"gecko": {"id": "{e8c9a7b2-4f3d-4c2b-9a1e-6d5f8c3e4a7b}", "strict_min_version": "109.0"}}, "data_collection_permissions": {"builtin": {"public_info_collection": false}}}