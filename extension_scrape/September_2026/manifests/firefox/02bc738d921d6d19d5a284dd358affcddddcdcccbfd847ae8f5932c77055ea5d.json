{"manifest_version": 3, "name": "Tabfinder Ultimate", "description": "Quickly search and switch tabs.", "version": "1.0.13", "icons": {"128": "icon/128.png"}, "permissions": ["tabs", "storage", "tabGroups", "sessions"], "browser_specific_settings": {"gecko": {"id": "tabfinder-ultimate-1@vegeta47.dev", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}}, "switch-to-last-used-tab": {"suggested_key": {"default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period"}, "description": "Switch to the last used tab"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tabfinder Ultimate", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}