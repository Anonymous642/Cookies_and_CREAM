{"manifest_version": 3, "name": "Tab Tamer", "version": "1.3", "description": "Freezes idle tabs to save memory & organize your browser", "homepage_url": "https://github.com/yourusername/tabtamer", "author": "TabTamer Developer", "permissions": ["tabs", "storage", "alarms", "idle"], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tabtamer@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "description": "Extension does not collect user data"}}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png"}}}