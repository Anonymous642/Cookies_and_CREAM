{"manifest_version": 3, "name": "In'Seine Parental Web Filter", "version": "0.8.0", "description": "A net across the web. Parents choose what it catches; children never see the rest.", "browser_specific_settings": {"gecko": {"id": "inseine@inseine.co.uk", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "webNavigation", "tabs", "alarms", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/schedule.js", "lib/pin.js", "lib/youtube.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["youtube/page-probe.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["*://*.youtube.com/*"], "js": ["lib/youtube.js", "youtube/content.js"], "css": ["youtube/styles.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["youtube/page-probe.js"], "matches": ["*://*.youtube.com/*"]}], "declarative_net_request": {"rule_resources": [{"id": "youtube-ads", "enabled": false, "path": "youtube/rules.json"}]}, "action": {"default_title": "In'Seine", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"128": "icons/icon128.png"}}