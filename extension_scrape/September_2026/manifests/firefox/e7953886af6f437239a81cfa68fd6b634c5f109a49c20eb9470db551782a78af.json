{"manifest_version": 3, "name": "ChatWraps", "author": "Nair", "developer": {"name": "Nair", "url": "https://www.chatwraps.com"}, "version": "2.0.1", "description": "The ultimate AI conversation extractor for Gemini, Grok, and ChatGPT.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["*://gemini.google.com/*", "*://grok.com/*", "*://chatgpt.com/*"], "background": {"scripts": ["background/main.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "chatwraps@nair.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://gemini.google.com/*"], "js": ["lib/constants.js", "lib/jspdf.umd.min.js", "lib/jspdf.plugin.autotable.min.js", "lib/NotoSans-font.js", "lib/shared_ui.js", "lib/utils.js", "platforms/gemini/content.js"], "css": ["platforms/gemini/styles.css"]}, {"matches": ["*://grok.com/*"], "js": ["lib/constants.js", "lib/jspdf.umd.min.js", "lib/jspdf.plugin.autotable.min.js", "lib/NotoSans-font.js", "lib/shared_ui.js", "lib/utils.js", "platforms/grok/content.js"], "css": ["platforms/grok/styles.css"]}, {"matches": ["*://chatgpt.com/*"], "js": ["lib/constants.js", "lib/jspdf.umd.min.js", "lib/jspdf.plugin.autotable.min.js", "lib/NotoSans-font.js", "lib/shared_ui.js", "lib/utils.js", "platforms/chatgpt/content.js"], "css": ["platforms/chatgpt/styles.css"]}], "web_accessible_resources": [{"resources": ["lib/*", "icons/*"], "matches": ["<all_urls>"]}]}