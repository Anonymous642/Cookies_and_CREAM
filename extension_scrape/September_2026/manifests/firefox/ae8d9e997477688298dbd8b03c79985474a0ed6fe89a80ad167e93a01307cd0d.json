{"manifest_version": 3, "name": "SavvyShield", "version": "1.1.7", "description": "AI-powered protection that scans, trains, and simulates to help you recognize and avoid online threats.", "permissions": ["contextMenus", "notifications", "storage", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["images/logo.png", "images/warning-sign.png", "images/thumbsup.png", "images/thumbsdown.png", "images/shield-check.png", "images/savvyScan.gif", "styles/styles.css", "styles/fonts/urbanist-latin-wght-normal.woff2", "styles/fonts/urbanist-latin-ext-wght-normal.woff2"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background/background.js"], "type": "module"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_popup": "popup/login.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "SavvyShield"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self';"}, "sidebar_action": {"default_panel": "sidepanel/disabled.html", "default_title": "SavvyShield", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png"}, "open_at_install": false}, "content_scripts": [{"matches": ["https://portal.savvyshield.com/*", "https://eiros-backend.web.app/*", "*://localhost/*"], "js": ["content-scripts/portal-bridge.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "extension@savvyshield.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity", "websiteContent"]}}}}