{"manifest_version": 2, "name": "tws.my.id - Multi Tools", "description": "Multi-purpose plugin to perform a translate, dns check and more.", "version": "2.3.9", "icons": {"16": "/dns-16.png", "48": "/dns-48.png", "128": "/dns-128.png"}, "options_ui": {"page": "options.html"}, "permissions": ["activeTab", "tabs", "storage", "contextMenus", "scripting", "http://*/*", "https://*/*", "http://api.tws.my.id/*", "https://api.tws.my.id/*", "https://api.openai.com/*"], "commands": {"translate-selected": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T", "linux": "Ctrl+Shift+T"}, "description": "Translate selected text (Indonesian \u2192 English)"}, "paraphrase-selected": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P", "linux": "Ctrl+Shift+P"}, "description": "Paraphrase selected text (Empathetic & Professional)"}, "screenshot-capture": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S", "linux": "Ctrl+Shift+S"}, "description": "Capture a screenshot (region or full page)"}}, "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://localhost:3000 http://api.tws.my.id https://api.tws.my.id https://api.openai.com;", "browser_specific_settings": {"gecko": {"id": "tws-my-id@irfani.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "tws.my.id", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}]}