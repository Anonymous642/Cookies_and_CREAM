{"manifest_version": 2, "name": "Sakitoo SMS - Extracteur WhatsApp", "version": "1.0.0", "description": "Extraire les numeros de telephone depuis WhatsApp Web pour les importer dans Sakitoo SMS", "permissions": ["activeTab", "storage", "https://web.whatsapp.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@sakitoosms.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "websiteContent"]}}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}