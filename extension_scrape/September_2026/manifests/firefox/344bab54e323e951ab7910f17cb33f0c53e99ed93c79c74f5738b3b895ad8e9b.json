{"manifest_version": 2, "name": "Punkin", "description": "Save recipes from the web into Punkin.", "version": "0.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "<all_urls>", "https://punkin.top/*"], "browser_specific_settings": {"gecko": {"id": "punkin@punkin.top", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Punkin", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}