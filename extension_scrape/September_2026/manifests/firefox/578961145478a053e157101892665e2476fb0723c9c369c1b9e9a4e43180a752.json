{"manifest_version": 3, "name": "Online Grocery Manager", "version": "1.0", "description": "Collect and manage grocery lists directly from recipe websites, making shopping easier.", "icons": {"128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "{e4b9d2f3-a7c8-4f6e-b9d2-c5e8b0f7c3a1}"}}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["*://*.allrecipes.com/*", "*://*.foodnetwork.com/*", "*://*.epicurious.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.allrecipes.com/*", "*://*.foodnetwork.com/*", "*://*.epicurious.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}