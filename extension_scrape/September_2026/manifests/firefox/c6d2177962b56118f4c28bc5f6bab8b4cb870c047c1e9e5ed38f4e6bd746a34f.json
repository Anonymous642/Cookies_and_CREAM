{"manifest_version": 2, "name": "GitHub PR Link Copier", "version": "1.0", "description": "Adds a 'Copy Link' button on GitHub pull requests that copies the PR title and URL to clipboard.", "permissions": ["clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "github-pr-link@tpilewicz", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://github.com/*/*/pull/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/copy.svg"}}