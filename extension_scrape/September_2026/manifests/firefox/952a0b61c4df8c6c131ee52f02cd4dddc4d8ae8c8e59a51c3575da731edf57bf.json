{"manifest_version": 3, "name": "Fuzzy YouTube Thumbnails", "short_name": "Fuzzy", "version": "1.1.1", "description": "Blur YouTube video thumbnails and reveal them only when you choose.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "fuzzy-youtube-thumbnails@local", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["storage"], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Fuzzy YouTube Thumbnails", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "css": ["content.css"], "js": ["shared-settings.js", "content.js"], "run_at": "document_start"}]}