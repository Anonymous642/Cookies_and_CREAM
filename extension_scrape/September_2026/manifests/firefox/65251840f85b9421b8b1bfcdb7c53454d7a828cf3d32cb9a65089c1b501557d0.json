{"manifest_version": 3, "name": "DNS Robot - DNS Lookup Tool", "version": "1.0.0", "description": "Quick DNS lookup for any domain. Check A, AAAA, MX, NS, TXT, CNAME, SOA records instantly from dnsrobot.net.", "browser_specific_settings": {"gecko": {"id": "dns-robot@dnsrobot.net", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "DNS Robot - Quick DNS Lookup"}, "permissions": ["activeTab", "tabs"], "host_permissions": ["https://dnsrobot.net/*", "https://cloudflare-dns.com/*"]}