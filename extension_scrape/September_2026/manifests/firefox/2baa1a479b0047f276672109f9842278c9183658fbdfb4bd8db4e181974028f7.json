{"manifest_version": 2, "name": "Youtube Transcript Editable ChatGPT-Prompt", "version": "1.7", "description": "Copy YouTube transcript to clipboard (optional: with Chat GPT prompt) \u2014 Sidebar UI.", "permissions": ["activeTab", "tabs", "clipboardWrite", "*://*.youtube.com/*", "*://youtu.be/*"], "browser_action": {"default_title": "YT Transcript (Sidebar)"}, "sidebar_action": {"default_title": "YT Transcript", "default_panel": "sidebar/sidebar.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*", "*://*.youtube.com/live/*", "*://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "browser_specific_settings": {"gecko": {"id": "@yt-transcript.birdmanntutorials", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}