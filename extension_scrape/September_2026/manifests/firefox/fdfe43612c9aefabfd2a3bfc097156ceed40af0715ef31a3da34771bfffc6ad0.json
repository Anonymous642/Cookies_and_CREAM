{"manifest_version": 3, "name": "Following Filters for Twitch", "description": "Adds the ability to sort and filter your followed channels on Twitch.", "version": "2.0.0", "browser_specific_settings": {"gecko": {"id": "following-filters@twitch-following-filters", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.twitch.tv/*"], "js": ["js/storage.js", "js/autocomplete.js", "js/filtering.js", "js/content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["js/background.js"]}, "action": {"default_title": "Following Filters", "default_popup": "popup.html", "default_icon": {"16": "images/filter-16.png", "32": "images/filter-32.png"}}, "permissions": ["storage", "scripting"], "host_permissions": ["https://*.twitch.tv/*"], "icons": {"16": "images/filter-16.png", "32": "images/filter-32.png", "48": "images/filter-48.png", "128": "images/filter-128.png"}}