{"manifest_version": 2, "name": "TinyImageCompare", "version": "1.0.0", "description": "Ch\u1ecdn \u1ea3nh A r\u1ed3i \u1ea3nh B \u2192 so s\u00e1nh v\u1edbi slider (before/after) trong popup/overlay.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "TinyImageCompare", "default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "tinyimagecompare@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}