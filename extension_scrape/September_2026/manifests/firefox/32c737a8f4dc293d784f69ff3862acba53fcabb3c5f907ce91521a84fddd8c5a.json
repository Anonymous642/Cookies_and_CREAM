{"manifest_version": 3, "name": "Penny Resume", "short_name": "Penny Resume", "description": "Tailored resume PDF for any job posting. One click.", "version": "0.2.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "Penny Resume \u2014 tailor this job", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "downloads", "notifications"], "host_permissions": ["https://api.pennyresume.com/*"], "content_scripts": [{"matches": ["https://pennyresume.com/onboarding*", "https://pennyresume.com/post-signin*", "https://pennyresume.com/dashboard*"], "js": ["content-script.js"], "run_at": "document_start", "all_frames": false, "world": "ISOLATED"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}, "commands": {"generate": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Generate resume"}}, "browser_specific_settings": {"gecko": {"id": "pr@pennyresume.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}