{"manifest_version": 3, "name": "SubTube - Subscriptions Only", "version": "1.1.2", "description": "Turns YouTube into a subscriptions-only site: no algorithmic home feed, no Up next sidebar, no end-screen wall, no autoplay.", "browser_specific_settings": {"gecko": {"id": "SubTube@blueorange", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["settings.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["settings.js", "content.js"], "run_at": "document_start"}], "action": {"default_title": "SubTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}