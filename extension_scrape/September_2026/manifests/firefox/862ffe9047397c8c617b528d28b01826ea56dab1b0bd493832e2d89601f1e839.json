{"manifest_version": 3, "name": "Shorts Scroll Blocker Minimalist", "version": "1.0", "description": "Stops you from mindlessly scrolling through YouTube Shorts.", "browser_specific_settings": {"gecko": {"id": "yt-scroll-blocker@robercik.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Shorts Scroll Blocker Minimalist"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}]}