{"manifest_version": 3, "name": "Costloop \u2013 Email Scanner for Firefox", "version": "1.0.99", "description": "Review Gmail and Outlook billing emails in Firefox to detect and import subscriptions into Costloop", "permissions": ["alarms", "storage", "history"], "host_permissions": ["https://www.googleapis.com/*", "https://graph.microsoft.com/*", "https://app.costloop.app/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Costloop Email Scanner for Firefox", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "browser_specific_settings": {"gecko": {"id": "costloop-email-scanner@costloop.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "financialAndPaymentInfo", "personalCommunications", "personallyIdentifyingInfo"]}}}, "optional_permissions": []}