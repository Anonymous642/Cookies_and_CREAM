{"manifest_version": 3, "name": "Lasso-select for TurtleStitch and Snap!", "version": "3.1", "description": "Adds rectangle lasso multi-selection, Alt-click toggle, Select All (Cmd+A/Ctrl+A), and Backspace/Delete shortcuts to TurtleStitch & Snap! workspaces.", "permissions": ["activeTab"], "content_scripts": [{"matches": ["https://snap.berkeley.edu/snap/snap.html*", "https://www.turtlestitch.org/*", "http://localhost:8000/*", "http://127.0.0.1:8000/*"], "all_frames": true, "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "snap-lasso-selection@antigravity.addon", "data_collection_permissions": {"required": ["none"]}}}}