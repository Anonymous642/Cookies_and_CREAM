{"manifest_version": 3, "name": "Vite Research", "version": "2.0.5", "description": "Highlight and annotate web pages using a sidebar synced with Vite Research.", "permissions": ["storage", "tabs", "scripting", "activeTab"], "host_permissions": ["https://api.viteresearch.com/*"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Toggle the Vite Research sidebar"}, "toggle-quick-capture": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Toggle Quick Capture"}}, "action": {"default_title": "Vite Research", "default_icon": {"16": "annotatorFavicon16.png", "32": "annotatorFavicon32.png", "48": "annotatorFavicon48.png", "128": "annotatorFavicon128.png"}}, "icons": {"16": "annotatorFavicon16.png", "32": "annotatorFavicon32.png", "48": "annotatorFavicon48.png", "128": "annotatorFavicon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-bridge.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "extension@viteresearch.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}