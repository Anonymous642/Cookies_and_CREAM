{"manifest_version": 3, "name": "ArtiFlux Saver", "version": "1.3.0", "description": "Save articles to ArtiFlux", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to ArtiFlux"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications", "tabs"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*.supabase.co/*", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"open-link-picker": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save a link from this page to ArtiFlux"}}, "browser_specific_settings": {"gecko": {"id": "artiflux-saver@ritesh.com", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}