{"manifest_version": 2, "name": "Webshare Containers", "version": "1.3.1", "description": "Cria containers do Firefox a partir dos seus proxies da Webshare (Proxy Server e IP Estatico Residencial), com proxy e autenticacao configurados automaticamente, troca de IPs expirados em segundo plano e bloqueio do container se o proxy falhar, para nao expor seu IP real.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["contextualIdentities", "cookies", "proxy", "storage", "webRequest", "webRequestBlocking", "management", "tabs", "alarms", "<all_urls>", "https://proxy.webshare.io/*"], "web_accessible_resources": ["bloqueado.html"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Webshare Containers", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "webshare-containers@seudominio.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}