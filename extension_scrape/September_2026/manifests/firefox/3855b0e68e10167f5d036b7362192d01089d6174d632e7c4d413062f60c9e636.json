{"manifest_version": 3, "name": "Fokasu", "version": "1.0.0", "description": "Blocks websites during Fokasu focus sessions. Website URL checks stay local to the extension.", "icons": {"16": "icons/fokasu-16.png", "32": "icons/fokasu-32.png", "48": "icons/fokasu-48.png", "128": "icons/fokasu-128.png"}, "permissions": ["alarms", "storage", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:27843"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "{71f975d7-4744-4ad5-9d35-471236efe7f1}", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}, "strict_min_version": "142.0"}}}