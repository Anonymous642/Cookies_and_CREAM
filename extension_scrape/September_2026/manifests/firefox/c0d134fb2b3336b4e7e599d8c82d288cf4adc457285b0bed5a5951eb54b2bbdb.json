{"manifest_version": 3, "name": "Video Opener & Downloader", "version": "1.0.0", "description": "Open videos in a new tab by middle-clicking on thumbnails. Press 'd' to download, 'a' to bulk download.", "author": "redext_dev", "browser_specific_settings": {"gecko": {"id": "redext@redext.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.redgifs.com/*"], "js": ["content.js"], "run_at": "document_end"}], "permissions": ["tabs", "storage", "downloads"]}