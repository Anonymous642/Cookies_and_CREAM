{"manifest_version": 3, "name": "Blocker GPT", "version": "0.5.0", "description": "Blocker GPT full beta with stronger ad blocking, popup protection and settings.", "browser_specific_settings": {"gecko": {"id": "blockergpt@example.com"}}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "ads", "enabled": true, "path": "rules.json"}]}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}