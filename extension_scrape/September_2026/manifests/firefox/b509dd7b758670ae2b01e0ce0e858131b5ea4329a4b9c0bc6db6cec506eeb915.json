{"manifest_version": 3, "name": "sbm bookmarks", "short_name": "sbm", "version": "0.3.1", "description": "Your sbm bookmarks in the browser: search as you type, add the page, sync with bm and the sbm app.", "homepage_url": "https://github.com/equwal/sbm-extension", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "sbm bookmarks", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open sbm"}}, "omnibox": {"keyword": "bm"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["lib/tsv.js", "lib/fuzzy.js", "lib/plan.js", "background.js"]}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://sbmsync.com/*", "https://sbm.subread.space/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "sbm@equwal.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["bookmarksInfo", "personallyIdentifyingInfo", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}