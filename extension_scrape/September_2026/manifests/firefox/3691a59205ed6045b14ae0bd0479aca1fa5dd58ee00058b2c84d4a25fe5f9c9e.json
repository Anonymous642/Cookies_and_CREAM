{"manifest_version": 2, "name": "Surge Download Manager", "description": "High-performance download acceleration. Intercepts and routes browser downloads to Surge's multi-connection engine.", "version": "2.1.3", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "storage", "notifications", "webRequest", "http://127.0.0.1/*", "<all_urls>"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Surge", "default_popup": "popup.html"}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "surge@surge-downloader.com", "strict_min_version": "109.0"}}, "background": {"scripts": ["background.js"]}}