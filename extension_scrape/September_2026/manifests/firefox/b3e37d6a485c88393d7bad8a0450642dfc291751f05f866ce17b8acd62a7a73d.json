{"manifest_version": 3, "name": "Favorites \u2014 start page", "version": "0.2.1", "description": "Your start page on every new tab. Syncs by a URL \u2014 no account, no login, no trackers.", "browser_specific_settings": {"gecko": {"id": "favorites@favorites.website", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage"], "host_permissions": ["https://favorites.website/*"], "content_scripts": [{"matches": ["https://favorites.website/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Favorites", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}