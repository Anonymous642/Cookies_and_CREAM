{"manifest_version": 2, "name": "KamiList", "version": "0.1.4", "description": "Enregistre, suis et organise tous tes mangas, manhwas, webtoons et animes en un seul endroit automatiquement via l'extension et l'application.", "permissions": ["tabs", "activeTab", "storage", "https://app.kamilist.com/*"], "content_scripts": [{"matches": ["*://mangas-origines.fr/*", "*://www.mangas-origines.fr/*", "*://raijin-scans.fr/*", "*://www.raijin-scans.fr/*", "*://phenix-scans.com/*", "*://www.phenix-scans.com/*", "*://scan-manga.com/*", "*://www.scan-manga.com/*", "*://crunchyscan.fr/*", "*://www.crunchyscan.fr/*", "*://manga-scantrad.io/*", "*://www.manga-scantrad.io/*", "*://sushiscan.net/*", "*://www.sushiscan.net/*", "*://webtoons.com/*", "*://www.webtoons.com/*", "*://anime-sama.fr/*", "*://www.anime-sama.fr/*"], "js": ["src/js/admin-tracker.js", "src/js/content-script.js"], "css": ["src/css/floating-widget.css"], "run_at": "document_end"}], "background": {"scripts": ["src/js/background.js"], "persistent": false}, "browser_action": {"default_popup": "src/pages/add.html", "default_icon": {"16": "src/assets/icons/icon.png", "48": "src/assets/icons/icon.png", "128": "src/assets/icons/icon.png"}}, "icons": {"16": "src/assets/icons/icon.png", "48": "src/assets/icons/icon.png", "128": "src/assets/icons/icon.png"}, "web_accessible_resources": ["src/components/*.html", "src/pages/*.html", "src/assets/**/*"], "applications": {"gecko": {"id": "kamilist@kami-list.com", "strict_min_version": "58.0"}}}