{"manifest_version": 3, "name": "WalkReminder", "description": "Get walk reminders while browsing tracked websites based on your configured time thresholds.", "version": "1.0.0", "short_name": "WalkReminder", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "WalkReminder", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "walkreminder@kartheek.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}