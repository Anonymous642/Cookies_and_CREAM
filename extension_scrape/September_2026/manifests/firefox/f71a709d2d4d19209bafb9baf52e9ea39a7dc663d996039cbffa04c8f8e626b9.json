{"manifest_version": 3, "name": "FBIG Stories Unseen", "description": "Hide your 'seen' status on Facebook and Instagram Stories with a simple toggle.", "version": "1.0.1", "icons": {"128": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "fbig-stories-unseen@duckcit", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "data_collected": [], "data_shared": []}}}, "content_scripts": [{"matches": ["https://*.facebook.com/*", "https://*.instagram.com/*"], "js": ["scripts/inject.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["scripts/unseen.js"], "matches": ["https://*.facebook.com/*", "https://*.instagram.com/*"]}], "permissions": ["storage", "tabs"], "host_permissions": ["https://*.facebook.com/*", "https://*.instagram.com/*"], "action": {"default_popup": "popup/popup.html"}}