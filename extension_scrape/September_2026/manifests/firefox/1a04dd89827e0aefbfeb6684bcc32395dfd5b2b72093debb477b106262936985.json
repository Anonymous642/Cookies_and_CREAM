{"manifest_version": 2, "name": "Alt Text Inspector", "version": "1.2.4", "description": "A quick accessibility check for images. Label each picture on a page with its alternative text and clearly mark any image that has none, with a running count of how many descriptions are missing.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{ec6b8a15-d4c3-4fa7-ac93-96c2701066cd}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Alt Text Inspector", "default_popup": "app/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}