{"manifest_version": 3, "name": "Encryptio Password Manager", "version": "1.1.7", "description": "Unlock your Encryptio vault and fill or save logins on the sites you visit. The API returns ciphertext only.", "author": "Encryptio <info@encryptio.it>", "homepage_url": "https://www.encryptio.it", "browser_specific_settings": {"gecko": {"id": "info@encryptio.it", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"], "host_permissions": ["https://encryptio.it/*", "https://*.encryptio.it/*", "http://127.0.0.1:5000/*", "http://localhost:5000/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*", "http://*/*", "https://*/*"], "content_scripts": [{"matches": ["https://encryptio.it/*", "https://*.encryptio.it/*", "http://127.0.0.1:5000/*", "http://localhost:5000/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*"], "js": ["bridge.js"], "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://encryptio.it/*", "https://*.encryptio.it/*", "http://127.0.0.1:5000/*", "http://localhost:5000/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*"], "js": ["page.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Encryptio Vault", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'self'; form-action 'none';"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}