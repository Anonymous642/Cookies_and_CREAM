{"manifest_version": 3, "name": "Moxby", "version": "3.2.0", "description": "A workspace where you and your AI agent work in context: Mods, Missions, and chat on any site via ChatGPT, Claude, or OpenRouter.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "extension@moxby.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personalCommunications", "websiteContent"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Moxby \u2014 Alt+Shift+D to toggle chat", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"scripts": ["service-worker.js"], "type": "module"}, "sidebar_action": {"default_title": "Moxby", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "open_at_install": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "nativeMessaging", "scripting", "webNavigation", "contextMenus", "tabGroups", "webRequest", "cookies", "unlimitedStorage", "alarms", "notifications", "downloads"], "optional_permissions": ["userScripts"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["sidepanel.html", "component-preview.html", "mod-reference-preview.html", "assets/*", "icons/*", "logos/*"], "matches": ["<all_urls>"]}], "commands": {"download-debug-logs": {"suggested_key": {"default": "Ctrl+D", "mac": "Command+D"}, "description": "Download Moxby debug logs"}, "toggle-moxby": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Alt+Shift+M"}, "description": "Toggle the Moxby sidebar"}, "toggle-moxby-dock": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open or close the docked chat on the current page"}}}