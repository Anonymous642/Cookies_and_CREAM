{"manifest_version": 3, "name": "SQL Formatter \u2014 T-SQL & More", "version": "1.0.0", "description": "Instantly beautify T-SQL, MySQL, PostgreSQL and more. Paste, format, copy. Also adds a right-click 'Format SQL' option for selected text on any page.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "sql-formatter@igor.extension", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/sql-formatter.min.js", "content.js"], "run_at": "document_idle"}]}