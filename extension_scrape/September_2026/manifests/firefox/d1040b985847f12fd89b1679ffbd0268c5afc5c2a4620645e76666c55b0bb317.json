{"manifest_version": 3, "name": "Speed Controller", "version": "1.3", "description": "Control video playback speed with hotkeys, per-site profiles, and a quick popup.", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_title": "Speed Controller - adjust playback speed"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "speed-controller@ducky.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"set_speed_100": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Set playback speed to 100%"}, "set_speed_135": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Set playback speed to 135%"}, "set_speed_200": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Set playback speed to 200%"}, "set_speed_250": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Set playback speed to 250%"}, "speed_up": {"description": "Increase playback speed"}, "speed_down": {"description": "Decrease playback speed"}, "reset_speed": {"description": "Reset to the default speed"}}}