{"manifest_version": 2, "name": "Audio Compressor", "version": "1.0", "description": "Compresses audio in the browser to make lows louder and highs quieter.", "permissions": ["activeTab", "storage", "management", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/compressor-48.png"}}, "options_ui": {"page": "options/page.html"}, "browser_specific_settings": {"gecko": {"id": "@simple-compressor", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"48": "icons/compressor-48.png"}}