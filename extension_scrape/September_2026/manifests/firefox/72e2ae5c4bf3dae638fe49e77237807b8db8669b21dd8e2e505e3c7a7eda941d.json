{"manifest_version": 2, "name": "Makro Pro Unit Price Calculator", "version": "1.1", "description": "A Firefox extension that calculates and displays per-unit pricing for products sold by weight or volume on makro.pro", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Unit Price Calculator"}, "content_scripts": [{"matches": ["https://www.makro.pro/*", "https://makro.pro/*"], "js": ["content-makro-unitprice.js"], "run_at": "document_idle"}], "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "@mpromax", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "58.0"}, "gecko_android": {"strict_min_version": "113.0"}}}