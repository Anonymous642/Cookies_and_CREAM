{"manifest_version": 2, "name": "Series Tracker", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "series-tracker@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Automatically track your TV shows and anime across Netflix, Amazon Prime Video, and 9anime. See your watch progress, organize by status, and resume with one click.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs", "https://api.themoviedb.org/*", "https://api.jikan.moe/*"], "background": {"scripts": ["utils/utils.js", "utils/api.js", "storage/storage.js", "background.js"]}, "browser_action": {"default_icon": "icons/icon-48.png", "default_popup": "popup/popup.html", "default_title": "Series Tracker"}, "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["utils/utils.js", "detectors/base.js", "detectors/netflix.js"], "run_at": "document_idle"}, {"matches": ["*://*.primevideo.com/*", "*://*.amazon.com/gp/video/*", "*://*.amazon.com/dp/*"], "js": ["utils/utils.js", "detectors/base.js", "detectors/amazon.js"], "run_at": "document_idle"}, {"matches": ["*://*.9anime.to/*", "*://*.9animetv.to/*", "*://*.9anime.gs/*", "*://*.9anime.me/*", "*://*.9anime.id/*", "*://*.9anime.pe/*", "*://*.9anime.pl/*", "*://*.aniwave.to/*", "*://*.aniwave.live/*", "*://*.aniwatchtv.to/*"], "js": ["utils/utils.js", "detectors/base.js", "detectors/9anime.js"], "run_at": "document_idle"}]}