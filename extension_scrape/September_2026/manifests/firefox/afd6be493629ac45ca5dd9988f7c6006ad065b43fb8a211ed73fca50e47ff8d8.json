{"manifest_version": 3, "name": "Prime Download Manager Integration", "version": "1.1.3", "version_name": "1.1.3", "description": "Intercepts browser downloads and sends them to the Prime Download Manager desktop app.", "permissions": ["downloads", "storage", "notifications", "nativeMessaging", "tabs", "contextMenus", "cookies", "alarms"], "host_permissions": ["<all_urls>", "http://127.0.0.1:17832/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["messaging/native-messaging.js", "background/service-worker.js"]}, "action": {"default_title": "Prime Download Manager", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/youtube-button.js"], "run_at": "document_end"}, {"matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.fb.com/*", "*://*.fb.watch/*"], "js": ["content/tiktok-button.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "pdm@primedownloadmanager.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}