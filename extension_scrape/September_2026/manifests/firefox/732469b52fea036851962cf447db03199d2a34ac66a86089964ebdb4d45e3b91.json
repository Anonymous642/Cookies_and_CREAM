{"manifest_version": 3, "name": "Mute Commercials", "version": "1.0", "description": "Automatically mutes ads and sponsorships on streaming platforms.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitch.tv/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.twitch.tv/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "mute_commercials@antigravity.ai", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}