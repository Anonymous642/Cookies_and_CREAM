{"manifest_version": 3, "name": "Where it's AT", "version": "0.4.10", "description": "Browser extension that highlights atproto references on the current page.", "permissions": ["storage", "clipboardWrite", "menus"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "action": {"default_icon": {"16": "icons/inactive-16.png", "32": "icons/inactive-32.png", "48": "icons/inactive-48.png", "128": "icons/inactive-128.png"}, "default_title": "Where it's AT \u2014 reveal atproto references"}, "icons": {"16": "icons/detected-16.png", "32": "icons/detected-32.png", "48": "icons/detected-48.png", "128": "icons/detected-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "background": {"scripts": ["src/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "where-its-at@byjp.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}