{"manifest_version": 2, "name": "Spaced Learning Reminder", "version": "1.0.0", "description": "Use spaced repetition reminders to review topics at the right time and improve long-term memory.", "permissions": ["storage", "notifications", "alarms"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "SpacedLearningReminder@id", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}