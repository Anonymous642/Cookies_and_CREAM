{"manifest_version": 3, "name": "Clear View", "version": "1.0.0", "description": "Minimalistische Extension, die unerwuenschte Websites blockiert.", "permissions": ["storage", "webRequest", "webRequestBlocking", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/blocklist.js", "background/background.js"], "type": "module"}, "action": {"default_popup": "ui/popup.html", "default_title": "Clear View"}, "options_ui": {"page": "ui/options.html", "browser_style": false}, "browser_specific_settings": {"gecko": {"id": "clear-view@scal.red", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["data/blocklist.txt"], "matches": ["<all_urls>"]}]}