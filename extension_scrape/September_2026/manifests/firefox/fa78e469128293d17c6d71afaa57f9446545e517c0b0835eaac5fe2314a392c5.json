{"manifest_version": 3, "name": "Mark Seen Youtube", "description": "Easily mark YouTube videos as watched.", "version": "1.1.4", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_title": "Mark Seen Youtube", "default_popup": "extension-ui.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"mark-current-page": {"suggested_key": {"default": "Alt+W"}, "description": "Mark/unmark current video as watched"}}, "background": {"scripts": ["service_worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "contact@fixyourstartup.com", "strict_min_version": "112.0"}}}