{"manifest_version": 3, "name": "YouTube Video Scaler", "version": "1.0.0", "description": "Crop YouTube video to fill the current screen without changing video quality.", "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "css": ["scaler.css"], "run_at": "document_idle"}], "icons": {"48": "icons/scaler.svg", "96": "icons/scaler.svg"}, "browser_specific_settings": {"gecko": {"id": "youtube-video-scaler@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}