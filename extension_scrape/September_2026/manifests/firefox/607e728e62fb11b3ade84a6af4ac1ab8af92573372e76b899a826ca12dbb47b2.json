{"manifest_version": 2, "name": "Meta Ads Extractor", "version": "1.0.0", "description": "Extract ad creatives and generate an interactive analysis report from the Meta Ad Library.", "author": "Mozilla Firefox Team", "permissions": ["downloads", "activeTab", "tabs", "https://www.facebook.com/*", "https://*.fbcdn.net/*", "https://*.cdninstagram.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Meta Ads Extractor", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "meta-ads-extractor@mozilla", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}