{"manifest_version": 2, "name": "MP3Skulls Video to MP3", "version": "1.0.0", "description": "Convert videos to MP3 directly from any webpage using MP3Skulls.org.", "browser_specific_settings": {"gecko": {"id": "@mp3skulls-video-to-mp3"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "tabs"], "browser_action": {"default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"]}]}