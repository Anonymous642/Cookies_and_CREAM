{"manifest_version": 3, "name": "Cardmarket Tools (manavalue.org)", "version": "5.17.1", "description": "Flags Cardmarket listings priced over or under market, fills Bulk Listing from a ManaBox CSV, and exports wants to Moxfield.", "homepage_url": "https://www.manavalue.org/cardmarket-tools", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.cardmarket.com/*/Stock/ListingMethods/BulkListing*", "https://www.cardmarket.com/*/Stock/Offers/*", "https://www.cardmarket.com/*/Users/*/Offers*", "https://www.cardmarket.com/*/Magic/Wants/*"], "js": ["cardmarket-tools.js"], "run_at": "document_idle", "world": "MAIN"}], "browser_specific_settings": {"gecko": {"id": "cardmarket-tools@manavalue.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}