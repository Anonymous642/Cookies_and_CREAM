{"manifest_version": 3, "name": "Priv Lens", "version": "1.3.4", "description": "See what the web sees about you. Clean tracking URLs, copy clean links, and score every site's privacy.", "homepage_url": "https://smallroom.dev/product/priv-lens/", "browser_specific_settings": {"gecko": {"id": "priv-lens@smallroom.dev", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Priv Lens", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/shorturl-intercept.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/fingerprint-inject.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content/fingerprint-main.js"], "matches": ["http://*/*", "https://*/*"]}], "permissions": ["storage", "webNavigation", "webRequest", "declarativeNetRequest", "cookies", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}