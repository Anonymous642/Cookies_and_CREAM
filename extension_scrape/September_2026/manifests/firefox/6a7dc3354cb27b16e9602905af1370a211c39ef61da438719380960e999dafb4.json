{"manifest_version": 3, "name": "Page Tab for Webflow", "short_name": "Page Tab", "version": "1.6.0", "description": "Alt+Tab-style recent-page switcher for Webflow Designer. Hold the hotkey, cycle pages, and release to switch instantly.", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.design.webflow.com/*"], "js": ["bridge.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}, {"matches": ["https://*.design.webflow.com/*"], "js": ["keylabel.js", "content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true, "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_title": "Page Tab for Webflow", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "page-tab@webflow-page-tab", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}