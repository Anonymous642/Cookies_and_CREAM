{"manifest_version": 3, "version": "1.0.1", "name": "presenza", "description": "MV3 build of the Presenza browser extension.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "action": {"default_icon": "icons/icon-32.png", "default_title": "Open Presenza"}, "sidebar_action": {"default_icon": "icons/icon-32.png", "default_title": "Presenza", "default_panel": "sidebar/index.html", "open_at_install": false}, "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/scripts.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/content-0.js"], "css": []}], "web_accessible_resources": [{"resources": ["content_scripts/*.css", "main-world-runtime.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "presenza@presence.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "author": "michael matos"}