{"manifest_version": 3, "name": "ShortsCut", "version": "1.0.1", "description": "Hides YouTube Shorts everywhere they appear \u2014 home feed, search, sidebar and channel pages \u2014 and opens any Short in the normal player. Works on desktop and Firefox for Android.", "author": "Harkenzo", "browser_specific_settings": {"gecko": {"id": "shortscut@harkenzo.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "css": ["block.css"], "js": ["blocker.js"], "run_at": "document_start", "all_frames": false}]}