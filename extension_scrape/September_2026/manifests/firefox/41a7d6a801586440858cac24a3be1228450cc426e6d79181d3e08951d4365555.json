{"manifest_version": 2, "name": "Just Marketplace", "version": "1.1", "description": "Marketplace without all the nonsense.", "browser_specific_settings": {"gecko": {"id": "just-marketplace@_kibben.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "icons": {"48": "icons/just-icon-48.png", "96": "icons/just-icon-96.png"}, "browser_action": {"default_title": "Just Marketplace", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["content.js"], "run_at": "document_start"}]}