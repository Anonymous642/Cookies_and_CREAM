{"manifest_version": 3, "name": "AI Assistant Chat Saver", "version": "1.0.0", "description": "Save your ChatGPT, Claude and Gemini conversations (including images) as self-contained HTML or Markdown files, or export them as a PDF.", "browser_specific_settings": {"gecko": {"id": "info@geomsoft.eu", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["downloads", "activeTab", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "*://*.oaiusercontent.com/*", "*://*.openai.com/*", "*://*.googleusercontent.com/*", "*://*.gstatic.com/*", "*://*.claude.ai/*", "*://*.anthropic.com/*"], "background": {"scripts": ["lib/filename.js", "lib/katex-css.js", "vendor/highlight.min.js", "lib/export-html.js", "lib/export-markdown.js", "lib/export-pdf.js", "background.js"]}, "action": {"default_title": "AI Assistant Chat Saver - Save this chat", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-scripts/extractor-common.js", "content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/extractor-common.js", "content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/extractor-common.js", "content-scripts/claude.js"], "run_at": "document_idle"}]}