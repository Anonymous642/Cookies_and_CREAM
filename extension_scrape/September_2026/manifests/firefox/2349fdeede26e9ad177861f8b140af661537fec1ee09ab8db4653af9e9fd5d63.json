{"manifest_version": 2, "name": "Bloqueador do X/Twitter", "version": "1.0.0", "description": "Bloqueia o acesso ao X/Twitter no Firefox para Android.", "permissions": ["webRequest", "webRequestBlocking", "*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@bloqueador-x-twitter", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}}