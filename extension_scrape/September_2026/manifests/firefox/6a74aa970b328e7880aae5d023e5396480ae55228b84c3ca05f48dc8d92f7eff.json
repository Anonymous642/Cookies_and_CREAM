{"manifest_version": 2, "name": "History Roulette", "version": "1.6", "description": "Take a nostalgic spin through your browsing history. One click pulls up a random page you once visited, filtered by age, so you can revisit old finds you'd otherwise forget.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{d2f73baa-e4ad-4183-bf15-d6cdaa5074c7}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["history", "tabs"], "browser_action": {"default_title": "History Roulette", "default_popup": "app/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}