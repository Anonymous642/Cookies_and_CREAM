{"manifest_version": 2, "name": "BlockForge", "version": "1.0.0", "description": "Wide-spectrum ad and tracker blocker with real-time stats.", "author": "devbybalu", "homepage_url": "https://github.com/szbobalu/", "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs", "activeTab", "notifications", "<all_urls>"], "background": {"scripts": ["rules.js", "background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "BlockForge", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "blockforge@devbybalu", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}