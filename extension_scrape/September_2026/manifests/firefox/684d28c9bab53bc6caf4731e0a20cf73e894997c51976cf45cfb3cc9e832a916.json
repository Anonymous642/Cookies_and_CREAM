{"manifest_version": 3, "name": "ClipForge", "version": "1.0.2", "description": "Simple video downloader for web videos", "author": "PaKu", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["activeTab", "downloads", "notifications", "storage", "tabs", "webRequest", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "default_title": "ClipForge", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/network-interceptor.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_end", "all_frames": true}, {"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content/youtube-bridge.js"], "run_at": "document_end", "world": "ISOLATED"}, {"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_end", "world": "MAIN"}], "browser_specific_settings": {"gecko": {"id": "clipforge@paku.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}