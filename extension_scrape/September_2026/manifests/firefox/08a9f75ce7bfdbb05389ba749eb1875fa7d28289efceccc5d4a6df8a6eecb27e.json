{"manifest_version": 3, "name": "Mark It", "version": "1.0.1", "description": "A simple web extension for tag-based bookmarking", "action": {"default_popup": "popup.html", "default_title": "Tag Bookmarks"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Q", "mac": "MacCtrl+Q"}, "description": "Open Bookmark Tagger"}}, "permissions": ["storage", "downloads", "tabs", "activeTab"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "mark-it@local.build", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}