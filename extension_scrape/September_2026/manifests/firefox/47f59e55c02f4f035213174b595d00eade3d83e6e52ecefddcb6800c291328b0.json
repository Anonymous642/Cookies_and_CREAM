{"manifest_version": 3, "name": "Blunder Review", "version": "3.1.3", "description": "Send a finished Chess.com or Lichess game to Blunder Review from the toolbar.", "homepage_url": "https://blunder.review", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open a Chess.com or Lichess game to review it", "default_icon": {"16": "icons/icon-muted-16.png", "32": "icons/icon-muted-32.png", "48": "icons/icon-muted-48.png", "128": "icons/icon-muted-128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["sw.js"], "type": "module"}, "permissions": ["tabs", "storage"], "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://blunder.review/*"], "js": ["presence.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "toolbar@blunder.review", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}