{"manifest_version": 3, "name": "TabGroupSync", "version": "0.3.0.0", "description": "A firefox extension that syncs tabs and tab-groups between devices", "icons": {"32": "icons/32-icon.png", "64": "icons/64-icon.png"}, "permissions": ["tabs", "tabGroups", "bookmarks", "theme", "storage"], "browser_specific_settings": {"gecko": {"id": "tabgroupsync@lofox.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "action": {"default_title": "TabGroupSync", "default_popup": "popup/popup.html", "default_area": "tabstrip", "default_icon": {"32": "icons/32-icon.png"}}}