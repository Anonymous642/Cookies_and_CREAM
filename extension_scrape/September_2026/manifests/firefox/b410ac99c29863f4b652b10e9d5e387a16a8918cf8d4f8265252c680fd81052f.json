{"manifest_version": 2, "name": "Dark Web Alert", "version": "1.3", "description": "Alerts users when entered email addresses may have appeared in known data breaches or dark web leaks.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["notifications", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Dark Web Alert", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Dark-Web-Alert", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}