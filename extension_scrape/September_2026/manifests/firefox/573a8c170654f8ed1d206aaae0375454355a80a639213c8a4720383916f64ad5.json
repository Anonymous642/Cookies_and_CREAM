{"manifest_version": 3, "name": "Ultimate Browser Assistant", "version": "4.0.0", "description": "Minimal Firefox/Zen Browser Assistant with three-tab settings for downloads, hover zoom, and smart social-video controls. Hover shows media at true actual size, including the real full-resolution image on Google Images results; Shift+hover for an instant full-resolution quick look.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "downloads", "notifications", "tabs"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Ultimate Browser Assistant"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"toggle-zoom": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Toggle Global Zoom on/off"}}, "browser_specific_settings": {"gecko": {"id": "{37e15f99-9cd2-46c9-a8c9-f027c60ac95f}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}