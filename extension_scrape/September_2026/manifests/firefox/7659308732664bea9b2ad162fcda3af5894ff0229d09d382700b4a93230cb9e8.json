{"manifest_version": 2, "name": "Nexload Browser Integration", "description": "Send downloads and selected links to the Nexload desktop app for macOS.", "version": "0.1.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["contextMenus", "nativeMessaging", "tabs", "cookies", "storage", "downloads", "notifications", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Send to Nexload", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "options_ui": {"page": "setup.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "nexload@nexload.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "homepage_url": "https://nexloadapp.com/", "content_security_policy": "script-src 'self'; object-src 'self'"}