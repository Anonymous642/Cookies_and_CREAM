{"manifest_version": 3, "name": "Full Page Print (All Content)", "version": "1.1.4", "description": "Print the entire page (not just the viewport). Flattens layout, hides sticky chrome, avoids bad page breaks, and lets you set paper size/margins.", "permissions": ["storage", "scripting", "activeTab", "contextMenus", "tabs"], "action": {"default_title": "Print full page"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"print_full_page": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Print full page"}}, "icons": {"16": "icons/print-16.png", "32": "icons/print-32.png", "48": "icons/print-48.png", "128": "icons/print-128.png"}, "browser_specific_settings": {"gecko": {"id": "full-page-print@yourname.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}