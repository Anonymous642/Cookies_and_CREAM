{"manifest_version": 2, "name": "AutoWallpaper", "version": "1.0.0", "description": "Thay \u1ea3nh n\u1ec1n tab m\u1edbi theo th\u1eddi ti\u1ebft (d\u00f9ng Open-Meteo + geolocation).", "permissions": ["storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "AutoWallpaper"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "@autowallpaper", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}