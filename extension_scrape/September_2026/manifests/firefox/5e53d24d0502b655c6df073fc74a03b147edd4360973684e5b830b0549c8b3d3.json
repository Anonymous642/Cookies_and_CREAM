{"manifest_version": 3, "name": "Skadooble \u2014 Active Recall", "version": "0.3.0", "description": "Active recall on autopilot: get a surprise question from your own Skadooble courses now and then, and answer it in seconds.", "permissions": ["alarms", "notifications", "storage", "identity"], "host_permissions": ["https://skadooble.com/*"], "browser_specific_settings": {"gecko": {"id": "recall@skadooble.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Skadooble Recall", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}