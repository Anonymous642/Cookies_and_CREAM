{"manifest_version": 2, "name": "Autoqueue", "version": "1.0.0", "description": "Opens the store tab the moment a watched queue goes live.", "permissions": ["storage", "alarms", "https://queue.autoqueue.app/*"], "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "extension@autoqueue.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}