{"manifest_version": 2, "name": "Quick Bookmark Filer", "version": "11.1", "description": "Quickly file bookmarks into folders with fuzzy search, recent locations, tree browsing, tab management, and history.", "browser_specific_settings": {"gecko": {"id": "quick-bookmark-filer@philip.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["bookmarks", "tabs", "activeTab", "storage", "history", "sessions", "clipboardRead", "menus", "alarms", "*://*/*"], "optional_permissions": ["downloads"], "browser_action": {"default_icon": {"48": "icons/icon-48.svg"}, "default_title": "Quick Bookmark Filer", "default_popup": "quicksave.html"}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Open Quick Save"}, "toggle-qbf": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Ctrl+MacCtrl+D"}, "description": "Open or close the QBF window"}, "toggle-quicksave": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Ctrl+MacCtrl+S"}, "description": "Open or close Quick Save"}, "toggle-url-as-tab": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Turn URL-as-Tab mode on or off"}, "toggle-quicktab": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Ctrl+MacCtrl+T"}, "description": "Open Quick Save in the Tabs pane"}}, "background": {"page": "background.html"}}