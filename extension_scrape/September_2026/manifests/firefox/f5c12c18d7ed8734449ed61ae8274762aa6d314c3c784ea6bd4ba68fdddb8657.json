{"manifest_version": 3, "name": "Zen Website Usage Tracker", "version": "1.1", "description": "Tracks daily website usage and helps manage digital well-being.", "browser_specific_settings": {"gecko": {"id": "zen-website-tracker@bhikules", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "idle", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "dashboard.html", "default_icon": "icons/icon48.png"}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"}}