{"manifest_version": 2, "name": "Quippy", "version": "1.0.0", "description": "Smart text assistant for quick lookups and conversions", "permissions": ["activeTab"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://en.wikipedia.org/*", "https://api.exchangerate-api.com/*", "https://worldtimeapi.org/*", "https://api.datamuse.com/*", "https://api.mymemory.translated.net/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["index.js", "widget.js"], "css": ["style.css"]}], "web_accessible_resources": ["assets/*"], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "quippy@example.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}, "data_collection": {"required": [], "optional": []}}}}