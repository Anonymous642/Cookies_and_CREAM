{"manifest_version": 3, "name": "Attune Focus Companion", "version": "0.3.1", "description": "Privacy-first local attention intelligence and distraction-reduction companion for Attune Focus desktop.", "icons": {"16": "attune-16.png", "32": "attune-32.png", "48": "attune-48.png", "256": "attune-256.png"}, "permissions": ["tabs", "nativeMessaging", "storage", "alarms", "declarativeNetRequest", "idle"], "browser_specific_settings": {"gecko": {"id": "attune@attuneprivacy.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "host_permissions": ["<all_urls>"], "background": {"scripts": ["policy.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["policy.js", "rule_enforcement.js"], "run_at": "document_start"}], "incognito": "not_allowed", "action": {"default_title": "Attune Focus Companion", "default_popup": "popup.html"}}