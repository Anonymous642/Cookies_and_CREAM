{"manifest_version": 3, "name": "YouTube Alchemy", "author": "Tim Macy", "version": "12.2.2", "description": "Swiss Army knife for YouTube with customizable features and interface improvements, all controlled via intuitive settings panels.", "homepage_url": "https://github.com/TimMacy/YouTubeAlchemy", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "128": "icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["https://*.youtube.com/*"], "background": {"scripts": ["panels.js"]}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "css": ["CascadingStyleSheets.css"], "js": ["YouTubeAlchemy.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["setVideoQuality.js", "maxVideoSize.js"], "matches": ["https://*.youtube.com/*"]}], "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html", "default_title": "YouTube Alchemy"}, "browser_specific_settings": {"gecko": {"id": "YouTubeAlchemy@TimMacy.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}