{"manifest_version": 3, "name": "Distill Text", "version": "1.0", "description": "Automatically detects articles and documentation, summarizes them with AI, and stores them locally", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>", "https://api.groq.com/*"], "background": {"scripts": ["background/background.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["libs/Readability.js", "content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Distill text", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "article-summarizer@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}