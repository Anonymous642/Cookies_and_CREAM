{"manifest_version": 2, "name": "Vault \u2013 Password Manager", "version": "1.0.1", "description": "Lokaler Vault-Passwortmanager: Autofill, Identit\u00e4ten, Passwortvorschl\u00e4ge und sichere Speicherabfrage.", "browser_specific_settings": {"gecko": {"id": "vault-firefox@thewalkingtoast.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity"]}}}, "permissions": ["nativeMessaging", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Vault", "default_popup": "popup.html", "default_icon": {"32": "icons/vault.svg"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "icons/vault.svg", "48": "icons/vault.svg", "96": "icons/vault.svg"}}