{"manifest_version": 3, "name": "Send to Koharu", "version": "0.4.1", "description": "Right-click an image in Firefox and send it to the local Koharu app.", "permissions": ["menus", "storage", "notifications", "webRequest", "webRequestBlocking"], "host_permissions": ["http://127.0.0.1/*", "https://*/*", "http://*/*"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "send-to-koharu@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Send to Koharu settings", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}}