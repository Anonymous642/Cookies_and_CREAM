{"manifest_version": 3, "name": "Videonotify: Fast Web & Video Note", "version": "1.3.5", "description": "Fast note-taking on any webpage with automatic URL, Title and Video Timestamp capture.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "fast-web-note@minikkerata.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity"]}}}, "permissions": ["tabs", "activeTab", "storage", "identity", "scripting"], "host_permissions": ["<all_urls>", "*://*/*", "https://*/*", "http://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.youtube.com https://*.googlevideo.com https://*.google.com;"}, "content_scripts": [{"matches": ["<all_urls>", "https://videonotify.vercel.app/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_title": "Videonotify: Fast Web Note", "default_panel": "src/extension/index.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "action": {"default_title": "Videonotify: Fast Web Note", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Yan Paneli A\u00e7 / Kapat (Toggle Sidebar)"}, "quick-note-capture": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Alt+Shift+K"}, "description": "Videoyu Durdur, Saniyeyi Yakala ve Not Kutusuna Odaklan"}}}