{"manifest_version": 2, "name": "LocalSampler", "version": "1.0.0", "description": "Record up to 30s from the current tab, trim 1\u20133 regions and export WAV/OGG.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "web_accessible_resources": ["assets/*", "icons/*"], "browser_specific_settings": {"gecko": {"id": "@localsampler-example", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}