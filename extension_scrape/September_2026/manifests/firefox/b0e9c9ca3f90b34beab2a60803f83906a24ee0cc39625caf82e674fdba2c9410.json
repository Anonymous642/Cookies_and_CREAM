{"manifest_version": 3, "name": "Hafnova Link Guard", "version": "1.1.7", "description": "Checks visited links against Link Guard and blocks by selected tags.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}, "permissions": ["storage", "tabs", "webNavigation", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>", "https://api.hafnova.com/*", "https://track.hafnova.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "options_page": "options.html", "action": {"default_title": "Hafnova Link Guard", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "threatdb-link-guard@hafnova.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}}