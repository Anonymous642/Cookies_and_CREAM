{"manifest_version": 3, "name": "HLTV Team Blacklister", "version": "1.0", "description": "Allows for blacklisting teams on HLTV.org. Once blocked, the matches involving this team will not show up on the upcoming section.", "browser_specific_settings": {"gecko": {"id": "hltvteamblacklister@maliszewski.co.uk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"96": "icons/hltvteamblacklister-96.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.hltv.org/*"], "js": ["hltvteamblacklister.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "HTML Match Blacklister", "default_popup": "popup.html"}}