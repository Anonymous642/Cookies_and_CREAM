{"manifest_version": 3, "name": "EasyTime for Firefox", "version": "0.4.3", "homepage_url": "https://techtime.co.nz/display/TECHTIME/EasyTime", "description": "Automatically record time as you work, and make it easy to review your day.", "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "html/options.html", "open_in_tab": true}, "permissions": ["alarms", "history", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_icon": "./icons/techtime-icon.png", "default_title": "EasyTime"}, "icons": {"16": "./icons/techtime-icon.png", "36": "./icons/techtime-icon.png", "48": "./icons/easytime-logo.png", "120": "./icons/easytime-logo.png"}, "browser_specific_settings": {"gecko": {"id": "easytime@techtime.co.nz"}}}