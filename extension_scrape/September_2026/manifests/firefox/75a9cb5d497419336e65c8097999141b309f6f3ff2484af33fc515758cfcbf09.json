{"manifest_version": 3, "name": "Spelltable to Google Sheets", "version": "1.31", "description": "Scrape Spelltable deck names and send to Google Sheets", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://spelltable.wizards.com/*", "https://script.google.com/*"], "content_scripts": [{"matches": ["https://spelltable.wizards.com/*"], "js": ["content.js"]}], "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "action": {"default_popup": "popup.html", "default_icon": "icon-48.png", "default_title": "Spelltable to Google Sheets"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "oscar@dahlberg.com", "data_collection_permissions": {"required": ["websiteContent"]}}}}