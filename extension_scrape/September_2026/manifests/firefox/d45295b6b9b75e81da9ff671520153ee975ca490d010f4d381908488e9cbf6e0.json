{"name": "Private Search & Tracker Blocker", "version": "1.0", "description": "Enhance your online privacy by searching securely and blocking trackers across websites with this lightweight extension", "manifest_version": 2, "chrome_settings_overrides": {"search_provider": {"name": "bipbop", "keyword": "bipbop", "search_url": "https://bipbop.me/search?q={searchTerms}", "favicon_url": "https://bipbop.me/favicon.ico", "suggest_url": "https://bipbop.me/api/suggest?q={searchTerms}", "encoding": "UTF-8", "is_default": true}}, "permissions": ["webRequest", "webRequestBlocking", "tabs", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"match_about_blank": true, "all_frames": true, "js": ["content.js"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "{73764f12-e057-4939-a3a0-ed4fb86d3398}"}}}