{"manifest_version": 3, "name": "Palisade", "version": "1.0.2", "description": "Blocks ads and trackers, hides what is left over, and shows you exactly what it did.", "icons": {"16": "assets/img/icon-16.png", "32": "assets/img/icon-32.png", "48": "assets/img/icon-48.png", "128": "assets/img/icon-128.png"}, "action": {"default_title": "Palisade", "default_popup": "ui/popup.html", "default_icon": {"16": "assets/img/icon-16.png", "32": "assets/img/icon-32.png", "48": "assets/img/icon-48.png", "128": "assets/img/icon-128.png"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/procedural.js", "content/contentscript.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["assets/redirects/*"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "palisade@tiltedlunar.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background/main.js"], "type": "module"}, "permissions": ["webRequest", "webRequestBlocking", "storage", "unlimitedStorage", "scripting", "tabs", "webNavigation", "alarms"]}