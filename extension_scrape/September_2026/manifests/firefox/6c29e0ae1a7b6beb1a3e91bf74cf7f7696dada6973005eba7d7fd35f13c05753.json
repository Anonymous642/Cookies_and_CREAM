{"manifest_version": 3, "name": "EchoClip", "version": "2.0.2", "description": "Auto-saves everything you copy and organizes it by website.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "clipboardWrite", "clipboardRead", "unlimitedStorage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}], "background": {"scripts": ["crypto.js", "background.js"]}, "commands": {"paste-pinned-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "Command+Shift+1"}, "description": "Paste 1st Pinned Item"}, "paste-pinned-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "Command+Shift+2"}, "description": "Paste 2nd Pinned Item"}, "paste-pinned-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "Command+Shift+3"}, "description": "Paste 3rd Pinned Item"}}, "action": {"default_title": "EchoClip", "default_icon": "icon.png"}, "web_accessible_resources": [{"resources": ["popup.html", "crypto.js", "popup.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "echoclip@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}