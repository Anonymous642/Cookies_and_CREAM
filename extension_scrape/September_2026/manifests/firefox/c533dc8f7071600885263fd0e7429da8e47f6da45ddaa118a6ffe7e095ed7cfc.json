{"manifest_version": 3, "name": "Tumblr Exporter", "description": "Back up any public Tumblr blog to a browseable local archive (CSV + HTML + media).", "version": "0.0.17", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "notifications", "idle"], "host_permissions": ["https://*.tumblr.com/*", "https://api.tumblr.com/*", "https://*.media.tumblr.com/*", "https://va.media.tumblr.com/*", "https://*.tumblr.co/*", "https://i.ytimg.com/*", "https://i.vimeocdn.com/*", "https://i1.sndcdn.com/*", "https://i.scdn.co/*", "https://f4.bcbits.com/*", "https://store.rxliuli.com/*"], "author": "rxliuli", "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "homepage_url": "https://store.rxliuli.com/extensions/tumblr-exporter", "browser_specific_settings": {"gecko": {"id": "tumblr-exporter@rxliuli.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}