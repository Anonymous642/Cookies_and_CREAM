{"manifest_version": 3, "name": "Element Screenshot", "version": "1.0.0", "description": "Elements Screenshot allows you to take a screenshot of an element from any web page.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["html2canvas.min.js", "content.js"], "all_frames": true}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "element-screenshot@skanie", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}