{"manifest_version": 2, "name": "Google Meet Transcriber", "version": "1.0", "description": "Captura legendas do Google Meet e envia para transcri\u00e7\u00e3o", "permissions": ["activeTab", "storage", "*://meet.google.com/*"], "browser_specific_settings": {"gecko": {"id": "meet-transcriber@exemplo.com", "strict_min_version": "142.0", "data_collection_permissions": {"types": ["technicalAndInteraction"], "comments": {"technicalAndInteraction": "Usado para manter sess\u00e3o com o servidor Django via cookies"}, "required": ["none"]}}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://meet.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png"}}, "icons": {"48": "icon48.png"}}