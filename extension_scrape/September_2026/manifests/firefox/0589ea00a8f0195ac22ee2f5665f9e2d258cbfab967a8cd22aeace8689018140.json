{"manifest_version": 3, "name": "Smack", "version": "1.2.2", "description": "Smack annoying posts out of your LinkedIn and X feeds. Click the \ud83d\udd90\ufe0f on any post. Uses each site's own hide feature.", "browser_specific_settings": {"gecko": {"id": "smack@anja.design", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Smack settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}