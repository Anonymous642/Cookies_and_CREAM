{"manifest_version": 3, "name": "CineSkip Pro", "description": "Automatically skip intros, recaps, and filler scenes on top streaming platforms to save your time and keep you in the action.", "version": "1.0.0", "author": "Lumina Labs", "permissions": ["storage", "scripting"], "host_permissions": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.primevideo.com/*", "https://*.hulu.com/*", "https://*.disneyplus.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cineskippro@luminalabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}