{"manifest_version": 3, "name": "Brightery Vault", "version": "2.5.3", "description": "Securely save, update and fill passwords and OTPs, scan authenticator QR codes, use smart site matching, and connect to Brightery Vault.", "homepage_url": "https://vault.brightery.com/", "action": {"default_popup": "popup.html", "default_title": "Brightery Vault"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://vault.brightery.com/*"], "commands": {"fill-otp": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Fill OTP for the current site"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "otpvault@brightery.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"], "optional": ["websiteContent"]}}}, "optional_host_permissions": ["http://*/*", "https://*/*"], "options_page": "options.html", "version_name": "2.5.3 OTP Context Menu & Preferred Match Fix"}