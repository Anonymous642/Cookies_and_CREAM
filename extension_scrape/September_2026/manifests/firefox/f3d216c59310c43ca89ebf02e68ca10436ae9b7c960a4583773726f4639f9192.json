{"manifest_version": 3, "name": "NookTunes", "version": "1.0.0", "description": "Plays hourly music from Animal Crossing games with weather and K.K. Slider support.", "permissions": ["storage", "alarms", "notifications", "tabs"], "background": {"scripts": ["lib/music_db.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "options_ui": {"page": "settings.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "nooktunes@ac-music.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}