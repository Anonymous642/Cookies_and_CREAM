{"manifest_version": 3, "name": "NoSpoilerYouTube", "version": "1.0.0", "description": "Hide potential spoilers from YouTube videos", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "extensions@lachlanallison.com"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["styles.css"], "js": ["content.js"]}]}