{"name": "GitLab conventional comments button", "version": "0.0.4", "manifest_version": 3, "description": "An extension to quickly add conventional comments in GitLab", "homepage_url": "https://conventionalcomments.org/", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "conventional-comments-button@synaos.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "host_permissions": ["https://gitlab.com/*", "https://gitlab.synaos.com/*"], "content_scripts": [{"matches": ["https://gitlab.com/*", "https://gitlab.synaos.com/*"], "js": ["src/inject/inject.js"], "css": ["src/inject/inject.css"], "run_at": "document_idle"}]}