{"manifest_version": 2, "name": "Meeting Auto Join (No Mic, No Cam)", "version": "1.1", "description": "Automatically joins Zoom and Google Meet meetings at a scheduled time with mic and camera off.", "homepage_url": "https://github.com/bondhon1/meeting-auto-join", "permissions": ["alarms", "tabs", "storage", "*://*.zoom.us/*", "*://meet.google.com/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.zoom.us/*", "*://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "meeting-auto-join@example.com", "data_collection_permissions": {"privacy_policy": "https://github.com/bondhon1/meeting-auto-join/blob/main/privacy-policy.md", "required": ["none"], "optional": [], "data_types": [], "data_usage": []}}}}