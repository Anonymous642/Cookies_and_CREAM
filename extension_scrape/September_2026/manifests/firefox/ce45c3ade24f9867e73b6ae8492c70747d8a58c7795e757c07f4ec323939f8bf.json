{"manifest_version": 3, "name": "Social Media Detoxer", "version": "1.0", "description": "Temporarily hide or limit social media feeds to reduce distractions.", "icons": {"128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "{550d609d-67e9-4520-8b19-49aaa014ab42}"}}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*"], "js": ["content.js"], "run_at": "document_start"}]}