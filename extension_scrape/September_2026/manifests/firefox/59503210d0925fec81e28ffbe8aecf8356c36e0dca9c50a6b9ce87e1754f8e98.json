{"manifest_version": 3, "name": "LinkedIn Scroll Normalizer", "version": "1.0.1", "description": "Normalizes LinkedIn scrolling behavior with a simple on/off toggle.", "permissions": ["storage"], "action": {"default_title": "LinkedIn Scroll Normalizer", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "zakaria-linkedin-scroll@addon", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}