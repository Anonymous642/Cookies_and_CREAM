{"manifest_version": 3, "name": "One Radar: Ad & Store Intelligence", "short_name": "One Radar", "description": "Spy any Shopify store & the Meta Ad Library: traffic, revenue, top products, apps, ad reach & spend. Save ads, and more.", "version": "1.0.2", "browser_specific_settings": {"gecko": {"id": "one-radar@one-radar.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent", "authenticationInfo"]}}}, "action": {"default_title": "One Radar", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.facebook.com/*", "https://*.one-radar.com/*", "https://data.similarweb.com/*", "https://cloudflare-dns.com/*", "https://cdn.shopify.com/*", "<all_urls>"], "optional_host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["https://www.facebook.com/ads/library/*"], "js": ["content-scripts/meta-injector.js"], "run_at": "document_start"}, {"matches": ["https://www.facebook.com/ads/library/*"], "js": ["src/meta-early-hook.js", "src/meta-intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.one-radar.com/*", "https://one-radar.com/*"], "js": ["content-scripts/auth-capture.js"], "run_at": "document_idle"}]}