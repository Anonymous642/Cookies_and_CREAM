{"manifest_version": 3, "name": "Roblox Radar", "version": "1.9", "description": "Find any player or game server instantly. Pro-tier discovery and real-time tracking. Optimized for speed and FPS.", "permissions": ["storage", "activeTab", "clipboardWrite", "alarms", "notifications"], "host_permissions": ["https://users.roblox.com/*", "https://presence.roblox.com/*", "https://games.roblox.com/*", "https://thumbnails.roblox.com/*", "https://friends.roblox.com/*", "https://groups.roblox.com/*"], "background": {"scripts": ["js/browser-polyfill.js", "js/background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "roblox-radar@yourdomain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}