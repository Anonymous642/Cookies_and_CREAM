{"manifest_version": 3, "name": "Go Incognito Pro", "version": "1.0.0", "description": "Opens the current tab in an incognito window, with options to remove from history and close the original tab.", "permissions": ["activeTab", "history", "contextMenus", "storage"], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Go Incognito"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"open-incognito": {"suggested_key": {"default": "Alt+I", "mac": "Alt+I"}, "description": "Open current tab in Incognito"}}, "browser_specific_settings": {"gecko": {"id": "goincognitopro@ext.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}