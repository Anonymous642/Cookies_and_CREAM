{"manifest_version": 3, "name": "TabFind", "version": "1.0.0", "description": "Search open Firefox tabs, switch to a result, close selected tabs, and copy filtered tab URLs.", "permissions": ["tabs", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open TabFind", "default_icon": "icon.svg"}, "options_ui": {"page": "index.html", "open_in_tab": true}, "icons": {"64": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "tabfind@local.tools", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}