{"manifest_version": 3, "name": "Mosslet", "version": "1.0.0", "description": "A small animated forest companion for the edge of your page. Walk, nest and wave without interrupting your work.", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "mosslet@page-poetry.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Mosslet", "default_popup": "popup.html", "default_icon": {"48": "icons/48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}, "background": {"scripts": ["lifecycle.js"]}}