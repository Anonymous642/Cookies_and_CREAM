{"manifest_version": 3, "name": "Website Health Checker", "version": "2.0.0", "description": "Analyze website speed, SEO, accessibility, security, privacy and mobile friendliness instantly.", "author": "BayHatter", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"rescan-page": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Re-scan current page"}}, "browser_specific_settings": {"gecko": {"id": "websitehealthchecker@bayhatter.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}