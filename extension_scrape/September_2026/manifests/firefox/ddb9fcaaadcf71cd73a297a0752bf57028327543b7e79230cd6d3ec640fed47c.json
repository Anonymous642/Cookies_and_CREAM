{"manifest_version": 3, "name": "LinkVault Quick Save", "version": "1.0.0", "description": "Speichere den aktuellen Link mit einem Klick in LinkVault.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "cookies", "contextMenus", "scripting"], "host_permissions": ["https://linkvault.eneabaechler.ch/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "linkvault-quicksave@eneabaechler.ch", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["bookmarksInfo"]}}}}