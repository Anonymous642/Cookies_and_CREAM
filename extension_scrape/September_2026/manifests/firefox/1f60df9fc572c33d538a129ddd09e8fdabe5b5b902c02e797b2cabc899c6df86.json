{"name": "Hacker Rangers Cyberattitude Reporter", "description": "Extension for submitting cyberattitudes", "version": "1.1", "manifest_version": 3, "action": {"default_popup": "index.html", "default_icon": "icons/favicon-150.png"}, "host_permissions": ["https://*.hackerrangers.com/*"], "background": {"service_worker": "./scripts/background.js", "scripts": ["./scripts/background.js"]}, "content_scripts": [{"matches": ["https://*.hackerrangers.com/*"], "js": ["./scripts/content.js"]}], "permissions": ["tabs", "activeTab", "scripting", "storage", "cookies", "downloads"], "browser_specific_settings": {"gecko": {"id": "hrcyberreporter@hackerrangers.com", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"], "authenticationInfo": {"description": "Stores access tokens to the Hacker Rangers platform.", "required": true, "dataTypes": ["Hacker Rangers access Tokens"]}, "browsingActivity": {"description": "Detects when the user is on a hacker rangers instance to enable simultaneous login.", "required": true, "dataTypes": ["URL matches for hackerrangers.com subdomains"]}, "websiteContent": {"description": "On the user's request can take a screenshot of the current open website to submit as a cyberattitude.", "required": true, "dataTypes": ["Webpage screenshot"]}}}}}