{"manifest_version": 3, "name": "Cortado", "version": "1.0.0", "description": "A minimal password manager. Your passwords stay on your machine.", "icons": {"32": "icons/32x32.png", "128": "icons/128x128.png"}, "action": {"default_title": "Cortado", "default_popup": "index.html?popup", "default_icon": {"32": "icons/32x32.png"}}, "permissions": ["storage", "activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "cortado@hunixcode.github.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}