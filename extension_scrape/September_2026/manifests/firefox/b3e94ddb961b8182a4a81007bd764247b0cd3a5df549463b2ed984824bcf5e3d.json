{"manifest_version": 2, "name": "Google Drive No Auto Download", "description": "Stop Google Drive from automatically downloading content from a download link.", "version": "1.0.4", "author": "Jonas Blackwood", "homepage_url": "https://github.com/tux-76/google-drive-no-auto-download", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["webRequest", "webRequestBlocking", "*://drive.google.com/uc*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@google-drive-no-auto-download.tux_76", "data_collection_permissions": {"required": ["none"]}}}}