{"manifest_version": 2, "name": "Gemini Remover", "version": "1.0", "description": "An addon that removes the gemini answer from google search.", "icons": {"16": "./icons/icon-16.png", "24": "./icons/icon-24.png", "48": "./icons/icon-48.png", "96": "./icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "compaszer.geminiremover@gmail.com", "strict_min_version": "58.0"}}, "applications": {"gecko": {"id": "compaszer.geminiremover@gmail.com"}}, "content_scripts": [{"matches": ["https://www.google.com/search?*"], "css": ["filter.css"], "run_at": "document_start"}]}