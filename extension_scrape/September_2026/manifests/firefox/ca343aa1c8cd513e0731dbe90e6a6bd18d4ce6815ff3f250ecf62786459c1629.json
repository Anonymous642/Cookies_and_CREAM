{"manifest_version": 3, "name": "Roll20 Bard", "version": "1.0.0", "description": "Ambient music manager for Roll20 with YouTube integration.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "roll20-bard-player@user-extension", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://app.roll20.net/editor*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "action": {"default_title": "Roll20 Bard", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://app.roll20.net/*"]}]}