{"manifest_version": 2, "name": "Blurry-subtitile", "description": "Extension that make your youtube subtitle blur.", "version": "1.1", "icons": {"64": "icons/icon.jpg"}, "permissions": ["storage"], "browser_action": {"default_icon": "icons/icon.jpg", "default_title": "Blurry Subtitle Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content_script.js"]}], "browser_specific_settings": {"gecko": {"id": "blury@thanachot.com", "data_collection_permissions": {"required": ["none"]}}}}