{"manifest_version": 2, "name": "FB Monitor SaaS", "version": "5.4", "description": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e2\u05dd \u05de\u05de\u05e9\u05e7 \u05e0\u05d9\u05d4\u05d5\u05dc \u05e4\u05e0\u05d9\u05de\u05d9", "permissions": ["storage", "tabs", "https://*.facebook.com/*", "https://*.make.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "content_scripts": [{"matches": ["*://*.facebook.com/groups/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "fbmonitor-saas@moshiktm1994.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["websiteContent"], "usage": "The extension reads text from Facebook groups to filter posts based on user keywords."}}}}