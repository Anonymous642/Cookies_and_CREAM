{"manifest_version": 3, "name": "Old Reddit Comment GIF Downloader", "version": "1.0.0", "description": "Adds a download button next to old.reddit comments with GIFs inside them.", "browser_specific_settings": {"gecko": {"id": "oldreddit-gif-downloader@quix.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage"], "host_permissions": ["*://old.reddit.com/*", "*://np.reddit.com/*", "*://*.reddit.com/*", "*://*.giphy.com/*", "*://*.redd.it/*", "*://*.imgur.com/*", "*://*.tenor.com/*", "*://*.gfycat.com/*", "*://*.redgifs.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://old.reddit.com/*", "*://np.reddit.com/*", "*://*.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "Old Reddit GIF Downloader", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}