{"manifest_version": 2, "name": "Skannly: URL & Phishing Scanner", "version": "1.0.1", "description": "Skannly protects you from phishing, scams, and malicious websites in real-time with the power of community.", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["<all_urls>", "activeTab", "storage", "contextMenus", "tabs", "webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "skannly@skannly.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}, "browser_action": {"default_popup": "popup.html", "default_title": "Skannly - URL Threat Detection", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}]}