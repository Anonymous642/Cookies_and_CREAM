{"manifest_version": 3, "name": "Debug Collector", "version": "0.1.0", "description": "Collects console logs and WebRTC stats on demand.", "action": {"default_title": "Collect Error", "default_popup": "popup.html"}, "permissions": ["activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["pageScript.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "debug-collector@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}