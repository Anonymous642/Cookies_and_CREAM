{"manifest_version": 2, "name": "PageNote", "version": "0.1.0", "description": "Attach notes to specific places on web pages and revisit them later.", "homepage_url": "https://example.com/pagenote", "author": "Gareth", "icons": {"48": "icons/pagenote.svg", "96": "icons/pagenote.svg"}, "permissions": ["contextMenus", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pagenote@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}