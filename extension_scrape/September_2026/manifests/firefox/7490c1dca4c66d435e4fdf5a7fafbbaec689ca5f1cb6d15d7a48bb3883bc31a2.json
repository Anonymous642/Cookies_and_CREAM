{"manifest_version": 3, "name": "Language Learning Assistant", "version": "1.0", "description": "Replace English words with words from your target language to help you learn through context", "browser_specific_settings": {"gecko": {"id": "language-learning-assistant@example.com"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*/*", "https://openrouter.ai/api/*"], "externally_connectable": {"matches": ["https://openrouter.ai/*"]}, "background": {"scripts": ["src/background.js"]}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Language Learning", "default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"]}]}