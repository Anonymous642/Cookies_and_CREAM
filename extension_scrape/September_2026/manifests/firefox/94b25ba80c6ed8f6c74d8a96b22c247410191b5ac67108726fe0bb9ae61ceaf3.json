{"manifest_version": 3, "name": "Lens URL Safety Checker", "version": "1.7", "description": "Checks URL safety and provides visual feedback.", "permissions": ["storage", "activeTab", "tabs", "contextMenus", "notifications", "alarms"], "host_permissions": ["https://127.0.0.1:62873/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "preferred_environment": ["service_worker", "document"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "lens-url-safety-checker@pahilabs.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}