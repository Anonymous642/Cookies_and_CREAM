{"manifest_version": 3, "name": "Tuxify", "version": "1.0", "description": "Adds Tux to every Youtube thumbnail ", "icons": {"48": "icons/tux-square.png"}, "browser_specific_settings": {"gecko": {"id": "tux@blablaymousy.org", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["icons/tux-square.png"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["Tuxify.js"], "css": ["tuxify.css"]}]}