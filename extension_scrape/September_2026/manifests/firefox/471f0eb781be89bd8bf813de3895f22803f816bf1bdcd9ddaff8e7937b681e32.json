{"manifest_version": 3, "name": "SafeBrowse", "description": "Warns users before opening unsafe or phishing websites using a Cloudflare Worker verdict, with Go Back / Proceed Once / Always Allow options.", "version": "1.0.3", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options/options.html"}, "browser_specific_settings": {"gecko": {"id": "safebrowse@rkabanda.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}