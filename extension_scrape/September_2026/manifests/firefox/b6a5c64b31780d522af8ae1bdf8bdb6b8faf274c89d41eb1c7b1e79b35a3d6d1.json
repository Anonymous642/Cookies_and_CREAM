{"manifest_version": 2, "name": "Web Rhythm Recorder", "version": "1.0", "description": "Record audio played in the page and convert short captures into loopable beats for quick remixing.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>", "notifications"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Web Rhythm Recorder", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "webrhythm@example.com"}}}