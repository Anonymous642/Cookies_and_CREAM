{"name": "Location Guard Revived", "description": "Hide your geographic location from websites.", "author": "Gabe Lichten", "homepage_url": "https://github.com/glichten/location-guard", "icons": {"16": "images/pin_16.png", "32": "images/pin_32.png", "64": "images/pin_64.png", "128": "images/pin_128.png"}, "version": "2.7.1", "browser_specific_settings": {"gecko": {"id": "location-guard@glichten.github.io", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["http://*/*", "https://*/*", "storage", "webRequest", "webRequestBlocking"], "manifest_version": 2, "background": {"scripts": ["js/common.js", "js/main.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "page_action": {"default_icon": {"16": "images/pin_16.png", "19": "images/pin_19.png", "20": "images/pin_20.png", "32": "images/pin_32.png", "38": "images/pin_38.png", "40": "images/pin_40.png", "64": "images/pin_64.png"}, "default_popup": "popup.html", "default_title": "Location Guard Revived"}, "content_scripts": [{"js": ["js/common.js", "js/content/content.js"], "matches": ["<all_urls>"], "run_at": "document_start", "all_frames": true}]}