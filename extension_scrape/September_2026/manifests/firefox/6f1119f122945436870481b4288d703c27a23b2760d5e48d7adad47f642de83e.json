{"manifest_version": 3, "name": "CouponWala - Auto Coupon Finder", "version": "1.0.0", "description": "Automatically finds and applies the best coupon codes while you shop online. Save money instantly!", "browser_specific_settings": {"gecko": {"id": "couponwala@extension.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.myntra.com/*", "*://*.ajio.com/*", "*://*.nykaa.com/*", "*://*.meesho.com/*", "*://*.snapdeal.com/*", "*://*.paytmmall.com/*", "*://*.shopclues.com/*", "*://*.bigbasket.com/*", "*://*.blinkit.com/*", "*://*.zomato.com/*", "*://*.swiggy.com/*"], "js": ["content.js"]}], "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.myntra.com/*", "*://*.ajio.com/*", "*://*.nykaa.com/*", "*://*.meesho.com/*", "*://*.snapdeal.com/*", "*://*.paytmmall.com/*", "*://*.bigbasket.com/*", "*://*.blinkit.com/*", "*://*.zomato.com/*", "*://*.swiggy.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}