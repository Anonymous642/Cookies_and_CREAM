{"manifest_version": 2, "name": "StreamQR", "version": "1.1", "description": "Generate QR codes for YouTube videos with draggable display for streamers", "browser_specific_settings": {"gecko": {"id": "streamqr@yourname.com", "strict_min_version": "109.0"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "browser_action": {"default_popup": "popup.html", "default_title": "StreamQR - YouTube QR Generator", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}