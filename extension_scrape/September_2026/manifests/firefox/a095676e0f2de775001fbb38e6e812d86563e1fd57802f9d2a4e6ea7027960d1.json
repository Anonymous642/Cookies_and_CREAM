{"manifest_version": 2, "name": "WhirlTab", "version": "1.0.0", "description": "Spin through tabs with fluid gestures and quick shortcuts.", "browser_specific_settings": {"gecko": {"id": "whirltab@example.com", "strict_min_version": "102.0"}}, "icons": {"48": "icons/whirltab-48.png", "128": "icons/whirltab-128.png"}, "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "WhirlTab", "default_popup": "popup.html", "default_icon": {"48": "icons/whirltab-48.png", "128": "icons/whirltab-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"next-tab": {"suggested_key": {"default": "Alt+Shift+Right"}, "description": "Spin to next tab"}, "prev-tab": {"suggested_key": {"default": "Alt+Shift+Left"}, "description": "Spin to previous tab"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}