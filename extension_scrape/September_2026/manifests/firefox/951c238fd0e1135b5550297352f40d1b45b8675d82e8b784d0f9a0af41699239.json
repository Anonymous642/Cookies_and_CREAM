{"manifest_version": 3, "name": "Saysike - Shop Smarter", "description": "Save money and more with Saysike!", "version": "1.2.0", "icons": {"128": "icon-128.png"}, "permissions": ["tabs", "activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "extension@saysike.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Saysike Extension", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}