{"manifest_version": 3, "name": "FitGirl Repack Checker", "version": "0.0.2", "author": "nived@ohnoimded.com", "description": "Automatically checks if the game you are viewing on Steam, Epic Games, or GOG is available on FitGirl Repacks. For informational purposes only. The author does not endorse or take responsibility for piracy or any related activities.", "permissions": ["storage", "search"], "host_permissions": ["*://fitgirl-repacks.site/*", "*://store.steampowered.com/*", "*://store.epicgames.com/*", "*://www.gog.com/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["src/shared/constants.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["*://store.steampowered.com/app/*", "*://store.epicgames.com/*/p/*", "*://www.gog.com/en/game/*", "*://www.gog.com/game/*"], "js": ["src/shared/constants.js", "src/shared/icons.js", "src/shared/components.js", "src/content/content.js"], "css": ["src/content/styles.css"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://store.steampowered.com/*", "*://store.epicgames.com/*", "*://www.gog.com/*"]}], "browser_specific_settings": {"gecko": {"id": "fitgirl-checker@nived.ohnoimded.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}