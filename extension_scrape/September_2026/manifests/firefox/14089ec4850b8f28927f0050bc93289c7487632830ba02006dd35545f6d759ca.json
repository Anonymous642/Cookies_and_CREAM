{"manifest_version": 3, "name": "The Land RPG Roll20 Companion", "short_name": "Land Roll20", "version": "1.0.3", "description": "Sends character updates and rolls from The Land RPG Chaos Character Generator to Roll20 chat.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "scripting"], "host_permissions": ["https://thelandrpg.com/chaos/*", "https://www.thelandrpg.com/chaos/*", "https://app.roll20.net/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://thelandrpg.com/chaos/*", "https://www.thelandrpg.com/chaos/*"], "js": ["chaos-content.js"], "run_at": "document_start"}, {"matches": ["https://app.roll20.net/*"], "js": ["roll20-content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "the-land-rpg-roll20-companion@thelandrpg.com", "strict_min_version": "140.0", "strict_min_android_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}