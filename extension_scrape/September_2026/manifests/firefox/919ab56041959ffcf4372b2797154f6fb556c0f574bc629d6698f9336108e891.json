{"manifest_version": 2, "name": "Sidney's Citation Helper", "version": "1.3.2", "description": "Your professor doesn\u2019t grade like everyone else. Your citations shouldn\u2019t either. Runs only when clicked. Optional BYOK AI.", "permissions": ["activeTab", "storage", "clipboardWrite", "https://api.openai.com/*"], "browser_action": {"default_title": "Sidney's Citation Helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "sidneys-citation-helper@sidneys-citation-helper.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}