{"manifest_version": 3, "name": "Auto Scroll - Desktop & Mobile", "version": "1.2.1", "description": "Automatically scroll pages using separate settings for each website.", "browser_specific_settings": {"gecko": {"id": "auto-scroll@emir.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Auto Scroll", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}