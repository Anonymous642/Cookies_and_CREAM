{"manifest_version": 3, "name": "Darknessbrowser", "version": "2.0.0", "description": "The lights go out and you have to find the hidden box with your flashlight.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "icons": {"128": "icons/icon128.png"}, "background": {"page": "js/background.html"}, "action": {"default_title": "Flashlight Hunt", "default_popup": "popup/popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "css": ["style/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "flashlight-hunt@example.com", "data_collection_permissions": {"required": ["none"]}}}}