{"manifest_version": 2, "name": "Auto Refresher", "version": "1.0", "description": "Automatically refreshes the page at specified intervals within a time range.", "permissions": ["activeTab", "storage", "scripting", "tabs", "http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "auto-refresher@yourdomain.com", "strict_min_version": "60.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}]}