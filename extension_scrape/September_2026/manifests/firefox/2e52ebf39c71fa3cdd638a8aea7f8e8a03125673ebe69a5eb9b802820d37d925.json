{"manifest_version": 3, "name": "Reels Blocker", "version": "1.0.0", "description": "Block distracting content on Facebook and YouTube (especially Reels/Shorts and News Feed) to stay productive.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"], "optional": []}, "id": "reels-blocker-ks@extension"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-youtube.js"], "run_at": "document_start"}, {"matches": ["*://*.facebook.com/*"], "js": ["content-facebook.js"], "run_at": "document_start"}], "permissions": ["declarativeNetRequest", "storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "*://*.facebook.com/*"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["*://*.youtube.com/*", "*://*.facebook.com/*"]}]}