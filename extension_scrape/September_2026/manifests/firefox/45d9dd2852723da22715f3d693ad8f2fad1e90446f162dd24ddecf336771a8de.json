{"manifest_version": 3, "name": "Deadline Reminder", "version": "1.0.0", "description": "Never miss a due date. Set deadlines with split month/day/hour/minute inputs, get repeat notifications at configurable intervals, and stop reminders with one click. Data stays local, works offline.", "author": "Deadline Reminder Contributors", "homepage_url": "https://github.com/user/deadline-reminder", "permissions": ["storage", "alarms", "notifications", "downloads"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Deadline Reminder", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options/options.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "deadline-reminder@firefox.addons", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}