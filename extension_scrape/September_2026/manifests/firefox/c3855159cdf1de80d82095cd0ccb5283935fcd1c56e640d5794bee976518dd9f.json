{"manifest_version": 3, "name": "YouTube Video Rotator", "version": "1.0", "description": "Rotate YouTube videos on the page", "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "yt-rotator@saintdaprince.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}