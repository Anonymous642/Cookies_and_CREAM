{"manifest_version": 2, "name": "SPOT Collector", "short_name": "SPOT", "description": "Lets your signed-in SPOT portal read SAP PO design-time metadata from inside your network. Read-only, with no sign-in of its own.", "icons": {"16": "icons/spot-16.png", "32": "icons/spot-32.png", "48": "icons/spot-48.png", "96": "icons/spot-96.png", "128": "icons/spot-128.png"}, "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "spot-collector@tarento.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}}, "permissions": ["storage"], "optional_permissions": ["http://*/*", "https://*/*"], "background": {"page": "background.html", "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "SPOT Collector \u2014 paired portals and PO systems", "default_icon": {"16": "icons/spot-16.png", "32": "icons/spot-32.png"}}}