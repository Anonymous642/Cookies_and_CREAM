{"manifest_version": 3, "name": "Loupe v2", "version": "2.0", "homepage_url": "https://github.com/Francesco146/loupe/", "description": "Highlights occurrences of selected word in page.", "icons": {"96": "icons/loupe-96.png", "128": "icons/loupe-128.png", "256": "icons/loupe-256.png"}, "action": {"default_title": "Loupe v2", "default_icon": {"96": "icons/loupe-96.png", "128": "icons/loupe-128.png", "256": "icons/loupe-256.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["find", "storage"], "options_ui": {"page": "options/options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["loupe.js"]}], "browser_specific_settings": {"gecko": {"id": "@loupe-v2-extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}