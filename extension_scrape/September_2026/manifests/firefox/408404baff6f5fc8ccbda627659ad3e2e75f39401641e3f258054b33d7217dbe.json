{"manifest_version": 2, "name": "Readable Recipes", "description": "One click turns any recipe page into a clean reader view: ingredients, steps, and times. No popups, no life stories, no account.", "version": "0.9.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "https://api.readable.recipes/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}, "id": "{1f78ffd9-e1fe-47e9-87ee-2d1a8d8da6b7}"}}, "browser_action": {"theme_icons": [{"light": "icon/16dark.png", "dark": "icon/16.png", "size": 16}, {"light": "icon/32dark.png", "dark": "icon/32.png", "size": 32}], "default_title": "Readable Recipes", "default_popup": "popup.html"}, "page_action": {"default_icon": "icon/whisk.svg", "default_title": "Toggle Readable Recipes", "browser_style": false}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"]}