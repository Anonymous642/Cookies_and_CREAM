{"manifest_version": 3, "name": "QR Code Scanner", "version": "1.0", "description": "Markiere einen QR-Code auf einer beliebigen Webseite, um den Text oder Link sofort im Browser auszulesen und zu kopieren.", "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "qr-scanner@Martin-He.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "action": {"default_title": "QR Bereich ausw\u00e4hlen", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["style.css"], "js": ["jsQR.js", "content.js"]}]}