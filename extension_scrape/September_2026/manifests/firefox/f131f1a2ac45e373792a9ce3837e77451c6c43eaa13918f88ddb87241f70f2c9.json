{"manifest_version": 2, "name": "Task Manager", "version": "1.0.0", "description": "A Todoist-like task management extension", "permissions": ["storage", "notifications", "scripting"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "jenzcore1@gmail.com", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html"}, "content_security_policy": "script-src 'self'; object-src 'self';"}