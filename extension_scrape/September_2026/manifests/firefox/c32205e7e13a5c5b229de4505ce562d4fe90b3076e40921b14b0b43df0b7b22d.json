{"manifest_version": 3, "name": "wplace.live Map Style Override", "version": "1.2", "description": "Allows users to specify a custom map style JSON to override the default on wplace.live.", "permissions": ["webRequest", "webRequestBlocking", "webRequestFilterResponse", "storage"], "host_permissions": ["*://maps.wplace.live/*", "*://*.wplace.live/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Set Custom Map Style", "default_popup": "options.html"}, "browser_specific_settings": {"gecko": {"id": "wplace-style@defvs.dev"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}