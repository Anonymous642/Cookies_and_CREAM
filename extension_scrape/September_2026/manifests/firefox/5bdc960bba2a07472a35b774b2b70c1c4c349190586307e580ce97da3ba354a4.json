{"manifest_version": 3, "name": "Auto Markdown", "version": "1.0", "description": "Automatically converts Markdown-style text (**bold**, *italic*) into formatted HTML on any page. That's it.", "icons": {"128": "icon.png"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Auto Markdown"}, "permissions": ["scripting", "activeTab", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "obraddev-auto-markdown@example.com", "data_collection_permissions": {"required": ["none"]}}}}