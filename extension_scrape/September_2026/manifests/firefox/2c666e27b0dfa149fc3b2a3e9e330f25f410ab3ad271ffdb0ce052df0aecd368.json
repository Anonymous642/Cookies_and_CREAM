{"manifest_version": 3, "name": "YouTube Shorts AutoScroller", "version": "1.0", "description": "Automatically scrolls through YouTube Shorts for seamless viewing.", "permissions": ["scripting", "tabs"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Auto Shorts", "default_icon": {"48": "icon.png", "128": "icon.png"}}, "icons": {"48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "shorts-autoscroller@example.com", "strict_min_version": "109.0"}}}