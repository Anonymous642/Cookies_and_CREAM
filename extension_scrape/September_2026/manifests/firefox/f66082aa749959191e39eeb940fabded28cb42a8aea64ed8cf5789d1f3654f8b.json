{"manifest_version": 3, "name": "AudioLayr", "version": "1.0.23", "description": "Mute and unmute audio tabs instantly from one clean floating control panel.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open AudioLayr", "default_icon": {"16": "icons/Pulse/icon16.png", "32": "icons/Pulse/icon32.png"}}, "host_permissions": ["<all_urls>"], "icons": {"16": "icons/Pulse/icon16.png", "32": "icons/Pulse/icon32.png", "48": "icons/Pulse/icon48.png", "128": "icons/Pulse/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/Pulse/Pulse.png", "icons/Pulse/icon16.png", "icons/Pulse/icon32.png", "icons/Pulse/icon48.png", "icons/Pulse/icon64.png", "icons/Pulse/icon128.png", "icons/Cipher/Cipher.png", "icons/Vice/Vice.png", "icons/Eclipse/Eclipse.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "audiolayr@overlayr.tools", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}