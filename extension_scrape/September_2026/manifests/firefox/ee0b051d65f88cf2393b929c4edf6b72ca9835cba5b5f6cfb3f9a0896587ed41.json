{"manifest_version": 3, "name": "Tubi Downloader for Firefox", "version": "1.3.3", "description": "Downloads supported DRM-free Tubi HLS streams in Firefox, with audio/video muxing and automatic whole-season queues.", "author": "monjanse7", "permissions": ["downloads", "storage", "tabs", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["common/hls.js", "common/dash.js", "common/tsmux.js", "common/season.js", "background.js"]}, "action": {"default_title": "Tubi Downloader for Firefox", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "tubi-firefox-downloader@monjanse7", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://tubitv.com/*", "*://*.tubitv.com/*", "*://tubi.tv/*", "*://*.tubi.tv/*"], "js": ["common/season.js", "season-content.js"], "run_at": "document_idle"}], "incognito": "not_allowed"}