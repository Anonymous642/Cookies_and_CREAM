{"manifest_version": 3, "name": "YouTube Reactions Button", "version": "1.11", "description": "Adds a Reacts button that shows reaction videos to the video you're watching.", "browser_specific_settings": {"gecko": {"id": "youtube-reactions@reactionfinder.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "YouTube Reactions Button", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://reactionfinder.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}]}