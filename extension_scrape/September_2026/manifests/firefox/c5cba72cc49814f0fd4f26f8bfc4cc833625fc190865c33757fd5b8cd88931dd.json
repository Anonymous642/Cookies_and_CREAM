{"manifest_version": 2, "name": "NegativeSpace", "version": "1.0.0", "description": "Th\u00eam 'Ch\u1ebf \u0111\u1ed9 \u00e2m b\u1ea3n' cho m\u1ecdi \u1ea3nh tr\u00ean trang (invert filter) v\u1edbi n\u00fat b\u1eadt/t\u1eaft.", "permissions": ["activeTab", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "NegativeSpace"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "@negativespace", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}