{"manifest_version": 3, "name": "AI Slop Inspector", "version": "0.4.0", "description": "Check webpages for common AI writing and design patterns. Click a match to find it on the page. Scans stay in your browser.", "permissions": ["activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "browser_specific_settings": {"gecko": {"id": "pattern-lens@patochaos.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Inspect this page with AI Slop Inspector", "default_popup": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Open AI Slop Inspector"}}}