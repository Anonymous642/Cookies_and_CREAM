{"manifest_version": 3, "name": "SlopSieve", "description": "Flag bots, AI slop, and low-quality posts on X, Reddit, Hacker News, Bluesky, and LinkedIn \u2014 scoring runs fully on your device.", "version": "0.4.22", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "alarms", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://x.com/*", "*://*.reddit.com/*", "*://news.ycombinator.com/*", "https://bsky.app/*", "*://*.linkedin.com/*", "https://slopsieve.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "optional_host_permissions": ["https://api.slopsieve.com/*", "<all_urls>"], "background": {"scripts": ["lib/verdict.js", "heuristics.js", "account-model.js", "lib/ort/ort.wasm.min.js", "lib/bpe-tokenizer.js", "lib/slop-text-model-onnx.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "SlopSieve", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "web_accessible_resources": [{"resources": ["model.json", "models/slopdetect-minilm-v3/meta.json", "models/slopdetect-minilm-v3/vocab.json", "models/slopdetect-minilm-v3/merges.txt", "lib/emoji-demojize.json", "lib/ort/ort-wasm-simd.wasm", "lib/wasm/keyring.wasm", "benchmark/benchmark.html", "benchmark/benchmark.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://x.com/*"], "run_at": "document_start", "js": ["lib/verdict.js", "ml-feature-distributions.js", "content-scripts/badges.js", "content-scripts/capture.js"]}, {"matches": ["https://x.com/*"], "run_at": "document_start", "js": ["content-scripts/interceptor.js"], "world": "MAIN"}, {"matches": ["*://*.reddit.com/*"], "run_at": "document_idle", "js": ["lib/verdict.js", "lib/badge-surface.js", "lib/reddit-extract.js", "content-scripts/reddit-capture.js", "content-scripts/reddit-badges.js"]}, {"matches": ["*://news.ycombinator.com/*"], "run_at": "docu