{"manifest_version": 3, "name": "Rapid Indexer - Link Indexing Service", "version": "1.2.2", "description": "Submit URLs to Rapid Indexer from your browser. Index pages on Google, Bing, and Brave, and track task status.", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["https://rapid-indexer.com/*"], "action": {"default_popup": "popup.html", "default_title": "Rapid Indexer"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "rapid-indexer@rapid-indexer.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}