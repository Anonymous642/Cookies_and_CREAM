{"manifest_version": 2, "name": "Color Palette Extractor", "version": "1.3", "description": "Extract dominant colors from the current webpage and generate a clean color palette with HEX codes.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs"], "browser_action": {"default_title": "Color Palette Extractor", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@Color-Palette-Extractor", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}