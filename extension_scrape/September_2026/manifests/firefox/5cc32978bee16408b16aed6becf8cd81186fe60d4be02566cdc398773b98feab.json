{"manifest_version": 3, "name": "SERP Garuda \u2013 SERP Counter", "version": "1.0.0", "description": "SERP Garuda is a SERP counter that shows the true organic rank of Google results, skipping ads, map packs and AI Overviews.", "permissions": ["storage"], "host_permissions": ["https://www.google.com/search*", "https://www.google.co.in/search*", "https://www.google.co.uk/search*", "https://www.google.ca/search*", "https://www.google.com.au/search*", "https://www.google.de/search*", "https://www.google.fr/search*"], "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.co.in/search*", "https://www.google.co.uk/search*", "https://www.google.ca/search*", "https://www.google.com.au/search*", "https://www.google.de/search*", "https://www.google.fr/search*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_title": "SERP Garuda"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "serp-garuda@serp.one", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}