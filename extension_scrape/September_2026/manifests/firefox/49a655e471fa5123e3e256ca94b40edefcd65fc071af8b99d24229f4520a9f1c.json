{"manifest_version": 3, "name": "Dark Mode Bang - Universal Dark Theme", "version": "1.0.0", "description": "Transform any website into dark mode automagically", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Dark Mode Bang"}, "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Cycle through dark mode states"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "darkmodebang@synthralabs.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}