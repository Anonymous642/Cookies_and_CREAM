{"manifest_version": 2, "name": "URL Blocker", "version": "1.0", "description": "Block specific URLs with easy toggle controls", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "url-blocker@example.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}