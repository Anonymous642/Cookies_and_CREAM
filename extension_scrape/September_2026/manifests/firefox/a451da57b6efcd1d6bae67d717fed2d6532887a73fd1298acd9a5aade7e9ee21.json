{"manifest_version": 2, "name": "gdluxx-extension", "description": "companion browser extension for gdluxx, a self-hosted browser GUI for gallery-dl", "version": "1.10.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "notifications", "scripting", "alarms"], "optional_permissions": ["<all_urls>", "cookies"], "browser_specific_settings": {"gecko": {"id": "gdluxx@gdluxx.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "gdluxx Overlay", "default_popup": "popup.html"}, "content_scripts": []}