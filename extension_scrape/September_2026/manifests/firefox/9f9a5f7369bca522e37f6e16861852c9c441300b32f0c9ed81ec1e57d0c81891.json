{"manifest_version": 3, "name": "Facebook Pending Posts Supabase Helper", "version": "0.3.1", "description": "Shows Supabase moderation history on Facebook group pending posts.", "permissions": ["storage"], "host_permissions": ["https://www.facebook.com/*", "https://*.supabase.co/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.facebook.com/groups/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "nestora-fb-mod-public@nestora.local", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}