{"manifest_version": 2, "name": "PageBeat", "version": "1.0.0", "description": "T\u1ea1o nh\u1ecbp \u0111i\u1ec7u d\u1ef1a tr\u00ean m\u00e0u s\u1eafc & n\u1ed9i dung trang (nh\u1ecbp nhanh/nh\u1ecbp ch\u1eadm).", "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "PageBeat"}, "browser_specific_settings": {"gecko": {"id": "pagebeat@example.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}