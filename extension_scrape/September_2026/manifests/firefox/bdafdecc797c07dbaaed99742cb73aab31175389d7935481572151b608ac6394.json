{"manifest_version": 2, "name": "Spotify Ad Muter", "version": "1.0.0", "description": "Automatically mutes Spotify tab when ads are playing and unmutes when music resumes", "author": "Power to the people", "permissions": ["tabs"], "content_scripts": [{"matches": ["*://open.spotify.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "spotify-ad-muter@power-to-the-people", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}