{"manifest_version": 2, "name": "DealHunter - Best US Retail Deals", "description": "Instantly compare prices across Amazon, Walmart, Target and more. Find the best deal in seconds.", "version": "2.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["compat.js", "background.js"], "persistent": false}, "permissions": ["tabs", "storage", "identity", "https://serpapi.com/*", "https://dealhunter-backend.vercel.app/*"], "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "dealhunter@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}