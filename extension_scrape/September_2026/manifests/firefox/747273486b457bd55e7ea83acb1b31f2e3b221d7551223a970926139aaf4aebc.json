{"manifest_version": 3, "name": "GoLive - YouTube & Twitch Tracker", "version": "1.0.0", "description": "Track your favorite YouTube and Twitch channels and get notified when they go live", "permissions": ["storage", "notifications", "alarms", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://www.twitch.tv/*", "https://twitch.tv/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "GoLive"}, "options_page": "settings.html", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{b7e8a1c4-3d25-4b12-9f8d-2d9e8c7a4e1b}", "strict_min_version": "126.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*", "https://twitch.tv/*"], "js": ["content.js"], "css": ["content.css"]}]}