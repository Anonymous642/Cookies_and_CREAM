{"manifest_version": 2, "name": "MeowMail \u2014 Disposable Email", "description": "Generate temporary email addresses instantly. No signup, no tracking.", "version": "1.0.0", "icons": {"16": "/icons/icon-16.png", "32": "/icons/icon-32.png", "48": "/icons/icon-48.png", "128": "/icons/icon-128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "clipboardWrite", "https://meowmail.in/*", "https://api.meowmail.in/*"], "browser_specific_settings": {"gecko": {"id": "extension@meowmail.in", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Open MeowMail popup"}, "copy-address": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy current MeowMail address to clipboard"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "MeowMail", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}