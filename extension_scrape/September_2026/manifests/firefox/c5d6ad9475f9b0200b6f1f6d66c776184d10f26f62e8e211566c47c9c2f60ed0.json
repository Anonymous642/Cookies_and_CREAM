{"manifest_version": 3, "name": "IMPACT TimeLog Extension", "version": "1.0.0", "description": "IMPACT Commerce helper for TimeLog invoicing - search, highlight and bulk-select time registrations.", "homepage_url": "https://impactcommerce.com", "browser_specific_settings": {"gecko": {"id": "bss@impactcommerce.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://app.timelog.com/*", "https://app3.timelog.com/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "IMPACT TimeLog Extension", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["impact_background.js"]}, "content_scripts": [{"matches": ["https://app.timelog.com/*", "https://app3.timelog.com/*"], "css": ["impact_styles.css"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://app.timelog.com/*", "https://app3.timelog.com/*"], "js": ["impact_content.js"], "run_at": "document_idle", "all_frames": true}]}