{"manifest_version": 3, "name": "DOM Scraper Pro - No Backend Scraper", "version": "1.0.1", "description": "Scrape DOM data, tables, links, images, or custom elements directly in Firefox. Instant preview & export to CSV or JSON without any server backend.", "author": "Antigravity", "browser_specific_settings": {"gecko": {"id": "dom-scraper-pro@abdulbasit.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon-64.png", "default_title": "DOM Scraper Pro"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}