{"manifest_version": 3, "name": "SYNTEX Privacy Shield", "version": "1.2.0", "browser_specific_settings": {"gecko": {"id": "contact@syntexsecurity.com", "strict_min_version": "121.0"}}, "description": "Advanced privacy protection and threat detection for browsers", "permissions": ["storage", "webRequest", "webRequestBlocking", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "background": {"page": "background/background.html"}, "action": {"default_popup": "popup/popup.html", "default_title": "SYNTEX Privacy Shield"}, "icons": {"16": "popup/icons/icon16.png", "48": "popup/icons/icon48.png", "128": "popup/icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}