{"manifest_version": 3, "name": "Omni Deck", "version": "0.1.0", "description": "Custom new tab with bookmarks, widgets, and editable layout", "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["bookmarks", "topSites", "sessions", "storage"], "host_permissions": ["https://api.open-meteo.com/*", "http://localhost/*", "http://127.0.0.1/*"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "omni-deck@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo"]}}}}