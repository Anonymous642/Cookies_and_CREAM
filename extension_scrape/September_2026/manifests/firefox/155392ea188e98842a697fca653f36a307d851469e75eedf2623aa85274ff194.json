{"manifest_version": 3, "name": "Drillr \u2014 Cr\u00e9er une candidature", "short_name": "Drillr", "version": "0.1.25", "description": "Depuis une offre d'emploi, cr\u00e9e la candidature dans ton compte Drillr et g\u00e9n\u00e8re la lettre de motivation.", "action": {"default_popup": "popup.html", "default_title": "Drillr", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "scripting", "identity"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "drillr-extension@drillr.eu", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"]}}}}