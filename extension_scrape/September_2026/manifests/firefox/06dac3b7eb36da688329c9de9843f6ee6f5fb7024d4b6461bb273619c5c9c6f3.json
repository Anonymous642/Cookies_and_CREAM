{"manifest_version": 3, "name": "PixelPerfect", "version": "1.1.0", "description": "Overlay design comps on any page: drag, scale, opacity, and blend modes for pixel-perfect implementation.", "browser_specific_settings": {"gecko": {"id": "pixelperfect@saroj.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "PixelPerfect - click to toggle the panel", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Toggle the PixelPerfect panel"}, "toggle-visibility": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Show / hide the overlay"}, "toggle-lock": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Lock / unlock the overlay"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}