{"manifest_version": 3, "name": "Letterboxd Single-Liner Blocker", "version": "1.4.0", "description": "Hides short, low-effort reviews on Letterboxd. Configurable threshold (characters, words, or sentences).", "permissions": ["storage"], "host_permissions": ["*://letterboxd.com/*", "*://*.letterboxd.com/*"], "content_scripts": [{"matches": ["*://letterboxd.com/*", "*://*.letterboxd.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Single-Liner Blocker"}, "browser_specific_settings": {"gecko": {"id": "letterboxd-singleliner-blocker@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}