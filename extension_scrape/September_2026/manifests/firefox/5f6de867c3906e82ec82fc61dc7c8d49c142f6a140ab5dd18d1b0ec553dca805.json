{"manifest_version": 2, "name": "Telescopify", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "{fa6ce372-264b-4421-a503-7fb72ce170d8}", "data_collection_permissions": {"required": ["none"]}}}, "description": "Adds quick navigation in open tabs and interactive elements on page. Inspired by Telescope plugin for vim/nvim.", "icons": {"48": "icons/telescopify-48.png", "128": "icons/telescopify-128.png"}, "permissions": ["<all_urls>", "tabs", "activeTab", "downloads"], "background": {"scripts": ["telescopify.js"], "persistent": true, "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_injector.js"], "run_at": "document_start"}], "web_accessible_resources": ["popup.html", "popup.js", "popup.css", "poi.js"]}