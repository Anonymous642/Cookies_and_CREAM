{"manifest_version": 3, "name": "Click to FreeTube", "description": "Simple and lightweight extension that opens the current YouTube video/short in FreeTube.", "version": "1.1", "developer": {"name": "Andrei Ionel (thetechdog)", "url": "https://github.com/thetechdog/click-to-freetube/"}, "permissions": ["activeTab", "notifications"], "action": {"default_icon": {"32": "icons/c2ft.svg"}, "default_title": "Click to watch in FreeTube"}, "browser_specific_settings": {"gecko": {"id": "click2freetube@thetechdog", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/c2ft.svg", "64": "icons/c2ft.svg"}, "background": {"scripts": ["extension.js"]}}