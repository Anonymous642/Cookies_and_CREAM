{"manifest_version": 3, "name": "GitHub Helpers", "version": "1.0.0", "description": "Quality-of-life improvements for GitHub \u2014 toggleable, lightweight, and unobtrusive.", "permissions": ["storage", "tabs", "clipboardWrite"], "host_permissions": ["https://api.github.com/*", "https://github.com/login/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["shared/compat.js", "background/service-worker.js"], "service_worker": "background/service-worker.js"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["shared/compat.js", "shared/registry.js", "shared/feature-config.js", "shared/github-utils.js", "features/back-to-top/back-to-top.js", "features/sticky-tabs/sticky-tabs.js", "features/pr-quick-review/pr-quick-review.js", "features/image-viewer/image-viewer.js", "features/markdown-table-builder/markdown-table-builder.js", "vendor/marked.min.js", "features/extended-markdown-tables/extended-markdown-tables.js", "features/sso-monitor/sso-monitor.js", "features/pr-comment-resolver/pr-comment-resolver.js", "shared/init.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "github-helpers@github-helpers", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}