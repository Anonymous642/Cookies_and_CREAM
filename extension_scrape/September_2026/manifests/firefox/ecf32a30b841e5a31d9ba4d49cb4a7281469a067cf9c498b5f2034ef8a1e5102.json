{"manifest_version": 2, "name": "Lichess Pairing Filter", "version": "2.0", "description": "Configurable quick-pairing time control filter", "browser_specific_settings": {"gecko": {"id": "lichess-filter@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "icons": {"16": "icons/pawn-16.png", "32": "icons/pawn-32.png", "48": "icons/pawn-48.png", "128": "icons/pawn-128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Pairing Filter Settings", "default_icon": {"16": "icons/pawn-16.png", "32": "icons/pawn-32.png", "48": "icons/pawn-48.png"}}, "content_scripts": [{"matches": ["*://lichess.org/*"], "js": ["content.js"], "run_at": "document_idle"}]}