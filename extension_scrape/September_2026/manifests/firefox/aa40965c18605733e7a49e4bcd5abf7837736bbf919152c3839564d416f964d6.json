{"manifest_version": 3, "name": "Secure History Lock", "version": "1.5.2", "description": "Password-protect access to your browser history across all major browsers.", "permissions": ["history", "storage"], "action": {"default_title": "Open Secure History Lock"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+H", "mac": "Alt+H"}, "description": "Open Secure History Lock"}}, "chrome_url_overrides": {"history": "history.html"}, "browser_specific_settings": {"gecko": {"id": "secure-history-lock@local.extension", "strict_min_version": "109.0"}}}