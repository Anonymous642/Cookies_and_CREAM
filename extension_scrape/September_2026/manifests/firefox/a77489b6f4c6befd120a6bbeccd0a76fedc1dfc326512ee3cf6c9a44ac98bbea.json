{"manifest_version": 3, "name": "YT Cinema & Blackout", "version": "1.2.0", "description": "Cinema mode that hides every YouTube distraction, plus audio-only blackout with sleep timer. CSS-only resize \u2014 built for tiling window managers.", "author": "HitCreate", "homepage_url": "https://github.com/hitcreate", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "yt-cinema-mode@hitcreate.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"toggle-cinema": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Toggle cinema mode on current YouTube tab"}, "toggle-blackout": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Toggle blackout (audio-only black screen) on current YouTube tab"}}, "action": {"default_title": "Toggle Cinema Mode", "default_icon": {"48": "icons/icon-48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}}