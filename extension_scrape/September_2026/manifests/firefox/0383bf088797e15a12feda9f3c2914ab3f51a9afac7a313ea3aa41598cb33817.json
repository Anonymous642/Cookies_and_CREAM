{"manifest_version": 3, "name": "CIDR Subnet Inspector", "version": "1.2.0", "description": "Affiche le calcul d'un sous-r\u00e9seau (r\u00e9seau, broadcast, plage, masque) au survol ou via le menu contextuel sur toute notation CIDR pr\u00e9sente dans une page.", "author": "LAB-INF0", "homepage_url": "https://github.com/LAB-INF0/.githLAB", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "storage", "notifications", "clipboardWrite", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/cidr.js", "background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/cidr.js", "lib/render.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Calculateur CIDR", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "cidr-subnet-inspector@lab-inf0.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}