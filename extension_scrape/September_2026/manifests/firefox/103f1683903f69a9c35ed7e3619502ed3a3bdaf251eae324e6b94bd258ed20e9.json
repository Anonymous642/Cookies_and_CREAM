{"manifest_version": 3, "name": "Translate to Tab", "version": "1.0.2", "description": "Instant translations in a new tab. Right-click text to translate in a dedicated tab, not a cramped popup.", "browser_specific_settings": {"gecko": {"id": "open-in-tab-translate@ejfn.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "storage"], "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "action": {"default_title": "Translate to Tab"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}