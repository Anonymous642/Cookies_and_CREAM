{"manifest_version": 3, "name": "Smart Bookmarks", "version": "0.1.1", "description": "Read, bookmark, and summarize web pages using local LM Studio", "permissions": ["storage", "activeTab", "scripting", "tabs", "management"], "host_permissions": ["<all_urls>", "https://*.firebaseio.com/*", "https://*.firebaseapp.com/*", "https://*.googleapis.com/*"], "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "smart-bookmarks@example.com", "data_collection_permissions": {"required": ["none"]}}}}