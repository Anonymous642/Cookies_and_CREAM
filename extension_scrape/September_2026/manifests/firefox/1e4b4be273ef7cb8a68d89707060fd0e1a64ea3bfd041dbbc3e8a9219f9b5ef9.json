{"manifest_version": 3, "name": "Inspeck \u2014 Measure, Inspect & Edit", "version": "1.0", "description": "Measure, inspect & edit any live web page \u2014 sizes, spacing, CSS, type & color. No DevTools, runs 100% in your browser.", "permissions": ["activeTab", "scripting", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "Inspeck - Measure anything"}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle Inspeck on this page"}}, "browser_specific_settings": {"gecko": {"id": "inspeck@inspeck.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}