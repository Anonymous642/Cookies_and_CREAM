{"manifest_version": 3, "name": "XO Downloader Integration Module", "version": "1.2.0", "author": "LeaF <lord.grim.sh@gmail.com>", "description": "Seamless high-speed download interception and browser integration for XO Downloader Desktop App.", "permissions": ["downloads", "cookies", "contextMenus", "storage", "activeTab", "notifications"], "host_permissions": ["http://127.0.0.1:23859/*", "http://localhost:23859/*", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "xo-downloader@leaf.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "XO Downloader", "default_icon": {"32": "icons/icon32.png", "128": "icons/icon128.png"}}, "icons": {"32": "icons/icon32.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}