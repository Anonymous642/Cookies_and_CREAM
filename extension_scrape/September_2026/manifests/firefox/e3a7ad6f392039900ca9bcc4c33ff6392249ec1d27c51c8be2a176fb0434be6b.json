{"manifest_version": 2, "name": "IFrame changer", "version": "1.1.0", "description": "Simple changer on IFrame.", "icons": {"16": "icons/img.png", "32": "icons/img.png", "48": "icons/img.png", "128": "icons/img.png"}, "permissions": ["storage", "webRequest", "webRequestBlocking", "webNavigation", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/img.png", "32": "icons/img.png", "48": "icons/img.png", "128": "icons/img.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "iframe-changer@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}