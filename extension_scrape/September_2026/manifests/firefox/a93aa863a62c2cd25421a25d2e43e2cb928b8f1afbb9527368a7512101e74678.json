{"manifest_version": 3, "name": "Marketplace Auto-Reply (asistido)", "version": "0.2.0", "description": "Detecta mensajes nuevos en Facebook Marketplace y arma un borrador de respuesta con IA, una configuraci\u00f3n por cuenta (container de Firefox). No env\u00eda solo \u2014 el humano confirma.", "browser_specific_settings": {"gecko": {"id": "marketplace-autoreply@local", "data_collection_permissions": {"required": ["personalCommunications", "personallyIdentifyingInfo"]}}}, "permissions": ["storage", "tabs", "contextualIdentities"], "host_permissions": ["https://www.messenger.com/*", "https://www.facebook.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.messenger.com/*", "https://www.facebook.com/marketplace/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}}