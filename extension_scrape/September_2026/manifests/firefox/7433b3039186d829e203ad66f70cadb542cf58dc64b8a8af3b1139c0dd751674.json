{"manifest_version": 3, "name": "VoicePresso AI Writing Assistant", "version": "2.0.1", "description": "VoicePresso AI Writing Assistant: Process voice or text inside any text field, process static text on pages, Save prompts for quick access, organize results by project.", "permissions": ["activeTab", "storage", "tabs", "scripting", "alarms", "clipboardRead", "clipboardWrite", "webNavigation", "contextMenus"], "host_permissions": ["<all_urls>", "https://*.voicepresso.com/*", "https://voicepresso.com/*", "https://*.paddle.com/*", "https://generativelanguage.googleapis.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "content.js"], "css": ["style.css"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/voicepresso-logo-16.png", "48": "icons/voicepresso-logo-48.png", "128": "icons/voicepresso-logo-128.png"}}, "background": {"scripts": ["lib/browser-polyfill.js", "background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Start/stop speech recognition"}, "toggle-grammar": {"suggested_key": {"default": "Ctrl+Shift+G"}, "description": "Toggle grammar correction (BYOK)"}, "toggle-gemini-premium": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Toggle Gemini processing (Premium)"}}, "web_accessible_resources": [{"resources": ["auth.html", "options.html", "icons/*", "auth.js", "languages.js", "storage-manager.js", "manager.html", "manager.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/voicepresso-logo-16.png", "48": "icons/voicepresso-logo-48.png", "128": "icons/voicepresso-logo-128.png"}, "browser_specific_settings": {"gecko": {"id": "voicepresso@voicepresso.com", "data_collection_permissions": {"required": ["none"]}}}}