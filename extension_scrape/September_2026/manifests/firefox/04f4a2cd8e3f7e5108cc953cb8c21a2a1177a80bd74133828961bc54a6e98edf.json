{"manifest_version": 2, "name": "AdFill Pro", "version": "1.1.1", "description": "Remplissage automatique d'annonces pour Facebook Marketplace et Avito Maroc", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "downloads", "https://*.facebook.com/*", "https://*.avito.ma/*", "https://*.unsplash.com/*", "https://images.unsplash.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup.html", "default_title": "AdFill Pro", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "adfill-pro@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}}