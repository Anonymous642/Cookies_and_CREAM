{"manifest_version": 2, "name": "NoSub Helper", "version": "1.1", "description": "Subtitle display preferences for Crunchyroll with an in-player None option.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.crunchyroll.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["tabs", "webRequest", "webRequestBlocking", "*://*.crunchyroll.com/*", "*://*.crunchyrollcdn.com/*", "*://beta-api.crunchyroll.com/*", "*://cr-api.crunchyroll.com/*"], "browser_specific_settings": {"gecko": {"id": "nosub-helper@nosub.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}