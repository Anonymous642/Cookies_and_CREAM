{"manifest_version": 3, "name": "Tab Reminder Pro", "version": "2026.1.2", "description": "Snooze inactive tabs, whitelist domains, and get smart focus notifications.", "permissions": ["alarms", "notifications", "storage", "tabs"], "action": {"default_popup": "popup.html"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tab-reminder-pro@example.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}