{"manifest_version": 2, "name": "Facebook Timeout", "version": "1.0.0", "description": "Temporarily blocks Facebook. You set the timer yourself \u2014 it unlocks automatically when time is up.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "alarms", "webRequest", "webRequestBlocking", "tabs", "*://*.facebook.com/*", "*://*.messenger.com/*", "*://*.fb.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Facebook Timeout"}, "web_accessible_resources": ["blocked.html", "blocked.js"], "browser_specific_settings": {"gecko": {"id": "facebook-timeout@daniel.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}