{"manifest_version": 3, "name": "CA3", "description": "Save web pages to CA3 as Markdown notes with source metadata and optional compressed image attachments.", "version": "2026.7.21.2", "action": {"default_title": "Clip to CA3", "default_popup": "popup.html", "default_icon": {"16": "icons/ca3-icon-16.png", "32": "icons/ca3-icon-32.png", "48": "icons/ca3-icon-48.png", "128": "icons/ca3-icon-128.png"}}, "icons": {"16": "icons/ca3-icon-16.png", "32": "icons/ca3-icon-32.png", "48": "icons/ca3-icon-48.png", "128": "icons/ca3-icon-128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "clipboardWrite", "identity", "scripting", "storage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "ca3@dribwise.ai", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}, "strict_min_version": "142.0"}}}