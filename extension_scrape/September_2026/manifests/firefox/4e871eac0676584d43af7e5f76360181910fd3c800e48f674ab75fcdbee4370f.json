{"manifest_version": 2, "name": "justjump", "description": "JustJump browser extension", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "justjump@dcjanus.com", "data_collection_permissions": {"required": ["none"]}}}, "omnibox": {"keyword": "jj"}, "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' https://unpkg.com", "permissions": ["storage", "history"], "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_title": "JustJump"}}