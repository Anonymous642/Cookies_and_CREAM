{"manifest_version": 3, "name": "Switchalot", "version": "1.0.3", "description": "Easily switch between various environments/domains of your website", "permissions": ["activeTab"], "action": {"default_popup": "index.html"}, "icons": {"16": "favicon-16.png", "32": "favicon-32.png", "48": "favicon-48.png", "128": "favicon-128.png"}, "browser_specific_settings": {"gecko": {"id": "switchalot@neighbourhoodkoala.com", "data_collection_permissions": {"required": ["websiteActivity"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}