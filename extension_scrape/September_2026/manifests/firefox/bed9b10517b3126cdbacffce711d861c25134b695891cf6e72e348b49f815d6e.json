{"manifest_version": 2, "name": "Klyqme", "description": "Shorten any URL in one click with Klyqme", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "notifications", "https://api.klyqme.com/*"], "content_security_policy": "script-src 'self'; object-src 'none'", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Klyqme"}}, "browser_specific_settings": {"gecko": {"id": "extension@klyqme.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Klyqme", "default_popup": "popup.html"}}