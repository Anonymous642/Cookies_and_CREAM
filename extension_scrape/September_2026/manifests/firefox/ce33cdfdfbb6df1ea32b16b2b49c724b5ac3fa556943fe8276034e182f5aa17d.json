{"manifest_version": 3, "name": "MangaGlow Overlay", "description": "Modernizes MangaGo pages and finds official releases through MangaUpdates.", "version": "0.7.61", "permissions": ["storage", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://api.mangaupdates.com/*", "https://api.openverse.org/*", "https://gifsnap.com/*"], "optional_host_permissions": [], "background": {"scripts": ["background.js"]}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{3a8b3783-a712-46bd-a0da-4fd3ccb2f30f}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "action": {"default_title": "MangaGlow Overlay", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://mangago.me/", "https://www.mangago.me/", "https://mangago.me/home/people/*/manga/*", "https://www.mangago.me/home/people/*/manga/*", "https://mangago.me/read-manga/*", "https://www.mangago.me/read-manga/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://mangago.me/*", "https://www.mangago.me/*"], "js": ["boot.js", "shared/settings.js", "shared/page-utils.js", "content.js"], "css": ["content.css", "mobile.css"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}}