{"manifest_version": 2, "name": "YouTube Duration Filter", "version": "1.0.0", "description": "Automatically hide YouTube videos shorter than your preferred duration and all Shorts for a cleaner viewing experience.", "author": "cativi", "homepage_url": "https://github.com/cativi/youtube-filter-extension", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Duration Filter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "web_accessible_resources": ["popup.html"], "browser_specific_settings": {"gecko": {"id": "youtube-duration-filter@cativi.dev", "strict_min_version": "109.0"}}}