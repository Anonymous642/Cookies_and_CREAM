{"manifest_version": 3, "name": "Youtube Default Resolution", "version": "0.8.1", "description": "Automatically selects a desired resolution on youtube or the closest one to it.", "icons": {"48": "icons/yt-default-res-48.png", "96": "icons/yt-default-res-96.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_icon": {"32": "icons/yt-default-res-32.png"}, "default_title": "Default Youtube Resolution", "default_popup": "popup/choose_resolution.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["yt-default-res.js"]}], "browser_specific_settings": {"gecko": {"id": "alexei.krokhmal@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}