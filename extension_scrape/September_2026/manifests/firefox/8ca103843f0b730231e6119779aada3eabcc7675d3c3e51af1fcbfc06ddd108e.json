{"manifest_version": 3, "name": "Unicode Sidebar", "version": "1.2.1", "description": "Sidebar picker for emoji, punctuation, math symbols, IPA, and the full Unicode standard. Click a glyph to insert it into the active text box.", "browser_specific_settings": {"gecko": {"id": "glyphpicker@bubblegumbitch", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "clipboardWrite", "storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "sidebar_action": {"default_panel": "sidebar.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Unicode Sidebar", "open_at_install": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]}