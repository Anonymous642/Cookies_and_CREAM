{"manifest_version": 3, "name": "AI Detector", "version": "0.1.0", "description": "Very simple Firefox extension that scores a page from 0-100 for likely AI-written text. Completely vibe-coded for now. I plan to make it open source soon.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "AI Detector"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "my-ai-detector@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}