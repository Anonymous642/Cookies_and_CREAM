{"manifest_version": 2, "name": "Mute Meter", "version": "1.0", "description": "When you mute a tab, play a gentle wind-like ambient sound so the silence feels rhythmic.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "notifications", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Mute Meter", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "mutemeter@example.com"}}}