{"manifest_version": 2, "name": "blurry", "version": "1.0", "description": "Allows using the Escape key to unfocus the element currently focused on.", "icons": {"32": "icons/icon32.png", "64": "icons/icon64.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["blurry.js"]}], "permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "@blurry", "data_collection_permissions": {"required": ["none"]}}}}