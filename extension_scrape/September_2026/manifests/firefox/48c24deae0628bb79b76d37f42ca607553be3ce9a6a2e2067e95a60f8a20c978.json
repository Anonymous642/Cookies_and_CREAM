{"manifest_version": 2, "name": "Immersive Reader \u2013 Lector educativo", "version": "1.0.1", "description": "Lector inmersivo para alumnado con dificultades: simplifica textos largos, mejora legibilidad y reduce distracciones.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "immersive-reader-alumnos@pp4mnk", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_title": "Immersive Reader", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["reader.css"]}]}