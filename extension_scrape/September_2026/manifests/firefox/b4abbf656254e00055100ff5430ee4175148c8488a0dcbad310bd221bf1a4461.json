{"manifest_version": 3, "name": "LocalSend", "short_name": "LocalSend", "version": "1.1.0", "description": "Send and receive files with nearby devices directly from your browser using animated optical codes.", "action": {"default_title": "Open LocalSend", "default_icon": {"16": "icons/icon-v4-16.png", "32": "icons/icon-v4-32.png", "48": "icons/icon-v4-48.png", "128": "icons/icon-v4-128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-v4-16.png", "32": "icons/icon-v4-32.png", "48": "icons/icon-v4-48.png", "128": "icons/icon-v4-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "localsend@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}