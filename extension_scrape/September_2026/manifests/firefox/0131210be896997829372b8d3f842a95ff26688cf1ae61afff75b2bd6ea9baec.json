{"manifest_version": 2, "name": "Feedly Notifier (manual polling)", "version": "1.0.0", "description": "Monitor user-provided RSS/Atom feeds, poll periodically, show unread counts and notify on new items.", "permissions": ["storage", "alarms", "notifications", "activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Feedly Notifier", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "web_accessible_resources": [], "applications": {"gecko": {"id": "feedlynotifier@example.com", "strict_min_version": "60.0"}}}