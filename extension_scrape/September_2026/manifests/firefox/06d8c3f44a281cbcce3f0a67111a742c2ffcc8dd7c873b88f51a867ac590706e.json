{"manifest_version": 2, "name": "VideoGrab", "version": "2.3.0", "description": "Detect and download HLS/DASH video streams from any website", "author": "VideoGrab Team", "permissions": ["webRequest", "webRequestBlocking", "webNavigation", "storage", "tabs", "activeTab", "downloads", "<all_urls>"], "background": {"page": "src/background/background.html", "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content-script.js"], "run_at": "document_start", "all_frames": true}], "browser_action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_title": "VideoGrab"}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": ["src/background/lib/*"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "videograb@example.com", "strict_min_version": "109.0"}}}