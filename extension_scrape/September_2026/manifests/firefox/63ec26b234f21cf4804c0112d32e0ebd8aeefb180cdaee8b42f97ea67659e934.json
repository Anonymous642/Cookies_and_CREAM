{"manifest_version": 3, "name": "Solimons", "description": "Value and RAP viewer for limited items on Solario.", "version": "1.1", "action": {"default_icon": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "solimons-ext@solimons.com"}, "safari": {"strict_min_version": "14"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"js": ["scripts/trademake.js"], "matches": ["https://solario.ws/trade/*"]}, {"js": ["scripts/tradepage.js"], "matches": ["https://solario.ws/trade/view/*"]}, {"js": ["scripts/catalog.js"], "matches": ["https://solario.ws/catalog/", "https://solario.ws/catalog/?*"]}, {"js": ["scripts/catalogitem.js"], "matches": ["https://solario.ws/catalog/*"]}, {"js": ["scripts/userprofile.js"], "matches": ["https://solario.ws/users/*"]}]}