{"manifest_version": 3, "name": "Salesforce Session", "description": "Easily copy your session ID from any Salesforce Org", "version": "1.1", "author": "Aditya Kumawat", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "salesforce-session-copy@adityakumawat.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*", "https://*.visualforce.com/*", "https://*.cloudforce.com/*"], "js": ["support.js"]}], "action": {"default_title": "Click to Copy Session ID"}, "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*", "https://*.visualforce.com/*", "https://*.cloudforce.com/*", "https://*.salesforce-setup.com/*"], "permissions": ["scripting", "activeTab", "tabs", "cookies", "contextMenus", "notifications"]}