{"manifest_version": 3, "name": "Tab Nest", "version": "1.0.1", "description": "Group pinned tabs into named groups and view unpinned tabs organized by domain.", "browser_specific_settings": {"gecko": {"id": "tab-nest@horobeanu.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "menus", "alarms"], "host_permissions": ["https://horobeanu.github.io/*", "https://api.openai.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_title": "Tab Nest", "default_panel": "sidebar/sidebar.html", "default_icon": "icons/sidebar-icon.svg"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open the Tab Nest sidebar"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}