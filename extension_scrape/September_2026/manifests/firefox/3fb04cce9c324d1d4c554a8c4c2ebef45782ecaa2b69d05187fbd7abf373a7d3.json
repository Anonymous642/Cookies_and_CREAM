{"manifest_version": 3, "name": "Englify \u2013 Fix My Comment", "short_name": "Englify", "description": "Rewrites your social media comments in correct English before you post them.", "version": "1.2.0", "browser_specific_settings": {"gecko": {"id": "englify@englify.social", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Englify"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://englify.social/*"], "js": ["detect.js"], "run_at": "document_start"}], "permissions": ["storage"], "host_permissions": ["https://englify.social/*"], "web_accessible_resources": [{"resources": ["auth-callback.html"], "matches": ["https://englify.social/*"]}]}