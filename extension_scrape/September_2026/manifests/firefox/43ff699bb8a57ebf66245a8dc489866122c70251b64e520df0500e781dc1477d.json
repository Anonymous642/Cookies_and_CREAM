{"manifest_version": 3, "name": "Nightcore Mode for YouTube", "description": "Speed up YouTube videos without pitch correction for that classic Nightcore effect", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "nightcoremode@youtube", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "data_collection_permissions": {"storage_local": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}