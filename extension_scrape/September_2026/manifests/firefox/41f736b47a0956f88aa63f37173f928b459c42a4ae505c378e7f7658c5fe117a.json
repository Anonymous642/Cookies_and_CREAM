{"manifest_version": 2, "name": "lineitem", "description": "Match YNAB transactions to your Amazon and Target orders and split each charge into the right budget categories", "version": "1.4.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "lineitem@lineitem.dev", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo", "personalCommunications"]}}}, "permissions": ["storage", "tabs", "identity", "https://*.amazon.com/*", "https://*.target.com/*", "https://api.ynab.com/*", "https://app.ynab.com/oauth/*", "https://auth.lineitem.dev/*", "https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*", "https://api.web3forms.com/*"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "lineitem"}, "content_scripts": [{"matches": ["*://*.amazon.com/*"], "js": ["content-scripts/amazon.js"]}, {"matches": ["*://*.target.com/*"], "js": ["content-scripts/target.js"]}]}