{"manifest_version": 2, "name": "Kagi", "description": "Kagi password manager and secure vault browser extension.", "version": "0.0.4", "icons": {"16": "icon/light/16.png", "32": "icon/light/32.png", "48": "icon/light/48.png", "128": "icon/light/128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@kagi.pw", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity"]}}}, "permissions": ["storage", "activeTab", "identity", "cookies", "https://*.kagi.pw/*"], "incognito": "spanning", "web_accessible_resources": ["fonts/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Kagi", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}]}