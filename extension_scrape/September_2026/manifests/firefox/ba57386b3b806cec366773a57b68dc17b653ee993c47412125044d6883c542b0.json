{"manifest_version": 3, "name": "Cookie Clicker", "short_name": "Cookie Clicker", "version": "1.0.0", "version_name": "1.0.0 - Initial Release", "description": "Clicks cookie banners on your favorite sites.", "author": "Isaac Hill", "default_locale": "en", "homepage_url": "https://www.isaachill.co.uk", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "index.html", "default_title": "Accept Cookies"}, "browser_specific_settings": {"gecko": {"id": "cookie-clicker@isaachill.co.uk"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "/icons/cookie16.png", "48": "/icons/cookie48.png", "128": "/icons/cookie128.png"}, "commands": {"run-cookie-clicker": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Run the Cookie Clicker"}}}