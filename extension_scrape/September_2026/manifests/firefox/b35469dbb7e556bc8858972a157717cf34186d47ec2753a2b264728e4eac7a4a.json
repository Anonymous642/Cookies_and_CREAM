{"manifest_version": 3, "name": "Differactor", "homepage_url": "https://habett.fr/Differactor.html", "version": "1009.0", "description": "Capture l'\u00e9tat d'une page web puis la compare avec une nouvelle version : les nouveaux \u00e9l\u00e9ments sont surlign\u00e9s, les autres flout\u00e9s.", "permissions": ["storage", "activeTab", "scripting", "unlimitedStorage"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "icons": {"32": "icons/32x32.png", "64": "icons/64x64.png", "128": "icons/128x128.png", "256": "icons/256x256.png", "512": "icons/512x512.png"}, "action": {"default_popup": "popup.html", "default_title": "Differactor", "default_icon": {"32": "icons/32x32.png", "64": "icons/64x64.png", "128": "icons/128x128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "differactor@stephane.roux.to", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "web_accessible_resources": [{"resources": ["icons/128x128.png", "assets/compare.mp3", "assets/capture.mp3", "assets/reset.mp3", "assets/reload.mp3"], "matches": ["<all_urls>"]}], "commands": {"compare": {"suggested_key": {"default": "Alt+Delete", "mac": "Command+Delete"}, "description": "Trigger Differactor compare"}, "capture": {"suggested_key": {"default": "Alt+End", "mac": "Command+End"}, "description": "Ask Differactor to capture the current page"}}}