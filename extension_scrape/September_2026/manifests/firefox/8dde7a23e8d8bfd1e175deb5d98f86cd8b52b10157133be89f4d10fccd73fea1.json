{"manifest_version": 2, "name": "gmail-find-sender-emails", "description": "a very small extension to find all emails from a sender, similar to a button that existed 10 years ago and was ruthlessly removed", "version": "0.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "gmail-find-sender-emails@sthuck.github", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "permissions": ["https://mail.google.com/*"]}