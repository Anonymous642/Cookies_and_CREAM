{"manifest_version": 3, "name": "Brain Rot Detox", "version": "1.1", "description": "Stop watching shorts with this extension. Choose a detox plan to gradually limit the time spent on Youtube Shorts and TikTok", "permissions": ["storage", "tabs", "alarms", "notifications", "idle"], "host_permissions": ["*://*.youtube.com/*", "*://*.tiktok.com/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "action": {"default_icon": "icon.png", "default_title": "Brain Rot Detox"}, "icons": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "brain-rot-detox@restlesspedals", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}