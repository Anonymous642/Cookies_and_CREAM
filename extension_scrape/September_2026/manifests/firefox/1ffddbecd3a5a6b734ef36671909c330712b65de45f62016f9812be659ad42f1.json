{"manifest_version": 3, "name": "Athlete Filters", "version": "0.0.3", "description": "Filter your Strava feed using custom athlete groups.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.strava.com/*"], "content_scripts": [{"matches": ["*://www.strava.com/dashboard*", "*://www.strava.com/athletes/*", "*://www.strava.com/pros/*", "*://www.strava.com/activities/*", "*://www.strava.com/athlete/training*"], "js": ["browser-polyfill.js", "content.js"], "css": ["content.css"]}], "action": {"default_icon": "icons/icon-48.png", "default_title": "Athlete Filters", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "strava-athlete-filters@statelessnessone.github.com", "strict_min_version": "140.0", "data_collection_permissions": {"built_in": false, "required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}