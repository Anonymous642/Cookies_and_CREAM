{"manifest_version": 3, "name": "DragShot", "version": "2.1.0", "description": "Capture full pages, visible screens, or a selected area. Crop, annotate, and export as PNG, JPG, WebP, or PDF. Nothing ever leaves your device.", "author": "Md. Habibur Rahman", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "DragShot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "src/settings/index.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "downloads", "alarms"], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture the visible area"}, "capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture the full page"}, "capture-select-area": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Select an area to capture"}}, "browser_specific_settings": {"gecko": {"id": "habiburhridoy01@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}