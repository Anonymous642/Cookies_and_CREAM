{"manifest_version": 2, "name": "TrackRotate", "description": "A extension that displays TrackRotate data in your Spotify playlists", "version": "0.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "cookies", "storage", "*://open.spotify.com/playlist/*", "*://*.trackrotate.com/*", "*://localhost/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "\n      TrackRotate\n    ", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://open.spotify.com/playlist/*"], "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "{c8bf761d-9622-4a6a-89e1-f1a051f94181}"}}}