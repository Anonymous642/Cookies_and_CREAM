{"manifest_version": 3, "name": "KaiTV", "version": "1.3.20", "description": "Display Twitch pronouns, earned titles, Adventure Time profiles, and authorized private balances", "permissions": ["storage", "alarms", "identity"], "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*", "https://eraleas.com/*", "https://pronouns.alejo.io/*"], "homepage_url": "https://eraleas.com", "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://eraleas.com/*", "https://www.eraleas.com/*"], "js": ["presence.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/currency/*.png", "icons/classes/*.png"], "matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"]}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "kaitv@eraleas.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["personallyIdentifyingInfo", "authenticationInfo"]}}}}