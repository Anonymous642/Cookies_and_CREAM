{"manifest_version": 3, "name": "YouTube Monetization Checker - Mega Creative", "version": "3.5", "description": "One-click check if a YouTube channel is monetized: ad detection, Partner Program and claim signals, optional AI. Estimates only.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.googleapis.com/*", "https://generativelanguage.googleapis.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "browser_specific_settings": {"gecko": {"id": "monetization-checker@megacreative.network", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["dist/background.js"]}, "action": {"default_title": "YouTube Monetization Checker - Mega Creative", "default_popup": "dist/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}