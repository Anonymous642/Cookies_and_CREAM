{"manifest_version": 3, "name": "Auto Browser Color", "description": "Adapte la couleur de l'interface de Firefox \u00e0 celle du site visit\u00e9.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "auto-browser-color@abc", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["tabs", "theme", "storage"], "action": {"default_title": "Auto Browser Color", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}