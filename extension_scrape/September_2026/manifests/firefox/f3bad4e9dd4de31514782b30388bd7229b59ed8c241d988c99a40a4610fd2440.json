{"manifest_version": 3, "name": "MailPurge", "version": "1.0.19", "description": "Quickly delete email in bulk, auto purge senders, and clean your Gmail, Outlook, or Yahoo inbox with this privacy-first extension.", "permissions": ["storage", "scripting", "tabs", "alarms", "notifications", "contextMenus"], "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "host_permissions": ["https://extensionpay.com/*", "*://outlook.live.com/*", "*://mail.google.com/*", "*://mail.yahoo.com/*", "*://www.icloud.com/mail/*"], "action": {"default_title": "Click to open MailPurge"}, "sidebar_action": {"default_panel": "popup/index.html", "default_title": "MailPurge", "default_icon": "assets/icon48.png"}, "background": {"scripts": ["utils/ExtPay.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "mailpurge@digicapsolutions.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["cdn/selectors.json", "utils/*", "content/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content/gmail-observer.js"], "run_at": "document_idle"}, {"matches": ["*://outlook.live.com/*"], "js": ["content/outlook-observer.js"], "run_at": "document_idle"}]}