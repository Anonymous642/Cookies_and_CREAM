{"manifest_version": 3, "name": "Shortcut Gallery BS", "version": "1.88", "description": "A simple shortcut gallery for your favorite links.", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "chrome_url_overrides": {"newtab": "popup.html"}, "options_ui": {"page": "preferences.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"strict_min_version": "142.0", "id": "shortcut-gallery@example.com", "data_collection_permissions": {"required": ["none"]}}}}