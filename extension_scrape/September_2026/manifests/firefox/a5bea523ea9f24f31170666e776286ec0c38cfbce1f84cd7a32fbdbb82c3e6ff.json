{"manifest_version": 3, "name": "Subreddit Render Blocker", "version": "1.0.1", "description": "Hide posts from unwanted subreddits on Reddit's aggregate feeds (/r/all, /r/popular). Supports exact names and *wildcard* keywords.", "permissions": ["storage"], "host_permissions": ["*://*.reddit.com/*"], "browser_specific_settings": {"gecko": {"id": "subreddit-render-blocker@redditblock", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["src/match.js", "src/content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup/popup.html", "default_title": "Subreddit Render Blocker", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}