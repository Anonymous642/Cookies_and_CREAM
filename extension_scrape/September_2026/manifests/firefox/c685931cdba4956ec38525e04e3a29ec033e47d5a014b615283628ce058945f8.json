{"manifest_version": 3, "name": "Volume Control by debauer", "version": "0.1.9", "description": "Set per-tab media volume and local website defaults.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "sessions", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Volume Control by debauer", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-audio-hook.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "firefox-tab-volume@example.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}