{"manifest_version": 2, "name": "Tekphreak's FB Audio Downloader", "version": "1.0.44", "description": "Download audio messages from Facebook Messenger", "author": "tekphreak", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["webRequest", "downloads", "tabs", "storage", "*://*.facebook.com/*", "*://*.fbcdn.net/*", "*://*.fbsbx.com/*", "*://*.cdninstagram.com/*"], "background": {"page": "background.html", "persistent": true}, "content_scripts": [{"matches": ["*://*.facebook.com/messages/*", "*://*.messenger.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "web_accessible_resources": ["inject.js"], "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "fb-audio-downloader@tekphreak", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "FB Messenger Audio Downloader"}}