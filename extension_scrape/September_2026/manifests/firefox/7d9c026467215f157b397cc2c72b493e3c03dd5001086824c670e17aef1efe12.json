{"manifest_version": 3, "name": "ArzDigital", "version": "3.4.1", "description": "A new tab page displaying real-time financial market data and personal watchlists.", "chrome_url_overrides": {"newtab": "index.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "images/arz16.png", "32": "images/arz32.png", "48": "images/arz48.png", "128": "images/arz128.png"}, "permissions": ["search", "storage", "alarms", "notifications"], "host_permissions": ["https://gw.arzdigital.com/*"], "browser_specific_settings": {"gecko": {"id": "info@arzdigital.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "locationInfo", "personallyIdentifyingInfo", "searchTerms", "websiteContent"]}}}}