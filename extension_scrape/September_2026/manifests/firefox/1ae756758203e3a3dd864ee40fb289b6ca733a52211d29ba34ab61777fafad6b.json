{"manifest_version": 3, "name": "Quicksub YT", "version": "0.2.7", "description": "Assists in manually subscribing to YouTube channels from a list or webpage with timed intervals.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*", "<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background_bundle.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-timed-subscriber@yt-timer-sub.com", "strict_min_version": "109.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/channel_scanner.js"], "run_at": "document_idle"}]}