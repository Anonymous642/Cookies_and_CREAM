{"manifest_version": 2, "name": "Pokus - Stay Focused", "version": "2.0", "description": "Block distracting websites with focus timer", "permissions": ["storage", "activeTab", "tabs", "alarms", "notifications", "<all_urls>"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "browser_action": {"default_popup": "popup.html", "default_title": "Pokus", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": ["blocked.html", "blocked.js", "images/*"], "browser_specific_settings": {"gecko": {"id": "pokus@extension.local", "strict_min_version": "79.0"}}}