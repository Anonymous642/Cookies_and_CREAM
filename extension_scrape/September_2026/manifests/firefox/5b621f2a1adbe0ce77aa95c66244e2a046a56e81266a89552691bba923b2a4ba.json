{"manifest_version": 3, "name": "Helpi", "version": "1.0.0", "description": "Process selected text through AI using keyboard shortcuts. Grammar check, translate, summarize, and more \u2014 instantly.", "browser_specific_settings": {"gecko": {"id": "helpi@helpi.me", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": []}}}, "permissions": ["activeTab", "clipboardWrite", "clipboardRead", "storage", "menus"], "host_permissions": ["https://helpi.me/*", "https://*.helpi.me/*"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content-script.js"], "css": [], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "commands": {"check-grammar": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Alt+Shift+G"}, "description": "Check grammar of selected text"}, "answer-explain": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Alt+Shift+A"}, "description": "Answer or explain selected text"}, "translate": {"description": "Translate selected text"}, "summarize": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Alt+Shift+S"}, "description": "Summarize selected text"}, "smart-action": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Alt+Shift+Space"}, "description": "Smart AI action \u2014 auto-detects grammar fix, answer, summarize, or translate"}}, "web_accessible_resources": [{"resources": ["assets/*", "auth/*"], "matches": ["https://helpi.me/*", "https://*.helpi.me/*"]}]}