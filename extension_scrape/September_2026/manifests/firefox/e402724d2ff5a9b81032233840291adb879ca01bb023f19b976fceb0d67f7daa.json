{"manifest_version": 3, "name": "Cheapr", "version": "2.0.0", "description": "Unlimited Discounts on Amazon, eBay, and 1000+ other stores", "browser_specific_settings": {"gecko": {"id": "cheapr@extension.com", "strict_min_version": "115.0"}}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://restcountries.com/*", "https://ipapi.co/*", "https://api.ipify.org/*", "https://app.cheapr.cc/*"], "background": {"scripts": ["src/background/background.js"], "service_worker": "src/background/background.js", "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "css": ["assets/dealsPopup.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon16.png", "icon32.png", "icon48.png", "icon128.png", "assets/dealsPopup.css", "assets/deals.css", "assets/deals.js", "assets/images/product1.png", "assets/images/product2.png", "assets/images/product3.png", "deals.html", "product1.png", "product2.png", "product3.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"}, "commands": {"scrape-product": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Scrape product data from the current page"}}}