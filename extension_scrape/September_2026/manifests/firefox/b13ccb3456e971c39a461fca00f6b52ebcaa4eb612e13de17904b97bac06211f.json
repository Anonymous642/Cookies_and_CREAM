{"manifest_version": 3, "name": "JobCubby \u2014 save any job in one click", "version": "1.3.0", "description": "Save the job you're looking at straight to your JobCubby tracker. Works on any site, including ones that block automated readers.", "homepage_url": "https://jobcubby.com", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Save this job to JobCubby", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background.js"], "type": "module"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "permissions": ["identity", "activeTab", "storage", "scripting", "notifications"], "host_permissions": ["https://jobcubby.com/*", "https://sentry.jobcubby.com/*"], "browser_specific_settings": {"gecko": {"id": "addon@jobcubby.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}