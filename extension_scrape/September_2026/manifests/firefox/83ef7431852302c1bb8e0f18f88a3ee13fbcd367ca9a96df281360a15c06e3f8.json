{"manifest_version": 3, "name": "Sahiko Dial", "short_name": "Sahiko Dial", "version": "1.0.0", "description": "Save your favorite and most-visited sites. One click to open, one place to manage.", "author": "Sahiko", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Sahiko Dial"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "tabs", "topSites", "history", "contextMenus"], "host_permissions": ["<all_urls>"], "options_page": "management/management.html", "commands": {"open-tile-1": {"suggested_key": {"default": "Alt+1"}, "description": "Open pinned site 1"}, "open-tile-2": {"suggested_key": {"default": "Alt+2"}, "description": "Open pinned site 2"}, "open-tile-3": {"suggested_key": {"default": "Alt+3"}, "description": "Open pinned site 3"}}, "browser_specific_settings": {"gecko": {"id": "sahiko-dial@sahiko.app", "data_collection_permissions": {"required": ["none"]}}}}