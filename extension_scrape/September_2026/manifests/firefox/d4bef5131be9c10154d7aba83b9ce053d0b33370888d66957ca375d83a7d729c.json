{"manifest_version": 3, "name": "Qwen Navigator", "version": "4.1.2", "description": "Agent web local utilisant Ollama, sans Native Messaging.", "permissions": ["storage", "tabs", "scripting", "activeTab"], "host_permissions": ["http://127.0.0.1:11434/*", "http://localhost:11434/*", "<all_urls>"], "action": {"default_title": "Qwen Navigator", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ollama-qwen-navigator@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}}