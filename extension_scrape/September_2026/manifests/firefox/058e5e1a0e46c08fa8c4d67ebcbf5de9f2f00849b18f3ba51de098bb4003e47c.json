{"manifest_version": 3, "name": "NijiHub Resolver", "description": "Compagnon du lecteur NijiHub : r\u00e9sout les flux vid\u00e9o depuis votre navigateur pour une lecture directe.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "resolver@nijihub.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "NijiHub Resolver", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.nijihub.com/*", "*://localhost/*", "*://nijihub.com/*"], "run_at": "document_start", "js": ["content-scripts/nijihub.js"]}]}