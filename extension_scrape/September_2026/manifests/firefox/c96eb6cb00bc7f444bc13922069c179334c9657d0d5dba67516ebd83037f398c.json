{"manifest_version": 2, "name": "YouTube Auto Pause Preventer", "version": "1.0.0", "description": "Prevents YouTube videos from auto-pausing within the first 10 seconds.", "permissions": ["*://*.youtube.com/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content_scripts/controller.js"]}], "browser_specific_settings": {"gecko": {"id": "youtube-auto-resume@hasil.in", "strict_min_version": "58.0"}}}