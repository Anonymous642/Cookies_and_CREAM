{"manifest_version": 3, "name": "Color Palette Extractor by Rod Lovell", "version": "2.0", "description": "Extract all colors from the current page and display them in a popup.", "permissions": ["activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "artwithrod@gmail.com", "strict_min_version": "109.0"}}}