{"manifest_version": 3, "name": "Hunchyroll", "description": "Enjoy Crunchyroll with Hungarian subtitles on supported episodes.", "version": "0.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "hu", "web_accessible_resources": [{"resources": ["site.js"], "matches": ["https://static.crunchyroll.com/*"]}], "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["https://static.crunchyroll.com/*", "https://www.crunchyroll.com/watch/*"], "browser_specific_settings": {"gecko": {"id": "contact@nergal.xyz", "strict_min_version": "127.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Hunchyroll", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://static.crunchyroll.com/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}