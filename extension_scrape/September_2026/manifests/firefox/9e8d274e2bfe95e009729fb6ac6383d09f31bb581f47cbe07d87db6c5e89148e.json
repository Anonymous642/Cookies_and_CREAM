{"manifest_version": 3, "name": "Hacker News Summary", "version": "1.3.1", "description": "Adds a summary link to Hacker News stories.", "browser_specific_settings": {"gecko": {"id": "hn-summary-firefox-extension@johannes.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "action": {"default_title": "Hacker News Summary", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["hn-summary.js"]}]}