{"manifest_version": 2, "name": "YT Mini Player", "version": "1.3.1", "description": "Mini player for YouTube Music & SoundCloud", "browser_specific_settings": {"gecko": {"id": "yt-mini-player@my-extension.local"}}, "permissions": ["tabs", "storage", "webNavigation", "https://music.youtube.com/*", "https://soundcloud.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Open Mini Player"}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043c\u0438\u043d\u0438-\u043f\u043b\u0435\u0435\u0440"}, "play_pause": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "\u0418\u0433\u0440\u0430\u0442\u044c / \u041f\u0430\u0443\u0437\u0430"}, "next_track": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "\u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0442\u0440\u0435\u043a"}, "prev_track": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "\u041f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u0442\u0440\u0435\u043a"}}}