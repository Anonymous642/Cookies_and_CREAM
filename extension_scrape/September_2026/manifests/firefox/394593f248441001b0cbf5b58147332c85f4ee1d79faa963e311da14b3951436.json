{"manifest_version": 3, "name": "SharePoint List Scheduler", "short_name": "SP Scheduler", "version": "1.0.0", "description": "Automatically download SharePoint Lists on a scheduled basis using the existing SharePoint login session.", "permissions": ["storage", "downloads", "alarms", "notifications", "cookies"], "host_permissions": ["https://*.sharepoint.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "SharePoint List Scheduler", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "web_accessible_resources": [{"resources": ["lib/xlsx.full.min.js", "browser-polyfill.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "sharepoint-list-scheduler@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}