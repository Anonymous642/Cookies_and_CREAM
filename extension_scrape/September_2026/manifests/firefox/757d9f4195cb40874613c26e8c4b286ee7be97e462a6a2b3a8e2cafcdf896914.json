{"manifest_version": 3, "name": "BoltBrief - Instant AI Summaries for YouTube", "short_name": "BoltBrief", "version": "1.0.7", "description": "Summarize YouTube videos in one click with key points, comment summaries, and no-caption video analysis for eligible plans.", "default_locale": "en", "permissions": ["storage", "activeTab", "identity"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content/transcript-extractor.js", "src/content/content-script.js"], "css": ["src/content/content-style.css"], "run_at": "document_idle"}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["src/content/injected-fetcher.js", "src/content/assets/boltbrief-logo-button.png", "src/workspace/*", "src/lib/*"], "matches": ["*://*.youtube.com/*"]}], "action": {"default_title": "BoltBrief"}, "browser_specific_settings": {"gecko": {"id": "boltbrief@boltbrief.com", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity", "websiteContent"]}}}}