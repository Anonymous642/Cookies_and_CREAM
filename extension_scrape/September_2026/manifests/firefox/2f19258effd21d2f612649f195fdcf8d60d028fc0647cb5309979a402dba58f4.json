{"manifest_version": 3, "name": "Bitcashback", "version": "4.3.1", "description": "Estensione che ti notifica quando ti trovi in un negozio affiliato a Bitcashback", "background": {"scripts": ["script/worker.js"], "type": "module"}, "action": {"default_title": "BitCashback: il tuo cashback in bitcoin", "default_icon": {"16": "images/bitcback-16.png", "19": "images/bitcback-19.png", "32": "images/bitcback-32.png", "38": "images/bitcback-38.png", "48": "images/bitcback-48.png", "128": "images/bitcback-128.png"}, "default_popup": "pages/popup.html"}, "content_scripts": [{"css": ["css/bitcback.css", "css/bitcback-amz.css"], "js": ["script/initialize.js", "script/content_script.js"], "matches": ["https://*/*"], "run_at": "document_end"}, {"js": ["script/bitcback.js", "script/tracking.js", "script/alert-amz.js"], "matches": ["https://bitcashback.net/*"], "run_at": "document_idle"}], "permissions": ["storage", "cookies", "clipboardWrite", "tabs"], "optional_permissions": ["privacy"], "host_permissions": ["*://*/*"], "options_ui": {"page": "pages/options.html"}, "web_accessible_resources": [{"resources": ["images/*", "pages/*", "script/*", "fonts/*"], "matches": ["<all_urls>"]}], "icons": {"16": "images/bitcback-16.png", "19": "images/bitcback-19.png", "32": "images/bitcback-32.png", "38": "images/bitcback-38.png", "48": "images/bitcback-48.png", "128": "images/bitcback-128.png"}, "browser_specific_settings": {"gecko": {"id": "snowhaystack@gmail.com", "strict_min_version": "102.0"}}}