{"manifest_version": 3, "name": "RoRaFx", "version": "0.7.0", "description": "Copy customized Twitter/X links with format picker, history, and presets", "permissions": ["storage", "contextMenus", "tabs"], "host_permissions": ["https://*.twimg.com/*"], "background": {"scripts": ["shared.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "RoRaFx"}, "commands": {"copy-formatted-link": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Copy formatted link for focused tweet"}}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["shared.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "rorafx@yourdomain.com", "strict_min_version": "109.0"}}}