{"manifest_version": 2, "name": "Bloqueio YouTube por Tarefas", "version": "1.0", "description": "Redireciona para tarefas antes de liberar o YouTube.", "permissions": ["storage", "webNavigation", "*://www.youtube.com/*", "*://youtube.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Bloqueio YouTube", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://softhdr.com.br/tarefas*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "bloqueio-youtube@softhdr.com.br", "data_collection_permissions": {"required": ["none"]}}}}