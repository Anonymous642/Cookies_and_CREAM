{"manifest_version": 2, "name": "Vorasense", "description": "AI-driven scam detection for chat platforms", "version": "0.1.7", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "alarms", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://mail.google.com/*", "https://chat.google.com/*"], "commands": {"scan-conversation": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Scan the current conversation"}}, "browser_specific_settings": {"gecko": {"id": "vorasense@vorasense.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Vorasense", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["https://chat.google.com/*", "https://mail.google.com/*", "https://www.facebook.com/*", "https://www.messenger.com/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}