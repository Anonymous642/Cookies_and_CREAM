{"manifest_version": 2, "name": "Dark Mode Universel", "version": "1.0.0", "description": "Active un mode sombre sur n'importe quel site, m\u00e9moris\u00e9 site par site.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Dark Mode Universel"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Activer/d\u00e9sactiver le mode sombre sur ce site"}}, "permissions": ["<all_urls>", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "dark-mode-universal@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "78.0"}}}