{"manifest_version": 3, "name": "Comics / Manga Downloader", "version": "1.9.0", "description": "A cross browser extension to download comics / manga as pdf file from any site.", "author": "Saptarshi Mondal <mondalsaptarshi7@gmail.com>", "icons": {"16": "./icon/16.png", "48": "./icon/48.png", "96": "./icon/96.png", "128": "./icon/128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "./popup/icon/16.png", "32": "./popup/icon/32.png", "64": "./popup/icon/64.png"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.bundle.js"]}, "browser_specific_settings": {"gecko": {"id": "comics-manga-downloader-ext@saptarshimondal", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}