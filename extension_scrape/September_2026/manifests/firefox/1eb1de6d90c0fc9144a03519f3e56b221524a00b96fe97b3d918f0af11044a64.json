{"manifest_version": 3, "name": "Branchkeeper \u2014 Tab Tree Vault", "short_name": "Branchkeeper", "version": "0.2.16", "description": "Protect, search, archive, restore, and back up Firefox tabs in a compact window tree.", "incognito": "not_allowed", "permissions": ["contextualIdentities", "cookies", "sessions", "storage", "tabGroups", "tabs"], "background": {"scripts": ["background/vault.js", "background/group-restore.js", "background/whats-new.js", "background/background.js"]}, "action": {"default_icon": "icons/branchkeeper.svg", "default_title": "Open Branchkeeper manager"}, "sidebar_action": {"default_icon": "icons/branchkeeper.svg", "default_panel": "sidebar/index.html", "default_title": "Branchkeeper", "open_at_install": false}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle the Branchkeeper sidebar"}, "focus-branchkeeper-search": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Open Branchkeeper and focus tab search"}}, "icons": {"48": "icons/branchkeeper.svg", "96": "icons/branchkeeper.svg"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "branchkeeper@semasping.info", "strict_min_version": "142.0"}}}