{"manifest_version": 3, "name": "Metricon Web Activity Tracker", "version": "1.0.0", "description": "Collects active website title, domain and URL.", "permissions": ["tabs", "storage"], "host_permissions": ["http://*/*", "https://*/*", "http://localhost:8080/*", "http://127.0.0.1:8080/*", "https://metriconapp.com/*"], "background": {"scripts": ["dist/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "metricon-web-activity@metriconapp.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}