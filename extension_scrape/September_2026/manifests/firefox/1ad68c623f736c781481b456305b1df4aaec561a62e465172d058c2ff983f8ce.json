{"manifest_version": 3, "name": "Trwet Bookmarks Sidebar", "version": "1.0", "description": "Manage your bookmarks directly in the Firefox sidebar via trwet.com", "icons": {"48": "icons/icon.png"}, "sidebar_action": {"default_title": "Trwet Bookmarks", "default_panel": "sidebar.html"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.trwet.com/?hint=1"], "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Alt+T", "mac": "Command+Shift+T"}, "description": "Toggle Trwet Bookmarks Sidebar"}}, "browser_specific_settings": {"gecko": {"id": "info@trwet.com"}}}