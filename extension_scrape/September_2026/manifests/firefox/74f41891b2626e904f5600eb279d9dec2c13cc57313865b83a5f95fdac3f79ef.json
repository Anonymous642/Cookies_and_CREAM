{"manifest_version": 3, "name": "Feank URL Tracker", "version": "0.2.0", "description": "Sends active tab URLs to Feank and blocks distracting sites during focus sessions.", "browser_specific_settings": {"gecko": {"id": "feank-url-tracker@feank.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "declarativeNetRequest"], "host_permissions": ["http://127.0.0.1:17345/*"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}