{"manifest_version": 3, "name": "Clipwave Video & Image Prompts", "version": "1.0.0", "description": "Turn any page or selected text into a structured AI video or image brief, then generate it in your ClipWave workspace.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Clipwave Video & Image Prompts", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "scripting", "contextMenus", "storage"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Open Clipwave Video & Image Prompts"}}, "browser_specific_settings": {"gecko": {"id": "video-image-prompts@clipwave.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}}