{"manifest_version": 3, "name": "FireCaster", "version": "0.4.2", "description": "Cast YouTube videos to your TV (Chromecast, Fire TV Stick, Android TV, DIAL/DLNA) with a floating in-player button and a local helper.", "permissions": ["storage"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-tv-sync-cast@djsen.nvx", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}