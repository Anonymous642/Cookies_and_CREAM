{"manifest_version": 3, "name": "ShortsMind: YouTube Time Tracker", "version": "1.1", "description": "Track time spent on YouTube Shorts with a live on-page timer and dashboard stats.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "webNavigation", "idle"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "dashboard.html", "browser_specific_settings": {"gecko": {"id": "shortsmind@yourname.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}