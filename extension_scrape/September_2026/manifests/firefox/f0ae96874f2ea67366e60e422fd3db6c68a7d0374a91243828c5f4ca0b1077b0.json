{"manifest_version": 2, "name": "Shit Portal Auto Fill", "version": "1.0", "description": "Auto-fills login credentials on the SHIT portal login page.", "permissions": ["storage", "activeTab", "tabs"], "icons": {"48": "icons/logo.png", "96": "icons/logo.png"}, "browser_specific_settings": {"gecko": {"id": "upes-autofill@yourdomain.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_icon": "icons/logo.png", "default_title": "Shit Auto-Fill", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://myupes-beta.upes.ac.in/*"], "js": ["content/autofill.js"], "run_at": "document_idle"}]}