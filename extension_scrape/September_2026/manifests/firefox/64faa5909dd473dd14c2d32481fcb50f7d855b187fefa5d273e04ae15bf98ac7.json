{"manifest_version": 3, "name": "PhishTriage", "version": "1.0.0", "description": "AI-powered phishing triage. Analyze suspicious emails and web pages instantly.", "permissions": ["activeTab", "storage", "scripting"], "optional_permissions": ["webNavigation", "downloads"], "optional_host_permissions": ["<all_urls>"], "storage": {"managed_schema": "managed-storage.json"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"], "js": ["scanshark.js", "content.js"], "css": ["sidebar.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "PhishTriage", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "phishtriage@phishtriage.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications", "personallyIdentifyingInfo"], "optional": ["browsingActivity", "websiteActivity"]}}}}