{"manifest_version": 3, "name": "ChronoTube: Speed-Aware Time", "version": "1.0.0", "description": "Smart remaining time calculator for YouTube. Handles playback speed, seeking, and live updates.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_title": "YT Speed-Aware"}, "web_accessible_resources": [{"resources": ["src/modules/*.js", "icons/icon128.png"], "matches": ["<all_urls>"]}], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "chronotube@chronotube.org", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}