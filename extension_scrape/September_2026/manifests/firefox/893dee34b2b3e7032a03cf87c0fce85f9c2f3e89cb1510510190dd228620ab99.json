{"manifest_version": 3, "name": "Oplata Captcha Solver", "version": "1.0.0", "description": "Automatic captcha recognition on oplata.info using Perplexity AI", "permissions": ["storage", "activeTab"], "host_permissions": ["https://oplata.info/*", "https://api.perplexity.ai/*"], "browser_specific_settings": {"gecko": {"id": "oplata-captcha-solver@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://oplata.info/info/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}