{"manifest_version": 2, "name": "TemporaryMail.com - Disposable Email", "version": "1.2.0", "description": "Receive emails to your disposable email address directly in your browser.", "permissions": ["storage", "notifications", "activeTab", "contextMenus", "tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"32": "images/icon-32.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://*.temporarymail.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "images/icon-32.png", "64": "images/icon-64.png", "128": "images/icon-128.png"}, "web_accessible_resources": ["popup.html"], "browser_specific_settings": {"gecko": {"id": "temporarymailcomteam@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}