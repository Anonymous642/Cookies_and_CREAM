{"manifest_version": 2, "name": "Refined GitLab", "description": "Improves the GitLab web UI. Works on gitlab.com and self-hosted instances.", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "refined-gitlab@dreamingcodes", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}