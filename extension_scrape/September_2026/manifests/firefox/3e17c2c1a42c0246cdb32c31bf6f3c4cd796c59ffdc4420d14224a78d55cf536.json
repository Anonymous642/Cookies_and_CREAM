{"manifest_version": 3, "name": "MirrorFusion", "version": "0.2.0", "description": "Validate and combine highlighted file-host mirrors through aria2.", "author": "MirrorFusion Project", "homepage_url": "https://github.com/Frixon21/MirrorFusion", "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "mirrorfusion@frixon21", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent", "websiteActivity"]}, "strict_min_version": "142.0"}}, "permissions": ["activeTab", "cookies", "downloads", "menus", "nativeMessaging", "scripting", "storage", "webNavigation", "webRequest", "webRequestBlocking"], "host_permissions": ["https://gofile.io/*", "https://*.gofile.io/*", "https://pixeldrain.com/*", "https://*.pixeldrain.com/*", "https://vik1ngfile.site/*", "https://*.vik1ngfile.site/*", "https://vikingfile.com/*", "https://*.vikingfile.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"scripts": ["shared/domain.js", "shared/providers.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "64": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_title": "MirrorFusion", "default_popup": "workflow.html", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}}