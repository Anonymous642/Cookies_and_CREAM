{"manifest_version": 3, "name": "Letras Bonitas", "version": "1.0.0", "description": "Apply beautiful, stylish fonts to any webpage. Choose from a curated collection of pretty fonts (letras bonitas) to make text more readable and elegant.", "author": "Letras Bonitas", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg"}, "default_title": "Letras Bonitas - Pretty Fonts", "default_popup": "popup/popup.html"}, "permissions": ["storage", "activeTab"], "optional_host_permissions": ["https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "letras-bonitas@addon", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}