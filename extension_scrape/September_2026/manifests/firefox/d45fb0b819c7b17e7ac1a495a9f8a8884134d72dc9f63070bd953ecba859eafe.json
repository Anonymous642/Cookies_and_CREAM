{"manifest_version": 3, "name": "XYGene Extension", "version": "1.12.0", "description": "The XYGene Web Extension assists authorized users in transferring limited patient demographic information from supported web applications into the locally installed XYGene desktop application, as part of legitimate clinical and laboratory workflows.", "permissions": ["storage"], "host_permissions": ["https://tamvoes.com/*", "https://*.tamvoes.com/*", "https://simplepractice.com/*", "https://*.simplepractice.com/*", "https://static.practicefusion.com/*", "https://*.practicefusion.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "xygene-webextension@xygene.net", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "web_accessible_resources": [{"resources": ["scripts/*", "script-map.json"], "matches": ["https://tamvoes.com/*", "https://*.tamvoes.com/*", "https://simplepractice.com/*", "https://*.simplepractice.com/*", "https://static.practicefusion.com/*", "https://*.practicefusion.com/*", "http://localhost/*"]}], "content_scripts": [{"matches": ["https://tamvoes.com/*", "https://*.tamvoes.com/*", "https://simplepractice.com/*", "https://*.simplepractice.com/*", "https://static.practicefusion.com/*", "https://*.practicefusion.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_title": "XYGene Extension"}}