{"manifest_version": 2, "name": "TabFlow", "version": "1.1.0", "description": "Organiser dine faner i grupper, gem sessioner som workflows og bloker reklamer og trackere automatisk.", "homepage_url": "https://github.com/tabflow-extension/tabflow", "developer": {"name": "TabFlow"}, "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "TabFlow", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["blocklist.js", "background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "tabflow@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}