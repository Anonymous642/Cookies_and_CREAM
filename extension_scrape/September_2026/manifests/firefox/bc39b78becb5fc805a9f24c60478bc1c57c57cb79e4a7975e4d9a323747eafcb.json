{"manifest_version": 3, "name": "Vim Reddit Nav", "version": "4.1.0", "description": "Redirects reddit.com to old.reddit.com and adds Vim-style keyboard navigation for posts and comments.", "author": "Generated for keyboard-driven old.reddit.com browsing", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://reddit.com/*", "*://www.reddit.com/*", "*://old.reddit.com/*"], "background": {"scripts": ["background.js"]}, "declarative_net_request": {"rule_resources": [{"id": "old_reddit_redirect", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://old.reddit.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "old-reddit-keyboard-nav@example.com", "strict_min_version": "115.0"}}}