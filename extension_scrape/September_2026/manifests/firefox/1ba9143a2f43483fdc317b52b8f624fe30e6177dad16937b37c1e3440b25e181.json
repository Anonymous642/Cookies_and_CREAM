{"manifest_version": 3, "name": "DeviantArt Subscribe Tile Hider", "version": "1.0.0", "description": "Hides locked/paywalled deviation tiles (blurred thumbnail + price + Subscribe button) on DeviantArt.", "content_scripts": [{"matches": ["*://*.deviantart.com/*"], "js": ["prefetch.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.deviantart.com/*"], "js": ["lookahead.js", "content.js"], "run_at": "document_start", "css": ["content.css"]}], "browser_specific_settings": {"gecko": {"id": "da-hide-subscribe@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}