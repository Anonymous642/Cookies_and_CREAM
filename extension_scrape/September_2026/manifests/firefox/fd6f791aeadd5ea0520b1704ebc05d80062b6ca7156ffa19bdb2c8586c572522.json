{"manifest_version": 2, "name": "Pet Zoom for ChatGPT", "version": "1.0.0", "author": "Betonbroetchen", "description": "Enlarges and repositions animated pets in signed-in ChatGPT Work chats.", "homepage_url": "https://codeberg.org/Betonbroetchen/Pet-Zoom-for-ChatGPT", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Pet Zoom for ChatGPT", "default_popup": "popup.html", "default_area": "navbar"}, "browser_specific_settings": {"gecko": {"id": "pet-zoom-for-chatgpt@betonbroetchen.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}