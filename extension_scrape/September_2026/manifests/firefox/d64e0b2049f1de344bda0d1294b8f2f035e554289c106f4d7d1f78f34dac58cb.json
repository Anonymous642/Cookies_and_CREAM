{"manifest_version": 2, "name": "Pomodoro Productivity Extension", "version": "0.1.0", "description": "Organize tasks, focus with Pomodoro, block distractions, sync calendar, and get insights from an AI Buddy.", "browser_specific_settings": {"gecko": {"id": "pomodoro-productivity-extension@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage", "notifications", "alarms", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["src/background.firefox.js"], "persistent": false}, "browser_action": {"default_title": "Pomodoro", "default_popup": "src/popup.html"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "chrome_url_overrides": {"newtab": "src/dashboard.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_start"}]}