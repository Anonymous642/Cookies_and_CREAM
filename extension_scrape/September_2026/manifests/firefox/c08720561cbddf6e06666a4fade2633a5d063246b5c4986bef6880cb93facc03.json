{"manifest_version": 3, "name": "NetKeepAlive Pro", "version": "1.2.2", "description": "Stabilizes data connections and reduces latency spikes with adaptive multi-endpoint keep-alive pings that adjust their pace to your connection's health.", "author": "Abdul Rahman", "developer": {"name": "Abdul Rahman"}, "browser_specific_settings": {"gecko": {"id": "netkeepalive-pro@netkeepalivepro.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["alarms", "storage", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "NetKeepAlive Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}