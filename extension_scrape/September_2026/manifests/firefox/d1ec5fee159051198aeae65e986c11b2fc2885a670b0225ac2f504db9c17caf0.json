{"manifest_version": 2, "name": "AstoundTube - YouTube Speed Controller", "short_name": "AstoundTube", "version": "1.0.0", "description": "Control YouTube playback speed with keyboard shortcuts, customizable slider, and smart speed memory. Fast, lightweight, and privacy-focused.", "author": "Astound Technology", "homepage_url": "https://astound.technology", "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "contact@astound.technology", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "*://www.youtube.com/*", "*://youtube.com/*"], "browser_action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "AstoundTube"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["src/shared/config.js", "src/shared/storage.js", "src/shared/utils.js", "src/content/overlay.js", "src/content/indicator.js", "src/content/hover.js", "src/content/player.js", "src/content/index.js"], "css": ["src/content/styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["src/background/background.js"]}}