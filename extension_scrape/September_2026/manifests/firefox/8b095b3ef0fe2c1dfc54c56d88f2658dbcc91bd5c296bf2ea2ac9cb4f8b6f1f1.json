{"manifest_version": 3, "name": "PermaZap", "version": "1.3.4", "description": "you click the extension, click an element you hate (cookie bar, sticky header, giant sidebar) and it disappears permanently on that site, under the hood it injects a CSS rule before the page paints so the element never flashes on screen", "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "permazap@felyx.studio", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}