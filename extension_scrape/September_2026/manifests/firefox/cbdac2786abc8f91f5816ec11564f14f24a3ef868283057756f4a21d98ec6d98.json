{"manifest_version": 3, "name": "Homoglyph Guard", "version": "1.0.0", "description": "Highlights lookalike Unicode characters (e.g. Cyrillic '\u0430' vs Latin 'a') in page text and flags links whose domain mixes scripts, to help you spot spoofing/phishing.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Homoglyph Guard"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "homoglyph-guard@groupxyz.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["confusables.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}]}