{"manifest_version": 2, "name": "Tumblr Muter", "version": "1.0.1", "description": "Completely hide posts from specific Tumblr users you follow.", "permissions": ["storage", "*://*.tumblr.com/*"], "content_scripts": [{"matches": ["*://*.tumblr.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Tumblr Muter"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "tumblr-muter@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}