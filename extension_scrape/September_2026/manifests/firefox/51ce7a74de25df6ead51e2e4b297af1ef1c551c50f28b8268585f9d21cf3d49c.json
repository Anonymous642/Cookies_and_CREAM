{"manifest_version": 2, "name": "Emoji-fy Page", "version": "2.2.1.0", "description": "Add a little joy to any page by dropping matching emoji next to words like cat, coffee, fire or rocket. A generosity slider controls how often it happens, and Restore puts the text back.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{c83b1ca2-2fc3-468c-9d70-977c9d283502}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Emoji-fy Page", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}