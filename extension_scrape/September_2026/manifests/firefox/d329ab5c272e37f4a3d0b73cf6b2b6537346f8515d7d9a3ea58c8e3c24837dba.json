{"manifest_version": 3, "name": "Video Transcript Summarizer", "version": "2.0", "description": "Extracts and summarizes transcripts from YouTube and Vimeo using Gemini AI.", "permissions": ["storage", "scripting", "activeTab", "webRequest", "downloads"], "host_permissions": ["*://*.youtube.com/*", "*://*.vimeo.com/*", "*://player.vimeo.com/*", "https://*.googleapis.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "transcript_summarizer@extension.local", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*", "*://player.vimeo.com/video/*"], "js": ["content-scripts/summary-panel.js"], "all_frames": true}, {"matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*"], "js": ["content-scripts/youtube.js"]}, {"matches": ["*://player.vimeo.com/video/*"], "js": ["content-scripts/vimeo.js"], "all_frames": true}]}