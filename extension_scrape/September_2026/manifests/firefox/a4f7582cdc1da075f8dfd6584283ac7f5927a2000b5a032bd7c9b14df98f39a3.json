{"manifest_version": 3, "name": "Attention Budget for YouTube", "version": "0.2.2", "description": "Budget content choices and watch time while keeping deliberate YouTube paths available.", "incognito": "spanning", "permissions": ["storage"], "host_permissions": ["https://i.ytimg.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://i.ytimg.com data:;"}, "background": {"scripts": ["src/domain.js", "src/background.js"]}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "exclude_matches": ["https://music.youtube.com/*"], "css": ["src/content.css"], "js": ["src/domain.js", "src/runtime-messaging.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/history.html"], "matches": ["https://*.youtube.com/*"]}], "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Attention Budget for YouTube", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "attention-budget-for-youtube@lucharo.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}