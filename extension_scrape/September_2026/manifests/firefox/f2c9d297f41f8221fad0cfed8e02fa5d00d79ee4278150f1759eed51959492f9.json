{"manifest_version": 3, "name": "Algoright AI: YouTube, TikTok, IG & X Filter", "version": "6.0", "description": "AI content filter that blocks Shorts, Reels, clickbait, ads & distractions on YouTube, TikTok, Instagram & X.", "icons": {"16": "logo-16.png", "32": "logo-32.png", "48": "logo-48.png", "128": "logo.png"}, "permissions": ["scripting", "storage", "alarms", "declarativeNetRequest"], "host_permissions": ["https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://zyympgdkofabrgukszjy.supabase.co/*", "https://algorightai.com/*", "https://www.algorightai.com/*"], "browser_specific_settings": {"gecko": {"id": "algoright-ai@algorightai.com", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*"], "js": ["i18n.js", "filterHeuristic.js", "content.js", "hud.js"], "css": ["overlay.css"], "run_at": "document_end"}, {"matches": ["https://algorightai.com/*", "https://www.algorightai.com/*"], "js": ["i18n.js", "filterHeuristic.js", "content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js"], "matches": ["<all_urls>"]}]}