{"manifest_version": 3, "name": "Tangia Auto-Join", "version": "4.1", "description": "Auto-sends !join in any Twitch chat when a Tangia party or battle message appears. Works even when unfocused. No login, no account access, no data collected.", "browser_specific_settings": {"gecko": {"id": "tangia-autojoin@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}, "action": {"default_title": "Tangia Auto-Join", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}]}