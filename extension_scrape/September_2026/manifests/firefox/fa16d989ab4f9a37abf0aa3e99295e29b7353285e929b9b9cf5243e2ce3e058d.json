{"manifest_version": 2, "name": "Lazy Zoom", "version": "1.0", "description": "Smooth hover-zoom for images: slowly zooms (default 1.6x) over 0.5s to create a smooth effect.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Lazy Zoom", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "lazyzoom@example.com"}}}