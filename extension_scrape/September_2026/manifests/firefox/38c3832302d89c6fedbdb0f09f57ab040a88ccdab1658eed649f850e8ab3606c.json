{"manifest_version": 3, "name": "Hamax Integration Module", "version": "1.0.6", "description": "Bridges your browser downloads and media to the Hamax Desktop App.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "hamax@hamax.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "authenticationInfo"]}}}, "permissions": ["downloads", "activeTab", "scripting", "contextMenus", "tabs", "webRequest", "storage", "cookies"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["browser-polyfill-shim.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["styles.css"], "js": ["browser-polyfill-shim.js", "content.js"], "all_frames": true}], "action": {"default_title": "Send to Hamax", "default_popup": "popup.html"}}