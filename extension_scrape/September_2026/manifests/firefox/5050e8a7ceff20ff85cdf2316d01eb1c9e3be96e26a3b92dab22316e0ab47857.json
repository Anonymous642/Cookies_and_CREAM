{"manifest_version": 2, "name": "QR Bridge", "version": "1.0.7", "description": "Inserta texto de QR y c\u00f3digos de barras le\u00eddos desde el celular en el cursor de cualquier p\u00e1gina web.", "author": "pochii-dev", "browser_specific_settings": {"gecko": {"id": "qr-bridge@pochii-dev", "strict_min_version": "79.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["<all_urls>", "activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["qrcode.js", "content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["qrcode.js"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "QR Bridge (Panel persistente en pantalla)"}, "sidebar_action": {"default_title": "QR Bridge", "default_panel": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}