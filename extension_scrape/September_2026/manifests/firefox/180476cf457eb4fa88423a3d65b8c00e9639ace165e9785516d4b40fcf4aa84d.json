{"manifest_version": 3, "name": "YouTube My Playlists Bar", "version": "1.0.3", "description": "Adds a customizable My Playlists bar to the YouTube Home and Subscriptions feeds.", "browser_specific_settings": {"gecko": {"id": "youtube-playlists-bar@nir.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}