{"manifest_version": 3, "name": "Nico Comment Flow", "version": "0.1.0", "description": "Show NicoNico-style flowing comments on supported video sites.", "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*", "*://www.youtube.com/embed/*", "*://abema.tv/video/episode/*", "*://tver.jp/episodes/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "nico-comment-flow@makitsukasa.dev", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "host_permissions": ["*://www.nicovideo.jp/*", "*://public.nvcomment.nicovideo.jp/*", "*://nvcomment.nicovideo.jp/*", "*://snapshot.search.nicovideo.jp/*"]}