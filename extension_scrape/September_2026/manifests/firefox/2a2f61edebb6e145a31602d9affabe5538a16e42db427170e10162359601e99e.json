{"manifest_version": 3, "name": "WriteAlt - AI Alt Text Generator", "short_name": "WriteAlt", "version": "1.0.0", "description": "Generate SEO-friendly AI alt text for browser images in 130+ languages.", "homepage_url": "https://writealt.com", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "64": "assets/icons/icon-64.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png", "256": "assets/icons/icon-256.png"}, "action": {"default_title": "WriteAlt - AI Alt Text Generator", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "64": "assets/icons/icon-64.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png", "256": "assets/icons/icon-256.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["platform.js", "languages.js", "api.js", "background.js"]}, "permissions": ["activeTab", "clipboardWrite", "contextMenus", "notifications", "scripting", "storage"], "host_permissions": ["https://writealt.com/*", "https://*/*", "http://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https: http:; connect-src https://writealt.com https://wsrv.nl https: http:;"}, "browser_specific_settings": {"gecko": {"id": "writealt@writealt.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}