{"manifest_version": 3, "name": "ZenBreak", "version": "1.0.0", "author": "dendarrion", "description": "Rest, hydrate, move. A simple break reminder for focus and health.", "permissions": ["alarms", "storage", "notifications", "tabs"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "ZenBreak"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["reminder.html", "reminder.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "zenbreak-extension@dev.dendarrion.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}