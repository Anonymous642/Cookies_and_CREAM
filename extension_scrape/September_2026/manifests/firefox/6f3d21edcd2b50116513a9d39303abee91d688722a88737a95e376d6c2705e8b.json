{"manifest_version": 3, "name": "Improvinator", "version": "2.5", "description": "Customize the appearance and behavior of your favorite websites by easily injecting custom CSS and JavaScript through URL pattern-based rules.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "activeTab", "storage", "scripting", "sessions"], "host_permissions": ["<all_urls>"], "action": {"default_icon": "icons/icon-48.png", "default_title": "Improvinator"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"]}], "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "browser_specific_settings": {"gecko": {"id": "jochumchristophe@gmail.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}