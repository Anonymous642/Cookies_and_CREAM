{"manifest_version": 2, "name": "Error Toast", "version": "2.0", "description": "Affiche les erreurs et warnings des sites web dans un toast", "icons": {"48": "icon48.png", "96": "icon96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "permissions": ["storage", "webRequest", "<all_urls>"], "web_accessible_resources": ["page-script.js"], "browser_action": {"default_icon": {"48": "icon48.png", "96": "icon96.png"}, "default_popup": "popup.html", "default_title": "Error Toast"}, "browser_specific_settings": {"gecko": {"id": "error-toast@czsyn.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}