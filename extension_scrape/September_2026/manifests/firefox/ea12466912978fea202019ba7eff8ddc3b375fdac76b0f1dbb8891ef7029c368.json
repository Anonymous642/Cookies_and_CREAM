{"manifest_version": 3, "name": "Image URL Collector", "version": "1.1.1", "author": "Arashk Rajabpour", "homepage_url": "https://github.com/arashkrjp/image-url-collector/", "description": "Collects unique image URLs matching your selected CSS classes after you enable it.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "icons": {"48": "icon.png", "96": "icon.png"}, "action": {"default_title": "Image URL Collector", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "96": "icon.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "image-url-collector@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}