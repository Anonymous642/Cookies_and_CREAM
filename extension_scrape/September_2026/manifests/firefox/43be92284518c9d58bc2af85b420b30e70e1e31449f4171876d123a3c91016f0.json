{"manifest_version": 2, "name": "Olungu - AI-powered Distraction Blocker", "description": "AI website blocker for focused browser work. Blocks distractions by context while keeping docs, research, and tools open.", "version": "0.45.4", "short_name": "Olungu", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "webNavigation", "contextMenus", "notifications", "alarms", "idle", "http://*/*", "https://*/*"], "web_accessible_resources": ["mascot-ok.webp", "mascot-error.webp", "mascot_checking.webp"], "browser_specific_settings": {"gecko": {"id": "olungu@olungu.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "searchTerms"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "browser_action": {}}