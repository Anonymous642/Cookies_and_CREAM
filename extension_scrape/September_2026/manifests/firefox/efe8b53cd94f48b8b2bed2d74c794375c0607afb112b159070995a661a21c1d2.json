{"manifest_version": 3, "name": "ReddPost - Reddit post and content manager", "description": "Plan, organize, and publish subreddit content with an assisted posting workflow.", "version": "1.1.0", "permissions": ["storage", "tabs", "scripting", "identity"], "host_permissions": ["*://*.reddit.com/*", "*://reddit.com/*", "*://*.redgifs.com/*", "*://redgifs.com/*", "https://jmgryqnxecgkkocoqjeb.supabase.co/*"], "icons": {"16": "ico/16.png", "32": "ico/32.png", "48": "ico/48.png", "128": "ico/128.png"}, "action": {"default_title": "Reddit post assistant & content manager", "default_icon": {"16": "ico/16.png", "32": "ico/32.png", "48": "ico/48.png", "128": "ico/128.png"}}, "background": {"scripts": ["src/shared/utils.js", "src/shared/db.js", "src/shared/engine.js", "src/shared/subredditMetadata.js", "src/shared/watermark.js", "src/shared/image-transform.js", "src/shared/supabaseClient.js", "src/shared/auth.js", "src/shared/accountStatus.js", "src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "reddpost-assistant@local", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.redgifs.com/*", "*://redgifs.com/*"], "js": ["src/content/redgifs.js"], "run_at": "document_idle"}, {"matches": ["*://*.reddit.com/*", "*://reddit.com/*"], "js": ["src/content/reddit-common.js", "src/content/reddit-bootstrap.js", "src/content/reddit-submit.js"], "run_at": "document_start"}]}