{"manifest_version": 3, "name": "PIKA PRANK", "short_name": "PIKA PRANK", "version": "1.0.0", "description": "Rewrites visible text as pika and swaps images using your list. Runs automatically when the browser or extension starts, when you open or finish loading an http(s) tab, and on demand via the toolbar icon.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "pikaprank@local", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "PIKA PRANK: pika text & Pikachu images", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "content/imageList.json"], "matches": ["<all_urls>"]}]}