{"manifest_version": 3, "name": "ChatSnap", "short_name": "ChatSnap", "description": "Export AI chat conversations from Claude, ChatGPT, Gemini, Grok and more to Markdown in one click.", "version": "1.0.0", "icons": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "ChatSnap \u2014 Export this chat"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://claude.ai/*", "*://chat.openai.com/*", "*://gemini.google.com/*", "*://grok.com/*", "*://www.grok.com/*", "*://perplexity.ai/*", "*://www.perplexity.ai/*", "*://copilot.microsoft.com/*", "*://chat.deepseek.com/*"], "js": ["lib/browser-polyfill.min.js", "content.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "downloads"], "browser_specific_settings": {"gecko": {"id": "chatsnap@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}