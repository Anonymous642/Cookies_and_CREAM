{"manifest_version": 3, "name": "Akralys: Themes & UI Styles for ChatGPT", "version": "1.0.2", "description": "Akralys: Customize ChatGPT with custom themes, advanced UI tweaks and powerful tools. Export to PDF, edit fonts and colors live.", "author": "Vadym Trebushnyi(CepeshRC)", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_start"}], "sidebar_action": {"default_panel": "popup.html", "default_title": "Open Akralys", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Open Akralys Sidebar"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["themes/*.css", "themes/*.js", "theme-backgrounds/*", "assets/vendor/bootstrap/bootstrap.min.css", "assets/vendor/fontawesome/css/all.min.css", "assets/vendor/bootstrap-slider/bootstrap-slider.min.css", "assets/vendor/html2pdf/html2pdf.bundle.min.js", "assets/fonts/inter/*.ttf", "assets/fonts/orbiton/*.ttf", "assets/fonts/montserrat/*.ttf", "assets/fonts/matrix-code-nfi/*.ttf", "assets/fonts/roboto-mono/*.ttf", "popup.css", "akralys.html", "akralys.css", "akralys.js", "icons/icon128.png"], "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]}], "browser_specific_settings": {"gecko": {"id": "akralys@cepeshrc", "strict_min_version": "109.0"}}}