{"manifest_version": 3, "name": "Better Keydrop", "version": "0.1.2", "description": "Analyze loaded cases, calculate EV metrics, and store the latest case data locally.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "better_keydrop@local.dev", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://key-drop.com/*", "*://keydrop.com/*", "*://*.key-drop.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://key-drop.com/*", "*://keydrop.com/*", "*://*.key-drop.com/*"], "js": ["lib/caseDataHub.js", "caseDetailsLoader.js", "content.js"], "css": ["styles/badges.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["lib/presetData.json"], "matches": ["*://key-drop.com/*"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "KeyDrop Case Analyzer"}}