{"manifest_version": 2, "name": "Force Paste \u2014 Unblock Copy, Cut & Paste", "version": "1.0.0", "description": "Stops websites from blocking paste, copy, cut, right-click, and text selection \u2014 handy for password managers and forms that disable pasting.", "browser_specific_settings": {"gecko": {"id": "force-paste@example.local", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Force Paste"}, "web_accessible_resources": ["main-world.js"], "content_scripts": [{"matches": ["<all_urls>"], "css": ["force-select.css"], "js": ["content-bridge.js"], "run_at": "document_start", "all_frames": true}]}