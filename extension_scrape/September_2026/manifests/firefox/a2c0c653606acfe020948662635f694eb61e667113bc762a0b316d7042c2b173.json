{"manifest_version": 3, "name": "Copiador de Estilos", "version": "0.1.0", "description": "Clique em qualquer elemento de um site e copie o CSS dele (cores, fontes, espa\u00e7amentos). Mostra tamb\u00e9m a paleta e as fontes da p\u00e1gina.", "action": {"default_title": "Copiador de Estilos", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "copiador@nshowdebola-ctrl.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}