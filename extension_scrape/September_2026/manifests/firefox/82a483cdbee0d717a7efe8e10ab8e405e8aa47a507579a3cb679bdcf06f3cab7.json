{"manifest_version": 3, "name": "LockShield", "version": "1.0", "description": "Generate and manage strong, unique passwords for each website.", "browser_specific_settings": {"gecko": {"id": "lockshield@example.com"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "permissions": ["storage", "activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}