{"manifest_version": 3, "name": "Video Downloader", "version": "1.1.1", "description": "Background downloader extension connected to local MediaStation backend.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*/*", "http://localhost:20552/*", "ws://localhost:20552/*"], "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["*://*.pornhub.com/*"], "js": ["dist/content.js"], "css": ["src/content.css"]}], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "video-downloader@mediastation.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}