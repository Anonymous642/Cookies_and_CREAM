{"manifest_version": 2, "name": "Ask Ollama", "version": "1.1.0", "description": "Right-click selected text to send it to your local Ollama instance, prepended with a customizable prompt. Response appears in an overlay on the page.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["contextMenus", "storage", "http://localhost:11434/*", "http://127.0.0.1:11434/*"], "optional_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "ask-ollama@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}