{"manifest_version": 3, "name": "TranslatePlus - Real Time Translation API", "version": "2.0.0", "description": "Translate selected text on any website using TranslatePlus.io API - Real Time Translation API", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://api.translateplus.io/*", "https://*.translateplus.io/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "translateplus@translateplus.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "info_url": "https://translateplus.io/privacy-policy"}}}}