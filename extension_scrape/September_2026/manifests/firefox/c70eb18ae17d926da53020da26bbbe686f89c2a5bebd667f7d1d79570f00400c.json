{"manifest_version": 2, "name": "Backlink Link Type Checker", "version": "1.0", "description": "A lightweight tool that checks links on the current page and shows whether they are dofollow, nofollow, sponsored, or UGC.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Backlink Link Type Checker", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "backlink-link-type-checker@seoarabia.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}