{"manifest_version": 3, "name": "Social AI Assistant", "version": "0.2.0", "description": "Like comments and reply to your subscribers with AI across YouTube, Instagram, X/Twitter, Facebook, TikTok and LinkedIn.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "*://*.linkedin.com/*", "https://api.openai.com/*", "https://api.groq.com/*", "https://openrouter.ai/*", "https://api.deepseek.com/*", "https://api.mistral.ai/*", "https://generativelanguage.googleapis.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "*://*.linkedin.com/*"], "js": ["src/content/core.js", "src/content/platforms/youtube.js", "src/content/platforms/twitter.js", "src/content/platforms/tiktok.js", "src/content/platforms/instagram.js", "src/content/platforms/facebook.js", "src/content/platforms/linkedin.js", "src/content/adapters.js", "src/content/ui.js", "src/content/main.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Social AI Assistant", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "social-ai-assistant@users.noreply.github.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}