{"manifest_version": 3, "name": "DemoLens for FACEIT", "version": "0.4.27", "description": "Watch FACEIT CS2 demos in DemoLens with one click \u2014 plus live scouting stats, map win rates and Elo tiers in match rooms.", "permissions": ["downloads", "storage", "clipboardWrite", "webRequest", "webRequestBlocking"], "host_permissions": ["https://*.backblazeb2.com/*", "https://*.faceit-cdn.net/*", "https://api.faceit.com/*", "https://demolens.org/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "DemoLens"}, "content_scripts": [{"matches": ["https://www.faceit.com/*"], "js": ["i18n.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["flags/*.png"], "matches": ["https://www.faceit.com/*"]}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "demolens-for-faceit@demolens.org", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["none"]}}}}