{"manifest_version": 2, "name": "IspeedProxy Manager", "version": "1.7", "description": "Proxy manager: HTTP/HTTPS/SOCKS4/SOCKS5 with auth, auto timezone spoofing, WebRTC leak protection, country flags.", "incognito": "spanning", "permissions": ["proxy", "storage", "<all_urls>", "webRequest", "webRequestBlocking", "privacy"], "browser_action": {"default_popup": "index.html", "default_icon": "img/icon_default.png"}, "icons": {"96": "img/icon_extension.png"}, "background": {"scripts": ["./background.js"], "persistent": true}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"strict_min_version": "128.0", "id": "ispeedproxy@ispeedproxy.com", "data_collection_permissions": {"required": ["none"]}}}}