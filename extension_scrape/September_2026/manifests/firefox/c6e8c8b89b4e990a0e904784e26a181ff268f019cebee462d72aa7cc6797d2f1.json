{"manifest_version": 3, "name": "Custom Video Speed Controller", "version": "1.0", "description": "Speed up HTML5 videos beyond the standard limit.", "browser_specific_settings": {"gecko": {"id": "video-speed-controller@yourdomain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icons/icon.png", "96": "icons/icon.png", "128": "icons/icon.png"}, "action": {"default_popup": "popup.html", "default_title": "Video Speed Controller", "default_icon": {"48": "icons/icon.png"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_end"}]}