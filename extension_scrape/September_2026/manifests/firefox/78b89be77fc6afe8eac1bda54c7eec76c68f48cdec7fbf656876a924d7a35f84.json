{"manifest_version": 2, "name": "Google Docs & Sheets Dark Mode", "version": "1.0.0", "description": "Toggle dark mode for Google Docs and Google Sheets.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "*://docs.google.com/*"], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Docs/Sheets Dark Mode", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://docs.google.com/document/*", "*://docs.google.com/spreadsheets/*"], "js": ["content/content.js"], "css": ["content/dark-mode.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "gdocs-sheets-dark-mode@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}