{"manifest_version": 3, "name": "WhatsOffice", "version": "0.2.3", "description": "Local-only Firefox add-on that restyles WhatsApp Web as a generic office mail client.", "permissions": ["storage"], "host_permissions": ["https://web.whatsapp.com/*"], "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "css": ["content/office.css"], "js": ["content/selectorMap.js", "content/content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "WhatsOffice", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "commands": {"toggle-workface": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle the WhatsOffice skin"}}, "browser_specific_settings": {"gecko": {"id": "whatsoffice@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}