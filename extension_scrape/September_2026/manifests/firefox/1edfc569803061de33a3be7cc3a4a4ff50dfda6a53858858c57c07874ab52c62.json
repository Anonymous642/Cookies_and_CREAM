{"manifest_version": 3, "name": "Re-Download - Smart Download Manager", "version": "1.0.1", "description": "Detects duplicate downloads before they happen using smart score-based matching and helps you decide: Open Existing, Download Again, or Cancel.", "permissions": ["downloads", "downloads.shelf", "downloads.open", "storage", "tabs", "notifications", "activeTab"], "host_permissions": ["<all_urls>", "file:///*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["decision.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "re-download@yourdomain.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}