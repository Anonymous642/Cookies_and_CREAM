{"manifest_version": 3, "name": "Ryker \u2014 YouTube AI Tools", "version": "1.1.0", "description": "AI-powered YouTube growth tools: descriptions, SEO, thumbnails, retention analysis, and more \u2014 right inside YouTube.", "browser_specific_settings": {"gecko": {"id": "ryker@ryker.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://studio.youtube.com/*", "https://www.ryker.me/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "sidebar/sidebar.html", "default_title": "Ryker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles/content.css"], "run_at": "document_idle"}, {"matches": ["https://studio.youtube.com/*"], "js": ["content-studio.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["sidebar/sidebar.html", "icons/*"], "matches": ["https://www.youtube.com/*", "https://studio.youtube.com/*"]}]}