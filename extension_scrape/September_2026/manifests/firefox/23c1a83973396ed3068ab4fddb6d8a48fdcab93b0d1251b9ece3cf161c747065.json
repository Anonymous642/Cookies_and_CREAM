{"manifest_version": 3, "name": "mark_me", "version": "1.1.0", "description": "Save and organize bookmarks with AI assistance. Quick-save from any page, search from a beautiful New Tab.", "author": "Ajibola Akelebe", "action": {"default_popup": "popup.html", "default_title": "Save to mark_me", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "storage", "contextMenus", "alarms", "notifications"], "host_permissions": ["https://markme-app.vercel.app/*"], "content_scripts": [{"matches": ["https://markme-app.vercel.app/extension-auth*"], "js": ["content/auth-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "extension@markme.live", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"]}}}}