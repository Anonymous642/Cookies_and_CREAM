{"manifest_version": 3, "name": "QuickChord Finder", "description": "Instantly identify and display guitar or piano chords from any song playing in your browser.", "version": "1.0.0", "author": "MusicTech Labs", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quickchordfinder@musictechlabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}