{"manifest_version": 3, "name": "EveryBlock", "version": "1.1.0", "description": "Privacy-first modular web experience enhancer.", "icons": {"48": "icons/everyblock.svg", "96": "icons/everyblock.svg"}, "permissions": ["storage", "notifications"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background/background.js"]}, "action": {"default_title": "EveryBlock", "default_popup": "popup/index.html", "default_icon": "icons/everyblock.svg"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["content/page-permission-guard.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "everyblock@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}