{"manifest_version": 3, "name": "Reddit Random Post", "version": "0.1.0", "description": "Click the toolbar button while on a subreddit to jump to a random post from it.", "browser_specific_settings": {"gecko": {"id": "reddit-random-post@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "notifications"], "host_permissions": ["*://*.reddit.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Random post from this subreddit", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"]}}