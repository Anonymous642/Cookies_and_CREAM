{"manifest_version": 3, "name": "Vyprae", "version": "1.0.17", "description": "Blocage de sites par quotas et horaires de restriction", "permissions": ["storage", "tabs", "alarms", "notifications", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "action": {"default_title": "Vyprae \u2014 Ouvrir l\u2019extension", "default_icon": "Logo vyprae icon.png"}, "page_action": {"default_title": "Vyprae \u2014 Bloquer temporairement ce site", "default_icon": "Logo vyprae icon rouge.png", "default_popup": "temporary-block.html"}, "icons": {"128": "Logo vyprae icon.png"}, "background": {"scripts": ["shared.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["youtube-shorts-blocker.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "vyprae@local", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_browsing_data": false, "collects_health_data": false, "collects_financial_data": false, "collects_location_data": false, "collects_user_activity_data": false}}}}