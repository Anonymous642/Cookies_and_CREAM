{"manifest_version": 3, "name": "CopyKit", "version": "1.0.0", "author": "Mohamed JOUINI", "homepage_url": "https://addons.mozilla.org/addon/copy-kit", "developer": {"name": "Mohamed JOUINI", "url": "https://github.com/amad3v/CopyKit"}, "browser_specific_settings": {"gecko": {"id": "copykit@amad3v.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "A useful tool for web links.\nFeatures:\nCopy as plain text.\nCopy as HTML source.\nCopy Link Name & URLs.\nCopy Tab Name & URLs.\nAnalyze image/page URLs.", "default_locale": "en", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["menus", "tabs", "activeTab", "clipboardWrite", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["common.js", "background.js"]}, "content_scripts": [{"js": ["common.js", "content.js"], "matches": ["<all_urls>"], "match_about_blank": true, "all_frames": true}], "options_ui": {"page": "options.html"}, "web_accessible_resources": [{"resources": ["_locales/*.json"], "matches": ["<all_urls>"]}], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "CopyKit"}, "commands": {"command_action": {"suggested_key": {"default": "F8"}}}}