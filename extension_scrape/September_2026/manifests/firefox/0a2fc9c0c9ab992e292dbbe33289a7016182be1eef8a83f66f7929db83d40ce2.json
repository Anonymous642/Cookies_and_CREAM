{"manifest_version": 2, "name": "Dekhtei Hobe", "version": "1.0", "description": "Track and resume YouTube videos", "permissions": ["storage", "activeTab", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "dekhtei-hobe@extension.local", "data_collection_permissions": {"required": ["websiteActivity"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.png"}}