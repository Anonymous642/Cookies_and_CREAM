{"manifest_version": 2, "name": "GMGN+", "version": "0.3.1", "description": "GMGN Solana helper", "browser_specific_settings": {"gecko": {"id": "gmgn-plus@local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_action": {"default_title": "GMGN+", "default_popup": "src/popup/popup.html"}, "background": {"scripts": ["src/background/worker.js"], "persistent": false}, "permissions": ["storage", "<all_urls>"], "content_scripts": [{"matches": ["*://gmgn.ai/*"], "js": ["src/content/inject.js"], "css": ["src/styles/inject.css"], "run_at": "document_idle"}]}