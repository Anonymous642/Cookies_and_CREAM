{"manifest_version": 2, "name": "X to XCancel Redirector", "version": "1.0", "description": "Redirects x.com and twitter.com to xcancel.com with manual Nitter fallback", "browser_specific_settings": {"gecko": {"id": "xcancel-redirector@pojgorskihtica.in.rs", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "*://x.com/*", "*://www.x.com/*", "*://twitter.com/*", "*://www.twitter.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "X to XCancel Redirector", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "64": "icon-64.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "64": "icon-64.png"}}