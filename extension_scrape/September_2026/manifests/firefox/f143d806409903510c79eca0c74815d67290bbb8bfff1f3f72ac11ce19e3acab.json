{"manifest_version": 3, "name": "Twitch VOD Bookmarks", "version": "1.0.0", "description": "Bookmark moments while watching a Twitch stream live, then jump straight to them when you watch the VOD.", "author": "araise", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.twitch.tv/*", "*://gql.twitch.tv/*"], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Twitch VOD Bookmarks", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "{d01fe2ac-ecc2-4f8b-9595-fc5d0b457665}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}