{"manifest_version": 3, "name": "Meesho Review Finder - Phoenix", "version": "1.0.0", "description": "Find and highlight reviews by any reviewer name on Meesho product pages. Scans up to 3000 reviews, shows matched reviews with jump-to-replica feature.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.meesho.com/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["*://www.meesho.com/*/p/*", "*://www.meesho.com/s/p/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "meesho-review-finder@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "action": {"default_title": "Open Meesho Review Finder - Phoenix", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}