{"manifest_version": 3, "name": "Stop Roblox Slop", "version": "1.0", "description": "Removes low quality games from Roblox charts and search.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "stop-roblox-slop@robloxfilter", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["filter.js"]}]}