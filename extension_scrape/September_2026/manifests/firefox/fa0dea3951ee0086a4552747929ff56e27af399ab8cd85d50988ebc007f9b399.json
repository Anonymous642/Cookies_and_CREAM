{"manifest_version": 3, "name": "BowerBird - Declutter Any Page", "version": "1.0.0", "description": "Hide cookie banners, popups and clutter for good. Blocks ads and trackers without asking to read every site you visit.", "permissions": ["declarativeNetRequest", "storage", "scripting", "activeTab", "contextMenus"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "core-ads", "enabled": true, "path": "rules/core-ads.json"}, {"id": "core-tracking", "enabled": true, "path": "rules/core-tracking.json"}, {"id": "annoy-cookies", "enabled": true, "path": "rules/annoy-cookies.json"}, {"id": "annoy-popups", "enabled": true, "path": "rules/annoy-popups.json"}, {"id": "malware", "enabled": true, "path": "rules/malware.json"}, {"id": "annoy-social", "enabled": false, "path": "rules/annoy-social.json"}, {"id": "regional-de", "enabled": false, "path": "rules/regional-de.json"}, {"id": "regional-fr", "enabled": false, "path": "rules/regional-fr.json"}, {"id": "regional-es", "enabled": false, "path": "rules/regional-es.json"}, {"id": "regional-ru", "enabled": false, "path": "rules/regional-ru.json"}]}, "web_accessible_resources": [{"resources": ["cosmetic/*"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "bowerbird@hakeemify.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}