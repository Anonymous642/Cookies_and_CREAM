{"manifest_version": 2, "name": "Korben News Tab", "version": "1.4.1", "description": "Affiche les derni\u00e8res news de korben.info dans un nouvel onglet", "author": "Korben", "homepage_url": "https://github.com/korben00/korben-extension-new-tab", "browser_specific_settings": {"gecko": {"id": "korben-news-tab-v2@korben.info", "strict_min_version": "71.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://korben.info/*", "https://www.youtube.com/feeds/*", "storage", "alarms"], "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' https://korben.info https://*.ytimg.com https://www.youtube.com", "web_accessible_resources": ["img/*", "icons/*"], "background": {"scripts": ["js/background.js"], "persistent": false}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}}