{"manifest_version": 2, "name": "Watch in Stremio", "version": "1.0.0", "description": "Detects the movie or show you're viewing and opens it in Stremio (app or web) with one click.", "icons": {"32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "watch-in-stremio@arlandi.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Watch in Stremio", "default_popup": "popup.html", "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}