{"manifest_version": 2, "name": "TabPilot", "version": "1.0.0", "description": "Granular automatic tab switching: timed rotation, scheduled times, keyword and audio/load triggers.", "homepage_url": "https://rorapaw.com", "browser_specific_settings": {"gecko": {"id": "tabpilot@rorapaw.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "alarms"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "TabPilot", "default_popup": "popup.html", "default_icon": {"32": "icon.svg"}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "commands": {"toggle-rotation": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start/stop tab rotation"}}}