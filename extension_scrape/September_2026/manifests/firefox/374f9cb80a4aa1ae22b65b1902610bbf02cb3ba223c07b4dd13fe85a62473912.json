{"manifest_version": 2, "name": "Idea Compression Tool", "version": "1.3", "description": "Compresses long ideas and complex text into concise, easy-to-understand summaries.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_title": "Idea Compression Tool", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Idea-Compression-Tool", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}