{"manifest_version": 2, "name": "Word Cloud", "version": "2.2.0", "description": "Visualize the most frequent words on any page as a colorful word cloud, sized by how often each word appears. Click a word in the cloud to highlight and jump to it on the page.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{60eb9888-4cbf-4e29-8c4a-482f5635d4c2}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Word Cloud", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}