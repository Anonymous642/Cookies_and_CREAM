{"manifest_version": 3, "name": "Old Reddit Switch", "version": "0.1.5", "description": "One\u2011click switcher: instantly load the classic old.reddit.com interface on every Reddit page for a faster load. 100% private - no personal data is collected by this extension.", "permissions": ["webRequest", "webRequestBlocking", "storage", "notifications"], "host_permissions": ["*://reddit.com/*", "*://*.reddit.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "switch@old-reddit", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Toggle Switch for Old Reddit", "default_icon": {"16": "icons/off.svg", "32": "icons/off.svg", "48": "icons/off.svg", "128": "icons/off.svg"}}, "icons": {"16": "icons/on.svg", "48": "icons/on.svg", "128": "icons/on.svg"}}