{"manifest_version": 2, "name": "Ambient Website DJ", "version": "1.0", "description": "Analyze a page's dominant color and play a matching ambient soundtrack (Chill, Rock/Electronic, Piano).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Ambient Website DJ", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "ambientdj@example.com"}}}