{"manifest_version": 3, "name": "Web App Tabs for Firefox", "version": "0.3.0", "description": "Open multiple tabs inside native Firefox web app windows.", "author": "Raj Piskala", "permissions": ["activeTab", "menus"], "background": {"scripts": ["lib.js", "background.js"]}, "action": {"default_icon": "icons/icon.svg", "default_popup": "popup.html", "default_title": "Web App Tabs for Firefox"}, "commands": {"open-web-app-tab": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open another tab in the current Firefox window"}}, "icons": {"32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "@web-app-tabs.raj-piskala", "strict_min_version": "143.0", "data_collection_permissions": {"required": ["none"]}}}}