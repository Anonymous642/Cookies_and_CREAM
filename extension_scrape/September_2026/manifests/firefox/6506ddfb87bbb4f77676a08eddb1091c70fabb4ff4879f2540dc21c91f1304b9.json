{"manifest_version": 3, "name": "Browser Sync", "version": "1.0.2", "description": "Self-hosted sync for history and bookmarks across all your browsers", "permissions": ["history", "bookmarks", "storage", "tabs", "sessions", "webNavigation", "topSites", "management", "browserSettings", "privacy", "alarms", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["crypto-js.min.js", "plugin_sync.js", "preference_sync.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Browser Sync Status"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "browsersync@agostinelli.eu", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["bookmarksInfo", "browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}