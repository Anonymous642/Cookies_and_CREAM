{"manifest_version": 3, "name": "PrivateOrganizer Toolbox", "version": "1.0.0", "description": "Quick access to your PrivateOrganizer toolbox \u2014 save bookmarks, create tasks, clip notes.", "browser_specific_settings": {"gecko": {"id": "toolbox@puffen.org", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs"], "host_permissions": ["https://toolbox.puffen.org/*"], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"save-bookmark": {"suggested_key": {"default": "Alt+B"}, "description": "Quick save bookmark"}, "add-task": {"suggested_key": {"default": "Alt+T"}, "description": "Quick add task"}, "add-note": {"suggested_key": {"default": "Alt+N"}, "description": "Quick add note"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}