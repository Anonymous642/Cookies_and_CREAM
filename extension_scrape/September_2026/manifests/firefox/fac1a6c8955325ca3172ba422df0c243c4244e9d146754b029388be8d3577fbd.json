{"manifest_version": 3, "name": "CoreAsia Download Manager", "version": "1.9.0", "description": "Companion for the CoreAsia Download Manager desktop app: sends a page's download link to the app running locally (127.0.0.1).", "permissions": ["downloads", "contextMenus", "storage", "cookies", "alarms", "tabs", "webRequest", "webNavigation", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"download-page": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Download the current page with CoreAsia"}, "download-audio": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Download audio only (MP3) from the current page"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["blob-hook.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "js": ["blob-bridge.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "CoreAsia Download Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "cadm@coreasia.id", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}