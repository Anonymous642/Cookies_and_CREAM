{"manifest_version": 3, "name": "Domain Details: WHOIS & Domains", "description": "Research the current domain or a domain shown on marketplace landers. View registration data, sale listings, and observed history.", "version": "2.0.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "contextMenus", "scripting", "storage"], "host_permissions": ["https://api.domaindetails.com/*", "https://ext.domaindetails.com/*", "https://f.domaindetails.com/*"], "action": {"default_title": "Domain Details", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "domain-details@simplebytes.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}}