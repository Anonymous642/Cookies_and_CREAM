{"manifest_version": 2, "name": "YT Clipper", "version": "1.3.2", "description": "Mark in/out points on a YouTube video and record the segment to a downloadable clip.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["downloads", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-clipper@shane.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}