{"manifest_version": 3, "name": "QuickCast - Screen Recorder", "version": "1.4.2", "default_locale": "en", "description": "Screen recorder with tab/full-screen capture, circular webcam bubble, pre-flight mic check, telemetry HUD, and 1-click cloud share.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "QuickCast", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "tabs", "storage", "downloads", "clipboardWrite"], "host_permissions": ["https://quickcast-r2-uploader.admettre.workers.dev/*", "*://*/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quickcast@admettre.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}