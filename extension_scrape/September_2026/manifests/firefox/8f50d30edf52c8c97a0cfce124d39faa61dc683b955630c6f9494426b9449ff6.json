{"manifest_version": 3, "name": "SoftAware AI Form Filler", "version": "1.2", "description": "Auto-fill web forms using the SoftAware AI API.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://softaware.net.za/*", "*://*/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "AI Form Filler", "default_icon": "icon-48.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "testing-ai@softaware.net.za", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}