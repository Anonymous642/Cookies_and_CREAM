{"manifest_version": 2, "name": "Quiz Every 15 Minutes", "version": "1.0", "description": "Show a tiny multiple-choice quiz every 15 minutes to keep you alert. If unanswered, dim the screen for 5s.", "permissions": ["alarms", "notifications", "storage", "activeTab"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "QuizEvery15", "default_popup": "popup.html"}, "icons": {"48": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "quiz15@example.com", "data_collection_permissions": {"required": ["none"]}}}}