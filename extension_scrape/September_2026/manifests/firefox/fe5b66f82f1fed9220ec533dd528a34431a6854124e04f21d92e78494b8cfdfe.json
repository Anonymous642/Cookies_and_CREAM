{"manifest_version": 3, "name": "Shelf Zero", "description": "Save the page you're on to Shelf Zero - a 25-slot read-it-or-lose-it shelf with AI summaries.", "version": "1.0.0", "action": {"default_popup": "popup.html", "default_title": "Save to Shelf Zero"}, "background": {"scripts": ["api.js", "background.js"]}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://app.shelfzero.app/*"], "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to Shelf Zero"}}, "browser_specific_settings": {"gecko": {"id": "extension@shelfzero.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}