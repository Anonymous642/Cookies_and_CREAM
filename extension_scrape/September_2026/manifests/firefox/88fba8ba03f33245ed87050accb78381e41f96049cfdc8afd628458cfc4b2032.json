{"manifest_version": 2, "name": "Auto Scroll Toggle", "version": "1.0", "description": "B\u1eadt/t\u1eaft t\u1ef1 \u0111\u1ed9ng cu\u1ed9n trang v\u1edbi t\u1ed1c \u0111\u1ed9 t\u00f9y ch\u1ec9nh. Kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Auto Scroll", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@auto-scroll-toggle", "data_collection_permissions": {"required": ["none"]}}}}