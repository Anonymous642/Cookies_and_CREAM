{"manifest_version": 3, "name": "Mortar: Real Estate Deal Analyzer", "short_name": "Mortar", "version": "1.1.5", "description": "Open a listing on Zillow, Redfin, Realtor.com, or Homes.com. Mortar reads the numbers, tells you if the deal is worth it.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Mortar", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "host_permissions": ["https://mortar-api-z8uo.vercel.app/*", "https://*.zillow.com/*"], "content_scripts": [{"matches": ["https://*.zillow.com/*"], "js": ["content/onboarding-tour.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/mortar-idle.png", "assets/mortar-buy.png", "assets/mortar-investigate.png", "assets/mortar-pass.png"], "matches": ["https://*.zillow.com/*"]}], "permissions": ["storage", "activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "mortar@bricks.investments", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["authenticationInfo"]}}}}