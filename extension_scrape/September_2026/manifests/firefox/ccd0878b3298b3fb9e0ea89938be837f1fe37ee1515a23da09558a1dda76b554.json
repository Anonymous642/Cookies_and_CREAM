{"manifest_version": 3, "name": "Goupil Check", "description": "Situe le prix d'une annonce dans la fourchette du quartier (open data) : un fait sur le prix, jamais un avis sur le bien.", "version": "1.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://askgoupil.fr/*", "https://www.seloger.com/*", "https://www.leboncoin.fr/*", "https://www.pap.fr/*", "https://www.bienici.com/*", "https://www.logic-immo.com/*"], "browser_specific_settings": {"gecko": {"id": "goupil-check@askgoupil.fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Goupil Check", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.bienici.com/*", "https://www.leboncoin.fr/*", "https://www.logic-immo.com/*", "https://www.pap.fr/*", "https://www.seloger.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}