{"manifest_version": 3, "name": "DuckDuckGo to Google Button", "version": "1.0", "description": "Injects a Google button next to the DuckDuckGo search icon.", "content_scripts": [{"matches": ["*://duckduckgo.com/*", "*://*.duckduckgo.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ddg-google-injector@custom.extension", "data_collection_permissions": {"required": ["none"]}}}}