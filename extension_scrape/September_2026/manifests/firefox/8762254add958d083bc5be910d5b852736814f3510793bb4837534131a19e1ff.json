{"manifest_version": 2, "name": "Quick Tab Switcher", "version": "1.0", "description": "Switch tabs quickly using a popup with keyboard search.", "permissions": ["tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-tab-switcher": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Open tab switcher popup"}}, "browser_specific_settings": {"gecko": {"id": "quick-tab-switcher@example.com", "strict_min_version": "91.0"}}}