{"manifest_version": 3, "name": "Teleflow Helper", "version": "2.8.6", "description": "Extracts YouTube transcripts for Teleflow with advanced UI integration", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://localhost/*", "*://*.teleflow.live/*", "*://*.teleflow.co/*", "*://*.vercel.app/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_panel": "sidepanel/index.html", "default_icon": "icons/icon128.png", "default_title": "Teleflow Helper"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/transcript-button.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content/channel-button.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content/video-card-button.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content_main.js"], "world": "MAIN"}], "browser_specific_settings": {"gecko": {"id": "helper@teleflow.live", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}