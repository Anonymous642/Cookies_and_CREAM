{"manifest_version": 2, "name": "YouTube Radio Remover", "version": "1.0", "description": "Redirects YouTube links removing list & start_radio.", "icons": {"48": "icons/nyrd-48.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "permissions": ["webRequest", "webRequestBlocking", "*://*.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://youtu.be/*"], "browser_specific_settings": {"gecko": {"id": "youtube-radio-remover@ludocrypt.crd.co"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["spa-cleaner.js"], "run_at": "document_start"}]}