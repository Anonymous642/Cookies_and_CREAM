{"manifest_version": 3, "name": "Curfew", "version": "0.2.1", "description": "Blocks YouTube and Instagram during a schedule you set. Everything stays on your device.", "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*"], "background": {"scripts": ["schedule.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Curfew", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["blocked/blocked.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{669941fb-ab05-43b6-bff1-39a0fc7fe8fb}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}