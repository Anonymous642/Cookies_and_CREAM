{"manifest_version": 3, "name": "FetLife Event Visibility Checker", "version": "1.0", "description": "Indicates to a userwhether a FetLife event is publicly accessible.", "license": "MPL-2.0", "browser_specific_settings": {"gecko": {"id": "@fl-event-checker", "strict_min_version": "58.0"}}, "host_permissions": ["https://fetlife.com/*"], "content_scripts": [{"matches": ["https://fetlife.com/events/20*", "https://fetlife.com/events/near*", "https://fetlife.com/events/virtual*"], "js": ["content.js"], "run_at": "document_idle"}]}