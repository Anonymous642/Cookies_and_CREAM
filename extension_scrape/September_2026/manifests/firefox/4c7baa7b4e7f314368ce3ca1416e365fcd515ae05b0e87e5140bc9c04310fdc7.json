{"manifest_version": 3, "name": "LinkGaze", "version": "0.1.1", "description": "Save any URL and instantly know what it is and why it matters.", "homepage_url": "https://www.linkgaze.app", "action": {"default_title": "Save to LinkGaze", "default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "service-worker-loader.js", "type": "module", "scripts": ["service-worker-loader.js"]}, "permissions": ["activeTab", "alarms", "scripting"], "host_permissions": ["https://www.linkgaze.app/*", "https://linkgaze.app/*"], "commands": {"save-to-linkgaze": {"description": "Save the current page to LinkGaze (no note)", "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "linkgaze@linkgaze.app", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "personallyIdentifyingInfo"]}}}}