{"manifest_version": 2, "name": "cherryclipper", "version": "1.5", "description": "An extension that when changing the active tab stores the last tab's URL and changes the clipboard to a markdown hyperlink to that URL with the link text beeing the former clipboard content.", "icons": {"48": "icons/stammtisch-48.png"}, "permissions": ["tabs", "activeTab", "scripting", "clipboardRead", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "pdfclipper@g14p.codeberg.org", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*/", "https://*/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"], "persistent": false, "type": "module"}, "homepage_url": "https://stammtafel.codeberg.page/oc-z10/", "browser_action": {"default_title": "pdfclipper", "default_popup": "popup/popup.html", "browser_style": true}}