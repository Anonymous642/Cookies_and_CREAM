{"content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "manifest_version": 3, "name": "__MSG_extName__", "homepage_url": "https://www.zenexten.com/", "description": "Bring Zen back to your Browsing experience, with beautiful 4k background video or images, easy task and note management.", "default_locale": "en", "permissions": ["storage"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"scripts": ["js/background.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "./ntp.html"}, "action": {"default_icon": {"19": "icons/favicon.png", "38": "icons/favicon.png"}}, "web_accessible_resources": [{"resources": ["ntp.html", "js/*", "css/*", "icons/bootstrap.svg", "images/*", "images/Weather/*", "fonts/*", "css/fonts/*", "public/media/*"], "matches": ["*://*/*"]}], "chrome_settings_overrides": {"search_provider": {"name": "ZenExten", "search_url": "https://www.zenexten.com/search/?q={searchTerms}", "keyword": "zenexten", "favicon_url": "/icons/32.png", "is_default": true, "encoding": "UTF-8"}}, "browser_specific_settings": {"gecko": {"id": "appsupport@zenexten.com"}}, "version": "0.0.64"}