{"manifest_version": 2, "name": "Subscription Price Tracker", "version": "1.3", "description": "Track subscription prices, detect changes, and alert users about increases or savings opportunities.", "permissions": ["activeTab", "storage", "tabs", "notifications"], "browser_action": {"default_popup": "popup.html", "default_title": "Subscription Price Tracker"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Subscription-Price-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}