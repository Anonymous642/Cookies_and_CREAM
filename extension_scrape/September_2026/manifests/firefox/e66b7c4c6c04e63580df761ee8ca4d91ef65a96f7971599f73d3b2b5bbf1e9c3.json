{"manifest_version": 3, "name": "Ryanair\u2011WizzAir Scraper", "description": "An extension designed to streamline ticket price retrieval for both Ryanair and WizzAir", "version": "1.0.1", "author": "Daniooo", "homepage_url": "https://github.com/0xdaniooo/Ryanair-WizzAir-Scraper", "license": "MIT", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": "icon48.png", "default_title": "Ryanair\u2011WizzAir Scraper", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.ryanair.com/*", "*://*.wizzair.com/*"], "js": ["content.js"]}], "commands": {"scrape-information": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Scrapes flight information"}}, "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["*://*.ryanair.com/*", "*://*.wizzair.com/*"], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; object-src 'self';"}, "web_accessible_resources": [{"resources": ["assets/*", "fonts/*", "browser-polyfill.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "daniel.kasprzyk@daniooo.com", "strict_min_version": "117.0"}}}