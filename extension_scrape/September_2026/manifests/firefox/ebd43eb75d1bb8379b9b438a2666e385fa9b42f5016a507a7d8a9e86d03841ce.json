{"manifest_version": 3, "name": "Vetis", "version": "1.3.0", "description": "This extension enables Omni-Vet users to automate the input process when registering a new patient.", "icons": {"48": "icons/icon.png", "96": "icons/icon.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "vetis@omnivet", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://omni-vet.com/*", "https://vetis.bfsa.bg/*", "http://localhost:8000/*"], "action": {"default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["https://vetis.bfsa.bg/*", "http://localhost:8000/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": [], "matches": ["https://vetis.bfsa.bg/*", "http://localhost:8000/*"]}]}