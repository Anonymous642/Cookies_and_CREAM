{"manifest_version": 2, "name": "URL Melody", "version": "1.0", "description": "Turn a page's URL into a short melody: each character maps to a musical note and plays when you open or switch to a tab.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "URL Melody", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "urlmelody@example.com"}}}