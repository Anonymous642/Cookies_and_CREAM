{"manifest_version": 3, "name": "vxTwitter Paste", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "vxtwitter-paste@ishyume", "data_collection_permissions": {"required": ["none"]}}}, "description": "Paste x.com links as vxtwitter.com links with Alt+V", "permissions": ["clipboardRead", "clipboardWrite", "activeTab"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "vxTwitter Paste", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"paste-vx-link": {"suggested_key": {"default": "Ctrl+Q"}, "description": "Paste clipboard URL as vxtwitter link"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Open vxTwitter Paste popup"}}, "icons": {"16": "icon16.png", "48": "icon48.png"}}