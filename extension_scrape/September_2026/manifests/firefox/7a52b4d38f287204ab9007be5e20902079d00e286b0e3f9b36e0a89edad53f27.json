{"manifest_version": 3, "name": "GTA VI Spoiler Shield", "version": "0.1.0", "description": "Actively filters GTA VI spoilers from major social and video sites.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.google.com/*", "*://*.bing.com/*", "*://*.discord.com/*", "*://*.twitch.tv/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "action": {"default_title": "GTA VI Spoiler Shield", "default_popup": "popup.html"}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "icons": {"48": "icons/shield.svg", "96": "icons/shield.svg"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.google.com/*", "*://*.bing.com/*", "*://*.discord.com/*", "*://*.twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "gta6-spoiler-shield@zachary.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}