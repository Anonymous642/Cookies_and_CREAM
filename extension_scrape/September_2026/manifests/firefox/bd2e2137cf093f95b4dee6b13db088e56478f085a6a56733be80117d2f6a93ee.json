{"manifest_version": 3, "name": "MoonMonet Themes For Firefox", "version": "1.0.0", "description": "Custom Extension for MoonMonet browser themes, allowing you to customize them!", "author": "noxygalaxy", "homepage_url": "https://moonmonet.lol", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "moonmonet-themes@moonmonet.lol", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["content.js"], "css": ["content.css"]}], "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://raw.githubusercontent.com/*"], "web_accessible_resources": [{"resources": ["themes/*.css"], "matches": ["*://music.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}