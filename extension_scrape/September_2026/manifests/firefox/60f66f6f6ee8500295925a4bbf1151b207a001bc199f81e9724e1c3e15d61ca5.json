{"manifest_version": 3, "name": "Skilly", "description": "Skilly points, talks, and acts on any page you're browsing.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Skilly", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "skilly@tryskilly.app", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personalCommunications", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "js": ["content-scripts/content.js"]}]}