{"manifest_version": 3, "name": "SimiliScan", "version": "1.0", "description": "Check similarity between web pages and more", "browser_specific_settings": {"gecko": {"id": "simili-scan@gmail.com"}}, "permissions": ["activeTab", "storage", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}