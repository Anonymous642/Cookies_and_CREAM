{"manifest_version": 2, "name": "Roblox Cookie Manager", "version": "4.0.0", "description": "Log into Roblox using a .ROBLOSECURITY cookie. Save and manage multiple accounts with a sleek liquid UI.", "permissions": ["cookies", "storage", "tabs", "*://*.roblox.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Roblox Cookie Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "roblox-login-extension@teronix"}}}