{"manifest_version": 2, "name": "SHEIN Coupon Finder", "version": "1.0.2", "description": "Automatically finds and applies the best SHEIN coupon codes for your region.", "permissions": ["storage", "alarms", "activeTab", "*://*.shein.com/*", "*://*.tajribti.com/*"], "background": {"scripts": ["src/utils/storage-manager.js", "src/utils/region-resolver.js", "src/utils/api-client.js", "src/utils/coupon-ranking.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["*://*.shein.com/*"], "js": ["src/utils/storage-manager.js", "src/utils/region-resolver.js", "src/utils/coupon-ranking.js", "src/utils/api-client.js", "src/utils/i18n.js", "src/content/floating-widget.js", "src/content/checkout-injector.js", "src/content/cart-popup.js", "src/content/content-main.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "shein-coupon-finder@tajribti.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}