{"manifest_version": 3, "name": "Manga History Bridge", "short_name": "Manga Bridge", "version": "1.6.1", "description": "Track your manga reading history automatically. Sync chapters, view 'Last read' badges, manage alt-titles, and export your library.", "author": "Manga History Bridge", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://kissmanga.in/*", "https://manhuaus.com/*", "https://mangapark.io/*", "https://mangadex.org/*", "https://vymanga.com/*", "https://kingofshojo.com/*", "https://kunmanga.com/*", "https://asurascans.com/*", "https://manhuaplus.top/*", "https://flamecomics.xyz/*", "https://utoon.net/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "action": {"default_title": "Manga History Bridge", "default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["https://kissmanga.in/*", "https://manhuaus.com/*", "https://mangapark.io/*", "https://mangadex.org/*", "https://vymanga.com/*", "https://kingofshojo.com/*", "https://kunmanga.com/*", "https://asurascans.com/*", "https://manhuaplus.top/*", "https://flamecomics.xyz/*", "https://utoon.net/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "history-bridge@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}