{"manifest_version": 3, "name": "KAITimer", "version": "1.0.2", "description": "Tracks time spent on websites (maybe it's time to touch the grass?)", "permissions": ["activeTab", "tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "@kaitimer.ardermax", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "main.html", "default_title": "KAITimer"}, "background": {"service_worker": "js/background.js", "scripts": ["js/background.js"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"]}]}