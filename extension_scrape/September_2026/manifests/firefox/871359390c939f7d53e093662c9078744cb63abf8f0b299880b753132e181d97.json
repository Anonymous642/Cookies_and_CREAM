{"manifest_version": 3, "name": "Earthquake Today - Realtime Alerts", "version": "1.0.1", "description": "Get real-time earthquake alerts and check the latest seismic activity near you.", "permissions": ["alarms", "storage", "notifications"], "host_permissions": ["https://earthquake.usgs.gov/*", "https://*.basemaps.cartocdn.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["lib/images/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://*.basemaps.cartocdn.com"}, "browser_specific_settings": {"gecko": {"id": "earthquake-today-release@earthquaketoday.org", "strict_min_version": "130.0", "data_collection_permissions": {"required": ["none"]}}}}