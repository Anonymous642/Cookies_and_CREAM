{"manifest_version": 2, "name": "Lock-In", "version": "1.0", "description": "Limit your daily social media usage.", "browser_specific_settings": {"gecko": {"id": "@lock-in", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_action": {"default_icon": "icons/icon.svg", "default_title": "Lock-In Settings", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.linkedin.com/*", "*://*.pinterest.com/*", "*://*.snapchat.com/*"], "js": ["content/timer.js"], "css": ["content/timer.css"]}], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}