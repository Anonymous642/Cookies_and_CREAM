{"manifest_version": 3, "name": "Dreamwidth Features", "description": "Utility features for Dreamwidth.", "version": "2.0.3", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "cookies", "contextualIdentities"], "host_permissions": ["https://*.dreamwidth.org/*", "https://mail.google.com/*", "https://mail.proton.me/*"], "browser_specific_settings": {"gecko": {"id": "dwext@blossom.blue", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Dreamwidth features settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.dreamwidth.org/*"], "css": ["content-scripts/dreamwidth.css"], "js": ["content-scripts/dreamwidth.js"]}, {"matches": ["https://mail.google.com/*"], "js": ["content-scripts/gmail.js"]}, {"matches": ["*://*.mail.proton.me/*"], "all_frames": true, "js": ["content-scripts/proton.js"], "match_origin_as_fallback": true}]}