{"manifest_version": 2, "name": "ConnectWise Manage Ticket Search", "version": "1.0", "description": "Browser extension for searching tickets in ConnectWise Manage.", "permissions": ["storage", "tabs"], "background": {"page": "background.html", "persistent": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+S"}, "description": "Open the ticket search popup"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "cwm-ticket-search@forzza.industries", "strict_min_version": "80.0"}}}