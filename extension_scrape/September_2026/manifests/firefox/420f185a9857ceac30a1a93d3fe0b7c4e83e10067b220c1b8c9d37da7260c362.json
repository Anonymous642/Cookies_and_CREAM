{"manifest_version": 3, "name": "YouTube Queue", "version": "1.0", "description": "Queue YouTube videos to watch later", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_title": "YouTube Queue", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "@Youtube_Queue_by_Daniel"}}}