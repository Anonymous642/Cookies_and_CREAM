{"manifest_version": 2, "name": "Fireflies Meeting Joiner", "version": "1.0.0", "description": "Invite Fireflies.ai to join your current Teams or Meet call automatically.", "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}}, "permissions": ["activeTab", "storage", "tabs", "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://meet.google.com/*", "https://api.fireflies.ai/*"], "content_scripts": [{"matches": ["https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "fireflies-joiner@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}