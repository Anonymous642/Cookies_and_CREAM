{"manifest_version": 3, "name": "YouTube Lockout", "version": "1.0.0", "description": "Bloque strictement l'acc\u00e8s \u00e0 YouTube pendant une dur\u00e9e d\u00e9termin\u00e9e sans d\u00e9verrouillage possible.", "browser_specific_settings": {"gecko": {"id": "youtube-lockout@melina.dev", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon.svg", "128": "icons/icon.svg"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked/blocked.html"], "matches": ["<all_urls>"]}]}