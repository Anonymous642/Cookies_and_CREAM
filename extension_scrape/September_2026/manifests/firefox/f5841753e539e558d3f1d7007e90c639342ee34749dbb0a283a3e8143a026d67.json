{"manifest_version": 3, "name": "JobSnap - Job Application Tracker", "version": "1.76", "description": "Track and manage your job applications in one place with advanced features like auto-fill, cloud sync, CSV export, and smart job reminders.", "permissions": ["storage", "activeTab", "scripting", "notifications", "alarms", "downloads"], "host_permissions": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.internshala.com/*", "*://*.naukri.com/*", "*://*.monster.com/*", "*://*.monsterindia.com/*", "*://*.glassdoor.com/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "JobSnap", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.internshala.com/*", "*://*.naukri.com/*", "*://*.monster.com/*", "*://*.monsterindia.com/*", "*://*.glassdoor.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open JobSnap"}}, "browser_specific_settings": {"gecko": {"id": "jobsnap-unique-2025@example.com"}}}