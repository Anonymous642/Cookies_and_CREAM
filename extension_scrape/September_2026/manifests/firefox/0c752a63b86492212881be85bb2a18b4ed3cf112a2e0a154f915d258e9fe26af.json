{"manifest_version": 3, "name": "AI DOM Translator", "description": "Translate the visible text on a page by replacing DOM text nodes with AI-generated translations.", "version": "0.1.2", "permissions": ["activeTab", "storage"], "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "browser_specific_settings": {"gecko": {"id": "ai-dom-translator@example.local", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "AI DOM Translator", "default_popup": "src/popup.html"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content.js", "src/floating-ui.js"], "css": ["src/floating-ui.css"], "run_at": "document_end"}]}