{"manifest_version": 3, "name": "Unblock YouTube TV", "short_name": "unblock-youtube-tv", "version": "1.0.2", "description": "Loads the YouTube TV on any device. Press F to fullscreen.", "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "unblock-youtube-tv@s01.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "140.0"}}, "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.youtube.com/tv", "*://*.youtube.com/tv/*"], "declarative_net_request": {"rule_resources": [{"id": "user_agent", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/tv", "*://*.youtube.com/tv/*", "*://*.youtube.com/tv?*"], "js": ["fullscreen.js"], "run_at": "document_idle", "all_frames": false}]}