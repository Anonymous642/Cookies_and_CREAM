{"manifest_version": 2, "name": "ESChat", "short_name": "ESChat", "description": "Allows ESChat Web Client to communicate with ESChat Native Service.", "version": "1.5", "permissions": ["nativeMessaging"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bridge@eschat.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo"], "optional": ["personalCommunications", "locationInfo", "technicalAndInteraction"]}}}, "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.sla-ptt.com/*", "https://*.eschat-ptt.com/*", "https://*.eschat-gov.com/*", "https://*.stage-eschat-gov.com/*", "https://*.dev-eschat-gov.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": "eschat-fav.png"}, "icons": {"48": "eschat-fav.png", "128": "eschat-fav.png"}}