{"manifest_version": 3, "name": "Image Zoom", "version": "1.0.0", "description": "Click any image on a webpage to view it full-size in a lightbox overlay. Supports zoom in/out and panning for detailed inspection.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "image-zoom-041@mozillamaker.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Image Zoom"}}