{"manifest_version": 3, "name": "Gemini Tagger", "description": "Add tags to Gemini conversations for organization and filtering", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "gemini-tagger@local", "data_collection_permissions": {"required": ["none"], "contacted": [], "stored": []}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://gemini.google.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}