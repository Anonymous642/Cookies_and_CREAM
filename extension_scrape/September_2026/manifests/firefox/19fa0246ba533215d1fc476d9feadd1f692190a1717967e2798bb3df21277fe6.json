{"manifest_version": 3, "name": "RotateX \u2013 Image Rotator & Page Rotation", "version": "2.1.0", "description": "The fast image rotator to rotate and adjust webpages, photos, videos, and PDFs with 1 click, keyboard shortcuts, or custom sliders.", "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.dodopayments.com/*", "*://dodopayments.com/*"], "js": ["scripts/checkout-listener.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["purchased.html", "scripts/*", "rotate16.png", "rotate48.png", "rotate128.png"], "matches": ["*://*.dodopayments.com/*", "*://dodopayments.com/*", "<all_urls>"]}], "action": {"default_popup": "popup.html"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "commands": {"rotate-90": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1"}, "description": "Rotate page 90\u00b0 clockwise"}, "rotate-180": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2"}, "description": "Rotate page 180\u00b0"}, "rotate-270": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "MacCtrl+Shift+3"}, "description": "Rotate page 270\u00b0"}, "rotate-reset": {"suggested_key": {"default": "Ctrl+Shift+0", "mac": "MacCtrl+Shift+0"}, "description": "Reset page rotation"}}, "icons": {"16": "rotate16.png", "48": "rotate48.png", "128": "rotate128.png"}, "browser_specific_settings": {"gecko": {"id": "rotatex@codesec.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}