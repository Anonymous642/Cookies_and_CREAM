{"manifest_version": 3, "name": "ConnectWise Enhancer", "version": "0.2.0", "description": "Adds quick ticket search and rich ticket-link copying to ConnectWise Manage.", "permissions": ["storage", "scripting"], "host_permissions": ["https://*.myconnectwise.net/*", "https://*.connectwise.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background/index.js"]}, "action": {"default_title": "Open ConnectWise Enhancer settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.myconnectwise.net/*", "https://*.connectwise.com/*"], "js": ["content/index.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"open-quick-ticket-search": {"description": "Open ConnectWise quick ticket search"}}, "browser_specific_settings": {"gecko": {"id": "connectwise-enhancer@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}