{"manifest_version": 3, "name": "Stream Companion for Twitch", "version": "1.2.0", "description": "Utilities for Twitch viewers and streamers including chat translation, stream information tools, and user search features.", "permissions": ["storage", "alarms"], "host_permissions": ["https://api.twitch.tv/*", "https://translate.googleapis.com/*", "*://*.twitch.tv/*", "https://api.commanderroot.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "stream-companion-for-twitch@extension.com", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "collects_data": false}}}}