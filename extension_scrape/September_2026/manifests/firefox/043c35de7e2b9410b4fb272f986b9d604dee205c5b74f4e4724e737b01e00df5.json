{"manifest_version": 3, "name": "VoluMax", "version": "1.0.0", "description": "Per-site volume control: boost audio up to +32 dB (several times louder), lower, mute, or make it mono. Settings are remembered per site.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "VoluMax", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["page-audio-hook.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["shared.js", "cs.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}], "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"description": "Open volume control"}, "volume-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase volume by 1 dB"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease volume by 1 dB"}, "volume-reset": {"suggested_key": {"default": "Alt+Shift+0"}, "description": "Reset volume to 0 dB"}, "toggle-mono": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle mono audio"}, "toggle-mute": {"description": "Toggle mute"}}, "browser_specific_settings": {"gecko": {"id": "{741367a4-c213-4f3f-bb10-c4f9cfada478}", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "128.0"}}}