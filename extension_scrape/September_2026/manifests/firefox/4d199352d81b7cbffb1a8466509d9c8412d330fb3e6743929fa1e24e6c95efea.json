{"manifest_version": 3, "name": "XinStudio - Next Level YouTube", "version": "1.2.0", "description": "YouTube and YouTube Studio tools to make your day just a little bit easier. For free!", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://studio.youtube.com/*", "https://cdn.jsdelivr.net/*"], "action": {"default_title": "XinStudio", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "{48026840-ffde-43bd-b4a1-7dd9f74c954b}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["studio-intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["shared.js", "youtube-content.js", "youtube-features.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["https://studio.youtube.com/*"], "js": ["shared.js", "studio-content.js", "studio-features.js"], "css": ["content.css"], "run_at": "document_idle"}]}