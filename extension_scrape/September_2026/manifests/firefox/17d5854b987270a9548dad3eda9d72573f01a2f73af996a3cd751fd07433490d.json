{"manifest_version": 2, "name": "Tab Grouper", "version": "1.0.0", "description": "Organisez automatiquement vos onglets par domaine avec des couleurs personnalis\u00e9es", "browser_specific_settings": {"gecko": {"id": "tab-grouper@example.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "activeTab", "bookmarks", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Tab Grouper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["icons/*"]}