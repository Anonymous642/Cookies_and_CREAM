{"manifest_version": 3, "name": "Xirp Launcher for GitHub", "version": "0.1.1", "description": "Launch configurable Xirp coding-agent sessions from GitHub issues.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://github.com/*"], "content_scripts": [{"matches": ["https://github.com/*/*/issues/*"], "js": ["src/lib.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "action": {"default_title": "Configure Xirp Launcher", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "xirp-launcher@joshuajacobson.dev", "data_collection_permissions": {"required": ["none"]}}}}