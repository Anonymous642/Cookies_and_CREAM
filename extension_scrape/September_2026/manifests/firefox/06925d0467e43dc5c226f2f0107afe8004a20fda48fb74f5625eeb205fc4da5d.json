{"manifest_version": 3, "name": "BlurMask \u2014 Blur & Hide Sensitive Data", "version": "1.0.1", "description": "Privacy blur extension: blur screen share on Zoom & Meet, hide sensitive data, mask text, and redact screens in one click. Free.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://api.polar.sh/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "default_title": "BlurMask"}, "background": {"scripts": ["utils.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "blurmask@blurmask.online", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["content.css"], "js": ["utils.js", "content.js"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"toggle-inspector": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Toggle Click-to-Blur Inspector"}, "blur-selection": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Blur Highlighted Selection"}, "clear-all-blurs": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C"}, "description": "Clear All Blurs On Current Page"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "incognito": "spanning", "web_accessible_resources": [{"resources": ["assets/icon16.png", "assets/icon32.png"], "matches": ["http://*/*", "https://*/*"]}]}