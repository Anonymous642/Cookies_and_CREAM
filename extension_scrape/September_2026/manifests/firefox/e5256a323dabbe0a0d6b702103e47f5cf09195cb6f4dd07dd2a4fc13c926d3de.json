{"manifest_version": 2, "name": "Google\u2192ChatGPT Redirect", "version": "1.0", "author": "jojihatzz", "description": "On Google search pages, click the icon to open ChatGPT with the same query.", "icons": {"48": "icon.png", "96": "icon.png"}, "permissions": ["tabs", "activeTab", "*://www.google.com/*", "*://duckduckgo.com/*", "*://www.bing.com/*", "*://www.youtube.com/*", "*://search.yahoo.com/*", "*://www.baidu.com/*", "*://yandex.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Send query to ChatGPT"}, "applications": {"gecko": {"id": "google-to-chatgpt@ex.com", "strict_min_version": "58.0"}}}