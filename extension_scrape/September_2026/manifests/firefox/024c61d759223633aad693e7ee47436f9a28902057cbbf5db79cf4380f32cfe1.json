{"manifest_version": 3, "name": "rei's tabs", "version": "1.0.0", "description": "Save your open tabs to a file or Google Drive, close them in one go, and restore any saved session later.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "reis-tabs@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "tabGroups", "storage", "downloads", "identity", "notifications"], "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "rei's tabs", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"save-and-clear": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save & Clear: export unpinned tabs, then close them"}, "save-only": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Save only: export unpinned tabs without closing them"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open the rei's tabs popup"}}}