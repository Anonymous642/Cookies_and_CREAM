{"manifest_version": 2, "name": "Color Picker \u2013 Eye Dropper & Palette", "description": "Pick colors, generate palettes, export to JSON/CSS/ASE.", "version": "1.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "clipboardWrite", "downloads", "tabs", "https://tally.so/*", "https://*.mozilla.org/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "content_security_policy": "script-src 'self'; connect-src 'self' https://tally.so;", "web_accessible_resources": ["icons/*", "popup/popup.html"], "browser_specific_settings": {"gecko": {"id": "colorpicker@example.com", "strict_min_version": "109.0"}}}