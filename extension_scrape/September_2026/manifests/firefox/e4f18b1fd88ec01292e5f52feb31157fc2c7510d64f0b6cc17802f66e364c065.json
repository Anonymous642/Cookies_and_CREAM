{"manifest_version": 3, "name": "Reading Intent Switch Alert", "version": "1.3", "description": "Detects when browsing behavior shifts away from the original reading intent and provides gentle focus reminders.", "permissions": ["tabs", "storage", "notifications", "activeTab", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Reading Intent Switch Alert"}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Reading-Intent-Switch-Alert", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}