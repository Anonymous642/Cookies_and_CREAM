{"manifest_version": 2, "name": "Butter Home", "version": "1.0.0", "description": "The new tab page for Butter: a clock, a search box and your shortcuts, in your colours. Remove this add-on to get Firefox's own new tab back.", "author": "Butter", "browser_specific_settings": {"gecko": {"id": "{2c1f7a3e-5d84-4b0b-9a6f-7e3d1c9b2a41}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/butter-16.png", "32": "icons/butter-32.png", "48": "icons/butter-48.png", "96": "icons/butter-96.png", "128": "icons/butter-128.png"}, "permissions": ["storage", "search"], "background": {"scripts": ["shared/companion.js", "background.js"], "persistent": false}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}}