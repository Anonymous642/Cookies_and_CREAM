{"manifest_version": 3, "name": "SnapBlur \u2014 Full Page Capture, Blur & Annotate", "short_name": "SnapBlur", "description": "Full-page screenshots with blur, arrows, text, highlights and crop. Download, copy or share. Works on any page.", "version": "2.0.0", "browser_specific_settings": {"gecko": {"id": "snapblur@bulldozestore.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs", "downloads", "clipboardWrite", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "SnapBlur \u2014 Capture, Blur & Share"}, "background": {"scripts": ["background-firefox.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture current page"}}, "web_accessible_resources": [{"resources": ["icons/*", "editor/*", "welcome/*"], "matches": ["<all_urls>"]}]}