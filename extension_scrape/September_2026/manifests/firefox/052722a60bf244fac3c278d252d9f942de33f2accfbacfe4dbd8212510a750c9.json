{"manifest_version": 3, "name": "LinkProof Inspector", "version": "1.0.0", "description": "Inspect page links, remove tracking parameters, and prepare safe local link reports.", "browser_specific_settings": {"gecko": {"id": "linkproof-inspector@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "clipboardWrite", "menus", "scripting", "storage", "tabs"], "background": {"scripts": ["shared/constants.js", "shared/browser.js", "shared/urlRules.js", "shared/storage.js", "background.js"]}, "action": {"default_title": "LinkProof Inspector", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"scan-active-page": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Scan links on the active page"}, "open-linkproof-report": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Open the latest LinkProof report"}}, "icons": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}