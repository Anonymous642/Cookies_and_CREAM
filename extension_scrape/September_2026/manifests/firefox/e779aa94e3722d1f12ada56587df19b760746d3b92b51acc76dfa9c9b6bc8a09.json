{"manifest_version": 3, "name": "YouTube Focus Mode", "version": "1.0.0", "description": "Remove distractions from YouTube", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "YouTube Focus Mode"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["*://*.youtube.com/*"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "engineerbaba049@gmail.com", "strict_min_version": "109.0"}}}