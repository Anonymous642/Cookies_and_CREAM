{"manifest_version": 2, "name": "AWS SSO Role Switcher", "version": "0.1.8", "description": "Automatically switches from configured AWSReservedSSO roles into target AWS Console roles.", "icons": {"128": "assets/icon.svg"}, "permissions": ["storage", "tabs", "webNavigation", "*://*.console.aws.amazon.com/*", "*://signin.aws.amazon.com/*", "*://*.signin.aws.amazon.com/*"], "background": {"scripts": ["src/config.js", "src/background.js"]}, "options_ui": {"page": "src/options.html", "browser_style": false, "open_in_tab": true}, "browser_action": {"default_title": "AWS SSO Role Switcher", "default_icon": "assets/icon.svg", "default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["*://*.console.aws.amazon.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["*://signin.aws.amazon.com/switchrole*"], "js": ["src/switchrole.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "aws-sso-role-switcher@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}