{"manifest_version": 3, "name": "TrueValio", "version": "0.0.8", "description": "AI-Powered Real Estate Valuation - Instant property condition analysis on Zillow and Redfin", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.zillow.com/*", "*://*.redfin.com/*", "http://localhost:8000/*", "https://truevalio.com/*", "https://api.truevalio.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@truevalio.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "content_scripts": [{"matches": ["*://*.zillow.com/homedetails/*", "*://*.zillow.com/apartments/*", "*://*.zillow.com/rentals/*", "*://*.zillow.com/condos/*", "*://*.zillow.com/townhomes/*", "*://*.zillow.com/building/*", "*://*.zillow.com/complex/*", "*://*.zillow.com/unit/*", "*://*.zillow.com/property/*", "*://*.zillow.com/b/*", "*://*.zillow.com/r/*", "*://*.redfin.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["*://truevalio.com/*", "*://www.truevalio.com/*", "http://localhost:5173/*"], "js": ["dashboardAuth.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}