{"manifest_version": 3, "name": "Secritly", "version": "1.0.0", "description": "Instantly understand what you're agreeing to before clicking \"I agree\".", "browser_specific_settings": {"gecko": {"id": "secritly@example.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "permissions": ["storage", "activeTab", "tabs"], "background": {"scripts": ["background/background.js"]}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_title": "Open Secritly Panel", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png"}, "default_popup": "popup/popup.html"}, "web_accessible_resources": [{"resources": ["images/*.png"], "matches": ["https://*/*"]}], "sidebar_action": {"default_title": "Secritly", "default_panel": "sidepanel.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png"}}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content.js"]}]}