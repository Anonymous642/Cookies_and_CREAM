{"manifest_version": 3, "name": "BadLaw", "version": "1.2", "description": "Displays contextual banners on law firm websites based on public data about their response to the Trump administration.", "permissions": ["storage"], "host_permissions": ["https://raw.githubusercontent.com/badlawext/badlaw/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"]}], "action": {"default_popup": "settings.html", "default_icon": {"48": "icons/icon.png"}, "default_title": "BadLaw Settings"}, "icons": {"48": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "badlaw.extension@gmail.com", "strict_min_version": "109.0"}}}