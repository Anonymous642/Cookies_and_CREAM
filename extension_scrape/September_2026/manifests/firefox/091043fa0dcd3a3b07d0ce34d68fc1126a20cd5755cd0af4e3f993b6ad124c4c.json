{"manifest_version": 3, "name": "FillWise \u2014 AI Job Application Autofill", "version": "1.8.0", "description": "AI-powered autofill for job applications. Uses your saved profile and your own Groq/Gemini API key to fill forms on Indeed, LinkedIn, Naukri, Workday, Greenhouse, Lever and more. You always review and submit \u2014 it never submits for you.", "permissions": ["storage", "unlimitedStorage", "activeTab", "webNavigation"], "host_permissions": ["https://api.groq.com/*", "https://generativelanguage.googleapis.com/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "FillWise \u2014 AI Job Autofill", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ai-job-autofill@local-extension", "strict_min_version": "109.0"}}}