{"manifest_version": 2, "name": "eBay Zero Feedback Filter", "version": "1.0", "description": "Nasconde automaticamente le inserzioni eBay di venditori con pochi o nessun feedback.", "icons": {"48": "icon48.png", "96": "icon96.png"}, "browser_specific_settings": {"gecko": {"id": "ebay-feedback-filter@claudiotools", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://*.ebay.it/*", "*://*.ebay.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png"}, "default_title": "eBay Feedback Filter"}, "permissions": ["activeTab", "storage"]}