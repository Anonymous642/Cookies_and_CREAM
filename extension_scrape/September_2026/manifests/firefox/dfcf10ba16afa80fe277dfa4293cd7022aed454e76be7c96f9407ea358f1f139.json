{"manifest_version": 3, "name": "NepsezAI Assistant", "version": "2.0.1", "description": "Auto-solves the NEPSE TMS login CAPTCHA and fills the broker logins saved in your NepsezAI account.", "permissions": ["storage"], "host_permissions": ["https://*.nepsetms.com.np/*", "https://api.nepsezai.com/*", "https://nepsezai.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*.nepsetms.com.np/*"], "js": ["content.js"]}, {"matches": ["https://nepsezai.com/*/extension/connect*", "https://www.nepsezai.com/*/extension/connect*"], "js": ["connect.js"]}], "action": {"default_title": "NepsezAI", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "nepsezai-assistant@anilks", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}