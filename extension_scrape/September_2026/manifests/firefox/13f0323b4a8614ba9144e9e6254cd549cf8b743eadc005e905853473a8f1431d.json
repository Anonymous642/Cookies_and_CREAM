{"manifest_version": 3, "author": "Toni", "name": "Perplexity Sidebar for Firefox", "version": "1.0.1", "description": "Unofficial Firefox add-on that opens Perplexity in Firefox's native sidebar instead of Firefox's built-in AI sidebar.", "homepage_url": "https://www.perplexity.ai/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Toggle Perplexity Sidebar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_title": "Perplexity", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_panel": "panel/fallback.html", "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "@perplexity-sidebar", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "websiteActivity", "websiteContent"]}}}}