{"manifest_version": 2, "name": "Twitter Video Downloader", "version": "1.2", "description": "Adds a download button to each tweet and sends it to a Cobalt instance.", "icons": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png", "96": "icons/favicon-96.png", "128": "icons/favicon-128.png"}, "browser_specific_settings": {"gecko": {"id": "twitter-video-downloader@x.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>", "webRequest", "downloads", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Twitter Video Downloader", "default_popup": "popup.html", "default_icon": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png"}}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}