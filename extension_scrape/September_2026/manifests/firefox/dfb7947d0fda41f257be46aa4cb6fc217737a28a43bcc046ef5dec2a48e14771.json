{"manifest_version": 2, "name": "Elixor", "version": "1.0.0", "description": "Advanced proxy manager", "permissions": ["proxy", "storage", "unlimitedStorage", "<all_urls>", "webRequest", "webRequestBlocking", "tabs", "activeTab", "management"], "background": {"scripts": ["lib/js-yaml.min.js", "background/storage.js", "background/proxy-manager.js", "background/pac-manager.js", "background/exception-manager.js", "background/request-handler.js", "background/main.js"], "persistent": true}, "browser_action": {"default_title": "Elixor", "default_popup": "ui/popup/popup.html", "default_icon": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["ui/content/page-toast.js"], "run_at": "document_idle", "all_frames": false}], "icons": {"16": "icons/16x16.png", "32": "icons/32x32.png", "48": "icons/48x48.png", "128": "icons/128x128.png"}, "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "firefox@elixor.extension", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "web_accessible_resources": ["proxy.pac"], "commands": {"elixor_always_current": {"description": "Always proxy current site"}, "elixor_never_current": {"description": "Never proxy current site"}, "elixor_auto_current": {"description": "Auto mode for current site"}, "elixor_toggle_enabled": {"description": "Toggle extension enabled"}, "elixor_toggle_inversion": {"description": "Toggle inversion mode"}, "elixor_open_editor": {"description": "Open exceptions editor"}, "elixor_update_data": {"description": "Update PAC and remote lists"}}}