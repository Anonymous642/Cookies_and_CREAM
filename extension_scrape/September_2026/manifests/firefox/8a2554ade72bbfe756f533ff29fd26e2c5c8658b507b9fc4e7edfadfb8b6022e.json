{"manifest_version": 2, "name": "LinkedIn Experience & Language Previews", "version": "1.0.0", "description": "Adds experience requirement and vacancy language labels to a LinkedIn job cart title. The extension works only at linkedin.com/jobs/(search|recommendations|collections)/*.", "icons": {"48": "icons/icon48.png"}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/search/*", "*://*.linkedin.com/jobs/recommendations/*", "*://*.linkedin.com/jobs/collections/*"], "js": ["src/main.js"], "run_at": "document_end"}], "background": {"scripts": ["src/background.js"], "persistent": true}, "permissions": ["tabs", "webRequest", "webRequestBlocking", "*://*.linkedin.com/jobs/*"], "browser_specific_settings": {"gecko": {"id": "@linkedin-experience-language.siinus"}}}