{"manifest_version": 3, "name": "IBFT - Instagram Block & Unfollow Tool", "version": "1.1.0", "description": "Identify non-followers, manage your community with bulk actions, and export lists safely and efficiently.", "permissions": ["storage", "activeTab", "scripting", "cookies", "tabs"], "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "ibft@modern.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["analysis.html"], "matches": ["https://www.instagram.com/*"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}