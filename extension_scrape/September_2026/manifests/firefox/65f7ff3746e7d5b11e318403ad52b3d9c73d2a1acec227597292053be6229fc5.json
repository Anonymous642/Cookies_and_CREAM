{"manifest_version": 3, "name": "format-filler", "version": "1.0.0", "id": "format-filler@vyankatesh-odilwar", "description": "Fill ODT templates with dynamic fields. Works completely offline. Publisher: Vyankatesh Odilwar | Technical Support: vodilwar@gmail.com", "author": "Vyankatesh Odilwar", "browser_specific_settings": {"gecko": {"id": "format-filler@vyankatesh-odilwar", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "downloads", "tabs"], "action": {"default_title": "Format Filler", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["service-worker.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["libs/*", "assets/*", "fonts/*", "page.html"], "matches": ["<all_urls>"]}]}