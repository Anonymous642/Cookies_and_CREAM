{"manifest_version": 3, "name": "Deepbrid - Browser Extension", "version": "3.0.1", "description": "Official Deepbrid.com browser extension. Access your account, manage downloads and detect supported links directly in your browser.", "browser_specific_settings": {"gecko": {"id": "extensions@deepbrid.com", "strict_min_version": "121.0"}}, "icons": {"16": "icons/deepbrid.png", "32": "icons/deepbrid.png", "48": "icons/deepbrid.png", "128": "icons/deepbrid.png"}, "action": {"default_popup": "popup.html", "default_title": "Deepbrid - Browser Extension", "default_icon": {"16": "icons/deepbrid.png", "32": "icons/deepbrid.png", "48": "icons/deepbrid.png"}}, "background": {"scripts": ["sw.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "permissions": ["storage", "downloads", "tabs"], "web_accessible_resources": [{"resources": ["icons/*", "fonts/*"], "matches": ["*://*/*"]}]}