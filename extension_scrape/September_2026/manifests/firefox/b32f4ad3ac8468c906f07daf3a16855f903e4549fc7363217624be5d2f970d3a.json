{"manifest_version": 2, "name": "Zero New Tabs", "version": "1.1", "description": "Prevents any new tab from opening. Links redirect to the current tab instead.", "permissions": ["tabs"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "zero-new-tabs@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}