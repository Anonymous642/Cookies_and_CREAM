{"manifest_version": 3, "name": "TabLogger", "version": "1.0.0", "description": "Auto-archives tabs you haven't used recently into one accessible log, grouped by website and date.", "permissions": ["tabs", "storage", "alarms"], "background": {"scripts": ["lib/storage.js", "lib/grouping.js", "background/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "TabLogger", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "tablogger@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}