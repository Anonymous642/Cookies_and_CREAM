{"manifest_version": 2, "name": "Twitch Chat Names", "version": "1.9", "description": "Adds the displayname in addition to username to community tab on Twitch. \u5c07\u4f7f\u7528\u8005\u7684\u986f\u793a\u540d\u7a31\u6dfb\u52a0\u5230 Twitch \u7684\u793e\u7fa4\u6a19\u7c64\u4e2d\u3002", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["production-chatlist.js"]}], "permissions": ["https://*.twitch.tv/*"], "browser_specific_settings": {"gecko": {"id": "{b64df498-6a06-4e34-b6cb-66dee6a79d07}"}}}