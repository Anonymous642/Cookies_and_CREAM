{"manifest_version": 3, "name": "Preco Unitario ML", "description": "Calcula o preco por kg, litro ou unidade nos anuncios do Mercado Livre, diluindo o frete", "version": "0.3.1", "browser_specific_settings": {"gecko": {"id": "preco-unitario-ml@extensoes.brom", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.mercadolivre.com.br/*", "*://*.mercadolibre.com/*"], "js": ["src/lib/parse.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "action": {"default_title": "Preco Unitario ML", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}}