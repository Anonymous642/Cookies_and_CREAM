{"manifest_version": 3, "name": "X Video Downloader \u2013 ClipSave", "version": "1.1.0", "description": "Download public X (Twitter) videos as MP4. Save videos you own or have permission to download.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*.twimg.com/*", "https://cdn.syndication.twimg.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "x-video-downloader-clipsave@cxgrowthlab.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "X Video Downloader \u2013 ClipSave", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/wechat-qr.png"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]}