{"manifest_version": 2, "name": "Link Lens", "version": "1.0", "description": "Show a 3D-lit magnifier preview when hovering image links or thumbnails.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "linklens@example.com"}}}