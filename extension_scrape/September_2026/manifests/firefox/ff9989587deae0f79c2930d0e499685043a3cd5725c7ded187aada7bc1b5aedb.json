{"manifest_version": 3, "name": "Keytab", "version": "1.5.1", "description": "Keyboard shortcuts for tab actions (unload, pin/unpin) plus media-key control of YouTube Music.", "permissions": ["tabs", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "{bfa454e4-de37-4f96-90be-7533e84f0704}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Keytab: Unload this tab (Ctrl+L)", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "commands": {"unload-active-tab": {"suggested_key": {"default": "Ctrl+L", "mac": "MacCtrl+L"}, "description": "Unload the active tab"}, "toggle-pin-active-tab": {"suggested_key": {"default": "Ctrl+P", "mac": "MacCtrl+P"}, "description": "Pin or unpin the active tab"}, "ytm-play-pause": {"suggested_key": {"default": "MediaPlayPause"}, "description": "YouTube Music: play / pause"}, "ytm-next-track": {"suggested_key": {"default": "MediaNextTrack"}, "description": "YouTube Music: next track"}, "ytm-prev-track": {"suggested_key": {"default": "MediaPrevTrack"}, "description": "YouTube Music: previous track"}}}