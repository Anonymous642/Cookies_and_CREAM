{"manifest_version": 2, "name": "Self-Test Trigger System", "version": "1.3", "description": "Automatically triggers self-test reminders during learning sessions to improve knowledge retention.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "background": {"scripts": ["triggerEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Self-Test Trigger System"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Self-Test-Trigger-System", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}