{"manifest_version": 3, "name": "YouTube URL Downloader", "version": "1.0.2", "description": "Select videos on any YouTube channel page and export their URLs as a yt-dlp batch file.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["style.css"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["youtube-dl.svg"], "matches": ["*://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "yt-url-downloader@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}