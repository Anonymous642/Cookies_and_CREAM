{"manifest_version": 3, "name": "Research Wheel", "version": "2.0.0", "description": "Single-ring 8-action research gesture wheel and workspace panel for instant citations, notes, and searches.", "permissions": ["storage", "activeTab", "clipboardWrite", "sessions"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icon48.png"}, "action": {"default_icon": "icon48.png", "default_title": "Research Wheel"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": "icon48.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle the Research Workspace Sidebar"}}, "browser_specific_settings": {"gecko": {"id": "researchwheel@local.extension", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["<all_urls>"]}]}