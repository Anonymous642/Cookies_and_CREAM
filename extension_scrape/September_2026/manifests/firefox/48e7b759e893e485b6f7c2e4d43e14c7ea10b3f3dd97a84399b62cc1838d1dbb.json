{"manifest_version": 3, "name": "LaserFocus: Tab Manager", "version": "1.0", "description": "Displays a simple list of open tabs and allows you to close or pin them quickly.", "permissions": ["tabs"], "icons": {"16": "actionIcon-16.png", "32": "actionIcon-32.png", "48": "actionIcon-48.png", "128": "actionIcon-128.png"}, "action": {"default_title": "Manage Tabs", "default_icon": {"16": "actionIcon-16.png", "32": "actionIcon-32.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tabmanager@yourdomain.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}}