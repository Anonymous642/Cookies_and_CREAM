{"manifest_version": 3, "name": "PistEmploi - Ajouter une candidature", "description": "Ajoutez en un clic l'offre d'emploi de la page courante au suivi de vos candidatures PistEmploi.", "version": "1.2.0", "default_locale": "fr", "browser_specific_settings": {"gecko": {"id": "extension@pistemploi.com", "strict_min_version": "121.0"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Ajouter \u00e0 PistEmploi", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background.js"]}, "permissions": ["activeTab", "scripting", "storage", "cookies"], "host_permissions": ["https://api.pistemploi.com/*", "https://pistemploi.com/*", "https://www.pistemploi.com/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content-detect.js"], "run_at": "document_idle"}]}