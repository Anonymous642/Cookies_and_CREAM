{"manifest_version": 3, "name": "eBay Dark Theme", "version": "1.1", "description": "Applies a dark theme to eBay.", "browser_specific_settings": {"gecko": {"id": "ebay-dark-theme@yourname.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.de/*", "*://*.ebaydesc.com/*", "*://*.ebaydesc.co.uk/*", "*://*.ebaydesc.ca/*", "*://*.ebaydesc.com.au/*", "*://*.ebaydesc.de/*"], "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.de/*", "*://*.ebaydesc.com/*", "*://*.ebaydesc.co.uk/*", "*://*.ebaydesc.ca/*", "*://*.ebaydesc.com.au/*", "*://*.ebaydesc.de/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}