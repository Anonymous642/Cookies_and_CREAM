{"manifest_version": 3, "name": "JobFlo Capture", "version": "1.1", "description": "Capture job listings from LinkedIn, Indeed, Greenhouse, Lever, and Ashby directly into JobFlo.", "icons": {"16": "icons/Icon-16.png", "32": "icons/Icon-32.png", "48": "icons/Icon-48.png", "96": "icons/Icon-96.png", "128": "icons/Icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "capture@jobflo.design", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["telemetry.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/Icon-16.png", "32": "icons/Icon-32.png", "48": "icons/Icon-48.png"}}, "content_scripts": [{"matches": ["*://www.linkedin.com/jobs/*", "*://linkedin.com/jobs/*", "*://www.indeed.com/viewjob*", "*://indeed.com/viewjob*", "*://*.greenhouse.io/jobs/*", "*://*.lever.co/*", "*://*.ashbyhq.com/posting/*", "*://jobs.ashbyhq.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["activeTab"], "host_permissions": ["https://lymegrove.com/*", "https://lymegroveanalytics.synology.me:3001/*"]}