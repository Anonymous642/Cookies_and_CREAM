{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "brightward@brightward.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "name": "BrightWard for Firefox", "version": "1.0.2", "description": "A local-first, guided incident reporting and family-safe browsing tool.", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://www.reddit.com/*", "https://www.youtube.com/*", "https://report.cybertip.org/*", "https://www.cybertipline.org/*", "https://www.ic3.gov/*", "https://complaint.ic3.gov/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["dist/background.bundle.js"]}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://www.reddit.com/*", "https://www.youtube.com/*"], "js": ["dist/content.bundle.js"], "run_at": "document_idle"}, {"matches": ["https://report.cybertip.org/*", "https://www.cybertipline.org/*", "https://www.ic3.gov/*", "https://complaint.ic3.gov/*"], "js": ["dist/autofill.bundle.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dist/content.bundle.js"], "matches": ["https://twitter.com/*", "https://x.com/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://www.reddit.com/*", "https://www.youtube.com/*"]}, {"resources": ["dist/autofill.bundle.js"], "matches": ["https://report.cybertip.org/*", "https://www.cybertipline.org/*", "https://www.ic3.gov/*", "https://complaint.ic3.gov/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}