{"manifest_version": 3, "name": "Purple Platform Ad Non-Viewer", "version": "0.8.0", "description": "During Twitch ad breaks, promotes the picture-by-picture mini stream to the main player with sound, and mutes/covers the ad. Ads still play and count \u2014 you just don't watch them.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.twitch.tv/*"], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_title": "Purple Platform Ad Non-Viewer", "default_popup": "src/popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "browser_specific_settings": {"gecko": {"id": "ad-non-viewer@purple-platform", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}