{"manifest_version": 2, "name": "Cursor Personalizado", "version": "1.0", "description": "Cambia el cursor del navegador (solo en p\u00e1ginas web) por una imagen que t\u00fa elijas. No modifica el cursor de Windows ni recolecta datos.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Cursor Personalizado"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "custom-cursor@lazaro.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}