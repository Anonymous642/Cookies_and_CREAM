{"manifest_version": 2, "name": "GreasyBoii", "version": "2.0.1", "description": "Run custom JavaScript and CSS on webpages, with tools for downloads, links and data scraping.", "author": "Andy Dixon", "browser_specific_settings": {"gecko": {"id": "greasyboii@dixon.cx", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "downloads", "<all_urls>"], "background": {"scripts": ["background.js"]}, "commands": {"toggle-greasyboii": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Enable/disable all GreasyBoii rules"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}