{"manifest_version": 2, "name": "Shastimer", "author": "Ivan Nokonoko", "description": "Task timer for Maps Analyst raters working on TryRating.com", "version": "6.1", "permissions": ["tabs", "storage", "notifications", "webRequest", "identity", "scripting", "*://*.tryrating.com/*", "*://*.cloudfunctions.net/*", "*://*.firebaseio.com/*", "*://*.lbtimer.com/*"], "icons": {"16": "img/t16.png", "48": "img/t48.png", "128": "img/t128.png"}, "browser_specific_settings": {"gecko": {"id": "@shastimer.lbtimer.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'", "background": {"page": "bg.html"}, "browser_action": {"default_title": "Shastimer", "default_popup": "o.html"}, "content_scripts": [{"matches": ["*://*.tryrating.com/*"], "js": ["tr.js"], "run_at": "document_end"}]}