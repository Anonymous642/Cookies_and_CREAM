{"manifest_version": 2, "name": "MyLinks", "description": "My Links browser extension", "version": "2.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "alarms", "contextMenus", "notifications", "tabs"], "optional_permissions": ["bookmarks", "*://*/*"], "commands": {"open-search": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open MyLinks and focus the search field"}}, "browser_specific_settings": {"gecko": {"id": "my-links@mylinks.app", "data_collection_permissions": {"required": ["bookmarksInfo"]}}}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "MyLinks"}, "browser_action": {}}