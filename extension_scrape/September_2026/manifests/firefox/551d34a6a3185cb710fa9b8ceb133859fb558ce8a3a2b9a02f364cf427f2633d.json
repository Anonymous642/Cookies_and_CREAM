{"manifest_version": 2, "name": "Glyphshift", "description": "Transform web text into 9 different writing systems. Learn Hiragana, Braille, Morse Code, and more while browsing.", "version": "1.0.8", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "web_accessible_resources": ["fonts/*.woff2", "fonts/*.ttf"], "browser_specific_settings": {"gecko": {"id": "glyphshift@github.com", "strict_min_version": "58.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Glyphshift", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}