{"manifest_version": 2, "name": "Auto Hashtag Generator", "version": "1.3", "description": "Automatically generate relevant hashtags from selected text or page content.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs", "storage", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Auto Hashtag Generator", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Auto-Hashtag-Generator", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}