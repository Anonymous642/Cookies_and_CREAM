{"manifest_version": 3, "name": "Tab Rename", "version": "1.0.1", "description": "Rename any browser tab to a custom title, and revert to the page's original title whenever you like.", "author": "Sean Breen", "browser_specific_settings": {"gecko": {"id": "{386f4cbd-d8bb-4538-aa84-156ce81fe899}", "strict_min_version": "115.0"}}, "permissions": ["tabs", "storage", "contextMenus"], "action": {"default_title": "Rename this tab", "default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}