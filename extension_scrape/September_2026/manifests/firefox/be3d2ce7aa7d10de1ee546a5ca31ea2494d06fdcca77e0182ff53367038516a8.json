{"manifest_version": 2, "name": "YouTube Speed Buttons", "version": "1.1", "description": "Adds buttons to control YouTube video speed in the status bar.", "permissions": ["tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": "icons/icon.png", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "icons": {"48": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-speed-buttons@example.com"}}}