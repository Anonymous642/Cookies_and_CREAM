{"manifest_version": 2, "name": "New Tab Tune", "version": "1.0", "description": "Plays a short musical phrase when a new tab is opened. Choose style: jazz, lo-fi, classical.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "notifications", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "New Tab Tune", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "newtabtune@example.com"}}}