{"manifest_version": 3, "name": "WhatsApp Privacy Shield", "description": "Protect privacy on WhatsApp Web by hiding chats, messages, and media until explicitly revealed.", "version": "1.0.0", "permissions": ["storage", "tabs"], "host_permissions": ["https://web.whatsapp.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_title": "WhatsApp Privacy Shield", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icon.png"], "matches": ["https://web.whatsapp.com/*"]}], "browser_specific_settings": {"gecko": {"id": "whatsapp-privacy-shield@primordic.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}