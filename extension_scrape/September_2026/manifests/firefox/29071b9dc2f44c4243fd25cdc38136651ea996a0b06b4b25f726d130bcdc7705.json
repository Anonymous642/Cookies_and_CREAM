{"manifest_version": 2, "name": "Amazon Variation Scores", "version": "1.0", "description": "Shows review scores for each product variation inline", "browser_specific_settings": {"gecko": {"id": "amazon-variation-scores@yourdomain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.co.jp/*"], "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.co.jp/*"], "js": ["content.js"], "run_at": "document_idle"}]}