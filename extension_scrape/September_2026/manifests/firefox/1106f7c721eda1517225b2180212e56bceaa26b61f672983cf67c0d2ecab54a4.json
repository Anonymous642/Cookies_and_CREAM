{"manifest_version": 2, "name": "Periodic Bookmark Backup", "version": "1.12.1", "description": "Automatically exports Firefox bookmarks to an HTML file.", "permissions": ["bookmarks", "downloads", "storage", "alarms", "https://icons.duckduckgo.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "Open Bookmark Backup settings"}, "browser_specific_settings": {"gecko": {"id": "{3983ada7-3a7a-4f02-b20c-1f3f213f5ee0}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["bookmarksInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}