{"manifest_version": 2, "name": "Nucleus - Sales Task Manager", "version": "1.2.2", "description": "Multi-channel outbound tool for managing sales tasks, email sequences, calls, and LinkedIn outreach", "permissions": ["storage", "activeTab", "tabs", "https://www.linkedin.com/*", "https://mail.google.com/*", "https://api.anthropic.com/*", "https://api.airtable.com/*", "https://api.notion.com/*", "https://*.supabase.co/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content-linkedin.js"], "css": ["content.css"]}, {"matches": ["https://mail.google.com/*"], "js": ["gmail-inject.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "nucleus@salestaskmanager.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "sidebar_action": {"default_title": "Nucleus", "default_panel": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Nucleus sidebar"}}, "web_accessible_resources": ["icons/*.png", "popup.html"], "browser_action": {"default_title": "Toggle Nucleus", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}