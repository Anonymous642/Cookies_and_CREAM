{"manifest_version": 3, "name": "A1 HTML Checker", "short_name": "A1 HTML", "version": "0.1.0", "description": "Run a fast local markup structure check on the active page with selectors and snippets.", "homepage_url": "https://a1local.com.au/extensions/html-validity-checker/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "A1 HTML Checker", "default_popup": "popup.html"}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "html-validity-checker@a1local.com.au", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}