{"manifest_version": 2, "name": "YouTube Speedbar Extension", "version": "1.0.0", "description": "Double-tap Space to toggle 1x/2x speed. Hold Space at 2x to temporarily slow down.", "browser_specific_settings": {"gecko": {"id": "@youtube-speedbar-extension", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}