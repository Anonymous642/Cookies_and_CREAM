{"manifest_version": 3, "name": "Zoho People Time Tracker", "version": "1.0.7", "description": "See remaining work hours, punches, weekly summary, and permission usage from Zoho People - live in a popup, no page needed.", "browser_specific_settings": {"gecko": {"id": "zoho-people-time-tracker@yegappan.pages.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "alarms", "cookies", "tabs"], "host_permissions": ["https://people.zoho.in/*", "https://people.zoho.com/*", "https://people.zoho.eu/*", "https://people.zoho.com.au/*", "https://people.zoho.com.cn/*", "https://people.zoho.jp/*", "https://people.zoho.sa/*", "https://contacts.zoho.in/*", "https://contacts.zoho.com/*", "https://contacts.zoho.eu/*", "https://contacts.zoho.com.au/*", "https://contacts.zoho.com.cn/*", "https://contacts.zoho.jp/*", "https://contacts.zoho.sa/*"], "action": {"default_title": "Zoho People Time Tracker", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Command+Shift+Y"}, "description": "Open the Zoho remaining time popup"}}, "background": {"scripts": ["service_worker.js"]}}