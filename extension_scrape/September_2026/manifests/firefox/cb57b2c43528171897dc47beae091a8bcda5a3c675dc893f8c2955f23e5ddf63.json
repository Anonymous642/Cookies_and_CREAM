{"manifest_version": 3, "name": "QR Master: QR Code for Current Tab", "version": "1.0.2", "description": "Create QR codes for the current tab, URLs, text, Wi-Fi details, or contact cards. Download PNG or copy to clipboard.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "clipboardWrite"], "homepage_url": "https://www.qrmaster.net", "browser_specific_settings": {"gecko": {"id": "qrmaster-current-tab@qrmaster.net", "data_collection_permissions": {"required": ["none"]}}}}