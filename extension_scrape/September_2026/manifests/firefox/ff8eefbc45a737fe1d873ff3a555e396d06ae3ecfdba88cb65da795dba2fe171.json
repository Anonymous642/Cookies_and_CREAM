{"manifest_version": 2, "name": "Remove YouTube Shorts", "version": "1.0", "description": "Removes YouTube Shorts from your feed.", "permissions": ["storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "shorts@bluedron.com"}}}