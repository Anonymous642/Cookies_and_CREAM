{"manifest_version": 3, "name": "Privacy Image Shield", "version": "0.1.0", "description": "Strips EXIF/GPS/ICC/XMP metadata from images locally before upload.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"scripts": ["background/service_worker.js"], "type": "module"}, "permissions": ["downloads"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/interceptor.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html"}, "web_accessible_resources": [{"resources": ["lib/privacy_image.wasm", "lib/privacy_image.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "privacy-image-shield@example.com", "data_collection_permissions": {"required": ["none"]}}}}