{"manifest_version": 3, "name": "Nextcloud Talk", "version": "2.5", "description": "Nextcloud Talk client.", "icons": {"32": "icons/talk-32.png", "48": "icons/talk-48.png"}, "permissions": ["storage", "notifications", "clipboardWrite", "clipboardRead", "identity", "webRequest", "webRequestBlocking"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_icon": {"32": "icons/talk-32.png"}, "default_title": "Talk", "default_popup": "popup/talk.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "background": {"scripts": ["background/background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "nextcloud@talk"}}}