{"manifest_version": 3, "name": "TabLock - Password Tab Locker", "version": "1.0.0", "description": "Lock any tab with a password. Auto-lock social sites including sub-pages. Re-locks after restart. All data stays on this device.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "tablock-password-locker@example.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "icons/icon-48.png", "default_title": "TabLock", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/main.js"]}, "permissions": ["storage", "tabs", "webNavigation", "idle"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "options/options.html", "open_in_tab": true}}