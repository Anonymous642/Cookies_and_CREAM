{"manifest_version": 2, "name": "CU FireAuth", "version": "6.0.1", "description": "Automatically logs into the CU campus Wi-Fi portal natively and invisibly in the background.", "author": "CU FireAuth", "browser_specific_settings": {"gecko": {"id": "cu-fireauth@cu.edu.in", "strict_min_version": "91.0"}}, "browser_action": {"default_popup": "popup.html", "default_title": "CU FireAuth", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://172.16.2.1:1000/*", "http://172.16.2.1/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "permissions": ["storage", "alarms", "tabs", "notifications", "webRequest", "webRequestBlocking", "webNavigation", "http://172.16.2.1/*", "<all_urls>"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}