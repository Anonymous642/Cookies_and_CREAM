{"manifest_version": 3, "name": "Hack Font Everywhere", "version": "0.3.0", "description": "Renders all text on web pages using the Hack typeface.", "browser_specific_settings": {"gecko": {"id": "hack-font@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/inject.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg", "default_title": "Hack Font Everywhere"}}