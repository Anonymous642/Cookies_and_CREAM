{"manifest_version": 3, "name": "Web Markdown Clipper for AI", "version": "1.0.0", "description": "Extraherar ren, strukturerad Markdown fr\u00e5n inloggade webbappar (Vercel m.fl.) direkt till Clipboard f\u00f6r minimal token\u00e5tg\u00e5ng i AI.", "permissions": ["activeTab", "scripting", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "markdown-clipper@traitmesh.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Kopiera sidan som ren Markdown (Alt+C)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"clip-page": {"suggested_key": {"default": "Alt+C"}, "description": "Kopiera sidan som ren Markdown"}}}