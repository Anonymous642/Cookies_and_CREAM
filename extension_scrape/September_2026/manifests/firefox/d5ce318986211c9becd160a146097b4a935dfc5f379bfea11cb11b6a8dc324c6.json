{"manifest_version": 3, "name": "VirusTotal Extension", "version": "1.1", "description": "Uses the VirusTotal api to scan a website and tell if it is safe or not", "permissions": ["activeTab", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "virus-total-extension@virus-total-extension.com", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["<all_urls>", "https://www.virustotal.com/api/v3/domains/*"], "action": {"default_popup": "../html/popup.html", "default_icon": {"16": "images/image16.png", "32": "images/image32.png"}}, "icons": {"16": "images/image16.png", "48": "images/image48.png", "128": "images/image128.png"}, "background": {"scripts": ["../js/extension.js"]}}