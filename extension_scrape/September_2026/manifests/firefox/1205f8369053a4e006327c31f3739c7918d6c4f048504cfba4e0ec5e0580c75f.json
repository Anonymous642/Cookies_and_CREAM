{"manifest_version": 2, "name": "Send to qBittorrent (with SavePaths)", "version": "1.4.0", "description": "Modified version of frogmech's Send to qBittorrent with dynamic save path context menus. Fork by Dareeo (https://github.com/Dareeo).", "author": "frogmech (original) \u2014 Dareeo (modified)", "homepage_url": "https://github.com/Dareeo", "license": "GPL-3.0-or-later", "browser_specific_settings": {"gecko": {"id": "send-to-qbittorrent-dynamicpaths@dareeo", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["contextMenus", "storage", "notifications", "https://*/*", "http://*/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["leftclicksend.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "config.html", "default_icon": {"48": "icons/icon-48.png"}}, "options_ui": {"page": "config.html", "open_in_tab": false}}