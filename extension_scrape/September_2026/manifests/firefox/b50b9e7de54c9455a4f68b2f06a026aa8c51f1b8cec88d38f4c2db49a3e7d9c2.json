{"manifest_version": 3, "name": "Loto Pro Connect", "description": "Preenche automaticamente jogos de v\u00e1rias loterias da Caixa (Lotomania, Mega-Sena, Quina e mais). Cole os n\u00fameros ou carregue um CSV.", "version": "1.2", "action": {"default_title": "Loto Pro Connect"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "permissions": ["scripting", "tabs"], "host_permissions": ["https://www.loteriasonline.caixa.gov.br/*"], "browser_specific_settings": {"gecko": {"id": "loto-pro-connect@lotomania.zeloureiro.com.br", "data_collection_permissions": {"required": ["none"]}}}}