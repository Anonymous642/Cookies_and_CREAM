{"manifest_version": 3, "name": "Clean Links from Tabs", "version": "1.0.0", "description": "Copy links from highlighted tabs and remove tracking parameters like utm_* and fbclid. Simple, offline, configurable.", "permissions": ["tabs", "storage", "clipboardWrite"], "background": {"page": "background/background.html"}, "action": {"default_title": "Copy clean links from tabs", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"copy-highlighted-tabs": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Copy clean links from highlighted tabs"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "clean-links-from-tabs@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}