{"manifest_version": 3, "name": "LinkedIn Scroll Fix", "description": "Fixes slow scrolling on LinkedIn.", "version": "1.0.0", "icons": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "128": "assets/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "@linkedin-scroll-fix.humtta", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "css": ["inject.css"], "run_at": "document_start"}]}