{"manifest_version": 3, "name": "Spatialify", "version": "1.1.0", "description": "Enhance YouTube Music audio with stereo widening and spatial effects. All audio processing happens locally in your browser. No data collection.", "permissions": ["storage"], "host_permissions": ["*://music.youtube.com/*"], "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["scripts/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/logonav16.png", "32": "icons/logonav32.png", "48": "icons/logonav48.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/logonav48.png", "96": "icons/logonav96.png", "128": "icons/logonav128.png"}, "browser_specific_settings": {"gecko": {"id": "spatialify@nebula.audio", "data_collection_permissions": {"required": ["none"]}}}}