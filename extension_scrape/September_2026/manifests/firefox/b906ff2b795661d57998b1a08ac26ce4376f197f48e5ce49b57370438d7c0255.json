{"manifest_version": 3, "name": "Piper Read Aloud", "version": "1.6.0", "description": "Select any text and hear it read by a local Piper (ONNX/WASM) voice. No server, no binary.", "browser_specific_settings": {"gecko": {"id": "{9c4d7a2e-51b8-4f6c-a3d2-8e0f5b7c1a94}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Piper Read Aloud", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["settings.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "contextMenus", "activeTab", "notifications"], "host_permissions": ["https://huggingface.co/*", "https://cdn.jsdelivr.net/*", "https://cdnjs.cloudflare.com/*"], "commands": {"readSelection": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read the current selection aloud with Piper"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}