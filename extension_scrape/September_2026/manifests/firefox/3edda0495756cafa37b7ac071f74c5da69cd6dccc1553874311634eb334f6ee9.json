{"manifest_version": 2, "name": "SpeedFlix", "version": "1.0", "description": "Playback speed control for Netflix. Use keyboard shortcuts or the popup to adjust speed.", "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}, "default_title": "SpeedFlix"}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "permissions": ["storage", "tabs", "*://*.netflix.com/*"], "data_collection_permissions": {"required": [], "optional": []}, "browser_specific_settings": {"gecko": {"id": "speedflix@local", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}