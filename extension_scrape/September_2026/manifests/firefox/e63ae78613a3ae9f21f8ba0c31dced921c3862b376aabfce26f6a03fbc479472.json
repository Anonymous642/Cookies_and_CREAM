{"manifest_version": 2, "name": "Bulenox Auto Coupon Finder", "version": "5.0.4.1", "description": "Fetches coupons from bulenox.codes API, shows expiry dates, and helps apply the best code on Bulenox checkout.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "128": "icon128.png", "256": "icon256.png", "512": "icon512.png"}, "permissions": ["storage", "alarms", "notifications", "activeTab", "*://bulenox.com/*", "*://www.bulenox.com/*", "*://www.bulenox.us/*", "*://bulenox.us/*", "*://bulenox.codes/*", "*://www.bulenox.codes/*"], "browser_specific_settings": {"gecko": {"id": "contact@bulenox.codes", "strict_min_version": "109.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Bulenox Coupons"}, "content_scripts": [{"matches": ["*://bulenox.com/*", "*://www.bulenox.com/*", "*://bulenox.us/*", "*://www.bulenox.us/*"], "js": ["contentScript.js"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["content-detect.js"], "run_at": "document_start"}], "content_security_policy": "script-src 'self'; object-src 'self'"}