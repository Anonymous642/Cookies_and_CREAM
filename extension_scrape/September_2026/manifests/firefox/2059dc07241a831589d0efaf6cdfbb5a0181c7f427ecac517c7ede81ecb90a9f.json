{"manifest_version": 2, "name": "bookmark-sync", "description": "Sync Bookmarks and Tabs", "version": "0.29.0", "browser_specific_settings": {"gecko": {"id": "bookmark-sync@example.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "64": "icons/icon.png", "128": "icons/icon.png"}, "background": {"scripts": ["background_script.js"]}, "content_scripts": [{"matches": ["*://*.mozilla.org/*"], "js": ["content_script.js"]}], "permissions": ["tabs", "storage"], "browser_action": {"default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "64": "icons/icon.png", "128": "icons/icon.png"}, "default_popup": "browserAction/index.html", "default_title": "bookmark-sync"}, "page_action": {"default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "64": "icons/icon.png", "128": "icons/icon.png"}, "default_popup": "pageAction/index.html", "default_title": "bookmark-sync"}, "options_ui": {"page": "options/index.html"}, "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Open Bookmark Sync popup"}}}