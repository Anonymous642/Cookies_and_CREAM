{"manifest_version": 2, "name": "Nexus Link Manager", "version": "1.0.0", "description": "Save links directly to your Nexus Links Manager", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "nexus-link-manager@mercenary.com", "strict_min_version": "91.0"}, "gecko_android": {"strict_min_version": "113.0"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}