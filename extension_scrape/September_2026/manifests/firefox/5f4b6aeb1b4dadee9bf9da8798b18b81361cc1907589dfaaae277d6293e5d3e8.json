{"manifest_version": 3, "default_locale": "en", "name": "__MSG_extensionName__", "browser_specific_settings": {"gecko": {"id": "react-tab-manager@samsperd.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "version": "0.6.0", "description": "__MSG_extensionDescription__", "host_permissions": ["<all_urls>"], "permissions": ["storage", "tabs", "tabGroups", "sessions", "bookmarks"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/index.html", "default_icon": "icon-34.png"}, "icons": {"128": "icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "<all_urls>"], "js": ["content-ui/all.iife.js"]}], "web_accessible_resources": [{"resources": ["*.js", "*.css", "*.svg", "icon-128.png", "icon-34.png"], "matches": ["*://*/*"]}], "incognito": "split", "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}, "restore-last-session": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last saved session"}, "mute-all-tabs": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Mute all audible tabs"}, "undo-close-tab": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Restore most recently closed tab"}}, "options_ui": {"page": "settings/index.html", "browser_style": false}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}