{"manifest_version": 2, "name": "TabFinder", "version": "1.0", "description": "Quick tab search. Press Ctrl+Shift+F to open.", "author": "Roman Sidoroff", "homepage_url": "https://lab9.pro", "browser_specific_settings": {"gecko": {"id": "tabfinder@lab9.pro", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs"], "browser_action": {"default_popup": "popup.html", "default_title": "TabFinder", "default_icon": {"48": "icon-light.png", "96": "icon-light@2x.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Shift+Ctrl+F", "mac": "Shift+Ctrl+F"}, "description": "Open TabFinder"}}}