{"manifest_version": 3, "name": "QuarkEcho", "version": "1.0", "description": "Reverses and animates page text as quark particles on button click.", "icons": {"64": "icon.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "quarkecho@unique.com", "data_collection_permissions": {"required": ["none"], "notification-emails": ["ypuuajw@vuk.edu.vn"]}}}}