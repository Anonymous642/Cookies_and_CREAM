{"manifest_version": 3, "name": "Auto Generate on Ideogram", "version": "1.1", "description": "Klickt automatisch auf den Generate-Button bei Ideogram, sobald der Timer abgelaufen ist.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.ideogram.ai/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"48": "icon.png"}, "content_scripts": [{"matches": ["*://*.ideogram.ai/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "auto-generate-ideogram@example.com", "strict_min_version": "91.0"}}}