{"manifest_version": 3, "name": "Construction Prices", "version": "0.1.1", "description": "Shows the product price from the page source as a fixed badge on pages that only show the product price in a script tag.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://vanderschueren.com/*"], "browser_specific_settings": {"gecko": {"id": "{f57936f5-a21c-4146-8e11-e612d0b28c1e}", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://vanderschueren.com/collections/*/products/*", "https://vanderschueren.com/products/*"], "js": ["content.js"], "run_at": "document_start"}]}