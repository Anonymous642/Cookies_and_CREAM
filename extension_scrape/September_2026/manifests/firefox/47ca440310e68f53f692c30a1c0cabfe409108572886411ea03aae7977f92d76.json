{"manifest_version": 2, "name": "Deep Keyword Search", "version": "1.0.2", "description": "Search for a keyword on the current page and linked pages at configurable depth.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Deep Keyword Search", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background/background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "deep-keyword-search@sjb.com", "data_collection_permissions": {"required": ["none"]}}}}