{"manifest_version": 2, "name": "Files Manager for Claude Companion", "version": "1.0.2", "description": "Companion extension for Files Manager for Claude  Jetbrains IDE plugin - enables automatic file synchronization with Claude projects", "browser_specific_settings": {"gecko": {"id": "filesmanagercompanion@martincerman"}}, "permissions": ["storage", "tabs", "https://claude.ai/*", "http://localhost/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://claude.ai/project/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "Files Manager for Claude", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["popup.html", "content.css"]}