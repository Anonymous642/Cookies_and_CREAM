{"manifest_version": 2, "name": "Arrange FF Tabs", "version": "1.0.0", "description": "Arrange tabs by title or website from menus, popup, or keyboard shortcuts.", "permissions": ["tabs", "menus", "notifications"], "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Arrange Tabs", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_popup": "popup/popup.html"}, "commands": {"sort-by-title": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Arrange tabs by title"}, "sort-by-website": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Arrange tabs by website"}}, "browser_specific_settings": {"gecko": {"id": "arrangefftabs@example.local", "data_collection_permissions": {"required": ["none"]}}}}