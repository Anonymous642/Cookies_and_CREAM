{"manifest_version": 3, "name": "ZenLite AutoLister", "version": "0.1.1", "description": "Scrapes vehicle details from dealer websites and auto-fills Facebook Marketplace listing fields.", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["helpers/api.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["helpers/special_cases.js", "universal_dealer.js"], "run_at": "document_end"}, {"matches": ["*://*.facebook.com/marketplace/create/*", "*://*.facebook.com/marketplace/you/listings*"], "js": ["helpers/waitForElement.js", "helpers/uploadImages.js", "facebook.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icon.png", "banner.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "thezenliteproservice@gmail.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}