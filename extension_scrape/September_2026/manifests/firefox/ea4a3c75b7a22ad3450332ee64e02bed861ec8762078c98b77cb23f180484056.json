{"manifest_version": 2, "name": "YouTube Mindful", "version": "1.5.0", "description": "Take back control of YouTube. Block Shorts, hide recommendations, grayscale thumbnails, intent checks, session limits, and more.", "permissions": ["storage", "tabs", "alarms", "https://www.youtube.com/*", "https://youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Mindful"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["intent.html", "intent.js", "analytics.html", "analytics.js", "welcome.html", "welcome.js"], "browser_specific_settings": {"gecko": {"id": "youtube-mindful@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}