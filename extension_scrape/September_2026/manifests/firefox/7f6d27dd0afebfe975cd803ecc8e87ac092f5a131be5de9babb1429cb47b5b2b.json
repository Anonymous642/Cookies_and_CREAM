{"manifest_version": 3, "name": "Ultra Tab", "version": "1.0.2", "description": "Command palette for tabs.", "browser_specific_settings": {"gecko": {"id": "supertab@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "bookmarks", "history", "downloads", "downloads.open"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "F1"}, "description": "Toggle the Ultra Tab palette"}}, "action": {"default_title": "Toggle Ultra Tab"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["palette.html", "assets/*"], "matches": ["<all_urls>"]}]}