{"manifest_version": 3, "name": "Aliexpress Age Verification Remover", "version": "1.0.3.6", "description": "Removes blur, hides the safety modal, and makes the whole product card clickable on AliExpress search pages.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.aliexpress.com/*", "https://*.aliexpress.com/*", "https://www.aliexpress.us/*", "https://*.aliexpress.us/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.aliexpress.com/*", "https://*.aliexpress.com/*", "https://www.aliexpress.us/*", "https://*.aliexpress.us/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_title": "Ali Age Verify Remover", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "aliexpress-age-verifier@example.com", "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}