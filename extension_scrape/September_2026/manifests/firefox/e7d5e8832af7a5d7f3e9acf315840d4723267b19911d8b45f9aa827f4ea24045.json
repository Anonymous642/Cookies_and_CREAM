{"manifest_version": 3, "name": "Tabbi", "version": "2.0", "description": "Overrides the new tab page with a custom interface and settings.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "New Tab"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage"], "host_permissions": ["*://suggestqueries.google.com/*", "*://api.bing.com/*", "*://duckduckgo.com/*", "*://*.wikipedia.org/*"], "browser_specific_settings": {"gecko": {"id": "tabbi@newtab.extension.mozilla", "strict_min_version": "109.0"}}}