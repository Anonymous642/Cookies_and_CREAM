{"manifest_version": 3, "name": "SoundTag Pro Saver", "description": "Easily save, tag, and organize track metadata and timestamps from your favorite music streaming platforms with one click.", "version": "1.0.0", "author": "MelodyLabs", "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["https://*.soundcloud.com/*", "https://*.youtube.com/*", "https://*.spotify.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "soundtagprosaver@melodylabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}