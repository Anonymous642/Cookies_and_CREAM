{"manifest_version": 3, "name": "Genius Lyrics for YouTube", "short_name": "Genius4YT", "version": "1.1.0", "description": "Automatically detects music playing on YouTube and shows a button to open the lyrics on Genius in one click.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.youtube.com/*", "https://api.genius.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Genius Lyrics for YouTube"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "genius-lyrics-youtube@tsar", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}