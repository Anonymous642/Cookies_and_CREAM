{"manifest_version": 2, "name": "Proton Docs as Task", "description": "Turn a Proton Docs document into an interactive task board \u2014 start it with the activation marker and its checklist becomes Kanban.", "version": "0.7.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://docs.proton.me/*", "https://docs-editor.proton.me/*"], "browser_specific_settings": {"gecko": {"id": "proton-docs-as-task@josselinonduty.fr", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Proton Docs as Task", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://docs-editor.proton.me/*", "https://docs.proton.me/*"], "all_frames": true, "js": ["content-scripts/proton-task.js"]}], "web_accessible_resources": ["content-scripts/proton-task.css"]}