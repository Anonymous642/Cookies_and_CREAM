{"manifest_version": 3, "name": "ZeDiet", "version": "1.0.2", "description": "Obtenez l'avis ZeDiet directement sur vos sites de courses en ligne. D\u00e9cryptage expert, \u00e9thique et sans tracking.", "browser_specific_settings": {"gecko": {"id": "extension@zediet.fr", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "action": {"default_icon": {"16": "img/icon16.png", "32": "img/icon32.png"}, "default_title": "Avis ZeDiet sur Carrefour, Syst\u00e8me U, Intermarch\u00e9, Houra et Franprix", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "options_page": "options.html", "permissions": ["storage"], "host_permissions": ["https://zediet.fr/*"], "content_scripts": [{"matches": ["*://*.carrefour.fr/*", "*://*.intermarche.com/*", "*://*.coursesu.com/*", "*://*.houra.fr/*", "*://*.franprix.fr/*", "*://*.zediet.fr/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["img/*.png", "img/*.jpg"], "matches": ["<all_urls>"]}]}