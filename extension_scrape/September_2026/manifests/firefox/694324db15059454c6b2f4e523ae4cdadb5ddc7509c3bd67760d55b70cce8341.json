{"manifest_version": 3, "name": "Payflow", "version": "2.5.0", "description": "Widget flutuante e arrast\u00e1vel no Musixmatch Curators Studio mostrando o total ganho em USD e na moeda secund\u00e1ria de sua escolha (BRL, EUR, GBP, ARS, JPY, CHF, CAD, AUD, INR ou IDR), com cota\u00e7\u00e3o ao vivo (AwesomeAPI + fallback Frankfurter), soma combinada de v\u00e1rias miss\u00f5es e detalhamento por miss\u00e3o.", "author": "nero", "browser_specific_settings": {"gecko": {"id": "mxm-studio-total-usd-brl@nero", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["update-check.js", "background.js"]}, "action": {"default_title": "Payflow", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "permissions": ["storage"], "host_permissions": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*", "https://economia.awesomeapi.com.br/*", "https://api.frankfurter.dev/*"], "content_scripts": [{"matches": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*"], "js": ["content.js"], "run_at": "document_end"}]}