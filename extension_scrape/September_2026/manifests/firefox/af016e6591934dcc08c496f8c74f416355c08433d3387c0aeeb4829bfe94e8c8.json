{"manifest_version": 2, "name": "Auto Close YouTube Chat", "version": "1.1", "description": "Automatically closes the YouTube chat panel when joining a live stream or VOD.", "browser_specific_settings": {"gecko": {"id": "@auto-close-youtube-chat", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"96": "icon-96.svg"}, "permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}