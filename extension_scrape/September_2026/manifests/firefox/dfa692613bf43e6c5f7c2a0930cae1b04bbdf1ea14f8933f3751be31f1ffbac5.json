{"manifest_version": 3, "name": "Tellect Scroll", "version": "1.0.0", "description": "Turn any web page into a quick, readable story.", "browser_specific_settings": {"gecko": {"id": "scroll@tellect.in", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "storage", "contextMenus", "scripting"], "host_permissions": ["https://tellect.in/*"], "action": {"default_title": "Tellect Scroll", "default_popup": "action/default_popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/scripts.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}