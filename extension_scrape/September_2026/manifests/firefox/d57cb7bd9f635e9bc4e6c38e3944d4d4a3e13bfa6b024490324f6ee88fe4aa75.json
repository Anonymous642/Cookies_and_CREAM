{"manifest_version": 2, "name": "ChatGPT Custom Sidebar Width", "version": "1.1.0", "description": "Customize the sidebar width on ChatGPT by dragging or using the popup slider", "author": "raul conchello", "homepage_url": "https://github.com/raul/gpt-custom-sidebar-width", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "chatgpt-sidebar-width@raul", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon-48.png"}, "default_title": "ChatGPT Sidebar Width"}, "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}}