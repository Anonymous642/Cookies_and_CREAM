{"manifest_version": 2, "name": "Cutter \u2014 skip the silence", "description": "Fast-forwards silent and low-volume parts of any video. Basic skip runs locally; smart trim on YouTube is an opt-in Pro feature.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://cutter.nektonsoft.ru", "permissions": ["storage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "cutter@cutter.app", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Cutter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "https://cutter.nektonsoft.ru/*"], "run_at": "document_start", "js": ["content-scripts/cutter-site.js"]}]}