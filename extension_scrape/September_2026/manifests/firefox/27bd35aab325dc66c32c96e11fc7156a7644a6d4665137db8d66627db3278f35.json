{"manifest_version": 3, "name": "YouTube Liked Videos Extractor", "version": "1.0.0", "description": "Scrolls through your YouTube Liked Videos playlist and exports every video (title, URL, channel, duration, views, date) as JSON or CSV.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Extract Liked Videos", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/playlist*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-liked-extractor@local.ext", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}