{"manifest_version": 3, "name": "PagePress", "version": "1.3.0", "description": "Capture the whole web page, not just the visible part. Then crop, annotate or redact it and save as PNG, JPEG, WebP or PDF.", "homepage_url": "https://pagepress.cyburdine.com/", "browser_specific_settings": {"gecko": {"id": "pagepress@cyburdine.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "downloads", "storage", "clipboardWrite"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["markup.js", "markup-anchor.js", "markup-export.js", "markup.css", "editor-doc.js", "editor-render.js", "shared.js"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Capture the full page", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"capture-full-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the full page and download it"}}}