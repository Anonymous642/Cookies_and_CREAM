{"manifest_version": 2, "name": "Pin Rail", "version": "1.0.0", "description": "Pinned tabs as an icon-only left sidebar. Click to switch, right-click to unpin or resize icons, drag to reorder.", "permissions": ["tabs", "menus", "storage"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "Pin Rail", "default_panel": "panel.html", "default_icon": "icons/pin.svg", "open_at_install": true}, "icons": {"48": "icons/pin.svg", "96": "icons/pin.svg"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle the Pin Rail sidebar"}}, "browser_specific_settings": {"gecko": {"id": "pin-rail@winryany", "data_collection_permissions": {"required": ["none"]}}}}