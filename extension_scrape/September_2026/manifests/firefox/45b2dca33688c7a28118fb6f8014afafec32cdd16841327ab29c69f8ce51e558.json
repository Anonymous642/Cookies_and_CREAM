{"manifest_version": 3, "name": "Zantedeschia", "description": "Copy title and/or URL of selected tabs.", "version": "3.1.0", "icons": {"48": "icons/icon_gray.png", "96": "icons/icon_gray.png"}, "permissions": ["clipboardWrite", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "zantedeschia_background.js", "scripts": ["zantedeschia_background.js"], "persistent": false}, "action": {"default_title": "Copy tab title", "default_icon": "icons/icon_lightgray.png"}, "commands": {"_execute_action": {"description": "Copy tab title", "suggested_key": {"default": "Alt+Shift+T"}}, "copy-link-plaintext": {"description": "Copy tab title and URL in plain text", "suggested_key": {"default": "Alt+Shift+P"}}, "copy-link-markdown": {"description": "Copy tab title and URL as Markdown link", "suggested_key": {"default": "Alt+Shift+M"}}, "copy-link": {"description": "Copy tab URL", "suggested_key": {"default": "Alt+Shift+U"}}}, "browser_specific_settings": {"gecko": {"id": "{17f215a4-d88e-4bb0-bf64-1ba9625a0b72}", "strict_min_version": "109.0"}}}