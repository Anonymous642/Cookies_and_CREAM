{"manifest_version": 2, "name": "GTMA Internal Traffic Flag", "version": "1.0.0", "description": "Sets a cookie to flag internal GTMA traffic and lets staff manage tracked client domains.", "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "permissions": ["tabs", "cookies", "storage", "<all_urls>"], "browser_action": {"default_icon": "icon_48.png", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "gtma-internal-traffic-flag@gtma.agency", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}