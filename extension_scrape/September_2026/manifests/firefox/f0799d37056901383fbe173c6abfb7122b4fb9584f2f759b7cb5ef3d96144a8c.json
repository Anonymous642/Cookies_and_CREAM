{"manifest_version": 2, "name": "Content Skipping Pattern", "version": "1.3", "description": "Tracks content skipping behavior and identifies reading avoidance patterns on webpages.", "permissions": ["activeTab", "tabs", "storage", "notifications"], "browser_action": {"default_title": "Content Skipping Pattern", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Content-Skipping-Pattern", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}