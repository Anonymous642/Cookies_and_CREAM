{"manifest_version": 2, "name": "Photon - New Tab, New Photo", "description": "Beautiful photos from Philip's Photo Collection on each new tab you open.", "version": "1.0.3", "browser_specific_settings": {"gecko": {"id": "photon@philips-photo-collection.vercel.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Photon Settings"}, "permissions": ["storage", "https://philips-photo-collection.vercel.app/*"], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}