{"manifest_version": 3, "name": "PravdoMetr - Odhal\u00edme pravdu v ka\u017ed\u00e9m videu", "version": "1.1.1", "description": "Zobrazuje hodnocen\u00ed pravdivosti u YouTube vide\u00ed na z\u00e1klad\u011b anal\u00fdzy z platformy PravdoMetr.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://www.youtube.com/*", "https://pravdometr.cz/*", "http://localhost/demowpreseni/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["style.css"]}, {"matches": ["https://chatgpt.com/*"], "js": ["ai-inject-chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["ai-inject-gemini.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["ai-inject-claude.js"], "run_at": "document_idle"}], "action": {"default_title": "PravdoMetr"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://www.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "pravdometr-extension@pravdometr.cz", "data_collection_permissions": {"required": ["none"]}}}}