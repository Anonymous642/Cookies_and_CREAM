{"manifest_version": 2, "name": "JSTOR", "description": "Access JSTOR features directly from your browser, starting with search from the popup, side panel, and right-click context menu.", "version": "0.0.4", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "author": "ITHAKA", "homepage_url": "https://github.com/ithaka/jstor-browser-extension", "permissions": ["contextMenus", "tabs", "storage"], "web_accessible_resources": ["icons/32.png"], "browser_specific_settings": {"gecko": {"id": "@jstor-browser-extension.ithaka.org", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "JSTOR", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "browser_style": false, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "browser_style": false, "default_title": "JSTOR"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"], "world": "ISOLATED"}]}