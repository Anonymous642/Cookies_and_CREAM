{"manifest_version": 2, "name": "Deedoop Private AI Agent (Lightweight)", "version": "2.1.0", "description": "A privacy\u2011first browser assistant that performs page summarisation and data extraction on low\u2011end devices without requiring GPU acceleration.", "permissions": ["activeTab", "storage", "tabs", "http://*/*", "https://*/*", "clipboardWrite"], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Deedoop AI Agent", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "deedoop@deedoop.ai", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"id": "deedoop@deedoop.ai", "data_collection_permissions": {"required": ["none"]}}}}