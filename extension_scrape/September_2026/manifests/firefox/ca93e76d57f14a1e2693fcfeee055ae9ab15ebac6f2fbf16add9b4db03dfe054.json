{"manifest_version": 3, "name": "CareClinic Health Tracker", "short_name": "CareClinic", "version": "0.1.3", "description": "Track symptoms, complete medication reminders, and review recent CareClinic trends from Firefox.", "incognito": "not_allowed", "permissions": ["storage", "alarms", "idle"], "optional_permissions": ["notifications"], "optional_host_permissions": ["https://start.careclinic.io/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "CareClinic Health Tracker", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "homepage_url": "https://careclinic.io/", "browser_specific_settings": {"gecko": {"id": "careclinic-health-tracker@careclinic.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "healthInfo"]}}}}