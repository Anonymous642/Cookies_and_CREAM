{"manifest_version": 3, "name": "Amazon Shopping Optimizer", "version": "0.1.0", "description": "Amazon unit price and value checker with explicit-click comparison links.", "browser_specific_settings": {"gecko": {"id": "amazon-shopping-optimizer@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "121.0"}}, "action": {"default_title": "Amazon Shopping Optimizer", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.it/*", "https://www.amazon.es/*", "https://www.amazon.com.au/*"], "content_scripts": [{"matches": ["https://www.amazon.com/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.it/*", "https://www.amazon.es/*", "https://www.amazon.com.au/*"], "js": ["utils/units.js", "utils/parser.js", "utils/calculator.js", "utils/affiliate.js", "utils/storage.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}