{"manifest_version": 3, "name": "Kretify", "version": "1.0", "description": "Did you ever think chess didn't have enough krets? Well you're in luck! this extension replaces all your chess.com pawns with krets!", "icons": {"16": "icons/kret-16.png", "32": "icons/kret-32.png", "48": "icons/kret-48.png", "128": "icons/kret-128.png"}, "action": {"default_icon": {"16": "icons/kret-16.png", "32": "icons/kret-32.png", "48": "icons/kret-48.png", "128": "icons/kret-128.png"}}, "browser_specific_settings": {"gecko": {"id": "kretify@zackgabri.github.io", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.chess.com/*"], "css": ["kretify.css"], "js": ["kretify.js"]}], "web_accessible_resources": [{"resources": ["kret.webp", "ethical.webp"], "matches": ["*://*.chess.com/*"]}]}