{"manifest_version": 3, "name": "TikTok Comment Scraper", "version": "1.3", "description": "Scrape TikTok comments and replies \u2014 including all nested replies \u2014 to a JSON file with one click.", "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["*://*.tiktok.com/*", "https://*.cloudfunctions.net/*"], "action": {"default_popup": "popup.html", "default_title": "TikTok Comment Scraper"}, "content_scripts": [{"matches": ["*://*.tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://*.cloudfunctions.net/*"], "js": ["success-detector.js"], "run_at": "document_idle"}], "background": {"scripts": ["config.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "tiktok-comment-scraper@benetti-media", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}}