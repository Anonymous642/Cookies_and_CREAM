{"manifest_version": 2, "name": "Magnic", "version": "1.5.1", "description": "Need a closer look? Zoom into images like magic - just double-tap Ctrl.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "contextMenus", "storage", "unlimitedStorage", "downloads", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["jsQR.min.js", "image-viewer.js", "image-editor.js", "content.js"], "run_at": "document_end"}], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Magnic", "default_popup": "popup.html"}, "web_accessible_resources": ["icons/*", "images/*", "content.css"], "browser_specific_settings": {"gecko": {"id": "magnic@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}