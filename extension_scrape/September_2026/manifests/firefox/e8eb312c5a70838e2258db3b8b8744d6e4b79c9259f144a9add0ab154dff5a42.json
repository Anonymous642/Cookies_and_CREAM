{"manifest_version": 3, "name": "Screenlings", "version": "0.2.4", "description": "A playful, privacy-friendly animated frog companion for ordinary webpages.", "permissions": ["activeTab", "storage"], "action": {"default_title": "Screenlings controls", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/screenlings-16.png", "32": "assets/icons/screenlings-32.png", "48": "assets/icons/screenlings-48.png", "128": "assets/icons/screenlings-128.png"}}, "icons": {"16": "assets/icons/screenlings-16.png", "32": "assets/icons/screenlings-32.png", "48": "assets/icons/screenlings-48.png", "128": "assets/icons/screenlings-128.png"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/core/constants.js", "src/core/settings.js", "src/core/state-machine.js", "src/content/safety-monitor.js", "src/content/overlay.js", "src/creatures/frog.js", "src/content/main.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/frog-sprites.png", "assets/frog-vampire-sprites.png"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "screenlings-prism@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}