{"manifest_version": 2, "name": "Volume Fader", "version": "1.0.1", "description": "Control the volume of each tab independently", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["tabs", "storage", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Volume Fader", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "fader@tabvolume", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}