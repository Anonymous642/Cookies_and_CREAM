{"description": "Remove ad section of outlook mail page", "manifest_version": 3, "name": "Un-Ad Outlook", "version": "1.0", "homepage_url": "https://github.com/Diewos/no-ad-outlook", "icons": {"48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage"], "content_scripts": [{"matches": ["https://outlook.live.com/mail/*", "https://outlook.office.com/*"], "js": ["unad.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "unad-outlook@diewos", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "icons/icon.png", "theme_icons": [{"light": "icons/icon.png", "dark": "icons/icon.png", "size": 32}], "default_title": "Un-Ad Outlook", "default_popup": "popup/popup.html"}}