{"manifest_version": 3, "name": "Talysman", "version": "0.6.0", "description": "Companion for Talysman desktop that applies your configured website-blocking rules in the browser.", "permissions": ["declarativeNetRequest", "nativeMessaging", "scripting", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "premade-1", "enabled": false, "path": "premade-lists/premade.1.json"}, {"id": "premade-2", "enabled": false, "path": "premade-lists/premade.2.json"}, {"id": "premade-3", "enabled": false, "path": "premade-lists/premade.3.json"}, {"id": "premade-4", "enabled": false, "path": "premade-lists/premade.4.json"}, {"id": "premade-5", "enabled": false, "path": "premade-lists/premade.5.json"}]}, "action": {"default_title": "Talysman status", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "talysman-firefox@talysman.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}}