{"manifest_version": 3, "name": "SIGA Scheduler Extension", "version": "1.0", "description": "Schedules a month's school meals on SIGA.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "siga-meal-scheduler@jonibatista.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://node3.siga.edubox.pt/webapp/schedules/*"], "js": ["content.js"], "run_at": "document_idle"}]}