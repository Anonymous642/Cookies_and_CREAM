{"manifest_version": 3, "name": "Gyyft", "version": "1.0", "description": "A simple extension to scrape products and add them to my gyyft wishlist.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://gyyft.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "addon@gyyft.com", "strict_min_version": "109.0"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}