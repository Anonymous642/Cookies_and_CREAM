{"manifest_version": 2, "name": "X Snapshot", "version": "1.0.4", "description": "Collect X.com posts as text snapshots", "permissions": ["tabs", "clipboardWrite", "activeTab"], "browser_action": {"default_title": "X Snapshot", "default_popup": "popup.html", "default_icon": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png"}}, "icons": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "x-snapshot@example.com", "data_collection_permissions": {"required": ["none"]}}}}