{"manifest_version": 2, "name": "VizTrack \u2014 AI LinkedIn Job Tracker", "description": "AI job search assistant. Captures LinkedIn jobs as you browse, ranks them by fit, and keeps everything organized.", "version": "1.1.1", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "viztrack@viztrack.io", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["activeTab", "tabs", "storage", "*://*.linkedin.com/*", "https://viztrack.io/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "VizTrack", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "VizTrack"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "all_frames": true, "js": ["content-scripts/content.js"]}, {"matches": ["https://viztrack.io/*"], "run_at": "document_idle", "js": ["content-scripts/dashboard-auth.js"]}]}