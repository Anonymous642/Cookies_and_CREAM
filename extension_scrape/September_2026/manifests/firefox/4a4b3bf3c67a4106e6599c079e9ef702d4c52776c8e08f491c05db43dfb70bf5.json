{"manifest_version": 3, "name": "Lumist Stash Clipper", "version": "2.0.3", "description": "Clip code snippets, images, and bookmarks directly into your local Lumist Stash.", "permissions": ["activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to Lumist Stash", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "stash@lumist.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}