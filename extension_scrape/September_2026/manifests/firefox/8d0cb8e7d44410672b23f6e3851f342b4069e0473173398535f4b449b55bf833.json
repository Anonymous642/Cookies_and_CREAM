{"manifest_version": 2, "name": "Chess Blocker", "version": "1.0", "description": "Blocks Chess.com after 3 games to reduce compulsive play.", "permissions": ["storage", "*://*.chess.com/*"], "content_scripts": [{"matches": ["*://*.chess.com/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"]}, "icons": {"512": "icons/icon.jpg"}, "web_accessible_resources": ["icons/icon1.jpeg"], "browser_specific_settings": {"gecko": {"id": "chessblocker@yourname.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}