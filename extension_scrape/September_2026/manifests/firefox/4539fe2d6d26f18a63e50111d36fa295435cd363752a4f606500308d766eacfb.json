{"manifest_version": 2, "name": "AI's That Helpalot", "version": "1.0.1", "description": "Enables WordPress sites to connect to your local AI provider like Ollama. Check helpalot.nl", "permissions": ["<all_urls>", "storage", "notifications"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon-16.webp", "32": "icon-32.webp", "48": "icon-48.webp", "128": "icon-128.webp"}, "browser_action": {"default_icon": {"48": "icon-48.webp"}, "default_title": "AI's That Helpalot", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "ais-that-helpalot@helpalot.nl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}