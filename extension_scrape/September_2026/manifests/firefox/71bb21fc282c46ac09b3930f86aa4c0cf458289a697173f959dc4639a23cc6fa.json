{"manifest_version": 3, "name": "Password Vault Manager", "version": "1.0.3", "description": "Fill logins securely from the Password Vault Manager desktop app.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["nativeMessaging"], "host_permissions": ["https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Password Vault Manager", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "content_scripts": [{"matches": ["https://*/*"], "js": ["login-field-heuristics.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "pvm-browser@darksoft.ie", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}}