{"manifest_version": 2, "name": "HarmonyTab", "version": "1.0.1", "description": "Estimate basic chords (C, G, Am, F...) over time and show a chord timeline for the playing tab.", "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_popup": "popup.html", "default_title": "HarmonyTab"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "harmonytab@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "applications": {"gecko": {"id": "harmonytab@example.com", "strict_min_version": "142.0"}}}