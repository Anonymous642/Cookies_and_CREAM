{"manifest_version": 3, "name": "TikIgEs", "version": "2.2.3", "description": "Detecta stickers de TikTok e im\u00e1genes/GIFs de Instagram, te deja elegir cu\u00e1les agregar a tu set de stickers de WhatsApp, con historial, ZIP, ajustes y arrastrar stickers directamente a WhatsApp.", "browser_specific_settings": {"gecko": {"id": "tikiges@kenny.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "scripting", "downloads", "contextMenus", "nativeMessaging"], "host_permissions": ["http://localhost:4711/*", "*://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Sticker Set Tool", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}