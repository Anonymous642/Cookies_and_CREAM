{"manifest_version": 2, "name": "HLN Abonnement Blocker", "version": "1.1", "description": "Toggle HLN subscription popup on and off.", "author": "Robin", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "activeTab", "https://www.hln.be/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.hln.be/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "hln-abonnement-blocker@robin.com"}}}