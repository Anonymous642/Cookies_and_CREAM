{"manifest_version": 3, "name": "Consent Guard", "version": "1.0.9", "description": "Automatically rejects nonessential consent prompts.", "icons": {"16": "icons/consent-guard-16.png", "32": "icons/consent-guard-32.png", "48": "icons/consent-guard-48.png", "96": "icons/consent-guard-96.png", "128": "icons/consent-guard-128.png"}, "browser_specific_settings": {"gecko": {"id": "@consent-guard", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Consent Guard", "default_popup": "popup.html", "default_icon": {"16": "icons/consent-guard-16.png", "32": "icons/consent-guard-32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}]}