{"manifest_version": 3, "name": "No Shorts & Reels", "version": "1.0.0", "description": "Blocca YouTube Shorts, Instagram Reels e Facebook Reels. Nasconde le sezioni Shorts e reindirizza le pagine /shorts al player normale.", "browser_specific_settings": {"gecko": {"id": "no-shorts-reels@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "action": {"default_title": "No Shorts & Reels", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/util.js", "content/youtube.js"], "css": ["content/youtube.css"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.instagram.com/*"], "js": ["content/util.js", "content/instagram.js"], "css": ["content/instagram.css"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.facebook.com/*"], "js": ["content/util.js", "content/facebook.js"], "css": ["content/facebook.css"], "run_at": "document_start", "all_frames": false}]}