{"manifest_version": 2, "name": "Password Autofill Defocus", "version": "1.0.0", "description": "Defocuses password fields after auto-fill on HTTP pages, preventing Firefox's insecure login warning from blocking the login button.", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "password-autofill-defocus@nealon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}