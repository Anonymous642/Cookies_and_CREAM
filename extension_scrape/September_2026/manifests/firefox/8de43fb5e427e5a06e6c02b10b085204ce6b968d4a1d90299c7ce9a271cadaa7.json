{"manifest_version": 2, "name": "TNUA Timetable \u2192 ICS Exporter", "version": "0.4.0", "description": "Export the TNUA student timetable page to an .ics file for Google Calendar.", "permissions": ["activeTab", "tabs", "downloads", "storage", "https://acad6.tnua.edu.tw/*"], "browser_action": {"default_title": "Export ICS", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "tnua-ics-exporter@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}