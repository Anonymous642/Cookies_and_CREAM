{"manifest_version": 2, "name": "YouTube Radio Blocker", "version": "1.0.0", "description": "Prevents YouTube from automatically sending you to its 'radio' playlist feature when you click on music.", "permissions": ["webRequest", "webRequestBlocking", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "@youtube-radio-blocker", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}