{"manifest_version": 3, "name": "tday Meeting Assistant", "description": "Adds active-speaker attribution to tday live standup notes.", "version": "0.1.0", "incognito": "not_allowed", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["nativeMessaging", "storage"], "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://tday.com/admin/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html", "default_title": "tday Meeting Assistant"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "meeting-assistant@tday.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "browsingActivity", "websiteContent"]}}}}