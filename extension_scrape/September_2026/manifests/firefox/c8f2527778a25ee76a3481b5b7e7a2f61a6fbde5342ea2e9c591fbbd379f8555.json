{"manifest_version": 3, "name": "No More Short Videos", "version": "1.0", "description": "Automatically hides YouTube videos that are too short (customizable duration).", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon.png"}}, "icons": {"128": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "nomoreshortvideos@vincentgonnet.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}