{"manifest_version": 2, "name": "Hebrew RTL for ChatGPT & Claude", "version": "1.4.15", "description": "Firefox toolbar toggle for Hebrew RTL in ChatGPT and Claude, keeping English, tables, lists, punctuation, and code readable.", "icons": {"16": "icons/rtl-hebrew-16.png", "32": "icons/rtl-hebrew-32.png", "48": "icons/rtl-hebrew-48.png", "96": "icons/rtl-hebrew-96.png", "128": "icons/rtl-hebrew-128.png"}, "permissions": ["storage"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["hebrew-rtl-content.js"], "css": ["css/style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "hebrew-rtl-chatgpt-claude@jamp0002", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Hebrew RTL: OFF", "default_icon": {"16": "icons/rtl-hebrew-off-16.png", "32": "icons/rtl-hebrew-off-32.png", "48": "icons/rtl-hebrew-off-48.png", "96": "icons/rtl-hebrew-off-96.png", "128": "icons/rtl-hebrew-off-128.png"}}}