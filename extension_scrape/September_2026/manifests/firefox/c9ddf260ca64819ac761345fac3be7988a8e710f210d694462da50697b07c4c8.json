{"manifest_version": 3, "name": "MyTodoBoard", "description": "Your board at a glance: today's tasks, quick add, complete and pin.", "version": "0.1.0", "browser_specific_settings": {"gecko": {"id": "extension@mytodoboard.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Open MyTodoBoard"}, "sidebar_action": {"default_panel": "panel.html", "default_title": "MyTodoBoard", "default_icon": "icons/32.png", "open_at_install": false}, "background": {"scripts": ["background.js"]}, "permissions": ["identity", "storage"], "host_permissions": ["https://api.mytodoboard.com/*"]}