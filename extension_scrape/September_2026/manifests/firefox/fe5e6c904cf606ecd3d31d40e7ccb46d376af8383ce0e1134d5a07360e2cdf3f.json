{"manifest_version": 3, "name": "YouTube RSS Copier", "version": "0.1.0", "description": "Copy a YouTube channel RSS feed URL from supported pages.", "permissions": ["activeTab", "clipboardWrite", "contextMenus", "scripting"], "action": {"default_popup": "popup/popup.html", "default_title": "YouTube RSS Copier"}, "background": {"scripts": ["background/index.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/channel/*", "https://www.youtube.com/@*", "https://www.youtube.com/shorts/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-rss-copier@example.local", "data_collection_permissions": {"required": ["none"]}}}}