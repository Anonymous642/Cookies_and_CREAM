{"manifest_version": 3, "name": "ARSENAL", "version": "2026.7.1", "description": "Adds a download button on Helldivers 2 Nexus Mods pages to send mods directly to your Arsenal client.", "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.nexusmods.com/helldivers2/mods/*"], "js": ["js/main.js"], "css": ["styles/style.css"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://www.nexusmods.com/*"]}], "browser_specific_settings": {"gecko": {"id": "@ext.arsenal.app", "strict_min_version": "109.0"}}}