{"manifest_version": 2, "name": "Watch Party Sync", "version": "1.3", "description": "Sync video playback between friends \u2014 create/join watch rooms, sync play/pause/seek and basic chat.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "tabs", "activeTab", "notifications"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Watch Party Sync", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@Watch-Party-Sync", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}