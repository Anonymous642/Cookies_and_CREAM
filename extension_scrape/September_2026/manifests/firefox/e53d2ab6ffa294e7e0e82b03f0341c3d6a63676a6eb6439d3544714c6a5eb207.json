{"manifest_version": 3, "name": "OMNITRACKER Web Gateway Agent", "description": "Manages Web Gateway browser tabs if object is opened in existing session.", "version": "1.1.0", "action": {"default_popup": "popup.html", "default_icon": "on.png"}, "icons": {"16": "on.png", "48": "ON_48.png", "128": "ON_128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "browser_specific_settings": {"gecko": {"id": "extension@omninet.de", "data_collection_permissions": {"required": ["none"]}}}}