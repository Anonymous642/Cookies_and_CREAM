{"manifest_version": 3, "name": "Pinterest Exporter", "description": "Save your Pinterest boards, sections, and pins to your computer. Downloads images, videos, and a CSV with full metadata", "version": "0.0.8", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["alarms", "notifications", "idle", "cookies"], "host_permissions": ["*://*.pinterest.com/*", "https://i.pinimg.com/*", "https://v1.pinimg.com/*", "https://store.rxliuli.com/*"], "author": "rxliuli", "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "homepage_url": "https://rxliuli.com/project/pinterest-exporter", "browser_specific_settings": {"gecko": {"id": "pinterest-exporter@rxliuli.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "js": ["content-scripts/content.js"]}]}