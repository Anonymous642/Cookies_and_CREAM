{"manifest_version": 2, "name": "JobChef", "description": "Capturez les offres d'emploi et laissez JobChef les noter \u00e0 votre go\u00fbt.", "version": "0.2.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://jobchef.fr", "permissions": ["storage", "https://jobchef.fr/*", "https://*.jobchef.fr/*", "http://localhost:8050/*"], "commands": {"capture-rapide": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capturer l'offre de la page courante"}}, "author": "JobChef", "developer": {"name": "JobChef", "url": "https://jobchef.fr"}, "browser_specific_settings": {"gecko": {"id": "extension@jobchef.fr", "data_collection_permissions": {"required": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "JobChef", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}