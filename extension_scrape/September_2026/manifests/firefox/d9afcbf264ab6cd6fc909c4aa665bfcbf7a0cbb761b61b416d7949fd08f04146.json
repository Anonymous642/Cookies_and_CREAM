{"manifest_version": 2, "name": "Invisible Message", "version": "1.1.0", "description": "Hide messages in invisible Unicode", "permissions": ["storage", "https://www.facebook.com/*", "https://www.messenger.com/*", "https://web.facebook.com/*"], "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://www.messenger.com/*", "https://web.facebook.com/*"], "js": ["loader.js"], "run_at": "document_start"}], "web_accessible_resources": ["injected.js"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "invisible-msg@example.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}