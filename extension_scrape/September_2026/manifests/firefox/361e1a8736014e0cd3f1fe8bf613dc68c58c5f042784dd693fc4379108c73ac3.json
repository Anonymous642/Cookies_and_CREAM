{"browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_popup": "src/inject/app/index.html", "default_title": "Urdu for Web"}, "content_scripts": [{"css": ["src/inject/fonts.css", "src/inject/inject.css"], "exclude_matches": ["*://twitter.com/*", "*://ur.wikipedia.org/*", "*://pnb.wikipedia.org/*", "*://quran.com/*"], "js": ["src/inject/fonts-config.js", "src/inject/font-selector.js"], "matches": ["*://*/*"], "run_at": "document_start"}, {"css": ["src/inject/fonts.css", "src/inject/twitter.css"], "js": ["src/inject/fonts-config.js", "src/inject/font-selector.js"], "matches": ["*://twitter.com/*", "*://x.com/*"], "run_at": "document_start"}, {"css": ["src/inject/fonts.css", "src/inject/whatsapp.css"], "matches": ["*://web.whatsapp.com/*"]}, {"css": ["src/inject/fonts.css", "src/inject/google.css"], "matches": ["*://*.google.com/*", "*://*.google.com.pk/*", "*://*/search?*", "*://google.com.pk/*", "*://*/#q*"]}, {"css": ["src/inject/fonts.css", "src/inject/youtube.css"], "matches": ["*://*.youtube.com/*"]}, {"css": ["src/inject/fonts.css", "src/inject/chatgpt.css"], "matches": ["*://chatgpt.com/*", "*://*.openai.com/*"]}, {"css": ["src/inject/fonts.css", "src/inject/gemini.css"], "matches": ["*://gemini.google.com/*"]}, {"css": ["src/inject/fonts.css", "src/inject/facebook.css"], "matches": ["*://*.facebook.com/*"]}, {"css": ["src/inject/fonts.css", "src/inject/sbs.css"], "matches": ["*://www.sbs.com.au/language/urdu/*"]}, {"css": ["src/inject/fonts.css", "src/inject/alarabiya.css"], "matches": ["*://urdu.alarabiya.net/*"]}, {"css": ["src/inject/fonts.css", "src/inject/cgtn.css"], "matches": ["*://urdu.cgtn.com/*"]}], "content_security_policy": "script-src 'self'; object-src 'self'", "default_locale": "en", "description": "Community fork of Urdu for Web: renders Urdu text on websites using a selectable bundled font (Mehr Nastaliq Web, Noto Nastaliq Urdu or Noto Naskh Arabic). Covers Google, Facebook, X/Twitter, WhatsApp, YouTube comments, ChatGPT, Gemini and other pages with Urdu language tags or RTL text.\n Mehr Nastalique Font is CC BY-SA 4.0 - Courtesy of Center for Speech And Language Technologies (CSaLT) - https://www.c-salt.org/downloads/mehr-e-nastaliq-font . Noto fonts are SIL Open Font License 1.1 - https://fonts.google.com/noto .", "homepage_url": "https://github.com/ishaqx/WebUrdu", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "manifest_version": 2, "name": "Urdu for Web - Community Edition", "short_name": "Urdu", "permissions": ["*://*/*", "storage"], "version": "3.6.1", "web_accessible_resources": ["src/inject/fonts/*.ttf"], "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "{3400be22-747d-4e98-81bc-cdfa0328d114}", "data_collection_permissions": {"required": ["none"]}}}}