{"manifest_version": 2, "name": "Remove Ai-Overview", "version": "1.1", "description": "appends the -ai string to every search query to remove ai overview", "icons": {"48": "icons/-ai_extension_icon_v3_48x48.png", "96": "icons/-ai_extension_icon_v3_96x96.png"}, "permissions": ["webRequest", "webRequestBlocking", "*://*.google.com/*"], "browser_specific_settings": {"gecko": {"id": "@Remove-AI-Overview", "data_collection_permissions": {"required": ["searchTerms"]}}}, "background": {"scripts": ["AppendString.js"]}}