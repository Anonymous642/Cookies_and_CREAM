{"manifest_version": 2, "name": "Dashboard Rotator & Auto-Scroll", "version": "1.1.0", "description": "Rota autom\u00e1ticamente entre pesta\u00f1as y hace scroll arriba/abajo en cada una. Ideal para monitores de monitoreo.", "permissions": ["tabs", "storage", "<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "Dashboard Rotator", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "commands": {"toggle-rotation": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Activar/desactivar la rotaci\u00f3n de pesta\u00f1as"}, "toggle-scroll": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Activar/desactivar el scroll autom\u00e1tico"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "dashboard-rotator@llinquiman.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}