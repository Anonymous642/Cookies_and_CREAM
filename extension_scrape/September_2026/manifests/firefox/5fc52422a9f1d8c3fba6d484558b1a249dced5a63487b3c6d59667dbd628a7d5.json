{"manifest_version": 3, "name": "TrailerSwitch Pro", "description": "Instantly preview movie trailers in a picture-in-picture window without leaving your current streaming or database page.", "version": "1.0.0", "author": "CineFlow Labs", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.imdb.com/*", "https://www.themoviedb.org/*", "https://www.rottentomatoes.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "trailerswitchpro@cineflowlabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}