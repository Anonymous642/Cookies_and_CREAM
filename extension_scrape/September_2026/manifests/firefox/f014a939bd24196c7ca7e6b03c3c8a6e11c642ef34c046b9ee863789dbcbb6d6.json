{"manifest_version": 3, "name": "HippoLink TCGplayer Sync", "description": "Keeps HippoLink's copy of this browser's TCGplayer seller session current, so a sign-in elsewhere never silently breaks sync.", "version": "0.3.0", "author": "HippoLink", "homepage_url": "https://hippolink.app", "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "tcgplayer-sync@hippolink.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "permissions": ["cookies", "alarms", "storage"], "host_permissions": ["*://*.tcgplayer.com/*", "https://api.hippolink.app/*"]}