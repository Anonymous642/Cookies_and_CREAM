{"manifest_version": 3, "name": "Time Gatherer - Better Browsing Habits", "version": "0.2.0", "description": "Set a daily time budget on a site, then lock it out until the next day. This extension allows you to build better browsing habits.", "browser_specific_settings": {"gecko": {"id": "time-gatherer@example.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "sessions", "alarms"], "optional_permissions": ["tabHide", "bookmarks"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "action": {"default_title": "Time Gatherer", "default_popup": "src/panel/panel.html", "default_icon": "icons/new-icon.png"}, "sidebar_action": {"default_title": "Time Gatherer", "default_panel": "src/panel/panel.html", "default_icon": "icons/new-icon.png"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "icons": {"48": "icons/new-icon.png", "96": "icons/new-icon.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open Time Gatherer"}, "close-duplicates": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Close duplicate tabs"}, "reopen-last-closed": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Reopen last closed tab"}}}