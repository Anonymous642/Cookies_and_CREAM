{"manifest_version": 3, "name": "SnapChart", "version": "1.1", "description": "SnapChart takes screenshots of memecoins charts and analyzes them with AI.", "action": {"default_popup": "popup.html", "default_title": "SnapChart"}, "icons": {"16": "snapchart_16.png", "32": "snapchart_32.png", "48": "snapchart_48.png", "128": "snapchart_128.png"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://*.dextools.io/*", "https://*.uniswap.org/*", "https://*.tradingview.com/*", "https://*.dexscreener.com/*", "https://*.geckoterminal.com/*", "https://snapchart.up.railway.app/*", "https://snapchart-backend.up.railway.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "@snapchart.oba", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}