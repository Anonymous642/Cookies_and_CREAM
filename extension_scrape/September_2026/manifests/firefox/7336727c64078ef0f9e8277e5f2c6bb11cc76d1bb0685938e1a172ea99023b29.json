{"manifest_version": 3, "name": "Codex Edge TTS Overlay", "version": "0.2.2", "description": "Inject a floating read-aloud and capture control on web pages for Hammerspoon-based Edge TTS playback.", "browser_specific_settings": {"gecko": {"id": "codex-edge-tts-overlay@jennie.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "permissions": ["storage", "clipboardWrite", "downloads", "tabs"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"], "preferred_environment": ["document", "service_worker"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page_bridge.js"], "matches": ["<all_urls>"]}]}