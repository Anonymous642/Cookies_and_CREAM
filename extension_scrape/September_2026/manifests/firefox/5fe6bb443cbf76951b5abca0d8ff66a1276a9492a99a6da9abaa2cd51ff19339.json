{"manifest_version": 3, "name": "Better UBS", "version": "0.4.3", "description": "Makes IKCU UBS navigation open in the current tab instead of forcing new tabs.", "author": "Enthros", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "better-ubs@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "host_permissions": ["https://ubs.ikc.edu.tr/*"], "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://ubs.ikc.edu.tr/*"]}], "content_scripts": [{"matches": ["https://ubs.ikc.edu.tr/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}