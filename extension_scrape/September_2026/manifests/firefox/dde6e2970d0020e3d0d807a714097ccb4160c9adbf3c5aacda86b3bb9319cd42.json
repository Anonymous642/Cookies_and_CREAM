{"manifest_version": 3, "name": "Focus Companion", "version": "1.7.2", "description": "A calm productivity companion that tracks your web activity and offers gentle insights.", "browser_specific_settings": {"gecko": {"id": "focuscompanion@focuscompanion.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteActivity", "personallyIdentifyingInfo", "technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Focus Companion", "default_popup": "browser/index.html#/popup", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_page": "browser/index.html#/options", "permissions": ["tabs", "storage", "idle", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service_worker.js"]}, "content_scripts": [{"matches": ["https://focuscompanion.app/*", "https://www.focuscompanion.app/*"], "js": ["auth_bridge.js"], "run_at": "document_idle"}]}