{"manifest_version": 2, "name": "Blahaj Tab Limiter", "version": "1.0.0", "description": "Limits the maximum number of open tabs. Click the toolbar icon to configure how many tabs are allowed.", "permissions": ["tabs", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Tab Limiter", "default_popup": "popup/popup.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "blahaj-tab-limiter@blahaj", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}