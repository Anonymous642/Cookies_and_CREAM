{"manifest_version": 3, "name": "YouTube Blur Bad Thumbnails", "short_name": "YT Blur", "version": "2.8", "description": "Blurs unwanted or clickbait thumbnails on YouTube homepage.", "author": "BayHatter", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icon-gray-16.png", "32": "icon-gray-32.png", "48": "icon-gray-48.png", "128": "icon-gray-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-gray-16.png", "32": "icon-gray-32.png", "48": "icon-gray-48.png", "128": "icon-gray-128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/", "*://youtube.com/"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-blur-thumbnails@bayhatter.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}