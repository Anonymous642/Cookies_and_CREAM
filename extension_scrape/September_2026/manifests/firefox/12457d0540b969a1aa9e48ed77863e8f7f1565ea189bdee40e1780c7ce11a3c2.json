{"manifest_version": 3, "name": "GoldFinder", "version": "1.1.0", "description": "Spot gold prospecting locations on Google Maps satellite view, with AI analysis", "permissions": ["storage", "activeTab", "tabs", "clipboardWrite", "scripting"], "host_permissions": ["*://www.google.com/*", "*://maps.google.com/*", "*://claude.ai/*", "https://api.anthropic.com/*", "https://api.openai.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.google.com/maps/*", "*://maps.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://claude.ai/*"], "js": ["claude_ai.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://www.google.com/maps/*", "*://maps.google.com/*"]}, {"resources": ["claude_inject.js"], "matches": ["*://claude.ai/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "goldfinder@codingwithjoe", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}