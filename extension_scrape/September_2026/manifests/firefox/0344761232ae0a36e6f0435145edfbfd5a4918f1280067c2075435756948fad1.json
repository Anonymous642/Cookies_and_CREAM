{"manifest_version": 2, "name": "Screen Capture Blocker", "version": "1.3", "description": "Attempts to deter screen capture and protect sensitive content on web pages.", "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_popup": "popup.html", "default_title": "Screen Capture Blocker"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Screen-Capture-Blocker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}