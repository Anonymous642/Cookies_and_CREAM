{"manifest_version": 2, "name": "Hotline Suwayomi", "version": "0.3", "description": "Open Suwayomi WebUI with a search for the current entry", "homepage_url": "https://github.com/blokyk/hotline-suwayomi", "icons": {"48": "icon.svg"}, "browser_action": {"default_icon": "icon.svg", "default_title": "Search in Suwayomi"}, "options_ui": {"page": "options.html", "browser_style": true}, "content_scripts": [{"matches": ["*://*.dynasty-scans.com/*"], "js": ["dynasty.js"], "run_at": "document_end"}], "permissions": ["activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "@blokyk.hotline-suwayomi", "strict_min_version": "58.0"}}}