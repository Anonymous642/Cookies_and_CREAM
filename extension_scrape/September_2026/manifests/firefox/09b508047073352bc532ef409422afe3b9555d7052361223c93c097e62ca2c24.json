{"manifest_version": 3, "name": "Twitter Filter", "description": "Filter and manage your feed on X (Twitter) based on customizable rules.", "version": "0.0.67", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://x.com/*", "https://twitter-filter.rxliuli.com/*"], "author": "rxliuli", "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "web_accessible_resources": [{"resources": ["/feed-filter-ui.js"], "matches": ["*://x.com/*"]}], "homepage_url": "https://store.rxliuli.com/extensions/twitter-filter/", "browser_specific_settings": {"gecko": {"id": "feed-filter-for-twitter@rxliuli.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://x.com/*"], "run_at": "document_start", "js": ["content-scripts/bridge.js"], "world": "ISOLATED"}, {"matches": ["*://x.com/*"], "run_at": "document_start", "js": ["content-scripts/filter.js"], "world": "MAIN"}]}