{"manifest_version": 3, "name": "Extract Links in Csv or Txt file", "version": "1.6", "description": "Extract links with titles from current page and download as CSV or TXT.", "author": "BayHatter", "permissions": ["activeTab", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "extractlinks@bayhatter.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}