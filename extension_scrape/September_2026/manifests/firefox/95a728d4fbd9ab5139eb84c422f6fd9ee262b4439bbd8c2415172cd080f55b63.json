{"manifest_version": 3, "name": "TradeYantra Multi Watchlist TV Sync", "version": "1.0.0", "description": "Receives TV_SYNC_BATCH payloads from TradeYantra and syncs multiple watchlists to TradingView.", "permissions": ["tabs", "storage"], "host_permissions": ["https://www.tradingview.com/*", "https://in.tradingview.com/*", "https://tradeyantra.com/*", "https://*.tradeyantra.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "multi-watchlist-sync@tradeyantra.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://tradeyantra.com/*", "https://*.tradeyantra.com/*"], "js": ["app-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.tradingview.com/*", "https://in.tradingview.com/*"], "js": ["tradingview-sync.js"], "run_at": "document_idle"}], "action": {"default_title": "TradeYantra Multi Watchlist TV Sync"}}