{"manifest_version": 3, "name": "Roost \u2014 Smart Tab Manager & Session Saver", "short_name": "Roost", "version": "1.1.2", "description": "Save, search, and restore your tabs. Smart tab manager with duplicate detection, RAM tracking, and auto-archive. Free to start.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "alarms", "notifications", "contextMenus", "unlimitedStorage"], "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save all tabs as a session"}, "search-tabs": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Roost search"}, "archive-old": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Archive stale tabs"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "roost@hakeemify.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}