{"manifest_version": 3, "name": "DialHard Click-to-Dial", "version": "1.0.1", "description": "Every phone number on the web becomes a call. Click a tel: link, your DialHard dialer opens with the number ready.", "homepage_url": "https://dialhard.com/browser-extension", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/config.js", "lib/tel.js", "lib/route.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/tel.js", "content/intercept.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}, {"matches": ["https://dialhard.com/*"], "js": ["lib/config.js", "content/workspace.js"], "run_at": "document_start"}], "action": {"default_title": "DialHard Click-to-Dial", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "click-to-dial@dialhard.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}