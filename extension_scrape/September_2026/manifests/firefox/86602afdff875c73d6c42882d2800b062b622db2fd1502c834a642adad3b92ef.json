{"manifest_version": 2, "name": "Quick AI Message Enhancer", "version": "1.2.3", "description": "AI-powered message improvement for Microsoft Teams (Firefox build, MV2 background page).", "permissions": ["https://*.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://generativelanguage.googleapis.com/*"], "browser_action": {"default_title": "AI Message Enhancer", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.microsoft.com/*", "https://*.teams.microsoft.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ai-message-enhancer@example.com", "strict_min_version": "102.0", "data_collection": {"collects_data": false}}}}