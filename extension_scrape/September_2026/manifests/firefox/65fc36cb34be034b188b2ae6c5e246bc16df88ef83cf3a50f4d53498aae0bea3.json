{"manifest_version": 3, "name": "Filter Forge", "description": "Turn a Diablo 4 build guide into in-game loot filter import codes, with adjustable strictness.", "version": "0.1.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://maxroll.gg/*", "https://planners.maxroll.gg/*", "https://assets-ng.maxroll.gg/*"], "action": {"default_title": "Filter Forge"}, "browser_specific_settings": {"gecko": {"id": "filterforge@filterforge.dev", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["sidepanel.html", "chunks/*", "assets/*", "icon/*"], "matches": ["https://maxroll.gg/*", "https://d4builds.gg/*", "https://infinitybuilds.gg/*", "https://mobalytics.gg/*", "https://www.mobalytics.gg/*"]}], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Filter Forge"}, "content_scripts": [{"matches": ["https://d4builds.gg/builds/*"], "js": ["content-scripts/d4builds.js"]}, {"matches": ["https://infinitybuilds.gg/*"], "js": ["content-scripts/infinitybuilds.js"]}, {"matches": ["https://maxroll.gg/d4/*"], "js": ["content-scripts/maxroll.js"]}, {"matches": ["https://mobalytics.gg/diablo-4/builds/*", "https://mobalytics.gg/diablo-4/profile/*/builds/*", "https://www.mobalytics.gg/diablo-4/builds/*", "https://www.mobalytics.gg/diablo-4/profile/*/builds/*"], "js": ["content-scripts/mobalytics.js"]}]}