{"manifest_version": 3, "name": "ScrollBrake", "version": "1.0.0", "description": "Mindful Instagram \u2014 hides Reels to reduce screen time while keeping DMs, Stories, Posts & Feed.", "browser_specific_settings": {"gecko": {"id": "scrollbrake@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://www.instagram.com/*"], "content_scripts": [{"matches": ["*://www.instagram.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "icons/*"], "matches": ["*://www.instagram.com/*"]}]}