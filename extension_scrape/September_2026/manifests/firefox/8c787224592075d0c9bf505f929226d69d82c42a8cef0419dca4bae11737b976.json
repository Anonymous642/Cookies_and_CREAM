{"manifest_version": 3, "name": "Andoxa", "version": "1.2.0", "description": "Import de profils LinkedIn vers Andoxa", "permissions": ["tabs", "activeTab", "storage"], "host_permissions": ["*://*.linkedin.com/*", "https://*.supabase.co/*", "https://andoxa.fr/*", "https://*.andoxa.fr/*", "http://localhost:3000/*"], "content_scripts": [{"matches": ["https://andoxa.fr/*", "https://*.andoxa.fr/*", "http://localhost:3000/*"], "js": ["content.js"], "run_at": "document_start"}], "sidebar_action": {"default_icon": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png"}, "default_panel": "panel.html", "default_title": "Ouvrir Andoxa", "open_at_install": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "andoxa@andoxa.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}