{"manifest_version": 2, "name": "OLED Stream Guard", "version": "0.2.2", "description": "Reduces OLED burn-in on Twitch and Kick: black backgrounds, no borders, hidden chat controls, and chat that alternates sides.", "browser_specific_settings": {"gecko": {"id": "oled-stream-guard@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage"], "browser_action": {"default_icon": "icons/icon.svg", "default_title": "OLED Stream Guard", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*", "*://*.kick.com/*"], "css": ["oled.css"], "js": ["content.js"], "run_at": "document_idle"}]}