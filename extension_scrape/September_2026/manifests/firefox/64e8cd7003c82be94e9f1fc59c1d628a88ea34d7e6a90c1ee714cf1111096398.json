{"manifest_version": 3, "name": "azdefark", "version": "1.3.1", "description": "Monitors URLs on dev.azure.com and updates the tab title with the 'path' query parameter for _library pages, applying custom regex transformations.", "browser_specific_settings": {"gecko": {"id": "pasi.savolainen@iki.fi", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://dev.azure.com/*"], "content_scripts": [{"matches": ["https://dev.azure.com/*"], "js": ["content.compiled.js"], "run_at": "document_end"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "options.html", "default_title": "Open Options"}}