{"manifest_version": 3, "name": "FundHub Clipper", "version": "1.0.1", "description": "Add items to your FundHub requests and drafts from any vendor's product page \u2014 budgets, approvals, and shipping in one place.", "default_locale": "en", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "FundHub Clipper", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "scripts": ["src/background/service-worker.js"], "type": "module"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://*.google.com/*", "*://accounts.google.com/*", "*://*.facebook.com/*"], "js": ["src/extraction/generic.js", "src/extraction/vendors.js", "src/extraction/router.js", "src/content/content-script.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "fundhub-clipper@braintree4me.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": []}}}}