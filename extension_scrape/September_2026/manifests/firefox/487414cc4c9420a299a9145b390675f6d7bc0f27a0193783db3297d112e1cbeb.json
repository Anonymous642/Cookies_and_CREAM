{"manifest_version": 2, "name": "SongSnippet Saver", "version": "1.0.0", "description": "Save short music snippets (10-20s) from media on pages.", "permissions": ["activeTab", "tabs", "storage", "<all_urls>"], "browser_action": {"default_title": "SongSnippet Saver", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "@songsnippet.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}