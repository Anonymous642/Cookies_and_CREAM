{"manifest_version": 3, "name": "Reverse Image Search Menu", "version": "1.0.0", "description": "Open a public image URL in Google Lens, Bing Visual Search, or TinEye from a popup or image context menu.", "permissions": ["menus", "storage", "clipboardWrite"], "background": {"scripts": ["search-core.js", "background.js"]}, "action": {"default_title": "Reverse image search", "default_popup": "popup.html", "default_icon": {"48": "assets/icon.svg", "96": "assets/icon.svg"}}, "icons": {"48": "assets/icon.svg", "96": "assets/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "reverse-image-search-menu@local.tools", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}