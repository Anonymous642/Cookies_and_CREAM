{"manifest_version": 2, "name": "TRC Partner Auto Poster", "description": "Receives queued TRC Partner jobs and posts to Facebook from your logged-in browser session.", "version": "0.1.5", "permissions": ["storage", "tabs", "alarms", "*://www.facebook.com/*", "*://m.facebook.com/*", "*://facebook.com/*", "https://*/*", "http://*/*", "http://localhost/*", "https://*.trc.inc/*", "https://relationshipconstitution.com/*", "https://www.relationshipconstitution.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "TRC Auto Poster", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@trc-partner-auto-poster", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "options_page": "options.html", "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://facebook.com/*", "https://m.facebook.com/*", "http://m.facebook.com/*"], "js": ["facebookContentScript.js"], "run_at": "document_end"}, {"matches": ["http://localhost/*", "https://*.trc.inc/*", "https://relationshipconstitution.com/*", "https://www.relationshipconstitution.com/*"], "js": ["trcBridgeContentScript.js"], "run_at": "document_idle"}]}