{"manifest_version": 3, "name": "Username Autofill for Reddit", "version": "1.0", "description": "Saves and autofills the last used Reddit username because Reddit won't fix their login page.", "permissions": ["storage"], "icons": {"16": "icon-16x16.png", "32": "icon-32x32.png", "192": "icon-192x192.png", "512": "icon-512x512.png"}, "browser_specific_settings": {"gecko": {"id": "{7e15d061-3a04-4dc6-b625-a038d6934a4c}", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}