{"manifest_version": 2, "name": "SuperTools - All-In-One Browser Toolkit", "version": "2.0.0", "version_name": "2.0.0", "description": "20+ browser tools in one extension. Calculator, Converter, Color Picker, JSON, Dark Mode, Password Gen & more. 100% offline.", "author": "SuperTools Team", "homepage_url": "https://github.com/supertools-addon/supertools", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "supertools@addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "clipboardWrite", "clipboardRead", "notifications", "contextMenus", "tabs"], "web_accessible_resources": ["icons/*.png", "popup/qrcode.min.js"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-48.png", "48": "icons/icon-48.png"}, "default_title": "SuperTools - All-In-One Toolkit", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}