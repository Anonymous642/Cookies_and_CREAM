{"manifest_version": 3, "name": "LiteTab DDR3", "version": "1.1.1", "description": "Optimizador de memoria y CPU para Firefox. Detecta DDR3/DDR4/DDR5, reduce RAM, limita FPS, suspende pesta\u00f1as, bloquea publicidad y puede congelar programas del sistema mientras navegas.", "author": "LiteTab DDR3 Project", "homepage_url": "https://github.com/litetal-ddr3/litetal-firefox", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "LiteTab DDR3 \u2014 clic para abrir panel"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"], "run_at": "document_start", "all_frames": false}], "declarative_net_request": {"rule_resources": [{"id": "adblock_rules", "enabled": true, "path": "rules/adblock-rules.json"}]}, "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest", "declarativeNetRequestFeedback", "scripting", "activeTab", "nativeMessaging"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["content-scripts/fps-limiter.js", "content-scripts/optimizer.js"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "litetal-ddr3@extension", "strict_min_version": "109.0"}}}