{"manifest_version": 3, "name": "Universal Frame Stepper", "version": "1.0.0", "description": "Play HTML5 videos frame-by-frame on any website using YouTube's shortcuts (, and .).", "permissions": ["storage"], "icons": {"48": "icons/icon48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Frame Stepper Settings", "default_icon": {"48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "framestepper@your-own-name.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}