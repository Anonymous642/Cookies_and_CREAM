{"manifest_version": 2, "name": "Autoload Pinned Tabs", "version": "1.1", "description": "Opens your sites in pinned tabs when Firefox starts. / Ouvre vos sites dans des onglets \u00e9pingl\u00e9s au d\u00e9marrage de Firefox.", "icons": {"32": "icons/autoload-pinned-tabs.svg", "48": "icons/autoload-pinned-tabs.svg", "64": "icons/autoload-pinned-tabs.svg", "96": "icons/autoload-pinned-tabs.svg"}, "permissions": ["storage", "tabs"], "background": {"scripts": ["sites.js", "background.js"]}, "browser_action": {"default_icon": "icons/autoload-pinned-tabs.svg", "default_title": "Configure pinned tabs / Configurer les onglets \u00e9pingl\u00e9s"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "pinned-startup@pluginfirefox.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}