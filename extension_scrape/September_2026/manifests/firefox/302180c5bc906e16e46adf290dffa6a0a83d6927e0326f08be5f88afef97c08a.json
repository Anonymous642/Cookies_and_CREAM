{"manifest_version": 3, "name": "CleanFeedFB", "version": "1.2.0", "description": "Hides Facebook posts that contain Follow or Join links, and removes Sponsored ads from your timeline", "homepage_url": "https://github.com/salvoventura/CleanFeedFB", "browser_specific_settings": {"gecko": {"id": "cleanfeedfb@extension.local", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["libs/browser-polyfill.min.js", "common/constants.js", "common/logger.js", "content-script/detector.js", "content-script/dom-utils.js", "content-script/scanner.js", "content-script/saver.js", "content-script/index.js"], "run_at": "document_end"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/hiding-apps-icon-16.png", "48": "icons/hiding-apps-icon-48.png", "128": "icons/hiding-apps-icon-128.png"}, "action": {"default_title": "CleanFeedFB", "default_popup": "popup/popup.html"}}