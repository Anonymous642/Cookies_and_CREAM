{"manifest_version": 3, "name": "Deskletics \u2014 Movement Breaks", "version": "0.1.0", "description": "Gentle desk-exercise breaks in your browser: every X minutes your screen fades into a 60-second guided reset. Skip or snooze anytime.", "permissions": ["alarms", "storage", "scripting", "idle"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["shared/defaults.js", "shared/exercises.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Deskletics", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@deskletics.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "healthInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}