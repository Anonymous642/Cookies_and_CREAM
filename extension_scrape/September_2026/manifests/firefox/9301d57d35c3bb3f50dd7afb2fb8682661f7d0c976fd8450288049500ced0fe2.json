{"manifest_version": 3, "name": "Epic Freebies", "version": "1.3.0", "description": "Displays the current and upcoming free games from the Epic Games Store. Can notify you when new freebies are available.", "permissions": ["storage", "alarms"], "optional_permissions": ["notifications"], "host_permissions": ["https://*.epicgames.com/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "action": {"default_popup": "index.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "epic-freebies@lancamp.dev", "data_collection_permissions": {"required": ["none"]}}}}