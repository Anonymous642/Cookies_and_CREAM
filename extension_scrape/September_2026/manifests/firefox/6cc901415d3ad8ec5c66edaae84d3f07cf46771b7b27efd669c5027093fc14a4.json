{"manifest_version": 2, "name": "Kiekucheck", "version": "1.2", "description": "Worktime summary tool for Finnish government employees using CGI HRM (Kieku). All processing is local \u2014 no data is sent anywhere.", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "kiekucheck@kiekucheck", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*/wsector/pages/pw/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}