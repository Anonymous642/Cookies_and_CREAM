{"manifest_version": 3, "name": "clipr.bot \u2014 Video Downloader", "version": "1.2.0", "description": "Download videos from Instagram, YouTube, TikTok, VK, X, Boosty and 1000+ sites in your chosen format \u2014 powered by clipr.bot.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "clipr.bot", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["downloads", "storage", "activeTab"], "host_permissions": ["https://clipr.bot/*"], "content_scripts": [{"matches": ["*://*.instagram.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.tiktok.com/*", "*://*.vk.com/*", "*://*.vk.ru/*", "*://*.vkvideo.ru/*", "*://*.vkontakte.ru/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.fb.watch/*", "*://*.reddit.com/*", "*://*.twitch.tv/*", "*://*.vimeo.com/*", "*://*.boosty.to/*"], "js": ["i18n.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon128.png", "icons/icon512.png"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "clipr@clipr.bot", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}