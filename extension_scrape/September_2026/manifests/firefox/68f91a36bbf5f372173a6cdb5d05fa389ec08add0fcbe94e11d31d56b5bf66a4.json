{"manifest_version": 3, "name": "Short URL QR Code", "version": "1.2.0", "description": "Shorten the current or entered URL and generate a QR code.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://tinyurl.com/*", "https://v.gd/*", "https://spoo.me/*", "https://api-ssl.bitly.com/*", "https://api.reurl.cc/*"], "action": {"default_icon": {"32": "icons/icon-32.png", "64": "icons/icon-64.png"}, "default_title": "Shorten URL and create QR code", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "short-url-qrcode@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}