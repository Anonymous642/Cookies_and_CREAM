{"manifest_version": 3, "name": "Page Mind \u2014 AI Page Summarizer", "description": "AI-powered webpage summarizer with history. Bring your own API key.", "version": "0.5.1", "short_name": "Page Mind", "icons": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Page Mind", "default_icon": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "page-mind@xggaxlc.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png"}, "default_title": "Page Mind"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}