{"manifest_version": 2, "name": "Search automatic rewards", "description": "Script that gives you maximum amount of microsoft rewards points every day automatically or by a click of a button.", "version": "3.1.0", "icons": {"16": "imgs/logo.png", "32": "imgs/logo2.png", "48": "imgs/logo2.png", "128": "imgs/logo3.png"}, "permissions": ["storage", "alarms"], "browser_specific_settings": {"gecko": {"id": "microsoft_automatic_rewards@example.com", "strict_min_version": "91.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Search automatic rewards", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.bing.com/search*"], "js": ["content-scripts/bingResult.js"]}, {"matches": ["https://rewards.bing.com/*"], "js": ["content-scripts/rewards.js"]}]}