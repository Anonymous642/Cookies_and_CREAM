{"manifest_version": 3, "name": "Quick Git Clone", "short_name": "QGC", "version": "1.0.0", "description": "Add Clone & Open buttons to repository pull requests for quick git cloning and editor opening", "permissions": ["activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Quick Git Clone", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "quick-git-clone@your-domain.com", "strict_min_version": "109.0"}}}