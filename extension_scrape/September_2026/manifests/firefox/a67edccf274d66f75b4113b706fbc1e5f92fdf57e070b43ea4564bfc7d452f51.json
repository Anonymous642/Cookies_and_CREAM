{"manifest_version": 2, "name": "TwitchMe", "version": "1.1.6", "description": "Auto-opens Twitch streams when channels go live", "browser_specific_settings": {"gecko": {"id": "twitchme@extension", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "alarms", "tabs", "scripting", "https://*.twitch.tv/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "TwitchMe"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": ["help/adblockers.html"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}