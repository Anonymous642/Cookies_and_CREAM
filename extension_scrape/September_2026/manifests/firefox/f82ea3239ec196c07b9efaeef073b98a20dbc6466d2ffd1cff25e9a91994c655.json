{"manifest_version": 2, "name": "Auction Photo Saver", "version": "1.5.1", "description": "Download only the current AuctionTime or EquipmentFacts listing photos and create a photo-only PDF report.", "permissions": ["activeTab", "downloads", "tabs", "*://*.auctiontime.com/*", "*://*.equipmentfacts.com/*", "*://media.sandhills.com/*"], "content_scripts": [{"matches": ["*://*.auctiontime.com/listing/*", "*://*.equipmentfacts.com/listing/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Auction Photo Saver", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "auction-photo-saver@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}