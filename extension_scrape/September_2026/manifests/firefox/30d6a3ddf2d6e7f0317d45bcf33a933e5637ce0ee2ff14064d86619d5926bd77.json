{"manifest_version": 3, "name": "ComicKChapterSearch", "version": "3.1.4", "description": "Because publishers forced ComicK to remove searching, this adds it back. Along with the ability to add your own for different series.", "permissions": ["storage", "tabs"], "host_permissions": ["https://comick.dev/*"], "browser_specific_settings": {"gecko": {"id": "comickchaptersearch@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48x48.png", "128": "icons/128x128.png", "512": "icons/512x512.png"}, "action": {"default_title": "ComicKChapterSearch", "default_popup": "popup.html", "default_icon": {"48": "icons/48x48.png", "128": "icons/128x128.png", "512": "icons/512x512.png"}}, "content_scripts": [{"matches": ["https://comick.dev/*"], "js": ["shared.js", "content.js", "content.main.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["icons/*.png", "shared.js", "popup.html", "popup.js"], "matches": ["https://comick.dev/*"]}]}