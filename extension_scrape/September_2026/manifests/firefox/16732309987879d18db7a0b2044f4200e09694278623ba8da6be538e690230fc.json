{"manifest_version": 2, "name": "Spotlight Reader", "version": "1.7", "description": "A focus aid for reading long pages: darken everything except a moving band or spotlight under your cursor, so your eyes stay on the current line. Tune the dimness and the size of the clear area.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{77547051-9ffe-425e-856d-2e2d8ec723b6}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Spotlight Reader", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}