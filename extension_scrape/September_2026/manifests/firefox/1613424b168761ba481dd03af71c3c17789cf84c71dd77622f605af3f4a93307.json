{"manifest_version": 3, "name": "TAB Detox", "version": "0.1.2", "description": "Save tabs, set an expiry, archive them automatically, and restore them anytime. Optimized for Firefox-family browsers.", "permissions": ["tabs", "storage", "alarms", "contextMenus", "notifications"], "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "TAB Detox", "default_popup": "src/popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save the current tab to TAB Detox"}}, "browser_specific_settings": {"gecko": {"id": "tab-detox-firefox@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}