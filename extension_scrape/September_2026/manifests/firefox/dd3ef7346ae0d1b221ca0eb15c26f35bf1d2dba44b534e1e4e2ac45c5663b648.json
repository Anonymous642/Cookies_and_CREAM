{"manifest_version": 2, "name": "Hardware Key Passkey Redirect", "version": "1.2.1", "description": "Catches WebAuthn conditional-mediation (passkey autofill) requests and offers a 'Sign in with hardware key' modal rewritten with security-key hints. Keeps rpId/challenge intact.", "homepage_url": "https://gitlab.com/webauthn-tools/hardware_key_passwordless_login", "author": "\u00c1bel P\u00f3ta", "permissions": ["activeTab", "storage"], "icons": {"48": "icon/hardware_key_passwordless_login_icon.svg", "96": "icon/hardware_key_passwordless_login_icon.svg"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["src/injected.js"], "browser_action": {"default_title": "Hardware Key Redirect", "default_icon": "icon/hardware_key_passwordless_login_icon.svg", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "hardware-key-redirect@abelpota", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}