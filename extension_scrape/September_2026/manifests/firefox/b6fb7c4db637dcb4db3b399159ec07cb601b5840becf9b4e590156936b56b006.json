{"manifest_version": 3, "name": "Margin \u2014 Sidebar Notes", "version": "1.6.0", "description": "Take notes in the Firefox sidebar while you browse. Clip selected text from any page, search titles and bodies, pin what matters.", "homepage_url": "https://github.com/YOUR-USERNAME/margin-sidebar-notes", "author": "YOUR NAME", "browser_specific_settings": {"gecko": {"id": "margin-sidebar-notes@YOUR-DOMAIN.example", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "menus"], "background": {"scripts": ["lib/notes.js", "background.js"]}, "sidebar_action": {"default_title": "Notes", "default_panel": "sidebar/panel.html", "default_icon": "icons/icon.svg", "open_at_install": true}, "action": {"default_title": "Show notes sidebar", "default_icon": "icons/icon.svg"}, "icons": {"32": "icons/app-32.png", "48": "icons/app-48.png", "96": "icons/app-96.png", "128": "icons/app-128.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Show or hide the notes sidebar"}}}