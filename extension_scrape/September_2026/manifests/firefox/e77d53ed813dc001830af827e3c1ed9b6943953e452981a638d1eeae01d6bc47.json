{"manifest_version": 3, "name": "Nowted Web Clipper", "version": "0.1.19", "description": "Save articles, highlights, web pages, and transcripts to Markdown or your local Nowted notebooks. Private and offline-first.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage", "alarms", "contextMenus", "tabs"], "host_permissions": ["<all_urls>", "http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["dist/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "action": {"default_title": "Clip to Nowted", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "commands": {"quick-clip": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Clip article directly to Nowted"}, "clip-to-daily": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Append clip to Today's Daily Note"}, "toggle-highlighter": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Toggle in-page text highlighter"}}, "background": {"scripts": ["dist/background.js"]}, "browser_specific_settings": {"gecko": {"id": "web-clipper@nowted.com", "data_collection_permissions": {"required": ["none"]}}}}