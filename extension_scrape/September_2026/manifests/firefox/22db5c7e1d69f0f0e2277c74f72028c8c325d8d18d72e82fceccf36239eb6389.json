{"manifest_version": 3, "name": "AliExpress Review Extractor", "version": "1.0", "author": "Matthew Moura", "description": "Extracts the top reviews from an AliExpress product page.", "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*", "*://*.aliexpress.ru/*", "*://*.aliexpress.ca/*"], "browser_specific_settings": {"gecko": {"id": "aliexpress-review-extractor@matthewmoura.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "Extract Reviews", "default_icon": "img.png"}, "icons": {"16": "img.png", "32": "img.png", "48": "img.png", "128": "img.png"}}