{"manifest_version": 3, "name": "Multivex", "version": "1.8.0", "description": "Manage separate Firefox container sessions for multiple Discord, Instagram and X accounts, with automatic unread tracking and optional cross-device sync.", "permissions": ["contextualIdentities", "cookies", "tabs", "storage", "notifications"], "host_permissions": ["https://discord.com/*", "https://www.discord.com/*", "https://instagram.com/*", "https://www.instagram.com/*", "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://*.workers.dev/*"], "action": {"default_title": "Multivex", "default_popup": "workspace.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "sidebar_action": {"default_title": "Multivex", "default_panel": "workspace.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "open_at_install": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://discord.com/*", "https://www.discord.com/*"], "js": ["discord-monitor.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "umair-workspace@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "commands": {"open-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Multivex sidebar"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}