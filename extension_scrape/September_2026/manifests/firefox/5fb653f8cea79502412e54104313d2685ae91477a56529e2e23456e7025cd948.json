{"manifest_version": 2, "name": "Kitsumi", "version": "7.5.58", "description": "Smart, multilingual YouTube / Netflix / anime subtitle overlay with multi-dictionary Yomitan support, intense study mode, memory words, gamified XP/level/rank progression, and directional tokenization.", "author": "Kitsumi", "homepage_url": "https://kitsumi.org", "content_security_policy": "script-src 'self' blob:; object-src 'self'", "browser_action": {"default_popup": "popup.html", "default_title": "Kitsumi", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "background": {"scripts": ["lib/browser-polyfill.js", "lib/fflate.min.js", "lib/dict-storage.js", "lib/dict-parse.js", "lib/epparse.js", "lib/selection.js", "lib/optcache.js", "lib/substate.js", "lib/spadetect.js", "lib/mining.js", "lib/providers-core.js", "lib/providers.js", "lib/game.js", "lib/searchstate.js", "lib/searchbridge.js", "lib/ocr-engine.js", "lib/deinflect.js", "lib/scan.js", "lib/fontstore.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["lib/yt-page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.netflix.com/*"], "js": ["lib/nfx-page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.crunchyroll.com/*"], "js": ["lib/cr-page-bridge.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "lib/subtitle-parser.js", "lib/deinflect.js", "lib/tokenizer.js", "lib/dictstate.js", "lib/optcache.js", "lib/epparse.js", "lib/selection.js", "lib/substate.js", "lib/spadetect.js", "lib/mining.js", "lib/fshost.js", "lib/recorder.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"quick-mine-current-subtitle": {"description": "Kitsumi: quick-mine the current subtitle"}, "toggle-current-site-allowlist": {"description": "Kitsumi: a