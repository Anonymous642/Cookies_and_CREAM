{"manifest_version": 3, "name": "Scrapi", "version": "1.0", "description": "Scrape emails and phone numbers from any website and export to CSV.", "permissions": ["storage", "scripting", "activeTab", "downloads", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icon_.png", "48": "icon_.png", "128": "icon_.png"}, "browser_specific_settings": {"gecko": {"id": "scrapi@example.com", "strict_min_version": "109.0"}}}