{"manifest_version": 2, "name": "Fixvx Link Copier", "version": "1.0", "description": "Copies X/Twitter post URLs but rewrites x.com to fixvx.com.", "permissions": ["contextMenus", "tabs", "activeTab", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://x.com/*", "*://*.x.com/*"], "js": ["content.js"]}], "icons": {"128": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "fixvx@Nimiato.fox", "data_collection_permissions": {"required": ["none"], "collects_install_time": false, "collects_update_time": false, "collects_events": false}}}}