{"manifest_version": 2, "name": "NoDis", "version": "1.1", "description": "Blocks any pages you want", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "NoDis@NoDis", "data_collection_permissions": {"required": ["none"], "collects_sensitive_data": false, "collects_device_identifiers": false, "collects_payment_info": false, "collects_location": false, "collects_browsing_history": false, "collects_form_data": false}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png"}, "browser_action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["nodis.js"], "run_at": "document_end"}]}