{"manifest_version": 3, "name": "Modo Mudae", "version": "0.1.2", "description": "Simplifica visualmente Discord Web para canales de Mudae.", "permissions": ["storage"], "host_permissions": ["https://discord.com/*"], "browser_specific_settings": {"gecko": {"id": "modo-mudae@xseesx.dev", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Modo Mudae", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://discord.com/channels/*"], "js": ["content.js"], "css": ["mudae.css"], "run_at": "document_idle"}]}