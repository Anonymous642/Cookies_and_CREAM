{"manifest_version": 3, "name": "Translucent AI - Page Summarizer", "browser_specific_settings": {"gecko": {"id": "translucent-ai@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "version": "1.1", "description": "Analyze and summarize web pages using OpenRouter's free AI models.", "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://openrouter.ai/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}, "commands": {"stealth-analyze": {"suggested_key": {"default": "Alt+S"}, "description": "Run Stealth Analysis (Invisible)"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open Settings (API Key)"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}