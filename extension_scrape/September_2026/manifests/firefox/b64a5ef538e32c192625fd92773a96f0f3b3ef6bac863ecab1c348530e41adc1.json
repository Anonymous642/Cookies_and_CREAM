{"manifest_version": 2, "name": "APXM", "description": "A mobile browser extension for Prosperous Universe", "version": "1.3.0", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "https://apex.prosperousuniverse.com/*", "https://rest.fnar.net/*"], "web_accessible_resources": ["ws-interceptor.js", "icon-48.png", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "apxm@27bit.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://apex.prosperousuniverse.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}