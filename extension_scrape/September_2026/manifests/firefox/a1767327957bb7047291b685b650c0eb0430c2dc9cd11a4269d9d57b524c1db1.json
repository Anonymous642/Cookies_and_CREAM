{"manifest_version": 3, "name": "RenderDiff - SEO Rendering Diff Checker", "version": "1.9", "description": "Compares raw HTML with the JavaScript-rendered DOM to find SEO-relevant differences in meta tags, headings, and more.", "permissions": ["activeTab", "scripting", "clipboardWrite", "downloads", "storage", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "RenderDiff - Scan this page for SEO rendering differences"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "renderdiff@timberlin.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}