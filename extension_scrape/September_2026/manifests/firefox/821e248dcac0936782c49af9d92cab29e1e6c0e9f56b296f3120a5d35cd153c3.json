{"manifest_version": 3, "name": "ONOXSOFT Hosting Control Panel", "short_name": "ONOXSOFT", "description": "Monitor and manage hosting servers, WordPress sites, DNS, SSL, services, health, alerts and backups directly from Firefox.", "version": "3.0.1", "permissions": ["alarms", "activeTab", "identity", "notifications", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "ONOXSOFT Panel", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "onoxsoft-hosting-control-panel@onoxsoft.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}