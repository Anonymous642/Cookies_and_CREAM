{"manifest_version": 3, "name": "Kick Twitchify", "version": "0.1.0", "description": "Adoucit le design de Kick.com pour le rapprocher de Twitch.", "author": "DonneLaPapatte", "browser_specific_settings": {"gecko": {"id": "kick-twitchify@donnelapapatte", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://kick.com/*"], "js": ["content.js"], "css": ["kick-twitch.css"], "run_at": "document_start"}]}