{"manifest_version": 3, "name": "WPT \u2014 Web Page Translate", "version": "1.0.6", "description": "Translate the whole open page in place. Google (free, no key) or LibreTranslate with automatic fallback.", "browser_specific_settings": {"gecko": {"id": "{bbd1ae6c-02af-4429-9900-291d6f21a489}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://translate.googleapis.com/*", "https://translate.google.com/*", "https://clients5.google.com/*", "https://api.mymemory.translated.net/*", "https://libretranslate.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "WPT \u2014 Web Page Translate", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["translate-core.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}