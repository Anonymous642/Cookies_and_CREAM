{"manifest_version": 3, "name": "Z.ai Usage Helper", "version": "0.2.0", "description": "Shows 5-hour quota reset time, countdown and subscription info on z.ai coding plan usage page.", "host_permissions": ["https://z.ai/*", "https://api.z.ai/*"], "content_scripts": [{"matches": ["https://z.ai/manage-apikey/coding-plan/personal/usage*", "https://z.ai/*/manage-apikey/coding-plan/personal/usage*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "zai-usage-helper@nniicckk", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}}