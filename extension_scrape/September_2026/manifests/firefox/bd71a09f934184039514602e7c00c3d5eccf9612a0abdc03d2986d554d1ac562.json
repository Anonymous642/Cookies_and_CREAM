{"manifest_version": 3, "name": "Sticky Highlighter", "version": "1.0.0", "description": "Highlight selected text on a page and save highlights per URL. Restore or clear highlights anytime.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Sticky Highlighter", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "sticky-highlighter@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}