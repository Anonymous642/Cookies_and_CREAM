{"manifest_version": 2, "name": "CleanFolder \u2014 Download Manager", "version": "2.7", "description": "Organize downloads automatically. Decide what to keep vs discard at download time.", "permissions": ["downloads", "storage", "notifications", "alarms", "<all_urls>"], "background": {"scripts": ["src/background/background-bundled.js"]}, "browser_action": {"default_popup": "src/popup/popup.html", "default_title": "CleanFolder"}, "options_ui": {"page": "src/options/options.html", "browser_style": false}, "browser_specific_settings": {"gecko": {"id": "cleanfolder@custom.icon", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.png"}}