{"manifest_version": 2, "name": "PiP Hotkey Toggle", "version": "3.0.0", "description": "Toggle Picture-in-Picture for the current page's video with a hotkey you set yourself.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["activeTab", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "icon.svg", "default_title": "PiP Hotkey Toggle", "default_popup": "popup.html"}, "commands": {"toggle-pip": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Toggle Picture-in-Picture"}}, "browser_specific_settings": {"gecko": {"id": "pip-hotkey-toggle@local.ext", "data_collection_permissions": {"required": ["none"]}}}}