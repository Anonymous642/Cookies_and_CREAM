{"manifest_version": 3, "name": "Folara", "version": "1.0.0", "description": "Save useful things to Folara from your browser.", "homepage_url": "https://folara.app", "permissions": ["activeTab", "contextMenus", "scripting", "tabs"], "action": {"default_icon": {"32": "icons/icon-32.png"}, "default_popup": "popup.html", "default_title": "Folara"}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://folara.app/*"], "icons": {"32": "icons/icon-32.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}, "id": "extension@folara.app", "strict_min_version": "140.0"}}}