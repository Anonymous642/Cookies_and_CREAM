{"manifest_version": 2, "name": "Quick List Solo", "version": "1.4", "description": "A standalone extension for those who just want a link list and not the full RNLA.", "browser_action": {"default_title": "Quick List Solo", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open Quick List Solo"}}, "permissions": ["storage", "tabs", "contextMenus", "clipboardWrite"], "options_ui": {"page": "settings.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "quick-list-solo@rnla", "data_collection_permissions": {"required": ["none"]}}}}