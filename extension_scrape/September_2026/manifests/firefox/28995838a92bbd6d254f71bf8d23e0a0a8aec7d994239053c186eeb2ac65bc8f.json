{"manifest_version": 3, "name": "XCircle Link Sender", "version": "1.0.0", "description": "Quickly send a link to the current page to XCircle.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://inxa.one/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "xcircle@nexth.one", "strict_min_version": "142.0", "android": {"strict_min_version": "142.0"}, "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}}