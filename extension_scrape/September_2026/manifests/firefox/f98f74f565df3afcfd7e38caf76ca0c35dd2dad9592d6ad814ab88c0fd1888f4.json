{"manifest_version": 2, "name": "Azure Resource Nicknames", "description": "A browser extension that allows users to assign and manage custom nicknames for their Azure resources in the Azure Portal.", "version": "1.0.0", "icons": {"96": "icon/96.png"}, "permissions": ["storage", "https://portal.azure.com/*", "https://*.reactblade.portal.azure.net/*"], "browser_action": {"default_title": "Azure Resource Nicknames", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.reactblade.portal.azure.net/*", "https://portal.azure.com/*"], "all_frames": true, "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "@azure-resource-nicknames", "data_collection_permissions": {"required": ["none"]}}}}