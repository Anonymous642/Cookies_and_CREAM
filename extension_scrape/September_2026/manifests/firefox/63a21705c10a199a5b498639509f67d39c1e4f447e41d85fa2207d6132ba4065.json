{"manifest_version": 2, "name": "Opteamex Click-to-Call", "version": "1.0.0", "description": "Detects phone numbers on any webpage and triggers calls via Yeastar Linkus Web App or Linkus Desktop", "permissions": ["activeTab", "tabs", "storage", "scripting", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "exclude_matches": ["*://*/linkus*", "*://*/*linkus*"]}], "browser_action": {"default_popup": "popup.html", "default_title": "Opteamex Click-to-Call", "default_icon": {"8": "icons/opteam-8x8.png", "16": "icons/opteam-16x16.png", "32": "icons/opteam-32x32.png"}}, "icons": {"8": "icons/opteam-8x8.png", "16": "icons/opteam-16x16.png", "32": "icons/opteam-32x32.png"}, "web_accessible_resources": ["icons/opteam-8x8.png", "content.css"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "opteam-click-to-call@opteamex.fr"}}}