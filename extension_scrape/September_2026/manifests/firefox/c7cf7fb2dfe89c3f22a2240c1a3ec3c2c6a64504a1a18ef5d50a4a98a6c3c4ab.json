{"manifest_version": 3, "name": "Reddit Big Collapse Buttons", "version": "1.0.0", "description": "Enlarges the [+]/[-] buttons that collapse and expand comment threads on Reddit, so they are easier to click.", "author": "Rezzi", "browser_specific_settings": {"gecko": {"id": "reddit-big-buttons@rezzi", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Gr\u00f6\u00dfe der Collapse-Buttons"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}