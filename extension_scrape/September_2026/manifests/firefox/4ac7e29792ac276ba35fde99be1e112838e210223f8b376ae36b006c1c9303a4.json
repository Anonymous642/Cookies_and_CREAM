{"manifest_version": 3, "name": "SoundCloud Transfer", "version": "1.3", "browser_specific_settings": {"gecko": {"id": "eerie@soundcloudhackers", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "icons": {"48": "icons/file.png", "128": "icons/file.png"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.soundcloud.com/*"], "js": ["content.js"]}]}