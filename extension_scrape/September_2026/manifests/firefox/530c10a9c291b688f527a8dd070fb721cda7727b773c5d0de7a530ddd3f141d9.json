{"manifest_version": 3, "name": "RSS Harpoon", "version": "1.0.0", "description": "Ajoute un bouton RSS aux pages de cha\u00eenes YouTube afin de copier leur flux vid\u00e9o.", "author": "Ren\u00e9 Drouin & Astor", "homepage_url": "https://www.mioursmipanda.fr", "permissions": ["clipboardWrite"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"48": "icons/rss-48.png", "96": "icons/rss-96.png"}, "browser_specific_settings": {"gecko": {"id": "rss-harpoon@mioursmipanda.fr", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}