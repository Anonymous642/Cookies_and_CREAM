{"manifest_version": 2, "name": "URL Extractor Pro", "version": "9.0.0", "browser_specific_settings": {"gecko": {"id": "sameer@g989.com", "strict_min_version": "110.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Extract all URLs from any webpage \u2014 filter, highlight, sort, export, and open in tabs.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "URL Extractor Pro", "default_popup": "popup/popup.html"}, "commands": {"extract-urls": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y"}, "description": "Extract URLs from current page"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background/background.js"], "persistent": false}, "web_accessible_resources": ["newtab/newtab.html", "newtab/newtab.js", "options/options.html", "options/options.js"]}