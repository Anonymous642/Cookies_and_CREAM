{"manifest_version": 3, "name": "Videoff", "version": "1.0.5", "description": "Deep-detects videos on every web page and archives them to your personal video library.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Videoff", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "webRequest", "notifications"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["content/page-world.js", "src/library/library.html", "icons/logo.png"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "videoff@videoff.video", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}