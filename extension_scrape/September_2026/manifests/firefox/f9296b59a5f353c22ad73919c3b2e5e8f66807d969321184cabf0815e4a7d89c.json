{"manifest_version": 3, "name": "Per-Tab Volume Control", "version": "5.5.0", "description": "Controls audio volume for individual tabs up to 500%", "icons": {"16": "icons/app-icon-16.png", "32": "icons/app-icon-32.png", "48": "icons/app-icon-48.png", "128": "icons/app-icon-128.png", "512": "icons/app-icon.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["shared/protocol.js", "shared/i18n.js", "background.js"]}, "action": {"default_icon": {"16": "icons/app-icon-16.png", "32": "icons/app-icon-32.png", "48": "icons/app-icon-48.png", "128": "icons/app-icon-128.png", "512": "icons/app-icon.png"}, "default_title": "Per-Tab Volume Control", "default_popup": "popup/popup.html"}, "commands": {"volume-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase volume on the active tab"}, "volume-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease volume on the active tab"}, "volume-reset": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Reset volume on the active tab"}, "toggle-mute": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute or unmute the active tab"}, "toggle-compressor": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Enable or disable compressor on the active tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared/protocol.js", "content_scripts/utils/constants.js", "content_scripts/utils/logger.js", "content_scripts/core/state.js", "content_scripts/core/element_state.js", "content_scripts/sync/storage_sync.js", "content_scripts/core/audio_context.js", "content_scripts/core/source_capture.js", "content_scripts/core/audio_pipeline.js", "content_scripts/core/volume_controller.js", "content_scripts/sync/volume_sync.js", "content_scripts/sync/volume_ownership.js", "content_scripts/detection/media_detector.js", "content_scripts/features/compressor.js", "content_scripts/main.js", "con