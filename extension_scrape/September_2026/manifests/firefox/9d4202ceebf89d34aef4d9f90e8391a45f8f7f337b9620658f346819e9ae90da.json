{"manifest_version": 3, "name": "PasteToMe", "version": "1.0.5", "description": "Highlight text, right-click, and send it to yourself via PasteToMe.", "permissions": ["contextMenus", "storage", "notifications", "activeTab"], "host_permissions": ["https://pastetome.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/logo-dark-16.png", "48": "icons/logo-dark-48.png", "96": "icons/logo-dark-96.png"}, "theme_icons": [{"light": "icons/logo-light-16.png", "dark": "icons/logo-dark-16.png", "size": 16}, {"light": "icons/logo-light-48.png", "dark": "icons/logo-dark-48.png", "size": 48}, {"light": "icons/logo-light-96.png", "dark": "icons/logo-dark-96.png", "size": 96}]}, "icons": {"16": "icons/logo-dark-16.png", "48": "icons/logo-dark-48.png", "96": "icons/logo-dark-96.png"}, "content_scripts": [{"matches": ["https://pastetome.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pastetome@pastetome.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": []}}}}