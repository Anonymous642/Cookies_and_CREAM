{"manifest_version": 2, "name": "Cardle Daily Tracker", "version": "0.2.0", "description": "Auto-refreshes playcardle.com once per day on first visit. Click the toolbar icon (highlighted while on playcardle.com) to open the Make/Model/Year guess log sidebar.", "icons": {"48": "icon48.png"}, "permissions": ["storage", "*://www.playcardle.com/*", "*://playcardle.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.playcardle.com/*", "*://playcardle.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Open Cardle Guess Log", "default_icon": "icon48.png"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Cardle Guess Log", "default_icon": "icon48.png"}, "browser_specific_settings": {"gecko": {"id": "cardle-guess-tracker@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}