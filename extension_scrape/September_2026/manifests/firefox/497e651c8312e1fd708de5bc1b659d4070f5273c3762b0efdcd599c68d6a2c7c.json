{"manifest_version": 2, "name": "Right-Click Dictionary", "version": "1.0", "description": "Look up definitions from the right-click menu", "permissions": ["contextMenus", "storage", "tabs", "activeTab", "https://api.dictionaryapi.dev/*"], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "commands": {"define-selection": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Define the selected word"}}, "applications": {"gecko": {"id": "rightclick-dictionary@example.com"}}}