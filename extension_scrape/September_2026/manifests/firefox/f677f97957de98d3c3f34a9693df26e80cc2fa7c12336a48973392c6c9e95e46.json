{"manifest_version": 3, "name": "cpdown", "description": "Copy any webpage/YouTube subtitle as clean markdown", "version": "1.3.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "action": {}, "commands": {"copy-as-markdown": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Ctrl+T"}, "description": "Copy current page as clean markdown"}}, "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "cpdown@ysm.dev"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}