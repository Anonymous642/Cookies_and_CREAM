{"manifest_version": 2, "name": "Tabisto - Bookmark Manager & Workspaces", "description": "Bookmark manager + new tab dashboard. Workspaces, notes, reminders, saved sessions, beautiful themes. Local-first, free.", "version": "1.0.7", "short_name": "Tabisto", "icons": {"16": "icon/dark/16.png", "32": "icon/dark/32.png", "48": "icon/dark/48.png", "128": "icon/dark/128.png"}, "browser_specific_settings": {"gecko": {"id": "tabisto@tabisto.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "bookmarksInfo"]}}}, "permissions": ["storage", "tabs", "contextMenus", "identity", "alarms", "notifications"], "optional_permissions": ["bookmarks"], "commands": {"save-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current tab to Tabisto"}}, "web_accessible_resources": ["_favicon/*"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "Tabisto", "default_popup": "popup.html"}}