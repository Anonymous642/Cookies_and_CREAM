{"manifest_version": 2, "name": "GrackerAI AEO Audit", "description": "Audit any page for AI search readiness. 7 instant checks + a 0-100 AEO score.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "support@gracker.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "GrackerAI AEO Audit", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}