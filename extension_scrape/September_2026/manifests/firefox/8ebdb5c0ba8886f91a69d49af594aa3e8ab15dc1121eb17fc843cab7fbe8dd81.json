{"manifest_version": 3, "name": "X Video Navigator", "version": "1.0.0", "description": "X (Twitter) videolu tweetlerde ok tu\u015flar\u0131 / yukar\u0131-a\u015fa\u011f\u0131 / mouse tekerle\u011fi ile gezinme, sesli otomatik oynatma, video bitince otomatik ge\u00e7i\u015f ve videosuz tweetleri atlama.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["storage"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": "icon.svg", "default_title": "X Video Navigator: A\u00c7IK (kapatmak i\u00e7in t\u0131kla)"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "x-video-navigator@local.ext", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}