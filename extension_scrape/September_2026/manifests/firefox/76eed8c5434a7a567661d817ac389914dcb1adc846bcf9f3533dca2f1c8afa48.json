{"manifest_version": 3, "name": "Gmail Quote Collapser", "version": "0.2.3", "description": "Collapse quoted email history in Gmail using custom text rules. Rules can sync across your Firefox devices through Firefox Sync.", "permissions": ["storage", "contextMenus"], "host_permissions": ["https://mail.google.com/*"], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["common.js", "sync.js", "background.js"], "service_worker": "background.js"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Gmail Quote Collapser", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["common.js", "engine.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "gmail-history-cleaner@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["personalCommunications", "personallyIdentifyingInfo"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}