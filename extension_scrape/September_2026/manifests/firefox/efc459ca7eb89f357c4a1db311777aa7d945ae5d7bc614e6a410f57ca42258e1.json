{"manifest_version": 3, "key": "", "name": "Disfora", "version": "0.1.5", "description": "Run Disfora comments on sites that do not embed Disfora.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "identity", "scripting", "activeTab", "webNavigation"], "host_permissions": ["https://disfora.com/*"], "optional_host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["assets/klipy/*"], "matches": ["https://*/*"]}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Disfora", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "hello@disfora.com", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications"]}}}}