{"manifest_version": 3, "name": "Markbase", "version": "1.1.2", "description": "Save any page to Markbase in one click. Your personal link memory.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon-32.png", "default_title": "Markbase"}, "browser_specific_settings": {"gecko": {"id": "markbase-extension@markbase.app", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "websiteContent", "websiteActivity"]}}}, "sidebar_action": {"default_panel": "sidebar/sidebar.html", "default_title": "Markbase"}, "background": {"scripts": ["background/firefox-background.js"]}, "externally_connectable": {"matches": ["https://markbase.app/*"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.min.js", "content/content.js"], "run_at": "document_idle"}], "permissions": ["storage", "contextMenus", "notifications", "activeTab", "tabs", "alarms"], "host_permissions": ["https://markbase.app/*"], "web_accessible_resources": [{"resources": ["lib/browser-polyfill.min.js"], "matches": ["<all_urls>"]}]}