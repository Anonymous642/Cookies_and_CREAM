{"manifest_version": 3, "name": "Regular Shorts", "version": "1.0.0", "description": "Redirects YouTube Shorts to the standard YouTube player.", "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "regularshorts@tomsingleton.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}