{"manifest_version": 3, "name": "YouTube Audio Sync Fix", "version": "1.0.2", "description": "Forces a tiny double-seek after releasing a held Space key on a playing YouTube video to resync audio and video.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-audio-sync-fix@local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["content_script.js"], "all_frames": true, "run_at": "document_idle"}]}