{"manifest_version": 3, "name": "MyBB Ultra Filter Toolkit", "version": "3.0", "description": "Total Blocks, Social Mutes, Thread Hiding, Spam Filters, and Dynamic Strictness.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage"], "host_permissions": ["*://*.mybroadband.co.za/*"], "browser_specific_settings": {"gecko": {"id": "MyBBFilter@Frantasticstuff.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "MyBB Filter Settings", "default_icon": {"128": "icon.png"}}, "content_scripts": [{"matches": ["*://mybroadband.co.za/forum/*"], "js": ["content.js"], "run_at": "document_idle"}]}