{"manifest_version": 3, "name": "MindShield", "version": "1.2.0", "description": "Protects your critical thinking from being outsourced to AI.", "browser_specific_settings": {"gecko": {"id": "mindshield@extension.mozilla.org", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*", "https://cdn.jsdelivr.net/*"], "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://x.com/*", "https://grok.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["transformers/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://x.com/*", "https://grok.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "icons": {"48": "icon48.png"}}