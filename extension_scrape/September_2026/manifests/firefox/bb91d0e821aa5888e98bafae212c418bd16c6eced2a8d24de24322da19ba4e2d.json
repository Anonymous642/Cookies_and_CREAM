{"manifest_version": 2, "name": "DocuDetect", "description": "Automatically place fields on DocuSign documents", "version": "2026.4.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["storage", "tabs", "activeTab", "identity", "cookies", "scripting", "*://*.docusign.com/*", "*://*.docusign.net/*", "*://*.docudetect.com/*"], "browser_specific_settings": {"gecko": {"id": "docudetect@wayofthat.com", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "browsingActivity"]}}}, "web_accessible_resources": ["injected-*.js"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "DocuDetect", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.docusign.com/*", "*://*.docusign.net/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}