{"manifest_version": 2, "name": "Do Not Inter", "version": "1.2.1", "description": "Inter is everywhere. Not anymore. We detect Inter and swap it for something friendlier and more legible - a random pick, a font you choose, or any system or Google font you specify.", "browser_specific_settings": {"gecko": {"id": "do-not-inter@internomore.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>", "storage"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_action": {"default_popup": "popup.html", "default_title": "Do Not Inter", "default_icon": "icon.svg"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}