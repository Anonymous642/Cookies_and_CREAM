{"manifest_version": 3, "name": "NameMC Locator Bar Dot", "version": "1.3.0", "description": "Displays the official Minecraft Locator Bar colored dot & texture next to player names on NameMC profiles.", "browser_specific_settings": {"gecko": {"id": "namemc-locator-bar-dot@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://*.namemc.com/*", "https://playerdb.co/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://namemc.com/*", "https://*.namemc.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["default_0.png", "default_1.png", "default_2.png", "default_3.png", "bowtie.png"], "matches": ["https://*.namemc.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "NameMC Locator Bar Dot", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}}