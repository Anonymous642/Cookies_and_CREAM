{"manifest_version": 3, "name": "Highlighted Tab Image Downloader", "version": "1.1", "description": "Download all images from highlighted (multi-selected) tabs into a custom folder with one click.", "browser_specific_settings": {"gecko": {"id": "highlighted-image-downloader@haithemharaga.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Download Highlighted Images", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Download images from highlighted tabs"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}