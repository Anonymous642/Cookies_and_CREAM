{"manifest_version": 3, "name": "Rolink-Clicker", "version": "1.1", "description": "Extension that will automaticaly click links in a live youtube chat, and with settings you can filter what links it will click.", "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "rolink@largepotato.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.png", "96": "icon.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Rolink-Clicker settings"}}