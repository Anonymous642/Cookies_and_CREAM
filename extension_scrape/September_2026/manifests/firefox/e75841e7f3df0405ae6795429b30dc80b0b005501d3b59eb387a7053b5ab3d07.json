{"manifest_version": 3, "name": "KiCad Parts Clipper", "version": "1.0.1", "description": "Copy component data from Digikey, Mouser, or LCSC directly into KiCad symbol clipboard format.", "permissions": ["activeTab", "scripting", "clipboardWrite"], "host_permissions": ["*://*.digikey.com/*", "*://*.digikey.com.br/*", "*://*.mouser.com/*", "*://*.mouser.com.br/*", "*://*.lcsc.com/*"], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.digikey.com/*", "*://*.digikey.com.br/*"], "js": ["content-scripts/browser-polyfill.js", "content-scripts/digikey.js"], "run_at": "document_idle"}, {"matches": ["*://*.mouser.com/*", "*://*.mouser.com.br/*"], "js": ["content-scripts/browser-polyfill.js", "content-scripts/mouser.js"], "run_at": "document_idle"}, {"matches": ["*://*.lcsc.com/*"], "js": ["content-scripts/browser-polyfill.js", "content-scripts/lcsc.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "kicad-parts-clipper@novasmar.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}