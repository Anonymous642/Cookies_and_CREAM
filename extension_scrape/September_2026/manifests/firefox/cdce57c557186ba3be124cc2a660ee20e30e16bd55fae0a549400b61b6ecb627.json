{"manifest_version": 3, "name": "TubeMark", "version": "1.0.0", "description": "Extracts, formats, and cleans YouTube video transcripts into timestamped, publication-ready Markdown notes with one click.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "yt-markdown-clipper@polybrain.addon", "strict_min_version": "115.0"}}}