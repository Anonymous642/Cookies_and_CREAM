{"manifest_version": 3, "name": "Konshus", "version": "1.5.5", "description": "Automatically back up your ChatGPT, Claude, Gemini and Perplexity chats to your own Vault, and start new threads with your context.", "browser_specific_settings": {"gecko": {"id": "extension@konshus.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*", "https://*.konshus.ai/*"], "action": {"default_popup": "popup.html", "default_title": "Konshus"}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"}, "web_accessible_resources": [{"resources": ["feedback.html"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://*.perplexity.ai/*"]}], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["lib/shared.js", "hosts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["lib/shared.js", "hosts/claude.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["lib/shared.js", "hosts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://*.perplexity.ai/*"], "js": ["lib/shared.js", "hosts/perplexity.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}