{"manifest_version": 2, "name": "Fact Check with Gemini", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "fact-check-gemini@example.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Highlight text and use Gemini API to fact-check via Google Search.", "permissions": ["contextMenus", "activeTab", "storage", "https://*.googleapis.com/*", "https://*.gemini.com/*", "https://*.generativelanguage.googleapis.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "icons": {"16": "logo.png"}}