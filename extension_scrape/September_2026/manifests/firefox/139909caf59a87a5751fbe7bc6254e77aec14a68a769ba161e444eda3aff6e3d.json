{"manifest_version": 3, "name": "WayBackTube Date Range Search", "version": "1.0.0", "description": "Search YouTube videos within a custom year range using the official YouTube Data API v3.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.googleapis.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WayBackTube Date Range Search", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/api.js", "src/cache.js", "src/background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/i18n.js", "src/ui.js", "src/content.js"], "css": ["src/styles.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{eb4fdb6b-ec88-41d4-b6ee-4b9bc378c50c}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "searchTerms"]}}}}