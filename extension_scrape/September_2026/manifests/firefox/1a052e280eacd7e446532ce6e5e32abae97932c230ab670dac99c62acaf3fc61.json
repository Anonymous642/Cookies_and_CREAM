{"manifest_version": 3, "name": "H2O Reminder - Water Intake Reminder", "version": "1.0.1", "description": "Stay hydrated with customizable water drinking reminders, beautiful UI, and motivational quotes.", "permissions": ["alarms", "storage", "notifications", "system.display"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "h2o-reminder@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}}