{"name": "Freedom Lite", "description": "Block distracting sites you choose\u2014on demand.", "version": "1.0.0", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "freedomlite@example.com"}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Freedom Lite", "default_popup": "dynamicOptions.html", "default_icon": {"48": "icons/icon48.png", "72": "icons/icon72.png"}}, "icons": {"96": "icons/icon96.png", "144": "icons/icon144.png", "192": "icons/icon196.png"}, "web_accessible_resources": [{"resources": ["blocked.html", "/blocked.js"], "matches": ["<all_urls>"]}], "options_page": "dynamicOptions.html", "side_panel": {"default_path": "dynamicOptions.html"}}