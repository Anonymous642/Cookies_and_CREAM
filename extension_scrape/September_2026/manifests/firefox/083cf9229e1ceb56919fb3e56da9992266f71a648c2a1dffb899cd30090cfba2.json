{"manifest_version": 2, "name": "Downloads Auto-Sorter", "version": "1.0.0", "description": "Automatically organizes your downloads into subfolders by file type. Zero configuration needed \u2014 Images, Videos, Documents, Archives, and more.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["downloads", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png"}, "default_title": "Downloads Auto-Sorter"}, "browser_specific_settings": {"gecko": {"id": "downloads-auto-sorter@extension", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}