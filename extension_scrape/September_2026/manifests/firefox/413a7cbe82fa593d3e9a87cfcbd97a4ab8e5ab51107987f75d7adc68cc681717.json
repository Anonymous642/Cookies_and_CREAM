{"manifest_version": 3, "name": "LeetHub v2", "description": "Automatically integrate your Leetcode & GeeksforGeeks submissions to GitHub", "homepage_url": "https://github.com/Fizzy444/LeetHub-2.0", "version": "2.0.20", "author": "Mithun A", "action": {"default_icon": {"16": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}, "default_popup": "popup.html", "default_title": "Upload your LeetCode solutions to GitHub"}, "icons": {"16": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png"}, "background": {"scripts": ["scripts/background.js"]}, "permissions": ["unlimitedStorage", "storage", "webNavigation"], "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["scripts/leetcode.js"], "run_at": "document_idle"}, {"matches": ["https://github.com/*"], "js": ["scripts/authorize.js"]}, {"matches": ["https://practice.geeksforgeeks.org/*"], "js": ["scripts/gfg.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "custom_leethub_v2_mithun@leethub.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}