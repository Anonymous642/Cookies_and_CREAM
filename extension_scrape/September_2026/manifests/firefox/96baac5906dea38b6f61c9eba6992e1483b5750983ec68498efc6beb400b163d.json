{"manifest_version": 2, "name": "Our Morning Coffee", "version": "1.2.0", "description": "Open your favorite websites each morning - organize sites by day of the week for your daily routine", "homepage_url": "https://github.com/nate-double-u/Our-Morning-Coffee", "browser_specific_settings": {"gecko": {"id": "our-morning-coffee@nate-double-u", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/coffee-48.png", "96": "icons/coffee-96.png"}, "permissions": ["tabs", "storage", "notifications"], "background": {"scripts": ["shared/site-lists.js", "shared/settings.js", "shared/tabs.js", "shared/storage.js", "background/background.js"]}, "browser_action": {"default_icon": {"48": "icons/coffee-48.png"}, "theme_icons": [{"light": "icons/coffee-48-light.svg", "dark": "icons/coffee-48.svg", "size": 48}], "default_title": "Our Morning Coffee", "default_popup": "popup/popup.html", "default_area": "navbar"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"open-morning-coffee": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open today's morning coffee sites"}}}