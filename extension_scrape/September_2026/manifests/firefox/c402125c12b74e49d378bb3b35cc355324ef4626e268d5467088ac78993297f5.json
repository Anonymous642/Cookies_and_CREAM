{"manifest_version": 2, "name": "globalcampus-scholarone", "description": "Global Campus integration for ScholarOne", "version": "0.3.0", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "sidebar_action": {"default_title": "Find on Global Campus", "default_panel": "gc-sidepanel.html", "open_at_install": false}, "permissions": ["cookies", "contextMenus", "https://globalcampus.ai/*"], "web_accessible_resources": ["images/*"], "browser_specific_settings": {"gecko": {"id": "globalcampus.firefox.ext@globalcampus.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.manuscriptcentral.com/*"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_title": "Find on Global Campus"}}