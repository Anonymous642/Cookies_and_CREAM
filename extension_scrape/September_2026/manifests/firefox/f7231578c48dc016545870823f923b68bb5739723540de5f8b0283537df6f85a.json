{"manifest_version": 3, "name": "Content Capture", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "content-capture@example.com"}}, "description": "Captures webpage content for analysis", "permissions": ["activeTab", "clipboardWrite", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}