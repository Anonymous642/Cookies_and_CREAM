{"manifest_version": 3, "name": "Packmind for Code Review", "version": "4.2.0", "description": "Skyrocket your code review experience with all Packmind capabilities.", "permissions": ["activeTab", "contextMenus", "storage", "notifications", "scripting"], "browser_specific_settings": {"gecko": {"id": "{d510cd67-35fc-4a69-8c68-58d15e50df0c}"}}, "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["popup/popup.html", "contentscript/css/contentscript.css", "contentscript/img/*", "contentscript/css/*", "contentscript/fonts/*"], "matches": ["<all_urls>"]}], "icons": {"128": "./packmind.png"}, "action": {"default_title": "Packmind", "default_popup": "popup/popup.html"}, "background": {"scripts": ["index.js"]}, "options_ui": {"page": "options/index.html"}, "content_scripts": [{"matches": ["*://*/*merge_requests*", "*://*/*pull*", "*://*.github.com/*", "*://*/*reviews*"], "js": ["codeReviewDecoration.js"], "css": ["contentscript/css/contentscript.css"], "run_at": "document_idle"}]}