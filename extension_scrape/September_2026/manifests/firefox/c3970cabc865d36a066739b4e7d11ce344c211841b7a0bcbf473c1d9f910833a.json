{"manifest_version": 2, "name": "InnoShield", "version": "1.0", "description": "Scans URLs using VirusTotal API before opening them", "browser_specific_settings": {"gecko": {"id": "innoshield@innofyre.net", "strict_min_version": "109.0"}}, "permissions": ["webNavigation", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "web_accessible_resources": ["blocked.html", "blocked.js"], "content_security_policy": "script-src 'self'; object-src 'self'", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "InnoShield"}}