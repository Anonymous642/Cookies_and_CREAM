{"manifest_version": 2, "name": "TabXProxy", "version": "1.0", "description": "Switch browser proxy based on tab", "icons": {"16": "icons/icon-noproxy.png", "32": "icons/icon-noproxy.png"}, "permissions": ["tabs", "storage", "proxy", "tabGroups", "<all_urls>"], "incognito": "spanning", "browser_action": {"default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "tabxproxy@tabxproxy", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}