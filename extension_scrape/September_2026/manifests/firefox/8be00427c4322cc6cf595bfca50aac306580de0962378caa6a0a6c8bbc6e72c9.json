{"manifest_version": 2, "name": "SpeedyIndex Link Indexing Service", "version": "1.0.0", "description": "The fastest way to send URLs to the SpeedyIndex link indexing service directly from your browser.", "permissions": ["storage", "activeTab", "tabs", "alarms", "https://api.speedyindex.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@speedyindex.com", "strict_min_version": "60.0"}}}