{"manifest_version": 3, "name": "JobRefined \u2014 JD Capture", "version": "1.0.2", "description": "Capture job descriptions from any job listing page and send them to JobRefined for AI-powered analysis.", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["https://api.jobrefined.ai/*", "http://localhost:8000/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["utils/browser-polyfill.js", "utils/api.js", "background/service-worker.js"]}, "content_scripts": [{"matches": ["https://app.jobrefined.ai/*", "https://staging.jobrefined.ai/*", "http://localhost:5173/*", "http://localhost:5174/*"], "js": ["utils/browser-polyfill.js", "content/auth-bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "extension@jobrefined.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "urlVisited": false, "searchTerms": false, "tabInfo": false, "deviceInfo": false, "personalInfo": true, "locationInfo": false, "healthInfo": false, "financialInfo": false, "authenticationInfo": true, "communicationsInfo": false, "websiteContent": true, "userActivity": false}}}}