{"manifest_version": 3, "name": "CloudFlare Advanced Purge Plugin", "short_name": "CloudFlare Advanced Purge", "description": "This extension can purge the CloudFlare cache for the current page, for a domain or for a tag of your CloudFlare enabled website", "version": "1.10.2", "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"19": "icon.png", "48": "icon48.png"}, "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "background": {"page": "background.html"}, "permissions": ["activeTab", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "{eb712bb1-0338-5208-a7a3-0af8cb9f59a4}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}