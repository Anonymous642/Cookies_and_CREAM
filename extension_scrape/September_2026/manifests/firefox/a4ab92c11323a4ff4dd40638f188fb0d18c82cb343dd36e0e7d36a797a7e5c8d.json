{"manifest_version": 3, "name": "Trello Card Export", "version": "0.1.0", "description": "One-click export of any Trello card to a .zip with attachments and a card.md summary.", "minimum_chrome_version": "148", "browser_specific_settings": {"gecko": {"id": "trello-card-export@arthur", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Trello Card Export", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.min.js", "scripts": ["background.min.js"]}, "content_scripts": [{"matches": ["https://trello.com/*"], "js": ["content.bundle.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["downloads", "storage", "activeTab", "scripting"], "host_permissions": ["https://trello.com/*", "https://*.amazonaws.com/*"], "web_accessible_resources": []}