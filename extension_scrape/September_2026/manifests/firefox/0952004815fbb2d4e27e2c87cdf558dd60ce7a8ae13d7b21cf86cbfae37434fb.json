{"manifest_version": 3, "name": "OG Pulse", "version": "2.0.0", "description": "Premium dashboard and analytics for OGame.", "icons": {"16": "icons/nexus-16.png", "32": "icons/nexus-32.png", "48": "icons/nexus-48.png", "128": "icons/nexus-128.png"}, "permissions": ["storage", "alarms", "identity"], "host_permissions": ["*://*.ogame.gameforge.com/*", "https://ogapi.faw-kes.de/*", "https://*.geo.gfsrv.net/*"], "action": {"default_title": "Open OG Pulse"}, "background": {"type": "module", "scripts": ["src/background/index.js"]}, "content_scripts": [{"matches": ["*://*.ogame.gameforge.com/game/*"], "js": ["src/content/index.js"], "css": ["src/content/styles.css"], "run_at": "document_end"}, {"matches": ["*://*.ogame.gameforge.com/game/*"], "js": ["src/content/pageContext.js"], "run_at": "document_start", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["dashboard.html", "icons/*"], "matches": ["*://*.ogame.gameforge.com/*"]}], "browser_specific_settings": {"gecko": {"id": "og-pulse@happylouface.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}