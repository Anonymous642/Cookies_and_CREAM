{"manifest_version": 3, "name": "File Safety Check", "short_name": "Safety Check", "version": "1.3.1", "description": "Checks a selected file locally for its real type, suspicious extension mismatches, and known-malware hash matches.", "homepage_url": "https://github.com/srpvpn/magikaext", "action": {"default_title": "Scan files", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "file-safety-check@local.magika", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}