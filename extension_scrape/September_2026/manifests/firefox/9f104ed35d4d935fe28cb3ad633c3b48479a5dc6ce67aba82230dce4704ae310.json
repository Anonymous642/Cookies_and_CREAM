{"manifest_version": 2, "name": "Bookmark Notes", "version": "1.0.1", "description": "Save selected text as self-contained bookmark notes", "homepage_url": "https://github.com/yourname/bookmark-notes", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["bookmarks", "storage", "contextMenus", "activeTab", "tabs"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"save-bookmark-note": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Save selected text as Bookmark Note"}, "save-personal-note": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Save a personal note about this page"}}, "browser_action": {"default_title": "Bookmark Notes", "default_icon": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "bookmarknotes@plucafs"}}}