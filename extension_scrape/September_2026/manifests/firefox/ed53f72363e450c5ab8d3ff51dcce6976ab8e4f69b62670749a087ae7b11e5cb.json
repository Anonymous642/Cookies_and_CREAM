{"manifest_version": 2, "name": "Autovirality", "description": "Companion extension for Autovirality that copies TikTok content and downloads images from Pinterest search results.", "version": "0.1.3", "icons": {"180": "icon/180.png", "192": "icon/192.png", "196": "icon/196.png", "512": "icon/512.png"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "autovirality@example.com"}}, "permissions": ["activeTab", "scripting", "tabs", "clipboardWrite", "downloads", "https://www.tiktok.com/*", "https://*.tiktok.com/*", "https://pinterest.com/*", "https://*.pinterest.com/*", "https://*.pinimg.com/*"], "browser_action": {"default_title": "Autovirality", "default_popup": "popup.html"}}