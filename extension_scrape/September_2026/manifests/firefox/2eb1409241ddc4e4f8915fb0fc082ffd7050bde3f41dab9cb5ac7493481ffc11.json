{"manifest_version": 2, "name": "Annotate", "version": "1.0", "description": "Drop sticky notes on any page and manage annotations from the popup.", "browser_specific_settings": {"gecko": {"id": "vunham537@gmail.com", "data_collection_permissions": {"required": ["none"], "description": "Annotate does not collect or transmit any user data. All annotations are stored locally."}}}, "permissions": ["storage", "activeTab", "contextMenus"], "browser_action": {"default_title": "Annotate", "default_popup": "zone/annotate.html", "default_icon": {"48": "icons/note-48.png", "96": "icons/note-96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["field/annotator.js"], "css": ["field/annotator.css"]}], "background": {"scripts": ["scope/note-scope.js"], "persistent": false}, "icons": {"48": "icons/note-48.png", "96": "icons/note-96.png"}}