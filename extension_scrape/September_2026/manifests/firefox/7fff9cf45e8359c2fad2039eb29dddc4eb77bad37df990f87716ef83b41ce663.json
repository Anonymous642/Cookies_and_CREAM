{"manifest_version": 3, "name": "DealDrift Coupon Finder", "version": "1.0.0", "description": "Automatically finds and applies coupons from DealDrift.org while shopping online", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "DealDrift Coupons"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "permissions": ["storage", "tabs", "activeTab", "notifications"], "host_permissions": ["https://dealdrift.org/*"], "browser_specific_settings": {"gecko": {"id": "dealdrift@temp-addon", "strict_min_version": "112.0"}}}