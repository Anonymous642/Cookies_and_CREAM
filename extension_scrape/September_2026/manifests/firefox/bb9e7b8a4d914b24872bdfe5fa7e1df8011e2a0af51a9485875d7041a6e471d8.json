{"manifest_version": 2, "name": "Random Bookmark Opener", "version": "1.0", "description": "Opens random bookmarks from a selected folder", "browser_specific_settings": {"gecko": {"id": "random-bookmark-opener@noodle", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["bookmarks", "storage", "contextMenus", "tabs"], "browser_action": {"default_title": "Random Bookmark Opener", "default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icon.png"}}