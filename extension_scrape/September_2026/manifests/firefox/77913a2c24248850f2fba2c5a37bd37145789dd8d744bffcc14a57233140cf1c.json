{"manifest_version": 2, "name": "Containacious", "version": "1.0.0", "description": "Tenaciously keeps your tabs in the right container", "author": "Dejan Cabrilo", "permissions": ["tabs", "contextualIdentities", "cookies", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_action": {"default_icon": "icons/icon.svg", "default_title": "Containacious"}, "options_ui": {"page": "options.html", "browser_style": true}, "homepage_url": "https://github.com/cabrilo/containacious", "browser_specific_settings": {"gecko": {"id": "containacious@cabrilo.github.io", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}