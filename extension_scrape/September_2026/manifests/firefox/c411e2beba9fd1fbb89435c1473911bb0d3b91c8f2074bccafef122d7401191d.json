{"manifest_version": 3, "name": "NeetCode Versus Match Notifier", "version": "1.1", "description": "Never miss a NeetCode Versus battle! Automatically switch to your match tab and get desktop alerts the instant a game begins.", "browser_specific_settings": {"gecko": {"id": "neetcode-notifier@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["notifications", "tabs", "storage"], "host_permissions": ["https://neetcode.io/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "default_title": "NeetCode Dashboard"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://neetcode.io/versus*"], "js": ["content.js"]}, {"matches": ["https://neetcode.io/*"], "js": ["stats_scraper.js"], "run_at": "document_idle"}], "commands": {"queue-versus-match": {"suggested_key": {"default": "Alt+M"}, "description": "Queue for a NeetCode Versus match"}}, "web_accessible_resources": [{"resources": ["chime.mp3"], "matches": ["https://neetcode.io/*"]}]}