{"manifest_version": 3, "name": "WebSuite", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "websuitesecurity@defendshieldcybersecurity.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "protocols": {"telemetry": {"enable": false}}}}}, "description": "A modern web security testing toolbar for Firefox.", "permissions": ["activeTab", "scripting", "webRequest", "webRequestBlocking", "storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle WebSuite TopBar"}, "web_accessible_resources": [{"resources": ["topbar.css"], "matches": ["<all_urls>"]}], "sidebar_action": {"default_title": "WebSuite", "default_panel": "sidebar.html", "open_at_install": true}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png"}}