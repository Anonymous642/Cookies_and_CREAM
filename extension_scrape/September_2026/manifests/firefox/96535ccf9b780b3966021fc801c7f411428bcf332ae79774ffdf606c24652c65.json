{"manifest_version": 3, "name": "X Speed", "version": "1.2.3", "description": "On-video speed control for X (Twitter). Remember the speed setting from one video to another. Adjust it with + / -", "browser_specific_settings": {"gecko": {"id": "x-playback-speed-control@qqubica", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_title": "X Speed", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["src/i18n-data.js", "src/content.js"], "run_at": "document_start"}]}