{"manifest_version": 3, "name": "OMORI Typing", "version": "1.1.1", "description": "Play OMORI text sounds while typing. Inspired by Animalese Typing", "permissions": ["activeTab", "scripting"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["audio/*.ogg"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "omori-typing@moseni.wtf"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}