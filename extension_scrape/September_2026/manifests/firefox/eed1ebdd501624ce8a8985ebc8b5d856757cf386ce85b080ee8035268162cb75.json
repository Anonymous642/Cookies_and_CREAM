{"manifest_version": 3, "name": "Panel de uso de tiempo", "version": "0.1.0", "description": "Trackea cu\u00e1nto tiempo pas\u00e1s en cada sitio web, directamente en el navegador (sin instalar nada m\u00e1s).", "permissions": ["tabs", "sidePanel", "idle", "storage", "notifications", "alarms"], "side_panel": {"default_path": "sidebar.html"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Panel de uso de tiempo", "open_at_install": false, "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"service_worker": "background.js", "scripts": ["comun.js", "background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content_visibilidad.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "panel-uso-tiempo@panel-uso-tiempo.app", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}}