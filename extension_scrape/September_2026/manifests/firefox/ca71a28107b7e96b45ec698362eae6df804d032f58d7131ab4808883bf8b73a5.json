{"manifest_version": 3, "name": "Discord Trad FR", "version": "1.1.0", "description": "Traduit automatiquement les messages \u00e9trangers de Discord Web en fran\u00e7ais.", "browser_specific_settings": {"gecko": {"id": "@discord-trad-fr", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "permissions": ["storage"], "host_permissions": ["https://discord.com/*", "https://translate.googleapis.com/*"], "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "action": {"default_title": "Discord Trad FR", "default_popup": "popup.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}