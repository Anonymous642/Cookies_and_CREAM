{"manifest_version": 2, "name": "Tab Renamer", "version": "1.0.0", "description": "Rename Tabs", "permissions": ["tabs", "storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "Tab-Rename@developer.dev", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Rename this tab", "default_popup": "popup.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "commands": {"rename-current-tab": {"suggested_key": {"default": "Ctrl+Alt+Z", "mac": "MacCtrl+Alt+Y"}, "description": "Open Tab Renamer for the current tab"}}}