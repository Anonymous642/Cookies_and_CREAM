{"manifest_version": 3, "name": "Sarva Backup on Local (SBL)", "version": "1.0.3", "description": "Comprehensive backup and restore tool for Firefox profiles. Backup extensions, themes, bookmarks, preferences, passwords, cookies, and more.", "author": "SarvaIT", "browser_specific_settings": {"gecko": {"id": "Sarva-Backup-On-Local@sarvait", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "usage": false, "performance": false, "functionality": false}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "bookmarks", "cookies", "history", "downloads", "management", "tabs", "unlimitedStorage", "notifications", "alarms"], "optional_permissions": ["downloads"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Sarva Backup on Local", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["wizard/*.html", "wizard/*.css", "wizard/*.js"], "matches": ["<all_urls>"]}]}