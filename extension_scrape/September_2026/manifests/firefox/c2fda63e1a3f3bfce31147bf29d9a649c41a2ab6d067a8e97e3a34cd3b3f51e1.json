{"manifest_version": 3, "name": "YouTube No Play/Pause Overlay", "version": "1.0.5", "description": "Removes the play/pause overlay animation on YouTube videos.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "css": ["content.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-no-overlay@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_browsing_history": false, "collects_user_activity": false, "collects_health_data": false, "collects_financial_data": false, "collects_location_data": false, "collects_authentication_info": false, "collects_contacts": false}}}}