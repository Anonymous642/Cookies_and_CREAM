{"manifest_version": 3, "name": "Sidebar Comments for Reddit", "version": "1.0.3", "description": "Show comments on the right sidebar instead of opening a new tab.", "browser_specific_settings": {"gecko": {"id": "reddit-sidebar-comments@extension", "strict_min_version": "109.0"}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}