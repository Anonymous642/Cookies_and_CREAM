{"manifest_version": 2, "name": "Pinus Maximus", "description": "A free, privacy-friendly new tab pinboard for saved links, shortcuts, screens and groups.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "incognito": "not_allowed", "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';", "browser_specific_settings": {"gecko": {"id": "@pinus-maximus.pinusmaximus.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["searchTerms", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "optional_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}}