{"manifest_version": 3, "name": "Anime Quick Search", "version": "1.0.0", "description": "Select any anime name on a webpage, right-click and instantly search it. Get quick info + find where to download for free.", "browser_specific_settings": {"gecko": {"id": "anime-quick-search@animeworlddl.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "storage", "activeTab"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["popup-style.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}}