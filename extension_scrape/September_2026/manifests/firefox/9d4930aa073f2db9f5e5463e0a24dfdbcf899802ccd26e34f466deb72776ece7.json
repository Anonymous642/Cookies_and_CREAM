{"manifest_version": 2, "name": "Tab Abandon Reason Detector", "version": "1.3", "description": "Analyze tab abandonment behavior and estimate why users leave pages unfinished.", "permissions": ["tabs", "storage", "activeTab", "notifications"], "browser_action": {"default_title": "Tab Abandon Reason Detector", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Tab-Abandon-Reason-Detector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}