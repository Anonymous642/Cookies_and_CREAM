{"manifest_version": 3, "name": "Open HUJI-moodle Embedded PDF in New Tab", "version": "1.0", "description": "Opens embedded HUJI-moodle PDFs in a new tab for easier reading.", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "default_title": "Open PDF in New Tab"}, "commands": {"open-pdf": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Send a 'toggle-feature' event"}}, "browser_specific_settings": {"gecko": {"id": "moodlepdf1@moodlesucks", "strict_min_version": "109.0"}}}