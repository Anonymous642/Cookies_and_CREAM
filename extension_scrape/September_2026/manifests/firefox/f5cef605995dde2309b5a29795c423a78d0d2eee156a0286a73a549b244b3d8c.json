{"manifest_version": 2, "name": "Turn Off the Lights", "version": "1.0.0", "description": "Dim the web page (soft 'lights off') to focus on video content. Simple overlay with options.", "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Turn Off the Lights", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_end"}], "options_ui": {"page": "options.html", "open_in_tab": false}, "applications": {"gecko": {"id": "turnoffthelights@example.com"}}}