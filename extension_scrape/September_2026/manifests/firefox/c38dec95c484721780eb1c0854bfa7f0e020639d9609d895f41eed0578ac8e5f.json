{"manifest_version": 3, "name": "YouTube Bilingual Subtitles", "version": "1.0.0", "description": "Auto overlay translated subtitles on YouTube videos \u2014 watch in any language", "browser_specific_settings": {"gecko": {"id": "yt-bilingual-subs@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://api.deepseek.com/*"], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://www.youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "YT Subtitles", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}