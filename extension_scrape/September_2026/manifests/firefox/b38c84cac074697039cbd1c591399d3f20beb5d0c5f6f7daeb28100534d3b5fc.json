{"manifest_version": 2, "applications": {"gecko": {"id": "attributeai@getattributeai.app", "strict_min_version": "109.0"}}, "name": "AttributeAI \u2013 Keyword Intelligence", "version": "1.0.0", "description": "Unlimited keyword research with AI insights and multi-touch attribution tracking. The superior alternative to Keywords Everywhere.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "downloads", "tabs"], "host_permissions": ["https://*.google.com/*", "https://*.bing.com/*", "https://*.youtube.com/*", "https://*.amazon.com/*", "https://*.attributeai.app/*", "https://*.netlify.app/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.google.com/search*", "https://*.bing.com/search*", "https://*.youtube.com/*", "https://*.amazon.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "AttributeAI \u2013 Keyword Intelligence", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["content.js", "popup.html"]}