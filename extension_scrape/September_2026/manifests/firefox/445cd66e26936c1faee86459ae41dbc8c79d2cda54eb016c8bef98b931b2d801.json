{"manifest_version": 3, "name": "No Blink for Google Docs", "version": "3.0", "description": "Disables the blinking cursor animation on Google Docs.", "browser_specific_settings": {"gecko": {"id": "no-blink-cursor-v2@google-docs-fix", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://docs.google.com/*"], "css": ["style.css"], "run_at": "document_idle"}]}