{"manifest_version": 3, "name": "U-NEXT Video Guard", "description": "Reduce hover controls and accidental click-to-pause behavior on U-NEXT.", "version": "0.1.4", "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://video.unext.jp/*", "https://*.video.unext.jp/*", "https://unext.jp/*", "https://*.unext.jp/*", "https://u-next.jp/*", "https://*.u-next.jp/*"], "browser_specific_settings": {"gecko": {"id": "unext-video-guard@shio.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "U-NEXT Video Guard", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://video.unext.jp/*", "https://*.video.unext.jp/*", "https://unext.jp/*", "https://*.unext.jp/*", "https://u-next.jp/*", "https://*.u-next.jp/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_start", "all_frames": true}]}