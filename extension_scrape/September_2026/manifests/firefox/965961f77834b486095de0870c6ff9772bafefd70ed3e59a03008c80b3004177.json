{"manifest_version": 3, "name": "AI Design Detector - AI Website Checker", "short_name": "AI Design Detector", "version": "0.2.1", "description": "Generic design costs customers. Get a free scan & score for how AI-generated your site looks, plus ready-to-go fixes & recommendations.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "background": {"scripts": ["dist/background.js"]}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ai-design-detector@polderlab", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}