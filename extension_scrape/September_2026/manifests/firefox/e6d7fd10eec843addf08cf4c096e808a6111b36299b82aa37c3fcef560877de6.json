{"manifest_version": 2, "name": "Stashly", "version": "0.1.0", "description": "Stash your tabs. Never lose them.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["tabs", "storage", "unlimitedStorage"], "browser_action": {"default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_title": "Stash tabs", "default_popup": "popup/index.html"}, "background": {"scripts": ["background/main.js"], "persistent": true}, "commands": {"stash-all": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stash all tabs"}}, "browser_specific_settings": {"gecko": {"id": "stashly@stashly.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}