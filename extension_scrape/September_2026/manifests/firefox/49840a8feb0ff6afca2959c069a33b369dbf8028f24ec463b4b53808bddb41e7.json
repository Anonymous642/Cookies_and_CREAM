{"manifest_version": 3, "name": "Auto Scroll", "version": "2.4", "description": "Enhance browsing by automating page scrolling with customizable speeds and loop options.", "icons": {"16": "images/icon-16-chrome.png", "48": "images/icon-48-chrome.png", "128": "images/icon-128-chrome.png"}, "permissions": ["activeTab", "storage", "scripting"], "background": {"scripts": ["firefox-background.js"]}, "action": {"default_popup": "firefox-popup.html"}, "commands": {"toggle-scroll": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Start or pause scrolling"}, "speed-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase scroll speed"}, "speed-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease scroll speed"}}, "browser_specific_settings": {"gecko": {"id": "auto-scroll@arjunkolagatla.local", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}}