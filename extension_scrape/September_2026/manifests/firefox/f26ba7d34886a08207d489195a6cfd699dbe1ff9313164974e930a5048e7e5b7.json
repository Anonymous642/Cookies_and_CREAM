{"manifest_version": 3, "name": "WeProxy Manager", "short_name": "WeProxy", "version": "1.0.4", "description": "Professional client-side proxy management extension with auto-auth and WebRTC leak protection powered by weproxy.io.", "author": "weproxy.io", "browser_specific_settings": {"gecko": {"id": "weproxy-manager@weproxy.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "WeProxy Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "privacy", "tabs", "scripting"], "host_permissions": ["<all_urls>"]}