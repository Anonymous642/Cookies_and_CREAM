{"manifest_version": 2, "name": "QRZ Auto Login", "description": "Automatically log into QRZ.com", "version": "1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "255": "icon/255.png"}, "default_locale": "en", "permissions": ["storage", "https://www.qrz.com/"], "browser_specific_settings": {"gecko": {"id": "@qrzautologin.cniesen", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.qrz.com/*"], "js": ["content-scripts/content.js"]}]}