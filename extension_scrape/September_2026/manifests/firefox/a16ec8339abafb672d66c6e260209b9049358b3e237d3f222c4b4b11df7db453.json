{"manifest_version": 3, "name": "Slazzer - Free Image Background Remover", "version": "1.0", "description": "Remove background from images easily!", "permissions": ["activeTab", "scripting", "notifications", "tabs"], "icons": {"16": "icon-16.png", "128": "icon-32.png"}, "action": {"default_popup": "popup.html", "default_icon": "icon-32.png"}, "web_accessible_resources": [{"resources": ["icon-16.png", "icon-32.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "addon@slazzer.online"}}}