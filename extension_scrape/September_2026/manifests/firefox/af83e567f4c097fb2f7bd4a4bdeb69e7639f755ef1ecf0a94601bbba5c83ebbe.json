{"manifest_version": 2, "name": "SideChat for WhatsApp", "version": "2.13", "description": "A lightweight, responsive WhatsApp sidebar extension featuring custom slim layouts and instant toolbar toggling.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["https://web.whatsapp.com/*", "tabs", "storage", "webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "sidechat-for-whatsapp@dreamstate.local", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "SideChat for WhatsApp", "open_at_install": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "css": ["style.css"], "js": ["contents.js"], "run_at": "document_idle", "all_frames": true}]}