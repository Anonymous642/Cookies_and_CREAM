{"manifest_version": 3, "name": "EGFReader", "version": "1.0.0", "description": "Opens and plays Educational Game Format (.egf) files directly from URLs, with an option to download the file from the built-in reader.", "icons": {"48": "icons/icon_48.png", "96": "icons/icon_96.png"}, "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["reader/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "egf-reader@egf-reader", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}