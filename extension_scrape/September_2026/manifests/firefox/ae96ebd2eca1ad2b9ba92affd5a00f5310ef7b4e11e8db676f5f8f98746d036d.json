{"manifest_version": 3, "name": "SAT\u00ae Score Hider", "version": "1.0", "description": "Hides SAT\u00ae scores until clicked on, plays sounds, and displays confetti", "browser_specific_settings": {"gecko": {"id": "@SATScoreHider.NobiDevs", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://studentscores.collegeboard.org/*", "*://mysat.collegeboard.org/*"], "js": ["content.js", "confetti.js"], "css": ["styles.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "SAT\u00ae Score Hider"}, "icons": {"48": "icons/48.png", "128": "icons/128.png", "512": "icons/512.png"}, "web_accessible_resources": [{"resources": ["audio/*.mp3"], "matches": ["<all_urls>"]}]}