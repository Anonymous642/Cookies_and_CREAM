{"manifest_version": 2, "name": "Bookmark Sections", "version": "1.0.2", "description": "Mostra i segnalibri di Firefox in una sidebar organizzata in sezioni, usando i separatori come intestazioni. Include drag & drop per riordinare cartelle, sezioni e link, e aggiorna le favicon dei siti.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["bookmarks", "storage", "tabs"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end"}], "sidebar_action": {"default_icon": "icons/icon-48.png", "default_title": "Segnalibri con sezioni", "default_panel": "sidebar/sidebar.html"}, "browser_specific_settings": {"gecko": {"id": "{bb26c2dd-c921-493e-bb2b-93bed9497506}", "data_collection_permissions": {"required": ["none"]}}}}