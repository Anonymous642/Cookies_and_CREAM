{"manifest_version": 3, "name": "Parse \u2014 Web Page Inspector & Auditor", "version": "2.5.1", "description": "Instantly audit any webpage \u2014 AI summary, SEO, security, accessibility, performance & broken links. Sidebar + CSV export.", "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel/sidepanel.html", "default_title": "Open Parse", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "parse-web-inspector@harshaashok.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}