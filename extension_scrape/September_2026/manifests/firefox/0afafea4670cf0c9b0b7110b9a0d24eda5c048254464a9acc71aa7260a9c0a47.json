{"manifest_version": 3, "name": "Break Buddy", "short_name": "Break Buddy", "version": "1.3.0", "default_locale": "en", "description": "Cute animals remind you to take healthy screen breaks. Fun, gentle, and privacy-first.", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_title": "Break Buddy"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "alarms", "tabs", "activeTab", "scripting"], "optional_permissions": ["notifications"], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["overlay.html", "party.html", "animals/*.svg", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "break-buddy@breakbuddy.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}