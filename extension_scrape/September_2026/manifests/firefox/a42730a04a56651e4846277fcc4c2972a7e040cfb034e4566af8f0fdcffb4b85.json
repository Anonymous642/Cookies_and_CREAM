{"manifest_version": 3, "name": "Google Account Switcher", "version": "1.0.0", "description": "Auto-switch Google account when access is denied", "browser_specific_settings": {"gecko": {"id": "vokelood@gmail.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["https://docs.google.com/*", "https://drive.google.com/*", "https://accounts.google.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "GAAS \u2014 Google Account Auto-Switcher", "default_icon": "icons/icon-toolbar.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://docs.google.com/*", "https://drive.google.com/*"], "js": ["content.js"], "run_at": "document_start"}]}