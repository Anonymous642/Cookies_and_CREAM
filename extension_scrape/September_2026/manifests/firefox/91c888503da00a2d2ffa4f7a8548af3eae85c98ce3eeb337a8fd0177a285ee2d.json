{"manifest_version": 2, "name": "Bookmarker+ for YouTube", "version": "0.3.8", "description": "Bookmark timestamps in YouTube videos. Markers on the progress bar AND a clickable list below the player.", "browser_specific_settings": {"gecko": {"id": "youtube-bookmarker-plus@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "alarms", "https://*.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/storage.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["src/storage.js", "src/gistsync.js", "src/background.js"], "persistent": false}, "browser_action": {"default_popup": "src/popup.html", "default_title": "YouTube Bookmarker+", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}