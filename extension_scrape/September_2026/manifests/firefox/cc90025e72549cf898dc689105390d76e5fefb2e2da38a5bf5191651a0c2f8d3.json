{"manifest_version": 3, "name": "DraftRescue Desk", "version": "1.0.0", "description": "Save recoverable form drafts locally after you activate a watcher for the current tab.", "browser_specific_settings": {"gecko": {"id": "draftrescue-desk@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "alarms", "clipboardWrite", "menus", "notifications", "scripting", "storage", "tabs"], "background": {"scripts": ["shared/constants.js", "shared/browser.js", "shared/draftRules.js", "shared/storage.js", "background.js"]}, "action": {"default_title": "DraftRescue Desk", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"toggle-draft-watcher": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Toggle DraftRescue watcher on the active tab"}, "open-draft-vault": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Open the DraftRescue local vault"}}, "icons": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}