{"manifest_version": 3, "name": "Raia Extension", "version": "1.0.0", "description": "Raia browser extension for Chromium and Gecko", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "auth/auth.html", "open_in_tab": true}, "action": {"default_title": "Raia", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html"}, "permissions": ["storage", "tabs", "alarms"], "background": {"scripts": ["background/background.js"], "service_worker": "background/background.js"}, "host_permissions": ["http://localhost:4111/*", "https://api-v3.raia.edu.vn/*"], "browser_specific_settings": {"gecko": {"id": "raia-extension@raia.edu.vn", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"], "optional": []}}}}