{"manifest_version": 3, "name": "Jira Ninja", "version": "1.9", "description": "Adds a ninja-button next to the jira-issue ID that copies the ID to the clipboard.", "permissions": ["clipboardWrite", "storage"], "content_scripts": [{"matches": ["*://*.atlassian.net/*"], "js": ["js/content.js"], "css": ["css/styles.css"]}], "action": {"default_popup": "settings.html", "default_icon": {"16": "images/icon.png", "32": "images/icon.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": false}, "icons": {"16": "images/icon.png", "32": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "browser_specific_settings": {"gecko": {"id": "jiraninjaextension@gmail.com", "strict_min_version": "109.0"}}}