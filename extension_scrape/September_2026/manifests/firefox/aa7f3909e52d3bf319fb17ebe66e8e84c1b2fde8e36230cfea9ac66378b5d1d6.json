{"manifest_version": 2, "name": "LinguaTube - Learn Languages on YouTube.", "version": "1.0.0", "description": "Filter videos in 10+ languages in YouTube recommendations. (Currently, only English is available)", "browser_specific_settings": {"gecko": {"id": "linguatube@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "default_title": "LinguaTube"}, "icons": {"48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "web_accessible_resources": ["page-script.js"]}