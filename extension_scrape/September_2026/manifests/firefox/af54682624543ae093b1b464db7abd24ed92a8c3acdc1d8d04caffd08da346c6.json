{"manifest_version": 3, "name": "URL Copier", "version": "1.0", "description": "Copy the current page URL to clipboard with one click", "icons": {"48": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "Copy Page URL"}, "permissions": ["activeTab", "scripting", "storage"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tinspj1997@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}