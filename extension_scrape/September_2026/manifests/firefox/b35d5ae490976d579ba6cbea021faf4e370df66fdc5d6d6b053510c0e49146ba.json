{"manifest_version": 3, "name": "Volume Booster", "version": "1.0.0", "description": "Boost the audio volume of the current browser tab up to 600%.", "author": "github.com/realunfazed", "browser_specific_settings": {"gecko": {"id": "rf-volumebooster@unfazed.ir", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Volume Booster", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "all_frames": true, "run_at": "document_start", "match_about_blank": false}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}