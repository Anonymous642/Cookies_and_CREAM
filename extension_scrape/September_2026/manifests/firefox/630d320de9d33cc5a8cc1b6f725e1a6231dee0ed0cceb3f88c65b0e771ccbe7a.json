{"name": "VisBug2", "version": "2.0.1", "description": "Open source browser design tools", "manifest_version": 3, "icons": {"128": "icons/visbug.png"}, "permissions": ["activeTab", "contextMenus", "scripting", "storage"], "background": {"scripts": ["visbug.js"], "type": "module"}, "action": {"default_title": "Click or press Alt+Shift+D to launch VisBug2", "default_icon": {"128": "icons/visbug.png"}}, "web_accessible_resources": [{"resources": ["tuts/*.gif", "toolbar/*", "toolbar/chunks/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"windows": "Alt+Shift+D", "mac": "Alt+Shift+D", "chromeos": "Alt+Shift+D", "linux": "Alt+Shift+D"}}}, "browser_specific_settings": {"gecko": {"id": "visbug2@node-projects.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}