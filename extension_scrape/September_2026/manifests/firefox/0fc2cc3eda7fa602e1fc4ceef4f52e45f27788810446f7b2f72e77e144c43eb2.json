{"manifest_version": 3, "name": "DefendShield Autofill", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "defendshield@antigravity.addon", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "description": "Automatically fills contact forms on visited pages.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/autofill.js"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"]}, "commands": {"trigger_autofill_command": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Autofill current page"}}}