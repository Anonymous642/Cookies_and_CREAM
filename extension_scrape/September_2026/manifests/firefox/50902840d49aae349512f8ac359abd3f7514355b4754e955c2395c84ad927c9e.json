{"manifest_version": 3, "name": "Passpartu", "version": "0.1.2", "description": "Type %free text query and press Enter inline anywhere on the web. The LLM answer replaces the query in-place \u2014 no popups, no copy/paste.", "browser_specific_settings": {"gecko": {"id": "passpartu@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.workers.dev/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://api.tavily.com/*"], "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": false}], "action": {"default_title": "Passpartu", "default_popup": "src/ui/popup.html", "default_icon": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}}, "options_ui": {"page": "src/ui/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "web_accessible_resources": [{"resources": ["icons/icon.svg"], "matches": ["<all_urls>"]}]}