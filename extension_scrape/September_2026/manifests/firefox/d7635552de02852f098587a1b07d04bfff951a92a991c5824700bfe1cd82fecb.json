{"manifest_version": 3, "name": "Sticky Party", "description": "Secure, self-hosted, server-synced sticky notes for web pages", "version": "0.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "tabs", "alarms", "scripting"], "web_accessible_resources": [{"resources": ["annotation-iframe.html", "realtime-orchestrator.html"], "matches": ["*://*/*"]}], "browser_specific_settings": {"gecko": {"id": "sticky-party@asano69.dev", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Sticky Party", "default_popup": "popup.html"}, "host_permissions": ["*://*/*"]}