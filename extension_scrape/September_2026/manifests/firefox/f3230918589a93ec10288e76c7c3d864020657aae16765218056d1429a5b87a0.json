{"manifest_version": 2, "name": "Netflix Auto-Skip", "version": "1.0.2", "description": "Passe automatiquement les intros, les recaps Netflix et lance l'episode suivant sans interruption", "browser_specific_settings": {"gecko": {"id": "netflix-autoskip@actuftour.fr", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "*://*.netflix.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}