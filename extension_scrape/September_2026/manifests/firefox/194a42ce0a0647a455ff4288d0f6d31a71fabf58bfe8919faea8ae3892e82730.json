{"manifest_version": 3, "name": "Strava Segment Matches Links", "version": "1.0", "description": "Adds links to Strava segments listed in the potential segment matches page.", "browser_specific_settings": {"gecko": {"id": "strava-segment-links@hackersgarden.ch", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.strava.com/*/potential-segment-matches"], "js": ["segmentLinks.js"], "run_at": "document_idle"}]}