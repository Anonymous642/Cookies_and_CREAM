{"manifest_version": 2, "name": "FluidMixer Tabs", "version": "1.0.1", "description": "Per-tab volume control that pairs with FluidMixer.app. Works in Zen, Firefox, and other Firefox-based browsers.", "browser_specific_settings": {"gecko": {"id": "fluidmixer-tabs@fluidmixer.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "activeTab", "storage", "http://127.0.0.1/*", "<all_urls>"], "browser_action": {"default_title": "FluidMixer Tabs", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}]}