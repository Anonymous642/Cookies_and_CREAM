{"manifest_version": 2, "name": "Sensible GitHub", "description": "Surface human PR comments, and see PR status and reviews inline on any website", "version": "0.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "https://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "sensible-github@mturley"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Sensible GitHub", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://127.0.0.1/*", "*://[::1]/*", "*://github.com/*", "*://localhost/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://github.com/*/pull/*"], "run_at": "document_end", "js": ["content-scripts/hide-bot-comments.js", "content-scripts/pr-tab-title.js"]}]}