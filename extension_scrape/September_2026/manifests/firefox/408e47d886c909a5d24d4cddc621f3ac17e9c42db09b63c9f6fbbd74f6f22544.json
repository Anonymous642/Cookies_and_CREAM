{"manifest_version": 3, "name": "Google Docs Folder Manager (Sheets & Slides)", "version": "0.6", "description": "Organize Google Docs, Sheets, and Slides with custom folders. Manage and sort your workspace effortlessly with a smart sidebar.", "permissions": ["identity", "storage", "unlimitedStorage"], "host_permissions": ["https://docs.google.com/*", "https://sheets.google.com/*", "https://slides.google.com/*", "https://www.googleapis.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://docs.google.com/*", "https://sheets.google.com/*", "https://slides.google.com/*"], "js": ["content.js"], "css": ["content.css"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "gdocs-folder-manager@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}