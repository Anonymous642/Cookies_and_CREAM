{"manifest_version": 3, "name": "MyContxt Extension", "version": "1.0.2", "description": "Export your AI conversations to your personal dashboard", "permissions": ["storage", "tabs"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://t3.chat/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://*.convex.cloud/*", "http://localhost:3000/*", "https://*.vercel.app/*", "https://mycontxt.app/*"], "action": {"default_popup": "popup.html", "default_icon": "my-contxt-logo.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["dist/scripts/content.js"], "matches": ["https://chatgpt.com/*", "https://t3.chat/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*"]}, {"js": ["dist/scripts/auth-listener.js"], "matches": ["http://localhost:3000/extension-auth*", "https://*.vercel.app/extension-auth*", "https://mycontxt.app/extension-auth*"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["dist/scripts/*", "auth-callback.html"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://t3.chat/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://*.convex.cloud/*", "http://localhost:3000/*", "https://*.vercel.app/*", "https://mycontxt.app/*"]}], "browser_specific_settings": {"gecko": {"id": "mycontxt-extension@mycontxt.app"}}}