{"manifest_version": 3, "name": "OrbitHub - SpeedDial and bookmark HOMEpage", "version": "2.0.0", "description": "Beautiful new tab homepage with speed dial, bookmarks & shortcuts. Quick access to your favorite links.", "permissions": ["storage", "activeTab", "tabs", "identity", "search"], "content_security_policy": {"extension_pages": "script-src 'self'; frame-src *; object-src 'self';"}, "host_permissions": ["https://api.orbithubs.net/*"], "chrome_url_overrides": {"newtab": "index.html"}, "action": {"default_title": "Add current page to OrbitHub", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "homepage_url": "https://orbithubs.net", "browser_specific_settings": {"gecko": {"id": "orbithub@vvi.tplinkdns.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "bookmarksInfo"]}}}}