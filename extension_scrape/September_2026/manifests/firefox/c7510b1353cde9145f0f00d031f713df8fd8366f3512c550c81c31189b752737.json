{"manifest_version": 2, "name": "WhatsApp Contact Replacer", "version": "1.0.0", "description": "Replace phone numbers with contact names on WhatsApp Web using your own VCF contact list.", "browser_specific_settings": {"gecko": {"id": "@whatsapp-web-contact-replacer.uak-gitlab", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_popup": "popup/popup.html", "default_title": "WhatsApp Contact Replacer"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["utils/vcf-parser.js", "content/content.js"], "run_at": "document_idle"}]}