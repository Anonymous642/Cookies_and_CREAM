{"manifest_version": 2, "name": "Lyrics Copier", "version": "1.0.1", "description": "Copy lyrics from Musixmatch, Genius with one click", "browser_specific_settings": {"gecko": {"id": "lyrics.copier@admin.io.vn", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "menus", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}, "default_title": "Copy Lyrics", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.musixmatch.com/lyrics/*"], "js": ["extractors/musixmatch.js", "content.js"], "run_at": "document_idle"}, {"matches": ["*://*.genius.com/*-lyrics"], "js": ["extractors/genius.js", "content.js"], "run_at": "document_idle"}]}