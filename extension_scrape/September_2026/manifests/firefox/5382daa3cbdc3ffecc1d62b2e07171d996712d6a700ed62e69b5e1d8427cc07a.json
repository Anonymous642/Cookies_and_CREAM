{"manifest_version": 3, "name": "LinArts New Tab & AI Wallpaper Startpage", "version": "2.0.0", "description": "Atemberaubende KI-Kunst und Wallpapers als Firefox-Startseite mit integrierter Suche, Uhr und Quick-Links.", "action": {"default_title": "LinArts Startpage"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage", "declarativeNetRequest"], "background": {"scripts": ["js/background.js"]}, "host_permissions": ["*://*.proton.me/*", "*://*.google.com/*", "*://*.gstatic.com/*", "*://suggestqueries.google.com/*", "*://*.chatgpt.com/*", "*://*.openai.com/*", "*://*.linarts.app/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*", "*://*.startpage.com/*", "*://*.youtube.com/*", "https://www.tagesschau.de/*", "https://www.heise.de/*", "https://*.spiegel.de/*", "https://rss.golem.de/*"], "declarative_net_request": {"rule_resources": [{"id": "remove_frame_headers", "enabled": true, "path": "rules.json"}]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/*", "icons/services/*", "wallpapers/*", "fonts/*", "welcome.html", "welcome.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "startpage@linarts.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}