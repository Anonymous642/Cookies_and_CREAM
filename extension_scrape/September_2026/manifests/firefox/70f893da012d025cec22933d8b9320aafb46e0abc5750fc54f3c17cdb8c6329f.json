{"manifest_version": 2, "name": "Study Music Pauser", "version": "1.0", "description": "Auto-pauses your YouTube music when a lecture video plays, resumes when it stops.", "permissions": ["tabs", "storage", "webNavigation", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "study-music-pauser@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Study Music Pauser"}}