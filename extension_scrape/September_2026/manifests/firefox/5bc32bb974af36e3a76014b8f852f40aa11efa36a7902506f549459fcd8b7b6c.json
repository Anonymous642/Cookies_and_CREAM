{"manifest_version": 2, "name": "Snippetly", "description": "Save canned replies and expand shortcuts in editable fields. Your team's replies, always one click away.", "version": "0.1.0", "homepage_url": "https://snippetly.online", "permissions": ["storage", "activeTab", "<all_urls>", "clipboardWrite"], "browser_action": {"default_title": "Snippetly", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Snippetly popup"}}, "browser_specific_settings": {"gecko": {"id": "snippetly@snippetly.online", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}