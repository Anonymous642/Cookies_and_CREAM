{"manifest_version": 3, "name": "WebPage Source Recon", "version": "1.0", "description": "Sidebar for analyzing raw web page source during reconnaissance. Extracts HTML comments, meta tags, inline scripts, hidden inputs, with filtering and export.", "browser_specific_settings": {"gecko": {"id": "webpage_source_recon@libor_benes.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "sidebar_action": {"default_title": "WebPage Source Recon", "default_panel": "sidebar.html"}}