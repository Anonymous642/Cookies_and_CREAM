{"manifest_version": 3, "name": "OMG U PEOPLE CANT DO ANYTHING", "version": "2.1", "description": "Restricts Instagram to DMs only. Blocks Instagram entirely when a Pomodoro is running.", "permissions": ["tabs", "storage"], "host_permissions": ["https://www.instagram.com/*", "https://pomofocus.io/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["instagram.js"], "css": ["hide-nav.css"], "run_at": "document_start"}, {"matches": ["https://pomofocus.io/*"], "js": ["pomofocus.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Instagram DM Only"}, "icons": {"48": "icons/icon48.jpg"}, "browser_specific_settings": {"gecko": {"id": "instagram-dm-only@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}