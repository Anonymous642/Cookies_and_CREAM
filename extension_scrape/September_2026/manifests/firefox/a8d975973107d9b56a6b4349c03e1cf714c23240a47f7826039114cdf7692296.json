{"manifest_version": 3, "name": "Lamha \u2014 \u0644\u0645\u062d\u0629", "short_name": "Lamha", "version": "1.0.0", "description": "Look up English words and translate anything to Arabic \u2014 select text and tap the button. \u0642\u0627\u0645\u0648\u0633 \u0648\u0645\u062a\u0631\u062c\u0645 \u0641\u0648\u0631\u064a \u0644\u0644\u0639\u0631\u0628\u064a\u0629.", "browser_specific_settings": {"gecko": {"id": "lamha@artwork-lab", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["storage", "menus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/styles.js", "content/page-translator.js", "content/content.js"], "all_frames": true, "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg", "default_title": "\u0644\u0645\u062d\u0629 \u2014 \u062a\u0631\u062c\u0645\u0629 \u0648\u0628\u062d\u062b"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"lookup-selection": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Look up / translate the selected text"}, "translate-page": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Translate the whole page to Arabic (toggle)"}}}