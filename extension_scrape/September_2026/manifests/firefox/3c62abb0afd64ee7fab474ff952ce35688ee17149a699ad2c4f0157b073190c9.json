{"manifest_version": 2, "name": "Declutterer", "version": "1.0", "description": "Removes the suggestions and comment section in youtube and some other parts of the website that I don't find helpful", "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["yt-declutterer.js"]}], "browser_specific_settings": {"gecko": {"id": "@youtube-declutterer", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"id": "@youtube-declutterer", "data_collection_permissions": {"required": ["none"]}}}}