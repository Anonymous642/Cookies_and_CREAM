{"manifest_version": 3, "name": "Favourites for pCloud", "version": "0.1.1", "description": "Star your favourite photos in pCloud and browse them in a dedicated gallery. Favourites are stored in your own pCloud account.", "browser_specific_settings": {"gecko": {"id": "pcloud-favorites@schoennenbeck", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "permissions": ["storage", "webRequest", "cookies", "tabs"], "host_permissions": ["https://*.pcloud.com/*"], "background": {"scripts": ["src/lib/util.js", "src/lib/api.js", "src/lib/store.js", "src/background.js"]}, "content_scripts": [{"matches": ["https://my.pcloud.com/*", "https://e.pcloud.com/*", "https://e1.pcloud.com/*"], "js": ["src/content/page-tap.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}, {"matches": ["https://my.pcloud.com/*", "https://e.pcloud.com/*", "https://e1.pcloud.com/*"], "js": ["src/lib/util.js", "src/content/adapter.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "src/ui/popup.html", "default_title": "Favourites for pCloud", "default_icon": {"48": "icons/logo-48.svg", "96": "icons/logo-96.svg"}}, "options_ui": {"page": "src/ui/options.html", "open_in_tab": true}, "icons": {"48": "icons/logo-48.svg", "96": "icons/logo-96.svg"}}