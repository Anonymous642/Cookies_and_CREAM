{"manifest_version": 3, "name": "NetScope", "version": "1.0.8", "description": "Inspect HTTP traffic and alert on local-network probes and fingerprinting \u2014 sidebar, toolbar badge, and desktop notifications.", "author": "NetScope", "browser_specific_settings": {"gecko": {"id": "netscope@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "tabs", "cookies", "notifications"], "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"], "background": {"scripts": ["src/js/detectors.js", "src/js/background.js"]}, "sidebar_action": {"default_panel": "src/html/panel.html", "default_title": "NetScope", "default_icon": "src/assets/icon.svg"}, "action": {"default_icon": "src/assets/icon.svg", "default_title": "Toggle NetScope"}, "options_ui": {"page": "src/html/panel.html", "open_in_tab": true}, "icons": {"48": "src/assets/icon.svg", "96": "src/assets/icon.svg"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+N"}, "description": "Toggle NetScope sidebar"}}, "content_scripts": [{"matches": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"], "js": ["src/js/detectors.js", "src/js/content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["src/js/detectors.js", "src/js/page-hooks.js"], "matches": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"]}]}