{"manifest_version": 2, "name": "OutlookBuddy", "version": "0.2.0", "description": "Switch between multiple Outlook / Microsoft 365 web accounts instantly \u2014 each stays signed in via its own isolated container. No more logouts or 'switch account' prompts. Not affiliated with or endorsed by Microsoft.", "browser_specific_settings": {"gecko": {"id": "outlookbuddy@addons", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["contextualIdentities", "cookies", "tabs", "storage"], "background": {"scripts": ["lib.js", "background.js"]}, "browser_action": {"default_title": "OutlookBuddy", "default_popup": "popup.html", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg"}}, "commands": {"next-account": {"suggested_key": {"default": "Alt+PageDown"}, "description": "Switch to next mailbox"}, "prev-account": {"suggested_key": {"default": "Alt+PageUp"}, "description": "Switch to previous mailbox"}, "open-all": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open all mailboxes"}}}