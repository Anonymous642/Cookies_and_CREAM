{"manifest_version": 3, "name": "Text Spacing Switch", "version": "1.0.0", "description": "Apply temporary line, letter, word, and paragraph spacing styles to the active web page.", "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["spacing-core.js", "background.js"]}, "action": {"default_title": "Open Text Spacing Switch", "default_popup": "popup.html", "default_icon": {"48": "assets/icon.svg", "96": "assets/icon.svg"}}, "commands": {"toggle-spacing": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Apply or remove saved text spacing on the active page"}}, "icons": {"48": "assets/icon.svg", "96": "assets/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "text-spacing-switch@local.tools", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}