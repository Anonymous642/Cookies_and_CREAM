{"manifest_version": 3, "name": "QRGenerator", "version": "1.0.0", "description": "Simple QR code generator. Generate QR codes from current page URL or custom text.", "icons": {"48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png"}, "action": {"default_icon": {"48": "images/icon-48.png", "96": "images/icon-96.png"}, "default_title": "QRGenerator", "default_popup": "viewer/qr.html"}, "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "qrgenerator@code.maker", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}