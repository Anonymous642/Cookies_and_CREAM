{"manifest_version": 2, "name": "Engagement Heatmap", "version": "1.3", "description": "Visualize user engagement on web pages using a scroll and click heatmap.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_title": "Engagement Heatmap", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Engagement-Heatmap", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}