{"manifest_version": 3, "name": "localStorage Inspector", "version": "1.0.0", "description": "A dedicated DevTools panel for inspecting, editing, and monitoring localStorage and sessionStorage with a live JSON tree, type badges, size heatmap, and change history.", "icons": {"16": "public/icon16.svg", "48": "public/icon48.svg", "128": "public/icon128.svg"}, "browser_specific_settings": {"gecko": {"id": "storage-inspector@example.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "devtools_page": "src/devtools/devtools.html", "background": {"scripts": ["service-worker-loader.js"]}, "content_scripts": [{"js": ["assets/content_script.js"], "matches": ["<all_urls>"], "run_at": "document_start"}], "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["src/panel/panel.html", "src/panel/assets/*", "assets/content_script.js"]}], "permissions": ["storage"], "host_permissions": ["<all_urls>"]}