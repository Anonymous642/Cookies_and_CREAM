{"manifest_version": 2, "name": "Make That a Podcast!", "version": "1.0.1", "description": "Transform any webpage into engaging podcasts with one click. Install our browser extension and create podcasts from any webpage - articles, blogs, news, or any text content you want to listen to later.", "permissions": ["activeTab", "tabs", "storage", "contextMenus", "notifications", "alarms", "clipboardWrite", "scripting", "http://localhost:8010/*", "https://*.makethatapodcast.com/*", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Add to Listening List"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"add-to-list": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Add current page to listening list"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "make-that-a-podcast-1.0@makethatapodcast.com", "strict_min_version": "58.0"}}}