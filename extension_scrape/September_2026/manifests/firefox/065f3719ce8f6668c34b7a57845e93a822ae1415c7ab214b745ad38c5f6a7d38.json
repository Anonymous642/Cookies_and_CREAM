{"manifest_version": 3, "name": "Archive Now", "version": "2.4.0", "description": "Open the archived copy of the current page in one click \u2014 archive.today and the Wayback Machine. Clean full-width snapshot view and a themeable reader mode.", "permissions": ["activeTab", "contextMenus", "storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "{352ccdc5-51da-4cba-bd03-62e55b18d251}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Open with Archive Now", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options.html"}, "commands": {"archive-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Archive the current page"}, "open-newest": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Open newest snapshot of the current page"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://archive.ph/*", "https://archive.today/*", "https://archive.is/*", "https://archive.li/*", "https://archive.md/*", "https://archive.vn/*", "https://web.archive.org/*"], "js": ["vendor/Readability.js", "clean.js"], "run_at": "document_idle"}], "host_permissions": ["https://archive.ph/*", "https://archive.today/*", "https://archive.is/*", "https://archive.li/*", "https://archive.md/*", "https://archive.vn/*", "https://web.archive.org/*"]}