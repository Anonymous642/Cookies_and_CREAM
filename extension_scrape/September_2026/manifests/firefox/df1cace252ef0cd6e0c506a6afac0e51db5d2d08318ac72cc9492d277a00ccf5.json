{"manifest_version": 2, "name": "ExtAgento", "version": "0.1.0", "version_name": "0.1.0.20260704", "description": "Dynamic User-Agent Switcher \u2014 auto-learns latest browser/OS versions, auto-randomizes on configurable intervals, logs all activity.", "author": "ExtAgento", "homepage_url": "https://extagento.github.io", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "webRequest", "webRequestBlocking", "tabs", "contextMenus", "alarms", "cookies", "<all_urls>"], "background": {"scripts": ["lib/ua-data.js", "lib/version-updater.js", "lib/ua-parser.js", "background.js"], "persistent": true}, "browser_action": {"browser_style": false, "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "ExtAgento"}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "content_scripts": [{"all_frames": true, "run_at": "document_start", "match_about_blank": true, "matches": ["<all_urls>"], "js": ["lib/ua-parser.js", "content.js"]}], "browser_specific_settings": {"gecko": {"id": "extagento@extagento.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}