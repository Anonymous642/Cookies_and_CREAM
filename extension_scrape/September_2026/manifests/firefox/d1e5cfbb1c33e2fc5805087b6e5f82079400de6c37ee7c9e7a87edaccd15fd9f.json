{"manifest_version": 3, "name": "KnowMyBrowser", "version": "1.0", "description": "Tells you which browser you are currently using, shown in a clear, easy-to-read popup with a customizable colored dot.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "knowmybrowser@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "KnowMyBrowser", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}