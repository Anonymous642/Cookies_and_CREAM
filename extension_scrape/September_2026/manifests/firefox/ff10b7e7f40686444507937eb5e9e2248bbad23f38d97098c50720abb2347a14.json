{"manifest_version": 3, "name": "Web Reader for LingQ", "version": "1.9.0", "description": "Highlights known and unknown words on any webpage using your LingQ vocabulary.", "action": {"default_title": "Web Reader for LingQ", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["storage", "unlimitedStorage", "alarms"], "host_permissions": ["https://*.lingq.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "web-reader-for-lingq@joshuabragge.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}