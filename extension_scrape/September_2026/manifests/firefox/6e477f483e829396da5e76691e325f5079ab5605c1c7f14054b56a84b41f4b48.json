{"manifest_version": 3, "name": "LessTube", "description": "YouTube as a search engine - no recommendations, just search", "version": "1.1.4", "author": "Faunder", "homepage_url": "https://github.com/ranefaunder/lesstube", "icons": {"16": "icon-16x16.png", "48": "icon-48x48.png", "128": "icon-128x128.png"}, "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["index.js"], "css": ["style.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "lesstube@lessmatter.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}