{"manifest_version": 3, "name": "Prompt Shortcuts for ChatGPT", "version": "1.0.0", "description": "Add, edit and reuse your favorite prompts with one click, right next to the ChatGPT composer.", "browser_specific_settings": {"gecko": {"id": "prompt-shortcuts@local.dev", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}