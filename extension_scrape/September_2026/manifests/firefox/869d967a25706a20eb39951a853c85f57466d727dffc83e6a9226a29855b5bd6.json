{"manifest_version": 2, "name": "PGP Copy", "version": "1.0.0", "description": "Encode and decode text on copy and paste. 17 codecs including PGP encryption, Base64, URL encoding, Hex, Caesar, Vigen\u00e8re, XOR, and more \u2014 right from your context menu.", "author": "thom@swoll.in", "homepage_url": "https://github.com/Nillows", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["contextMenus", "clipboardRead", "clipboardWrite", "activeTab", "storage"], "background": {"scripts": ["lib/openpgp.min.js", "codecs.js", "background.js"], "persistent": false}, "browser_action": {"default_icon": {"48": "icons/icon-48.svg"}, "default_title": "PGP Copy Settings", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pgp-copy@extension", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}