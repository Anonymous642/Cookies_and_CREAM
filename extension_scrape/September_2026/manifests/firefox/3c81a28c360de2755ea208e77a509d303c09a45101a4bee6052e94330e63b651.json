{"manifest_version": 3, "name": "Replace YouTube Chat With Twitch Chat", "version": "1.5.0", "description": "Replaces YouTube live chat with the matching Twitch channel chat.", "permissions": ["activeTab", "storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "browser_specific_settings": {"gecko": {"id": "replace-youtubechat-with-twitchchat@udin.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}