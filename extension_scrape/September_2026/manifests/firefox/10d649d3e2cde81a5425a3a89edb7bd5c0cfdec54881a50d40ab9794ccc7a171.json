{"manifest_version": 2, "name": "Spotizerr Helper (Starter)", "version": "0.1.0", "description": "Injects a simple UI on Spotify pages and calls Spotizerr backend.", "browser_action": {"default_title": "Spotizerr Helper"}, "permissions": ["storage", "<all_urls>"], "background": {"scripts": ["src/background.js"], "persistent": true}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://open.spotify.com/*playlist/*", "https://open.spotify.com/*album/*", "https://open.spotify.com/*track/*", "https://open.spotify.com/*artist/*", "https://open.spotify.com/*"], "js": ["src/content-script.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "spotizerr-helper@example.com"}}}