{"name": "Hudu Password Manager", "description": "Hudu Password Manager", "version": "1.1.1", "manifest_version": 3, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "alarms", "scripting", "activeTab", "identity", "webNavigation"], "host_permissions": ["https://*/*", "<all_urls>"], "action": {"default_icon": "icon16.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+I"}, "description": "Open Hudu popup"}}, "background": {"scripts": ["backgroundScript.js"]}, "web_accessible_resources": [{"resources": ["assets/*", "scripts/setUpAutofillBtn.js", "index.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"css": ["contentCSS.css"], "all_frames": true, "run_at": "document_idle", "matches": ["<all_urls>"]}, {"js": ["scripts/mainScript.js"], "run_at": "document_idle", "matches": ["<all_urls>"]}, {"matches": ["https://*/*"], "js": ["scripts/passkeyPageShim.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["https://*/*"], "js": ["scripts/passkeyRelay.js"], "run_at": "document_start", "all_frames": true}, {"js": ["scripts/passkeyNamePrefill.js"], "run_at": "document_idle", "all_frames": true, "matches": ["https://mysignins.microsoft.com/*", "https://account.microsoft.com/*", "https://login.microsoft.com/*"]}], "browser_specific_settings": {"gecko": {"id": "hudu-password-extension@hudu.com", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "object-src 'self'; script-src 'self' 'wasm-unsafe-eval';"}}