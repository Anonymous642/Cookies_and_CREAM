{"name": "Deckr", "version": "2.10.30.1030", "manifest_version": 3, "description": "The Ultimate Social Bookmark Manager. With a secure offline AI chat and more. More new features on the way!", "chrome_url_overrides": {"newtab": "new_tab_page.html"}, "background": {"scripts": ["js/background_service.js"]}, "permissions": ["bookmarks", "tabs", "topSites", "history", "clipboardRead"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "commands": {"add-bookmark": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Save current tab to Deckr."}, "open-find-dialog": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Open Find dialog in Deckr."}, "open-deckr-tab": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Open Deckr Tab."}}, "icons": {"16": "icons/favicon.png", "32": "icons/app_icon_32.png", "64": "icons/app_icon_64.png", "128": "icons/app_icon_128.png", "256": "icons/app_icon_256.png", "512": "icons/app_icon_512.png", "1024": "icons/app_icon_1024.png"}, "action": {"default_icon": {"16": "icons/favicon.png", "32": "icons/favicon.png"}, "default_title": "Add to Inbox"}, "cross_origin_opener_policy": {"value": "same-origin"}, "cross_origin_embedder_policy": {"value": "credentialless"}, "browser_specific_settings": {"gecko": {"id": "{dae45bf7-e98f-5484-979e-81ef08954c3d}", "strict_min_version": "91.1.0"}}}