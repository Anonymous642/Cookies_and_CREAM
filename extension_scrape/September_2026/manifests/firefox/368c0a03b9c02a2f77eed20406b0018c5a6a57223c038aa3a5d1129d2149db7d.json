{"manifest_version": 3, "name": "Syniq Screen Capture", "version": "1.0.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "description": "Capture, annotate, and share screenshots instantly from your browser.", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "identity"], "optional_permissions": ["notifications", "downloads", "clipboardWrite"], "host_permissions": ["<all_urls>"], "optional_host_permissions": ["https://mail.google.com/*", "file:///*"], "background": {"scripts": ["background-firefox.js"]}, "action": {"default_title": "Capture selected area", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["content.js", "settings.js", "shared.js", "annotator-core.js", "permission-modal.js", "rollbar.js", "rollbar-core.js", "rollbar-config.js", "selection-cursor.svg", "landing.html", "landing.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "MacCtrl+Shift+O"}}, "activate-selection": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "MacCtrl+Shift+J"}, "description": "Start area screenshot selection"}, "activate-full-page": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L"}, "description": "Start full-page screenshot capture"}, "activate-full-screen": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "MacCtrl+Shift+U"}, "description": "Start screen or window capture"}}, "browser_specific_settings": {"gecko": {"id": "syniq-screen-capture@getsyniq.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}