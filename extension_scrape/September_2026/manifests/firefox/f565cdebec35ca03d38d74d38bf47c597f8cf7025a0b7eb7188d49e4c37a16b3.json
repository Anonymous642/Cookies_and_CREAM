{"manifest_version": 3, "name": "ZenMode", "version": "2.0", "homepage_url": "https://zenmode.woodendoor.website", "description": "Customizable UI toggles for YouTube, Twitch, and Bilibili.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.twitch.tv/*", "*://*.bilibili.com/*"], "browser_specific_settings": {"gecko": {"id": "zenmode@woodendoor.website", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"512": "icons/icon512.png"}}, "icons": {"512": "icons/icon512.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["core/content.js", "sites/youtube/main.js"], "css": ["sites/youtube/styles.css"], "run_at": "document_start"}, {"matches": ["*://*.twitch.tv/*"], "js": ["core/content.js", "sites/twitch/main.js"], "css": ["sites/twitch/styles.css"], "run_at": "document_start"}, {"matches": ["*://*.bilibili.com/*"], "js": ["core/content.js", "sites/bilibili/main.js"], "css": ["sites/bilibili/styles.css"], "run_at": "document_start"}]}