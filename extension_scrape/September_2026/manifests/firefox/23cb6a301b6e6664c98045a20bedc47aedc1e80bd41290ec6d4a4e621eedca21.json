{"manifest_version": 3, "name": "RapidTabSurf", "version": "1.4", "description": "A Chrome Extension v3 for RapidTabSurf traffic exchange platform", "browser_specific_settings": {"gecko": {"id": "rapidtabsurf@example.com", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "tabs", "storage", "notifications"], "host_permissions": ["https://rapidtab.surf/*", "https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup.html", "default_title": "RapidTabSurf"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}