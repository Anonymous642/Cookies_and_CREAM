{"manifest_version": 3, "name": "Search Engine Redirector", "version": "1.0.0", "description": "Leitet versehentliche Suchanfragen und Startseiten von Bing, Yahoo und weiteren Suchmaschinen automatisch auf Google oder deine Wunsch-Suchmaschine um.", "browser_specific_settings": {"gecko": {"id": "redirect-search-engine@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/rules/engine-rules.js", "src/background/background.js"]}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Search Engine Redirector", "default_popup": "src/popup/popup.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}