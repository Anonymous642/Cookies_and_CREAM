{"manifest_version": 3, "name": "Sticky Notes", "version": "0.2.1", "description": "Add sticky notes to any webpage and share via URL.", "action": {"default_title": "Toggle sticky notes mode", "default_icon": {"16": "icons/icon-16.png", "19": "icons/icon-19.png", "32": "icons/icon-32.png", "38": "icons/icon-38.png"}}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "sticky-notes@example.com", "strict_min_version": "109.0"}}}