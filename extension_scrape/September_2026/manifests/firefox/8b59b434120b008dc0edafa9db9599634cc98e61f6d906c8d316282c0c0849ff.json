{"manifest_version": 3, "name": "guesel", "version": "0.1.0", "description": "Fill any email field with a throwaway guesel address, and see unread mail on the toolbar badge.", "browser_specific_settings": {"gecko": {"id": "guesel-extension@guesel.ch", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "icons": {"48": "icons/guesel.svg", "96": "icons/guesel.svg"}, "permissions": ["storage", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["common.js", "background.js"]}, "action": {"default_title": "guesel", "default_icon": {"48": "icons/guesel.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}]}