{"manifest_version": 3, "name": "KoraTS Match Time Planner", "version": "1.0.2", "description": "Convert football match times to your local timezone, save fixtures, and set kick-off reminders.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "action": {"default_title": "Plan match times", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "alarms", "notifications"], "browser_specific_settings": {"gecko": {"id": "korats-match-time-planner@korats.net", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}