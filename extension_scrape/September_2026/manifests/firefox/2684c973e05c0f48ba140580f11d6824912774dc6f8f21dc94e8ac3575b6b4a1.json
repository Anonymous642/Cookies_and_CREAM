{"manifest_version": 3, "name": "Spacebar Review for GitHub", "version": "1.0.0", "description": "Space marks the next unviewed file on a PR and scrolls to the following one.", "browser_specific_settings": {"gecko": {"id": "spacebar-review-for-github@jeppejuliuskrogh.gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "16.png", "48": "48.png", "128": "128.png"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}