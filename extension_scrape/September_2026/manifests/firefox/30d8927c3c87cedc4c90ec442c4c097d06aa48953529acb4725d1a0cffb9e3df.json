{"manifest_version": 3, "name": "HintTree \u2014 Keyboard Bookmark Launcher", "version": "1.0.0", "description": "Navigate your complete Firefox bookmark tree with keyboard hints, adaptive columns, search, and locally cached favicons.", "permissions": ["bookmarks", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open HintTree", "default_icon": {"32": "icons/hinttree-32.png", "64": "icons/hinttree-64.png"}}, "commands": {"toggle-bookmark-tree": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle HintTree"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["overlay.html", "overlay.css", "overlay.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "hinttree@daniilstupnikov", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["bookmarksInfo"]}}}, "icons": {"32": "icons/hinttree-32.png", "64": "icons/hinttree-64.png", "128": "icons/hinttree-128.png"}}