{"manifest_version": 2, "name": "Clean Copy Link", "version": "1.0.0", "description": "Copy a clean, tracking\u2011free URL (or Title + URL) from the current page or any link \u2014 no inline scripts, no remote code, and minimal permissions.", "browser_specific_settings": {"gecko": {"id": "clean-copy-link@example.com", "strict_min_version": "78.0"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "clipboardWrite", "storage", "menus", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Clean Copy Link", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true, "browser_style": true}}