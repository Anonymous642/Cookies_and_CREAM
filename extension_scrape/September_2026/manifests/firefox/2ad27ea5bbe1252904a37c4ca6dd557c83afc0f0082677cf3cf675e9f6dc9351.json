{"manifest_version": 2, "name": "One YouTube Premium", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "one-youtube-premium-2026@ferozomer.proton.me", "data_collection_permissions": {"required": ["none"]}}}, "description": "Replaces YouTube/YouTube Music logo with Premium logo and removes ads/upsells on both platforms.", "permissions": ["storage", "activeTab", "tabs", "*://*.youtube.com/*", "*://*.music.youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "One YouTube Premium", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.music.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": ["inject.js"]}