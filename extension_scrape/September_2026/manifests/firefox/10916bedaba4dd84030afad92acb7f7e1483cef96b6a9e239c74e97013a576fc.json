{"manifest_version": 3, "name": "Lightweight YouTube", "version": "1.0.1", "description": "Redirects YouTube to its mobile version on desktop browsers, providing a faster and lighter experience on old hardware.", "developer": {"name": "Andrei Ionel (thetechdog)", "url": "https://github.com/thetechdog/lightweight-youtube/"}, "browser_specific_settings": {"gecko": {"id": "lightweight-youtube@thetechdog", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "113.0"}}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"128": "lightweight_youtube_128.png"}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}}