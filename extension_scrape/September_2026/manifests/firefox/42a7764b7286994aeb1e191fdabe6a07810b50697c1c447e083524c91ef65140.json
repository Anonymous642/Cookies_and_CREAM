{"manifest_version": 2, "name": "250WPM", "version": "1.0", "description": "Read time estimator based on 250 WPM", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "250wpm@erling.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs"], "commands": {"estimate-reading-time": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Show reading time estimate"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}