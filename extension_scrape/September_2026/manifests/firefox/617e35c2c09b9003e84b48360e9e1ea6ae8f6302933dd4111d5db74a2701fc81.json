{"manifest_version": 2, "name": "Nexus Autofill Pro", "version": "3.9.0", "description": "Auto-fills dispute resolution forms on Nexus Talos Portal. Supports batch mode: fill multiple tabs automatically.", "permissions": ["activeTab", "storage", "tabs", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "nexus-autofill-pro-public@amazon.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://nexus-talos-portal-prod-na.aka.amazon.com/dispute/*", "https://nexus-talos-portal-prod-eu.aka.amazon.com/dispute/*"], "js": ["presets.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "Nexus Autofill Pro"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}