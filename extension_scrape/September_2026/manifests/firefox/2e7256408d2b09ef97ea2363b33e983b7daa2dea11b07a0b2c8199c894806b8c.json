{"manifest_version": 3, "name": "Swagger Filter", "version": "3.1.1", "description": "An extension built on Swagger UI that provides an intuitive interface to display, filter, and manage API endpoints, enhancing the efficiency of API exploration and understanding.", "icons": {"16": "assets/logo-16.png", "24": "assets/logo-24.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "64": "assets/logo-64.png", "128": "assets/logo-128.png"}, "action": {"default_icon": {"16": "assets/logo-16.png", "24": "assets/logo-24.png", "32": "assets/logo-32.png", "48": "assets/logo-48.png", "64": "assets/logo-64.png", "128": "assets/logo-128.png"}, "default_title": "Toggle Sidebar"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle the sidebar visibility"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "assets/index.js"], "css": ["assets/index.css"]}], "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@swagger-filter-547d081b-99e5-4acb-b7c3-aa2807e548c8"}}}