{"manifest_version": 3, "name": "Gmail Reply Assistant (LM Studio / Groq)", "version": "1.0.0", "description": "G\u00e9n\u00e8re une r\u00e9ponse polie et compl\u00e8te au mail Gmail ouvert, via LM Studio en local (avec repli automatique sur Groq).", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://mail.google.com/*", "http://localhost/*", "http://127.0.0.1/*", "https://api.groq.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Assistant Mail"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "gmail-reply-assistant@rooomaan.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personalCommunications"]}}}}