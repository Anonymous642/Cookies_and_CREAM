{"manifest_version": 3, "name": "Teserra Clipper", "version": "0.6.1", "description": "Save pages, articles, images and videos to Teserra, your visual library on your Mac. Option-click any image or video.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "notifications"], "host_permissions": ["http://127.0.0.1/*"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "Clip to Teserra", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "homepage_url": "https://license.rittie.cloud/privacy", "browser_specific_settings": {"gecko": {"id": "clipper@teserra.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}