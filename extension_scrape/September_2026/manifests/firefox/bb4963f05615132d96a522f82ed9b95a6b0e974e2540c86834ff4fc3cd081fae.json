{"manifest_version": 3, "name": "Wary Security Companion", "version": "0.4.0", "description": "Warns you about fake sites and blocks third-party ad and tracker requests as you browse. Works with the Wary Security desktop app.", "permissions": ["tabs", "storage", "declarativeNetRequest", "webRequest"], "host_permissions": ["http://127.0.0.1/*", "<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "seed_ads", "enabled": true, "path": "rules/seed-ads.json"}]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Wary Security", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "wary-security@natchland.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}}