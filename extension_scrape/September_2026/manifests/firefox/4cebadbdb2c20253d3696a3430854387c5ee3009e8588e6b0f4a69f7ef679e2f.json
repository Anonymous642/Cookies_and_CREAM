{"manifest_version": 3, "name": "Full Slate for Canvas", "version": "1.0.0", "description": "Shows every Canvas deadline, including the pages, discussions and events the Canvas To Do list cannot display. Exports to your calendar. Local only.", "author": "Noah Albert", "homepage_url": "https://github.com/Android-Tipster/full-slate", "browser_specific_settings": {"gecko": {"id": "fullslate@roborhythms.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "activeTab"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["src/model.js", "src/ics.js", "src/api.js", "src/background.js"]}, "action": {"default_title": "Full Slate", "default_popup": "src/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}