{"manifest_version": 3, "name": "YouTube Speed Toggle", "version": "1.0.0", "description": "Toggle YouTube playback speed with the backtick key. Tap to switch between 1x and a configurable speed; hold for a higher speed while pressed.", "author": "pwh9882", "permissions": ["storage"], "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "YouTube Speed Toggle", "default_popup": "popup.html", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg"}}, "browser_specific_settings": {"gecko": {"id": "yt-speed-toggle@pwh9882", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}