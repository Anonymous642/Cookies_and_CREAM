{"manifest_version": 3, "name": "ApplyThis", "version": "1.0", "description": "Companion extension for ApplyThis", "browser_specific_settings": {"gecko": {"id": "applythis@hazmimosbah.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["contextMenus", "storage", "notifications", "activeTab"], "host_permissions": ["http://localhost:3000/*", "https://hazmimosbah.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/bitmap.svg"}}, "icons": {"48": "icons/bitmap.svg"}, "web_accessible_resources": [{"resources": ["icons/bitmap.svg"], "matches": ["*://*.linkedin.com/*"]}]}