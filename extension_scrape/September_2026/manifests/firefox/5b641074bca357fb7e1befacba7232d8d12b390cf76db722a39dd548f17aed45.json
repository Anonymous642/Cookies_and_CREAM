{"manifest_version": 3, "name": "YouTube Distraction Free", "version": "1.0", "author": "Marjuk Amin (github: Marjuk06)", "description": "Removes all distractions from YouTube, leaving only the main video.", "permissions": ["storage", "tabs"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "icons": {"128": "icon.png"}, "action": {}, "browser_specific_settings": {"gecko": {"id": "marjukamin06@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}