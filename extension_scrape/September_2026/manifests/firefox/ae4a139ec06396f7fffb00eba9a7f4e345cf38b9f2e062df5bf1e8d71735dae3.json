{"manifest_version": 3, "name": "YouTube Dossier", "version": "0.1.0", "description": "Brutalist black/white/red report styling for YouTube, with toggles for Shorts, comments and clutter.", "browser_specific_settings": {"gecko": {"id": "youtube-dossier@yt-stylus", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "action": {"default_title": "YouTube Dossier", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "css": ["dossier.css"], "js": ["defaults.js", "content.js"], "run_at": "document_start"}]}