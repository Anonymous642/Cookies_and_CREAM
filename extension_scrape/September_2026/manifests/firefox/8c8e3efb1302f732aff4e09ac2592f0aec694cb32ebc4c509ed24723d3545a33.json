{"manifest_version": 3, "name": "DarkSelect - Selective Element Dark Mode", "version": "1.0.3", "description": "Selectively force dark mode on blinding white screenshots, diagrams, and elements on dark web pages.", "browser_specific_settings": {"gecko": {"id": "darkselect@extension.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "DarkSelect"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-picker": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Activate element dark mode picker"}}}