{"manifest_version": 2, "name": "SceneNotes", "version": "1.0.0", "description": "Attach short text notes to video timestamps. Hover/click on progress to see notes. Notes stored locally via browser.storage.local.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "css": ["styles.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "scenenotes@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}