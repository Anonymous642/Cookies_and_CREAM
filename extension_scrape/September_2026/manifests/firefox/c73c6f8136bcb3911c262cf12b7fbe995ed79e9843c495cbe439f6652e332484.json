{"manifest_version": 3, "name": "CiteKit \u2013 Reference Library", "short_name": "CiteKit", "version": "2.1.1", "description": "Save web pages as references, organize them into reference sets, and send them to your WordPress site to cite in articles.", "homepage_url": "https://citekit.com/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Save to CiteKit", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "library.html#settings", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Save this page to CiteKit"}}, "background": {"scripts": ["reference.js", "lib/store.js", "lib/wp.js", "background.js"]}, "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"], "optional_host_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "reference-library@citekit.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}