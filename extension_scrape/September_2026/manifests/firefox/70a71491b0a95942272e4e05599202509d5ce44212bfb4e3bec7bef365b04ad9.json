{"manifest_version": 3, "name": "CineLog Tracker", "version": "1.0.0", "description": "Detects when you finish a movie or show on any site and logs it to CineLog.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "cinelog-tracker@blue0.dev", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"], "optional": []}}, "gecko_android": {"strict_min_version": "126.0"}}, "key": "", "externally_connectable": {"matches": ["https://heartive.pages.dev/*", "https://*.blue0.dev/*"]}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.twitch.tv/*", "*://twitch.tv/*", "*://*.tiktok.com/*", "*://*.google.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.zoom.us/*", "*://*.meet.google.com/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": false, "run_at": "document_idle"}]}