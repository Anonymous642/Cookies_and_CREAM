{"manifest_version": 2, "name": "PixelCloak", "version": "1.0.0", "description": "Capture, detect, and redact sensitive information locally.", "permissions": ["activeTab", "storage", "scripting"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/settings/index.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "content_security_policy": "script-src 'self'; object-src 'self'; worker-src 'self'", "commands": {"pixelcloak-shortcut": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture and redact the current tab"}}, "browser_specific_settings": {"gecko": {"id": "pixelcloak@pixelcloak.app", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}