{"manifest_version": 3, "name": "YouTube Classic 2015 (Mobile + Desktop)", "version": "1.1.0", "description": "Restyles YouTube (m.youtube.com and www.youtube.com) with a flat, red-accented approximation of the 2015-era interface, including the HTML5 video player chrome.", "browser_specific_settings": {"gecko": {"id": "yt-2015-classic@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://m.youtube.com/*", "http://m.youtube.com/*", "https://www.youtube.com/*", "http://www.youtube.com/*", "https://youtube.com/*", "http://youtube.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_start"}], "host_permissions": ["https://m.youtube.com/*", "http://m.youtube.com/*", "https://www.youtube.com/*", "http://www.youtube.com/*", "https://youtube.com/*", "http://youtube.com/*"]}