{"manifest_version": 3, "name": "AriaFlow: URL to Faceless Video", "version": "0.2.1", "description": "Send the current webpage URL to AriaFlow's AI Faceless Video Generator, prefill the workflow, and generate after review.", "browser_specific_settings": {"gecko": {"id": "url-to-faceless-video@ariaflow.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "permissions": ["activeTab"], "action": {"default_title": "Open this URL in AriaFlow", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}