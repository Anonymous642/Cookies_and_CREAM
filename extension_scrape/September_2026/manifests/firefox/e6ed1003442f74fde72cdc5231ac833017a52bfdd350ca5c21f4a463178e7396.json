{"name": "CamelCollect", "description": "CamelCollect helps you to save and organize posts from LinkedIn. Then you can view and organize the posts on CamelCollect.io", "version": "0.3.3", "manifest_version": 3, "permissions": ["storage", "cookies"], "browser_specific_settings": {"gecko": {"id": "camelcollect@camelcollect.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "CamelCollect", "default_popup": "index.html", "default_icon": {"128": "camel-icon-black.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["folders.js"]}], "host_permissions": ["https://camelcollect.vercel.app/*", "https://clerk.camelcollect.io/*", "https://camelcollect.io/*", "https://www.camelcollect.io/*"], "web_accessible_resources": [{"resources": ["camel-icon-black.png", "camel-icon-white.png"], "matches": ["https://www.linkedin.com/*"]}], "icons": {"16": "camel-icon-black-16.png", "32": "camel-icon-black-32.png", "48": "camel-icon-black-48.png", "128": "camel-icon-black.png"}}