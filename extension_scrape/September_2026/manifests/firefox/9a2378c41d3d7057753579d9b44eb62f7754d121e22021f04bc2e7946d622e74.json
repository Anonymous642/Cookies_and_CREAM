{"manifest_version": 3, "name": "ChatGPT Background Changer", "version": "1.0.0", "description": "Set a custom background image on ChatGPT's web interface", "author": "Custom Extension", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "activeTab", "tabs"], "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "ChatGPT Background Changer"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "chatgpt-bg-changer@rooibos.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}