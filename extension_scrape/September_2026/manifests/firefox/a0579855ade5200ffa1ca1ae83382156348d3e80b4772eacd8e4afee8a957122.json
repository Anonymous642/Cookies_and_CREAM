{"manifest_version": 2, "name": "TorBox Handler", "version": "1.0", "description": "Automatically open and upload .torrent files to TorBox.app", "browser_specific_settings": {"gecko": {"id": "torbox-handler@example.com", "strict_min_version": "58.0"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["webRequest", "webRequestBlocking", "downloads", "downloads.open", "storage", "tabs", "notifications", "*://torbox.app/*", "*://api.torbox.app/*", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://torbox.app/*"], "js": ["content-scripts/torbox-uploader.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "browser_style": true}}