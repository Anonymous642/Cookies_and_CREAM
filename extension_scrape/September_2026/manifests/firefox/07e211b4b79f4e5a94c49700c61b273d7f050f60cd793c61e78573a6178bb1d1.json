{"manifest_version": 3, "name": "HuddleWatch Connector", "version": "3.0.54", "description": "Connect ESPN, Yahoo and Sleeper to HuddleWatch: draft rooms, lineups, waiver claims and AutoSwap for a starter ruled out.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["alarms", "cookies", "scripting", "storage"], "host_permissions": ["https://*.espn.com/*", "https://yahoo.com/*", "https://football.fantasysports.yahoo.com/*", "https://pub-api.fantasysports.yahoo.com/*", "https://pub-api-ro.fantasysports.yahoo.com/*", "https://sleeper.com/*", "https://api.sleeper.app/*", "https://huddlewatch.com/*", "https://huddlewatch.pages.dev/*"], "background": {"scripts": ["autoswap-core.js", "background.js"]}, "content_scripts": [{"matches": ["https://sleeper.com/*"], "js": ["sleeper-action-core.js", "sleeper-league-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://sleeper.com/*"], "js": ["sleeper-league.js"], "run_at": "document_start"}, {"matches": ["https://huddlewatch.com/*", "https://huddlewatch.pages.dev/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["https://fantasy.espn.com/football/draft*"], "js": ["espn-draft.js"], "run_at": "document_idle"}, {"matches": ["https://football.fantasysports.yahoo.com/*"], "js": ["yahoo-league.js", "yahoo-projections.js"], "run_at": "document_idle"}, {"matches": ["https://football.fantasysports.yahoo.com/draftclient/*"], "js": ["yahoo-draft-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://football.fantasysports.yahoo.com/draftclient/*"], "js": ["yahoo-draft.js"], "run_at": "document_start"}, {"matches": ["https://sleeper.com/*"], "js": ["sleeper-draft-hook.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://sleeper.com/*"], "js": ["sleeper-draft.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "HuddleWatch Connect