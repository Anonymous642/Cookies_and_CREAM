{"manifest_version": 2, "name": "Inkognito-Ingrid", "version": "1.0.1", "description": "Ingrid \u00f6ppnar Aftonbladet, Svenska Dagbladet, Omni och tv.nu automatiskt i ett privat Firefox-f\u00f6nster. Till\u00e4gget samlar inte in, lagrar inte eller skickar n\u00e5gon anv\u00e4ndardata. All logik k\u00f6rs lokalt i webbl\u00e4saren.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "webNavigation", "https://aftonbladet.se/*", "https://www.aftonbladet.se/*", "http://aftonbladet.se/*", "http://www.aftonbladet.se/*", "https://svd.se/*", "https://www.svd.se/*", "http://svd.se/*", "http://www.svd.se/*", "https://omni.se/*", "https://www.omni.se/*", "http://omni.se/*", "http://www.omni.se/*", "https://tv.nu/*", "https://www.tv.nu/*", "http://tv.nu/*", "http://www.tv.nu/*"], "background": {"scripts": ["background.js"]}, "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "inkognito-ingrid@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}