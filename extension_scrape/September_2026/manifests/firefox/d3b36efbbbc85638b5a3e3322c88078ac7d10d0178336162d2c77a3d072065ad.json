{"manifest_version": 2, "name": "Redirect Finder", "version": "1.0.0", "description": "Detects open redirect parameters in URLs and network requests. Shows popup alerts, badge counter, and maintains a persistent session log.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Redirect Finder"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "devtools_page": "devtools.html", "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "activeTab", "*://*/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "redirect-finder-baha@baha.security", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}