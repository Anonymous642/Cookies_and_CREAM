{"manifest_version": 3, "name": "UpTrack", "version": "1.0.0", "description": "Tracks reviewed Upwork job listings and hides them on future searches so you only see fresh listings.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.upwork.com/*", "https://jjcommonservices.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.upwork.com/nx/search/jobs*", "https://www.upwork.com/search/jobs*", "https://www.upwork.com/nx/find-work/*", "https://www.upwork.com/jobs/*", "https://www.upwork.com/freelance-jobs/apply/*"], "js": ["db/db.js", "content/search.js", "content/detail.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "uptrack@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}