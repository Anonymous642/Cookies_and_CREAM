{"manifest_version": 3, "name": "Vera - your study partner", "version": "1.5.1", "description": "Think out loud about your coursework. A small Vera window you can drag anywhere on the page.", "action": {"default_title": "Open Vera", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage"], "web_accessible_resources": [{"resources": ["icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "study@talktovera.ai", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}