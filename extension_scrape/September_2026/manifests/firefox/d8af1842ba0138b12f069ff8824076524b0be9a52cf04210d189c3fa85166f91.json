{"manifest_version": 2, "name": "ReadLater", "version": "1.2", "browser_specific_settings": {"gecko": {"id": "@readlater.harajuko"}}, "description": "Send current page to ReadLater", "permissions": ["contextMenus", "tabs", "storage", "notifications", "activeTab", "bookmarks"], "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"48": "icons/icon-grey.png"}, "browser_action": {"default_icon": "icons/icon-grey.png", "default_title": "Readlater"}, "options_ui": {"page": "options.html", "open_in_tab": true}}