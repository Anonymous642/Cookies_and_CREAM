{"manifest_version": 2, "name": "Form Auto-Encrypt", "version": "1.3", "description": "Automatically encrypts sensitive form inputs before submission to enhance data privacy.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Form Auto-Encrypt", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Form-Auto-Encrypt", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}