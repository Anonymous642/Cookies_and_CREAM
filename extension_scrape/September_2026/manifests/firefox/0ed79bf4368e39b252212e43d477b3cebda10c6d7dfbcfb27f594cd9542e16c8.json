{"manifest_version": 3, "name": "Speeder \u2014 Video Speed Controller", "version": "1.0.1", "description": "Control playback speed (0.25x\u20134x) on any site: YouTube, Netflix, Prime Video and more.", "action": {"default_popup": "popup.html", "default_title": "Speeder"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"increase-speed": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Increase speed by 0.1"}, "decrease-speed": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Decrease speed by 0.1"}, "reset-speed": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Reset speed to 1x"}}, "browser_specific_settings": {"gecko": {"id": "{7f22eb6d-1882-47aa-ac99-0050edc4c9b9}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}