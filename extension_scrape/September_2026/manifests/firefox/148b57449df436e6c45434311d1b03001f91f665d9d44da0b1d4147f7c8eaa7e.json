{"manifest_version": 3, "name": "CSV Reader", "version": "2.0.0", "description": "Skip the download: CSV Reader turns raw .csv pages into a clean, readable table right in your browser tab", "homepage_url": "https://github.com/rubenvar/csv-reader", "author": "Rub\u00e9n Vara", "browser_specific_settings": {"gecko": {"id": "hey@rubenvara.io", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/csv-16.png", "32": "icons/csv-32.png", "48": "icons/csv-48.png", "64": "icons/csv-64.png", "96": "icons/csv-96.png", "128": "icons/csv-128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/csv-16.png", "32": "icons/csv-32.png", "64": "icons/csv-64.png"}, "default_popup": "popup.html", "default_title": "CSV Reader", "theme_icons": [{"dark": "icons/csv-16.png", "light": "icons/csv-light-16.png", "size": 16}, {"dark": "icons/csv-32.png", "light": "icons/csv-light-32.png", "size": 32}]}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*", "*://*/*.csv"]}