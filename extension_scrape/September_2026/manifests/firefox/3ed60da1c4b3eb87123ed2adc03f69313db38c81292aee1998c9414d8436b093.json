{"manifest_version": 3, "name": "Canvas Quiz Fetch", "short_name": "QuizFetch", "version": "2026.9.20", "description": "Automatically capture and organize Canvas LMS quiz questions for easy review and study.", "homepage_url": "https://quiz-fetch.vercel.app/privacy", "browser_specific_settings": {"gecko": {"id": "quizfetch@wehyn.github.io", "strict_min_version": "109.0"}}, "background": {"scripts": ["src/background.js"]}, "permissions": ["activeTab", "storage", "contextMenus", "cookies"], "host_permissions": ["https://*.instructure.com/*", "https://*.edu/*", "https://*.supabase.co/*", "https://quiz-fetch.vercel.app/*"], "content_scripts": [{"matches": ["*://*.instructure.com/courses/*/quizzes/*/take*", "*://*.instructure.com/courses/*/quizzes/*", "*://*.instructure.com/courses/*/*", "*://*.edu/courses/*/quizzes/*/take*"], "js": ["browser-polyfill.min.js", "src/content/config.js", "src/content/themes.js", "src/content/storage.js", "src/content/db.js", "src/content/question-fingerprint.js", "src/content/answer-state.js", "src/content/course-context.js", "src/content/sync.js", "src/content/index.js"], "css": ["src/content/index.css"]}], "web_accessible_resources": [{"resources": ["src/content/index.js"], "matches": ["*://*.instructure.com/*", "*://*.edu/*"]}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "src/popup/index.html", "default_title": "QuizFetch"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}