{"manifest_version": 2, "name": "Boring YouTube", "version": "2.0.0", "description": "A lightweight browser extension that turns YouTube thumbnails grayscale \u2014 inspired by Arc's Boring YouTube Boost.", "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "{c75c1b77-f5a8-4c67-95a0-29cb86a9d39f}"}}, "permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Toggle Boring YouTube", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content-script.js"], "css": ["styles.css"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "author": "Delacrix Morgan", "homepage_url": "https://github.com/delacrixmorgan/BoringYouTube"}