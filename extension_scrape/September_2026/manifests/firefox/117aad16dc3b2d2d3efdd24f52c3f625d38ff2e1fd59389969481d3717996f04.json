{"manifest_version": 3, "name": "Context Recovery Tool", "version": "1.3", "description": "Captures browsing context and restores workflows after interruptions.", "permissions": ["tabs", "storage", "sessions", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["recoveryEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "action": {"default_popup": "popup.html", "default_title": "Context Recovery Tool"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Context-Recovery-Tool", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}