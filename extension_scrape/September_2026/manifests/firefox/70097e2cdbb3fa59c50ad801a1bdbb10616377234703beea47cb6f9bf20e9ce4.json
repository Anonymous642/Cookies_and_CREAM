{"manifest_version": 3, "name": "TabMold - Tab Exporter", "version": "1.4.3", "description": "Export current window tabs into a beautiful HTML bookmark page with multi-format copying.", "permissions": ["tabs", "tabGroups", "contextMenus", "clipboardWrite", "notifications", "scripting", "activeTab", "downloads"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_locale": "zh_CN", "browser_specific_settings": {"gecko": {"id": "tabmold-exporter@yourdomain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}