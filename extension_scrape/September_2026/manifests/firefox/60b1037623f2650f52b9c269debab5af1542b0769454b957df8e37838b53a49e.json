{"manifest_version": 3, "name": "Stats for Spotify Compact", "version": "1.0.0", "description": "Compact view for statsforspotify.com/track/recent - removes album art for dense screenshots", "author": "Reppard (reppardwalkermusic.com)", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.statsforspotify.com/*"], "browser_specific_settings": {"gecko": {"id": "stats-for-spotify-compact@reppard", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Stats for Spotify Compact"}, "content_scripts": [{"matches": ["https://www.statsforspotify.com/track/recent*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}