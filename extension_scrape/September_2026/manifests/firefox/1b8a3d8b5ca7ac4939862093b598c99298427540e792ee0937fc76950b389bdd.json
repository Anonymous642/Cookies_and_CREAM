{"manifest_version": 3, "name": "Dopamine Redirect", "short_name": "Dopamine Redirect", "description": "Interrupt distracting sites with a calm reset prompt and a smaller next step.", "version": "1.0.0", "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Dopamine Redirect", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "dopamine-redirect@example.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}