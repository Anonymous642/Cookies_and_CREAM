{"manifest_version": 3, "name": "X Snap Scroller", "version": "1.4", "description": "Snap perfectly to the next post on X using arrow keys.", "icons": {"32": "icon-32.png", "128": "icon-128.png"}, "action": {"default_title": "X Snap Scroller", "default_icon": {"32": "icon-32.png", "128": "icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "x-snap-scroller@your-handle", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"]}]}