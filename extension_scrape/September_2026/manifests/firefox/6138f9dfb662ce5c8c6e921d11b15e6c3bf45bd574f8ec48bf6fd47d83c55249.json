{"manifest_version": 3, "name": "Tab Space", "version": "1.4.0", "description": "Save, organize, and restore tabs with the Tab Space app.", "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://app.mytab.space/*", "http://127.0.0.1/*"], "action": {"default_title": "Tab Space", "default_popup": "popup.html", "default_icon": {"16": "toolbar-16.png", "32": "toolbar-32.png", "48": "toolbar-48.png", "128": "toolbar-128.png"}, "theme_icons": [{"size": 16, "dark": "toolbar-16.png", "light": "toolbar-light-16.png"}, {"size": 32, "dark": "toolbar-32.png", "light": "toolbar-light-32.png"}]}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["https://app.mytab.space/*"], "js": ["content-script.js"], "run_at": "document_start"}], "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save the current tab"}, "open-tab-space": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Open Tab Space"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@mytab.space", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}