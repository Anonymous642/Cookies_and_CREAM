{"manifest_version": 3, "name": "NeoRad Link QR Extension", "version": "1.1.1", "description": "Customizable QR generator for NeoRad/PACS viewer links. Set your public/local URLs in settings.", "author": "Sanrad Infotech", "background": {"scripts": ["background.js"]}, "action": {"default_title": "NeoRad Link QR (Click for QR, right-click for Settings)", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["interceptor.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}], "options_page": "options.html", "permissions": ["clipboardRead", "clipboardWrite", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["popup.html", "popup.js", "qrcode.min.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "neorad-link-qr@sanrad.net", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}