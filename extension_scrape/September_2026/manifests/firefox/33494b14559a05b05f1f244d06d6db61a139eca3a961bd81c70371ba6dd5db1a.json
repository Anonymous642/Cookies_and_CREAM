{"name": "Cobrowse by Zoho Assist", "description": "A Firefox extension for cobrowsing", "version": "1.0.3", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "cobrowsefirefox@zohoassist.com", "data_collection_permissions": {"required": ["locationInfo", "websiteContent"]}}}, "action": {"default_popup": "html/index.html", "default_icon": "icons/default_icon.png"}, "background": {"scripts": ["js/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-extension.js"], "css": ["css/puvi-font.css"], "run_at": "document_start"}], "permissions": ["tabs", "storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"]}