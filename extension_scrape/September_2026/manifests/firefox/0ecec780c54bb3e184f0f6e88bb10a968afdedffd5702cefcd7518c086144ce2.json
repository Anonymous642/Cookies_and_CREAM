{"manifest_version": 2, "name": "Octohide", "description": "Hide GitHub workflows from the Actions sidebar. Great for keeping reusable/template workflows out of the way.", "version": "0.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "https://github.com/*", "https://raw.githubusercontent.com/*", "https://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "octohide@the-rogue.agency", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content-scripts/github.js"]}]}