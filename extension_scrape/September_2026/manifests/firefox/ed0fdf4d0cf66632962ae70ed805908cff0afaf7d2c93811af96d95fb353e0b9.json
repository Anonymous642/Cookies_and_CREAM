{"manifest_version": 2, "name": "osu! BeatConnect mirror download", "description": "Adds a 'Download via Mirror' button next to osu!'s own Download button on beatmap pages, pulling the file from the BeatConnect mirror.", "version": "1.0.0", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "osu-mirror-download-firefox@example.local", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["https://osu.ppy.sh/beatmapsets/*"], "js": ["mirrors.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "osu! mirror download"}}