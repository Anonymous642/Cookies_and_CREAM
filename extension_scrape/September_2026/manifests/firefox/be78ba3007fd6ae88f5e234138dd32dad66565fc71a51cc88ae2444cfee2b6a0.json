{"manifest_version": 2, "name": "Tildes Unread", "version": "0.1", "description": "Adds the ability to mark topics as read, and limit front page/groups to only show unread topics", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "tildes-unread@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://tildes.net/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}]}