{"manifest_version": 2, "name": "Abstract-to-Concrete Converter", "version": "1.3", "description": "Transforms abstract concepts on web pages into concrete examples and practical interpretations.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_title": "Abstract-to-Concrete Converter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Abstract-To-Concrete-Converter", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}