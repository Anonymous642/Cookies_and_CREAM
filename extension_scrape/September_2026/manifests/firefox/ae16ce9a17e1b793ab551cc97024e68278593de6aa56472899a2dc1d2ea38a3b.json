{"manifest_version": 3, "name": "CleanMyX \u2013 X Post Remover", "version": "1.0.0", "description": "Remove your own X posts and reposts in bulk with a controlled, local browser workflow.", "action": {"default_title": "CleanMyX \u2013 X Post Remover", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "browser_specific_settings": {"gecko": {"id": "cleanmyx@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}