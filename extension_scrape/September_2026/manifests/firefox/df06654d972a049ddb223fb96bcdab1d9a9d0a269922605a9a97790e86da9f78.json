{"manifest_version": 3, "name": "Star Citizen Adventurer Companion", "short_name": "SC Companion", "version": "1.1.0", "description": "Displays a nicely sorted view of your hangar items (all kinds), get in-game items information and build CCU chains with AI.", "permissions": ["cookies", "storage", "alarms"], "host_permissions": ["https://robertsspaceindustries.com/*", "https://schangar.web3c.cc/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://schangar.web3c.cc/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "SC Adventurer Companion", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "sc-hangar-sync@schangar.web3c.cc", "data_collection_permissions": {"required": ["websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}