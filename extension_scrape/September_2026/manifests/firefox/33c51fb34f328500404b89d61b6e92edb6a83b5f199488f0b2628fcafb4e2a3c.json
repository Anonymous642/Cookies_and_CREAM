{"manifest_version": 2, "name": "Kagi Translate", "description": "Use Kagi Translate within your browser", "version": "0.1.10", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "contextMenus", "cookies", "scripting", "notifications", "webNavigation", "https://*/*", "http://*/*", "*://*/*"], "web_accessible_resources": ["roundcube-global-probe.js", "assets/lufga.css", "assets/fonts/*.woff", "content-scripts/content-features.css", "content-scripts/media-custom-features.css", "content-scripts/media-site-features.css", "content-scripts/selection-features.css", "content-scripts/site-features.css"], "default_locale": "en", "commands": {"translate_page": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Translate the entire page"}, "translate_selection": {"suggested_key": {"default": "Alt+T", "mac": "Alt+T"}, "description": "Translate selected text"}, "define_selection": {"suggested_key": {"default": "Alt+D", "mac": "Alt+D"}, "description": "Define selected text"}, "proofread_selection": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Proofread selected text"}, "read_aloud": {"description": "Read the selection (or the page) aloud / play-pause"}}, "browser_specific_settings": {"gecko": {"id": "{bd6be57d-91d7-41d2-b61d-3ba20f7942e5}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Kagi Translate", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "all_frames": true, "js": ["content-scripts/content.js"]}, {"matches": ["*://www.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-player-bridge.js"], "world": "MAIN"}]}