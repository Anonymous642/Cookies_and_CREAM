{"manifest_version": 2, "name": "PapiFlix", "version": "1.0.0", "description": "Carrega automaticamente o video mais recente do canal Odysee @mandiocaa por cima do player da Kick.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["https://api.na-backend.odysee.com/*", "https://odysee.com/*", "https://kick.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_security_policy": "script-src 'self'; object-src 'self'; frame-src https://odysee.com;", "web_accessible_resources": ["player.html", "player.js"], "content_scripts": [{"matches": ["https://kick.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "papiflix@local.firefox", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}