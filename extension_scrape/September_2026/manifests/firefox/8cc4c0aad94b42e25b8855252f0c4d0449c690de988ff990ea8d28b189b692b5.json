{"manifest_version": 3, "name": "udemy-show-release-date", "description": "A browser extension to show the release date of Udemy courses", "version": "1.0.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "udemy-show-release-date@InvictusNavarchus", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "action": {"default_title": "Udemy Show Release Date", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.udemy.com/course/*"], "js": ["content-scripts/course-date.js"]}]}