{"manifest_version": 2, "name": "Google Meet Attendance Tracker", "version": "1.0", "description": "Records Google Meet attendance and detects camera status.", "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "meet-attendance@example.com"}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html"}}