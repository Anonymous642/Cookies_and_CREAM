{"name": "WebState", "version": "1.0.2", "description": "A tool to view html statistics", "manifest_version": 2, "permissions": ["activeTab", "scripting"], "browser_action": {"default_icon": "logo.png", "default_title": "Page Modifier", "default_popup": "popup.html"}, "web_accessible_resources": ["images/*"], "browser_specific_settings": {"gecko": {"id": "ff-ext-webstats@hereket.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}