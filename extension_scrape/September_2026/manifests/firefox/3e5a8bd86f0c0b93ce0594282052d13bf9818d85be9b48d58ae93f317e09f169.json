{"manifest_version": 3, "name": "The Wall", "version": "1.0.0", "description": "A minimalist distraction blocker that immediately replaces blocked websites and URL patterns with a clean black screen.", "browser_specific_settings": {"gecko": {"id": "the-wall@productivity.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "webNavigation", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["matcher.js", "background.js"]}, "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "The Wall"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}