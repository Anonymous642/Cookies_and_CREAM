{"manifest_version": 2, "name": "Kordelo Time Tracker", "version": "1.0.1", "description": "Track time with Kordelo directly from your browser", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs", "https://kordelo.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["https://kordelo.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "numen-time-tracker@numen.no", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}