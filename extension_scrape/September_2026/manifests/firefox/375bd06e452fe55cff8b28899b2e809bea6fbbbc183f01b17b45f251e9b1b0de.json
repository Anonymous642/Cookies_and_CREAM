{"manifest_version": 2, "name": "RTL Enabler", "version": "1.0.0", "description": "Enable right-to-left (RTL) text direction for entire pages or selected sections on any website.", "author": "RTL Enabler Contributors", "homepage_url": "https://github.com/oeiv/rtl-enabler", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "RTL Enabler", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "tabs"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "rtl-enabler@firefox-extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}