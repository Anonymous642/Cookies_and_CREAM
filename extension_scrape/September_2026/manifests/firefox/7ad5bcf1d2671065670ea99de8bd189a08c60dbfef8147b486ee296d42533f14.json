{"manifest_version": 3, "name": "Package Tracker - track parcel anywhere", "version": "1.0.0", "description": "Track Amazon, AliExpress, SHEIN & 500+ carriers. Simple one-click parcel tracking.", "author": "Dmytro Ye", "homepage_url": "https://packagetrack.online", "permissions": ["storage", "alarms"], "web_accessible_resources": [{"resources": ["callback.html"], "matches": ["https://packagetrack.online/*", "https://www.packagetrack.online/*"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "92": "icons/icon92.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "92": "icons/icon92.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "package-tracker@packagetrack.online", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo", "searchTerms"]}}}}