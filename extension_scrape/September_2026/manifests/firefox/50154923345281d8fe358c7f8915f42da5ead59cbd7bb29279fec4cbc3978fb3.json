{"manifest_version": 2, "name": "My Tab Notes", "version": "6.5", "description": "With this add-on, you can add notes to any tab you want.", "homepage_url": "http://www.inframe.ro", "browser_specific_settings": {"gecko": {"id": "mytabnotes@inframe.ro", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "assets/logo_32.png", "48": "assets/logo_48.png", "64": "assets/logo_64.png", "128": "assets/logo_128.png"}, "browser_action": {"default_icon": "assets/logo_32.png", "default_title": "My Tab Notes"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "tabs", "activeTab", "contextMenus"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/badge.js"], "run_at": "document_end"}], "web_accessible_resources": ["assets/background.jpg", "assets/background2.jpg"]}