{"manifest_version": 3, "name": "First 7-Digit Text Copier", "version": "1.1", "description": "Copies the first 7-digit number found on the webpage text.", "permissions": ["activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Copy first 7-digit number from page"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "first-7digit-copier@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}}