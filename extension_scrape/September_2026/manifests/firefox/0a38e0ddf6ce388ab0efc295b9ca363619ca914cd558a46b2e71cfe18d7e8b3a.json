{"manifest_version": 3, "name": "G\u00e9nIA", "description": "Votre assistant IA pour automatiser LinkedIn, les e-mails et le web.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "scripting", "storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "app@genia-ai.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://*.linkedin.com/*", "*://mail.google.com/*", "*://outlook.live.com/*", "*://outlook.office.com/*", "*://outlook.office365.com/*"], "web_accessible_resources": [{"resources": ["linkedin-bridge.js"], "matches": ["*://*.linkedin.com/*"]}], "externally_connectable": {"matches": ["*://genia-demo-tau.vercel.app/*", "*://localhost/*"]}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "GenIA", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*", "*://*/*", "*://mail.google.com/*", "*://outlook.live.com/*", "*://outlook.office.com/*", "*://outlook.office365.com/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://genia-demo-tau.vercel.app/*", "http://localhost/*"], "js": ["content-scripts/session.js"]}]}