{"manifest_version": 2, "name": "Kibana Clicker", "description": "Automation tool for Kibana", "version": "100.0.8", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "<all_urls>"], "autoIcons": {"baseIconPath": "assets/icon.png"}, "browser_specific_settings": {"gecko": {"id": "kibana-clicker@hyzyla.dev"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Kibana Clicker Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}