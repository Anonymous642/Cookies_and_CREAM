{"manifest_version": 2, "name": "The Meow! Domain Blocker", "version": "1.0", "description": "A ultra-simple tool to block domains that you don't want to load, and instead writes 'Meow!' to help you think of better things to do ;)", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@meow-domain-blocker", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "web_accessible_resources": ["blocked.html"]}