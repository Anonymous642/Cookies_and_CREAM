{"manifest_version": 2, "name": "Biqli Link Manager", "version": "4.0.2", "description": "Create, manage, and track short links and QR codes from your browser.", "permissions": ["storage", "activeTab", "identity", "https://biq.li/api/v1/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "biqli-addon-firefox@biq.li", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "locationInfo"], "optional": ["technicalAndInteraction"]}}}}