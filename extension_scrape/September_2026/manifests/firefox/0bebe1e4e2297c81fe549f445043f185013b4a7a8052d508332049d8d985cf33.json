{"manifest_version": 2, "name": "Street View Tracker", "version": "1.4", "description": "Save coordinates from Google Street View.", "permissions": ["tabs", "storage", "https://www.google.com/*", "https://tiles.openfreemap.org/*"], "browser_action": {"default_title": "Mapper Visualiser", "default_icon": "icon.png", "default_popup": "popup.html"}, "icons": {"16": "icon.png"}, "applications": {"gecko": {"id": "streetview-tracker-public@example.com"}}, "web_accessible_resources": ["viewer.html", "viewer.js", "leaflet.*"], "content_scripts": [{"matches": ["*://*.google.com/*maps*"], "js": ["inject.js"]}]}