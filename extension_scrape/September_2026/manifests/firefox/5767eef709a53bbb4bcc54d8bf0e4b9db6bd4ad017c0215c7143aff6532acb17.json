{"manifest_version": 3, "name": "QuickBuy Pro", "version": "2.0.0", "description": "Auto checkout istantaneo su Amazon, Vinted, Subito e altri", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon48.png", "default_title": "QuickBuy Pro"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.it/*"], "js": ["core/injector.js", "sites/amazon.js"], "css": ["core/ui.css"], "run_at": "document_idle"}, {"matches": ["*://*.vinted.it/*"], "js": ["core/injector.js", "sites/vinted.js"], "css": ["core/ui.css"], "run_at": "document_idle"}, {"matches": ["*://*.subito.it/*"], "js": ["core/injector.js", "sites/subito.js"], "css": ["core/ui.css"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"], "host_permissions": ["*://*.amazon.it/*", "*://*.vinted.it/*", "*://*.subito.it/*"], "browser_specific_settings": {"gecko": {"id": "quickbuypro@alessandro.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}