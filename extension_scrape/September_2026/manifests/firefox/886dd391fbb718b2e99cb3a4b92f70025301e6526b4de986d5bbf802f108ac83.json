{"manifest_version": 3, "name": "Quick Troll Blocker", "version": "1.1.0", "description": "Block toxic commenters on Facebook with one click. Blocks are queued and run in the background so you can keep scrolling.", "browser_specific_settings": {"gecko": {"id": "quick-troll-blocker@fbqb", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking"], "optional_host_permissions": ["*://*.facebook.com/*"], "background": {"scripts": ["src/compat.js", "src/header-strip.firefox.js", "src/ua-desktop.firefox.js", "src/onboarding.firefox.js", "src/background.js"]}, "action": {"default_title": "Quick Troll Blocker", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["src/compat.js", "src/content.js"], "css": ["src/widget.css"], "run_at": "document_idle", "all_frames": true, "match_about_blank": false}]}