{"manifest_version": 3, "name": "MapJump: Maps Redirect", "version": "1.0.1", "description": "Seamlessly switch between Google Maps, TIM-online NRW, and Apple Maps Web with automatic coordinate and zoom transfer.", "host_permissions": ["*://*.google.com/maps/*", "*://*.google.de/maps/*", "*://*.tim-online.nrw.de/*", "*://*.apple.com/*", "*://beta.maps.apple.com/*", "*://maps.apple.com/*"], "content_scripts": [{"matches": ["*://*.google.com/maps/*", "*://*.google.de/maps/*", "*://*.tim-online.nrw.de/*", "*://*.apple.com/*", "*://beta.maps.apple.com/*", "*://maps.apple.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"32": "icon.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "mapjump@deinname.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}