{"manifest_version": 2, "name": "Ma'at Vision", "version": "1.3", "description": "Toggle a green-on-black terminal or white on blue theme for the web, as it was meant to be.", "browser_specific_settings": {"gecko": {"id": "maat-vision@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Toggle Mode", "default_icon": {"16": "icons/off.png", "32": "icons/off.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}