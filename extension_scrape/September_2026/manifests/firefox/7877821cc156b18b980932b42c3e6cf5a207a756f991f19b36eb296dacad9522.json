{"manifest_version": 3, "name": "Control Parental de Sitios Web", "version": "1.3", "description": "Una extensi\u00f3n para bloquear el acceso a sitios web para adultos.", "permissions": ["declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["blocklist.txt", "blocked.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "control-parental@TU-DOMINIO.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}