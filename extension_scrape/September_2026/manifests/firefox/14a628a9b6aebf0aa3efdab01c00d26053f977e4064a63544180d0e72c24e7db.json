{"name": "ClickToCall over HTTP", "description": "handle tel-protocol links to redirect them to a HTTP-Servlet. e.g. Yealink, Snom and others", "homepage_url": "https://github.com/netas-ch/ClickToCallOverHttpExtension", "version": "1.1", "manifest_version": 3, "action": {"default_icon": {"16": "icons/ico_light_16.png", "32": "icons/ico_light_32.png", "48": "icons/ico_light_48.png", "96": "icons/ico_light_96.png"}, "theme_icons": [{"dark": "icons/ico_light_32.png", "light": "icons/ico_dark_32.png", "size": 32}, {"dark": "icons/ico_light_16.png", "light": "icons/ico_dark_16.png", "size": 16}], "default_title": "Make a call"}, "icons": {"16": "icons/ico_light_16.png", "32": "icons/ico_light_32.png", "48": "icons/ico_light_48.png", "96": "icons/ico_light_96.png"}, "background": {"scripts": ["js/background.js"]}, "options_ui": {"page": "options.html"}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "ClickToCallOverHttp@netas.ch", "strict_min_version": "118.0"}}, "protocol_handlers": [{"protocol": "tel", "name": "ClickToCall over HTTP", "uriTemplate": "index.html?tel=%s"}]}