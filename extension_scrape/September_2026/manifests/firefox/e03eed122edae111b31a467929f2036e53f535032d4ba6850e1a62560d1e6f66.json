{"manifest_version": 3, "name": "SecureNetXZone Guard", "short_name": "SecureNetXZone Guard", "version": "1.1.0", "description": "Hl\u00edd\u00e1 str\u00e1nky, kter\u00e9 nav\u0161t\u00edv\u00edte, a upozorn\u00ed v\u00e1s, pokud jsou veden\u00e9 v datab\u00e1zi podvod\u016f SecureNetXZone.", "icons": {"16": "icons/icon-safe-16.png", "32": "icons/icon-safe-32.png", "48": "icons/icon-safe-48.png", "128": "icons/icon-safe-128.png"}, "action": {"default_icon": {"16": "icons/icon-safe-16.png", "32": "icons/icon-safe-32.png", "48": "icons/icon-safe-48.png", "128": "icons/icon-safe-128.png"}, "default_title": "SecureNetXZone Guard", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://*.snxz.cz/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "permissions": ["tabs", "storage", "notifications", "activeTab", "alarms"], "host_permissions": ["https://web.snxz.cz/*", "http://*/*", "https://*/*"], "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "snxz-guard@snxz.cz", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["browsingActivity", "personallyIdentifyingInfo", "authenticationInfo"]}}}}