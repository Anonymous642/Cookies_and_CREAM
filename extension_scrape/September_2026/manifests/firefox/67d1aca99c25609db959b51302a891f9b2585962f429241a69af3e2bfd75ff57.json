{"manifest_version": 3, "name": "My Custom HTTP Headers", "version": "1.0.2", "description": "Esta extens\u00e3o permite que desenvolvedores e modifiquem headers de requisi\u00e7\u00f5es HTTP de forma f\u00e1cil e segura. Organize seus headers em projetos e proteja informa\u00e7\u00f5es sens\u00edveis com criptografia baseada em senha. Nenhum dado do usu\u00e1rio \u00e9 coletado.", "homepage_url": "https://github.com/oliveiraxavier/my-custom-http-headers", "icons": {"48": "icons/48.png", "96": "icons/96.png"}, "permissions": ["activeTab", "storage", "webRequest", "webRequestBlocking", "webNavigation"], "optional_host_permissions": ["*://*/*", "<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-default.png", "96": "icons/icon-default.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "{1b1ec632-8ed8-11f1-96f9-5b81f388aa83}", "data_collection_permissions": {"required": ["none"]}}}}