{"manifest_version": 3, "name": "EPM (Ez Password Manager)", "version": "4.0.0", "description": "A lightweight and secure password manager with master password protection and end-to-end encryption", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab", "scripting"], "optional_host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_title": "Ez Password Manager", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": false}], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"}, "browser_specific_settings": {"gecko": {"id": "ez-password-manager@s0ulz.com", "data_collection_permissions": {"required": ["none"]}}}}