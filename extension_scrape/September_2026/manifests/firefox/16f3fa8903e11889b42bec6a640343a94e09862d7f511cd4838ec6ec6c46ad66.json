{"manifest_version": 3, "name": "Smart Session Starter", "version": "1.3", "description": "Analyzes previous browsing sessions and intelligently prepares optimized startup workflows.", "permissions": ["tabs", "storage", "sessions", "notifications", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["sessionEngine.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Smart Session Starter"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Smart-Session-Starter", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}