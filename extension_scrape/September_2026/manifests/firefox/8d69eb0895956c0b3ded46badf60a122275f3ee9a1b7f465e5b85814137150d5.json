{"manifest_version": 3, "name": "GrinBeam Image", "version": "1.0.7", "description": "GrinBeam Image ma osobny test dodatku bez otwierania Google oraz osobne wyszukiwanie obraz\u00f3w dla grinbeam.com z limitem przewijania.", "permissions": ["tabs", "storage"], "host_permissions": ["https://www.google.com/*", "https://www.google.pl/*", "https://images.google.com/*", "https://www.grinbeam.com/*", "https://grinbeam.com/*"], "background": {"service_worker": "background.js", "type": "module", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.grinbeam.com/*", "https://grinbeam.com/*"], "js": ["site-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.google.com/search*", "https://www.google.pl/search*", "https://images.google.com/*"], "js": ["google-images-reader.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "GrinBeam Image"}, "homepage_url": "https://www.grinbeam.com/", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "grinbeam-image@grinbeam.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "websiteContent", "browsingActivity"]}}}}