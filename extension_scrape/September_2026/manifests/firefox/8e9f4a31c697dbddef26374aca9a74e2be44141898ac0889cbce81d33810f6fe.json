{"manifest_version": 2, "name": "URL to QR & HTML", "version": "1.0", "description": "Convert the current URL into a QR code or HTML tag effortlessly with this extension", "homepage_url": "https://github.com/Joelmmm/aQRate.git", "icons": {"32": "icons/qr-32.png", "48": "icons/qr-48.png"}, "permissions": ["activeTab", "tabs", "storage"], "options_ui": {"page": "options.html", "open_in_tab": false}, "background": {"scripts": ["./background.js"]}, "browser_action": {"default_icon": "icons/qr-32.png", "default_title": "aQRate", "default_popup": "aQRate.html"}, "browser_specific_settings": {"gecko": {"id": "{12135312-c97e-4394-a047-2eee1fcaaeb7}"}}}