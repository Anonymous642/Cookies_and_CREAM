{"manifest_version": 2, "name": "PaperYoga", "version": "1.2", "description": "Browser extension to enhance Google Scholar with additional information about the search results.", "browser_action": {"default_title": "PaperYoga", "default_popup": "menu/menu.html", "default_icon": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "paperyoga@lezdu.it", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "icons": {"48": "icons/icon.png"}, "content_scripts": [{"matches": ["*://scholar.google.com/scholar?*"], "js": ["js/libraries/jquery_min.js", "js/utils.js", "js/scholar.js", "js/icore.js", "js/scopus.js", "js/view.js", "js/content.js"], "css": ["css/content.css"]}], "background": {"scripts": ["js/background.js"]}, "permissions": ["https://portal.core.edu.au/*", "https://api.elsevier.com/*", "storage", "scripting", "activeTab"], "web_accessible_resources": ["img/*", "icons/*", "html/*", "css/*", "js/*", "menu/*"]}