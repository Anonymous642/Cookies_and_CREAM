{"manifest_version": 3, "name": "Pasteover", "version": "1.0.0", "description": "Paste a screenshot, annotate it in seconds, and copy or save it locally.", "permissions": ["activeTab", "contextMenus"], "background": {"scripts": ["service-worker.js"]}, "action": {"default_title": "Open Pasteover Editor", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pasteover@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}