{"manifest_version": 2, "name": "Pyor Helper", "description": "Open GitHub pull-request links in Pyor instead of github.com: a faster home for code review.", "version": "0.2.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage", "declarativeNetRequest", "*://github.com/*"], "web_accessible_resources": ["installed.txt"], "browser_specific_settings": {"gecko": {"id": "pyor-helper@pyor.review", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Pyor Helper", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://github.com/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}