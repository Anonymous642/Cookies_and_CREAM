{"manifest_version": 2, "name": "MasterCP", "version": "1.0", "description": "Send competitive programming problems to CP Editor", "browser_specific_settings": {"gecko": {"id": "mastercp@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}, "default_title": "MasterCP - Send to CP Editor"}, "icons": {"48": "icon.png", "96": "icon.png"}, "content_scripts": [{"matches": ["*://codeforces.com/*", "*://*.codeforces.com/*", "*://atcoder.jp/*", "*://*.atcoder.jp/*", "*://codechef.com/*", "*://*.codechef.com/*", "*://leetcode.com/*", "*://*.leetcode.com/*", "*://hackerrank.com/*", "*://*.hackerrank.com/*", "*://spoj.com/*", "*://*.spoj.com/*", "*://cses.fi/*", "*://*.cses.fi/*"], "js": ["content.js"], "run_at": "document_idle"}]}