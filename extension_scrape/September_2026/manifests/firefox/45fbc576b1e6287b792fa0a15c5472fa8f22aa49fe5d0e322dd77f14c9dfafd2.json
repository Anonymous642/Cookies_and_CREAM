{"manifest_version": 2, "name": "VaultFox", "version": "2.0.0", "description": "Local password manager with auto-fill for Firefox", "author": "You", "browser_specific_settings": {"gecko": {"id": "vaultfox@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "tabs", "alarms", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "VaultFox", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_security_policy": "script-src 'self'; object-src 'self';"}