{"manifest_version": 3, "name": "AI Page Summarizer", "version": "1.1.1", "description": "Uses AI to summarize the current webpage, with streaming for real-time updates.", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"48": "icon/icon.svg", "128": "icon/icon.svg"}, "action": {"default_popup": "settings.html", "default_icon": "icon/icon.svg"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.js", "popup.css", "icon/icon.svg"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "ff-ai-page-summarizer@wxnderer.tech"}}}