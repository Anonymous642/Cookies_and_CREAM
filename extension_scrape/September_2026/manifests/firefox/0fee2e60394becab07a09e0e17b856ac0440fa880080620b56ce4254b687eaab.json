{"manifest_version": 3, "name": "Website Visibility Checker for AI", "version": "1.0.0", "description": "One-click audit of website AI visibility. Get a score (0-100) and top issues to fix.", "author": "EvoWeb.ai", "browser_specific_settings": {"gecko": {"id": "ai-visibility-checker@evoweb.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Check AI Visibility"}, "permissions": ["activeTab", "scripting"], "background": {"scripts": ["scripts/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content_script.js"], "run_at": "document_idle"}], "default_locale": "en"}