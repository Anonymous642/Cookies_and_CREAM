{"manifest_version": 3, "name": "RBSK Speed", "version": "3.2.1", "description": "RBSK Speed \u2014 Autofill for RBSK screening forms on the TeCHO Gujarat portal. Supports 1500 free trial forms with optional activation for continued use.", "browser_specific_settings": {"gecko": {"id": "rbskspeed@rbsk.extension", "strict_min_version": "109.0"}}, "action": {"default_title": "RBSK Speed", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["https://techo.gujarat.gov.in/*"], "web_accessible_resources": [{"resources": ["subscribe.html", "subscribe.js", "terms.html"], "matches": ["https://techo.gujarat.gov.in/*"]}], "content_scripts": [{"matches": ["https://techo.gujarat.gov.in/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}