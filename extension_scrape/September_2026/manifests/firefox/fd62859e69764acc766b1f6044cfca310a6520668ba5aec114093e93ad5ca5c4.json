{"manifest_version": 3, "name": "ShieldCloaked Media Protection", "version": "2.1.0", "homepage_url": "https://shieldcloaked.tech", "description": "ShieldCloaked Media Protection enhances your browsing experience by protecting from the harm of social engineering. It replaces nicknames and avatars on supported social media platforms.", "browser_specific_settings": {"gecko": {"id": "support@shieldcloaked.tech", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "host_permissions": ["*://*.steamcommunity.com/*", "*://*.shieldcloaked.tech/*", "*://*.quora.com/*", "*://*.youtube.com/*", "*://*.stackoverflow.com/*", "*://*.rutube.ru/*", "*://*.reddit.com/*"], "web_accessible_resources": [{"resources": ["icons/*.png", "options/consent.html", "options/options.html", "options/about.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/scmedia16.png", "32": "icons/scmedia32.png", "48": "icons/scmedia48.png", "128": "icons/scmedia128.png"}, "action": {"default_icon": "icons/scmedia32.png", "default_popup": "/options/options.html"}, "content_scripts": [{"matches": ["*://*.steamcommunity.com/*", "*://*.shieldcloaked.tech/*", "*://*.quora.com/*", "*://*.youtube.com/*", "*://*.stackoverflow.com/*", "*://*.rutube.ru/*", "*://*.reddit.com/*"], "js": ["main.js"], "run_at": "document_start"}], "options_page": "/options/options.html", "content_security_policy": {"extension_pages": "default-src 'self'; img-src 'self'; connect-src 'self' https://shieldcloaked.tech"}}