{"manifest_version": 2, "name": "Pluralmind - Plurality Plugin for Twitch Chat", "description": "Plurality support for Twitch Chat", "version": "2.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://pluralmind.chat/*"], "browser_specific_settings": {"gecko": {"id": "{f5313eba-0033-40a2-954a-2a851ebcf2ef}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Pluralmind", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}