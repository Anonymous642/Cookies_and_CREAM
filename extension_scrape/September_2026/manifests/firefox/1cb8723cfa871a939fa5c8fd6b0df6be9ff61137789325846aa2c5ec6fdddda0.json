{"manifest_version": 2, "name": "Nodie - Decentralized Node Network", "version": "1.0.0", "description": "Turn your browser into a network node. Earn rewards for sharing bandwidth and completing tasks.", "permissions": ["storage", "alarms", "activeTab", "tabs", "https://nodie.host/*", "https://*.emergentagent.com/*", "https://decnode.preview.emergentagent.com/*", "https://api.ipify.org/*", "https://api.my-ip.io/*", "https://httpbin.org/*", "https://www.google.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["icons/*"], "browser_specific_settings": {"gecko": {"id": "nodie@nodie.host", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}