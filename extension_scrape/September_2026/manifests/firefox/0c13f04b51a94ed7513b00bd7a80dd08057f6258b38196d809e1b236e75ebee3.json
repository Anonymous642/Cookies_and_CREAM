{"manifest_version": 3, "name": "TabTrail", "version": "0.1.0", "description": "External working memory for ADHD brains. Park context, capture intent, and resume in flow.", "author": "TabTrail", "homepage_url": "https://tabtrail.app", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["tabs", "tabGroups", "activeTab", "storage", "alarms", "notifications", "webNavigation", "scripting", "downloads"], "host_permissions": [], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_title": "TabTrail", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "commands": {"tabtrail-park-window": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Park tabs in the current window"}, "tabtrail-voice-capture": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open intent editor for latest parked session"}, "tabtrail-open-vault": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open search vault"}}, "options_page": "src/onboarding/index.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "sidebar_action": {"default_title": "TabTrail", "default_panel": "src/sidepanel/index.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "{a8cbc175-7407-47b8-b1d1-04c996080184}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}