{"manifest_version": 2, "name": "GalleryGrab", "version": "3.1.0", "description": "Finds the dominant image sequence on a gallery page and downloads all full-resolution images.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "downloads", "storage", "tabs", "<all_urls>"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open GalleryGrab"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/lib.js", "src/background.js", "src/background-core.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "gallerygrab@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}