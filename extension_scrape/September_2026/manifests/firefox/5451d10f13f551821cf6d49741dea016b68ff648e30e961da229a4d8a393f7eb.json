{"manifest_version": 2, "name": "SceneCue", "version": "3.0", "description": "Get notified about disturbing scenes in movies using community-verified timestamps.", "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "notifications", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "scenecue-ext@sohaib.dev", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "searchTerms"]}}}}