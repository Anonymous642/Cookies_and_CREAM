{"manifest_version": 3, "name": "SingAlong Overlay", "description": "Displays real-time, synchronized lyrics in a customizable floating window over any music or video platform.", "version": "1.0.0", "author": "SonicLayer Studio", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.spotify.com/*", "https://*.youtube.com/*", "https://*.music.apple.com/*", "https://*.soundcloud.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "singalongoverlay@soniclayerstudio.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}