{"manifest_version": 2, "name": "Multi-account Manager", "version": "1.3", "description": "Manage, store, and switch between multiple online accounts easily. This extension helps users isolate sessions, control cookies, and improve productivity without using multiple browsers.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["cookies", "tabs", "storage", "<all_urls>"], "browser_action": {"default_title": "Multi-account Manager", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "@DMulti-Account-Manager", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}