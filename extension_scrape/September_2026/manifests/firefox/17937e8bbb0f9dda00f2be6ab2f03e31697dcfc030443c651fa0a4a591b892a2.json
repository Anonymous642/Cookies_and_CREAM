{"manifest_version": 3, "name": "Outlook: Local Attachments Only", "version": "1.1.0", "description": "Routes Outlook on the web file drops to normal attachments instead of OneDrive.", "developer": {"name": "Eddie"}, "browser_specific_settings": {"gecko": {"id": "outlook-local-attachments-only@joe.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "host_permissions": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.cloud.microsoft/*"], "content_scripts": [{"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.cloud.microsoft/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}]}