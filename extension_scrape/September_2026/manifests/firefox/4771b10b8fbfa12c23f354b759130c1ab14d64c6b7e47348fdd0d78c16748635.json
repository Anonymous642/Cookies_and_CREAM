{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "timeguard@emiryilmaz.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "name": "TimeGuard", "version": "1.0.0", "description": "A sleek and modern time manager that measures your time spent on websites and blocks them when daily limits are exceeded.", "permissions": ["tabs", "storage", "alarms", "idle"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}