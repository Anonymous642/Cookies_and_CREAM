{"manifest_version": 3, "name": "VibeGrow", "version": "1.3.5", "description": "Connect your signed-in Firefox to VibeGrow so your AI marketing agent can work in the tools you already use.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "scripting", "storage", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["hosted_transport.js", "service_worker.js"]}, "action": {"default_title": "VibeGrow", "default_popup": "options.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://app.vibegrow.io/*"], "js": ["firefox_app_bridge.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "my-browser@vibegrow.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteActivity", "websiteContent", "personallyIdentifyingInfo", "personalCommunications", "financialAndPaymentInfo", "healthInfo", "locationInfo", "searchTerms"]}}}}