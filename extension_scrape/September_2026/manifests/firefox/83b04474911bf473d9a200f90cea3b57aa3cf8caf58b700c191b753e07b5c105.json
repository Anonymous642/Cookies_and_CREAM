{"manifest_version": 3, "name": "Polymarket Simulator", "short_name": "PM Simulator", "version": "0.1.0", "description": "Educational practice tool for Polymarket that uses virtual play money only. No wallet, no deposits, no real funds, no rewards.", "permissions": ["storage"], "host_permissions": ["https://polymarket.com/*", "https://gamma-api.polymarket.com/*", "https://clob.polymarket.com/*"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Polymarket Simulator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://polymarket.com/*"], "js": ["src/content/loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/*.js", "src/content/ui/*.js", "src/core/*.js", "vendor/*.js", "styles/*.css", "fonts/*.woff2", "assets/*.png"], "matches": ["https://polymarket.com/*"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "polymarket-simulator@steveramos", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}