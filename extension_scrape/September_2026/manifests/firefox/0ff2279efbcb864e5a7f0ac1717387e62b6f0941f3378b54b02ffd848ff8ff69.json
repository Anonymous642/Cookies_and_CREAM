{"manifest_version": 3, "name": "SAM.gov to SuiteCRM", "version": "1.0.3", "description": "Extracts SAM.gov contract opportunity data and creates matching Accounts, Contacts, Opportunities and Notes in your SuiteCRM instance.", "browser_specific_settings": {"gecko": {"id": "sam2suitecrm@hwdomain.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "SAM.gov to SuiteCRM - open on this page"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://sam.gov/*", "https://*.sam.gov/*"], "js": ["content.js"], "run_at": "document_idle"}]}