{"manifest_version": 2, "name": "Twitter/X Web3 & AI Noise Filter", "version": "1.0.0", "description": "Filtra spam de Web3, NFT, crypto, inteligencia artificial y derivados en Twitter/X.", "browser_specific_settings": {"gecko": {"id": "twitter-web3-filter@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*", "*://mobile.twitter.com/*", "*://mobile.x.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}