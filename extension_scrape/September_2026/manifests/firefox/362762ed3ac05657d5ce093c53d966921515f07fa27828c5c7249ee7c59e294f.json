{"manifest_version": 2, "name": "Reddxxx Scraper de M\u00eddia", "version": "1.2.4", "description": "Localiza fotos e v\u00eddeos na p\u00e1gina Reddxxx e baixa tudo numa pasta criada automaticamente (ex.: nome do perfil u/username).", "browser_specific_settings": {"gecko": {"id": "reddxxx-media-scraper@xup.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["downloads", "tabs", "activeTab", "<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_title": "Reddxxx \u2014 Baixar fotos e v\u00eddeos desta p\u00e1gina", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://reddxxx.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}