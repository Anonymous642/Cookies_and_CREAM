{"manifest_version": 2, "name": "Image Compare Splitter", "version": "1.0", "description": "Select two images on a page and create a draggable before/after splitter to compare them.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Image Compare", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "imgcompare@example.com"}}}