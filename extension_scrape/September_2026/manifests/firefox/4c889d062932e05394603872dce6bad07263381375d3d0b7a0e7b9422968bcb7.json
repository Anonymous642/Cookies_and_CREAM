{"manifest_version": 3, "name": "Right-Click Quick Searcher", "version": "1.1", "description": "Highlight text and right-click to search across your favorite or custom search engines instantly.", "permissions": ["contextMenus", "storage"], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "right-click-quick-searcher@chamod.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "all_frames": true}]}