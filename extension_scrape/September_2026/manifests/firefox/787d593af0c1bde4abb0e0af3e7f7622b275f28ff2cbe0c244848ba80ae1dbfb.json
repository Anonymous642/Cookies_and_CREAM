{"manifest_version": 2, "name": "Semble", "description": "Save pages to your Semble library, organize them into collections, and create typed connections between them.", "version": "1.0.4", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "storage", "contextMenus", "notifications", "https://api.semble.so/*"], "browser_specific_settings": {"gecko": {"id": "semble@semble.so", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Semble", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Semble"}}