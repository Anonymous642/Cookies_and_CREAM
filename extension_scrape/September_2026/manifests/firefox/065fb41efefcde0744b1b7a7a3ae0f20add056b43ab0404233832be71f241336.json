{"manifest_version": 3, "name": "Timebased", "version": "5.5", "description": "Blocks sites unless allowed, applies time limits, allows wildcard URL bypassing. Caches config for 5 minutes.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg"}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "universal-timeblocker@jorissoris.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}