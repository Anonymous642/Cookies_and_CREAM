{"manifest_version": 2, "name": "Research Watchdog for Zotero", "version": "0.3.0", "description": "Monitors scholarly sources on demand and adds matches into Zotero with deduplication and OA PDF detection.", "browser_action": {"default_title": "Research Watchdog for Zotero", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js", "source-apis.js", "zotero-helpers.js"], "persistent": false}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": true}, "permissions": ["storage", "notifications", "tabs", "https://api.zotero.org/*", "https://api.crossref.org/*", "https://api.openalex.org/*", "https://www.ebi.ac.uk/*", "https://api.semanticscholar.org/*", "http://export.arxiv.org/*", "https://api.unpaywall.org/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "research-watchdog-for-zotero@addon.mozilla.org", "strict_min_version": "78.0"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}