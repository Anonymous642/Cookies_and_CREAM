{"manifest_version": 3, "name": "Drime Save", "version": "1.8.0", "description": "Save images, PDFs, videos, links and text to your Drime cloud via right-click. Switch workspaces from the popup.", "browser_specific_settings": {"gecko": {"id": "drime-save@drime.cloud", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "storage", "notifications", "activeTab", "scripting"], "host_permissions": ["https://app.drime.cloud/*", "https://drime.cloud/*", "<all_urls>"], "background": {"scripts": ["api.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}