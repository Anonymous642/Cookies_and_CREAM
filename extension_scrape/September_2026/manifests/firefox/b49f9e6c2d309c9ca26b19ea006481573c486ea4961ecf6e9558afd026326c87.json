{"manifest_version": 3, "name": "Spacebar Clicker \u2013 Counter & CPS", "version": "1.4.0", "description": "Count Spacebar presses and measure clicks per second (CPS) while browsing in Firefox.", "homepage_url": "https://poptyping.app/spacebar-press", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Spacebar Clicker", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}], "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "spacebar-clicker@poptyping.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}