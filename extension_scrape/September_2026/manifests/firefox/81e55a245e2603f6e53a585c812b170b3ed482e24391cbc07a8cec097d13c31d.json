{"manifest_version": 3, "name": "Wikeo", "description": "Turn YouTube videos into a personal, searchable knowledge library with notes, highlights, and screenshots.", "version": "0.2.1", "icons": {"32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["http://127.0.0.1:21547/*"], "web_accessible_resources": [{"resources": ["icon/32.png", "icon/48.png", "icon/64.png", "icon/128.png", "youtube-main-world.js"], "matches": ["*://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "wikeo-extension@getwikeo.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}, "strict_min_version": "140.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["*://www.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-main.js"]}]}