{"manifest_version": 2, "name": "SessionAlive", "version": "3.1.0", "description": "Save and manage browser sessions for supported services. Export cookies as structured session JSON.", "permissions": ["cookies", "activeTab", "tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"scripts": ["background/background.js"]}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "sessionalive@sessionalive.app", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}