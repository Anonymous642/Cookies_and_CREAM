{"name": "The Movie Database", "description": "This extension will redirect all IMDB links to The Movie Database.", "version": "1.3", "manifest_version": 2, "content_scripts": [{"run_at": "document_idle", "matches": ["https://www.google.com/*", "https://www.google.pt/*", "https://www.google.co.uk/*", "https://www.google.co.jp/*", "https://www.duckduckgo.com/*", "https://duckduckgo.com/*"], "js": ["replace.js"]}, {"run_at": "document_idle", "matches": ["https://duckduckgo.com/*"], "js": ["replace_duckduckgo.js"]}], "permissions": ["webRequest", "webNavigation", "https://api.themoviedb.org/3"], "browser_specific_settings": {"gecko": {"id": "{347e6f2d-3f2f-429d-bc1d-3cb1f31b8ba2}"}}}