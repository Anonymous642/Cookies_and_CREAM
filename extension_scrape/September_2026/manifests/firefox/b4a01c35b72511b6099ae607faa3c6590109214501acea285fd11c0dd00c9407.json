{"manifest_version": 2, "name": "Click Tone Composer", "version": "1.0.3", "description": "M\u1ed7i click chu\u1ed9t ph\u00e1t m\u1ed9t n\u1ed1t nh\u1ea1c, bi\u1ebfn thao t\u00e1c duy\u1ec7t web th\u00e0nh nh\u1ea1c c\u1ee5.", "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "commands": {"toggle-sound": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "B\u1eadt/T\u1eaft Click Tone"}}, "icons": {"128": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "click-tone-composer@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}