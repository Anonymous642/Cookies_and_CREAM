{"manifest_version": 3, "name": "Mistral Summarizer", "version": "1.2", "description": "R\u00e9sume le contenu des pages web en utilisant l'API Mistral AI.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>", "https://api.mistral.ai/*"], "action": {"default_popup": "popup/popup.html", "default_icon": "icon.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "mistral-summarizer@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}