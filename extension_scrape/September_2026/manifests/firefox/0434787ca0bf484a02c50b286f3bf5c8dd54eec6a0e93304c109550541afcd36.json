{"manifest_version": 2, "name": "JavaScript Per-Site Toggle", "version": "1.4.1", "description": "Enable or disable JavaScript for the current website with one click. Rules are stored locally per site.", "permissions": ["storage", "menus", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_action": {"default_title": "Toggle JavaScript for this site", "default_icon": {"16": "icons/js-on-16.png", "32": "icons/js-on-32.png", "48": "icons/js-on-48.png", "64": "icons/js-on-64.png", "96": "icons/js-on-96.png", "128": "icons/js-on-128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "js-per-site-toggle@alice.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}