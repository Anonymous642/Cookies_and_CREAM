{"manifest_version": 2, "name": "Copy All Magnet Links", "version": "1.2.0", "description": "Click the extension to copy every magnet link on the current page to your clipboard.", "permissions": ["activeTab", "clipboardWrite"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Copy all magnet links", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "magnet-link-copier@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}