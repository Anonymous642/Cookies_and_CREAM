{"manifest_version": 2, "name": "Sound Booster (Pretty + Compat)", "version": "1.3.0", "description": "Boost per-tab audio up to 600%. Compatibility mode avoids auto-mute on sites like pstream/vidplay/hydrax.", "permissions": ["activeTab", "storage", "<all_urls>", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Sound Booster", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-safe-sound-booster@charan.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "commands": {"increase_volume": {"suggested_key": {"default": "Alt+Up"}, "description": "Increase boost"}, "decrease_volume": {"suggested_key": {"default": "Alt+Down"}, "description": "Decrease boost"}, "toggle_mute": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle mute"}}}