{"manifest_version": 2, "name": "Spotify Controller", "description": "Remote control for your Spotify playback. Requires Spotify Premium.", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "author": "Jayden Kwon", "homepage_url": "https://github.com/jaydenkwon07/SpotifyExtension", "permissions": ["identity", "storage", "alarms", "https://api.spotify.com/*", "https://accounts.spotify.com/*"], "browser_specific_settings": {"gecko": {"id": "spotify-controller@jayden.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Spotify Controller", "default_popup": "popup.html"}}