{"manifest_version": 2, "name": "KB Link Fetcher", "version": "1.3", "description": "Detects DOI and fetches paper via KB.", "permissions": ["tabs", "activeTab", "contextMenus", "<all_urls>"], "browser_action": {"default_title": "KB Link Fetcher", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://soeg.kb.dk/*"], "js": ["kb-autoclick.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "kb-link-fetcher@local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}