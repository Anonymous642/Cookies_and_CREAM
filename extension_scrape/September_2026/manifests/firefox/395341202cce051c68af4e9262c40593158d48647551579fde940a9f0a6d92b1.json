{"manifest_version": 3, "name": "Autoscroll", "version": "2.0", "description": "Automatically scrolls to the next reel when one finishes. Works for Instagram.", "permissions": ["scripting", "activeTab"], "host_permissions": ["*://www.instagram.com/reels/*"], "content_scripts": [{"matches": ["*://www.instagram.com/reels/*"], "js": ["content.js"]}], "icons": {"48": "icons/icon.png"}, "action": {"default_icon": "icons/icon.png", "default_title": "Autoscroll"}, "browser_specific_settings": {"gecko": {"id": "autoscroll@example.com"}}}