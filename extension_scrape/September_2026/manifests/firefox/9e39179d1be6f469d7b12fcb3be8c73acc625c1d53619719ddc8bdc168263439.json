{"manifest_version": 2, "name": "Sachvu", "description": "Save any page, link, or text highlight to Sachvu \u2014 your AI reference library, from the toolbar.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://sachvu.com", "permissions": ["activeTab", "tabs", "scripting", "storage", "contextMenus", "<all_urls>"], "options_ui": {"open_in_tab": true, "page": "options.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open the Sachvu popup"}}, "browser_specific_settings": {"gecko": {"id": "sachvu@sachvu.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Sachvu", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}