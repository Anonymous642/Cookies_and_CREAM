{"manifest_version": 2, "name": "Quiet Markdown Reader", "version": "0.1.1", "description": "Render local and web markdown files in a clean browser reading view.", "browser_specific_settings": {"gecko": {"id": "quiet-markdown-reader@akozlo.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["<all_urls>"], "browser_action": {"default_title": "Open Markdown Reader"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["file:///*", "http://*/*", "https://*/*"], "js": ["markdown.js", "content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": ["styles.css", "reader.html"]}