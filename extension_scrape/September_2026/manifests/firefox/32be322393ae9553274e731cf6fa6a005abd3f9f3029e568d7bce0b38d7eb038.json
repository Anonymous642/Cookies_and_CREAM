{"manifest_version": 2, "name": "PseudoRun - IGCSE Pseudocode Editor", "version": "2.0.0", "description": "Offline IGCSE/A-Level pseudocode editor and simulator with examples, tutorial, syntax validation, and exam mode.", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Open PseudoRun Editor", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}}, "icons": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "web_accessible_resources": ["index.html", "icons/*", "assets/*"], "browser_specific_settings": {"gecko": {"id": "pseudorun-offline@pseudorun.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}