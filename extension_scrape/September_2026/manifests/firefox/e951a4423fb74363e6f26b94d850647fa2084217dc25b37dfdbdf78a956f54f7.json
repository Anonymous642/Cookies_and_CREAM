{"manifest_version": 3, "name": "X Link Fixer & Menu Reverter", "version": "1.3", "description": "Reverts the X/Twitter share menu order and converts copied links to vxtwitter.com", "browser_specific_settings": {"gecko": {"id": "x-menu-fixer@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content.js"], "run_at": "document_start"}]}