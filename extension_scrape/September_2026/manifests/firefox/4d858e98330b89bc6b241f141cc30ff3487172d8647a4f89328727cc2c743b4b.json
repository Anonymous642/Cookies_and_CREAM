{"manifest_version": 3, "name": "Red Flags AI", "version": "1.3.0", "description": "Audit your store, listings and suppliers from the page you are on: missing details, policy gaps and supplier warning signs.", "action": {"default_title": "Red Flags AI", "default_popup": "popup.html"}, "background": {"scripts": ["shared.js", "service-worker.js"]}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "notifications"], "optional_host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.ca/*", "https://*.amazon.de/*", "https://*.ebay.com/*", "https://*.ebay.co.uk/*", "https://*.aliexpress.com/*", "https://*.alibaba.com/*", "https://*.etsy.com/*", "https://*.walmart.com/*"], "host_permissions": ["https://redflagsai.app/*", "https://www.redflagsai.app/*", "https://cepmmsfsiklxmibqpjqa.supabase.co/*"], "commands": {"scan-active-page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Scan the current selection or page with Red Flags AI"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@redflagsai.app", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "personalCommunications"]}}}}