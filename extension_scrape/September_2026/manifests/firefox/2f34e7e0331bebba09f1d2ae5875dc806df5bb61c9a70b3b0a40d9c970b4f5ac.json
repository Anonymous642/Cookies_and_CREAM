{"manifest_version": 3, "name": "Remanga Fix", "version": "1.0.2", "browser_specific_settings": {"gecko": {"id": "remanga-fix@remanga.org", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"scripts": ["build/background.js"]}, "permissions": ["storage", "tabs", "cookies", "scripting", "activeTab"], "host_permissions": ["https://remanga.org/*"], "icons": {"32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_popup": "build/popup.html", "default_icon": "icons/icon.svg"}, "content_scripts": [{"matches": ["https://remanga.org/*"], "js": ["build/content.js"], "css": ["build/styles.css"], "run_at": "document_start"}]}