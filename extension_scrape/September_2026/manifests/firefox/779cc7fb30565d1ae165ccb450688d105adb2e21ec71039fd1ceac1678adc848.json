{"manifest_version": 2, "name": "Water & Break Reminders", "version": "1.7", "description": "Gentle nudges to drink water, stand up and stretch, and rest your eyes with the 20-20-20 rule. Turn each reminder on or off and set its own interval; notifications arrive while Firefox is open.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{6e4fbc01-56c8-41dd-9afa-b862342c95f9}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "notifications", "storage"], "background": {"scripts": ["src/background.js"]}, "browser_action": {"default_title": "Water & Break Reminders", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}