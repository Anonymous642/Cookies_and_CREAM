{"manifest_version": 2, "name": "AI Read Aloud for Firefox", "version": "0.3.0", "description": "Reads webpage text with private AI speech generated by your paired Windows PC.", "browser_specific_settings": {"gecko": {"id": "ai-read-aloud@utbdq.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "tabs", "storage"], "optional_permissions": ["http://*/*"], "background": {"scripts": ["shared.js", "mobile-crypto.js", "runtime-adapter.js", "service-worker.js"], "persistent": false}, "browser_action": {"default_title": "Toggle AI Read Aloud", "default_icon": "icon.svg"}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-playback": {"description": "Play or pause AI Read Aloud"}, "previous-word": {"description": "Move back one word"}, "next-word": {"description": "Move forward one word"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}