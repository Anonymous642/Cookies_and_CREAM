{"manifest_version": 3, "name": "ProtPeek", "description": "Peek at protein structures without leaving the article you are reading.", "version": "0.1.2", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "homepage_url": "https://github.com/MOMISBACK/ProtPeek", "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_title": "Open ProtPeek"}, "permissions": ["scripting", "contextMenus", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://models.rcsb.org https://files.rcsb.org https://alphafold.ebi.ac.uk;"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["searchTerms"]}, "id": "protpeek@momisback.github.io", "strict_min_version": "140.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "ProtPeek", "open_at_install": false}}