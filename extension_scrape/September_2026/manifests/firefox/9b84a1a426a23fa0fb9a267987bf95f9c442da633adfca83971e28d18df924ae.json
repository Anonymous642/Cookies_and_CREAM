{"manifest_version": 2, "name": "Sit-In!", "version": "0.1.1.5", "description": "Sit-In! is an activist browser-extension that extends and documents a physical sit-in organised by tech workers in Nairobi 2023. Install to join this digital sit-in in solidarity with the fight against the exploitative working conditions imposed by Meta and its subcontractors!", "author": "lnd4", "permissions": ["<all_urls>", "tabs", "alarms", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "sit-in@sit-in.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "browser_action": {"default_title": "Toggle Sit-In", "default_icon": {"48": "icons/logo48.png", "128": "icons/logo128.png"}}, "web_accessible_resources": ["icons/icon.png", "fonts/Inter-Bold.woff2"], "options_ui": {"page": "options.html", "open_in_tab": false}, "icons": {"16": "icons/logo16.png", "48": "icons/logo48.png", "128": "icons/logo128.png"}, "content_security_policy": "script-src 'self'; object-src 'self';", "content_scripts": [{"matches": ["*://*/*"], "js": ["utils.js", "content.js", "options.js"], "run_at": "document_idle"}]}