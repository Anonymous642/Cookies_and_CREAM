{"manifest_version": 2, "name": "Hidden YouTube Contents", "description": "Hide the Contents of YouTube videos", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "hidden-youtube-contents@itsutose", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Hidden YouTube Contents", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://m.youtube.com/*", "https://www.youtube.com/*"], "js": ["content-scripts/content.js"]}]}