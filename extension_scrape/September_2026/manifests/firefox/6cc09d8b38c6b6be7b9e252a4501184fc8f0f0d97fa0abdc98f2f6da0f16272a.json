{"manifest_version": 3, "name": "Local Markdown Renderer", "version": "1.0", "description": "Renders local .md files as formatted Markdown with a toggle to view raw source.", "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["file:///*.md", "file:///*.markdown", "file:///*.mdown", "file:///*.mkd", "file:///*.mkdown"], "js": ["marked.min.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "local-md-renderer@dev.local", "data_collection_permissions": {"required": ["none"]}}}}