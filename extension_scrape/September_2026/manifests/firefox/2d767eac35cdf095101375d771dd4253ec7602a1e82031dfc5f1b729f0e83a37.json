{"manifest_version": 2, "name": "Peanut Gemini Float", "version": "2.0.0", "description": "A lightweight Firefox Android helper for summarizing the current page and sending context to ChatGPT.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "activeTab", "clipboardWrite", "https://generativelanguage.googleapis.com/*"], "background": {"scripts": ["browser-api.js", "storage.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["browser-api.js", "storage.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "peanut-gemini-float@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}