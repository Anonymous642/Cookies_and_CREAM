{"manifest_version": 2, "name": "Tab Modifier", "version": "1.0.1", "description": "Customize tab titles and favicons with URL-based rules using exact, prefix, or regex matching.", "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "browser_action": {"default_title": "Tab Name & Favicon Rules", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "rule-tab-renamer@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}