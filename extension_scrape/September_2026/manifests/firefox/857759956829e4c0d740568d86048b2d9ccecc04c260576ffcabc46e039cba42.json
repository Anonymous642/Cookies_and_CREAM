{"manifest_version": 2, "name": "Cookie Toggle Manager", "version": "1.0", "description": "Automatisches Ein-/Ausschalten aller Cookie-Toggles mit einem Klick", "author": "Ben Halking", "browser_specific_settings": {"gecko": {"id": "cookie-toggle-manager@deinname.com", "strict_min_version": "79.0"}}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Cookie Toggles verwalten", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}