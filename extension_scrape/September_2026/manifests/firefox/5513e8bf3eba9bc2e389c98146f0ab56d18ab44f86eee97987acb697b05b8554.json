{"manifest_version": 3, "name": "BeamNG Mod Manager Pro", "version": "1.0.3", "description": "Adds a Download with Mod Manager Pro button to BeamNG resource pages and hands the install off to the desktop app.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "beamng-mod-manager-pro@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}}}, "host_permissions": ["https://www.beamng.com/resources/*", "https://beamng.com/resources/*"], "content_scripts": [{"matches": ["https://www.beamng.com/resources/*", "https://beamng.com/resources/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}