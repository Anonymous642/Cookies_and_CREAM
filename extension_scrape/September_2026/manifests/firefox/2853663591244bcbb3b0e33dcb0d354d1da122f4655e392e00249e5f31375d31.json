{"manifest_version": 3, "name": "YouTube Snip", "version": "1.1.0", "description": "Snip YouTube video transcripts directly into your Obsidian Vault", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.svg"}, "background": {"scripts": ["background.js"]}, "commands": {"snip-transcript": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Snip current video transcript"}, "export-snippets": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Export snippets to Obsidian"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content-isolated.js"], "run_at": "document_start"}], "externally_connectable": {"ids": ["tridactyl@cmcaine.co.uk"]}, "browser_specific_settings": {"gecko": {"id": "youtube-snip@patryk.local", "data_collection_permissions": {"required": ["none"]}}}}