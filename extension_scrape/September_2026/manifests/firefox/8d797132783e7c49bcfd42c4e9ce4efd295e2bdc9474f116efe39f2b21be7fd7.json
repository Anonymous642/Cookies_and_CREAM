{"manifest_version": 3, "name": "Smooth X", "version": "1.2", "description": "Customizable smooth animations and interactive physics for X.com", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "smoothxpro@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "css": ["smooth.css"], "js": ["smooth.js"], "run_at": "document_start"}]}