{"manifest_version": 3, "name": "Textivo \u2013 Text-Qualit\u00e4t pr\u00fcfen", "short_name": "Textivo", "version": "1.0.0", "description": "Markiere Text auf jeder Website und analysiere Lesbarkeit, Grammatik und Lesezeit mit Textivo.", "browser_specific_settings": {"gecko": {"id": "extension@textivo.de", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Textivo \u2013 Text analysieren"}, "content_scripts": [{"matches": ["https://app.textivo.de/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"analyze-grammatik": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Markierten Text mit Grammatik-Check analysieren"}, "analyze-lesbarkeit": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Markierten Text mit Lesbarkeits-Check analysieren"}, "analyze-lesezeit": {"suggested_key": {"default": "Ctrl+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Markierten Text mit Lesezeit-Rechner analysieren"}}}