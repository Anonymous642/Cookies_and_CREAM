{"manifest_version": 2, "name": "TikTok Order Monitor", "version": "1.0", "description": "Monitor TikTok Shop orders and get notifications", "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'", "permissions": ["storage", "activeTab", "tabs", "notifications", "webRequest", "webRequestBlocking", "cookies", "contextualIdentities", "alarms", "*://www.tiktok.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TikTok Order Monitor", "theme_icons": [{"light": "icons/icon16_grey.png", "dark": "icons/icon16.png", "size": 16}, {"light": "icons/icon48_grey.png", "dark": "icons/icon48.png", "size": 48}, {"light": "icons/icon128_grey.png", "dark": "icons/icon128.png", "size": 128}]}, "background": {"scripts": ["background.js"], "persistent": true}, "web_accessible_resources": ["notification.mp3", "combined-orders.html", "combined-orders.js", "notification-overlay.html", "welcome.html", "ad.jpg", "ad2.jpg"], "content_scripts": [{"matches": ["https://www.tiktok.com/*"], "js": ["content.js"]}], "chrome_url_overrides": {"newtab": "combined-orders.html"}, "browser_specific_settings": {"gecko": {"id": "{27a7cccf-c7e3-4256-9cfa-b8c93bcee0d9}"}}}