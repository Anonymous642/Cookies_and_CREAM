{"manifest_version": 2, "name": "Reddit Subreddit Blocker", "version": "3.0.1", "description": "Block subreddits from appearing on Reddit's front page.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "subreddit-blocker@yourdomain.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.min.js"], "css": ["content.css"], "run_at": "document_start"}]}