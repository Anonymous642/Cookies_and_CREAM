{"manifest_version": 3, "name": "Accessify", "version": "1.1", "description": "Adjusts the current website to make it more accessible.", "icons": {"48": "icons/icon_48.png"}, "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "accessify@automatic-accessibility", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["accessify.js"], "css": ["accessible.css"]}], "action": {"default_icon": "icons/icon_32.png", "default_title": "Accessify", "default_popup": "popup/popup.html"}}