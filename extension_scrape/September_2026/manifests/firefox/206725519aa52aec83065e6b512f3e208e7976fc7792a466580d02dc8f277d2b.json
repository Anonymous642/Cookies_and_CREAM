{"manifest_version": 2, "name": "Midnight Lizard (MV2 example)", "version": "1.0.0", "description": "Simple color-theme extension (MV2) \u2014 injects CSS to apply a night-friendly theme. No remote code. No icons included.", "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_start"}], "browser_action": {"default_title": "Midnight Lizard", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "midnight_lizard_example@example.com", "strict_min_version": "60.0"}}}