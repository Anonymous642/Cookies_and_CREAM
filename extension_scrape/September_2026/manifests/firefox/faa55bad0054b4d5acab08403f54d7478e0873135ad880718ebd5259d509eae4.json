{"manifest_version": 3, "name": "Slottle", "description": "Schedule generator right in your browser", "version": "2.4.1", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open Slottle"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16-dark.png", "icons/icon48-dark.png", "icons/icon128-dark.png", "icons/slottledark.png", "icons/slottlelight.png"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "permissions": ["cookies", "storage"], "host_permissions": ["https://archershub.dlsu.edu.ph/*"], "browser_specific_settings": {"gecko": {"id": "slottle@scheduler", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}