{"manifest_version": 3, "name": "Pounce", "description": "Companion extension for the Pounce.so app that connects it to your browser so you can post replies on Reddit and X.", "version": "0.3.3", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "homepage_url": "https://pounce.so", "permissions": ["tabs", "scripting", "storage", "alarms"], "host_permissions": ["https://*.reddit.com/*", "https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*", "https://pounce.so/*", "https://www.pounce.so/*"], "action": {"default_title": "Pounce", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "extension@pounce.so", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://pounce.so/*", "https://www.pounce.so/*"], "run_at": "document_idle", "js": ["content-scripts/pounce-bridge.js"]}, {"matches": ["https://*.reddit.com/*"], "run_at": "document_idle", "js": ["content-scripts/reddit.js"]}, {"matches": ["https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/x-main.js"], "world": "MAIN"}, {"matches": ["https://*.twitter.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://x.com/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/x.js"]}]}