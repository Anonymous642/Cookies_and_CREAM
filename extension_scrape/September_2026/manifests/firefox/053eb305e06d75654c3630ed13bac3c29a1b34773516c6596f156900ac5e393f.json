{"manifest_version": 3, "name": "Spectra \u2013 Color Picker & Palettes", "short_name": "Spectra", "version": "1.0.2", "description": "Pick any color from a web page or your screen and copy it as HEX, RGB or HSL. Build palettes from Apple, Google, Material, Microsoft and more. Private by design.", "author": "Mo", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Spectra", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "commands": {"pick-from-page": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Pick a color from the current page"}}, "browser_specific_settings": {"gecko": {"id": "spectra-color-picker@mo-extensions", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}