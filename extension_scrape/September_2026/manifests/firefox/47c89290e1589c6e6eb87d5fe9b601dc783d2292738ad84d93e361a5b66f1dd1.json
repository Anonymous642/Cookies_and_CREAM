{"manifest_version": 3, "name": "SimpleUI for LinkedIn", "version": "2.0.0", "description": "Take control of your LinkedIn feed.", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "simpleui-for-linkedin@simpleui.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Options", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["localeMeta.js", "content.js"], "run_at": "document_start"}]}