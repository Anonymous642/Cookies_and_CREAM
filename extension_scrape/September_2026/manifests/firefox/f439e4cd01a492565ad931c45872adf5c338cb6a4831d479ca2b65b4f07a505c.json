{"manifest_version": 2, "name": "InstaSideBar", "version": "1.0.1", "description": "Instagram Sidebar for Firefox \u2014 Chat, Reels & Search with mobile phone view", "permissions": ["webRequest", "webRequestBlocking", "*://*.instagram.com/*", "storage"], "sidebar_action": {"default_title": "InstaSideBar", "default_panel": "sidebar/sidebar.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start", "all_frames": true}], "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "instasidebar@firefox-extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+I"}, "description": "Toggle InstaSideBar"}}}