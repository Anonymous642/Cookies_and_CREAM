{"manifest_version": 3, "name": "Whiskey Tab Manager", "version": "3.4.0", "description": "A local-first workspace manager for power browsers.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Stash Window", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "downloads", "bookmarks"], "background": {"scripts": ["assets/background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "whiskeytab@whiskeylabs.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}