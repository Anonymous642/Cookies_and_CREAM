{"manifest_version": 2, "name": "Link With Context", "short_name": "LWC", "description": "Copy the text of a link and its hyperlink as one.", "version": "0.1.1", "browser_specific_settings": {"gecko": {"id": "link_with_context@luascfl"}}, "permissions": ["contextMenus", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icon_16.png", "32": "icon_32.png", "64": "icon_64.png"}}