{"manifest_version": 3, "name": "TextReadsFast for YouTube", "version": "0.2.0", "description": "Read YouTube subtitles one word at a time, at a fixed focal point, so you can follow along at 2x.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "unlimitedStorage", "downloads"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["reader.css", "readmode.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["inject.js", "fonts/*", "keysetup.html"], "matches": ["*://www.youtube.com/*"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "TextReadsFast", "default_popup": "popup.html"}, "optional_host_permissions": ["https://openrouter.ai/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "textreadsfast-youtube@ravandohq.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}