{"manifest_version": 3, "name": "KickGuard Chat Highlighter", "version": "1.0.0", "description": "Highlights Kick chat messages containing saved words.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://kick.com/*"], "content_scripts": [{"matches": ["https://kick.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "KickGuard Chat Highlighter"}, "browser_specific_settings": {"gecko": {"id": "kickguard-chat-highlighter@kickguard.space", "data_collection_permissions": {"required": ["none"]}}}}