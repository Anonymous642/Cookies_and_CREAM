{"manifest_version": 3, "name": "TUKE - Form Filler", "version": "1.1.0", "description": "A Firefox extension for automatic data filling in forms", "icons": {"48": "icons/extension-icon.svg", "96": "icons/extension-icon.svg"}, "permissions": ["activeTab", "tabs", "storage", "scripting", "webNavigation"], "host_permissions": ["<all_urls>"], "sidebar_action": {"default_title": "TUKE - Form Filler", "default_panel": "sidebar/browser/index.html", "default_icon": {"48": "icons/extension-icon.svg", "96": "icons/extension-icon.svg"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "form-filler@tuke.sk", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}