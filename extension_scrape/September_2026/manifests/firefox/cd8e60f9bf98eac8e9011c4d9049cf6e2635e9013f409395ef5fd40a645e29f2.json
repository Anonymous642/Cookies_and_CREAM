{"manifest_version": 2, "name": "Little John", "description": "Little John extension for autofilling third-party forms.", "version": "2.0.8", "short_name": "Little John", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["cookies", "activeTab", "storage", "webNavigation", "tabs", "<all_urls>", "https://workspace.little-john.io/*", "https://api.workspace.little-john.io/*", "https://idp.workspace.little-john.io/*", "https://agent.workspace.little-john.io/*"], "browser_specific_settings": {"gecko": {"id": "little-john@little-john.io", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "financialAndPaymentInfo", "healthInfo", "locationInfo", "browsingActivity", "websiteContent", "websiteActivity"]}}}, "commands": {"autofill-current-form": {"suggested_key": {"default": "Alt+F", "mac": "MacCtrl+F"}, "description": "Fill the current form with WorkflowAI Autofill"}, "recheck-current-form": {"suggested_key": {"default": "Alt+R", "mac": "MacCtrl+R"}, "description": "Recheck the current page for newly appeared form fields"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Little John"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["http://127.0.0.1/*", "http://localhost/*", "https://dev.little-john.io/*", "https://qa.little-john.io/*", "https://stg.little-john.io/*", "https://workspace.little-john.io/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/presence.js"]}]}