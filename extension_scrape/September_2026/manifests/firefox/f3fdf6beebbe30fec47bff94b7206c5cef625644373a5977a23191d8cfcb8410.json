{"manifest_version": 3, "name": "VizChess", "description": "Read chess diagrams on web pages and videos into a board you can check, analyse and save. Works on your device.", "version": "0.1.0", "icons": {"16": "/icons/icon-16.png", "32": "/icons/icon-32.png", "48": "/icons/icon-48.png", "128": "/icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "homepage_url": "https://vizchess-production.up.railway.app/", "web_accessible_resources": [{"resources": ["connected.html"], "matches": ["https://vizchess-production.up.railway.app/*"]}], "action": {"default_title": "Scan this page with VizChess"}, "commands": {"scan-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Scan the chess boards on this page"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "{6b1f0e0a-5f7d-4c9e-9a7c-3d2f8e4b1a55}", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "VizChess"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}