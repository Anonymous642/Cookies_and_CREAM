{"manifest_version": 3, "name": "lsg", "version": "1.2", "description": "A browser extension that helps you learn foreign vocabulary by translating words with contextual examples and exporting them to Anki decks", "permissions": ["activeTab", "tabs", "scripting", "storage"], "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "run_at": "document_idle", "js": ["dist/content.js"], "css": ["style.css"]}], "action": {"default_title": "Rrr", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.jpg"}}, "sidebar_action": {"default_panel": "sidebar.html"}, "background": {"type": "module", "scripts": ["background.js"]}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "lsg@lsg.com", "strict_min_version": "102.0"}}}