{"manifest_version": 3, "name": "Notion Page to Markdown", "version": "1.0.0", "description": "Extracts a Notion page's content and saves it as a Markdown file, even when 'Copy page contents' is disabled.", "permissions": ["scripting", "activeTab"], "host_permissions": ["https://www.notion.so/*", "https://*.notion.site/*"], "action": {"default_title": "Export Notion page as Markdown"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "notion-md@abdallahahmedmohamed.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}