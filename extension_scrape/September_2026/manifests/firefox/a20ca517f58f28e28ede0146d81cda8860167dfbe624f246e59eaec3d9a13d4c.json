{"manifest_version": 2, "name": "SocioFend", "version": "1.0", "description": "Block distracting social media websites during your focus hours to boost productivity", "author": "Idrees Kema", "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "activeTab", "<all_urls>", "unlimitedStorage"], "browser_specific_settings": {"gecko": {"id": "idreeskema14@gmail.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "SocioFend", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": ["blocked.html", "icons/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}