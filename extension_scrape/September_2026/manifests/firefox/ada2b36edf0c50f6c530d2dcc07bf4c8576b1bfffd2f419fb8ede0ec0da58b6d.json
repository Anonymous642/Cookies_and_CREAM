{"manifest_version": 3, "name": "TradingView Toolbar Autohide", "version": "1.3", "description": "Automatically hides Firefox's toolbars on in.tradingview.com and gives a floating button to bring them back.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "windows"], "host_permissions": ["*://in.tradingview.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://in.tradingview.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "tradingview-toolbar-autohide@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}