{"manifest_version": 3, "default_locale": "en", "name": "ScreenText - Screenshot OCR & Translator", "version": "1.0.0", "description": "Capture any screen area, extract text with OCR, and translate it to any language.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker-loader.js", "scripts": ["service-worker-loader.js"], "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture screen area"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "screentext@tere-webdesign", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}