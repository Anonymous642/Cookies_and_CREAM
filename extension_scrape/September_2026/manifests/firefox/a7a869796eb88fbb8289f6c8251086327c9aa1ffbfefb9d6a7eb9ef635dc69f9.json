{"manifest_version": 3, "name": "Pastree", "description": "Clipboard history in your sidebar: save what you copy, keep snippets in lists, attach files to upload forms, and reuse prompts.", "browser_specific_settings": {"gecko": {"id": "pastree@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "clipboardRead", "clipboardWrite", "scripting", "alarms"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "action": {"default_title": "Pastree - Clipboard Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "src/popup/popup.html", "default_title": "Pastree", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "open_at_install": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "src/options/options.html", "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V"}, "description": "Open or close Pastree"}, "paste-last": {"suggested_key": {"default": "Alt+P", "mac": "MacCtrl+Shift+O"}, "description": "Paste shortcut item 3"}, "paste-second": {"suggested_key": {"default": "Alt+O", "mac": "MacCtrl+Shift+I"}, "description": "Paste shortcut item 2"}, "paste-third": {"suggested_key": {"default": "Alt+I", "mac": "MacCtrl+Shift+U"}, "description": "Paste shortcut item 1"}, "toggle-auto-capture": {"description": "Turn auto-capture on or off"}, "clear-history": {"description": "Open Clear All Data"}}, "version": "1.2.1"}