{"manifest_version": 3, "name": "Web2Vector", "description": "Export the current web page as an image or vector file. Supports common formats including SVG, PDF and raster images.", "version": "1.5.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Web2Vector \u2014 Export page"}, "permissions": ["activeTab", "downloads", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service-worker.js"]}, "web_accessible_resources": [{"resources": ["woff2.wasm"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "web2vector@node-projects.github.io", "data_collection_permissions": {"required": ["websiteContent"]}}}}