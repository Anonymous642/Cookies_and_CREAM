{"manifest_version": 2, "name": "YouTube Content Detox", "version": "1.2", "description": "Filters YouTube content based on user-defined keywords.", "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "youtubecontent@detox.extension"}}, "permissions": ["storage", "tabs", "<all_urls>"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}}