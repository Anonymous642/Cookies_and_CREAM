{"manifest_version": 3, "name": "Claude Chat Exporter", "version": "0.1.1", "description": "Export Claude.ai conversations to Markdown, including incognito chats that aren't saved server-side.", "author": "sank3t9", "homepage_url": "https://github.com/sank3t9/claude-chat-export-incognito", "browser_specific_settings": {"gecko": {"id": "claude-chat-exporter@sank3t9.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "downloads"], "host_permissions": ["https://claude.ai/*"], "action": {"default_popup": "src/popup.html", "default_title": "Export Claude chat", "default_icon": "icons/icon.svg"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["lib/turndown.umd.js", "src/selectors.js", "src/api.js", "src/extractor.js", "src/markdown.js", "src/content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon.svg", "128": "icons/icon.svg"}}