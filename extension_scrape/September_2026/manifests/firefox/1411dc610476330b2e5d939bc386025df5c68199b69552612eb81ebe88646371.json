{"manifest_version": 3, "name": "IMDb Distractless Image Scroll", "version": "1.0.1", "description": "Stops the sponsored interstitial from interrupting the IMDb photo gallery, so Next/Previous always move to the next photo.", "icons": {"48": "icons/main-48.png"}, "browser_specific_settings": {"gecko": {"id": "imdb-distractless-image-scroll@local", "strict_min_version": "153.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.imdb.com/*"], "declarative_net_request": {"rule_resources": [{"id": "imdb-interstitial", "enabled": true, "path": "rules.json"}]}}