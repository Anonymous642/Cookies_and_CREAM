{"manifest_version": 3, "name": "Tailnet Bookmarks", "description": "Mirrors your Tailscale Devices and Services into a browser bookmarks folder.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["bookmarks", "alarms", "storage"], "host_permissions": ["https://api.tailscale.com/*"], "browser_specific_settings": {"gecko": {"id": "tailnet-bookmarks@tylerjohnson.me", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tailnet Bookmarks", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}