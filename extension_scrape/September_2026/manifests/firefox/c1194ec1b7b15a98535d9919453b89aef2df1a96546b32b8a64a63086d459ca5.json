{"manifest_version": 2, "name": "YT Time Bookmarks", "version": "3.1.0", "description": "Personal timestamp knowledge base for YouTube videos", "browser_specific_settings": {"gecko": {"id": "yt-time-bookmarks@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "*://www.youtube.com/*", "*://youtube.com/*"], "browser_action": {"default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "sidebar_action": {"default_panel": "popup/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "TimeSnap"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content/content.js"]}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Command+Shift+S"}, "description": "Open/Close TimeSnap Sidebar"}}}