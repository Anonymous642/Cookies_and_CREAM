{"manifest_version": 2, "name": "BattleMetrics Rust Analytics", "version": "1.0.0", "description": "Analytics and server monitoring tools for BattleMetrics \u00e2\u20ac\u201d displays Rust player stats, top servers, real-time server monitoring, and player alerts.", "author": "jlaiii", "homepage_url": "https://jlaiii.github.io/BattleMetrics-Rust-Analytics/", "browser_specific_settings": {"gecko": {"id": "battlemetrics-rust-analytics@jlaiii", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.battlemetrics.com/*"], "js": ["BMplayer.js"], "run_at": "document_idle"}, {"matches": ["https://www.battlemetrics.com/servers/*"], "js": ["BMserver.js"], "run_at": "document_idle"}], "permissions": ["storage", "https://www.battlemetrics.com/*", "https://raw.githubusercontent.com/*"]}