{"manifest_version": 3, "name": "AI RTL Fix", "short_name": "AIRTLFix", "description": "Fixes mixed left-to-right/right-to-left text and applies Vazir across AI sites. Click the icon to toggle on/off.", "version": "1.0.0", "minimum_chrome_version": "121", "author": "Parsa", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "ai-rtl-fix@parsash.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "AI RTL Fix \u2014 click to toggle", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "js": ["vendor/browser-polyfill.js", "content/site-config.js", "content/bidi-fixer.js", "content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles/fonts.css", "fonts/Vazirmatn[wght].woff2"], "matches": ["http://*/*", "https://*/*"]}]}