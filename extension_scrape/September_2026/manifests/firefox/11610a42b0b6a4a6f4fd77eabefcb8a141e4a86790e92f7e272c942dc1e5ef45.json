{"manifest_version": 3, "name": "Veriguard \u2014 scam check", "description": "Check a suspicious message, link, email or number for scam signals. Runs entirely on your device \u2014 nothing is sent anywhere.", "version": "0.3.2", "permissions": ["contextMenus", "storage", "notifications"], "action": {"default_title": "Veriguard", "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://veriguard.app"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "veriguard@veriguard.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}