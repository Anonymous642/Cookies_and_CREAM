{"manifest_version": 3, "name": "YouTube Playlist Randomizer", "version": "1.0.0", "description": "Shuffle any YouTube playlist in a random order. Paste a playlist link and discover videos you might have forgotten about.", "browser_specific_settings": {"gecko": {"id": "yt-playlist-randomizer@theytcommentfinder.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}]}