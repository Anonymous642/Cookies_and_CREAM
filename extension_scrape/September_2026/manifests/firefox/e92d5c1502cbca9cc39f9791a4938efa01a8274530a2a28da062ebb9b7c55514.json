{"manifest_version": 3, "name": "AISEO Content Guard", "version": "1.0.0", "description": "Check repetition, claims, readability, headings, and brand consistency locally.", "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "action": {"default_title": "AISEO Content Guard", "default_popup": "src/popup/popup.html", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "96": "src/icons/icon-96.png"}}, "background": {"scripts": ["src/background/background.js"]}, "icons": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "96": "src/icons/icon-96.png", "128": "src/icons/icon-128.png"}, "options_ui": {"page": "src/settings/settings.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; connect-src 'none'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "aiseo-content-guard@aiseo.company", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}