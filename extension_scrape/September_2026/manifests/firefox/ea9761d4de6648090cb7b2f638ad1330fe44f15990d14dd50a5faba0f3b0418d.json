{"manifest_version": 3, "name": "FeedLake", "version": "1.1.0", "description": "Detect and follow RSS feeds on any website", "browser_specific_settings": {"gecko": {"id": "feedlake@feedlake.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/feed-detector.js"], "run_at": "document_idle"}], "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "developer": {"name": "FeedLake", "url": "https://feedlake.ai"}}