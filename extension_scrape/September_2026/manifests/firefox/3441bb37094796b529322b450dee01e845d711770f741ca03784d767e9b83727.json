{"manifest_version": 3, "name": "Walmart Trip Optimizer", "version": "1.0.0", "description": "Re-sorts your Walmart cart into aisle order for an efficient in-store trip.", "permissions": ["clipboardWrite"], "host_permissions": ["*://*.walmart.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.walmart.com/cart*", "https://www.walmart.com/orders*", "https://www.walmart.com/checkout*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "walmart-trip-optimizer@public", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}