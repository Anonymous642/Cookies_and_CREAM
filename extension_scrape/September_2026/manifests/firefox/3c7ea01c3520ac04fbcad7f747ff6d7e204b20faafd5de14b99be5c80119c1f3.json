{"manifest_version": 2, "name": "Smart Clipboard Manager", "version": "1.2", "description": "Clipboard manager with timestamps, source, image support, pin, export, context menu and shortcuts.", "permissions": ["storage", "activeTab", "tabs", "contextMenus", "clipboardWrite", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"128": "assets/icon128.png"}}, "icons": {"128": "assets/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"open-popup": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open clipboard manager popup"}, "paste-last-pinned": {"suggested_key": {"default": "Ctrl+Shift+P"}, "description": "Paste last pinned clipboard item"}}, "browser_specific_settings": {"gecko": {"id": "smartclipboardmanager@princepal", "data_collection_permissions": {"required": ["none"], "optional": []}}}}