{"manifest_version": 3, "name": "CLI Summary", "version": "1.2", "description": "Right-click a YouTube tab to copy a ready-to-paste prompt that has any CLI agent condense the video.", "browser_specific_settings": {"gecko": {"id": "cli-summary@yt-condense", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["menus", "contextMenus", "clipboardWrite", "scripting", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "background": {"scripts": ["prompt.js", "background.js"]}, "action": {"default_title": "Copy CLI summary prompt", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "author": "h-3303"}