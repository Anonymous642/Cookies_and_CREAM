{"manifest_version": 3, "name": "7TV for Rumble", "version": "2.6.1", "description": "7TV, BetterTTV, FrankerFaceZ and native Rumble emotes for Rumble livestream chat, plus opt-in moderation chat history, chatter lookup, @mention highlight/sound alerts, deduplicated local logging and reliable Supabase sync.", "browser_specific_settings": {"gecko": {"id": "7tv-rumble@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}}, "permissions": ["storage"], "host_permissions": ["https://rumble.com/*", "https://www.rumble.com/*", "https://7tv.io/*", "https://api.7tv.app/*", "https://cdn.7tv.app/*", "https://api.betterttv.net/*", "https://cdn.betterttv.net/*", "https://api.frankerfacez.com/*", "https://vtdisvhxihpvfshjwvzj.supabase.co/*", "https://decapi.me/*", "https://api.ivr.fi/*"], "action": {"default_title": "7TV for Rumble", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg"}}, "content_scripts": [{"matches": ["https://rumble.com/*", "https://www.rumble.com/*"], "js": ["supabase.js", "content.js", "moderation.js"], "css": ["content.css"], "run_at": "document_idle"}]}