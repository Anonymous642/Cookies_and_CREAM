{"manifest_version": 2, "name": "Story Prompt Injector", "version": "1.3", "description": "Inject creative story prompts into text areas to help writers overcome writer's block and generate new ideas.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Story Prompt Injector"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "@Story-Prompt-Injector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}