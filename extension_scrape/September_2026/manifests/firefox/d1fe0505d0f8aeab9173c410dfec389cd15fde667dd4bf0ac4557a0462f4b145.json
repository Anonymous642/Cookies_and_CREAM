{"manifest_version": 3, "name": "vMeasure Extension", "version": "1.2.0", "description": "vMeasure Extension captures dimensions/weight from vMeasure Ultima, updating web page fields based on configuration.", "browser_specific_settings": {"gecko": {"id": "ravikiran@visailabs.com", "strict_min_version": "42.0"}}, "icons": {"72": "images/icon72.png", "96": "images/icon96.png", "128": "images/icon128.png", "144": "images/icon144.png", "152": "images/icon152.png", "192": "images/icon192.png", "384": "images/icon384.png", "512": "images/icon512.png"}, "background": {"scripts": ["service-worker.js"], "type": "module"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "index.html", "default_title": "vMeasure Extension for Parcel Measurements"}, "commands": {"measure": {"suggested_key": {"default": "Ctrl+M"}, "description": "measure"}, "measure_key_1": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "measure"}}}