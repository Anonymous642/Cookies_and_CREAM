{"manifest_version": 2, "name": "One-Click RSS", "description": "Automatically discover RSS/Atom feeds and subscribe with one click", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "storage", "webNavigation", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "one-click-rss@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "RSS Feeds", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}