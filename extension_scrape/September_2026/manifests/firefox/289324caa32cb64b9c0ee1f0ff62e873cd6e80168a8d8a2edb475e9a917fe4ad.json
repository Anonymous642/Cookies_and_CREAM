{"manifest_version": 3, "name": "Source Light", "version": "1.0.0", "description": "Calculates and displays product scores across six ethical dimensions.", "permissions": ["activeTab"], "host_permissions": ["https://*.amazon.com/*", "https://getsourcelight.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.amazon.com/*/dp/*", "https://*.amazon.com/dp/*", "https://*.amazon.com/gp/product/*"], "js": ["content.js"], "css": ["toolbar.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "addon@getsourcelight.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}