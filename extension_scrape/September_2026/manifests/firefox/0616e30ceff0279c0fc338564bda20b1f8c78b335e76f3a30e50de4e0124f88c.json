{"manifest_version": 2, "name": "Tab Loader", "version": "1.0.0", "description": "Keeps selected tabs reporting as visible so pages continue acting loaded.", "icons": {"48": "icons/tab-loader-extension.svg", "96": "icons/tab-loader-extension.svg"}, "permissions": ["<all_urls>", "storage", "tabs"], "page_action": {"default_title": "Keep this site loaded", "default_icon": {"19": "icons/tab-loader-off.svg", "38": "icons/tab-loader-off.svg"}, "show_matches": ["http://*/*", "https://*/*", "file:///*"]}, "background": {"scripts": ["matcher.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["matcher.js", "content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "tab-loader@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}