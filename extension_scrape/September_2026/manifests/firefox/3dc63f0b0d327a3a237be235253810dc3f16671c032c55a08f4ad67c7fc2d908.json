{"manifest_version": 2, "name": "Auto-Captioner", "version": "1.0.0", "description": "T\u1ef1 sinh caption cho \u1ea3nh tr\u00ean trang b\u1eb1ng AI \u0111\u01a1n gi\u1ea3n (offline/local).", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Auto-Captioner", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "auto-captioner@example.com", "data_collection_permissions": {"required": ["none"]}}}}