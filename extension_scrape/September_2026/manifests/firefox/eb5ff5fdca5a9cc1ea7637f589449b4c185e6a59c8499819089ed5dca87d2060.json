{"manifest_version": 3, "name": "TempMailGrab", "short_name": "TempMailGrab", "description": "Get a disposable email instantly - detects email fields on any site and auto-fills them for you.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "tempmailgrab-extension@github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "alarms", "notifications", "clipboardWrite"], "host_permissions": ["https://tempmailgrab.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://tempmailgrab.com/*", "https://www.tempmailgrab.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "TempMailGrab", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}