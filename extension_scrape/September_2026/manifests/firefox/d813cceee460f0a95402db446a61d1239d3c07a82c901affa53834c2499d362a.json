{"manifest_version": 3, "name": "Tailora \u2014 Spara jobb & generera CV", "description": "Spara jobbannonser direkt fr\u00e5n LinkedIn, Indeed och Platsbanken. Generera skr\u00e4ddarsydda CV med Tailora.", "version": "1.1.1", "permissions": ["storage"], "host_permissions": ["https://tailora.se/*"], "browser_specific_settings": {"gecko": {"id": "tailora@tailora.se", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/tailora16.png", "48": "icons/tailora48.png", "128": "icons/tailora128.png"}}, "icons": {"16": "icons/tailora16.png", "48": "icons/tailora48.png", "128": "icons/tailora128.png"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*", "https://se.indeed.com/*", "https://www.indeed.se/*", "https://indeed.se/*", "https://www.indeed.com/*", "https://arbetsformedlingen.se/platsbanken/*", "https://www.arbetsformedlingen.se/platsbanken/*", "https://tailora.se/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}