{"manifest_version": 3, "name": "Tube+ Universal Toolkit", "version": "1.0.0", "description": "YouTube enhancer + universal adblock, tracking protection, cookie popup blocker, auto dark mode, screenshot, and notes/bookmark manager.", "permissions": ["storage", "tabs", "scripting", "activeTab", "downloads", "webRequest", "webRequestBlocking"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tube+ Toolkit", "default_popup": "ui/popup.html"}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_start"}, {"matches": ["*://*/*"], "js": ["content/universal.js", "content/cookies.js", "content/darkmode.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "tubeplus@example.com", "strict_min_version": "109.0"}}}