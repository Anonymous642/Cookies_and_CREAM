{"manifest_version": 2, "name": "Youtube Spotify Links Replacer", "version": "1.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "YT | SPTY Helper"}, "browser_specific_settings": {"gecko": {"id": "youtube-spotify-link-replacer@github.dewamadewira", "data_collection_permissions": {"required": ["none"], "data_categories": [], "data_purposes": [], "data_types": []}}}, "permissions": ["tabs", "https://www.youtube.com/oembed*", "https://open.spotify.com/*", "storage"], "data_collection_permissions": {"data_categories": {"technical_data": false, "interaction_data": false, "location_data": false, "website_activity": false, "website_content": false}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://open.spotify.com/*"], "js": ["content.js"]}]}