{"manifest_version": 3, "name": "AiKeyz", "version": "0.1", "description": "Shortcuts to open common LLM websites", "browser_specific_settings": {"gecko": {"id": "AiKeyz@commonllms", "strict_min_version": "112.0"}}, "icons": {"48": "Icons/icon_48.png", "96": "Icons/icon_96.png"}, "permissions": ["activeTab"], "background": {"scripts": ["background.js"]}, "commands": {"open-chatgpt": {"suggested_key": {"default": "Alt+C"}, "description": "Open ChatGPT"}, "open-gemini": {"suggested_key": {"default": "Alt+G"}, "description": "Open Gemini"}, "open-grok": {"suggested_key": {"default": "Alt+X"}, "description": "Open Grok"}, "open-claude": {"suggested_key": {"default": "Alt+L"}, "description": "Open Claude"}}, "action": {"default_popup": "popup.html"}, "host_permissions": ["http://chatgpt.com/*", "https://chatgpt.com/*", "http://gemini.google.com/*", "https://gemini.google.com/*", "http://grok.com/*", "https://grok.com/*"]}