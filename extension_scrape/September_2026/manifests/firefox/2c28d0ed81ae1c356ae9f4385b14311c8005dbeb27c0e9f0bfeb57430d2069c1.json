{"manifest_version": 2, "name": "HappyMode Version Checker", "version": "1.0.2", "description": "Check Google Play apps on HappyMode", "browser_specific_settings": {"gecko": {"id": "happymode-checker@happymode.net.in", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "https://play.google.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "HappyMode Version Checker"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://play.google.com/store/apps/details*"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}