{"manifest_version": 2, "name": "TabBeep", "version": "1.0.0", "description": "Ph\u00e1t \u00e2m b\u00e1o ri\u00eang cho t\u1eebng tab khi tab thay \u0111\u1ed5i tr\u1ea1ng th\u00e1i. G\u00e1n \u00e2m b\u00e1o, b\u1eadt/t\u1eaft, ch\u1ec9nh \u00e2m l\u01b0\u1ee3ng.", "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "TabBeep", "default_popup": "popup.html"}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "@tabbeep.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}