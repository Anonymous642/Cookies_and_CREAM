{"manifest_version": 3, "name": "CloudWarning", "version": "1.2", "description": "Displays a warning icon when a page is served via Cloudflare.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Cloudflare warning enabled", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "permissions": ["webRequest", "webRequestBlocking", "storage"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-48.png", "icons/icon-96.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "cloudflare-warning@example.com", "strict_min_version": "110.0"}}}