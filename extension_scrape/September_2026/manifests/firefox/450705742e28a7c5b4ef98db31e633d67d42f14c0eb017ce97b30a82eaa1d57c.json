{"manifest_version": 3, "name": "Volume Booster For Netflix", "version": "0.1.0", "description": "Boost Netflix audio in Firefox after DRM playback has started.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.netflix.com/*"], "content_scripts": [{"matches": ["https://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Netflix Volume Booster", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png"}}, "browser_specific_settings": {"gecko": {"id": "volume-booster-4-netflix@local.test", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "121.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}}