{"manifest_version": 2, "name": "RASTATAB", "version": "6.1.3", "description": "Color-code your tabs with a right-click, keyboard shortcuts, or voice. Compare products, apartments & more.", "permissions": ["activeTab", "contextMenus", "storage", "tabs", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "rastatab@rastatab.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"color-cycle": {"suggested_key": {"default": "Alt+R"}, "description": "Cycle through colors"}, "color-remove": {"suggested_key": {"default": "Alt+Q"}, "description": "Remove tab color"}, "toggle-voice": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle voice commands (microphone)"}}}