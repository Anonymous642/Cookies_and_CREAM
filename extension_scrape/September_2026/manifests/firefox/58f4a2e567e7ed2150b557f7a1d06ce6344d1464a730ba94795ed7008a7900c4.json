{"manifest_version": 3, "name": "Tabba \u2013 Minimal New Tab Suite", "short_name": "Tabba", "version": "0.7.4", "description": "A privacy-first new tab with calendar, to-do, bookmarks & zero tracking.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage", "unlimitedStorage"], "chrome_url_overrides": {"newtab": "index.html"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "assets/icons/icon128.png"}}, "icons": {"128": "assets/icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "tabba@tabba.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}