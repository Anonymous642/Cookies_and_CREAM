{"manifest_version": 3, "name": "Video Blocker \u2014 Read Mode", "version": "2.0.0", "description": "Permanently blocks video content on sites you choose and replaces it with a readable transcript.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://vimeo.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "video-blocker@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}