{"manifest_version": 2, "name": "ARWallet Auto Buyer", "version": "1.1.0", "description": "Watches the ARWallet buy list, grabs the first trade in your price range, refreshes when someone beats you to it, then picks your payment app.", "browser_specific_settings": {"gecko": {"id": "arwallet-auto-buyer@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["lib/defaults.js", "background.js"], "persistent": false}, "browser_action": {"default_title": "ARWallet Auto Buyer", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/defaults.js", "lib/upi-apps.js", "content/engine.js"], "css": ["content/hud.css"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-run": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Start or stop the auto buyer"}}}