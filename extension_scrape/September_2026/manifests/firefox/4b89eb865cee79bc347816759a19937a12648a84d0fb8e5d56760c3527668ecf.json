{"manifest_version": 3, "name": "Amazon Decrappifier", "version": "1.0", "description": "Filters out low-rated and low-review products from Amazon search results.", "permissions": ["storage"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*"], "action": {"default_popup": "popup.html", "default_title": "Amazon Decrappifier Settings", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "amazon-decrappifier@cragg.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}