{"manifest_version": 2, "name": "SteamDB Add to Cart", "version": "1.3", "description": "Quickly add SteamDB games to your Steam cart.", "permissions": ["cookies", "tabs", "activeTab", "storage", "https://steamdb.info/*", "https://store.steampowered.com/*"], "content_scripts": [{"matches": ["https://steamdb.info/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "steamdb-addon@yourdomain.com", "strict_min_version": "109.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}