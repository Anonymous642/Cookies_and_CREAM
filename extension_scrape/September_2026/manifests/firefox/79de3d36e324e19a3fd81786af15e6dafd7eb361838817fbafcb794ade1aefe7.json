{"manifest_version": 2, "name": "Athenty Snap", "description": "One-click identity verification from any web page", "version": "1.0.1", "icons": {"16": "icon-gray-16.png", "32": "icon-gray-32.png", "48": "icon-gray-48.png", "128": "icon-gray-128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "notifications", "alarms", "https://api.athenty.com/*"], "homepage_url": "https://athenty.com", "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "snap@athenty.com", "strict_min_version": "109.0"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Athenty Snap"}, "scan_page": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Scan page for identity data"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Athenty Snap", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": false, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}