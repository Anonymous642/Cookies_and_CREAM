{"manifest_version": 3, "name": "Timeslicer - Intelligent Website Blocker", "description": "Capture work content on your browsers.", "version": "1.8.4", "permissions": ["tabs", "idle", "alarms", "storage", "nativeMessaging"], "host_permissions": ["https://api.timeslicer.app/*", "http://127.0.0.1/*"], "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["dist/contentScript.js"], "run_at": "document_end"}], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["dist/ui/overlay/*", "assets/blocker-images/*", "assets/icons/*", "assets/fonts/*"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_popup": "dist/ui/popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "timeslicer@timeslicer.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "browsingActivity"], "optional": ["technicalAndInteraction"]}}}}