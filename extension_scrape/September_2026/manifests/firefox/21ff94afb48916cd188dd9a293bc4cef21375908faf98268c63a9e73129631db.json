{"manifest_version": 3, "name": "Cobra Speed Board", "version": "0.3.7", "description": "A customizable speed board for your Firefox new tab page with boards, sections, shortcuts, Premium themes, cloud backup, and optional Premium wallpaper collections.", "permissions": ["storage", "tabs", "activeTab", "menus", "unlimitedStorage"], "host_permissions": ["https://medcode.pl/api/cobra-speed-board/*", "https://www.medcode.pl/api/cobra-speed-board/*"], "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Cobra Speed Board"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "biuro@medcode.pl", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "optional_host_permissions": ["<all_urls>"]}