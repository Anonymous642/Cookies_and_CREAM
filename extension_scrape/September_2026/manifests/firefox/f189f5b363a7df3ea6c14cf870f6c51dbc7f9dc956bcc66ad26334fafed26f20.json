{"manifest_version": 2, "name": "Carbi a Bazos export", "version": "1.6.25", "description": "Exportuje vozidla z Carbi do ABManagera a na Bazos a umoznuje repridavat existujuce Bazos inzeraty.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "clipboardWrite", "https://www.carbi.sk/*", "https://carbi.sk/*", "https://i.carbi.sk/*", "https://www.abmanager.sk/*", "https://*.bazos.sk/*", "https://*.bazos.cz/*", "https://autobazar.eu/*", "https://*.autobazar.eu/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Carbi a Bazos export", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "browser_specific_settings": {"gecko": {"id": "carbi-abmanager@local", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://www.carbi.sk/*", "https://carbi.sk/*"], "js": ["carbi.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://www.abmanager.sk/*"], "js": ["abmanager.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://*.bazos.sk/*", "https://*.bazos.cz/*"], "js": ["bazos.js", "repridavac.js"], "css": ["styles.css"], "run_at": "document_idle"}]}