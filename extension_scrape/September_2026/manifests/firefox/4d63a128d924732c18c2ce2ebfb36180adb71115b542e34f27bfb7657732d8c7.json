{"manifest_version": 2, "name": "Contextual Translator & Vocab Builder", "version": "0.2.1", "description": "Translate words/phrases in context, save and review vocabulary while browsing.", "permissions": ["storage", "activeTab", "contextMenus", "notifications", "https://generativelanguage.googleapis.com/*"], "background": {"scripts": ["constants.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["constants.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true, "browser_style": true}, "commands": {"translate-selection": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Translate Selected Text"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "applications": {"gecko": {"id": "contextualtranslator@example.com", "strict_min_version": "60.0"}}}