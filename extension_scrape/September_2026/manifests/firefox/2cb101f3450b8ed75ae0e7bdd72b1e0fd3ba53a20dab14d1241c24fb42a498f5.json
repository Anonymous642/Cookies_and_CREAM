{"manifest_version": 3, "name": "ManyDial Click-to-Call", "short_name": "ManyDial", "version": "1.0.1", "description": "Detect and call phone numbers from any webpage through your ManyDial Call Center.", "author": "ManyDial", "homepage_url": "https://app.manydial.com", "browser_specific_settings": {"gecko": {"id": "manydial-click-to-call@manydial.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "121.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ManyDial Click-to-Call \u2014 open settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["contextMenus", "storage", "tabs", "scripting", "notifications"], "host_permissions": ["https://app.manydial.com/*", "http://localhost/*"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://app.manydial.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}]}