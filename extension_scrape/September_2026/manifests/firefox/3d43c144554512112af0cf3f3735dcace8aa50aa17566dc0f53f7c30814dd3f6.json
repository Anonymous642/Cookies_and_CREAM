{"manifest_version": 3, "name": "Sparrow \u2014 CSS Inspector & Annotator", "version": "1.0.5", "description": "Inspect CSS, measure layouts, pick colors and fonts, extract assets, and annotate any webpage \u2014 the Sparrow toolkit, on every site.", "action": {"default_title": "Toggle Sparrow Scanner", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["dist/background.js"]}, "browser_specific_settings": {"gecko": {"id": "sparoww@trysparrowcss.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "cookies", "scripting"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dist/content.css", "fonts/*.woff2"], "matches": ["<all_urls>"]}]}