{"manifest_version": 3, "name": "YouTube Default Settings", "version": "1.12", "browser_specific_settings": {"gecko": {"id": "yt-defaults@your-handle", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://www.youtube-nocookie.com/*"], "icons": {"128": "icon.png"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://www.youtube-nocookie.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}