{"manifest_version": 3, "name": "Cookie Vault", "version": "1.19.5", "description": "Restore cookies from a file, or view/edit/delete/paste-inject cookies already in your browser via Site Manager. Everything runs locally \u2014 no data ever leaves your device.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["cookies", "tabs", "storage", "unlimitedStorage", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "incognito": "split", "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "author": "Maruf Hossain Keyas", "homepage_url": "https://github.com/marufhossainkeyas11/Cookie-Vault", "browser_specific_settings": {"gecko": {"id": "cookie-vault@local.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}