{"manifest_version": 3, "name": "TranslateNext", "description": "A tiny, beautiful, free, open-source, real-time website and video subtitle translation extension.", "version": "0.1.1", "default_locale": "en", "author": "RoversX", "icons": {"16": "translatenext.png", "32": "translatenext.png", "48": "translatenext.png", "128": "translatenext.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "TranslateNext", "default_icon": "translatenext.png"}, "background": {"scripts": ["background/index.js"], "type": "module"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "permissions": ["storage", "tabs", "webRequest", "declarativeNetRequest"], "host_permissions": ["*://*.google.com/*", "*://*.googleapis.com/*", "*://*.microsoft.com/*", "*://*.deepl.com/*", "*://*.openai.com/*", "*://*.anthropic.com/*", "*://*.youtube.com/*", "*://*.huggingface.co/*", "*://*.hf.co/*", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/*"], "js": ["content/network_hook.js"], "run_at": "document_start", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["assets/*", "translatenext.png", "translatenext_checked.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "contact@closex.org", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}