{"manifest_version": 3, "name": "Castaway Cast", "version": "1.0.0", "description": "Right-click any video to cast it to a Chromecast via Castaway \u2014 as the main stream or picture-in-picture.", "browser_specific_settings": {"gecko": {"id": "castaway@dlamanna.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/wilson-48.png", "96": "icons/wilson-96.png"}, "permissions": ["contextMenus", "storage", "notifications", "activeTab"], "host_permissions": ["https://cast.dlamanna.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Castaway", "default_popup": "popup.html", "default_icon": {"48": "icons/wilson-48.png", "96": "icons/wilson-96.png"}}}