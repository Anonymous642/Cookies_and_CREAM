{"manifest_version": 3, "name": "Skyreader", "version": "0.2.0", "description": "Save the page you're reading to Skyreader, or subscribe to its feeds.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Skyreader", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "skyreader@skyreader.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "contextMenus", "scripting"], "host_permissions": ["https://api.skyreader.app/*"]}