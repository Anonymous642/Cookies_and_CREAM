{"manifest_version": 3, "name": "txt-only-reader", "version": "0.3.0", "description": "Prefix any URL with txt. for a text-only, image-free, date-sorted reading view.", "browser_specific_settings": {"gecko": {"id": "txt-only-reader@mcln.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "menus"], "optional_host_permissions": ["*://*/*"], "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_title": "txt-only-reader", "default_icon": "icons/icon.svg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Toggle text-only mode for the current tab"}}}