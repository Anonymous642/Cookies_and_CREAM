{"manifest_version": 2, "name": "Context Harvester", "description": "Multi-tab LLM context builder \u2014 collect, organize, and export content from multiple browser tabs as structured, token-aware prompts.", "version": "1.0.0", "permissions": ["contextMenus", "storage", "activeTab"], "commands": {"add-to-context": {"suggested_key": {"default": "Alt+C"}, "description": "Add selected text to context"}}, "browser_specific_settings": {"gecko": {"id": "context-harvester@rishapgandhi.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "purposes": [], "is_exempt": true}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "sidebar_action": {"default_panel": "sidepanel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}