{"manifest_version": 3, "name": "Simpsonize Browser", "version": "1.0", "description": "Transform your browser into a Simpsons-style experience with custom cursors and yellow styling!", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/homer16.png", "48": "icons/homer48.png", "128": "icons/homer128.png"}}, "icons": {"16": "icons/homer16.png", "48": "icons/homer48.png", "128": "icons/homer128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["faces/*", "styles.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "contact@simpsonizeme.co"}}}