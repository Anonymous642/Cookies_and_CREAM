{"manifest_version": 2, "name": "ATN Reviewer Monitor", "version": "1.3.0", "description": "Logs slow responses, 5xx errors and network failures on addons.thunderbird.net (reviewer work, downloads and other pages).", "author": "John Bieling", "browser_specific_settings": {"gecko": {"id": "atn-reviewer-monitor@john.bieling", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "storage", "unlimitedStorage", "downloads", "https://addons.thunderbird.net/*", "https://*.addons.thunderbird.net/*"], "background": {"scripts": ["lib/shared.js", "lib/db.js", "background.js"]}, "browser_action": {"default_title": "ATN Reviewer Monitor", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}