{"manifest_version": 3, "name": "Potato Mode", "version": "1.2", "description": "Optimisez votre navigation : d\u00e9sactivez les animations, bloquez les GIFs, passez en mode sombre forc\u00e9 et \u00e9conomisez des ressources pour une exp\u00e9rience web ultra-rapide.", "author": "djael-ml", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "potato-mode@djael-ml.github", "data_collection_permissions": {"required": ["none"]}}}}