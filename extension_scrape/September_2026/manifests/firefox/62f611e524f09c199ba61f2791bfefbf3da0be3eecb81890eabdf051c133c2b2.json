{"manifest_version": 2, "name": "Chat Shield \u2014 federicocalo.dev", "description": "Maschera email, telefoni, IBAN, carte, chiavi API, JWT, IP e codice fiscale prima di inviarli a un assistente AI. 100% offline, zero telemetria.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "browser_specific_settings": {"gecko": {"id": "chat-shield@federicocalo.dev", "strict_min_version": "109.0"}}, "data_collection_permissions": {"required": ["none"]}, "browser_action": {"default_title": "Chat Shield", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}