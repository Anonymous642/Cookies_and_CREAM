{"manifest_version": 3, "name": "Desker \u2014 Central de Demandas", "description": "Envie e-mails, mensagens e p\u00e1ginas para a Central de Demandas do Desker com um clique.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "minimum_chrome_version": "116", "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://*.desker.com.br/*", "https://desker.com.br/*", "https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["pageWorld.js", "icon/*.png"], "matches": ["https://mail.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "collector@desker.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications", "personallyIdentifyingInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "default_title": "Enviar para Desker", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "run_at": "document_end", "js": ["content-scripts/gmail.js"]}]}