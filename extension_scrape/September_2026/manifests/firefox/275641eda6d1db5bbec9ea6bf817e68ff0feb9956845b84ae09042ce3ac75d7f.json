{"manifest_version": 3, "name": "Adaptive Speed \u2013 Smart Video Speed Control", "version": "1.3.3", "description": "Automatically detects short-form vs long-form video by URL and duration, and applies the right playback speed on every site \u2014 YouTube, Facebook, Instagram, TikTok, and more. Near-zero CPU/RAM overhead, no polling.", "author": "Hafiz", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["rules.js", "content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "Adaptive Speed", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "adaptive-speed@hafiz.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}