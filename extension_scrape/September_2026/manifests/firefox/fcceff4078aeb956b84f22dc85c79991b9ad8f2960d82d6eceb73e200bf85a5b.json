{"manifest_version": 2, "name": "NAMINT quicksearch", "version": "1.0", "description": "A simple OSINT tool for searching info based on selected text (select 2 or 3 words) i.e. name, optional nickname, and surname", "browser_specific_settings": {"gecko": {"id": "namint-quicksearch-addon@seint.pl", "strict_min_version": "109.0"}}, "permissions": ["contextMenus", "activeTab"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/namint-16.png", "32": "icons/namint-32.png", "48": "icons/namint-48.png", "128": "icons/namint-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_action": {"default_icon": {"32": "icons/namint-32.png"}, "default_title": "NAMINT quicksearch", "default_popup": "popup.html"}}