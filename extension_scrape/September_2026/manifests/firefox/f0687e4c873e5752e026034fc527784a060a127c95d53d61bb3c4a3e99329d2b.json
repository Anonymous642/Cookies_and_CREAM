{"manifest_version": 2, "name": "Transcript Mode for YouTube", "version": "1.1.0", "description": "A clean, native-feeling YouTube reading mode. Distraction-free synchronized transcripts. Works across Chrome, Firefox, Edge, Brave, Opera, and more.", "permissions": ["storage", "activeTab", "tabs", "*://*.youtube.com/*", "*://*.youtubetranscript.com/*"], "background": {"scripts": ["src/utils/browserApi.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/utils/browserApi.js", "src/utils/designTokens.js", "src/utils/icons.js", "src/utils/dom.js", "src/utils/youtube.js", "src/content/storageManager.js", "src/content/settingsManager.js", "src/content/timestampEstimator.js", "src/content/transcriptManager.js", "src/content/playerController.js", "src/content/animationManager.js", "src/content/virtualList.js", "src/content/lyricsMode.js", "src/content/wordMode.js", "src/content/readingMode.js", "src/content/searchManager.js", "src/content/sidebarManager.js", "src/content/uiManager.js", "content.js"], "css": ["src/styles/main.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Transcript Mode for YouTube", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "options_ui": {"page": "dist/index.html", "open_in_tab": true}, "web_accessible_resources": ["assets/*", "src/styles/*", "dist/*"], "browser_specific_settings": {"gecko": {"id": "transcript-mode@youtube.extension", "strict_min_version": "140.0", "strict_min_version_android": "142.0", "data_collection_permissions": {"required": ["none"]}}}}