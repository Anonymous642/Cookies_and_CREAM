{"manifest_version": 2, "name": "Xitter Blues: Hide verified on twitter/X", "version": "1.0.0", "description": "Hide posts from verified users on X.com (formerly Twitter)", "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Xitter Blues Settings"}, "applications": {"gecko": {"id": "xitter-blues@example.com", "strict_min_version": "58.0"}}}