{"manifest_version": 2, "name": "Study Session Tracker", "version": "1.3", "description": "Track focused study sessions and total learning time.", "permissions": ["storage", "alarms"], "browser_action": {"default_title": "Study Session Tracker", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Study-Session-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}