{"manifest_version": 2, "name": "BIGLOVE.AI Container Importer", "description": "Imports Multi-Containers from an Airtable base.", "version": "1.7.9", "browser_specific_settings": {"gecko": {"id": "biglove@container-importer-addons", "strict_min_version": "91.1.0"}}, "icons": {"48": "icons/icon48.png"}, "permissions": ["proxy", "storage", "contextualIdentities", "notifications", "https://api.airtable.com/*", "tabs", "activeTab", "scripting", "alarms"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"browser_style": true, "default_icon": "icons/icon48.png", "default_title": "BIGLOVE.AI Container Importer", "default_popup": "login.html", "default_area": "navbar", "theme_icons": [{"light": "icons/icon48.png", "dark": "icons/icon48.png", "size": 48}]}, "commands": {"clear-containers": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Clear all containers"}}}