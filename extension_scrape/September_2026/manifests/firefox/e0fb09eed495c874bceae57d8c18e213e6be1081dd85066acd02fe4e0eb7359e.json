{"manifest_version": 3, "name": "FPN Reader", "version": "0.6.5", "description": "A locally-rendered reader for fountainpennetwork.com that cuts thread views from ~71 requests to 1 and blocks the chatbox poll.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["lib/api.js", "lib/util.js", "lib/urls.js", "lib/governor.js", "lib/store.js", "sw.js"]}, "browser_specific_settings": {"gecko": {"id": "fpn-reader@fountainpennetwork.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://www.fountainpennetwork.com/*"], "content_scripts": [{"matches": ["https://www.fountainpennetwork.com/*"], "exclude_matches": ["https://www.fountainpennetwork.com/forum/messenger/*", "https://www.fountainpennetwork.com/forum/notifications/*", "https://www.fountainpennetwork.com/forum/settings/*", "https://www.fountainpennetwork.com/forum/modcp/*", "https://www.fountainpennetwork.com/forum/admin/*"], "js": ["lib/api.js", "lib/util.js", "lib/urls.js", "lib/sanitize.js", "lib/parse.js", "content/styles.js", "content/hud.js", "content/editor.js", "content/compose.js", "content/reader.js"], "css": ["content/hide-chatbox.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "FPN Reader", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "declarative_net_request": {"rule_resources": [{"id": "chatbox", "enabled": true, "path": "rules/chatbox.json"}, {"id": "ads", "enabled": false, "path": "rules/ads.json"}]}, "web_accessible_resources": [{"resources": ["content/editor-bridge.js"], "matches": ["https://www.fountainpennetwork.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}