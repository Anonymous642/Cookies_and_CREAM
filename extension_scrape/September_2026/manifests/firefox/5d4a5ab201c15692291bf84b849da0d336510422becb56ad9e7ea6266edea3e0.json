{"manifest_version": 3, "name": "Facebook Photo Extractor", "version": "1.2.3", "description": "Extract Facebook profile and cover image URLs from your active Facebook tab.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Facebook Photo Extractor", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab", "scripting", "downloads", "storage"], "host_permissions": ["https://*.facebook.com/*", "http://*.facebook.com/*"], "content_scripts": [{"matches": ["https://*.facebook.com/*", "http://*.facebook.com/*", "https://*.fb.com/*", "http://*.fb.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "facebook-photo-extractor@ayoxic.dev", "data_collection_permissions": {"required": ["none"]}}}}