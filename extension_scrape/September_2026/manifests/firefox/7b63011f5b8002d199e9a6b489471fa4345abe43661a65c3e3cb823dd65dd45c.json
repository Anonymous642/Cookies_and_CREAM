{"manifest_version": 3, "name": "YouTrack Time Tracker", "version": "1.0.0", "description": "Track time for YouTrack tasks directly from your browser", "permissions": ["storage", "activeTab", "scripting", "identity"], "host_permissions": ["https://*.youtrack.cloud/*", "https://*.youtrack.jetbrains.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.youtrack.cloud/*", "https://*.youtrack.jetbrains.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/logo-ed-16.png", "48": "icons/logo-ed-48.png", "128": "icons/logo-ed-128.png"}, "browser_specific_settings": {"gecko": {"id": "youtrack-time-tracker@yarandin.com", "strict_min_version": "58.0", "strict_max_version": "138.*"}}}