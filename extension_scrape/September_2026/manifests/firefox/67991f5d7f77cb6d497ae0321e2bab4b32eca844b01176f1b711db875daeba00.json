{"manifest_version": 3, "name": "Readable IMSLP PDFs", "description": "Automatically gives IMSLP PDF downloads readable, user-configurable names from score metadata.", "version": "1.2.0", "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["https://*.imslp.org/*", "https://*.imslp.eu/*", "https://*.imslp.info/*", "https://*.petruccimusiclibrary.ca/*", "https://*.imslp.tw/*"], "background": {"scripts": ["lib/naming.js", "firefox-background.js"]}, "action": {"default_title": "Readable IMSLP PDFs", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.imslp.org/wiki/*", "https://*.imslp.eu/wiki/*"], "js": ["lib/naming.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "readable-imslp-pdfs@codex.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}