{"manifest_version": 3, "name": "YouTube Rabbit", "version": "1.0.3", "description": "A YouTube extension that allows users to watch videos at 4x speed and apply various visual filters for a unique viewing experience.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "tabs"], "action": {"default_icon": "icon48.png", "default_title": "YouTube Rabbit"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["update.html"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "ukihunter@github.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}