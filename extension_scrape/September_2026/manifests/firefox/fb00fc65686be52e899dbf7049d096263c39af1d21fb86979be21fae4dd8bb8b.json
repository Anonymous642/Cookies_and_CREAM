{"manifest_version": 3, "name": "AdvisorReach", "version": "0.1.0", "description": "Companion extension for your AdvisorReach assistant.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "advisorreach-connector@advisorreach.ai", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "content_scripts": [{"matches": ["https://advisorreach.ai/*"], "js": ["src/connect-mcp/content.js"], "run_at": "document_start", "all_frames": false}], "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.boxes.advisorreach.ai/*"], "x_box_origin_pattern": "https://*.boxes.advisorreach.ai/*", "web_accessible_resources": [{"resources": ["src/connect-mcp/result.html"], "matches": ["<all_urls>"]}]}