{"manifest_version": 2, "name": "Kainos HL7 Editor Companion", "description": "Detect HL7 v2 messages on any page and edit them in the Kainos HL7 Editor desktop app \u2014 entirely on-device.", "version": "1.0.2", "short_name": "HL7 Editor", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "clipboardRead", "clipboardWrite", "alarms"], "optional_permissions": ["*://*/*"], "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;", "web_accessible_resources": ["editor-bridge.js"], "browser_specific_settings": {"gecko": {"id": "hl7-editor-extension@kainoshealthcare.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "HL7 Editor Companion", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "js": ["content-scripts/hl7-detector.js"]}]}