{"manifest_version": 3, "name": "PomodoroTimer", "version": "1.0.0", "description": "Pomodoro productivity timer. 25 min work + 5 min break with notifications.", "icons": {"48": "pomodoro-icons/icon-48.png", "96": "pomodoro-icons/icon-96.png", "128": "pomodoro-icons/icon-128.png"}, "action": {"default_icon": {"48": "pomodoro-icons/icon-48.png", "96": "pomodoro-icons/icon-96.png"}, "default_title": "PomodoroTimer", "default_popup": "timer-ui/display.html"}, "permissions": ["notifications", "storage"], "browser_specific_settings": {"gecko": {"id": "pomodoro@productivity.timer", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}