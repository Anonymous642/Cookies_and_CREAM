{"manifest_version": 3, "name": "Instagram DM Exporter", "version": "1.2.2", "description": "Exporte une conversation Instagram (DM), enti\u00e8re ou sur une p\u00e9riode \u2014 avec ou sans m\u00e9dias \u2014 en HTML, JSON et TXT.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Ouvrir l\u2019exporteur Instagram (panneau lat\u00e9ral)", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "permissions": ["storage"], "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ig-dm-exporter@khalilbenaz", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "sidebar_action": {"default_title": "Instagram DM Exporter", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"scripts": ["background.js"]}}