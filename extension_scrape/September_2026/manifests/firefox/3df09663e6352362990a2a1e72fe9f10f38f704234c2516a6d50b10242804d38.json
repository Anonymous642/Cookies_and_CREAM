{"manifest_version": 3, "name": "OAI-turnend-notification", "version": "0.1.3", "description": "Notify when a normal ChatGPT chat response finishes, with selectable extension-side sounds.", "browser_specific_settings": {"gecko": {"id": "@oai-turnend-notification", "strict_min_version": "153.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["notifications", "storage", "tabs"], "host_permissions": ["https://chatgpt.com/*"], "background": {"page": "background.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "OAI-turnend-notification settings", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "developer": {"name": "\u95a2\u6771\u6a5f\u95a2/\u7957\u5712\u7652\u5fcc"}, "author": "\u95a2\u6771\u6a5f\u95a2/\u7957\u5712\u7652\u5fcc"}