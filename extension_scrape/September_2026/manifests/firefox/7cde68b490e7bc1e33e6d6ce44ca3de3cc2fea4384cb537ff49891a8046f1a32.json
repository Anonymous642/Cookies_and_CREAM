{"manifest_version": 3, "name": "Steam Cards Bulk Seller", "version": "1.0.0", "description": "Bulk-list Steam trading cards on the Community Market with configurable pricing and rate-limited queueing.", "author": "adrianvfx@gmail.com", "permissions": ["storage", "activeTab"], "host_permissions": ["*://steamcommunity.com/*"], "action": {"default_title": "Steam Cards Bulk Seller", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://steamcommunity.com/market/*", "*://steamcommunity.com/id/*/inventory*", "*://steamcommunity.com/profiles/*/inventory*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://steamcommunity.com/*"]}], "browser_specific_settings": {"gecko": {"id": "steam-cards-bulk-seller@adrianvfx", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}