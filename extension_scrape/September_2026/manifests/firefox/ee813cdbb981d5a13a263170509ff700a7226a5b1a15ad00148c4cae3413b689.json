{"manifest_version": 3, "name": "Sabanci University - Personel Shuttle Tool", "version": "1.1.2", "description": "Automatic login credentials on su.infotraq.com and access reservation via popup.", "permissions": ["storage"], "host_permissions": ["https://*.infotraq.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Infotraq Servisler"}, "sidebar_action": {"default_panel": "popup.html?view=sidebar", "default_title": "Infotraq Servisler"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://su.infotraq.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://su.infotraq.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://su.infotraq.com/*"], "js": ["capture-bridge.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "infotraq-shuttle@cospace", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}