{"manifest_version": 3, "name": "Tab Queue", "version": "0.1.3", "description": "Queue tabs, especially YouTube videos, and step through them from a compact popup UI.", "icons": {"16": "icons/queue-16.png", "32": "icons/queue-32.png", "48": "icons/queue-48.png", "96": "icons/queue-96.png", "128": "icons/queue-128.png"}, "permissions": ["storage", "tabs", "contextMenus"], "action": {"default_title": "Tab Queue", "default_popup": "popup.html", "default_icon": {"16": "icons/queue-16.png", "32": "icons/queue-32.png", "48": "icons/queue-48.png"}}, "browser_specific_settings": {"gecko": {"id": "tab-queue@wardenx.dev", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"queue-current-tab": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Queue the current tab"}, "queue-and-close-current-tab": {"suggested_key": {"default": "Ctrl+Alt+Q"}, "description": "Queue the current tab and close it"}, "open-next-queued-item": {"suggested_key": {"default": "Ctrl+Alt+N"}, "description": "Open the next queued item"}, "open-base-tab": {"suggested_key": {"default": "Ctrl+Shift+B"}, "description": "Open the base tab"}}}