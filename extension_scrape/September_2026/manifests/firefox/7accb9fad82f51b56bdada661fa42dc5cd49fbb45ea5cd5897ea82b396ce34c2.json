{"manifest_version": 2, "name": "Clear Domain Data", "version": "0.0.2", "description": "Configure a list of domains, then press F9 to clear cookies and site data for those domains. Click the toolbar button to manage your domain list.", "permissions": ["cookies", "browsingData", "storage", "notifications", "<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "clear-domain-data@jkomoroski", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"id": "clear-domain-data@jkomoroski", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Clear Domain Data"}, "commands": {"clear-cookies": {"suggested_key": {"default": "F9"}, "description": "Clear cookies for configured domains"}}}