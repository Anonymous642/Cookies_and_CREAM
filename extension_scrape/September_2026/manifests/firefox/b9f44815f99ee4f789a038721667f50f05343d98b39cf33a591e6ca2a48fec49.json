{"manifest_version": 2, "name": "YouTube AdBlock Reload Enhancer Pro", "version": "3.0", "description": "Advanced AdBlock detection and reload system for YouTube with precision controls", "browser_specific_settings": {"gecko": {"id": "saem@saemstunes.com", "strict_min_version": "109.0"}}, "permissions": ["tabs", "webRequest", "webNavigation", "scripting", "storage", "activeTab", "alarms", "data_collection_permissions"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "YouTube AdBlock Reload Enhancer", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}, "test_detection": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Test AdBlock detection"}, "abort_reload": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Abort pending reload"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}}