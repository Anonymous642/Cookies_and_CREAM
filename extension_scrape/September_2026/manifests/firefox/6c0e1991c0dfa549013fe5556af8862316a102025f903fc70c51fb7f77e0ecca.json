{"manifest_version": 2, "name": "AI Test Helper", "version": "1.0", "description": "Highlights text and gets AI answers in a small overlay", "permissions": ["activeTab", "storage", "https://generativelanguage.googleapis.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png"}}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "ai-test-helper@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}