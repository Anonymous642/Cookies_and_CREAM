{"manifest_version": 3, "name": "Cookie Guardian Ultimate", "version": "2.1.0", "description": "Local-first cookie security, threat detection, monitoring and privacy dashboard.", "permissions": ["cookies", "storage", "tabs", "notifications", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Cookie Guardian", "default_popup": "popup/popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "options_ui": {"page": "dashboard/index.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "blocked_domains", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "cookieguardian-ultimate@example.local", "strict_min_version": "109.0"}}}