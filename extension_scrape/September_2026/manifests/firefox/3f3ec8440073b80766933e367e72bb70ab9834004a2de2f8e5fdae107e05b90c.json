{"manifest_version": 3, "name": "Tab Manager Pro", "version": "1.0.0", "description": "A powerful tab management extension with window grouping, search, and session management", "browser_specific_settings": {"gecko": {"id": "tab-manager-pro@vizepulse101", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "sessions"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}