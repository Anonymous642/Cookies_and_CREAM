{"manifest_version": 2, "name": "Cost Keeper", "version": "4.0.1", "description": "Track the price of things you plan to buy. Everything stays on your machine: no accounts, no servers, no scraping.", "browser_specific_settings": {"gecko": {"id": "{2b78e24f-615f-4d68-a4ab-367fe34e27bf}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_action": {"default_title": "Cost Keeper", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}}, "permissions": ["storage", "activeTab", "notifications"], "background": {"scripts": ["app/background.js"]}}