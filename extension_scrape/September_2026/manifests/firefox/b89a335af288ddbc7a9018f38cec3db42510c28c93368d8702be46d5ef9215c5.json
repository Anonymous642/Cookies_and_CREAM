{"manifest_version": 3, "name": "DrossFilter", "short_name": "DrossFilter", "version": "1.1.1", "description": "Premium Ad and tracker shield", "homepage_url": "https://github.com/dhakalkumar/drossfilter", "author": "Kumar", "developer": {"name": "Kumar", "url": "https://github.com/dhakalkumar"}, "permissions": ["storage", "tabs", "declarativeNetRequest", "webRequest", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/browser-polyfill.min.js", "background.js"]}, "action": {"default_title": "DrossFilter", "default_icon": {"16": "drossfilter-icon-active.png", "48": "drossfilter-icon-active.png", "128": "drossfilter-icon-active.png"}, "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.min.js", "content.js"], "run_at": "document_start", "all_frames": true}], "icons": {"16": "drossfilter-icon-active.png", "48": "drossfilter-icon-active.png", "128": "drossfilter-icon-active.png"}, "declarative_net_request": {"rule_resources": [{"id": "main_rules", "enabled": true, "path": "rules/rules.json"}, {"id": "annoyance_rules", "enabled": true, "path": "rules/rules_annoyances.json"}, {"id": "social_rules", "enabled": true, "path": "rules/rules_social.json"}, {"id": "param_rules", "enabled": true, "path": "rules/rules_params.json"}]}, "browser_specific_settings": {"gecko": {"id": "drossfilter@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}