{"manifest_version": 2, "name": "KpiClock", "description": "Official browser extension for KpiClock.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "activeTab"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "KpiClock", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.clickup.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["*://huly.boomdevs.net/workbench/*/tracker/*"], "css": ["content-scripts/huly.css"], "js": ["content-scripts/huly.js"]}], "browser_specific_settings": {"gecko": {"id": "extension@kpiclock.com"}}}