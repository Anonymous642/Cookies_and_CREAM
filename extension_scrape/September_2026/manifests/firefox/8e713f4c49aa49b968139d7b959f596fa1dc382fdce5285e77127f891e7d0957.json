{"manifest_version": 3, "name": "UniLayer", "short_name": "UniLayer", "version": "0.7.0", "description": "Your university, your workspace. Find it, understand it, make it yours.", "browser_specific_settings": {"gecko": {"id": "unilayer@unilayer.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "UniLayer", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "sidebar_action": {"default_title": "UniLayer workspace", "default_panel": "popup/sidepanel.html", "default_icon": "icons/icon-48.png", "open_at_install": false}, "permissions": ["alarms", "storage", "unlimitedStorage", "activeTab", "contextMenus", "scripting"], "optional_host_permissions": ["https://*/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+U", "mac": "Alt+U"}, "description": "Open UniLayer"}, "open-palette": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Open the UniLayer command palette on the current page"}, "toggle-widget": {"description": "Show or hide the UniLayer contextual widget"}, "open-workspace": {"description": "Open the full UniLayer workspace"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'"}, "web_accessible_resources": [{"resources": ["ui/tokens.css", "ui/kumo.css", "content/widget.css", "icons/*"], "matches": ["https://*/*"]}]}