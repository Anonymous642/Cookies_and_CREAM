{"manifest_version": 2, "name": "Quiet Feed: Hide Posts by Keyword", "version": "2.2", "author": "Petru", "description": "Hide whole posts containing your chosen words on YouTube, Reddit and X. Hides rather than removes, so feeds don't spiral into reloading, and silences video in hidden posts.", "browser_specific_settings": {"gecko": {"id": "quietfeed@petru", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "permissions": ["storage", "*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://*.twitter.com/*"], "optional_permissions": ["downloads", "https://i.ytimg.com/*", "https://i.redd.it/*", "https://preview.redd.it/*", "https://cf.preview.redd.it/*", "https://external-preview.redd.it/*", "https://pbs.twimg.com/*"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';", "background": {"scripts": ["src/vendor/tesseract/tesseract.min.js", "src/common.js", "src/ocr.js", "src/background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.x.com/*", "*://*.twitter.com/*"], "js": ["src/common.js", "src/content.js"], "css": ["src/hidden.css"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_popup": "src/popup.html", "default_title": "Quiet Feed", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}