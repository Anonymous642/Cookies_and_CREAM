{"manifest_version": 3, "name": "Rasto's Kimai Tracker", "version": "0.10.1", "description": "Track time in Kimai directly from GitLab issues. Kimai is an open-source time tracker that replaces expensive SaaS services. This extension adds a Start/Stop button right into your GitLab issues.", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/kimai-16.png", "48": "icons/kimai-48.png", "128": "icons/kimai-128.png"}}, "icons": {"16": "icons/kimai-16.png", "48": "icons/kimai-48.png", "128": "icons/kimai-128.png"}, "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "kimai-tracker@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}