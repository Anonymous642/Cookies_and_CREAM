{"manifest_version": 2, "name": "Security.txt Finder", "version": "1.0.0", "description": "Detecta autom\u00e1ticamente archivos security.txt en sitios web seg\u00fan RFC 9116. Muestra alertas visuales cuando encuentra informaci\u00f3n de contacto de seguridad.", "author": "Damian Gambacorta", "homepage_url": "https://www.olivex.io", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["activeTab", "webNavigation", "tabs", "<all_urls>", "notifications"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icon.svg", "default_title": "Security.txt Finder", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "security-txt-finder@extension.local", "strict_min_version": "58.0"}}}