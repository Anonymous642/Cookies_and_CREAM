{"manifest_version": 3, "name": "Driftboard", "version": "0.1.1", "description": "A customizable, widget-based new tab dashboard.", "browser_specific_settings": {"gecko": {"id": "driftboard@bluezero.sk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo", "browsingActivity", "searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "developer": {"name": "BlueZero"}, "chrome_url_overrides": {"newtab": "src/newtab/newtab.html"}, "permissions": ["storage", "bookmarks", "topSites"], "optional_permissions": ["geolocation"], "host_permissions": ["https://api.unsplash.com/*", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://wttr.in/*", "https://api.frankfurter.dev/*"], "optional_host_permissions": ["*://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}