{"manifest_version": 3, "name": "Quick Tab Notes", "version": "1.0.0", "description": "Ghi nhanh ghi ch\u00fa cho trang hi\u1ec7n t\u1ea1i. D\u1eef li\u1ec7u l\u01b0u c\u1ee5c b\u1ed9, kh\u00f4ng chia s\u1ebb ra ngo\u00e0i.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs"], "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Quick Tab Notes", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": []}], "browser_specific_settings": {"gecko": {"id": "quick-tab-notes@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}