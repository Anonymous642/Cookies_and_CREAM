{"manifest_version": 2, "name": "SmootherOfPAGE", "version": "1.0.1", "description": "Physics-based smooth scrolling for the mouse wheel and arrow keys. All input funnels into one momentum calculation, so mixed input and direction changes always stay smooth.", "author": "me;)", "permissions": ["storage"], "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "96": "img/icon96.png", "128": "img/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "smootherofpage@user.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"run_at": "document_start", "matches": ["<all_urls>"], "match_about_blank": true, "all_frames": true, "js": ["util.js", "scroller.js", "content.js"]}], "background": {"scripts": ["util.js", "background.js"]}, "browser_action": {"browser_style": true, "default_icon": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png"}, "default_title": "SmootherOfPAGE", "default_popup": "popup.html"}}