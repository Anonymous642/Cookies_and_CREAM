{"manifest_version": 2, "name": "Locktin \u2014 Website Blocker", "description": "Block distracting sites with rules that are hard to undo on impulse. Pairs with the Locktin app; your browsing stays on your device.", "version": "2.0.0", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs", "webNavigation", "*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*", "<all_urls>", "webRequest", "webRequestBlocking", "nativeMessaging"], "browser_specific_settings": {"gecko": {"strict_min_version": "140.0", "id": "info@getlocktin.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "browser_action": {"default_title": "Locktin", "default_popup": "popup.html"}, "web_accessible_resources": ["blocked.html", "blocked.js"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/block-enforce.js"]}, {"matches": ["*://*.instagram.com/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/instagram.js"]}, {"matches": ["*://*.reddit.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/reddit.js"]}, {"matches": ["*://*.youtube.com/*"], "all_frames": true, "run_at": "document_start", "css": ["content-scripts/youtube.css"], "js": ["content-scripts/youtube.js"]}]}