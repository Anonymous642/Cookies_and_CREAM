{"manifest_version": 3, "name": "RoodyPass", "description": "Rellena tus contrase\u00f1as autom\u00e1ticamente con RoodyPass. Conecta con la app de escritorio para hacer autofill seguro.", "version": "1.0.3", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["http://127.0.0.1:49153/*", "https://127.0.0.1:49153/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"service_worker": "background/scripts.js", "scripts": ["background/scripts.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "browser_specific_settings": {"gecko": {"id": "roodypass@roody.es", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}