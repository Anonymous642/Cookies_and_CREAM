{"manifest_version": 3, "name": "Tab Harbor", "version": "1.2.0", "description": "Automatically backs up Firefox windows, tabs, and native tab groups for safe recovery.", "permissions": ["tabs", "tabGroups", "alarms", "storage", "downloads"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "manager.html", "open_in_tab": true}, "action": {"default_title": "Tab Harbor", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-harbor@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}