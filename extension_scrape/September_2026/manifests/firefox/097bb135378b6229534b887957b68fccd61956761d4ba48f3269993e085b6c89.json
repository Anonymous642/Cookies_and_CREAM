{"manifest_version": 3, "name": "Save to Nifty Gifts", "description": "Create personal gift lists, share and collaborate, and avoid duplicate gifts", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "identity", "contextMenus", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Nifty Gifts", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Nifty Gifts capture"}}, "browser_specific_settings": {"gecko": {"id": "capture@nifty.gifts", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["*://*.nifty.gifts/oauth2/safari*"], "run_at": "document_start", "js": ["content-scripts/oauth-callback.js"]}]}