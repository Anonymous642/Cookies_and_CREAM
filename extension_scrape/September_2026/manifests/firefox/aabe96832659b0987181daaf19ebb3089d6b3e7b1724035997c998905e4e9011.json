{"manifest_version": 2, "name": "Blue Check Hider", "version": "1.0.0", "description": "Hide posts from blue-check verified users on X/Twitter.", "browser_specific_settings": {"gecko": {"id": "blue-check-hide@unedotampubolon.com", "data_collection_permissions": {"description": "This extension does not collect any data. All processing happens locally on your device.", "required": ["none"]}}}, "permissions": ["storage", "*://*.x.com/*", "*://*.twitter.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Blue Check Hider", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}