{"manifest_version": 3, "name": "Ather Notepad - Quick and Cool Notes", "short_name": "Ather Notepad", "version": "2.0.4", "description": "A versatile, clutter-free notepad accessible via new tab, popup or side panel. Features Markdown, zen mode and backups to bookmarks.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Open Notepad", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["storage", "bookmarks", "tabs", "contextMenus", "downloads"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Ather Notepad", "default_icon": "icon32.png"}, "browser_specific_settings": {"gecko": {"id": "athersultanabrand@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}