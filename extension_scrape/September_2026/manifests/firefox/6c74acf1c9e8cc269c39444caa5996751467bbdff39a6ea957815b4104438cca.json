{"manifest_version": 3, "name": "VeloFill", "description": "Fill at the speed of thought - High-velocity form completion powered by AI", "icons": {"32": "icon.svg", "64": "icon.svg"}, "permissions": ["storage", "activeTab"], "action": {"default_icon": "icon.svg", "default_title": "VeloFill", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*/*", "http://*/*", "file:///*"], "js": ["content.js"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "addon@velofill.com"}}, "version": "1.3.3"}