{"manifest_version": 2, "name": "OttoFill", "version": "0.1.7", "description": "Otto remembers every form you fill and fills new ones for you \u2014 privately, on your device.", "author": "Bala Kumar", "homepage_url": "https://ottofill.xyz", "browser_specific_settings": {"gecko": {"id": "ottofill@balakumar.dev", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}, "browser_action": {"default_title": "OttoFill", "default_popup": "popup.html", "default_icon": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}}, "permissions": ["storage", "<all_urls>"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "background": {"page": "dist/background.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": ["dist/ort/ort-wasm-simd-threaded.asyncify.mjs", "dist/ort/ort-wasm-simd-threaded.asyncify.wasm", "onboarding.html"]}