{"manifest_version": 3, "name": "Canvas Course Wiper", "version": "1.0.0", "description": "Bulk-delete assignments, modules, pages, files, discussions, announcements, and quizzes from a Canvas course you have instructor access to.", "author": "Osman Sayginer", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*.instructure.com/*"], "action": {"default_popup": "popup.html", "default_title": "Canvas Course Wiper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.instructure.com/courses/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "canvas-course-wiper@local.dev", "data_collection_permissions": {"required": ["none"]}}}}