{"manifest_version": 2, "name": "TextSnap: Share as Image", "version": "1.0.0", "description": "Convert selected text into shareable images with QR code links. Note: Uses html2canvas.min.js which has known risks associated with innerHTML usage; this is a controlled usage.", "content_security_policy": "script-src 'self'; object-src 'self';", "permissions": ["activeTab", "clipboardWrite", "contextMenus", "downloads", "storage", "<all_urls>"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "qrcode.min.js", "html2canvas.min.js", "content.js"]}], "web_accessible_resources": ["qrcode.min.js", "html2canvas.min.js"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "textsnap@example.com", "strict_min_version": "58.0"}}}