{"manifest_version": 2, "name": "Rhythm Typist", "version": "1.0", "description": "Plays a small drum hit on keystrokes in input fields; typing faster increases the beat rate.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Rhythm Typist", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "rhythms_typist@example.com"}}}