{"manifest_version": 3, "name": "Turn Into Dark Mode", "version": "1.0.0", "description": "Right-click any page and turn it into dark mode. Remembers your choice per site.", "author": "aryanpxcr7", "homepage_url": "https://github.com/aryanpxcr7/Firefox-dark-mode-extension", "browser_specific_settings": {"gecko": {"id": "turn-into-dark-mode@aryan", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["contextMenus", "menus", "storage", "scripting"], "host_permissions": ["<all_urls>", "file:///*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": false}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}