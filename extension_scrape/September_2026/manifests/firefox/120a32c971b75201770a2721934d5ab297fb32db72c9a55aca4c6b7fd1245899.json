{"manifest_version": 2, "name": "Stackyard", "description": "Preview any public GitHub repo running live, right from its repo page.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "https://github.com/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}, "id": "{d92aa1c4-d968-4f3b-9253-903c0e6c53a3}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Stackyard", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://github.com/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://stackyard.vercel.app/*"], "run_at": "document_start", "js": ["content-scripts/extension-marker.js"]}, {"matches": ["*://stackyard.vercel.app/*"], "js": ["content-scripts/message-bridge.js"]}]}