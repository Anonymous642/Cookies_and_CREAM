{"manifest_version": 3, "name": "UnitNormalize", "version": "1.3.0", "description": "Fights shrinkflation. Instantly calculates price-per-unit badges on Amazon search results so you always know the real deal.", "author": "UnitNormalize", "browser_specific_settings": {"gecko": {"id": "unitnormalize@vibe.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*"], "content_scripts": [{"matches": ["*://*.amazon.com/s*", "*://*.amazon.co.uk/s*", "*://*.amazon.ca/s*", "*://*.amazon.com.au/s*", "*://*.amazon.de/s*", "*://*.amazon.fr/s*", "*://*.amazon.it/s*", "*://*.amazon.es/s*", "*://*.amazon.co.jp/s*"], "js": ["converter.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "UnitNormalize", "default_icon": "icons/icon48.svg"}, "icons": {"48": "icons/icon48.svg", "128": "icons/icon128.svg"}}