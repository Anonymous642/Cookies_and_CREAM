{"manifest_version": 3, "name": "Resizer & Cropper", "version": "1.2", "description": "Firefox extension to crop, flip, and enlarge images with automatic background color matching.", "permissions": ["contextMenus", "storage", "unlimitedStorage", "activeTab", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "action": {"default_title": "Open Resizer & Cropper"}, "browser_specific_settings": {"gecko": {"id": "resizer-cropper@extensions.ksandroid.pl", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}