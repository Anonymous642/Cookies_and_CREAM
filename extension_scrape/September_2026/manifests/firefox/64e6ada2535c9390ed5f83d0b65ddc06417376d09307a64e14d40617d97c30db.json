{"manifest_version": 2, "name": "Discord Token Saver", "version": "1.0", "description": "Save your Discord token when logged in", "permissions": ["storage", "downloads", "https://discord.com/*"], "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "discord-token-saver@example.com", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}}}