{"manifest_version": 3, "name": "Clipboard formatting and line break remover", "version": "1.0", "description": "Removes formatting and optionally line breaks from clipboard text on click.", "browser_specific_settings": {"gecko": {"id": "@clipboard-formatting-and-line-break-remover"}}, "permissions": ["clipboardRead", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Remove line breaks", "theme_icons": [{"light": "icons/dark-theme/icon.svg", "dark": "icons/light-theme/icon.svg", "size": 128}]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Run the default action"}}}