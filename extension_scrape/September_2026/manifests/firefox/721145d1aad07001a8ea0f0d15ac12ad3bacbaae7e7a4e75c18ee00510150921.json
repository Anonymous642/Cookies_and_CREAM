{"manifest_version": 2, "name": "Aegis-Shield", "version": "1.2.2", "description": "A clean Firefox privacy shield with aggressive preset blocklists, site compatibility exceptions, anti-fingerprinting, and local-only settings.", "author": "Aegis-Shield Project", "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs", "cookies", "webNavigation", "downloads", "notifications", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Aegis-Shield", "default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon-active-16.png", "32": "assets/icons/icon-active-32.png", "48": "assets/icons/icon-active-48.png", "128": "assets/icons/icon-active-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["page-script.js", "logger.html", "assets/icons/icon-active-16.png", "assets/icons/icon-active-32.png", "assets/icons/icon-active-48.png", "assets/icons/icon-active-128.png", "assets/icons/icon-paused-16.png", "assets/icons/icon-paused-32.png", "assets/icons/icon-paused-48.png", "assets/icons/icon-paused-128.png"], "content_security_policy": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline';", "browser_specific_settings": {"gecko": {"id": "aegis-shield@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}