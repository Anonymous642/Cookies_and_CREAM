{"manifest_version": 3, "name": "ChatFlow \u2014 AI Chat Optimizer", "version": "2.0.0", "browser_specific_settings": {"gecko": {"id": "chatflow@chatflow.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "AI Chat Optimizer for ChatGPT, Claude, Gemini & Grok. Token counter, export (DOCX/TXT/MD/CSV/XLSX), chat search, pinned facts, compact mode & more. 100% local \u2014 no data collected.", "permissions": ["storage", "contextMenus", "scripting", "downloads", "tabs"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.com/i/grok*"], "background": {"service_worker": "src/background/worker.js", "scripts": ["src/background/worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.com/i/grok*"], "js": ["src/utils/logger.js", "src/utils/storage.js", "src/utils/tokenCounter.js", "src/utils/license.js", "src/utils/promptLibrary.js", "src/utils/exporter.js", "src/content/platforms.js", "src/content/messageStore.js", "src/content/virtualScroll.js", "src/content/observer.js", "src/content/index.js"], "css": ["styles/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*", "styles/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://x.com/i/grok*"]}]}