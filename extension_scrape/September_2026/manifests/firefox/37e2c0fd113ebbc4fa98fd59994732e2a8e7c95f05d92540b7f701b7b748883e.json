{"manifest_version": 2, "name": "Kinen \u2014 Save to Library", "description": "Save any page to your Kinen library with one click", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "cookies", "https://kinen.app/*", "http://127.0.0.1:3000/*", "http://localhost:3000/*"], "browser_specific_settings": {"gecko": {"id": "extension@kinen.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://kinen.app/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}