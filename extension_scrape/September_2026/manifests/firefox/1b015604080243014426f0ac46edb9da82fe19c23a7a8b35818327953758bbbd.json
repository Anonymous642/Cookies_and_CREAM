{"manifest_version": 3, "name": "Radiadores Frontera Extractor", "version": "1.0.0", "description": "Extrae datos estructurados de portales autorizados y los almacena directamente en Google Sheets.", "browser_specific_settings": {"gecko": {"id": "radiadores-frontera-extractor@addons.mozilla.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["floating.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["logos/*"], "matches": ["<all_urls>"]}]}