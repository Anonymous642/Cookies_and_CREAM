{"manifest_version": 2, "name": "ScrollSage", "version": "1.0", "description": "Stop doomscrolling and start exploring. Enhance your Twitter experience with ScrollSage.", "icons": {"48": "icons/scrollsage-48.png", "96": "icons/scrollsage-96.png"}, "permissions": ["activeTab", "storage", "https://twitter.com/*", "https://api.twitter.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "browser_action": {"default_icon": "icons/scrollsage-48.png", "default_title": "ScrollSage", "default_popup": "popup.html"}, "web_accessible_resources": ["icons/*", "styles.css"], "browser_specific_settings": {"gecko": {"id": "{deeecd9c-8c94-49e0-91eb-6aa259283e2c}"}}}