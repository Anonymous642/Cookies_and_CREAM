{"manifest_version": 3, "name": "Alice", "version": "1.0.1", "description": "Browser extension for Alice \u2014 generate email aliases without leaving the sign-up form", "homepage_url": "https://git.aktech.fr/alice/alice", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "alarms"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "Alice", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "alice@lagache.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}