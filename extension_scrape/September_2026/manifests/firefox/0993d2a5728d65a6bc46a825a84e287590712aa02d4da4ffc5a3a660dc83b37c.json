{"manifest_version": 2, "name": "Emoji Board", "version": "2.4.3", "description": "A quick emoji board in your toolbar. Type to search by keyword, switch between categories, and tap an emoji to copy it. Your most recent picks stay one click away.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{d6f04a2b-4995-44e6-aca3-0ea0c92fab1d}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "clipboardWrite"], "browser_action": {"default_title": "Emoji Board", "default_popup": "app/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}