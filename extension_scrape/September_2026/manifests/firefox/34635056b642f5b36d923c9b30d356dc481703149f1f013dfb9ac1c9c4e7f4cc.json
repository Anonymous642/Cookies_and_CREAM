{"manifest_version": 3, "name": "Claude Search", "version": "1.2.0", "description": "Use Claude (claude.ai) as a search engine \u2014 auto-submits your query.", "browser_specific_settings": {"gecko": {"id": "claude-search@antoyo", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "chrome_settings_overrides": {"search_provider": {"name": "Claude", "keyword": "@claude", "search_url": "https://claude.ai/new?q={searchTerms}&ref=claude-search", "encoding": "UTF-8", "favicon_url": "icons/icon-16.png"}}, "content_scripts": [{"matches": ["*://claude.ai/*"], "js": ["content.js"], "run_at": "document_start"}]}