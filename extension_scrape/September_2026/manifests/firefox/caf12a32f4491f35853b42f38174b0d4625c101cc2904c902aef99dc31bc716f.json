{"manifest_version": 3, "name": "Smart Block Blast Solver", "short_name": "Block Blast Solver", "version": "1.0.0", "description": "Instantly solve Block Blast puzzles with AI. Upload a screenshot or draw your board in manual mode \u2014 get step-by-step optimal move suggestions.", "browser_specific_settings": {"gecko": {"id": "smartblockblastsolver@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Smart Block Blast Solver"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://smartblockblastsolver.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://smartblockblastsolver.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+B", "mac": "Alt+B"}, "description": "Open Smart Block Blast Solver"}}}