{"manifest_version": 3, "name": "PageKeep \u2014 Save Page to PDF", "version": "0.1.0", "minimum_chrome_version": "121", "description": "Save any page as a PDF, including pages you are signed in to. Nothing is uploaded, no account, no watermark.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "PageKeep"}, "commands": {"save-pdf": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Save this page as a PDF"}}, "browser_specific_settings": {"gecko": {"id": "pagekeep@pagekeep.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}