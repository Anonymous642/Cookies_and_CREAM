{"manifest_version": 2, "name": "Container Hotkeys", "version": "1.4resigned1", "description": "Adds a hotkey to \"Open New Tab in Container\" and \"Toggle Container's Tab Visibility\".", "icons": {"16": "icon16.png", "24": "icon24.png", "32": "icon32.png", "48": "icon.svg", "64": "icon64.png", "96": "icon.svg", "128": "icon128.png", "256": "icon256.png", "512": "icon512.png"}, "commands": {"toggle-tab-visibility": {"suggested_key": {"default": "Ctrl+Alt+B"}, "description": "Toggle visibility of all tabs in container."}, "open-new-tab": {"suggested_key": {"default": "Ctrl+Alt+T"}, "description": "Opens a new tab in this container."}}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs", "tabHide", "contextualIdentities", "cookies", "notifications", "storage"], "options_ui": {"page": "options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "{623c8754-ad92-4667-9acf-7241a2923b2f}"}}}