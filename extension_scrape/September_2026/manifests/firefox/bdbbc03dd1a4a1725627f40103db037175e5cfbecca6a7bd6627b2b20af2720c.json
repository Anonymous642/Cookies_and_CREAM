{"manifest_version": 3, "name": "FeedFluffy Auto-Feeder", "version": "1.1", "description": "Auto-feed Fluffy when you browse your favorite sites.", "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["https://feedfluffy.com/*"], "js": ["content.js"]}], "host_permissions": ["https://feedfluffy.com/*"], "icons": {"16": "fluffy16.png", "32": "fluffy32.png", "48": "fluffy48.png", "128": "fluffy128.png"}, "action": {"default_icon": {"16": "fluffy16.png", "32": "fluffy32.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "feeder@feedfluffy.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}