{"manifest_version": 3, "name": "ScamRadar \u2014 Email Threat Detector", "version": "1.0.0", "description": "Instantly flags scam, phishing, and crypto fraud emails in your inbox before you open them.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "ScamRadar"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*", "https://mail.proton.me/*", "https://account.proton.me/mail/*", "https://app.fastmail.com/*", "https://www.fastmail.com/*", "https://mail.zoho.com/*"], "js": ["content/scanner.js", "content/injector.js"], "css": ["content/badges.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab"], "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://mail.yahoo.com/*", "https://mail.proton.me/*", "https://account.proton.me/mail/*", "https://app.fastmail.com/*", "https://www.fastmail.com/*", "https://mail.zoho.com/*"], "browser_specific_settings": {"gecko": {"id": "scamradar@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}