{"manifest_version": 3, "name": "Clipdown \u2014 Web to Markdown", "version": "1.2.0", "description": "Smart Markdown copier. Copy web content as clean Markdown with source citations, smart titles & reading time estimates.", "author": "Suhas Holla", "homepage_url": "https://github.com/suhashollakc/clipdown", "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["src/background.js"]}, "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"copy-selection-markdown": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Alt+Shift+C"}, "description": "Copy selection as Markdown"}, "copy-page-markdown": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Copy entire page as Markdown"}}, "browser_specific_settings": {"gecko": {"id": "clipdown@suhashollakc.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}