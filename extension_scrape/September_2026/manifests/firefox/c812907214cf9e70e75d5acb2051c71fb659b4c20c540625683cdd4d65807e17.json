{"manifest_version": 3, "name": "Orbit", "version": "0.4.6", "description": "A keyboard browsing layer and personal homepage for Zen.", "icons": {"16": "assets/orbit-16.png", "32": "assets/orbit-32.png", "48": "assets/orbit-48.png", "96": "assets/orbit-96.png"}, "permissions": ["tabs", "history", "clipboardWrite", "search", "scripting", "storage", "sessions", "browserSettings"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["core.js", "commands.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["core.js", "vimium.js"], "css": ["vimium.css"], "all_frames": true, "run_at": "document_idle"}], "chrome_url_overrides": {"newtab": "index.html"}, "omnibox": {"keyword": "m"}, "commands": {"open-home": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Open the Orbit homepage"}, "unload-all": {"suggested_key": {"default": "Ctrl+Alt+U", "mac": "MacCtrl+Alt+U"}, "description": "Unload all background tabs"}, "clean": {"suggested_key": {"default": "Ctrl+Alt+C", "mac": "MacCtrl+Alt+C"}, "description": "Unload background tabs unused for four hours"}, "copy-markdown": {"suggested_key": {"default": "Ctrl+Alt+M", "mac": "MacCtrl+Alt+M"}, "description": "Copy the current page as Markdown"}}, "browser_specific_settings": {"gecko": {"id": "monocle@monilmeh.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo"]}}}}