{"manifest_version": 3, "name": "QuickCritic - Notes, Trailers & Fiches", "version": "2.0.0", "description": "Affichez instantan\u00e9ment les notes critiques (IMDb, Rotten Tomatoes, Metacritic, Allocin\u00e9, SensCritique, TMDB, Letterboxd), le titre qu\u00e9b\u00e9cois, les bandes-annonces YouTube VF/VO, le s\u00e9lecteur d'opus alternatifs, et l'acc\u00e8s \u00e0 c411.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "quickcritic@extension.firefox", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://www.omdbapi.com/*", "https://api.themoviedb.org/*", "https://image.tmdb.org/*", "https://apollo.senscritique.com/*", "https://www.allocine.fr/*", "https://www.senscritique.com/*", "https://letterboxd.com/*", "https://fr.wikipedia.org/*", "https://www.youtube.com/*", "https://www.youtube-nocookie.com/*", "https://img.youtube.com/*", "https://i.ytimg.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "QuickCritic - Recherche de films & s\u00e9ries", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}