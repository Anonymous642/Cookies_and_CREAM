{"manifest_version": 3, "name": "SoberScroll", "version": "1.0.0", "description": "Stay sober from Instagram's endless scroll. Keep stories and DMs. Skip the algorithm.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "activeTab"], "host_permissions": ["*://*.instagram.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "soberscroll_redirects", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["*://*.instagram.com/*"]}], "browser_specific_settings": {"gecko": {"id": "soberscroll@pragati.dev", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}