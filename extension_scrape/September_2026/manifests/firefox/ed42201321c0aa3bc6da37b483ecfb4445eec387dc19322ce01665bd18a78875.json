{"manifest_version": 3, "name": "Fin Flow Queue", "version": "2.0.5", "description": "Queue prompts for bulk image generation on Google Flow \u2014 simple and automatic.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["*://labs.google/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Fin Flow Queue"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://labs.google/fx/tools/flow/*"], "js": ["content_script.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "fin-flow-queue@richthinking.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "websiteContent"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}