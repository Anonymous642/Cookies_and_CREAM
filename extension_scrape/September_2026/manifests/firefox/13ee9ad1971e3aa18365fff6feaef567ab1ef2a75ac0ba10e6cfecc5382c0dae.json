{"manifest_version": 2, "name": "Common Notes", "description": "Community Notes Everywhere", "version": "0.3.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "contextMenus", "activeTab", "tabs", "scripting", "alarms", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "extension@commonnotes.net", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Common Notes", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.substack.com/*"], "js": ["content-scripts/notes.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube.js"]}], "web_accessible_resources": ["content-scripts/generic.css", "content-scripts/notes.css", "content-scripts/youtube.css"]}