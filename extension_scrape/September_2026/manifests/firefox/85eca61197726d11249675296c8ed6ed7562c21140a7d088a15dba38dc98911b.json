{"manifest_version": 3, "name": "Snappy \u2014 Textbausteine (lokal & privat)", "version": "1.0.0", "description": "Tippe kurze K\u00fcrzel, bekomme ganze Textbausteine mit Platzhaltern & Ausf\u00fcll-Feldern. 100% lokal, kein Konto, kein Tracking.", "browser_specific_settings": {"gecko": {"id": "snappy@max1220z", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["storage", "contextMenus", "clipboardRead"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Snappy \u2014 Textbausteine", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["lib/store.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/store.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "commands": {"open-manager": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Snappy-Manager \u00f6ffnen"}, "open-picker": {"description": "Baustein-Schnellauswahl \u00f6ffnen (Tastenk\u00fcrzel in Firefox unter Add-ons verwalten festlegbar)"}}}