{"manifest_version": 3, "name": "Tobby: Smart Tab Manager", "version": "1.0.0", "description": "Save and restore all your tabs - keep your browsing organized and never lose a session again.", "permissions": ["tabs", "storage", "downloads"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "sanctumworks.dev@gmail.com", "strict_min_version": "120.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["suspended_tab_placeholder.html", "suspended_tab_placeholder.js"], "matches": ["<all_urls>"]}]}