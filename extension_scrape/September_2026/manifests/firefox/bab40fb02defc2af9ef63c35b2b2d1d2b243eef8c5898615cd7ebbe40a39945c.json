{"manifest_version": 3, "name": "Save For Later Pro", "version": "1.0.2", "description": "A powerful bookmark manager that helps you save, organize, and discover web content. Features smart tagging, cross-device sync, and intelligent categorization to keep your bookmarks organized and easily accessible.", "short_name": "SaveForLater", "author": "Save For Later Team", "homepage_url": "https://app.saveforlater.pro", "keywords": ["bookmarks", "productivity", "organization", "sync", "tags", "categories", "web-content"], "categories": ["productivity", "bookmarks"], "lang": "en", "permissions": ["bookmarks", "tabs", "storage", "activeTab", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "bookmark-manager@saveforlater.pro", "strict_min_version": "109.0"}}, "action": {"default_popup": "popup.html", "default_title": "Save For Later Pro - Smart Bookmark Manager", "default_icon": {"16": "16.png", "32": "32.png", "48": "48.png", "128": "128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "16.png", "32": "32.png", "48": "48.png", "128": "128.png"}, "web_accessible_resources": [{"resources": ["index.html", "assets/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "minimum_chrome_version": "88", "offline_enabled": true, "incognito": "split"}