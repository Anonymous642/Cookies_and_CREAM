{"manifest_version": 3, "name": "Basecamp Hotkeys", "short_name": "BCHotkeys", "version": "0.1.0", "description": "Browser extension prototype for Basecamp keyboard navigation.", "author": "Roman Yanke", "homepage_url": "https://github.com/romanyanke/basecamp-hotkeys", "browser_specific_settings": {"gecko": {"id": "basecamp-hotkeys@local.dev", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Basecamp Hotkeys", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "web_accessible_resources": [{"resources": ["options.html", "options.css", "options.js"], "matches": ["https://basecamp.com/*", "https://*.basecamp.com/*"]}], "content_scripts": [{"matches": ["https://basecamp.com/*", "https://*.basecamp.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}