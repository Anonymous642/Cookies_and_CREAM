{"manifest_version": 2, "name": "Tab Saver", "version": "1.0.0", "description": "Never lose your tabs again. Save, organize, and restore tab collections instantly.", "permissions": ["tabs", "storage", "alarms", "clipboardWrite"], "browser_action": {"default_popup": "popup.html", "default_title": "Tab Saver", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-tabs": {"suggested_key": {"default": "Alt+S"}, "description": "Save current tabs as a collection"}, "restore-last": {"suggested_key": {"default": "Alt+R"}, "description": "Restore your last saved session"}}, "browser_specific_settings": {"gecko": {"id": "tabsaver@ranakeshav", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}