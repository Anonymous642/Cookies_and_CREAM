{"manifest_version": 3, "name": "AegiVara", "version": "1.0", "description": "AegiVara is a browser activity tracker with real-time URL interception and GSAP-powered dashboard.", "permissions": ["webRequest", "webNavigation", "storage", "tabs", "alarms", "declarativeNetRequest"], "host_permissions": ["<all_urls>", "https://aegisbrowse.tarxemo.com/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "aegivara@tarxemo.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}