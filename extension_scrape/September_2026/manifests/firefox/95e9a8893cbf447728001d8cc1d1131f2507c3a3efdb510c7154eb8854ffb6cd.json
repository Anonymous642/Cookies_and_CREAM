{"manifest_version": 2, "name": "iDME Kehadiran Helper", "version": "1.0.0", "description": "Paste senarai WhatsApp murid tak hadir, auto-navigate iDME, dan auto-tanda kehadiran.", "permissions": ["activeTab", "storage", "tabs", "https://idme.moe.gov.my/*", "https://moeispel.moe.gov.my/*", "https://ispel.moe.gov.my/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "idme-kehadiran@helper.my", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "browser_action": {"default_title": "iDME Kehadiran Helper", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://idme.moe.gov.my/*"], "js": ["idme-navigate.js"], "run_at": "document_idle"}, {"matches": ["https://moeispel.moe.gov.my/*", "https://ispel.moe.gov.my/*"], "js": ["content.js", "ispel-navigate.js"], "all_frames": true, "run_at": "document_idle"}]}