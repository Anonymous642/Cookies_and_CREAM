{"manifest_version": 3, "name": "Link Catcher \u2014 Slow Load Link Catcher", "short_name": "LinkCatcher", "version": "1.3.1", "description": "Instantly catches links you click or forms you submit on slow-loading pages, and shows them in a floating panel. Never miss a payment link again.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Link Catcher"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "tabs", "webNavigation", "webRequest"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "{8818594e-813b-416c-8902-6596efe5e01e}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}