{"manifest_version": 3, "name": "TWUING Extension", "description": "This extension brings native Angular support to Tailwind UI", "version": "2.2.0", "browser_specific_settings": {"gecko": {"id": "twuing-extension@twuing.dev", "strict_min_version": "109.0"}}, "icons": {"16": "./images/twuing-extension-16px.png", "32": "./images/twuing-extension-32px.png", "48": "./images/twuing-extension-48px.png", "128": "./images/twuing-extension-128px.png"}, "action": {"default_title": "TWUING Extension", "default_popup": "./html/popup.html", "default_icon": {"16": "./images/twuing-extension-16px.png", "32": "./images/twuing-extension-32px.png", "48": "./images/twuing-extension-48px.png", "128": "./images/twuing-extension-128px.png"}}, "background": {"scripts": ["./js/variables.js", "./js/background.js"]}, "content_scripts": [{"matches": ["https://tailwindcss.com/*"], "js": ["./js/variables.js", "./js/content.js", "./js/twuing.js", "./libs/prism/1.24.1/prism.min.js", "./libs/prism/1.24.1/prism-typescript.js"], "css": ["./css/styles.css", "./css/tailwind.css"]}], "host_permissions": ["https://tailwindcss.com/**/*"], "permissions": ["storage", "clipboardWrite"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["./css/styles.css", "./css/tailwind.css", "*.html"], "matches": ["https://tailwindcss.com/*"]}]}