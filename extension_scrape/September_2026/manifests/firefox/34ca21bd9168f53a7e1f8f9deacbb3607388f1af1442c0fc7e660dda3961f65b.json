{"manifest_version": 3, "name": "ClickAutomator", "version": "0.1.0", "description": "Extension de Firefox para clics automaticos aleatorios por intervalo.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["src/shared/i18n.js", "src/background/index.js"]}, "icons": {"48": "ico.png", "96": "ico.png", "128": "ico.png"}, "action": {"default_icon": {"32": "ico.png"}, "default_title": "ClickAutomator", "default_popup": "src/popup/popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/shared/i18n.js", "src/content/index.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "clickautomator.argtime@local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "121.0"}}}