{"manifest_version": 3, "name": "Window Mute", "description": "Instantly mute or unmute all tabs within the current window with a single click.", "version": "1.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage", "sessions"], "action": {"default_area": "navbar", "default_title": "Window Mute"}, "commands": {"toggle-window-mute": {"suggested_key": {"default": "Alt+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle mute in current window"}}, "browser_specific_settings": {"gecko": {"id": "window-mute@fawaztakahji.github.io", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}