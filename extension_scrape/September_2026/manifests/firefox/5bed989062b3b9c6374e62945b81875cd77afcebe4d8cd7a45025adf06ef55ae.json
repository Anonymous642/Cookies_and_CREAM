{"manifest_version": 3, "name": "YouTube No Playlist", "version": "6.1", "description": "Elimina autom\u00e1ticamente par\u00e1metros de playlist de los enlaces de YouTube.", "browser_specific_settings": {"gecko": {"id": "youtube-noplaylist@example.com"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "YouTube No Playlist"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}