{"manifest_version": 3, "name": "OpenRouter Auto-Filler", "version": "1.3.0", "description": "Auto-fill forms using OpenRouter API", "permissions": ["storage", "contextMenus", "activeTab"], "host_permissions": ["https://picsum.photos/*", "https://images.unsplash.com/*", "https://fastly.picsum.photos/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Genium Settings", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["genium_engine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "openrouter-filler@example.com", "data_collection_permissions": {"required": ["none"]}}}}