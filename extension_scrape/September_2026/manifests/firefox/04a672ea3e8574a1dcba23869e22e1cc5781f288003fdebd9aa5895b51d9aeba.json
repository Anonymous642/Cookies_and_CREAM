{"manifest_version": 3, "name": "YouTube to N8N", "version": "1.0", "description": "Send YouTube URLs to N8N webhook", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.youtube.com/*", "<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "youtube-to-n8n@xavier.extension"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["browser-polyfill.js", "content.js"]}]}