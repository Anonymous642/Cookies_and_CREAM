{"manifest_version": 3, "name": "Aeterna Safe", "version": "0.3.0", "description": "Passw\u00f6rter in Aeterna Safe speichern und ausf\u00fcllen \u2014 Zero-Knowledge Passwort-Tresor.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://*/*", "http://localhost:3000/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Aeterna Safe", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "extension@aeterna-safe.de", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}