{"manifest_version": 2, "name": "BeatTab", "version": "1.0", "description": "Make each tab action play a musical note\u2014open a tab, close a tab, switch tabs \u2014 creates a little browsing soundtrack.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "notifications", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "BeatTab", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "applications": {"gecko": {"id": "beattab@example.com"}}}