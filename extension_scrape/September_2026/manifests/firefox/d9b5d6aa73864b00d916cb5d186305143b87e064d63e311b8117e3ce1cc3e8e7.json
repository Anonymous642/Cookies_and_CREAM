{"manifest_version": 3, "name": "Reflow Lab", "version": "1.0.0", "description": "Stress selected layouts with text and container-width trials. Measure overflow, compare and undo.", "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "reflow-lab@frontend-observatory.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Reflow Lab", "default_popup": "popup.html", "default_icon": {"48": "icons/48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}