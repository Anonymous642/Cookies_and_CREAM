{"manifest_version": 3, "name": "TabVault", "version": "1.0.0", "description": "Save, organize, and restore browser sessions. Never lose context again.", "permissions": ["tabs", "tabGroups", "storage", "alarms"], "host_permissions": ["https://firestore.googleapis.com/*", "https://checkout.freemius.com/*"], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "src/icons/icon-16.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}}, "background": {"service_worker": "src/js/background.js", "scripts": ["src/js/background.js"]}, "options_page": "src/options.html", "commands": {"save-session": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current session"}}, "icons": {"16": "src/icons/icon-16.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tabvault@tabvault.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}