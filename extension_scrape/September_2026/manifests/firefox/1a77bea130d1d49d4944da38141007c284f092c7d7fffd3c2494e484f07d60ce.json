{"manifest_version": 3, "name": "QuickBox", "version": "3.4.0", "description": "Beautiful new tab bookmark launcher with folders, drag & drop, and a clean UI", "author": "Brandon Bischoff", "browser_specific_settings": {"gecko": {"id": "quickbox@brandonbischoff.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "notifications", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"48": "icon-48.png", "96": "icon-96.png"}, "default_title": "QuickBox - Add current page to bookmarks", "default_popup": "popup.html"}, "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "commands": {"quick-note": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Quick note capture"}}}