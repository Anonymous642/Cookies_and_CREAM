{"manifest_version": 3, "name": "Save to Google Keep", "version": "4", "description": "Save the current tab to Google Keep with organized content", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["https://keep.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "save-to-keep@example.com", "strict_min_version": "91.0"}}}