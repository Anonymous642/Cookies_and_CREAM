{"manifest_version": 3, "name": "TikQuick", "version": "1.2.1", "description": "Upload helper for TikQuick and TikTok Studio", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TikQuick"}, "content_scripts": [{"js": ["content.js"], "matches": ["https://www.tiktok.com/tiktokstudio/*"], "run_at": "document_start"}], "permissions": ["activeTab", "alarms", "storage", "tabs"], "host_permissions": ["https://www.tiktok.com/*", "https://mikeden.site/*"], "web_accessible_resources": [{"matches": ["https://www.tiktok.com/*"], "resources": ["inject.js"]}], "browser_specific_settings": {"gecko": {"id": "tikquick@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}