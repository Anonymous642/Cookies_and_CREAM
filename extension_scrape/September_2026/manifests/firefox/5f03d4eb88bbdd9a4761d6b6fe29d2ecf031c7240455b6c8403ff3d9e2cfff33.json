{"manifest_version": 3, "name": "Raiffeisenbank CZ SEPA QR Scanner & Filler", "version": "1.1.1", "description": "Scans SEPA QR codes using an Element Picker and autofills Raiffeisen CZ payment forms.", "browser_specific_settings": {"gecko": {"id": "raiffeisenbank-cz-sepa-qr-code-scanner@vokracko.cz", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["*://*.rb.cz/*"], "js": ["dist/autofill-content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["<all_urls>"]}], "action": {"default_title": "Scan SEPA QR / Fill Form", "default_icon": "assets/icon.svg", "default_popup": "popup.html"}, "icons": {"48": "assets/icon.svg", "128": "assets/icon.svg"}}