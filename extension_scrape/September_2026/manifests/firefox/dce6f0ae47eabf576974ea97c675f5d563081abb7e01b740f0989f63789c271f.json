{"manifest_version": 3, "name": "MarX", "version": "1.1.1", "description": "Auto-captures X history and native bookmark clicks with rich tweet previews, tag-based labeling, scheduled auto-import and removal synced to X.", "browser_specific_settings": {"gecko": {"id": "marx@karl.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "alarms"], "host_permissions": ["https://x.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "MarX", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["import.html"], "matches": ["https://x.com/*"]}]}