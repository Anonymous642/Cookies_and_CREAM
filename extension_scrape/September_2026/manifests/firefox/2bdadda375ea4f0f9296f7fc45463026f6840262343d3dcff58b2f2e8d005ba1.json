{"manifest_version": 2, "name": "Workorder Schedule for Lightspeed", "version": "1.5.2", "description": "Workorder schedule calendar for Lightspeed Retail R-Series. See due dates, status colors, line totals, and store credit at a glance. Auto-applies customer deposits at checkout.", "browser_specific_settings": {"gecko": {"id": "workorder-schedule@lightspeed", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "https://*.merchantos.com/*", "https://*.lightspeedapp.com/*", "https://cloud.lightspeedapp.com/*", "https://api.lightspeedapp.com/*", "https://ls-oauth-proxy.ls-proxy.workers.dev/*", "https://stevecomrade.github.io/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.merchantos.com/*", "https://*.lightspeedapp.com/*"], "js": ["content.js", "checkout-payment.js"], "css": ["styles.css"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["setup.html"]}