{"manifest_version": 3, "name": "No AI Overview", "version": "1.0", "description": "Hides Google AI Overview from search results", "permissions": ["storage", "tabs"], "host_permissions": ["*://www.google.com/*"], "content_scripts": [{"matches": ["*://www.google.com/search*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"128": "logo.png"}, "action": {"default_popup": "popup.html", "default_title": "No AI Overview", "default_icon": "logo.png"}, "browser_specific_settings": {"gecko": {"id": "no-ai-overview@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}