{"manifest_version": 3, "name": "Qprompter", "version": "1.2.0", "description": "Queue prompts and automate AI chat workflows with smart delays.", "permissions": ["storage", "tabs", "scripting", "alarms", "notifications", "webRequest"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://bard.google.com/*", "https://copilot.microsoft.com/*", "https://www.bing.com/*", "https://poe.com/*", "https://character.ai/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "qprompter@example.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "128.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}