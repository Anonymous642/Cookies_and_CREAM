{"manifest_version": 3, "name": "AstroVPN", "short_name": "AstroVPN", "version": "1.2.1", "description": "Connect to AstroVPN directly from your browser.", "action": {"default_popup": "popup.html", "default_title": "AstroVPN", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["proxy", "storage", "notifications", "alarms", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "extension@astrovpn.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "content_scripts": [{"matches": ["https://astrovpn.app/extension-connect*", "https://astrovpn.app/extension-connect/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}