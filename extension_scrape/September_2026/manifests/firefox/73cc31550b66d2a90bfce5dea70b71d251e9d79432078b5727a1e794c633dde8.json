{"manifest_version": 3, "name": "Session Pal", "version": "1.1", "description": "A single-page session pal for saving and restoring browser sessions.", "permissions": ["tabs", "storage", "scripting"], "optional_host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "session-pal@session-pal-dev.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "logo_16x16.png", "32": "logo_32x32.png", "48": "logo_48x48.png", "64": "logo_64x64.png", "128": "logo_128x128.png", "256": "logo_256x256.png"}, "action": {"default_title": "Open Session Pal", "default_icon": {"16": "logo_16x16.png", "32": "logo_32x32.png", "48": "logo_48x48.png", "128": "logo_128x128.png"}}, "commands": {"open-session-pal": {"suggested_key": {"default": "Ctrl+Alt+B"}, "description": "Open Session Pal"}}, "background": {"scripts": ["background.js"]}}