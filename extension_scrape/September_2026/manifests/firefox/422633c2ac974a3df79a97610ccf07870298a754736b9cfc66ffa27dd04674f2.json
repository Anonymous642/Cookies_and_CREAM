{"manifest_version": 3, "name": "Page Load Progress", "version": "3.1.3", "author": "DukeCorp1996", "homepage_url": "https://dukecorp1996.x35.in/", "description": "Shows a customizable loading bar with optional live page telemetry", "icons": {"96": "icon.png"}, "permissions": ["webRequest", "webNavigation", "storage", "tabs"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["settings.js", "telemetry.js", "content.js"], "css": ["progress.css"], "run_at": "document_start", "all_frames": false}], "background": {"scripts": ["settings.js", "telemetry.js", "permissions.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Page Load Progress", "default_icon": {"96": "icon.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "page-load-progress@John", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}