{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "rtl-helper@eslam.x", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "name": "STRIX RTL", "version": "1.0.0", "description": "STRIX RTL and Arabic readability helper for Claude and custom websites.", "permissions": ["storage"], "commands": {"toggle-rtl": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle RTL Helper on/off"}}, "host_permissions": ["https://claude.ai/*", "http://*/*", "https://*/*"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "index.html", "default_title": "STRIX RTL", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*", "http://*/*", "https://*/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}