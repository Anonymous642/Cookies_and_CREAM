{"manifest_version": 3, "name": "AutoCookie", "author": "Foxyverse", "description": "Firefox-Add-on: Akzeptiert Cookie-Banner automatisch auf vielen Webseiten.", "version": "18.2.27", "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "autocookie@messi.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "AutoCookie", "default_popup": "popup.html", "default_icon": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}