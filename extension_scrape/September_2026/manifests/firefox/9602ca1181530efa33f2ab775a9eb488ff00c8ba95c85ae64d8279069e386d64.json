{"manifest_version": 2, "name": "Viral Video Detector", "version": "1.0", "description": "Automatically detects potentially viral videos on social media. No data collection; runs only on the pages you visit.", "icons": {"32": "icons/icon32.png", "48": "icons/icon48.png"}, "permissions": [], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.facebook.com/*", "*://*.fb.com/*", "*://*.fbwatch.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.vimeo.com/*", "*://*.dailymotion.com/*", "*://*.twitch.tv/*", "*://*.bilibili.com/*", "*://*.weibo.com/*", "*://*.pinterest.com/*", "*://*.snapchat.com/*", "*://*.tumblr.com/*", "*://*.vk.com/*", "*://*.ok.ru/*", "*://*.rumble.com/*", "*://*.odysee.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "viral-video-detector@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}