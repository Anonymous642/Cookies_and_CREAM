{"manifest_version": 3, "name": "ir-ext", "description": "Incremental Reading by bookmarks", "version": "0.0.20", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "bookmarks", "storage", "notifications", "alarms"], "browser_specific_settings": {"gecko": {"id": "ir-ext@lyq.one", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+I"}, "description": "Open the extension popup"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content-scripts/content.js"]}]}