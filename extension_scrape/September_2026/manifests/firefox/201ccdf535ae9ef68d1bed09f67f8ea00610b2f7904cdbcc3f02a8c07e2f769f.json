{"manifest_version": 2, "name": "SoundCloud Mini Player", "version": "2.0.0", "description": "Bridges SoundCloud and Spotify in the browser to the desktop mini player.", "browser_specific_settings": {"gecko": {"id": "soundcloud-mini-player@soundcloud-mini-player.local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "*://soundcloud.com/*", "*://open.spotify.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background-firefox.js"]}, "content_scripts": [{"matches": ["*://soundcloud.com/*"], "js": ["content.js"], "run_at": "document_end"}, {"matches": ["*://open.spotify.com/*"], "js": ["content-spotify.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup-firefox.html", "default_title": "SoundCloud Mini Player"}, "web_accessible_resources": ["mini-player.html", "themes.css"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}