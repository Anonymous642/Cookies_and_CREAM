{"manifest_version": 3, "name": "No AI Google", "version": "1.0.3", "description": "Hides Google's AI features. Unofficial, not affiliated with Google. Local only.", "author": "F*CK AI", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "No AI Google", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://www.google.com/search*", "*://www.google.co.uk/search*", "*://www.google.ca/search*", "*://www.google.com.au/search*", "*://www.google.de/search*", "*://www.google.fr/search*", "*://www.google.co.in/search*", "*://www.google.com.br/search*", "*://www.google.es/search*", "*://www.google.it/search*", "*://www.google.nl/search*", "*://www.google.co.jp/search*"], "css": ["hide.css"], "js": ["block.js"], "run_at": "document_start"}], "background": {"scripts": ["bg.js"]}, "browser_specific_settings": {"gecko": {"id": "no-ai-google@noai.fckai", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}