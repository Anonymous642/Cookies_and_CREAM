{"manifest_version": 3, "name": "PDF Search Helper", "version": "1.0.1", "description": "Enhanced search experience with PDF file search capabilities.", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://*.pdfsearchhelper.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.pdfsearchhelper.com/*"], "js": ["js/dpl-extensions.js", "js/utils.js", "js/pdfsearchhelper.js"]}], "action": {"default_popup": "popup.html", "default_title": "PDF Search Helper"}, "chrome_settings_overrides": {"search_provider": {"name": "PDF Search Helper", "keyword": "@pdfsearch", "search_url": "https://api.pdfsearchhelper.com/api/search?q={searchTerms}", "favicon_url": "icons/favicon.ico", "suggest_url": "https://api.pdfsearchhelper.com/api/suggest?q={searchTerms}", "encoding": "UTF-8", "is_default": true}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "pdfsearchhelper@system1.com", "strict_min_version": "121.0"}}}