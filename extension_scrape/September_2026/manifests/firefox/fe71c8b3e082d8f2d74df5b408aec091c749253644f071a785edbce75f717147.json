{"manifest_version": 3, "name": "ExHentai Monitor", "version": "1.0.0", "description": "Monitor ExHentai updates for specified keywords", "browser_specific_settings": {"gecko": {"id": "exhentai-monitor@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": []}}}, "permissions": ["storage", "tabs", "activeTab", "notifications"], "host_permissions": ["https://exhentai.org/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "images/icon-48.png"}}, "background": {"page": "background/background.html"}, "content_scripts": [{"matches": ["https://exhentai.org/*"], "js": ["content/content.js"], "run_at": "document_end"}], "icons": {"48": "images/icon-48.png"}}