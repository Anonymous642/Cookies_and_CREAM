{"manifest_version": 3, "name": "Confible Pseudoanonimo", "version": "0.1.1", "description": "Protege datos sensibles antes de enviar mensajes a chats de IA como ChatGPT y Claude.", "browser_specific_settings": {"gecko": {"id": "confible@confible.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://confible.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Confible Pseudoanonimo", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "web_accessible_resources": [{"resources": ["linking.html", "linking.js", "confible-api.js", "popup.css", "assets/icon-16.png", "assets/icon-32.png", "assets/icon-48.png", "assets/icon-128.png"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://copilot.microsoft.com/*"], "js": ["confible-api.js", "content-script.js"], "run_at": "document_idle"}]}