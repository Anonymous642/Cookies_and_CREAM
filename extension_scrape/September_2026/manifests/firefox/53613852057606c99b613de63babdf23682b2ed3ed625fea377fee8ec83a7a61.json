{"manifest_version": 3, "name": "Deseret Bookshelf Title Fixer (+)", "version": "0.1.8", "description": "Sets page titles & adds media type switching utilities", "browser_specific_settings": {"gecko": {"id": "deseret-title-plus@fix.page", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "404": "icons/icon404.png"}, "permissions": ["contextMenus", "clipboardWrite", "scripting", "storage"], "host_permissions": ["*://*.deseretbook.com/*"], "options_ui": {"page": "options.html", "open_in_tab": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://read.deseretbook.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}