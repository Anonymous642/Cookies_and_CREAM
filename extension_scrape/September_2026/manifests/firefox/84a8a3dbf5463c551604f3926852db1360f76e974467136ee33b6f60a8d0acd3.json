{"manifest_version": 3, "name": "Object Data Proxy", "version": "1.0.2", "description": "Roteia o acesso a objectdata.com.br por um servidor no Brasil. N\u00e3o coleta, armazena nem compartilha dados de navega\u00e7\u00e3o.", "browser_specific_settings": {"gecko": {"id": "object-data-proxy@cron8.cloud", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["proxy", "storage"], "optional_host_permissions": ["*://objectdata.com.br/*", "*://*.objectdata.com.br/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}