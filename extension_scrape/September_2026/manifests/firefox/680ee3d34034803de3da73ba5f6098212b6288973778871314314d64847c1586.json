{"manifest_version": 2, "name": "Linkedin Tagger", "version": "1.0.7", "description": "Adiciona tags personalizadas a perfis do LinkedIn, organiza por tags, com backup autom\u00e1tico e lembretes.", "permissions": ["storage", "activeTab", "downloads", "alarms", "notifications", "https://www.linkedin.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Linkedin Tagger", "default_icon": "icon.svg"}, "background": {"scripts": ["background.js"], "persistent": false}, "web_accessible_resources": ["import.html", "welcome.html"], "browser_specific_settings": {"gecko": {"id": "linkedin-tagger@seu-email.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}