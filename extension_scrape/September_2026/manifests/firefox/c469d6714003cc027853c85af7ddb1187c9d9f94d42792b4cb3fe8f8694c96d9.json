{"manifest_version": 2, "name": "ChatVault", "version": "0.1.1", "description": "Save reusable QA from ChatGPT, DeepSeek, Grok, and Gemini into a local Firefox knowledge base.", "icons": {"16": "icons/chatvault-16.png", "32": "icons/chatvault-32.png", "48": "icons/chatvault-48.png", "128": "icons/chatvault-128.png"}, "permissions": ["storage", "tabs", "activeTab", "contextMenus", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://chat.deepseek.com/*", "https://deepseek.chat/*", "https://grok.com/*", "https://x.com/i/grok*", "https://gemini.google.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "ChatVault", "default_icon": {"16": "icons/chatvault-16.png", "32": "icons/chatvault-32.png", "48": "icons/chatvault-48.png"}, "default_popup": "popup.html"}, "options_ui": {"page": "library.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://chat.deepseek.com/*", "https://deepseek.chat/*", "https://grok.com/*", "https://x.com/i/grok*", "https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "chatvault@chatvault.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}