{"manifest_version": 2, "name": "AO3 Kudos Reminder", "version": "2.0", "description": "Reminds you to leave kudos on AO3 before navigating away.", "icons": {"48": "kudos-48.png", "96": "kudos-96.png"}, "permissions": [], "content_scripts": [{"matches": ["https://archiveofourown.org/works/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ao3-kudos-reminder@yourdomain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}