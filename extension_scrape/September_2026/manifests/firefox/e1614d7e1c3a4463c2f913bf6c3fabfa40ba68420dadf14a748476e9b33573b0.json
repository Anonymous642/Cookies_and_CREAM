{"manifest_version": 3, "name": "Notion Writing Stats", "short_name": "Notion Writi", "version": "1.0.0", "description": "Displays real-time word count, reading time, and writing statistics for the current Notion page", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.notion.so/*", "https://notion.so/*"], "background": {"scripts": ["background/service-worker.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Notion Writing Stats", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.notion.so/*", "https://notion.so/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "notion_word_count@forgex.aevorn", "strict_min_version": "109.0"}}}