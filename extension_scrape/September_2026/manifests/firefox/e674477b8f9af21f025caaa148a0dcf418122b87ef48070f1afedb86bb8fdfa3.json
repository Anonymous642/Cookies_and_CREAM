{"manifest_version": 2, "name": "Open Link on Click", "version": "1.0.1", "description": "Opens your chosen website in a new tab when you click the toolbar icon.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Open my site", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "browser_specific_settings": {"gecko": {"id": "open-link-on-click@example.com", "strict_min_version": "78.0"}}}