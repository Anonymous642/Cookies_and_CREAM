{"manifest_version": 3, "name": "LumaLyrics \u2013 Lyrics for YouTube Music", "version": "1.1.5", "description": "Real-time synced lyrics for YouTube Music with karaoke mode, animated lyrics, customization, and light & dark themes.", "author": "@Chrg_Bsr", "permissions": ["storage"], "host_permissions": ["https://music.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "luma-lyrics@chrg-bsr.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}