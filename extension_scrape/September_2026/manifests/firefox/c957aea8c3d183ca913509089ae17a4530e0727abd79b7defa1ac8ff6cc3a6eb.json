{"manifest_version": 3, "name": "PSX Price Watch", "version": "1.2.0", "license": "MPL-2.0", "description": "Set a buy/sell target price on any PSX stock page and get alerted when the current price hits it.", "icons": {"96": "icon.png"}, "permissions": ["storage", "notifications"], "content_scripts": [{"matches": ["https://dps.psx.com.pk/company/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "PSX Price Watch", "default_icon": {"96": "icon.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "psx-price-watch@khuzaimj.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}