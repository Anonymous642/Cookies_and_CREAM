{"manifest_version": 2, "name": "Bybit P2P Keyword Filter", "version": "3.0.0", "description": "Hide P2P offers on Bybit by custom keywords in seller conditions, nicknames and payment methods", "browser_specific_settings": {"gecko": {"id": "bybit-p2p-keyword-filter@addon", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "*://www.bybit.com/*", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.bybit.com/*/p2p/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Bybit P2P Keyword Filter"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}