{"manifest_version": 2, "name": "Joey_rc_02", "version": "0.9.3", "description": "Save articles for later reading. Highlight and annotate text, export to Markdown. Everything stored locally \u2014 no accounts, no servers.", "homepage_url": "https://github.com/", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "Save to Joey", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/Readability.js", "content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["reader/reader.html", "list/list.html"], "browser_specific_settings": {"gecko": {"id": "joey@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "unlimitedStorage", "tabs"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save current page to Joey"}}}