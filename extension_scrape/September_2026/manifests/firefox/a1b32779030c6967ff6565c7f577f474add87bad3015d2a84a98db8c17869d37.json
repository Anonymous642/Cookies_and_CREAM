{"manifest_version": 3, "name": "ffext", "version": "0.0.1", "description": "Redirect urls from en_US to zh_CN", "browser_specific_settings": {"gecko": {"id": "xingqingxyz@github.com"}}, "permissions": ["declarativeNetRequestWithHostAccess"], "declarative_net_request": {"rule_resources": [{"id": "redirect_rules", "path": "redirect_rules.json", "enabled": true}]}, "action": {"default_title": "Redirect to chinese urls", "default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["https://github.com/*", "https://learn.microsoft.com/en-us/*", "https://developer.mozilla.org/en-US/docs/*"], "js": ["dist/extension.js"]}]}