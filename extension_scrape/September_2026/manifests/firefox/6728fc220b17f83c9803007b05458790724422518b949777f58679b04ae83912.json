{"manifest_version": 3, "name": "HeadForge", "description": "Manage multiple header profiles and inject request/response headers per domain. A modern ModHeader alternative.", "version": "2026.715.1411", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "HeadForge", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_page": "src/options/index.html", "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "headforge@owt.swiss", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}