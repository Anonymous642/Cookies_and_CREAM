{"manifest_version": 3, "name": "Steam ID Copier", "version": "1.1.0", "description": "Affiche et copie facilement le SteamID et SteamID64 sur les profils Steam.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "steamid-copier@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://steamcommunity.com/id/*", "*://steamcommunity.com/profiles/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_end"}]}