{"manifest_version": 3, "name": "Web Rich Presence", "version": "0.4.0", "description": "Uses webrichpresence:// to show what are you listening to in Discord. Currently supports: SoundCloud, YouTube Music", "icons": {}, "permissions": ["notifications"], "background": {"scripts": ["global.mjs"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "sc-rich-presence@immails.su", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://soundcloud.com/*"], "js": ["./soundcloud.mjs"]}, {"matches": ["*://music.youtube.com/*"], "js": ["./youtube-music.mjs"]}, {"matches": ["*://music.yandex.com/*"], "js": ["./yandex-music.mjs"]}, {"matches": ["*://music.yandex.ru/*"], "js": ["./yandex-music.mjs"]}, {"matches": ["*://music.yandex.by/*"], "js": ["./yandex-music.mjs"]}, {"matches": ["*://music.yandex.kz/*"], "js": ["./yandex-music.mjs"]}, {"matches": ["*://music.yandex.uz/*"], "js": ["./yandex-music.mjs"]}, {"matches": ["*://music.yandex.net/*"], "js": ["./yandex-music.mjs"]}]}