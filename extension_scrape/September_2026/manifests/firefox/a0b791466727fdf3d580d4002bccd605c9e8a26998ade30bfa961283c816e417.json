{"manifest_version": 3, "name": "StyleGrabber", "description": "Hover over any element on any page to instantly grab its CSS and HTML.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "clipboardWrite", "activeTab"], "host_permissions": ["<all_urls>", "file:///*"], "commands": {"toggle-pin": {"suggested_key": {"default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Toggle Pin Overlay"}, "toggle-tree-mode": {"suggested_key": {"default": "Alt+Shift+T", "mac": "MacCtrl+Shift+T"}, "description": "Toggle Tree Mode"}, "toggle-auto-copy": {"suggested_key": {"default": "Alt+Shift+C", "mac": "MacCtrl+Shift+C"}, "description": "Toggle Auto Copy"}}, "browser_specific_settings": {"gecko": {"id": "stylegrabber@extension.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "matches": ["<all_urls>", "file:///*"]}]}