{"manifest_version": 2, "name": "Lighthouse Quick Run", "version": "1.0", "description": "Quickly open a Lighthouse (web.dev measure) report for the active tab's URL. AMO-friendly MV2 example (no icons).", "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Run Lighthouse (web.dev)", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "lighthouse-quickrun@example.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs"], "applications": {"gecko": {"id": "lighthouse-quickrun@example.com"}}}