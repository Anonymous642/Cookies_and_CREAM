{"manifest_version": 3, "name": "VidHatch \u2014 Video Downloader", "version": "1.0.3", "description": "Detect and download video, images and GIFs from any page. Save streams as one MP4, or just the sound as MP3. No ads, no watermark.", "browser_specific_settings": {"gecko": {"id": "vidhatch@vidhatch.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity"]}}}, "permissions": ["downloads", "webRequest", "declarativeNetRequest", "alarms", "storage", "tabs", "notifications", "contextMenus"], "optional_permissions": ["downloads.open"], "host_permissions": ["<all_urls>"], "background": {"page": "background-ff.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["ff-compat.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "VidHatch", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "sidebar_action": {"default_title": "VidHatch", "default_panel": "sidebar.html", "open_at_install": false, "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}