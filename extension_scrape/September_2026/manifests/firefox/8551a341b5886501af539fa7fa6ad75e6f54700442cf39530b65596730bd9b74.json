{"manifest_version": 3, "name": "woscope", "version": "0.0.2", "description": "manage your meetings", "background": {"scripts": ["background.js"]}, "action": {"default_title": "tap to create meet", "default_icon": "icons/logo.svg"}, "icons": {"16": "icons/logo.svg", "32": "icons/logo.svg", "48": "icons/logo.svg", "128": "icons/logo.svg"}, "permissions": ["storage", "menus", "notifications"], "host_permissions": ["https://core.woscope.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://core.woscope.com"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@woscope", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}