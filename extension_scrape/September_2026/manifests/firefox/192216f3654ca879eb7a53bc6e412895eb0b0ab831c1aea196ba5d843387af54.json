{"manifest_version": 3, "name": "Dual AI Discussion Workspace", "version": "2.0.0", "description": "Enables a real-time discussion loop and debate workspace between Qwen AI, Z.ai, ChatGPT, Claude, DeepSeek, and Gemini in a split window.", "permissions": ["declarativeNetRequest", "scripting", "tabs", "storage"], "host_permissions": ["https://qwen.ai/*", "https://*.qwen.ai/*", "https://z.ai/*", "https://*.z.ai/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://chat.deepseek.com/*", "https://*.deepseek.com/*", "https://gemini.google.com/*", "https://*.google.com/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["https://qwen.ai/*", "https://*.qwen.ai/*", "https://z.ai/*", "https://*.z.ai/*", "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://claude.ai/*", "https://*.claude.ai/*", "https://chat.deepseek.com/*", "https://*.deepseek.com/*", "https://gemini.google.com/*", "https://*.google.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_end"}], "action": {"default_title": "Open Dual AI Workspace", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "dual-ai-discussion@hobbyist.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}