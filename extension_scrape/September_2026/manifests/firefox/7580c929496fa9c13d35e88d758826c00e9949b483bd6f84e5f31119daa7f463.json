{"manifest_version": 3, "name": "LinkShortener", "version": "1.0.0", "description": "URL shortener and link manager. Shorten URLs, track clicks, save collections.", "icons": {"48": "link-icons/icon-48.png", "96": "link-icons/icon-96.png", "128": "link-icons/icon-128.png"}, "action": {"default_icon": {"48": "link-icons/icon-48.png", "96": "link-icons/icon-96.png"}, "default_title": "LinkShortener", "default_popup": "shortener-ui/shorten.html"}, "permissions": ["storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "linkshortener@link.manager", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}