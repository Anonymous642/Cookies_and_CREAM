{"manifest_version": 3, "name": "Trustpilot Verifier", "version": "1.0.2", "description": "Instantly verify the reliability of the website you are currently browsing on Trustpilot.", "permissions": ["activeTab", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*.trustpilot.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "trustpilot-verifier@leo.addons", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}