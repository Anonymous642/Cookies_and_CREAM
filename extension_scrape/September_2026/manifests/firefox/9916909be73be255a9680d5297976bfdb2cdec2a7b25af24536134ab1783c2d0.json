{"manifest_version": 2, "name": "Bookmarks Grid", "version": "0.0.8", "description": "Show bookmarks of category 'Bookmark Menu' on home page and new tabs in a grid.", "permissions": ["bookmarks", "storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "index.html"}, "chrome_settings_overrides": {"homepage": "index.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "bookmark_grid@rastik.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}