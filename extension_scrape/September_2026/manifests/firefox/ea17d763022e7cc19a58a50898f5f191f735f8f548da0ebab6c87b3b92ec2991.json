{"manifest_version": 3, "name": "INSPEKT", "short_name": "INSPEKT", "version": "1.1.0", "author": "Jonas Arden", "description": "Debug faster: visualize outlines, measure elements, inspect text styles, audit SEO, and check heading hierarchy.", "browser_specific_settings": {"gecko": {"id": "inspekt@jonasarden.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/styles.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}