{"manifest_version": 2, "name": "Mr. Translator", "version": "1.2", "description": "A simple translator for you", "icons": {"64": "icon.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["https://mail.google.com/*", "https://translate.googleapis.com/*", "storage"], "browser_specific_settings": {"gecko": {"id": "mr-translator@nonscapex.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}