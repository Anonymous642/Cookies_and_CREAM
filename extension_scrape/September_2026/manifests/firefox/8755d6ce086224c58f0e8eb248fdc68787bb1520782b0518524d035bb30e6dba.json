{"manifest_version": 3, "name": "URL Tagger", "version": "3.0.0", "description": "Etiqueta URLs con colores. Oculta resultados en buscadores. IngeneoTechs.", "author": "IngeneoTechs", "browser_specific_settings": {"gecko": {"id": "URLs-Tagger@ingeneotechs.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "host_permissions": ["*://*.google.com/*", "*://*.google.com.mx/*", "*://*.google.es/*", "*://*.google.co.uk/*", "*://*.google.com.ar/*", "*://*.google.com.co/*", "*://*.google.cl/*", "*://*.google.com.pe/*", "*://*.google.de/*", "*://*.google.fr/*", "*://*.google.com.br/*", "*://*.google.ca/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*", "*://*.yahoo.com/*"], "action": {"default_popup": "popup.html", "default_title": "URL Tagger \u2014 IngeneoTechs", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.google.com/*", "*://*.google.com.mx/*", "*://*.google.es/*", "*://*.google.co.uk/*", "*://*.google.com.ar/*", "*://*.google.com.co/*", "*://*.google.cl/*", "*://*.google.com.pe/*", "*://*.google.de/*", "*://*.google.fr/*", "*://*.google.com.br/*", "*://*.google.ca/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*", "*://*.yahoo.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_page": "options.html", "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}