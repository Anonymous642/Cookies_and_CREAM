{"manifest_version": 3, "name": "GPTpin Pro", "version": "0.1.0", "description": "Organize ChatGPT chats in folders, save images, and reopen everything from a customizable overlay.", "homepage_url": "https://xctlab.com", "browser_specific_settings": {"gecko": {"id": "gptpin-pro@xctlab.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["https://chatgpt.com/*"]}]}