{"manifest_version": 2, "name": "Hitr\u00e1dio Player", "version": "2.1.0", "description": "Sedm stanic Hitr\u00e1dia p\u0159\u00edmo v prohl\u00ed\u017ee\u010di. Jedno kliknut\u00ed, aktu\u00e1ln\u00ed skladba, hlasitost a playlist. Bez reklam a sledov\u00e1n\u00ed.", "icons": {"48": "shared/icons/icon-48.png", "96": "shared/icons/icon-96.png", "128": "shared/icons/icon-128.png"}, "permissions": ["storage", "https://ice.radia.cz/*", "https://hitradiocity.cz/*", "https://ice.abradio.cz/*"], "background": {"page": "firefox/background-page.html", "persistent": true}, "browser_action": {"default_title": "Hitr\u00e1dio Player", "default_popup": "shared/popup/popup.html", "default_icon": {"48": "shared/icons/icon-48.png", "96": "shared/icons/icon-96.png", "128": "shared/icons/icon-128.png"}}, "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "hitradio-player@rb-projects.eu"}}}