{"manifest_version": 3, "name": "Coloring Page Maker", "version": "1.1.1", "description": "Right-click any image to turn it into a printable coloring page, processed entirely on your own device.", "homepage_url": "https://coloringpage.design/chrome-extension", "permissions": ["contextMenus", "storage", "unlimitedStorage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service-worker.js"]}, "content_scripts": [{"matches": ["https://coloringpage.design/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content-script.js"], "run_at": "document_start"}], "action": {"default_title": "Open Coloring Page Maker"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "coloring-page-maker@coloringpage.design", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}