{"manifest_version": 3, "name": "IkaExport", "description": "Export your Ikariam empire data (cities, resources) to Excel with one click. Supports multi-language and color formatting.", "version": "0.0.2", "browser_specific_settings": {"gecko": {"id": "ikaexport@ikamaniac.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["http://*.ikariam.gameforge.com/*", "https://*.ikariam.gameforge.com/*"], "js": ["loader.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["exceljs.min.js", "translations.js", "page_script.js"], "matches": ["http://*.ikariam.gameforge.com/*", "https://*.ikariam.gameforge.com/*"]}]}