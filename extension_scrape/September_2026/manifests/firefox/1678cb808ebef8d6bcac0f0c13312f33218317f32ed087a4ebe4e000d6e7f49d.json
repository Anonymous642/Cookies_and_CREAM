{"manifest_version": 3, "name": "Forti Moodle Tool", "version": "1.1", "description": "A tool to assist with writing and formatting in Moodle.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "*://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_title": "Config", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "commands": {"solve_question": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Format current text"}}, "browser_specific_settings": {"gecko": {"id": "forti-moodle-tool@forti-writing.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}