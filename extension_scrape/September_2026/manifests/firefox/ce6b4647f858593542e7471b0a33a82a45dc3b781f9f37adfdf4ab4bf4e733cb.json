{"manifest_version": 3, "name": "Spotter", "version": "1.0.3", "description": "Collect visual feedback with real browser screenshots and screen recordings.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Spotter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["Metropolis-Bold.woff2", "Metropolis-Regular.woff2"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "spotter@buzzvel.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "browsingActivity", "websiteActivity", "websiteContent"]}}}}