{"manifest_version": 3, "name": "BetterBoxd Reviews", "version": "0.1.0", "description": "Filters Letterboxd film review lists down to substantive reviews (350+ words, low swear-word ratio, low emoji ratio, not AI-sounding) and auto-loads more as you scroll.", "browser_specific_settings": {"gecko": {"id": "better-boxd-reviews@agenttux.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://letterboxd.com/film/*/reviews/*", "*://www.letterboxd.com/film/*/reviews/*"], "js": ["content/swear-list.js", "content/ai-phrases.js", "content/filter.js", "content/content.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "web_accessible_resources": [{"resources": ["content/assets/no-results.jpg"], "matches": ["*://letterboxd.com/*", "*://www.letterboxd.com/*"]}]}