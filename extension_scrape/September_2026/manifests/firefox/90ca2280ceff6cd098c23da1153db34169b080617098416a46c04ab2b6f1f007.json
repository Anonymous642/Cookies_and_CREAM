{"manifest_version": 3, "name": "FDA Drugs Search", "version": "1.1", "description": "Quick search bar for Drugs@FDA", "browser_specific_settings": {"gecko": {"id": "fda-drugs-search@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "activeTab", "scripting"], "host_permissions": ["https://www.accessdata.fda.gov/scripts/cder/daf/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png"}}, "icons": {"48": "icon48.png"}, "omnibox": {"keyword": "fda"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.accessdata.fda.gov/scripts/cder/daf/index.cfm*"], "js": ["content.js"], "run_at": "document_end"}]}