{"manifest_version": 2, "name": "Foxus - Focus Mode for X", "description": "Stop doom-scrolling. Focus on one tweet at a time with a cinematic blur effect.", "version": "1.0.0", "short_name": "Foxus", "icons": {"16": "/icon/icon-16.png", "48": "/icon/icon-48.png", "128": "/icon/icon-128.png"}, "permissions": ["storage", "*://*.x.com/*", "*://*.twitter.com/*"], "web_accessible_resources": ["foxus.css"], "browser_specific_settings": {"gecko": {"id": "foxus-extension@nman1github.com", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Foxus Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content-scripts/content.js"]}]}