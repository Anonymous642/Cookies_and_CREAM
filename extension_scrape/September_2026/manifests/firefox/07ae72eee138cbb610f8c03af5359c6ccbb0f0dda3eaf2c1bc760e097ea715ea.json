{"manifest_version": 3, "name": "PokeChill - Fight Again Auto", "version": "1.0.0", "description": "Clique automatiquement sur le bouton \"Fight Again\" \u00e0 la fin de chaque combat sur play-pokechill.github.io, m\u00eame si l'onglet est en arri\u00e8re-plan ou la fen\u00eatre pas au premier plan.", "permissions": ["storage"], "host_permissions": ["https://play-pokechill.github.io/*"], "content_scripts": [{"matches": ["https://play-pokechill.github.io/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "PokeChill Auto Fight"}, "browser_specific_settings": {"gecko": {"id": "pokechill-fight-again-auto@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}