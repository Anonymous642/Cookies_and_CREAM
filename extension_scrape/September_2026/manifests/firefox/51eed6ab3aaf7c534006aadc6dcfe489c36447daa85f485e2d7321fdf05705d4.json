{"manifest_version": 3, "name": "Acatrix Position Capture", "short_name": "Acatrix", "description": "Capture academic position pages from Firefox and add them to your Acatrix Application Tracker.", "version": "0.1.0", "author": "Acatrix", "homepage_url": "https://acatrix.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Acatrix", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "position-capture@acatrix.com", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteContent"]}, "strict_min_version": "121.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://acatrix.com/*"]}