{"manifest_version": 3, "name": "RefCatastral Search", "version": "1.0.2", "description": "B\u00fasqueda ultrarr\u00e1pida de inmuebles y referencias catastrales desde cualquier web y Google Maps.", "icons": {"180": "icons/icon.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "addon@refcatastral.es", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_title": "Instrucciones de RefCatastral"}, "permissions": ["contextMenus", "activeTab"], "host_permissions": ["*://refcatastral.es/*", "*://www.refcatastral.es/*"], "content_scripts": [{"matches": ["*://www.google.es/maps/*", "*://www.google.com/maps/*", "*://maps.google.es/*", "*://maps.google.com/*", "*://google.es/maps/*", "*://google.com/maps/*"], "js": ["content_maps.js"], "css": ["content_styles.css"], "run_at": "document_idle"}]}