{"manifest_version": 2, "name": "Dual Work Timer", "version": "1.0.0", "description": "Two mutually exclusive work stopwatches with keyboard shortcuts, local history, daily and monthly totals, and CSV export.", "browser_specific_settings": {"gecko": {"id": "dual-work-timer@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "notifications"], "background": {"scripts": ["shared.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Dual Work Timer \u2014 paused", "default_popup": "popup.html", "default_icon": {"16": "icons/timer-paused-16.png", "32": "icons/timer-paused-32.png", "48": "icons/timer-paused-48.png", "96": "icons/timer-paused-96.png"}}, "commands": {"toggle-standard": {"suggested_key": {"default": "Alt+1"}, "description": "Start or pause Standard work"}, "toggle-other": {"suggested_key": {"default": "Alt+2"}, "description": "Start or pause Other work"}}, "icons": {"16": "icons/timer-paused-16.png", "32": "icons/timer-paused-32.png", "48": "icons/timer-paused-48.png", "96": "icons/timer-paused-96.png"}}