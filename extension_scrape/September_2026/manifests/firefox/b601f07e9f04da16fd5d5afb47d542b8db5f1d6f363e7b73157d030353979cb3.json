{"manifest_version": 2, "name": "MISL Tools", "version": "1.3", "description": "A Firefox extension for MISL Tools and Shortcuts.", "browser_specific_settings": {"gecko": {"id": "misl-tools@bodrulamin.github.io", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options-ui/options.html", "open_in_tab": true}, "permissions": ["contextMenus", "activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"]}, "icons": {"16": "resources/icons/icon16.png", "48": "resources/icons/icon48.png", "128": "resources/icons/icon.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "resources/icons/icon16.png", "48": "resources/icons/icon48.png", "128": "resources/icons/icon.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["settings.js", "content.js"]}], "web_accessible_resources": ["resources/*", "features/*", "helpers/*", "settings.js"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+M", "mac": "MacCtrl+Command+M"}}}}