{"manifest_version": 2, "name": "TikTok Live Comment Fix", "version": "1.0", "description": "Fixes the comment input in TikTok live streams for Firefox", "permissions": ["storage", "*://*.tiktok.com/*"], "applications": {"gecko": {"id": "tiktok-comment-fix@firefox.addon"}}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "content_scripts": [{"matches": ["*://*.tiktok.com/*"], "js": ["browser-polyfill.js", "content.js"]}], "icons": {"48": "icons/icon48.png"}}