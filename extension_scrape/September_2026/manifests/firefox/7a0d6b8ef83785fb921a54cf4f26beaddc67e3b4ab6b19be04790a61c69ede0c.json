{"manifest_version": 2, "name": "ApiTab", "description": "Lightweight, local-first API testing tool \u2014 a fast, minimal API client.", "version": "0.11.18", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "identity", "<all_urls>"], "commands": {"open-apitab": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Open the ApiTab workspace"}}, "sandbox": {"pages": ["sandbox.html"]}, "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "{94f73efd-e2be-4067-b2e9-be05268189d1}", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo", "authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "ApiTab", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}