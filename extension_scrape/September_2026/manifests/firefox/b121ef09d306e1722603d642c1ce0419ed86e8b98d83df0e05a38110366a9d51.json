{"manifest_version": 3, "name": "Clipboard Image Preview", "version": "1.0.2", "description": "Paste an image and preview it instantly in the popup.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Open Image Preview popup"}}, "browser_specific_settings": {"gecko": {"id": "image-preview-public@example.com", "strict_min_version": "109.0"}}}