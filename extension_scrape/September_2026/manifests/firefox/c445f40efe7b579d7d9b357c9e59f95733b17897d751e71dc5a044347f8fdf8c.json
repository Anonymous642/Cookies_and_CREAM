{"manifest_version": 2, "name": "Olmind Web Clipper", "description": "Capturez des pages web dans vos projets Olmind.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms", "http://127.0.0.1/*", "http://localhost/*"], "commands": {"capture-page": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Capturer la page dans Olmind"}}, "browser_specific_settings": {"gecko": {"id": "clipper@olmind.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Olmind Web Clipper", "default_popup": "popup.html"}}