{"manifest_version": 3, "name": "LinkedIn Next", "version": "0.1.0", "description": "Firefox WebExtension MV3 to automate navigation in LinkedIn Learning", "browser_specific_settings": {"gecko": {"id": "linkedin-next@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms"], "host_permissions": ["https://www.linkedin.com/learning/*"], "background": {"scripts": ["background/index.js"]}, "action": {"default_popup": "popup/index.html", "default_title": "LinkedIn Next"}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.linkedin.com/learning/*"], "js": ["content/index.js"], "run_at": "document_idle"}]}