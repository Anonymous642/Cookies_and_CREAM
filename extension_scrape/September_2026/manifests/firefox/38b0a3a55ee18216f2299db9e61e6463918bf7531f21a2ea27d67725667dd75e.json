{"manifest_version": 2, "name": "BlockTok: Mindful Doomscroll Blocker", "description": "Stop doomscrolling. Mindful blocker for TikTok, YouTube Shorts, Reels. Hit your limit, solve a puzzle to earn time back.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "alarms"], "options_ui": {"open_in_tab": true, "page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "blocktok@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "BlockTok", "default_popup": "popup.html"}}