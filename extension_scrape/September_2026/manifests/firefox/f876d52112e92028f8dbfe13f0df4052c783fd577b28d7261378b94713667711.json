{"manifest_version": 3, "name": "LeetApex", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "leetapex@extension.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"128": "extension_icon.png"}, "description": "A smart study browser extension optimizes spaced repetition by recommending practice questions based on your specific past mistakes rather than broad topic tags.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://leetcode.com/problems/*", "http://localhost:3300/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "css": ["content.css"], "js": ["components/big-O-Report.js", "components/questionBox.js", "components/hintButton.js", "components/difficultyFeedback.js", "components/showDueBanner.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "LeetApex"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://leetcode.com/*"]}]}