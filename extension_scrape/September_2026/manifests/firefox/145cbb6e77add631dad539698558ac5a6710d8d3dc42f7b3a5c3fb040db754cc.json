{"manifest_version": 2, "name": "WolfSecurity", "description": "A tool that allows employees to capture and upload screenshots so administrators can analyze and review internal assets.", "version": "0.0.2", "icons": {"32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "extension@fullsend.security", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}