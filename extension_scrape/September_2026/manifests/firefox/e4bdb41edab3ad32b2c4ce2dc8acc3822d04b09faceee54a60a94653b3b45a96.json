{"manifest_version": 2, "name": "Ajuste de Texto", "version": "1.0", "description": "Aumenta o disminuye el tama\u00f1o del texto en la p\u00e1gina actual.", "permissions": ["activeTab"], "browser_action": {"default_icon": "icons/icon.svg", "default_title": "Ajustar Tama\u00f1o de Texto", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "commands": {"increase-text": {"suggested_key": {"default": "Ctrl+Alt+Up"}, "description": "Aumentar tama\u00f1o del texto"}, "decrease-text": {"suggested_key": {"default": "Ctrl+Alt+Down"}, "description": "Disminuir tama\u00f1o del texto"}, "reset-text": {"suggested_key": {"default": "Ctrl+Alt+Home"}, "description": "Restablecer tama\u00f1o del texto"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "ajuste-texto@neuroflux.com", "data_collection_permissions": {"required": ["none"]}}}}