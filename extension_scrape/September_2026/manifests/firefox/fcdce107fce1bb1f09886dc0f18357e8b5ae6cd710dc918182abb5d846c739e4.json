{"manifest_version": 3, "name": "DutchMate", "version": "0.5.2", "description": "Learn Dutch while reading, with quick English and Telugu translations in context.", "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://dutchmate-backend.onrender.com/*"], "background": {"scripts": ["assets/background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_title": "Open DutchMate Learn"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "hover-translate@example.mgurramai.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}