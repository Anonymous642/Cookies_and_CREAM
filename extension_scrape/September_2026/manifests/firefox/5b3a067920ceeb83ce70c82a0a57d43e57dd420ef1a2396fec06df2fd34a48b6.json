{"manifest_version": 2, "name": "Neocat Ad Killer", "version": "1.3.7", "description": "Automatically skips pre-recorded ads in Kill Tony YouTube videos. Powered by SponsorBlock.", "permissions": ["storage", "https://www.youtube.com/*", "https://sponsor.ajay.app/*", "https://neocat.ca/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Neocat Ad Killer"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "killtony-skipper@extension", "strict_min_version": "109.0"}}, "background": {"scripts": ["background.js"], "persistent": true}}