{"manifest_version": 3, "name": "Socialstats: Social Media Analytics", "version": "1.1.2", "description": "Cross-platform social media insights for creators, brands, and posts - right inside your browser.", "permissions": ["activeTab", "cookies"], "host_permissions": ["https://data.songstats.com/*", "https://songstats.com/*", "https://*.songstats.com/*", "https://socialstats.com/*", "https://*.socialstats.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://facebook.com/*", "https://*.facebook.com/*", "https://youtube.com/*", "https://*.youtube.com/*", "https://youtu.be/*", "https://tiktok.com/*", "https://*.tiktok.com/*"], "action": {"default_title": "Socialstats: Social Media Analytics", "default_icon": {"16": "icons-gray/icon16.png", "48": "icons-gray/icon48.png", "128": "icons-gray/icon128.png"}}, "sidebar_action": {"default_title": "Socialstats: Social Media Analytics", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["socialstats-service.js", "utils.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "@socialstats", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}