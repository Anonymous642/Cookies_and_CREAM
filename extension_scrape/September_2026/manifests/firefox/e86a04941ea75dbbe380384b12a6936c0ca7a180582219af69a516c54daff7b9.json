{"manifest_version": 3, "name": "Flightradar24 to SimBrief", "version": "1.2", "description": "Capture flight data from Flightradar24 and open SimBrief with the relevant details.", "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "permissions": ["contextMenus", "storage", "tabs", "scripting"], "host_permissions": ["https://www.flightradar24.com/data/flights/*", "https://www.flightradar24.com/data/aircraft/*", "https://api.simbrief.com/*"], "content_scripts": [{"matches": ["https://www.flightradar24.com/data/flights/*", "https://www.flightradar24.com/data/aircraft/*"], "js": ["fr24-state-watcher.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "{9f3c2c9e-6c6a-4b6f-b5a1-3f5d2f9c8a77}", "data_collection_permissions": {"required": ["none"]}}}}