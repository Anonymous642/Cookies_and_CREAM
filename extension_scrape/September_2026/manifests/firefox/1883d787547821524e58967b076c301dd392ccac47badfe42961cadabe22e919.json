{"manifest_version": 2, "name": "Hackernews Summarize Comments", "description": "Summarize comments on Hackernews submission page using AI", "version": "2.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "hackernews-summarize-comments@kunver.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Popup", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content-scripts/content.js"]}]}