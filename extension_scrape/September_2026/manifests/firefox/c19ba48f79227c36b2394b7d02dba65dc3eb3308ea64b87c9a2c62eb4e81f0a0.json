{"manifest_version": 3, "name": "TabVault - Tab Manager & Session Saver", "version": "1.0.0", "description": "Save, organize, and restore your browser sessions. Manage tabs efficiently across Firefox and Edge.", "permissions": ["tabs", "storage", "sessions"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "tabvault@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"isExempt": false, "required": ["browsingActivity"]}}}}