{"manifest_version": 3, "name": "BookmarkStuff Extension", "version": "1.0.0", "description": "Quickly save bookmarks to your BookmarkStuff account. Capture the current page URL and title, add descriptions and tags, and save directly from your browser toolbar.", "author": "BookmarkStuff", "homepage_url": "https://bookmarkstuff.com", "permissions": ["tabs", "cookies"], "host_permissions": ["https://bookmarkstuff.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to BookmarkStuff", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "bookmarkstuff@bookmarkstuff.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity", "authenticationInfo"]}}}}