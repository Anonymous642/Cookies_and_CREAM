{"manifest_version": 3, "name": "Focus4Life \u2014 Website Friction", "version": "0.2.0", "description": "Gently friction distracting websites during a focus session. Companion for Focus4Life \u2014 no account, fails open.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "website-friction@focus4life.com", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["src/sw.js"], "type": "module"}, "action": {"default_title": "Focus4Life", "default_popup": "pages/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["pages/blocked.html"], "matches": ["<all_urls>"]}]}