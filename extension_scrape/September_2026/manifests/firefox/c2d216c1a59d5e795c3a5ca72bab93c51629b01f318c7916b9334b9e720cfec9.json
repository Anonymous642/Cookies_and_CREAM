{"manifest_version": 3, "name": "SchemaScope JSON-LD Inspector", "version": "1.0.0", "description": "Extract, inspect, copy, and validate JSON-LD schema markup from the current page. Runs locally with no tracking.", "browser_specific_settings": {"gecko": {"id": "schemascope-jsonld-inspector@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "scripting", "clipboardWrite", "storage"], "action": {"default_popup": "popup.html", "default_title": "SchemaScope JSON-LD Inspector"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "short_name": "SchemaScope"}