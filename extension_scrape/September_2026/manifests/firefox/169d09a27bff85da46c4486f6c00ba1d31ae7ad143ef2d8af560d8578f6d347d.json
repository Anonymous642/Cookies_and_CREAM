{"manifest_version": 3, "name": "raider-tools Embark Auth Bridge", "version": "1.0.0", "description": "Enables Embark authentication for raider-tools.app by routing local OAuth callbacks to the site.", "browser_specific_settings": {"gecko": {"id": "embark-login-bridge@ernst.local", "strict_min_version": "130.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["http://127.0.0.1/*", "https://raider-tools.app/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://raider-tools.app/*"], "js": ["presence-raider-tools.js"], "run_at": "document_start"}]}