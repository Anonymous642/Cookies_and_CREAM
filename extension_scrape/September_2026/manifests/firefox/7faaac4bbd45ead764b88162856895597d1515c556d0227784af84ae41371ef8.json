{"manifest_version": 2, "name": "Bandcamp Cover Finder", "version": "1.0.0", "description": "Affiche la pochette d'album en haute r\u00e9solution (taille r\u00e9elle, poids, format) sur les pages Bandcamp.", "author": "Konami", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Bandcamp Cover Finder", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.bandcamp.com/album/*", "*://*.bandcamp.com/track/*", "*://*.bandcamp.com/", "*://bandcamp.com/search*"], "js": ["shared.js", "content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "permissions": ["tabs", "*://*.bandcamp.com/*", "*://f4.bcbits.com/*"], "browser_specific_settings": {"gecko": {"id": "bandcamp-cover-finder@konami.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}