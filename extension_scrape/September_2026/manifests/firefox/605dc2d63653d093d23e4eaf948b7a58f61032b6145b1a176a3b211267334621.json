{"manifest_version": 3, "name": "Get Url", "description": "Adds a download button to images for easy downloading.", "version": "1.0.7", "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["<all_urls>"], "background": {"page": "background.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"toggle-buttons": {"suggested_key": {"default": "Alt+1", "mac": "Command+Shift+1"}, "description": "Toggle image download buttons"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/download-icon.png", "48": "icons/download-icon.png", "128": "icons/download-icon.png"}}, "icons": {"16": "icons/download-icon.png", "48": "icons/download-icon.png", "128": "icons/download-icon.png"}, "browser_specific_settings": {"gecko": {"id": "geturl-extension@mansurivilla.github.io"}}}