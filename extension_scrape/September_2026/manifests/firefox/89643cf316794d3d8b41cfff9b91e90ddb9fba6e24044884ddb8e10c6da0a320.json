{"manifest_version": 3, "name": "ReThink \u2014 Pause Before You Buy", "version": "1.0.1", "description": "Detects checkout pages anywhere on the web and asks you to pause before you buy \u2014 logs it to your ReThink account so you can decide with a clear head.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@rethinkapp.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["compat.js", "background.js"]}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "compat.js", "supabase-lite.js", "detector.js", "overlay.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["overlay.css", "icons/*.png"], "matches": ["<all_urls>"]}]}