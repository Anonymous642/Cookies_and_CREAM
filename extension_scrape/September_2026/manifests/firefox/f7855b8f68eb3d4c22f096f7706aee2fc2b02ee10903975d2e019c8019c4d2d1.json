{"manifest_version": 2, "name": "Search Insight & Visual Anchor Tool", "version": "1.0.0", "description": "Provides auditory and visual anchors for specific search terms to improve cognitive recognition.", "author": "Aria", "browser_specific_settings": {"gecko": {"id": "visual-anchor-tool@aria.pro", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://www.google.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.google.com/*"], "js": ["content.js"]}], "web_accessible_resources": ["grid.jpg", "*.mp3"]}