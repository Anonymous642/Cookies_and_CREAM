{"manifest_version": 3, "name": "Heizl_Video_Generator", "version": "2.2", "description": "Adds Heizl to every YouTube Video Thumbnail (Sub-Program of my 'DeGonker'-Series)", "action": {"default_title": "Heatlo", "default_popup": "popup.html"}, "icons": {"16": "icons/icon.png", "24": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "contextMenus", "storage"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["Main.js"]}], "web_accessible_resources": [{"matches": ["*://*.youtube.com/*"], "resources": ["images/67.png", "images/evilsecretheizl.gif", "images/glump.png", "images/minuslyfe.png", "images/mouther.png", "images/pointer.png", "images/schmimtechs.png", "images/scrata.png", "images/vssaloheizl.png", "images/wow.png"]}], "browser_specific_settings": {"gecko": {"id": "@HeizlVideoGenerator", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}}