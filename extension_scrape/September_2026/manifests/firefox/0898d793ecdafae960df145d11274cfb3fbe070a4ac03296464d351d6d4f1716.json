{"manifest_version": 3, "name": "Idle Tab Archiver", "version": "1.1.0", "description": "Automatically archives idle tabs after a certain period of inactivity to free up resources.", "permissions": ["tabs", "storage", "alarms", "menus", "notifications"], "browser_specific_settings": {"gecko": {"id": "idle-tab-archiver@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}