{"manifest_version": 3, "name": "ListSnap", "version": "1.0.0", "description": "Post ListSnap listings to Facebook Marketplace with one click.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["sidePanel", "storage", "tabs", "scripting"], "host_permissions": ["https://fb-api.gospace.au/*", "https://fb-fill.gospace.au/*", "https://www.facebook.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "side_panel": {"default_path": "sidebar/sidebar.html"}, "sidebar_action": {"default_panel": "sidebar/sidebar.html", "default_title": "ListSnap"}, "action": {"default_title": "ListSnap \u2014 click to open panel"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/create/*"], "js": ["content/fb-fill.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "browser_specific_settings": {"gecko": {"id": "listsnap@listsnap.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}