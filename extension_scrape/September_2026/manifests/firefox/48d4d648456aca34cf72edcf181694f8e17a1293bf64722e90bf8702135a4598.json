{"manifest_version": 3, "name": "eBay: Always Show 240 Listings", "version": "1.0", "description": "Forces eBay search and seller pages to show 240 items per page by default, while still letting you change it manually.", "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.de/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.pl/*", "*://*.ebay.at/*", "*://*.ebay.be/*", "*://*.ebay.ch/*", "*://*.ebay.ie/*", "*://*.ebay.nl/*", "*://*.ebay.com.hk/*", "*://*.ebay.com.my/*", "*://*.ebay.com.sg/*", "*://*.ebay.ph/*", "*://*.ebay.in/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup.html", "default_title": "eBay items-per-page setting", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "ebay-240-listings@local.extension", "data_collection_permissions": {"required": ["none"]}}}}