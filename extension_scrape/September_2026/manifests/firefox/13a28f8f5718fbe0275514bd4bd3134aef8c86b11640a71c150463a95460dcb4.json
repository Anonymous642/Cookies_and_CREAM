{"manifest_version": 2, "name": "FastFrame Capture", "version": "1.0.0", "description": "Capture high-quality frames from online videos instantly using a keyboard shortcut.", "permissions": ["activeTab", "downloads"], "background": {"scripts": ["background.js"]}, "commands": {"capture-frame": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Capture current video frame"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "fastframe-capture@amo.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}