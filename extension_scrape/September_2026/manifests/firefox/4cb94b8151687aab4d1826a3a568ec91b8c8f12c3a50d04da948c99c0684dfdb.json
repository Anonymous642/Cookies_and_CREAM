{"manifest_version": 2, "name": "VPN Hider - Privacy Shield", "version": "1.1.5", "description": "Prevents DNS leaks, WebRTC IP leaks, timezone mismatch, and fingerprinting. Auto-detects VPN location. Developed by SAKH.", "author": "SAKH", "homepage_url": "https://github.com/sakh", "permissions": ["privacy", "storage", "webRequest", "webRequestBlocking", "proxy", "dns", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "vpnhider@sakh.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "VPN Hider - Privacy Shield", "default_popup": "popup/popup.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}