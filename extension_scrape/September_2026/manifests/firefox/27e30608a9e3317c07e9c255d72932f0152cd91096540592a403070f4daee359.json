{"manifest_version": 2, "name": "WorkSight URL Bridge", "version": "1.3.0", "description": "Pushes active tab URLs to the WorkSight desktop agent for accurate productivity tracking.", "permissions": ["tabs", "activeTab", "storage", "webNavigation", "webRequest", "webRequestBlocking", "<all_urls>"], "web_accessible_resources": ["block.html", "block.js"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "worksight-url-bridge@worksight.app", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}}