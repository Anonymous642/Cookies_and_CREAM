{"manifest_version": 3, "name": "Timezone Auto Switcher", "version": "7.2.0", "description": "Automatically matches JavaScript local time to the current public IP timezone, including browser-routed VPN traffic, or lets you choose an IANA timezone manually.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["*://*/*", "https://ipwho.is/*", "https://ipapi.co/*"], "action": {"default_title": "Timezone Auto Switcher", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["page.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "@timezone-auto-switcher.nuvyq", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo"]}}}, "developer": {"name": "Nuvyq"}}