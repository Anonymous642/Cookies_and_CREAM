{"manifest_version": 3, "name": "TabSnapshot", "version": "1.0.1", "description": "Capture and restore entire browser workspaces with a single click.", "permissions": ["tabs", "storage", "windows", "alarms"], "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.js", "background.js"]}, "commands": {"save-snapshot": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current workspace as a snapshot"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "tabsnapshot@extension", "strict_min_version": "109.0"}}, "minimum_chrome_version": "88"}