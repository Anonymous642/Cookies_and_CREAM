{"manifest_version": 3, "name": "MarkFlow", "version": "0.6.0", "description": "Save bookmarks to MarkFlow with DOM-extracted title, description, and image.", "browser_specific_settings": {"gecko": {"id": "extension@markflow.fyi", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "bookmarksInfo"]}}}, "permissions": ["activeTab", "storage", "scripting", "contextMenus", "notifications", "alarms"], "optional_permissions": ["bookmarks", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Save to MarkFlow", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "MarkFlow", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"save-current-tab": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Alt+Shift+D"}, "description": "Save current tab to MarkFlow"}, "_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Alt+Shift+E"}, "description": "Open MarkFlow side panel"}}}