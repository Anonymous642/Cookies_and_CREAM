{"manifest_version": 3, "name": "X Cleaner Layout", "version": "1.0.13", "description": "Blendet bei X.com optional die rechte Leiste sprachunabh\u00e4ngig auf allen Seiten (Suchfeld bleibt sichtbar), die linke Leiste sowie die Home-Feeds 'For you' und 'Following' aus.", "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "action": {"default_title": "X Cleaner Layout", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "x-cleaner-layout@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/content.js"], "run_at": "document_start"}]}