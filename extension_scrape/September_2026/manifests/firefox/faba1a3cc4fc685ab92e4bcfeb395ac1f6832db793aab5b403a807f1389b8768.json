{"manifest_version": 2, "name": "PicMute \u2014 Mute Videos by Picture", "version": "3.5.2", "description": "Automatically mutes videos on any website when a saved picture appears.", "icons": {"16": "icons/picmute-16.png", "32": "icons/picmute-32.png", "48": "icons/picmute-48.png", "96": "icons/picmute-96.png", "128": "icons/picmute-128.png"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "PicMute", "default_icon": {"16": "icons/picmute-16.png", "32": "icons/picmute-32.png"}, "default_popup": "popup.html"}, "commands": {"toggle-for-tab": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Enable or disable the blocker on this tab"}}, "browser_specific_settings": {"gecko": {"id": "picmute@local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}