{"manifest_version": 3, "name": "InstDub \u2014 Your Language. Every Video.", "version": "1.0.5", "description": "Watch any video in your language. Real-time AI subtitles and natural dubbing for YouTube, X, and more.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>", "https://api.instdub.com/*", "https://app.instdub.com/*", "https://www.instdub.com/*", "wss://speech.platform.bing.com/*"], "background": {"page": "background.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://app.instdub.com/*", "https://www.instdub.com/*"], "js": ["auth-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "assets/icons/logo-white-16.png", "32": "assets/icons/logo-white-32.png", "48": "assets/icons/logo-white-48.png", "64": "assets/icons/logo-white-64.png", "128": "assets/icons/logo-white-128.png"}, "default_title": "InstDub"}, "icons": {"16": "assets/icons/logo-white-16.png", "32": "assets/icons/logo-white-32.png", "48": "assets/icons/logo-white-48.png", "64": "assets/icons/logo-white-64.png", "128": "assets/icons/logo-white-128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "instdub@instdub.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}