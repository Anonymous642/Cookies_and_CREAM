{"manifest_version": 3, "name": "Keyword Finder for Old Reddit", "version": "1.1.0", "description": "Scan old.reddit.com/r/all/new for one or more keywords and collect the title and URL of every matching post.", "browser_specific_settings": {"gecko": {"id": "keyword-finder-old-reddit@paulhp.addons", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_title": "Keyword Finder for Old Reddit", "default_popup": "popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "scripting", "clipboardWrite"], "host_permissions": ["https://old.reddit.com/*"], "content_scripts": [{"matches": ["https://old.reddit.com/r/all/new/", "https://old.reddit.com/r/all/new/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle"}]}