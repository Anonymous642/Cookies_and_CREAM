{"manifest_version": 3, "name": "MWX Color Comfort", "version": "1.0.0", "description": "Make ChatGPT more comfortable to use by changing the background color and other colors.", "author": "roymwxuk (https://roymwxuk)", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "mwx-color-comfort-chatgpt@roymwxuk.uk", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://chatgpt.com/*"], "action": {"default_title": "Color Comfort", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "css": ["content/content.css"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"48": "icon/icon-48.png", "64": "icon/icon-64.png", "96": "icon/icon-96.png", "128": "icon/icon-128.png"}}