{"name": "YouTube Playlist Deduper", "description": "Scan a YouTube playlist, mark duplicates, and optionally remove extras via the YouTube UI.", "version": "1.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_title": "YT Deduper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png"}}, "permissions": ["tabs", "activeTab", "storage"], "host_permissions": ["https://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "yt-deduper@313326.xyz", "strict_min_version": "109.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/playlist?list=*"], "js": ["content_script.js"], "run_at": "document_idle"}]}