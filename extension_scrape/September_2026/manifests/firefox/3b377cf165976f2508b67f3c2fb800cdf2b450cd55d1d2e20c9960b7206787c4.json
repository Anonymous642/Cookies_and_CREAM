{"manifest_version": 2, "name": "Forms AI Assistant", "version": "0.1.0", "description": "Scan Microsoft Forms and analyze structure with your AI API key.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_title": "Forms AI Assistant", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true, "browser_style": true}, "background": {"scripts": ["js/background.js"]}, "content_scripts": [{"matches": ["https://forms.office.com/*", "https://*.forms.office.com/*"], "js": ["js/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "forms-ai-assistant@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}