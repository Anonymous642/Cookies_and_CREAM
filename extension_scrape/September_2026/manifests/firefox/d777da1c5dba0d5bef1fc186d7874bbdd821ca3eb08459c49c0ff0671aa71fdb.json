{"manifest_version": 2, "name": "IMDb to Letterboxd redirect button", "version": "1.1", "description": "This extension adds a floating button to IMDb movie pages that redirects you to the corresponding movie page on Letterboxd.", "permissions": ["activeTab", "tabs", "storage", "*://www.imdb.com/*"], "icons": {"48": "icon.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.imdb.com/title/tt*"], "js": ["content.js"], "css": ["overlay.css"]}], "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "commands": {"open_letterboxd": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open Letterboxd for this movie"}}, "browser_specific_settings": {"gecko": {"id": "{becc9434-e4a3-46fe-91a7-fbd8c6073f04}"}}}