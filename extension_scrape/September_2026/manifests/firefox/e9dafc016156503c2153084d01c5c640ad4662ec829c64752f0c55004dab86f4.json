{"manifest_version": 3, "name": "Scrinium Clipper", "version": "0.4.13", "description": "One click saves the page you're reading into your Scrinium archive.", "action": {"default_title": "Save to Scrinium", "default_icon": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "setup.html", "open_in_tab": true}, "permissions": ["activeTab", "tabs", "scripting", "storage", "unlimitedStorage", "identity"], "host_permissions": ["https://api.apple-cloudkit.com/*"], "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "clipper@getscrinium.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteActivity", "websiteContent"]}}}}