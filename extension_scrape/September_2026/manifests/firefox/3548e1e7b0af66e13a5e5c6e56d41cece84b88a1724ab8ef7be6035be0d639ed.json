{"manifest_version": 3, "name": "FocusColor", "version": "1.0.0", "description": "Digital discipline extension that helps you focus by removing color from distracting websites", "author": "FocusColor Team", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "focuscolor@eld", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}