{"manifest_version": 3, "name": "ApplyForge", "version": "3.2.1", "description": "AI co-pilot for job applications \u2014 generate tailored CVs, cover letters, fit scores, and AI answers from supported job pages.", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://www.linkedin.com/*", "https://*.linkedin.com/*", "https://*.amazonaws.com/*", "https://*.cloudfront.net/*", "https://api.applyforge.net/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "applyforge@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity", "websiteContent"]}}}}