{"manifest_version": 3, "name": "YouTube Automix Killer", "version": "1.0", "description": "Removes automix playlists from YouTube URLs", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "youtube-automix-killer@zlojkolhoznik", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}