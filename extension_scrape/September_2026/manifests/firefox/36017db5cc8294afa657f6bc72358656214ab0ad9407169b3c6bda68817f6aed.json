{"manifest_version": 3, "name": "Reddit Sauce Linker", "version": "1.1", "description": "Finds 6-digit codes in Reddit comments and links them to a configurable website.", "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}, "default_title": "Set Custom Link URL"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content_script.js"]}], "browser_specific_settings": {"gecko": {"id": "sauce-linker@example.com"}}}