{"manifest_version": 2, "name": "Spaced Review Reminder", "version": "1.0.0", "description": "Reminds you to review topics at spaced intervals to help maintain long-term memory and consistent study habits.", "permissions": ["storage", "notifications", "alarms"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "spaced-review-reminder@id", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}