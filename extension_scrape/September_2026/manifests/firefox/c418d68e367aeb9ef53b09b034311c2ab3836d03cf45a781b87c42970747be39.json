{"manifest_version": 3, "name": "9if7: Wishlists Made Easy", "version": "0.1.3", "description": "Save and organize wishlists from any website: add items to your 9if7 account in one click!", "permissions": ["activeTab", "storage", "scripting"], "default_locale": "en", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://9if7.com/*", "*://*.9if7.com/*", "http://localhost/*"], "js": ["content-9if7.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "9if7-Wishlist-Firefox@9if7.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}