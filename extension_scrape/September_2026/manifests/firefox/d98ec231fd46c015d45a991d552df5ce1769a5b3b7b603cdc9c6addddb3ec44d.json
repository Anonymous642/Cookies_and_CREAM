{"manifest_version": 2, "name": "Global PDF Search and Downloader", "version": "1.0", "description": "Search and download PDF files from Google.", "permissions": ["activeTab", "downloads", "notifications", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "global-pdf-search@example.com", "strict_min_version": "79.0"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon-96.png", "48": "icon-96.png", "128": "icon-192.png"}}, "icons": {"96": "icon-96.png", "192": "icon-192.png", "512": "icon-512.png"}, "web_accessible_resources": ["icon-96.png", "icon-192.png", "icon-512.png", "favicon.svg", "favicon.ico", "apple-touch-icon.png"]}