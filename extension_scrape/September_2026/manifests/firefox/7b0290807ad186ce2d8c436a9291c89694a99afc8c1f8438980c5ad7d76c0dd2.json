{"manifest_version": 3, "name": "Qiosq", "version": "2.0.1", "description": "Save your favorite web pages with Qiosq", "browser_specific_settings": {"gecko": {"id": "qiosq@qiosq.webgrab.click", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["identity", "storage", "tabs", "scripting"], "host_permissions": ["https://*/", "http://*/"], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["icon.png", "icons/icon-16.png", "icons/icon-48.png", "icons/icon-128.png"], "matches": ["https://*/*", "http://*/*"]}]}