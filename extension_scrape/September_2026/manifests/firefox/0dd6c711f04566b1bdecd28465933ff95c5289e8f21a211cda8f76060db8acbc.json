{"manifest_version": 3, "name": "ADm Connector", "version": "1.5.65", "description": "Sends downloads and page media to ADm, the Avarwand Download Manager desktop application. Requires ADm to be installed.", "homepage_url": "https://github.com/avarwand/ADm", "author": "Avarwand", "browser_specific_settings": {"gecko": {"id": "adm-connector@avarwand", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "nativeMessaging", "cookies", "storage", "activeTab", "scripting", "notifications", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Send this page's media to ADm", "default_icon": {"48": "icon48.png"}}, "icons": {"48": "icon48.png"}}