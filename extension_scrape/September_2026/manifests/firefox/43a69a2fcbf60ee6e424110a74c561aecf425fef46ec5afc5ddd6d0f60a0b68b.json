{"manifest_version": 2, "name": "kravat", "description": "Finis la double saisie. Sauvegarde tes candidatures dans kravat directement depuis LinkedIn, Indeed, WTTJ et d'autres sites d'offres.", "version": "0.1.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "cookies", "storage", "scripting", "https://kravat.app/*"], "browser_specific_settings": {"gecko": {"id": "extension@kravat.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "kravat", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://jobs.lever.co/*", "https://www.indeed.com/*", "https://www.indeed.fr/*", "https://www.jobteaser.com/*", "https://www.linkedin.com/jobs/*", "https://www.welcometothejungle.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}