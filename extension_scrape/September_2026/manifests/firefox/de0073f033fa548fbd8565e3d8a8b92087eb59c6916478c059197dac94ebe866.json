{"manifest_version": 3, "name": "RR Random Picker", "version": "1.1", "description": "Find it hard to choose what to start reading next? Want to narrow down your choices? This extension picks 3 random stories from your Royal Road Read Later list.", "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["*://www.royalroad.com/*"], "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "random.rr.readlater.picker@example.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Royal Road Random Picker", "default_popup": "popup.html"}}