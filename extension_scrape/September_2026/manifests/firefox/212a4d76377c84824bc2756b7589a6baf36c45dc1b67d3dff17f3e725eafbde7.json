{"manifest_version": 3, "name": "SocketSentry", "version": "1.0", "description": "WebSocket Debugging Tool: Inspect and debug WebSocket connections in real-time", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["webRequest", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "socketsentry@gmail.com"}}}