{"manifest_version": 2, "name": "MusicFocus", "version": "1.0.0", "description": "Automatically mute music tabs when you open a 'focus' site (Docs, Wikipedia, e-learning). Restore when you leave.", "permissions": ["tabs", "storage", "activeTab"], "browser_action": {"default_popup": "popup.html", "default_title": "MusicFocus"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "musicfocus@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "applications": {"gecko": {"id": "musicfocus@example.com", "strict_min_version": "142.0"}}}