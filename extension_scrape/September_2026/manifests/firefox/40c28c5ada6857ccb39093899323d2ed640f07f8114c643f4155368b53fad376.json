{"manifest_version": 3, "name": "BuyFromUs", "description": "Highlight products from US companies on Amazon", "version": "0.6.1", "icons": {"16": "./default/icon-16.png", "32": "./default/icon-32.png", "48": "./default/icon-48.png", "128": "./default/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "leobuyfromus@gmail.com"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "BuyFromUs", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.amazon.com/**/cart*", "https://www.amazon.com/**/dp/*", "https://www.amazon.com/cart*", "https://www.amazon.com/dp/*", "https://www.amazon.com/gp/bestsellers/**/ref=*", "https://www.amazon.com/s?*"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}