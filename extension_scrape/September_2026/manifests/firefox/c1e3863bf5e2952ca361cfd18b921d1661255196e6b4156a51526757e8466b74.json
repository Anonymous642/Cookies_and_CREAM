{"manifest_version": 3, "name": "BookSlash \u2014 Team Shortcuts & Shared Bookmarks", "short_name": "BookSlash", "version": "1.1.4", "description": "Save links from any page and turn them into team shortcuts. b/ slugs that work right from your address bar.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "BookSlash", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "omnibox": {"keyword": "b/"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "storage", "alarms", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "host_permissions": ["https://b/*", "https://bookslash.app/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "extension@bookslash.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}