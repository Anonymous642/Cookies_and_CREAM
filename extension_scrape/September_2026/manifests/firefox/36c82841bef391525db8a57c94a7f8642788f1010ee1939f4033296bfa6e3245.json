{"manifest_version": 2, "name": "Keep Reasoning Closed (llama.cpp WebUI)", "version": "1.2.0", "description": "Keeps the Reasoning/Thinking block in the llama.cpp web UI collapsed by default, including while the model is generating. You can still open and close it manually. Add your server address on the options page.", "icons": {"48": "icon-48.webp", "96": "icon-96.webp", "128": "icon-128.webp"}, "browser_specific_settings": {"gecko": {"id": "keep-reasoning-closed@firedreams.studio", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "optional_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle"}]}