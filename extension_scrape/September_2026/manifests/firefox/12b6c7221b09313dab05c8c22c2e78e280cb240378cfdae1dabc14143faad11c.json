{"manifest_version": 3, "name": "Claude Farsi RTL Fix", "version": "1.0.1", "description": "Fixes right-to-left text rendering for Farsi/Persian in Claude.ai and applies the Vazir font.", "author": "MX AI ACADEMY", "browser_specific_settings": {"gecko": {"id": "claude-farsi-rtl-fix@mxaiacademy.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://claude.ai/*"], "css": ["rtl-fix.css"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["fonts/Vazir-Regular.woff2", "fonts/Vazir-Bold.woff2", "fonts/Vazir-Medium.woff2", "fonts/Vazir-Light.woff2"], "matches": ["https://claude.ai/*"]}]}