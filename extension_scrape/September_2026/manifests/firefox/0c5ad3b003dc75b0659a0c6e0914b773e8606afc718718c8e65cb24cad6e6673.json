{"manifest_version": 3, "name": "Lumist Hue Extractor", "version": "2.0.2", "description": "Extract dominant brand colors from any website and instantly export them to your Lumist Hue workspace as a Tailwind v4 theme.", "permissions": ["activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Extract Colors to Lumist Hue", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "hue@lumist.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}