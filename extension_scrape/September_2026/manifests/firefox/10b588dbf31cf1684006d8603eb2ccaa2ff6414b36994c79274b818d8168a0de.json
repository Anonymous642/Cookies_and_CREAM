{"manifest_version": 3, "name": "OhMyTab", "version": "2.2.1", "description": "Save open tabs as groups, restore them later, and optionally sync with your own server.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_title": "Save tabs"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "ohmytab@example.com", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity", "authenticationInfo"]}}}}