{"manifest_version": 3, "name": "Best Buy Marketplace Remover", "short_name": "BB No Marketplace", "version": "1.0.1", "description": "Removes third-party marketplace items from Best Buy search results, showing only products sold directly by Best Buy.", "author": "MoldyTaint", "browser_specific_settings": {"gecko": {"id": "bb-marketplace-remover@moldytaint.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.bestbuy.com/site/searchpage.jsp*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": []}