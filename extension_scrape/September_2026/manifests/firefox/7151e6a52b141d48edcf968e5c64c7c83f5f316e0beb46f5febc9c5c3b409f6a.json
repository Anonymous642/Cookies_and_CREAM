{"manifest_version": 2, "name": "fossync (dev)", "description": "Start a watch party and sync the page's video.", "version": "0.0.1", "permissions": ["storage", "activeTab", "https://fossync.cloud/*", "https://harness.fossync.cloud/*", "http://localhost:5173/*", "*://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "fossync@floatpoint.net", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "fossync", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://localhost/*", "https://harness.fossync.cloud/*"], "js": ["content-scripts/harness.js"]}, {"matches": ["*://www.youtube.com/*"], "js": ["content-scripts/youtube.js"]}]}