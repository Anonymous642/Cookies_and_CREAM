{"manifest_version": 3, "name": "Crossword Dictionary", "version": "0.1.0", "description": "Keep the crossword answers you want to remember.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "alarms", "theme"], "host_permissions": ["https://www.nytimes.com/crosswords/*", "https://www.newyorker.com/puzzles-and-games-dept/*", "https://games.newyorker.com/*", "https://crosswithfriends.com/*", "https://www.crosswithfriends.com/*", "https://en.wiktionary.org/*", "https://en.wikipedia.org/*", "https://commons.wikimedia.org/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Crossword Dictionary", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "dictionary.html", "open_in_tab": true}, "commands": {"capture-clue": {"suggested_key": {"default": "Alt+C"}, "description": "Save the highlighted crossword answer"}}, "content_scripts": [{"matches": ["https://www.nytimes.com/crosswords/*", "https://www.newyorker.com/puzzles-and-games-dept/*", "https://games.newyorker.com/*", "https://crosswithfriends.com/*", "https://www.crosswithfriends.com/*"], "js": ["page-bridge.js"], "world": "MAIN", "all_frames": true, "run_at": "document_idle"}, {"matches": ["https://www.nytimes.com/crosswords/*", "https://www.newyorker.com/puzzles-and-games-dept/*", "https://games.newyorker.com/*", "https://crosswithfriends.com/*", "https://www.crosswithfriends.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https://upload.wikimedia.org https://commons.wikimedia.org https://*.wikimedia.org; connect-src 'self' https://en.wiktionary.org https://en.wikipedia.org https://commons.wikimedia.org"}, "browser_specific_settings": {"gecko": {"id": "crossword-dictionary@nebunebu.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}