{"manifest_version": 2, "name": "Solace - Focus on what matters", "version": "1.0.0", "description": "Find your focus. Lock your browser to the tabs you're working on and let Solace keep you there.", "browser_specific_settings": {"gecko": {"id": "solace@solace-extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["tabs", "webNavigation", "storage", "notifications", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": {"16": "icons/unlocked-16.png", "32": "icons/unlocked-32.png", "48": "icons/unlocked-48.png"}, "default_title": "Solace", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "commands": {"quick-lock": {"suggested_key": {"default": "Ctrl+Alt+S"}, "description": "Quick lock with your default settings"}}, "icons": {"48": "icons/unlocked-48.png", "96": "icons/unlocked-96.png"}}