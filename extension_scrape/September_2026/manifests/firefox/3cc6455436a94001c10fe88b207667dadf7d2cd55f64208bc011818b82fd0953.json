{"manifest_version": 3, "name": "CurateKit", "description": "Save the current page to your CurateKit collections and lists.", "version": "2026.4.16", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "CurateKit", "default_popup": "popup/index.html"}, "permissions": ["cookies", "activeTab", "storage"], "host_permissions": ["https://www.curatekit.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "curatekit@curatekit.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}}