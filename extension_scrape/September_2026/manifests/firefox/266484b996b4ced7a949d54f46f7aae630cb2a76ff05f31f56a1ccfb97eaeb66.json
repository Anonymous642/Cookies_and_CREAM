{"manifest_version": 3, "name": "Clipboard Tools \u2013 Clean & Format Text", "version": "1.0", "short_name": "Clipboard Tools", "description": "Format text, clean clipboard, and manage tab groups.", "permissions": ["tabs", "storage", "clipboardWrite", "clipboardRead"], "host_permissions": ["https://tally.so/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open tab group manager", "default_icon": {"48": "icons/icon-48.png"}, "default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-48.png", "icons/icon-128.png", "popup/popup.html"], "matches": ["https://tally.so/*"]}], "browser_specific_settings": {"gecko": {"id": "clipboard-tools@example.com", "strict_min_version": "109.0"}}}