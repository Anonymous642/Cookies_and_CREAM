{"manifest_version": 3, "name": "Local Page Editor", "version": "1.0.3", "description": "Locally edit webpage text, input values, or safe HTML and persist those changes in your own Firefox browser.", "author": "LAF", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Local Page Editor", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/storage.js", "shared/html-sanitizer.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "browser_specific_settings": {"gecko": {"id": "local-page-editor@laf.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}