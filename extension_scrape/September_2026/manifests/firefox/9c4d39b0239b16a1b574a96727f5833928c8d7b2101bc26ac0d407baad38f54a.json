{"manifest_version": 2, "name": "J++ Runner", "version": "1.1.1", "description": "Run .jpp files in Firefox \u2014 a modern markup language that's faster and cleaner than HTML.", "author": "J++ Project", "browser_specific_settings": {"gecko": {"id": "jpp-runner@jpp-lang.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "J++ Runner", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "tabs", "storage", "contextMenus", "<all_urls>"], "content_scripts": [{"matches": ["*://*/*.jpp", "file:///*.jpp"], "js": ["jpp-parser.js", "jpp-renderer.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["editor.html", "icons/icon16.png", "icons/icon48.png", "icons/icon128.png"], "background": {"scripts": ["background.js"], "persistent": false}}