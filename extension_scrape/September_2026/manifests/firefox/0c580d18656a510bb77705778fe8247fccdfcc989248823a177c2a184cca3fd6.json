{"manifest_version": 2, "name": "UCW Attendance Helper", "version": "1.0", "description": "Match MS Teams attendance CSV to UCW attendance page and mark present/absent.", "browser_action": {"default_title": "Attendance Helper"}, "content_scripts": [{"matches": ["https://www.myucwest.ca/profile/courses/attendance/*"], "js": ["content.js"]}], "icons": {"16": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "ucw-attendance-helper@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}