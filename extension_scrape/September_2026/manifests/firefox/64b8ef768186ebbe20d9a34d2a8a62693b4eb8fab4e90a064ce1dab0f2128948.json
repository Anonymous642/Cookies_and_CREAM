{"manifest_version": 2, "name": "Time Guard", "version": "0.2.8", "description": "Parental control extension for managing children's daily screen time and website access with smart blocking features.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "author": "p3lo", "homepage_url": "https://github.com/p3lo", "permissions": ["storage", "tabs", "alarms", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "{f4646d3b-0f99-468d-9428-2a18cbb11962}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}, {"matches": ["<all_urls>"], "js": ["overlay.js"], "run_at": "document_idle"}], "options_page": "options.html", "browser_action": {"default_title": "Time Guard", "default_popup": "popup.html"}, "web_accessible_resources": ["blocked.html", "blocked.css"]}