{"manifest_version": 3, "name": "Canvas Ninja", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "canvas-ninja@benjuntilla.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "version": "0.1.0", "description": "Command-K palette for Canvas LMS", "permissions": ["storage", "alarms"], "host_permissions": ["https://*/"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.posthog.com https://*.i.posthog.com;"}, "background": {"scripts": ["background/index.js"]}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/index.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["content/palette/styles.css"], "matches": ["https://*/*"]}], "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open command palette"}}}