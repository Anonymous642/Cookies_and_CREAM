{"manifest_version": 2, "name": "Quick Translate ES", "version": "1.0.0", "description": "Traduce texto al espa\u00f1ol al instante. Selecciona cualquier texto y escucha su pronunciaci\u00f3n. R\u00e1pido, simple y sin complicaciones.", "author": "PunaBIO", "homepage_url": "https://github.com/punabio/quick-translate-es", "browser_specific_settings": {"gecko": {"id": "quick-translate-es@punabio.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "https://api.mymemory.translated.net/*", "https://translate.googleapis.com/*", "https://translate.google.com/*"], "icons": {"48": "icons/translate-48.svg", "96": "icons/translate-96.svg", "128": "icons/translate-128.svg"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "icons/translate-48.svg", "default_title": "Quick Translate ES", "default_popup": "popup/popup.html"}}