{"name": "Clikr", "version": "1.13.0.2", "manifest_version": 2, "description": "Wireless laser pointer, clicker, and video play/pause/skip for browser slide decks. Free, with one-time-payment Pro features.", "author": "Mattias Wallander <mattias@mawal.se>", "browser_specific_settings": {"gecko": {"id": "webpresenter@mawal.se", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent", "technicalAndInteraction"]}}}, "permissions": ["alarms", "storage", "*://*/*"], "background": {"scripts": ["/dist/browser-polyfill.js", "/dist/background/index.js"], "persistent": true}, "browser_action": {"default_title": "Clikr", "default_icon": "/dist/images/icon-disabled-light.png", "default_popup": "/dist/popup/index.html"}, "web_accessible_resources": ["/dist/controls/index.js", "/dist/images/icon-disabled-dark.png", "/dist/images/icon-enabled-dark.png", "/dist/images/icon-disabled-light.png", "/dist/images/icon-enabled-light.png"]}