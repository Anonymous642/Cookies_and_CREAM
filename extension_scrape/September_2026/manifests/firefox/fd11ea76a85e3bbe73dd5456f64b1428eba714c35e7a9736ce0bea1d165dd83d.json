{"manifest_version": 2, "name": "TubeJump", "version": "1.0.4", "description": "Jump from your computer to your phone instantly with a QR code.", "author": "marcelszymanski65@gmail.com", "permissions": ["tabs", "activeTab", "clipboardWrite", "storage"], "browser_specific_settings": {"gecko": {"id": "tubejump@marcelszymanski65.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"500": "icon.png"}, "web_accessible_resources": ["icon.png"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["content.js"]}]}