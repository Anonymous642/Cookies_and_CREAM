{"manifest_version": 2, "name": "WatchFlow", "version": "1.0", "description": "Kill tab clutter. Save videos, track progress, manage playlists \u2014 all inside YouTube.", "permissions": ["storage", "tabs", "https://www.youtube.com/*", "alarms", "notifications"], "browser_action": {"default_title": "WatchFlow Hub", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["bg.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["sidebar.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "watchflow@ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}