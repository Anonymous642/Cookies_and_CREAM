{"manifest_version": 3, "name": "SoundCloud Media Controls Fix", "version": "1.0.0", "description": "Workaround for Firefox bug 2067534: activates the OS-level media controls (lock screen, media keys, etc.) when SoundCloud plays audio only through the Web Audio API (e.g. the Likes/queue mini-player).", "browser_specific_settings": {"gecko": {"id": "soundcloud-media-controls-fix@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.soundcloud.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "SoundCloud Media Controls Fix", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}