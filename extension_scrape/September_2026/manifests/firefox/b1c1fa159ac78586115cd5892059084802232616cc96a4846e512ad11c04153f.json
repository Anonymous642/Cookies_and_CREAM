{"manifest_version": 2, "name": "Loonix", "description": "An extension that converts Linux to Loonix", "version": "0.0.0", "short_name": "Loonix", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "loonix@deadlymouth", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}