{"manifest_version": 2, "name": "Digital Lock", "version": "1.0.0", "description": "Protect websites using a PIN.", "browser_specific_settings": {"gecko": {"id": "digital-lock-firefox@lekhana.dev", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "Digital Lock", "default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}