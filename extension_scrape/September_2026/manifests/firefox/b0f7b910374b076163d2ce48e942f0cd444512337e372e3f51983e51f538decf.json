{"manifest_version": 2, "name": "Discord Vault - Account Switcher", "version": "2.6", "description": "Futuristic, local, and safe Discord account vault & token switcher with container support.", "browser_specific_settings": {"gecko": {"id": "discord-vault@local", "strict_min_version": "109.0"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "permissions": ["storage", "tabs", "cookies", "contextualIdentities", "https://discord.com/*", "https://*.discord.com/*"], "browser_action": {"default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_popup": "popup.html", "default_title": "Discord Vault"}, "content_scripts": [{"matches": ["https://discord.com/*", "https://*.discord.com/*"], "js": ["content.js"], "run_at": "document_start"}]}