{"manifest_version": 3, "name": "SUP - Super Ultimate Privacy", "version": "1.3.2", "description": "Add-on privasi tingkat tinggi: Anti-Fingerprinting, WebRTC Guard, DNR Blocker, dan Header Hardening.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "SUP Active"}, "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "privacy", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["privacy-guard.js"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_sup", "enabled": true, "path": "rules/block_rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "sup-privacy@local.test", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}