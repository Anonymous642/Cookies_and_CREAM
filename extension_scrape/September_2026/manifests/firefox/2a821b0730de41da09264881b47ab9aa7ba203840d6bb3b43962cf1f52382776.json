{"manifest_version": 3, "name": "watchlogg", "version": "0.5.19", "description": "Logs what you watch to your watchlogg diary. You choose which sites it runs on.", "browser_specific_settings": {"gecko": {"id": "watchlogg@watchlogg.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "permissions": ["storage", "alarms", "scripting", "activeTab", "tabs"], "host_permissions": ["https://api.watchlogg.com/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*"], "background": {"scripts": ["log.js", "platform.js", "blocked-hosts.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_title": "watchlogg", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}