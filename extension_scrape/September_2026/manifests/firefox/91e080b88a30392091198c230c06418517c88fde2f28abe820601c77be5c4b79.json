{"manifest_version": 3, "name": "ckopet", "version": "0.0.2", "description": "Save bookmarks and screenshots to ckopet", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon.png"}, "action": {"default_icon": "icons/icon.png", "default_popup": "popup.html", "default_title": "Save to ckopet"}, "browser_specific_settings": {"gecko": {"id": "ckopet@ckopet", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}