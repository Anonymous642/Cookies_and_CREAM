{"manifest_version": 3, "name": "patente.ar Linker", "short_name": "patente.ar", "version": "0.1.0", "description": "Abri el reporte de una patente en patente.ar desde Firefox donde aparezca un dominio argentino.", "homepage_url": "https://patente.ar/extension-browser-dominio", "browser_specific_settings": {"gecko": {"id": "linker@patente.ar", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "patente.ar Linker", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage"], "web_accessible_resources": [{"resources": ["icons/link-icon.svg"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://patente.ar/*", "https://*.patente.ar/*"], "js": ["plate-linker.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}