{"manifest_version": 2, "name": "Lemmy Upload", "version": "1.3.0", "description": "Right-click images or Twitter/X posts and upload them to a Lemmy community, with Catbox/Cobalt support for videos.", "browser_specific_settings": {"gecko": {"id": "lemmy-media-uploader@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["contextMenus", "tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": true}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://www.twitter.com/*", "*://x.com/*", "*://www.x.com/*"], "js": ["twitter-content.js"], "run_at": "document_idle"}]}