{"manifest_version": 2, "name": "Indexer", "description": "A smarter bookmark manager with AI-assisted organization, bookmark audits, focused browsing sessions, and optional sync.", "version": "1.0.23", "icons": {"16": "/icon/icon-16.png", "32": "/icon/icon-32.png", "48": "/icon/icon-48.png", "128": "/icon/icon-128.png"}, "commands": {"_execute_action": {"description": "Open Indexer popup", "suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}}, "open-indexer-settings": {"description": "Open Indexer settings page", "suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}}}, "permissions": ["bookmarks", "cookies", "storage", "tabGroups", "tabs", "https://getindexer.com/*"], "browser_specific_settings": {"gecko": {"id": "indexer-extension@getindexer.com", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Indexer", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://getindexer.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}