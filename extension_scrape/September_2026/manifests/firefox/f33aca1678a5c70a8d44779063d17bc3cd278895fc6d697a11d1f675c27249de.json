{"manifest_version": 2, "name": "Confluence PDF Archiver", "version": "1.0.3", "description": "Confluence-Seiten als PDF exportieren und archivieren. Falls noetig, in permissions *://<deine-domain>/* ergaenzen.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "downloads", "storage", "tabs", "*://*.atlassian.net/*"], "optional_permissions": ["*://*/*"], "background": {"scripts": ["utils/confluence-url-parser.js", "background/background.js"]}, "browser_action": {"default_title": "Confluence PDF Archiver", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["*://*.atlassian.net/wiki/*", "*://*.atlassian.net/spaces/*", "*://*.atlassian.net/display/*", "*://*.atlassian.net/pages/viewpage.action*", "*://*/wiki/*", "*://*/spaces/*", "*://*/display/*", "*://*/pages/viewpage.action*"], "js": ["utils/confluence-url-parser.js", "content/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "confluence-pdf-archiver@local", "data_collection_permissions": {"required": ["none"]}}}}