{"manifest_version": 3, "name": "Vesselock", "version": "1.0.0", "description": "Open one-off links in self-cleaning Firefox containers that disappear when their last tab closes.", "permissions": ["contextualIdentities", "menus", "storage", "tabs"], "background": {"scripts": ["core.js", "background.js"]}, "action": {"default_title": "Vesselock", "default_popup": "popup.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "vesselock@threshold.tools", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "incognito": "not_allowed", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}