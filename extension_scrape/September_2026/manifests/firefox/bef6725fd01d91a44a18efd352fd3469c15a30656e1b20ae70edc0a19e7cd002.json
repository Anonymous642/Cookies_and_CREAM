{"manifest_version": 2, "name": "Nonstick", "version": "0.6.2", "icons": {"32": "icons/logo32.png", "64": "icons/logo64.png"}, "description": "Nonstick is a plugin for the Firefox web browser aiming to prevent getting stuck on social media platforms while still allowing limmited access from outside. This is achieved by allowing visits from search results or direct links, but blocking access to home pages and limiting navigation on the platform. In addition, reccomended content commonly found on such sites is hidden if possible to prevent distractions.", "homepage_url": "https://gitlab.com/amaebe/nonstick", "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "storage", "nativeMessaging"], "browser_action": {"default_title": "Nonstick", "default_popup": "popup/popup.html", "default_icon": {"32": "icons/logo32.png", "64": "icons/logo64.png"}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["sites/reddit/content.js"], "css": ["sites/reddit/content.css"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["sites/youtube/content.js"], "css": ["sites/youtube/content.css"], "run_at": "document_start"}], "background": {"scripts": ["common/daemon.js", "common/block.js", "sites/reddit/block.js", "sites/youtube/block.js"], "persistent": true}, "web_accessible_resources": ["blocked.html", "blocked.css"], "browser_specific_settings": {"gecko": {"id": "nonstick@mlata.me", "data_collection_permissions": {"required": ["none"]}}}}