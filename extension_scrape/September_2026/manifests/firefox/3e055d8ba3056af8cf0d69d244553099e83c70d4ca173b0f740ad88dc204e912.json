{"manifest_version": 3, "name": "Chill Subs Magazine Stats", "version": "1.0.0", "description": "Stop guessing about literary magazines. See acceptance rates, response times, and real submission data while you browse.", "browser_specific_settings": {"gecko": {"id": "magazine-stats@chillsubs.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://www.chillsubs.com/*"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "dist/background.js", "scripts": ["dist/background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["images/not-found.svg", "images/not-found-white.svg", "images/checkmark.svg", "fonts/Inter-VariableFont_opsz,wght.woff2"], "matches": ["https://*/*"]}]}