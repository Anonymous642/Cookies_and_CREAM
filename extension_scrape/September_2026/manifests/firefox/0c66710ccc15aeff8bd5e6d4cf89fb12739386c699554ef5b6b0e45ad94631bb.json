{"manifest_version": 3, "name": "Picture in Picture", "version": "1.0.4", "description": "Pop any video out of the page. One click, works everywhere with HTML5 video.", "permissions": ["activeTab", "notifications", "scripting", "storage"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Picture in Picture (Alt+P)", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"toggle-pip": {"suggested_key": {"default": "Alt+P"}, "description": "Toggle Picture in Picture on the largest visible video"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "picture-in-picture@extendforge.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}}