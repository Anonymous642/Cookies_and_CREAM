{"manifest_version": 3, "name": "FrigoChef", "version": "1.1.0", "description": "Lit les produits de votre panier Coop ou Migros et propose des recettes \u00e0 cuisiner avec, en fran\u00e7ais.", "browser_specific_settings": {"gecko": {"id": "frigochef@frigochef.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["storage"], "host_permissions": ["https://frigochef.frigochef.workers.dev/*"], "action": {"default_title": "FrigoChef \u2014 ouvrir le panneau", "default_icon": {"16": "images/icons/icon-16.png", "32": "images/icons/icon-32.png", "48": "images/icons/icon-48.png", "128": "images/icons/icon-128.png"}}, "sidebar_action": {"default_title": "FrigoChef", "default_panel": "popup.html", "default_icon": {"16": "images/icons/icon-16.png", "32": "images/icons/icon-32.png", "48": "images/icons/icon-48.png"}}, "background": {"scripts": ["src/background/service-worker.js"]}, "icons": {"16": "images/icons/icon-16.png", "32": "images/icons/icon-32.png", "48": "images/icons/icon-48.png", "128": "images/icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.migros.ch/*", "https://www.coop.ch/*"], "js": ["src/content/dom-selector.js", "src/content/product-validator.js", "src/content/product-extractor.js", "src/content/ingredient-converter.js", "src/content/basket-observer.js", "src/content/content.js", "src/content/init.js"], "run_at": "document_idle"}]}