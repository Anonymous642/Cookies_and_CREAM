{"manifest_version": 3, "name": "ChatTrail", "short_name": "ChatTrail", "version": "1.0.1", "description": "A local message navigator and pinned-message panel for ChatGPT conversations.", "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["i18n.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "ChatTrail", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "chattrail@chikirao.github.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}