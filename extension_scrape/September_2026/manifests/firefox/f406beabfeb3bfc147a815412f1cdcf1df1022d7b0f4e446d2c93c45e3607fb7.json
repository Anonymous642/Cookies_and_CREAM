{"manifest_version": 3, "name": "Robtex", "description": "Shows Robtex info about the site you are on", "version": "2.2.1", "browser_specific_settings": {"gecko": {"id": "toolbar@robtex.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png"}}, "permissions": ["activeTab", "storage"], "optional_permissions": ["tabs"], "host_permissions": ["https://robtex.com/*"]}