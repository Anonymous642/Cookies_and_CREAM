{"manifest_version": 3, "name": "Discogs Price Sorter & Vinyl Enhancer", "version": "1.0.0", "description": "Sort Discogs marketplace listings by total price.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "discogs-price-sorter@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "host_permissions": ["*://*.discogs.com/*"], "content_scripts": [{"matches": ["*://*.discogs.com/sell/release/*", "*://*.discogs.com/sell/list*"], "js": ["content.js"], "css": ["styles.css"]}]}