{"manifest_version": 3, "name": "Verification Assistant", "version": "1.0.0", "description": "H\u1ed7 tr\u1ee3 ph\u00e1t hi\u1ec7n v\u00e0 th\u00f4ng b\u00e1o cho ng\u01b0\u1eddi d\u00f9ng th\u1ef1c hi\u1ec7n x\u00e1c th\u1ef1c CAPTCHA/Cloudflare th\u1ee7 c\u00f4ng m\u1ed9t c\u00e1ch thu\u1eadn ti\u1ec7n.", "browser_specific_settings": {"gecko": {"id": "verification-assistant@local.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/service-worker.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Verification Assistant"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/detector.js"], "run_at": "document_idle", "all_frames": true}]}