{"manifest_version": 3, "name": "Seed Imagine - Media Helper", "version": "1.0.0", "description": "Quick access to seedimagine.com and local download shortcuts for selected images and videos.", "homepage_url": "https://seedimagine.com/", "action": {"default_title": "Seed Imagine - Media Helper", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["contextMenus", "downloads"], "icons": {"48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "seedimagine-com-media-helper@seedimagine.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}