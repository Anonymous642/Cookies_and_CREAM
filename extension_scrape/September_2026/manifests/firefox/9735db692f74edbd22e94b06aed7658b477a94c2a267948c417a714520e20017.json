{"manifest_version": 2, "name": "Tab Volume Slider", "version": "1.1.0", "description": "Control the volume of media elements independently for each Firefox tab.", "author": "Dominik", "icons": {"48": "icons/tab-volume.svg", "96": "icons/tab-volume.svg"}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "browser_action": {"default_title": "Tab Volume", "default_popup": "popup.html", "default_icon": {"32": "icons/tab-volume.svg", "64": "icons/tab-volume.svg"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["page_volume.js"], "browser_specific_settings": {"gecko": {"id": "tab-volume-slider@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "91.0"}}}