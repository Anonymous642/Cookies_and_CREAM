{"manifest_version": 3, "name": "Image Replacer", "version": "1.0.0", "description": "This addon replaces images with pictures of Nicholas Cage. What isn't there to love?", "browser_specific_settings": {"gecko": {"id": "@image-replacer-ok", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["cageify.js"]}], "permissions": ["storage"], "options_ui": {"page": "options.html", "browser_style": true}, "homepage_url": "http://github.com/pvrs12/NicCageAddon"}