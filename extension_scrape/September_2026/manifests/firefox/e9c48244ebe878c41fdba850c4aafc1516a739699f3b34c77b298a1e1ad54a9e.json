{"manifest_version": 3, "name": "Online Mini Tools", "version": "1.0.0", "description": "Search and quickly access all tools from onlineminitools.com", "permissions": ["storage", "tabs"], "host_permissions": ["http://127.0.0.1:8888/*", "https://onlineminitools.com/*"], "browser_specific_settings": {"gecko": {"id": "tools@onlineminitools.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://127.0.0.1:8888/*", "https://onlineminitools.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}