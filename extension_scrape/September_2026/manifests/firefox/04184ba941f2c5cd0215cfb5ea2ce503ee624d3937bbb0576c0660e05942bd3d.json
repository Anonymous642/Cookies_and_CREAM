{"manifest_version": 2, "name": "Twos: The best place to write things down", "description": "Capture the page you are on, a link, or selected text straight into Twos.", "version": "1.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "activeTab", "scripting", "contextMenus", "notifications", "identity", "https://writethingsdown.com/*", "https://www.writethingsdown.com/*", "https://twosapp.com/*", "https://www.twosapp.com/*", "https://read.amazon.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@twosapp.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Twos", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://read.amazon.com/notebook*"], "run_at": "document_idle", "js": ["content-scripts/read-amazon.js"]}, {"matches": ["https://twosapp.com/*", "https://writethingsdown.com/*", "https://www.twosapp.com/*", "https://www.writethingsdown.com/*"], "run_at": "document_idle", "js": ["content-scripts/writethingsdown.js"]}]}