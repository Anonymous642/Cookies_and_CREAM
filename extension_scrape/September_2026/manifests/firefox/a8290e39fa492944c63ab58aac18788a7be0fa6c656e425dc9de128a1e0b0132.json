{"manifest_version": 2, "name": "Permission Monitor", "version": "1.3", "description": "Monitors, logs, and alerts users about browser permissions requested and used by websites.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["permissions", "tabs", "storage", "notifications", "<all_urls>"], "background": {"scripts": ["background.js", "storage.js"], "persistent": false}, "browser_action": {"default_title": "Permission Monitor", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@Permission-Monitor", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}