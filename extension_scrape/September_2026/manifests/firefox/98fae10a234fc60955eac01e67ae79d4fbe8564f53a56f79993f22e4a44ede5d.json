{"manifest_version": 3, "name": "Website Email Finder \u2014 Deutschland", "version": "1.0", "description": "Find emails and phone numbers on German websites. Scans Kontakt, Impressum, and other German contact pages.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Find contacts on German websites"}, "browser_specific_settings": {"gecko": {"id": "email-finder-de@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}}