{"manifest_version": 2, "name": "Smart Note", "version": "1.0.2", "description": "Full-featured note sidebar. Select any text on any website, right-click and save as note. Search, pin, tags, rich editor & export, built by Foxaura AI.", "author": "Smart Note", "browser_specific_settings": {"gecko": {"id": "smartnote@foxauraai.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "developer": {"name": "Foxaura AI", "url": "https://foxauraai.com/"}, "homepage_url": "https://foxauraai.com/", "permissions": ["storage", "contextMenus", "activeTab", "tabs"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background/background.js"]}, "sidebar_action": {"default_title": "Smart Note", "default_panel": "sidebar/sidebar.html", "default_icon": "icons/icon-32.png", "open_at_install": true}, "browser_action": {"default_title": "Open Smart Note sidebar", "default_icon": "icons/icon-32.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+N"}, "description": "Toggle Smart Note sidebar"}}}