{"manifest_version": 2, "name": "Focus Guard", "version": "2.4.3", "description": "Stay on task by fencing your browser to an allow-list of sites for a chosen duration. Wander off and Focus Guard steers you back with a calm lock screen and a countdown until the session ends.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{460a7f9e-8b6d-40a0-a217-3106720c1e7d}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "alarms", "notifications", "tabs", "<all_urls>"], "background": {"scripts": ["app/background.js"]}, "browser_action": {"default_title": "Focus Guard", "default_popup": "app/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}