{"manifest_version": 3, "name": "Speed Reader Extension", "version": "1.0", "description": "A speed reader overlay and popup to quickly read web articles.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://archive.org/*", "https://*.archive.org/*"], "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "action": {"default_title": "Speed Read this page", "default_icon": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "focused-reader@jandrus.com", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Open Speed Reader"}}, "web_accessible_resources": [{"resources": ["overlay.html", "overlay.css", "overlay.js", "reader_engine.js", "analytics.js", "jszip.min.js"], "matches": ["<all_urls>"]}]}