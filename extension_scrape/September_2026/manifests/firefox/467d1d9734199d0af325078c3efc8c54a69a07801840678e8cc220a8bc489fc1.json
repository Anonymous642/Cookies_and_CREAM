{"manifest_version": 3, "name": "Smart Retry System", "version": "1.3", "description": "Detects failed browser actions and recommends intelligent retry strategies.", "permissions": ["tabs", "storage", "notifications", "activeTab", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["retryEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "action": {"default_popup": "popup.html", "default_title": "Smart Retry System"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Smart-Retry-System", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}