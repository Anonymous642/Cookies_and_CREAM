{"manifest_version": 3, "name": "Brightery Notes \u2014 Secure Autofill", "version": "1.1.2", "description": "Autofill user-selected identity, address and card details from your encrypted Brightery Notes vault.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://notes.brightery.com/*"], "action": {"default_popup": "popup.html", "default_title": "Brightery Notes"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "secure-autofill@notes.brightery.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "financialAndPaymentInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}