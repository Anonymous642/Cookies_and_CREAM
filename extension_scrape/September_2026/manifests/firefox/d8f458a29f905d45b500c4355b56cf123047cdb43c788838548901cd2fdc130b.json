{"manifest_version": 2, "name": "Cookie Vault", "version": "6.0.0", "description": "Server-authenticated cookie export/import with expiry, selective export, and tamper-proof limits.", "browser_specific_settings": {"gecko": {"id": "cookie-vault@cookievault", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "browsingActivity"], "optional": []}}, "gecko_android": {"strict_min_version": "113.0"}}, "permissions": ["cookies", "tabs", "activeTab", "storage", "alarms", "webNavigation", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}