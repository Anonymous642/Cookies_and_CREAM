{"manifest_version": 2, "name": "Wishio Quick Add", "version": "1.0.3", "description": "Add products to your Wishio with just one click.", "permissions": ["storage", "activeTab"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "wishio@addon", "strict_min_version": "109.0", "data_collection_permissions": {"collectsTelemetry": false, "collectsAccountIdentifiers": false, "collectsPersonalInformation": false, "required": ["none"]}}}}