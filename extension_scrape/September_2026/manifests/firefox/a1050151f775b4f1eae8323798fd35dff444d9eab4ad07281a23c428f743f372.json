{"manifest_version": 3, "name": "StaleTabs", "version": "1.0.1", "description": "Automatically discard and close stale tabs", "browser_specific_settings": {"gecko": {"id": "staletabs@lawrence.gripper", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "alarms"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Show tab summary", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}