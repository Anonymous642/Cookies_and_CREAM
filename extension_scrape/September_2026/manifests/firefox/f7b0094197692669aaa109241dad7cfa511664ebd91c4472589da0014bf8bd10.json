{"manifest_version": 3, "name": "Clip Master", "version": "1.0.0", "description": "A browser extension to manage and track clipboard history.", "permissions": ["clipboardRead", "clipboardWrite", "storage", "activeTab"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "index.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "clipboard-icon.png", "48": "clipboard-icon.png", "128": "clipboard-icon.png"}, "browser_specific_settings": {"gecko": {"id": "clipmaster@gmail.com", "strict_min_version": "91.0"}}}