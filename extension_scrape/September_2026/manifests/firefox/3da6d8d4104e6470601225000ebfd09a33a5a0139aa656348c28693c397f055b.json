{"manifest_version": 3, "name": "Google Meet Live Translator", "version": "1.1.0", "description": "Translates Google Meet live captions in real time with minimal latency and duplicate-request protection.", "permissions": ["storage"], "host_permissions": ["https://meet.google.com/*", "https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["selectors.js", "translator.js", "ui.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "google-meet-translator@local-dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}