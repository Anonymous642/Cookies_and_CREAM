{"manifest_version": 2, "name": "Privacy Moderation Web", "version": "0.1.0", "description": "Classifies the text you type with privacy-moderation models running locally.", "permissions": ["activeTab", "<all_urls>", "storage"], "browser_specific_settings": {"gecko": {"id": "privacy-moderation-web@progressx.co"}}, "background": {"page": "background.html", "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "icons": {"48": "icons/icon-48.png"}, "content_security_policy": "script-src 'self'; object-src 'self'"}