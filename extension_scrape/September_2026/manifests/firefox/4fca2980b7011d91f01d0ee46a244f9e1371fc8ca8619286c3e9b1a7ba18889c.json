{"manifest_version": 3, "name": "Carnets", "version": "0.2.1", "description": "Rangez vos contacts LinkedIn en listes, depuis leur page de profil. Sans compte, sans serveur : tout reste dans votre navigateur.", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["contenu.js"], "css": ["contenu.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Carnets", "default_icon": {"16": "icones/16.png", "48": "icones/48.png", "128": "icones/128.png"}}, "icons": {"16": "icones/16.png", "48": "icones/48.png", "128": "icones/128.png"}, "browser_specific_settings": {"gecko": {"id": "linkedin-list@kaankarabulut.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}