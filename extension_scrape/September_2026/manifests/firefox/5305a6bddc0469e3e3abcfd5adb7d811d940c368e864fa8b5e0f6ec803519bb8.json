{"manifest_version": 3, "name": "Zoho Task Link Copier", "version": "1.1", "description": "Copia o c\u00f3digo + nome + link de tarefas do Zoho Projects com um atalho", "permissions": ["clipboardWrite", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://projects.zoho.com/*", "https://*.zoho.com/*"], "browser_specific_settings": {"gecko": {"id": "zoho-task-copier@artur_ur_code", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"copy-task-link": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copiar nome e link da tarefa atual"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://projects.zoho.com/*", "https://*.zoho.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}