{"manifest_version": 3, "name": "AntiShorts", "version": "0.1.0", "description": "Blocks YouTube Shorts recommendation shelves and prevents moving between Shorts in the Shorts viewer.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png"}, "default_title": "AntiShorts settings", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "antishorts@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["settings.js", "content-script.js"], "css": ["styles.css"], "run_at": "document_start"}]}