{"manifest_version": 3, "name": "Kibosh Extension", "version": "9.0", "description": "Multi-browser extension for latency and DNS checks.", "icons": {"128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "kibosh-dns@kibosh.com", "strict_min_version": "110.0"}}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://*.kibosh.com/*", "https://kibosh.com/*", "https://8.8.8.8/*", "https://1.1.1.1/*", "http://192.168.10.1/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Kibosh Extension"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}, {"matches": ["https://kibosh.com/login*", "https://portal.kibosh.com/login*"], "js": ["autologin-portal.js"], "run_at": "document_idle"}, {"matches": ["http://192.168.10.1/*"], "js": ["autologin-local.js"], "run_at": "document_idle"}]}