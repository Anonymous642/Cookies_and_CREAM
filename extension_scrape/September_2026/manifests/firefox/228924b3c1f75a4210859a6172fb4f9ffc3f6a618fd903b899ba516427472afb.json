{"manifest_version": 3, "name": "Wordle Word Checker", "version": "1.0", "description": "Highlights guesses if they were past Wordle answers.", "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://www.rockpapershotgun.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.nytimes.com/games/wordle/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["wordle-answers.txt"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "@wordle-word-checker", "strict_min_version": "58.0"}}}