{"manifest_version": 2, "name": "VIUko", "version": "1.0.6", "description": "Review browser file downloads in VIUko and hand confirmed downloads to the desktop app.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "nativeMessaging", "notifications", "storage", "tabs", "webRequest", "http://*/*", "https://*/*"], "optional_permissions": ["cookies"], "background": {"scripts": ["shared/constants.js", "shared/browser-adapter.js", "shared/consent.js", "shared/settings.js", "shared/response-metadata.js", "shared/intake-message.js", "shared/native-messaging.js", "shared/cookie-save.js", "shared/session-material.js", "shared/background-flow.js", "background/firefox.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["shared/constants.js", "shared/settings.js", "content/download-click.js"], "run_at": "document_start"}], "browser_action": {"default_title": "VIUko", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "viuko/settings.html", "open_in_tab": true, "browser_style": false}, "browser_specific_settings": {"gecko": {"id": "viuko@emediaarts.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}