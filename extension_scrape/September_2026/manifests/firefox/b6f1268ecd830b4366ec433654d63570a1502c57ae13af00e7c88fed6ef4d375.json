{"manifest_version": 2, "name": "TabTrack", "version": "1.2.0", "description": "See which websites you spend the most time on \u2014 daily, weekly, monthly, and all-time. Tracks time + page visits per site, lets you tag categories and set soft daily targets, all stored locally.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["tabs", "storage", "idle", "webNavigation", "notifications"], "background": {"scripts": ["shared.js", "background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "TabTrack"}, "browser_specific_settings": {"gecko": {"id": "tabtrack@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}