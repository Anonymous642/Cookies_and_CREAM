{"manifest_version": 3, "name": "Teams Nicknames", "version": "1.2.0", "description": "Geef Microsoft Teams lokale namen voor teams en kanalen.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "teams-nicknames@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Teams Nicknames", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://teams.cloud.microsoft/*", "https://teams.microsoft.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}