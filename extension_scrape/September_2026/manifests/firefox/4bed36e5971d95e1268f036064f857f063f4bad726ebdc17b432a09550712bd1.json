{"manifest_version": 3, "name": "Alpha EHR Bridge", "version": "0.3.6", "description": "Send notes from Alpha into your EHR, pick note fields, and transfer text between phone and desktop.", "permissions": ["activeTab", "alarms", "notifications", "scripting", "storage", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["shared/origins.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Alpha EHR Bridge"}, "content_scripts": [{"matches": ["https://alpha-xai.pages.dev/*", "https://*.alpha-xai.pages.dev/*", "https://app.alpha-aix.com/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["pwa_bridge.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "alpha-ehr-bridge@alpha-aix.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}