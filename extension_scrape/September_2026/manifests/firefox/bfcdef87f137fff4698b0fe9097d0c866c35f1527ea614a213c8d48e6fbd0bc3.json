{"manifest_version": 3, "name": "LumaVista Etsy Listing Filler", "version": "0.1.7", "description": "Fill Etsy listing title, description, price, and tags from a Listing Text.md file.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://www.etsy.com/*", "https://etsy.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open LumaVista Filler", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "lumavista-etsy-listing-filler@lumavista.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.etsy.com/*", "https://etsy.com/*"], "js": ["listing_parser.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["https://www.etsy.com/*", "https://etsy.com/*"]}]}