{"manifest_version": 3, "name": "Rec Local \u2014 Screen Recorder, No Watermark", "version": "0.1.0", "minimum_chrome_version": "121", "description": "Record your screen, window, or tab locally. No watermark, no time limit, no account, no upload.", "permissions": ["downloads", "storage", "tabs", "scripting", "tabCapture"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Rec Local"}, "browser_specific_settings": {"gecko": {"id": "reclocal@reclocal.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-pause": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause or resume the current recording"}, "stop-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop the current recording and save it"}}}