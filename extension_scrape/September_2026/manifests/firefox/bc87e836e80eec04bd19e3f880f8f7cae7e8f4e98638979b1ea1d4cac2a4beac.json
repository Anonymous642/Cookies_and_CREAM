{"manifest_version": 2, "name": "YouTube Playlist Notifier", "version": "1.0.0", "description": "Get notifications when YouTube playlists are updated", "browser_specific_settings": {"gecko": {"id": "jdoneal859@gmail.com", "data_collection_permissions": {"required": ["none"]}}}, "developer": {"name": "Josiah O'Neal"}, "icons": {"32": "icons/icon-32.png", "96": "icons/icon-96.png"}, "permissions": ["notifications", "storage", "alarms", "https://www.youtube.com/*"], "background": {"scripts": ["utils/storage.js", "background.js"], "persistent": false}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon-32.png", "96": "icons/icon-96.png"}}}