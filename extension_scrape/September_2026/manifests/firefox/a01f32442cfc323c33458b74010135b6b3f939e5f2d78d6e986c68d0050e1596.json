{"manifest_version": 2, "name": "Querencia \u2014 Move Checklist", "description": "Builds a change-of-address checklist of the sites that hold your address \u2014 detected on-device, never uploaded.", "version": "0.1.10", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "alarms", "https://*.querencia.cloud/*", "https://*.amazoncognito.com/*", "https://*.appsync-api.*.amazonaws.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@querencia.cloud", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Querencia", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}