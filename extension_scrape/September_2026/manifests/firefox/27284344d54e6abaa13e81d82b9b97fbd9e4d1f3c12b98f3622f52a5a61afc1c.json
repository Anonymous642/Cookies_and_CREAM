{"manifest_version": 3, "name": "Keyboard Range Copy", "description": "Choose the first and last word with keyboard hints, then copy everything between them.", "author": "Daniil Stupnikov", "version": "0.3.2", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "clipboardWrite", "scripting"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Start keyboard range copy", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png"}}, "commands": {"toggle-keyboard-range-copy": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Start or cancel keyboard range copy"}}, "web_accessible_resources": [{"resources": ["keyboard-capture.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "keyboard-range-copy@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}