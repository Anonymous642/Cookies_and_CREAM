{"manifest_version": 3, "name": "Prompthub Connector", "version": "1.2", "description": "Use, classify, and save prompts to your local Prompthub database.", "browser_specific_settings": {"gecko": {"id": "prompthubconnector@frantasticstuff.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "clipboardWrite", "notifications", "storage"], "host_permissions": ["http://127.0.0.1:8080/*", "http://127.0.0.1:5000/*", "http://127.0.0.1:5173/*", "http://127.0.0.1:3000/*", "http://localhost:8080/*", "http://localhost:5000/*", "http://localhost:5173/*", "http://localhost:3000/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Prompthub", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}}