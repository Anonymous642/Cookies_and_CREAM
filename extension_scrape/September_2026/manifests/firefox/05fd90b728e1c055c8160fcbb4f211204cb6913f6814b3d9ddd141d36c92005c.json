{"manifest_version": 2, "name": "inflict-wisdom", "version": "2.0.2", "description": "Adds tooltips to webpages for all the creatures, items, and keywords of Slice & Dice\u2122.", "author": "Parker Kemp", "permissions": ["storage", "tabs"], "icons": {"48": "static/img/wisdom_48x48.png"}, "web_accessible_resources": ["font/*.ttf", "img/hero/*.png", "img/monster/*.png", "img/item/*.png", "img/side/*.png", "img/keyword/*.png", "img/ability/*.png", "img/other/*.png"], "content_scripts": [{"matches": ["*://*/*"], "js": ["js/main.js"], "css": ["css/main.css"]}], "browser_action": {"default_popup": "static/popup/popup.static.html"}, "browser_specific_settings": {"gecko": {"id": "inflict-wisdom@blackberd.com"}}}