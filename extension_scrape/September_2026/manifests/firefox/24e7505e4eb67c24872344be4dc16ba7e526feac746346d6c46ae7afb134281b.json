{"manifest_version": 3, "name": "Yokey Live Notifier", "version": "1.5", "description": "Ne manque plus aucun de mes lives : notifications, acc\u00e8s rapide \u00e0 tous mes r\u00e9seaux et la programmation des streams.", "icons": {"16": "icons/live16.png", "48": "icons/live48.png", "128": "icons/live128.png"}, "action": {"default_icon": {"16": "icons/offline16.png", "48": "icons/offline48.png", "128": "icons/offline128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://yokey.fr/*"], "externally_connectable": {"matches": ["https://yokey.fr/*"]}, "browser_specific_settings": {"gecko": {"id": "yokey-live-notifier@yokey.fr", "strict_min_version": "128.0"}}}