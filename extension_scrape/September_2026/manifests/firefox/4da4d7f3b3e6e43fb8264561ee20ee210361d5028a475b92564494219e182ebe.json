{"manifest_version": 3, "name": "Linkflare", "version": "1.0.35", "description": "Save links to your linkflare.", "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus", "bookmarks"], "host_permissions": ["https://linkflare.io/*", "https://www.linkflare.io/*", "https://app.linkflare.io/*", "https://api.linkflare.io/*"], "background": {"scripts": ["assets/background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@linkflare.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["assets/content.js"]}, {"matches": ["<all_urls>"], "exclude_matches": ["https://linkflare.io/*", "https://www.linkflare.io/*", "https://app.linkflare.io/*", "https://api.linkflare.io/*"], "js": ["assets/highlights.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}