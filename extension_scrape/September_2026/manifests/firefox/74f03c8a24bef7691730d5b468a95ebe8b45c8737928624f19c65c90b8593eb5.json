{"manifest_version": 3, "name": "Besser Pinned Tabs for Firefox", "version": "1.7.1", "description": "Opens an address typed in a pinned tab and leading to a different site in a new tab, so the pinned page stays put", "browser_specific_settings": {"gecko": {"id": "{bf5e830b-bda8-4a63-9b69-9bc67583efcd}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "webNavigation", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "About Besser Pinned Tabs", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "settings.html"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png", "512": "icon512.png"}}