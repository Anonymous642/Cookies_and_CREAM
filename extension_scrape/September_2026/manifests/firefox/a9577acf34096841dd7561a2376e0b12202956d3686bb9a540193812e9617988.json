{"manifest_version": 2, "name": "Redmineitor", "version": "0.0.2", "description": "Make changes in states and users more easily on RedMine. With this add-on you can get a configurable menu to make varios state changes in one click or send the issue to another user with a predefined comment.", "homepage_url": "https://github.com/Eduardolgg/Redmineitor", "icons": {"48": "icons/Redmineitor-48.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "menus", "activeTab", "*://*/*"], "content_scripts": [{"matches": ["*://*/*/issues/*", "*://*/issues/*"], "js": ["jquery.min.js", "jquery-ui/jquery-ui.min.js", "redmineitor_api.js", "redmineitor.js"], "css": ["jquery-ui/jquery-ui.min.css", "redmineitor.css"]}], "options_ui": {"page": "options/options.html", "browser_style": true}, "web_accessible_resources": ["icons/Redmineitor-48.png", "jquery-ui/images/*.png", "datatable/datatable.css"], "browser_action": {"default_title": "Redmineitor"}, "browser_specific_settings": {"gecko": {"id": "redmineitor.webmaster@dudekdu.es", "strict_min_version": "126.0"}}}