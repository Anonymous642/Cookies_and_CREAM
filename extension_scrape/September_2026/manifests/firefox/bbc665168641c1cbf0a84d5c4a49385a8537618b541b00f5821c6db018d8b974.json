{"manifest_version": 2, "name": "Crunchyroll No Spoilers", "version": "1.0", "description": "Hides next episode title and thumbnail on Crunchyroll to avoid spoilers.", "homepage_url": "https://github.com/juiceyo/crunchyroll-nospoiler", "browser_specific_settings": {"gecko": {"id": "nospoilers@jcpr.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "content_scripts": [{"matches": ["*://*.crunchyroll.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}