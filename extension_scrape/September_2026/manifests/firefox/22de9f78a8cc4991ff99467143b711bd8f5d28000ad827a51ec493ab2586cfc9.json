{"manifest_version": 3, "name": "Moxfield Combo Finder", "version": "1.3.0", "description": "Adds a Commander Spellbook panel to Moxfield deck pages showing the combos you already have and the ones you're one card away from.", "browser_specific_settings": {"gecko": {"id": "moxfield-combo-finder@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["https://*.moxfield.com/*", "https://backend.commanderspellbook.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.moxfield.com/decks/*"], "js": ["content.js"], "run_at": "document_idle", "css": ["panel.css"]}], "action": {"default_title": "Refresh combos"}}