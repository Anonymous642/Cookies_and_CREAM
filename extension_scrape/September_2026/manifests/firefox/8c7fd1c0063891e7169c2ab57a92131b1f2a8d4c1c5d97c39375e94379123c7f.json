{"manifest_version": 3, "name": "UniVertex - DTU Course Extension", "version": "1.0.0", "description": "See grade stats, pass rates, exam dates, schedules, and evaluations from UniVertex directly on kurser.dtu.dk.", "browser_specific_settings": {"gecko": {"id": "kurser@univertex.dk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "host_permissions": ["https://kurser.dtu.dk/*", "https://univertex.dk/*", "http://localhost:3000/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["favicon.svg"], "matches": ["https://kurser.dtu.dk/*"]}], "content_scripts": [{"matches": ["https://kurser.dtu.dk/course/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}