{"manifest_version": 2, "name": "Shtab: Clipper, Recorder & Time Tracker", "description": "Web clipper, screen recorder & time tracker for Shtab.app. Save articles, capture screens and track work time.", "version": "1.3.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'", "permissions": ["activeTab", "storage", "contextMenus", "tabs", "scripting", "notifications", "downloads", "unlimitedStorage", "https://*.shtab.io/*", "https://*.shtab.app/*", "<all_urls>"], "optional_permissions": [], "web_accessible_resources": ["shtab_logo_vert.svg", "icon.svg", "icon.png", "logo.png", "content-scripts/clipper-widget.css", "content-scripts/recording-toolbar.css"], "commands": {"clip-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0432 Shtab"}, "quick-clip": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "\u0411\u044b\u0441\u0442\u0440\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u044c\u044e \u0431\u0435\u0437 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0432\u0438\u0434\u0436\u0435\u0442\u0430"}, "highlight-mode": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "\u0420\u0435\u0436\u0438\u043c \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0438 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435"}}, "browser_specific_settings": {"gecko": {"id": "shtab-clipper@shtab.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title