{"manifest_version": 3, "name": "FocusMode", "version": "1.0.0", "description": "Distraction-free focus timer. Pomodoro technique with site blocking.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "FocusMode", "default_popup": "ui/focus.html"}, "permissions": ["storage", "notifications", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/worker.js"]}, "browser_specific_settings": {"gecko": {"id": "focusmode@productivity.timer", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}