{"manifest_version": 2, "name": "JobFindr Platform Auth", "default_locale": "en", "privacy_policy_url": "https://jobfindr.me/privacy", "version": "0.1.10", "description": "Connect supported job platforms to JobFindr by securely sharing session cookies.", "permissions": ["cookies", "https://*.linkedin.com/*", "https://*.glassdoor.com/*", "https://glassdoor.com/*", "https://*.naukrigulf.com/*", "https://naukrigulf.com/*", "https://*.bayt.com/*", "https://bayt.com/*", "https://jobfindr.me/*", "https://*.jobfindr.me/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "JobFindr Platform Auth", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://jobfindr.me/*", "https://*.jobfindr.me/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "jobfindr-platform-auth@example.com", "data_collection_permissions": {"required": ["none"]}}}}