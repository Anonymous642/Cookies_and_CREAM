{"manifest_version": 2, "name": "Bang Search", "version": "0.0.2", "description": "Allows you to choose search engine via !bangs (or via clicking)", "author": "TheNamlessGuy", "homepage_url": "https://codeberg.org/TheNamlessGuy/browser-bang-search", "developer": {"name": "TheNamlessGuy", "url": "https://codeberg.org/TheNamlessGuy/browser-bang-search"}, "icons": {"16": "res/icons/16.dark.png", "32": "res/icons/32.dark.png", "48": "res/icons/48.dark.png"}, "permissions": ["webRequest", "webRequestBlocking", "storage", "bookmarks", "https://bangs.invalid/*"], "background": {"type": "module", "scripts": ["src/background.mjs"]}, "options_ui": {"page": "src/options/page/stub/index.html"}, "chrome_settings_overrides": {"search_provider": {"name": "Bang search", "search_url": "https://bangs.invalid/search?q={searchTerms}", "is_default": true}}, "web_accessible_resources": ["src/manual-selection-page/index.html"], "browser_specific_settings": {"gecko": {"id": "bang-search@namless.net", "data_collection_permissions": {"required": ["none"]}}, "namless": {"common_includes": ["browser/plugins/background/base-options.mjs", "browser/plugins/background/base-communication.mjs", "browser/plugins/foreground/base-communication.mjs", "browser/general/onDOMContentLoaded.mjs"]}}}