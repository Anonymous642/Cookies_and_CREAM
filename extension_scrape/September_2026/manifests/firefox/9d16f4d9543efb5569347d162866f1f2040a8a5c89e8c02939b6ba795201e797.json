{"manifest_version": 3, "name": "Farsi RTL Fix for AI Chats", "version": "1.0.0", "description": "Automatically right-aligns Persian (Farsi) text in Claude, ChatGPT, Grok, WhatsApp Web, Messenger, and DeepSeek chats, without breaking the site's icons.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "farsi-rtl-fix@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://grok.com/*", "https://web.whatsapp.com/*", "https://www.messenger.com/*", "https://chat.deepseek.com/*"], "css": ["content.css"], "run_at": "document_start"}]}