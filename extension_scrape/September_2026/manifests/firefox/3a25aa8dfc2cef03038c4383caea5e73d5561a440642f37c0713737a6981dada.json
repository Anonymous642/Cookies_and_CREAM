{"manifest_version": 2, "name": "Posture Webcam Monitor", "version": "1.3", "description": "Monitor your sitting posture using the webcam and gentle reminders when slouching is detected.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "notifications", "alarms"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Posture Webcam Monitor", "default_icon": "icons/logo_64.png", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "browser_specific_settings": {"gecko": {"id": "@Posture-Webcam-Monitor", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}