{"manifest_version": 2, "name": "Reddit Ration", "version": "1.7", "description": "Browse Reddit in batches, take a pause between every few posts to stay mindful of your time", "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "reddit-ration@redue.net", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "*://www.reddit.com/*", "*://sh.reddit.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.reddit.com/*", "*://sh.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}