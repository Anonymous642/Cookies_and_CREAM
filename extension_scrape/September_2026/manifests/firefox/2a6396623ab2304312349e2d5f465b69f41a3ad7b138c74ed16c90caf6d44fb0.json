{"manifest_version": 3, "name": "CESU Sync", "version": "1.8.6", "description": "Synchronise automatiquement les donn\u00e9es CESU avec votre syst\u00e8me de gestion", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.cesu.urssaf.fr/*", "https://cesu-manager.fr/*"], "content_scripts": [{"matches": ["https://www.cesu.urssaf.fr/decla/*"], "js": ["polyfill.js", "content-urssaf.js"], "run_at": "document_idle"}, {"matches": ["https://cesu-manager.fr/*", "https://www.cesu.urssaf.fr/*"], "js": ["polyfill.js", "content-bubble.js"], "run_at": "document_idle"}], "background": {"scripts": ["polyfill.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "cesu-sync@cesu-manager.fr", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon.png"], "matches": ["https://cesu-manager.fr/*", "https://www.cesu.urssaf.fr/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://cesu-manager.fr https://www.cesu.urssaf.fr http: https:;"}}