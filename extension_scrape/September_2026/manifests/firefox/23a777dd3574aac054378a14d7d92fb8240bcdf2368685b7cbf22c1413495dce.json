{"manifest_version": 3, "name": "Bubble Board Saver", "version": "0.1.1", "description": "Add the current page or an image to your Bubble Board.", "action": {"default_title": "Add to Bubble Board", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["lib/browser-polyfill.js", "background.js"], "service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://bubbles.flukefam.cc/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "bubble-board-saver@flukefam.cc", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}