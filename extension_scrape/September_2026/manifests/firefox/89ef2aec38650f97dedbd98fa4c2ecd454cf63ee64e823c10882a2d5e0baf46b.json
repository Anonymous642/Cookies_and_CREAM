{"manifest_version": 3, "name": "CleanSnap - Webpage to Clean PDF & Markdown", "description": "One-click clean export of any webpage to beautifully formatted PDF or Markdown. No ads, no clutter, no junk.", "version": "1.0.1", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://extensionpay.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background/service-worker.js", "scripts": ["background/ExtPay.js", "background/service-worker.js"]}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["preview/preview.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "cleansnap@cleansnap.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}