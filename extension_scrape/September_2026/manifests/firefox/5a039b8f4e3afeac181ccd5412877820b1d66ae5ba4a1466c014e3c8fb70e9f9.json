{"manifest_version": 3, "name": "Study Signal", "description": "Get alerts, highlight better-paying studies, convert rewards, and track activity across supported study sites.", "version": "1.8.9", "short_name": "Study Signal", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "host_permissions": ["https://app.prolific.com/*", "https://connect.cloudresearch.com/*", "https://internal-api.prolific.com/api/v1*", "https://connect.cloudresearch.com/participant-api*", "https://api.telegram.org/*"], "permissions": ["storage", "notifications", "tabs", "webRequest", "idle", "offscreen"], "browser_specific_settings": {"gecko": {"id": "@chantu-survey-enhancer", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Study Signal", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://app.prolific.com/*", "*://connect.cloudresearch.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}