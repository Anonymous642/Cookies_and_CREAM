{"manifest_version": 2, "name": "Bulk Tab URL Opener", "version": "1.2.1", "description": "Paste a list of URLs and open them all as tabs, N at a time. Close one of the opened tabs and the next one in the queue opens automatically.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "search"], "background": {"scripts": ["common.js", "background.js"], "persistent": true}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Bulk Tab URL Opener", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "bulk-tab-url-opener@iqbal-extensions.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}