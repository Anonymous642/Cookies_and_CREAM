{"manifest_version": 3, "name": "Live Tab Deduplication", "version": "1.0", "description": "Redirects duplicate tabs to the already-open version the moment they load. Audit mode scans all open tabs and lets you close duplicates in one click.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Live Tab Deduplication", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "livetabdedup@extensions", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}