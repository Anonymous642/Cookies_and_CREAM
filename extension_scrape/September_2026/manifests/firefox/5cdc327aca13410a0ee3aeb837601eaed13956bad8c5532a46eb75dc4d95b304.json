{"manifest_version": 2, "name": "HackTogether", "description": "Leave your one annotation per day on HN-featured articles.", "version": "0.0.1", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "scripting", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "hacktogether@hacktogether.news", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity", "websiteContent", "websiteActivity"], "optional": []}}}, "web_accessible_resources": ["fonts/*", "content-scripts/*.css", "content-scripts/content.css"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "SurfTogether", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}