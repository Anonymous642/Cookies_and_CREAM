{"manifest_version": 2, "name": "Vimput", "description": "Edit any text input with a Vim-powered editor. Right-click on any input field to open the Vimput editor.", "version": "1.3.4", "icons": {"16": "icons/png/icon-16.png", "32": "icons/png/icon-32.png", "48": "icons/png/icon-48.png", "128": "icons/png/icon-128.png"}, "permissions": ["contextMenus", "storage", "activeTab"], "web_accessible_resources": ["pageScript.js", "vimput-formatter.py"], "browser_specific_settings": {"gecko": {"id": "vimput@extension", "data_collection_permissions": {"data_collection_enabled": false, "required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Vimput", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}