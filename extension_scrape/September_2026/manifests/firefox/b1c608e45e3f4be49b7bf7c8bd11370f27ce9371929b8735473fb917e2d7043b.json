{"manifest_version": 3, "name": "linkward", "version": "0.8.1", "description": "Asks which container to open a link in \u2014 before it opens. Or just copies the URL and opens nothing.", "permissions": ["storage", "contextualIdentities", "cookies"], "optional_permissions": ["webRequest", "webRequestBlocking"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "linkward settings"}, "web_accessible_resources": [{"resources": ["pick/pick.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "linkward@sapn95.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}