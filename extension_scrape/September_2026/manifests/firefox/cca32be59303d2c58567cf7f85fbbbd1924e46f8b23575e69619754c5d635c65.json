{"manifest_version": 2, "name": "Youtube to Post", "version": "1.9.1", "description": "Captura v\u00eddeos do YouTube e cria posts no WordPress e LinkedIn com enriquecimento de IA e criptografia de dados", "permissions": ["activeTab", "storage", "identity", "notifications", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.linkedin.com/*", "https://api.linkedin.com/*", "https://api.github.com/*", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/content.js"]}], "background": {"scripts": ["crypto.js", "migration.js", "linkedin-api.js", "background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "youtube-to-wordpress@extension.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}