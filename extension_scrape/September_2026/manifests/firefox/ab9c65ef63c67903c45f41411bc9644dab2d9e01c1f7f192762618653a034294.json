{"manifest_version": 3, "name": "Colab Auto Runner", "version": "1.0", "description": "Otomatisasi membuka dan menjalankan Colab dari Bookmark", "browser_specific_settings": {"gecko": {"id": "colab-auto-runner@rendra.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["bookmarks", "tabs", "scripting"], "host_permissions": ["https://colab.research.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon48.png", "48": "icons/icon48.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}