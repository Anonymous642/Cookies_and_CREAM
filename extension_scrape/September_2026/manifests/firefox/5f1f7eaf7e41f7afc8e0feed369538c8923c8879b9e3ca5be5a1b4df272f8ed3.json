{"manifest_version": 3, "name": "Layerdolls", "version": "1.0.11", "description": "Save and organize your bookmarks with Layerdolls - your personal bookmark manager", "browser_specific_settings": {"gecko": {"id": "extension@layerdolls.com", "strict_min_version": "109.0", "data_collection_permissions": {"pings_allowed": false, "required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://app.layerdolls.com/*", "https://layerdolls.api.elevapps.co/*", "http://localhost:5173/*", "http://localhost:8080/*", "<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["https://app.layerdolls.com/*", "http://localhost:5173/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["popup/popup.html", "popup/popup.css", "popup/popup.js", "lib/api.js"], "matches": ["https://app.layerdolls.com/*", "http://localhost:5173/*"]}]}