{"manifest_version": 3, "name": "Ad Dodge Game Shield", "description": "Optimize your browser gaming by automatically blocking intrusive overlays and popup ads.", "version": "1.0.0", "author": "Streamline Devs", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "addodgegameshield@streamlinedevs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}