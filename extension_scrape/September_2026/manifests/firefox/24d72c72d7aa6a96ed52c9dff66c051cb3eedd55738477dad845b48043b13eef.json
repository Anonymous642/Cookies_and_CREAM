{"manifest_version": 2, "name": "Halal YouTube Music Filter", "version": "1.0.0", "description": "Filters YouTube Music to show only Quran recitations, preventing accidental exposure to music.", "browser_specific_settings": {"gecko": {"id": "halal-youtube-music-filter@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.jpeg", "96": "icons/icon-96.jpeg"}, "permissions": ["https://music.youtube.com/*"], "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["keywords.js", "content.js"], "run_at": "document_end"}], "browser_action": {"default_icon": {"48": "icons/icon-48.jpeg"}, "default_title": "Halal YouTube Music Filter - Active"}}