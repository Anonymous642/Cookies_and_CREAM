{"manifest_version": 3, "name": "Memfold Web Clipper", "version": "1.0.0", "description": "Save web pages to your Memfold workspace", "permissions": ["activeTab", "storage", "contextMenus", "scripting", "identity"], "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["vendor/purify.min.js", "vendor/Readability.js", "content.js"]}], "background": {"scripts": ["background.js"], "persistent": false}, "host_permissions": ["<all_urls>"], "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "web_accessible_resources": [{"resources": ["oauth-redirect.html", "popup.html", "config.js", "assets/*.js", "navigation-bar.js", "navigation-bar-css.css", "vendor/*.js"], "matches": ["<all_urls>"]}], "commands": {"save_page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page"}}, "browser_specific_settings": {"gecko": {"id": "memfold-extension@memfold.com", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}