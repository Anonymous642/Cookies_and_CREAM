{"manifest_version": 3, "name": "ClearPea", "version": "1.1", "description": "Removes the right empty ad space and adblock warnings in Photopea.", "icons": {"48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "clearpea@extension", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.photopea.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}]}