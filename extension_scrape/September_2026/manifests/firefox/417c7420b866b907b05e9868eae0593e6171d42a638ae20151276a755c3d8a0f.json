{"manifest_version": 2, "name": "ReFind - AI Bookmark Manager", "description": "Import browser bookmarks, save web pages in one click, and quickly search your saved knowledge.", "version": "1.0.27", "short_name": "ReFind", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "tabs", "bookmarks", "contextMenus", "notifications", "alarms", "identity", "https://api.refind.cc/*"], "commands": {"save-to-kexun": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save current page to ReFind"}, "open-kexun": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "MacCtrl+Shift+K"}, "description": "Open ReFind side panel"}}, "browser_specific_settings": {"gecko": {"id": "refind@refind.cc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent", "websiteActivity", "bookmarksInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "ReFind"}, "browser_action": {"default_title": "ReFind", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}}