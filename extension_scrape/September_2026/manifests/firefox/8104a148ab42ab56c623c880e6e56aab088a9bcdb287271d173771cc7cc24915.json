{"manifest_version": 3, "name": "Wordle hints", "description": "Suggests words for the Wordle game.", "author": "Binar256", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "@wordle_hints.Binar256", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "src/icons/icon16px.png", "48": "src/icons/icon48px.png", "128": "src/icons/icon128px.png"}, "action": {"default_popup": "src/popup/popup.html"}, "content_scripts": [{"matches": ["*://www.nytimes.com/games/wordle/index.html*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"]}], "web_accessible_resources": [{"matches": ["*://www.nytimes.com/*"], "resources": ["src/content/lightbulb-solid-full.svg", "src/solver/wordle_solver.js", "src/solver/allowed_guesses.txt"]}]}