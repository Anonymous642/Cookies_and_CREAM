{"manifest_version": 3, "name": "GoodTube - Youtube Adblocker & Enhancer", "short_name": "goodtube", "version": "2.1.3", "author": "GoodTube", "description": "Undetectable Youtube adblock / adblocker! With options to Remove Youtube Shorts, Auto Set Youtube Video Quality, Restore the old UI, Remove AI and more!", "background": {"scripts": ["background.js"]}, "host_permissions": ["https://extensionpay.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://extensionpay.com;"}, "browser_specific_settings": {"gecko": {"id": "@goodtube-adblock", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["personallyIdentifyingInfo", "personalCommunications"]}}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/extpay.js", "redirect.js"], "css": ["css/extpay.css"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*"], "js": ["lib/extpay.js", "content.js"], "css": ["css/style.css"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.youtube.com/*"], "js": ["mute.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://*.wikimedia.org/*"], "include_globs": ["*?*goodTubeProxy=1*"], "js": ["lib/extpay.js", "content.js"], "css": ["css/style.css"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["goodtube/main.min.js", "goodtube/proxy.min.js", "goodtube/player.min.js", "goodtube/old.min.js", "player/index.html", "player/css/style.css"], "matches": ["*://*.youtube.com/*", "*://*.wikimedia.org/*"]}], "action": {"default_popup": "popup/index.html"}, "permissions": ["storage"], "icons": {"16": "img/icon-16.png", "32": "img/icon-32.png", "48": "img/icon-48.png", "128": "img/icon-128.png"}}