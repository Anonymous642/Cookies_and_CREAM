{"manifest_version": 3, "name": "Paginated Reader", "version": "0.7.5", "description": "A distraction-free reading mode with page-turn navigation instead of scrolling. Built for e-ink displays.", "browser_specific_settings": {"gecko": {"id": "paginated-reader@local.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["<all_urls>", "http://*/*", "https://*/*"], "action": {"default_title": "Toggle Paginated Reader (Alt+Shift+R)", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["src/settings-schema.js", "background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/Readability.js", "lib/Readability-readerable.js", "lib/purify.min.js", "src/settings-schema.js", "src/content-sanitizer.js", "src/paginator.js", "src/reader.js", "src/auto-detect.js", "src/bootstrap.js"], "run_at": "document_idle"}], "commands": {"toggle-reader": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle paginated reader view"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "web_accessible_resources": [{"resources": ["src/reader.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}