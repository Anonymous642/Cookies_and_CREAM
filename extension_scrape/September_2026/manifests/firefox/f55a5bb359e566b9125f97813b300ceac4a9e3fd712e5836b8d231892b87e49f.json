{"manifest_version": 3, "name": "Lightning Tracker: Live Map & Alerts", "short_name": "Lightning Tracker", "version": "1.0.0", "description": "Real-time lightning tracker & severe storm alerts. Live satellite radar, proximity distance, and 30-30 safety warnings.", "homepage_url": "https://lightningmaps.live/", "browser_specific_settings": {"gecko": {"id": "lightning-tracker@lightningmaps.live", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_title": "Lightning Tracker \u2014 Live Radar", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "alarms", "notifications", "geolocation"], "host_permissions": ["https://lightningmaps.live/*"]}