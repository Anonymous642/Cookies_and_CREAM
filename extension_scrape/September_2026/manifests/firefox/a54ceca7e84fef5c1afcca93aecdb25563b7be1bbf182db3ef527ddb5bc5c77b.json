{"manifest_version": 3, "name": "Mindful Watch Later for YouTube", "version": "1.1.3", "description": "Blocks impulsive YouTube watching: only videos you deliberately queue will play. Everything else redirects to your subscriptions feed.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab"], "host_permissions": ["*://www.youtube.com/*", "*://youtu.be/*"], "background": {"scripts": ["storage.js", "background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtu.be/*"], "js": ["storage.js", "content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Watch Later Manager"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "mindful-watch-later@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}