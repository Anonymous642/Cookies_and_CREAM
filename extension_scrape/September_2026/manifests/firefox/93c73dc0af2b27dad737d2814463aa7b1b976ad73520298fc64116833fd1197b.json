{"manifest_version": 3, "name": "Karpture", "version": "2.2.2", "description": "Save copied text to use anytime.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus", "clipboardRead", "clipboardWrite", "downloads"], "host_permissions": ["https://*.sentry.io/*", "https://*.ingest.sentry.io/*", "https://*.ingest.de.sentry.io/*", "https://*.google-analytics.com/*", "https://www.google-analytics.com/*"], "browser_specific_settings": {"gecko": {"id": "support@trykarpture.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}