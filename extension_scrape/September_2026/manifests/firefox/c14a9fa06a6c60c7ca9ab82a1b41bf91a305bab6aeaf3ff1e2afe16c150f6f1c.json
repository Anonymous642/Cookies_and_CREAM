{"manifest_version": 3, "name": "YTCut \u2014 premium clip cutter", "version": "0.5.1", "description": "Mark IN/OUT on any YouTube video, send it to ytcut.org for instant clipping.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": "icons/48.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}, {"matches": ["https://ytcut.org/*", "https://www.ytcut.org/*"], "js": ["content/auth-bridge.js"], "run_at": "document_start"}], "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "web_accessible_resources": [{"resources": ["icons/48.png", "icons/128.png"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "ytcut@ytcut.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}