{"manifest_version": 2, "name": "fandom_redirect", "version": "0.1.0", "description": "Redirects Fandom wiki pages to the matching Antifandom wiki page while preserving the page path and query string.", "homepage_url": "https://github.com/erSpell", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["webRequest", "webRequestBlocking", "*://*.fandom.com/*"], "background": {"scripts": ["redirect.js"]}, "browser_specific_settings": {"gecko": {"id": "fandom_redirect@erspell.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}