{"manifest_version": 2, "name": "Right Click Download", "version": "3.0", "description": "Accessible right-click tool to download images with timestamped filenames.", "permissions": ["<all_urls>", "downloads", "notifications", "tabs", "menus"], "browser_specific_settings": {"gecko": {"id": "right-click-download@accessibility.tool", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"128": "icons/icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon-128.png"}, "default_title": "Right Click Download"}}