{"manifest_version": 2, "name": "JobAssay \u2014 Job Tracker & AI Fit Score", "description": "Save any job posting in one click, track every application on a kanban board, and check how well your resume fits before you apply.", "version": "0.9.1", "short_name": "JobAssay", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting", "https://jobassay.com/*"], "browser_specific_settings": {"gecko": {"id": "jobassay@jobassay.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "JobAssay", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.glassdoor.com/Job/*", "*://*.glassdoor.com/job*", "*://*.indeed.com/*", "*://*.linkedin.com/jobs/*", "*://*.myworkdayjobs.com/*", "*://*.smartrecruiters.com/*", "*://apply.workable.com/*", "*://boards.greenhouse.io/*", "*://job-boards.greenhouse.io/*", "*://jobs.ashbyhq.com/*", "*://jobs.lever.co/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}