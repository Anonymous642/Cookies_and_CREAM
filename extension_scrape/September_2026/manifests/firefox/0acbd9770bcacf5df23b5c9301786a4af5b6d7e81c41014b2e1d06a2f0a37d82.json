{"manifest_version": 2, "name": "YouTube Auto Pause", "version": "1.0", "description": "Pauses YouTube video when you switch to another tab and plays it again when you come back.", "permissions": ["tabs", "activeTab", "http://*/", "https://*/"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "youtube-autopause@example.com"}}}