{"name": "Scholar Bib Checker", "description": "Shows if Google Scholar entries match your BibLaTeX file.", "version": "1.0", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "scholarbibchecker@ap.com"}}, "permissions": ["storage", "scripting", "activeTab"], "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://scholar.google.com/*", "https://scholar.google.de/*"], "js": ["content.js"]}], "host_permissions": ["https://scholar.google.com/*", "https://scholar.google.de/*"]}