{"manifest_version": 2, "name": "AdSlayer", "version": "1.6.0", "description": "Ad blocker with uBlock-style filter lists for every site, plus Twitch stream ads through your own proxy and YouTube ad skipping.", "browser_specific_settings": {"gecko": {"id": "adslayer@local.extension", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "proxy", "webNavigation", "alarms", "unlimitedStorage", "activeTab", "<all_urls>"], "background": {"scripts": ["common/proxyspec.js", "common/abp.js", "common/lists.js", "background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "AdSlayer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content/twitch-inject.js", "content/twitch-clean.js"], "run_at": "document_start", "all_frames": true, "css": ["content/twitch.css"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content/youtube-inject.js", "content/youtube.js", "content/sponsorblock.js"], "css": ["content/youtube.css"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["content/twitch-main.js", "content/youtube-main.js"]}