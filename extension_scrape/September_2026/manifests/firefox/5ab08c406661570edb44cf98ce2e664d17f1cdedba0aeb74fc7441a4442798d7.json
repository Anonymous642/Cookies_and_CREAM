{"manifest_version": 2, "name": "Substack Link Previewer", "version": "1.0", "description": "Rewrites Substack redirect links as the original link", "permissions": ["https://mail.google.com/*", "https://substack.com/*"], "browser_specific_settings": {"gecko": {"id": "UnhideSubstackLinks@kai-williams.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}}