{"manifest_version": 2, "name": "Concept Revisit Reminder", "version": "1.3", "description": "Reminds users to revisit previously learned concepts using lightweight learning analytics and spaced review intervals.", "permissions": ["storage", "tabs", "notifications", "activeTab", "alarms"], "background": {"scripts": ["reminderEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Concept Revisit Reminder", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Concept-Revisit-Reminder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}