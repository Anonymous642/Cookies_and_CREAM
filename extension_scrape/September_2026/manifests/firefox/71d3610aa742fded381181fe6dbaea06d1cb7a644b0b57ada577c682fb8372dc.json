{"manifest_version": 2, "name": "Codeforces Challenge Extension", "version": "1.0.0", "description": "Challenge a friend to solve Codeforces problems!", "permissions": ["storage", "activeTab", "https://codeforces.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://codeforces.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "codeforces-1v1@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}