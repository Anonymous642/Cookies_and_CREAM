{"manifest_version": 3, "name": "ABN Lookup", "version": "1.0.0", "description": "Look up Australian Business Numbers and business names via ABN Lookup", "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "contextMenus"], "host_permissions": ["https://abr.business.gov.au/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "abn-lookup@gl1.live.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://*.coupahost.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "ABN Lookup", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}