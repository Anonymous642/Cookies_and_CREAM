{"manifest_version": 3, "name": "NAGA Report Translator (Unofficial)", "version": "1.0.0", "description": "Unofficial. Translates the NAGA mahjong AI report site (naga.dmv.nico) from Japanese to English with a curated, offline glossary \u2014 no data collected. Not affiliated with DWANGO / NAGA.", "browser_specific_settings": {"gecko": {"id": "naga-report-translator@myessail.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://naga.dmv.nico/*"], "js": ["canvas-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["*://naga.dmv.nico/*"], "js": ["glossary.js", "translate.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "NAGA Translator", "default_icon": "icon.svg"}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["storage", "tabs"]}