{"manifest_version": 3, "name": "streamverlay", "version": "0.1.3", "description": "Camada de v\u00eddeo sincronizada sobre o player da Kick. N\u00e3o altera o player nem o stream da Kick.", "minimum_chrome_version": "116", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://kick.com/*", "https://*.kick.com/*", "https://streamverlay.com/*", "https://api.streamverlay.com/*", "https://hls.streamverlay.com/*", "https://seg.streamverlay.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://kick.com/*", "https://*.kick.com/*"], "js": ["content-script.js"], "css": ["overlay.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://streamverlay.com/*"], "js": ["viewer-bridge.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "streamverlay", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}}, "web_accessible_resources": [{"resources": ["overlay.css"], "matches": ["https://kick.com/*", "https://*.kick.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.streamverlay.com https://hls.streamverlay.com https://seg.streamverlay.com"}, "browser_specific_settings": {"gecko": {"id": "streamverlay@streamverlay.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "120.0"}}}