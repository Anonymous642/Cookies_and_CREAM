{"manifest_version": 3, "name": "Boce HTTP Speed Test", "version": "1.0", "description": "Opens boce.com and automatically submits a URL.", "browser_specific_settings": {"gecko": {"id": "boce-auto-submitter@myextensions.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.boce.com/*"], "icons": {"16": "icons/boce_icon_16x16.png", "32": "icons/boce_icon_32x32.png", "48": "icons/boce_icon_48x48.png", "128": "icons/boce_icon_128x128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/boce_icon_16x16.png", "32": "icons/boce_icon_32x32.png"}}, "content_scripts": [{"matches": ["https://*.boce.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}