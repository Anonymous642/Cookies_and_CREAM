{"manifest_version": 3, "name": "Digital Impulse Map", "version": "1.3", "description": "Visualizes browsing impulses and spontaneous navigation patterns to encourage mindful web usage.", "permissions": ["tabs", "storage", "notifications", "activeTab", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Digital Impulse Map"}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Digital-Impulse-Map", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}