{"name": "YouTube Playlist Helper", "description": "YouTube playlist editor and generator", "version": "2.12.2", "manifest_version": 3, "icons": {"48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "YouTube Playlist Helper", "default_popup": "popup/popup.html"}, "background": {"service_worker": "sw.js", "scripts": ["sw.js"]}, "permissions": ["bookmarks", "tabs", "storage", "notifications", "activeTab", "contextMenus", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "yph-mv3@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}