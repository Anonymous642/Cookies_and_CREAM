{"manifest_version": 3, "name": "FTMxADS-BLOCKER", "version": "1.4.0", "description": "Blocks ads, popups & same-tab redirects. YouTube auto-skip. Spotify mute. By @ftmdevz & @ftmdeveloperz.", "author": "@ftmdevz & @ftmdeveloperz", "browser_specific_settings": {"gecko": {"id": "ftmxads-blocker@ftmdevz", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FTMxADS-BLOCKER"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["anti-redirect.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_start"}, {"matches": ["*://open.spotify.com/*", "*://spotify.com/*"], "js": ["spotify.js"], "run_at": "document_idle"}], "declarative_net_request": {"rule_resources": [{"id": "ftm_rules", "enabled": true, "path": "rules/rules.json"}]}, "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "tabs", "activeTab", "webNavigation", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}