{"manifest_version": 3, "name": "PureFeed: Opinionated YouTube Filter", "version": "1.0.0", "description": "An opinionated filter that hides YouTube Shorts, videos under 1 minute, and AI-generated slop. No settings, runs invisibly in the background.", "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "pure-feed@yanic.downloads", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}