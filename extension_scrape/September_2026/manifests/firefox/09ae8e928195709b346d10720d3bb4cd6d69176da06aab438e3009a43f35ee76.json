{"manifest_version": 3, "name": "Gazenest", "version": "1.0.96", "description": "The conscious layer for YouTube: track, score and reclaim your attention.", "browser_specific_settings": {"gecko": {"id": "gazenest@gazenest.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["browsingActivity", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "activeTab", "scripting", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.gazenest.com/*", "https://glitchtip.ibasaw.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["background/sentry.js", "background/service-worker.js"]}, "content_scripts": [{"matches": ["https://www.gazenest.com/*"], "js": ["content/dashboard-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/binge-overlay.js", "content/budget-overlay.js", "content/zen-widget.js", "content/content.js", "content/history-sync.js", "content/panel.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/history-reader-main.js"], "run_at": "document_idle", "world": "MAIN"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content/playlists-reader-main.js"], "run_at": "document_idle", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["content/history-reader-main.js", "content/playlists-reader-main.js"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}