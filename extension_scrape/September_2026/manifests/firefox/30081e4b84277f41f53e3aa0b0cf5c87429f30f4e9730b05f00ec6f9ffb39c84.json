{"manifest_version": 3, "name": "3D Friend", "version": "1.0.0", "description": "A 3D character appears on your browser page and either runs away from or chases your mouse cursor", "browser_specific_settings": {"gecko": {"id": "3dfriend@3dfriend.fun", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "permissions": ["activeTab", "storage", "unlimitedStorage"], "host_permissions": ["https://3dfriend.fun/*", "https://www.3dfriend.fun/*"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["three.min.js", "GLTFLoader.js", "content.js"], "all_frames": false, "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["content/models/*.glb", "content/textures/*", "content/environmentMap.jpg", "*.png", "*.jpg"], "matches": ["<all_urls>"]}]}