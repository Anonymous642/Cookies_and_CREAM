{"manifest_version": 3, "name": "BugSmash: Fast Feedback, Zero Friction", "version": "3.2.0", "description": "Turn any webpage, design or dashboard into an interactive feedback space with BugSmash. Add comments and share it with anyone.", "icons": {"16": "favicon16.png", "32": "favicon32.png", "48": "favicon32.png"}, "action": {"default_icon": "favicon32.png"}, "permissions": ["activeTab", "tabs", "cookies", "storage", "scripting"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["loader.js"], "run_at": "document_start"}, {"matches": ["http://localhost:3000/*", "https://tools.bugsmash.io/*", "https://uat-tools.bugsmash.io/*"], "js": ["bugsmash-script.js"]}], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["index.html", "*.js", "*.css", "assets/*", "vite.svg", "processing-pill.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Open the extension popup"}}, "browser_specific_settings": {"gecko": {"id": "extension@bugsmash.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}