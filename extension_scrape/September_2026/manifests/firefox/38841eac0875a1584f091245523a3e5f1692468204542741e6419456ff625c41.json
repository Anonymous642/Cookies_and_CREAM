{"manifest_version": 3, "name": "Clipboard History", "version": "1.0", "description": "Save and manage your clipboard history", "browser_specific_settings": {"gecko": {"id": "clipboard-history@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Clipboard History", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"open-clip-selector": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Open clipboard selector"}, "paste-clip-1": {"suggested_key": {"default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1"}, "description": "Paste clipboard item 1"}, "paste-clip-2": {"suggested_key": {"default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2"}, "description": "Paste clipboard item 2"}, "paste-clip-3": {"suggested_key": {"default": "Ctrl+Shift+3", "mac": "MacCtrl+Shift+3"}, "description": "Paste clipboard item 3"}, "paste-clip-4": {"description": "Paste clipboard item 4"}, "paste-clip-5": {"description": "Paste clipboard item 5"}, "paste-clip-6": {"description": "Paste clipboard item 6"}, "paste-clip-7": {"description": "Paste clipboard item 7"}, "paste-clip-8": {"description": "Paste clipboard item 8"}, "paste-clip-9": {"description": "Paste clipboard item 9"}}}