{"manifest_version": 2, "name": "SomethingPhishy", "version": "1.6", "description": "A browser extension based anti-phishing system. Check out at https://somethingphishy.ddns.net/", "homepage_url": "https://somethingphishy.ddns.net/", "permissions": ["storage", "tabs"], "background": {"scripts": ["background/background.js", "options/options.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "@somethingphishy", "strict_min_version": "88.0"}}, "browser_action": {"default_icon": {"32": "/img/icons/icon-dark.png"}, "default_title": "SomethingPhishy", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/history.html", "open_in_tab": true}, "content_security_policy": "script-src 'self'", "icons": {"32": "/img/icons/icon-dark.png"}, "web_accessible_resources": ["icon-dark.png", "dist/output.css"]}