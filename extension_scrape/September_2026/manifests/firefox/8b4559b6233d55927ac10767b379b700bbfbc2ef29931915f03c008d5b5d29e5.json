{"manifest_version": 3, "name": "Broken Link Highlighter", "version": "1.0.0", "description": "Check page links, flag obvious broken URLs, and highlight problematic links directly on the current page.", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Broken Link Highlighter", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "broken-link-highlighter@local-addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}