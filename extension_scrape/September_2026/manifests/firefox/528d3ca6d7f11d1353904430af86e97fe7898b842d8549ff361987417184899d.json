{"manifest_version": 2, "name": "OG Previewer", "version": "1.0.0", "description": "Instantly preview how your page looks when shared on Twitter, LinkedIn, Slack, Discord & iMessage. Works on localhost.", "permissions": ["activeTab", "storage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "og-previewer@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"scripts": ["background/service-worker.js"]}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "content_security_policy": "script-src 'self'; object-src 'none'"}