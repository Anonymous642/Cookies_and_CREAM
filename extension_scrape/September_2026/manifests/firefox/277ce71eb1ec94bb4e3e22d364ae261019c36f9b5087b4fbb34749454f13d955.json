{"manifest_version": 3, "name": "SoundCloud Follow Bot", "description": "SoundCloud Follow Bot automatically follows someone's followers for you", "author": "Sprise", "permissions": ["storage"], "host_permissions": ["https://soundcloud.com/*", "https://sprise-api.xyz/*"], "update_url": "https://clients2.google.com/service/update2/crx", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "{a3b2c1d4-5e6f-4789-90ab-cdef12345678}"}}, "icons": {"16": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png"}, "action": {"default_popup": "popup/payment.html"}, "content_scripts": [{"js": ["content/content.js"], "matches": ["https://soundcloud.com/*"]}]}