{"manifest_version": 3, "name": "Dump to Todoist", "version": "1.0.0", "description": "Select open tabs and dump them to Todoist as tasks, then close the tabs.", "permissions": ["tabs", "storage"], "host_permissions": ["https://api.todoist.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "dump2todoist@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}