{"manifest_version": 3, "name": "Focused YouTube", "version": "1.0.0", "description": "This project is an independent fork of \u201cMinimal YouTube\u201d by Ephraim Atta-Duncan. Not affiliated with YouTube or Google.", "author": "Ethan Gaspar", "browser_specific_settings": {"gecko": {"id": "{3b77439d-c08e-4235-9ae1-efb52d323ea2}", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/16x16.png", "48": "assets/48x48.png", "128": "assets/128x128.png"}, "content_scripts": [{"css": ["src/styles/styles.css"], "js": ["src/content/content.js"], "matches": ["https://*.youtube.com/*"], "exclude_matches": ["https://music.youtube.com/*"]}], "action": {"default_popup": "src/popup/popup.html"}, "permissions": ["storage", "tabs"]}