{"manifest_version": 3, "name": "FocusShield - Block Online Distractions", "version": "3.6.0", "description": "Block distracting content on social media and custom sites. Stay focused, browse smarter, reclaim your time.", "browser_specific_settings": {"gecko": {"id": "focusshield@extension", "strict_min_version": "109.0"}}, "permissions": ["storage", "tabs", "activeTab", "alarms", "contextMenus"], "commands": {"toggle-focus-mode": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Toggle FocusShield master blocking on/off"}, "quick-block-tab": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Quick block the current tab's domain"}}, "host_permissions": ["<all_urls>"], "background": {"scripts": ["supabase.js", "config.js", "auth.js", "sync.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["hard-blocked.html", "hard-blocked.js"], "matches": ["<all_urls>"]}]}