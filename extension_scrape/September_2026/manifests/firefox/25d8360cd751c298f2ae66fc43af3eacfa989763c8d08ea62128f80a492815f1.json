{"manifest_version": 2, "name": "Google Translate Sidebar V2", "version": "1.3", "description": "Translate selected or input text with Google Translate using a sidebar. Supports language selection and persistent settings.", "permissions": ["contextMenus", "storage", "activeTab", "tabs"], "sidebar_action": {"default_title": "Translate Text", "default_panel": "sidebar.html", "default_icon": "icons/logo_64.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "translate-sidebar@example.com", "strict_min_version": "68.0"}}}