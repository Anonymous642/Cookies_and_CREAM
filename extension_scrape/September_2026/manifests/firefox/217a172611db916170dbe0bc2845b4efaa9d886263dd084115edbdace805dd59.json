{"manifest_version": 2, "name": "SpotFacts", "description": "Detect deepfake, voice cloning and more just by clicking on the extension.!", "version": "1.0.2", "icons": {"48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "contextMenus", "clipboardWrite", "activeTab", "https://api.spotfacts.com/*"], "web_accessible_resources": ["popup.html", "*.css", "*.js", "*.png", "*.svg"], "externally_connectable": {"matches": ["https://spotfacts.com/*"]}, "browser_specific_settings": {"gecko": {"id": "spotfacts@extension_1", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "SpotFacts", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://spotfacts.com/extension/connect*"], "run_at": "document_start", "js": ["content-scripts/auth-bridge.js"]}, {"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}