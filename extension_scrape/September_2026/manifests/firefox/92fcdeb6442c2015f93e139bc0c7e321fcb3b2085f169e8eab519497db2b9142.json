{"manifest_version": 3, "default_locale": "en", "name": "Hedge - AI-powered distraction blocker", "version": "0.0.8", "description": "Hedge is a web browser extension designed to help you stay focused and achieve your goals by blocking distracting websites.", "host_permissions": ["<all_urls>"], "permissions": ["storage", "tabs", "notifications", "scripting"], "background": {"scripts": ["background.iife.js"], "type": "module"}, "action": {"default_popup": "popup/index.html", "default_icon": "icon-34.png"}, "icons": {"128": "icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "<all_urls>"], "js": ["content-ui/index.iife.js"]}, {"matches": ["http://*/*", "https://*/*", "<all_urls>"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["*.js", "*.css", "*.svg", "icon-128.png", "icon-34.png", "*.mp3", "offscreen.html"], "matches": ["*://*/*"]}], "options_ui": {"page": "options/index.html", "browser_style": false}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "extension@hedge.coach", "strict_min_version": "109.0"}}}