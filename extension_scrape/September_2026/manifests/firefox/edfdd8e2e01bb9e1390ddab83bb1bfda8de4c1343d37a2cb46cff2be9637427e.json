{"manifest_version": 3, "name": "League Read Browser Extension", "short_name": "League Read", "version": "0.3.3", "description": "Links this browser to a League Read account and connects private ESPN leagues from the signed-in ESPN session.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "League Read browser connection", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["storage", "scripting"], "background": {"scripts": ["background.js"]}, "optional_permissions": ["cookies"], "optional_host_permissions": ["https://espn.com/*", "https://*.espn.com/*", "https://leagueread.com/*"], "browser_specific_settings": {"gecko": {"id": "{2d80a8f8-24cd-4fcb-8470-ff9d8bedc46d}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}