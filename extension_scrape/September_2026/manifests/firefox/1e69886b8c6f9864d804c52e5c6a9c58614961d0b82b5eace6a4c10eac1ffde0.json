{"manifest_version": 3, "name": "Interpellami - Assistente Interpelli docenti", "version": "0.2.0", "description": "Compila automaticamente i dati nelle candidature agli interpelli per docenti sul portale Argo.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Interpellami", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "browser_specific_settings": {"gecko": {"id": "@interpellami", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://madinterpello.portaleargo.it/*"], "js": ["fill.js", "auto.js"], "run_at": "document_idle"}], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}