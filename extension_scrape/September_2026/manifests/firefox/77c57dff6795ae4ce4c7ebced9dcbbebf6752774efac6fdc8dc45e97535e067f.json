{"manifest_version": 2, "name": "Playerok Seller Tools", "version": "5.0.1", "description": "\u0428\u0430\u0431\u043b\u043e\u043d\u044b \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439, \u0443\u0447\u0451\u0442 \u0441\u0434\u0435\u043b\u043e\u043a \u0438 \u043f\u0440\u0438\u0431\u044b\u043b\u0438, \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440, \u0430\u0432\u0442\u043e-\u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446", "author": "PlayerokTools", "browser_specific_settings": {"gecko": {"id": "playerok-seller-tools@firefox.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_popup": "src/popup.html", "default_title": "Playerok Seller Tools"}, "permissions": ["storage", "tabs", "alarms", "activeTab", "*://*.playerok.com/*"], "background": {"scripts": ["src/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.playerok.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "src/options.html", "browser_style": false, "open_in_tab": true}, "commands": {"open-chats": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0447\u0430\u0442\u044b"}, "open-sales": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0440\u043e\u0434\u0430\u0436\u0438"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}