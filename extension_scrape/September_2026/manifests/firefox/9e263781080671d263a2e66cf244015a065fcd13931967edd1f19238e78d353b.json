{"manifest_version": 3, "name": "Social Media Quick Search for Mozilla", "version": "1.0", "description": "Quickly search your favourite social media sites from your browser's address bar!", "permissions": ["tabs", "storage", "webNavigation"], "host_permissions": ["https://*.google.com/*", "https://youtube.com/*", "https://x.com/*", "https://twitter.com/*", "https://reddit.com/*", "https://twitch.tv/*"], "background": {"scripts": ["backgroundyoutube.js"]}, "content_scripts": [{"matches": ["https://youtube.com/*", "https://x.com/*", "https://twitter.com/*", "https://reddit.com/*", "https://twitch.tv/*"], "js": ["contentyoutube.js"]}], "browser_specific_settings": {"gecko": {"id": "socialquicksearch@valkryx.com", "strict_min_version": "109.0"}}, "icons": {"16": "./icons/icon16.png", "48": "./icons/icon48.png", "128": "./icons/icon128.png"}, "action": {"default_icon": {"16": "./icons/icon16.png", "48": "./icons/icon48.png", "128": "./icons/icon128.png"}, "default_popup": "popup.html"}}