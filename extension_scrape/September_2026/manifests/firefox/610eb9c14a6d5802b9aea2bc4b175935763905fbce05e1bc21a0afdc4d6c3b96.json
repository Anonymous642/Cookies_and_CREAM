{"manifest_version": 3, "name": "Tab Exporter", "version": "3.0", "description": "Tabs auflisten, kopieren, gruppieren und verwalten.", "permissions": ["tabs", "clipboardWrite", "bookmarks", "downloads", "storage"], "action": {"default_title": "Tab Exporter", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tab-exporter-v3@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}