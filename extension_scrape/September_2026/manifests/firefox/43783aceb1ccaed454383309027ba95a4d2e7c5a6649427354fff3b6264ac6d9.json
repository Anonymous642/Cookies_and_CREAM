{"manifest_version": 3, "name": "Zen Auto-Close Tabs", "version": "0.1.0", "description": "Automatically closes old unpinned tabs after a chosen interval. Designed for Zen Browser.", "permissions": ["alarms", "storage", "tabs"], "background": {"scripts": ["shared.js", "background.js"]}, "action": {"default_icon": "icons/icon.svg", "default_popup": "popup/popup.html", "default_title": "Zen Auto-Close Tabs"}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "options_ui": {"browser_style": false, "page": "options/options.html"}, "browser_specific_settings": {"gecko": {"id": "@zen-auto-close-tabs", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}