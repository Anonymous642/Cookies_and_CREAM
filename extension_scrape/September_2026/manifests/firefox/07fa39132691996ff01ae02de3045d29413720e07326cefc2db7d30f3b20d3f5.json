{"manifest_version": 3, "name": "Nelis CRM for Linkedin", "version": "1.0.8", "description": "Synchronisez vos contacts LinkedIn avec votre CRM Nelis en un clic, sans quitter LinkedIn.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.linkedin.com/*", "https://*.mynelis.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["config/oauth-config.js", "utils/linkedin-scraper.js", "content-script.js"], "css": ["content-script.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.linkedin.com/*"]}], "browser_specific_settings": {"gecko": {"id": "nelis-crm-linkedin@mynelis.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"]}}}}