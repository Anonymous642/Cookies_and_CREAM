{"manifest_version": 3, "name": "Tailmailer", "version": "1.0.1", "description": "Fill signup forms with private Tailmailer aliases that shield your real email address from breaches and spam.", "homepage_url": "https://account.tailmailer.com", "browser_specific_settings": {"gecko": {"id": "firefox-extension@tailmailer.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}, "permissions": ["storage", "activeTab", "clipboardWrite"], "host_permissions": ["https://api.tailmailer.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup/popup.html", "default_title": "Tailmailer", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}