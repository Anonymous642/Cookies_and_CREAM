{"manifest_version": 3, "name": "Custom Shortcuts", "version": "0.1.6", "description": "Keyboard-driven tab actions for Firefox.", "background": {"scripts": ["background.js"]}, "action": {"default_title": "Custom Shortcuts", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabGroups"], "browser_specific_settings": {"gecko": {"id": "custom-shortcuts@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"unload-selected-tabs": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Unload selected tabs"}, "toggle-selected-tab-group": {"suggested_key": {"default": "Ctrl+Shift+G"}, "description": "Group / ungroup selected tabs"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}