{"manifest_version": 2, "name": "Kishta.io Theme Customizer", "version": "1.0.0", "description": "Extensive theme library and generation system for unlimited kishta.io customization options", "permissions": ["storage", "activeTab", "notifications", "contextMenus"], "content_scripts": [{"matches": ["*://kishta.io/*", "*://*.kishta.io/*"], "js": ["utils/css-parser.js", "utils/dom-utils.js", "themes/color-algorithms.js", "themes/theme-engine.js", "storage/theme-storage.js", "content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Kishta.io Theme Customizer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-theme": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Toggle between themes"}, "random-theme": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Apply random theme"}, "reset-theme": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Reset to original theme"}}, "browser_specific_settings": {"gecko": {"id": "jimmymarley147@gmail.com"}}}