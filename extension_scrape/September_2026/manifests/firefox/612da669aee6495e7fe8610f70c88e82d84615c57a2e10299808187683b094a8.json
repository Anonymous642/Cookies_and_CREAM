{"manifest_version": 3, "name": "SilentSkip Music Master", "description": "Automatically skip silence and long intros in songs for a seamless and uninterrupted music listening experience.", "version": "1.0.0", "author": "SoundLabs", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.spotify.com/*", "*://*.soundcloud.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "silentskipmusicmaster@soundlabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}