{"manifest_version": 2, "name": "AudioSaver-Pro", "version": "1.7.0", "description": "Save bandwidth on YouTube & YouTube Music: drop the video stream when possible, force the smallest video when it isn't, and track what you saved.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["scripting", "storage", "tabs", "activeTab", "*://*.youtube.com/*", "*://music.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "AudioSaver-Pro"}, "background": {"scripts": ["utils.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://music.youtube.com/*"], "js": ["utils.js", "content.js"], "css": ["content.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-audio-saver-pro@antigravity.addon", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}