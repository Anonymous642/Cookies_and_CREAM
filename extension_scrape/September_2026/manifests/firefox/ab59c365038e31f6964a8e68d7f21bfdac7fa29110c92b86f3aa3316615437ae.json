{"manifest_version": 3, "name": "X Verified Blocker", "version": "1.0", "description": "Hide tweets from verified users in Twitter home feed and replies. Provides a toggle to enable/disable without reload.", "icons": {"48": "icon.png"}, "permissions": ["storage"], "host_permissions": ["*://x.com/*", "*://twitter.com/*"], "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["block-verified.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "twitterverifiedblocker@addons.mozilla.com", "strict_min_version": "109.0"}}}