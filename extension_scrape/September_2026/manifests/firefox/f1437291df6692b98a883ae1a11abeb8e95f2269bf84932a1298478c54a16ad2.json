{"manifest_version": 2, "name": "ScrollSnake", "version": "1.0.0", "description": "A mini snake game controlled by page scroll: scroll down = move forward, scroll up = change direction. Runs in a small overlay.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "scrollsnake@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}