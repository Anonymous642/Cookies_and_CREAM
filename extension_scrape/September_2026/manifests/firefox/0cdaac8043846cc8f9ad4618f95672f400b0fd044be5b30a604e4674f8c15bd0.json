{"manifest_version": 3, "name": "Security Attachment Scanner", "version": "1.0.2", "description": "Detecta descargas potencialmente sospechosas por extensi\u00f3n, doble extensi\u00f3n y tama\u00f1o vac\u00edo. Integra advertencias inline en Gmail.", "permissions": ["downloads", "storage"], "host_permissions": ["https://mail.google.com/*", "https://www.virustotal.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Security Scanner", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content_gmail.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "security-attachment-scanner@iamtweaks.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}