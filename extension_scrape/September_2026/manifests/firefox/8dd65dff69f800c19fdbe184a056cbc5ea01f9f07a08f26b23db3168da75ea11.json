{"manifest_version": 3, "name": "Ybomb", "version": "0.4.0", "description": "Removes YouTube videos whose title, channel, description, or tags match your blacklist; hides YouTube Shorts and Instagram Reels.", "browser_specific_settings": {"gecko": {"id": "ybomb@ybomb.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://www.instagram.com/*"], "background": {"scripts": ["src/background/background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["src/common/matcher.js", "src/common/ids.js", "src/common/lru.js", "src/common/limiter.js", "src/common/innertube.js", "src/common/settings.js", "src/content/dom.js", "src/content/metadata.js", "src/content/engine.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_start"}, {"matches": ["*://www.instagram.com/*"], "js": ["src/common/matcher.js", "src/common/settings.js", "src/content/instagram-core.js", "src/content/instagram.js"], "css": ["src/content/instagram.css"], "run_at": "document_start"}], "action": {"default_title": "Ybomb", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/ybomb.svg", "96": "icons/ybomb.svg"}}, "icons": {"48": "icons/ybomb.svg", "96": "icons/ybomb.svg"}}