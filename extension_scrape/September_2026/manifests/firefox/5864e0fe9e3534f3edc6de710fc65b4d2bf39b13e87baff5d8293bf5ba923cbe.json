{"manifest_version": 3, "name": "TFT Bookmarks", "version": "1.1", "description": "Save custom bookmarks on tactics.tools and metatft.com.", "browser_specific_settings": {"gecko": {"id": "tftbookmarks@stebbun.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://tactics.tools/*", "*://*.metatft.com/*"], "action": {"default_popup": "popup.html", "default_title": "TFT Bookmarks", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://tactics.tools/*", "*://*.metatft.com/*"], "js": ["content.js"], "css": ["content.css"]}]}