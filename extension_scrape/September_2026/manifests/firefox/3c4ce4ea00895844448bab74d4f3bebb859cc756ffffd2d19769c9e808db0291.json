{"manifest_version": 3, "name": "Refindoo \u2014 IKEA seconde vie", "version": "1.0.0", "description": "Sur une page produit IKEA, voyez s'il existe en seconde vie (occasion) et cr\u00e9ez une alerte prix/stock en un clic.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Refindoo \u2014 seconde vie IKEA", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.ikea.com/*", "https://refindoo.com/*"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "content_scripts": [{"matches": ["*://*.ikea.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "refindoo@refindoo.com", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"]}}}}