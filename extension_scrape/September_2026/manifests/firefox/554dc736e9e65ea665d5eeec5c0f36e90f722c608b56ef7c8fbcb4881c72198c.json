{"manifest_version": 3, "name": "SteamHunters Stats", "version": "1.0.0", "description": "Displays SteamHunters completion stats on Steam store pages: avg completion, users perfected, DLC requirements, and more.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "SteamHunters Stats", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "host_permissions": ["https://steamhunters.com/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://store.steampowered.com/*"]}], "browser_specific_settings": {"gecko": {"id": "steamhunters-stats@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}