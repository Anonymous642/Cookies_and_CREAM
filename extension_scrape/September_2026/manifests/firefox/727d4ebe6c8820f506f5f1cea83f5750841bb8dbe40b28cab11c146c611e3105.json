{"manifest_version": 3, "name": "RandUserNameGenerator", "version": "2.0.2", "description": "Generate random usernames for any account creation form with a single click.", "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["utils.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils.js", "content.js"]}], "commands": {"fill-active-field": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Fill active field with a random username"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "rand-user-gen-v1@extensions.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}