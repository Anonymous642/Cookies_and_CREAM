{"manifest_version": 2, "name": "Mesh Proxy Controller", "version": "0.1.0", "description": "Route Firefox through your mesh-proxy edges, with live edge status, weights, enable/disable and country flags.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "proxy", "webRequest", "webRequestBlocking", "notifications", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Mesh Proxy", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "mesh-proxy@local", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"]}}}}