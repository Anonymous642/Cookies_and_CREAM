{"manifest_version": 3, "name": "Screeb Inspector", "version": "0.1.1", "description": "Health check and quick access to the Screeb Debug Inspector on any site running the Screeb SDK.", "action": {"default_popup": "popup.html", "default_title": "Screeb Inspector", "default_icon": {"16": "icons/icon-gray-16.png", "32": "icons/icon-gray-32.png", "48": "icons/icon-gray-48.png", "128": "icons/icon-gray-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/detector-main.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/bridge.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "inspector@screeb.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}