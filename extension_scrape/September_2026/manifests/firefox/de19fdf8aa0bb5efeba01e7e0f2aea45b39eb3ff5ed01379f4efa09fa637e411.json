{"manifest_version": 3, "name": "Selectable YouTube Subtitles", "version": "1.0", "description": "Makes all YouTube video subtitles selectable.", "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "ytselectablesubtitles@ytselectablesubtitles", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}]}