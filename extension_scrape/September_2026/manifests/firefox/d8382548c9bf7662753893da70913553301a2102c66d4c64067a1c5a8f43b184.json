{"manifest_version": 2, "name": "Stay Upright", "version": "1.0.0", "description": "Straighten your phone during a fullscreen video to switch to portrait and zoom in. Pinch, drag and double-tap to frame it.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "stay-upright@hoshinonaiginga", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}]}