{"manifest_version": 3, "name": "OpenAsGuest \u2013 Shared Link Access Checker", "short_name": "OpenAsGuest", "version": "0.1.1", "description": "Check whether Google Drive and Dropbox file links open without signing in before you send them.", "author": "End of the End", "icons": {"16": "icons/open-as-guest.svg", "32": "icons/open-as-guest.svg", "48": "icons/open-as-guest.svg", "64": "icons/open-as-guest.svg", "96": "icons/open-as-guest.svg"}, "permissions": ["activeTab", "contextMenus"], "host_permissions": ["https://drive.google.com/*", "https://accounts.google.com/*", "https://dropbox.com/*", "https://www.dropbox.com/*", "https://*.dropboxusercontent.com/*"], "incognito": "not_allowed", "background": {"scripts": ["src/common.js", "src/url-policy.js", "src/permissions.js", "src/providers/google.js", "src/providers/dropbox.js", "src/provider-registry.js", "src/checker.js", "src/background.js"]}, "action": {"default_title": "Check a Drive or Dropbox file link as guest", "default_icon": "icons/open-as-guest.svg", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "openasguest@endoftheend", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}