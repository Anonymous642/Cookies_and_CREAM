{"manifest_version": 3, "name": "mAId", "short_name": "mAId", "description": "mAId simplifie vos d\u00e9marches administratives en France (CAF, Ameli, Imp\u00f4ts, etc.)", "version": "0.3.1", "browser_specific_settings": {"gecko": {"id": "maid@numaid.app", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "mAId", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png", "256": "assets/store-icon-256.png", "512": "assets/store-icon-512.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/overlay.js", "content/context.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}