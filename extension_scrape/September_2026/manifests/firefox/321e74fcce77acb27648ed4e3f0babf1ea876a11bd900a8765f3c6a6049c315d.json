{"manifest_version": 3, "name": "D&D Beyond 5.5e Rules Overlay", "version": "1.11.0", "description": "Adds 5.5e rules effects plus a native-style active-effects sidebar, concentration display, expanded sheet layout, and synchronized primary-resource tracker.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_title": "5.5e Rules Overlay - Character Sheet Update", "default_icon": "icons/icon.svg", "default_popup": "popup/popup.html"}, "permissions": ["storage"], "host_permissions": ["https://character-service.dndbeyond.com/*"], "browser_specific_settings": {"gecko": {"id": "dndbeyond-2024-rules-overlay@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://dndbeyond.com/characters/*", "*://*.dndbeyond.com/characters/*"], "css": ["styles/overlay.css"], "js": ["content/exhaustion-rules.js", "content/content.js"], "run_at": "document_start"}, {"matches": ["*://dndbeyond.com/characters/*", "*://*.dndbeyond.com/characters/*"], "css": ["styles/sheet-update.css"], "js": ["content/sheet-update-data.js", "content/sheet-update.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/exhaustion-rules.js", "content/page-roll-bridge.js"], "matches": ["*://dndbeyond.com/*", "*://*.dndbeyond.com/*"]}]}