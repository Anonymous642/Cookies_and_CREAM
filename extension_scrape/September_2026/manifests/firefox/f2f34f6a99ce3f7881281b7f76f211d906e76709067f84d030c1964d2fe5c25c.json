{"manifest_version": 3, "name": "S Plus Zedge Link Copier", "short_name": "Zedge Copier", "version": "1.2.0", "description": "Instantly generate and copy shareable Zedge links from your contributor dashboard. Save time and stop hunting for URLs.", "permissions": ["activeTab"], "action": {"default_popup": "popup.html", "default_title": "Copy Zedge Link", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C", "mac": "MacCtrl+Shift+C"}, "description": "Open S Plus Zedge Link Copier popup"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "s-plus-zedge-link-copier@splus", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}