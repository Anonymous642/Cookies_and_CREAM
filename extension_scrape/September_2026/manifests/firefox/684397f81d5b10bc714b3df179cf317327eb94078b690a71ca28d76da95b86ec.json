{"manifest_version": 3, "name": "Torii Image Translator \u2014 AI Manga Translator", "description": "Best manga translator, manhwa translator, image translator in general, using AI, translate any image on any website!", "version": "2.22.4", "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "128": "images/128.png"}, "default_title": "Torii Image Translator"}, "commands": {"torii_contextmenu": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open Context Menu"}, "torii_screencrop": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Screen Crop Image"}, "torii_screenshot": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Screenshot Image"}, "torii_translate": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Translate Image"}, "torii_edit": {"description": "Edit Image"}, "torii_repeatscreencrop": {"description": "Repeat Last Screen Crop"}, "torii_download": {"description": "Download Image"}}, "icons": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "128": "images/128.png"}, "web_accessible_resources": [{"resources": ["images/*", "css/*", "fonts/*", "html/*", "scripts/*"], "matches": ["<all_urls>"]}], "background": {"page": "bg.html"}, "permissions": ["activeTab", "storage", "contextMenus", "declarativeNetRequestWithHostAccess", "unlimitedStorage"], "optional_permissions": ["downloads"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/untaint.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "stringieee@gmail.com", "strict_min_version": "115.0"}}}