{"manifest_version": 2, "name": "Vulgaris", "version": "1.0.1", "description": "Anonymous imageboard-style comment system for HackerNews", "author": "Vulgaris", "homepage_url": "https://git.sr.ht/~vulgaris/vulgaris", "browser_specific_settings": {"gecko": {"id": "vulgaris@vulgaris.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://news.ycombinator.com/*", "https://*.supabase.co/*"], "content_scripts": [{"matches": ["https://news.ycombinator.com/item?id=*"], "js": ["content-all.js"], "css": ["content/styles.css"], "run_at": "document_end"}], "background": {"scripts": ["background/service-worker.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "Vulgaris", "default_popup": "popup/popup.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["config/*", "lib/*", "content/*", "moderation/*"], "content_security_policy": "script-src 'self' https://cdn.jsdelivr.net; object-src 'self'"}