{"manifest_version": 2, "name": "Wikipedia-LastUpdatedUpTop", "version": "0.1", "description": "Shows when wiki articles were last updated at the TOP of the page", "icons": {"48": "icon48.png"}, "browser_specific_settings": {"gecko": {"id": "@Wikipedia-LastUpdatedUpTop", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.wikipedia.org/wiki/*"], "js": ["background.js"], "run_at": "document_end"}]}