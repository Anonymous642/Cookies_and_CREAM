{"manifest_version": 3, "name": "Isra Cloud \u2013 Restore Original File URL", "version": "1.0.0", "description": "Tracks redirects from isra.cloud and restores the original file ID in the address bar instead of /download.", "permissions": ["webRequest", "*://isra.cloud/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://isra.cloud/download*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "@isra-cloud-restore-original-url", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon/icon-16.png", "24": "icon/icon-24.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png"}, "action": {"default_title": "Isra Cloud \u2013 Restore Original File URL"}}