{"manifest_version": 2, "name": "BookMarquee", "version": "2.1.1", "description": "Turn your X bookmarks into a searchable knowledge base. Collections, tags, smart filters, all local. No account, no server needed.", "browser_specific_settings": {"gecko": {"id": "bookmarquee@nassif.pro", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "sidebar_action": {"default_title": "BookMarquee", "default_panel": "sidepanel/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "https://x.com/*", "https://twitter.com/*", "https://www.google-analytics.com/"], "background": {"scripts": ["background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/injected.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/hint.js"], "run_at": "document_idle"}], "web_accessible_resources": ["sidepanel/*", "icons/*", "content/injected.js"]}