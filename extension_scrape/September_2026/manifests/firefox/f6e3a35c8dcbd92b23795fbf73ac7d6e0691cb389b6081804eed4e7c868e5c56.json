{"manifest_version": 3, "name": "LinkedIn Company Blocklist", "version": "1.1.0", "description": "Hide job postings from companies you never want to see again.", "browser_specific_settings": {"gecko": {"id": "linkedin-blocklist@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "action": {"default_title": "Company Blocklist", "default_popup": "popup.html", "default_icon": "icon.svg"}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}