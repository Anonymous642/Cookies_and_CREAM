{"name": "Wtyczka Badawcza IFIS", "description": "Logs Google search interactions and correlates opened result tabs.", "version": "1.0.0", "manifest_version": 3, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.google.com/*", "https://google.com/*", "https://www.google.pl/*", "https://google.pl/*", "https://api.plugin.ifis.jkfstudio.pl/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "ifis-survey-plugin@jkfstudio.pl", "data_collection_permissions": {"required": ["searchTerms", "browsingActivity", "websiteContent", "websiteActivity"]}}}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://google.com/search*", "https://www.google.pl/search*", "https://google.pl/search*"], "js": ["src/content.js", "src/content/google-search-capture.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.plugin.ifis.jkfstudio.pl"}, "web_accessible_resources": [{"resources": ["assets/*.js", "logo.png", "alert.wav", "index.html", "audio.html"], "matches": ["<all_urls>"]}]}