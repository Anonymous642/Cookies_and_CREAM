{"manifest_version": 3, "name": "TF2 Emporium Checker", "version": "1.0.1", "description": "Checks the TF2 Workshop submissions for Emporium users to inform the user.", "icons": {"48": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "hazeofdreamx@gmail.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "downloads"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html"}, "host_permissions": ["https://steamcommunity.com/*"], "content_scripts": [{"matches": ["https://steamcommunity.com/sharedfiles/filedetails/?id=*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}