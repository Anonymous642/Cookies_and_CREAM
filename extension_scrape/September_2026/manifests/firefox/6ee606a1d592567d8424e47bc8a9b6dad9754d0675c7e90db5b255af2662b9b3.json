{"manifest_version": 3, "name": "Copus \u2013 Curate, Discover, Connect", "description": "Save what resonates as you browse. Build a taste graph you own, share it with anyone, and connect it to your AI.", "version": "1.19.6", "browser_specific_settings": {"gecko": {"id": "copus@copus.network", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": []}}}, "permissions": ["activeTab", "tabs", "scripting", "contextMenus", "storage", "webNavigation"], "host_permissions": ["https://api-prod.copus.network/*", "https://api-test.copus.network/*", "https://copus.network/*", "https://test.copus.network/*", "https://copus.ai/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Copus", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "commands": {"quick-save": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Alt+Shift+S"}, "description": "Quick save current page to Copus"}, "toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Alt+Shift+E"}, "description": "Toggle Copus sidebar"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_start"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://chat.deepseek.com/*", "https://gemini.google.com/*", "https://grok.com/*", "https://chat.mistral.ai/*", "https://huggingface.co/chat/*"], "js": ["aiChatHelper.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["taste-icon.png"], "matches": ["<al