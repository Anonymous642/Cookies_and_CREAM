{"manifest_version": 3, "name": "Video Speed Control", "version": "1.3.0", "description": "Control HTML5 video playback speed from 0.5\u00d7 to 4\u00d7 on any website.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup/popup.html", "default_title": "Video Speed Control"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": true}], "permissions": ["activeTab", "storage", "tabs"], "commands": {"increase-speed": {"suggested_key": {"default": "Alt+Period"}, "description": "Increase playback speed by 0.1\u00d7"}, "decrease-speed": {"suggested_key": {"default": "Alt+Comma"}, "description": "Decrease playback speed by 0.1\u00d7"}, "reset-speed": {"suggested_key": {"default": "Alt+N"}, "description": "Reset playback speed to 1\u00d7"}}, "browser_specific_settings": {"gecko": {"id": "video-speed-control@vsc.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}