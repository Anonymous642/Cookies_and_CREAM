{"manifest_version": 3, "name": "Background Remover by ResizeBox.com", "description": "Remove image backgrounds locally in Firefox. Images stay on your device.", "version": "1.0.0", "default_locale": "en", "homepage_url": "https://resizebox.com/remove-background?utm_source=firefox_extension&utm_medium=extension", "permissions": ["downloads"], "host_permissions": ["https://*.huggingface.co/*", "https://*.hf.co/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open Background Remover", "default_icon": "icons/logo.png"}, "sidebar_action": {"default_title": "Background Remover", "default_panel": "sidepanel.html", "default_icon": "icons/logo.png", "open_at_install": false}, "icons": {"512": "icons/logo.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "background-remover@resizebox.com", "data_collection_permissions": {"required": ["none"]}}}}