{"manifest_version": 3, "name": "EveryCRT", "version": "0.5.0", "description": "Earn points on EveryCRT.com by spotting CRTs & vintage AV gear on marketplace sites", "permissions": ["storage", "tabs", "identity", "webNavigation", "webRequest", "scripting"], "host_permissions": ["*://*.facebook.com/*", "*://*.etsy.com/*", "*://*.craigslist.org/*", "*://*.offerup.com/*", "*://*.shopgoodwill.com/*", "*://*.govdeals.com/*", "*://*.marktplaats.nl/*", "*://*.avito.ru/*", "https://everycrt.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://everycrt.com/*"], "js": ["site-marker.js"], "run_at": "document_start"}, {"matches": ["https://everycrt.com/extension/authorized*"], "js": ["authorized.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "EveryCRT", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "spotter@everycrt.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}}