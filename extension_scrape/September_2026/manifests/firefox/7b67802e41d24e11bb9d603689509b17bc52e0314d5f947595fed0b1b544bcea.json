{"manifest_version": 3, "name": "YT-XL", "version": "1.5.3", "description": "Customize YouTube homepage thumbnails and watch page styles.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["*://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "yt-xl-layout@example.com", "strict_min_version": "109.0"}}}