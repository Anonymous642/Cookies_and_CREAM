{"manifest_version": 3, "name": "chrpr", "version": "2.1.0", "description": "A chatty on-screen companion with personality packs. Pick an avatar or bring your own GIF, drag it anywhere, and click to search every action it knows.", "browser_specific_settings": {"gecko": {"id": "chrpr@nyghtcore.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "tabs", "bookmarks", "sessions"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["avatars.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "chrpr", "default_popup": "popup.html", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}, "commands": {"toggle-menu": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open the chrpr menu"}, "hide-chrpr": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hide chrpr on this site"}, "copy-clean": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Copy the page link without tracking tags"}, "reader-mode": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle reader view"}, "pin-tab": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pin or unpin this tab"}, "mute-tab": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Mute or unmute this tab"}}, "web_accessible_resources": [{"resources": ["packs/*.txt", "gifstore.js"], "matches": ["<all_urls>"]}], "icons": {"48": "icon.svg", "96": "icon.svg"}}