{"manifest_version": 3, "name": "Bypass Schibsted CMP-wall", "version": "1.1.0", "description": "Removes the Sourcepoint/Schibsted cookie-consent wall and restores scrolling on Aftonbladet and other Schibsted sites. The article is already in the page; this just gets the overlay out of the way.", "browser_specific_settings": {"gecko": {"id": "cmp-declutter@jont.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.aftonbladet.se/*", "*://*.svd.se/*", "*://*.omni.se/*", "*://*.vg.no/*", "*://*.aftenposten.no/*", "*://*.bt.no/*", "*://*.aftenbladet.no/*"], "declarative_net_request": {"rule_resources": [{"id": "block_cmp", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.aftonbladet.se/*", "*://*.svd.se/*", "*://*.omni.se/*", "*://*.vg.no/*", "*://*.aftenposten.no/*", "*://*.bt.no/*", "*://*.aftenbladet.no/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}