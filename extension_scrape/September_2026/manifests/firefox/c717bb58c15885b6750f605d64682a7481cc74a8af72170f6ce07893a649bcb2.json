{"manifest_version": 3, "name": "Splashtop Web Tunnel", "version": "1.1.0", "description": "Splashtop Web Tunnel provides secure access to internal web applications via encrypted web tunnels without exposing inbound ports.", "browser_specific_settings": {"gecko": {"id": "web-tunnel@splashtop.com", "strict_min_version": "140.0"}}, "permissions": ["nativeMessaging", "activeTab", "scripting", "proxy", "storage"], "host_permissions": ["http://localhost/*", "https://*/*", "file://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>", "file://*/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}}, "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "web_accessible_resources": [{"resources": ["logo.png"], "matches": ["<all_urls>"]}], "incognito": "spanning"}