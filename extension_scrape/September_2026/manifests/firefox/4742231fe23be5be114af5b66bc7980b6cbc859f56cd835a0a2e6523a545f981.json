{"manifest_version": 3, "name": "Quinn", "version": "26.9.1", "description": "Extension implementation of Quinn's initiative tracker", "permissions": ["storage", "scripting", "alarms", "identity", "tabs"], "host_permissions": ["https://shmeppy.com/*", "https://api.doxbox.org/*"], "action": {"default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://shmeppy.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "quinn@doxbox.org", "strict_min_version": "112.0"}}, "web_accessible_resources": [{"resources": ["icons/quinn_side_smol.png"], "matches": ["https://shmeppy.com/*"]}]}