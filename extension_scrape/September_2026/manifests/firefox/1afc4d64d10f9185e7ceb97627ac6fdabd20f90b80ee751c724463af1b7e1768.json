{"manifest_version": 3, "name": "Intentionality - Focused Browsing", "short_name": "Intentionality", "version": "1.8.1", "description": "Build the habit of focus. Block distractions, browse with intention, and set mindful time limits with Intentionality.", "homepage_url": "https://intentionality.app/", "author": "Intentionality Team", "permissions": ["storage", "scripting", "notifications", "tabs", "webNavigation", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/browser-polyfill.js", "service-worker.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["why_prompt.html", "lib/*"], "matches": ["https://intentionality.app/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "intentionality-firefox@intentionality.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "personallyIdentifyingInfo"]}}, "gecko_android": {}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}