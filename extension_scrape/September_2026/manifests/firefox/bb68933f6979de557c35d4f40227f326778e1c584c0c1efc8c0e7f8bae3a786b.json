{"manifest_version": 3, "name": "Adad Calculator", "version": "1.0.0", "description": "Adad Calculator is a powerful Firefox extension offering Basic, Scientific, Programmer, and Converter calculator modes, along with calculation history, dark mode, and selected-text calculations.", "browser_specific_settings": {"gecko": {"id": "adad@calculator.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "action": {"default_title": "Adad Calculator", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "permissions": ["storage", "contextMenus", "clipboardWrite"]}