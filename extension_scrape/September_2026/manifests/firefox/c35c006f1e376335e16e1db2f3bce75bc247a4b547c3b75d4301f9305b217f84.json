{"manifest_version": 3, "name": "Taber", "version": "1.1", "description": "A browser extension to manage TABs", "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "browser_specific_settings": {"gecko": {"id": "{310c3b77-8ce1-4761-a5c3-52883588dded}", "strict_min_version": "109.0"}}, "sidebar_action": {"default_icon": "icons/icon_128.png", "default_title": "Taber", "default_panel": "pages/side.html"}, "background": {"scripts": ["js/bg.js"]}, "action": {"default_title": "\u6253\u5f00\u4fa7\u8fb9\u680f"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["js/cs.js"], "css": ["css/common.css", "css/side.css"], "run_at": "document_end"}], "permissions": ["scripting", "tabs", "activeTab", "storage", "downloads", "webRequest"], "host_permissions": ["<all_urls>"]}