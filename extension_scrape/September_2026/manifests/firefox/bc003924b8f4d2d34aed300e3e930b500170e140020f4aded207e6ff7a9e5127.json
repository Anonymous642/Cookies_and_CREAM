{"manifest_version": 3, "name": "SOWN JD Matcher", "version": "1.0", "description": "Match your CV to job descriptions on any webpage.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["<all_urls>"], "background": {"page": "background.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "sown-jd-matcher@yourdomain.com"}}}