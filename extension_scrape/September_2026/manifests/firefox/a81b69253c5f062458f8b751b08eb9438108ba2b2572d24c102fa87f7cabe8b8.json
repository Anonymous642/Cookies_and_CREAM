{"manifest_version": 2, "name": "Echo Lite", "version": "0.6.5", "description": "Make a voice your own. Local voice effects and a soundboard for calls in Firefox.", "permissions": ["storage", "scripting", "activeTab", "identity"], "background": {"page": "background.html", "persistent": true}, "options_ui": {"page": "index.html", "open_in_tab": true}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "commands": {"toggle-mute": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Mute or unmute Echo"}, "stop-sounds": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Stop all Echo sounds"}, "play-sound-1": {"description": "Run Echo action slot 1"}, "play-sound-2": {"description": "Run Echo action slot 2"}, "play-sound-3": {"description": "Run Echo action slot 3"}, "play-sound-4": {"description": "Run Echo action slot 4"}}, "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; connect-src 'self' https://soundboard.pro https://media.soundboard.pro https://voicechanger.live https://eu.i.posthog.com; img-src 'self' data: blob: https://soundboard.pro; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'", "browser_action": {"default_title": "Echo Lite", "default_popup": "index.html?popup=1"}, "optional_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "echo-lite@escalera.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "personalCommunications"], "optional": ["technicalAndInteraction"]}}}}