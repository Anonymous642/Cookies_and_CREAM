{"manifest_version": 2, "name": "ShadowCore Privacy Suite", "version": "1.0.4", "description": "License-activated privacy suite with proxy routing and YouTube skipper", "author": "ShadowCore Team", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["proxy", "storage", "tabs", "privacy", "alarms", "https://license.shadowcore.club/*", "<all_urls>"], "background": {"scripts": ["license.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_title": "ShadowCore", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "shadowcore-mode@shadowcore.browser", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"]}}}}