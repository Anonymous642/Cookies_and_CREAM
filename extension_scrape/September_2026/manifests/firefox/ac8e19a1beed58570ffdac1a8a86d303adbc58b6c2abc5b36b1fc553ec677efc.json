{"manifest_version": 3, "name": "NOligarchy", "version": "1.26.0", "browser_specific_settings": {"gecko": {"id": "noligarchy@noligarchy.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "description": "Shop without bankrolling political power and influence. Works on Amazon, Walmart & Target.", "permissions": ["activeTab", "storage"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "NOligarchy Settings", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "host_permissions": ["*://*.amazon.com/*", "*://*.walmart.com/*", "*://*.target.com/*", "https://noligarchy.com/*"], "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.walmart.com/*", "*://*.target.com/*"], "js": ["lib.js", "content.js"]}], "background": {"service_worker": "background.js", "scripts": ["lib.js", "background.js"]}, "web_accessible_resources": [{"resources": ["domain_scores.json"], "matches": ["*://*.amazon.com/*", "*://*.walmart.com/*", "*://*.target.com/*"]}]}