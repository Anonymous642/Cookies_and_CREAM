{"manifest_version": 2, "name": "FFYT - YouTube Tab Extractor", "description": "Save (and close) all your open YouTube tabs and reopen them later.", "version": "1.2.2", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["tabs", "activeTab", "storage", "https://www.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "ffyt@x86.no", "data_collection_permissions": {"required": ["none"], "optional": []}}}}