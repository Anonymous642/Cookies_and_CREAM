{"manifest_version": 2, "name": "Advanced Auto Dark Mode", "version": "1.0.0", "description": "Toggle dark mode per site, with customizable background and text colors.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_title": "Dark Mode Control", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "auto-dark-mode-v2@example.com", "strict_min_version": "78.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}