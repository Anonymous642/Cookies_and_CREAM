{"manifest_version": 3, "name": "Hoard Clipper", "version": "1.9.7", "description": "Save reference images to your private Hoard library.", "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications", "alarms"], "host_permissions": ["https://my-hoard.app/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Save to Hoard", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "hoard-clipper@my-hoard.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}