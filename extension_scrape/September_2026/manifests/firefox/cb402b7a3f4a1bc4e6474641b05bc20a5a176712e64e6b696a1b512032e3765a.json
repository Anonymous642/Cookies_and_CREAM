{"manifest_version": 3, "name": "Diagram Lens", "version": "1.1.1", "description": "Renders diagram code blocks on GitHub pages via kroki.io \u2014 supports DOT, PlantUML, Mermaid, D2, Excalidraw, and more.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://kroki.io/*", "https://api.web3forms.com/*", "https://nom.telemetrydeck.com/*"], "content_scripts": [{"matches": ["https://github.com/*", "https://gist.github.com/*"], "js": ["content/index.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/index.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "diagramlens@northfieldapps.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}