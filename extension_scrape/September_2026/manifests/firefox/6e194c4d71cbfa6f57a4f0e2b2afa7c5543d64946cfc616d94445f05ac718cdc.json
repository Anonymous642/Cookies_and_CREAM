{"manifest_version": 3, "name": "Yandex Images: Open+Similar Links", "version": "1.1.0", "description": "Collects and sends original and similar image links from Yandex Images", "permissions": ["activeTab"], "host_permissions": ["https://yandex.ru/images/*", "https://yandex.com/images/*", "https://ya.ru/images/*", "http://127.0.0.1/*", "http://localhost/*"], "action": {"default_title": "Yandex Links", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://yandex.ru/images/*", "https://yandex.com/images/*", "https://ya.ru/images/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["config.json"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "yandex-links2@local", "data_collection_permissions": {"required": ["none"], "data_types": [], "purposes": []}}}}