{"manifest_version": 2, "name": "MOT Mileage Tools", "version": "4.0", "description": "On GOV.UK vehicle pages: charts mileage and defects across MOT history, and estimates road tax (VED) by year and band on the tax & MOT status page. Exports to JSON, CSV or a copy-ready report.", "author": "Dimitrios Bogas", "browser_specific_settings": {"gecko": {"id": "@mot-mileage-tools", "strict_min_version": "68.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.check-mot.service.gov.uk/results*"], "css": ["panel.css"], "js": ["ai-prompt.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://vehicleenquiry.service.gov.uk/VehicleFound*"], "css": ["panel.css"], "js": ["ved-rates.js", "tax.js"], "run_at": "document_idle"}, {"matches": ["https://vehicleenquiry.service.gov.uk/*"], "js": ["autofill.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "MOT Mileage Tools", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab", "storage"]}