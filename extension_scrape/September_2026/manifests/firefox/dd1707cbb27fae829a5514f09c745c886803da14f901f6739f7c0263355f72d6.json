{"manifest_version": 2, "name": "YouTube TimeSaver", "version": "2.0", "description": "Scan YouTube videos automatically by cycling seek positions with configurable intervals, auto-captions, and pause sync.", "author": "Eduardo", "browser_specific_settings": {"gecko": {"id": "yt-timesaver@proyectosdeviernes.com", "data_collection_permissions": {"enabled": false, "required": ["none"]}}}, "icons": {"16": "icons/icon-inactive-16.png", "32": "icons/icon-inactive-32.png", "48": "icons/icon-inactive-48.png", "96": "icons/icon-inactive-96.png"}, "browser_action": {"default_icon": {"16": "icons/icon-inactive-16.png", "32": "icons/icon-inactive-32.png", "48": "icons/icon-inactive-48.png"}, "default_popup": "popup/popup.html", "default_title": "YouTube TimeSaver"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"], "persistent": false}, "commands": {"toggle-cycle": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "Start / stop the cycle on the active YouTube tab"}}, "permissions": ["storage", "tabs", "https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"]}