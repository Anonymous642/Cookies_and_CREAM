{"manifest_version": 3, "name": "nosh", "version": "0.4.5", "description": "Automatic ad volume reduction and interaction with YouTube's official Skip button.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "background": {"scripts": ["background/index.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["content/index.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/index.html", "default_title": "nosh", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "nosh@piterfly", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}