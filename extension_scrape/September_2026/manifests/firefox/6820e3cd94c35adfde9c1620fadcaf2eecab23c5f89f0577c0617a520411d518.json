{"manifest_version": 3, "name": "Odoo Man Domain Builder for Firefox", "short_name": "Odoo Domain", "version": "1.0.2", "description": "Firefox WebExtension for building Odoo domains with Python, XML, JavaScript, and JSON output formats.", "author": "Odoo Man", "homepage_url": "https://odooman.odoo.com/", "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Odoo Domain Builder", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "omg-domain-builder@odooman.odoo.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}