{"manifest_version": 3, "name": "Ext-SiFu", "version": "2.0.1", "description": "Advanced cookie extractor for all major platforms. Export in JSON, Netscape, Header String, cURL and more. By SIFAT | GitHub: Ewr-sifu", "author": "SIFAT", "homepage_url": "https://github.com/Ewr-sifu", "browser_specific_settings": {"gecko": {"id": "ext-sifu@ewr-sifu", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Ext-SiFu \u2014 Cookie Extractor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["cookies", "activeTab", "tabs", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}