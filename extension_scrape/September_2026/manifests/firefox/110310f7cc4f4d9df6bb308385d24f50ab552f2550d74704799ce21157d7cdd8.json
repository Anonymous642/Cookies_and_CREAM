{"manifest_version": 2, "name": "Perplexity Lag Fix", "version": "1.0.0", "description": "Reduces lag in long Perplexity AI threads by hiding older messages. Keep only the N most recent Q&A pairs visible.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.perplexity.ai/*", "*://perplexity.ai/*"], "css": ["css/lagfix.css"], "js": ["js/lagfix.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon-48.svg"}, "default_popup": "popup.html", "default_title": "Perplexity Lag Fix"}, "browser_specific_settings": {"gecko": {"id": "perplexity-lag-fix@youremail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}