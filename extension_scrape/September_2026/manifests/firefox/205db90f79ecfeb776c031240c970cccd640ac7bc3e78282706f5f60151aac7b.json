{"manifest_version": 3, "name": "ChromaShift \u2013 Eye Comfort Reading Mode", "short_name": "ChromaShift", "version": "1.0", "description": "Reduce eye strain with optimized warm reading filters, mouse focus guides, typography spacing overrides, and circadian scheduler.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "ChromaShift", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "commands": {"toggle_enabled": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle ChromaShift On/Off"}, "decrease_brightness": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Decrease Screen Brightness"}, "increase_brightness": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Increase Screen Brightness"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "chromashift-eyecomfort@developer.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}