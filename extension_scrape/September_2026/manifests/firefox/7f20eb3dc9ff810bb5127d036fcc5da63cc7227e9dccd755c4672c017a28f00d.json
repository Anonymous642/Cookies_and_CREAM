{"manifest_version": 3, "name": "Content Chef", "version": "1.0.0", "description": "Label and manage automated digital content streams.", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.ytimg.com/*", "https://*.youtube.com/*", "https://curation-layer-gateway.fluryjanis.workers.dev/*"], "browser_specific_settings": {"gecko": {"id": "clean-web-curation@fluryjanis.dev", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["sandbox.html", "sandbox.js", "ai_worker.js", "ort.min.js", "ort-wasm.wasm", "ort-wasm-simd.wasm", "ort-wasm-threaded.wasm", "ort-wasm-simd-threaded.wasm", "ort-wasm-simd-threaded.jsep.mjs", "ort-wasm-simd-threaded.jsep.wasm", "model_v4.onnx", "model_v4.onnx.data"], "matches": ["*://*.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}]}