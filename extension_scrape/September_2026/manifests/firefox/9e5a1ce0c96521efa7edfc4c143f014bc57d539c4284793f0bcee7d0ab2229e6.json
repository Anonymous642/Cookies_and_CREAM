{"manifest_version": 3, "name": "Search Geo & Settings Tuner", "description": "Customise Google search by setting location, language, currency and other parameters via a handy popup. Compatible with Firefox desktop and Android.", "version": "1.0.0", "author": "sham.si", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {"default_title": "Search Tuner", "default_popup": "popup.html"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["*://*.google.com/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["https://*.google.com/search*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "searchtuner@sham.si", "data_collection_permissions": {"required": ["none"]}}}}