{"manifest_version": 3, "name": "Doxos", "version": "0.2.0", "description": "Highlight a line on any page and make a Doxos video about it.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Doxos", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["contextMenus", "activeTab", "scripting", "storage", "alarms", "notifications"], "optional_permissions": ["<all_urls>"], "host_permissions": ["https://api.doxos.ai/*"], "content_scripts": [{"matches": ["https://doxos.ai/connect*"], "js": ["handoff.js"], "run_at": "document_start"}], "commands": {"clip": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Make a video from the highlighted text"}}, "browser_specific_settings": {"gecko": {"id": "extension@doxos.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}