{"manifest_version": 2, "name": "Magpie - Youtube summarizer", "description": "Summarize youtube videos at the click of a button.", "version": "1.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "tabs", "downloads", "scripting", "storage", "https://*.magpie.ink/*", "*://*.youtube.com/*"], "externally_connectable": {"matches": ["https://*.magpie.ink/*"]}, "web_accessible_resources": ["fonts/*.woff2", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "hello@magpie.ink", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "browser_action": {"default_title": "Magpie", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}