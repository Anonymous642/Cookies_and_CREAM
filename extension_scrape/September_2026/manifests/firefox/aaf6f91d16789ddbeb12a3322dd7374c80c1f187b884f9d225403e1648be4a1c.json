{"manifest_version": 3, "name": "Tumblr Favourites!", "version": "1.0.0", "description": "Save Tumblr dashboard posts to a private local favourites list.", "permissions": ["storage"], "host_permissions": ["https://www.tumblr.com/*", "https://*.tumblr.com/*"], "browser_specific_settings": {"gecko": {"id": "tumblr-favourites@example.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.tumblr.com/*", "https://*.tumblr.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "Tumblr Favourites", "default_popup": "popup.html"}}