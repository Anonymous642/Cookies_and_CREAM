{"manifest_version": 3, "name": "CoolVPN Proxy", "version": "1.0.0", "description": "One-click VPN & proxy switcher with Kill Switch, ad blocking, and zero-logs privacy.", "action": {"default_popup": "index.html", "default_title": "CoolVPN Proxy"}, "browser_specific_settings": {"gecko": {"id": "support@coolvpn.app", "strict_min_version": "91.1.0"}}, "permissions": ["proxy", "storage", "webRequest", "tabs", "webRequestAuthProvider", "webRequestBlocking", "privacy"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["icons/*.png"], "use_dynamic_url": false}], "incognito": "split"}