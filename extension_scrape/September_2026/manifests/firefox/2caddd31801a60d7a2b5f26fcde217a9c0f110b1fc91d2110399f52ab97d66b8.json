{"manifest_version": 2, "name": "LowTube - YouTube View Filter", "version": "1.0", "description": "Filters out low-view videos from YouTube recommendations", "browser_specific_settings": {"gecko": {"id": "me@numli.net"}}, "permissions": ["storage", "activeTab", "*://*.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}