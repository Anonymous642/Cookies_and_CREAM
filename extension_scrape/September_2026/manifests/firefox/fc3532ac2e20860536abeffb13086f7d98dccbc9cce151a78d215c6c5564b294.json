{"manifest_version": 3, "name": "Revspire Everywhere", "description": "Revspire content search, request workflows, deal rooms, and activity insights with tenant-aware authentication.", "version": "1.1.0", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "tabs", "clipboardWrite"], "host_permissions": ["https://mail.google.com/*", "https://*.revspire.io/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Revspire Everywhere", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "sidebar_action": {"default_title": "Revspire Everywhere", "default_panel": "sidepanel.html"}, "browser_specific_settings": {"gecko": {"id": "revspire-everywhere@revspire.io", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "searchTerms", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}