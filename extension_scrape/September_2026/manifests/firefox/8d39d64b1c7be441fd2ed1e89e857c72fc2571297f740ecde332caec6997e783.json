{"manifest_version": 3, "name": "Nexora AI Client Assistant", "version": "1.1.0", "description": "Privacy-first Firefox sidebar assistant for translating, understanding, summarizing and drafting client replies.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://discord.com/*", "https://*.discord.com/*"], "action": {"default_title": "Open Nexora", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "sidebar_action": {"default_title": "Nexora", "default_panel": "sidebar.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://discord.com/*", "https://*.discord.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@nexora-client-assistant", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}