{"manifest_version": 3, "name": "Web Clipper - Save Text and Snippet Manager", "version": "1.0", "description": "Save and organize web content snippets", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["contextMenus", "storage", "activeTab", "downloads", "tabs"], "host_permissions": ["https://tally.so/*"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-48.png", "icons/icon-128.png", "popup/popup.html"], "matches": ["https://tally.so/*"]}], "browser_specific_settings": {"gecko": {"id": "Web-clipper@example.com", "strict_min_version": "109.0"}}}