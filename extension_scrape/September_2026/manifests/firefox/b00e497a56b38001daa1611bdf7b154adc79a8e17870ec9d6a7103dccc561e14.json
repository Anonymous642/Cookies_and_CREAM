{"manifest_version": 2, "name": "Link Fishing", "version": "1.0", "description": "Turn links on a page into swimming fish; cast a line to catch links matching a target (e.g., containing 'about').", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Link Fishing", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "linkfishing@example.com"}}}