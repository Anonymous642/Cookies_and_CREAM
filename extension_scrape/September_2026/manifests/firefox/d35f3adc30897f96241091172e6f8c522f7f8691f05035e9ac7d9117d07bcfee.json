{"manifest_version": 2, "name": "Mostrar/Ocultar Inputs", "version": "1.0.0", "description": "Revela inputs (incluyendo hidden) y muestra id/name; permite ocultarlos luego.", "permissions": ["activeTab", "tabs"], "browser_action": {"default_title": "Mostrar/Ocultar Inputs", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@mostrar-ocultar-inputs", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}