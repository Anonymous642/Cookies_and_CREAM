{"manifest_version": 3, "name": "Pluck", "short_name": "Pluck", "description": "Finds and adds your visible Amex Offers \u2014 one tap, done. Runs locally, no login automation, no data collection.", "version": "0.1.10", "homepage_url": "https://pluck.stanislav.black/", "action": {"default_popup": "popup.html", "default_title": "Pluck", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.americanexpress.com/*", "https://*.aexp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://*.americanexpress.com/*", "https://*.aexp.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://img.buymeacoffee.com"}, "browser_specific_settings": {"gecko": {"id": "pluck@stanislav.black", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}