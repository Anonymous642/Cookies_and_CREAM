{"manifest_version": 3, "name": "Robin \u2014 Your Caped Crusader's Helper", "version": "1.0.3", "description": "Robin examines the page, writes scripts, runs them, and saves your actions. Batman asks \u2014 Robin delivers.", "permissions": ["activeTab", "storage", "scripting", "tabs", "clipboardWrite", "clipboardRead"], "optional_permissions": ["userScripts"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "action": {"default_title": "Summon Robin", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_title": "Robin", "default_panel": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content-script.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "robin@batcave.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "personalCommunications", "websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}