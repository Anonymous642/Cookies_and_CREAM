{"manifest_version": 2, "name": "Filter Now", "description": "An offline tool help user to add CSS based filter to image and save it.", "version": "0.0.4", "icons": {"32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "200": "icon/200.png"}, "permissions": ["storage", "tabs"], "homepage_url": "https://github.com/ntnyq/filter-now", "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';", "commands": {"openOptionsPage": {"suggested_key": {"default": "Alt+O"}, "description": "Open the Options page"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "%VITE_APP_TITLE%", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "{f968fd77-f0d4-4a5c-8dca-6ba87a6b060b}"}}}