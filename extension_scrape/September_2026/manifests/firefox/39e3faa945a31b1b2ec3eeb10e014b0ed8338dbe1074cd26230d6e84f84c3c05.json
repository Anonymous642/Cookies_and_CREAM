{"manifest_version": 2, "name": "DOM Snapshot Saver", "version": "1.3", "description": "Capture and save the current webpage DOM as an HTML snapshot.", "permissions": ["activeTab", "tabs", "downloads", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "DOM Snapshot Saver", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@DOM-Snapshot-Saver", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}