{"manifest_version": 3, "name": "Etoiles - Twitch & YouTube Notifications", "version": "1.6", "description": "Recevez des notifications lorsque Etoiles est en ligne sur Twitch ou qu'une nouvelle vid\u00e9o YouTube est publi\u00e9e.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://api.twitch.tv/*", "https://www.googleapis.com/*", "https://www.youtube.com/*"], "author": "AlexisAMZ", "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["config.js"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/photos/on16.png", "48": "images/photos/on48.png", "128": "images/photos/on128.png"}}, "icons": {"16": "images/photos/on16.png", "48": "images/photos/on48.png", "128": "images/photos/on128.png"}, "browser_specific_settings": {"gecko": {"id": "etoiles_notifications@example.com"}}}