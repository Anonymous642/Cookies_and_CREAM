{"manifest_version": 3, "name": "Gjallarhorn Ex", "version": "0.6", "description": "Implements several integrations between Youtube, Soundcloud, and Chariot's API.", "browser_specific_settings": {"gecko": {"id": "chariot-ex@setsu.party", "data_collection_permissions": {"user_data": "none", "usage_data": "none", "required": ["none"]}}}, "options_ui": {"page": "pages/options/index.html", "browser_style": true}, "permissions": ["storage", "tabs", "activeTab", "scripting", "contextMenus", "notifications"], "host_permissions": ["https://chariotapi.setsu.party/*"], "background": {"scripts": ["scripts/background/main.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.gjallarhorncontrol.setsu.party/*", "*://*.youtube.com/*", "*://*.soundcloud.com/*"], "js": ["scripts/content/main.js"], "css": ["assets/main.css"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "180": "icons/icon-180.png", "192": "icons/icon-192.png", "512": "icons/icon-512.png"}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*", "popup/*", "scripts/**/*"], "matches": ["*://*.gjallarhorncontrol.setsu.party/*", "*://*.youtube.com/*", "*://*.soundcloud.com/*"]}]}