{"manifest_version": 3, "name": "cloqra", "version": "3.0.0", "description": "Protect sensitive information before it reaches AI tools. Local processing only.", "browser_specific_settings": {"gecko": {"id": "cloqra@cloqra.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://*.copilot.microsoft.com/*", "https://*.cursor.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}, "action": {"default_title": "cloqra", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png"}}, "options_page": "options.html", "commands": {"toggle-protection": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle cloqra protection"}, "pause-protection": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pause cloqra temporarily"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://*.copilot.microsoft.com/*", "https://*.cursor.com/*"], "js": ["settings.js", "browser-rules.js", "context-event.js", "detector.js", "sanitizer.js", "editors.js", "content.js"], "run_at": "document_start", "all_frames": false}]}