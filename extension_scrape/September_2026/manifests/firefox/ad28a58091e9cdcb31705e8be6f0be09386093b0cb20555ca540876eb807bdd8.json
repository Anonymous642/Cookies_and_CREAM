{"manifest_version": 3, "name": "Visual Bug Tracker", "version": "1.0.7", "description": "Pin visual bugs on any website and report them.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon.png"}, "permissions": ["storage", "activeTab", "tabs", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "contentScript.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["pin-icon.png", "closebug-pin-icon.png", "page-styles.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "support@teaming.rocks", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}