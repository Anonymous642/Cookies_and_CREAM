{"manifest_version": 3, "name": "A1 Reverse Image Search", "short_name": "A1 Search", "version": "0.1.0", "description": "Search images and selected text from the right-click menu using trusted visual and web search engines.", "homepage_url": "https://a1local.com.au/extensions/reverse-image-search-menu/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "A1 Reverse Image Search", "default_popup": "popup.html"}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "options_page": "options.html", "permissions": ["contextMenus", "storage"], "browser_specific_settings": {"gecko": {"id": "reverse-image-search-menu@a1local.com.au", "data_collection_permissions": {"required": ["searchTerms", "websiteContent"]}, "strict_min_version": "142.0"}}}