{"manifest_version": 3, "name": "Archive Today Shortcut", "version": "2.0.0", "description": "Quickly archive any webpage with Archive.today, Wayback Machine, and more. One-click, keyboard shortcut, or right-click to save pages for posterity.", "homepage_url": "https://github.com/eterradas/open-archived", "permissions": ["activeTab", "contextMenus", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Archive This Page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"archive-page": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Archive the current page"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Archive the current page (toolbar button)"}}, "browser_specific_settings": {"gecko": {"id": "archive-today-shortcut@eterradas.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}