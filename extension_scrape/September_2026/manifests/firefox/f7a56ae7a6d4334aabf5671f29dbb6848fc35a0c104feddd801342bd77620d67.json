{"manifest_version": 3, "name": "BooP Remote", "version": "1.0.7", "description": "Control Chrome from your phone and run AI browser automation. Remote trackpad, media, tabs, keyboard. Requires mobile app.", "permissions": ["tabs", "activeTab", "storage", "scripting", "alarms", "clipboardRead", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Open BooP Sidebar"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": "icons/icon48.png", "default_title": "BooP Remote"}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "boop-remote@orcawhisperer.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}