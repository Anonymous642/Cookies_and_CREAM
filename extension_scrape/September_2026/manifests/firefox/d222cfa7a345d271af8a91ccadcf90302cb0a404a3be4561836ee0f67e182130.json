{"manifest_version": 3, "name": "Mr. Block", "version": "1.1.1", "description": "Remove rounded corners from the web.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Mr. Block"}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["src/content/index.js"]}], "permissions": ["storage", "activeTab", "tabs", "cookies", "downloads", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "commands": {"toggle-site": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Toggle Mr. Block on current site"}}, "browser_specific_settings": {"gecko": {"id": "mrblock@example.com", "strict_min_version": "140.0", "gecko_android": {"strict_min_version": "142.0"}}}}