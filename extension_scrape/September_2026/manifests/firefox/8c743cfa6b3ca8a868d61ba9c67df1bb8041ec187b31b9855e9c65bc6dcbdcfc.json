{"manifest_version": 2, "name": "Environment Switcher", "version": "1.0.1", "description": "Switch between different environments while preserving URL paths", "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Switch Environment", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"toggle-environment": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open environment switcher"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "environment-switcher@exobytelabs.com", "strict_min_version": "79.0"}}}