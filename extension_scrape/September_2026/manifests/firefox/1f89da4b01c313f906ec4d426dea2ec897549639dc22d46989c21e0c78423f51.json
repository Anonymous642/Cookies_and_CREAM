{"manifest_version": 3, "name": "RPC Phishing Scanner", "version": "1.0.1", "description": "Scan every page you open against the rule set before showing you its content.", "browser_specific_settings": {"gecko": {"id": "rpc-phishing-scanner@RuiTheSaltyFish", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity"]}}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["storage", "tabs", "webNavigation", "webRequest", "scripting"], "web_accessible_resources": [{"resources": ["block.html", "block.js"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "RPC Phishing Scanner", "default_icon": "icons/icon.svg"}, "options_page": "options.html"}