{"manifest_version": 2, "name": "History Waver for Pixiv", "version": "1.5.1", "description": "Encrypted Pixiv history sync with a true desktop dashboard on PC and a touch-first Android layout in one Firefox extension.", "icons": {"48": "icons/48.png", "96": "icons/96.png"}, "browser_specific_settings": {"gecko": {"id": "history-waver-for-pixiv@aquaticwaves", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "unlimitedStorage", "alarms", "*://*.pixiv.net/*"], "optional_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background/crypto.js", "background/db.js", "background/cloud-account.js", "background/sync-providers.js", "background/background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.pixiv.net/*/artworks/*", "*://*.pixiv.net/artworks/*", "*://*.pixiv.net/member_illust.php*", "*://*.pixiv.net/novel/show.php*", "*://*.pixiv.net/*/novel/show.php*"], "js": ["content/detect.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.pixiv.net/history.php"], "js": ["content/unlock-history.js"], "run_at": "document_start"}], "browser_action": {"default_title": "History Waver for Pixiv", "default_popup": "ui/popup.html", "default_icon": {"48": "icons/48.png"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}}