{"manifest_version": 3, "name": "Home by si4k", "version": "2.2.0", "description": "A beautiful, high-performance, and feature-rich new tab override extension for Mozilla Firefox.", "author": "Akshit Kamboj (si4k)", "homepage_url": "https://github.com/akshitKamboj13/minimal-homepage", "browser_specific_settings": {"gecko": {"id": "home-by-si4k@akshitkamboj.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "chrome_url_overrides": {"newtab": "src/index.html"}, "background": {"scripts": ["src/background.js"]}, "permissions": ["bookmarks", "search", "declarativeNetRequest", "contextMenus", "activeTab", "tabs"], "host_permissions": ["*://suggestqueries.google.com/*", "*://*.yandex.com/*", "*://*.yandex.ru/*", "*://*.bing.com/*"], "sandbox": {"pages": ["src/sandbox.html"]}, "web_accessible_resources": [{"resources": ["app-bootstrapper.js", "src/app-bootstrapper.js", "src/js/app-bootstrapper.js"], "matches": ["<all_urls>"]}]}