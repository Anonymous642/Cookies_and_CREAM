{"manifest_version": 3, "name": "BP Cookies Manager", "version": "1.17", "description": "Create, edit, import, export, and delete cookies for the current tab.", "permissions": ["cookies", "tabs", "storage", "clipboardWrite"], "host_permissions": ["<all_urls>"], "action": {"default_title": "BP Cookies Manager", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-notifications.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["http://*/*", "https://*/*"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "bp-cookies-manager@buyproxies.org", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}