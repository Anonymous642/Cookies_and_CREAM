{"manifest_version": 3, "name": "Vencord Web", "version": "1.15.8", "description": "The cutest Discord mod now in your browser", "author": "Vendicated", "homepage_url": "https://github.com/Vendicated/Vencord", "browser_specific_settings": {"gecko": {"id": "vencordweb@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"96": "icon.png"}, "host_permissions": ["*://*.discord.com/*", "https://raw.githubusercontent.com/*"], "permissions": ["declarativeNetRequest"], "content_scripts": [{"run_at": "document_start", "matches": ["*://*.discord.com/*"], "js": ["content.js"], "all_frames": true, "world": "ISOLATED"}, {"run_at": "document_start", "matches": ["*://*.discord.com/*"], "js": ["dist/Vencord.js"], "all_frames": true, "world": "MAIN"}], "web_accessible_resources": [{"resources": ["dist/*", "vendor/*"], "matches": ["*://*.discord.com/*"]}], "declarative_net_request": {"rule_resources": [{"id": "modifyResponseHeaders", "enabled": true, "path": "modifyResponseHeaders.json"}]}}