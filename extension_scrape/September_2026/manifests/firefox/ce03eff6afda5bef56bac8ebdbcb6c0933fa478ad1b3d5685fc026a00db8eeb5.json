{"manifest_version": 2, "name": "Finch", "description": "Hear your browser \u2014 short audio cues for tabs, downloads, bookmarks, and navigation. 65 events, per-event controls, zero tracking.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/akash07k/finch", "minimum_chrome_version": "140", "permissions": ["tabs", "bookmarks", "downloads", "webNavigation", "storage", "notifications", "idle"], "optional_permissions": ["management", "cookies", "history"], "commands": {"toggle-mute": {"suggested_key": {"default": "Alt+M"}, "description": "Toggle sound mute on/off"}, "toggle-mute-when-blurred": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Toggle muting sounds when browser is unfocused"}, "open-options": {"suggested_key": {"default": "Alt+I"}, "description": "Open Finch options page"}}, "browser_specific_settings": {"gecko": {"id": "{e5b3402e-127a-4eff-8529-77c5d34363f6}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "techdata_collected": false, "interactiondata_collected": false}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Finch - Quick Controls", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}