{"manifest_version": 3, "name": "YouTube Shorts Blocker & Remover", "version": "1.0.1", "description": "Completely removes YouTube Shorts shelves, sidebar links, search carousels, and redirects Shorts URLs to the standard video player.", "browser_specific_settings": {"gecko": {"id": "yt-shorts-blocker@emplaz.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "YouTube Shorts Blocker"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content/content.css"], "js": ["content/content.js"], "run_at": "document_start"}], "background": {"scripts": ["background/background.js"]}}