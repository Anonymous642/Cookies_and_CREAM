{"manifest_version": 3, "name": "Tab Search Xtra", "version": "1.0.0", "author": "yetbad", "homepage_url": "https://yetbad.com", "description": "Fuzzy tab search, media controls, recently closed tabs, Firefox theme support, and per-tab audio effects including volume, mono, EQ, and compression. Customizable to your needs.", "icons": {"48": "assets/icons/icon.svg", "96": "assets/icons/icon.svg"}, "permissions": ["tabs", "sessions", "history", "theme", "scripting", "storage", "browsingData"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": "assets/icons/icon.svg", "default_title": "Tab Search"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Tab Search"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tab-search@yetbad.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}