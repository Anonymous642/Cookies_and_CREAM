{"manifest_version": 3, "name": "Islamic Dhikr Reminder", "version": "3.1", "description": "Stay connected with your faith through automated Dhikr notifications. | \u062a\u0630\u0643\u064a\u0631 \u0628\u0627\u0644\u0623\u0630\u0643\u0627\u0631 \u0648\u0627\u0644\u0623\u062f\u0639\u064a\u0629 \u0628\u0634\u0643\u0644 \u0622\u0644\u064a \u0648\u0645\u0646\u062a\u0638\u0645.", "permissions": ["alarms", "storage", "tabs", "activeTab"], "browser_specific_settings": {"gecko": {"id": "dhikr-reminder@mugiwara", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "icons": {"128": "icon.png"}, "background": {"scripts": ["adhkar.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["alert.mp3", "icon.png"], "matches": ["<all_urls>"]}]}