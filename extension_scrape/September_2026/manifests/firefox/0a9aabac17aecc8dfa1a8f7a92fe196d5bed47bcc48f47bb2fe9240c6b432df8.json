{"manifest_version": 3, "name": "WebCron", "version": "2.0.0", "description": "Local-only browser scheduler for the open web.", "permissions": ["alarms", "storage", "tabs", "scripting", "downloads", "bookmarks"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "options_page": "index.html", "action": {"default_title": "WebCron", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"strict_min_version": "140.0", "id": "webcron@openweb.local", "data_collection_permissions": {"required": ["none"], "optional": ["websiteActivity", "websiteContent", "searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}}