{"manifest_version": 2, "name": "Page Dimmer", "version": "1.0.0", "description": "Toggle a safe, page-level dark overlay on web pages to reduce glare. Requires only activeTab and storage permissions.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": "icons/icon48.png", "default_title": "Toggle Page Dim Mode", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "storage"], "options_ui": {"page": "options.html", "open_in_tab": false}, "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "pagedimmer@example.com"}}}