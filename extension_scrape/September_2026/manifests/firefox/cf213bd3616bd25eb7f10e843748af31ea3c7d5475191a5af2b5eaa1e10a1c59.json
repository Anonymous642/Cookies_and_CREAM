{"manifest_version": 2, "name": "youtubenoads-extension", "description": "Firefox browser extension for ad-free YouTube video playback via YoutubeNoAds", "version": "1.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "webRequest", "webRequestBlocking", "*://*.youtube.com/*"], "browser_action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "default_area": "navbar", "default_title": "YoutubeNoAds", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "youtubenoads@ynoadsofficial.gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}