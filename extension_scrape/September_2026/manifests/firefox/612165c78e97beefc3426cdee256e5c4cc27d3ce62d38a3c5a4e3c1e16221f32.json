{"manifest_version": 2, "name": "GS Page Reader", "version": "1.0.0", "description": "Reads DOM text from v-CA inspection page and sends it to the local Java service for SN extraction. Works exclusively with local v-CA pages and localhost communication. No data is sent to external servers.", "homepage_url": "https://github.com/vmax/gs-plugin", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "{2be9e373-f984-4e48-8ae6-73214dd3a81b}", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "storage", "http://localhost/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}