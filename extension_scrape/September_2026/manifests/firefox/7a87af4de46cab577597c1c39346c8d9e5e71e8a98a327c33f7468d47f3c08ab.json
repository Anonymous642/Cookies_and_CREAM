{"manifest_version": 2, "name": "Trimi Link Shortener", "description": "Shorten the current page, a link, or selected URL with Trimi.", "version": "1.0.0", "homepage_url": "https://trimi.me", "browser_specific_settings": {"gecko": {"id": "trimi-link-shortener@trimi.me", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "tabs", "contextMenus", "https://trimi.me/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Shorten link", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}