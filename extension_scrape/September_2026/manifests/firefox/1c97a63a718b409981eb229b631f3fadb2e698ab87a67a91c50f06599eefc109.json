{"manifest_version": 2, "name": "DateSleuth", "version": "1.1", "description": "Advanced date extraction tool for recall impact analysis", "author": "sotosade", "permissions": ["activeTab", "<all_urls>", "scripting"], "browser_specific_settings": {"gecko": {"id": "datesleuth@sotosade.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_icon": "icons/icon48.png", "default_title": "DateSleuth", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.cpsc.gov/Recalls/*", "https://www.fda.gov/*", "https://www.accessdata.fda.gov/*", "https://www.nhtsa.gov/*", "https://static.nhtsa.gov/*", "https://www.fsis.usda.gov/*", "https://recalls-rappels.canada.ca/*", "https://wwwapps.tc.gc.ca/*", "*://*/*.pdf", "*://*/*.pdf*", "file://*/*.pdf"], "js": ["content-script.js"], "run_at": "document_end", "all_frames": true}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}