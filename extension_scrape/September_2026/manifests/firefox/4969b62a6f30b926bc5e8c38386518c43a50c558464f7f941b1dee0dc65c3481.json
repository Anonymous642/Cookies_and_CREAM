{"manifest_version": 3, "name": "Pinport - Bookmark Manager", "description": "Save and find your bookmarks with Pinport. Subscription required; 7-day free trial for new accounts.", "version": "6.1.4", "homepage_url": "https://pinport.app", "author": "Pinport", "permissions": ["activeTab", "contextMenus", "storage"], "optional_permissions": ["tabs", "bookmarks", "clipboardRead"], "host_permissions": ["https://pinport.app/*"], "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_title": "Open Pinport", "default_icon": {"16": "icon.png", "32": "icon.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://pinport.app/*"], "js": ["connection-content.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://pinport.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src 'none'"}, "omnibox": {"keyword": "p"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P"}}}, "sidebar_action": {"default_title": "Pinport", "default_panel": "panel.html", "default_icon": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "firefox-addon@bookmarkmanager.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "searchTerms", "websiteContent"]}}}}