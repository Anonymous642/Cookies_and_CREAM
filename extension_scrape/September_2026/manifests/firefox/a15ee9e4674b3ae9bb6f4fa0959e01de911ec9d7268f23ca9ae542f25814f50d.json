{"manifest_version": 3, "name": "BrowserCord", "description": "Updates your Discord status based on what you are watching or browsing.", "version": "1.1.0", "permissions": ["tabs", "storage"], "host_permissions": ["http://localhost:3000/*", "<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "@browsercord", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}}}