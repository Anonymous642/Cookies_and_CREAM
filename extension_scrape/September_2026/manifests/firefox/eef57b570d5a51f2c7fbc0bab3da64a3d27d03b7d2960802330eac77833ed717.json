{"manifest_version": 3, "name": "Avertune", "version": "1.1.0", "description": "Communication intelligence, without switching tabs.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["cookies", "storage"], "host_permissions": ["https://avertuneserver.xyz/*", "http://localhost:3001/*"], "externally_connectable": {"matches": ["https://avertune.com/*", "https://www.avertune.com/*", "http://localhost:3001/*", "http://localhost:5500/*"]}, "browser_specific_settings": {"gecko": {"id": "extension@avertune.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}