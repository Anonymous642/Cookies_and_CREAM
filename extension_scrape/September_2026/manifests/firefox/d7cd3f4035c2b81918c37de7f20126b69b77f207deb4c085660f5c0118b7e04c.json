{"manifest_version": 3, "name": "Thread Styler", "version": "1.0.0", "description": "Select any text in the Threads composer and instantly convert it to monospace, italic, small caps, bold italic, or sans-serif bold using Unicode \u2014 no markup, just styled text that posts natively.", "browser_specific_settings": {"gecko": {"id": "thread-styler@tekphreak.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Thread Styler"}, "content_scripts": [{"matches": ["*://*.threads.net/*", "*://*.threads.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_end"}]}