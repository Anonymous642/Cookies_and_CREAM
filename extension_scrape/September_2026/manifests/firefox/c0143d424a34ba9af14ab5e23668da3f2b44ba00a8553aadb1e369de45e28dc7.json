{"manifest_version": 3, "name": "QuickCard - Movies and TV Info", "version": "1.0.0", "description": "QuickCard is a lightweight browser extension that displays information from IMDb, OMDb, TVmaze, and Wikidata for movies, series, episodes, and people.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "QuickCard"}, "permissions": ["storage", "contextMenus", "tabs", "activeTab"], "host_permissions": ["*://v3.sg.media-imdb.com/*", "*://www.imdb.com/*", "*://imdb.com/*", "https://www.omdbapi.com/*", "https://query.wikidata.org/*", "http://*/*", "https://*/*"], "background": {"service_worker": "background/service-worker.js", "scripts": ["background/core.js", "background/translate.js", "background/wikidata-links.js", "background/movies-data.js", "background.js"]}, "web_accessible_resources": [{"resources": ["icons/icon-48.png", "icons/sites/*.svg"], "matches": ["http://*/*", "https://*/*"]}], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["*://imdb.com/*", "*://www.imdb.com/*", "*://*.imdb.com/*"], "js": ["content/core.js", "content/translate.js", "content/disambiguation.js", "content/movies-pack.js", "content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "imdb-quickcard@kargi.top", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}