{"manifest_version": 2, "name": "Contrastify", "version": "1.0.0", "description": "Adjust page contrast with a simple slider \u2014 0 (flat grey) to 100 (default) to 200 (maximum).", "author": "", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_popup": "popup.html", "default_title": "Contrastify", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "contrastify@idonthaveone.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}