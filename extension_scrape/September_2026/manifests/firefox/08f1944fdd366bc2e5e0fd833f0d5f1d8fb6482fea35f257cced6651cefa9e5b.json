{"manifest_version": 2, "name": "Bookmark Popup", "version": "1.0.0", "description": "A bigger, more capable alternative to the address-bar bookmark star: a collapsible folder tree with search, tags, and pinned folders.", "icons": {"48": "icons/star.svg", "96": "icons/star.svg"}, "permissions": ["bookmarks", "storage", "tabs", "activeTab"], "page_action": {"default_icon": {"16": "icons/star.svg", "32": "icons/star.svg"}, "default_title": "Bookmark this page", "default_popup": "popup/popup.html", "show_matches": ["<all_urls>"]}, "commands": {"_execute_page_action": {"description": "Open the bookmark popup"}}, "browser_specific_settings": {"gecko": {"id": "bookmark-popup@dermeck.mozmail.com", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}