{"manifest_version": 2, "name": "TF Download Collector", "version": "1.0.36", "description": "Intercepts browser downloads and sends them to TF Download Collector Desktop Application.", "permissions": ["<all_urls>", "contextMenus", "cookies", "downloads", "http://127.0.0.1/*", "http://localhost/*", "nativeMessaging", "notifications", "storage", "tabs", "webRequest"], "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "TFDM - Link capture enabled", "default_popup": "popup.html"}, "icons": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "tfdm@tickfusion.com", "data_collection_permissions": {"required": ["websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["tfdm_toast.js", "tfdm_overlay.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": ["tfdm_page_hook.js"]}