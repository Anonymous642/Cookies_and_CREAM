{"manifest_version": 2, "name": "Cozy-Mod for Blooket", "version": "1.2.5", "description": "A Blooket-only Firefox add-on for personal UI tools, scripts, and coding help.", "permissions": ["*://*/*", "activeTab", "storage", "tabs", "windows"], "browser_action": {"default_title": "Cozy Hub", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.blooket.com/*", "*://blooket.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "cozymodder@example.com"}}}