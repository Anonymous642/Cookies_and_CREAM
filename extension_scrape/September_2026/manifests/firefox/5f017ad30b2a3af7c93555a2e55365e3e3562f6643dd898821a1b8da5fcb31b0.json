{"manifest_version": 2, "name": "Snippet Saver", "version": "1.0", "description": "L\u01b0u \u0111o\u1ea1n text b\u1ea1n b\u00f4i \u0111en th\u00e0nh danh s\u00e1ch ghi ch\u00fa nh\u1ecf, xem v\u00e0 copy l\u1ea1i b\u1ea5t c\u1ee9 l\u00fac n\u00e0o. Kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u.", "permissions": ["contextMenus", "storage", "activeTab", "notifications", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Snippet Saver", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@snippet-saver", "data_collection_permissions": {"required": ["none"]}}}}