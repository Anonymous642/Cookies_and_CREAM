{"manifest_version": 3, "name": "SG Ads Blocker", "short_name": "SG Ad Blocker", "version": "1.1.1", "description": "SG Ads Blocker by SG Gaming LLC blocks common YouTube ad requests, skips detectable player ads, and hides promotional placements.", "author": "SG Gaming LLC", "icons": {"16": "icons/sg-ads-blocker.svg", "32": "icons/sg-ads-blocker.svg", "48": "icons/sg-ads-blocker.svg", "96": "icons/sg-ads-blocker.svg", "128": "icons/sg-ads-blocker.svg"}, "permissions": ["storage", "activeTab", "tabs", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.doubleclick.net/*", "*://*.googlesyndication.com/*", "*://*.googleadservices.com/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "action": {"default_title": "SG Ads Blocker", "default_popup": "popup.html", "default_icon": "icons/sg-ads-blocker.svg"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "youtube_ad_requests", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "sg-ads-blocker@sggamingllc.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}