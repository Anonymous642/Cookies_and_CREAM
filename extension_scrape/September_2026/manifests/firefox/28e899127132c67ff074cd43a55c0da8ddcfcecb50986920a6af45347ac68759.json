{"manifest_version": 3, "name": "PhishEye - Anti Phishing", "version": "1.0.0", "description": "Real-time anti-phishing protection. PhishEye scans every site you visit against the urlscans.com threat-intelligence engine and warns you before you hand over a password.", "author": "PhishEye", "homepage_url": "https://phisheye.com", "browser_specific_settings": {"gecko": {"id": "anti-phishing@phisheye.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["activeTab", "tabs", "storage"], "host_permissions": ["https://urlscans.com/*", "https://phisheye.com/*"], "background": {"scripts": ["lib/scan.js", "background.js"]}, "action": {"default_title": "PhishEye - Anti Phishing", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon.svg", "128": "icons/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}