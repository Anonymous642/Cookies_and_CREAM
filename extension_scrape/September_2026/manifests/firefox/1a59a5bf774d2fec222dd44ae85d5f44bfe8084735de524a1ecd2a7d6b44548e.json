{"name": "Antibiotics Highlighter", "description": "Highlight antibiotic names", "version": "1.0", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "antibiotic-highlighter@blackomodo.com"}}, "icons": {"16": "images/icon_16x.png", "32": "images/icon_32x.png", "64": "images/icon_64x.png", "128": "images/icon_128x.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.js"], "css": ["dist/styles/highlighter.css"], "run_at": "document_idle"}], "background": {"scripts": ["dist/background.js"]}, "permissions": ["storage"], "web_accessible_resources": [{"resources": ["src/data/antibiotics.json"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "Toggle Antibiotic Highlighting", "default_icon": {"16": "images/icon_16x.png", "32": "images/icon_32x.png"}}}