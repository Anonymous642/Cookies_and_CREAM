{"manifest_version": 3, "name": "Instagram Video Controller", "version": "1.0.0", "description": "Adds professional time and speed sliders to Instagram videos.", "browser_specific_settings": {"gecko": {"id": "ig-video-controls-slider@myextension.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon48.png"}, "host_permissions": ["https://*.instagram.com/*"], "content_scripts": [{"matches": ["https://*.instagram.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}