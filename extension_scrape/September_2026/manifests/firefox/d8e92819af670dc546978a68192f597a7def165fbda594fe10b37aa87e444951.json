{"manifest_version": 2, "name": "Page-Palette Extractor Mini", "version": "1.0.0", "description": "Extract a small color palette (5\u20137 colors) from the current page and export as a PNG.", "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_title": "Page Palette", "default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pagepalette@example.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}