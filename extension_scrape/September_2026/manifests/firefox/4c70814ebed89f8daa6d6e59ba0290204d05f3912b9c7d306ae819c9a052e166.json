{"manifest_version": 2, "name": "Recipe Clipper", "description": "Save the recipe you are viewing straight to your Notion cookbook \u2014 in one click.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "identity", "contextMenus", "notifications"], "browser_specific_settings": {"gecko": {"id": "recipe-clipper@recipe-to-notion", "data_collection_permissions": {"required": ["websiteContent"]}}}, "commands": {"save-recipe": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save the current page to Notion"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Recipe Clipper", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}