{"manifest_version": 2, "name": "Discord Sidebar Toggle", "version": "2.1.0", "description": "Toggle Discord's Sidebar with a button or shortcut.", "icons": {"16": "logo/tgb_logo_16.png", "32": "logo/tgb_logo_32.png", "48": "logo/tgb_logo_48.png", "96": "logo/tgb_logo_96.png", "128": "logo/tgb_logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "discord-sidebar-toggle@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "background": {"scripts": ["./src/background.js"]}, "content_scripts": [{"matches": ["*://*.discord.com/*"], "js": ["./src/elementFinder.js", "./src/uiManager.js", "./src/stateManager.js", "./src/content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle Discord sidebar visibility"}}}