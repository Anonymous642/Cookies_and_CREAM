{"manifest_version": 3, "name": "Card Codex: Card Scanner & Price Checker", "short_name": "Card Codex", "version": "0.2.0", "description": "Drag a box over any Pokemon card photo to identify it and see its price.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://cardcodex.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "scanner@card-codex.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Card Codex \u2014 drag a box over a card to scan it", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["panel.html"], "matches": ["<all_urls>"]}]}