{"manifest_version": 2, "name": "MoodWall", "version": "1.0.0", "description": "T\u1ef1 \u0111\u1ed5i m\u00e0u \u1ea3nh n\u1ec1n tab m\u1edbi d\u1ef1a tr\u00ean m\u00e0u trung b\u00ecnh trang web.", "permissions": ["tabs", "activeTab", "storage"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "@moodwall2", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}