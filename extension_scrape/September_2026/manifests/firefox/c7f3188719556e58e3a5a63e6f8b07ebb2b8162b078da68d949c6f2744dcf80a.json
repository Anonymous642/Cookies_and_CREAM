{"manifest_version": 2, "name": "Quick AI actions", "version": "1.1.0", "description": "AI actions on selected text via the right-click menu.", "icons": {"128": "icon-128.png"}, "permissions": ["contextMenus", "storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "quick-ai@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}