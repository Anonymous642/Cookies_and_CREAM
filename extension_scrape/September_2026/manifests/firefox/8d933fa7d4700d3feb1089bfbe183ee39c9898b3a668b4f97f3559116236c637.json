{"manifest_version": 3, "name": "Markdown Web Clipper", "version": "0.1.0", "description": "Export selected text or full articles as Markdown files, or send them straight to Obsidian.", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "downloads", "notifications", "clipboardWrite"], "optional_host_permissions": ["http://127.0.0.1/*", "https://127.0.0.1/*", "http://localhost/*", "https://localhost/*"], "background": {"service_worker": "background.js", "scripts": ["lib/settings.js", "lib/markdown.js", "lib/clip.js", "export/file.js", "export/obsidian-uri.js", "export/obsidian-api.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Markdown Web Clipper"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"clip-selection": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Clip selection (or full page) to the default destination"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "md-clipper@dalason.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}