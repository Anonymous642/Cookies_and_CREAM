{"manifest_version": 3, "name": "SourceVerify", "version": "0.7.0", "description": "Verify sources and references instantly.", "default_locale": "en", "permissions": ["storage"], "host_permissions": ["https://sourceverify.ai/*"], "browser_specific_settings": {"gecko": {"id": "extension@sourceverify.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.open-sidepanel.js"], "type": "module"}, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "default_title": "Open SourceVerify Side Panel"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "sidebar_action": {"default_panel": "side-panel/index.html", "default_title": "SourceVerify", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open SourceVerify side panel"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}