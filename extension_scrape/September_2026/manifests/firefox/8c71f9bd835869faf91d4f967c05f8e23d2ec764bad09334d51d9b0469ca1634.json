{"manifest_version": 3, "name": "Translate & Copy", "version": "1.1.0", "description": "Highlight text on any webpage to translate and automatically copy to clipboard with instant feedback.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "contextMenus", "storage", "clipboardWrite", "scripting"], "host_permissions": ["https://clients5.google.com/*", "https://api.mymemory.translated.net/*", "https://lingva.lunar.icu/*", "https://lingva.thedaviddelta.com/*"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/popup.html", "default_title": "Translate & Copy", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"translate-selection": {"suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"}, "description": "Translate selected text and copy to clipboard"}}, "browser_specific_settings": {"gecko": {"id": "translate-and-copy@extension.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}