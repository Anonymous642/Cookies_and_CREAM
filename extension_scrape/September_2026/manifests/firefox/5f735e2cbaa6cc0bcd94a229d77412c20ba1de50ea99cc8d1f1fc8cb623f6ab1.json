{"manifest_version": 3, "name": "FLAC Finder", "version": "1.6.0", "description": "Premium lossless FLAC music finder with Magnet support", "browser_specific_settings": {"gecko": {"id": "flac.finder@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.nyaa.si/*", "*://*.nyaa.site/*", "*://*.nyaa.land/*", "*://*.nyaa.eu/*", "<all_urls>"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://music.youtube.com/*", "*://open.spotify.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}