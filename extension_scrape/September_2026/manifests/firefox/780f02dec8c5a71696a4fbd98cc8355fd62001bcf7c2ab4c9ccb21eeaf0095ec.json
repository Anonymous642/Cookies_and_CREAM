{"manifest_version": 3, "name": "Nissely Capture", "version": "1.1.0", "description": "Save products to your Nissely wish lists from any store.", "icons": {"16": "icons/icon-base-16.png", "32": "icons/icon-base-32.png", "48": "icons/icon-base-48.png", "128": "icons/icon-base-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-base-16.png", "32": "icons/icon-base-32.png", "48": "icons/icon-base-48.png"}}, "background": {"scripts": ["background/firefox.js"], "type": "module"}, "permissions": ["tabs", "activeTab", "storage", "scripting"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}, {"matches": ["https://nissely.com/*", "https://*.nissely.com/*"], "js": ["content/nissely.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "capture@nissely.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent"], "description": "Nissely Capture only stores the product details you explicitly add to a list and never sells or shares browsing history. Review https://nissely.com/privacy for our full privacy policy.", "url": "https://nissely.com/privacy"}}}, "host_permissions": ["<all_urls>", "https://nissely.com/*", "https://*.nissely.com/*"]}