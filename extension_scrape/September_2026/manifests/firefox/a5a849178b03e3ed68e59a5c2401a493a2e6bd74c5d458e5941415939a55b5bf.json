{"manifest_version": 2, "name": "Text Case & Slug Converter", "version": "1.3.0", "description": "Right-click or use the popup to convert selected text: snake_case, kebab-case, camelCase, PascalCase, Title Case, SLUGIFY, etc.", "permissions": ["contextMenus", "activeTab", "clipboardWrite", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Convert text", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"convert-with-last": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Convert selection with last-used method"}}, "applications": {"gecko": {"id": "case-converter@tripleorbits"}}}