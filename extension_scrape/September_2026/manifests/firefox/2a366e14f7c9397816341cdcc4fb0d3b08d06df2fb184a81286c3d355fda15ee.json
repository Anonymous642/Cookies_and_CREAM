{"manifest_version": 3, "name": "Mydashboard.me", "version": "1.4", "description": "Replaces your new tab with MyDashboard \u2014 your personal browser dashboard.", "permissions": ["storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "mydashboard@mydashboard.me", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "content_scripts": [{"matches": ["https://mydashboard.me/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}