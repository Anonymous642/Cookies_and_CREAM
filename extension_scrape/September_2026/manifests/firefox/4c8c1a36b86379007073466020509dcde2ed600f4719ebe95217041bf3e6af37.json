{"manifest_version": 3, "name": "One-Click-Jot", "description": "Jot down thoughts and ideas in seconds. Perfect for capturing quick notes while browsing or working.", "version": "1.8", "permissions": ["storage", "activeTab", "scripting", "downloads"], "browser_specific_settings": {"gecko": {"id": "oneclickjot@thomstudio", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "popup.js", "icon48.png", "font/*"], "matches": ["<all_urls>"]}]}