{"manifest_version": 3, "name": "One Tab Closer \u2014 Memento Mori", "version": "1.1.1", "description": "A countdown to approximately how long you have left to live. Every new tab is a reminder.", "permissions": ["storage"], "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "one-tab-closer@memento-mori", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}