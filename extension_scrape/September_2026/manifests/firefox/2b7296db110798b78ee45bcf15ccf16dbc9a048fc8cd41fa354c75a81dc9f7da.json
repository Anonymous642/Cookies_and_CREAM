{"manifest_version": 3, "name": "Instagram Relationship Manager", "version": "0.1.0", "description": "Locally analyse your Instagram followers/following relationships. Side panel UI enabled for Firefox.", "browser_specific_settings": {"gecko": {"id": "igrm@follow-tracer", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "action": {"default_title": "Instagram Relationship Manager", "default_icon": "icons/icon.svg"}, "sidebar_action": {"default_title": "Instagram Relationship Manager", "default_panel": "src/ui/popup.html", "default_icon": "icons/icon.svg"}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["src/content/selectors/dom-selectors.js", "src/core/action-log.js", "src/content/action-controller.js", "src/content/message-handler.js", "src/content/collector.js", "src/content/injector.js"], "run_at": "document_idle"}]}