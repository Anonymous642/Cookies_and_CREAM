{"manifest_version": 3, "name": "QuickLogin", "version": "1.3", "description": "An extension that automatically logs you in on Internet.lpu.in, ums.lpu.in, and myclass.lpu.in", "author": "Dewans Nehra", "homepage_url": "https://dewans.l0calh0st.xyz/", "permissions": ["tabs", "storage"], "icons": {"16": "icons/quicklogin16.png", "48": "icons/quicklogin48.png", "128": "icons/quicklogin128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.internet.lpu.in/*", "*://*.ums.lpu.in/*", "*://*.myclass.lpu.in/*"], "js": ["contentScript.js"]}], "browser_specific_settings": {"gecko": {"id": "dewansnehra.quicklogin@firefox"}}}