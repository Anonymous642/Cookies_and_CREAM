{"author": "Eric Promislow", "manifest_version": 3, "name": "3 Rows Down", "short_name": "3 Rows Down", "version": "0.5.0", "description": "Third-party extension that automatically clicks the last four words in the New York Times Connections game.", "permissions": ["activeTab"], "host_permissions": ["https://www.nytimes.com/games/connections", "https://www.nytimes.com/games/connections/*"], "browser_specific_settings": {"gecko": {"id": "3rowsdown@ericpromislow.com"}}, "homepage_url": "https://github.com/ericpromislow/ThreeRowsDown", "icons": {"48": "icons/trd-48x48.png", "96": "icons/trd-96x96.png", "128": "icons/trd-128x128.png"}, "content_scripts": [{"matches": ["https://www.nytimes.com/games/connections*"], "js": ["content.js"], "run_at": "document_end"}]}