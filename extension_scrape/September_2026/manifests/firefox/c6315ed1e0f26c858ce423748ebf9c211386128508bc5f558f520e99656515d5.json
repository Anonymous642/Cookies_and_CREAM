{"manifest_version": 3, "name": "Link Checker \u2013 Highlight Broken Links", "version": "1.0.0", "description": "Qu\u00e9t c\u00e1c li\u00ean k\u1ebft tr\u00ean trang, ki\u1ec3m tra status (HEAD/GET), t\u00f4 m\u00e0u link h\u1ecfng (4xx/5xx), v\u00e0 xu\u1ea5t CSV. C\u00f3 auto-scan, menu chu\u1ed9t ph\u1ea3i.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "link-checker-demo@example.com", "strict_min_version": "109.0"}}}