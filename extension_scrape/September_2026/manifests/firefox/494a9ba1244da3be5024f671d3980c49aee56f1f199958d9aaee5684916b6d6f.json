{"manifest_version": 2, "name": "WhisperTab", "version": "1.0", "description": "Assign a small sound to each tab that plays when the tab becomes audible, plus a visual overlay (replaces default speaker cue).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "WhisperTab", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "whispertab@example.com"}}}