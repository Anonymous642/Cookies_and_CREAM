{"manifest_version": 3, "name": "Screen Recorder Pro", "description": "Simple, private, local-first screen recorder. Record your entire screen, window, or tab offline with zero uploads or watermarks.", "version": "1.1.2", "homepage_url": "https://github.com/devlopersabbir/screen-recoder-pro", "icons": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "32": "icons/icon32.png", "38": "icons/icon38.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Screen Recorder Pro"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "scripting", "storage", "downloads"], "web_accessible_resources": [{"resources": ["v1.png", "icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "screen-recorder-pro@devlopersabbir.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}