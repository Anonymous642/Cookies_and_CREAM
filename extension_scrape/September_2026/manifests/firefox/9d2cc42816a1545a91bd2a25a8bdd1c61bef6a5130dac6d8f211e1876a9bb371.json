{"manifest_version": 2, "name": "Bookmark Plus", "version": "1.0", "description": "Enhanced bookmark tracking with checkboxes, descriptions, and tags for each webpage", "author": "hmmhesays", "homepage_url": "https://github.com/hmmhesays/bookmark-plus", "browser_specific_settings": {"gecko": {"id": "bookmark-plus@thelostpacket.org", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icon.png"}}, "sidebar_action": {"default_panel": "sidebar.html", "default_icon": {"48": "icon.png"}, "default_title": "Bookmark Plus"}, "commands": {"toggle-overlay": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Toggle bookmark overlay"}, "_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+S"}}}, "icons": {"48": "icon.png"}}