{"manifest_version": 2, "name": "ChessInsights AI \u2013 Chess Analysis AI tool", "description": "Analyze chess positions from YouTube, books, and videos using AI. Export to Lichess or Chess.com and find best moves instantly.", "version": "1.3.0", "short_name": "ChessInsights AI", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "author": "PawelGawlikDev", "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "permissions": ["storage", "activeTab", "identity", "file:///*", "https://lichess.org/*", "https://explorer.lichess.ovh/*", "https://api.chess-insights.app/*"], "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "{42d530ce-6766-4d60-bbb8-821cd93bdd7b}", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"open-dashboard-tab": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+V"}, "description": "Open pinned dashboard tab"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "ChessInsights.ai", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}