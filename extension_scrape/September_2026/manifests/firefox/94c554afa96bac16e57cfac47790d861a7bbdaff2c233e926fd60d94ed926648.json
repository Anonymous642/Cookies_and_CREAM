{"manifest_version": 3, "name": "Scout: Job Hunter", "version": "1.4.0", "description": "Automatically captures job listings into Scout as you browse LinkedIn and Seek.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://scoutroles.com/api/*", "https://scout.protogea.com/api/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.seek.com.au/*", "https://au.seek.com/*"], "js": ["intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.linkedin.com/*", "https://*.seek.com.au/*", "https://au.seek.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://scoutroles.com/*", "https://scout.protogea.com/*"], "js": ["connect.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Scout: Job Hunter", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "scout@protogea.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}