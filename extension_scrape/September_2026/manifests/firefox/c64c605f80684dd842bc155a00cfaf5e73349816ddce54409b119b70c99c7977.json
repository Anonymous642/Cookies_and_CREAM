{"manifest_version": 3, "name": "QR Reader", "version": "0.1.0", "description": "Select and decode QR codes directly from the page.", "icons": {"16": "icons/qr-reader-16.png", "32": "icons/qr-reader-32.png", "48": "icons/qr-reader-48.png", "128": "icons/qr-reader-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "QR Reader", "default_popup": "popup.html", "default_icon": {"16": "icons/qr-reader-16.png", "32": "icons/qr-reader-32.png", "48": "icons/qr-reader-48.png"}}, "commands": {"scan-qr": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Select a QR code on this page"}}, "browser_specific_settings": {"gecko": {"id": "qr-reader@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}