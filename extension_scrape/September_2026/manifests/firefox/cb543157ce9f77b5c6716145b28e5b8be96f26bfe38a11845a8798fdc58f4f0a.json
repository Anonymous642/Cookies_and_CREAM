{"manifest_version": 2, "name": "Autoplay Blocker + Controls", "version": "1.0", "description": "Blocks all non-user-initiated video playback (before and after interaction, including videos loaded on scroll) and can force native controls onto videos on chosen domains.", "icons": {"48": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "autoplay-blocker@maks.local", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["storage", "<all_urls>"], "browser_action": {"default_icon": "icons/icon-32.png", "default_title": "Autoplay Blocker", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": ["inject.js"]}