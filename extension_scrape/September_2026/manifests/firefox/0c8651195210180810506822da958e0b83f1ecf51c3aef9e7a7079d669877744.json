{"manifest_version": 3, "name": "Chauffeur - Save & Restore Tabs", "description": "Save and restore your browser windows and tabs with Chauffeur. 100% local - no cloud, no tracking.", "version": "1.0.4", "browser_specific_settings": {"gecko": {"id": "chauffeur-firefox@emaginasion.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"], "action": {"default_title": "Send Chauffeur context"}, "icons": {"16": "icons/chauffeur-16.png", "32": "icons/chauffeur-32.png", "48": "icons/chauffeur-48.png", "128": "icons/chauffeur-128.png"}}