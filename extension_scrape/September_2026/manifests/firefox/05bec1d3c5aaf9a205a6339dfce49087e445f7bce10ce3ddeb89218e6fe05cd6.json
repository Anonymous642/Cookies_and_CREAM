{"manifest_version": 3, "name": "CareerLynk - Job to Telegram", "version": "1.0", "description": "Extract LinkedIn job postings and send them to your Telegram channel.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.linkedin.com/jobs/*"], "action": {"default_icon": "icon.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "@addon-careerlynk-linkedin-to-telegram", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}, "gecko_android": {"id": "@addon-careerlynk-linkedin-to-telegram-android", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}