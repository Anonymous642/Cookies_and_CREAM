{"manifest_version": 3, "name": "Twitch Follows Viewer", "version": "1.0.1", "description": "Show channels a Twitch user follows (popup + viewer cards + 7TV).", "action": {"default_popup": "popup.html", "default_title": "Twitch Follows"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@pm8followersviewer", "strict_min_version": "58.0"}, "data_collection_permissions": {"required": ["none"]}}, "permissions": ["tabs"], "host_permissions": ["https://tools.2807.eu/*", "https://api.twitch.tv/*", "https://tfv.playm8.games/*"], "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "css": ["css/follows.css", "vendor/lang-flags.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["vendor/lang-flags.png"], "matches": ["*://*.twitch.tv/*"]}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}