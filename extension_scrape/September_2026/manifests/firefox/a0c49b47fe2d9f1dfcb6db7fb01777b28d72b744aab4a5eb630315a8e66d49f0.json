{"manifest_version": 2, "name": "Search with Gemini for Firefox", "version": "1.0.0", "description": "Adds Gemini as a search engine. Reads 'prompt' from URL, injects it, and auto-submits.", "author": "Andreas P\u00fctz", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "permissions": ["storage", "search", "tabs", "https://gemini.google.com/*"], "omnibox": {"keyword": "gem"}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "default_title": "Search with Gemini for Firefox \u2013 Options"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "persistent": true}, "chrome_settings_overrides": {"search_provider": {"name": "Gemini", "keyword": "@gemini", "search_url": "https://gemini.google.com/app?prompt={searchTerms}", "is_default": false}}, "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "search-with-gemini-autosubmit@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}