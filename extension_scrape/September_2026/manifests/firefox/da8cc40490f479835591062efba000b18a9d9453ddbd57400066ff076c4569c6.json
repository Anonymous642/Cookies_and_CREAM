{"manifest_version": 3, "name": "Mijn Cymaid", "short_name": "Mijn Cymaid", "version": "1.0.1", "description": "Opent automatisch de Mijn Cymaid startpagina voor snelle toegang tot de klantomgeving.", "homepage_url": "https://mijn.cymaid.nl/startpagina", "permissions": ["storage", "tabs"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Mijn Cymaid", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://mijn.cymaid.nl/*"], "js": ["content-script.js"], "run_at": "document_start"}], "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "mijn-cymaid@cymaid.nl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}