{"manifest_version": 3, "name": "ScanForAI \u2014 AI Detector & ChatGPT Checker", "short_name": "ScanForAI", "version": "0.4.4", "description": "See if text reads AI-written \u2014 with reasons in plain English \u2014 and clean up machine formatting. Free, no signup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage", "identity", "clipboardRead", "activeTab", "scripting"], "host_permissions": ["https://api.scanforai.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "ScanForAI \u2014 scan or clean up text", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "extension@scanforai.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "homepage_url": "https://scanforai.com/extension", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open ScanForAI"}}}