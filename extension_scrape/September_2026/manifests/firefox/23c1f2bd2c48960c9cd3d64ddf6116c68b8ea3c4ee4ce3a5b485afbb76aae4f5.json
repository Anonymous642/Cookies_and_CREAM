{"manifest_version": 3, "name": "AppliCraft Job Detail Capture", "version": "1.2.0", "description": "Capture job posting details and send them to AppliCraft for AI-powered application generation", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://applicraft.app/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "resume.png", "128": "resume.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@applicraft.app", "strict_min_version": "109.0"}}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "resume.png", "128": "resume.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}