{"manifest_version": 3, "name": "30secads \u2014 Google Ads from a landing page", "short_name": "30secads", "version": "0.1.0", "description": "Browse to any landing page, click the icon, and get 3 headlines + 1 description + 5 keywords ready for Google Ads in seconds.", "author": "30secads.com", "homepage_url": "https://30secads.com", "browser_specific_settings": {"gecko": {"id": "30secads@extension.30secads.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent", "locationInfo"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "30secads \u2014 Generate Google Ads", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background/service_worker.js", "scripts": ["background/service_worker.js"], "type": "module"}, "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["https://staging-api.30secads.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://staging-api.30secads.com https://api.30secads.com"}}