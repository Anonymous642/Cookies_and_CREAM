{"manifest_version": 3, "name": "ScamAvert", "version": "2.0.21", "description": "Scams hide in plain sight. ScamAvert watches pages, addresses and downloads for the tells, and warns you before you are caught.", "permissions": ["activeTab", "storage", "webNavigation", "notifications", "downloads", "alarms"], "host_permissions": ["https://api.scamavert.com/*", "http://localhost:4322/*"], "background": {"scripts": ["src/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/loader.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["https://scamavert.com/app/auth/callback*"], "js": ["src/content/auth-callback.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/*.png", "src/rules/*.js", "src/rules/lib/*.js", "src/rules/engine/*.js", "src/rules/content/*.js"], "matches": ["http://*/*", "https://*/*"]}], "action": {"default_popup": "src/popup/popup.html", "default_title": "ScamAvert", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "optional_host_permissions": ["http://localhost/*"], "browser_specific_settings": {"gecko": {"id": "alpha-extension@scamavert.com", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "browsingActivity", "personalCommunications", "technicalAndInteraction"]}, "strict_min_version": "140.0"}}}