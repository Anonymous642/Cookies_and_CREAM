{"manifest_version": 2, "name": "History Remix", "version": "1.0", "description": "When you reopen pages from history, create a short remix from the chain of visited pages and play it.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "history", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "History Remix", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "historyremix@example.com"}}}