{"manifest_version": 2, "name": "Queue Links", "version": "1.1.1", "description": "Manage a reading list of links in a queue based on the number of times the link has been enqueued.", "icons": {"48": "icons/queue-links-48.png"}, "permissions": ["bookmarks", "downloads", "tabs", "menus", "storage"], "background": {"scripts": ["background.js", "storage.js", "common.js"], "persistent": false}, "browser_action": {"default_icon": "icons/queue-links-32.png", "default_title": "Queue Links", "default_popup": "browser_action/browser_action.html"}, "sidebar_action": {"default_icon": "icons/queue-links-32.png", "default_title": "Queued Links", "default_panel": "queued_links/queued_links.html"}, "commands": {"pop-url-from-the-queue": {"description": "Open link at the top of the queue in the active tab", "suggested_key": {"default": "Ctrl+Shift+E"}}}, "browser_specific_settings": {"gecko": {"id": "{ac6ae294-3703-428b-93ff-20640326b6f2}", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "135.0"}}}