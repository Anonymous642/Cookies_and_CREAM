{"manifest_version": 3, "name": "Klaxon \u2014 watch a page, alert my phone", "version": "1.0.0", "description": "Watch a web page for changes and send the alert to your own Klaxon hub. Right-click anything to send it to your phone.", "browser_specific_settings": {"gecko": {"id": "klaxon-browser@klaxonalerts.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Klaxon \u2014 watch this page", "default_popup": "ui/panel.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "permissions": ["storage", "alarms", "contextMenus", "activeTab", "scripting"], "optional_permissions": ["downloads"], "optional_host_permissions": ["https://*/*", "http://*/*"]}