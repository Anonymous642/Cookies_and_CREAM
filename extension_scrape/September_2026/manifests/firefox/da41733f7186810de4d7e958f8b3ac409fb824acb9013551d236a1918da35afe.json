{"manifest_version": 2, "name": "ScrollTax \u2014 Infinite Scroll Penalty", "version": "2.0.0", "description": "Blurs and grayscales content as you scroll deeper. Forces a cooldown before more content loads. Kills doomscrolling dead.", "browser_specific_settings": {"gecko": {"id": "scrolltax-v2-penalty@devtools.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "ScrollTax"}, "background": {"scripts": ["background.js"], "persistent": false}}