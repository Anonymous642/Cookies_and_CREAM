{"manifest_version": 3, "name": "Strip ChatGPT utm_source", "version": "1.0.0", "description": "Removes ?utm_source=chatgpt.com from links on chatgpt.com.", "icons": {"1024": "icons/1024x1024.png"}, "browser_specific_settings": {"gecko": {"id": "strip-chatgpt-utm@kdheepak.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}