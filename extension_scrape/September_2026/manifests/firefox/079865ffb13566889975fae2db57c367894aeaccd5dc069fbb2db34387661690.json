{"manifest_version": 3, "name": "YouTube Mix Remover", "version": "1.3.3", "description": "Automatically filters out undesired single-video YouTube Mix playlists while keeping real curated artist, genre, and decade mixes.", "homepage_url": "https://github.com/tomkhoailang/remove-youtube-mixes", "browser_specific_settings": {"gecko": {"id": "youtube-mix-remover@tomkhoailang.github.io", "strict_min_version": "109.0"}}, "icons": {"48": "icons/icon_48.png", "96": "icons/icon_96.png", "128": "icons/icon_128.png", "512": "icons/icon_512.png"}, "permissions": ["webNavigation", "tabs", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon_48.png", "96": "icons/icon_96.png", "128": "icons/icon_128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.youtube.com/*"], "js": ["content_main.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false}]}