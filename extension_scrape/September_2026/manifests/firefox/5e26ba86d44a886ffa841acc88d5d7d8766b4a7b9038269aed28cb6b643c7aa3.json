{"manifest_version": 2, "name": "YouTube Speed Controls", "description": "Click ` (backtick) to toggle between normal (1x) and 2x speed, or Ctrl + ` to play at 3x speed.", "version": "2.5", "browser_specific_settings": {"gecko": {"id": "@youtube-speed-controls-firefox", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["src/javascript/script.js"], "css": ["src/css/styles.css"]}], "icons": {"16": "src/images/icon16.png", "48": "src/images/icon48.png", "128": "src/images/icon128.png"}, "developer": {"name": "Your Name", "url": "https://github.com/yourusername/youtube-speed-controls-firefox"}, "browser_action": {"default_title": "YouTube Speed Controls"}}