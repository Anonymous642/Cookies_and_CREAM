{"manifest_version": 3, "name": "Text Link Copier", "version": "1.0.5", "description": "Select multiple links, press Ctrl+Shift+L, and copy their real URLs (not just the visible text) to the clipboard for pasting into a download manager or anywhere else.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "clipboardWrite", "contextMenus", "storage"], "optional_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"copy-links": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Copy URLs of all selected links to the clipboard"}}, "browser_specific_settings": {"gecko": {"id": "abdm-link-copier@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}