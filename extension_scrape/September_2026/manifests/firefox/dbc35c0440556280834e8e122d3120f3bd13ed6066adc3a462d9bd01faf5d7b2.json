{"manifest_version": 3, "name": "Stereo L/R Meter", "version": "0.3.1", "description": "Measures YouTube left/right levels and lets you audition either channel on its native side or duplicated to both ears.", "permissions": ["activeTab"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "action": {"default_title": "Stereo L/R Meter", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "stereo-lr-meter@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}