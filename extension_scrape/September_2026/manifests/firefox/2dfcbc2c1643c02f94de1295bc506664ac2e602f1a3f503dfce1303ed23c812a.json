{"manifest_version": 3, "name": "X Video Downloader", "version": "0.3.0", "description": "One-click download of X/Twitter videos to your computer. Adds a download button to every tweet's action bar.", "browser_specific_settings": {"gecko": {"id": "x-video-downloader@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "X Video Downloader", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "permissions": ["downloads", "storage", "notifications"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*.twimg.com/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/lib/media.js", "src/injected.js"], "world": "MAIN", "run_at": "document_start", "all_frames": false}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/lib/media.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_start", "all_frames": false}]}