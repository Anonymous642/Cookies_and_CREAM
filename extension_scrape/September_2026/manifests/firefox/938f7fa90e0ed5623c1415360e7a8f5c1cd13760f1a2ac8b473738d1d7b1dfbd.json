{"manifest_version": 2, "name": "Gmail Inbox Cleaner for Firefox", "version": "3.0", "description": "The power of AI while using your Gmail.", "permissions": ["activeTab", "storage", "identity", "tabs", "https://mail.google.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "sidepanel.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "Opens only on Gmail"}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"]}], "web_accessible_resources": ["sidepanel.html", "sidepanel.js"], "applications": {"gecko": {"id": "gmail-cleaner@buddysuite.com"}}}