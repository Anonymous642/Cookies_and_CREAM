{"manifest_version": 3, "name": "Crestora Vault", "version": "0.1.3", "description": "Autofill logins from your local Crestora Vault \u2014 zero-knowledge, no cloud, no account.", "browser_specific_settings": {"gecko": {"id": "crestora-vault@crestoralabs.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "Crestora Vault"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "permissions": ["activeTab", "tabs", "clipboardWrite", "nativeMessaging", "storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}