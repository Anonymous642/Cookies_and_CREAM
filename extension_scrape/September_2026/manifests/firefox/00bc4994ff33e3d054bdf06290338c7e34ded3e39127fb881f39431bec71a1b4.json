{"manifest_version": 3, "name": "AssetSnip", "version": "1.0.3", "description": "Extract images, SVGs, videos, colors, fonts, and Lottie animations from any website", "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting", "webRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/jszip.min.js", "lib/mime.js", "background/service-worker.js"]}, "sidebar_action": {"default_panel": "panel/panel.html", "default_title": "AssetSnip", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/injected.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["lib/mime.js", "content/content.js"], "run_at": "document_idle"}], "action": {"default_title": "AssetSnip", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle the AssetSnip sidebar"}}, "web_accessible_resources": [{"resources": ["content/injected.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "assetsnip@assetsnip.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}