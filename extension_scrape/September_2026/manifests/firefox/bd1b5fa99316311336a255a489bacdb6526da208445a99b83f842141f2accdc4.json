{"manifest_version": 2, "name": "Image Source Finder", "version": "1.0", "description": "Right-click on any image to search for its original source", "permissions": ["menus", "activeTab", "contextMenus"], "browser_specific_settings": {"gecko": {"id": "image-source-finder@example.com", "strict_min_version": "79.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}