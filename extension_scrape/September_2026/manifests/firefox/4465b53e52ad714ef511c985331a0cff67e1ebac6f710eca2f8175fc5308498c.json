{"manifest_version": 3, "name": "LeagueInsights Connector", "version": "0.10.1", "description": "Loads your own Yahoo Fantasy league data for LeagueInsights from this browser, so your Yahoo login never leaves your computer.", "author": "BigT", "homepage_url": "https://www.leagueinsights.app/", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.fantasysports.yahoo.com/*", "https://www.leagueinsights.app/*"], "content_scripts": [{"matches": ["https://www.leagueinsights.app/*", "https://leagueinsights.app/*"], "js": ["src/site-bridge.js"], "run_at": "document_start"}], "action": {"default_title": "LeagueInsights Connector", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["src/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "leagueinsights-connector@leagueinsights.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "128.0"}}}