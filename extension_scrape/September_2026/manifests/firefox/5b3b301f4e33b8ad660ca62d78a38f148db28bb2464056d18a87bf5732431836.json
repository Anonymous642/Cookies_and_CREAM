{"manifest_version": 2, "name": "Smart Rewatch Reminder", "version": "1.3", "description": "Save important video moments and remind you to rewatch them later.", "permissions": ["activeTab", "tabs", "storage", "notifications"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "browser_specific_settings": {"gecko": {"id": "@Smart-Rewatch-Reminder-Pm", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}