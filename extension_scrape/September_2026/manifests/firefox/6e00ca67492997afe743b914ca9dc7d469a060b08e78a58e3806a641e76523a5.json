{"manifest_version": 3, "name": "CodeBlur - Anti-Spoiler for Coding", "version": "1.1", "description": "Automatically blurs code editors on solved problems to prevent spoilers. Works on LeetCode & GeeksforGeeks with instant toggle control.", "permissions": [], "browser_specific_settings": {"gecko": {"id": "codeblur@antispoiler.dev"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*", "https://www.geeksforgeeks.org/problems/*"], "js": ["background.js"], "css": ["style.css"], "run_at": "document_idle"}]}