{"manifest_version": 2, "name": "Scholar Metrics Enhancer", "version": "0.1.2", "description": "Adds SJR and Open Access info to Google Scholar results", "permissions": ["storage", "https://scholar.google.com/*", "https://api.crossref.org/*", "https://api.openalex.org/*"], "background": {"scripts": ["background.js", "scripts/utils.js", "scripts/crossref.js", "scripts/openalex.js", "scripts/scholar.js"], "persistent": true}, "content_scripts": [{"matches": ["https://scholar.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"16": "graphics/icon16.png", "32": "graphics/icon32.png", "48": "graphics/icon48.png", "128": "graphics/icon128.png"}, "browser_action": {"default_icon": {"16": "graphics/icon16.png", "32": "graphics/icon32.png", "48": "graphics/icon48.png", "128": "graphics/icon128.png"}, "default_title": "Scholar Metrics Enhancer", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "scholar.metrics.ext@aft.com", "data_collection_permissions": {"required": ["none"]}}}}