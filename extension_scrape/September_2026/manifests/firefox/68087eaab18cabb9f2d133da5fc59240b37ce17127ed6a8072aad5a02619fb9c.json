{"manifest_version": 2, "name": "Jira Test Generator", "description": "Generate test cases from Jira issues using your AI API key", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "https://*.atlassian.net/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.githubcopilot.com/*", "http://localhost:8765/*"], "options_ui": {"page": "settings.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "jira-test-generator@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "browser_action": {"default_title": "Jira Test Generator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.atlassian.net/*"], "js": ["content-scripts/content.js"]}]}