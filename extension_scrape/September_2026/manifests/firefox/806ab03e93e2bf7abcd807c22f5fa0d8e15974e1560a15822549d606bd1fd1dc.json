{"manifest_version": 3, "name": "DefendShield Bridge", "version": "1.0.1", "description": "Companion for the DefendShield security-testing suite: routes traffic through your local DefendShield proxy and reports client-side (DOM) source-to-sink flows, forms and parameters for authorised web-application security testing.", "author": "Sabareesh VK", "developer": {"name": "DefendShield CyberSecurity (OPC) Private Limited", "url": "https://defendshieldcybersecurity.com"}, "homepage_url": "https://defendshieldcybersecurity.com", "permissions": ["activeTab", "tabs", "storage", "proxy"], "host_permissions": ["<all_urls>", "http://127.0.0.1/*"], "browser_specific_settings": {"gecko": {"id": "defendshield-bridge@defendshieldcybersecurity.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "DefendShield Bridge", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "world": "ISOLATED"}]}