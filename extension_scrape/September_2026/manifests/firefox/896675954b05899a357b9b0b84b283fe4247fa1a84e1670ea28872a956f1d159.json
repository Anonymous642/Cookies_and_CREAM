{"manifest_version": 3, "name": "Epic Fill", "version": "0.1.1", "description": "Review and fill online application forms with profile information you choose and control.", "permissions": ["activeTab", "storage", "cookies", "scripting"], "host_permissions": ["https://api.epicfill.com/*"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content/shadow-bridge.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}, {"matches": ["https://*/*"], "js": ["content/submit-guard-channel.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}, {"matches": ["https://*/*"], "js": ["content/sentinel.js"], "run_at": "document_idle", "all_frames": false}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Epic Fill", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"open-epic-fill-context": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Epic Fill context panel"}}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'none'; worker-src 'self'; img-src 'self' data:; connect-src 'self' https://api.epicfill.com"}, "sidebar_action": {"default_title": "Epic Fill", "default_panel": "sidepanel/index.html", "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "epic-fill@epicfill.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}