{"manifest_version": 3, "name": "AI Sentinel: Content Origin Detector", "version": "1.0", "description": "Detects and warns about AI-generated content on web pages.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "AI Sentinel", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "ai-sentinel@example.com"}}}