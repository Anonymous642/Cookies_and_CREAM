{"manifest_version": 2, "name": "EnvTools", "description": "Seu kit de produtividade para testes: gerencie ambientes, credenciais e dados de teste direto no sidepanel do navegador.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "envtools@envtools.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Default Popup Title"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}