{"manifest_version": 2, "name": "Notch", "description": "Capture, structure, and interrogate web content with your own AI key.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "permissions": ["storage", "tabs", "activeTab", "*://*/*"], "commands": {"capture-page": {"suggested_key": {"default": "Alt+Shift+C", "mac": "Command+Shift+C"}, "description": "Capture this page with Notch"}}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "notch@notch-extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "Notch", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}