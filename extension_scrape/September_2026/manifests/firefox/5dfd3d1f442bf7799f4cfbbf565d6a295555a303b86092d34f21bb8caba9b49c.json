{"manifest_version": 3, "name": "10FastFingers Error Collector & Sync", "version": "1.0.0", "description": "Collects missed, mistyped, and slow words from 10FastFingers typing tests and syncs them to your local storage or custom API endpoint.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://10fastfingers.com/*", "http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://10fastfingers.com/share/*"], "js": ["content/content.js"]}], "background": {"scripts": ["background/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "10fastfingers-collector@szymon-wilczek.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}