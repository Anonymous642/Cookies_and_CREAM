{"manifest_version": 3, "name": "Tonal Web", "short_name": "Tonal Web", "version": "0.1.3", "description": "System-accent website recoloring for Firefox that preserves each site's tonal hierarchy.", "minimum_chrome_version": "111", "browser_specific_settings": {"gecko": {"id": "tonal-web@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "action": {"default_title": "Tonal Web", "default_popup": "popup/popup.html", "default_area": "navbar"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["page/engine.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_origin_as_fallback": true}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/bridge.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true, "match_origin_as_fallback": true}]}