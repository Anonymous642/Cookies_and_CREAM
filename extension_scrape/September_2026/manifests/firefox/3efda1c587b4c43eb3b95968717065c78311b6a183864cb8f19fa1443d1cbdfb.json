{"manifest_version": 3, "name": "VIX", "version": "1.0.0", "description": "Lightning-fast code error explanations.", "browser_specific_settings": {"gecko": {"id": "vix@sankalan.com", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup.html", "default_title": "Debugger", "default_icon": "icon_128.png"}, "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://vix-theta.vercel.app/*", "http://localhost/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://vix-theta.vercel.app http://localhost:3001"}}