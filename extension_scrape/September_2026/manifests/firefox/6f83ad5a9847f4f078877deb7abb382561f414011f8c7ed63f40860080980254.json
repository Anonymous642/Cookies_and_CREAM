{"manifest_version": 3, "name": "NDA Focus", "version": "1.0", "description": "Companion extension for the NDA Focus desktop app.", "permissions": ["storage", "alarms", "scripting", "activeTab", "tabs"], "host_permissions": ["http://127.0.0.1:50505/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "styles.css"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "NDA Focus"}, "browser_specific_settings": {"gecko": {"id": "nda-focus-app@local", "data_collection_permissions": {"required": ["none"]}}}}