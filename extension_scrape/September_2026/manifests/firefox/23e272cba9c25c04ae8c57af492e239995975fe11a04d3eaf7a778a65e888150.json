{"manifest_version": 2, "name": "Radial New Tab", "version": "2.5", "description": "Wallpapers, shortcut grid and folders, web/AI search (ChatGPT/Gemini temp chats), floating search anywhere.", "browser_specific_settings": {"gecko": {"id": "radial-new-tab@local", "data_collection_permissions": {"required": ["websiteActivity", "searchTerms"]}}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "96": "assets/icon96.png", "128": "assets/icon128.png"}, "permissions": ["storage", "contextMenus", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Radial New Tab"}, "incognito": "spanning", "web_accessible_resources": ["assets/*.svg"], "background": {"scripts": ["background.js"], "persistent": false}, "commands": {"focus-search": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Focus the search bar"}, "toggle-floating-search": {"suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}, "description": "Toggle floating search bar"}}, "chrome_url_overrides": {"newtab": "newtab.html"}}