{"manifest_version": 2, "name": "1-Click Blocker for X/Twitter", "version": "1.1.0", "description": "Block or mute X/Twitter users with a single click, from a button on every tweet, profile and follower list.", "author": "Sleepy-A", "browser_specific_settings": {"gecko": {"id": "1click-blocker@Sleepy-A", "strict_min_version": "115.0"}}, "permissions": ["storage", "notifications", "*://x.com/*", "*://twitter.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}