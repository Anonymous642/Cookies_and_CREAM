{"manifest_version": 3, "name": "RePlaste", "version": "1.0", "description": "Replace the contents of a text field with clipboard text via the context menu.", "browser_specific_settings": {"gecko": {"id": "replaste@drjekl.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/Replaste-48.png", "96": "icons/Replaste-96.png"}, "permissions": ["contextMenus", "activeTab", "clipboardRead"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}