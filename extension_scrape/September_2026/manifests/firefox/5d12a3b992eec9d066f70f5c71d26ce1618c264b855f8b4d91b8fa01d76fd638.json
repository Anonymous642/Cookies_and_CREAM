{"manifest_version": 3, "name": "launch.grid - Bookmark Launcher", "description": "Modern new-tab bookmark launcher with automatic thumbnails, smart search, and rich customization.", "version": "0.1.9", "browser_specific_settings": {"gecko": {"id": "bookmark-launcher@zlyfer.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-48x48.png", "64": "icons/icon-64x64.png", "128": "icons/icon-128x128.png"}, "permissions": ["bookmarks", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "launch.grid Settings", "default_popup": "options.html", "default_icon": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png"}}}