{"manifest_version": 3, "name": "Code Analyzer", "version": "2.1.1", "description": "Analyzes C++, Python, and Java competitive programming solutions using AI. Detects complexity, bottlenecks, and suggests optimizations.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://api.groq.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "code-analyzer@local.dev", "strict_min_version": "140.0"}}, "icons": {"16": "icons/image16.png", "48": "icons/image48.png", "128": "icons/image128.png"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*", "https://codeforces.com/problemset/problem/*/*", "https://codeforces.com/contest/*/problem/*", "https://*.codechef.com/problems/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}