{"manifest_version": 3, "name": "JobPulse Capture", "version": "1.2.0", "description": "Capture job listings from your logged-in browser into JobPulse.", "permissions": ["scripting", "storage", "sidePanel"], "host_permissions": ["*://*.linkedin.com/*", "*://*.indeed.com/*"], "optional_host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "jobpulse-capture@jobpulse.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "JobPulse Capture"}, "side_panel": {"default_path": "panel.html"}, "sidebar_action": {"default_panel": "panel.html", "default_title": "JobPulse Capture"}}