{"manifest_version": 3, "name": "YouTube Quickmark", "version": "1.0.0", "description": "Press B to drop a blue marker on the YouTube timeline. Markers persist per video and reappear when you return.", "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "YouTube Quickmark", "default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "youtube-quickmark@klar-web-services", "data_collection_permissions": {"required": ["none"]}}}}