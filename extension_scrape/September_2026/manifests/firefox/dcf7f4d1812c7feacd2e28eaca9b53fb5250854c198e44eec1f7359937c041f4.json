{"manifest_version": 2, "name": "Send to RPI", "version": "1.0.0", "description": "Open the current tab on your Raspberry Pi \u2014 one click sends the URL and opens it in Chromium on the Pi.", "homepage_url": "https://github.com/alfaugus/send-to-rpi", "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "developer": {"name": "Alfi George"}, "browser_specific_settings": {"gecko": {"id": "send-to-rpi@commandcode.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "http://localhost:9999/*", "http://127.0.0.1:9999/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Send to RPI", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}}}