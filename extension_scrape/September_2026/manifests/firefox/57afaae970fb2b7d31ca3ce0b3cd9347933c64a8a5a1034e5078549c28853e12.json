{"manifest_version": 2, "name": "Anti-Instagram Login", "version": "0.9.0", "description": "Elimina autom\u00e1ticamente los popups agresivos de registro/inicio de sesi\u00f3n de Instagram.", "author": "Sleepy-A", "browser_specific_settings": {"gecko": {"id": "anti-instagram-login@Sleepy-A", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "*://www.instagram.com/*", "*://instagram.com/*"], "content_scripts": [{"matches": ["*://www.instagram.com/*", "*://instagram.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}