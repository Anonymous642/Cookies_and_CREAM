{"manifest_version": 2, "name": "YouTube Fullscreen \u2192 Ctrl+Alt+S", "version": "1.0.0", "description": "Quando un video YouTube entra o esce dal fullscreen, invia Ctrl+Alt+S al sistema tramite un native messaging host.", "browser_specific_settings": {"gecko": {"id": "yt-fullscreen-trigger@glorianalynx.local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["nativeMessaging", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}