{"manifest_version": 3, "name": "Rumble Focus Mode", "version": "1.3.4", "description": "Reduziert rumble.com auf die gew\u00fcnschten Bereiche und bietet einen stabilen Fokus- und Video-Only-Modus.", "permissions": ["storage"], "host_permissions": ["https://rumble.com/*", "https://www.rumble.com/*"], "action": {"default_title": "Rumble Focus Mode", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://rumble.com/*", "https://www.rumble.com/*"], "js": ["common/defaults.js", "content/content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "rumble-focus-mode@example.local", "data_collection_permissions": {"required": ["none"]}}}}