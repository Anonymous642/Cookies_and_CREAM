{"manifest_version": 3, "name": "YouTube Toolkit", "short_name": "YT Toolkit", "version": "1.3.5", "description": "Volume drag for YouTube and YouTube Music, plus layout, Jump Ahead, headphone controls, and speed tools for YouTube.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "YouTube Toolkit", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}, "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "js": ["features/volume/main_bridge.js", "features/skipit/main_bridge.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "css": ["features/volume/styles.css"], "js": ["features/volume/visualizer.js", "features/volume/content.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "css": ["features/trimmer/content.css"], "js": ["features/trimmer/content.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "js": ["features/skipit/content.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "css": ["features/speed/styles.css"], "js": ["features/speed/content.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "js": ["onboarding/overlay-host.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["onboarding/onboarding.html", "onboarding/onboarding.css", "onboarding/onboarding.js", "onboarding/translations.js", "assets/headphones-colored.webp", "assets/side-tap-hand.webp"], "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "youtube-toolkit@ilcsi", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}