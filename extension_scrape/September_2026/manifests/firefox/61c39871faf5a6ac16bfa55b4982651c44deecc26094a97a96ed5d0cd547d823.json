{"manifest_version": 2, "name": "Nojob", "description": "Job authenticity, response signals, and Gmail/LinkedIn workflow support.", "version": "0.1.10", "icons": {"16": "assets/brand/nojob-mascot-16.png", "32": "assets/brand/nojob-mascot-32.png", "48": "assets/brand/nojob-mascot-48.png", "128": "assets/brand/nojob-mascot-128.png"}, "permissions": ["storage", "identity", "https://www.linkedin.com/*", "https://mail.google.com/*", "https://media.licdn.com/*", "https://www.nojob.app/api/extension-service/*"], "web_accessible_resources": ["assets/brand/nojob-mascot-48.png", "assets/brand/nojob-mascot.png", "assets/signals/shield-check.png", "assets/signals/chat-bubble.png", "assets/signals/star-match.png", "assets/signals/ghost-risk.png", "assets/signals/salary-coin.png", "assets/signals/document-check.png", "assets/signals/notification-bell.png", "assets/signals/company-building.png", "assets/signals/people-group.png", "assets/signals/globe-website.png", "assets/signals/location-pin.png", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "extension@nojob.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "personalCommunications", "browsingActivity", "websiteContent", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Nojob", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://www.linkedin.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}