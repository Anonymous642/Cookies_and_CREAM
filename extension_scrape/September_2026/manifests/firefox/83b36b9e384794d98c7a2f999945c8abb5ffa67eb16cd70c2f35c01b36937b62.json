{"manifest_version": 2, "name": "Dark theme", "version": "0.1.0", "author": "NelikNG", "description": "\u041f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043d\u0430\u044f \u0442\u0435\u043c\u0430 \u0434\u043b\u044f \u0441\u0430\u0439\u0442\u043e\u0432", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Dark theme", "default_popup": "ui/popup.html", "default_icon": "icons/icon-48.png"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"tab_toggle_hotkey": {"suggested_key": {"default": "Ctrl+Alt+D"}, "description": "Toggle theme for current tab"}, "global_toggle_hotkey": {"suggested_key": {"default": "F2"}, "description": "Toggle theme globally"}}, "browser_specific_settings": {"gecko": {"id": "darktheme-v2@nelikng.com", "strict_min_version": "142.0", "data_collection_permissions": {"description": "This extension does not collect any data.", "uses_personal_data": false, "uses_sensitive_data": false, "required": ["none"]}}, "gecko_android": {}}, "permissions": ["<all_urls>", "activeTab", "tabs", "storage"]}