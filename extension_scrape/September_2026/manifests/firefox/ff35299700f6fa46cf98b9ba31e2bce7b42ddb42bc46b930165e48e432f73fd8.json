{"manifest_version": 2, "name": "Clutch", "description": "AI that keeps you focused and blocks distractions.", "version": "0.0.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "clutch@vincentnahn.com"}}, "permissions": ["storage", "system.memory", "tabs", "https://api.openai.com/v1"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"]}