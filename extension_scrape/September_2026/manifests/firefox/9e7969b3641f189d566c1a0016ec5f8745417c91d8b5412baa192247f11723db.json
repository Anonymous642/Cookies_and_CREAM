{"manifest_version": 2, "name": "Prompt Magnus AI", "version": "1.3", "description": "A browser extension to save, organize, and quickly access ChatGPT prompts.", "permissions": ["storage", "activeTab", "tabs", "contextMenus", "notifications", "https://chat.openai.com/*", "https://chatgpt.com/*"], "browser_action": {"default_title": "Prompt Magnus AI", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"scripts": ["prompts.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["bundled_content.js"]}], "web_accessible_resources": ["images/promptmagnus_icon.svg", "images/icon16.png", "images/icon48.png", "images/icon128.png"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"strict_min_version": "102.0", "id": "{04d7a57c-3028-450b-8e36-028b8ad45047}"}}}