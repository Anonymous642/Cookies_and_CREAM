{"manifest_version": 2, "name": "The Yokai Addon!", "version": "1.0", "description": "Highlights yokai-related terms and opens a sidebar with info links so you can learn more about them.", "permissions": ["storage", "activeTab", "<all_urls>"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Toggle Yokai Highlighter", "default_popup": "popup.html"}, "sidebar_action": {"default_title": "Yokai Info", "default_panel": "sidebar.html", "open_at_install": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yokai-highlighter@diamondspider", "data_collection_permissions": {"required": ["none"]}}}}