{"manifest_version": 3, "name": "Path of Dust Item Links", "version": "0.2.1", "description": "Path of Dust item links in Twitch chat become the item's name \u2014 hover to see its full stats, Path of Exile style.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"], "js": ["shared/item-codec.js", "card.js", "content.js"], "css": ["tooltip.css"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pod-item-links@lokati-overlay", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}}