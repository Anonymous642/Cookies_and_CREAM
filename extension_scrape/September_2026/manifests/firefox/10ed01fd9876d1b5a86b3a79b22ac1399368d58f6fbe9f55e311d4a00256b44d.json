{"manifest_version": 3, "name": "Memory Saver", "version": "0.2.0", "description": "Automatically discard unused firefox tabs to save memory.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "alarms", "storage", "sessions", "menus"], "background": {"scripts": ["src/background/index.js"], "type": "module"}, "action": {"default_title": "Memory Saver", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "src/popup/index.html"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@firefox-memory-saver-hero", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}