{"manifest_version": 3, "name": "BC Cell Copy", "version": "2.1.1", "description": "Ctrl+Shift+click a cell in Business Central to copy its value(s) to the clipboard.", "browser_specific_settings": {"gecko": {"id": "bc-cell-copy@bccopypaste", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["clipboardWrite", "storage", "scripting"], "optional_host_permissions": ["https://*/*", "http://*/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://businesscentral.dynamics.com/*", "https://*.bc.dynamics.com/*", "https://*.businesscentral.dynamics.com/*"], "js": ["onboarding.js", "content.js"], "run_at": "document_idle", "all_frames": true}]}