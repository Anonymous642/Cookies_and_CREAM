{"manifest_version": 3, "name": "Open in Preferred", "description": "Open the current page in another service. GitHub and Graphite are built in, plus add your own mappings.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "Open in Preferred", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "open-in-preferred@hisbaan.com", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"open_in_tab": false, "page": "options.html"}}