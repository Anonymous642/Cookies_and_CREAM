{"name": "Topaz", "description": "Social media AI filtering", "version": "0.2.5", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "topazblock@extension.com"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.linkedin.com/*", "https://*.reddit.com/*"], "js": ["content/index.js"], "css": ["content/content.css"], "run_at": "document_end", "all_frames": false}], "icons": {"128": "assets/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "permissions": ["storage", "tabs"], "web_accessible_resources": [{"resources": ["content/config.json", "content/content.css"], "matches": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.linkedin.com/*", "https://*.reddit.com/*"]}], "host_permissions": ["https://*.youtube.com/*", "https://*.twitter.com/*", "https://*.x.com/*", "https://*.linkedin.com/*", "https://*.reddit.com/*"]}