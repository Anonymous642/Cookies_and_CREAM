{"manifest_version": 3, "name": "Lightshade Migration Helper", "version": "0.1.4", "description": "Helps users move their own Character.AI characters, personas and chat history into Lightshade.", "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://character.ai/*", "https://www.character.ai/*", "https://neo.character.ai/*", "https://characterai.io/*", "https://lightshade.cloud/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"}, "action": {"default_title": "Lightshade Migration Helper", "default_icon": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cai-migrator@lightshade.local", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications", "websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}