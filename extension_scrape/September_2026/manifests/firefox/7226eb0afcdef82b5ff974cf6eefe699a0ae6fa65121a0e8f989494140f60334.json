{"manifest_version": 3, "name": "Gemini Prompt Image Downloader", "version": "1.2.0", "description": "Automatically downloads Gemini generated images with prompts injected into PNG metadata.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "gemini-downloader@mahedihasan.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "downloads", "storage", "alarms"], "host_permissions": ["<all_urls>", "http://127.0.0.1:9999/*", "http://localhost:9999/*"], "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Gemini Downloader Options"}, "web_accessible_resources": [{"resources": ["page_script.js"], "matches": ["https://gemini.google.com/*"]}]}