{"manifest_version": 3, "name": "RustGuard Pairing Helper", "version": "1.0.0", "description": "Securely links your Steam / Rust+ account with RustGuard by capturing the Rust+ companion login token in your browser.", "permissions": ["storage"], "host_permissions": ["https://companion-rust.facepunch.com/*", "https://rustguard-api.feast-labs.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "RustGuard Pairing Helper", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://companion-rust.facepunch.com/*"], "js": ["cs-facepunch-main.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://companion-rust.facepunch.com/*"], "js": ["cs-facepunch-bridge.js"], "run_at": "document_start", "world": "ISOLATED"}, {"matches": ["https://rustguard.feast-labs.com/*"], "js": ["cs-rustguard.js"], "run_at": "document_start", "world": "ISOLATED"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "rustguard-pairing@feast-labs.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}