{"manifest_version": 2, "name": "tabstone", "version": "1.0.0", "description": "Organize and declutter browser tabs with a graveyard theme. Bury tabs into groups and resurrect them later.", "permissions": ["tabs", "storage", "activeTab"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "tabstone@example.com", "strict_min_version": "79.0"}}}