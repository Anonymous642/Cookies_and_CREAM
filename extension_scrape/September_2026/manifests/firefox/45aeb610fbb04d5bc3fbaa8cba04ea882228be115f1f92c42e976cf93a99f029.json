{"manifest_version": 3, "name": "Automacars", "version": "1.0.0", "description": "Extens\u00e3o para integra\u00e7\u00e3o entre o Facebook e a plataforma Automacars.", "permissions": ["storage", "tabs", "scripting", "activeTab"], "host_permissions": ["https://*.facebook.com/*", "https://automacars.vercel.app/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": "public/icon.png"}, "content_scripts": [{"matches": ["https://*.facebook.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "automacars@vercel.app", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"], "optional": [], "description": "This extension does not collect any personal data."}}}}