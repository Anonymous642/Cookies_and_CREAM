{"manifest_version": 3, "name": "Shorts AutoScroll", "version": "1.1.0", "description": "Auto-scrolls YouTube Shorts, Instagram Reels, and Facebook Reels when one ends. Includes a custom timer with alarm.", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}, "default_title": "Shorts AutoScroll"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["assets/timer-face.svg", "assets/timer-face-alarm.svg", "assets/five-more.svg", "assets/times-up.svg", "assets/gear.svg", "assets/clock.svg", "fonts/PlusJakartaSans-Medium.woff2"], "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"]}], "browser_specific_settings": {"gecko": {"id": "shorts-autoscroll@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}