{"manifest_version": 3, "name": "Kanahover", "version": "0.3", "description": "Randomly replaces a few English words with Japanese romaji and shows hover tooltips.", "browser_specific_settings": {"gecko": {"id": "{8f2f1f4e-2a31-4a39-9c0c-8b6d0b4d7f2a}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Toggle Kanahover", "default_icon": {"32": "icon-on.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["tooltip.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["dictionary.json"], "matches": ["<all_urls>"]}]}