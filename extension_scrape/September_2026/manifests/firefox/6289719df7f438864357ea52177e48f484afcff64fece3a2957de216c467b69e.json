{"manifest_version": 3, "name": "RunAway", "description": "An English-first progressive dictionary for uninterrupted web reading.", "version": "0.2.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "permissions": ["storage"], "host_permissions": ["https://freedictionaryapi.com/*"], "action": {"default_title": "RunAway \u2014 Off", "default_icon": {"16": "toolbar/inactive-16.png", "32": "toolbar/inactive-32.png"}}, "browser_specific_settings": {"gecko": {"id": "runaway@runaway.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}