{"manifest_version": 2, "name": "Search That", "version": "1.1.0", "description": "Every new tab opens on one search field wired to search-that.com, and your address bar goes to the same place.", "chrome_url_overrides": {"newtab": "newtab/index.html"}, "chrome_settings_overrides": {"search_provider": {"name": "Search That", "keyword": "st", "search_url": "https://www.google.com/search?q={searchTerms}", "favicon_url": "https://search-that.com/favicon.ico", "is_default": true}}, "permissions": ["storage", "tabs"], "background": {"scripts": ["background/background.js"]}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "extension@search-that.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}