{"manifest_version": 2, "name": "Jira Service Desk Notifier", "version": "2.6", "description": "Erstellt Benachrichtigungen f\u00fcr neue Jira-Tickets in einer ge\u00f6ffneten Filter-Ansicht.", "permissions": ["notifications", "storage", "alarms", "tabs", "https://*.atlassian.net/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.atlassian.net/issues/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "options.html", "default_title": "Jira Notifier"}, "icons": {"48": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "jira-servicedesk-notifier@bit-line.com"}}}