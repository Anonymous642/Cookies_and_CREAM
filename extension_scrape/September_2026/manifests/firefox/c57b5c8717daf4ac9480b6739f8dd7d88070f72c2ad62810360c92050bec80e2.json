{"manifest_version": 3, "name": "DeepTab Search: PDF & Web", "version": "1.9", "description": "Instantly search for any keyword across all your open tabs, including heavy PDF files and standard web pages. Perfect for research and study.", "browser_specific_settings": {"gecko": {"id": "deeptab-search@private.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "activeTab", "scripting", "notifications"], "host_permissions": ["<all_urls>", "file:///*"], "sidebar_action": {"default_panel": "popup.html", "default_title": "DeepTab Search", "default_icon": "icon48.png"}, "action": {"default_title": "Open DeepTab Search", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "background": {"scripts": ["pdf.min.js", "pdf.worker.min.js", "background.js"]}}