{"manifest_version": 2, "name": "Clear YouTube Shorts History", "version": "1.4.4", "description": "Clears YouTube Shorts from your Watch history in bulk.", "permissions": ["tabs", "activeTab", "https://www.youtube.com/*"], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Clear YouTube Shorts History", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content/youtube-history.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "clear-youtube-shorts@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}