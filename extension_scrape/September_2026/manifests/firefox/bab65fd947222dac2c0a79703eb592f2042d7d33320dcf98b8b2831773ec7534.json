{"manifest_version": 3, "name": "NoteHeist\u2013Capture,Extract Text & Bookmark", "version": "1.3.1", "description": "Capture video frames, extract text from videos, bookmark videos, & sync notes across Web & VS Code.", "permissions": ["storage", "activeTab", "scripting", "tabs", "sidebarAction", "cookies"], "host_permissions": ["https://noteheist.com/*", "https://www.noteheist.com/*", "<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}, "action": {"default_title": "Open Notes", "default_icon": {"16": "noteheist-icon-16.png", "32": "noteheist-icon-32.png", "48": "noteheist-icon-48.png"}}, "sidebar_action": {"default_title": "Noteheist", "default_panel": "sidepanel.html", "default_icon": "noteheist-icon-32.png"}, "commands": {"toggle_panel": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Hide or show Noteheist panel"}}, "background": {"scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["index.html", "sidepanel.html", "sidepanel.js", "assets/*", "noteheist-icon.svg", "noteheist-icon-16.png", "noteheist-icon-32.png", "noteheist-icon-48.png", "noteheist-icon-128.png"], "matches": ["<all_urls>"]}], "icons": {"16": "noteheist-icon-16.png", "32": "noteheist-icon-32.png", "48": "noteheist-icon-48.png", "128": "noteheist-icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "noteheist-ext@noteheist.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}