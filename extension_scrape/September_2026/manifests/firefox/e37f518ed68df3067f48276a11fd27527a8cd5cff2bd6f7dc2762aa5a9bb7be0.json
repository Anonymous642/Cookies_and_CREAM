{"manifest_version": 3, "name": "Tabstinence", "version": "1.0.0", "description": "Avoid tab and window overload with global, per-window, and per-domain tab limits, and a window limit.", "browser_specific_settings": {"gecko": {"id": "tabstinence@gpanakkal.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "notifications"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "action": {"default_title": "Tabstinence", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "src/popup/popup.html", "open_in_tab": false}}