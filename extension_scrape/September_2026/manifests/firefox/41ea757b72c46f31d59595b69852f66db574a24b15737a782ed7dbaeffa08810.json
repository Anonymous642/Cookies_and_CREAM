{"manifest_version": 3, "name": "Discord Token Manager", "version": "1.0.1", "description": "View your Discord session token and log in with a token \u2014 fast, private, fully local. Bilingual EN/RU.", "permissions": ["activeTab", "scripting"], "host_permissions": ["*://discord.com/*", "*://*.discord.com/*"], "browser_specific_settings": {"gecko": {"id": "discord-token-manager@extension", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}