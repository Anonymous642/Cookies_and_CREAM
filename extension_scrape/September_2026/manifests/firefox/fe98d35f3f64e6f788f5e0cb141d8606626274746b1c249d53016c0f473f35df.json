{"manifest_version": 2, "name": "Focus Timer", "version": "1.0", "description": "Helps you focus and get things done!", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon.png"}, "browser_action": {"default_icon": "icon.png", "default_title": "Focus Timer", "default_popup": "popup/popup.html"}, "permissions": ["storage", "alarms", "notifications"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "hello@gmail.com", "strict_min_version": "126.0"}}}