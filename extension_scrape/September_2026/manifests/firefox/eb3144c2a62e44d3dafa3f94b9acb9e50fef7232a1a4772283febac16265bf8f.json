{"manifest_version": 3, "name": "KadiSaver", "version": "1.5", "description": "Sauvegarde, organise et retrouve tes pages web - avec compte, recherche et partage de collections.", "icons": {"32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon-32.png", "64": "icons/icon-64.png"}, "default_title": "KadiSaver"}, "background": {"scripts": ["lib/config.js", "background.js"]}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "downloads"], "host_permissions": ["https://kadisaver.integriscloud.com/*"], "web_accessible_resources": [{"resources": ["content/save-modal.html", "content/save-modal-frame.js", "content/save-modal-frame.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "kadisaver@liane.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}