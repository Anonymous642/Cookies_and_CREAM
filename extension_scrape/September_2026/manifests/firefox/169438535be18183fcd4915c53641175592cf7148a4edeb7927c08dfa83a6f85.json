{"manifest_version": 3, "name": "Arcade Deluxe \u2014 Mini Games Pack", "version": "2.1", "description": "A polished offline arcade: 10 classic games (Snake, Tetris, 2048, Breakout, Minesweeper, Memory, Pong, Simon, Tic-Tac-Toe, Reflex), high scores, achievements and themes. No tracking, fully offline.", "browser_specific_settings": {"gecko": {"id": "arcade-deluxe@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "action": {"default_title": "Arcade Deluxe", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["js/background.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open Arcade Deluxe"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}