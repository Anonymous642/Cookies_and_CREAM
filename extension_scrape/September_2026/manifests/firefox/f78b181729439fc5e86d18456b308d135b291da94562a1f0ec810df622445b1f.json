{"manifest_version": 3, "name": "Simple Auto Refresher", "version": "1.0.1", "description": "Auto refresh the current tab at a custom interval.", "permissions": ["tabs", "storage"], "icons": {"16": "icons/auto-refresher-icon-16.png", "32": "icons/auto-refresher-icon-32.png", "64": "icons/auto-refresher-icon-64.png", "96": "icons/auto-refresher-icon-96.png"}, "action": {"default_title": "Auto Refresher", "default_popup": "popup.html", "default_icon": {"16": "icons/auto-refresher-icon-16.png", "32": "icons/auto-refresher-icon-32.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "autorefresher@letholdus.com", "data_collection_permissions": {"required": ["none"]}}}}