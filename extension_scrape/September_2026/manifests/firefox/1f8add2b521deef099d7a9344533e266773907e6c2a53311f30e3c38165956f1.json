{"manifest_version": 3, "name": "Zodify", "version": "1.0.0", "description": "Client-side developer popup that instantly converts raw JSON payloads into strictly-typed Zod schemas and TypeScript interfaces.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "json-zod-studio@polybrain.addon", "strict_min_version": "115.0"}}}