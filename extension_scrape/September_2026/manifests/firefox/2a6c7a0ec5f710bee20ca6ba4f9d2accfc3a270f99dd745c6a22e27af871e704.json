{"manifest_version": 3, "name": "tabme", "version": "2.1", "description": "Save open tabs into bookmark collections and manage them from a custom start page.", "permissions": ["bookmarks", "tabs", "storage"], "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*", "https://docs.google.com/*"], "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"homepage": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "@tabme.hento", "data_collection_permissions": {"required": ["none"], "optional": ["bookmarksInfo", "websiteActivity"]}}}}