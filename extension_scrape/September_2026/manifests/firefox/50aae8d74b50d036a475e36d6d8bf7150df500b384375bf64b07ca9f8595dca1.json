{"manifest_version": 3, "name": "SnapCash Sync", "version": "0.8.13", "description": "Sincronizza le prenotazioni del tuo extranet Booking.com con la piattaforma SnapCash. Credenziali sempre nel tuo browser.", "icons": {"128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}}, "background": {"scripts": ["gmail.js", "background.js"]}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://admin.booking.com/*", "https://www.snapcash.it/*"], "content_scripts": [{"matches": ["https://admin.booking.com/*", "https://www.snapcash.it/*"], "js": ["capture.js", "content.js"], "run_at": "document_idle"}], "optional_permissions": ["scripting"], "optional_host_permissions": ["https://mail.google.com/*"], "browser_specific_settings": {"gecko": {"id": "snapcash-sync@snapcash.it", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "financialAndPaymentInfo", "authenticationInfo", "websiteContent"], "optional": ["personalCommunications"]}}}}