{"manifest_version": 3, "name": "DarkB44 \u2014 Dark Mode for Base44", "version": "2.5.0", "description": "Dark mode for the Base44 builder. 13 themes, any accent, aurora & glass effects, focus mode, schedules \u2014 zero performance cost.", "browser_specific_settings": {"gecko": {"id": "darkb44@tommade.me", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://app.base44.com/*"], "content_scripts": [{"matches": ["https://app.base44.com/*"], "js": ["content/content.js"], "css": ["content/theme.css"], "run_at": "document_start"}], "background": {"service_worker": "bg/service-worker.js", "scripts": ["bg/service-worker.js"]}, "action": {"default_popup": "ui/popup.html", "default_title": "DarkB44", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "commands": {"toggle-theme": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle DarkB44 dark mode"}, "cycle-preset": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Cycle through DarkB44 themes"}, "toggle-focus": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Cycle focus mode (off / chat / preview)"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}