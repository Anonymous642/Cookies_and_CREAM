{"manifest_version": 2, "name": "Online Chess Recon", "version": "1.0.1", "description": "Checks your opponent's account age and recent win rate on Lichess and Chess.com to flag likely engine users and bots.", "browser_specific_settings": {"gecko": {"id": "online-chess-recon@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://lichess.org/*", "https://www.chess.com/*", "https://api.chess.com/*"], "content_scripts": [{"matches": ["https://lichess.org/*", "https://www.chess.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}