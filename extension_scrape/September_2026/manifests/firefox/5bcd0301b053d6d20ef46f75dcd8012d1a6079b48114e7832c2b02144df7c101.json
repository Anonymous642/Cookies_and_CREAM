{"manifest_version": 3, "name": "ZoneOut for YouTube", "description": "Zone out between YouTube videos. Auto-mutes new videos and inserts a calm break between them, so autoplay can\u2019t pull you under.", "version": "2.5.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_title": "ZoneOut for YouTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "{4efd469e-2622-4a66-9581-f4bc05569d00}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js", "content-scripts/dethrottle.js"]}]}