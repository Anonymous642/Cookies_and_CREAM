{"manifest_version": 3, "name": "YTM Playlist Exporter", "version": "1.0.1", "description": "Export YouTube Music playlists to CSV or JSON.", "browser_specific_settings": {"gecko": {"id": "ytm-playlist-exporter@bolorundurowb.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting"], "content_scripts": [{"matches": ["*://music.youtube.com/playlist*", "*://music.youtube.com/library/playlists*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}}