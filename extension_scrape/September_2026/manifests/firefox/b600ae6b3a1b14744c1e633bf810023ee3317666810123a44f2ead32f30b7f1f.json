{"manifest_version": 2, "name": "Archive PDF Grabber", "version": "1.0.0", "description": "Scans Archive.org search results and collects PDF links from items.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage", "downloads", "*://archive.org/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "PDF Grabber", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://archive.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "archive-pdf-grabber@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}