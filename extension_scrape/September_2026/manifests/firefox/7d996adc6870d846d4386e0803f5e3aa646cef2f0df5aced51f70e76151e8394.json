{"manifest_version": 2, "name": "Focus Lock", "version": "2.4.0", "description": "Lock yourself onto the sites you need for a set time. During a focus session, any attempt to navigate to a site that isn't on your allow-list is gently redirected to a focus screen with the time remaining.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{7723560f-05e8-437c-8e41-26c89ba0fd1a}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "alarms", "notifications", "tabs", "<all_urls>"], "background": {"scripts": ["src/background.js"]}, "browser_action": {"default_title": "Focus Lock", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}