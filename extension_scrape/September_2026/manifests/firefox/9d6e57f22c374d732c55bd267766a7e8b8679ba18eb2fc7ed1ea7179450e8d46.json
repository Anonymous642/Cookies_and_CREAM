{"manifest_version": 3, "name": "YouTube Anti Tracker", "version": "3.0", "description": "Removes YouTube tracking parameters pp, si and redirect links directly in the page.", "browser_specific_settings": {"gecko": {"id": "youtube-pp-cleaner@plutonium", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_browsing_history": false, "collects_website_content": false, "collects_authentication_info": false, "collects_location": false, "collects_health_info": false, "collects_financial_info": false, "collects_contacts": false, "collects_user_activity": false}}}, "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"48": "icon48.png", "96": "icon96.png"}}