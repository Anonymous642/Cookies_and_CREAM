{"manifest_version": 3, "name": "TabbySync", "version": "1.6.18", "description": "Self-hosted sync for your bookmarks and your open tabs \u2014 two tools in one extension sharing one server, token and sync name.", "permissions": ["bookmarks", "tabs", "storage", "unlimitedStorage", "contextMenus", "alarms", "notifications"], "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "TabbySync", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "commands": {"send-all-tabs": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Send all tabs in this window to TabbySync"}, "open-tabbysync": {"description": "Open the TabbySync tab list"}}, "browser_specific_settings": {"gecko": {"id": "tabbysync@tabbysync.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["bookmarksInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}