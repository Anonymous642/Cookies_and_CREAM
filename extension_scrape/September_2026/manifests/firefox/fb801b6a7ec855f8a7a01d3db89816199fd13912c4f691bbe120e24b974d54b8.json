{"manifest_version": 3, "name": "Bang Override", "version": "0.1.0", "description": "Overrides stale DuckDuckGo bang redirects for selected services.", "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["https://duckduckgo.com/*", "https://www.duckduckgo.com/*", "https://tidal.com/*"], "background": {"scripts": ["src/redirect.js", "src/overrides/index.js", "src/overrides/tidal.js", "background.js"], "service_worker": "background.js"}, "browser_specific_settings": {"gecko": {"id": "bang-override@example.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Bang Override", "default_popup": "popup.html"}}