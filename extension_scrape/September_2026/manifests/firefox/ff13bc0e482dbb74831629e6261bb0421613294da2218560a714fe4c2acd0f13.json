{"manifest_version": 2, "name": "Pokemon Themes", "version": "2.0.0", "description": "Change your browser theme to match your favorite Pokemon's colors with PokeAPI integration", "browser_specific_settings": {"gecko": {"id": "pokemon-themes@firefox", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["theme", "storage", "alarms"], "browser_action": {"default_icon": "icons/icon.svg", "default_title": "Pokemon Themes", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "browser_style": true}, "background": {"scripts": ["lib/pokeapi.js", "lib/color-extractor.js", "lib/theme-manager.js", "lib/daily-manager.js", "background/background.js"]}}