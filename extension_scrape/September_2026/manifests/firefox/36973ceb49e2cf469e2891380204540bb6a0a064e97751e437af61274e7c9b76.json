{"manifest_version": 3, "name": "AI Snip Animator - Screenshot to Video", "version": "1.1.0", "description": "Capture any area of a webpage like Snipping Tool and transform it into AI-generated animated GIFs, stickers, and videos.", "browser_specific_settings": {"gecko": {"id": "ai-snip-animator@hasimax.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "AI Snip Animator \u2014 Turn Screenshots Into Videos (Ctrl+Shift+G)", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"trigger-snip": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "Command+Shift+G"}, "description": "Activate AI Snipping Overlay"}}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*", "content.css"], "matches": ["<all_urls>"]}]}