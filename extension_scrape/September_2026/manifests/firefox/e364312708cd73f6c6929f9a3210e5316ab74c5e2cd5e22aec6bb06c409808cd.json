{"manifest_version": 3, "name": "TradeYantra TradingView Sync", "version": "1.0.0", "description": "Receives TV_SYNC payloads from TradeYantra and syncs to TradingView.", "browser_specific_settings": {"gecko": {"id": "tv-sync@tradeyantra.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://www.tradingview.com/*", "https://in.tradingview.com/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["app-bridge.js"], "run_at": "document_start"}, {"matches": ["https://www.tradingview.com/*", "https://in.tradingview.com/*"], "js": ["tradingview-sync.js"], "run_at": "document_idle"}], "action": {"default_title": "TradeYantra TV Sync"}}