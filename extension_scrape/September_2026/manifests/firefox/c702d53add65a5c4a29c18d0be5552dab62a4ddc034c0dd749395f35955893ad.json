{"manifest_version": 2, "name": "// bookmarks", "version": "1.0.1", "description": "Personal bookmark manager with tag filtering, folder navigation, full-text search, and optional git backup", "permissions": ["bookmarks", "storage", "tabs", "downloads", "<all_urls>"], "browser_action": {"default_title": "// bookmarks", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "double-slash-bookmarks@lebcit.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}