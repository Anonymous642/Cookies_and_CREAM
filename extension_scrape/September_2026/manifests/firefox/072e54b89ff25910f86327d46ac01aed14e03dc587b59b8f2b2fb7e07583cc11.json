{"manifest_version": 3, "name": "PostingLens", "short_name": "PostingLens", "version": "1.1.1", "description": "Analyse job postings locally in your browser. Right-click selected text or open the sidebar. Translation is optional.", "browser_specific_settings": {"gecko": {"id": "postinglens@postinglens.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}}, "action": {"default_title": "PostingLens \u2014 click to toggle the sidebar", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "sidepanel/sidepanel.html", "default_title": "PostingLens", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs"], "host_permissions": ["https://postinglens.com/*"], "content_scripts": [{"matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.justjoin.it/*", "https://*.pracuj.pl/*", "https://*.nofluffjobs.com/*", "https://*.glassdoor.com/*", "https://jobs.lever.co/*", "https://*.greenhouse.io/*", "https://boards.greenhouse.io/*", "https://*.myworkdayjobs.com/*", "https://jobs.workday.com/*"], "js": ["content/extractor.js"], "run_at": "document_idle"}, {"matches": ["https://postinglens.com/*"], "js": ["content/site-bridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://translate.googleapis.com https://postinglens.com;"}}