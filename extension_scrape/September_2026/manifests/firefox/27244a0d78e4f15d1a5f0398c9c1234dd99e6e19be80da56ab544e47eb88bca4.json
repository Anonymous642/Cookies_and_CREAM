{"manifest_version": 3, "name": "Active Reader: Focus & Track While You Read", "version": "3.0.0", "description": "Highlight a word, hit Tab, and step through any article word-by-word or sentence-by-sentence without losing your place.", "homepage_url": "https://synodichub.netlify.app", "permissions": ["storage", "contextMenus", "alarms"], "host_permissions": ["https://mlqooyutrequlqrkmlra.supabase.co/*"], "background": {"service_worker": "background.js", "scripts": ["config.js", "security/runtime-security.js", "security/storage-coordinator.js", "security/entitlements.js", "features/goback.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}, "incognito": "spanning", "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "active-reader@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "security/entitlements.js", "security/ruleset.js", "features/smart-pacing.js", "features/goback.js", "seasonal/seasonal-effects.js", "content/reader-shadow-styles.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Active Reader", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "commands": {"goback-save": {"description": "GoBack: save the current page location"}, "golater-save": {"description": "GoLater: save the current page location for later"}, "goback-manager": {"description": "Open GoBack Manager"}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}