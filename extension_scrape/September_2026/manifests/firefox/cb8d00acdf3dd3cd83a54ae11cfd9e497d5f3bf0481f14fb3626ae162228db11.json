{"manifest_version": 3, "name": "KeywordMiner On-Page Extractor", "version": "1.0.0", "description": "Extract on-page keywords, headings, word counts, and keyword density from the current tab. Runs locally with no tracking.", "browser_specific_settings": {"gecko": {"id": "keywordminer-onpage-extractor@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "scripting", "clipboardWrite", "storage"], "action": {"default_popup": "popup.html", "default_title": "KeywordMiner On-Page Extractor"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "short_name": "KeywordMiner"}