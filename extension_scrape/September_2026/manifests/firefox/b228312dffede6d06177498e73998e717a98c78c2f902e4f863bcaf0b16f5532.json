{"manifest_version": 3, "name": "TikTok Extension", "version": "1.6", "description": "A basic TikTok extension for Firefox.", "permissions": ["activeTab", "storage"], "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.tiktok.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "tiktok-extension@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}