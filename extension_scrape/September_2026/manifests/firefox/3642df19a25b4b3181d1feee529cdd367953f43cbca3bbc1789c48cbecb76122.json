{"manifest_version": 2, "name": "TheShot.ai Review Extractor", "version": "1.0.9", "description": "Extract publicly visible reviews and comments from supported websites and save them to your TheShot.ai account.", "browser_specific_settings": {"gecko": {"id": "extractor@theshot.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16-light-transparent.png", "48": "icons/icon48-light-transparent.png", "128": "icons/icon128-light-transparent.png"}, "default_title": "TheShot.ai Review Extractor", "theme_icons": [{"light": "icons/icon16.png", "dark": "icons/icon16-light-transparent.png", "size": 16}, {"light": "icons/icon48.png", "dark": "icons/icon48-light-transparent.png", "size": 48}, {"light": "icons/icon128.png", "dark": "icons/icon128-light-transparent.png", "size": 128}]}, "permissions": ["activeTab", "tabs", "storage", "https://theshot.ai/*", "https://www.theshot.ai/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://theshot.ai/extension/auth*", "https://www.theshot.ai/extension/auth*"], "js": ["content/auth-handler.js"], "run_at": "document_idle"}], "web_accessible_resources": ["content/extractor.js"]}