{"manifest_version": 3, "name": "Queue Playback Guard", "version": "1.0.0", "description": "Blocks YouTube from auto-advancing to the next video in queues, playlists, and shortcut, also with exact visual selector filtering.", "permissions": ["declarativeNetRequestWithHostAccess"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://web.telegram.org/*", "https://www.instagram.com/*"], "declarative_net_request": {"rule_resources": [{"id": "qpg_permissions_policy", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}, {"matches": ["https://www.youtube.com/*"], "js": ["content-isolated.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}, {"matches": ["https://www.youtube.com/*"], "css": ["selectors-youtube.css"], "js": ["youtube-visual-schedule.js"], "run_at": "document_start", "world": "ISOLATED", "css_origin": "user"}, {"matches": ["https://web.telegram.org/*"], "css": ["selectors-telegram.css"], "run_at": "document_start", "css_origin": "user"}, {"matches": ["https://www.instagram.com/*"], "css": ["selectors-instagram.css"], "run_at": "document_start", "css_origin": "user"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Queue Playback Guard"}, "browser_specific_settings": {"gecko": {"id": "queue-playback-guard@localprotection.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}