{"manifest_version": 3, "name": "QuickTranslate", "version": "1.0.0", "description": "Fast translator with 20+ languages, text-to-speech, and translation history. Uses free translation API - no key needed for basic use!", "icons": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_icon": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png"}, "default_title": "QuickTranslate", "default_popup": "src/popup/popup.html"}, "permissions": ["storage"], "host_permissions": ["https://translate.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "quicktranslate@language.tools", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}