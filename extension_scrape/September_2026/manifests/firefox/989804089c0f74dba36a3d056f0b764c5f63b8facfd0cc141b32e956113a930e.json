{"manifest_version": 2, "name": "VTEX IO ToolKit", "version": "1.0", "description": "Atualmente conta com ferramenta de extra\u00e7\u00e3o de dados salvos no site editor do Vtex IO. Em breve novas funcionalidades.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "web_accessible_resources": ["injected.js"], "browser_specific_settings": {"gecko": {"id": "vtexio-toolkit-extension@andre-souza-dev.github.com", "strict_min_version": "109.0"}}}