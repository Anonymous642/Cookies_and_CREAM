{"manifest_version": 2, "name": "Themeboi", "description": "Refreshes colour scheme via the theme API and a simple python server", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "themeboi@subez", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "64": "icons/icon-64.svg"}}, "permissions": ["theme", "http://127.0.0.1/*"], "background": {"scripts": ["bg.js"]}, "web_accessible_resources": ["colors.json"]}