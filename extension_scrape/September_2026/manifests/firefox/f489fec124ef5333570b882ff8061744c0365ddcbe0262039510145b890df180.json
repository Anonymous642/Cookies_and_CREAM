{"manifest_version": 3, "name": "SupaPM", "version": "0.0.21", "description": "AI-powered product management assistant with context-aware chat", "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://supapm.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.typesafe.ai/*", "http://localhost/*", "http://127.0.0.1/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "SupaPM"}, "commands": {"add_selection_to_context": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Add highlighted text to SupaPM context"}, "_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Open SupaPM side panel"}}, "options_page": "options/index.html", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/icon-16.png", "assets/icon-48.png", "assets/icon-128.png"], "matches": ["https://supapm.com/*"]}], "browser_specific_settings": {"gecko": {"id": "supapm@supapm.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "sidebar_action": {"default_panel": "sidepanel/index.html", "default_title": "SupaPM", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}}