{"browser_specific_settings": {"gecko": {"id": "firefox@dayglow.app"}}, "name": "Dayglow for Firefox", "version": "0.0.1", "manifest_version": 3, "description": "Dayglow keeps you focused & effective. This extension brings extra power to Chrome. Install the main app at dayglow.app", "icons": {"16": "icon16.png", "32": "icon32.png", "128": "icon128.png", "256": "icon256.png"}, "background": {"scripts": ["ff_background.js"]}, "content_scripts": [{"run_at": "document_start", "matches": ["*://*/*"], "js": ["content_scripts.js"]}], "permissions": ["alarms", "tabs", "scripting"], "host_permissions": ["*://*/*"]}