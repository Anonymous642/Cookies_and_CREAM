{"manifest_version": 3, "name": "Stellar Photos", "description": "Experience a beautiful high-resolution photo every time you open a new browser tab. Fast, customizable, and clutter-free.", "version": "5.0.0", "icons": {"48": "48.png", "64": "64.png", "128": "128.png"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://api.unsplash.com/*", "https://images.unsplash.com/*", "https://www.gstatic.com/prettyearth/*"], "browser_specific_settings": {"gecko": {"id": "stellar@stellarapp.photos", "strict_min_version": "153.0"}}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}}