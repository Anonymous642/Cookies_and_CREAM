{"manifest_version": 2, "name": "Play on FreeTube", "version": "2.0.0", "description": "Open YouTube videos, channels, and playlists in FreeTube app", "permissions": ["contextMenus", "activeTab", "storage", "tabs", "*://www.youtube.com/*", "*://youtube.com/*", "*://youtu.be/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"128": "icon.png"}, "default_title": "FreeTube Extension"}, "icons": {"128": "icon.png"}, "commands": {"open-in-freetube": {"suggested_key": {"default": "Alt+F", "windows": "Alt+F", "mac": "Alt+F", "linux": "Alt+F"}, "description": "Open current video in FreeTube"}}, "browser_specific_settings": {"gecko": {"id": "play-on-freetube@github.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}