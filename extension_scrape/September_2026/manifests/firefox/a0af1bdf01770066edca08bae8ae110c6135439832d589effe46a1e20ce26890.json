{"manifest_version": 2, "name": "share-the-mark", "description": "Annotate live web pages and export a Markdown changelog plus an annotated screenshot.", "version": "2.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://github.com/mpecan/share-the-mark", "permissions": ["activeTab", "scripting", "storage"], "optional_permissions": ["http://127.0.0.1/*", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "share-the-mark@mpecan.dev", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "share the mark", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [], "web_accessible_resources": ["content-scripts/content.css"]}