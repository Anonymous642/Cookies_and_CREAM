{"manifest_version": 3, "name": "Yet Another Linkwarden Extension", "description": "Small extension to save new pages to Linkwarden", "version": "0.0.1", "minimum_chrome_version": "126", "browser_specific_settings": {"gecko": {"id": "yetanotherlinkwardenextension@emersonveenstra.net", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"128": "assets/logo.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "omnibox": {"keyword": "lw"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open the save popup"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"128": "assets/logo.png"}}, "permissions": ["storage", "tabs", "scripting"], "optional_permissions": ["trialML"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "homepage_url": "https://codeberg.org/emersonveenstra/yet-another-linkwarden-extension"}