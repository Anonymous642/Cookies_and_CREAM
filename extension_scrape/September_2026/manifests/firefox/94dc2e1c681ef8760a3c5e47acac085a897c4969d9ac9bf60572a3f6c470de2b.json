{"manifest_version": 3, "name": "LupaMoodle", "version": "1.5.0", "description": "Sube notas desde LupaMoodle directamente a Moodle. Visualiza, califica y sincroniza entregas de alumnos.", "author": "fmesasc", "permissions": ["activeTab", "storage", "tabs", "scripting"], "host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "lupamoodle@fmesasc", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["xlsx.min.js"], "matches": ["*://*/*"]}], "content_scripts": [{"matches": ["*://*/*"], "js": ["darkmode.js"], "run_at": "document_start"}, {"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}