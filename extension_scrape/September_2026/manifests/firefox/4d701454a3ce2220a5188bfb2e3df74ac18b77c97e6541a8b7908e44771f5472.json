{"manifest_version": 3, "name": "Ribbon", "version": "1.0.10", "description": "Save a product page to your Ribbon gift list. Only that page is sent when you click Add to Ribbon.", "homepage_url": "https://ribbon-list.com", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Add to Ribbon", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "tabs", "scripting", "contextMenus"], "host_permissions": ["http://*/*", "https://*/*"], "incognito": "not_allowed", "commands": {"save-to-ribbon": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Save this page to Ribbon"}}, "browser_specific_settings": {"gecko": {"id": "ribbon@ribbon-list.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "120.0"}}}