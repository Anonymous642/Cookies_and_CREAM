{"manifest_version": 3, "name": "FoolForms", "version": "1.0", "description": "Save and reload form fields from a top bar.", "homepage_url": "https://github.com/maguzzz/FoolForms.git", "icons": {"128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "activeTab", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "FoolForms \u2014 toggle toolbar", "default_icon": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "foolforms@maguzzz", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["css/styles.css", "fonts/IosevkaCharon-Regular.ttf"], "matches": ["<all_urls>"]}]}