{"manifest_version": 2, "name": "RSS Kit", "version": "1.0.3", "description": "Discover and manage RSS feeds with RSS Kit - detect feeds on any webpage and sync with your RSS Kit account", "author": "RSS Kit", "sidebar_action": {"default_panel": "src/sidebar/landing.html", "default_title": "RSS Kit", "default_icon": "src/assets/icons/icon48.png"}, "background": {"scripts": ["src/background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/feed-detector.js"], "run_at": "document_idle"}], "permissions": ["storage", "notifications", "activeTab", "https://*/*", "http://*/*"], "browser_action": {"default_title": "RSS Kit - Open Sidebar", "default_icon": {"16": "src/assets/icons/icon16.png", "32": "src/assets/icons/icon32.png", "48": "src/assets/icons/icon48.png"}}, "icons": {"16": "src/assets/icons/icon16.png", "32": "src/assets/icons/icon32.png", "48": "src/assets/icons/icon48.png", "128": "src/assets/icons/icon128.png"}, "web_accessible_resources": ["src/assets/*"], "browser_specific_settings": {"gecko": {"id": "rsskit@rsskit.co.uk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}