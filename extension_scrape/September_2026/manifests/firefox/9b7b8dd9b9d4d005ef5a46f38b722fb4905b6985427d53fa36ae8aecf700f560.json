{"manifest_version": 3, "name": "ArabFilter", "version": "1.0.0", "description": "Filter comments and reviews to show only Arabic-language ones on Letterboxd and Trakt.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "ArabFilter"}, "permissions": ["storage"], "host_permissions": ["https://letterboxd.com/*", "https://www.letterboxd.com/*", "https://trakt.tv/*", "https://*.trakt.tv/*"], "content_scripts": [{"matches": ["*://letterboxd.com/film/*/reviews/*", "*://letterboxd.com/film/*/", "*://letterboxd.com/film/*", "*://www.letterboxd.com/film/*/reviews/*", "*://www.letterboxd.com/film/*/", "*://www.letterboxd.com/film/*"], "js": ["shared/arabic-detector.js", "content/letterboxd.js"], "run_at": "document_idle"}, {"matches": ["*://trakt.tv/*", "*://*.trakt.tv/*"], "js": ["content/trakt-injector.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://trakt.tv/movies/*/reviews", "*://trakt.tv/movies/*", "*://trakt.tv/shows/*/reviews", "*://trakt.tv/shows/*", "*://*.trakt.tv/movies/*", "*://*.trakt.tv/shows/*"], "js": ["shared/arabic-detector.js", "content/trakt.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "arabfilter@yasser.dev", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["fonts/thmanyahsans-Regular.woff2", "fonts/thmanyahsans-Bold.woff2", "icons/*.svg", "content/trakt-injector.js"], "matches": ["<all_urls>"]}]}