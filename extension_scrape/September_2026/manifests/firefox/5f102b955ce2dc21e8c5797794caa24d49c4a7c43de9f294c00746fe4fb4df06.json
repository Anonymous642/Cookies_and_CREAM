{"manifest_version": 3, "name": "OneTapEmoji \u2014 Emoji Keyboard", "short_name": "OneTapEmoji", "version": "1.0.0", "description": "Search, copy, favorite and combine every Unicode emoji from a persistent Firefox sidebar.", "homepage_url": "https://onetapemoji.com/en/", "permissions": ["clipboardWrite", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open OneTapEmoji keyboard", "default_area": "navbar", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "sidebar_action": {"default_title": "OneTapEmoji \u2014 Emoji Keyboard", "default_panel": "sidepanel.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "open_at_install": true}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open the OneTapEmoji keyboard"}}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "one-tap-emoji@onetapemoji.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}