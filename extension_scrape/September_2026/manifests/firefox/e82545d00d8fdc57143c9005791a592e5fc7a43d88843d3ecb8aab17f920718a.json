{"manifest_version": 2, "name": "Standup Reminder", "version": "1.0.0", "description": "Reminds you to stand up and stretch every X minutes during your work hours.", "browser_specific_settings": {"gecko": {"id": "standup-reminder@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_title": "Standup Reminder"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["alarms", "notifications", "storage"]}