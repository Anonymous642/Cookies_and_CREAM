{"manifest_version": 3, "name": "TOTVS Vault", "version": "1.0.11", "description": "Pesquise clientes, URLs e credenciais do TOTVS Vault rapidamente.", "browser_specific_settings": {"gecko": {"id": "totvs-vault@addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "TOTVS Vault", "default_icon": {"128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://totvsvault.vercel.app/*", "https://stagingtotvsvault.vercel.app/*", "https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"], "icons": {"128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+V"}, "description": "Abrir TOTVS Vault"}}}