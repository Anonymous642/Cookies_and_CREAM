{"manifest_version": 3, "name": "Gerador Nicks \u2014 GN Autofill", "version": "1.0.0", "description": "Adds a GN button next to username fields to generate human-like nicknames with Insert, Copy, Regenerate, and styles. From geradornicks.com.br.", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Gerador Nicks"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "geradornicks-addon@geradornicks.com.br", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}