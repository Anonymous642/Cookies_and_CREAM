{"manifest_version": 3, "name": "Citt.ai", "version": "1.0.23", "description": "Helper for Citt.ai telehealth sessions, right there in your browser", "permissions": ["activeTab", "tabs"], "host_permissions": ["https://www.citt.ai/*", "https://citt.ai/*", "https://ws.citt.ai/*"], "content_scripts": [{"matches": ["https://www.citt.ai/*", "https://citt.ai/*"], "js": ["protocol.js", "recording-protocol.js", "recovery-spool.js", "recorder-generation-flush.js", "socket.io.min.js", "firefox-capture.js", "content-bridge.js"], "run_at": "document_start"}], "background": {"service_worker": "firefox-background.js", "scripts": ["firefox-background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["socket.io.min.js", "micsetup.html", "micsetup.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "extension@citt.ai", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}