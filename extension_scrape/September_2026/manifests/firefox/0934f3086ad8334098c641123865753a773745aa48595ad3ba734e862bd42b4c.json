{"manifest_version": 3, "name": "mrkdwn Web Clipper", "version": "1.1.1", "description": "Clip a selection or a whole page as Markdown, straight into a folder on your own disk.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "src/options/index.html", "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "downloads"], "commands": {"_execute_action": {"description": "Clip the selection, or the whole page if nothing is selected"}, "clip-selection": {"description": "Save selection to mrkdwn"}, "clip-page": {"description": "Save page to mrkdwn"}}, "browser_specific_settings": {"gecko": {"id": "mrkdwn@buenalabs.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}