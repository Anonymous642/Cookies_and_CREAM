{"manifest_version": 3, "name": "Claude Session Meter", "version": "1.0", "description": "Shows current session and weekly usage percentage in a corner badge on claude.ai.", "permissions": ["storage", "alarms"], "host_permissions": ["https://claude.ai/*"], "browser_specific_settings": {"gecko": {"id": "claude-session-meter@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["content.js"]}]}