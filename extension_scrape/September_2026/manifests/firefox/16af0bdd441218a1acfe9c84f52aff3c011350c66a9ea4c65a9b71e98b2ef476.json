{"manifest_version": 3, "name": "SimSweep CC Source Tracker", "version": "1.1.0", "description": "Automatically tracks where you download Sims 4 CC from. Works with SimSweep to crowdsource download sources.", "permissions": ["downloads", "storage", "alarms", "tabs"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cc-source-tracker@syvr", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}