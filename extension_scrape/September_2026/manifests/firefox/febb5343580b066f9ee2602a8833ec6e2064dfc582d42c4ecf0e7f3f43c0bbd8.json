{"manifest_version": 3, "name": "LibreGuard", "version": "0.1.0", "description": "Browse the web like nobody's watching.", "browser_specific_settings": {"gecko": {"id": "libreguard@example.org", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "LibreGuard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "background": {"scripts": ["background.js"]}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "activeTab", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "block_ads_1", "enabled": true, "path": "rules/block-ads-1.json"}, {"id": "block_ads_2", "enabled": true, "path": "rules/block-ads-2.json"}]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}