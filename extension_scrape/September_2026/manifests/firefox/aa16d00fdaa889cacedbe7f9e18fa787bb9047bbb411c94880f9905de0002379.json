{"version": "1.0.2", "name": "SBB for Komoot", "homepage_url": "https://github.com/sbb-for-komoot/sbb-for-komoot", "description": "An SBB/CFF/FFS extension for Komoot, to easily plan your train journey to the start of your next hike.", "icons": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/favicon-48x48.png", "128": "icons/favicon-128x128.png"}, "background": {"scripts": ["background/scripts.js"]}, "content_scripts": [{"matches": ["https://www.komoot.com/*", "https://komoot.com/*"], "js": ["content_scripts/content-0.js"], "css": []}], "author": "Aloha Churchill & Benjamin Lozes", "manifest_version": 3, "action": {"default_icon": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/favicon-48x48.png", "128": "icons/favicon-128x128.png"}, "default_title": "SBB for Komoot"}, "sidebar_action": {"default_panel": "sidebar/index.html", "default_title": "SBB for Komoot", "default_icon": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/favicon-48x48.png", "128": "icons/favicon-128x128.png"}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://transport.opendata.ch/*", "https://www.komoot.com/*", "https://komoot.com/*"], "browser_specific_settings": {"gecko": {"id": "sbb-for-komoot@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}