{"manifest_version": 2, "name": "Rise of the Penguins GB", "version": "1.0.0", "description": "Retro Game Boy penguin platformer as a browser extension. A moderate challenge in a cold setting!", "browser_specific_settings": {"gecko": {"id": "rise-of-the-penguins-gb@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Rise of the Penguins GB", "default_popup": "popup.html"}, "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'", "web_accessible_resources": ["game/*"]}