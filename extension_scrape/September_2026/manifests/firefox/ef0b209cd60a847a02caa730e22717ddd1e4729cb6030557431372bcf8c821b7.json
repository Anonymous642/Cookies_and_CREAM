{"manifest_version": 2, "name": "Sign in with Google Blocker", "version": "1.0", "description": "Automatically dismisses the annoying 'Sign in with Google' popups that appear on many websites.", "author": "Matthew Davis", "homepage_url": "https://github.com/mdavis-xyz/google-sign-in-extension", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["*://accounts.google.com/gsi/*"], "content_scripts": [{"matches": ["<all_urls>"], "css": ["hide-gsi.css"], "run_at": "document_start"}, {"matches": ["*://accounts.google.com/gsi/*"], "js": ["click-close.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "google-sign-in-blocker@mdavis.xyz", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}