{"manifest_version": 3, "name": "YouTube Auto-Pause", "version": "1.0.1", "description": "Auto-pauses YouTube on tab switch or window blur. F8 to toggle.", "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["browser-polyfill.min.js", "content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "YouTube Auto-Pause"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "yt-autopause@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}