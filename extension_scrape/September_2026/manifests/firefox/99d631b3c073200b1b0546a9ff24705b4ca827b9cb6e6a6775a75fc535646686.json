{"manifest_version": 2, "name": "Instagram Web Enhancer", "version": "1.0.0", "description": "Cleaner, more app-like Instagram on Firefox mobile, plus a Save button for Reels and videos.", "browser_specific_settings": {"gecko": {"id": "ig-web-enhancer@personal.example", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["downloads", "webRequest", "storage", "*://*.instagram.com/*", "*://*.cdninstagram.com/*", "*://*.fbcdn.net/*"], "content_scripts": [{"matches": ["*://*.instagram.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"], "persistent": true}}