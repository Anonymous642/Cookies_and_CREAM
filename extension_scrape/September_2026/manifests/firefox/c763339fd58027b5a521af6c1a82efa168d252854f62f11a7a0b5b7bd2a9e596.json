{"manifest_version": 3, "name": "ChannelLens", "version": "1.0.0", "description": "Privately label YouTube channels and see your notes when you encounter them again.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_title": "ChannelLens", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content/page-bridge-loader.js", "src/shared/constants.js", "src/shared/storage.js", "src/content/channel-detector.js", "src/content/reminder-banner.js", "src/content/content.js"], "css": ["src/content/reminder-banner.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content/page-bridge.js"], "matches": ["*://*.youtube.com/*"]}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "channellens@fahad.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}