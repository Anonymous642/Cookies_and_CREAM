{"manifest_version": 3, "name": "DiceRoller", "version": "1.0.0", "description": "Dice rolling simulator. Roll D4, D6, D8, D10, D12, D20 dice with results.", "icons": {"48": "dice-icons/icon-48.png", "96": "dice-icons/icon-96.png", "128": "dice-icons/icon-128.png"}, "action": {"default_icon": {"48": "dice-icons/icon-48.png", "96": "dice-icons/icon-96.png"}, "default_title": "DiceRoller", "default_popup": "roller-ui/roll.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "diceroller@dice.roll", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}