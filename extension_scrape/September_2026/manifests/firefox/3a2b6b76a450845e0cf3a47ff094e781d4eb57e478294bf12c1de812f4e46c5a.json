{"manifest_version": 3, "name": "ZENTIKI Quick Notes", "version": "1.0.0", "description": "A lightweight Firefox add-on for saving quick notes, opening custom shortcuts, and searching the web from a clean popup.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ZENTIKI Quick Notes", "default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "zentiki-quick-notes@zentiki.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}