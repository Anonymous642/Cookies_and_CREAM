{"manifest_version": 2, "name": "Quick Invoice Generator", "version": "1.3", "description": "Create simple invoices quickly from the browser and print or export them as PDF/HTML.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Invoice Gen", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@Quick-nvoice-Generator", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}