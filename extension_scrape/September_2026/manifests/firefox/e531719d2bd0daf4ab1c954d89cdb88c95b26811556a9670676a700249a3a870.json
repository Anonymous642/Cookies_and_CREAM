{"manifest_version": 2, "name": "Japanese Prices To Dollars & Euros", "version": "1.0.3", "description": "Finds Japanese yen prices on web pages and shows normalized yen, EUR, and USD conversions on hover using Frankfurter exchange rates.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["https://api.frankfurter.app/*", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "japanese-prices-to-dollars-euros@jjlt-ext.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}