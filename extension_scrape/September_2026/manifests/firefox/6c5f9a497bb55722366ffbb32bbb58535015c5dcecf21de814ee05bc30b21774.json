{"manifest_version": 2, "name": "Google Drive Extractor", "version": "3.0.0", "description": "Extract file metadata, shareable links, and details directly from Google Drive folders. Export to CSV, JSON, and Markdown.", "browser_specific_settings": {"gecko": {"id": "gdrive-extractor@simkah.web.id", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "https://drive.google.com/*", "https://docs.google.com/*"], "sidebar_action": {"default_panel": "panel.html", "default_title": "Drive Extractor"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://drive.google.com/*"], "js": ["extractor.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Google Drive Extractor", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}