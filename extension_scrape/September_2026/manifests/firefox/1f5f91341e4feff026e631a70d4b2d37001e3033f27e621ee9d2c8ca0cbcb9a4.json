{"manifest_version": 3, "name": "Multily \u2014 Profile Switcher", "short_name": "Multily", "version": "0.9.8", "description": "Save and restore browser identities. Switch between accounts without logging in again.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/storage.js", "lib/config.js", "lib/i18n-classic.js", "lib/ExtPay.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "multily@multily.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["financialAndPaymentInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["lib/ExtPay.js"], "run_at": "document_start"}], "permissions": ["cookies", "storage", "tabs", "notifications", "downloads"], "host_permissions": ["<all_urls>"], "incognito": "spanning", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open Multily"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open the Multily profile manager (full page)"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current incognito session as a new profile"}}}