{"manifest_version": 2, "name": "BypassKit - Link Unlocker", "version": "1.0.0", "description": "Quickly resolve shortened or redirected URLs to reveal the final destination link. Simple, fast, and privacy-friendly.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "BypassKit - Link Unlocker"}, "permissions": ["https://api.bypasskit.co/*"], "browser_specific_settings": {"gecko": {"id": "bypasskit@bypasskit.co", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'"}