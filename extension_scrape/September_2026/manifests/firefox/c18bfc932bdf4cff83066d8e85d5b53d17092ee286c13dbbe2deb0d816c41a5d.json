{"manifest_version": 3, "name": "YouTube Like/Dislike Ratio", "version": "2.1.0", "description": "Shows like/dislike ratio on YouTube (via Return YouTube Dislike API).", "browser_specific_settings": {"gecko": {"id": "yt-like-dislike-ratio@amura.ru", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "https://returnyoutubedislikeapi.com/*"], "icons": {"128": "icon.png"}, "action": {"default_title": "YouTube Like/Dislike Ratio", "default_icon": {"128": "icon.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}