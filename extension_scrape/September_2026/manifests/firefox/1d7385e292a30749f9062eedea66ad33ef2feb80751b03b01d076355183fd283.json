{"manifest_version": 3, "name": "Declutter Ecosia", "version": "1.2", "description": "Remove clutter like sponsored results and sidebars from Ecosia. Clean, distraction-free search\u2014just like it used to be.", "permissions": ["storage", "scripting"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["*://www.ecosia.org/search*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "declutter-ecosia@example.com", "strict_min_version": "102.0"}}}