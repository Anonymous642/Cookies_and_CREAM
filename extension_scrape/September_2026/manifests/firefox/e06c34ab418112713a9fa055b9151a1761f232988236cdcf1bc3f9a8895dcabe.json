{"manifest_version": 3, "name": "CyberTrixs Browser Security", "version": "1.10", "description": "Holistic Cybersecurity Extension", "browser_specific_settings": {"gecko": {"id": "cybertrixs@cybertrixs.com"}}, "permissions": ["activeTab", "storage", "downloads", "tabs", "declarativeNetRequest", "declarativeNetRequestFeedback", "notifications", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": "images/icon-48.png"}, "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}