{"manifest_version": 2, "name": "YouTube Background Play", "version": "1.0.0", "description": "Keep YouTube videos playing when you switch tabs or minimize your browser. Perfect for listening to music or podcasts in the background.", "author": "Your Name", "homepage_url": "https://github.com/yourusername/youtube-background-play", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "{0bcd2a52-5734-4bc5-b8c5-66eeefa7a3cf}", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "permissions": ["*://*.youtube.com/*"]}