{"manifest_version": 2, "name": "Web Shield Mobile", "short_name": "Web Shield", "description": "Bloqueia an\u00fancios e rastreadores no Firefox, com prote\u00e7\u00e3o para o YouTube e reprodu\u00e7\u00e3o cont\u00ednua em segundo plano.", "version": "1.3.1", "permissions": ["<all_urls>", "activeTab", "storage", "tabs", "webRequest", "webRequestBlocking"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Web Shield", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}}, "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "css": ["content/cosmetic.css"], "js": ["content/content.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["content/background-playback-firefox.js", "content/youtube-control.js", "content/youtube.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["content/continuous-playback.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "web-shield-mobile@adielsonsetubal.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}