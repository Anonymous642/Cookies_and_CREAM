{"manifest_version": 3, "name": "WHAT", "version": "1.0.0", "description": "Highlight words and learn their definitions instantly.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://api.dictionaryapi.dev/*"], "browser_specific_settings": {"gecko": {"id": "what-extension@yahyamansoub.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "action": {"default_title": "WHAT", "default_popup": "popup.html", "default_icon": {"16": "icons/what-16.png", "32": "icons/what-32.png", "48": "icons/what-48.png", "128": "icons/what-128.png"}}, "icons": {"16": "icons/what-16.png", "32": "icons/what-32.png", "48": "icons/what-48.png", "128": "icons/what-128.png"}}