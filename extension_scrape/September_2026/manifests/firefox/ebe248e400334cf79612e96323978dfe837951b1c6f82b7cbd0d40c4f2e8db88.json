{"manifest_version": 3, "name": "PriceHunter Comparison Tool", "version": "2.0.2", "description": "Compare prices on Amazon and Walmart with unit-price ranking and search history.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://*.amazon.com/*", "https://*.walmart.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "pricehunter@comparison.tool", "data_collection_permissions": {"required": ["none"]}}}}