{"manifest_version": 3, "name": "Reqnroll Recorder", "version": "1.0.0", "description": "Automatically record browser interactions and generate Reqnroll BDD tests with Gherkin feature files and C# step definitions.", "permissions": ["activeTab", "scripting", "storage", "downloads"], "browser_specific_settings": {"gecko": {"id": "{8a7e5c3d-1f2b-4a9e-b6c8-3d4e5f6a7b8c}", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}