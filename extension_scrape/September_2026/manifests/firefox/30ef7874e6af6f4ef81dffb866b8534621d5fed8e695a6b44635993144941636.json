{"manifest_version": 3, "name": "GPGWebAuth", "version": "1.0.9", "description": "GPG encryption, signing, and decryption in your browser. Create keys, sign messages, and automatically decrypt PGP content.", "permissions": ["activeTab", "alarms", "contextMenus", "storage", "clipboardRead", "clipboardWrite", "notifications", "scripting"], "host_permissions": ["https://keys.openpgp.org/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "gpgwebauth@dreaming.codes", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}