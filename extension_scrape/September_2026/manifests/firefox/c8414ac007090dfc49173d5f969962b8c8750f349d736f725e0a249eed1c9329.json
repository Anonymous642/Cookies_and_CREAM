{"manifest_version": 3, "name": "Hindsite", "version": "1.0.0", "description": "Search Google, ChatGPT, Gemini, and Claude simultaneously in one click.", "author": "Debarshi Das", "browser_specific_settings": {"gecko": {"id": "hindsite@debarshidas", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Hindsite \u2014 Multi-Platform Search"}, "background": {"service_worker": "background/service-worker.js", "scripts": ["background/service-worker.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-scripts/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["content-scripts/gemini.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-scripts/claude.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "contextMenus", "tabs", "commands"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://www.google.com/*"], "commands": {"open-hindsite": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Open Hindsite popup"}}, "omnibox": {"keyword": "hs"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}