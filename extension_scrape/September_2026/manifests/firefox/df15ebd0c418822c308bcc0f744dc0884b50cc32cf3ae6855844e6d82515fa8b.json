{"manifest_version": 3, "name": "Smart Clipboard Manager", "version": "1.0", "description": "A professional clipboard manager that saves your copied items with timestamps", "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "tabs", "contextMenus", "notifications"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "smart-clipboard-manager@firefox.extension"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "floating-clips.js"], "css": ["floating-clips.css"]}], "commands": {"copy-to-clipboard": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Copy to Smart Clipboard"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}