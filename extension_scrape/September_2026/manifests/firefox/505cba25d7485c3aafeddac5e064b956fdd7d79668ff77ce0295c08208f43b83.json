{"manifest_version": 3, "name": "Archivum - Tab manager to clear your mind", "description": "Organize your browser tabs by age. Automatically group tabs into age-based groups (Week+, Month+, Quarter+, etc.) and keep your workspace organized.", "version": "1.26.711.1151", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "activeTab", "bookmarks", "clipboardRead", "storage", "scripting", "tabGroups", "alarms"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Archivum - manager", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "archivum@kowalskipiotr.pl", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"type": "module", "scripts": ["background.js"]}}