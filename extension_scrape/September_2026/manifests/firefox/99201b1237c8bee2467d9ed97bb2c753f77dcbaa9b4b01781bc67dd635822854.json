{"manifest_version": 3, "name": "Tabora", "version": "1.0.1.101", "permissions": ["storage", "contextMenus", "cookies", "bookmarks", "topSites", "notifications", "downloads", "menus.overrideContext", "identity"], "action": {"default_popup": "index.html"}, "chrome_url_overrides": {"newtab": "index.html"}, "options_ui": {"page": "index.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tabora@tabora.app"}}, "web_accessible_resources": [{"resources": ["assets/lottie/*.json"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "assets/icon16.webp", "48": "assets/icon48.webp", "128": "assets/icon128.webp"}}