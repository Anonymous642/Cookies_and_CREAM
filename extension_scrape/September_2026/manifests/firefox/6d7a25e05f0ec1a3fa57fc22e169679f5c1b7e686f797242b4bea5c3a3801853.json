{"manifest_version": 2, "name": "GCP Color Bar", "version": "0.1.0", "description": "Colors the GCP header according to the current project", "permissions": ["activeTab", "storage", "https://console.cloud.google.com/*"], "browser_specific_settings": {"gecko": {"id": "gcp-color-bar@cuvellier.fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://console.cloud.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "GCP Color Bar Configuration"}, "icons": {"32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "64": "icons/icon-64.svg", "96": "icons/icon-96.svg", "128": "icons/icon-128.png"}}