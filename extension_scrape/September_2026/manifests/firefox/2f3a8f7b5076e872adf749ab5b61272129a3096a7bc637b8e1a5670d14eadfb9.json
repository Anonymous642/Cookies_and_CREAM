{"manifest_version": 3, "name": "PoliCanvas", "version": "2.0.0", "description": "Lightweight Browser Extension that prevents re-downloading files from Canvas LMS by caching them locally.", "permissions": ["downloads", "storage", "webRequest", "webRequestBlocking"], "host_permissions": ["https://*.instructure.com/*", "https://aulavirtual.espol.edu.ec/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.instructure.com/*", "https://aulavirtual.espol.edu.ec/*"], "js": ["content.js", "loader.js"], "css": ["loader.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["loader.html", "icon-32.png"], "matches": ["https://*.instructure.com/*", "https://aulavirtual.espol.edu.ec/*"]}], "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "default_title": "PoliCanvas", "default_popup": "popup.html"}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "policanvas@policanvas.app", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}}