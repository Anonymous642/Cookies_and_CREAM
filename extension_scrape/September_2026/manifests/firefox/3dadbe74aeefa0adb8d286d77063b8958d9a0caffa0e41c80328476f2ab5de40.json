{"manifest_version": 3, "name": "Multi Copy Cat", "version": "1.0", "description": "A right panel extension for copying and managing multiple text snippets", "permissions": ["activeTab", "contextMenus", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "action": {"default_title": "Multi Copy Cat"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "commands": {"copy-selected-text": {"suggested_key": {"default": "Ctrl+Shift+C", "mac": "Command+Shift+C"}, "description": "Copy selected text to Multi Copy Cat"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle Multi Copy Cat panel"}, "clear-all": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Clear all texts in Multi Copy Cat"}}, "browser_specific_settings": {"gecko": {"id": "multicopycat@example.com", "strict_min_version": "109.0"}}}