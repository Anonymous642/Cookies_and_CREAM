{"manifest_version": 3, "name": "ReadIntent", "version": "0.1.0", "description": "Send the current article page or a custom URL for extraction.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup.html", "default_title": "ReadIntent", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "background": {"type": "module", "service_worker": "src/background.js", "scripts": ["src/background.js"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "@readintent.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}