{"manifest_version": 2, "name": "Cookie Dismisser", "version": "3.5.6.2", "description": "Removes cookie pop-ups per site with a counter and a per-domain off switch.", "browser_specific_settings": {"gecko": {"id": "{656a865b-867d-4f49-80eb-29c4f8b701c6}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "graphics/icon32.png", "48": "graphics/icon48.png", "64": "graphics/icon64.png", "96": "graphics/icon96.png", "128": "graphics/icon128.png"}, "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["core/background.js"], "persistent": false}, "browser_action": {"default_popup": "core/popup.html", "default_title": "Cookie Dismisser", "default_icon": {"32": "graphics/icon32.png", "48": "graphics/icon48.png", "64": "graphics/icon64.png", "96": "graphics/icon96.png", "128": "graphics/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["core/core.js", "core/content.js"], "run_at": "document_idle", "all_frames": false}]}