{"manifest_version": 3, "name": "DevFormFiller", "version": "1.0.0", "description": "Automatically fill web forms with test data for developers", "author": "Your Name", "homepage_url": "https://github.com/yourusername/devformfiller", "browser_specific_settings": {"gecko": {"id": "devformfiller@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "DevFormFiller", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "commands": {"toggle-fill-form": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Automatically fill form with test data"}}}