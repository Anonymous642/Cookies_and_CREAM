{"manifest_version": 3, "name": "Vidward - YouTube Parental Controls", "short_name": "Vidward", "description": "YouTube parental controls for families and schools. Block channels, videos, and Shorts, and set every rule from one dashboard.", "version": "0.1.1", "background": {"scripts": ["js/shared/identity.js", "js/shared/config.js", "js/background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@vidward.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "action": {"default_title": "Vidward", "default_popup": "html/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "scripting", "alarms"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["js/seed.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "js": ["js/shared/identity.js", "js/content/nav_gate.js", "js/content/watch_tracker.js", "js/content/dom_state.js", "js/content/dom_helpers.js", "js/content/dom_extractors.js", "js/content/dom_fallback.js", "js/content/bridge_injection.js", "js/content/bridge_settings.js", "js/content/handle_resolver.js", "js/content_bridge.js"], "run_at": "document_start", "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["js/injector.js", "js/filter_logic.js", "js/seed.js", "js/shared/identity.js", "html/blocked.html"], "matches": ["*://*.youtube.com/*"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["*://*.youtube.com/*", "https://vidward.app/*"]}