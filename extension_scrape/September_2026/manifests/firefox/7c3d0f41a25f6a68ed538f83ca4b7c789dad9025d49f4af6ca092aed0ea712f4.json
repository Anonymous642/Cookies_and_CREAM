{"manifest_version": 3, "name": "Search Focus Filter", "short_name": "SearchFilter", "version": "1.4.3", "description": "Surgically hide unwanted search results, domains, and keywords across Google, Bing, and deeply filter YouTube.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.google.com/*", "*://*.google.co.in/*", "*://*.google.co.uk/*", "*://*.google.ca/*", "*://*.google.com.au/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*", "*://*.search.yahoo.com/*", "*://search.brave.com/*", "*://*.youtube.com/*"], "incognito": "spanning", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Search Focus Filter"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.google.co.in/search*", "*://*.google.co.uk/search*", "*://*.google.ca/search*", "*://*.google.com.au/search*", "*://*.bing.com/search*", "*://*.duckduckgo.com/*", "*://*.search.yahoo.com/search*", "*://search.brave.com/*", "*://*.youtube.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start"}], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "searchfocusfilter@custom.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}