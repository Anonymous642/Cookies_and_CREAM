{"manifest_version": 3, "name": "Smart Deep Tab Navigator", "version": "2.0.0", "description": "AI-powered deep link prediction with adaptive sequences, temporal patterns, and semantic clustering. Privacy-first learning.", "permissions": ["storage", "tabs", "history", "idle", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Smart Deep Tab Navigator", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "smart-deep-tab@navigator.extension", "strict_min_version": "109.0"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "commands": {"open-dashboard": {"suggested_key": {"default": "Alt+D"}, "description": "Open Smart Deep Tab Dashboard"}, "quick-search": {"suggested_key": {"default": "Alt+S"}, "description": "Quick search deep links"}}}