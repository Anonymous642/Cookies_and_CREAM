{"manifest_version": 2, "name": "Zhiro: Read It Later", "description": "Save articles and webpages to your Zhiro library with one click", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "https://zhiro.in/*", "https://*.zhiro.in/*"], "browser_specific_settings": {"gecko": {"id": "extension@zhiro.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Zhiro - Save to Library", "default_popup": "popup.html"}}