{"manifest_version": 3, "name": "YouTube SpeedUp", "version": "1.2.3", "description": "A simple Firefox extension to speed up YouTube videos via scroll on a speedometer icon.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "exclude_matches": ["*://music.youtube.com/*"], "js": ["index.js"], "run_at": "document_idle"}], "permissions": ["storage"], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "{05528bd5-3341-4084-bac0-c3a61d568e44}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}