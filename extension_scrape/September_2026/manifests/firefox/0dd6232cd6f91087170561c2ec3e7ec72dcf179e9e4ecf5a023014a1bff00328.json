{"manifest_version": 3, "name": "Scroll Sense \u2014 Short-Form Time Tracker", "version": "1.0.0", "description": "Tracks daily time spent on short-form content sites and adds friction (spacing, break reminders, grayscale) to make doomscrolling harder.", "browser_specific_settings": {"gecko": {"id": "scroll-sense@local.extension", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting"], "optional_host_permissions": ["*://*/*"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.facebook.com/*"], "background": {"scripts": ["sites.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Scroll Sense", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.reddit.com/*", "*://*.facebook.com/*"], "js": ["sites.js", "content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}]}