{"manifest_version": 3, "name": "SponsorShield - Amazon Ad Blocker", "version": "1.0", "description": "Tired of guessing which results are ads? SponsorShield just hides them.", "browser_specific_settings": {"gecko": {"id": "sponsorshield@sponsorshield.com", "strict_min_version": "136.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.in/*", "*://*.amazon.com.au/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.nl/*", "*://*.amazon.co.jp/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*"], "action": {"default_popup": "popup.html", "default_title": "SponsorShield for Amazon", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.bundle.js", "scripts": ["background.bundle.js"], "preferred_environment": ["service_worker", "document"]}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.in/*", "*://*.amazon.com.au/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.nl/*", "*://*.amazon.co.jp/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*"], "js": ["content.bundle.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}