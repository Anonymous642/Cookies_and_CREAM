{"manifest_version": 3, "name": "TrueDuration Adjuster", "description": "Adjust video playback speed to perfectly fit movies and shows into your specific available time slots.", "version": "1.0.0", "author": "StreamFlow Labs", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.youtube.com/*", "https://*.netflix.com/*", "https://*.vimeo.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "truedurationadjuster@streamflowlabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}