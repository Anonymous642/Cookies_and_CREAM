{"manifest_version": 3, "name": "Notes Sidebar \u2013 Per Site & Page", "version": "1.0.1", "description": "Ghi ch\u00fa theo site/page. Popup qu\u1ea3n l\u00fd ghi ch\u00fa, panel n\u1ed5i tr\u00ean trang, menu chu\u1ed9t ph\u1ea3i \u0111\u1ec3 th\u00eam nhanh \u0111o\u1ea1n b\u00f4i \u0111en. L\u01b0u t\u1ef1 \u0111\u1ed9ng v\u00e0o storage.sync.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "tabs", "scripting", "storage", "contextMenus", "downloads"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "notes-sidebar-demo@example.com", "strict_min_version": "109.0"}}}