{"manifest_version": 3, "name": "Prompt Tuner", "version": "0.0.2", "description": "Boost your AI chats with ready-made templates\u2014set tone, style, and goals to get clearer, more useful answers every time.", "action": {"default_icon": "./assets/icon-512.png"}, "icons": {"16": "./assets/icon-512.png", "48": "./assets/icon-512.png", "128": "./assets/icon-512.png"}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/app"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "prompttuner@jairoblatt.com"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}