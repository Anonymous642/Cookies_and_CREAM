{"manifest_version": 2, "name": "Limpiador del Navegador", "version": "1.1", "description": "Deja el navegador como de f\u00e1brica borrando historial, cach\u00e9, cookies y todos los datos \u2014 sin tocar los marcadores.", "author": "Will", "browser_specific_settings": {"gecko": {"id": "limpiador-firefox@will.dev", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["browsingData", "tabs", "notifications"], "browser_action": {"default_popup": "popup.html", "default_title": "Limpiar Navegador", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}