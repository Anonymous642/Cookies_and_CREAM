{"manifest_version": 3, "name": "QueueMark \u2013 Read Later for Firefox", "short_name": "QueueMark", "version": "0.1.0", "description": "Save pages to a private Firefox reading queue, then find, finish, and share them without another account.", "author": "End of the End", "icons": {"16": "icons/queuemark.svg", "32": "icons/queuemark.svg", "48": "icons/queuemark.svg", "64": "icons/queuemark.svg", "96": "icons/queuemark.svg", "128": "icons/queuemark.svg"}, "permissions": ["bookmarks", "menus", "storage", "activeTab"], "incognito": "not_allowed", "background": {"scripts": ["src/core.js", "src/background.js"]}, "action": {"default_title": "Open QueueMark", "default_icon": "icons/queuemark.svg", "default_popup": "popup/popup.html"}, "commands": {"save-current-page": {"description": "Save the current page to QueueMark"}}, "browser_specific_settings": {"gecko": {"id": "queuemark@endoftheend", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}