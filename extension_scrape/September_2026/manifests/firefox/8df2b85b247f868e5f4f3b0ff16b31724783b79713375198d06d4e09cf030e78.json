{"manifest_version": 3, "name": "refhub ext", "version": "2.0.0", "description": "capture and save to your refhub vault.", "action": {"default_title": "refhub Capture", "default_popup": "popup.html", "default_icon": {"16": "icons/refhub-16.png", "32": "icons/refhub-32.png", "48": "icons/refhub-48.png", "128": "icons/refhub-128.png"}}, "icons": {"16": "icons/refhub-16.png", "32": "icons/refhub-32.png", "48": "icons/refhub-48.png", "128": "icons/refhub-128.png"}, "background": {"scripts": ["js/background.js"], "type": "module"}, "options_page": "options.html", "permissions": ["activeTab", "storage", "scripting", "cookies"], "host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["build-info.json"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "refhub-capture-prototype@refhub.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}