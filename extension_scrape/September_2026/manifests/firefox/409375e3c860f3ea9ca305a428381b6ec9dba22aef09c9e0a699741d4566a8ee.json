{"manifest_version": 2, "name": "Remote Control", "version": "4.4.1", "description": "Remotely view and control your Firefox browser from any device via a secure dashboard.", "applications": {"gecko": {"id": "remote-control@example.com", "strict_min_version": "109.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "activeTab", "storage", "<all_urls>", "https://live.jarvisonlineweb.in/*", "http://127.0.0.1:8008/*", "http://localhost:8008/*"], "background": {"scripts": ["config.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Remote Control", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}