{"manifest_version": 3, "name": "Smoss Time Tracker", "description": "Track and limit daily time on selected websites.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "time-limiter@smoss.dev", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/warning.js"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "tabs", "idle", "scripting"], "host_permissions": ["<all_urls>"]}