{"manifest_version": 2, "name": "Playlist Utils", "version": "0.3.0", "description": "Reorder YouTube playlists: sort presets plus manual drag and drop, remembered per playlist.", "browser_specific_settings": {"gecko": {"id": "playlist-utils@johneric.local", "strict_min_version": "115.0"}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["storage", "*://www.youtube.com/*", "*://m.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}]}