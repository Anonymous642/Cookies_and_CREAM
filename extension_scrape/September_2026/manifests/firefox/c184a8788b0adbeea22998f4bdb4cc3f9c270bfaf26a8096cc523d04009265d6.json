{"manifest_version": 3, "name": "JobsFilter", "version": "1.0.0", "description": "Hide unwanted LinkedIn jobs automatically.", "permissions": ["storage"], "host_permissions": ["https://www.linkedin.com/*"], "browser_specific_settings": {"gecko": {"id": "jobsfilter@yoyo.video", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "JobsFilter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}