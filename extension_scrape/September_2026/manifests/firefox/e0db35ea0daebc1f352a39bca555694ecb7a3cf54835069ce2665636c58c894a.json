{"manifest_version": 2, "name": "A Stock Keyword Search", "description": "Search multiple keywords on Adobe Stock and download results as a CSV file.", "version": "24.9.4.1", "permissions": ["activeTab", "tabs", "storage", "downloads"], "content_scripts": [{"matches": ["https://stock.adobe.com/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}}, "icons": {"16": "icons/icon_16.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "astock-keyword-search@localhost", "strict_min_version": "128.0"}}}