{"manifest_version": 3, "name": "RelayShield", "version": "1.1.0", "description": "Manage your RelayShield email aliases from any website.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "RelayShield"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://relayshield.io/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "options_page": "src/options/options.html", "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://relayshield.io/*", "http://*/*", "https://*/*"], "background": {"scripts": ["src/background/index.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "relay-shield@relayshield.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}