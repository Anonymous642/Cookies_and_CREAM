{"manifest_version": 3, "name": "LifeZeus Helper", "version": "1.3.4", "description": "Blocks distracting sites during LifeZeus focus sessions and syncs website usage analytics to the LifeZeus app.", "permissions": ["declarativeNetRequest", "storage", "sessions", "alarms", "tabs", "webNavigation", "idle"], "background": {"scripts": ["buildConfig.js", "browser-polyfill.js", "controlSync.js", "telemetryAggregation.js", "trackingRuntime.js", "trackingLedger.js", "background.js"]}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "lifezeus-helper@lifezeus.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}, "content_scripts": [{"matches": ["https://app.lifezeus.com/*", "https://*.app.lifezeus.com/*"], "js": ["buildConfig.js", "browser-polyfill.js", "contentBridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "browser-polyfill.js", "public/images/background.jpg"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "public/images/icon16.png", "48": "public/images/icon48.png", "128": "public/images/icon128.png"}}, "icons": {"16": "public/images/icon16.png", "48": "public/images/icon48.png", "128": "public/images/icon128.png"}}