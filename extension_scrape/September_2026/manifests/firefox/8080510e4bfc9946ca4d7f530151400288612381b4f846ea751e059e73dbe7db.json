{"manifest_version": 3, "name": "Bookmark Folder Icons", "version": "0.1.1", "description": "Changes the extension toolbar icon based on the folder that contains the current page's bookmark.", "permissions": ["bookmarks", "storage", "tabs"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Bookmark Folder Icons", "default_popup": "popup.html", "default_icon": {"16": "icon-default.svg", "32": "icon-default.svg", "48": "icon-default.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icon-extension.svg", "96": "icon-extension.svg"}, "browser_specific_settings": {"gecko": {"id": "bookmark-folder-icons@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}