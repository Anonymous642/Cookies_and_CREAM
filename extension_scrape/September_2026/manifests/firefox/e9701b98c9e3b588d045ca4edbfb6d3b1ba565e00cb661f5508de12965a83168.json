{"manifest_version": 2, "name": "FocusBlind", "version": "1.1", "description": "Blurs everything on a page except the paragraph your cursor is hovering over. Forces deep reading.", "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "focusblind-md-2026@salter.studio", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}