{"manifest_version": 3, "name": "Bibliodrina", "description": "Bookmark management with bibliodrina", "version": "0.1.0", "author": "Thorben G\u00fcnther <admin@xenrox.net>", "permissions": ["activeTab", "nativeMessaging", "tabs", "notifications"], "background": {"scripts": ["background.js"]}, "commands": {"bibliodrina-open-bookmark-new-tab": {"suggested_key": {"default": "Alt+Shift+Space"}, "description": "Open bibliodrina bookmark in new tab"}, "bibliodrina-open-bookmark-current-tab": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open bibliodrina bookmark in current tab"}, "bibliodrina-add-bookmark": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Save bookmark to bibliodrina"}, "bibliodrina-remove-bookmark": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Remove bookmark from bibliodrina"}}, "browser_specific_settings": {"gecko": {"id": "bibliodrina@xenrox.net"}}}