{"manifest_version": 3, "name": "OpenTab", "version": "1.1", "description": "Add links to your OpenTab collection", "browser_specific_settings": {"gecko": {"id": "opentab-dev@superdev.one"}}, "permissions": ["activeTab", "storage", "scripting", "tabs", "bookmarks", "commands", "alarms"], "background": {"scripts": ["assets/js/background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/16.png", "32": "assets/icons/32.png"}}, "commands": {"add-tab": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Add the current tab to bookmarks"}, "sync-bookmarks": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sync bookmarks"}}, "web_accessible_resources": [{"resources": ["levelup.html"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html"}, "icons": {"16": "assets/icons/16.png", "32": "assets/icons/32.png", "64": "assets/icons/64.png", "128": "assets/icons/128.png"}}