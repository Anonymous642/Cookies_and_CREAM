{"manifest_version": 3, "name": "YT - Your Tabs", "version": "5.1.1", "description": "A customizable Firefox New Tab. customize everything", "author": "Jigistar", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "96": "assets/icon96.png", "128": "assets/icon128.png"}, "permissions": ["storage", "unlimitedStorage"], "optional_permissions": ["topSites"], "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"homepage": "newtab.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https: blob: data:;"}, "browser_specific_settings": {"gecko": {"id": "yourtabs@addons.mozilla.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo"]}}}}