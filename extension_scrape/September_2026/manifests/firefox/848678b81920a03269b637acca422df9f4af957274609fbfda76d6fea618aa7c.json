{"manifest_version": 3, "name": "Find Tab", "description": "Replicates Chrome's 'Find Tab' feature", "version": "1.2.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabs", "sessions"], "browser_specific_settings": {"gecko": {"id": "@find-tab.jack", "strict_min_version": "109.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Default Popup Title"}, "commands": {"togglePopup": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Opens the popup"}}}