{"manifest_version": 3, "name": "Aar318's Real-Time Sports Score HUD", "version": "1.1.0.0", "description": "Shows a compact, movable live-score HUD for selected sports on ordinary webpages.", "permissions": ["storage", "alarms", "contextMenus", "scripting", "notifications"], "host_permissions": ["https://site.api.espn.com/*", "https://site.web.api.espn.com/*", "https://statsapi.mlb.com/*", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["game-details-ui.js", "hud.js"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/icon-16.png", "icons/icon-32.png", "icons/icon-48.png", "icons/icon-128.png"], "matches": ["<all_urls>"]}], "background": {"scripts": ["game-details-data.js", "background.js"]}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "toolbar.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Open Aar318's Sports Score HUD"}, "browser_specific_settings": {"gecko": {"id": "sports-score-hud@aar318", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}