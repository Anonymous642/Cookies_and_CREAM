{"manifest_version": 2, "name": "Confusion Point Highlighter", "version": "1.3", "description": "Detects potential confusion points during reading and highlights difficult sections for review.", "permissions": ["storage", "tabs", "notifications", "activeTab"], "background": {"scripts": ["confusionEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "Confusion Point Highlighter"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Confusion-Point-Highlighter", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}