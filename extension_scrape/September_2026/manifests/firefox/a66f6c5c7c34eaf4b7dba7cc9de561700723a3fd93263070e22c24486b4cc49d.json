{"manifest_version": 3, "name": "voluMeet: Sound Control for Meet", "short_name": "voluMeet", "version": "1.1.7", "description": "Adjust the volume you hear on Google Meet (global and per-participant) with boost up to 300%.", "browser_specific_settings": {"gecko": {"id": "volumeet@lookas.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage"], "host_permissions": ["https://meet.google.com/*"], "action": {"default_popup": "popup.html", "default_title": "voluMeet", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "world": "ISOLATED"}]}