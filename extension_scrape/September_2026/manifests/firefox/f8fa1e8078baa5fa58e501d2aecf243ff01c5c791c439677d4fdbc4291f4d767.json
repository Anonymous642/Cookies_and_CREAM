{"manifest_version": 3, "name": "AI Actions", "version": "1.5.17", "description": "Summarize, translate, and fact-check anything you see online with one right-click. No copying, no tab switching. Works on pages, videos, links, and selected text. Supports ChatGPT, Gemini, Copilot, Grok, Mistral, and Qwen.", "icons": {"512": "icons/AI-Actions.png"}, "action": {"default_title": "AI Actions", "default_icon": "icons/AI-Actions.png", "default_popup": "AI-Actions_Settings.html"}, "sidebar_action": {"default_title": "AI Actions", "default_panel": "AI-Actions_Settings.html", "default_icon": "icons/AI-Actions.png"}, "background": {"scripts": ["aia-background.js"]}, "permissions": ["activeTab", "menus", "scripting", "storage", "tabs"], "host_permissions": ["*://chat.mistral.ai/*", "*://chat.qwen.ai/*", "*://chatgpt.com/*", "*://copilot.microsoft.com/*", "*://gemini.google.com/*", "*://grok.com/*"], "content_scripts": [{"matches": ["*://chat.mistral.ai/*", "*://chat.qwen.ai/*", "*://chatgpt.com/*", "*://copilot.microsoft.com/*", "*://gemini.google.com/*", "*://grok.com/*"], "js": ["aia-bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ai-actions@yooefdoost.com", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}