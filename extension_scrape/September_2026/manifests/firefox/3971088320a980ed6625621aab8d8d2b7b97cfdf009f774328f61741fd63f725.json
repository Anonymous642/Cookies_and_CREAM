{"manifest_version": 3, "name": "Alt+Q Tab-Switcher", "version": "1.0.2", "description": "Tab-Wechsel exakt wie Alt+Tab unter Windows: Hotkey halten, wiederholt dr\u00fccken, loslassen wechselt zum ausgew\u00e4hlten Tab.", "browser_specific_settings": {"gecko": {"id": "alt-q-tab-switcher@local.addon", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/shared.js", "src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["src/shared.js", "src/overlay.js"]}], "action": {"default_title": "Tab-Switcher (Alt+Q)", "default_popup": "ui/popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "commands": {"cycle-forward": {"suggested_key": {"default": "Alt+Q"}, "description": "Tab-Switcher \u00f6ffnen / vorw\u00e4rts bl\u00e4ttern"}, "cycle-backward": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Tab-Switcher r\u00fcckw\u00e4rts bl\u00e4ttern"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}