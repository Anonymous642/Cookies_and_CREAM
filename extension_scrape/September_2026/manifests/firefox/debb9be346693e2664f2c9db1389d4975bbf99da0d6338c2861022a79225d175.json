{"manifest_version": 3, "name": "Auto Default/Large Toggler", "version": "1.2.0", "description": "Alternately clicks page elements labeled Default and Large at a user-selected interval. Controlled from the Firefox toolbar.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Auto Default/Large Toggler", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "@auto-default-large-toggler", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}