{"manifest_version": 3, "name": "RTPS Bihar Autofill", "version": "3.1.4", "description": "Auto-fills Income/Caste/Residence certificate forms on serviceonline.bihar.gov.in from a saved profile \u2014 with Applicant Photo & Annexure Document Auto-Fill!", "author": "RTPS Autofill", "browser_specific_settings": {"gecko": {"id": "rtps-bihar-autofill-new-2026@addons.mozilla.org", "strict_min_version": "142.0", "strict_min_version_android": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab", "tabs", "unlimitedStorage"], "host_permissions": ["*://serviceonline.bihar.gov.in/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://serviceonline.bihar.gov.in/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "RTPS Bihar Autofill", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}}