{"manifest_version": 2, "name": "Ratatoskr", "version": "1.1.4", "description": "Select text on any page and open it in a configurable URL template. Supports multiple named templates and comma-separated multi-tab opening.", "browser_specific_settings": {"gecko": {"id": "{46f8946f-2464-4b04-b523-c30e7ef11d88}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "storage", "menus", "clipboardWrite"], "background": {"scripts": ["src/template-utils.js", "src/background.js"]}, "browser_action": {"default_title": "Ratatoskr", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}