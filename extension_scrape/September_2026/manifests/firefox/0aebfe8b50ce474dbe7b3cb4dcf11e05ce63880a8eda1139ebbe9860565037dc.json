{"manifest_version": 3, "name": "X-Anti-Slop", "description": "Hide posts on X using your own regular-expression filters.", "permissions": ["storage"], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_icon": {"16": "icons/16.png", "32": "icons/32.png"}, "default_title": "X-Anti-Slop filters", "default_popup": "options.html", "default_area": "navbar"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["options.html", "icons/48.png"], "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"]}], "content_scripts": [{"matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "version": "0.1.0", "browser_specific_settings": {"gecko_android": {"strict_min_version": "142.0"}, "gecko": {"id": "x-anti-slop@tasarren.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}