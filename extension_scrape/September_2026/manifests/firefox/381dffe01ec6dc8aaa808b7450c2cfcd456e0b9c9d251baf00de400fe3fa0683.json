{"manifest_version": 3, "name": "One Tap Blocker", "version": "1.1.0", "description": "Blocks Google One Tap sign-in prompts across websites, with per-site allow controls.", "permissions": ["storage", "activeTab"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "One Tap Blocker", "default_icon": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}}, "icons": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "browser_specific_settings": {"gecko": {"id": "one-tap-blocker@local", "data_collection_permissions": {"required": ["none"]}}}}