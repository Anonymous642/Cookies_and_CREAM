{"manifest_version": 2, "name": "Threshold", "version": "1.7.4", "description": "A mindful pause before distracting sites, with a timed session and automatic re-block.", "permissions": ["storage", "tabs", "webNavigation", "alarms", "clipboardWrite", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "web_accessible_resources": ["block.html"], "browser_specific_settings": {"gecko": {"id": "threshold@localhost", "strict_min_version": "58.0"}}}