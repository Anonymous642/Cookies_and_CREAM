{"manifest_version": 3, "name": "autojot-browser-extension", "description": "Autojot anywhere", "version": "1.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Autojot"}, "browser_specific_settings": {"gecko": {"id": "support.extension@autojot.com"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}