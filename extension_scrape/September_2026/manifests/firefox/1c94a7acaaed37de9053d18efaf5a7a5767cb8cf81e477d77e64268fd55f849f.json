{"manifest_version": 3, "name": "Grimoire", "version": "0.2.0", "description": "Offline prompt library and version control", "homepage_url": "https://github.com/ltbatis/grimoire-prompts", "icons": {"16": "icons/grimoire.svg", "32": "icons/grimoire.svg", "48": "icons/grimoire.svg", "96": "icons/grimoire.svg", "128": "icons/grimoire.svg"}, "permissions": ["storage", "clipboardWrite", "activeTab", "contextMenus"], "action": {"default_title": "Grimoire", "default_icon": {"16": "icons/grimoire.svg", "32": "icons/grimoire.svg"}, "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+G"}, "description": "Open Grimoire"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "grimoire-prompts-v2@ltbatis.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}