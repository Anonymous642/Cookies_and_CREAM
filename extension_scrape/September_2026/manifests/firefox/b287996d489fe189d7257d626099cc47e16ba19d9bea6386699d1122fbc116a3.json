{"manifest_version": 3, "name": "Tanish Ultimate Browser Toolkit", "short_name": "TUBT", "version": "1.0.0", "description": "One Extension. Everything You Need. \u2014 The ultimate privacy, security, productivity & developer toolkit by Tanish Sareen.", "author": "Tanish Sareen", "homepage_url": "https://github.com/Tanish-sareen/tubt", "icons": {"16": "public/icons/icon16.png", "32": "public/icons/icon32.png", "48": "public/icons/icon48.png", "96": "public/icons/icon96.png", "128": "public/icons/icon128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "default_title": "Tanish Ultimate Browser Toolkit"}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_start", "all_frames": true}], "sidebar_action": {"default_panel": "sidebar/index.html", "default_title": "TUBT Sidebar", "default_icon": "public/icons/icon48.png"}, "options_ui": {"page": "options/index.html", "browser_style": false, "open_in_tab": true}, "permissions": ["storage", "tabs", "activeTab", "webRequest", "webNavigation", "downloads", "notifications", "clipboardRead", "clipboardWrite", "bookmarks", "history", "sessions", "contextMenus", "alarms", "cookies", "identity", "scripting", "declarativeNetRequest", "declarativeNetRequestFeedback", "tabHide"], "optional_permissions": ["nativeMessaging"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["content/injected.js", "content/styles/*.css", "public/icons/*", "public/assets/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Open TUBT Popup"}, "open-sidebar": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle TUBT Sidebar"}, "open-command-palette": {"suggested_key": {"default": "Alt+Shift+P"