{"manifest_version": 2, "name": "Claude Usage Bar", "version": "1.0.0", "description": "Adds a compact usage indicator next to the model selector on Claude.ai, showing your current session and weekly usage limits at a glance. Click to expand the full breakdown.", "developer": {"name": "Apolonia"}, "browser_specific_settings": {"gecko": {"id": "claude-usage-bar@apolonia", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["*://claude.ai/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["https://claude.ai/*"]}