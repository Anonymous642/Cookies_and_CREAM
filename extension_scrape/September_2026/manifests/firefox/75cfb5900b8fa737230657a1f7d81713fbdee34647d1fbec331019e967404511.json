{"manifest_version": 2, "name": "Hugging Face Helper (unofficial)", "version": "1.0.0", "description": "Quick helper to search Hugging Face Hub/Spaces for selected text or current page URL. Unofficial \u2014 not affiliated with Hugging Face.", "permissions": ["activeTab", "tabs", "storage"], "icons": {}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Hugging Face Helper", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "css": ["inject.css"]}], "applications": {"gecko": {"id": "huggingface-helper@example", "strict_min_version": "60.0"}}}