{"manifest_version": 3, "name": "Panely", "version": "1.1.6", "description": "A sidebar of stackable panes: your Bookmarks Toolbar, your open tabs, and a simple task checklist. Resize, collapse, reorder or switch off each pane \u2014 it all syncs across your computers.", "browser_specific_settings": {"gecko": {"id": "panely@amityweb.co.uk", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["bookmarks", "tabs", "storage"], "sidebar_action": {"default_title": "Panely", "default_panel": "sidebar/panel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "action": {"default_title": "Toggle Panely sidebar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Toggle the Panely sidebar"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}