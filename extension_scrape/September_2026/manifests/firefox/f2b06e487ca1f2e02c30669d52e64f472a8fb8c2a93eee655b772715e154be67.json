{"manifest_version": 3, "name": "YourThreads", "version": "1.0.1", "description": "Track RP threads from Tumblr posts \u2014 a one-click Track button, a whose-turn panel, and notes. Fully local: no account, no server.", "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.tumblr.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED"}, {"matches": ["https://www.tumblr.com/*"], "js": ["yourthreads.js"], "run_at": "document_idle", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["assets/colour-of-the-sky.jpg", "assets/anon-runner.png", "assets/logo.png"], "matches": ["https://www.tumblr.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "YourThreads", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "yourthreads@yourthreads", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://www.tumblr.com/*"]}