{"manifest_version": 2, "name": "Quick Karaoke Mode", "version": "1.3", "description": "Enable karaoke mode for online videos by reducing vocals and controlling playback.", "permissions": ["activeTab", "tabs", "storage"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "browser_specific_settings": {"gecko": {"id": "@Quick-Karaoke-Mode", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}