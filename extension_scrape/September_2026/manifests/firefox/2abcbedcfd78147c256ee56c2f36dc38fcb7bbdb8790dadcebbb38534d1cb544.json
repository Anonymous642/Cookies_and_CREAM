{"manifest_version": 2, "name": "MemexNG - Semantic History Search", "description": "Never lose what you've read. Semantic search for your browsing history \u2014 100% private, zero cloud, on-device AI.", "version": "0.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "history", "unlimitedStorage", "contextMenus", "bookmarks", "alarms", "<all_urls>"], "omnibox": {"keyword": "memex"}, "web_accessible_resources": ["*.wasm", "*.onnx", "models/**"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "MemexNG", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/annotations.js", "content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "memexng@search.memex", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": "script-src 'wasm-unsafe-eval' 'self'; connect-src 'self' https: http:"}