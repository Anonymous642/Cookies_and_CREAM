{"manifest_version": 3, "name": "Hacklets", "version": "0.2.0", "description": "Search for and use commands and bookmarks with ease", "browser_specific_settings": {"gecko": {"id": "hacklets@ricobl.addons", "strict_min_version": "153.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["bookmarks", "activeTab", "storage", "scripting", "tabs"], "optional_permissions": ["userScripts"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"show-bookmarks-palette": {"suggested_key": {"default": "Ctrl+P", "mac": "Command+P"}, "description": "Show bookmarks palette"}, "show-commands-palette": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Show commands palette"}, "repeat-last-command": {"suggested_key": {"default": "Ctrl+Period", "mac": "Command+Period"}, "description": "Repeat last executed command"}}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "default-src 'self'; connect-src 'self' https:; img-src 'self' chrome://favicon https: data:; style-src 'self' 'unsafe-inline'; object-src 'none'"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "content_scripts": [{"run_at": "document_start", "matches": ["<all_urls>"], "js": ["content-script.js"]}], "web_accessible_resources": [{"resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": []}]}