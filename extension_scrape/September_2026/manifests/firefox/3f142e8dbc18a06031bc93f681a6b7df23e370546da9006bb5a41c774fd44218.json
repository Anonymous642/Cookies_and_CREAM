{"manifest_version": 2, "name": "Obfuscatron", "version": "0.5.2", "description": "Spoofs tracking headers, cookies and fingerprint tricks so websites can't follow you.", "homepage_url": "https://github.com/your-name/obfuscatron", "author": "Your Name", "applications": {"gecko": {"id": "obfuscatron@example.com", "strict_min_version": "109.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "ui/popup.html", "default_icon": {"48": "icons/48.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["<all_urls>", "storage", "cookies", "alarms", "webRequest", "webRequestBlocking", "browsingData"], "optional_permissions": ["nativeMessaging"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/fingerprint.js"], "run_at": "document_start"}], "content_security_policy": "script-src 'self'; object-src 'none';", "default_locale": "en", "support_url": "https://buymeacoffee.com/tapeshack", "licenses": {"type": "MPL-2.0"}}