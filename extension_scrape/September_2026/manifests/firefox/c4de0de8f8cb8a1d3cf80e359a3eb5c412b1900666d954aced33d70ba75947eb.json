{"manifest_version": 3, "name": "SavedIt - Save Links", "version": "1.1.8", "description": "Save pages to your private SavedIt library with optional collections, notes, and tags.", "permissions": ["activeTab", "storage", "scripting", "alarms", "tabs"], "host_permissions": ["https://api.saveditapp.com/*"], "action": {"default_popup": "popup.html", "default_title": "SavedIt", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["config.js", "browser-api.js", "async-lock.js", "pending-save-store.js", "session-auth.js", "save-queue.js", "web-auth-state.js", "firefox-auth-tabs.js", "background.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+U", "mac": "Alt+Shift+U"}, "description": "Open SavedIt to save current page"}}, "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "firefox@saveditapp.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}