{"manifest_version": 2, "name": "MXroute Forwarder", "description": "A simple MXroute email forwarder extension for browsers.", "version": "0.0.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "https://api.mxroute.com/*"], "browser_specific_settings": {"gecko": {"id": "mxroute-forwarder@code-fabrik.ch", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}