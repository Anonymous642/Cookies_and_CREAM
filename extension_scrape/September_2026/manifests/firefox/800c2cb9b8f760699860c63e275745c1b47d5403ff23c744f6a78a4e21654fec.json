{"manifest_version": 2, "name": "Stop brainrot", "version": "1.2", "description": "Block YouTube Shorts, TikTok, Facebook Reels, and Instagram Reels to avoid distractions", "permissions": ["storage", "https://www.youtube.com/*", "https://www.tiktok.com/*", "https://www.facebook.com/*", "https://www.instagram.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"128": "icon.png"}}, "icons": {"128": "icon.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://www.tiktok.com/*", "*://www.facebook.com/*", "*://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "stop-brainrot-extension@mozilla", "strict_min_version": "91.0"}}}