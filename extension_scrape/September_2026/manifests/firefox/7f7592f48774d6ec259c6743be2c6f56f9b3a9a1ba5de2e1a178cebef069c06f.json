{"manifest_version": 3, "name": "De-Reddit", "version": "1.0.0", "description": "Blocks your Reddit feed(s) but still lets you read individual posts, e.g. ones you find via Google.", "browser_specific_settings": {"gecko": {"id": "dereddit@pomodoro_jar", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon.png", "64": "icons/icon@2x.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "De-Reddit settings"}}