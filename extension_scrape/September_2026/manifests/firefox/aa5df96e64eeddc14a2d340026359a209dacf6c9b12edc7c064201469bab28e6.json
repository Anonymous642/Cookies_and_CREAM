{"manifest_version": 3, "name": "Reddit Lite", "version": "1.0.2", "description": "Makes new Reddit lighter and faster: stops media autoplay, frees memory from off-screen video, skips rendering off-screen posts, blocks Reddit's own telemetry, and optionally hides clutter.", "browser_specific_settings": {"gecko": {"id": "reddit-lite@local.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "declarativeNetRequest", "activeTab", "alarms", "notifications"], "host_permissions": ["https://live.dodopayments.com/*"], "declarative_net_request": {"rule_resources": [{"id": "telemetry_block", "enabled": false, "path": "rules/telemetry_block.json"}]}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.reddit.com/*", "*://sh.reddit.com/*", "*://reddit.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Reddit Lite"}}