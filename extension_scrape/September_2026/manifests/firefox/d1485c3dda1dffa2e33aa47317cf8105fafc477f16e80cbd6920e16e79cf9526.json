{"manifest_version": 2, "name": "Image Alt Peek", "version": "1.2.0", "description": "Audit image accessibility at a glance. Overlays every image on the page with its alt text, or a red warning when alt is missing, and counts how many images lack a description. Toggle overlays on and off.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{63b0c645-a368-4d59-9d0a-abc2ac4bf320}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Image Alt Peek", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}