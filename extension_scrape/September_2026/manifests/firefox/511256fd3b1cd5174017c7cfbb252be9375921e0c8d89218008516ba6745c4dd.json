{"manifest_version": 3, "name": "Image Link Opener & Skipper", "version": "1.0", "description": "Trova e apre in background link specifici, e salta i redirect in automatico.", "permissions": ["activeTab", "tabs", "scripting"], "host_permissions": ["*://*.imgdrive.net/*", "*://*.imgtaxi.com/*", "*://*.imgadult.com/*", "*://*.imagetwist.com/*"], "action": {"default_title": "Estrai e apri link"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.imgdrive.net/*", "*://*.imgtaxi.com/*", "*://*.imgadult.com/*"], "js": ["autoclick.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "image-opener-skipper@tuodominio.it", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}