{"manifest_version": 3, "name": "BrowseMind", "version": "1.0.1", "description": "Browse calmly and focus better. Track website time, set healthy limits, and reduce distractions.", "homepage_url": "https://xarrays.com", "permissions": ["tabs", "storage", "idle", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "BrowseMind", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "dashboard/dashboard.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "browsemind@xarrays.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}