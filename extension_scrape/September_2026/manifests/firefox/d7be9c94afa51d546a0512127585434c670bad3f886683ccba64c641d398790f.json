{"manifest_version": 3, "name": "Anti-YouTube Calendar", "version": "1.0", "description": "Automatically hides 'Anyone watching in 20XX?' comments on YouTube.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://m.youtube.com/watch*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "anti-youtube-calendar@cycastic.net", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}