{"manifest_version": 3, "name": "Handybox", "version": "1.4.0", "description": "Handybox is a clean, lightweight, ad-free collection of developer tools. No ads, no accounts, no clutter \u2014 open it, use it, move on.", "browser_specific_settings": {"gecko": {"id": "handybox@addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_icon": "icons/icon-48.png", "default_title": "Handybox", "default_popup": "popup/popup.html"}}