{"manifest_version": 3, "name": "Comic Collector", "version": "1.3.2", "description": "Organize manga/manhwa chapters into nested collections, with a draggable reading overlay and optional cloud sync.", "author": "You", "browser_specific_settings": {"gecko": {"id": "comic-collector@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_title": "Comic Collector"}, "background": {"scripts": ["lib/storage.js", "background.js"]}, "permissions": ["storage", "activeTab", "scripting", "contextMenus", "downloads", "tabs", "alarms", "clipboardWrite"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.mozilla.org/*"], "js": ["lib/storage.js", "overlay/content.js"], "css": ["overlay/content.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "options_ui": {"page": "popup/popup.html#/settings", "open_in_tab": true}}