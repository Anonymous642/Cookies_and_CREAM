{"manifest_version": 2, "name": "NoteStash", "version": "1.0.0", "description": "Lightweight synced notes inside your browser. Write, search, and capture selections; sync via Firefox account if you want.", "permissions": ["storage", "activeTab", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "NoteStash", "default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "notestash@example.com", "strict_min_version": "91.0"}}}