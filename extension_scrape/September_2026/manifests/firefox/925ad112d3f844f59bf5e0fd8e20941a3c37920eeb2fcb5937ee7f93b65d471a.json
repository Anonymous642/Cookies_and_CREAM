{"manifest_version": 2, "name": "WPBulkify", "description": "Bulk install plugins & themes, save reusable profiles, and launch instant WordPress Playground previews \u2014 all from your browser.", "version": "1.1.2", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "notifications", "https://*/wp-admin/*", "http://*/wp-admin/*", "https://wpbulkify.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "{39a6fc1d-b63d-4265-9bdd-e9cf61d6e34e}", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "WordPress Plugin Manager", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/wp-admin/*", "https://*/wp-admin/*"], "js": ["content-scripts/content.js"]}, {"matches": ["https://wpbulkify.com/p/*", "https://wpbulkify.com/profiles/*"], "run_at": "document_end", "js": ["content-scripts/profile-import.js"]}]}