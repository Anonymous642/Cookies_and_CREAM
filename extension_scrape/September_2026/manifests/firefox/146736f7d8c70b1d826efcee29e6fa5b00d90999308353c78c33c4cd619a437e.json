{"manifest_version": 3, "name": "lurkr", "version": "1.3", "description": "Read Reddit logged out: removes login and app nags, blocks trackers, and adds reading conveniences.", "browser_specific_settings": {"gecko": {"id": "{007d776e-d05b-4162-96ca-25d6c057adba}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "lurkr_trackers", "enabled": true, "path": "rules.json"}]}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "action": {"default_icon": "icon.svg", "default_title": "lurkr \u2014 works on reddit.com tabs"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}