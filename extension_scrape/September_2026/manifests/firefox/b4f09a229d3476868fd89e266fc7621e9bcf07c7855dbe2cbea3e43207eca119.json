{"manifest_version": 2, "name": "Quoth", "description": "YouTube transcript viewer with client-side formatting", "version": "0.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "contextMenus", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "quoth@tednaleid.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Quoth"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube-player.js"], "world": "MAIN"}], "browser_action": {"default_title": "Quoth"}}