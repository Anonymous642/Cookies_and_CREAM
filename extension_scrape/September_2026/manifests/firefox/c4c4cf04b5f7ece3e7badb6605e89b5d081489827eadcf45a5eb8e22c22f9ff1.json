{"manifest_version": 3, "name": "Photopea Text Assistant", "version": "1.0.0", "description": "Ajoute un panneau flottant sur Photopea pour lire, \u00e9diter et importer du texte (y compris depuis des fichiers .docx) sans quitter la page.", "icons": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "content_scripts": [{"matches": ["https://www.photopea.com/*"], "js": ["lib/mammoth.browser.min.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "photopea-text-assistant@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}