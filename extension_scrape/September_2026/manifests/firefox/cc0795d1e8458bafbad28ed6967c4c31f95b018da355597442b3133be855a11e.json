{"manifest_version": 2, "name": "Universal Redirector", "version": "1.1", "description": "Redirect chosen websites to a chosen destination.", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "icon.png", "default_title": "Edit Blocked Domains", "default_popup": "popup.html"}, "web_accessible_resources": ["blocked_domains.json"], "browser_specific_settings": {"gecko": {"id": "verysimpleredirector@alga.local"}}}