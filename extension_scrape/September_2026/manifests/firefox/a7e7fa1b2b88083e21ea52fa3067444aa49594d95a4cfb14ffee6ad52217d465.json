{"manifest_version": 3, "name": "Highlight Notes", "version": "1.2.17", "description": "Highlight webpages, add notes, export PDFs, and sync your library across devices with Highlight Notes.", "permissions": ["storage", "alarms", "contextMenus", "tabs", "identity"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "commands": {"highlight-selection": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "Open Highlight Notes for the selected text"}, "toggle-popup": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}, "description": "Enable or disable the Highlight Notes selection popup everywhere"}}, "action": {"default_title": "Open Highlight Notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "chatgpt-selection-popup.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "options_page": "options.html", "author": "Rochak Agrawal", "homepage_url": "https://highlight-notes.rochak10.chatgpt.site", "browser_specific_settings": {"gecko": {"id": "highlight-notes-free@rochak-agrawal", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}