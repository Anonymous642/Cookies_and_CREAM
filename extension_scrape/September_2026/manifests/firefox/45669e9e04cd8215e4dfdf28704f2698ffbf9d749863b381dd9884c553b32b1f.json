{"manifest_version": 3, "name": "MAL Score Hider", "version": "1.0.0", "description": "Hides score labels on MyAnimeList.net, replacing them with '...'", "browser_specific_settings": {"gecko": {"id": "mal-score-hider@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": [], "host_permissions": ["https://myanimelist.net/*"], "content_scripts": [{"matches": ["https://myanimelist.net/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}