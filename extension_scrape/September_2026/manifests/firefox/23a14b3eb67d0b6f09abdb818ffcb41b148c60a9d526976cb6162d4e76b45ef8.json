{"manifest_version": 2, "name": "Digizent Log Time Extension", "version": "1.3", "permissions": ["storage", "scripting", "tabs", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://app.asana.com/*"], "js": ["content.js"], "css": ["digizent-content.css"]}], "browser_action": {"default_popup": "popup.html", "default_title": "Digizent Extension"}, "web_accessible_resources": ["dashboard.html", "static-dashboard.html", "timelog-history.html", "assets/*", "styles.css"], "description": "Adds Log Time and History buttons to Asana tasks for quick time logging to your Digizent dashboard.", "icons": {"16": "/assets/DZ-16.png", "48": "/assets/DZ-48.png", "128": "/assets/DZ-128.png"}, "browser_specific_settings": {"gecko": {"id": "dev@digizent.com"}}}