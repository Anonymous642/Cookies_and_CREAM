{"manifest_version": 3, "name": "Discord Developers Widgets Override", "version": "1.0", "description": "Runs an override on Discord Developers pages to enable the Widgets menu.", "content_scripts": [{"matches": ["https://discord.com/developers/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@raydeguchi-discord-devportal-widgets-enable", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "58.0"}}}