{"manifest_version": 3, "name": "Meeting Sidebar", "version": "1.0.0", "description": "Find AA & recovery meetings near you or online, in a side panel. Free. Unofficial. Includes a one-tap privacy screen.", "browser_specific_settings": {"gecko": {"id": "meetingsidebar@meetingsidebar.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "geolocation", "alarms", "notifications"], "host_permissions": ["https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open Meeting Sidebar"}, "sidebar_action": {"default_title": "Meeting Sidebar", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}