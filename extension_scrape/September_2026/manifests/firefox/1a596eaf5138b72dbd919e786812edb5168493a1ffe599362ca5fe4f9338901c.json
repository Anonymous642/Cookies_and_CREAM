{"manifest_version": 3, "name": "Sonora.Chat Music Search", "version": "1.0", "description": "Search and listen music on Sonora.Chat directly from your browser", "permissions": ["tabs"], "host_permissions": ["*://sonora.chat/*"], "action": {"default_popup": "popup.html", "default_title": "Search on Sonora.Chat", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "sonora-search@sonora.chat", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}