{"manifest_version": 3, "name": "YouTube Reflection", "version": "0.1.0", "description": "Log pre/post reflections on YouTube videos locally.", "action": {"default_title": "Reflect", "default_popup": "popup.html"}, "options_page": "options.html", "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module", "preferred_environment": ["service_worker", "document"]}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["css/tailwind.css"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"]}], "browser_specific_settings": {"gecko": {"id": "youtube-reflection@your-domain", "strict_min_version": "128.0"}}}