{"manifest_version": 2, "name": "QuickAnnotator", "version": "1.0.0", "description": "QuickAnnotator adds a lightweight note-taking popup for the current page. Save a short note per page and show it on the page when needed.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "QuickAnnotator", "default_popup": "popup/popup.html", "default_icon": "icons/icon48.png"}, "permissions": ["storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "browser_style": true}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "quickannotator-6895b9e51ebe4524bb39a1c8dbfe7ea3@example.com", "strict_min_version": "78.0"}}}