{"manifest_version": 2, "name": "Gamana Focus", "version": "1.0.0", "description": "Blocks distracting sites in Firefox while Focus mode is on in the Gamana to-do app.", "author": "Gamana", "browser_specific_settings": {"gecko": {"id": "focus@gamana.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "web_accessible_resources": ["blocked.html"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}