{"manifest_version": 2, "name": "High Contrast Toggle", "version": "1.0.0", "description": "Quickly toggle a high-contrast accessible view for the current page.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Toggle High Contrast", "default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["activeTab", "storage"], "options_ui": {"page": "options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "high-contrast-toggle@example.com", "strict_min_version": "60.0"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}