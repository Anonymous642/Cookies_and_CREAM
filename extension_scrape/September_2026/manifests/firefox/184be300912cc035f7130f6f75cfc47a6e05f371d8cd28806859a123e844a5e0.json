{"manifest_version": 3, "name": "ScreenLife Watch Logger", "short_name": "ScreenLife", "version": "0.1.19", "description": "Detect completed movies and episodes and log, rate, or review them on ScreenLife.", "homepage_url": "https://screenlife.tv/extension", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ScreenLife Watch Logger", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "alarms", "scripting", "storage"], "host_permissions": ["https://screenlife.tv/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "watch-logger@screenlife.tv", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity", "websiteContent"]}}}}