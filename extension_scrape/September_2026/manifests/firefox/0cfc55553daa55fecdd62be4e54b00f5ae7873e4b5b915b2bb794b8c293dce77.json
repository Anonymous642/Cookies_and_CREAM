{"manifest_version": 3, "name": "Gorilla Bridge", "version": "0.1.0", "description": "Integra le password di Password Gorilla (.psafe3) in Firefox: ricerca e riempimento dei login.", "browser_specific_settings": {"gecko": {"id": "gorilla-bridge@example.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["nativeMessaging", "storage", "activeTab", "clipboardWrite"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/autofill.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Gorilla Bridge", "default_icon": {"32": "icons/gorilla-32.png", "48": "icons/gorilla-48.png"}}, "commands": {"fill-login": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Compila il login per il sito corrente"}}, "icons": {"48": "icons/gorilla-48.png", "96": "icons/gorilla-96.png"}}