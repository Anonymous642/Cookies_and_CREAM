{"manifest_version": 3, "name": "Nightspar \u2014 Vocabulary Flashcards, Any Page", "description": "Save words from any page. AI builds a complete flashcard for the meaning used in that sentence; spaced repetition makes it stick.", "version": "1.2.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@nightspar.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "identity", "alarms"], "host_permissions": ["https://api.nightspar.com/*", "https://auth.nightspar.com/*"], "web_accessible_resources": [{"resources": ["fonts/*", "panel.js"], "matches": ["<all_urls>"]}, {"resources": ["probe.png"], "matches": ["https://nightspar.com/*"]}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Nightspar", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}