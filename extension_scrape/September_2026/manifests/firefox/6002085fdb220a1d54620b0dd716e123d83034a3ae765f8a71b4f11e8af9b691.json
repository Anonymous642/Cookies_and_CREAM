{"manifest_version": 3, "name": "CardCompass \u2014 Rewards Optimizer", "short_name": "CardCompass", "description": "See which card in your wallet earns the most rewards on every site you visit. From cardcompass.app.", "version": "1.4.0", "background": {"scripts": ["src/background/service-worker.js"]}, "action": {"default_popup": "src/popup/index.html", "default_title": "CardCompass Rewards", "default_icon": {"16": "icons/icon-grey-16.png", "32": "icons/icon-grey-32.png", "48": "icons/icon-grey-48.png", "128": "icons/icon-grey-128.png"}}, "icons": {"16": "icons/icon-active-16.png", "32": "icons/icon-active-32.png", "48": "icons/icon-active-48.png", "128": "icons/icon-active-128.png"}, "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://app.cardcompass.app/*"], "content_scripts": [{"matches": ["https://app.cardcompass.app/*"], "js": ["src/content/auth-bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "cardcompass@cardcompass.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}