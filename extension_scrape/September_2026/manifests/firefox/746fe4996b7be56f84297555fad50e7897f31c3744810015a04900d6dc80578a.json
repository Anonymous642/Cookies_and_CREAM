{"manifest_version": 2, "name": "New Tab Redirector", "version": "1.0.0", "description": "Customize your new tab page - redirect to any URL you choose. Simple, fast, and privacy-focused.", "icons": {"16": "icons/iconsmall.png", "48": "icons/iconmedium.png", "96": "icons/iconlarge.png", "128": "icons/iconbigger.png"}, "permissions": ["storage"], "background": {"scripts": ["background-firefox.js"], "persistent": false}, "chrome_url_overrides": {"newtab": "newtab-firefox.html"}, "browser_action": {"default_popup": "popup-firefox.html", "default_title": "Configure New Tab URL", "default_icon": {"16": "icons/iconsmall.png", "48": "icons/iconmedium.png", "96": "icons/iconlarge.png", "128": "icons/iconbigger.png"}}, "options_ui": {"page": "options-firefox.html", "open_in_tab": true}, "commands": {"open-settings": {"suggested_key": {"default": "Ctrl+Shift+N"}, "description": "Open New Tab Redirector settings"}}, "author": "Kilian Barbier", "homepage_url": "https://newtab.kilianbarbier.fr", "browser_specific_settings": {"gecko": {"id": "newtab-redirector@kilianbarbier.fr", "strict_min_version": "58.0"}}}