{"manifest_version": 2, "name": "VideoDL Remote", "version": "3.3.0", "description": "Companion extension for your self-hosted VideoDL server. Send video URLs from any page to your VideoDL instance for downloading.", "permissions": ["activeTab", "contextMenus", "storage", "cookies", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "videodl-remote@videodl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"19": "icons/icon-19.png", "38": "icons/icon-38.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["common/utils.js", "background.js"]}, "options_ui": {"page": "options/options.html", "browser_style": false}, "browser_action": {"default_icon": {"19": "icons/icon-19.png", "38": "icons/icon-38.png"}, "default_title": "Send to VideoDL", "default_popup": "popup/popup.html"}, "commands": {"send-to-videodl": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Send current page to VideoDL"}}}