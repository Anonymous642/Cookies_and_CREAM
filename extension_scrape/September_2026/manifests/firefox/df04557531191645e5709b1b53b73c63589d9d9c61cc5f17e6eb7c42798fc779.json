{"manifest_version": 3, "name": "Card Style Tab Search", "version": "2.5.0", "description": "List and manage all open tabs in card style, efficiently", "permissions": ["activeTab", "scripting", "bookmarks", "tabs", "contextMenus", "sessions", "storage", "contextualIdentities", "cookies"], "action": {"default_popup": "tabs.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"tab-to-next-shortcut": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Open a new tab next to the active tab."}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{6fee00db-4204-40fe-b21a-3ca993dc0983}"}}}