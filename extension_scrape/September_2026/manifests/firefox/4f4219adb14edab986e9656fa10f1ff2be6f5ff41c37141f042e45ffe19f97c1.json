{"manifest_version": 3, "name": "Claude.ai Freeze Fix on LibreWolf", "short_name": "claude-freeze-fix", "version": "1.0.0", "author": "Filippo Airaldi", "homepage_url": "https://github.com/FilippoAiraldi/claude-ai-freeze-fix-librewolf", "description": "Fixes the freezing issue of Claude.ai on LibreWolf by ensuring monotonic behaviour of Date.now().", "browser_specific_settings": {"gecko": {"id": "{0f914ee6-8712-47f8-9dc7-847baa59db3f}", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["fix.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://claude.ai/*"]}]}