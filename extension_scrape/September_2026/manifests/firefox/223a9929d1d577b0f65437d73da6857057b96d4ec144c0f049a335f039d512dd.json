{"manifest_version": 3, "name": "twall", "version": "0.1.0", "description": "Opens x.com and twitter.com status links as a fast, plain, native-feeling tweet view.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "twall setup", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["https://*.x.com/*", "https://*.twitter.com/*", "https://cdn.syndication.twimg.com/*"], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "twall@jack.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["src/tweet.html"], "matches": ["https://*.x.com/*", "https://*.twitter.com/*"]}]}