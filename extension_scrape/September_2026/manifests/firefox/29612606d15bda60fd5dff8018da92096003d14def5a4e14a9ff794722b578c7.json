{"manifest_version": 2, "name": "pinacea", "description": "Pinacea is a browser addon that help you manage your pinned tabs with ease.", "author": "Danny Colin", "version": "0.1.0", "browser_specific_settings": {"gecko": {"id": "pinacea@dannycolin.com", "strict_min_version": "115.0"}}, "permissions": ["storage", "tabs"], "icons": {"32": "assets/pinacea.svg", "48": "assets/pinacea.svg", "64": "assets/pinacea.svg", "96": "assets/pinacea.svg"}, "background": {"scripts": ["scripts/background.js"]}, "options_ui": {"page": "options/options.html"}, "commands": {"toggle-pin-tab": {"description": "(un)pin a tab"}}}