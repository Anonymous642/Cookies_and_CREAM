{"manifest_version": 2, "name": "YTPA - YouTube Play All", "description": "Standalone Extension for the YTPA userscript.", "version": "1.1.788.0", "icons": {"16": "icon-16.png", "24": "icon-24.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "scripting", "tabs", "https://*.youtube.com/*", "https://ytplaylist.robert.wesner.io/*"], "browser_specific_settings": {"gecko": {"id": "ytpa-standalone@scripts.yt", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity", "browsingActivity", "personallyIdentifyingInfo"]}}}, "content_security_policy": "script-src 'self'; object-src 'none';", "web_accessible_resources": ["exposed/*", "exposed/js/*.js"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}