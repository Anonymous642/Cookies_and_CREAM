{"manifest_version": 3, "name": "Aegis", "version": "10.5", "description": "Un bouclier de protection avanc\u00e9 qui vous rend ind\u00e9tectable en appliquant une empreinte num\u00e9rique coh\u00e9rente et en effa\u00e7ant toute trace de sa pr\u00e9sence.", "permissions": ["storage", "declarativeNetRequest", "scripting", "tabs", "privacy"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "aegis-untraceable-android@votre-domaine.com", "strict_min_version": "113.0"}}}