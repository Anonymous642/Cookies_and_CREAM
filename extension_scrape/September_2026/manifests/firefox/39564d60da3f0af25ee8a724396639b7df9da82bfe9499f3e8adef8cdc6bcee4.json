{"manifest_version": 3, "name": "Doodle Page", "version": "1.0.0", "description": "Drag shapes, draw lines, add text, icons, images & GIFs to any web page. Save and reload your creations.", "author": "Doodle Page", "homepage_url": "https://doodle-page.app", "icons": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_popup": "popup/popup.html", "default_title": "Doodle Page", "default_icon": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}}, "permissions": ["activeTab", "storage", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "commands": {"toggle-canvas": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle Doodle Page on/off"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "content/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "doodlepage@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}