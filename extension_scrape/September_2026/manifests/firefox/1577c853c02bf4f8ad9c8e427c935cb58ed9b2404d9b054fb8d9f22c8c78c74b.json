{"manifest_version": 2, "name": "Hum2Search", "version": "0.1.0", "description": "Prototype: record a short hum (5-10s), generate a simple fingerprint, and search for similar tracks (prototype UI).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "microphone"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "web_accessible_resources": ["assets/*", "icons/*"], "browser_specific_settings": {"gecko": {"id": "@hum2search-example", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}