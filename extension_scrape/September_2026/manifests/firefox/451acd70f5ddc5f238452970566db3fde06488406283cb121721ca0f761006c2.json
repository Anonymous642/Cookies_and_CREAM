{"manifest_version": 2, "name": "DRTV \u2192 Simkl Scrobbler", "version": "2.0", "description": "Automatically scrobbles episodes watched on DR TV (dr.dk/drtv) to your Simkl account.", "permissions": ["tabs", "storage", "https://www.dr.dk/*", "https://api.simkl.com/*", "https://api.themoviedb.org/*"], "web_accessible_resources": ["auth.html", "auth.js"], "background": {"scripts": ["background.js", "simkl.js", "storage.js"], "persistent": true}, "content_scripts": [{"matches": ["*://www.dr.dk/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Open Settings"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "drtv-simkl@example.com", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}