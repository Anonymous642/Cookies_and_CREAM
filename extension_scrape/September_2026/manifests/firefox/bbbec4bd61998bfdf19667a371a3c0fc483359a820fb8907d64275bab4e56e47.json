{"manifest_version": 2, "name": "LinkShell", "version": "117.1.0", "description": "Wraps every external link in a protective shell.", "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "AleshaCroix595519@outlook.com", "strict_min_version": "91.1.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["clamp/linkshell-bg.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["struts/linkshell-content.js"], "css": ["struts/linkshell.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "LinkShell", "default_popup": "capsule/capsule.html"}, "icons": {"48": "capsule/shell-icon.svg"}}