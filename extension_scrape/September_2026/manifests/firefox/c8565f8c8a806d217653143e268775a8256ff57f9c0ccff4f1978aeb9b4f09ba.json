{"manifest_version": 3, "name": "Cleverly Write", "version": "1.0.0", "description": "A secure writing assistant extension that uses the Gemini API to enhance your text with spell check, grammar correction, and tone adjustment.", "permissions": ["storage"], "host_permissions": ["https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.svg", "48": "icons/icon48.svg", "128": "icons/icon128.svg"}}, "icons": {"16": "icons/icon16.svg", "48": "icons/icon48.svg", "128": "icons/icon128.svg"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com;"}, "browser_specific_settings": {"gecko": {"id": "cleverly-write@tisankan.dev", "strict_min_version": "109.0"}}}