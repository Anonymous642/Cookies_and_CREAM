{"manifest_version": 3, "name": "FaB Living Legend Tracker", "version": "1.0.0", "description": "Track week-over-week Living Legend point changes on fabtcg.com", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://fabtcg.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://fabtcg.com/living-legend*"], "js": ["parser.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "FaB Living Legend Tracker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "fab-ll-tracker@louise.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}