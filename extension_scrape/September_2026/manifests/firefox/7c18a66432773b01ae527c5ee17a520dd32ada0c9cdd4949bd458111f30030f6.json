{"manifest_version": 3, "name": "MochiDim: Manga Dark Mode & Blue Light Filter", "description": "Warm dim and blue light filter for manga, comics, webtoons & any image-heavy site. A real dark mode that keeps the artwork true.", "version": "1.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "homepage_url": "https://mochipanel.com", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://mangadex.org/*", "https://comick.io/*", "https://bato.to/*", "https://asuracomic.net/*", "https://www.webtoons.com/*", "https://webtoons.com/*", "https://mangaplus.shueisha.co.jp/*", "https://cubari.moe/*", "https://tapas.io/*", "https://www.tapas.io/*", "https://api.polar.sh/*"], "optional_host_permissions": ["https://*/*"], "browser_specific_settings": {"gecko": {"id": "mochidim@mochipanel.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "MochiDim", "default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_popup": "popup.html"}, "commands": {"toggle-dim": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Toggle MochiDim on/off"}, "cycle-warmth": {"suggested_key": {"default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma"}, "description": "Cycle MochiDim warmth (paper \u2192 dusk \u2192 midnight)"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://asuracomic.net/*", "https://bato.to/*", "https://comick.io/*", "https://cubari.moe/*", "https://mangadex.org/*", "https://mangaplus.shueisha.co.jp/*", "https://tapas.io/*", "https://webtoons.com/*", "https://www.tapas.io/*", "https://www.webtoons.com/*"], "all_frames": true, "run_at": "document_end", "js": ["content-scripts/content.js"]}]}