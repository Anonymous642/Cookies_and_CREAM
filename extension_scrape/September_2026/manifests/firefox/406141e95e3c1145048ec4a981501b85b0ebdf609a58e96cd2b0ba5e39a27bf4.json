{"manifest_version": 3, "name": "POE Unique Tier Helper", "version": "1.0.0", "description": "Shows the unique tier of unique items on the Path of Exile Wiki.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "POE Unique Tier Helper"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "tabs"], "host_permissions": ["https://www.poewiki.net/*"], "content_scripts": [{"matches": ["https://www.poewiki.net/wiki/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "poe-unique-tier-helper-keyoh@2026", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}