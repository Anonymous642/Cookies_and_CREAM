{"manifest_version": 2, "name": "Forktastic", "description": "Extract recipes from any webpage with AI", "version": "1.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "scripting", "tabs", "https://api.revenuecat.com/*"], "commands": {"extract-recipe": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Extract recipe from current page"}}, "browser_specific_settings": {"gecko": {"id": "support@forktastic.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Forktastic", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["http://localhost:8081/*", "https://app.forktastic.com/*"], "run_at": "document_idle", "js": ["content-scripts/auth-bridge.js"]}, {"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}