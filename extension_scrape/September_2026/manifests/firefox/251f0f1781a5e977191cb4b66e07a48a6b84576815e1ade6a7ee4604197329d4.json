{"manifest_version": 3, "name": "Slidoro", "version": "1.0.2", "description": "Website blocker & timer companion for Slidoro app.", "homepage_url": "https://pomodoro.milmanart.win", "browser_specific_settings": {"gecko": {"id": "pomodoro-focus@milmanart.win", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "Slidoro", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "tabs", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-overlay.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["content-overlay.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}