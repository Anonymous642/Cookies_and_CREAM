{"manifest_version": 2, "name": "Form Rage Saver", "version": "3.0.0", "description": "Never lose form data again. Silently saves your in-progress form fields and restores them if you accidentally navigate away.", "browser_specific_settings": {"gecko": {"id": "formragesaver@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "tabs", "activeTab", "<all_urls>", "alarms"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "Form Rage Saver"}, "background": {"scripts": ["background.js"], "persistent": false}}