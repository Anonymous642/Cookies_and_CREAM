{"manifest_version": 3, "name": "Diplodocus", "version": "1.2", "description": "Automatically replaces \"Claude Opus\" (and \"Opus\") with \"Diplodocus\" on every webpage.", "icons": {"16": "icons/diplodocus-16.png", "48": "icons/diplodocus-48.png", "128": "icons/diplodocus-128.png"}, "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/diplodocus-16.png", "48": "icons/diplodocus-48.png", "128": "icons/diplodocus-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "diplodocus-replacer@alexisamadei", "data_collection_permissions": {"required": ["none"]}}}}