{"manifest_version": 2, "name": "ZenLinks", "version": "1.2.3", "description": "Sync pinned tabs from Linkding - auto-pin bookmarks by tag with container/workspace support", "author": "Mirrikato", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "storage", "contextualIdentities", "cookies", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "ZenLinks - Linkding Sync", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "zenlinks@mirrikato", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}