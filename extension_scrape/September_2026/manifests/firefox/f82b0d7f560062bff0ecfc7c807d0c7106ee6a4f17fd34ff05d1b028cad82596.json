{"manifest_version": 3, "name": "Passhash Redux", "version": "2.4.5", "browser_specific_settings": {"gecko": {"id": "passhash-redux@extension", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "description": "Deterministic password hashing for the modern web", "permissions": ["activeTab", "storage", "contextMenus", "tabs"], "host_permissions": ["*://*/*"], "icons": {"48": "icons/icon.svg"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'"}, "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "pages/options.html"}, "content_scripts": [{"matches": ["*://*/*"], "all_frames": true, "js": ["content.js"], "css": ["content.css"]}], "action": {"default_title": "Hash password", "default_icon": {"48": "icons/icon-inactive.svg"}, "default_popup": "pages/popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+F6"}}}}