{"manifest_version": 3, "name": "Endlss", "version": "1.0.6", "description": "Pick up images from the web and add them to Endlss", "permissions": ["contextMenus", "storage", "activeTab", "tabs", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "extension@endlss.app", "data_collection_permissions": {"required": ["none"], "reason": "This extension does not collect any data that is not strictly necessary for its core functionality. All data (images, metadata) is only transmitted to the user's own Endlss account when they explicitly trigger a capture."}}}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content/scraper.js"], "run_at": "document_idle"}, {"matches": ["*://localhost/auth/extension-link*", "*://*.endlss.co/auth/extension-link*"], "js": ["content/auth-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}