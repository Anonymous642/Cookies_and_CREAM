{"manifest_version": 2, "name": "Rezka Language Subtitles", "version": "1.2.0", "description": "Interactive bilingual EN/RU subtitles for rezka-tv.org. Tap English lines to pause and see Russian translation.", "permissions": ["storage", "activeTab", "*://rezka-tv.org/*", "*://*.rezka-tv.org/*"], "optional_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Rezka Language Subtitles", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["*://rezka-tv.org/*", "*://*.rezka-tv.org/*"], "js": ["inject-hook.js"], "all_frames": true, "run_at": "document_start"}, {"matches": ["*://rezka-tv.org/*", "*://*.rezka-tv.org/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "web_accessible_resources": ["icons/*", "page-fetch.js"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "rezka-language-subtitles@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}