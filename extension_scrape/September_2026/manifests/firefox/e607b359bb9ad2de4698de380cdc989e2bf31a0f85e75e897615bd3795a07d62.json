{"manifest_version": 2, "name": "Sessionaire", "version": "1.4.6", "description": "Master your browser sessions - Save, restore, and manage tabs with ease", "author": "Sessionaire Team", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "sessions", "unlimitedStorage", "contextualIdentities", "cookies"], "background": {"scripts": ["storage/storage.js", "utils/session-manager.js", "utils/crash-recovery.js", "core/js/background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Sessionaire - Manage your tabs and sessions", "default_popup": "sessionaire-mini.html"}, "browser_specific_settings": {"gecko": {"id": "sessionaire@sessionaire.app", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "chrome_url_overrides": {"newtab": "sessionaire-newtab.html"}, "commands": {"open-sessionaire": {"suggested_key": {"default": "Alt+Shift+Down", "mac": "MacCtrl+Shift+Down"}, "description": "Open Sessionaire"}, "quick-save-session": {"suggested_key": {"default": "Alt+Shift+Up", "mac": "MacCtrl+Shift+Up"}, "description": "Quick save session with name prompt"}}}