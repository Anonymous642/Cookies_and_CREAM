{"manifest_version": 3, "name": "Cookie Bridge", "version": "1.0.1", "description": "One click: copy cookies from the current tab's site to http://localhost. HttpOnly cookies included. Useful for local development against a logged-in production session.", "permissions": ["cookies", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Copy this tab's cookies \u2192 localhost", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg"}}, "icons": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "cookie-bridge@etiel.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}