{"manifest_version": 2, "name": "E-ROBLOX", "version": "2.6.1", "description": "E-ROBLOX is a lightweight Firefox extension that enhances Roblox with lots of free themes.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "E-ROBLOX", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["main.js", "e-roblox.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "*://*.roblox.com/*"], "browser_specific_settings": {"gecko": {"id": "e-roblox@firefox", "strict_min_version": "115.0"}}}