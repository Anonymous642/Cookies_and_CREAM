{"manifest_version": 3, "name": "Search Enhancement Suite", "version": "1.0.0", "description": "Enhance your search engine experience with blocking, highlighting, saving search results and more", "permissions": ["storage", "scripting"], "host_permissions": ["https://www.google.com/*", "https://m.google.com/*", "https://www.bing.com/*", "https://duckduckgo.com/*", "https://search.yahoo.com/*"], "content_scripts": [{"matches": ["https://www.google.com/search*", "https://m.google.com/search*", "https://www.bing.com/search*", "https://duckduckgo.com/*", "https://search.yahoo.com/search*"], "js": ["content.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "options_page": "options.html", "action": {"default_popup": "popup.html", "default_title": "Search Enhancement Suite"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://www.google.com/*", "https://m.google.com/*", "https://www.bing.com/*", "https://duckduckgo.com/*", "https://search.yahoo.com/*"]}], "browser_specific_settings": {"gecko": {"id": "search-enhancement-suite@scriptsmith04.github.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}