{"manifest_version": 2, "name": "Jiffy Reader for Firefox", "version": "1.0.1", "description": "Emphasize the beginning of words for faster, more comfortable reading.", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "jiffy-reader-firefox@example.com", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Jiffy Reader", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-reading": {"suggested_key": {"default": "Alt+W"}, "description": "Toggle reading mode"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}