{"manifest_version": 3, "name": "Geloxio", "version": "1.2.6", "description": "Voice dictation for Gmail, Google Docs, and any website. Speak naturally, Geloxio writes.", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "host_permissions": ["https://www.geloxio.com/*", "https://geloxio.com/*", "https://geloxio.vercel.app/*"], "action": {"default_title": "Open Geloxio", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "geloxio@geloxio.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}