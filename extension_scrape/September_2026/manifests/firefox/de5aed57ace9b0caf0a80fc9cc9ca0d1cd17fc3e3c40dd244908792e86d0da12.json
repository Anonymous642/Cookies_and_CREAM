{"manifest_version": 3, "name": "Tab Debt Manager", "version": "0.1.0", "description": "Group tabs by topic, snooze them, and gently guilt-trip yourself into closing stale tabs.", "permissions": ["tabs", "storage", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tab Debt Manager", "default_popup": "popup.html"}, "options_page": "options.html", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-debt-manager@example.local", "data_collection_permissions": {"required": ["none"]}}}}