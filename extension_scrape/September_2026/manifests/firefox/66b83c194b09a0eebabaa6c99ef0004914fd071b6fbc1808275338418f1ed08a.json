{"manifest_version": 3, "name": "Simple Url Switcher", "version": "3.1001.10005", "description": "Switch url fluidly (for example youtube/soundcloud in keeping the progression) from your current device to another", "options_page": "settings.html", "permissions": ["activeTab", "contextMenus", "storage", "scripting"], "background": {"scripts": ["sw.js"]}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "web_accessible_resources": [{"resources": ["integrations/*.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "simple_url_switcher@lp177.fr", "strict_min_version": "109.0"}}}