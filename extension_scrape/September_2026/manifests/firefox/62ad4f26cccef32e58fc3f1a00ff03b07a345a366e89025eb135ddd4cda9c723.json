{"manifest_version": 3, "name": "cosine.club", "description": "Browser extension for cosine.club.", "version": "1.0.4", "icons": {"16": "icons/light/icon-16.png", "32": "icons/light/icon-32.png", "48": "icons/light/icon-48.png", "96": "icons/light/icon-96.png", "128": "icons/light/icon-128.png"}, "action": {"default_icon": {"16": "icons/light/icon-16.png", "32": "icons/light/icon-32.png", "48": "icons/light/icon-48.png"}, "default_popup": "./popup/popup.html", "default_title": "Cosine Club"}, "background": {"scripts": ["background/background-init.js"], "type": "module"}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://cosine.club/*"], "content_scripts": [{"matches": ["*://www.youtube.com/watch*", "*://youtube.com/watch*", "*://youtu.be/*"], "js": ["content/youtube/content.js"], "run_at": "document_idle"}, {"matches": ["*://*.discogs.com/release/*", "*://*.discogs.com/master/*"], "js": ["content/discogs/content.js"], "run_at": "document_idle"}, {"matches": ["*://soundcloud.com/*", "*://m.soundcloud.com/*"], "js": ["content/soundcloud/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://*.youtube.com/*"]}], "options_ui": {"page": "settings/options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "cosineplaylister@extensions.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}