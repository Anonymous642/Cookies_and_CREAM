{"manifest_version": 3, "name": "arXiv Title Downloader", "version": "0.1.0", "description": "Download arXiv PDFs with filenames based on paper titles.", "icons": {"16": "assets/icons/icon-16.svg", "32": "assets/icons/icon-32.svg", "48": "assets/icons/icon-48.svg", "96": "assets/icons/icon-96.svg", "128": "assets/icons/icon-128.svg"}, "permissions": ["downloads"], "host_permissions": ["https://arxiv.org/*"], "background": {"scripts": ["src/lib/arxiv.js", "src/background.js"]}, "content_scripts": [{"matches": ["https://arxiv.org/abs/*"], "css": ["src/content.css"], "js": ["src/lib/arxiv.js", "src/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Download arXiv PDF as Title", "default_icon": {"16": "assets/icons/icon-16.svg", "32": "assets/icons/icon-32.svg"}}, "browser_specific_settings": {"gecko": {"id": "@arxiv-title-downloader", "data_collection_permissions": {"required": ["none"]}}}}