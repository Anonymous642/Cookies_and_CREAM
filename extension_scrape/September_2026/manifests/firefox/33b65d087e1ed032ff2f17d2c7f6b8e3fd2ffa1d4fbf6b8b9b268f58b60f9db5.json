{"manifest_version": 3, "name": "SoundWave Spectrum", "version": "1.0", "description": "Create dynamic visual effects based on music playing on web pages", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "soundwavespectrum@example.com"}}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "SoundWave Spectrum", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["visualizer.js"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}}