{"manifest_version": 3, "name": "Roblox Accessory Stacker", "version": "1.0.0", "description": "Restores accessory stacking in Roblox's web Avatar Editor.", "permissions": ["storage"], "host_permissions": ["https://www.roblox.com/*", "https://avatar.roblox.com/*", "https://catalog.roblox.com/*", "https://economy.roblox.com/*"], "action": {"default_title": "Roblox Accessory Stacker", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.roblox.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page.js"], "matches": ["https://www.roblox.com/*"]}], "browser_specific_settings": {"gecko": {"id": "roblox-accessory-stacker@mikeprojects.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}