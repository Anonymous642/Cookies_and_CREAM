{"manifest_version": 3, "name": "Remember Position for YouTube", "version": "0.1.0", "description": "Saves and restores your playback position on YouTube videos.", "icons": {"48": "assets/icon.svg", "96": "assets/icon.svg", "128": "assets/icon.svg"}, "action": {"default_icon": {"48": "assets/icon.svg", "96": "assets/icon.svg"}, "default_popup": "src/popup.html", "default_title": "Remember Position for YouTube"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["src/storage.js", "src/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-remember-position@example.local", "data_collection_permissions": {"required": ["none"]}}}}