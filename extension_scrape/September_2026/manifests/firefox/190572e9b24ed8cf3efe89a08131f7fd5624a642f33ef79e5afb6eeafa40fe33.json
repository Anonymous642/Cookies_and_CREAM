{"manifest_version": 3, "name": "Exa Instant Lookup", "version": "1.1.0", "description": "Cmd/Ctrl+highlight any text to instantly search with Exa and get an AI summary", "browser_specific_settings": {"gecko": {"id": "exa-instant-lookup@exa.ai", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["searchTerms", "browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": [], "host_permissions": ["https://exainstantlookupextension.vercel.app/*", "https://www.google.com/*"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["popup.css"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Exa Instant Lookup"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}