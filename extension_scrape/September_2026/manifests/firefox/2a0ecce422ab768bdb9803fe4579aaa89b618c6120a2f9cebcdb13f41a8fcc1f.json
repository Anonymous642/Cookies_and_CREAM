{"manifest_version": 2, "name": "BloxScout: Roblox Server Toolkit", "description": "Find, compare, save, and join Roblox public servers faster.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "@bloxscout", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "clipboardWrite", "notifications", "alarms", "contextMenus", "*://*.roblox.com/*", "*://games.roblox.com/*", "*://users.roblox.com/*", "*://presence.roblox.com/*", "https://discord.com/*", "https://discordapp.com/*", "https://api.telegram.org/*", "https://thumbnails.roblox.com/*"], "commands": {"toggle-auto-snipe": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Toggle BloxScout Auto-Snipe On/Off"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "BloxScout", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["content-scripts/content.js"]}]}