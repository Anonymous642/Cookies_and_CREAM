{"manifest_version": 3, "name": "PyPy Sourcing", "version": "1.0.0", "description": "Save candidates from LinkedIn and hh.ru to PyPy in one click", "permissions": ["storage", "activeTab", "alarms", "notifications"], "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://hh.ru/*", "https://www.hh.ru/*", "https://*.hh.ru/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/in/*", "https://linkedin.com/in/*"], "js": ["utils/api.js", "utils/parser.js", "content/inject-button.js", "content/linkedin.js"], "css": ["content/inject-button.css"], "run_at": "document_idle"}, {"matches": ["https://hh.ru/resume/*", "https://www.hh.ru/resume/*"], "js": ["utils/api.js", "utils/parser.js", "content/inject-button.js", "content/hh.js"], "css": ["content/inject-button.css"], "run_at": "document_idle"}], "options_page": "options/options.html", "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"strict_min_version": "142.0", "id": "pypy-sourcing@pypy.ru", "data_collection_permissions": {"required": ["none"]}}}}