{"manifest_version": 3, "name": "Reel Minder", "version": "1.0.0", "description": "Track Instagram Reels consumption and set viewing limits", "author": "Your Name", "homepage_url": "https://github.com/yourusername/reel-minder", "permissions": ["storage", "activeTab", "notifications", "alarms"], "host_permissions": ["https://www.instagram.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "action": {"default_popup": "popup.html", "default_title": "Reel Minder"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "reel-minder@yourdomain.com", "strict_min_version": "109.0"}}}