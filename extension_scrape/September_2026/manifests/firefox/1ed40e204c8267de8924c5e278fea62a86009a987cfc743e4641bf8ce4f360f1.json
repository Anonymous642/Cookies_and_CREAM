{"manifest_version": 3, "name": "Toggle JS por Pesta\u00f1a", "version": "1.5", "description": "Activa o desactiva JavaScript en la pesta\u00f1a activa mediante un clic o atajo personalizable.", "permissions": ["webRequest", "webRequestBlocking", "activeTab", "tabs", "storage"], "host_permissions": ["<all_urls>"], "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "JavaScript Activado", "default_icon": "icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "F10"}, "description": "Activar o desactivar JavaScript en la pesta\u00f1a activa"}}, "browser_specific_settings": {"gecko": {"id": "toggle-js-tab-public@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}