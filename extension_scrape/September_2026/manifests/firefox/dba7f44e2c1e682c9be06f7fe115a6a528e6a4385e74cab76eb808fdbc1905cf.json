{"manifest_version": 3, "name": "YouTube AI Analyzer", "version": "1.0", "description": "Analyze YouTube videos with Gemini AI.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.youtube.com/*", "https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "popup/popup.html"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"]}], "browser_specific_settings": {"gecko": {"id": "yt-ai-analyzer@my-unique-addon-id", "data_collection_permissions": {"required": ["none"]}}}}