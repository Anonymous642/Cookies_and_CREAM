{"manifest_version": 3, "name": "Academic Notes - Snippet Saver", "version": "2.0.1", "description": "Capture academic snippets & citations. Direct Zotero Cloud Sync, 1-click export to Obsidian, Notion, Logseq, Anki with SQLite WASM.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "scripting", "tabs", "alarms", "notifications"], "web_accessible_resources": [{"resources": ["lib/sql-wasm.wasm"], "matches": ["<all_urls>"]}], "host_permissions": ["<all_urls>"], "background": {"scripts": ["utils/zotero-api.js", "utils/recall.js", "background/service-worker.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/pdf-metadata.js", "content/content.js"], "css": ["content/content.css"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Academic Notes - Snippet Saver"}, "sidebar_action": {"default_panel": "manager/manager.html", "default_title": "Academic Notes", "default_icon": "icons/icon-48.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"save-snippet": {"suggested_key": {"default": "Alt+S"}, "description": "Save selected text"}, "save-full-page": {"suggested_key": {"default": "Alt+W"}, "description": "Save full webpage or paper citation (Zotero style)"}, "quick-note": {"suggested_key": {"default": "Alt+N"}, "description": "Quick note or scratchpad composer"}, "toggle-unlock": {"suggested_key": {"default": "Alt+U"}, "description": "Toggle force unlock text selection"}}, "browser_specific_settings": {"gecko": {"id": "academic-notes-snippet-saver@triet.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}