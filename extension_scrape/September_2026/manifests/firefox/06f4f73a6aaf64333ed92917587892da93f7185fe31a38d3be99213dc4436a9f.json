{"manifest_version": 3, "name": "RoyalRoad Fiction Tracker", "version": "1.2.1", "description": "Tracks word counts and pages read for RoyalRoad fictions.", "browser_specific_settings": {"gecko": {"id": "Royal-Road-Word@webextensions", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://www.royalroad.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "options_page": "options.html", "content_scripts": [{"matches": ["https://www.royalroad.com/fiction/*/chapter/*"], "js": ["content.js"]}]}