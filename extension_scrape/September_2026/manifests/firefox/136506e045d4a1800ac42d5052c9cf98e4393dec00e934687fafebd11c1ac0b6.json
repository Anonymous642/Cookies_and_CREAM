{"manifest_version": 3, "name": "Nexus", "version": "2.2.0", "description": "Reads assignment questions, answers them with your own Gemini API key, and fills them into the page. Works on any website.", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open assignment assistant"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://api.groq.com"}, "sidebar_action": {"default_title": "Nexus", "default_panel": "sidepanel.html", "default_icon": "icons/icon-48.png", "browser_style": false}, "browser_specific_settings": {"gecko": {"id": "nexus@assignment-solver", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}