{"manifest_version": 3, "name": "MU Collection Matcher", "version": "0.1.0", "description": "Highlights marketplace listings that match your MU Online collection items.", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Collection Matcher", "default_popup": "popup/popup.html"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "collections-identifier@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}