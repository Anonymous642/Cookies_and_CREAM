{"manifest_version": 3, "name": "FocusMask", "version": "1.0.0", "description": "Stay productive by blocking distracting websites. Detailed list management and a clean 'Focus Mode' redirection page.", "icons": {"48": "resources/icon-48.png", "96": "resources/icon-96.png", "128": "resources/icon-128.png"}, "action": {"default_popup": "public/popup.html", "default_title": "FocusMask", "default_icon": "resources/icon-48.png"}, "permissions": ["storage", "tabs", "activeTab"], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "focusmask@focus.tool", "data_collection_permissions": {"required": ["none"]}}}}