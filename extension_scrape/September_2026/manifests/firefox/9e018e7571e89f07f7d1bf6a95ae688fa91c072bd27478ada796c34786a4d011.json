{"manifest_version": 3, "name": "chamelAIn \u2014 Persona Share", "version": "1.0.1", "description": "Browse your active chamelAIn personas and generate one-time share URLs for browser agents.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "chamelAIn Personas", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://www.chamelain.com/*", "https://chamelain.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "persona-share@chamelain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}