{"manifest_version": 2, "name": "Google Account Manager", "version": "1.0.0", "description": "Remembers your last-used Google account and lets you switch quickly from the toolbar.", "browser_specific_settings": {"gecko": {"id": "google-account-manager@bloomer.cc", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "webNavigation", "*://*.google.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "Google Account Manager"}, "content_scripts": [{"matches": ["*://drive.google.com/*", "*://docs.google.com/*", "*://mail.google.com/*", "*://calendar.google.com/*", "*://photos.google.com/*", "*://keep.google.com/*", "*://meet.google.com/*", "*://chat.google.com/*", "*://contacts.google.com/*", "*://sites.google.com/*", "*://jamboard.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon.svg"}}