{"manifest_version": 2, "name": "Lugelo Capture", "version": "1.0.6", "description": "Capture moments and add them to your Lugelo journals", "permissions": ["storage", "contextMenus", "activeTab", "<all_urls>", "tabs", "https://*.amazonaws.com/*", "https://*.lugelo.com/*"], "data_collection_permissions": {"collects_personal_data": false, "collects_browsing_history": false, "collects_user_activity": false, "collects_location": false, "collects_health_data": false, "collects_financial_data": false, "collects_authentication_information": false, "collects_personally_identifying_information": false}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup-react/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["icons/*.png", "icons/lugelo_logo_icon.png", "icons/icon48.png", "icons/icon16.png", "icons/icon128.png", "popup-react/index.html", "popup-react/*.js", "popup-react/*.css", "popup-react/assets/*", "config.json"], "content_security_policy": "script-src 'self'; object-src 'self'; frame-src 'self';", "externally_connectable": {"matches": ["http://localhost:3000/*", "https://*.lugelo.com/*"]}, "applications": {"gecko": {"id": "lugeloCapture@lugelo.com", "strict_min_version": "109.0"}}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "lugeloCapture@lugelo.com"}}}