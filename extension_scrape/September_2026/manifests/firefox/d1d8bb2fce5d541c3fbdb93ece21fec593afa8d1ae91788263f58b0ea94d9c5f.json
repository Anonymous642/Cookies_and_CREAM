{"manifest_version": 2, "name": "Page JavaScript Toggle", "version": "1.0.0", "description": "Toolbar / Tools-menu toggle that blocks scripts on websites (CSP script-src 'none'). Standard extensions cannot set about:config javascript.enabled; this matches its effect for web pages.", "browser_specific_settings": {"gecko": {"id": "page-js-toggle@local.dev", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "menus", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"page": "background.html"}, "browser_action": {"default_title": "Page JavaScript: allowed", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"toggle-page-js": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Toggle page JavaScript blocking"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}