{"manifest_version": 3, "name": "DeVuego - \u00bfEs espa\u00f1ol?", "version": "1.0.0", "description": "Avisa si el juego que ves en Steam, Xbox, PlayStation o Nintendo eShop es espa\u00f1ol, consultando la base de datos de DeVuego.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["webNavigation"], "host_permissions": ["https://www.devuego.es/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*", "https://www.xbox.com/*/games/store/*", "https://store.playstation.com/*/product/*", "https://www.nintendo.com/*/Juegos/*", "https://www.nintendo.es/Juegos/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon48.png", "fonts/IBMPlexSans.woff2", "fonts/KodeMono-Medium.woff2"], "matches": ["https://store.steampowered.com/*", "https://www.xbox.com/*", "https://store.playstation.com/*", "https://www.nintendo.com/*", "https://www.nintendo.es/*"]}], "browser_specific_settings": {"gecko": {"id": "extension-eschecker@devuego.es", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}