{"manifest_version": 2, "name": "NSpell", "version": "1.0", "description": "Abilita o disabilita il controllo ortografico per ogni sito", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png"}, "browser_specific_settings": {"gecko": {"id": "nspell@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}