{"manifest_version": 3, "name": "PDF Page Marker", "version": "2.0.1", "description": "Manually bookmark a page number for any PDF and jump back to it later.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pdf-page-marker@misterrhee", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab", "clipboardWrite"], "host_permissions": ["file:///*"], "action": {"default_popup": "popup.html", "default_title": "PDF Page Marker"}}