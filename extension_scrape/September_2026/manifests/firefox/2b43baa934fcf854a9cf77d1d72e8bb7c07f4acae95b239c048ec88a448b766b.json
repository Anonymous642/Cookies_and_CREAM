{"name": "KitchenPocket", "version": "1.0.7", "description": "Save recipes from any website, build cookbooks, plan meals & track nutrition, your smart kitchen companion.", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "kitchenpocket-ce@kitchenpocket.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "financialAndPaymentInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_icon": "assets/images/KitchenPocketLogo-small.png", "default_title": "Open KitchenPocket"}, "sidebar_action": {"default_panel": "index.html", "default_icon": "assets/images/KitchenPocketLogo-small.png", "default_title": "Open KitchenPocket"}, "icons": {"16": "assets/images/KitchenPocketLogo-small.png", "32": "assets/images/KitchenPocketLogo-small.png", "48": "assets/images/KitchenPocketLogo-small.png", "128": "assets/images/KitchenPocketLogo-small.png"}, "permissions": ["activeTab", "contextMenus", "clipboardWrite", "clipboardRead", "storage", "tabs", "scripting"], "host_permissions": ["https://www.kitchenpocket.com/", "https://staging.kitchenpocket.com/", "http://staging.kitchenpocket.com/", "https://qa.kitchenpocket.com/", "http://qa.kitchenpocket.com/", "http://api.kitchenpocket.com/", "https://api.kitchenpocket.com/", "http://*/", "https://*/"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["fab-content.js"], "css": ["fab.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/images/*.png", "fab.css"], "matches": ["<all_urls>"]}]}