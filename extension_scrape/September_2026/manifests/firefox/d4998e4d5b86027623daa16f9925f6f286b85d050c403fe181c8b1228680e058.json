{"manifest_version": 3, "name": "NoMoreCookies", "version": "1.0.0", "description": "Supprime automatiquement les popups de consentement aux cookies (RGPD) et restaure le scroll. 100% local.", "homepage_url": "https://nomorecookies.ritooon.xyz", "developer": {"name": "Ritooon", "url": "https://nomorecookies.ritooon.xyz"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["src/background/service-worker.js"]}, "browser_specific_settings": {"gecko": {"id": "nomorecookies@ritooon.xyz", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "src/popup/popup.html", "default_title": "NoMoreCookies"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/shared/constants.js", "src/shared/domain-utils.js", "src/shared/scorer.js", "src/shared/backdrop-heuristics.js", "src/shared/selector-builder.js", "src/shared/storage.js", "src/content/detector.js", "src/content/remover.js", "src/content/rules.js", "src/content/picker.js", "src/content/main.js"], "run_at": "document_start", "all_frames": false}]}