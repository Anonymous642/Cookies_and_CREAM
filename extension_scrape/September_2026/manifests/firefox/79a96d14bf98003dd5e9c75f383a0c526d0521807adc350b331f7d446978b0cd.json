{"manifest_version": 3, "name": "YouTube Surprise", "version": "0.1.0", "description": "Tu ne sais pas quoi regarder ? YouTube Surprise choisit intelligemment une vid\u00e9o parmi tes recommandations actuelles.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "youtube-surprise@example-changeme.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}