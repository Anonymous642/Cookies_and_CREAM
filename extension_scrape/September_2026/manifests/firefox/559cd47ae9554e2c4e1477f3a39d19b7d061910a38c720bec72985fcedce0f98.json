{"manifest_version": 2, "name": "Prime Episode Spoiler Blur", "version": "1.1.1", "description": "Blurs Prime Video episode images and descriptions until you reveal them.", "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://*.primevideo.com/*", "*://*.amazon.com/gp/video/*", "*://*.amazon.co.uk/gp/video/*", "*://*.amazon.ca/gp/video/*", "*://*.amazon.de/gp/video/*", "*://*.amazon.fr/gp/video/*", "*://*.amazon.es/gp/video/*", "*://*.amazon.it/gp/video/*", "*://*.amazon.co.jp/gp/video/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Prime Episode Spoiler Blur", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "prime-episode-spoiler-blur@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}