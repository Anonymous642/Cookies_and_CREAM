{"manifest_version": 3, "name": "Ignition Utility", "version": "0.1.0", "description": "Quick utilities for Ignition Perspective development", "browser_specific_settings": {"gecko": {"id": "ignition-utility@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "109.0"}}, "permissions": ["scripting", "activeTab", "storage", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"48": "Ignition_Extension_Icon.png", "96": "Ignition_Extension_Icon.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Ignition Utility", "default_icon": "Ignition_Extension_Icon.png"}, "sidebar_action": {"default_panel": "sidepanel/sidepanel.html", "default_title": "Ignition Utility", "default_icon": "Ignition_Extension_Icon.png", "open_at_install": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Toggle Ignition Utility sidebar"}}}