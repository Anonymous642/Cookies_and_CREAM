{"manifest_version": 3, "name": "Aar318's Live Chat Translator", "version": "1.8.0.1", "description": "Translate Twitch, Kick, and YouTube Live chat automatically, on click, or on hover, with outbound draft translation.", "permissions": ["storage", "contextMenus"], "host_permissions": ["https://www.twitch.tv/*", "https://m.twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://translate.googleapis.com/*"], "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://m.twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["twitch-translator.js"], "run_at": "document_start", "all_frames": true}], "background": {"scripts": ["translator-background.js"]}, "web_accessible_resources": [{"resources": ["kick-editor-bridge.js"], "matches": ["https://kick.com/*", "https://www.kick.com/*"]}], "browser_specific_settings": {"gecko": {"id": "twitch-kick-translator@aar318", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "icons": {"16": "icons/translator_inactive_16.png", "32": "icons/translator_inactive_32.png", "48": "icons/translator_inactive_48.png", "128": "icons/translator_inactive.png"}, "action": {"default_icon": {"16": "icons/translator_inactive_16.png", "32": "icons/translator_inactive_32.png", "48": "icons/translator_inactive_48.png", "128": "icons/translator_inactive.png"}, "default_title": "Aar318's Live Chat Translator"}}