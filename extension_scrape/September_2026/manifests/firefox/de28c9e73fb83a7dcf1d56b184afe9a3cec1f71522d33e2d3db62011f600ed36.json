{"manifest_version": 3, "name": "VIN Decoder & Workshop Manual Finder", "short_name": "WSM VIN Tools", "version": "1.0.0", "description": "Decode any VIN, check NHTSA recalls, and find the matching workshop manual. Buyer overlay on eBay, AutoTrader & Cars.com.", "author": "Workshop Manuals org", "homepage_url": "https://workshopmanuals.org/", "browser_specific_settings": {"gecko": {"id": "vin-decoder@workshopmanuals.org", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "action": {"default_popup": "popup/popup.html", "default_title": "VIN Decoder & Workshop Manual Finder", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://vpic.nhtsa.dot.gov/*", "https://api.nhtsa.gov/*", "https://workshopmanuals.org/*"], "content_scripts": [{"matches": ["https://www.ebay.com/itm/*", "https://www.facebook.com/marketplace/item/*", "https://www.autotrader.com/cars-for-sale/vehicle/*", "https://www.cars.com/vehicledetail/*", "https://*.craigslist.org/*/cto/*", "https://*.craigslist.org/*/ctd/*"], "js": ["content/marketplace.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}]}