{"manifest_version": 2, "name": "Tab Intent Classifier", "version": "1.3", "description": "Classifies browser tabs by estimated intent such as work, learning, entertainment, research, or distraction.", "permissions": ["tabs", "storage", "activeTab", "notifications"], "browser_action": {"default_title": "Tab Intent Classifier", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Tab-Intent-Classifier", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}