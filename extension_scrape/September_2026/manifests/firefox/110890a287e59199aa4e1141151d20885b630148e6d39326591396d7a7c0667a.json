{"manifest_version": 2, "name": "Otto Notificador de Hor\u00e1rios", "description": "Envia lembretes de batida de ponto mesmo com o Otto fechado.", "version": "1.0.5", "permissions": ["storage", "alarms", "notifications", "tabs", "https://app.ottoponto.com.br/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://app.ottoponto.com.br/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Otto Notificador", "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "otto-notificador@otto.local", "data_collection_permissions": {"required": ["none"]}}}}