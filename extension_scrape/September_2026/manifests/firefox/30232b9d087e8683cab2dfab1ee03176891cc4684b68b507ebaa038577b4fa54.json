{"manifest_version": 3, "name": "Ember \u2014 Ad Blocker & Redirect Guard", "description": "Blocks common web ads, warns about unwanted redirects, and offers experimental YouTube protection with Ember Pro.", "version": "0.8.25", "author": "Zero-point", "homepage_url": "https://emberblock.online", "permissions": ["storage", "identity", "declarativeNetRequest", "webRequest", "webRequestBlocking", "webRequestFilterResponse", "webNavigation", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["languages.js", "redirect-policy.js", "youtube-network.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "ember@emberblock.online", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "options_page": "options.html", "action": {"default_title": "Ember", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "declarative_net_request": {"rule_resources": [{"id": "ember_ads", "enabled": true, "path": "rules/ads.json"}]}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtu.be/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["*://youtube.com/*", "*://*.youtube.com/*"], "js": ["youtube-pro.js"], "run_at": "document_start"}]}