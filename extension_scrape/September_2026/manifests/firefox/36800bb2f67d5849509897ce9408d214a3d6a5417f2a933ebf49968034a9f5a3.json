{"manifest_version": 2, "name": "AV Volume Booster", "version": "1.6", "description": "Boost the audio volume of a tab above 100%. Persists across page navigation and reloads, with a per-tab badge showing the active level.", "author": "breakingbad", "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_title": "AV Volume Booster", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "avtab-volume-boost@local", "data_collection_permissions": {"required": ["none"]}}}}