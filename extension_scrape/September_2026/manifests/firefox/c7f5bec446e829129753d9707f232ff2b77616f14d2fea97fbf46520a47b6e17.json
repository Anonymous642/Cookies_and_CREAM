{"manifest_version": 2, "name": "Lecteur & R\u00e9sum\u00e9 d'Articles", "version": "1.0.0", "description": "Lit \u00e0 voix haute et r\u00e9sume les articles de l'onglet actif, enti\u00e8rement en fran\u00e7ais, sans service externe.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "contextMenus", "storage", "notifications"], "background": {"scripts": ["lib/summarizer.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Lecteur & R\u00e9sum\u00e9 d'Articles", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "commands": {"read-article": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Lire l'article de l'onglet actif"}, "stop-reading": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Arr\u00eater la lecture en cours"}}, "browser_specific_settings": {"gecko": {"id": "lecteur-resume-articles@thomaslapeyre.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}