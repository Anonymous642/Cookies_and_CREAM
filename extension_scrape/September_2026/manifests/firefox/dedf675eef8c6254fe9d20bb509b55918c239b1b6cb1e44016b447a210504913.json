{"manifest_version": 3, "name": "Serenity Mayhem", "description": "Random sounds while you watch YouTube.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["sounds/*"], "matches": ["*://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "serenity-mayhem@kokakiwi", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Serenity Mayhem", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/content.js"]}]}