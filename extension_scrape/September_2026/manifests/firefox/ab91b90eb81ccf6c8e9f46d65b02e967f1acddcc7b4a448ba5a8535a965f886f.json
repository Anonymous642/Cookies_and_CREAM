{"manifest_version": 2, "name": "TabMood Wallpaper", "version": "1.0", "description": "Automatically apply a lightweight background for each tab based on site theme (news \u2192 paper, youtube \u2192 dark, wikipedia \u2192 old-book).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "TabMood", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "tabmood@example.com"}}}