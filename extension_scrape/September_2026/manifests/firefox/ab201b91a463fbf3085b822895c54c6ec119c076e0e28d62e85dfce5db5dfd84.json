{"manifest_version": 3, "name": "Wideframe Video Crop", "version": "1.2.0", "description": "Fill your ultrawide screen. Drag the video controls, cycle Auto, Fill, Fit, Stretch and Reset, and adjust X/Y zoom.", "browser_specific_settings": {"gecko": {"id": "wideframe@video-crop.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Wideframe Video Crop", "default_popup": "popup.html", "default_icon": "icons/wideframe.svg"}, "icons": {"48": "icons/wideframe.svg", "96": "icons/wideframe.svg"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["core.js", "content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}]}