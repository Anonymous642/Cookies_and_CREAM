{"manifest_version": 3, "name": "Metaforge", "version": "1.0.0", "description": "Official Metaforge extension for handling OAuth callbacks on metaforge.app", "icons": {"128": "assets/logo.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["http://127.0.0.1/*", "https://metaforge.app/*"], "content_scripts": [{"matches": ["https://metaforge.app/*"], "js": ["presence.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "metaforge@metaforge.app", "data_collection_permissions": {"required": ["none"]}}}}