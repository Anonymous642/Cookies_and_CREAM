{"manifest_version": 3, "name": "Kawaii Tab Tamer", "version": "2.0.0", "description": "Lovingly blocks news home pages, counts your open tabs, reminds you to work through them and rewards every tab you close.", "homepage_url": "https://github.com/baslr/Kawaii-Tab-Tamer", "permissions": ["tabs", "storage", "scripting", "webNavigation", "alarms", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "scripts": ["src/shared.js", "src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/shared.js", "src/overlay.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Kawaii Tab Tamer", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "kawaii-tab-tamer@baesler.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}