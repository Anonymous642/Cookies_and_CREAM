{"manifest_version": 2, "name": "Octocopy", "description": "Copy GitHub PR details into your clipboard.", "version": "1.2.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["clipboardWrite", "storage", "contextMenus", "https://github.com/*", "https://api.github.com/*", "http://localhost:3000/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "{37b71737-51d9-4a96-a97f-2d49500c10f7}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Octocopy Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://app.graphite.com/github/pr/*", "*://github.com/*/*/pull/*"], "js": ["content-scripts/content.js"]}]}