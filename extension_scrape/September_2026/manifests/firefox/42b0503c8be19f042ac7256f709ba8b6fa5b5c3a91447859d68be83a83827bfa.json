{"manifest_version": 2, "name": "AI Block for YouTube", "version": "0.1.1", "description": "Flags or hides YouTube videos from blocked channels and lets users report channels for review.", "homepage_url": "https://github.com/echosintherain/aiblockyoutube", "permissions": ["alarms", "contextMenus", "storage", "tabs", "*://*.youtube.com/*", "https://*.deadinternet.co.uk/*", "https://api.github.com/*", "https://raw.githubusercontent.com/*"], "background": {"scripts": ["src/shared.js", "src/background.js"]}, "icons": {"48": "icons/ai-no.svg", "96": "icons/ai-no.svg"}, "browser_action": {"default_icon": "icons/ai-no.svg", "default_popup": "src/popup.html", "default_title": "AI Block for YouTube"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "aiblockyoutube@deadinternet.co.uk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "technicalAndInteraction", "websiteActivity", "websiteContent"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/shared.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}