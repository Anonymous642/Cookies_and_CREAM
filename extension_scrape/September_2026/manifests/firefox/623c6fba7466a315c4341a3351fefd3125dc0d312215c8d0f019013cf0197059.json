{"manifest_version": 2, "name": "Comment Sentiment Detector", "version": "1.3", "description": "Detect and summarize sentiment (positive, neutral, negative) from comments on web pages.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Comment Sentiment Detector", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Comment-Sentiment-Detector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}