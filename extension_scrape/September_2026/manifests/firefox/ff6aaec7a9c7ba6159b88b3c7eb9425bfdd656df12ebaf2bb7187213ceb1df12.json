{"manifest_version": 3, "name": "Anti Game Blocker", "short_name": "Anti Game", "version": "0.2.5", "description": "Bloqueador local de sites de apostas para reduzir impulso e apoiar rotinas digitais mais seguras.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png", "512": "assets/icon-512.png"}, "action": {"default_title": "Anti Game Blocker", "default_popup": "pages/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}}, "background": {"scripts": ["config.js", "data/default-domains.js", "background.js"]}, "declarative_net_request": {"rule_resources": [{"id": "anti_game_default_gambling", "enabled": true, "path": "rules/default-gambling.json"}]}, "permissions": ["alarms", "declarativeNetRequest", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["pages/blocked.html", "pages/blocked.css", "pages/blocked.js", "assets/*"], "matches": ["<all_urls>"]}], "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "anti-game-blocker@antigame.lovable.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "personallyIdentifyingInfo", "technicalAndInteraction"]}}}}