{"manifest_version": 2, "name": "Task Reminder Pro", "version": "1.0", "description": "Never forget your daily, tomorrow, or next week tasks! This extension reminds you of your scheduled to-dos right on time.", "permissions": ["activeTab", "storage", "notifications", "alarms"], "background": {"scripts": ["src/background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"]}], "browser_action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icon16.png", "48": "bg.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "bg.png", "128": "icon128.png"}, "web_accessible_resources": ["bg.png"], "browser_specific_settings": {"gecko": {"id": "task-reminder-pro@example.com"}}}