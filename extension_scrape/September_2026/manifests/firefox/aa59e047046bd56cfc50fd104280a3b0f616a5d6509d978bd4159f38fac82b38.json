{"manifest_version": 2, "name": "Letterboxd Movie Tracker", "version": "2.1", "description": "Track your downloaded, streaming, and watched movies on Letterboxd", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "letterboxd-movie-tracker@reelmark", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "https://letterboxd.com/*"], "browser_action": {"default_icon": "icons/icon48.png", "default_popup": "src/popup.html", "default_title": "Movie Tracker"}, "content_scripts": [{"matches": ["https://letterboxd.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["src/background.js"], "persistent": false}}