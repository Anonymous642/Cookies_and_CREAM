{"manifest_version": 2, "name": "Decision Delay Tracker", "version": "1.3", "description": "Track hesitation patterns and delayed decision behavior during browsing sessions.", "permissions": ["tabs", "storage", "activeTab", "notifications"], "browser_action": {"default_title": "Decision Delay Tracker", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Decision-Delay-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}