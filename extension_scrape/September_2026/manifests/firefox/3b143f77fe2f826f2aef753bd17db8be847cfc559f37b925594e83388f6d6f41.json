{"manifest_version": 2, "name": "NeonCodex AI", "version": "1.7.0", "description": "Chat with Claude Sonnet 5.5, Opus 5.5, GPT-5.5, Gemini and more in the sidebar. Ask about any page and act on selected text.", "homepage_url": "https://neoncodex.io", "browser_specific_settings": {"gecko": {"id": "neoncodex@neoncodex.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "Open NeonCodex", "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png"}}, "sidebar_action": {"default_title": "NeonCodex", "default_panel": "panel.html", "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png"}, "open_at_install": false}, "background": {"scripts": ["lib/api.js", "lib/actions.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/md.js", "lib/actions.js", "content.js"], "run_at": "document_idle"}], "permissions": ["contextMenus", "storage", "activeTab", "scripting", "https://neoncodex.io/*"], "commands": {"toggle-sidebar": {"suggested_key": {"default": "Ctrl+Shift+N", "mac": "Command+Shift+N"}, "description": "Open the NeonCodex sidebar"}, "quick-summarize": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Summarize the current page"}}}