{"manifest_version": 2, "name": "OpenTabs: Save trees by opening new tabs", "short_name": "OpenTabs", "version": "2.52.7", "description": "Customize your new tab page so you can fight climate change while browsing the web. Save trees by doing what you do every day.", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "OpenTabs", "default_icon": "icons/32.png"}, "chrome_settings_overrides": {"search_provider": {"name": "OpenTabs", "keyword": "OpenTabs", "favicon_url": "https://opentabs.org/icons/16.png", "search_url": "https://search.opentabs.org/?tab=web&q={searchTerms}", "suggest_url": "https://autocomplete.wellnessfueled.com/autocomplete/autocomplete?kwd={searchTerms}&count=5", "encoding": "UTF-8", "is_default": true}, "homepage": "index.html"}, "chrome_url_overrides": {"newtab": "index.html"}, "content_security_policy": "script-src 'self'; object-src 'self'", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "cookies", "*://*.opentabs.org/*"], "optional_permissions": ["topSites"], "browser_specific_settings": {"gecko": {"id": "{52393958-42ec-4745-a0d6-5aa822bdb899}"}}}