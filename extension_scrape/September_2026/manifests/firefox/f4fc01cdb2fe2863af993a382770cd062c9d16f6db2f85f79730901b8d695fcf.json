{"manifest_version": 3, "name": "Brotab", "version": "1.2.1", "description": "Transform your new tab into a powerful bookmark management system", "permissions": ["menus", "bookmarks", "storage", "tabs"], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://brotab.com; object-src 'self';"}, "background": {"scripts": ["background.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "index.html"}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "brotab@brotab.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"], "optional": []}}}}