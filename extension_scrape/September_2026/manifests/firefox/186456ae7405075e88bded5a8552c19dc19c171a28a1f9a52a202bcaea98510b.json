{"manifest_version": 2, "name": "Brand Mention Finder", "version": "1.3", "description": "Finds, highlights, and counts brand mentions on web pages in real time to help monitor brand visibility and online presence.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_title": "Brand Mention Finder", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "brand-mention-finder@example.com"}}, "browser_specific_settings": {"gecko": {"id": "@Brand-Mention-Finder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}