{"manifest_version": 3, "name": "TRAEMS", "version": "1.0.3", "description": "TRAEMS browser extension for quick access to absence reporting, schedules, and time tracking", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "notifications", "alarms", "tabs"], "host_permissions": ["https://*.traems.com/*", "https://*.amazoncognito.com/*", "https://login.microsoftonline.com/*", "https://accounts.google.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "traems@traems.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "126.0"}}}