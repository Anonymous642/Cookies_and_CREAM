{"manifest_version": 3, "name": "PriceHistory.ai: Tracker & Shopping Lens", "version": "1.7.5", "description": "Track price history, view trends, and get instant price-drop alerts across major Indian shopping sites.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "cookies", "alarms", "activeTab", "scripting", "offscreen", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "sandbox": {"pages": ["sandbox.html"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'", "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'self'"}, "content_scripts": [{"matches": ["https://pricehistory.ai/*", "https://www.pricehistory.ai/*"], "js": ["logger.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://www.amazon.in/*", "https://www.amazon.com/*", "https://www.flipkart.com/*", "https://www.myntra.com/*", "https://www.reliancedigital.in/*", "https://www.nykaa.com/*", "https://www.firstcry.com/*", "https://www.ajio.com/*", "https://www.tatacliq.com/*"], "js": ["logger.js", "product-content.js"], "css": ["product-overlay.css"], "run_at": "document_idle"}], "action": {"default_title": "PriceHistory.ai", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "pricehistory-ai@pricehistory.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}