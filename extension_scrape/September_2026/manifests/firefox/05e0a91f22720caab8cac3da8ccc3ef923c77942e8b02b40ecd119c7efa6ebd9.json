{"manifest_version": 3, "name": "SwipeTube", "version": "1.15.0", "description": "One-video-at-a-time card interface for the YouTube home page and subscriptions feed. Swipe through videos Tinder-style: not interested, don't recommend, unsubscribe, queue, or watch.", "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content/page-bridge.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://www.youtube.com/*"], "js": ["content/swipetube.js"], "css": ["content/swipetube.css"], "run_at": "document_idle"}], "action": {"default_title": "SwipeTube", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "swipetube@swipetube.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}