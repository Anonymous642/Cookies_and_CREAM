{"manifest_version": 2, "name": "fuzzytab", "description": "A keyboard focused fzf inspired browser extension for blazingly fast navigation.", "version": "0.7.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["bookmarks", "tabs", "storage", "contextualIdentities"], "browser_specific_settings": {"gecko": {"id": "fuzzytab@vasujain.me"}}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "Fuzzytab", "default_popup": "popup.html"}}