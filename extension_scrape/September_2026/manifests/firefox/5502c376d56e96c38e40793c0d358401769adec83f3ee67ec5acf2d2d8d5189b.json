{"manifest_version": 3, "name": "R3dMarks", "version": "2.0.3", "description": "An offline-first bookmark homepage. Turns a bookmarks folder into a drag-and-drop board; syncs only your layout + settings to your Firefox account.", "browser_specific_settings": {"gecko": {"id": "{777e1e1d-0b1e-4098-a453-cd1db650b01b}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["bookmarks", "storage", "unlimitedStorage"], "host_permissions": ["*://*/*"]}