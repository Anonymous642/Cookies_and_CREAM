{"manifest_version": 3, "name": "Pinned \u2014 Schedule inside chat", "version": "0.2.0", "description": "Add a calendar scheduling widget to Gmail, WhatsApp Web, and LinkedIn Messages \u2014 without leaving the chat.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "notifications"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["widget/widget.js", "content/gmail.js"], "css": ["widget/widget.css"], "run_at": "document_idle"}, {"matches": ["https://web.whatsapp.com/*"], "js": ["content/whatsapp.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/messaging/*"], "js": ["widget/widget.js", "content/linkedin.js"], "css": ["widget/widget.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pinned@pinnedapp.tech", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}