{"manifest_version": 3, "name": "WebTranslate Mini", "version": "1.2", "author": "swbasmx", "description": "Traductor flotante minimalista: traduce palabras al pasar el rat\u00f3n o frases seleccion\u00e1ndolas. Configura tus idiomas en los ajustes.", "permissions": ["scripting", "storage"], "host_permissions": ["https://translate.googleapis.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "webtranslate-mini@swbasmx.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}