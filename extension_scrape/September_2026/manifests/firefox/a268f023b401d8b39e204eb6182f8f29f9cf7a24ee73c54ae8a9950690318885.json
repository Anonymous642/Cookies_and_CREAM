{"manifest_version": 3, "name": "NitterPlease", "version": "1.2.5", "description": "Redirect X/Twitter to Nitter. Privacy-first Twitter alternative with built-in instance selector.", "author": "alvarosdev", "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://twitter.com/*", "*://www.twitter.com/*", "*://x.com/*", "*://www.x.com/*", "*://nitter.net/*", "*://nitter.poast.org/*", "*://xcancel.com/*", "*://nitter.catsarch.com/*", "*://nitter.tiekoetter.com/*", "*://lightbrd.com/*", "*://nitter.space/*", "*://nitter.privacyredirect.com/*", "*://nuku.trabun.org/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/index.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["loading.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "nitterplease@alvaros.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}