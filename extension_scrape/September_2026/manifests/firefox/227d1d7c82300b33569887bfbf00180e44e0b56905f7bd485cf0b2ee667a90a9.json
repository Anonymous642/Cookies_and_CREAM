{"manifest_version": 3, "name": "LinkedIn Job Blocker", "version": "1.0", "description": "Block job postings from specific companies on LinkedIn", "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.linkedin.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "LinkedIn Job Blocker", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://www.linkedin.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "linkedin-job-blocker@localhost", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "web_accessible_resources": [{"resources": ["lib/*.js", "content/*.js", "popup/*.js"], "matches": ["*://www.linkedin.com/*"]}]}