{"manifest_version": 2, "name": "YouTube Copy Video Info", "version": "1.0", "description": "Copy YouTube video Title, Channel, Views, Date, URL and Description with customizable options", "author": "Eduardo S.", "browser_specific_settings": {"gecko": {"id": "youtube-copy-video-info@proyectosdeviernes.com", "data_collection_permissions": {"enabled": false, "required": ["none"]}}}, "permissions": ["activeTab", "clipboardWrite", "storage", "*://*.youtube.com/*"], "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "YouTube Copy Video Info", "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}