{"manifest_version": 3, "name": "mapy.com for strava.com", "version": "0.5.5", "description": "P\u0159id\u00e1v\u00e1 turistickou a leteckou mapu z Mapy.com jako podklad do Strava Route Builderu. Ide\u00e1ln\u00ed pro pl\u00e1nov\u00e1n\u00ed MTB v \u010cesku.", "homepage_url": "https://github.com/janjensik/mapy-com-for-strava-com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.strava.com/maps/*", "https://www.strava.com/routes/*", "https://www.strava.com/activities/*", "https://www.strava.com/athletes/*/heatmaps/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://www.strava.com/maps/*", "https://www.strava.com/routes/*", "https://www.strava.com/activities/*", "https://www.strava.com/athletes/*/heatmaps/*"], "js": ["config-bridge.js"], "run_at": "document_start", "world": "ISOLATED"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["https://www.strava.com/*"]}], "host_permissions": ["https://api.mapy.cz/*", "https://api.mapy.com/*"], "action": {"default_title": "mapy.com for strava.com", "default_popup": "popup.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "mapy-com-for-strava-com@janjensik.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}