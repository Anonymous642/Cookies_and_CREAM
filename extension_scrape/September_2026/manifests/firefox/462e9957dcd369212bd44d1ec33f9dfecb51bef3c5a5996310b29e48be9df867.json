{"name": "Varia Redirect", "description": "Redirect browser downloads to a local Varia (Aria2) instance with advanced filtering.", "version": "0.1.7", "manifest_version": 2, "icons": {"16": "icon/icon-disconnected-16.png", "32": "icon/icon-disconnected-32.png", "48": "icon/icon-disconnected-48.png", "128": "icon/icon-disconnected-128.png", "256": "icon/icon-disconnected-256.png"}, "permissions": ["downloads", "storage", "notifications", "tabs", "<all_urls>"], "browser_action": {"default_popup": "src/popup.html", "default_icon": "icon/icon-disconnected-48.png", "default_area": "navbar"}, "browser_specific_settings": {"gecko": {"id": "bethropolis@outlook.com"}}, "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self';", "background": {"scripts": ["src/background.js"]}, "options_ui": {"page": "src/options.html", "open_in_tab": true}}