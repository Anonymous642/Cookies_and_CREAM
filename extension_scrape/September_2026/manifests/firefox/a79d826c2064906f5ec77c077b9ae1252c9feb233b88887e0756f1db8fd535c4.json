{"manifest_version": 2, "name": "Turbo Scroll", "default_locale": "en", "version": "1.0.1", "description": "__MSG_extensionDescription__", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "turbo-scroll@mercan.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Turbo Scroll", "default_popup": "popup/popup.html"}, "commands": {"toggle-scroll": {"suggested_key": {"default": "Alt+S"}, "description": "Start/Stop auto-scroll"}, "speed-up": {"suggested_key": {"default": "Alt+Up"}, "description": "Increase scroll speed"}, "speed-down": {"suggested_key": {"default": "Alt+Down"}, "description": "Decrease scroll speed"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}