{"name": "HTTP PUTter (Conditional)", "version": "1.2.0", "description": "Send the current page's content via HTTP PUT using ETag and Last-Modified for conditional requests.", "manifest_version": 3, "author": "Danny Milosavljevic (Improved by AI)", "icons": {"16": "img/icon-16x16.png", "32": "img/icon-32x32.png", "48": "img/icon-48x48.png", "128": "img/icon-128x128.png"}, "permissions": ["activeTab", "scripting", "webRequest", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Send page via HTTP PUT (conditional)"}, "background": {"scripts": ["background.js"]}, "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "put@friendly-machines.com", "strict_min_version": "126.0"}}}