{"manifest_version": 3, "name": "BeeSerp: Etsy Seller Toolkit", "version": "2.28.0", "description": "See real search volume, SEO scores, sales estimates and competitor tags right on Etsy. Free tag research, no account needed.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "BeeSerp Competitor Spy"}, "background": {"scripts": ["zip-writer.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "beeserp@beeserp.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.etsy.com/*"], "js": ["seo-scoring.js", "content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.etsy.com/*", "https://beeserp.com/*", "https://i.etsystatic.com/*", "https://v.etsystatic.com/*"], "web_accessible_resources": [{"resources": ["icons/*.png", "icons/logo.png"], "matches": ["https://www.etsy.com/*"]}]}