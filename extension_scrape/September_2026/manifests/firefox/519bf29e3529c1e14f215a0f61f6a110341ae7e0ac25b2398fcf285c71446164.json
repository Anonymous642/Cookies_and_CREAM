{"manifest_version": 3, "name": "Kick Emote Holder", "version": "5", "description": "Favorite emotes (Kick + 7TV + BTTV), quick-access bar above chat input, drag reorder, send-or-insert on click.", "permissions": ["storage"], "host_permissions": ["https://kick.com/*", "https://*.kick.com/*", "https://7tv.io/*", "https://api.betterttv.net/*"], "content_scripts": [{"matches": ["https://kick.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "Kick Emote Holder", "default_popup": "popup.html"}, "icons": {"16": "logo16.png", "32": "logo32.png", "48": "logo48.png", "128": "logo128.png"}, "browser_specific_settings": {"gecko": {"id": "kick-emote-holder@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}