{"manifest_version": 3, "name": "OGBert", "version": "0.1.0", "description": "Enhanced browser history with rich metadata capture and full-text search", "browser_specific_settings": {"gecko": {"id": "ogbert@potch.me", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/extractor.js"], "run_at": "document_idle"}], "action": {"default_title": "OGBert - Enhanced History", "default_popup": "ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "ui/newtab.html"}, "web_accessible_resources": [{"resources": ["lib/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}