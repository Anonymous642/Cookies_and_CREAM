{"manifest_version": 2, "name": "Always Word Count in Google Docs", "key": "@always-word-count", "version": "1.0", "description": "Automatically enables the persistent word count bar in Google Docs.", "permissions": ["*://docs.google.com/*"], "browser_specific_settings": {"gecko": {"id": "@always-word-count", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://docs.google.com/document/*"], "js": ["content.js"], "run_at": "document_idle"}]}