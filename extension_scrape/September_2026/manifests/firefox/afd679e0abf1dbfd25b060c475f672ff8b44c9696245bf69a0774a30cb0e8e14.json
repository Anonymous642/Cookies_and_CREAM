{"manifest_version": 3, "name": "Chess.com to Lichess", "version": "1.0", "description": "Add a button to export games from Chess.com analysis to Lichess", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["*://www.chess.com/analysis/*", "*://lichess.org/paste*"], "content_scripts": [{"matches": ["*://www.chess.com/analysis/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://lichess.org/paste?ext=true"], "js": ["lichess.js"], "run_at": "document_idle"}], "action": {"default_title": "Chess.com to Lichess"}, "web_accessible_resources": [{"resources": ["icons/lichess.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "chess-to-lichess@example.com", "strict_min_version": "102.0"}}}