{"manifest_version": 3, "name": "Phoenix Config Updater", "version": "1.0.0", "description": "Automatically check for and manage updates to the Phoenix Firefox configuration by Celenityy", "permissions": ["storage", "activeTab", "notifications", "alarms", "menus"], "host_permissions": ["https://gitlab.com/*", "https://github.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Phoenix Config Updater", "default_icon": {"16": "icons/phoenix-16.png", "32": "icons/phoenix-32.png", "48": "icons/phoenix-48.png", "128": "icons/phoenix-128.png"}}, "icons": {"16": "icons/phoenix-16.png", "32": "icons/phoenix-32.png", "48": "icons/phoenix-48.png", "128": "icons/phoenix-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "phoenixconfigupdater@privacymatters", "strict_min_version": "58.0"}}}