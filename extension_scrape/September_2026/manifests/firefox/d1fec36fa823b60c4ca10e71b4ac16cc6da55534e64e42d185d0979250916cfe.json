{"manifest_version": 3, "name": "Intentful YouTube", "version": "1.0", "description": "Removes algorithmic feeds, leaving only the search bar and video player.", "browser_specific_settings": {"gecko": {"id": "intentful-youtube@yourname.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["scripting"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_start"}]}