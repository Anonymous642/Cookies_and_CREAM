{"manifest_version": 3, "name": "AS24 Tools", "version": "0.2.6", "description": "Firefox extension for AutoScout24: hides sponsored listings and adds custom badges based on terms searched in the vehicle description.", "browser_specific_settings": {"gecko": {"id": "as24tools@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.autoscout24.com/*", "*://*.autoscout24.it/*", "*://*.autoscout24.de/*", "*://*.autoscout24.fr/*", "*://*.autoscout24.es/*", "*://*.autoscout24.nl/*", "*://*.autoscout24.at/*", "*://*.autoscout24.be/*", "*://*.autoscout24.ch/*", "*://*.autoscout24.pl/*", "*://*.autoscout24.dk/*", "*://*.autoscout24.fi/*", "*://*.autoscout24.se/*", "*://*.autoscout24.no/*", "*://*.autoscout24.pt/*", "*://*.autoscout24.cz/*", "*://*.autoscout24.hu/*", "*://*.autoscout24.ro/*"], "action": {"default_popup": "src/popup.html", "default_title": "AS24 Tools"}, "content_scripts": [{"matches": ["*://*.autoscout24.com/*", "*://*.autoscout24.it/*", "*://*.autoscout24.de/*", "*://*.autoscout24.fr/*", "*://*.autoscout24.es/*", "*://*.autoscout24.nl/*", "*://*.autoscout24.at/*", "*://*.autoscout24.be/*", "*://*.autoscout24.ch/*", "*://*.autoscout24.pl/*", "*://*.autoscout24.dk/*", "*://*.autoscout24.fi/*", "*://*.autoscout24.se/*", "*://*.autoscout24.no/*", "*://*.autoscout24.pt/*", "*://*.autoscout24.cz/*", "*://*.autoscout24.hu/*", "*://*.autoscout24.ro/*"], "js": ["src/common.js", "src/content.js"], "run_at": "document_idle"}]}