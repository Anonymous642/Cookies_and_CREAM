{"manifest_version": 3, "name": "ScreenLab", "version": "1.0.0", "description": "Viewport resizer for responsive testing - view pages at different device sizes", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle ScreenLab", "default_icon": {"16": "icons/icon-off-16.png", "32": "icons/icon-off-32.png", "48": "icons/icon-off-48.png", "128": "icons/icon-off-128.png"}}, "icons": {"16": "icons/icon-off-16.png", "48": "icons/icon-off-48.png", "128": "icons/icon-off-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scrollSync.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "screenlab@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}