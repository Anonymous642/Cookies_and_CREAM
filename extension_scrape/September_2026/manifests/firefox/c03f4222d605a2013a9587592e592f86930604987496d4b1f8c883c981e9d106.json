{"manifest_version": 2, "name": "Chatly - AI Assistant for Every Tab", "description": "Chat with any webpage, summarize YouTube videos, write emails, and analyze files - without leaving your tab.", "version": "2.0.1", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "cookies", "tabs", "activeTab", "scripting", "contextMenus", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "chatly@chatlyai.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "web_accessible_resources": ["youtube-main-world.js", "content-scripts/article-widget.css", "content-scripts/floating-widget.css", "content-scripts/gmail-ai-button.css", "content-scripts/gmail-compose-assistant.css", "content-scripts/gmail-thread-reply.css", "content-scripts/selection-toolbar.css", "content-scripts/youtube-widget.css"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+M", "mac": "Command+M"}, "description": "Open Chatly"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Chatly"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/article-widget.js", "content-scripts/floating-widget.js", "content-scripts/selection-toolbar.js"]}, {"matches": ["*://mail.google.com/*"], "js": ["content-scripts/gmail-ai-button.js", "content-scripts/gmail-compose-assistant.js", "content-scripts/gmail-thread-reply.js"]}, {"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube-widget.js"]}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube.js"]}], "browser_action": {"default_title": "Open Chatly", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}}