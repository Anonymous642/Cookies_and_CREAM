{"manifest_version": 3, "name": "FontChanger", "version": "1.0.0", "description": "Simple font size adjuster. Increase or decrease font size on any webpage with one click.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "FontChanger", "default_popup": "popup/adjust.html"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "fontchanger@accessibility.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}