{"manifest_version": 3, "name": "GeckoBridge", "version": "1.0.1", "description": "Compatibility mode for Firefox and Zen. Fixes sites that break or refuse to load because they expect Chrome.", "author": "GeckoBridge", "homepage_url": "https://github.com/local/geckobridge", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "geckobridge-2@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["lib/config.js", "lib/hosts.js", "lib/recipes.js", "lib/ua.js", "lib/settings.js", "lib/headers.js", "lib/diagnostics.js", "background/background.js"]}, "action": {"default_title": "GeckoBridge", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "scripting", "browsingData", "cookies", "activeTab"], "host_permissions": ["<all_urls>"], "optional_host_permissions": ["<all_urls>"], "commands": {"toggle-compat": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Toggle compatibility mode for the current site"}}}