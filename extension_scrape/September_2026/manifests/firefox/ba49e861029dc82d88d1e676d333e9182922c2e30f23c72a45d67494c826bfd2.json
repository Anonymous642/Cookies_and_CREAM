{"manifest_version": 3, "name": "Qwen Chat Prettify", "version": "1.1.0", "description": "Changes the max-width of elements in Qwen Chat (chat.qwen.ai) to user-defined values. Supports custom widths for messages, input field, sidebar, chat items, and tip text via an injected content script that applies CSS dynamically.", "browser_specific_settings": {"gecko": {"id": "qwen-width-override@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting"], "host_permissions": ["https://chat.qwen.ai/*"], "icons": {"48": "icon_48.png", "96": "icon_96.png"}, "content_scripts": [{"matches": ["https://chat.qwen.ai/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Qwen Chat Width", "default_icon": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "96": "icon_96.png"}}}