{"manifest_version": 3, "name": "GASS Landing Page Inspector", "version": "1.3.1", "description": "Detect GASS tracking install (JS, CTA link, visitor_id) plus Meta/TikTok pixels and page tech.", "browser_specific_settings": {"gecko": {"id": "gass-inspector@gass.co.id", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["scripting", "activeTab"], "optional_host_permissions": ["*://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["detect.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "GASS Inspector", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}