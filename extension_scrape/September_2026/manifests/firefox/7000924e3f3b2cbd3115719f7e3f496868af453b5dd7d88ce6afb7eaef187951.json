{"manifest_version": 2, "name": "Remote Tab Controller", "version": "1.2.1", "description": "Remotely control tabs, read webpage content and links", "browser_specific_settings": {"gecko": {"id": "remote-tab-controller@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "nativeMessaging", "<all_urls>", "webNavigation", "cookies", "contextualIdentities", "webRequest", "webRequestBlocking", "activeTab"], "background": {"scripts": ["background.js"], "persistent": true}}