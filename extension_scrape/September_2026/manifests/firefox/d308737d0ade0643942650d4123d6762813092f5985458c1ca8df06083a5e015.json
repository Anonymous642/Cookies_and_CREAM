{"manifest_version": 3, "name": "Grounded", "version": "1.0.3", "description": "Enforces website blocking rules pushed by the Grounded desktop app.", "browser_specific_settings": {"gecko": {"id": "hello@grounded.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webNavigation", "scripting", "tabs", "storage", "alarms", "nativeMessaging"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}