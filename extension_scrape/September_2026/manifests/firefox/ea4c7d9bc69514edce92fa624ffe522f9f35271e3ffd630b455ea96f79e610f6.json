{"manifest_version": 3, "name": "WasItAI", "description": "This extension connects to your WasItAI account and lets you analyze images you encounter while browsing the web to determine whether they are likely AI-generated or human-created. After signing in with your WasItAI account, you are good to go!", "version": "1.0.4", "browser_specific_settings": {"gecko": {"id": "firefox@wasitai.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["activeTab", "scripting", "contextMenus", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"16": "assets/img/icons/default_icon_16x16.png", "32": "assets/img/icons/default_icon_32x32.png", "48": "assets/img/icons/default_icon_48x48.png", "128": "assets/img/icons/default_icon_128x128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["config.js", "background.js"]}, "icons": {"16": "assets/img/icons/default_icon_16x16.png", "32": "assets/img/icons/default_icon_32x32.png", "48": "assets/img/icons/default_icon_48x48.png", "128": "assets/img/icons/default_icon_128x128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "content.js"]}], "web_accessible_resources": [{"resources": ["assets/img/emoji/emoji-1.png", "assets/img/emoji/emoji-2.png", "assets/img/emoji/emoji-3.png", "assets/img/emoji/emoji-4.png", "assets/img/emoji/emoji-5.png", "assets/img/arrow-down.svg", "assets/img/wasitai-logo.svg"], "matches": ["<all_urls>"]}]}