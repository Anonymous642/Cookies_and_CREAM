{"name": "ExcaliRooms", "version": "0.0.0", "description": "An awesome new browser extension", "homepage_url": "https://soundboards.app", "manifest_version": 2, "minimum_chrome_version": "121", "browser_specific_settings": {"gecko": {"id": "excalirooms@soundboards.app", "strict_min_version": "109.0"}}, "icons": {"128": "icon128.png"}, "permissions": ["storage", "identity", "tabs", "https://soundboards.app/*", "http://localhost:8033/*"], "content_scripts": [{"matches": ["https://excalirooms.soundboards.app/*"], "js": ["browser-polyfill.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_security_policy": "script-src 'self' 'unsafe-eval' https://www.gstatic.com; object-src 'self'", "web_accessible_resources": ["browser-polyfill.js", "firebase-app-compat.js", "firebase-auth-compat.js", "firebase-ui-auth.js", "firebase-ui-auth.css"]}