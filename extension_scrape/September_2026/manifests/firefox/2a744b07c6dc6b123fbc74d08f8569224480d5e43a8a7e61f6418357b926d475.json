{"manifest_version": 3, "name": "Slimbr Patient Lookup", "version": "1.4.1", "description": "Internal Slimbr tool. Right-click a name or email in Gmail to open Sales, Doctor, Dietician, or retention.", "permissions": ["contextMenus", "notifications", "scripting", "tabs", "clipboardWrite"], "host_permissions": ["https://slimbr.com/*", "http://localhost:3000/*", "https://mail.google.com/*"], "background": {"service_worker": "background.js", "scripts": ["extension-api.js", "background.js"]}, "content_scripts": [{"matches": ["https://slimbr.com/*", "http://localhost:3000/*"], "js": ["content-script.js"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["gmail-content-script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "slimbr-patient-lookup@slimbr.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}}