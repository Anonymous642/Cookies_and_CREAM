{"manifest_version": 3, "name": "Qorcam - Screen Recorder + Webcam Overlay", "version": "2.0.1", "description": "Screen recording with webcam overlay", "browser_specific_settings": {"gecko": {"id": "qorcam@swehacker", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"], "action": {"default_title": "QorCam", "default_popup": "src/sidepanel/index.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"screenshot": {"suggested_key": {"default": "Alt+Shift+N", "linux": "Alt+Shift+N"}, "description": "Take Screenshot"}}, "web_accessible_resources": [{"resources": ["src/compositor/index.html", "src/editor/index.html"], "matches": ["<all_urls>"]}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}