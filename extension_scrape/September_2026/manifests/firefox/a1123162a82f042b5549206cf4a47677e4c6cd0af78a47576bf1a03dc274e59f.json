{"manifest_version": 2, "name": "ParcelTag", "description": "Detect and import tracking numbers into ParcelTag.", "version": "0.0.1", "icons": {"16": "/icons/16.png", "48": "/icons/48.png", "128": "/icons/128.png"}, "permissions": ["activeTab", "storage", "scripting", "cookies", "tabs", "https://*.supabase.co/*", "https://parceltag.app/*"], "browser_specific_settings": {"gecko": {"id": "extension@parceltag.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "ParcelTag", "default_popup": "popup.html"}}