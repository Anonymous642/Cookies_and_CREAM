{"manifest_version": 3, "name": "Day Progress Tracker", "version": "2.0", "description": "Tracks daily progress and safely fetches Google Calendar events.", "permissions": ["storage"], "host_permissions": ["https://calendar.google.com/calendar/ical/*"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "dayprogress-v2@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}}