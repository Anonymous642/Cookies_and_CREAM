{"manifest_version": 3, "name": "Review Sort for Amazon", "version": "1.0.1", "description": "Sort Amazon search results by review count and remove sponsored ads.", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "review-sort@nedjack.com", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "Icon16.png", "32": "Icon32.png", "48": "Icon48.png", "128": "Icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*"], "js": ["content.js"]}, {"matches": ["*://nedjack.com/review-sort-success/*"], "js": ["activation.js"]}], "icons": {"16": "Icon16.png", "32": "Icon32.png", "48": "Icon48.png", "128": "Icon128.png"}}