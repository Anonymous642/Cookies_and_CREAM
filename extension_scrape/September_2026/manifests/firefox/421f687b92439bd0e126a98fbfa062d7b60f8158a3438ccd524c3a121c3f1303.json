{"manifest_version": 3, "name": "Local YouTube MP3 Converter", "version": "1.0.0", "description": "Convert YouTube audio to MP3 entirely on your device with FFmpeg WebAssembly. Personal use only. Not affiliated with YouTube or Google.", "browser_specific_settings": {"gecko": {"id": "local-youtube-mp3@personal.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "downloads"], "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*", "*://*.ggpht.com/*", "*://*.ytimg.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "background": {"scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "js": ["src/inject-hook.js"], "run_at": "document_start"}, {"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "action": {"default_title": "Local YouTube MP3 Converter", "default_popup": "disclaimer/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "web_accessible_resources": [{"resources": ["src/logger.js", "src/page-bridge.js", "src/player-hook.js", "vendor/ffmpeg/*", "vendor/core/*", "vendor/util/*", "disclaimer/*", "icons/*"], "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"]}]}