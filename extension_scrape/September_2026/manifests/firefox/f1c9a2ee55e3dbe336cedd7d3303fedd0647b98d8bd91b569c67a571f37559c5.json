{"manifest_version": 3, "name": "ZeeKey - Persian/English Keyboard Fixer", "version": "1.1.0", "description": "Fixes text typed with the wrong keyboard layout (Persian \u2194 English) anywhere on a web page, including mixed paragraphs. Press F2 to convert. By zeecut.ir", "homepage_url": "https://www.zeecut.ir", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "zeekey@zeecut.ir", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "ZeeKey - Persian/English Keyboard Fixer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}