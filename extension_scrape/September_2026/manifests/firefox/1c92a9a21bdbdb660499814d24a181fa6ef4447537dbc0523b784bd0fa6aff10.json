{"manifest_version": 3, "name": "Demivo Helper", "version": "1.0.1", "description": "Play your own IPTV subscription in the Demivo web player, straight from your provider to your browser \u2014 nothing is proxied.", "author": "Velmeron LLC", "homepage_url": "https://iptv.domains", "browser_specific_settings": {"gecko": {"id": "demivo-helper@iptv.domains", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["webRequest", "webRequestBlocking", "storage"], "host_permissions": ["*://panel.iptv.domains/*"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://panel.iptv.domains/*"], "js": ["content-bridge.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Demivo Helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}