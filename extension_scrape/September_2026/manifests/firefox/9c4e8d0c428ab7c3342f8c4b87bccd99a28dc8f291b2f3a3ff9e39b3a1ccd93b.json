{"manifest_version": 3, "name": "Reddit Infinite History", "version": "1.0.0", "description": "Automatically saves your Reddit browsing history locally.", "browser_specific_settings": {"gecko": {"id": "reddit-history@thelittleblue.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.reddit.com/*"], "action": {"default_title": "View Reddit History", "default_icon": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}, "background": {"scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}}