{"manifest_version": 3, "name": "Simple Sticky Notes", "version": "1.0.0", "description": "A simple sticky notes extension to take notes on any webpage.", "icons": {"128": "icons/icon.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "pages/popup.html", "default_icon": {"128": "icons/icon.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/note.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@extension-name.developer-name"}}}