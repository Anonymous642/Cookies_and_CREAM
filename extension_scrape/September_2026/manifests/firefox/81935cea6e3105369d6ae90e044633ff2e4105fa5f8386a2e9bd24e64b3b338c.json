{"manifest_version": 3, "name": "ReadEasy \u2014 Dyslexia Fonts", "version": "0.1.0", "minimum_chrome_version": "121", "description": "Make any page easier to read: dyslexia-friendly fonts, wider spacing, a colour tint and a reading ruler. Local, no account.", "permissions": ["storage", "activeTab", "scripting"], "optional_host_permissions": ["<all_urls>"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "ReadEasy"}, "commands": {"toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Turn the reading ruler on or off"}}, "web_accessible_resources": [{"resources": ["fonts/OpenDyslexic-Regular.woff2", "fonts/OpenDyslexic-Bold.woff2", "fonts/OpenDyslexic-Italic.woff2", "fonts/OpenDyslexic-Bold-Italic.woff2"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "readeasy@readeasy.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}