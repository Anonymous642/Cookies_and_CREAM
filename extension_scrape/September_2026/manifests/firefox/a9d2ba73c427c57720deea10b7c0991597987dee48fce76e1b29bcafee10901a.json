{"manifest_version": 3, "name": "Downstream", "version": "1.0.3", "description": "Detects HLS, DASH and progressive media on the page and saves it as a single file.", "permissions": ["tabs", "scripting", "downloads", "webRequest", "declarativeNetRequest", "storage", "unlimitedStorage", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'"}, "background": {"scripts": ["background/main.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Downstream", "default_icon": {"16": "icons/icon-16-grey.png", "32": "icons/icon-32-grey.png", "48": "icons/icon-48-grey.png", "128": "icons/icon-128-grey.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"world": "MAIN", "matches": ["*://*.youtube.com/*"], "js": ["content/youtube-main.js"], "run_at": "document_start", "all_frames": false}, {"world": "ISOLATED", "matches": ["*://*.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "{6f3c9a1e-58d2-4b17-9a0f-2c7e5b8d41a6}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}