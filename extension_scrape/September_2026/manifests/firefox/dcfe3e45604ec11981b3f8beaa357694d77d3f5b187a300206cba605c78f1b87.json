{"manifest_version": 2, "name": "Word Highlighter", "version": "1.0", "description": "B\u00f4i n\u1ed5i b\u1eadt t\u1eeb kh\u00f3a tr\u00ean trang hi\u1ec7n t\u1ea1i. Kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u.", "permissions": ["activeTab", "tabs", "storage"], "browser_action": {"default_title": "Word Highlighter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@word-highlighter", "data_collection_permissions": {"required": ["none"]}}}}