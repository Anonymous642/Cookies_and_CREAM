{"manifest_version": 3, "name": "Reverb.ai", "version": "1.7", "description": "Generate AI summaries of Echo360 lectures and link key concepts to your uploaded course notes by page number.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Reverb.ai", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"], "js": ["content.js"], "run_at": "document_start"}], "externally_connectable": {"matches": ["https://reverb-ai.uk/*", "https://reverb-ai3.vercel.app/*"]}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"]}], "browser_specific_settings": {"gecko": {"id": "reverb-ai@reverb-ai.uk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "authenticationInfo"]}}}}