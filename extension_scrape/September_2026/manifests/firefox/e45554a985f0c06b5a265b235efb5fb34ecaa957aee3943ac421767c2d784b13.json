{"manifest_version": 3, "name": "RedReplier: Reddit Marketing Rules Check", "version": "1.0.0", "description": "Read a subreddit's self-promotion rules before you post, then score your draft against them without leaving Reddit.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "RedReplier subreddit check"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.reddit.com/*", "https://api.redreplier.com/*"], "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content/reddit.js"], "css": ["content/reddit.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/panel.css", "assets/*"], "matches": ["*://*.reddit.com/*"]}], "browser_specific_settings": {"gecko": {"id": "extension@redreplier.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}