{"manifest_version": 3, "name": "WPMG Image Meta Filler", "version": "1.0", "description": "Automated metadata filling for WordPress Media Library", "browser_specific_settings": {"gecko": {"id": "wp-meta-filler@fixit.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*/*wp-admin/*"], "developer": {"name": "Fixit User", "url": "https://example.com"}, "action": {"default_popup": "popup.html", "default_title": "WP Meta Filler"}, "content_scripts": [{"matches": ["*://*/*wp-admin/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}