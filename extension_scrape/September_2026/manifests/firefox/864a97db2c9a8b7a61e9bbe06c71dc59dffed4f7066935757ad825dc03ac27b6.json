{"manifest_version": 2, "name": "Quick Background Remover", "version": "1.0", "description": "Chu\u1ed9t ph\u1ea3i v\u00e0o \u1ea3nh \u2192 ch\u1ecdn 'X\u00f3a n\u1ec1n'. N\u1ebfu c\u00f3 API key, g\u1eedi \u1ea3nh l\u00ean API; n\u1ebfu kh\u00f4ng, s\u1eed d\u1ee5ng ph\u01b0\u01a1ng ph\u00e1p \u0111\u01a1n gi\u1ea3n (make near-background color transparent). T\u1ea3i \u1ea3nh PNG trong su\u1ed1t.", "permissions": ["contextMenus", "activeTab", "storage", "downloads"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_action": {"default_title": "Quick Background Remover", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "{7de1fe5d-11a0-4915-9e16-b53ec33d3a95}"}}}