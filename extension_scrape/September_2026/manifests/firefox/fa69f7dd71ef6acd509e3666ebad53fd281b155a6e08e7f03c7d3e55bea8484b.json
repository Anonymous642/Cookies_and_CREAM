{"manifest_version": 3, "name": "Flexible Timers Activity", "version": "1.1.0", "description": "Reports the active tab URL/title to the Flexible Timers Pro app for on-device activity tracking.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "nativeMessaging", "alarms"], "host_permissions": ["http://127.0.0.1:5613/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "flexibletimers-activity@xintechllc.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}}