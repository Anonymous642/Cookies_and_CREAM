{"manifest_version": 3, "name": "FillButler", "version": "1.0.0", "description": "Bulk-fill any web form from a CSV. Map columns to fields once, run every row.", "permissions": ["storage", "activeTab", "scripting", "webNavigation"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "FillButler"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "fillbutler@fillbutler.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}