{"manifest_version": 3, "name": "Huntera Local Bridge", "version": "0.2.1", "description": "Envia XP e gold do Huntera para o Huntera Manager local.", "permissions": ["storage"], "host_permissions": ["https://huntera.com.br/*", "http://127.0.0.1:8787/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Huntera Local Bridge", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://huntera.com.br/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-hook.js"], "matches": ["https://huntera.com.br/*"]}], "browser_specific_settings": {"gecko": {"id": "huntera-local-bridge@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}