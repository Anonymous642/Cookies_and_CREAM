{"manifest_version": 3, "name": "Rewire for YouTube", "version": "1.1.0", "version_name": "1.1.0", "description": "Take control of YouTube. Block Shorts, remove distractions, and stay focused with daily limits and focus mode.", "homepage_url": "https://github.com/codem/yt-shorts-blocker", "permissions": ["activeTab", "storage", "tabs", "webNavigation"], "background": {"scripts": ["js/background.js"]}, "host_permissions": ["https://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "css": ["css/blocker.css"], "js": ["js/content.js"], "run_at": "document_start"}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["redirect.html", "css/*", "js/*", "images/*", "videos/*"], "matches": ["https://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"strict_min_version": "142.0", "id": "rewire-for-youtube@abhishek.com", "data_collection_permissions": {"required": ["none"]}}}}