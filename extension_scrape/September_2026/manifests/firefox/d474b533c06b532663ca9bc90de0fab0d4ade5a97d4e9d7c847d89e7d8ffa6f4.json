{"manifest_version": 2, "name": "GhostTube for YouTube\u2122 - Music & Ad Blocker", "description": "Listen to YouTube with video hidden. Music mode, ad blocker, and visual cleanups and more than 15 tools.", "version": "1.2.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "ghosttube@rohit-chouhan", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "GhostTube Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}