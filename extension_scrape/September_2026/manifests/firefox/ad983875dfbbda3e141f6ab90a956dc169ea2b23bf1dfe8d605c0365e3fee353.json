{"manifest_version": 3, "name": "Gloober", "version": "0.1.0", "browser_specific_settings": {"gecko": {"id": "gloober@addon.local", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "description": "Focus alignment: checks if the current page matches your focus (e.g. work) using an AI agent.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>", "http://127.0.0.1:7242/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png"}, "default_title": "Gloober"}, "web_accessible_resources": [{"resources": ["content.css"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}}