{"manifest_version": 2, "name": "Custom Dark New Tab", "version": "1.0.0", "description": "A dark-mode new tab page with customizable search, weather, clock, notes, and quick links.", "permissions": ["storage", "geolocation", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"], "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "custom-dark-newtab@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"], "optional": ["locationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": "script-src 'self'; object-src 'self';"}