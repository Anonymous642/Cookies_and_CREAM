{"manifest_version": 3, "name": "YouTube Channel Whitelist", "version": "1.0.0", "description": "Hanya izinkan menonton video & channel YouTube yang ada di daftar whitelist Anda. Channel lain otomatis diblokir.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-channel-whitelist@example-extension.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["utils.js", "storage.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "YouTube Channel Whitelist"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["utils.js", "storage.js", "content.js"], "css": ["overlay.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.youtube.com/*"]}]}