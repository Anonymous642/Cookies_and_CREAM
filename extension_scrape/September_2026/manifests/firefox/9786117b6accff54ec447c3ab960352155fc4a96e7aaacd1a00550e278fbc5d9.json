{"manifest_version": 3, "name": "Snap Linkit", "version": "1.2.1", "description": "Select and manage multiple links, checkboxes, and buttons with a simple drag. Privacy 100% Guaranteed.", "permissions": ["activeTab", "clipboardWrite", "storage", "downloads"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "Snap Linkit", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Toggle Snap Linkit on/off for current tab"}, "open-selected-tabs": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open all selected links in new tabs"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "snap-linkit@privacy-guaranteed", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}