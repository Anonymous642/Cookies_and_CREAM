{"manifest_version": 2, "name": "AnimeDemons Companion", "short_name": "AnimeDemons", "version": "2.0.3", "description": "Lista anime, orar si notificari sincronizate cu noua platforma AnimeDemons.", "homepage_url": "https://animedemons.ro/", "permissions": ["storage", "alarms", "notifications", "contextMenus", "tabs", "https://animedemons.ro/*"], "browser_action": {"default_title": "Deschide AnimeDemons Companion", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://animedemons.ro/*"], "js": ["content-episode.js"], "run_at": "document_idle"}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "animedemons@animedemons.ro", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "searchTerms", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}