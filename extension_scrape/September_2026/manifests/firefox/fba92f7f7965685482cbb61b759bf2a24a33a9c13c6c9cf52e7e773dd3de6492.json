{"manifest_version": 3, "name": "Tracely", "version": "0.2.0", "description": "See what websites actually learn about you \u2014 in real time", "browser_specific_settings": {"gecko": {"id": "tracely@privacy.investigator", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "images/icon-16.svg", "48": "images/icon-48.svg", "128": "images/icon-128.svg"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Tracely"}, "background": {"scripts": ["src/background/service-worker.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["src/utils/tracker-detection.js"], "matches": ["<all_urls>"]}]}