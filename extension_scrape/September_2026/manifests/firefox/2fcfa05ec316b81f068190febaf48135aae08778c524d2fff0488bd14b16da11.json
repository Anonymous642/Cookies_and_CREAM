{"manifest_version": 3, "name": "My Simple Notes", "version": "0.5.1", "description": "Add compact notes to specific URLs.", "icons": {"16": "icons/black.png", "32": "icons/black.png", "48": "icons/black.png", "96": "icons/black.png", "128": "icons/black.png"}, "permissions": ["menus", "storage", "activeTab", "tabs", "theme"], "host_permissions": ["<all_urls>"], "action": {"default_title": "My Simple Notes", "default_icon": {"16": "icons/black.png", "32": "icons/black.png", "48": "icons/black.png", "96": "icons/black.png", "128": "icons/black.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}], "options_ui": {"page": "manage.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "gray-notes@example.local", "data_collection_permissions": {"required": ["none"]}}}}