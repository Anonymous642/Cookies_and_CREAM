{"manifest_version": 2, "name": "CognifAI Quick Capture", "version": "1.0.0", "description": "Quickly save web pages as ideas in your CognifAI realms", "permissions": ["activeTab", "storage", "identity", "tabs", "webRequest", "webRequestBlocking", "https://*.cognifai.com/*", "https://*.cognifai.app/*", "http://localhost:3000/*", "http://localhost:3001/*", "http://localhost/*", "https://localhost/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Save to CognifAI", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["injected-script.js"], "browser_specific_settings": {"gecko": {"id": "cognifai-extension@cognifai.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}