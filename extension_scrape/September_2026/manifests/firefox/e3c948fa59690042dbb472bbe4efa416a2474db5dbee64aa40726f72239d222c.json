{"manifest_version": 3, "version": "1.1.1", "name": "CoursePlanner", "description": "Course Planner helps students extract course information and build conflict-free class schedules more easily.", "default_locale": "en", "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "assets/logo/logo-16.png", "32": "assets/logo/logo-32.png", "48": "assets/logo/logo-48.png", "64": "assets/logo/logo-64.png", "128": "assets/logo/logo-128.png", "256": "assets/logo/logo-256.png"}, "browser_specific_settings": {"gecko": {"id": "@saiter.ca", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo", "websiteContent"]}}}}