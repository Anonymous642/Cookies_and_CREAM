{"manifest_version": 3, "name": "Magnet Checker", "version": "1.0.0", "description": "Checks availability of magnet links using OpenWebTorrent API", "permissions": ["scripting", "activeTab"], "host_permissions": ["https://checker.openwebtorrent.com/*", "http://checker.openwebtorrent.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Magnet Checker"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "magnet-checker@greygraygrey", "data_collection_permissions": {"required": ["none"]}}}}