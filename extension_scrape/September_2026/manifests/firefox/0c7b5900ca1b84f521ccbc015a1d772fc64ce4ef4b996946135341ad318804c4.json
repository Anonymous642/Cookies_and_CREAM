{"manifest_version": 3, "name": "Firecrawl Frontend", "version": "0.2.0", "description": "Manual GUI for a self-hosted Firecrawl instance.", "browser_specific_settings": {"gecko": {"id": "firecrawl-frontend@hanfarjr.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["lib/api.js", "lib/log.js", "lib/writers.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Firecrawl"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "downloads", "alarms", "activeTab"], "optional_permissions": ["nativeMessaging"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"48": "icons/48.png", "96": "icons/96.png"}}