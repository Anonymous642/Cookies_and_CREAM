{"manifest_version": 3, "name": "Read Flow", "version": "0.3.0", "description": "Reading assistant with bionic text, readability controls, a focus ruler, guided pacing, speed estimates, and a PDF reader.", "author": "ScholarSail, LLC", "homepage_url": "https://scholarsail.com/", "permissions": ["storage", "activeTab", "contextMenus"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Read Flow", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"toggle-bionic": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Toggle bionic reading"}, "toggle-ruler": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Toggle reading ruler"}, "toggle-guide": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Start or stop Guide Me pacing"}, "toggle-night": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Cycle night reading (off, warm dim, dark)"}}, "browser_specific_settings": {"gecko": {"id": "read-flow@scholarsail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}