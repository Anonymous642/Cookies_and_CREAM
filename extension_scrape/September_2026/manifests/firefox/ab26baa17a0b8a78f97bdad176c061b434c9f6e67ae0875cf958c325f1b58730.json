{"manifest_version": 3, "name": "Ogame One", "version": "1.0.59", "description": "Tool per OGame: barra pianeti avanzata, galassia, spedizioni, flotta, spionaggio e Player Intelligence Sidebar. Integrazione opzionale con OneSync (one.ostats.eu).", "homepage_url": "https://one.ostats.eu", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ogameone@one.ostats.eu", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "host_permissions": ["https://one.ostats.eu/*", "https://ostats.eu/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.ogame.gameforge.com/game/*"], "js": ["bridge.js"], "run_at": "document_start"}, {"matches": ["https://*.ogame.gameforge.com/game/*"], "js": ["main.js"], "css": ["style.css"], "run_at": "document_start", "world": "MAIN"}]}