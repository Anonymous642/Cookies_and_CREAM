{"manifest_version": 3, "name": "Tradavity: Sync TradingView Trades", "description": "Sync your TradingView trades to your Tradavity journal in one click.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}}, "permissions": ["storage", "activeTab", "notifications", "scripting"], "host_permissions": ["https://*.tradingview.com/*", "https://app.tradavity.com/*"], "background": {"scripts": ["background/service-worker.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@tradavity.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"], "optional": []}}}}