{"manifest_version": 3, "name": "nimistu", "version": "0.4.0", "description": "Shows a clean nimistu.ee card for Estonian company and person searches on Google, Bing, DuckDuckGo and Yandex.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "nimistu settings", "default_popup": "options.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage"], "host_permissions": ["https://nimistu.ee/*"], "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.ee/search*", "https://www.google.co.uk/search*", "https://www.google.de/search*", "https://www.google.fi/search*", "https://www.google.lv/search*", "https://www.google.lt/search*", "https://www.google.se/search*", "https://www.bing.com/search*", "https://duckduckgo.com/*", "https://yandex.com/search*", "https://yandex.ru/search*", "https://yandex.ee/search*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "addon@nimistu.ee", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}}