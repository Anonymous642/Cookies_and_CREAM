{"manifest_version": 3, "name": "TT Radio", "version": "1.0.8.7", "description": "TT Radio: Online Radio Player", "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "tt-radio@ttradio.online", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "notifications", "contextMenus", "alarms"], "host_permissions": ["https://api.ttradio.online/*", "https://de1.api.radio-browser.info/*", "https://at1.api.radio-browser.info/*", "https://nl1.api.radio-browser.info/*", "https://all.api.radio-browser.info/*"], "background": {"scripts": ["compat.js", "audio-engine.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"play-pause": {"suggested_key": {"default": "MediaPlayPause"}, "description": "Play/Pause"}, "stop": {"suggested_key": {"default": "MediaStop"}, "description": "Stop"}, "next-fav": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Next favorite"}, "prev-fav": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Previous favorite"}, "volume-up": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Volume up"}, "volume-down": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Volume down"}}, "omnibox": {"keyword": "tt"}}