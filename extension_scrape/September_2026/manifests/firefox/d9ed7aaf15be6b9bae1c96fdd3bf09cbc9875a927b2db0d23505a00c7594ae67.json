{"manifest_version": 3, "name": "YouTubeBlue", "version": "0.2.2", "author": "Mr-Fougere", "description": "YouTubeBlue is a browser extension with features to improve use of YouTube ", "icons": {"48": "assets/icons/logo48.png", "64": "assets/icons/logo64.png", "96": "assets/icons/logo96.png", "128": "assets/icons/logo128.png"}, "action": {"default_icon": {"48": "assets/icons/logo48.png", "64": "assets/icons/logo64.png", "96": "assets/icons/logo96.png", "128": "assets/icons/logo128.png"}, "default_title": "YouTubeBlue", "default_popup": "src/popup.html"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["assets/styles/bluetify.css"]}], "browser_specific_settings": {"gecko": {"id": "youtubeblue@mr-fougere.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}