{"manifest_version": 3, "name": "Google Search Cleaner", "version": "1.0", "description": "Remove unwanted elements from Google Search results", "browser_specific_settings": {"gecko": {"id": "google-search-cleaner@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://*/*"], "include_globs": ["*://*.google.*/*"], "js": ["content.js"], "run_at": "document_start"}]}