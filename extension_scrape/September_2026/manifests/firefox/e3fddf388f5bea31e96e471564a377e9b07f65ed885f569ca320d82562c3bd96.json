{"manifest_version": 2, "name": "GG.deals on Steam", "version": "1.0", "description": "Display GG.deals official and keyshop prices directly on Steam store pages.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "https://store.steampowered.com/*", "https://api.gg.deals/*", "https://gg.deals/*"], "background": {"scripts": ["config.js", "background.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true, "browser_style": false}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*", "https://store.steampowered.com/sub/*", "https://store.steampowered.com/bundle/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ggdeals-on-steam@cake.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity", "authenticationInfo"]}}}}