{"manifest_version": 3, "name": "Smart TTS | AI Voices", "version": "1.0.3", "description": "Pinned floating TTS reader - reads page paragraphs with Supertonic AI voice", "author": "ext@hvlydmn.online", "homepage_url": "https://hvlydmn.online", "support_url": "mailto:ext@hvlydmn.online", "permissions": ["storage", "activeTab"], "host_permissions": ["https://tts.hvlydmn.dev/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js", "reader.js"], "css": ["reader.css"], "run_at": "document_start"}], "action": {"default_title": "Click to activate SuperTTS Reader (Supertonic) on this page"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "supertts@hvlydmn.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "description": "This extension does not collect or transmit personal user data."}}}, "web_accessible_resources": [{"resources": ["contentScript.css", "icons/play.svg", "icons/pause.svg", "icons/stop.svg", "icons/prev.svg", "icons/next.svg", "icons/close.svg"], "matches": ["<all_urls>"]}], "commands": {"togglePlayPause": {"suggested_key": {"default": "Alt+P"}, "description": "Play or Pause"}, "stop": {"suggested_key": {"default": "Alt+S"}, "description": "Stop reading"}, "next": {"suggested_key": {"default": "Alt+N"}, "description": "Next paragraph"}, "previous": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Previous paragraph"}}}