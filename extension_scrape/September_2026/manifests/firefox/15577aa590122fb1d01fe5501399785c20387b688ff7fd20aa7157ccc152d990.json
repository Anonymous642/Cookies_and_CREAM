{"manifest_version": 2, "name": "Scroll Intent Predictor", "version": "1.3", "description": "Predicts user scrolling intent and analyzes reading versus distraction behavior on webpages.", "permissions": ["activeTab", "storage", "tabs", "notifications"], "browser_action": {"default_title": "Scroll Intent Predictor", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Scroll-Intent-Predictor", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}