{"manifest_version": 3, "name": "Calculator & Percentage Calculator", "version": "1.0.0", "description": "Fast sidebar calculator with a live result preview, a paper tape of results, and instant percentage tools: X% of Y, percent change, discounts.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "permissions": ["storage", "sidePanel"], "action": {"default_title": "Open Calculator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"open-sidebar": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open Calc: Calculator & Percentage Tool"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "side_panel": {"default_path": "sidebar.html"}, "sidebar_action": {"default_title": "Calculator", "default_panel": "sidebar.html", "default_icon": "icons/icon48.png", "open_at_install": true}, "browser_specific_settings": {"gecko": {"id": "calculator@conceptx.example", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "short_name": "Calculator"}