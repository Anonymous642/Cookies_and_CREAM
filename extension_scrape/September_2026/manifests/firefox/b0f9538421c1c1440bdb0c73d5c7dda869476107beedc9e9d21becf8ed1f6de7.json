{"manifest_version": 3, "name": "Spidey Focus", "version": "1.5", "description": "Spider-Man drops from the top center of your web pages with smooth animations and interactive controls!", "permissions": ["storage", "activeTab", "scripting", "alarms"], "action": {"default_popup": "popup/popup.html", "default_title": "Spidey Focus"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content/content.css"], "js": ["content/content.js"]}], "web_accessible_resources": [{"resources": ["SpiderMan_web.png", "filter_red.png", "filter_green.png", "spidey_jingle.mp3"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"trigger-drop": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Drop Spider-Man"}}, "browser_specific_settings": {"gecko": {"id": "spidey-focus@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}