{"manifest_version": 2, "name": "Smart Dark Mode Pro", "version": "1.6.0", "description": "Intelligenter Dark Mode - Gelb/Orange = schwarzer Text, sonst automatisch.", "browser_specific_settings": {"gecko": {"id": "{d4e5f6a7-b8c9-4d0e-a1f2-3b4c5d6e7f8a}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Smart Dark Mode Pro"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["darkmode.css"], "run_at": "document_start", "all_frames": true}], "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Dark Mode ein-/ausschalten"}}}