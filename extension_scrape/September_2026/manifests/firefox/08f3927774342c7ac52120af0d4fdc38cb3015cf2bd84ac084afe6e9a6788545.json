{"manifest_version": 3, "name": "Hambit", "version": "3.1.0", "description": "Doomscroll less, learn more. Hambit pairs your most distracting sites with a quick question before they open.", "author": "Louis Viard", "homepage_url": "https://hambit.app", "browser_specific_settings": {"gecko": {"id": "hambit@hambitapp", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "tabs", "alarms", "identity"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Hambit", "default_popup": "action.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"service_worker": "background.js", "scripts": ["lib/shared.js", "lib/i18n.js", "lib/vendor/supabase-auth-minimal.js", "lib/supabase-client.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/shared.js", "lib/i18n.js", "content/buffer.js"], "run_at": "document_start"}, {"matches": ["https://hambit.app/*"], "js": ["lib/shared.js", "lib/i18n.js", "content/hambit-relay.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["locales/*.json", "packs/*.json", "packs/catalog.json", "questions.json", "fonts/*"], "matches": ["<all_urls>"]}], "options_ui": {"page": "dashboard.html", "open_in_tab": true}}