{"manifest_version": 3, "name": "seats.aero", "description": "Easily search for award availability on Google Flights, Chase Travel, and Amex Travel.", "version": "1.3.43", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["https://seats.aero/*", "https://www.travel.americanexpress.com/*"], "action": {"default_title": "Open on seats.aero"}, "externally_connectable": {"matches": ["https://seats.aero/*"]}, "browser_specific_settings": {"gecko": {"id": "addon@seats.aero", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "searchTerms"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://travelsecure.chase.com/*"], "run_at": "document_start", "js": ["content-scripts/chase-main.js"], "world": "MAIN"}, {"matches": ["https://travelsecure.chase.com/*"], "css": ["content-scripts/chase.css"], "js": ["content-scripts/chase.js"]}, {"matches": ["https://www.google.ca/travel/flights*", "https://www.google.co.uk/travel/flights*", "https://www.google.com.au/travel/flights*", "https://www.google.com/travel/flights*", "https://www.google.de/travel/flights*", "https://www.google.fr/travel/flights*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["https://seats.aero/firefox/welcome*"], "run_at": "document_start", "js": ["content-scripts/welcome.js"]}]}