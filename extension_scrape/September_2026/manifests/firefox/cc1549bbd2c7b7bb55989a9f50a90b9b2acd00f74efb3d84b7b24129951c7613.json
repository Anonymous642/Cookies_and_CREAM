{"manifest_version": 3, "name": "Nabber Full Page", "version": "1.0.0", "description": "Sends full-page screenshots of the current tab to the Nabber app (scroll-and-stitch).", "browser_specific_settings": {"gecko": {"id": "nabber@theinteractiveabode.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["http://127.0.0.1/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}}