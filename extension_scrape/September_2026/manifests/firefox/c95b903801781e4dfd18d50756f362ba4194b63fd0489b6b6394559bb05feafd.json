{"manifest_version": 2, "name": "Copy as Markdown", "version": "1.0.0", "description": "Right-click any selected text and copy it as clean Markdown. Preserves links, headers, lists, bold, italic, code blocks, images, and tables.", "permissions": ["contextMenus", "clipboardWrite", "activeTab"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "copy-as-markdown@agentfactory", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}