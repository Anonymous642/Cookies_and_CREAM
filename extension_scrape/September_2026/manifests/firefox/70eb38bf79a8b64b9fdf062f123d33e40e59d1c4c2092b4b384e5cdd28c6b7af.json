{"manifest_version": 3, "name": "Linkdeck Re.nk DECK Companion", "description": "Receive Re.nk DECK actions from Linkdeck and control browser tabs on this PC.", "version": "0.3.1", "action": {"default_title": "Linkdeck Companion", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["https://linkdeck.ing/*"], "js": ["page-session-bridge.js"], "run_at": "document_idle"}], "permissions": ["alarms", "storage", "tabs"], "host_permissions": ["https://linkdeck.ing/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://linkdeck.ing wss://linkdeck.ing;"}, "browser_specific_settings": {"gecko": {"id": "renk-companion@linkdeck.ing", "data_collection_permissions": {"required": ["none"]}}}}