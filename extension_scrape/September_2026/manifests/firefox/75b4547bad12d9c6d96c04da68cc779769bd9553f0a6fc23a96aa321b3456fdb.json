{"manifest_version": 3, "name": "Volume Scroll for YouTube", "version": "1.0", "description": "Control YouTube video volume by scrolling over the player controls", "icons": {"16": "icons/Youtube-Volume-scroll-16px.png", "32": "icons/Youtube-Volume-scroll-32px.png", "48": "icons/Youtube-Volume-scroll-48px.png", "96": "icons/Youtube-Volume-scroll-96px.png", "128": "icons/Youtube-Volume-scroll-128px.png"}, "action": {"default_icon": {"16": "icons/Youtube-Volume-scroll-16px.png", "32": "icons/Youtube-Volume-scroll-32px.png", "48": "icons/Youtube-Volume-scroll-48px.png", "96": "icons/Youtube-Volume-scroll-96px.png", "128": "icons/Youtube-Volume-scroll-128px.png"}}, "browser_specific_settings": {"gecko": {"id": "{d9b529b4-e444-4de6-8ccf-ddb0986341af}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}