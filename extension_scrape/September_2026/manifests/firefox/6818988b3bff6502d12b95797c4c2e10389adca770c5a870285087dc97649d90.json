{"manifest_version": 2, "name": "Shrekify the Web", "version": "1.0", "description": "Adds or removes Shrek images on webpages with a popup toggle.", "icons": {"48": "icon.png"}, "permissions": ["storage", "tabs", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "web_accessible_resources": ["imageA.png", "imageB.png"], "applications": {"gecko": {"id": "shrek-extension@example.local"}}}