{"manifest_version": 3, "name": "LinkedIn to CRM", "version": "1.0", "description": "Send LinkedIn profiles directly to your recruiting CRM", "browser_specific_settings": {"gecko": {"id": "linkedin-crm@jeremycrum.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}, "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["content.js"]}]}