{"manifest_version": 3, "name": "Roblox Cookie Manager", "version": "1.0.1", "description": "Simple cookie manager for Roblox with account switching", "permissions": ["cookies", "storage", "activeTab", "clipboardRead"], "host_permissions": ["https://*.roblox.com/*", "https://thumbnails.roblox.com/*", "https://users.roblox.com/*", "https://economy.roblox.com/*"], "action": {"default_popup": "popup.html", "default_title": "Roblox Cookie Manager"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "roblox-cookie-manager@yourdomain.com", "strict_min_version": "109.0"}}}