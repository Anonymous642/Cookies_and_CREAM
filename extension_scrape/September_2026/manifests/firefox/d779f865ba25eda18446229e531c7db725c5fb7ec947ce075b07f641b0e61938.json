{"manifest_version": 3, "name": "keepthis.site", "version": "0.3.0", "description": "One click to save the current tab to your local keepthis.site desktop app. Local-first, end-to-end encrypted, no analytics.", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["http://127.0.0.1:43215/*"], "action": {"default_title": "Save to keepthis.site", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "keep@galisteo.dev", "strict_min_version": "115.0"}}}