{"manifest_version": 2, "name": "Snoozer", "author": "Sander van Dragt", "short_name": "Snoozer", "version": "1.0.0", "description": "Snooze selected tabs from the tab context menu and restore them later from the toolbar popup.", "homepage_url": "https://vandragt.com", "icons": {"16": "icons/snoozer.svg", "32": "icons/snoozer.svg", "48": "icons/snoozer-48.png", "96": "icons/snoozer-96.png"}, "permissions": ["bookmarks", "menus", "notifications", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Snoozer", "default_popup": "popup.html", "default_icon": {"16": "icons/snoozer.svg", "32": "icons/snoozer.svg", "48": "icons/snoozer.svg"}}, "browser_specific_settings": {"gecko": {"id": "snoozer@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}