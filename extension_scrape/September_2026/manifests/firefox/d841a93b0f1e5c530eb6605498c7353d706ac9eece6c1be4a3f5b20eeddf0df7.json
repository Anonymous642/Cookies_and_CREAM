{"manifest_version": 3, "name": "TranslateQuick", "version": "1.0.0", "description": "Quick text translator. Translate selected text with context menu or popup.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "TranslateQuick", "default_popup": "popup-ui/translate.html"}, "permissions": ["contextMenus", "storage"], "background": {"scripts": ["background/context-menu.js"]}, "browser_specific_settings": {"gecko": {"id": "translatequick@language.convert", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}