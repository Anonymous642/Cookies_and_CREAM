{"manifest_version": 3, "name": "Only Bitcoin", "version": "0.1.0", "description": "Import-only wallet to pay fast in Bitcoin by scanning a QR code.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.bundle.js", "scripts": ["background.bundle.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://mempool.space/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "only-bitcoin@tudominio.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["financialAndPaymentInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}