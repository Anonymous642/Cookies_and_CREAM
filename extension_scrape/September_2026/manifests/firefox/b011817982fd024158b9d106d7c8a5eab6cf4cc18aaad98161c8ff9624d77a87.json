{"manifest_version": 3, "name": "Event Atlas", "version": "1.0.0", "description": "Record a local timeline of DOM events, focus changes and mutations, without recording field values.", "permissions": ["activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "event-atlas@frontend-observatory.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Event Atlas", "default_popup": "popup.html", "default_icon": {"48": "icons/48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}