{"manifest_version": 3, "name": "X Post's Time / Views Relocater", "version": "1.1", "description": "Forces timestamp formatting (10:20 PM - 12 12 2024) and moves it with view counts next to Name & Handle. Removes subscribe prompts", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs"], "host_permissions": ["*://twitter.com/*", "*://x.com/*"], "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "X-Posts-Time-Views-Relocater@Anabia5115.github.io"}}}