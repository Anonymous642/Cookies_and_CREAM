{"name": "Reccordr", "description": "Screen recorder - Capture and export as MP4, WebM, or MOV", "version": "1.1", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "reccordr@example.com"}}, "action": {"default_icon": {"16": "images/16.png", "48": "images/48.png", "128": "images/128.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "images/16.png", "48": "images/48.png", "128": "images/128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["platform-utils.js", "content.js"]}], "permissions": ["activeTab", "storage", "unlimitedStorage", "desktopCapture", "downloads", "scripting"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+P"}}}}