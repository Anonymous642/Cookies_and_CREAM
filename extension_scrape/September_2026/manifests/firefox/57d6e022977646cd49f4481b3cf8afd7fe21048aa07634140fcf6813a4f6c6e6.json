{"manifest_version": 3, "name": "NDT Cookies", "version": "1.0.8", "default_locale": "en", "description": "NDT Cookies - A faster, cleaner cookie export and import workflow", "author": "Tony Nguyen", "browser_specific_settings": {"gecko": {"id": "ndt-cookies@nguyenduytan.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "NDT Cookies"}, "permissions": ["tabs", "cookies", "storage"], "optional_host_permissions": ["*://*/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/eye-open.png", "icons/eye-closed.png", "icons/heart.png", "icons/check-green.png", "icons/check-red.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["background.js"]}, "options_page": "newtab.html"}