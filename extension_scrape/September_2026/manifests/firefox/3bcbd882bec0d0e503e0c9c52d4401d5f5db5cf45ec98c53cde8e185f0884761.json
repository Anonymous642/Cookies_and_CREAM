{"manifest_version": 2, "name": "YouTube Shorts Blocker", "version": "1.0.0", "description": "Blocks all YouTube Shorts: navigation, feeds, shelves, and direct URL access. Works on desktop and Android.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "yt-shorts-blocker@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webNavigation", "tabs"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "css": ["shorts-blocker.css"], "run_at": "document_start"}], "background": {"scripts": ["background.js"], "persistent": false}}