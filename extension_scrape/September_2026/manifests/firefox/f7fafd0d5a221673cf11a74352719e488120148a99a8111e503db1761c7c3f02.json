{"manifest_version": 2, "name": "Civitai Red Redirect", "description": "Redirects civitai.com URLs to civitai.red", "version": "0.1", "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "64": "icons/icon.png", "128": "icons/icon.png"}, "permissions": ["webRequest", "webRequestBlocking", "*://*.civitai.com/*"], "browser_specific_settings": {"gecko": {"id": "civitai-redirect@mrp", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background_script.js"], "persistent": true}}