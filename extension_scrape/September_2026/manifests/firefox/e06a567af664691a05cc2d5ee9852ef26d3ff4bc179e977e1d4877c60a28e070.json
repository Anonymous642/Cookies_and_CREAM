{"manifest_version": 3, "name": "Tab Privacy Lock", "version": "0.5.11", "description": "Visually locks selected tabs with a local PIN and a discreet local page.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tab Privacy Lock", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["i18n.js", "content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["open.svg", "close.svg"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "tab-privacy-lock@nomupay.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}