{"manifest_version": 2, "name": "Deluge Magnet Sender (DMS)", "version": "1.0.2", "description": "Send magnet links directly to your Deluge Web UI.", "default_locale": "en", "icons": {"32": "icons/deluge-32.png", "64": "icons/deluge-64.png", "128": "icons/deluge-128.png"}, "permissions": ["storage", "notifications", "*://*/"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "DMS"}, "options_ui": {"page": "options/options.html", "browser_style": true}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content_scripts/content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "deluge-magnet-sender@skeil909", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}