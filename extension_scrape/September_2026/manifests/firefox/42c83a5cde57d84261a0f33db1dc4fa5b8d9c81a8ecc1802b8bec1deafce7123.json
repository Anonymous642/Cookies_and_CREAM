{"manifest_version": 3, "name": "Better Crunchyroll", "version": "2.98", "description": "Improves the Crunchyroll watch experience with a persistent control panel, cleaner watch-page layout, and a streamlined Discover page.", "action": {"default_popup": "popup.html", "default_title": "Better Crunchyroll"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "tabs"], "host_permissions": ["*://*.crunchyroll.com/*"], "content_scripts": [{"matches": ["*://*.crunchyroll.com/*"], "js": ["content.js", "pip.js", "page-tweaks.js", "skipping.js", "seeking.js", "playback-speed.js", "episode-title.js", "episode-modal.js", "next-preview.js"], "run_at": "document_start", "css": ["player-ui.css"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/back-button.svg", "icons/episodes.svg", "icons/pip.svg"], "matches": ["*://*.crunchyroll.com/*"]}], "browser_specific_settings": {"gecko": {"id": "better-crunchyroll@elioelhage", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}