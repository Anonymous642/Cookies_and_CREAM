{"manifest_version": 2, "name": "URL Sanitizer", "version": "1.4.0", "description": "Strip tracking parameters from URLs", "background": {"scripts": ["filter/strip-agent.js"]}, "icons": {"48": "strain-48.png", "96": "strain-96.png"}, "browser_specific_settings": {"gecko": {"id": "url-sanitizer@example.net", "data_collection_permissions": {"required": ["none"], "description": "This extension does not collect any data."}}}, "permissions": ["webRequest", "webRequestBlocking", "contextMenus", "<all_urls>", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["filter/content-cleaner.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "URL Sanitizer"}}