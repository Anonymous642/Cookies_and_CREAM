{"manifest_version": 2, "name": "Name Changer", "version": "1.0.1", "description": "Swap character names in novels and fanfics (AO3, etc.) without touching other words.", "browser_specific_settings": {"gecko": {"id": "name-changer@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}