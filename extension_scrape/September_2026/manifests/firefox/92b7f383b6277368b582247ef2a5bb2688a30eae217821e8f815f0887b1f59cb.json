{"manifest_version": 3, "name": "Meal Tracker \u2192 Liste de courses", "version": "1.4.0", "description": "Compagnon de l'app Meal Tracker (mealplanner.creaweb.io) : synchronise votre liste de courses et aide \u00e0 la retrouver sur Carrefour.fr, Leclerc Drive et Auchan.fr. N\u00e9cessite un compte Meal Tracker.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://mealplanner.creaweb.io/*", "*://www.carrefour.fr/*", "*://*.leclercdrive.fr/*", "*://www.auchan.fr/*"], "browser_specific_settings": {"gecko": {"id": "mealplanner-grocery-assistant@creaweb.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://mealplanner.creaweb.io/*"], "js": ["content-app.js"], "run_at": "document_idle"}, {"matches": ["*://www.carrefour.fr/*", "*://*.leclercdrive.fr/*", "*://www.auchan.fr/*"], "js": ["site-adapters.js", "content-fill.js", "content-checklist.js"], "run_at": "document_idle"}]}