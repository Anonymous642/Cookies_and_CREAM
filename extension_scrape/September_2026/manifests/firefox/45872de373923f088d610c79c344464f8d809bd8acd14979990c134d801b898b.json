{"manifest_version": 2, "name": "PROT - Terms of Service & EULA Analyzer", "version": "1.2.2", "description": "Scans Terms of Service, EULAs & Privacy Policies for unfair clauses. Flags risks under EU, UK & Australian consumer protection law.", "browser_specific_settings": {"gecko": {"id": "prot@protsec.app", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage", "tabs", "*://*/*", "https://*.supabase.co/*"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["browser-polyfill.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://protsec.app/*"], "js": ["browser-polyfill.js", "bridge.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "PROT - Check Consumer Rights"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon192.png"}, "web_accessible_resources": ["icons/*.png", "report.html", "auth.js"]}