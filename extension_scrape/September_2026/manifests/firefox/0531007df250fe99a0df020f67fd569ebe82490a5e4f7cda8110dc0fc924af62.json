{"manifest_version": 3, "name": "YouTube Quality Restorer", "version": "1.0.0", "description": "Ajoute un bouton de qualite manuel dans le lecteur YouTube.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "youtube-quality-restorer@eliottine.local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}