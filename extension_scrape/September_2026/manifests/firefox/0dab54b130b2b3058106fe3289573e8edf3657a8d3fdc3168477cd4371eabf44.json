{"manifest_version": 2, "name": "pulld monitor", "description": "Companion for the pulld app: send downloads from your browser and manage your pulld download queue.", "version": "1.15.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["webRequest", "storage", "cookies", "tabs", "<all_urls>", "http://127.0.0.1/*", "http://localhost/*"], "browser_specific_settings": {"gecko": {"id": "pulld-monitor@akash11.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"], "browser_action": {"default_title": "pulld monitor: open panel", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}}