{"manifest_version": 3, "name": "AI Blocker", "version": "1.0.1", "description": "Block ChatGPT, Claude, Gemini and other AI websites with one click. 100% local \u2014 no data ever leaves your browser.", "author": "AI Blocker", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/firefox-background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "declarativeNetRequest"], "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "ai-blocker@local.extension", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}