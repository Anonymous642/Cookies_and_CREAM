{"manifest_version": 2, "name": "AI Cyber Shield", "version": "1.2", "description": "Capture and analyze web requests for bug bounty hunting", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["webRequest", "storage", "activeTab", "tabs", "downloads", "cookies", "debugger"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "applications": {"gecko": {"id": "aicybershield@example.com"}}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_end"}], "content_security_policy": "script-src 'self'; object-src 'self'", "web_accessible_resources": ["cloud-detector.js"]}