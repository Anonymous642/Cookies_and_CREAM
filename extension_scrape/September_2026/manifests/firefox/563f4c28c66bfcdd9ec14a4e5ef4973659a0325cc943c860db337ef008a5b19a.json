{"manifest_version": 3, "name": "Minimal Player for YouTube Music", "version": "1.1.0", "description": "Hide album art and video on YouTube Music for a cleaner, less distracting player.", "permissions": ["storage"], "host_permissions": ["*://music.youtube.com/*"], "icons": {"32": "icons/icon.svg", "64": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "action": {"default_title": "Minimal Player for YouTube Music", "default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon.svg", "64": "icons/icon.svg"}}, "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-music-visual-blocker@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}