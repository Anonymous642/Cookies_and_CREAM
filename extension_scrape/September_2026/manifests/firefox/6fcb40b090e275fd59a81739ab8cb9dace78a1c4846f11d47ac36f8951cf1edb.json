{"manifest_version": 3, "name": "Show/Hide UI youtube shorts", "version": "2.4", "description": "Tired of cluttered Shorts? This extension gives you a clean, distraction-free viewing experience. Just install this extension and click the red floating button on the top right corner of the screen to Show/Hide the action bar and metadata overlay of YouTube Short videos.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "content_scripts": [{"js": ["scripts/remove_tag.js"], "matches": ["https://m.youtube.com/shorts/*", "https://www.youtube.com/shorts/*"]}], "host_permissions": ["*://m.youtube.com/*", "*://www.youtube.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:;"}, "browser_specific_settings": {"gecko": {"id": "v2.0.nhongdevapp@gmail.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "src/hello.html", "default_title": "Show/Hide UI youtube shorts", "default_icon": "images/icon-16.png"}}