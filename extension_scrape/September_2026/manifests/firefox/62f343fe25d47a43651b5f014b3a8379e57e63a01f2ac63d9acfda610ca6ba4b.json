{"manifest_version": 3, "name": "Auto YT Music Playback Speed Switch", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "imnotharsh14@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "description": "Plays music videos at 1x speed and everything else at 2x. Automatically.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["page.js"], "matches": ["*://www.youtube.com/*"]}]}