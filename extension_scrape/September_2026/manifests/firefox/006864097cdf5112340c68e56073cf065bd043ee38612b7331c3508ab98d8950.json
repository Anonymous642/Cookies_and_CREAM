{"manifest_version": 3, "name": "Stowspace", "description": "Save pages, selections, and supported video links to your Stowspace library on Windows.", "version": "1.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "alarms", "contextMenus", "nativeMessaging", "scripting", "storage"], "action": {"default_title": "Stowspace", "default_icon": {"16": "action/action-16.png", "24": "action/action-24.png", "32": "action/action-32.png", "48": "action/action-48.png", "64": "action/action-64.png"}, "default_popup": "popup.html"}, "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current page to Stowspace"}}, "browser_specific_settings": {"gecko": {"id": "stowspace@stowspace.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": []}}}, "background": {"scripts": ["background.js"]}}