{"name": "My Clipboard", "description": "A Cross-platform universal clipboard for myclipboard.io", "version": "1.1", "manifest_version": 2, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "clipboardRead"], "content_scripts": [{"matches": ["https://myclipboard.io/token/firefox/*"], "js": ["scripts/auth_content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["templates/authenticate.html", "templates/onboarding.html"], "browser_action": {"default_popup": "templates/popup.html", "default_icon": {"16": "assets/favicon.png", "32": "assets/favicon.png", "48": "assets/favicon.png", "128": "assets/favicon.png"}}, "icons": {"16": "assets/favicon.png", "32": "assets/favicon.png", "48": "assets/favicon.png", "128": "assets/favicon.png"}, "options_ui": {"page": "templates/options.html"}, "browser_specific_settings": {"gecko": {"id": "myclipboard@myclipboard.io", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}}