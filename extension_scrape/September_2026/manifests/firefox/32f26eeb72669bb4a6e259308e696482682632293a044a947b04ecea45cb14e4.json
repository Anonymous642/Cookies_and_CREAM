{"manifest_version": 3, "name": "Reply Chime", "version": "1.0.3", "description": "Plays a sound when a long reply on chatgpt.com finishes generating.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["audio.js", "content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "reply-chime-7c8f2d1a@extensions.local", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["sounds/*.mp3"], "matches": ["https://chatgpt.com/*"]}]}