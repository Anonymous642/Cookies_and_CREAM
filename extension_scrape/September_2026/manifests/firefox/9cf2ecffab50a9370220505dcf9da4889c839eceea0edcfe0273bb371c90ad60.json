{"manifest_version": 2, "name": "Orgmode Lynx", "version": "0.1.1", "description": "Copy the current page URL and title as an Org link", "browser_specific_settings": {"gecko": {"id": "@extension-orgmode-lynx", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "clipboardWrite"], "background": {"scripts": ["common.js", "background.js"]}, "commands": {"copy-org-link": {"suggested_key": {"default": "Ctrl+Alt+L"}, "description": "Copy current page as Org link"}, "store-org-link": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Store link via org-protocol"}}, "browser_action": {"default_icon": {"48": "icons/icon.svg"}, "default_popup": "popup.html", "default_title": "Orgmode Lynx"}}