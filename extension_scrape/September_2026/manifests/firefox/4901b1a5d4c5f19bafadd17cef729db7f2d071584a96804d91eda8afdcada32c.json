{"manifest_version": 2, "name": "NDualSubs", "version": "3.0.3", "description": "Dual Subtitles for Netflix", "author": "Dan Chen, Gert Mertes (Firefox Port NTA)", "browser_specific_settings": {"gecko": {"id": "ndualsubs@firefox.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "*://*.netflix.com/*", "https://extensionpay.com/*"], "background": {"scripts": ["ExtPay.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_start"}, {"matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start"}], "browser_action": {"default_icon": "icon-gray.png", "default_popup": "settings.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "128": "icon128.png"}, "web_accessible_resources": ["netflix-manifest-bridge.js", "ndualsubs.js", "vanilla-picker.min.js"]}