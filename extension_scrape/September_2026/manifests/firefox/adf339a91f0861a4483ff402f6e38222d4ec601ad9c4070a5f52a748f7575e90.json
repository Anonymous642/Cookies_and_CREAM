{"manifest_version": 2, "name": "RodeoSync Fetcher", "version": "1.3", "description": "Scarica i dati di Rodeo XLI8 usando la sessione di Firefox e li invia alla dashboard locale RodeoSync.", "browser_specific_settings": {"gecko": {"id": "rodeosync@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "https://rodeo.eu.aftx.amazonoperations.app/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "RodeoSync: scarica ora"}}