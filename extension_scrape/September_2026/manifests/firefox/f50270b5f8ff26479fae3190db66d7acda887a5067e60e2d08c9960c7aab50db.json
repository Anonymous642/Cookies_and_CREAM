{"manifest_version": 2, "name": "Screen Privacy Guard for WhatsApp Web", "description": "Blur sensitive WhatsApp Web content locally and warn when enabled surfaces may be unprotected.", "version": "0.3.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "screen-privacy-guard-for-whatsapp-web@example.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://web.whatsapp.com/*"], "commands": {"toggle-privacy-mode": {"suggested_key": {"default": "Alt+X", "mac": "Alt+X"}, "description": "Toggle Privacy Mode"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Screen Privacy Guard", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}