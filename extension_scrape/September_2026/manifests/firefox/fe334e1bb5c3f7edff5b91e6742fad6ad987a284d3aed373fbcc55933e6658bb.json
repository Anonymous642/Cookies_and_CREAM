{"manifest_version": 3, "name": "Vurro for Substack", "version": "1.9.0", "description": "Enhanced Substack chat \u2014 filtered views, bookmarks, search, better threading", "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://substack.com/*", "https://*.substack.com/*"], "content_scripts": [{"matches": ["https://substack.com/*", "https://*.substack.com/chat*", "https://*.substack.com/publish/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}], "background": {"type": "module", "scripts": ["src/background/index.js"]}, "web_accessible_resources": [{"resources": ["hls.js"], "matches": ["https://substack.com/*", "https://*.substack.com/*"]}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "vurro@vurro.net", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}