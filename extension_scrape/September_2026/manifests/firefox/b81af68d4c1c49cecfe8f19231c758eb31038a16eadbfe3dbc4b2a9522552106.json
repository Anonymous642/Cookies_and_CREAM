{"name": "Keka Checkout Checker", "version": "3.5.0.0", "manifest_version": 3, "description": "Know exactly when to leave. Calculate your optimal clock-out time on Keka HRMS based on real-time attendance and effective hours.", "icons": {"16": "images/16.png", "32": "images/32.png", "48": "images/48.png", "64": "images/64.png", "128": "images/128.png"}, "action": {"default_icon": {"16": "images/16.png", "32": "images/32.png", "64": "images/64.png"}, "default_title": "Keka Checkout Checker", "default_popup": "index.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["alarms", "notifications"], "browser_specific_settings": {"gecko": {"id": "keka-checkout-checker@dharmitlakhani.in", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"run_at": "document_start", "matches": ["https://*.keka.com/*"], "js": ["script.js"]}]}