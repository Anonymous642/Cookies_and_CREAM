{"manifest_version": 3, "name": "ChabrBob.xyz", "version": "2.0.3", "description": "Companion extension for the ChabrBob Kick bot. Provides custom user identity and channel enhancements", "default_locale": "en", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://*.kick.com/*", "https://kick-extension.chabrbob.xyz/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.kick.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@chabrbob.xyz", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}}