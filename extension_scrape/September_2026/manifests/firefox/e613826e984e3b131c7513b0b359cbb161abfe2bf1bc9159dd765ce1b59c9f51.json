{"manifest_version": 3, "name": "LinkedIn Post Picker", "description": "Highlight only your own posts on LinkedIn", "version": "1.0.0", "permissions": ["scripting"], "host_permissions": ["https://www.linkedin.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "linkedin-post-picker@muammedsaad.com", "strict_min_version": "109.0", "data_collection_permissions": {"is_unnecessary_data_collection_allowed": false, "is_required_data_collection_allowed": false, "required": ["none"]}}}, "icons": {"16": "icons/in_icon16.png", "48": "icons/in_icon48.png", "128": "icons/in_icon128.png"}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"]}], "action": {"default_title": "LinkedIn Post Picker"}}