{"manifest_version": 3, "name": "Twitch Autochat", "version": "4.6.1", "description": "Automate your own Twitch chat commands with rules you define. Your Twitch token never leaves your browser.", "homepage_url": "https://srhades.com/", "browser_specific_settings": {"gecko": {"id": "twitch-autochat@srhades.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["wss://irc-ws.chat.twitch.tv/*", "https://srhades.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://srhades.com/twitch/tokengenerator/*"], "js": ["generator-bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Twitch Autochat", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}