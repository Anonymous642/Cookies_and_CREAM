{"manifest_version": 2, "name": "RDF Tab Restorer", "version": "1.0.0", "description": "Load RDF files and restore browser sessions with all URLs opened in tabs", "browser_specific_settings": {"gecko": {"id": "soyeb@btinternet.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "RDF Tab Restorer", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["tabs", "<all_urls>"], "privacy": {"description": "This extension does not collect any user data. All file processing happens locally in your browser.", "data_collection_permissions": "none"}}