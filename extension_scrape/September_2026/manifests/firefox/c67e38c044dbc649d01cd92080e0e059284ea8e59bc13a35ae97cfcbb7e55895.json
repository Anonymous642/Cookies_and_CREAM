{"manifest_version": 3, "name": "Anti RedditJS", "version": "1.2.0", "description": "Removes the NSFW age verification blocking modal on Reddit so you can read posts without logging in.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "anti-redditjs@anti-js.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}