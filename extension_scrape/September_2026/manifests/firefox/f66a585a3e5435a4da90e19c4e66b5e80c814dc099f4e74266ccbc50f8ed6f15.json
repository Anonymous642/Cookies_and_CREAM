{"manifest_version": 3, "name": "Nexus Legacy Advisor", "version": "2.0.0", "description": "Reads your Nexus Legacy colony from the game's own API and tells you the best one or two things to build or research next.", "browser_specific_settings": {"gecko": {"id": "nexus-legacy-advisor@agolho.github.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.nexuslegacy.space/*"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "Nexus Legacy Advisor", "default_panel": "sidebar.html", "open_at_install": false}, "action": {"default_title": "Nexus Legacy Advisor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.nexuslegacy.space/*"], "js": ["src/theme.js", "src/render.js", "src/state.js", "src/advisor.js", "src/api.js", "src/overlay.js", "content.js"], "run_at": "document_idle"}]}