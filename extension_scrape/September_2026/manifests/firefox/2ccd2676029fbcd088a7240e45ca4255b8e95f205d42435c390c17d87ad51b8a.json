{"manifest_version": 2, "name": "nitro-connect", "version": "1.0.1", "description": "Toggle a proxy on/off with support for HTTP, SOCKS4, and SOCKS5.", "permissions": ["proxy", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16-off.png", "48": "icons/icon48-off.png", "128": "icons/icon128-off.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "NitroConnect@nitro-ai.org", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "91.1.0"}}}