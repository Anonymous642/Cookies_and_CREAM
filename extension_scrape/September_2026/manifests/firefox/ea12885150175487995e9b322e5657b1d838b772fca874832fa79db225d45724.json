{"manifest_version": 3, "name": "VELA Connector", "version": "0.1.0", "description": "Connects your TradingView session to the VELA desktop app for automatic trade chart screenshots.", "permissions": ["cookies", "alarms"], "host_permissions": ["*://*.tradingview.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "VELA Connector", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "connector@vela.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}