{"name": "Quicker Connector", "version": "1.2.0", "manifest_version": 3, "description": "Native message connector with Quicker application", "background": {"scripts": ["./background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "addon@getquicker.net", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["bookmarksInfo"]}}}, "web_accessible_resources": [{"resources": ["./content/styles.css"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["./content/content.js"], "all_frames": true}], "icons": {"128": "./icons/128.png"}, "action": {"default_popup": "./popup/popup.html"}, "sidebar_action": {"default_title": "\u7f51\u9875\u6570\u636e\u63d0\u53d6\u5668", "default_panel": "./sidepanel/sidepanel.html"}, "permissions": ["nativeMessaging", "tabs", "contextMenus", "storage", "scripting", "activeTab", "cookies", "downloads", "webNavigation"], "optional_permissions": ["bookmarks", "browsingData", "history", "sessions", "userScripts"], "host_permissions": ["<all_urls>"], "homepage_url": "https://getquicker.net"}