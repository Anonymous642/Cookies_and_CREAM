{"manifest_version": 3, "name": "Markdown Reader", "version": "1.0.3", "author": "TechSivam Labs", "browser_specific_settings": {"gecko": {"id": "markdown-reader@techsivam.labs", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Renders local and remote Markdown files beautifully with customizable themes, Table of Contents, and printing support.", "permissions": ["storage", "activeTab"], "host_permissions": ["http://*/*", "https://*/*", "file:///*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_title": "Markdown Reader", "default_popup": "ui/reader.html"}, "web_accessible_resources": [{"resources": ["ui/reader.html", "ui/reader.js", "ui/styles.css", "vendor/marked.min.js", "vendor/purify.min.js"], "matches": ["<all_urls>"]}]}