{"manifest_version": 2, "name": "Uipg's EPUB Grabber", "version": "2.3.4", "description": "Grab chapters from a novel's table of contents (or a starting chapter URL) and package them into a clean, growing EPUB \u2014 full-page UI, pause/resume, library, and CAPTCHA-aware fetching.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Novel to EPUB", "default_icon": "icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "novel-to-epub@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}