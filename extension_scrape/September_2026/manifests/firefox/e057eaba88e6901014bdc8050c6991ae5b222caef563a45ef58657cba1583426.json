{"manifest_version": 3, "name": "Color Hunter", "version": "1.0.2", "description": "Selecciona un color de la pantalla y c\u00f3pialo al portapapeles en formato RGB, HSL o HEX.", "author": "YazeDev", "browser_specific_settings": {"gecko": {"id": "colorhunter@yazedev.com", "strict_min_version": "145.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"], "icons": {"64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_title": "ColorHunter", "default_popup": "popup.html", "default_icon": {"64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}}, "web_accessible_resources": [{"resources": ["popup.css", "inter-variablefont.ttf", "favorite-icon.svg", "pick-color-icon.svg", "copy-icon.svg", "pallete-icon.svg"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}}