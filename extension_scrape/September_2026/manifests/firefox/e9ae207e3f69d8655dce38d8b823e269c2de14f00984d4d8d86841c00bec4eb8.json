{"manifest_version": 2, "name": "Fanatical Steam Tags and Links", "author": "PixelForge", "version": "1.1", "description": "Fanatical Steam Tags And Links adds links to Steam pages and displays \"Wishlist\" and \"Owned\" tags for games on fanatical.com.", "background": {"scripts": ["src/background.js"]}, "browser_action": {"default_popup": "src/popup.html", "default_icon": {"128": "resources/logo.png"}}, "permissions": ["storage", "https://www.fanatical.com/*", "https://store.steampowered.com/api/*", "https://api.steampowered.com/*", "https://cdnjs.cloudflare.com/"], "content_scripts": [{"matches": ["https://www.fanatical.com/*"], "js": ["src/content.js"], "css": ["src/style.css"]}], "icons": {"128": "resources/logo.png"}, "browser_specific_settings": {"gecko": {"id": "pixelforge.tools@gmail.com", "data_collection_permissions": {"required": ["none"]}}}}