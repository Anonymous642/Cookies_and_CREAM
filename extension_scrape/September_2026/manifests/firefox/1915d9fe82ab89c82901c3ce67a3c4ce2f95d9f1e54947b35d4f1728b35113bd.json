{"manifest_version": 2, "name": "Cross-Browser Sender 2", "version": "1.0", "description": "Send webpage data to Python server", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Send page data", "default_icon": "image.png"}, "permissions": ["tabs", "activeTab", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "cross-browser-sender@proton.me", "data_collection_permissions": {"collects_browsing_data": false, "required": ["none"]}}}}