{"manifest_version": 3, "name": "Google Maps Website Scraper", "version": "1.0", "description": "Extract business names, websites, phone numbers, addresses, ratings and reviews from Google Maps search results and export to CSV.", "browser_specific_settings": {"gecko": {"id": "maps-scraper@yourname.com", "strict_min_version": "140.0", "data_collection_permissions": {"collects_data": false, "required": ["none"]}}}, "permissions": ["activeTab", "scripting", "downloads"], "host_permissions": ["https://www.google.com/maps/*"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Maps Scraper", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.google.com/maps/*"], "js": ["content.js"], "run_at": "document_idle"}]}