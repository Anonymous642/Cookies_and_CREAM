{"manifest_version": 3, "name": "DnD TrueSight Companion", "version": "1.0.16", "description": "Automatically sends your D&D Beyond dice rolls and HP to the TrueSight display screen.", "browser_specific_settings": {"gecko": {"id": "dndtruesight-companion@dndtruesight.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://www.dndbeyond.com/*", "https://localhost:3000/*", "https://dndtruesight-production.up.railway.app/*"], "content_scripts": [{"matches": ["https://www.dndbeyond.com/characters/*"], "js": ["content-dndbeyond.js"], "run_at": "document_idle"}, {"matches": ["https://localhost:3000/*", "https://dndtruesight-production.up.railway.app/*"], "js": ["content-app.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "DnD TrueSight Companion"}, "icons": {"16": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}}