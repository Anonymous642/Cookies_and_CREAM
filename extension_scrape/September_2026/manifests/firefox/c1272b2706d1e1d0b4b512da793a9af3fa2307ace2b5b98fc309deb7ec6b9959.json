{"manifest_version": 3, "name": "Startpage - No Perms", "version": "1.0.0", "description": "Adds Startpage to Firefox's search engine list but doesn't require any permissions. Not affiliated with Startpage.", "browser_specific_settings": {"gecko": {"id": "@startpage-noperms", "strict_min_version": "109.0"}}, "icons": {"32": "icon-32.png", "128": "icon-128.png"}, "chrome_settings_overrides": {"search_provider": {"name": "Startpage", "search_url": "https://www.startpage.com/search?q={searchTerms}", "favicon_url": "searchimage.png", "encoding": "UTF-8", "is_default": false}}}