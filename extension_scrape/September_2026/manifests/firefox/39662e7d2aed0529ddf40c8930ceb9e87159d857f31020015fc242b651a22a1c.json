{"manifest_version": 3, "name": "Site Cleaner \u2013 1-Click Cookies/Storage Clear", "version": "1.0.0", "description": "Xo\u00e1 d\u1eef li\u1ec7u c\u1ee7a site hi\u1ec7n t\u1ea1i: Cookies, LocalStorage/SessionStorage, IndexedDB, Cache Storage, Service Workers. C\u00f3 tu\u1ef3 ch\u1ecdn xo\u00e1 Cache tr\u00ecnh duy\u1ec7t (to\u00e0n c\u1ee5c).", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "tabs", "scripting", "cookies", "browsingData", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "site-cleaner-demo@example.com", "strict_min_version": "109.0"}}}