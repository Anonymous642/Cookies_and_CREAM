{"manifest_version": 3, "name": "Fillright \u2014 Form Autofill", "version": "0.1.0", "minimum_chrome_version": "121", "description": "Refill the forms you fill often. Unlimited, local, no account. Never touches passwords or card numbers.", "permissions": ["storage", "activeTab", "scripting"], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup.html", "default_title": "Fillright"}, "commands": {"fill-form": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Fill this page with the active profile"}}, "browser_specific_settings": {"gecko": {"id": "fillright@fillright.app", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "optional_host_permissions": ["<all_urls>"]}