{"manifest_version": 2, "name": "Mixalator", "description": "Easily add and browse links from your Mixalator.com account", "version": "0.2.2resigned1", "homepage_url": "https://mixalator.com", "icons": {"48": "icon48.png", "96": "icon96.png"}, "applications": {"gecko": {"id": "firefox@mixalator.com", "strict_min_version": "45.0"}}, "browser_action": {"default_icon": {"16": "icon16.png", "32": "icon32.png", "64": "icon64.png"}, "default_popup": "popup.html", "default_title": "Mixalator"}, "permissions": ["activeTab", "bookmarks", "https://*.mixalator.com/"], "commands": {"add-current-page": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Add the current page to your Mixalator mix."}}}