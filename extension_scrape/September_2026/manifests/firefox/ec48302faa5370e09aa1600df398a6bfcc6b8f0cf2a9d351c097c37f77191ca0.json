{"manifest_version": 2, "name": "TikTok Downloader & Auto Scroll", "version": "1.0", "description": "Download TikTok videos, subtitles, and auto-scroll videos.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "downloads", "storage", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://www.tiktok.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon48.png"}, "browser_specific_settings": {"gecko": {"id": "tiktok-downloader@example.com"}}}