{"manifest_version": 3, "name": "Weave \u2014 Page Transformer", "version": "1.0.1", "description": "Transform any webpage with custom text replacements, reading modes, and visual enhancements.", "permissions": ["storage", "activeTab", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "weave@weza.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Weave"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+W", "mac": "Command+Shift+W"}, "description": "Open Weave popup"}}, "author": "cuqz", "homepage_url": "https://github.com/cuqz/weave"}