{"manifest_version": 2, "name": "AliTaxCalc", "version": "1.5", "description": "shows approximate tax for chilean purchases in aliexpress + some useful tweaks", "icons": {"48": "icons/border-48.png"}, "content_scripts": [{"matches": ["*://*.aliexpress.com/p/shoppingcart/*", "*://*.aliexpress.com/item/*", "*://*.aliexpress.com/w/*", "*://*.aliexpress.ru/p/shoppingcart/*", "*://*.aliexpress.ru/item/*", "*://*.aliexpress.ru/w/*"], "js": ["main.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["websiteContent"]}, "id": "shironeko@alitaxcalc"}}}