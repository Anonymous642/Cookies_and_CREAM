{"manifest_version": 2, "name": "Immersive Web App (Singleton & Fullscreen)", "short_name": "Immersive Web App", "version": "3.1.0", "description": "Transform any website into a pure, immersive desktop app experience. Force all links to open in the current window and block new tabs.", "author": "Genmetsu Wenxue Press", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["detector.js"], "run_at": "document_start", "all_frames": false}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "immersive_webapp@Genmetsu-Wenxue-Press", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}