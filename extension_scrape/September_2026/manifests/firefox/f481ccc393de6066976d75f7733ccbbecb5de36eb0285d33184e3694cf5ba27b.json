{"manifest_version": 3, "name": "Linkfeed Extension", "version": "2.1", "description": "Share the page you're on to your Linkfeed in one click.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png"}, "default_title": "Share to Linkfeed"}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://linkfeed.io/*"], "browser_specific_settings": {"gecko": {"id": "admin@linkfeed.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}