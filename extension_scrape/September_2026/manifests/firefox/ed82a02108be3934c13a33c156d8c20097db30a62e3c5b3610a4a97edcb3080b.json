{"manifest_version": 3, "name": "Mooro for Webflow", "version": "0.1.0", "description": "Publish your Webflow site straight to Mooro hosting.", "browser_specific_settings": {"gecko": {"id": "mooro-webflow@mooro.host", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "permissions": ["storage", "tabs"], "host_permissions": ["https://mooro.host/*"], "content_scripts": [{"matches": ["https://*.webflow.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}