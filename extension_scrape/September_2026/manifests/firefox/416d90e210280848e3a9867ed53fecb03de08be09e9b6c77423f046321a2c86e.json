{"manifest_version": 3, "name": "Riidact: Detect sensitive data in AI & web", "version": "0.1.4", "description": "Catch sensitive data before you send it to AI tools like ChatGPT and Claude, plus other sites. On-device; your text never leaves.", "permissions": ["storage", "alarms", "identity", "scripting", "activeTab"], "optional_host_permissions": ["https://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "riidact@riidact.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}