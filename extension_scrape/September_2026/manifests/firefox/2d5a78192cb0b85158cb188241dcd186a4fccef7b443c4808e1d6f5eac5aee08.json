{"manifest_version": 3, "name": "StickyN+", "version": "2.0", "description": "Per-site floating sticky notes with a beautiful modern UI.", "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "StickyN+", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/note.svg", "96": "icons/note.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/note.svg", "96": "icons/note.svg"}, "browser_specific_settings": {"gecko": {"id": "stickynplus@kenisies", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}