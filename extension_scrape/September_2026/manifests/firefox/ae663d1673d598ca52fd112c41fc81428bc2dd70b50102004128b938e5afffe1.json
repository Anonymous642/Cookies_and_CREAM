{"manifest_version": 2, "name": "YouTube Spoiler Blocker", "version": "1.1", "description": "Automatically replace YouTube thumbnails for videos containing certain words (e.g. Pok\u00e9mon Z-A spoilers).", "permissions": ["storage", "tabs", "*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.png"}, "web_accessible_resources": ["icons/spoiler-blocked.png"], "browser_specific_settings": {"gecko": {"id": "youtube-spoiler-blocker@example.com"}}}