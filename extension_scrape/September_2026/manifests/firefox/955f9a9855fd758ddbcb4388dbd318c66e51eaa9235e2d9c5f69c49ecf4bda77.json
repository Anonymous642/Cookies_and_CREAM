{"manifest_version": 3, "name": "Snowplow Inspector", "description": "Add a panel to DevTools to show Snowplow analytics beacon information.", "version": "0.4.4", "author": "Snowplow Australia", "browser_specific_settings": {"gecko": {"id": "snowplow-addon-vunnam@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Snowplow Inspector", "default_popup": "popup.html", "default_icon": {"280": "assets/icon.png"}}, "options_page": "options.html", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "devtools_page": "devtools.html", "permissions": ["storage"], "host_permissions": ["*://iglucentral.com/*"], "optional_host_permissions": ["*://*/*"]}