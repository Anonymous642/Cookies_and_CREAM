{"manifest_version": 3, "name": "Broditor", "version": "1.0.0", "description": "Captures browser activity and syncs audit events to the Browser Activity Audit & Compliance Platform.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs", "webNavigation", "idle", "downloads", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service-worker.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "storage": {"managed_schema": "managed_schema.json"}, "browser_specific_settings": {"gecko": {"id": "broditor@yourdomain.com", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}}