{"manifest_version": 3, "name": "Keepsake for Janitor AI", "version": "1.0.1", "description": "A local black box for your Janitor AI chats. Saves every message the moment it happens, so a failed send or a lost session never costs you your roleplay.", "author": "Noah Albert", "homepage_url": "https://github.com/Android-Tipster/keepsake", "browser_specific_settings": {"gecko": {"id": "keepsake@roborhythms.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["*://janitorai.com/*", "*://*.janitorai.com/*"], "js": ["src/normalize.js", "src/decoder.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/page-hook.js"], "matches": ["*://janitorai.com/*", "*://*.janitorai.com/*"]}], "action": {"default_title": "Keepsake", "default_popup": "src/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}