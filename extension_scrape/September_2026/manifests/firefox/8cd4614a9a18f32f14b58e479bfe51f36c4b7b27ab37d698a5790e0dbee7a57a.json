{"manifest_version": 3, "name": "Search YT", "version": "1.0", "description": "Search contents of a YouTube video", "permissions": ["activeTab", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "search-yt@example.com"}}, "action": {"default_popup": "index.html", "default_icon": "public/fire-logo.png"}, "background": {"page": "public/background.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["dist/content.js"], "run_at": "document_idle"}]}