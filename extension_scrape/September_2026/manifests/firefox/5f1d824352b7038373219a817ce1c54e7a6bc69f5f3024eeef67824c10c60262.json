{"manifest_version": 3, "name": "Time Tracker Addon for Kimai", "version": "1.0.1.7", "description": "Start, stop and resume Kimai time entries directly from your browser", "permissions": ["storage", "tabs", "webRequest"], "host_permissions": ["*://app.clockwork.report/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/kimai-16.png", "48": "icons/kimai-48.png", "128": "icons/kimai-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/clockwork.js"], "run_at": "document_idle"}], "icons": {"16": "icons/kimai-16.png", "48": "icons/kimai-48.png", "128": "icons/kimai-128.png"}, "browser_specific_settings": {"gecko": {"id": "kimai-time-tracker@firefox-addon", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}