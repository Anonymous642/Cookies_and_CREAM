{"manifest_version": 3, "name": "Clickbait Remover Redux for Youtube", "short_name": "Clickbait Remover Redux", "default_locale": "en", "version": "1.0.0", "description": "Replaces thumbnails and modifies titles of videos on youtube.com. Based on the extension programmed by Pieter van Heijningen.", "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["js/youtube.js"]}], "background": {"scripts": ["js/background.js"]}, "action": {"default_icon": {"16": "images/clickbait_remover_icon16.png", "32": "images/clickbait_remover_icon32.png"}, "default_title": "Clickbait Remover for Youtube", "default_popup": "options_popup.html"}, "icons": {"16": "images/clickbait_remover_icon16.png", "32": "images/clickbait_remover_icon32.png", "48": "images/clickbait_remover_icon48.png", "128": "images/clickbait_remover_icon128.png"}, "permissions": ["webRequest", "storage", "webRequestBlocking", "scripting", "tabs"], "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://i.ytimg.com/*"], "browser_specific_settings": {"gecko": {"id": "clickbait-remover-redux@salazarbarrera", "data_collection_permissions": {"required": ["none"]}}}}