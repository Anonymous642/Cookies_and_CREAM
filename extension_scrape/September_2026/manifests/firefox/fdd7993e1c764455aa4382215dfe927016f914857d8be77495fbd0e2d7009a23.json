{"manifest_version": 3, "name": "FocusTube", "version": "0.2.2", "description": "Turn YouTube into a study tool. Start a focus session with a goal and the feed, recommendations, Shorts, comments and autoplay disappear until you finish. No session, no changes.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["youtube.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "FocusTube"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "focustube@focustube.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}