{"manifest_version": 2, "name": "ProseMirror Auto Unlock + Translate (v4)", "version": "1.0.4", "description": "T\u1ef1 \u0111\u1ed9ng b\u1eadt editable v\u00e0 cho ph\u00e9p d\u1ecbch (translate=yes) cho t\u1ea5t c\u1ea3 v\u00f9ng ProseMirror.", "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Toggle ProseMirror editable + translate"}, "commands": {"toggle-prosemirror": {"suggested_key": {"default": "Alt+E", "mac": "Alt+E"}, "description": "B\u1eadt/t\u1eaft auto editable + translate"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "prosemirror-unlock@example.com", "strict_min_version": "58.0"}}}