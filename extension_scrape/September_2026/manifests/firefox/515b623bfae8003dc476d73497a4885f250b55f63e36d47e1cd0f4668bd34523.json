{"manifest_version": 3, "name": "LockedIn - Digital Wellness", "description": "Permanently block short-form video feeds. Take back control of your digital wellness.", "version": "1.0.0", "permissions": ["storage", "tabs", "nativeMessaging"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://m.instagram.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "LockedIn", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "background": {"scripts": ["src/service-worker.js"]}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*", "https://m.instagram.com/*"], "js": ["src/content/instagram.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["src/content/youtube.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "lockedin@lockedin.dev", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}