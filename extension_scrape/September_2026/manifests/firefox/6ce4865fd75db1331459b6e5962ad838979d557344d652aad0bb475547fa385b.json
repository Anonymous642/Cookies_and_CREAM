{"manifest_version": 2, "name": "Site Gatekeeper", "version": "1.0.0", "description": "Block websites and optionally redirect them to URLs of your choice.", "browser_specific_settings": {"gecko": {"id": "site-gatekeeper@extension", "strict_min_version": "142.0", "data_collection_permissions": {"isDataCollected": false, "required": ["none"]}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}