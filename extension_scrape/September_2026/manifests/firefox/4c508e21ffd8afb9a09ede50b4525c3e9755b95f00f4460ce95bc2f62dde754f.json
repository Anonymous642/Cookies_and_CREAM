{"manifest_version": 3, "name": "Memo Pad \u2013 Sticky Notes on Websites", "version": "1.0.1", "description": "Persistent floating sticky notes with page isolation, multi-tabs, and cloud sync.", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://qsnlhslilprzydcfxnwm.supabase.co/*"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Memo Pad", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"toggle_memo": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Toggle Sticky Memo visibility"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "memo-pad@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteActivity", "websiteContent", "authenticationInfo"]}}}}