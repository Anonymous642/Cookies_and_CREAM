{"manifest_version": 3, "name": "Meteoflow\u00b0 Weather", "version": "2.0.0", "description": "Current weather and hourly forecast at a glance", "permissions": ["storage", "alarms"], "host_permissions": ["https://api.meteoflow.com/*", "https://meteoflow.com/*", "https://ws.meteoflow.com/*", "https://tiles.meteoflow.com/*"], "browser_specific_settings": {"gecko": {"id": "meteoflow-weather@meteoflow.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Meteoflow\u00b0 Weather"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["service-worker.js"], "type": "module"}}