{"manifest_version": 2, "name": "JDownloader Floating Button", "version": "0.1.3", "description": "Adds a floating Download with JD button to videos and sends links to a local JDownloader instance.", "permissions": ["<all_urls>", "storage", "webRequest", "http://127.0.0.1/*", "https://127.0.0.1/*", "http://localhost/*", "https://localhost/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "browser_action": {"default_title": "Send current page to JDownloader"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "jdownloader-floating-button@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}}}}