{"manifest_version": 3, "name": "Umair DeskPro \u2013 Agent Toolkit", "version": "0.1.0", "description": "Umair DeskPro \u2013 Agent Toolkit is a live chat agent sidebar for canned replies, SOP links, and notes. Designed for web-based contact center and support agents.", "author": "Muhammad Umair", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["sidebar.css"], "run_at": "document_idle"}], "action": {"default_title": "Umair DeskPro \u2013 Agent Toolkit"}, "browser_specific_settings": {"gecko": {"id": "umairdeskpro-agenttoolkit@umair.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}