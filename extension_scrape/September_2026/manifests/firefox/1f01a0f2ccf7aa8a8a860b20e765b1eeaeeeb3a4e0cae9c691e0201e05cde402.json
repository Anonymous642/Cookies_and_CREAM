{"manifest_version": 3, "name": "Translate with Mistral AI", "version": "1.0.0", "description": "Right-click selected text and translate it with Mistral AI in the sidebar.", "author": "Kvintvs", "license": "MIT", "browser_specific_settings": {"gecko": {"id": "translate-with-mistral@kvintvs", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["menus", "storage", "clipboardWrite", "scripting"], "host_permissions": ["https://api.mistral.ai/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "Translate with Mistral AI", "default_panel": "sidebar.html", "open_at_install": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"translate-selection": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Translate the current selection (opens the sidebar)"}}}