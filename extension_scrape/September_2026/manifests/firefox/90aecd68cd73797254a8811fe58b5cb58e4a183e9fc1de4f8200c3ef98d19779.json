{"manifest_version": 2, "name": "Page Reader", "version": "1.0.0", "description": "Reads the entire visible text of any page and displays it in a clean box.", "browser_specific_settings": {"gecko": {"id": "page-reader@devtool", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Page Reader"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["activeTab", "storage", "tabs"]}