{"manifest_version": 3, "name": "DoEveryday \u2014 Build habits that stick", "short_name": "DoEveryday", "version": "1.2.0", "description": "Every new tab becomes a habit check-in. One tap, every day \u2014 watch your streaks grow.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "identity", "alarms"], "host_permissions": ["https://*.supabase.co/*"], "background": {"scripts": ["assets/background.js"], "type": "module"}, "action": {"default_title": "DoEveryday \u2014 Quick check-in", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co https://*.supabase.in"}, "content_scripts": [{"matches": ["https://doeveryday.app/*", "https://*.doeveryday.app/*"], "js": ["assets/relay.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "doeveryday@doeveryday.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}}}