{"name": "BolFilter", "version": "2.0.0", "description": "Filter onderverkopers en drophippers uit de resultaten van Bol.com", "author": "JKCTech", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "BolFilter@jkctech.nl", "strict_min_version": "113.0"}}, "permissions": ["declarativeNetRequest", "storage", "webRequest", "tabs"], "declarative_net_request": {"rule_resources": [{"id": "bol", "enabled": false, "path": "handlers/bol/rules.json"}, {"id": "bol_disabled", "enabled": false, "path": "handlers/bol/rules_disabled.json"}]}, "web_accessible_resources": [{"resources": ["icon/bolfilter.png", "icon/bolfilter_enabled.png", "icon/bolfilter_disabled.png", "icon/bolfilter_unable.png", "handlers/global/popup.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.bol.com/*", "*://bol.com/*"], "css": ["handlers/global/popup.css", "handlers/bol/bol.css"], "js": ["handlers/global/popup.js", "handlers/bol/bol.js"], "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Bolfilter", "default_icon": "icon/icon.png", "default_popup": "menu/menu.html"}, "icons": {"16": "icon/icon16.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "host_permissions": ["*://*.bol.com/*", "*://bol.com/*"]}