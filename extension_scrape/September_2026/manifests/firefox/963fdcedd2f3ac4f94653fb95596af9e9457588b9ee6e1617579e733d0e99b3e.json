{"manifest_version": 3, "name": "Let Me Lurk, Reddit!", "short_name": "LMLR", "version": "0.1.0", "description": "Allows you to browse Reddit on desktop without logging in.", "browser_specific_settings": {"gecko": {"id": "@let-me-lurk-reddit", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_start"}]}