{"manifest_version": 2, "name": "Fix MTN Shop", "description": "I fixed what the MTN UI team left behind, so you can shop in peace.", "version": "1.0.0", "short_name": "Fix MTN Shop", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "fix-mtn-shop@addons.matsco.de", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Fix MTN Shop", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://shop.mtn.ng/*", "https://shop.mtn.ng/*"], "js": ["content-scripts/content.js"]}]}