{"manifest_version": 3, "name": "Quick PDF Search Toggle", "version": "1.2", "description": "Instantly reloads your current Google Search to show ONLY PDF files. Click the icon to toggle PDF mode on or off.", "permissions": ["activeTab", "scripting"], "action": {"default_title": "Toggle PDF Filter", "default_icon": "icon.svg"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "quick-pdf-toggle@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}