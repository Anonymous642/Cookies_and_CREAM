{"manifest_version": 3, "name": "Quick Actions - Search and Copy (Beta)", "version": "1.8", "description": "Adds a copy button and search button when text is selected on webpages, with a customizable options section", "browser_specific_settings": {"gecko": {"id": "quick-actions@example.org"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_end", "all_frames": true}], "permissions": ["activeTab", "clipboardWrite", "storage"], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["styles.css"], "matches": ["<all_urls>"]}]}