{"manifest_version": 2, "name": "AdWall Remover", "version": "1.2", "description": "Automatically removes anti-adblock overlays and restores page scrolling.", "browser_specific_settings": {"gecko": {"id": "adwall-remover@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_popup": "popup.html", "default_title": "AdWall Remover", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}}