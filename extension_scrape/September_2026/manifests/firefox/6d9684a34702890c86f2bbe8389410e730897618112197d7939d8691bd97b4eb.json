{"manifest_version": 2, "name": "URL Warning Banner", "version": "1.1", "description": "Shows a configurable warning banner on specific URLs", "browser_specific_settings": {"gecko": {"id": "url-warning@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "URL Warning Banner settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "theme_icons": [{"light": "icons/icon-16-light.png", "dark": "icons/icon-16.png", "size": 16}, {"light": "icons/icon-32-light.png", "dark": "icons/icon-32.png", "size": 32}]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "options_ui": {"page": "options.html", "browser_style": false}}