{"manifest_version": 2, "name": "Ascension", "version": "0.1.6", "description": "Block distracting websites and track your screentime.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "Ascension", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["declarativeNetRequest", "nativeMessaging", "storage", "tabs", "activeTab", "webNavigation", "alarms", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "css": ["youtube-content.css"], "js": ["youtube-content.js"], "run_at": "document_start"}], "web_accessible_resources": ["blocked.html", "blocked.js", "assets/Gradient.webp", "assets/Title+logo.png"], "browser_specific_settings": {"gecko": {"id": "ascension@ascensionapp.ai", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}