{"manifest_version": 3, "name": "Website Blocker", "version": "1.0.1", "description": "Block access to websites during specific times of the day.", "icons": {"48": "website-blocker.png", "128": "website-blocker - logo.png"}, "action": {"default_icon": "website-blocker.png", "default_popup": "html/popup.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "website-blocker@oxhey3", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/websiteBlocker.js"]}]}