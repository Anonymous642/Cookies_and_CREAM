{"manifest_version": 3, "name": "orchid", "version": "1.0.1", "description": "A Firefox extension that discourages opening AI websites", "icons": {"48": "icons/orchid-48.png", "96": "icons/orchid-96.png"}, "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://*.chatgpt.com/*", "*://claude.ai/*", "*://*.claude.ai/*", "*://gemini.google.com/*", "*://copilot.microsoft.com/*", "*://perplexity.ai/*", "*://*.perplexity.ai/*", "*://you.com/*", "*://*.you.com/*", "*://phind.com/*", "*://deepseek.chat/*", "*://chat.deepseek.com/*"], "js": ["orchid.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "orchid@local.dev"}}}