{"manifest_version": 2, "name": "ResumeVideo", "version": "1.2.5", "author": "ResumeVideo", "description": "Automatically saves video positions and resumes them where you left off. Positions can be cleared manually or automatically, with per-video pause, options and excluded sites.", "permissions": ["storage", "alarms"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": true}], "browser_action": {"default_title": "ResumeVideo \u2014 saved positions", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "riprendivideo@addons.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}