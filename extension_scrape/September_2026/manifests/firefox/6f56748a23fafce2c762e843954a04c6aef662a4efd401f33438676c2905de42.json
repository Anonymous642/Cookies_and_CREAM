{"manifest_version": 2, "name": "Tab Reloader", "version": "1.0", "description": "Reload the current tab at a specified interval", "homepage_url": "https://github.com/jrmgx/TabReloaderExtension", "permissions": ["tabs", "alarms", "storage"], "browser_action": {"default_popup": "popup.html", "default_title": "Tab Reloader", "default_icon": "blue.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@tab-reloader", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}