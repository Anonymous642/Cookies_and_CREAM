{"manifest_version": 3, "name": "Now Playing Bridge for Senpai", "version": "0.1.1", "description": "Sends the currently playing browser video to Senpai on Linux.", "permissions": ["nativeMessaging"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-now-playing-senpai@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}