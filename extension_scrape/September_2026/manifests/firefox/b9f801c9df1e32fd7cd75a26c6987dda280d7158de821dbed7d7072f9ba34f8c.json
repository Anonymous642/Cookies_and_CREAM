{"manifest_version": 3, "name": "CineTrack - Movie Watchlist", "version": "1.0.0", "description": "Track movies and shows you want to watch. Add titles, rate them, mark as watched, and organize your personal watchlist with ease.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "CineTrack Watchlist", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "cinetrack@watchlist.extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}