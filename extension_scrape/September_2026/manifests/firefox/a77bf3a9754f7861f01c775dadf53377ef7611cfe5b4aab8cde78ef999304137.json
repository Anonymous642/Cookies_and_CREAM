{"manifest_version": 3, "name": "Pro-E for Accurate", "version": "0.2.14", "description": "Apply Pro-E promotions to Sales Orders and invoice the opened Delivery Order in Accurate.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "identity"], "host_permissions": ["https://accurate.id/*", "https://*.accurate.id/*", "https://pro-e.app/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://accurate.id/*", "https://*.accurate.id/*"], "js": ["src/accurate-page-adapter.js", "src/content.js"], "css": ["styles/widget.css"], "run_at": "document_idle"}], "action": {"default_title": "Pro-E", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "pro-e@pro-e.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "financialAndPaymentInfo", "websiteContent"]}}}}