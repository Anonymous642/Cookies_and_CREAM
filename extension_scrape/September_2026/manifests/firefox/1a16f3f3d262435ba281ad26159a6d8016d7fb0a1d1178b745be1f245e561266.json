{"manifest_version": 3, "name": "Green Dictation", "version": "0.1.0", "description": "Dictate into any text field with on-page microphone controls.", "action": {"default_title": "Green Dictation"}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage"], "host_permissions": ["<all_urls>", "https://api.openai.com/*"], "options_ui": {"page": "popup/recorder.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/dictate.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "green-dictation@l3z.eu", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}