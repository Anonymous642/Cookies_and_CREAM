{"manifest_version": 3, "name": "AO3 Graph Search", "description": "Discover new AO3 works through graph-based search methods.", "version": "0.5.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://archiveofourown.org/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "ao3graphsearch@confusedphoton"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "AO3 Semantic Search", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://archiveofourown.org/*"], "run_at": "document_idle", "js": ["content-scripts/ao3.js"]}]}