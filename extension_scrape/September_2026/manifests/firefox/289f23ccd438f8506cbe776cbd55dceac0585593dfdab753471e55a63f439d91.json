{"manifest_version": 3, "name": "Lineage Tab Groups", "version": "1.0.0", "description": "Groups new tabs with the tab that opened them, creating a native group named after that opener when needed.", "icons": {"128": "images/lineage-tabgroups-128.png"}, "permissions": ["tabs", "tabGroups"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "addon@lineage-tab-groups.dev", "strict_min_version": "139.0", "data_collection_permissions": {"required": ["none"]}}}}