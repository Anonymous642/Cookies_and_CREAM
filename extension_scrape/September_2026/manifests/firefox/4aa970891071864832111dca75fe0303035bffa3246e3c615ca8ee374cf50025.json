{"manifest_version": 3, "name": "YouTube Channel Filter", "version": "2.3", "description": "Only show videos from selected YouTube channels.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"48": "icon.svg", "128": "icon.svg"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["intercept.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["intercept.js"], "matches": ["*://*.youtube.com/*"]}], "action": {"default_popup": "popup.html", "default_title": "Filter Channels", "default_icon": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "yt-channel-filter@local.extension", "data_collection_permissions": {"required": ["none"]}}}}