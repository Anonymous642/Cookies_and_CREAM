{"manifest_version": 3, "name": "Custom Data Scraper", "version": "1.0", "description": "Inject custom JS to scrape data across paginated pages.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "custom-data-scraper@my-domain.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "storage", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Open Scraper"}, "background": {"scripts": ["background.js"]}}