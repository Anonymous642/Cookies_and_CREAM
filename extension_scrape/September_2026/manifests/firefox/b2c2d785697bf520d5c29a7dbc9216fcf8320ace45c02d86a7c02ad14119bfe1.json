{"manifest_version": 3, "name": "AnimeSama AutoNext", "version": "1.9.0", "description": "Passe automatiquement \u00e0 l'\u00e9pisode suivant et saute openings/endings sur anime-sama", "permissions": ["scripting", "storage"], "host_permissions": ["*://anime-sama.to/*", "*://anime-sama.fr/*", "https://api.aniskip.com/*", "https://api.jikan.moe/*", "https://graphql.anilist.co/*"], "icons": {"48": "icon48.png", "128": "icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "commands": {"next-episode": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Passer \u00e0 l'\u00e9pisode suivant"}, "skip-current": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sauter l'intro/outro en cours"}, "restore-fullscreen": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Remettre le plein \u00e9cran"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-iframe.js"], "all_frames": true, "run_at": "document_idle"}, {"matches": ["*://anime-sama.to/*", "*://anime-sama.fr/*"], "js": ["content-anime-sama.js"], "all_frames": false, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "animesama-autonext@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}