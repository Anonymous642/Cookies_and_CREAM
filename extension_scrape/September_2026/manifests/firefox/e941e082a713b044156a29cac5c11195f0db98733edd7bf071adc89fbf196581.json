{"manifest_version": 2, "name": "Tab Floater", "version": "1.1", "description": "Mimics Ctrl+L followed by Shift+Enter and closes the tab.", "permissions": ["activeTab", "tabs"], "browser_specific_settings": {"gecko": {"id": "tab-floater@example.com", "strict_min_version": "68.0"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Tab Floater"}, "commands": {"activate-sequence": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Execute the tab automation sequence"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}