{"manifest_version": 2, "name": "MySpaced", "version": "1.1.0", "description": "Bring the MySpace era back. Transform any website into a Y2K glitter dream.", "browser_specific_settings": {"gecko": {"id": "myspaced@myspaced.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "scripting", "<all_urls>"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["themes/themes.js", "content.js"]}], "web_accessible_resources": ["themes/*", "icons/*", "images/*"]}