{"manifest_version": 2, "name": "Limitly", "version": "1.0.3", "description": "Lets you visit chosen websites a limited number of times per day, then blocks them until the next reset.", "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Limitly", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "daily-once-blocker@example.com", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": ["blocked.html", "blocked.css", "blocked.js"]}