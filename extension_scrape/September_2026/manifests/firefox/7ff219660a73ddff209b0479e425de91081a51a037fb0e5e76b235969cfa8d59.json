{"manifest_version": 3, "name": "Leetify", "version": "1.0.4", "description": "Display CS2 match stats on the Steam profile of Counter-Strike players.", "homepage_url": "https://leetify.com", "browser_specific_settings": {"gecko": {"id": "leetify-extension-firefox@leetify.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": {"16": "assets/logo-icons/16.png", "32": "assets/logo-icons/32.png", "48": "assets/logo-icons/48.png", "64": "assets/logo-icons/64.png", "128": "assets/logo-icons/128.png", "256": "assets/logo-icons/256.png"}}, "icons": {"16": "assets/logo-icons/16.png", "32": "assets/logo-icons/32.png", "48": "assets/logo-icons/48.png", "64": "assets/logo-icons/64.png", "128": "assets/logo-icons/128.png", "256": "assets/logo-icons/256.png"}, "background": {"scripts": ["dist/sw.js"]}, "permissions": ["declarativeNetRequest"], "host_permissions": ["https://api.cs-prod.leetify.com/*", "https://steamcommunity.com/*", "https://www.faceit.com/*", "https://leetify.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"all_frames": true, "js": ["dist/faceit/match-room/injector.js"], "matches": ["https://www.faceit.com/*"]}, {"all_frames": true, "js": ["dist/steam/profile/injector.js"], "matches": ["https://steamcommunity.com/id/*", "https://steamcommunity.com/profiles/*"]}, {"all_frames": true, "js": ["dist/leetify/detect-extension/injector.js"], "matches": ["https://leetify.com/*"]}], "web_accessible_resources": [{"matches": ["https://www.faceit.com/*"], "resources": ["assets/extension-logo.svg", "dist/faceit/match-room/injected.css", "dist/faceit/match-room/injected.js"]}, {"matches": ["https://steamcommunity.com/*"], "resources": ["assets/extension-logo.svg", "assets/icons/chevron-arrow-down.svg", "assets/icons/platforms/cybershoke.svg", "assets/icons/platforms/esplay.svg", "assets/icons/platforms/faceit.svg", "asset