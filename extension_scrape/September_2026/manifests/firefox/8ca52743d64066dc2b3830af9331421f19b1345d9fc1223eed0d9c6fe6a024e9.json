{"manifest_version": 3, "name": "WSJ to MSN Reader", "version": "1.0.0", "description": "Encontra e redireciona manchetes do Wall Street Journal para not\u00edcias gratuitas e correspondentes no MSN.", "permissions": ["storage"], "host_permissions": ["*://*.wsj.com/*", "*://*.duckduckgo.com/*", "*://html.duckduckgo.com/*", "*://lite.duckduckgo.com/*", "*://*.msn.com/*", "*://*.bing.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.wsj.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["*://*.msn.com/*"], "js": ["msn_content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "WSJ to MSN Reader", "default_icon": {"48": "icons/icon.svg", "128": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "wsj-to-msn@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}