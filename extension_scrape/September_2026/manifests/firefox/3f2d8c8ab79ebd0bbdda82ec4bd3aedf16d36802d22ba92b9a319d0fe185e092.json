{"manifest_version": 3, "name": "Beamo Search", "version": "2.3.6", "description": "Make Beamo your default search engine and search beamosearch.com from the address bar, toolbar button, or right-click menu.", "homepage_url": "https://beamosearch.com/", "author": "Beamo LLC", "browser_specific_settings": {"gecko": {"id": "search-helper@beamosearch.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "chrome_settings_overrides": {"search_provider": {"name": "Beamo", "keyword": "beamo", "search_url": "https://beamosearch.com/results?q={searchTerms}", "favicon_url": "icons/icon16.png", "encoding": "UTF-8", "is_default": true}}, "permissions": ["contextMenus", "scripting", "tabs", "storage"], "host_permissions": ["https://beamosearch.com/*"], "content_scripts": [{"matches": ["https://beamosearch.com/*"], "js": ["dist/content-auth.js"], "run_at": "document_idle"}], "background": {"scripts": ["dist/background.js"]}, "action": {"default_title": "Open Beamo Search", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}}