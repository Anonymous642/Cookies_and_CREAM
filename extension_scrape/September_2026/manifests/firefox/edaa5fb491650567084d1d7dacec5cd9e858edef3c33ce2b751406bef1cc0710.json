{"manifest_version": 3, "name": "Z-Extractor", "version": "1.0.0", "description": "Extract and download media URLs from TikTok, YouTube, Instagram, X, and more.", "browser_specific_settings": {"gecko": {"id": "z-extractor@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "downloads", "storage", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/browser-polyfill.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "default_title": "Z-Extractor"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "content/extractors/generic.js", "content/extractors/tiktok.js", "content/extractors/youtube.js", "content/extractors/instagram.js", "content/extractors/twitter.js", "content/content.js"], "run_at": "document_idle", "all_frames": false}]}