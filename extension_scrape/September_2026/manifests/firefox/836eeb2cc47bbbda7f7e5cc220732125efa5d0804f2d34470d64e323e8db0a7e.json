{"manifest_version": 3, "name": "Redact Anything \u2013 Hide Data in Screenshots", "short_name": "Redact Anything", "version": "1.0.0", "description": "Black out emails, phones, IBANs, cards and images in one click, then export a PNG. Nothing ever leaves your browser.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Redact this page (Alt+Shift+R)"}, "options_page": "options.html", "commands": {"toggle-redact": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Redact the current page"}}, "browser_specific_settings": {"gecko": {"id": "redact-anything@atelier.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}