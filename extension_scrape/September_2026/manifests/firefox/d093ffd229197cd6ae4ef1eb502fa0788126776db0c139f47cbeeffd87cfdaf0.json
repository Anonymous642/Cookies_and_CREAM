{"manifest_version": 3, "name": "YouTempo: YouTube Music Speed Controller", "short_name": "YouTempo", "version": "1.3.7", "description": "Playback speed control, pitch lock, A/B loop, and visualiser for YouTube Music. Stores your set speed and preferences locally.", "browser_specific_settings": {"gecko": {"id": "lookas.dev@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://music.youtube.com/*"], "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["content/namespace.js", "content/util.js", "content/locales/en.js", "content/locales/es.js", "content/locales/ro.js", "content/i18n.js", "content/storage.js", "content/media.js", "content/beat.js", "content/audio-graph.js", "content/visualiser.js", "content/game.js", "content/ui-overlay.js", "content/ui-player-bar.js", "content/popup-bridge.js", "content/features.js", "content/sleep-timer.js", "content/bootstrap.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "YouTempo", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}