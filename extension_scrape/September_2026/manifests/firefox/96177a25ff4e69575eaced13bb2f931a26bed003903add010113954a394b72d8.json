{"manifest_version": 3, "name": "YouTube Bell List", "version": "1.0", "description": "View a list of subscribed YouTube channels that have notifications enabled.", "icons": {"48": "icons/ytbl-48.png", "96": "icons/ytbl-96.png"}, "permissions": ["tabs"], "host_permissions": ["*://www.youtube.com/feed/channels*"], "browser_specific_settings": {"gecko": {"id": "yt-bell-list@janevik.net", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/feed/channels*"], "js": ["yt-bell-list.js"], "run_at": "document_idle"}]}