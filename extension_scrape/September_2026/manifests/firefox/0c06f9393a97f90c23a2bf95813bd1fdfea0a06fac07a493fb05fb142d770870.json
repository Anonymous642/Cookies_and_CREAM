{"manifest_version": 3, "name": "Web Clipper \u2014 Dijital Beyniniz", "short_name": "Web Clipper", "version": "2.1.0", "description": "Se\u00e7ili metni, makaleleri, ba\u011flant\u0131lar\u0131, g\u00f6rselleri ve ekran g\u00f6r\u00fcnt\u00fclerini tek t\u0131kla Web Clipper k\u00fct\u00fcphanenize kaydedin.", "permissions": ["activeTab", "scripting", "contextMenus", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["config.js", "lib/client.js", "lib/page-scripts.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Web Clipper", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Web Clipper penceresini a\u00e7"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Se\u00e7imi (yoksa sayfay\u0131) hemen kaydet"}, "take-screenshot": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Alan se\u00e7erek ekran g\u00f6r\u00fcnt\u00fcs\u00fc kaydet"}}, "browser_specific_settings": {"gecko": {"id": "web-clipper@cekyc.projects", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}