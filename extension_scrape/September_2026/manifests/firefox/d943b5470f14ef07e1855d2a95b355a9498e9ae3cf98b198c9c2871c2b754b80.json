{"manifest_version": 3, "name": "Shotko - Screenshot & Annotate", "version": "1.1.0", "description": "Capture, annotate, and share screenshots instantly. Built for developers by LXB Studio.", "browser_specific_settings": {"gecko": {"id": "shotko@lxb-studio.com", "strict_min_version": "112.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "tabs", "storage", "scripting", "contextMenus"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["editor.html", "editor.js", "browser-polyfill.js", "icons/*"], "matches": ["<all_urls>"]}], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Capture visible area"}, "capture-full": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Capture full page"}}}