{"manifest_version": 3, "name": "Zblocker", "version": "1", "description": "Auto-skips YouTube video ads with a On/Off control toggle and smart page refreshes.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-ad-shield@yourlocaldomain.local", "data_collection_permissions": {"required": ["none"]}}}}