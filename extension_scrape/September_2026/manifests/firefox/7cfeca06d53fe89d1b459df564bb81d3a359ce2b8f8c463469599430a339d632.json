{"manifest_version": 3, "name": "Open it Up!", "description": "Automatically Open URLs from a List", "version": "0.0.9", "minimum_chrome_version": "120", "icons": {"16": "logo/icon16.png", "32": "logo/icon32.png", "48": "logo/icon48.png", "128": "logo/icon128.png"}, "options_page": "settings/settings.html", "action": {"default_title": "Open it Up!", "default_popup": "popup/popup.html"}, "permissions": ["activeTab", "contextMenus", "scripting", "downloads", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "css": ["closebutton/closebuttonmain.css"], "js": ["foreground_mainframe.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker.js", "scripts": ["./settings/common-utils.js", "InjectedScripts.js", "service-worker.js"]}, "web_accessible_resources": [{"resources": ["closebutton/*", "help/*", "popup/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "fillit.upextension@gmail.com", "strict_min_version": "136.0", "data_collection_permissions": {"required": ["none"]}}}}