{"manifest_version": 3, "name": "Thomacky live", "description": "Envoie une notification quand Thomacky passe en live sur Twitch.", "version": "1.1.1", "permissions": ["alarms", "notifications", "storage", "windows"], "host_permissions": ["https://gql.twitch.tv/*", "https://www.twitch.tv/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "thomacky-live@thomacky.local", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Thomacky live", "default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}}