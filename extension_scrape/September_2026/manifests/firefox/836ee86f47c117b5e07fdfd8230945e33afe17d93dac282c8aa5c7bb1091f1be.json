{"manifest_version": 3, "name": "FC Bayern Unspoiler", "version": "1.0", "description": "Hides match scores on the FC Bayern matchplan page to avoid spoilers. Toggle with the button.", "browser_specific_settings": {"gecko": {"id": "fcb-unspoiler@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://fcbayern.com/*/match-center/matchplan*", "*://app.fcbayern.com/*/match-center/matchplan*"], "js": ["content.js"], "run_at": "document_end"}]}