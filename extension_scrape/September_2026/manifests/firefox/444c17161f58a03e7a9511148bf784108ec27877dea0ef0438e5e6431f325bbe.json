{"manifest_version": 3, "short_name": "Batch Downloader", "name": "Batch Downloader for Instagram", "description": "Batch download high resolution images, videos, reels, stories, and highlights with on-the-fly format conversion.", "version": "3.0.0", "author": "RandomSasquatch", "permissions": ["storage", "contextMenus", "downloads"], "host_permissions": ["https://*.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://*.instagram.com/*"], "js": ["content_scripts.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*", "lib/*"], "matches": ["https://*.instagram.com/*"]}], "action": {"default_title": "Open Settings & Dashboard", "default_icon": {"16": "assets/img_16.png", "32": "assets/img_32.png", "64": "assets/img_64.png"}}, "options_ui": {"page": "dashboard.html", "open_in_tab": true, "browser_style": false}, "commands": {"download_selected": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Download selected Instagram media"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "icons": {"16": "assets/img_16.png", "20": "assets/img_20.png", "24": "assets/img_24.png", "32": "assets/img_32.png", "48": "assets/img_48.png", "64": "assets/img_64.png", "128": "assets/img_128.png", "256": "assets/img_256.png", "512": "assets/img_512.png"}, "browser_specific_settings": {"gecko": {"id": "batch_downloader_instagram@randomsasquatch.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}