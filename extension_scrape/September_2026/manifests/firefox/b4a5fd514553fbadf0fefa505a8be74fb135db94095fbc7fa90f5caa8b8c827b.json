{"manifest_version": 3, "name": "PDF Dark Mode Eye Care", "version": "1.0", "description": "An extension to change PDF backgrounds to Black, Gray, or Navy for eye protection.", "browser_specific_settings": {"gecko": {"id": "pdf-dark-mode@0fplanet.blogspot.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["dark-pdf.css"], "run_at": "document_end"}]}