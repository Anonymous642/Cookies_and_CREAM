{"manifest_version": 3, "name": "Tabs By Time", "version": "1.0", "description": "Quickly find your most recently used browser tabs and easily close tabs you don't need.", "permissions": ["tabs", "storage"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Tabs By Time", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Toggle Tabs By Time extension ON/OFF"}}, "browser_specific_settings": {"gecko": {"id": "tabsbytime@example.com", "strict_min_version": "109.0"}}}