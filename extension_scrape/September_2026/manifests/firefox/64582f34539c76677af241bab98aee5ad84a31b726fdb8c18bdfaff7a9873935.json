{"manifest_version": 2, "name": "YouTube Shorts Remover", "version": "1.0.0", "description": "Removes YouTube Shorts from everywhere on YouTube", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-shorts-remover@extension.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://www.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Shorts Remover"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "developer": {"name": "YouTube Shorts Remover Team"}, "homepage_url": "https://github.com/yourusername/youtube-shorts-remover"}