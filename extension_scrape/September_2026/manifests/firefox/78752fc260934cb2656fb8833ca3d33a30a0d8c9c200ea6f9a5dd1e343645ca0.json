{"manifest_version": 2, "name": "Site Icon Switcher", "version": "1.2.0", "description": "Replace a target website's favicon with a custom remote URL or local file.", "icons": {"48": "icons/site-icon-switcher.svg", "96": "icons/site-icon-switcher.svg"}, "permissions": ["storage", "tabs", "<all_urls>"], "browser_action": {"default_title": "Site Icon Switcher", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/site-icon-switcher.svg", "96": "icons/site-icon-switcher.svg"}}, "options_ui": {"page": "popup/popup.html", "open_in_tab": true, "browser_style": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "site-icon-switcher@example.local", "data_collection_permissions": {"required": ["none"]}}}}