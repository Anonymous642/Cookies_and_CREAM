{"manifest_version": 2, "name": "Microphone Guard", "version": "1.3", "description": "Detects and alerts users when websites attempt to access their microphone.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["notifications", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Microphone Guard", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "@Microphone-Guard", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}