{"manifest_version": 2, "name": "Manga Downloader", "description": "Download manga, manhwa, and webtoon pages as a ZIP.", "version": "1.0.7", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage", "http://*/*", "https://*/*"], "optional_permissions": ["webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "manga-downloader@scan-translator.com", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Manga Downloader", "default_popup": "popup.html"}, "content_scripts": []}