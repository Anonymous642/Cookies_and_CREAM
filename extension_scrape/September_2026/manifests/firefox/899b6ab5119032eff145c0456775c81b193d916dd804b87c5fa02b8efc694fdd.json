{"manifest_version": 2, "name": "YouTube Deeplink Auto-Updater", "version": "1.0", "description": "Automatically updates YouTube bookmarks with the current timestamp when a video is paused.", "incognito": "spanning", "permissions": ["tabs", "bookmarks"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "{3d9a9b6f-f94e-47fb-b1bc-a16c85483b8a}"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle"}]}