{"manifest_version": 3, "name": "BitChute Volume Scroller", "version": "1.4", "description": "Scroll over BitChute videos to change volume with a visual indicator.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "default_title": "BitChute Volume Scroller"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "bitchute-vol-scroll-v2@yourname.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.bitchute.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_end"}]}