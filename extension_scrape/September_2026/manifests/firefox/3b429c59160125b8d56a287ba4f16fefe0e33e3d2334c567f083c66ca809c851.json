{"manifest_version": 3, "name": "My Web Shortcuts", "description": "Create keyboard shortcuts to click on elements in websites and navigate/operate faster", "version": "2.2.5", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage", "tabs", "notifications", "alarms"], "browser_specific_settings": {"gecko": {"id": "mywebshortcuts@browsergadgets.io", "strict_min_version": "109.0"}}, "web_accessible_resources": [{"resources": ["content-scripts/elementSelector.css", "content-scripts/shortcutWorker.css", "css/*", "fonts/*"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"], "persistent": false}, "commands": {"turnOnSelector": {"description": "Start selection in the active tab", "suggested_key": {"default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space"}}}, "externally_connectable": {"matches": ["*://browsergadgets.io/*"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/shortcutWorker.js"]}], "action": {"default_popup": "popup.html", "default_title": "My Web Shortcuts"}}