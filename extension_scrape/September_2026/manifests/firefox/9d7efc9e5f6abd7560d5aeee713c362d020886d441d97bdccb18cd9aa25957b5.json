{"manifest_version": 3, "name": "Plainsight: Dyslexia Font & Reading Ruler", "short_name": "Plainsight", "version": "1.0.0", "description": "Reading tools for dyslexia, ADHD, low vision, migraine and visual stress. Fonts, spacing, tints, rulers, reader mode and read-aloud. Free, no account.", "author": "Plainsight", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Plainsight \u2014 reading tools", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "options_page": "src/options/options.html", "background": {"scripts": ["src/background.js"]}, "permissions": ["storage", "scripting", "activeTab", "contextMenus"], "optional_host_permissions": ["https://api.dictionaryapi.dev/*"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://chromewebstore.google.com/*", "https://chrome.google.com/webstore/*"], "js": ["src/shared/api.js", "src/shared/defaults.js", "src/shared/presets.js", "src/content/engine.js", "src/content/overlays.js", "src/content/textwalk.js", "src/content/reader.js", "src/content/speech.js", "src/content/dictionary.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["assets/fonts/*.woff2", "assets/icons/*.png", "assets/icons/*.svg"], "matches": ["<all_urls>"]}], "commands": {"toggle-plainsight": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Turn Plainsight on or off"}, "toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Turn the reading ruler on or off"}, "toggle-reader": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open or close reader mode"}, "read-aloud": {"suggested_key": {"default": "Alt+Shift