{"manifest_version": 3, "name": "Yandex Mail Checker", "version": "1.0.0", "description": "Check your Yandex Mail inbox directly from your browser", "permissions": ["cookies"], "host_permissions": ["https://mail.yandex.com/*", "https://mail.yandex.ru/*", "https://mail.yandex-team.ru/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "yandexmailchecker@myextension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}