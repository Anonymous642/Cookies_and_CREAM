{"manifest_version": 3, "name": "SPRL Link Shortener", "version": "1.1.0", "description": "Easy Link Shortener with advance tracking", "icons": {"16": "img/sprlicon16.png", "32": "img/sprlicon32.png", "64": "img/sprlicon64.png", "128": "img/sprlicon128.png"}, "action": {"default_title": "Short Link with SPRL", "default_popup": "popup.html"}, "background": {"scripts": ["js/background.js"]}, "permissions": ["storage", "scripting", "contextMenus", "activeTab"], "host_permissions": ["https://insprl.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "contact@insprl.com", "data_collection_permissions": {"required": ["none"]}}}}