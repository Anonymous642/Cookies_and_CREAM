{"manifest_version": 3, "name": "Env Switcher", "version": "1.0.0", "description": "Instantly switch between Dev, UAT, Staging & Prod environments while preserving the current page path.", "browser_specific_settings": {"gecko": {"id": "env-switcher@ravipatel.addons", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "tabs", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Env Switcher"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Env Switcher popup"}}}