{"manifest_version": 3, "name": "Kortex - Spatial Workspace & Tab Manager", "short_name": "Kortex", "version": "3.4.0", "description": "Transform your browser clutter into a mapped knowledge graph. Kortex is a local-first spatial workspace that lets you drag, drop, and visually connect open tabs on an infinite 2D canvas. Fast, private, and powerful.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications", "sidePanel", "activeTab", "bookmarks", "identity"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Kortex Workspace"}, "chrome_url_overrides": {"newtab": "index.html"}, "background": {"type": "module", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "kortex@dockmira.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["index.html", "*"], "matches": ["<all_urls>"]}]}