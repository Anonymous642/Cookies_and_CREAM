{"manifest_version": 2, "name": "Reddit Feed Blocker", "version": "1.0", "description": "Redirects reddit feed urls to a blocked page.", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage"], "background": {"scripts": ["blocker.js"]}, "web_accessible_resources": ["blocked.html"], "browser_specific_settings": {"gecko": {"id": "firefoxredditblocker@sains", "data_collection_permissions": {"required": ["none"], "collects_website_data": false, "collects_error_data": false, "collects_interaction_data": false}}}}