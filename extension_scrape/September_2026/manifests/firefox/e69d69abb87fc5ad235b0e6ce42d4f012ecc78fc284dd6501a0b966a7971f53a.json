{"manifest_version": 3, "name": "Sober Start Page - Time & Weather & Bookmarks", "version": "1.0.2", "icons": {"128": "favicon.svg"}, "description": "Replaces the new tab with a start page showing time, date, weather and bookmarks.", "browser_specific_settings": {"gecko": {"id": "SoberStartPage@gm-software.de", "data_collection_permissions": {"required": ["bookmarksInfo"], "optional": ["locationInfo"]}}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["main.js"]}, "permissions": ["bookmarks", "storage", "webRequest"], "optional_permissions": ["geolocation"], "host_permissions": ["https://t2.gstatic.com/*", "https://api.open-meteo.com/*", "https://ipapi.co/*", "https://ipinfo.io/*", "http://ip-api.com/*"]}