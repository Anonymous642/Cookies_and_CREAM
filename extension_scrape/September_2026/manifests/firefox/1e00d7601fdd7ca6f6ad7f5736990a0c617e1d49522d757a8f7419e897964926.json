{"manifest_version": 3, "name": "Abstractor", "version": "0.2.0", "description": "Unify and abstract web page appearance with customizable fonts, colors, and content removal options for distraction-free reading", "homepage_url": "https://github.com/pediRAM/FirefoxAddOnAbstractor", "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "pedram.ganjeh.hadidi@gmail.com", "strict_min_version": "123.0"}}, "icons": {"22": "icons/icon22.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "action": {"default_title": "Abstractor", "default_popup": "popup/popup.html", "default_icon": {"22": "icons/icon22.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["abstractor.js"], "run_at": "document_idle"}]}