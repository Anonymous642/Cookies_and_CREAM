{"manifest_version": 3, "name": "referraldrop", "short_name": "referraldrop", "version": "0.3.0", "description": "Find referral codes and rewards on referraldrop. When you visit a site that has referral codes available, a small badge appears on the toolbar icon; open it to see the codes.", "browser_specific_settings": {"gecko": {"id": "referraldrop@referraldrop.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "referraldrop", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage"], "host_permissions": ["https://referraldrop.com/*"], "background": {"scripts": ["background.js"]}}