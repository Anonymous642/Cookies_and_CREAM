{"manifest_version": 3, "name": "Shortcuts", "version": "1.1.0", "description": "Create shortcuts for any website", "icons": {"48": "icon.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["shortcuts.js"]}], "web_accessible_resources": [{"resources": ["shortcut-creator.html", "shortcut-creator.css", "shortcut-creator.js"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}}, "pick_element": {"suggested_key": {"default": "Alt+Q"}, "description": "Select an element to create a shortcut for"}}, "browser_specific_settings": {"gecko": {"id": "browser_shortcuts_manager@tonystr.net", "data_collection_permissions": {"required": ["none"]}}}}