{"manifest_version": 3, "name": "Wizard Application Password Vault", "description": "Autofill and manage your Wizard Application password vault. Zero-knowledge: secrets are decrypted only on your device.", "version": "1.0.0", "short_name": "Wizard App Vault", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "activeTab", "scripting"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "password-vault@wizardapplication.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Wizard Password Vault", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}