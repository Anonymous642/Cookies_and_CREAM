{"manifest_version": 2, "name": "TL;DR Summarizer", "version": "1.4.3", "description": "Get the gist of long reads instantly. This extension extracts a page's main text and ranks its sentences with a local TextRank model to surface the 3\u20135 most important ones, then lets you copy them.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{94c73adb-8c05-4e11-8762-2c2529ccdfbb}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "TL;DR Summarizer", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}