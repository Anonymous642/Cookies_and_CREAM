{"manifest_version": 3, "name": "HolmesHunt", "description": "Natural language search for YouTube videos with advanced filtering", "version": "1.0.0", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://www.youtube.com/*", "https://huggingface.co/*", "https://translate.googleapis.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "HolmesHunt - Natural Language YouTube Search"}, "commands": {"open-search": {"suggested_key": {"default": "Alt+H"}, "description": "Open HolmesHunt search"}, "bookmark-current": {"suggested_key": {"default": "Alt+B"}, "description": "Bookmark current page"}, "block-current": {"suggested_key": {"default": "Alt+L"}, "description": "Block current channel"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["assets/*", "chunks/*"], "matches": ["https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "holmeshunt@app.gmail.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}}