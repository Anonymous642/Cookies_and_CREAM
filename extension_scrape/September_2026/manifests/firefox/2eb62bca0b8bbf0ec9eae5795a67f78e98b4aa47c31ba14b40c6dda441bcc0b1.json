{"manifest_version": 2, "name": "Undiscord", "description": "Bulk leave Discord servers", "version": "1.0.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "*://discord.com/*", "*://*.discord.com/*"], "browser_specific_settings": {"gecko": {"id": "undiscord@local", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Undiscord", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://discord.com/*"], "js": ["content-scripts/content.js"]}]}