{"manifest_version": 2, "name": "@capchur/extension", "description": "Capchur browser workflow recorder", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "alarms", "identity", "scripting", "storage", "https://capchur.io/*"], "optional_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "capchur@bizleader.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Capchur recording controls", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "js": ["content-scripts/content.js"]}]}