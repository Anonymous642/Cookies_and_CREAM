{"manifest_version": 2, "name": "Wordbank", "version": "1.0", "description": "Collect new words from context menus and review them in a popup.", "permissions": ["contextMenus", "storage", "activeTab"], "background": {"scripts": ["vault/context.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "anhdungvo332@gmail.com", "data_collection_permissions": {"required": ["none"], "description": "Wordbank collects no data. All vocabulary entries remain in your local storage."}}}, "browser_action": {"default_popup": "collector/popup.html", "default_title": "Wordbank", "default_icon": {"16": "icons/word-collect-16.png", "48": "icons/word-collect-48.png", "128": "icons/word-collect-128.png"}}, "icons": {"16": "icons/word-collect-16.png", "48": "icons/word-collect-48.png", "128": "icons/word-collect-128.png"}}