{"manifest_version": 3, "name": "Wordle Helper", "version": "3.4", "description": "Check whether a Wordle guess has appeared before and track possible answers.", "background": {"scripts": ["src/core.js", "src/data-service.js", "src/background.js"]}, "action": {"default_popup": "popup.html"}, "permissions": ["storage"], "host_permissions": ["https://raw.githubusercontent.com/*"], "content_scripts": [{"matches": ["https://www.nytimes.com/games/wordle/*", "https://www.nytimes.com/games/create/wordle/*"], "js": ["src/core.js", "src/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "wordle-helper@nmpraveen", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}