{"author": "Joshias", "manifest_version": 2, "name": "Erea Dictionary", "version": "1.1.0", "description": "View definitions easily as you browse the web. Double-click any word to view its definition in a small pop-up bubble.", "icons": {"48": "icons/Erea-Dictionary-48.png", "64": "icons/Erea-Dictionary-64.png", "96": "icons/Erea-Dictionary-96.png", "128": "icons/Erea-Dictionary-128.png"}, "browser_action": {"default_title": "Erea Dictionary", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/Erea-Dictionary-48.png", "64": "icons/Erea-Dictionary-64.png", "96": "icons/Erea-Dictionary-96.png", "128": "icons/Erea-Dictionary-128.png"}}, "options_ui": {"page": "options/options.html", "browser_style": false, "chrome_style": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["common/browser-polyfill.js", "content_scripts/dictionary.js"]}], "background": {"scripts": ["common/browser-polyfill.js", "background/background.js"], "persistent": false}, "permissions": ["storage", "https://en.wiktionary.org/*", "https://fr.wiktionary.org/*", "https://de.wiktionary.org/*", "https://es.wiktionary.org/*"], "browser_specific_settings": {"gecko": {"id": "@erea-dictionary.joshias", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}