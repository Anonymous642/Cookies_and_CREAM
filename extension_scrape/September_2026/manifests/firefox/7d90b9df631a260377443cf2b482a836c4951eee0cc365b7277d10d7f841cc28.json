{"manifest_version": 3, "name": "Porchia", "version": "0.3.0", "description": "Warns on fake (phishing) websites and pauses online purchases so a trusted family member can review them.", "permissions": ["storage", "tabs", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Porchia"}, "icons": {"128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "porchia@porchia.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["financialAndPaymentInfo", "personallyIdentifyingInfo", "websiteContent", "browsingActivity"]}}}}