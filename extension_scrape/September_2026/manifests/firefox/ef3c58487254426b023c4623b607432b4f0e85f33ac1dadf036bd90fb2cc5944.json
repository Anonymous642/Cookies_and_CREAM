{"manifest_version": 2, "name": "Github Whitespace Disabler", "version": "1.1.0", "description": "Force Github to open diff pages without whitespace changes displayed", "icons": {"48": "icons/github-48.png", "64": "icons/github-64.png"}, "background": {"scripts": ["interceptor.js"]}, "content_scripts": [{"matches": ["*://github.com/*/*/pull/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["webRequest", "webRequestBlocking", "*://github.com/*/*/pull/*/files", "*://github.com/*/*/pull/*/changes"], "applications": {"gecko": {"id": "maksimovic@outlook.com"}}, "author": "Oliver Maksimovic", "developer": {"name": "Mukul Murthy", "url": "https://github.com/mukulmurthy"}}