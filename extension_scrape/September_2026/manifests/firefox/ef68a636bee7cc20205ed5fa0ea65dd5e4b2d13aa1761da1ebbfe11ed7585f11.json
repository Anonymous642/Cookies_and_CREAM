{"description": "Firefox addon to redirect the shorts to the classical YouTube format.", "manifest_version": 3, "name": "Youtube Short Redirection", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "youtube-short-redirection@matthieuDev.com"}}, "permissions": ["webRequest", "webRequestBlocking", "webNavigation", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_icon": {"16": "icons/no-short-16.png", "32": "icons/no-short-32.png"}, "default_title": "There is no shorts, only vertical videos.", "theme_icons": [{"light": "icons/no-short-16.png", "dark": "icons/no-short-16-dark.png", "size": 16}, {"light": "icons/no-short-32.png", "dark": "icons/no-short-16-dark.png", "size": 32}]}, "background": {"scripts": ["scripts/background.js"]}}