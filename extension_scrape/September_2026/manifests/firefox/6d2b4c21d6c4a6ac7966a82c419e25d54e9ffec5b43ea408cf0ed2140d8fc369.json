{"manifest_version": 2, "name": "TabPort", "description": "Send the current tab to any browser installed on this computer", "version": "0.0.2", "permissions": ["nativeMessaging", "tabs", "contextMenus", "storage"], "browser_specific_settings": {"gecko": {"id": "tabport@tabport.app", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open TabPort"}, "quick-slot-1": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "TabPort: send to quick slot 1"}, "quick-slot-2": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "TabPort: send to quick slot 2"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "TabPort", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}}