{"manifest_version": 3, "name": "Deja El Roblox", "version": "1.0.1", "description": "Bloquea autom\u00e1ticamente el acceso a roblox.com y cualquier subdominio, mostr\u00e1ndote una p\u00e1gina personalizada.", "author": "Antigravity", "key": "", "browser_specific_settings": {"gecko": {"id": "deja-el-roblox@antigravity.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Deja El Roblox - Escudo Activo", "default_popup": "popup.html"}, "permissions": ["declarativeNetRequest", "storage", "tabs", "webNavigation", "webRequest", "webRequestBlocking"], "host_permissions": ["*://*.roblox.com/*", "*://roblox.com/*", "<all_urls>"], "content_scripts": [{"matches": ["*://*.roblox.com/*", "*://roblox.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_roblox", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["blocked.html", "styles.css", "blocked.js", "popup.html", "popup.css", "popup.js", "content.js", "icons/*"], "matches": ["*://*.roblox.com/*", "*://roblox.com/*", "<all_urls>"]}]}