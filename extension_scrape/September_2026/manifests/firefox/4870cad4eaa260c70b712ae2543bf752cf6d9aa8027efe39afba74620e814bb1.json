{"manifest_version": 3, "name": "PassHex", "version": "1.0.0", "description": "Auto-fill passwords from your PassHex vault", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "PassHex"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "passhex@rogerstech", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}}}