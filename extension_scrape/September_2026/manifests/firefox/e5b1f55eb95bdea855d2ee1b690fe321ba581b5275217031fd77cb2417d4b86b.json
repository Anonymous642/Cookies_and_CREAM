{"manifest_version": 3, "default_locale": "en", "name": "FocusGuard - Smart Procrastination Blocker", "version": "1.0.0", "description": "AI-powered procrastination blocker that tracks screen time and gently redirects you back to productive work.", "permissions": ["storage", "declarativeNetRequest", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "service-worker-loader.js", "scripts": ["service-worker-loader.js"], "type": "module"}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "src/options/index.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "focusguard@tere-webdesign", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}