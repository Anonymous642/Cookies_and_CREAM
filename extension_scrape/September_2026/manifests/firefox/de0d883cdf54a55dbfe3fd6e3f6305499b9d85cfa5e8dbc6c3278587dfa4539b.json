{"manifest_version": 2, "name": "copy-url", "description": "A simple extension to copy the current tab URL", "version": "0.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "clipboardWrite", "storage"], "browser_specific_settings": {"gecko": {"id": "copy-url@pruizlezcano", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}