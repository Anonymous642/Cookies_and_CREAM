{"manifest_version": 2, "name": "Liddi for LinkedIn", "version": "1.0.1", "description": "Sincronizza e analizza i tuoi post con Liddi. Tieni traccia di like, commenti e impression direttamente dalla dashboard.", "browser_specific_settings": {"gecko": {"id": "liddi@liddi.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "permissions": ["activeTab", "tabs", "https://www.linkedin.com/*", "https://it.linkedin.com/*"], "content_scripts": [{"matches": ["https://www.linkedin.com/*", "https://it.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}