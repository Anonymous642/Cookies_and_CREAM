{"manifest_version": 3, "name": "TabSavior", "description": "Save all open tabs from all windows into templated bookmark folders, reliably.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["bookmarks", "tabs", "windows", "storage"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "TabSavior", "default_popup": "popup.html"}, "commands": {"save-all-windows": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Save all windows"}, "open-session-list": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Open session list"}}, "browser_specific_settings": {"gecko": {"id": "{bbb8020d-288f-4d3f-8fbe-e0793a4568e0}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}