{"manifest_version": 2, "name": "PhobiaShield", "browser_specific_settings": {"gecko": {"id": "hemophobia-filter@wilhelm.no", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "version": "6.6", "description": "Automatically replaces triggering words based on customizable phobia profiles. Supports 12 languages, custom phobias, themes, and import/export.", "permissions": ["activeTab", "storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "PhobiaShield"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}