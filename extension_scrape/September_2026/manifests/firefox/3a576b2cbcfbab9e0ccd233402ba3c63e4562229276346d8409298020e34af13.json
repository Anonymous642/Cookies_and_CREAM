{"manifest_version": 3, "name": "Rainwave automation", "description": "Adds automation features, auto voting and requests, to rainwave.cc", "version": "1.4.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png"}, "web_accessible_resources": [{"resources": ["main-world.js"], "matches": ["https://rainwave.cc/*"]}], "permissions": ["cookies", "storage"], "host_permissions": ["https://rainwave.cc/*"], "browser_specific_settings": {"gecko": {"id": "@rainwave-automation", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": {"16": "/icons/16.png", "32": "/icons/32.png", "64": "/icons/64.png", "128": "/icons/128.png"}, "default_title": "Rainwave automation options", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://rainwave.cc/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}