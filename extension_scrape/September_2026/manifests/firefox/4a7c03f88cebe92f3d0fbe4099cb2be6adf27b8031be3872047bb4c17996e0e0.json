{"manifest_version": 3, "name": "EidonCore", "short_name": "EidonCore", "version": "1.0.0", "description": "Turn emails and web pages into EidonCore tasks and tickets, with privacy controls. Reads only what you choose to send.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "identity", "activeTab", "contextMenus"], "host_permissions": ["https://mail.google.com/*"], "optional_host_permissions": ["https://*/*"], "action": {"default_popup": "src/popup.html", "default_title": "EidonCore"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content-gmail.js"], "css": ["src/content-gmail.css"], "run_at": "document_idle"}], "commands": {"quick-capture": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Capture this page or the open email"}}, "background": {"scripts": ["src/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@eidoncore.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications", "personallyIdentifyingInfo", "websiteContent", "browsingActivity"], "optional": []}}}}