{"manifest_version": 2, "name": "YouTube Shorts Blocker", "description": "Blocks YouTube Shorts and other short-form video content across YouTube.", "version": "1.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "*://*.youtube.com/*"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"], "css": ["content/blocker.css"], "run_at": "document_start", "all_frames": true}], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "YouTube Shorts Blocker", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}, "id": "{ad57679c-403a-413d-9a75-10323734bdfe}"}}, "author": "Mourya <mannumourya@yahoo.com>", "developer": {"name": "Mourya", "url": "mailto:mannumourya@yahoo.com"}}