{"manifest_version": 3, "name": "Tabyrinth", "version": "2.0.1", "description": "Navigate your tabs with ease \u2014 find recent tabs and sort tab groups", "browser_specific_settings": {"gecko": {"id": "tabyrinth@tabyrinth.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabGroups", "contextualIdentities", "cookies", "storage", "contextMenus"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Tabyrinth"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Tabyrinth", "default_icon": "icons/icon16.png", "open_at_install": false}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T"}, "description": "Open Tabyrinth popup"}, "toggle-sidebar": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Toggle Tabyrinth sidebar"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}