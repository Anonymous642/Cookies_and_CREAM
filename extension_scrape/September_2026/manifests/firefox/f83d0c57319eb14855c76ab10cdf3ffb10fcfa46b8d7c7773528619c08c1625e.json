{"manifest_version": 2, "name": "GlideMarks", "version": "1.0.0", "description": "Swipe, save, and manage bookmarks fast.", "browser_specific_settings": {"gecko": {"id": "glidemarks@example.com", "strict_min_version": "102.0"}}, "icons": {"48": "icons/glidemarks-48.png", "128": "icons/glidemarks-128.png"}, "permissions": ["bookmarks", "storage", "activeTab", "tabs"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "GlideMarks", "default_popup": "popup.html", "default_icon": {"48": "icons/glidemarks-48.png", "128": "icons/glidemarks-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-save": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle bookmark for the current page (save if missing, remove if present)"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}