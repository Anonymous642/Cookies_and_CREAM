{"manifest_version": 2, "name": "Privora", "version": "2.0", "description": "Complete session isolation for each browser tab using advanced techniques.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-192.png", "128": "icons/icon-512.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Advanced Session Isolator"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["storage", "tabs", "browsingData", "activeTab", "<all_urls>"], "web_accessible_resources": ["content.js"], "browser_specific_settings": {"gecko": {"id": "session-isolator@example.com", "strict_min_version": "58.0"}}}