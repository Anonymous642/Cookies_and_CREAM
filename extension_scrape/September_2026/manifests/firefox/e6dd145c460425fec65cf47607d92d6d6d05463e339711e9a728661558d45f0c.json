{"name": "Clip To Workflowy", "version": "3.1.4", "description": "Bookmark websites in Workflowy", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "clipper@workflowy.com", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "action": {"default_icon": "icons/icon-128.png", "default_title": "Clip To Workflowy", "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["chrome_shim.js", "background.js"]}, "permissions": ["activeTab", "tabs", "storage", "scripting", "menus", "clipboardRead", "alarms"], "host_permissions": ["https://workflowy.com/*", "https://*.workflowy.com/*"], "content_scripts": [{"matches": ["https://workflowy.com/*", "https://*.workflowy.com/*"], "js": ["chrome_shim.js", "cursor_tracker.js"], "run_at": "document_idle"}, {"matches": ["https://workflowy.com/api-key/*", "https://workflowy.com/api-key"], "js": ["chrome_shim.js", "token_sniffer.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["cursor_tracker_main.js"], "matches": ["https://workflowy.com/*", "https://*.workflowy.com/*"]}], "options_ui": {"page": "popup.html", "open_in_tab": true}, "commands": {"1-default-destination": {"description": "Clip to default destination", "suggested_key": {"default": "Alt+Shift+D"}}, "2-clip-cursor": {"description": "Clip to cursor (API)", "suggested_key": {"default": "Alt+C"}}, "3-clip-clipboard": {"description": "Clip to clipboard (OPML)", "suggested_key": {"default": "Alt+Shift+C"}}, "4-repeat-last": {"description": "Repeat last clip action", "suggested_key": {"default": "Alt+Shift+R"}}, "5-arrange-browser-split": {"description": "Side-by-side Browser Tabs", "suggested_key": {"default": "Alt+Shift+T"}}, "6-arrange-windows": {"description": "Side-by-side Windows", "suggested_key": {"default": "Alt+Shift+W"}}}}