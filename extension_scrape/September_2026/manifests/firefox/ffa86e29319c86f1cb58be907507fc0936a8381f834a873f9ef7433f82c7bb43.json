{"manifest_version": 3, "name": "Reddit Thread Collector FAST", "version": "1.1.0", "description": "Collect the current Reddit post and accessible comments into a clean text file, using parallel requests for speed.", "permissions": ["activeTab"], "host_permissions": ["https://www.reddit.com/*", "https://reddit.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Collect this Reddit thread", "default_area": "navbar"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://reddit.com/*"], "js": ["collector.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "reddit-thread-collector-fast@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}