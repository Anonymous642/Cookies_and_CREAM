{"manifest_version": 3, "name": "Unscroll YouTube", "description": "Remove reels and recommended videos from YouTube.", "version": "1.2", "icons": {"48": "icons/scroll.png"}, "permissions": ["storage"], "content_scripts": [{"js": ["unscroll.js"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.youtu.be/*", "https://youtu.be/*", "https://m.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "@unscroll_youtube", "data_collection_permissions": {"required": ["none"]}}}}