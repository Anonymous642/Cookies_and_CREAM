{"manifest_version": 2, "name": "Nightfall Dark Mode", "version": "3.8", "description": "Give every website a beautiful dark theme. Nightfall darkens pages across the web with adjustable brightness and contrast, a one-tap per-site switch, and an automatic sunset-to-sunrise night mode.", "icons": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png", "96": "graphics/icon-96.png", "128": "graphics/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{628f7441-15cb-44a1-9d75-ffeafeb05273}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["app/dm-core.js", "app/darkmode.js"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_title": "Nightfall Dark Mode", "default_popup": "app/popup.html", "default_icon": {"32": "graphics/icon-32.png", "48": "graphics/icon-48.png", "64": "graphics/icon-64.png"}}}