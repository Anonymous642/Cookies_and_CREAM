{"manifest_version": 2, "name": "Tab Rotator", "version": "1.0", "description": "Automatically rotates through tabs.", "browser_action": {"default_popup": "popup.html", "default_icon": "icon48.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-rotator@example.com", "strict_min_version": "60.0"}}}