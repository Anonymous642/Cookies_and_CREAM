{"manifest_version": 3, "name": "Drum Rudiments Extension", "version": "1.0.3", "description": "A helpful extension for drumrudiments.app. Reminders, tips and tricks for drummers.", "browser_specific_settings": {"gecko": {"id": "no-reply@drumrudiments.app", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage", "notifications", "alarms", "idle"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"service_worker": "src/background/background.js", "scripts": ["src/background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content.js"]}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}