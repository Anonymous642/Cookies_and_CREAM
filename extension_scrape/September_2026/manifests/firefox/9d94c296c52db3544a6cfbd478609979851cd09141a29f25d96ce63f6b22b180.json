{"manifest_version": 3, "name": "Site Time Limit", "version": "1.1.3", "description": "Limits visit time on certain sites. Right-click to add new sites.", "permissions": ["storage", "contextMenus", "scripting", "tabs", "declarativeNetRequest"], "host_permissions": ["*://*.facebook.com/*", "*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.nytimes.com/*", "https://www.amazon.com/gp/video*", "*://*.netflix.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["service_worker.js"]}, "incognito": "spanning", "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.nytimes.com/*", "https://www.amazon.com/gp/video*", "*://*.netflix.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["assets/mascot.png", "blocked.html", "blocked.js"], "matches": ["<all_urls>"]}], "action": {"default_title": "Daily Site Limit", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "site-time-limit@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}