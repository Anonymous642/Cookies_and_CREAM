{"manifest_version": 3, "name": "Kick Quality Enforcer", "version": "1.6", "description": "Locks Kick.com stream quality to a preferred resolution, per stream.", "permissions": ["storage"], "host_permissions": ["https://kick.com/*", "https://player.kick.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Kick Quality Enforcer", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "content_scripts": [{"matches": ["https://kick.com/*", "https://player.kick.com/*"], "js": ["content-settings.js"], "run_at": "document_start"}, {"matches": ["https://kick.com/*", "https://player.kick.com/*"], "js": ["content-main.js"], "run_at": "document_start", "world": "MAIN"}], "browser_specific_settings": {"gecko": {"id": "kick-quality-enforcer@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}