{"name": "FetchHound \u2013 Video & Image Downloader", "description": "A powerful browser extension that helps you easily download media content from web pages.", "version": "1.0.0", "manifest_version": 2, "author": "FlashInTheNight", "homepage_url": "https://github.com/FlashInTheNight/FetchHound", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "downloads", "tabs", "storage", "<all_urls>"], "web_accessible_resources": ["src/popup.html", "src/popup.ts"], "browser_action": {"default_popup": "src/popup.html"}, "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "fetchhound@mediafetch.io", "strict_min_version": "58.0"}}}