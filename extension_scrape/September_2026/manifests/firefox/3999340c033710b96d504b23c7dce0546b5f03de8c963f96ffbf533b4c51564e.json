{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "termlens@termlens.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "name": "TermLens", "version": "0.1.0", "description": "Explain what an agreement means for you in under 30 seconds.", "action": {"default_title": "TermLens", "default_popup": "src/ui/index.html"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["http://localhost:8000/*", "https://api.termlens.app/*"], "background": {"scripts": ["service_worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}]}