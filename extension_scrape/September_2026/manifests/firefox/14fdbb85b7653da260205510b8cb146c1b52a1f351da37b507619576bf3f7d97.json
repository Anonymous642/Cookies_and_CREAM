{"manifest_version": 3, "name": "CEREMA Passwortmanager", "version": "1.0.2", "description": "CEREMA-Passwortmanager-Erweiterung f\u00fcr automatische Anmeldung in Webanwendungen mit Formular-Autofill, Kontoauswahl bei mehreren Zugangsdaten und Unterst\u00fctzung f\u00fcr HTTP Basic Authentication.", "permissions": ["activeTab", "scripting", "storage", "tabs", "webRequest", "webRequestBlocking"], "host_permissions": ["https://*/*"], "web_accessible_resources": [{"resources": ["icons/icon.svg"], "matches": ["https://*/*"]}], "action": {"default_title": "Passwort einf\u00fcgen", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "cerema-passwortmanager@cerema.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}