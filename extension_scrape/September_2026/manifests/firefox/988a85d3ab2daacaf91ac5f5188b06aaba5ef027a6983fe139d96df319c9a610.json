{"manifest_version": 3, "name": "Tab Drawers", "version": "0.5.2", "description": "Organize tabs into switchable drawers \u2014 only the open drawer's tabs are shown, the rest stay tucked away.", "author": "Diar Sabri", "browser_specific_settings": {"gecko": {"id": "tab-drawers@diarsabri", "strict_min_version": "139.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabHide", "storage", "sessions", "menus"], "background": {"scripts": ["src/background/index.js"], "type": "module"}, "action": {"default_title": "Tab Drawers", "default_popup": "src/panel/panel.html", "default_icon": "icons/icon.svg"}, "sidebar_action": {"default_title": "Tab Drawers", "default_panel": "src/panel/panel.html", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "commands": {"next-group": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Switch to next drawer"}, "prev-group": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Switch to previous drawer"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}