{"manifest_version": 2, "name": "StopYTDoomscroll", "version": "1.0", "description": "This extension tries to stop you from doomscrolling yt videos by removing the video suggestions beside the current video.", "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["removeSuggestions.js"]}], "browser_specific_settings": {"gecko": {"id": "stop-youtube-doomscroll@example.com", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}