{"manifest_version": 3, "name": "Scolab \u2014 Estude qualquer coisa na web", "version": "1.3.4", "description": "Selecione qualquer texto na web e gere defini\u00e7\u00f5es, flashcards, resumos e an\u00e1lises com IA. Salve tudo no Scolab.", "browser_specific_settings": {"gecko": {"id": "extension@scolab.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://scolab.ai/*"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Scolab \u2014 Estude qualquer coisa na web"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"description": "Abrir Scolab"}, "open_with_selection": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Estudar texto selecionado com Scolab"}}}