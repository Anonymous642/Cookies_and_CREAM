{"manifest_version": 2, "name": "Fukidashi", "description": "Add comments and notes to any web page", "version": "0.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "fukidashi@thundermiracle.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Fukidashi", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_end", "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"]}