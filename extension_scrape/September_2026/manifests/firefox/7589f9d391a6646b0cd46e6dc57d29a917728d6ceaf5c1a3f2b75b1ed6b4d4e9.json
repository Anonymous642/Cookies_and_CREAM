{"manifest_version": 2, "name": "SoundCloud Overlay Connector", "version": "1.0.0", "description": "Connects SoundCloud to the desktop overlay widget", "permissions": ["activeTab", "tabs", "*://*.sndcdn.com/*"], "content_scripts": [{"matches": ["*://soundcloud.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"32": "icons/icon32.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "soundcloud-overlay@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}