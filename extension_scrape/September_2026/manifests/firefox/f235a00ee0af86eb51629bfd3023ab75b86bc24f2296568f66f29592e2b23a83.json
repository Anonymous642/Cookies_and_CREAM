{"manifest_version": 3, "name": "YoutubeToText: Transcripts and Subtitles", "short_name": "YoutubeToText", "version": "1.0.0", "description": "Transcribe any YouTube video, get SRT and WebVTT subtitles, or burn captions into the video with YoutubeToText.", "homepage_url": "https://youtubetotext.ai/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "YoutubeToText", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab", "contextMenus"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["shared/youtube.js", "content/youtube.js"], "run_at": "document_idle"}, {"matches": ["https://youtubetotext.ai/*"], "js": ["shared/youtube.js", "content/site-handoff.js"], "run_at": "document_start"}], "background": {"scripts": ["shared/youtube.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "browser-extension@youtubetotext.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}