{"manifest_version": 3, "name": "FeedUndo", "version": "1.1.0", "description": "Reopen Reddit posts you just scrolled past.", "permissions": ["storage"], "host_permissions": ["https://*.supabase.co/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.reddit.com/*", "*://sh.reddit.com/*"], "js": ["lib/stage1-core.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "feedundo@feedundo.pages.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}