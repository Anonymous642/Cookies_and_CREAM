{"manifest_version": 2, "name": "Enhancements for Google Voice", "version": "0.5.3", "homepage_url": "https://github.com/Urgo/enhancements-for-google-voice", "description": "Send images Google Voice would reject, drag and drop to attach, and keep your texts and 2FA codes one click away.", "browser_specific_settings": {"gecko": {"id": "enhancements-for-google-voice@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "notifications", "clipboardWrite", "alarms", "https://voice.google.com/*", "https://clients6.google.com/static/proxy.html*"], "background": {"scripts": ["src/codes.js", "src/gv-config.js", "src/background.js"], "persistent": true}, "browser_action": {"default_title": "Enhancements for Google Voice", "default_popup": "src/popup/popup.html", "default_icon": {"32": "icons/32.png", "64": "icons/64.png"}}, "icons": {"32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png"}, "content_scripts": [{"matches": ["https://voice.google.com/*"], "js": ["src/gv-config.js", "src/gv-api.js", "src/content.js", "src/image-resize.js"], "run_at": "document_idle"}, {"matches": ["https://clients6.google.com/static/proxy.html*"], "js": ["src/gv-config.js", "src/gv-api.js", "src/content-proxy.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"copy-latest-code": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Copy the latest verification code"}, "_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+G"}}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}}