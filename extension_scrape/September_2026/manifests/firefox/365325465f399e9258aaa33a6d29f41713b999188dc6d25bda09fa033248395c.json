{"manifest_version": 3, "name": "YouTube Custom Helper", "version": "3.1", "description": "Control speed, quality, volume booster, mouse wheel controls, clean up distractions, auto-theater mode, multi-theme selector, stop background autoplay, capture screenshots, and advanced comment filtering.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-custom-helper@extension.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_area": "navbar"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js", "comnt_filtr.js"], "run_at": "document_idle"}]}