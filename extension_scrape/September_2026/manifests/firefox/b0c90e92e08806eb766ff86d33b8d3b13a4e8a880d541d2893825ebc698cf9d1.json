{"manifest_version": 3, "name": "Credibility Meter", "version": "0.0.1", "description": "Grades the credibility patterns of any web page - A to F - with specific reasons given. Opt-in, local-only, no data collection.", "permissions": ["storage", "activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Credibility Meter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["dist/background.js"]}, "optional_host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "credibility-meter@dominion.solutions", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}