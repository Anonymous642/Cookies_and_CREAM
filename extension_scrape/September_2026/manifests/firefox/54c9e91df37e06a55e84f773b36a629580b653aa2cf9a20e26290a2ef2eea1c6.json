{"manifest_version": 3, "name": "Multi-Language Virtual Keyboard", "version": "1.0.0", "description": "On-screen virtual keyboard addon for Firefox with 25+ language layouts, sound FX, text-to-speech, voice dictation, diacritics, custom themes, Cangjie, Pinyin, and Kanji converter workbench.", "author": "Antigravity AI", "homepage_url": "https://github.com/multilang-virtualkeyboard", "browser_specific_settings": {"gecko": {"id": "virtualkeyboard@multilang.addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Multi-Language Virtual Keyboard", "default_icon": "assets/icons/icon.svg"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["layouts/layouts.js", "engine/keyboard-core.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "scripting", "contextMenus", "downloads"], "host_permissions": ["https://translate.googleapis.com/*", "https://translate.google.com/*", "https://clients5.google.com/*", "https://api.mymemory.translated.net/*"], "commands": {"toggle-keyboard": {"suggested_key": {"default": "Alt+K"}, "description": "Toggle Virtual Keyboard Overlay"}}, "web_accessible_resources": [{"resources": ["content/content.css", "layouts/layouts.js", "engine/keyboard-core.js", "assets/icons/*", "editor/*", "analysis/*"], "matches": ["<all_urls>"]}]}