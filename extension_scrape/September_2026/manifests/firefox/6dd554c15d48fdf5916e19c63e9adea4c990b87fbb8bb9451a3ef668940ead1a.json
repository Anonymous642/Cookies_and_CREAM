{"manifest_version": 3, "name": "GG.deals on Steam Hardened", "version": "1.1.0", "author": "Juzlus and fork contributors", "description": "Displays current and historical GG.deals prices on supported Steam store pages.", "icons": {"128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "ggdeals-on-steam-hardened@local.invalid", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}, "permissions": ["notifications", "storage"], "host_permissions": ["https://store.steampowered.com/*", "https://api.gg.deals/v1/prices/by-steam-app-id/*", "https://api.gg.deals/v1/prices/by-steam-sub-id/*", "https://api.gg.deals/v1/prices/by-steam-bundle-id/*", "https://api.gg.deals/v1/bundles/by-steam-app-id/*", "https://api.gg.deals/v1/bundles/by-steam-sub-id/*", "https://api.gg.deals/v1/bundles/by-steam-bundle-id/*", "https://raw.githubusercontent.com/Juzlus/GG.deals-on-Steam/refs/heads/server/versions.json"], "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/128.png"}}, "options_ui": {"page": "popup.html", "open_in_tab": true}, "background": {"scripts": ["scripts/core.js", "scripts/background.js"]}, "web_accessible_resources": [{"resources": ["icons/128.png"], "matches": ["https://store.steampowered.com/*"]}], "content_scripts": [{"matches": ["https://store.steampowered.com/*"], "js": ["scripts/core.js", "scripts/seasonal-sales.js", "scripts/main.js", "scripts/app.js", "scripts/bundle.js", "scripts/cart.js", "scripts/recommended.js", "scripts/search.js", "scripts/wishlist.js"], "css": ["css/style.css"], "run_at": "document_idle"}]}