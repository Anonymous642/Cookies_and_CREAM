{"manifest_version": 3, "name": "ScAuthor - Journal Submission Tracker", "version": "1.1.2", "description": "Auto-fill journal submissions and track your research publications on ScAuthor.", "permissions": ["storage", "scripting", "alarms"], "host_permissions": ["https://scauthor.com/*", "https://*.scauthor.com/*", "https://*.elsevier.com/*", "https://*.springer.com/*", "https://*.wiley.com/*", "https://*.nature.com/*", "https://*.science.org/*", "https://*.biorxiv.org/*", "https://*.arxiv.org/*", "https://*.jove.com/*", "https://*.tandfonline.com/*"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["https://scauthor.com/*", "https://*.scauthor.com/*"], "js": ["scauthor-marker.js"], "run_at": "document_start"}, {"matches": ["https://*.elsevier.com/*", "https://*.springer.com/*", "https://*.wiley.com/*", "https://*.nature.com/*", "https://*.science.org/*", "https://*.biorxiv.org/*", "https://*.arxiv.org/*", "https://*.jove.com/*", "https://*.tandfonline.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "ScAuthor Journal Tracker", "default_icon": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}}, "icons": {"16": "icons/logo-16.png", "48": "icons/logo-48.png", "128": "icons/logo-128.png"}, "browser_specific_settings": {"gecko": {"id": "journal-tracker@scauthor.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}}