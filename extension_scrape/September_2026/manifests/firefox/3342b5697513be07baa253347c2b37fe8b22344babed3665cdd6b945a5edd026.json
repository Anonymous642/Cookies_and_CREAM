{"name": "Twitch Chat Sounds", "description": "Play a configurable sound when chat wakes up on selected Twitch channels.", "version": "1.1", "manifest_version": 3, "permissions": ["storage", "tabs"], "host_permissions": ["https://www.twitch.tv/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["sound/chat.mp3"], "matches": ["https://www.twitch.tv/*"]}], "browser_specific_settings": {"gecko": {"id": "turbo@twitchchatsounds", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}