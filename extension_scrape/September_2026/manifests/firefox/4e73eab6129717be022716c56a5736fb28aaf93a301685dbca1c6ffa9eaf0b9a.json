{"manifest_version": 3, "name": "Tab Home", "version": "1.0", "description": "Pins the current URL and allows navigating back to it via the extension icon.", "permissions": ["sessions", "menus", "contextMenus", "tabs", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Pin this URL", "default_icon": {"16": "icons/pin.svg", "32": "icons/pin.svg"}}, "icons": {"16": "icons/pin.svg", "32": "icons/pin.svg", "48": "icons/pin.svg", "128": "icons/pin.svg"}, "browser_specific_settings": {"gecko": {"id": "tab-home@example.com", "data_collection_permissions": {"required": ["none"]}}}}