{"manifest_version": 2, "name": "OceanLabs for X (Twitter)", "description": "Enhance your Twitter/X experience with custom, unique color schemes and visual effects while enhancing the overall user interface.", "version": "2.0", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "96": "images/icon96.png", "128": "images/icon128.png", "256": "images/icon256.png"}, "content_scripts": [{"js": ["inject/inject.js"], "css": ["inject/hud.css"], "matches": ["https://x.com/*"]}], "background": {"scripts": ["inject/video_downloader.js"]}, "browser_action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "96": "images/icon96.png", "128": "images/icon128.png", "256": "images/icon256.png"}, "default_popup": "popup/options.html", "default_title": "Options"}, "options_ui": {"open_in_tab": true, "page": "popup/options.html"}, "web_accessible_resources": ["inject/injectStyles.css", "fonts/*"], "permissions": ["storage", "activeTab", "webRequest", "webRequestBlocking", "scripting"], "browser_specific_settings": {"gecko": {"id": "oceanlabs-twitter@oceanbearstudios.com"}}}