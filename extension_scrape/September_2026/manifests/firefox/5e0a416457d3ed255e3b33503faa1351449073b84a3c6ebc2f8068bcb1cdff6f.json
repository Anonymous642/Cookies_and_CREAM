{"manifest_version": 2, "name": "FocusFade \u2014 SoundBookmark", "version": "1.0.0", "description": "FocusFade fades audio when leaving tab; SoundBookmark saves audio/video timestamps per page, export/import JSON.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "<all_urls>", "tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "FocusFade & SoundBookmark", "default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "focusfade.soundbookmark@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}