{"manifest_version": 3, "name": "PriEco Web Discovery", "version": "0.3.3", "description": "Contribute to the PriEco search index on your terms.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "ui/popup.html"}, "permissions": ["storage", "activeTab", "alarms", "offscreen", "webRequest", "declarativeNetRequest"], "host_permissions": ["https://crawler.prieco.net/*", "<all_urls>"], "background": {"service_worker": "browser/background.js", "scripts": ["scripts/parser.js", "browser/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/parser.js", "scripts/query_log.js", "scripts/sanitize.js", "page/content.js"]}], "browser_specific_settings": {"gecko": {"id": "prieco-web-discovery@prieco.net", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["websiteActivity"], "sharing": ["websiteActivity"], "privacy_policy_url": "https://prieco.net/privacy-ext"}}}}