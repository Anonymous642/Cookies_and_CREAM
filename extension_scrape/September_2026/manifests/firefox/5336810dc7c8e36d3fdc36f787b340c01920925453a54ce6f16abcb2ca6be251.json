{"manifest_version": 3, "name": "Keka Time Logger", "version": "1.0", "description": "Smart Keka time tracking companion \u2014 live time logs, expected Day End calculations, break tracking, and monthly late arrival counts.", "permissions": ["storage", "notifications", "tabs", "offscreen"], "host_permissions": ["*://*.keka.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.keka.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "keka-time-logger@bleed", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}