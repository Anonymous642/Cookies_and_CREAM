{"manifest_version": 3, "name": "Disable YouTube Pinch Zoom", "version": "1.1", "description": "Prevents YouTube from hijacking trackpad pinch-to-zoom gesture", "browser_specific_settings": {"gecko": {"id": "youtube-pinch-fix@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}]}