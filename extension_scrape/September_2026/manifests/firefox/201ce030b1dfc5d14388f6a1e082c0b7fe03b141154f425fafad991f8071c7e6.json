{"manifest_version": 3, "name": "Sydecko Kiosk", "version": "1.0.0", "description": "Fullscreen Sydecko signage kiosk: launches your player URL, keeps the screen awake, and relaunches automatically if closed.", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Sydecko Kiosk", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "kiosk@sydecko.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}