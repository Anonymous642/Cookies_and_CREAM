{"manifest_version": 2, "name": "MiWebMark", "version": "1.0.4", "description": "Save your current URL to your MiWebMark reading list quickly and easily.", "permissions": ["activeTab", "storage", "tabs", "alarms", "https://miwebmark.xdface.net/*", "https://api.miwebmark.xdface.net/*", "https://miwebmark-foundation-prod.auth.us-east-1.amazoncognito.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://miwebmark.xdface.net/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Save to MiWebMark", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["popup/popup.html"], "browser_specific_settings": {"gecko": {"id": "miwebmark@xdface.net", "strict_min_version": "91.0"}, "gecko_android": {"strict_min_version": "120.0"}}}