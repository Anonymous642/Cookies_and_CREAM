{"manifest_version": 3, "name": "Roblox Game Filter", "version": "1.0", "description": "Hides games containing user-entered keywords.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.roblox.com/*"], "js": ["filter.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "roblox-filter-extension@local.dev", "data_collection_permissions": {"required": ["none"]}}}}