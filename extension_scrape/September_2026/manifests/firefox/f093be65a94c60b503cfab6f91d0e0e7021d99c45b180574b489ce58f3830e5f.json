{"manifest_version": 3, "name": "Stabby", "version": "0.2", "description": "Short for 'Search Tab'. Quickly stab a tab!", "permissions": ["tabs", "activeTab"], "action": {"default_title": "Stabby", "default_popup": "main.html"}, "background": {"scripts": ["trigger.js"]}, "commands": {"toggle-tab-selector": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+O"}, "description": "Open the Tab Selector"}}, "browser_specific_settings": {"gecko": {"id": "stabby@momo.com", "data_collection_permissions": {"required": ["none"]}}}}