{"manifest_version": 3, "name": "CPBase - Solves to GitHub", "description": "Automatically syncs accepted Codeforces and TLX Toki solutions to GitHub.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "notifications"], "host_permissions": ["https://codeforces.com/*", "https://*.codeforces.com/*", "https://tlx.toki.id/*", "https://*.tlx.toki.id/*", "https://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "cpbase@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "CPBase Settings", "default_popup": "popup.html", "default_icon": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://codeforces.com/contest/*/my*", "*://codeforces.com/contest/*/problem/*", "*://codeforces.com/contest/*/status*", "*://codeforces.com/contest/*/submission/*", "*://codeforces.com/group/*/contest/*/my*", "*://codeforces.com/group/*/contest/*/problem/*", "*://codeforces.com/group/*/contest/*/status*", "*://codeforces.com/group/*/contest/*/submission/*", "*://codeforces.com/gym/*/my*", "*://codeforces.com/gym/*/problem/*", "*://codeforces.com/gym/*/status*", "*://codeforces.com/gym/*/submission/*", "*://codeforces.com/problemset/problem/*/*", "*://codeforces.com/problemset/status*", "*://codeforces.com/problemset/submission/*/*"], "run_at": "document_idle", "js": ["content-scripts/codeforces.js"]}, {"matches": ["*://tlx.toki.id/contests/*", "*://tlx.toki.id/courses/*", "*://tlx.toki.id/problems/*", "*://tlx.toki.id/submissions/*"], "run_at": "document_idle", "js": ["content-scripts/tlx.js"]}]}