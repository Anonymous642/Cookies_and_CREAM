{"manifest_version": 3, "name": "YouTube Studio Anti-Burnout", "version": "1.0", "description": "Hides Analytics in YouTube Studio, and removes view from the frontend. Focus on creating content and not the algorithm.", "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube@nutimo.dk", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": [], "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "css": ["ytstudio.css"], "js": ["ytstudio.js"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*"], "css": ["frontend.css"], "js": ["frontend.js"], "run_at": "document_start"}]}