{"manifest_version": 3, "name": "Humanity Score", "version": "0.1", "description": "Displays a humanity indicator next to X (Twitter) usernames.", "icons": {"128": "icon.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "authina@humanityscore.test", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}