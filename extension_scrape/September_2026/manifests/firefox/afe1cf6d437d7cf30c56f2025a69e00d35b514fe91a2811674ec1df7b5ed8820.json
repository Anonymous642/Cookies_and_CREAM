{"manifest_version": 2, "name": "Floatchamp", "description": "Browser extension for Floatplane live streams.", "version": "0.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://api.betterttv.net/*", "https://cdn.betterttv.net/*"], "browser_specific_settings": {"gecko": {"id": "floatchamp@floatchamp.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.floatplane.com/*"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_title": "Floatchamp"}}