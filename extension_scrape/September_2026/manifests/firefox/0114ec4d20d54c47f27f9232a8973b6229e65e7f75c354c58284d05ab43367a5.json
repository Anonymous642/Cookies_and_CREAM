{"manifest_version": 3, "name": "Local Reader Bridge", "version": "0.1.1", "description": "Capture the current logged-in page and send it to a local MCP reader.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["http://localhost:3010/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Open Local Reader Bridge"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "sidebar_action": {"default_panel": "panel.html", "default_title": "Local Reader Bridge"}, "browser_specific_settings": {"gecko": {"id": "browser-reader-bridge@bot-ai-bridge.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}}