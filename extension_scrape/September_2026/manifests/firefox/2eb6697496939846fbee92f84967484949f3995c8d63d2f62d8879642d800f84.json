{"manifest_version": 3, "name": "osu! standard pp calculator", "version": "1.1.0", "description": "Compact osu! standard pp calculator with stable/lazer modes for osu! beatmap and score pages.", "permissions": ["storage", "scripting", "activeTab"], "host_permissions": ["https://osu.ppy.sh/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "action": {"default_title": "Open osu! standard pp calculator"}, "content_scripts": [{"matches": ["https://osu.ppy.sh/beatmapsets/*", "https://osu.ppy.sh/beatmaps/*", "https://osu.ppy.sh/scores/*"], "js": ["content-loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*.js", "images/mods/*.svg", "engine/*"], "matches": ["https://osu.ppy.sh/*"]}], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "osu-pp-calculator@oppc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}