{"manifest_version": 3, "name": "WordySpot: English Vocabulary Finder", "version": "1.2.0", "description": "Scans visible page text locally to find English words you may want to learn, explain them, and save them to your WordySpot lists.", "permissions": ["storage"], "host_permissions": ["https://wordyspot.com/*", "https://sounds.wordyspot.com/*"], "incognito": "not_allowed", "options_ui": {"page": "permissions.html?source=settings", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Open WordySpot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Open the WordySpot panel"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://wordyspot.com/*"], "js": ["all.js"], "css": ["all.css"]}, {"matches": ["https://wordyspot.com/*"], "js": ["wordyspot.js"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@wordyspot.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": []}}, "gecko_android": {"strict_min_version": "150.0"}}}