{"manifest_version": 2, "name": "AutoScroll Racer", "description": "Race between open tabs: each tab's scroll speed moves its car. Scroll a tab to speed its car up.", "version": "1.0", "permissions": ["tabs", "storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "AutoScroll Racer", "default_popup": "popup.html"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "autoscrollracer@example.com", "data_collection_permissions": {"required": ["none"]}}}}