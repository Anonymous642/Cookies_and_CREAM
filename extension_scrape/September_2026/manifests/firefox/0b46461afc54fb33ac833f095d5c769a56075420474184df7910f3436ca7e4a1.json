{"manifest_version": 3, "name": "LetterStremio", "version": "1.2.1", "description": "Adds a \"Watch on Stremio\" button to Letterboxd film and TV show pages.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["*://api.strem.io/*", "*://v3-cinemeta.strem.io/*"], "content_scripts": [{"matches": ["*://letterboxd.com/film/*", "*://www.letterboxd.com/film/*", "*://letterboxd.com/*/film/*", "*://www.letterboxd.com/*/film/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "letterstremio@yasser.me", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}