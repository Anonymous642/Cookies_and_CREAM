{"manifest_version": 3, "name": "Neopets: Redirect to Home", "version": "1.0", "description": "Instantly redirects the neopets.com front page to /home/ at the network layer, before any request is sent.", "browser_specific_settings": {"gecko": {"id": "neopets-home-redirect@ascieth", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "icons": {"48": "icon.png", "128": "icon128.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://neopets.com/*", "*://www.neopets.com/*"], "declarative_net_request": {"rule_resources": [{"id": "neopets_home_redirect", "enabled": true, "path": "rules.json"}]}}