{"manifest_version": 3, "name": "Credibility Analyzer", "version": "1.6.8", "description": "Fact-check content using AI with real-time web grounding and search capabilities", "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://evergreen-labs.org/assets/factcheck.json"], "action": {"default_title": "Credibility Analyzer"}, "background": {"service_worker": "background.js", "scripts": ["browser-utils.js", "fact-check-core.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-utils.js", "content.js"]}], "web_accessible_resources": [{"resources": ["browser-utils.js", "ai-analyzer.js", "settings.html", "open-host-settings.html", "credibility-result.html", "credibility-result.js", "lib/pdf.min.js", "lib/pdf.worker.min.js"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "settings.html", "browser_specific_settings": {"gecko": {"id": "credibility-analyzer@evergreen-labs.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["websiteActivity"]}}}, "options_ui": {"page": "settings.html", "open_in_tab": true}}