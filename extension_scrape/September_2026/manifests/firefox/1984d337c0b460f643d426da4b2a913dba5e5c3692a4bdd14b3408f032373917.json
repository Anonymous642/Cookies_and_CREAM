{"manifest_version": 3, "name": "Stickflow Looper for YouTube", "description": "Section looping for YouTube with optional Stickflow account sync.", "version": "1.0.8", "action": {"default_title": "Stickflow Looper for YouTube", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.stickflow.app/*", "https://stickflow.app/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content-youtube.js"], "css": ["content/youtube.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://www.stickflow.app/*", "https://stickflow.app/*"], "js": ["content-connect.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content/youtube.css"], "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]}], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "stickflow-looper@stickflow.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity", "websiteContent", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}