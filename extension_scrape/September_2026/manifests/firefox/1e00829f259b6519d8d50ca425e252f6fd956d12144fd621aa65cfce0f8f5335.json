{"manifest_version": 2, "name": "UXstorm Secure Signing", "version": "1.2.8.1", "description": "Bridge UXstorm PDFsuite Digital Signing to the UXstorm Secure Signing Agent for secure Digital Signatures.   This includes CAC & PIV cards, USB Keys, and Certificates stored in the local keystore.", "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "permissions": ["cookies", "nativeMessaging", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "uxstorm-secure-signing@uxstorm.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent"]}}}}