{"manifest_version": 3, "name": "You Tube Focus AI Warden", "version": "0.2.0", "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://*.workers.dev/*", "https://cloud.langfuse.com/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "icons": {"16": "completed_logo.png", "48": "completed_logo.png", "128": "completed_logo.png"}, "web_accessible_resources": [{"resources": ["logo_zoomed_2.png"], "matches": ["https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "yt-focus@example.com", "strict_min_version": "115.0"}}}