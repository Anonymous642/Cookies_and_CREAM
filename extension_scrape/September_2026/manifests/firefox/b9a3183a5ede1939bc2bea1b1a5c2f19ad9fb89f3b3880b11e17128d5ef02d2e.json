{"name": "Nitter Redirect", "description": "Redirects Twitter/X requests to Nitter, the privacy friendly alternative.", "version": "1.2.0", "manifest_version": 2, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://www.twitter.com/*", "*://mobile.twitter.com/*", "*://pbs.twimg.com/*", "*://video.twimg.com/*", "*://x.com/*", "*://www.x.com/*", "*://mobile.x.com/*"], "js": ["content-script.js"], "run_at": "document_start"}], "permissions": ["storage", "webRequest", "webRequestBlocking", "*://twitter.com/*", "*://www.twitter.com/*", "*://mobile.twitter.com/*", "*://pbs.twimg.com/*", "*://video.twimg.com/*", "*://x.com/*", "*://www.x.com/*", "*://mobile.x.com/*"], "browser_action": {"default_popup": "pages/popup/popup.html", "default_icon": {"48": "images/icon48.png", "128": "images/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "nitter-redirect@astralvrz.github.io", "data_collection_permissions": {"required": ["none"]}}}}