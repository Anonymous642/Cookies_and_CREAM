{"manifest_version": 3, "name": "RedHN", "description": "A Reddit-style extension for Hacker News", "version": "1.0.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage"], "host_permissions": ["https://hacker-news.firebaseio.com/*"], "browser_specific_settings": {"gecko": {"id": "{236c74aa-26d2-4453-ab23-90148d0cce77}", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "RedHN", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content-scripts/redhn.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/redhn.css"], "matches": ["https://news.ycombinator.com/*"]}]}