{"manifest_version": 3, "name": "WebTM", "version": "1.7.4", "description": "WebTM is a cross-platform solution to integrate the navigation history between desktop and mobile web browsers.", "permissions": ["tabs", "activeTab", "storage", "scripting", "nativeMessaging"], "action": {"default_popup": "index.html"}, "host_permissions": ["<all_urls>"], "icons": {"16": "app-icon-16.png", "32": "app-icon-32.png", "48": "app-icon-48.png", "128": "app-icon-128.png"}, "content_scripts": [{"js": ["content.ts-loader.js"], "matches": ["*://*/*"], "run_at": "document_end"}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "{5790cffd-a2b7-4cb6-ad05-c5b955ddee3e}"}, "gecko_android": {"id": "{5790cffd-a2b7-4cb6-ad05-c5b955ddee3e}"}}, "background": {"scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"matches": ["*://*/*"], "resources": ["*.png", "*.jpg", "*.jpeg", "*.svg", "*.webp", "chunks/_commonjsHelpers.js", "chunks/index.js", "chunks/types.js", "content.js"], "use_dynamic_url": false}]}