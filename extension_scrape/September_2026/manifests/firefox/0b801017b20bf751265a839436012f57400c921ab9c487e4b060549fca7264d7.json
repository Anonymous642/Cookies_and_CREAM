{"manifest_version": 2, "name": "Feedbro (Simple)", "version": "1.0.0", "description": "Simple local RSS reader: add feeds, poll periodically, view and open items. No server required.", "permissions": ["storage", "alarms", "notifications", "activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Feedbro", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "applications": {"gecko": {"id": "feedbrosimple@example.com", "strict_min_version": "60.0"}}}