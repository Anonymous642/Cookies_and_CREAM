{"manifest_version": 2, "name": "Container Autopilot", "version": "2.0.3", "description": "Opens new and external tabs in disposable temporary containers, and routes URLs matching your rules into permanent containers.", "browser_specific_settings": {"gecko": {"id": "@container-autopilot", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextualIdentities", "cookies", "tabs", "tabGroups", "storage", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["lib.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Container Autopilot", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}