{"manifest_version": 2, "name": "ILPH - Link Cleaner", "version": "1.1.2", "description": "Nettoie automatiquement les liens ouverts dans Firefox en retirant les traceurs connus, sans modifier les pages.", "icons": {"500": "logo.png"}, "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["cleaner.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["cleaner.js", "content-youtube.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "link-cleaner@ilph.fr", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}