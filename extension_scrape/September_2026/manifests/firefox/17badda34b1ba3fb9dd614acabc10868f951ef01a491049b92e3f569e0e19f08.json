{"manifest_version": 3, "name": "LeetCode AI Helper", "description": "AI hints assistant for LeetCode problems with contextual guidance.", "version": "1.0.0", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://leetcode.com/problems/*", "https://generativelanguage.googleapis.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://leetcode.com/pro blems/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-chat": {"suggested_key": {"default": "Ctrl+Shift+A", "mac": "Command+Shift+A"}, "description": "Toggle LeetCode AI Helper chat"}}, "action": {"default_title": "LeetCode AI Helper", "default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "leetcode-ai-helper@example.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}