{"manifest_version": 3, "name": "Utilumo", "description": "Utilumo, available everywhere in your browser. Clean URLs, fix text, and launch privacy-first tools from the page you are on.", "version": "0.1.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_title": "Utilumo", "default_popup": "popup.html"}, "commands": {"open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Open the Utilumo mini launcher"}}, "browser_specific_settings": {"gecko": {"id": "extension@utilumo.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Utilumo"}}