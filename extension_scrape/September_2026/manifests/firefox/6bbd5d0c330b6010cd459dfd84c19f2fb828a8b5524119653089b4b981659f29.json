{"manifest_version": 3, "name": "Real-Time Translator", "version": "1.0.9", "description": "Real-time speech translation for browser tabs and microphone with cloud ASR/TTS support", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Real-Time Translator"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["fonts/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws: wss: http: https:"}, "browser_specific_settings": {"gecko": {"id": "translator@realtime.extension", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}