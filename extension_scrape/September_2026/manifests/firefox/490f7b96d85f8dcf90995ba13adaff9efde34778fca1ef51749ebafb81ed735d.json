{"manifest_version": 2, "name": "Kana Mail", "description": "A browser extension that integrates OpenPGP encryption into webmail services, allowing users to send and receive encrypted emails directly from their webmail interface.", "version": "1.1.0", "browser_specific_settings": {"gecko": {"id": "kanamail@kanasecure.co.za", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "notifications", "https://mail.google.com/*", "https://outlook.live.com/*", "https://mail.yahoo.com/*", "https://mail.proton.me/*"], "browser_action": {"default_title": "KanaMail", "default_popup": "contacts.html", "default_icon": {"16": "icons/lock-16.png", "48": "icons/lock-48.png", "128": "icons/lock-128.png"}}, "background": {"scripts": ["compat.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://mail.yahoo.com/*", "https://mail.proton.me/*"], "js": ["compat.js", "openpgp.min.js", "content_script.js"], "run_at": "document_idle"}], "web_accessible_resources": ["openpgp.min.js"], "icons": {"16": "icons/lock-16.png", "48": "icons/lock-48.png", "128": "icons/lock-128.png"}}