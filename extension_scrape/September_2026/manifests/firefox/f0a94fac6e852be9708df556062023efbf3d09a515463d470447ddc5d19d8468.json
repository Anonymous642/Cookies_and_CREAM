{"manifest_version": 2, "name": "DuckDuckGo + Google Search", "version": "1.0", "description": "Enhances DuckDuckGo search with Google search results displayed side-by-side", "browser_specific_settings": {"gecko": {"id": "ddg-google-addon@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://duckduckgo.com/*", "https://www.google.com/*", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.duckduckgo.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"48": "icon-48.png", "96": "icon-96.png"}}