{"manifest_version": 3, "name": "Highlight & Knowledge Vault", "version": "2.0.0", "description": "Save highlights. Organize with collections. Find in under 5 seconds.", "permissions": ["storage", "activeTab", "contextMenus"], "commands": {"save-highlight": {"suggested_key": {"default": "Alt+H"}, "description": "Save selected text as highlight"}, "quick-capture": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Quick save to Inbox"}, "open-vault": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open vault search"}}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/toast.js", "content/highlight.js"], "css": ["content/highlight.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "browser_specific_settings": {"gecko": {"id": "highlight-knowledge-vault@extension", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}