{"manifest_version": 3, "name": "Quick QR \u2013 Generate QR for URL/Text", "version": "1.0.0", "description": "T\u1ea1o m\u00e3 QR cho URL/tab hi\u1ec7n t\u1ea1i, li\u00ean k\u1ebft chu\u1ed9t ph\u1ea3i, ho\u1eb7c \u0111o\u1ea1n text ch\u1ecdn. C\u00f3 popup \u0111\u1ec3 copy/m\u1edf/t\u1ea3i PNG.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "tabs", "storage", "clipboardWrite", "downloads", "contextMenus", "scripting"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quick-qr-demo@example.com", "strict_min_version": "109.0"}}}