{"manifest_version": 3, "name": "ClipWave", "version": "1.3.2", "description": "See ClipWave markers on the YouTube progress bar. Jump to highlights instantly!", "permissions": ["storage"], "host_permissions": ["https://api.clipwaveapp.in/*", "https://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "clipwave@clipwave.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}