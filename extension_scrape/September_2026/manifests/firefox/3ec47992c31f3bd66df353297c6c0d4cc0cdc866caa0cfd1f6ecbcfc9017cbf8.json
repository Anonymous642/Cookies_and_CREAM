{"manifest_version": 3, "name": "Table to CSV: HTML Table Extractor", "version": "1.0.0", "description": "Extract tables from any website and save them as clean CSV. Handles HTML tables and many div/grid-based table layouts. On-demand scanning with power-user controls.", "permissions": ["activeTab", "scripting", "downloads", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "table-to-csv-htmlextractor@95tech.net", "data_collection_permissions": {"required": ["none"], "optional": []}, "strict_min_version": "142.0"}}}