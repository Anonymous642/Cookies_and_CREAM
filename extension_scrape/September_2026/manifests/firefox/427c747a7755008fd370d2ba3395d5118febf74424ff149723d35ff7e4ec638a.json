{"manifest_version": 3, "name": "Semitone for YouTube", "version": "0.3.0", "description": "Shift YouTube audio up or down in semitones without changing playback speed.", "browser_specific_settings": {"gecko": {"id": "semitone-youtube@fabiancabau", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "149.0"}, "gecko_android": {"strict_min_version": "149.0"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["firefox/background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["audio-worklet.js", "firefox/audio-controller.js", "src/*.js", "vendor/signalsmith/SignalsmithStretch.mjs"], "matches": ["https://youtube.com/*", "https://*.youtube.com/*", "https://youtu.be/*", "https://*.youtube-nocookie.com/*"]}], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html", "default_title": "Shift YouTube pitch"}}