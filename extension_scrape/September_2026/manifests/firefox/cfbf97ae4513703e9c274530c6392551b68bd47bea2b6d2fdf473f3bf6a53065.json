{"manifest_version": 3, "name": "TruthPrism", "version": "2.2", "description": "AI-powered fact-checker. Verify claims on any page with live web search and source citations.", "browser_specific_settings": {"gecko": {"id": "truth-prism@pklmedialab.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "TruthPrism", "default_popup": "popup.html"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["report.html", "report.js"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}}