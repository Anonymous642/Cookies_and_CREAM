{"manifest_version": 3, "name": "Block Blast Solves", "short_name": "BB Solves", "version": "1.0.0", "description": "AI solver for Block Blast puzzles. Upload a screenshot or draw your board to get step-by-step optimal move suggestions.", "browser_specific_settings": {"gecko": {"id": "blockblastsolves@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Block Blast Solves"}, "background": {"scripts": ["background/background.js"], "service_worker": "background/background.js"}, "content_scripts": [{"matches": ["https://blockblastsolves.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://blockblastsolves.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Open Block Blast Solves"}}}