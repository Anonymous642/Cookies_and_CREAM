{"manifest_version": 2, "name": "DarkShift", "version": "1.0", "description": "DarkShift is a sleek Firefox extension that lets you seamlessly toggle between dark and light modes on any website. Instantly switch for a comfortable browsing experience, day or night, with site-specific preferences remembered automatically for a personalized experience.", "permissions": ["activeTab", "storage", "tabs", "scripting"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-1.png", "24": "icons/icon-2.png", "32": "icons/icon-3.png", "48": "icons/icon-4.png", "64": "icons/icon-5.png", "96": "icons/icon-6.png"}}, "icons": {"16": "icons/icon-1.png", "24": "icons/icon-2.png", "32": "icons/icon-3.png", "48": "icons/icon-4.png", "64": "icons/icon-5.png", "96": "icons/icon-6.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/darkmode.js"], "run_at": "document_end"}], "options_ui": {"page": "popup/popup.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "{ab0b86f8-1ba3-4f85-9712-1c5696e471c4}"}}}