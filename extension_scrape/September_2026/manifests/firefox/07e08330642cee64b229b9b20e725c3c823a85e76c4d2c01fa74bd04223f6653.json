{"manifest_version": 2, "name": "ChessMaxus - Stockfish Live Analysis", "version": "2.6.5", "description": "Free live Stockfish analysis for chess.com: best moves as arrows, eval bar. No account, no limits, runs locally.", "permissions": ["storage"], "background": {"page": "background.html", "persistent": true}, "content_scripts": [{"matches": ["https://www.chess.com/*", "https://chess.com/*"], "js": ["chess.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "ChessMaxus", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "chessmaxus@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}