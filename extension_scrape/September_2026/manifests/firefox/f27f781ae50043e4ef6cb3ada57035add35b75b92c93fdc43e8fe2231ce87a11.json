{"manifest_version": 3, "name": "Sticky Page Draw", "version": "1.0.0", "description": "Draw on any web page with drawings that stay fixed in place even when scrolling. Perfect for annotations and notes.", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_icon": {"48": "icons/icon48-off.png"}, "default_title": "Sticky Page Draw \u2013 Click to draw"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["content.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "buraksaribas@yahoo.com", "data_collection_permissions": {"required": ["none"]}}}}