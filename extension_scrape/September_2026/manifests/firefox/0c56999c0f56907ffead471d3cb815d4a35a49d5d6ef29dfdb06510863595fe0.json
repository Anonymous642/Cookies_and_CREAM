{"manifest_version": 3, "name": "Altretta Web Clipper", "version": "0.9.7", "description": "Clip web pages and selections to your local Altretta vault inbox as verifiable Markdown.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "action": {"default_title": "Altretta Web Clipper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "version_name": "0.9.7", "browser_specific_settings": {"gecko": {"id": "clipper@altretta.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}