{"manifest_version": 2, "name": "Musa Spell", "description": "Highlights known words on any page. Click one to see its Musa phonetic alphabet breakdown in a fullscreen modal.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "<all_urls>"], "web_accessible_resources": ["*.otf"], "browser_specific_settings": {"gecko": {"id": "musa-spell@musa-view.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Musa Spell Data", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}