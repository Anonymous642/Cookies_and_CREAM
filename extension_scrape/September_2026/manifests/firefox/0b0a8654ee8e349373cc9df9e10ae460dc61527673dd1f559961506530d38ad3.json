{"manifest_version": 2, "name": "Bet Odds Auto Extractor", "version": "1.0", "description": "Automatically extracts betting odds and sends to local calculator", "browser_specific_settings": {"gecko": {"id": "bet-odds-extractor@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["http://localhost:8765/*", "<all_urls>"], "content_scripts": [{"matches": ["*://*.betfair.com/*", "*://*.bet365.com/*", "*://ex.indi2.club/*", "*://*.indi2.club/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}}