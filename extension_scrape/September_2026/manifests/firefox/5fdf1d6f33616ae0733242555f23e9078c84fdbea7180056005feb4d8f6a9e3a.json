{"manifest_version": 3, "version": "1.0.1", "name": "Youtube Transcript Search", "description": "Search through any Youtube video's transcripts.", "browser_specific_settings": {"gecko": {"id": "katella@katell.xyz"}}, "icons": {"128": "icon128.png"}, "incognito": "split", "permissions": ["webNavigation"], "background": {"scripts": ["service-worker.js"]}, "content_scripts": [{"js": ["lunr.js", "search.js"], "matches": ["*://*.youtube.com/*"], "run_at": "document_end"}]}