{"manifest_version": 2, "name": "Discord Container Account Manager", "version": "1.2.0", "description": "A safer Discord account launcher using Firefox Container Tabs. It does not store passwords or tokens.", "permissions": ["storage", "tabs", "cookies", "contextualIdentities", "https://discord.com/*"], "browser_action": {"default_title": "Discord Accounts", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "discord-container-account-manager@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}