{"manifest_version": 3, "name": "DeviceView Lab - Responsive Device Tester", "version": "1.0.0", "description": "Preview any website across mobile, tablet, laptop, and desktop viewports with realistic frames and developer tools.", "browser_specific_settings": {"gecko": {"id": "deviceview-lab@developer.firefox", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs"], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "DeviceView Lab", "default_popup": "popup.html"}, "sidebar_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "DeviceView Lab Sidebar", "default_panel": "sidebar.html"}, "background": {"scripts": ["background.js"]}, "commands": {"open-deviceview": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Open DeviceView Lab Workbench"}, "rotate-device": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Rotate Device Orientation"}, "reload-preview": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Reload Active Preview"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}