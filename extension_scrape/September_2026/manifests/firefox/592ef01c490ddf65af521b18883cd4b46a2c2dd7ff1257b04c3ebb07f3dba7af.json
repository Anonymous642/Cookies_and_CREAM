{"manifest_version": 3, "name": "Instagram DM Only", "version": "1.0.0", "description": "Always open Instagram on DMs and hide distractions. Click the icon to toggle.", "browser_specific_settings": {"gecko": {"id": "instagram-dm-only@jota95", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "Instagram Inbox Focus (activa)"}, "permissions": ["declarativeNetRequest", "storage", "tabs"], "host_permissions": ["*://www.instagram.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}