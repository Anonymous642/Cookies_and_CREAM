{"manifest_version": 3, "name": "No AI Overview", "description": "Hide Google Search AI Overview blocks, or force web-only results.", "version": "1.1.0", "permissions": ["storage"], "action": {"default_title": "No AI Overview", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "no-ai-overview@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "content_scripts": [{"matches": ["https://www.google.com/*", "https://google.com/*"], "js": ["content.js"], "run_at": "document_start"}]}