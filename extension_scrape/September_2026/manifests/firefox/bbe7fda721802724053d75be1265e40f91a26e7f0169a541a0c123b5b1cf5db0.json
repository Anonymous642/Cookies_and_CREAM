{"manifest_version": 2, "name": "VectoSolve - Image to SVG Converter", "short_name": "VectoSolve", "version": "3.1.0", "description": "Convert, upscale, or remove backgrounds from any image. Right-click, screenshot, batch process, or use on Canva & Figma.", "author": "VectoSolve", "homepage_url": "https://vectosolve.com", "browser_specific_settings": {"gecko": {"id": "vectosolve@vectosolve.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "VectoSolve - Convert to SVG"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["contextMenus", "storage", "activeTab", "tabs", "notifications", "downloads", "<all_urls>"], "content_scripts": [{"matches": ["https://www.canva.com/*", "https://www.figma.com/*", "https://docs.google.com/presentation/*"], "js": ["content/injector.js"], "css": ["content/injector.css"], "run_at": "document_idle"}], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+V", "mac": "Alt+V"}, "description": "Open VectoSolve popup"}}, "content_security_policy": "script-src 'self'; object-src 'self'", "offline_enabled": false}