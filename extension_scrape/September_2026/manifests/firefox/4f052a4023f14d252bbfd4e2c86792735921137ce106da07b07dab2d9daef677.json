{"manifest_version": 3, "name": "Deal Surfer \u2014 Amazon Price Watcher", "version": "1.7.2", "description": "Hang Loose, Pay Less. With Deal Surfer, see historical price data for any Amazon item and set alerts to buy at record lows.", "permissions": ["storage", "alarms", "notifications", "activeTab"], "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.co.jp/*", "https://*.amazon.ca/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*", "https://*.amazon.com.mx/*", "https://api.thedealsurfer.com/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "src/popup/popup.html", "default_title": "Deal Surfer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.co.jp/*", "https://*.amazon.ca/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*", "https://*.amazon.com.mx/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/popup/*", "src/lib/*", "fonts/*", "icons/*"], "matches": ["https://*.amazon.com/*", "https://*.amazon.co.uk/*", "https://*.amazon.de/*", "https://*.amazon.fr/*", "https://*.amazon.co.jp/*", "https://*.amazon.ca/*", "https://*.amazon.it/*", "https://*.amazon.es/*", "https://*.amazon.in/*", "https://*.amazon.com.mx/*"]}], "browser_specific_settings": {"gecko": {"id": "deal-surfer@thedealsurfer.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["personallyIdentifyingInfo"]}}}}