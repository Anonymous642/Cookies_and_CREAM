{"manifest_version": 3, "name": "IMDb/Rotten Tomatoes to Wikifeet", "description": "Opens the wikifeet page of an actress from IMDb or Rotten Tomatoes, and shows wikifeet ratings on actress, movie and series pages.", "version": "1.3.0", "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"19": "wikifeet-19.png", "48": "wikifeet-48.png"}, "default_title": "Wikifeet"}, "permissions": ["activeTab", "storage"], "icons": {"48": "wikifeet-48.png", "128": "wikifeet-128.png"}, "host_permissions": ["https://wikifeet.com/*", "https://www.wikifeet.com/*"], "content_scripts": [{"matches": ["https://www.imdb.com/*name/nm*", "https://m.imdb.com/*name/nm*", "https://www.imdb.com/*title/tt*", "https://m.imdb.com/*title/tt*", "https://www.rottentomatoes.com/celebrity/*", "https://www.rottentomatoes.com/m/*", "https://www.rottentomatoes.com/tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["wikifeet-48.png"], "matches": ["https://www.imdb.com/*", "https://m.imdb.com/*", "https://www.rottentomatoes.com/*"]}], "browser_specific_settings": {"gecko": {"id": "{2e7a2fe6-74e8-40ba-aa2f-acdff24675ff}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}