{"manifest_version": 2, "name": "Tally", "description": "Automated data entry from Google Sheets", "version": "1.0.2", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icon/96.png", "128": "icons/128.png"}, "permissions": ["activeTab", "scripting", "storage", "identity", "https://sheets.googleapis.com/*", "https://tally-oauth.austin-smith-d0e.workers.dev/*"], "browser_specific_settings": {"gecko": {"id": "tally@austinsmith.org", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Tally", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}