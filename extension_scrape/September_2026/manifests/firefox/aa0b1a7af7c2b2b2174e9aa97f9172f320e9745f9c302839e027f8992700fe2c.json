{"manifest_version": 3, "name": "SpeedGrid New Tab", "description": "Open a private, locally rendered SpeedGrid dashboard on every Firefox new tab and save pages directly to your grids.", "version": "1.1.3", "homepage_url": "https://speedgrid.app/", "permissions": ["activeTab", "contextMenus", "search", "storage"], "host_permissions": ["https://speedgrid.app/*", "https://www.speedgrid.app/*"], "browser_specific_settings": {"gecko": {"id": "speedgrid@speedgrid.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"], "optional": ["browsingActivity", "searchTerms", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://speedgrid.app/*", "https://www.speedgrid.app/*"], "js": ["sync.js"], "run_at": "document_idle"}], "action": {"default_title": "SpeedGrid Quick Save", "default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}