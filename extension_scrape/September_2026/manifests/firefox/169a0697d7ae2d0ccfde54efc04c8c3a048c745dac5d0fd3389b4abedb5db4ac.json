{"manifest_version": 2, "name": "Page Sonification", "version": "1.3.0", "description": "Listen to the shape of a web page. Headings, links and images are mapped to musical tones \u2014 play the whole structure as a short sequence, or switch on live mode to hear elements as you scroll past them.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{26fa3c24-0262-4603-ade7-5fd4a626d3f4}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Page Sonification", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}