{"manifest_version": 2, "name": "Simple Domain Tab Sorter", "version": "1.6.9", "description": "Sort tabs by domain and title without mixing Zen spaces or Firefox tab groups.", "permissions": ["tabs", "storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-sorter-andre@local", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Simple Domain Tab Sorter", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"sort-tabs-now": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sort tabs now"}, "toggle-auto-sort": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Toggle Auto-Sort"}}}