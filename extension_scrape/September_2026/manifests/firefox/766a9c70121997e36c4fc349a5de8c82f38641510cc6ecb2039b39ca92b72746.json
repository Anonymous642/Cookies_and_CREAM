{"manifest_version": 3, "name": "URL Detox", "version": "1.0.0", "description": "Seamlessly clean URLs and unshorten links.", "permissions": ["declarativeNetRequest", "webNavigation", "storage", "alarms", "contextMenus", "clipboardWrite"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "action": {}, "icons": {"16": "url-detox-16.png", "48": "url-detox-48.png", "128": "url-detox-128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "url-detox@atharvaverma.dev", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "web_accessible_resources": [{"resources": ["src/loader/index.html", "assets/*"], "matches": ["<all_urls>"]}]}