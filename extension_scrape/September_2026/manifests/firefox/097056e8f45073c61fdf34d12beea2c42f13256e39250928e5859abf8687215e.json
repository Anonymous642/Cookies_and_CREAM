{"manifest_version": 3, "name": "Quick Tab Switcher", "version": "1.0", "description": "Switch tabs using Ctrl+Q (Previous) and Ctrl+E (Next).", "permissions": ["tabs"], "background": {"scripts": ["background.js"]}, "commands": {"previous-tab": {"suggested_key": {"default": "Ctrl+Q"}, "description": "Switch to the previous tab"}, "next-tab": {"suggested_key": {"default": "Ctrl+E"}, "description": "Switch to the next tab"}}, "browser_specific_settings": {"gecko": {"id": "quick-tab-switcher@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}