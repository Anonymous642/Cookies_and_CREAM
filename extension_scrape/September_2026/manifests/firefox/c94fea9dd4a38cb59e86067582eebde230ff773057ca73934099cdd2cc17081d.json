{"manifest_version": 3, "name": "Tealium Event Debugger", "description": "Captures utag.view and utag.link events and shows them in the popup.", "version": "3.0.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "web_accessible_resources": [{"resources": ["utag-hook.js"], "matches": ["*://*/*"]}], "browser_specific_settings": {"gecko": {"id": "utag-event-debugger@github.fre-ben", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tealium Events", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": false, "run_at": "document_start", "js": ["content-scripts/tealium.js"]}]}