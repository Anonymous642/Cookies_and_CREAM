{"manifest_version": 3, "name": "Babylon AFK Focus for Firefox", "version": "1.0.2", "description": "Companion for the Babylon Discord RPG userscript. Focuses the Discord tab/window when Babylon reaches /tutien recovery, and can schedule a timed focus.", "permissions": ["tabs", "alarms", "storage"], "host_permissions": ["https://discord.com/*", "https://discordapp.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Babylon AFK Focus", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://discord.com/*", "https://discordapp.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{8f6e8f39-493e-4146-af27-14d5dbe845e3}", "data_collection_permissions": {"required": ["none"]}}}}