{"manifest_version": 2, "name": "Subtle Chapter Markers (ScenePins)", "version": "1.0.0", "description": "Quickly mark video scenes with a hotkey and manage timestamps in a popup.", "permissions": ["storage", "downloads"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "ScenePins", "default_popup": "popup.html"}, "commands": {"add-pin": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Add scene marker at current video time"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "scenepins@addon.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}