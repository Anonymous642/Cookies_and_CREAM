{"manifest_version": 3, "name": "Zammad Time Recorder", "version": "1.0.13", "description": "Record Zammad ticket time", "author": "Glarotech GmbH", "homepage_url": "https://www.glarotech.ch/", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["webRequest", "activeTab", "storage"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["tracker.js"]}], "options_ui": {"page": "settings/options.html"}, "browser_specific_settings": {"gecko": {"id": "zammad@glarotech.ch"}}}