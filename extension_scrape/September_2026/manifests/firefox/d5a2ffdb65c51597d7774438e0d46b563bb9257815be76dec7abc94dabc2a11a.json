{"manifest_version": 2, "name": "Anchor", "description": "Your Anchor companion: Set Anchor as your new tab page and save bookmarks instantly via right-click or shortcut.", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "https://www.anchordesktop.com/*"], "commands": {"add-bookmark": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Add current page to Anchor"}}, "browser_specific_settings": {"gecko": {"id": "extension@anchordesktop.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "Anchor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.anchordesktop.com/*"], "js": ["content-scripts/content.js"]}]}