{"manifest_version": 3, "name": "Chasqui - Descargar Anexos", "version": "1.3.0", "description": "Agrega un boton para descargar todos los anexos de un documento en el sistema Chasqui de Fuerzas Armadas del Ecuador, en una subcarpeta por documento y con reintentos.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads"], "host_permissions": ["*://chasqui.ffaa.mil.ec/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://chasqui.ffaa.mil.ec/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "chasqui-anexos@boris.ec", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}}