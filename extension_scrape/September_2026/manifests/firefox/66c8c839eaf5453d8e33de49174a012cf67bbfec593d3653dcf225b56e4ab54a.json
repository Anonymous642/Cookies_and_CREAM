{"manifest_version": 3, "name": "Game VFX Clipper", "version": "1.2.4", "description": "Grab a moment from YouTube, Twitch or any web video and send it straight to the Game VFX Database upload flow.", "permissions": ["activeTab", "storage", "scripting", "contextMenus", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Game VFX Clipper", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["lib.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "browser_specific_settings": {"gecko": {"id": "clipper@gamevfxdb.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}