{"manifest_version": 3, "name": "Sitemap & Robots.txt Finder", "version": "1.0.0", "description": "Find robots.txt, sitemap.xml, sitemap declarations, and common crawl-control files for the current website.", "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Sitemap & Robots.txt Finder", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "sitemap-robots-finder@local-addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}