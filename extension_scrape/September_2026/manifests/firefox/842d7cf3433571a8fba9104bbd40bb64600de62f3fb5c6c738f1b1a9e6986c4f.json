{"manifest_version": 3, "name": "ScamShield", "version": "2.0.0", "description": "Real-time link scanning \u2014 every link gets a live threat score before you click.", "permissions": ["activeTab", "tabs", "scripting", "storage", "contextMenus"], "host_permissions": ["https://scamshieldy.com/*"], "background": {"scripts": ["background-script.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js", "link-scanner.js"], "css": ["link-scanner.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["warning.html"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html", "browser_style": false}, "action": {"default_popup": "popup.html", "default_title": "ScamShield \u2014 Real-time link protection"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "scamshield@scamshieldy.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}