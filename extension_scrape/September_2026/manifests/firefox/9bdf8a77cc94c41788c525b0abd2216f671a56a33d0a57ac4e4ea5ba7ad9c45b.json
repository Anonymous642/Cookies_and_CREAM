{"manifest_version": 3, "name": "BetterXShare", "version": "1.0", "description": "Automatically replaces Twitter/X links with vxtwitter.com when copying, so videos embed properly in Discord and other platforms.", "author": "BetterXShare", "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.twitter.com/*", "*://*.x.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "betterxshare@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}