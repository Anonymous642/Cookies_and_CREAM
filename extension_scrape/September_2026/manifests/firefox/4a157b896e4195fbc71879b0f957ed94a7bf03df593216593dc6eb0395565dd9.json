{"manifest_version": 2, "name": "Translit RU \u2014 Russian Transliteration", "version": "1.1.0", "description": "Russian transliteration converter with virtual keyboard and inline page mode. Type in Latin letters, get Cyrillic output instantly.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_title": "Translit RU", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["translit-engine.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "translit-ru@translit.cc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["clipboardWrite", "storage"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+T"}, "description": "Open Translit RU popup"}, "toggle-inline": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Toggle inline transliteration on all pages"}}}