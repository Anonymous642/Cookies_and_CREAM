{"manifest_version": 2, "name": "RCSB PDB Prompt Handler", "version": "1.2", "description": "A FireFox extension to open PDB and submit a prompt.", "permissions": ["activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*/*"], "omnibox": {"keyword": "PDB"}, "content_scripts": [{"matches": ["https://www.rcsb.org/search"], "js": ["content.js"]}], "icons": {"16": "icon16.png", "128": "icon128.png"}, "action": {"default_icon": {"128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "myownextention@plzacceptme.com"}}}