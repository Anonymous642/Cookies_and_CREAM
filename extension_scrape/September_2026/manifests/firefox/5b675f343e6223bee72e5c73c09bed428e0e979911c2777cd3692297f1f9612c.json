{"manifest_version": 3, "name": "DANE Enforcer", "version": "1.0.0", "description": "Enforces DANE/TLSA validation for HTTPS connections and warns about security issues", "permissions": ["webRequest", "webRequestBlocking", "storage", "activeTab", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["src/pages/blocked/blocked.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "dane-enforcer@localhost", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["vendor/doh.min.js", "src/background/background.js"]}, "options_ui": {"page": "src/pages/settings/settings.html", "open_in_tab": false}, "action": {"default_popup": "src/pages/popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "DANE Enforcer"}, "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}