{"manifest_version": 3, "name": "RedPath - Best Price Finder", "version": "3.6.1", "description": "One search, every store. RedPath sweeps 27 retailers at once and ranks every price cheapest-first. No accounts, no tracking.", "author": "Karen Contreras Cubas", "browser_specific_settings": {"gecko": {"id": "redpath@karenc.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://*.ebay.com/*", "https://api.ebay.com/*", "https://api.bestbuy.com/*", "https://*.amazon.com/*", "https://*.walmart.com/*", "https://*.bestbuy.com/*", "https://*.newegg.com/*", "https://*.target.com/*", "https://*.adorama.com/*", "https://*.costco.com/*", "https://*.homedepot.com/*", "https://*.lowes.com/*", "https://*.staples.com/*", "https://*.officedepot.com/*", "https://*.microcenter.com/*", "https://*.gamestop.com/*", "https://*.etsy.com/*", "https://*.aliexpress.us/*", "https://*.wayfair.com/*", "https://*.kohls.com/*", "https://*.macys.com/*", "https://*.samsclub.com/*", "https://*.chewy.com/*", "https://*.rei.com/*", "https://*.dickssportinggoods.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors 'none'"}}