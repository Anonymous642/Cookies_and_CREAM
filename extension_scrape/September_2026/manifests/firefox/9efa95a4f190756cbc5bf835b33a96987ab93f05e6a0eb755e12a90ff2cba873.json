{"manifest_version": 3, "name": "EasyGrocer", "version": "1.2.3", "description": "Shopping companion that helps you save time at checkout", "permissions": ["cookies", "scripting"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://localhost/*", "https://easygrocer.app/*"], "js": ["content.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "easygrocer@example.com", "strict_min_version": "109.0"}}}