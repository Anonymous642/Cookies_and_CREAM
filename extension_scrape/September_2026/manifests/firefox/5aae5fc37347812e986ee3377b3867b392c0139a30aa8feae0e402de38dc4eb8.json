{"manifest_version": 2, "name": "Particular Cookie & Cache Cleaner", "version": "1.0", "description": "Cookies and cache removal for particular sites with various domain variants support", "permissions": ["cookies", "browsingData", "activeTab", "storage", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "Cookie & Cache Cleaner", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "cookie-cache-cleaner@yourdomain.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}