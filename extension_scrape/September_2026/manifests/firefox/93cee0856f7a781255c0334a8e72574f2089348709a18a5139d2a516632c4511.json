{"manifest_version": 3, "name": "Etyr", "version": "1.0.1", "description": "Understand the web as you read it. A minimalist dictionary that appears when you select text.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_popup": "src/popup/index.html", "default_title": "Etyr \u2014 Understand the web as you read it.", "theme_icons": [{"light": "icons/icon-16.png", "dark": "icons/icon-white-16.png", "size": 16}, {"light": "icons/icon-32.png", "dark": "icons/icon-white-32.png", "size": 32}, {"light": "icons/icon-48.png", "dark": "icons/icon-white-48.png", "size": 48}, {"light": "icons/icon-128.png", "dark": "icons/icon-white-128.png", "size": 128}]}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://freedictionaryapi.com/*", "https://router.huggingface.co/*", "https://generativelanguage.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "etyr@etyr.app", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["websiteContent", "searchTerms"]}}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}}