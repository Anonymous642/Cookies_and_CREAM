{"manifest_version": 3, "name": "Arma Reforger Workshop Mod Info Extractor", "version": "2.0", "description": "Extracts mod info from Arma Reforger workshop pages and lets you build a selectable list for copying as JSON. Mainly build for AMP by Codebuilder.", "browser_specific_settings": {"gecko": {"id": "addons.mozilla.org.lpmyn@passmail.net", "strict_min_version": "109.0"}}, "permissions": ["clipboardWrite", "storage"], "host_permissions": ["https://reforger.armaplatform.com/workshop/*"], "action": {"default_popup": "popup.html", "default_icon": "GetMods.png"}, "content_scripts": [{"matches": ["https://reforger.armaplatform.com/workshop/*"], "js": ["content-script.js"], "run_at": "document_end"}]}