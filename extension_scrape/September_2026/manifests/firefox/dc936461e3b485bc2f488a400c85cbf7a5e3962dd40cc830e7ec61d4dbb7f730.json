{"manifest_version": 2, "name": "LocalNote", "version": "1.0.0", "description": "Searchable note catalog in the browser sidebar. Fully local, no network calls.", "permissions": ["activeTab", "contextMenus", "storage"], "browser_specific_settings": {"gecko": {"id": "localnote@localnote.extension", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "sidebar_action": {"default_title": "LocalNote", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "LocalNote"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+N"}, "description": "Open LocalNote sidebar"}}}