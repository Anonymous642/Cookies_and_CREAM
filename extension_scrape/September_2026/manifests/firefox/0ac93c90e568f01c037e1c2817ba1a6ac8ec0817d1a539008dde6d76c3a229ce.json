{"manifest_version": 3, "name": "NPAV Enterprise Ai Insight", "version": "26.1", "description": "Monitors page content on configured domains and blocks policy-violating content.", "browser_specific_settings": {"gecko": {"id": "npav-ai-insight@npav.net", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "searchTerms"]}}}, "permissions": ["storage", "alarms", "tabs"], "icons": {"16": "icons/16x16px.png", "48": "icons/48x48px.png", "128": "icons/128x128px.png"}, "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "NPAV Enterprise Ai Insight"}}