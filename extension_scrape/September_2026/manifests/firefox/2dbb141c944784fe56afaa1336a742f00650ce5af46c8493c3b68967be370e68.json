{"manifest_version": 3, "default_locale": "en", "name": "UR-Vault Extension", "description": "This extension works in conjunction of the UR-Vault password manager app. This extension provides the ability to autofill usernames and passwords on web pages.The UR-Vault app can be installed from Apple AppStore or Google Playstore.", "version": "1.0.3", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png", "1024": "images/icon-1024.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["content.js"], "matches": ["<all_urls>"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "UR-Vault", "default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "permissions": ["activeTab", "clipboardWrite", "clipboardRead", "storage", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["images/toolbar-icon.svg"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "ur-vault@balajikadambi.com", "data_collection_permissions": {"required": ["none"]}}}}