{"manifest_version": 3, "name": "Seed Oil Tracker", "version": "1.0.0", "description": "See a restaurant's seed oil grade while you browse DoorDash, Uber Eats, Yelp, and Google Maps.", "homepage_url": "https://seedoiltracker.com", "permissions": ["storage", "activeTab"], "host_permissions": ["https://seedoiltracker.com/*"], "content_scripts": [{"matches": ["*://*.doordash.com/*", "*://*.ubereats.com/*", "*://*.yelp.com/*", "*://www.google.com/maps/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Seed Oil Tracker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@seedoiltracker.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}