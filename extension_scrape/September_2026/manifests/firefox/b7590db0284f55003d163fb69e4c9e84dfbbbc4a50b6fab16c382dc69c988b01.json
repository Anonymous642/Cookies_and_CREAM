{"manifest_version": 2, "name": "Bookmark Beat", "version": "1.0", "description": "Plays a short beat when you save a bookmark. Styles: jazz, lo-fi, retro.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["bookmarks", "storage", "notifications", "tabs"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Bookmark Beat", "default_popup": "popup.html"}, "applications": {"gecko": {"id": "bookmarkbeat@example.com"}}}