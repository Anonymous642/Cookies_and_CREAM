{"manifest_version": 3, "name": "Recipe Screener", "version": "1.0.2", "description": "The blog's own recipe card, minus the ads, share rows and newsletter pitches. Plus scaling, metric and a cook mode.", "permissions": ["storage", "activeTab", "declarativeNetRequest"], "declarative_net_request": {"rule_resources": [{"id": "ads", "enabled": false, "path": "rules/ads.json"}, {"id": "trackers", "enabled": false, "path": "rules/trackers.json"}, {"id": "popups", "enabled": false, "path": "rules/popups.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Recipe Screener", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/quantity.js", "src/timers.js", "src/saved.js", "src/quiet.js", "src/native-style.js", "src/site-card.js", "src/extract.js", "src/card.js", "src/content.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["src/frame-quiet.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "recipe-screener@jeremyjudah-sys.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}