{"manifest_version": 3, "name": "MarkShot Screenshot & Screen Recorder", "short_name": "MarkShot", "version": "1.0.2", "description": "Capture screenshots, mark privacy-safe annotations, record screens, create step guides, and export bug reports locally.", "action": {"default_title": "MarkShot", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/action-16.png", "32": "assets/icons/action-32.png", "48": "assets/icons/action-48.png", "128": "assets/icons/action-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "background": {"type": "module", "scripts": ["assets/service-worker.js"]}, "options_page": "src/options/options.html", "permissions": ["activeTab", "tabs", "scripting", "storage", "clipboardWrite", "notifications"], "commands": {"capture-visible": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Capture visible area"}}, "browser_specific_settings": {"gecko": {"id": "markshot@markshot.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}