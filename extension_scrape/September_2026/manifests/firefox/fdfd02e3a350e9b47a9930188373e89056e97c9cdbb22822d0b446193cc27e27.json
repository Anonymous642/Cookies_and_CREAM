{"manifest_version": 2, "name": "Pyxils Download Manager", "short_name": "Pyxils", "version": "1.0.0", "description": "Sends your downloads to Pyxils Download Manager: multi-connection speed, pause and resume that survive anything.", "browser_specific_settings": {"gecko": {"id": "pyxils@pyxils.app", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Pyxils Download Manager", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}}, "background": {"scripts": ["guard-data.js", "guard.js", "background.js"]}, "permissions": ["downloads", "cookies", "contextMenus", "nativeMessaging", "storage", "tabs", "webRequest", "<all_urls>"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["logo-data.js", "content.js"], "run_at": "document_idle", "all_frames": true}]}