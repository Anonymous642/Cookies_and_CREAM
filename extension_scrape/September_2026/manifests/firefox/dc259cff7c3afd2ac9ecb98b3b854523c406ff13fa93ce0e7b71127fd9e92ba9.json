{"manifest_version": 3, "name": "Claude RTL Helper", "version": "1.0.1", "description": "Automatic RTL (right-to-left) support for Claude.ai. Detects Hebrew, Arabic, Persian, and Urdu per paragraph. Code blocks stay LTR.", "permissions": ["storage"], "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"], "content_scripts": [{"matches": ["https://claude.ai/*", "https://*.claude.ai/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup.html", "default_title": "Claude RTL", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "claude-rtl-helper@local.ido", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}