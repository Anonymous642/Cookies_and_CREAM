{"manifest_version": 2, "name": "CookieConsentMate", "version": "1.3.1", "description": "Set your cookie consent preferences once, and never fill in a banner again. CookieConsentMate automatically handles consent banners across the web.", "browser_specific_settings": {"gecko": {"id": "cookieconsentmate@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["src/background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}