{"manifest_version": 3, "name": "Crunchyroll Enhancer", "version": "1.98.25", "description": "Automatically recognizes anime watched on Crunchyroll & other sites, syncs progress with AniList, reminds you of new episodes, and manages series pages.", "browser_specific_settings": {"gecko": {"id": "animetracker-enhancer@vibecode.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "activeTab", "alarms", "notifications", "tabs"], "host_permissions": ["https://*.crunchyroll.com/*", "https://graphql.anilist.co/*", "https://*.hianime.to/*", "https://*.gogoanime.cl/*", "https://*.9animetv.to/*", "https://*.gogoanime3.co/*", "https://*.wcoflix.tv/*", "https://*.wco.tv/*", "https://*.zoroxtv.to/*"], "background": {"scripts": ["background/storage.js", "background/anilist_api.js", "background/background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_title": "Crunchyroll Enhancer"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.crunchyroll.com/*"], "js": ["content_scripts/hud.js", "content_scripts/crunchyroll.js"], "css": ["content_scripts/hud.css"], "all_frames": true, "run_at": "document_end"}, {"matches": ["https://*.hianime.to/*", "https://*.gogoanime.cl/*", "https://*.9animetv.to/*", "https://*.gogoanime3.co/*", "https://*.wcoflix.tv/*", "https://*.wco.tv/*", "https://*.zoroxtv.to/*"], "js": ["content_scripts/hud.js", "content_scripts/generic_anime.js"], "css": ["content_scripts/hud.css"], "run_at": "document_end"}]}