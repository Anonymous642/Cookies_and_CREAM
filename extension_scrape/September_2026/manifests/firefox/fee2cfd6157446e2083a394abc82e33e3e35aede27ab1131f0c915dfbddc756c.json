{"manifest_version": 3, "name": "HoloSubs Chat Bridge", "description": "Connects YouTube chat and experimental Firefox player audio to the HoloSubs workspace.", "version": "0.1.2", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": [], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://holosubs.com/*", "https://www.holosubs.com/*"], "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "HoloSubs Chat Bridge", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["src/page-replay-poller.js"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}], "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*", "https://www.youtube.com/live_chat*", "https://youtube.com/live_chat*"], "js": ["src/youtube-chat-capture.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://holosubs.com/*", "https://www.holosubs.com/*"], "js": ["src/app-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/embed/*", "https://youtube.com/embed/*", "https://www.youtube.com/watch*", "https://youtube.com/watch*"], "js": ["src/firefox-audio-capture.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "holosubs-chat-bridge@holosubs.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}