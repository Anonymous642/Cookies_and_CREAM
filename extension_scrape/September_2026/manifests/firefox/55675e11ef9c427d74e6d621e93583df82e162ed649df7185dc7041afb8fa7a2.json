{"manifest_version": 3, "name": "SlopMute: AI Video Blocker For YouTube", "description": "Reduce AI slop on YouTube with private, local, on-device filtering.", "version": "0.18.4", "browser_specific_settings": {"gecko": {"id": "slopmute@slopmute.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "alarms", "contextMenus"], "host_permissions": ["https://www.youtube.com/*", "https://i.ytimg.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "SlopMute", "default_popup": "src/quick-popup/index.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "options_ui": {"page": "src/popup/index.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["assets/content.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icon-128.png", "src/onboarding/index.html"], "matches": ["https://www.youtube.com/*"]}]}