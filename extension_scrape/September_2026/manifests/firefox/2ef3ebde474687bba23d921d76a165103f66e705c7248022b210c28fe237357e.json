{"manifest_version": 3, "name": "Midnight Mode", "version": "1.0.0", "description": "Gives your OLED screen the true blacks it's capable of. Fixes gray letterbox bars and washed-out dark scenes in web video \u2014 no more dim glow where black should be.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_title": "Midnight Mode", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "{d185b442-f4cf-4c34-bd91-4d528aacaf0c}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}