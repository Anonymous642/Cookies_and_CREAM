{"manifest_version": 3, "name": "Browser Lock", "version": "1.0.0", "description": "Lock your browser with password, security questions, and timed recovery.", "author": "Komoid", "homepage_url": "https://www.komoid.com", "permissions": ["tabs", "storage", "alarms"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Browser Lock", "default_icon": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}}, "icons": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "commands": {"lock-browser": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock the browser"}}, "browser_specific_settings": {"gecko": {"id": "browser-lock@komoid.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}