{"manifest_version": 3, "name": "Canvas Due Date Shifter", "version": "1.2.2", "description": "Displays Canvas due dates shifted by a random number of hours (stable per assignment). Display-only: never changes real deadlines.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Canvas Due Date Shifter"}, "browser_specific_settings": {"gecko": {"id": "{2870cd50-30eb-4598-929d-30765d5019b2}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.instructure.com/*", "https://*.canvas.com/*"], "js": ["defaults.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}