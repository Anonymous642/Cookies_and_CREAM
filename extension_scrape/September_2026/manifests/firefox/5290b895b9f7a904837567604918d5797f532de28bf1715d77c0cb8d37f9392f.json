{"manifest_version": 2, "name": "Twitch Ad Blackout", "version": "1.0", "description": "Mutes the tab during Twitch ads and overlays a black screen to hide them.", "browser_specific_settings": {"gecko": {"id": "twitch-ad-blackout@maui.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["*://*.twitch.tv/*"], "icons": {"16": "images/TwitchAdBlackout.svg", "32": "images/TwitchAdBlackout.svg", "48": "images/TwitchAdBlackout.svg", "96": "images/TwitchAdBlackout.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}]}