{"manifest_version": 3, "name": "Sonrai Cloud Permissions Firewall", "version": "0.31.0", "description": "Least privilege shouldn't slow you down. See your Cloud Permissions Firewall access and request what you need\u2014right in your browser.", "background": {"scripts": ["background.js", "background-azure.js"]}, "browser_specific_settings": {"gecko": {"id": "{c4341964-a084-5882-bdff-873545b00b36}", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://console.cloud.google.com/*"], "js": ["helper.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://console.aws.amazon.com/*", "https://*.console.aws.amazon.com/*"], "js": ["helper.js", "content-aws.js"], "css": ["styles.css"], "run_at": "document_idle"}, {"matches": ["https://portal.azure.com/*"], "js": ["helper.js", "content-azure.js"], "css": ["styles.css"], "run_at": "document_idle"}], "permissions": ["storage", "identity", "webRequest", "alarms"], "host_permissions": ["https://*.sonraisecurity.com/*", "https://*.amazonaws.com/*", "https://*.aws.amazon.com/*", "https://management.azure.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}