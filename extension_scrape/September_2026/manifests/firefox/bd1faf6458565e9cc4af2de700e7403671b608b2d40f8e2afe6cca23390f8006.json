{"manifest_version": 2, "name": "AutoTwitchOpener", "version": "1.0.0", "description": "Automatically opens Twitch streams when your favorite streamers go live. Monitor multiple streamers and never miss a stream!", "browser_specific_settings": {"gecko": {"id": "autotwitchopener@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "tabs", "notifications", "identity", "https://api.twitch.tv/*", "https://id.twitch.tv/*"], "background": {"scripts": ["browser-polyfill.js", "background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}