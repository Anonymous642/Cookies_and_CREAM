{"manifest_version": 3, "name": "Cipher \u2014 Password Manager", "version": "1.0.0", "description": "Autofill credentials from your Cipher vault. Zero-knowledge, local-first.", "author": "ISSEI", "browser_specific_settings": {"gecko": {"id": "cipher-password-manager@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "key": "", "permissions": ["nativeMessaging", "activeTab", "clipboardWrite", "storage"], "icons": {"16": "icons/cipher-16.png", "32": "icons/cipher-32.png", "48": "icons/cipher-48.png", "128": "icons/cipher-128.png"}, "action": {"default_icon": {"16": "icons/cipher-16.png", "32": "icons/cipher-32.png"}, "default_popup": "popup/popup.html", "default_title": "Cipher"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/autofill.js"], "run_at": "document_idle"}]}