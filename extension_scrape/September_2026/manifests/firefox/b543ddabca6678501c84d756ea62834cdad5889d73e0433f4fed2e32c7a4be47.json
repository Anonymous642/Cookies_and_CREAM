{"manifest_version": 3, "name": "Indeed Sponsored Hider", "version": "1.0.0", "description": "Blendet gesponserte (promoted) Jobanzeigen bei Indeed aus, damit nur organische Treffer sichtbar bleiben.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Indeed Sponsored Hider"}, "content_scripts": [{"matches": ["*://*.indeed.com/*", "*://de.indeed.com/*", "*://*.indeed.de/*", "*://at.indeed.com/*", "*://*.indeed.at/*", "*://ch.indeed.com/*"], "run_at": "document_start", "css": ["hide.css"], "js": ["content.js"]}], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "indeed-sponsored-hider@stream.tools", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}