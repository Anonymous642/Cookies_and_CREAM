{"manifest_version": 3, "name": "TabLoop", "version": "1.2.2", "description": "Limit your open tabs and close the tab loop.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "index.html"}, "options_ui": {"page": "src/options.html", "open_in_tab": true}, "background": {"scripts": ["src/background.js"], "type": "module"}, "permissions": ["storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "tabloop@mtl.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}