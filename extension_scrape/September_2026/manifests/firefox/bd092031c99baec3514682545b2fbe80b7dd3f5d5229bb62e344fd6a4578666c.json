{"manifest_version": 2, "name": "Regex Tab Router", "version": "2.1", "description": "Automatically move tabs to specific tab groups based on regex URL patterns", "author": "urmish", "developer": {"name": "urmish", "url": "https://github.com/surmish"}, "browser_specific_settings": {"gecko": {"id": "regex-tab-router@surmish.github.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabGroups", "storage", "webNavigation", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "Regex Tab Router", "default_popup": "popup.html"}, "icons": {"96": "icon.png"}}