{"manifest_version": 2, "name": "Scout - Online Accountability", "version": "1.2.5", "description": "Monitors only user-listed websites and emails screenshots to a chosen accountability partner.", "permissions": ["<all_urls>", "tabs", "storage", "alarms", "https://scout-accountability.vercel.app/*"], "background": {"scripts": ["config.js", "site-rules.js", "monitoring-url-rules.js", "monitoring-site-filter.js", "background.js"], "persistent": true}, "options_page": "options.html", "browser_action": {"default_popup": "popup.html"}, "icons": {"16": "icons/pawprint.png", "48": "icons/scout.png", "128": "icons/scout.png"}, "web_accessible_resources": ["style.css", "options.js", "options-loader.js", "icons/*"], "browser_specific_settings": {"gecko": {"id": "scout-accountability@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity", "personalCommunications"], "optional": []}}}}