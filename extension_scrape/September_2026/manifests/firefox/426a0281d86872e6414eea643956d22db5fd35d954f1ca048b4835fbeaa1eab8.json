{"manifest_version": 3, "name": "Joply", "description": "Turn any job posting you're viewing into a tailored-ready Joply job in one click.", "version": "1.0.1", "action": {"default_title": "Joply", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://joply.co/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "joply@joply.co", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}