{"manifest_version": 3, "name": "TradeMac", "version": "0.7.2", "description": "Auto-relist Traderie listings older than a configurable threshold. Loads all listings first.", "permissions": ["scripting", "activeTab", "storage", "alarms"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://*.traderie.com/*", "https://generativelanguage.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "traderie-macro-v3@tiltedblock", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://traderie.com/*", "https://www.traderie.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}