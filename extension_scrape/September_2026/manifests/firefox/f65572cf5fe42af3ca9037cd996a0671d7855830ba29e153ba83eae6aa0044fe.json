{"manifest_version": 3, "name": "Sidepage", "version": "1.0.0", "description": "Display a configurable home page in the Firefox sidebar", "icons": {"48": "side-view.png", "96": "side-view.png"}, "author": "Cameron Monagle <cm@cameronmonagle.com>", "homepage_url": "https://github.com/cmonagle/sidepage/", "browser_specific_settings": {"gecko": {"id": "sidepage@cameronmonagle.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "side-view.svg", "default_title": "Open Sidepage"}, "sidebar_action": {"default_icon": "side-view.svg", "default_title": "Sidepage", "default_panel": "sidebar.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage"]}