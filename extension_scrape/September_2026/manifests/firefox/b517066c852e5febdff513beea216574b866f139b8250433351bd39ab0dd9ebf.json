{"manifest_version": 3, "name": "LineTrack PDF", "version": "0.2.2", "description": "Keep your place in PDFs and web pages: color each text line, reading ruler, focus mode and readable themes.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "linetrack-pdf@linetrack.addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "permissions": ["storage", "webRequest", "webRequestBlocking", "activeTab", "scripting"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "LineTrack PDF", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"toggle-coloring": {"suggested_key": {"default": "Alt+L"}, "description": "Toggle line coloring"}, "cycle-mode": {"suggested_key": {"default": "Alt+M"}, "description": "Cycle tracking mode"}, "toggle-dark": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle dark PDF theme"}, "next-profile": {"suggested_key": {"default": "Alt+P"}, "description": "Switch to next profile"}}, "web_accessible_resources": [{"resources": ["viewer/viewer.html"], "matches": ["http://*/*", "https://*/*"]}, {"resources": ["shared/*.js", "web/*.js"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; form-action 'none'"}}