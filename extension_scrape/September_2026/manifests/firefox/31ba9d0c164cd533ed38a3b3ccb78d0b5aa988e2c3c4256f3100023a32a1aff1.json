{"manifest_version": 3, "name": "Shouldn't You Be Working?", "version": "1.0.0", "description": "A speedbump extension that prompts you with questions before visiting distracting websites", "browser_specific_settings": {"gecko": {"id": "shouldnt-you-be-working@gomideleo.github.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "webNavigation", "alarms"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["timer.js"], "css": ["timer.css"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}