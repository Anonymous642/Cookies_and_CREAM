{"manifest_version": 3, "name": "Open with Purify", "version": "2.13", "description": "Open YouTube videos with Purify Video", "browser_specific_settings": {"gecko": {"id": "open-with-purify@silver.mazz", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["contextMenus", "storage", "tabs", "browsingData"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open with Purify", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "commands": {"open-current-in-purify": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open the current YouTube video with Purify"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "host_permissions": ["*://purify.video/*", "*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "content_scripts": [{"matches": ["*://purify.video/*"], "js": ["cleaner.js"], "run_at": "document_start"}, {"matches": ["*://purify.video/watch*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://*.youtube.com/embed/*", "*://*.youtube-nocookie.com/embed/*", "*://*.youtube.com/watch*"], "js": ["player.js"], "all_frames": true, "run_at": "document_end"}]}