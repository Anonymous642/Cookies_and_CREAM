{"manifest_version": 3, "name": "Speed Reader", "version": "2.0.0", "description": "Speed-read the web", "homepage_url": "https://codeberg.org/sterre/extension-speed-reader", "icons": {"48": "icons/speed-reader-logo.svg", "96": "icons/speed-reader-logo.svg"}, "permissions": ["contextMenus", "activeTab", "storage", "scripting"], "action": {"default_icon": "icons/speed-reader-logo.svg", "default_title": "Speed Reader"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Alt+U"}, "description": "Speed-read the selected text"}}, "background": {"scripts": ["build/extension.js"], "service_worker": "build/extension.js"}, "options_ui": {"page": "build/settings.html"}, "browser_specific_settings": {"gecko": {"id": "speed-reader@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}