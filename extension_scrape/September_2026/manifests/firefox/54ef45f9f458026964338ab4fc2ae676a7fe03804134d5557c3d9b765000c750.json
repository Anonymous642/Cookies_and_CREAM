{"manifest_version": 3, "name": "RollerCoin Hashrate Lens", "version": "0.5.0", "description": "Mant\u00e9m os hashrates do RollerCoin numa unidade escolhida.", "browser_specific_settings": {"gecko": {"id": "rollercoin-hashrate-lens@github.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "action": {"default_title": "Hashrate Lens", "default_popup": "popup.html", "default_icon": {"32": "assets/icon-128.png", "64": "assets/icon-128.png"}}, "icons": {"32": "assets/icon-128.png", "64": "assets/icon-128.png", "128": "assets/icon-128.png"}, "content_scripts": [{"matches": ["https://rollercoin.com/*", "https://*.rollercoin.com/*"], "js": ["src/converter.js", "src/content.js"], "run_at": "document_idle"}]}