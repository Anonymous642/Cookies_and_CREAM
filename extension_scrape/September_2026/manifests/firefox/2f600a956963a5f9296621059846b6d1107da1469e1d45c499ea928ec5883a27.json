{"manifest_version": 3, "name": "ResearchWize", "description": "Capture and analyze sources, keep a local Browser Library, and continue into the Research Workspace for Evidence Plans.", "version": "2.3.4", "action": {"default_title": "Open ResearchWize", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup_notice.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "identity", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["https://researchwize.com/*", "https://www.researchwize.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://researchwize.com https://www.researchwize.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; worker-src 'self'; media-src 'self' blob:"}, "sidebar_action": {"default_title": "Open ResearchWize", "default_panel": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "researchwize@rw.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}