{"manifest_version": 3, "name": "SAS EuroBonus Shopping Helper", "version": "1.0", "description": "Alerts you when the current website has an affiliated SAS EuroBonus shopping link so you can earn points.", "permissions": ["activeTab", "tabs", "storage", "scripting", "alarms"], "host_permissions": ["https://onlineshopping.flysas.com/*", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "SAS EuroBonus Shopping Helper"}, "content_scripts": [{"matches": ["https://onlineshopping.flysas.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://onlineshopping.flysas.com/*"], "js": ["notify.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "sas-eurobonus-helper@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}}