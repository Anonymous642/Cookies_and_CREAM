{"manifest_version": 3, "name": "Channel Find - YouTube Stats Viewer", "browser_specific_settings": {"gecko": {"id": "support@channelfind.com", "strict_min_version": "58.0"}}, "version": "1.0.1", "description": "Provides YouTube channel insights, including average views, monthly income, and sponsorship estimates, directly on the video page", "host_permissions": ["https://*.youtube.com/*", "https://api.channelfind.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "web_accessible_resources": [{"resources": ["assets/logo.png", "assets/favicon.ico"], "matches": ["*://*.youtube.com/*"]}], "icons": {"16": "assets/favicon-16.png", "32": "assets/favicon-32.png", "48": "assets/favicon-48.png"}}