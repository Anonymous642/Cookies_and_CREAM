{"manifest_version": 3, "name": "ContentLogger", "version": "0.2.1", "description": "Logs Content URLs", "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["general.js"]}, {"matches": ["*://*.reddit.com/*"], "js": ["reddit.js"]}], "action": {"default_icon": {"16": "icons/White-Clipboard-16.png"}, "default_popup": "popup/popup.html", "default_title": "ContentLogger", "theme_icons": [{"light": "icons/Black-Clipboard.png", "dark": "icons/White-Clipboard.png", "size": 32}, {"light": "icons/Black-Clipboard-16.png", "dark": "icons/White-Clipboard-16.png", "size": 16}]}, "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "clipboardRead", "scripting", "webRequest", "downloads"], "browser_specific_settings": {"gecko": {"id": "@contenlogger", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}}