{"manifest_version": 2, "name": "SnippetFire", "version": "1.1.0", "description": "Fast text expansion with paragraph support. Type a keyword, get your full text instantly. Works with Claude.ai, Notion, Slack, and all text fields.", "author": "Robin", "permissions": ["storage"], "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'", "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "browser_specific_settings": {"gecko": {"id": "snippetfire@robin.vlinder", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}