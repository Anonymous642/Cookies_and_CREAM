{"manifest_version": 3, "name": "Corral", "version": "1.0.1", "description": "Right-click-drag a marquee box over a page to extract hyperlinks, then open them in manageable batches.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Corral"}, "browser_specific_settings": {"gecko": {"id": "corral@yourdomain-or-handle.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}