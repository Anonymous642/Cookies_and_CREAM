{"manifest_version": 3, "name": "MemoryTab Quiz", "description": "Enhance cognitive recall and focus by testing your knowledge of open browser tabs through interactive memory quizzes.", "version": "1.0.0", "author": "MindSpring Lab", "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "memorytabquiz@mindspringlab.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}