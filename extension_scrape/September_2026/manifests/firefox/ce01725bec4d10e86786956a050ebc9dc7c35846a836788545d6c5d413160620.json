{"manifest_version": 2, "name": "ChatGPT Archivio Completo", "version": "2.0.1", "description": "Esporta la chat ChatGPT aperta senza scorrere: testi, rami, JSON e media in un unico ZIP locale.", "permissions": ["activeTab", "tabs", "downloads", "webRequest", "webRequestBlocking", "storage", "unlimitedStorage", "https://chatgpt.com/*", "https://*.oaiusercontent.com/*", "https://*.openai.com/*", "https://*.blob.core.windows.net/*", "https://*.azureedge.net/*"], "background": {"scripts": ["archive-core.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Archivia questa chat ChatGPT", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "chatgpt-archivio-completo@paolino.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}