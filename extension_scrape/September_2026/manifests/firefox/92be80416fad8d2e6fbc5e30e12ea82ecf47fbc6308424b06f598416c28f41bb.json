{"manifest_version": 3, "name": "ContactCue Desk", "version": "1.0.0", "description": "Extract public contact cues from the active page into a local contact sheet for review and export.", "browser_specific_settings": {"gecko": {"id": "contactcue-desk@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "clipboardWrite", "menus", "scripting", "storage", "tabs"], "background": {"scripts": ["shared/constants.js", "shared/browser.js", "shared/contactTools.js", "shared/storage.js", "background.js"]}, "action": {"default_title": "ContactCue Desk", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"extract-contact-cues": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Extract contact cues from the active page"}, "open-contactcue-directory": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Open ContactCue directory"}}, "icons": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}