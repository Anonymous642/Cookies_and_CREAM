{"manifest_version": 3, "name": "GRSize", "version": "1.2", "description": "See GitHub repository sizes before you clone.", "icons": {"32": "icon_32.png", "64": "icon_64.png", "128": "icon_128.png"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"]}], "permissions": ["storage"], "host_permissions": ["https://api.github.com/*", "https://github.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"32": "icon_32.png", "64": "icon_64.png", "128": "icon_128.png"}}, "web_accessible_resources": [{"resources": ["icon_32.png"], "matches": ["https://github.com/*"]}], "browser_specific_settings": {"gecko": {"id": "grsize@pluvivanto.win", "data_collection_permissions": {"required": ["none"]}}}}