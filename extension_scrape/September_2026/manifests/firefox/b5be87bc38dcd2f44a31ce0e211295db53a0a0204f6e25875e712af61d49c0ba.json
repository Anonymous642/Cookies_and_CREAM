{"manifest_version": 3, "name": "Quietly: Full Page Screenshot and Blur", "short_name": "Quietly", "version": "0.8.53", "description": "Full page screenshots that work on the dashboards other tools get wrong. Blur or black out anything private before you share.", "browser_specific_settings": {"gecko": {"id": "quietly@quietly.tools", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}}, "permissions": ["contextMenus", "storage", "activeTab", "notifications", "tabs", "scripting", "unlimitedStorage", "clipboardWrite"], "host_permissions": ["https://quietly.tools/*", "https://www.quietly.tools/*"], "action": {"default_title": "Quietly", "default_icon": {"16": "icons/quietly-icon-16.png", "32": "icons/quietly-icon-32.png", "48": "icons/quietly-icon-48.png", "128": "icons/quietly-icon-128.png"}}, "icons": {"16": "icons/quietly-icon-16.png", "32": "icons/quietly-icon-32.png", "48": "icons/quietly-icon-48.png", "128": "icons/quietly-icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Quietly", "default_icon": {"16": "icons/quietly-icon-16.png", "32": "icons/quietly-icon-32.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Z"}}, "capture-screenshot": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Open the screenshot choice card on the active tab"}}, "omnibox": {"keyword": "qt"}, "content_scripts": [{"matches": ["https://quietly.tools/*", "https://www.quietly.tools/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle"}]}