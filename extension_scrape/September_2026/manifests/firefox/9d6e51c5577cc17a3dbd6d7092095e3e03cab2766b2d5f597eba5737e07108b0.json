{"manifest_version": 3, "name": "Shortform Blocker", "version": "0.1.0", "description": "Blocks shortform content platforms and removes YouTube Shorts.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://tiktok.com/*", "https://*.tiktok.com/*", "https://m.tiktok.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://m.instagram.com/*", "https://facebook.com/*", "https://*.facebook.com/*", "https://m.facebook.com/*", "https://snapchat.com/*", "https://*.snapchat.com/*", "https://m.snapchat.com/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "shortsblocker@local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Shortform Blocker", "default_popup": "options/options.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://tiktok.com/*", "https://*.tiktok.com/*", "https://m.tiktok.com/*", "https://instagram.com/*", "https://*.instagram.com/*", "https://m.instagram.com/*", "https://facebook.com/*", "https://*.facebook.com/*", "https://m.facebook.com/*", "https://snapchat.com/*", "https://*.snapchat.com/*", "https://m.snapchat.com/*"], "js": ["content/content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.js", "blocked/blocked.css"], "matches": ["<all_urls>"]}]}