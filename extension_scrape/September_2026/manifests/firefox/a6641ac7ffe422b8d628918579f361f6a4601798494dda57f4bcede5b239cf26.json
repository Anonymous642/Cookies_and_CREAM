{"manifest_version": 3, "name": "CS2 3D Inspector (skinview.gg)", "version": "1.0.7", "description": "View Steam, CSFloat & CS.Money listings in-game in your browser. An Inspect button opens the skinview.gg skin inspector overlay.", "homepage_url": "https://skinview.gg", "browser_specific_settings": {"gecko": {"id": "@skinview-cs2-3d-inspector", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "CS2 3D Inspector", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://csfloat.com/*", "https://*.csfloat.com/*"], "js": ["csfloat-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://csfloat.com/*", "https://*.csfloat.com/*"], "js": ["overlay.js", "csfloat.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"matches": ["https://cs.money/*", "https://*.cs.money/*"], "js": ["csmoney-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://cs.money/*", "https://*.cs.money/*"], "js": ["overlay.js", "csmoney.js"], "css": ["overlay.css"], "run_at": "document_idle"}, {"matches": ["https://steamcommunity.com/market/*"], "js": ["steam-inject.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://steamcommunity.com/market/*"], "js": ["overlay.js", "steam.js"], "css": ["overlay.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon.svg"], "matches": ["https://csfloat.com/*", "https://*.csfloat.com/*", "https://cs.money/*", "https://*.cs.money/*", "https://steamcommunity.com/*"]}]}