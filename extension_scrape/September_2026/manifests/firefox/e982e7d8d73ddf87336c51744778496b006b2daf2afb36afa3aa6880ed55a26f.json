{"manifest_version": 3, "name": "LayrSlayr", "version": "1.0.0", "description": "A DevTools extension to inspect Google Analytics (GA4/UA) and dataLayer events in real-time.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["webRequest", "tabs", "storage"], "host_permissions": ["*://*.google-analytics.com/*", "*://*.analytics.google.com/*", "*://*.googletagmanager.com/*", "*://*.stats.g.doubleclick.net/*", "http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["<all_urls>"]}], "devtools_page": "devtools.html", "browser_specific_settings": {"gecko": {"id": "layrslayr@devtools.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}