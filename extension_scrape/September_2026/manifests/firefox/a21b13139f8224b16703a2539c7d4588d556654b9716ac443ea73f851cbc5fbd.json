{"manifest_version": 2, "name": "Pixel Pond Animated Theme", "version": "1.0.0", "description": "A tranquil pixel-art animated koi pond theme for Firefox. Features 6 atmospheric palettes with seamless 16-frame loops, drifting snow, expanding water ripples, and sleek dark browser styling.", "author": "dwaip", "permissions": ["theme", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Pixel Pond Settings", "default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pixel-pond@hawkdotdev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}