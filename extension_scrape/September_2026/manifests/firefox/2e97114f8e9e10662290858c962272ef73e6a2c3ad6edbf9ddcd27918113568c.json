{"manifest_version": 3, "name": "YouTube Undo Seek", "version": "2.0", "description": "Adds an undo button to YouTube player to go back to the previous positions after accidental seeking.", "icons": {"720": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-undo-seek@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "permissions": ["storage"]}