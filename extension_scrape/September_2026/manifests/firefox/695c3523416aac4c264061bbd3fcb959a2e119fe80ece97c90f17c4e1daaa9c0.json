{"manifest_version": 3, "name": "3MF to U1 - Universal Snapmaker Converter", "version": "1.1.5", "description": "Converts .3mf downloads from any site to Snapmaker U1 format. Supports Bambu Lab, PrusaSlicer, and standard 3MF.", "permissions": ["downloads", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/lib/file-store.js", "src/service-worker.js"]}, "content_scripts": [{"matches": ["https://makerworld.com/*", "https://*.makerworld.com/*", "https://www.printables.com/*", "https://www.thingiverse.com/*"], "js": ["src/content-script.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "3MF to U1 Converter"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["vendor/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "3mf-to-u1@ericreid.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}}