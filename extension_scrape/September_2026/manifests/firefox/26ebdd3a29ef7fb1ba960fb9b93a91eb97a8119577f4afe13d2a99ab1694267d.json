{"manifest_version": 3, "name": "Montro", "version": "1.5.1", "description": "Track SaaS usage organization-wide. Syncs with your Montro account for apps, insights, compliance, and governance.", "permissions": ["tabs", "storage", "idle"], "host_permissions": ["<all_urls>", "https://appapi.montro.io/*", "https://betaappapi.montro.io/*", "https://devappapi.montro.io/*", "http://localhost:3008/*", "http://127.0.0.1:3008/*"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://app.montro.io/*", "https://montro.io/*", "https://betaapp.montro.io/*", "https://beta.montro.io/*", "https://devapp.montro.io/*", "https://dev.montro.io/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"], "js": ["config.js", "getToken.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["application_logo/default.svg"], "matches": ["https://*.montro.io/*", "http://localhost/*"]}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Montro SaaS Tracker", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "montro-saas-tracker@montro.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "personallyIdentifyingInfo", "authenticationInfo"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}