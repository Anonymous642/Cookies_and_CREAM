{"manifest_version": 2, "name": "YouTube Shorts Cleaner", "version": "1.1", "description": "Redirects YouTube Shorts to normal watch pages and removes Shorts blocks from the home feed.", "author": "Not Exist", "icons": {"16": "assets/logo_16x16.png", "32": "assets/logo_32x32.png", "48": "assets/logo_48x48.png", "96": "assets/logo_96x96.png", "128": "assets/logo_128x128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/content.js"], "run_at": "document_start"}], "browser_action": {"default_title": "YouTube Shorts Cleaner", "default_icon": {"16": "assets/logo_16x16.png", "32": "assets/logo_32x32.png", "48": "assets/logo_48x48.png", "96": "assets/logo_96x96.png", "128": "assets/logo_128x128.png"}, "default_popup": "popup/popup.html"}, "permissions": ["storage", "https://www.youtube.com/*", "https://youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "anti-youtube-shorts@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}