{"manifest_version": 2, "name": "Auto-Fill", "version": "1.1", "description": "Auto-fills form fields using stored values.", "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "commands": {"run-autofill": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Run autofill"}}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "ai-autofill-tester@yourdomain.com"}}}