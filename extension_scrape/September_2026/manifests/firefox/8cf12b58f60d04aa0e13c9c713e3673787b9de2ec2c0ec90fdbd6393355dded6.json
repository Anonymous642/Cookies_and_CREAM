{"manifest_version": 2, "name": "Zero Speed Dial", "version": "1.0.0", "description": "A clean, customizable Speed Dial for quick access to your favorite sites from every new tab.", "icons": {"32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["storage", "tabs", "webNavigation", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "@zero-speed-dial.dyzrol", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}