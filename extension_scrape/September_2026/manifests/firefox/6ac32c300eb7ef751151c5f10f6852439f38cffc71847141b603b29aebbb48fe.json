{"manifest_version": 3, "name": "Tab Vault", "version": "1.7.4", "description": "Archive inactive Firefox tabs locally and restore them when you are ready.", "permissions": ["alarms", "clipboardWrite", "menus", "storage", "tabs", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["shared.js", "background.js"]}, "action": {"default_title": "Open Tab Vault", "default_icon": "icons/icon.svg"}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"archive-current-tab": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Archive the current tab"}}, "browser_specific_settings": {"gecko": {"id": "tab-vault@local.invalid", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}