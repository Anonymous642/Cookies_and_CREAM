{"manifest_version": 3, "author": "deron", "name": "Brave Search (Local Results Disabled)", "description": "Configures Brave Search as the default search engine and does not show local results.", "version": "1.0.0", "icons": {"16": "icons/brave_16x16.png", "32": "icons/brave_32x32.png", "48": "icons/brave_48x48.png", "64": "icons/brave_64x64.png", "128": "icons/brave_128x128.png"}, "browser_specific_settings": {"gecko": {"id": "brave-search-extension-fork@deron.dev", "strict_min_version": "136.0"}, "gecko_android": {}}, "chrome_settings_overrides": {"search_provider": {"favicon_url": "icons/brave_64x64.png", "name": "Brave", "keyword": "brave", "encoding": "UTF-8", "search_url": "https://search.brave.com/search?show_local=0&q={searchTerms}", "suggest_url": "https://search.brave.com/api/suggest?q={searchTerms}", "is_default": true}}}