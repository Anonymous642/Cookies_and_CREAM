{"manifest_version": 2, "name": "Zen Tabs Bridge", "version": "0.1.0", "description": "Connects Zen Browser tabs to the local Codex Zen Tabs plugin.", "permissions": ["tabs", "storage", "sessions", "http://127.0.0.1:38741/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Zen Tabs Bridge", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "zen-tabs-bridge@local.codex", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'"}