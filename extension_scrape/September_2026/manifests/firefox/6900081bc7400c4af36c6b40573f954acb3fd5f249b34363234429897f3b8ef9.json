{"manifest_version": 3, "name": "Pop Me Up", "version": "7", "description": "Open links in a popup window \u2014 automatically, via middle-click, or right-click context menu.", "browser_specific_settings": {"gecko": {"id": "popmeup@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["contextMenus", "storage", "activeTab", "tabs"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}