{"manifest_version": 2, "name": "IconicChat", "version": "2.0.17", "description": "Chat with your favorite icons, celebrities, and groups from any webpage", "browser_specific_settings": {"gecko": {"id": "extension@iconicchat.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "tabs", "https://iconicchat.ai/*", "https://www.iconicchat.ai/*", "https://iconicchat.com/*", "https://www.iconicchat.com/*"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_end"}], "web_accessible_resources": ["assets/*", "content/*", "lib/*"]}