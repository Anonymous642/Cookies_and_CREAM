{"manifest_version": 2, "name": "Custom New Tab", "version": "1.0.0", "description": "Set any URL or local HTML file as your new tab page.", "author": "GAMESHOOT", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs"], "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Custom New Tab Settings", "default_popup": "options.html"}, "browser_specific_settings": {"gecko": {"id": "custom-new-tab@gameshoot", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}