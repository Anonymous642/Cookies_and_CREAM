{"manifest_version": 3, "name": "Atlas", "version": "3.33.2", "description": "Save bookmarks to Atlas.", "browser_specific_settings": {"gecko": {"id": "ltf-atlas@ltf", "data_collection_permissions": {"required": ["bookmarksInfo", "personallyIdentifyingInfo", "websiteContent"]}}}, "icons": {"16": "icons/icon-complete-16.png", "32": "icons/icon-complete-32.png", "48": "icons/icon-complete-48.png", "96": "icons/icon-complete-96.png", "128": "icons/icon-complete-128.png"}, "permissions": ["activeTab", "contextMenus", "notifications", "scripting", "storage", "tabs"], "host_permissions": ["https://atlas.latinof.com/*", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/toast.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["auth-callback.html", "auth-callback.js"], "matches": ["https://atlas.latinof.com/*"]}], "action": {"default_title": "Atlas - save this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-blue-16.png", "32": "icons/icon-blue-32.png", "48": "icons/icon-blue-48.png", "96": "icons/icon-blue-96.png"}}, "background": {"scripts": ["background/background.js"], "type": "module"}, "options_ui": {"page": "options/options.html"}, "commands": {"save-current-page": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Save the current page to Atlas"}}}