{"manifest_version": 2, "name": "TabSaurus Search", "version": "0.1.0", "description": "Search all open Firefox tabs by title or URL and jump to the selected tab.", "browser_specific_settings": {"gecko": {"id": "tabsaurus-search@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs"], "browser_action": {"default_title": "Open TabSaurus Search", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "sidebar_action": {"default_title": "TabSaurus Search", "default_panel": "sidebar.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}}