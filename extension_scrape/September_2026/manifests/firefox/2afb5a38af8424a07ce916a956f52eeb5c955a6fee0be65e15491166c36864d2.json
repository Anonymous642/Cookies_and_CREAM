{"manifest_version": 3, "name": "CleanFeed", "version": "0.7.5", "description": "Collaborative Twitter banlists and automatic feed cleaning", "default_locale": "en", "permissions": ["alarms", "tabs"], "host_permissions": ["https://twitter.com/*", "https://x.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "cleanfeed@lucyjojo.me", "strict_min_version": "150.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "150.0"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/twitter.js"], "run_at": "document_idle"}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["content/id-stamper.js"], "run_at": "document_idle", "world": "MAIN"}], "web_accessible_resources": [{"resources": ["storage/count-min.js", "dom/selectors.js", "dom/identity.js", "dom/health-monitor.js"], "matches": ["https://twitter.com/*", "https://x.com/*"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "ui/popup/index.html", "default_title": "CleanFeed", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}