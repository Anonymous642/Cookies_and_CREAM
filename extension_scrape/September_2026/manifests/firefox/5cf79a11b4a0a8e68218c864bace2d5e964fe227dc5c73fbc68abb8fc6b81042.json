{"manifest_version": 3, "name": "CleanPix - Privacy-First Image Studio", "version": "1.0.0", "description": "100% Local Privacy-First Background Remover, Replacer, and Image Resizer for Firefox. Zero external APIs, zero data tracking.", "author": "CleanPix Open Source Team", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "CleanPix Image Studio", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage", "alarms", "downloads"], "browser_specific_settings": {"gecko": {"id": "cleanpix-studio-app@addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}