{"manifest_version": 3, "name": "Radar Carros OLX", "version": "1.0.2", "description": "Monitora buscas da OLX na sess\u00e3o real do Firefox e envia ao Telegram dados dos an\u00fancios novos e redu\u00e7\u00f5es de pre\u00e7o configuradas pelo usu\u00e1rio.", "permissions": ["alarms", "storage", "tabs", "scripting"], "host_permissions": ["https://www.olx.com.br/*", "https://go.olx.com.br/*", "https://api.telegram.org/*"], "background": {"scripts": ["defaults.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.olx.com.br/*", "https://go.olx.com.br/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Radar Carros OLX", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "radar-carros-olx@projetoyuri.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "searchTerms", "websiteContent"]}}}}