{"manifest_version": 3, "name": "Crazy Enhancer for YouTube", "version": "16.11", "description": "Quick download button, one-click transcript copy, and quick-access playback-speed controls for YouTube videos, Shorts, and Music. Only download content you have the rights to.", "author": "CrazySoftware (CrazyEntertainment)", "browser_specific_settings": {"gecko": {"id": "crazy-enhancer-for-youtube@crazysoftware.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "Crazy Enhancer for YouTube", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["settings.js", "content.js"], "run_at": "document_idle", "all_frames": false}]}