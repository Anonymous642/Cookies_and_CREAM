{"manifest_version": 2, "name": "YouTube Timestamped Screenshot", "version": "1.0", "description": "Take screenshots of YouTube videos with timestamp in filename", "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-screenshot@example.com"}}, "options_ui": {"page": "options.html", "browser_style": true}, "permissions": ["activeTab", "downloads", "storage", "*://*.youtube.com/*"], "browser_action": {"default_icon": "icon.png", "default_title": "Take YouTube Screenshot"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}]}