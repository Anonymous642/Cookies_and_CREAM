{"manifest_version": 3, "name": "SmartTranslator", "version": "1.1.3", "description": "Text selection translation with caching, language detection, hotkeys, and custom endpoints", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"translate-selection": {"suggested_key": {"default": "Ctrl+Shift+T", "mac": "Command+Shift+T"}, "description": "Translate selected text"}, "translate-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Translate the whole page (toggle)"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_end", "all_frames": true}], "background": {"scripts": ["background/background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "action": {"default_popup": "options/options.html", "default_title": "Translation Settings"}, "icons": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "browser_specific_settings": {"gecko": {"id": "hululu_hululu@outlook.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}