{"manifest_version": 3, "name": "Gemini Canvas Finder", "version": "1.5.2", "description": "A popup to manage and switch between Gemini Canvas documents.", "icons": {"48": "icon.svg"}, "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Gemini Canvas Finder", "default_icon": "icon.svg"}, "content_scripts": [{"matches": ["*://gemini.google.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "gemini-canvas-finder@your-domain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}