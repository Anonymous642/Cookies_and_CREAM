{"version": "1.4.0", "name": "Vercel", "description": "Use the Vercel Toolbar on production deployments", "manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "extension@vercel.com"}}, "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "browser_action": {"default_title": "Vercel"}, "permissions": ["<all_urls>", "alarms", "storage", "webRequest"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["http://localhost/_next-live/feedback/feedback.html", "http://localhost/_next-live/feedback/feedback.html?*", "https://vercel.live/_next-live/feedback/feedback.html", "https://vercel.live/_next-live/feedback/feedback.html?*", "https://*.vercel.sh/_next-live/feedback/feedback.html", "https://*.vercel.sh/_next-live/feedback/feedback.html?*"], "all_frames": true, "run_at": "document_start", "js": ["src/content/toolbar.js"]}, {"matches": ["<all_urls>"], "run_at": "document_start", "js": ["src/content/script-injector.js"], "world": "MAIN"}, {"matches": ["<all_urls>"], "run_at": "document_start", "js": ["src/content/toolbar-injector.js"]}, {"matches": ["*://vercel.com/*", "*://*.vercel.sh/*"], "all_frames": true, "run_at": "document_end", "js": ["src/content/vercel-site.js"]}]}