{"manifest_version": 2, "name": "Manga Ad Remover", "version": "1.2.1", "description": "Remove ads and auto-close ad dialogs on Up-Manga and Manga168 websites", "browser_specific_settings": {"gecko": {"id": "manga-ad-remover@extension.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "*://*.up-manga.com/*", "*://*.manga1688.com/*", "*://*.reborntrans.com/*", "*://*.chibi-manga.com/*"], "content_scripts": [{"matches": ["*://*.up-manga.com/*", "*://*.manga1688.com/*"], "js": ["content-script.js"], "css": ["ad-blocker.css"], "run_at": "document_start"}, {"matches": ["*://*.reborntrans.com/*"], "js": ["content-script.js"], "css": ["ad-blocker-reborntrans.css"], "run_at": "document_start"}, {"matches": ["*://*.chibi-manga.com/*"], "js": ["content-script.js"], "css": ["ad-blocker-chibi-manga.css"], "run_at": "document_start"}], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_title": "Manga Ad Remover", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "page_action": {"default_title": "Manga Ad Remover", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}