{"manifest_version": 2, "name": "Beastify", "version": "1.1", "description": "Adds a browser action icon to the toolbar. Click the button to choose a beast. The active tab's body content is then replaced with a picture of the chosen beast. See https://developer.mozilla.org/en-US/Add-ons/WebExtensions/Examples#beastify", "homepage_url": "https://github.com/mdn/webextensions-examples/tree/main/beastify", "icons": {"48": "icons/beasts-48.png", "96": "icons/beasts-96.png"}, "permissions": ["activeTab"], "browser_action": {"default_icon": "icons/beasts-32.png", "default_title": "Daraalal Clicker", "default_popup": "popup/choose_beast.html"}, "content_scripts": [{"matches": ["https://qms.newcompass.mn/kiosk/branchNew/*"], "js": ["borderify.js"], "run_at": "document_idle"}], "web_accessible_resources": ["beasts/frog.jpg", "beasts/turtle.jpg", "beasts/snake.jpg"], "browser_specific_settings": {"gecko": {"id": "{c6fdbcc3-7770-4ddb-ae9d-79ae61ae9252}"}}}