{"manifest_version": 3, "version": "1.0.0", "author": "FireLlama Team", "description": "Connect to LLM servers for page summarization, form filling, and sidebar chat", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "action": {"default_title": "Summarize this page", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "name": "FireLlama", "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidebar/sidebar.html", "default_title": "FireLlama Chat", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "browser_specific_settings": {"gecko": {"id": "firellama@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}