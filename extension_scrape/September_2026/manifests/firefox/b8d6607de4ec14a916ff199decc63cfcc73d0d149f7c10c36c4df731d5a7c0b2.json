{"manifest_version": 2, "name": "Beacon", "description": "Keyboard-driven tab search. Hit Cmd+. (period) , type, switch.", "version": "1.1.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["tabs", "bookmarks", "history"], "browser_specific_settings": {"gecko": {"id": "beacon@aryamanpandu", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["bookmarksInfo", "browsingActivity"]}}}, "commands": {"open-tab-search": {"suggested_key": {"mac": "Command+Period", "default": "Ctrl+Period"}, "description": "Open Beacon tab search"}}, "content_security_policy": "script-src 'self'; object-src 'self';", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Beacon", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "web_accessible_resources": ["content-scripts/content.css"]}