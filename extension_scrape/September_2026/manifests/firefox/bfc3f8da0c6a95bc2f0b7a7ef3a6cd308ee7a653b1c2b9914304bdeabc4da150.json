{"manifest_version": 3, "name": "Download Station", "version": "1.0.0", "description": "Send magnet links and downloads to Download Station", "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["alarms", "contextMenus", "storage", "notifications"], "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "*://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Download Station", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "download-station@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}