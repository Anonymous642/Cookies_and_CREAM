{"manifest_version": 3, "name": "FitCheck", "version": "2.0.0", "description": "Match your measurements to clothing size charts on any retail site \u2014 no AI, no account needed.", "browser_specific_settings": {"gecko": {"id": "fitcheck@extension", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "FitCheck", "default_icon": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}}