{"manifest_version": 3, "name": "Futaba Image Manager", "version": "4.2.1", "browser_specific_settings": {"gecko": {"id": "futaba-image-manager@example.com", "strict_min_version": "114.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "downloads", "declarativeNetRequest", "tabs"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["resource_guard.js", "background.js"]}, "host_permissions": ["*://*.2chan.net/*", "*://*.lmadps.jp/*", "*://*.reajyu.net/*"], "content_scripts": [{"matches": ["*://*.2chan.net/*"], "js": ["performance_guard.js", "config.js", "content_ng.js", "content_ui.js"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["image_manager.html", "image_manager.js", "zip_worker.js", "help.html", "help.js", "options.html", "options.js"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}}