{"manifest_version": 3, "name": "Knowledge Capture", "version": "1.4.0", "description": "Captures and cleans web pages on request from the sidebar or Hub add-on, then exports them as TXT, Word or PDF.", "permissions": ["tabs", "downloads", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open Knowledge Capture", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}, "sidebar_action": {"default_title": "Knowledge Capture", "default_panel": "sidebar/sidebar.html", "default_icon": {"48": "icon.svg", "96": "icon.svg"}, "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "knowledge-capture@aladike", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/cleaner.js", "lib/content.js"], "run_at": "document_idle", "all_frames": false}]}