{"manifest_version": 2, "name": "X Ally", "description": "Your ally on X", "version": "0.4.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "activeTab", "https://x.com/*", "https://pro.x.com/*", "https://api.x.com/*", "https://x-ally.com/*"], "web_accessible_resources": ["react-fiber-detector.js", "react-communicator.js", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "x-ally@x-ally.com"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "X Ally Config", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.x.com/*"], "js": ["content-scripts/content.js"]}]}