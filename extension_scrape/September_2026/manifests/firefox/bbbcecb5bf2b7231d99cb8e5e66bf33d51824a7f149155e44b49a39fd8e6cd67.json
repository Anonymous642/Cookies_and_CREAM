{"manifest_version": 2, "name": "Surprise Me", "version": "1.3", "description": "Rediscover forgotten pages from your own history. Spin the roulette to open a random page you visited before \u2014 filter by how far back to dig, then open it or spin again.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{e0b4653e-8b9a-4194-a237-ee7299cc616b}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["history", "tabs"], "browser_action": {"default_title": "Surprise Me", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}