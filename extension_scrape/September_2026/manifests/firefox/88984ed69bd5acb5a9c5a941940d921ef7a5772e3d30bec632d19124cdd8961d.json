{"manifest_version": 2, "name": "Hacksudo Security Inspector (CSP v2)", "version": "3.0", "description": "Hacksudo: CSP analysis, security headers inspection, TLS protocol & cipher visibility, passive vulnerability signals, and server stack fingerprint hints.", "browser_action": {"default_title": "Hacksudo Security Inspector", "default_popup": "popup.html", "default_icon": "icons/icon.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "96": "icons/icon.png", "128": "icons/icon.png"}, "permissions": ["tabs", "activeTab", "<all_urls>", "webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "hacksudo-csp-checker@hacksudo.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}