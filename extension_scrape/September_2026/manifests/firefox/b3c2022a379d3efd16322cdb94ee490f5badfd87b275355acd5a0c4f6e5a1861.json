{"manifest_version": 3, "name": "AI Chat Vault", "version": "0.1.0", "description": "Automatically save and search your Claude & ChatGPT conversations. Free, local, no setup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["browser-polyfill.js", "shared-storage.js", "capture-claude.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["browser-polyfill.js", "shared-storage.js", "capture-chatgpt.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "ai-chat-vault@yourdomain.example", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}