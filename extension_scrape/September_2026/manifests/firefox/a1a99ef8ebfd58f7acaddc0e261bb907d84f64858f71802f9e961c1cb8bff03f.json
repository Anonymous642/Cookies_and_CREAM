{"manifest_version": 3, "name": "UMD Music Metadata", "description": "View unified music metadata from the Unified Music Data API on supported streaming pages.", "version": "0.1.3", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["*://*.spotify.com/*", "*://*.deezer.com/*", "*://*.music.apple.com/*", "*://music.youtube.com/*", "*://*.youtube.com/*", "*://*.tidal.com/*", "*://listen.tidal.com/*", "https://api.unifiedmusicdata.org/*"], "options_ui": {"open_in_tab": false, "page": "options.html"}, "action": {"default_title": "Show UMD metadata for this page"}, "browser_specific_settings": {"gecko": {"id": "extension@unifiedmusicdata.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.deezer.com/*", "*://*.music.apple.com/*", "*://*.spotify.com/*", "*://*.tidal.com/*", "*://*.youtube.com/*", "*://listen.tidal.com/*", "*://music.youtube.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}