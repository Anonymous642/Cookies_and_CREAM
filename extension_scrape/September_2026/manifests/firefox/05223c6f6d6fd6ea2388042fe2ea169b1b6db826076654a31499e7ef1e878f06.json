{"manifest_version": 2, "name": "Quick Scroll Jump", "version": "1.0.0", "description": "One-tap floating buttons to instantly glide to the very top or bottom of long web pages. Configurable, private, and works offline.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{d9dd1de0-9f1a-4a0b-8b50-60012cb0671f}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "background": {"scripts": ["scripts/background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["scripts/content.js"], "css": ["scripts/content.css"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_title": "Quick Scroll Jump", "default_popup": "scripts/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}, "commands": {"scroll-top": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Jump to top of page"}, "scroll-bottom": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Jump to bottom of page"}}}