{"manifest_version": 2, "name": "SearchResultBlocker", "version": "1.1", "description": "Blocks search results from specified URLs.", "icons": {"48": "images/stash_result-48.png"}, "browser_specific_settings": {"gecko": {"id": "searchresultblocker@glntaugly", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_icon": "images/stash_result-48.png", "default_title": "\u62e1\u5f35\u6a5f\u80fd\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u958b\u304f"}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://duckduckgo.com/*"], "js": ["stash_search_result.js"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "tabs", "activeTab", "menus", "contextMenus"], "background": {"scripts": ["background.js"]}, "content_security_policy": "script-src 'self'; object-src 'self'"}