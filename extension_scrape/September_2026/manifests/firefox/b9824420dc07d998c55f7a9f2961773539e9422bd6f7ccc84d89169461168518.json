{"manifest_version": 3, "name": "High-Way.me", "version": "1.0.1", "description": "High-Way.me extension for Firefox. Manage OCH and torrent Cloud Downloads for your HIGHWAY account directly from the browser.", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png"}, "action": {"default_icon": "icons/32.png", "default_popup": "popup/popup.html", "default_title": "High-Way.me"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "contextMenus", "notifications", "downloads", "alarms", "webNavigation"], "host_permissions": ["https://cloud.high-way.me/*"], "browser_specific_settings": {"gecko": {"strict_min_version": "140.0", "id": "{8cce0bde-b3b8-42f7-ab6a-31bf2270e736}", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}