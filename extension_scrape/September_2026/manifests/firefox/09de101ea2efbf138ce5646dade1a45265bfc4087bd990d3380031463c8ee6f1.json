{"manifest_version": 2, "name": "Demvol CargoControl CVS extension", "version": "0.2.0", "description": "Helps DEMVOL users to display their image data from the platform directly inside CVS pages.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "https://local.demvol.com/*", "https://demvol.com/*", "https://www.demvol.com/*"], "browser_specific_settings": {"gecko": {"id": "@demvol-cargocontrol-cvs-extension", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://fleetcore.eurowag.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}