{"manifest_version": 3, "name": "Tabi", "version": "0.2.0", "description": "Export tab/window clusters to Markdown and reopen safely in new windows.", "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["tabs", "downloads", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tabi", "default_icon": {"16": "images/icon-16.png", "19": "images/icon-19.png", "32": "images/icon-32.png", "38": "images/icon-38.png"}}, "browser_specific_settings": {"gecko": {"id": "tabi@zacry.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "sidebar_action": {"default_panel": "sidebar.html"}}