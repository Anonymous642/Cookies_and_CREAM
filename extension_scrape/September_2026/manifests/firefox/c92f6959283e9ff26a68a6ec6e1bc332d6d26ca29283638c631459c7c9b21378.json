{"manifest_version": 3, "name": "Decrypt", "version": "2.11", "description": "D\u00e9chiffre les niveaus du site projet voltaire sotcke les r\u00e9ponses les affiches au fur et \u00e0 mesure que le niveau se poursuit. Cette extension peut aussi remplir les champs automatiquement", "permissions": ["storage", "webRequest", "webRequestBlocking", "webRequestFilterResponse"], "host_permissions": ["https://apprentissage.appli3.projet-voltaire.fr/*", "https://content-prd.projet-voltaire.fr/v55/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "voltaire@ext.local", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://ferney.uk"}, "content_scripts": [{"matches": ["https://apprentissage.appli3.projet-voltaire.fr/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html"}}