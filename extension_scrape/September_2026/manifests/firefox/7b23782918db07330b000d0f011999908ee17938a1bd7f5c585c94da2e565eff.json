{"author": "RegSyk", "manifest_version": 2, "name": "URL Bookmark Generator", "version": "1.2.1", "description": "Create visual PNG bookmarks (smart screenshots) from selected page areas with embedded metadata (e.g. URL, title, capture timestamp)", "permissions": ["tabs", "<all_urls>", "activeTab", "storage", "downloads", "contextMenus"], "background": {"scripts": ["fbookmark_shared.js", "fbookmark_settings-manager.js", "fbookmark_default-settings.js", "fbookmark_background.js"], "persistent": false}, "browser_action": {"default_title": "Capture and replace", "default_popup": "fbookmark_popup.html"}, "page_action": {"default_icon": "icons/fbookmark-icon-48.png", "default_title": "Capture this webpage and save a bookmark"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["fbookmark_shared.js", "qrcodegen-v1.8.0-es6.js", "fbookmark_content_selection.js", "fbookmark_content_script.js", "fbookmark_content-shortcuts.js", "fbookmark_block_overlay.js"], "run_at": "document_idle"}, {"matches": ["file://*/*"], "js": ["jsQR.js", "fbookmark_bookmarkLoader.js"], "run_at": "document_idle"}], "icons": {"48": "icons/fbookmark-icon-48.png"}, "web_accessible_resources": ["icons/fbookmark-icon-48.png"], "browser_specific_settings": {"gecko": {"id": "@urlbookmarkgenerator.regsyk", "data_collection_permissions": {"required": ["none"]}}}}