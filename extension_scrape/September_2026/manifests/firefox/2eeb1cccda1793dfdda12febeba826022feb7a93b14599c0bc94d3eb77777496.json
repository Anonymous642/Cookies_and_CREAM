{"manifest_version": 3, "name": "xselect2copy", "description": "xselect2copy - copy selection while holding ctrl/shift/alt", "version": "1.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "clipboardWrite"], "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "xselect2copy@xselect2copy.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Select2Copy Settings", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}