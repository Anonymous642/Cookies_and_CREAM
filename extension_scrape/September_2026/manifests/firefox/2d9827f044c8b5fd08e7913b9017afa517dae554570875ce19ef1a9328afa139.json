{"manifest_version": 2, "name": "NovelOS Studio: Bionic Reader", "description": "Bionic reading for any web page. Bolds the front of each word so your eyes glide and your brain fills in the rest.", "version": "1.0.0", "short_name": "Bionic Reader", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "commands": {"toggle-bionic": {"suggested_key": {"default": "Alt+B"}, "description": "Toggle bionic reading on the current page"}}, "browser_specific_settings": {"gecko": {"id": "bionic-reader@novelos.studio", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "NovelOS Bionic Reader", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}