{"manifest_version": 2, "name": "YouTube RSS Finder", "version": "0.3.2", "description": "Shows (and copies) the RSS feed URL for the currently opened YouTube video or channel.", "permissions": ["tabs", "activeTab", "storage", "clipboardWrite", "contextMenus", "notifications", "https://www.youtube.com/*", "https://youtube.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "YouTube RSS", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-rss-finder@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}