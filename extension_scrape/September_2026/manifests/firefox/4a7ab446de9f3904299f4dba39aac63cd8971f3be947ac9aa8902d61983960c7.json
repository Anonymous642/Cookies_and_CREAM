{"manifest_version": 2, "name": "Chinisik OCR Translator", "version": "1.0.1", "description": "Capture screen area and translate with AI", "default_locale": "ru", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "browser_action": {"default_popup": "src/views/popup/index.html"}, "web_accessible_resources": ["assets/fonts/MapleMono-CN/*", "assets/fonts/Rubik/*"], "background": {"scripts": ["src/background/index.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*/*"], "js": ["src/views/content-script/main.js"], "css": ["chinisik-ocr-translator.css"]}], "permissions": ["<all_urls>", "tabs", "storage", "notifications", "activeTab"], "browser_specific_settings": {"gecko": {"id": "chinisik-ocr-translator@chinisik.ru", "strict_min_version": "91.1.0"}}, "commands": {"capture-area": {"suggested_key": {"default": "Ctrl+Shift+S"}, "description": "Start area capture"}}}