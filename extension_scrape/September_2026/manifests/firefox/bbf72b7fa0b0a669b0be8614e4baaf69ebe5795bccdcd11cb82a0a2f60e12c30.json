{"manifest_version": 3, "name": "Improved Youtube Chat", "version": "1.1", "description": "Improves annoying chat features on YouTube like auto translation and new mod icon.", "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "old-mod-icon@fuzjajadrowa.pl", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"128": "icon.png"}, "action": {"default_icon": "icon.png", "default_title": "Improved Youtube Chat"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}]}