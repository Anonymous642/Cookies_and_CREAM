{"manifest_version": 2, "name": "Find-Sample (Detect Repeats)", "version": "1.0.0", "description": "Scan audio in the active tab to detect repeated/looped segments and export their timestamps.", "default_locale": "en", "permissions": ["tabs", "activeTab", "storage"], "browser_action": {"default_title": "Find-Sample", "default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "findsample@example.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}