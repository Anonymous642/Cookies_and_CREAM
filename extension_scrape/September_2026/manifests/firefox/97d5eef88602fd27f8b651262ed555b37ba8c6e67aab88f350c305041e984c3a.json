{"manifest_version": 3, "name": "YouTube Anti-Brainrot", "version": "3.0", "description": "A Youtube.com customization suite, offering options to toggle the visibility of Youtube.com homepage content, suggested content, playlist content, and comments. Additionally forces Theater Mode.", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-anti-brainrot@stopit.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "iconPINK2.svg", "128": "iconPINK2.svg"}, "action": {"default_title": "Toggle YouTube Anti-Brainrot", "default_icon": {"48": "iconPINK2.svg"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}