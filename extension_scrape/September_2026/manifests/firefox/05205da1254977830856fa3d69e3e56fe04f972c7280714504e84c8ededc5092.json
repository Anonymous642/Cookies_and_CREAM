{"manifest_version": 3, "name": "Tab Saver Pro", "version": "2.4", "description": "Save, export, and restore tabs instantly \u2014 with Pro features for power users.", "permissions": ["tabs", "storage"], "host_permissions": ["https://api.gumroad.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"128": "icon.png"}}, "icons": {"128": "icon.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tabsaverpro@johnsonmtco.com", "strict_min_version": "109.0", "data_collection": {"collects": false, "required": false}}}, "commands": {"save-tabs": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current tabs"}, "restore-last": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Restore last session"}}}