{"manifest_version": 2, "name": "FutureTabs", "version": "1.6.8", "description": "Save and organize your browser tabs with tags and folders", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_action": {"default_icon": "icons/icon.svg", "default_popup": "popup/popup.html", "default_title": "FutureTabs"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "permissions": ["tabs", "storage", "activeTab", "unlimitedStorage"], "browser_specific_settings": {"gecko": {"id": "futuretabs@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}