{"manifest_version": 2, "name": "YouTube Media Key Seek", "version": "1.3", "description": "Remaps media previous/next keys (F7/F9) to seek 5 seconds backward/forward on YouTube and on local video files instead of skipping tracks", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-media-key-seek@firefox", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "notifications"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "file:///*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}]}