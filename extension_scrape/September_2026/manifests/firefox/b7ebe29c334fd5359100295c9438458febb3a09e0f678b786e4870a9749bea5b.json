{"manifest_version": 3, "name": "Brevio - Kindle Highlights Exporter", "version": "1.0.1", "description": "Export your Kindle highlights to Brevio", "permissions": ["storage", "activeTab"], "host_permissions": ["https://read.amazon.com/*", "https://www.getbrevio.com/*"], "background": {"scripts": ["src/background/background.js"]}, "action": {"default_title": "Brevio - Export Highlights", "default_icon": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}}, "icons": {"16": "assets/icons/icon-16.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/logos/brevio_logo.png", "assets/logos/brevio_logo_small.png", "assets/logos/brevio_small_white_transparent.png"], "matches": ["https://read.amazon.com/*"]}], "content_scripts": [{"matches": ["https://read.amazon.com/notebook*"], "js": ["src/common/config.js", "src/common/logger.js", "src/common/errors.js", "src/common/constants.js", "src/common/dom-utils.js", "src/modules/api.js", "src/modules/extractor.js", "src/modules/uploader.js", "src/modules/auth.js", "src/modules/inject_popup.js", "src/content/content.js"]}], "browser_specific_settings": {"gecko": {"id": "firefox@getbrevio.com", "strict_min_version": "109.0"}}}