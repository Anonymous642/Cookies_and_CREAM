{"manifest_version": 3, "name": "Spol", "version": "1.0.2", "description": "Spol - Spoiler Free Media Companion", "permissions": ["activeTab", "storage", "scripting", "tabs", "webNavigation", "identity"], "host_permissions": ["https://www.netflix.com/*", "https://www.crunchyroll.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon.svg", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Spol", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@spol.io", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}}