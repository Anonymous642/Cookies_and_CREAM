{"manifest_version": 2, "name": "Download File Link Copier", "version": "1.2", "description": "Automatically copies the download page link or direct file link to your clipboard when you download a file. Toggle off to disable copying entirely.", "icons": {"48": "icon-48.png", "96": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "download-file-link-copier@yourdomain.example", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "clipboardWrite", "notifications", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icon-48.png", "96": "icon.png"}, "default_title": "Download File Link Copier", "default_popup": "popup.html"}}