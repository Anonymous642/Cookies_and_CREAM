{"manifest_version": 2, "name": "Chatwait: Get paid while AI thinks", "description": "Earn while ChatGPT, Claude, and Gemini thinks. We cannot read your chats.", "version": "0.1.6", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chatwait.com/*"], "web_accessible_resources": ["chatwait-icon-round.svg"], "browser_specific_settings": {"gecko": {"id": "extension@chatwait.com", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction", "personallyIdentifyingInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Chatwait", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content-scripts/content.js"]}]}