{"manifest_version": 2, "name": "Haven Twitch Chat Media", "version": "1.0.0", "description": "Shows inline media previews (GIF/PNG/JPG) in Twitch chat with viewer-friendly controls, per-channel toggles, and domain filtering.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "tabs", "activeTab", "*://www.twitch.tv/*", "*://dashboard.twitch.tv/*", "*://clips.twitch.tv/*", "*://player.twitch.tv/*"], "browser_action": {"default_title": "Haven Twitch Chat Media", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://www.twitch.tv/*", "*://dashboard.twitch.tv/*", "*://clips.twitch.tv/*", "*://player.twitch.tv/*"], "js": ["shared/ui.js", "content/chatMediaRenderer.js"], "css": ["content/contentStyles.css"], "run_at": "document_idle"}], "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self' data:;", "browser_specific_settings": {"gecko": {"id": "haven-twitch-chat-media@havenden.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}