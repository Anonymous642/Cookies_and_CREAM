{"manifest_version": 2, "name": "Add to Bredbox", "version": "1.6.0", "description": "Save the current tab to Bredbox.", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_action": {"default_title": "Add to Bredbox", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "tabs", "storage", "identity", "notifications", "https://api.bredbox.app/*", "https://bredbox.app/*"], "browser_specific_settings": {"gecko": {"id": "firefox-extension@bredbox.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}