{"manifest_version": 2, "name": "Tab Tidier", "version": "1.0", "description": "A full-featured Firefox tab manager with window grouping, domain view, sessions, search, drag and drop, mute, suspend and more.", "browser_specific_settings": {"gecko": {"id": "tabtidier@extension", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["tabs", "sessions", "storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Open Tab Tidier (Ctrl+M)"}, "background": {"scripts": ["background.js"], "persistent": false}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+M", "mac": "MacCtrl+M"}, "description": "Open Tab Manager"}}}