{"manifest_version": 2, "name": "Kick Emote Spam Blocker", "version": "1.0.3", "author": "David Oelfke", "description": "Suppresses repeated emote messages from the same Kick.com chatter within 2 minutes.", "homepage_url": "https://github.com/Doelfke/no-kick-emote-spam-firefox", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.kick.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": ["page-bridge.js"], "browser_specific_settings": {"gecko": {"id": "no-kick-emote-spam@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}