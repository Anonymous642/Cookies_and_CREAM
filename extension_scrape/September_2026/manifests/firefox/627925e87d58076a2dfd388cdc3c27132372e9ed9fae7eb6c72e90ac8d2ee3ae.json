{"manifest_version": 3, "name": "CanDoYa - Tool Search", "short_name": "CanDoYa", "version": "1.0.0", "description": "Search every free CanDoYa tool from a sidebar in any tab. Favorites and recents stay in sync with candoya.com.", "homepage_url": "https://candoya.com/", "browser_specific_settings": {"gecko": {"id": "tool-search@candoya.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "CanDoYa tool search", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_area": "navbar"}, "sidebar_action": {"default_title": "CanDoYa tools", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "open_at_install": true}, "background": {"scripts": ["background.js"]}, "permissions": ["storage"], "host_permissions": ["https://candoya.com/*"], "omnibox": {"keyword": "cd"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}}}, "content_scripts": [{"matches": ["https://candoya.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}