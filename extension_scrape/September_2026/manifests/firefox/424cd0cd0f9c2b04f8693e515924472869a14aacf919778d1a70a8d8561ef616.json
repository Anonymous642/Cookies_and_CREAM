{"manifest_version": 3, "name": "ipscmatch.de / steelmatch.de Filter Toolbar", "version": "0.3.1", "description": "Filter matches by level, radius and gun type. Adds a distance column. Supports associated portals (for example ipsc.fftir.org). WIP", "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.ipscmatch.de/*", "*://*.ipsc-dm.de/*", "*://*.steelmatch.de/*", "*://*.magnumpokal.de/*", "*://*.ipsc.fftir.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@ipscmatch-extension", "data_collection_permissions": {"required": ["none"]}}}}