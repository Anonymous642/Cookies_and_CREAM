{"manifest_version": 3, "name": "Aura - Browser UI & Workspace Customizer", "version": "1.2.2", "description": "Customize any webpage with smart dark themes, liquid glass, custom typography, element zapper, reader mode, and a sleek new tab dashboard.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "aura-ui-customizer@local.addon", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "topSites", "bookmarks", "tabs"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_start"}]}