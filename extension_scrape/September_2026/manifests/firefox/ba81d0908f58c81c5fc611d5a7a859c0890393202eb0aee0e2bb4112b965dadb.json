{"manifest_version": 2, "name": "Gemini Navigator", "version": "1.0.0", "description": "Navigate long Google Gemini conversations with a sidebar showing all your prompts", "permissions": ["activeTab", "*://gemini.google.com/*"], "content_scripts": [{"matches": ["*://gemini.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Gemini Navigator"}, "browser_specific_settings": {"gecko": {"id": "gemini-navigator-firefox@addon.royalp", "data_collection_permissions": {"required": ["none"]}}}}