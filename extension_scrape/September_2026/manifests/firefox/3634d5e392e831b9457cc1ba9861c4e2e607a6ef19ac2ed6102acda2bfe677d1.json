{"manifest_version": 3, "name": "NxTools Download Interceptor", "description": "Intercept browser downloads and send them to NxTools.", "version": "0.4.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "cookies", "downloads", "scripting", "storage", "activeTab", "tabs", "webNavigation", "webRequest"], "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_title": "NxTools", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["page-hook.js"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;"}, "browser_specific_settings": {"gecko": {"id": "nxtools-download-interceptor@nxtools.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}