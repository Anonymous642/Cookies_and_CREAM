{"manifest_version": 2, "name": "Download Shortform Summaries", "version": "1.1", "description": "Extract fully automated summaries on shortform.com to the clipboard or download them as a file in Markdown format", "permissions": ["activeTab", "downloads", "clipboardWrite"], "content_scripts": [{"matches": ["*://*.shortform.com/*"], "js": ["utils.js", "content-script.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "shortform-scraper@example.com", "strict_min_version": "102.0"}}}