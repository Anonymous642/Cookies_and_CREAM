{"manifest_version": 2, "name": "Quick Search", "version": "2.1", "description": "Select text on any webpage, right-click, and search on a website from your custom list.", "icons": {"16": "icon16.png", "32": "icon32.png", "64": "icon64.png", "128": "icon128.png"}, "permissions": ["contextMenus", "storage", "activeTab"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "quick-search@your-domain.com"}}}