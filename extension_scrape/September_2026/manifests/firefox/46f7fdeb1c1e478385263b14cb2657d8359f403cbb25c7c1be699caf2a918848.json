{"manifest_version": 2, "name": "Youtube Hide Sections", "version": "1.0", "description": "Makes it possible to hide video sections on YouTube.", "icons": {"48": "icons/border-48.png", "96": "icons/border-96.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["youtube-hide-sections.js"]}], "options_ui": {"page": "settings/options.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "@youtube-hide-sections", "data_collection_permissions": {"required": ["none"]}}}}