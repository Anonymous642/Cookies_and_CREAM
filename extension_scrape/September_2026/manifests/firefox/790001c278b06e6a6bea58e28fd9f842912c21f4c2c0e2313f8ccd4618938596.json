{"manifest_version": 3, "name": "Luxury Hotel Offers", "version": "1.1.3", "description": "Get notified when a hotel you're browsing has exclusive perks: breakfast, upgrades, and credits, at the same rate as booking direct.", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://www.luxuryhoteloffers.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}, "id": "lho@luxuryhoteloffers.app"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/notification.js"], "css": ["content/notification.css"], "run_at": "document_idle", "world": "ISOLATED"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-v2-16.png", "32": "icons/icon-v2-32.png", "48": "icons/icon-v2-48.png", "64": "icons/icon-v2-64.png", "128": "icons/icon-v2-128.png"}}, "icons": {"16": "icons/icon-v2-16.png", "32": "icons/icon-v2-32.png", "48": "icons/icon-v2-48.png", "64": "icons/icon-v2-64.png", "128": "icons/icon-v2-128.png"}}