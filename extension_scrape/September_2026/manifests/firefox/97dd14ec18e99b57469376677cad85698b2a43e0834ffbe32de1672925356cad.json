{"manifest_version": 2, "name": "PriceBeat - Smart Price Tracker", "version": "1.0.0", "description": "Track product prices across Amazon, Flipkart and more. Get instant alerts when prices drop and save money on your favorite products.", "browser_specific_settings": {"gecko": {"id": "pricebeat@extension.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}, "permissions": ["activeTab", "storage", "notifications", "alarms", "https://amazon.com/*", "https://www.amazon.com/*", "https://amazon.in/*", "https://www.amazon.in/*", "https://flipkart.com/*", "https://www.flipkart.com/*", "https://ebay.com/*", "https://www.ebay.com/*", "https://walmart.com/*", "https://www.walmart.com/*", "https://bestbuy.com/*", "https://www.bestbuy.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://amazon.com/*", "https://www.amazon.com/*", "https://amazon.in/*", "https://www.amazon.in/*", "https://flipkart.com/*", "https://www.flipkart.com/*", "https://ebay.com/*", "https://www.ebay.com/*", "https://walmart.com/*", "https://www.walmart.com/*", "https://bestbuy.com/*", "https://www.bestbuy.com/*"], "js": ["content.js"], "css": ["content.css"]}], "browser_action": {"default_popup": "popup.html", "default_title": "PriceBeat - Track This Product", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"]}