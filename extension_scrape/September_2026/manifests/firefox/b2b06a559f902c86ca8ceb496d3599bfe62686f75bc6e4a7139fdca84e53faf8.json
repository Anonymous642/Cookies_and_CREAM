{"manifest_version": 2, "name": "Floating Mini Player", "version": "1.0.0", "description": "Watch videos in a floating mini player while browsing other tabs.", "permissions": ["activeTab", "tabs", "storage"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "browser_specific_settings": {"gecko": {"id": "@Floating-Mini-Player", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}