{"manifest_version": 2, "name": "Thought Priority Matrix", "version": "1.3", "description": "A Firefox extension to categorize web text and personal notes into an Eisenhower-style Thought Priority Matrix.", "browser_action": {"default_icon": "icons/logo_64.png", "default_title": "Thought Priority Matrix", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "permissions": ["activeTab", "storage", "notifications", "contextMenus"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Thought-Priority-Matrix", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}