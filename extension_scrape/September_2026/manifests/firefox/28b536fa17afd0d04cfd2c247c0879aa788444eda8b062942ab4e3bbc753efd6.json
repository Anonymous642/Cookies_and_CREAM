{"manifest_version": 3, "name": "Open All Links in Tabs", "version": "2.2.0", "description": "Extract links from text input and open each link in a separate tab. Perfect for quickly opening multiple URLs from copied text.", "browser_specific_settings": {"gecko": {"id": "openalllinks@armanshirzad.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["tabs", "activeTab", "storage", "clipboardRead", "clipboardWrite", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["service-worker.js"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open the extension popup"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}