{"manifest_version": 3, "name": "Tab Limiter - Protocol Vital", "version": "1.1", "description": "Limits the number of tabs for system survival. Intervention required in case of overload.", "permissions": ["tabs", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "browser_specific_settings": {"gecko": {"id": "tablimiter@survival.mode", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}