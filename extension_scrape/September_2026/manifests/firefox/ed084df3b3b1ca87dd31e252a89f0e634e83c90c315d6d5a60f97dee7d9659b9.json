{"manifest_version": 2, "name": "Close Unauthenticated Tabs", "version": "1.2", "description": "Closes YouTube and Reddit tabs after 1 minute if not logged in on YouTube or Reddit.", "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.reddit.com/*", "*://*.old.reddit.com/*"], "js": ["content.js"]}], "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "yt-kick@idk.com"}}}