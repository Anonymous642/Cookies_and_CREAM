{"manifest_version": 2, "name": "WOFH Map Exporter", "version": "0.1.0", "description": "Exports currently loaded Ways of History map chunks to a JSON file.", "browser_specific_settings": {"gecko": {"id": "wofh-map-exporter@artemross.dev", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://waysofhistory.com/*", "https://*.waysofhistory.com/*"], "js": ["src/exporter.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "world": "MAIN"}]}