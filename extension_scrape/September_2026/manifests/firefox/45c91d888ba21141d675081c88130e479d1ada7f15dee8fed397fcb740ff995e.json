{"manifest_version": 3, "name": "Traduct", "description": "Traduct translates Bluesky posts locally.", "version": "0.2.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage", "nativeMessaging"], "browser_specific_settings": {"gecko": {"id": "@espanolize", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "host_permissions": ["http://127.0.0.1/*", "*://bsky.app/*", "*://*.bsky.app/*"], "action": {"default_title": "Traduct", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["traduct-mark.svg"], "matches": ["*://bsky.app/*", "*://*.bsky.app/*"]}], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.bsky.app/*", "*://bsky.app/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}