{"manifest_version": 3, "name": "Duration sort \u00b7 InnerTube", "version": "1.1.6", "description": "Add Duration (shortest/longest first) to YouTube\u2019s native playlist Sort menu. Uses InnerTube browse/edit_playlist with your existing youtube.com login \u2014 no extra OAuth.", "browser_specific_settings": {"gecko": {"id": "innertube-session@yt-duration-sort.prototypes", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png"}, "permissions": ["storage", "cookies"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content/page-bridge.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content/duration.js", "content/sort-plan.js", "content/innertube.js", "content/toast.js", "content/menu.js", "content/content.js"], "css": ["content/panel.css"], "run_at": "document_idle"}]}