{"manifest_version": 3, "name": "Twitch Timecodes", "version": "1.0.21", "description": "Capture et enregistre des timecodes pendant les lives Twitch, puis retrouve-les avec leur VOD associ\u00e9e.", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://www.twitch.tv/*", "https://api.twitch.tv/*", "https://id.twitch.tv/*", "https://gql.twitch.tv/*", "https://tight-resonance-f696.benjiramch.workers.dev/*"], "commands": {"capture-timecode": {"suggested_key": {"default": "Ctrl+Shift+8", "mac": "Command+Shift+8", "windows": "Ctrl+Shift+8", "linux": "Ctrl+Shift+8"}, "description": "Capturer le timecode du live Twitch actif"}}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Twitch Timecodes", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "twitch-timecodes@benjiramch", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity", "personallyIdentifyingInfo"]}}}}