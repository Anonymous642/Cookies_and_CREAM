{"manifest_version": 3, "name": "ClipboardManager", "version": "1.0.0", "description": "Clipboard history manager. Save, search, and manage clipboard items.", "icons": {"48": "clipboard-icons/icon-48.png", "96": "clipboard-icons/icon-96.png", "128": "clipboard-icons/icon-128.png"}, "action": {"default_icon": {"48": "clipboard-icons/icon-48.png", "96": "clipboard-icons/icon-96.png"}, "default_title": "ClipboardManager", "default_popup": "manager-ui/manager.html"}, "background": {"scripts": ["background/background.js"]}, "permissions": ["clipboardRead", "clipboardWrite", "storage"], "browser_specific_settings": {"gecko": {"id": "clipboardmanager@clipboard.history", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}