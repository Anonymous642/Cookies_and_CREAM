{"manifest_version": 2, "name": "Downloads Sidebar Reborn", "description": "Displays a sidebar that lets you manage all your downloads. No new windows, no new tabs, just a conveniently placed sidebar to the left or right of your screen.", "version": "0.0.2", "applications": {"gecko": {"id": "downloads-sidebar-reborn@rado84", "strict_min_version": "61.0"}}, "browser_specific_settings": {"gecko": {"id": "downloads-sidebar-reborn@rado84", "strict_min_version": "61.0"}}, "sidebar_action": {"default_icon": "icons/downloads.svg", "default_title": "Downloads", "default_panel": "sidebar/panel.html"}, "browser_action": {"default_icon": "icons/downloads.svg"}, "background": {"scripts": ["background.js"]}, "permissions": ["downloads", "downloads.open"], "commands": {"_execute_sidebar_action": {"description": "Open the downloads sidebar", "suggested_key": {"default": "F2"}}}}