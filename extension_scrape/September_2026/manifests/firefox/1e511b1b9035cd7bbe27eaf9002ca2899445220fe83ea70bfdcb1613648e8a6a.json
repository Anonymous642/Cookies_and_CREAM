{"manifest_version": 2, "name": "Nexus Archive Helper", "version": "1.0.2", "description": "Adds download buttons to Nexus Mods archived files list and adds a one-click button to open the archived files view.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "content_scripts": [{"matches": ["https://www.nexusmods.com/*/mods/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["https://www.nexusmods.com/*/mods/*"], "browser_specific_settings": {"gecko": {"id": "nexus-archive-helper@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}