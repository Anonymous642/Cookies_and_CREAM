{"manifest_version": 3, "name": "PitchMan", "version": "1.0.2", "description": "Repitch YouTube -12 to +12 semitones for sampling. Tempo locked (pitch-only) or speed-follows (classic sped-up sound).", "permissions": ["activeTab"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Toggle Pitchman panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"pitch-up": {"suggested_key": {"default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up"}, "description": "Pitch up 1 semitone"}, "pitch-down": {"suggested_key": {"default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down"}, "description": "Pitch down 1 semitone"}, "toggle-lock": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle lock-tempo (pitch-only) vs speed-follows"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["vendor/phase-vocoder-worklet.js", "vendor/recorder-worklet.js"], "matches": ["*://*.youtube.com/*"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "pitchman@mightymaxbeats.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}