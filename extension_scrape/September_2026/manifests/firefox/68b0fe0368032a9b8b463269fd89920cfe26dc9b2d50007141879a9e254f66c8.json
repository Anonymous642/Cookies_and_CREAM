{"manifest_version": 3, "name": "Facebook Post Image Downloader", "version": "1.0.0", "description": "Select, preview, and download images from the Facebook post you are viewing.", "permissions": ["activeTab", "downloads", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://*.facebook.com/*", "https://*.fbcdn.net/*"], "action": {"default_title": "Facebook Post Images", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://*.facebook.com/*"], "js": ["content/facebook-post-parser.js", "content/content-script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "facebook-post-images@example.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}