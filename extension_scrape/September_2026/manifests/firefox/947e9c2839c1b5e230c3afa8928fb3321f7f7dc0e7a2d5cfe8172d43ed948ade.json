{"manifest_version": 3, "name": "DossierVeille", "description": "Surveille automatiquement votre dossier ANEF et recevez des notifications en cas de changement.", "version": "1.1.1", "permissions": ["storage", "notifications", "alarms", "cookies"], "host_permissions": ["https://administration-etrangers-en-france.interieur.gouv.fr/*", "https://sso.anef.dgef.interieur.gouv.fr/*", "https://dossierveille.com/*"], "background": {"scripts": ["background/background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@dossierveille.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}, "action": {"default_popup": "popup/popup.html", "default_title": "DossierVeille"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}