{"manifest_version": 2, "name": "Local Runner Bridge", "version": "0.4.2", "description": "Run explicitly marked ChatGPT shell blocks locally.", "permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1:8765/*", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "chatgpt-local-runner@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}}