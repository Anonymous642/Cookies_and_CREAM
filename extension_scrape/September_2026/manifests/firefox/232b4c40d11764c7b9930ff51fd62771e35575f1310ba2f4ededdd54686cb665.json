{"manifest_version": 3, "name": "Logos Go Links", "version": "1.0", "description": "Instantly routes go/ links to the internal network", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://go/*", "*://www.google.com/search*"], "browser_specific_settings": {"gecko": {"id": "golinks@logos.work", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}}