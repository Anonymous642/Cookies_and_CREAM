{"name": "Symbols Icons for GitHub, GitLab and more", "description": "File and folder icons for GitHub, GitLab, Bitbucket and other code hosts, using the Symbols icon theme from VS Code.", "homepage_url": "https://github.com/jahirfiquitiva/symbols-browser-extension", "manifest_version": 3, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://github.com/*", "*://gitlab.com/*", "*://bitbucket.org/*", "*://dev.azure.com/*", "*://*.visualstudio.com/*", "*://gitea.com/*", "*://codeberg.org/*", "*://gitee.com/*", "*://sourceforge.net/*", "*://tangled.org/*"], "js": ["./main.js"], "css": ["./injected-styles.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/files/*.svg", "icons/folders/*.svg"], "matches": ["*://github.com/*", "*://gitlab.com/*", "*://bitbucket.org/*", "*://dev.azure.com/*", "*://*.visualstudio.com/*", "*://gitea.com/*", "*://codeberg.org/*", "*://gitee.com/*", "*://sourceforge.net/*", "*://tangled.org/*"]}], "action": {"default_title": "Symbols Icons", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "symbols-icons@jahirfiquitiva.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "version": "1.0.1"}