{"manifest_version": 3, "name": "InmoRadar", "description": "Analiza inmuebles antes de contactar. Compatible con Idealista, Fotocasa, Pisos.com y Habitaclia.", "version": "2.0.7", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://*.idealista.com/*", "https://*.fotocasa.es/*", "https://*.pisos.com/*", "https://*.habitaclia.com/*", "https://www.inmoradar.app/*"], "action": {"default_title": "InmoRadar", "default_popup": "public/popup.html", "default_icon": {"16": "public/icons/16.png", "32": "public/icons/32.png", "48": "public/icons/48.png", "128": "public/icons/128.png"}}, "icons": {"16": "public/icons/16.png", "32": "public/icons/32.png", "48": "public/icons/48.png", "128": "public/icons/128.png"}, "options_page": "public/options.html", "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self';"}, "content_scripts": [{"matches": ["https://*.idealista.com/*", "https://*.fotocasa.es/*", "https://*.pisos.com/*", "https://*.habitaclia.com/*"], "js": ["src/content/inject.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["data/municipal-tax-data.json", "data/idealista-market-data.json", "public/popup.html", "public/options.html", "public/icons/*.png", "src/styles/tailwind.css", "src/popup/*.js", "src/popup/views/*.js", "src/popup/components/*.js", "src/shared/*.js", "src/shared/calc/*.js", "src/shared/constants/*.js", "src/version/*.js", "src/options/*.js", "src/options/views/*.js", "src/options/components/*.js"], "matches": ["https://*.idealista.com/*", "https://*.fotocasa.es/*", "https://*.pisos.com/*", "https://*.habitaclia.com/*"]}], "browser_specific_settings": {"gecko": {"id": "inmoradar@inmoradar.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["technicalAndInterac