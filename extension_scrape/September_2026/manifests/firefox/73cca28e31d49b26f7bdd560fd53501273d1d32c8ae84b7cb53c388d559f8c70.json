{"manifest_version": 2, "name": "Budget Pie Visualizer", "version": "1.3", "description": "Visualize your budget and spending by category with an interactive pie chart.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Budget Pie", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@Budget-Pie-Visualizer", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}