{"manifest_version": 3, "name": "YeyMail Email Aliases", "version": "2.4.0", "description": "Create a private email alias for the site you're on, in one click, and keep your real address off the internet.", "action": {"default_popup": "popup.html", "default_title": "YeyMail"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "declarativeNetRequestWithHostAccess"], "host_permissions": ["https://api.yeymail.com/*"], "optional_host_permissions": ["<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "tracking", "enabled": false, "path": "rules/tracking.json"}]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icon.png", "fonts/manrope-latin.woff2", "fonts/schibsted-grotesk-latin.woff2"], "matches": ["<all_urls>"]}], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@yeymail.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteActivity"]}}}}