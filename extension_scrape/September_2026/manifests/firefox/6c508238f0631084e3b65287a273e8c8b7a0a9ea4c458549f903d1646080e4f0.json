{"manifest_version": 2, "name": "ATube Bookmark", "version": "1.0", "description": "\u81ea\u52a8\u8bb0\u5f55\u548c\u6062\u590dYouTube\u89c6\u9891\u64ad\u653e\u8fdb\u5ea6\u7684Firefox\u6269\u5c55", "permissions": ["storage", "tabs", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_title": "ATube Bookmark", "default_popup": "popup.html", "default_icon": "assets/Logo-48.png"}, "icons": {"48": "assets/Logo-48.png", "96": "assets/Logo-96.png"}, "browser_specific_settings": {"gecko": {"id": "atube-bookmark@example.com", "strict_min_version": "79.0"}}}