{"manifest_version": 2, "name": "BetterExtension", "version": "1.1.1", "description": "Import ArtStation concepts into BetterStation.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "storage", "https://www.artstation.com/*", "https://*.artstation.com/*"], "background": {"scripts": ["src/background.js"], "persistent": false}, "browser_action": {"default_title": "BetterExtension", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_popup": "src/popup/popup.html"}, "content_scripts": [{"matches": ["https://www.artstation.com/*", "https://*.artstation.com/*"], "js": ["src/content/artstation.js"], "run_at": "document_idle"}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "betterextension-public@betterstation.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}