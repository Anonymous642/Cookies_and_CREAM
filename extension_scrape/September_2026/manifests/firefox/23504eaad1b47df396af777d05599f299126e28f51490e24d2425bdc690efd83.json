{"manifest_version": 3, "name": "AWS IAM Identity Center", "version": "1.1.1", "description": "Gestion personnelle des comptes AWS : noms, environnements, couleurs et raccourcis SSO.", "permissions": ["storage"], "host_permissions": ["https://*.awsapps.com/start*"], "action": {"default_title": "AWS IAM Identity Center \u00b7 Manager", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["shared/model.js", "background.js"]}, "content_scripts": [{"matches": ["https://*.awsapps.com/start*"], "js": ["shared/model.js", "shared/client.js", "shared/styles.js", "shared/ui.js", "content/portal.js"], "css": ["content/portal.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["shared/ui.css", "icons/cloud.svg"], "matches": ["https://*.awsapps.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "browser_specific_settings": {"gecko": {"id": "nuage-aws-accounts@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}