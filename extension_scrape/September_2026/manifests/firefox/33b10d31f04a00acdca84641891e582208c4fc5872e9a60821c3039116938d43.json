{"manifest_version": 2, "name": "Reddit Post Image Downloader", "version": "1.2.0", "description": "Download only the images from the current Reddit post.", "permissions": ["downloads", "activeTab", "tabs", "contextMenus", "*://*.reddit.com/*"], "browser_action": {"default_title": "Download Reddit Post Images", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.reddit.com/r/*/comments/*", "*://*.reddit.com/comments/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "reddit-post-image-downloader@example.com", "strict_min_version": "78.0"}}}