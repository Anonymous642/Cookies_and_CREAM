{"manifest_version": 3, "name": "SearchClear", "version": "1.1.0", "description": "Forces real Google search from any browser. Strips ads, affiliate spam, Pinterest & AI filler. Works even when your browser hijacks the address bar or new tab.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://google.com/search*"], "js": ["content.js"], "css": ["toolbar.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "SearchClear"}, "omnibox": {"keyword": "sc"}, "permissions": ["storage", "tabs", "webNavigation", "contextMenus"], "host_permissions": ["*://www.google.com/*", "*://google.com/*"], "browser_specific_settings": {"gecko": {"id": "searchclear@notavello.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}