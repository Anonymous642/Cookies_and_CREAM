{"manifest_version": 2, "name": "AtStash", "description": "Secure, local-first bookmark and password manager", "version": "3.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png", "512": "icon-512.png"}, "homepage_url": "https://atinfotech.com/tools/atstash.php", "author": "ATinfotech", "permissions": ["storage", "activeTab", "clipboardWrite", "scripting", "tabs", "https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "options_page": "options.html", "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open AtStash popup"}, "lock-extension": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Lock AtStash"}}, "web_accessible_resources": ["icons/*"], "sidebar_action": {"default_panel": "popup.html", "default_title": "AtStash"}, "browser_specific_settings": {"gecko": {"id": "atstash@atstash.example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "browser_action": {"default_title": "AtStash", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}