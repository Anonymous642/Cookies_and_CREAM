{"manifest_version": 3, "name": "Volume Booster by SonicLab", "version": "2.0.0", "description": "Amplify any tab up to 300% with a built-in limiter, or boost an audio file and export it. Audio never leaves your device.", "author": "SonicLab", "homepage_url": "https://soniclab.io/tools/volume-booster", "permissions": ["storage", "activeTab"], "background": {"scripts": ["src/platform/browser.js", "src/core/boost.js", "src/core/messages.js", "background/service-worker.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/platform/browser.js", "src/core/boost.js", "src/core/settings.js", "src/core/messages.js", "src/audio/boost-chain.js", "src/audio/source-safety.js", "src/audio/live-engine.js", "src/audio/media-scanner.js", "content/content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": false}], "action": {"default_popup": "popup.html", "default_title": "Volume Booster by SonicLab", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "volume-booster@soniclab.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}