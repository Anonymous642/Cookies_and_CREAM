{"manifest_version": 3, "name": "Spendwise", "version": "3.2", "description": "Track your expenses across Zomato, Swiggy, Blinkit, Zepto and more \u2014 automatically. Fully local, all data stays on your device.", "author": "Vishal", "browser_specific_settings": {"gecko": {"id": "spendwise@vishaltodkar.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "permissions": ["storage", "scripting"], "host_permissions": ["*://*.zomato.com/*", "*://*.swiggy.com/*", "*://prod-api.swiggy.com/*", "*://*.blinkit.com/*", "*://*.zepto.com/*"], "background": {"scripts": ["background.bundle.js"]}, "content_scripts": [{"matches": ["*://*.zomato.com/*"], "js": ["content-scripts/dist/zomato.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["*://*.swiggy.com/*"], "js": ["content-scripts/dist/swiggy.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["*://*.blinkit.com/*"], "js": ["content-scripts/dist/blinkit.js"], "run_at": "document_end", "all_frames": false}, {"matches": ["*://*.zepto.com/*"], "js": ["content-scripts/dist/zepto.js"], "run_at": "document_end", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Spendwise", "default_icon": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}}