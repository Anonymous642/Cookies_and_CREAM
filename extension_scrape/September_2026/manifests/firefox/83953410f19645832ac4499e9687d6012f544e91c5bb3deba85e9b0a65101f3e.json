{"manifest_version": 3, "name": "ClueRate", "version": "0.4.61", "browser_specific_settings": {"gecko": {"id": "firefox-ext@cluerate.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "homepage_url": "https://cluerate.com", "author": "Musatunix Innovations LLC", "description": "Score jobs, tailor your CV, and fill application forms with your ClueRate profile. Official website: https://cluerate.com", "permissions": ["alarms", "storage", "activeTab", "scripting", "webNavigation", "cookies"], "host_permissions": ["https://api.cluerate.com/*", "https://cluerate.com/*"], "optional_host_permissions": ["<all_urls>"], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_title": "ClueRate", "default_popup": "cr_activate.html"}, "content_scripts": [{"matches": ["https://cluerate.com/*"], "js": ["cr_auth_interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://cluerate.com/*"], "js": ["cr_config.js", "cr_auth_bridge.js"], "run_at": "document_start"}], "background": {"scripts": ["cr_config.js", "cr_signal_rules_defaults.js", "cr_signal_rules.js", "cr_site_config_defaults.js", "cr_site_config.js", "cr_af_messages.js", "cr_profile_cache.js", "cr_autofill_sound.js", "cr_autofill_speech.js", "cr_autofill_badge.js", "cr_job_monitor.js", "cr_job_monitor_background.js", "cr_staleness.js", "cr_background.js"]}, "web_accessible_resources": [{"resources": ["job2cv_rules.json", "icons/icon.svg", "icons/cr_cv_view_64.png"], "matches": ["<all_urls>"]}]}