{"manifest_version": 3, "name": "no-shorts", "version": "0.1.0", "description": "Hide YouTube Shorts everywhere and redirect /shorts/<id> URLs to the regular video player.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{ab011a6f-b66b-4476-9649-302a3aac66b9}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*"], "declarative_net_request": {"rule_resources": [{"id": "shorts_redirect", "enabled": true, "path": "redirect-rules.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["hide.css"], "run_at": "document_start", "all_frames": false}]}