{"manifest_version": 3, "name": "Etherpad Archiver", "version": "1.3.4", "description": "Archive Etherpad pads to local disk as versioned snapshots with human-meaningful metadata", "permissions": ["downloads", "storage", "activeTab", "notifications"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Open Etherpad Archiver popup"}, "quick-archive": {"suggested_key": {"default": "Alt+Shift+C", "mac": "MacCtrl+Shift+C"}, "description": "Quick archive current pad (uses saved metadata)"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "default_title": "Etherpad Archiver"}, "background": {"scripts": ["utils/url.js", "utils/storage.js", "utils/hash.js", "utils/pad-state.js", "services/export.js", "services/download.js", "services/folder-scheme.js", "services/archive.js", "background.js"]}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "etherpad-archiver@barredowl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}