{"manifest_version": 3, "name": "Full Page Screen Capture", "version": "1.0", "description": "Captures a screenshot of the entire web page using the Scroll & Stitch method.", "permissions": ["activeTab", "scripting", "downloads"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Capture Full Page", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "screenshot-tool@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}