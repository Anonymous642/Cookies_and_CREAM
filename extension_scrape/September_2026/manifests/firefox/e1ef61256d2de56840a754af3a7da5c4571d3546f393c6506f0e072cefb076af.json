{"manifest_version": 2, "name": "autoformlb \u2014 robot de llenado", "version": "0.1.2", "description": "Sube al Google Form los registros capturados en la app autoformlb.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "robot@autoformlb", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "unlimitedStorage", "tabs", "https://docs.google.com/*", "https://drive.google.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://autoformlb.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content-bridge.js"], "run_at": "document_start"}, {"matches": ["https://docs.google.com/forms/*"], "js": ["content-form.js"], "run_at": "document_idle"}, {"matches": ["https://docs.google.com/*", "https://drive.google.com/*"], "exclude_matches": ["https://docs.google.com/forms/*"], "js": ["content-picker.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}]}