{"manifest_version": 3, "name": "Universal Ad Blocker", "version": "2.9.2", "description": "Removes Google, LinkedIn, Reddit, Twitter/X, overlay, banner, and various video ads from all websites", "author": "Andrii Povkh", "host_permissions": ["<all_urls>"], "permissions": ["webRequest", "webRequestBlocking", "declarativeNetRequest"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "background": {"scripts": ["background.js"], "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "ad_block_rules", "enabled": true, "path": "rules/ad_block_rules.json"}]}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "browser_specific_settings": {"gecko": {"id": "andrii.povkh@gmail.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}