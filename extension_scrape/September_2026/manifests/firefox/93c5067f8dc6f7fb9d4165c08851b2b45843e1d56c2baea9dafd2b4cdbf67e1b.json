{"manifest_version": 3, "name": "PageTidy", "short_name": "PageTidy", "version": "1.0.2", "version_name": "1.0.2 Firefox + Android launch", "description": "Remove annoying page clutter, restore broken scrolling, and remember the sites you want to keep clean.", "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["extension-config.js", "background.js"]}, "action": {"default_title": "PageTidy", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"quick-clean": {"suggested_key": {"default": "Alt+Shift+X", "mac": "Alt+Shift+X"}, "description": "Remove the most likely blocking overlay and restore scrolling"}}, "options_page": "rules.html", "browser_specific_settings": {"gecko": {"id": "pagetidy@ansonalexander.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}