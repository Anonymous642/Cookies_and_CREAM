{"manifest_version": 3, "name": "DanceJump for Youtube - Rhythm Dance Game", "version": "0.4.1", "description": "Turn YouTube into a retro rhythm dance game. Auto-chart any song, play with a dance mat or controller, and enjoy local multiplayer.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": [], "background": {"scripts": ["assets/js/background.js"]}, "browser_specific_settings": {"gecko": {"id": "dancejump@dancejump.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {}}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/img/icon16.png", "48": "assets/img/icon48.png", "128": "assets/img/icon128.png"}}, "icons": {"16": "assets/img/icon16.png", "48": "assets/img/icon48.png", "128": "assets/img/icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["assets/js/game.js"], "css": ["assets/css/overlay.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["assets/js/*", "assets/fonts/*", "assets/css/*", "assets/img/*", "src/popup/*", "src/welcome/*"], "matches": ["*://*.youtube.com/*"]}]}