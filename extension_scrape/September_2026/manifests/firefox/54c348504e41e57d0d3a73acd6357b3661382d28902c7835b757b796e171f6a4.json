{"manifest_version": 2, "name": "Aethra", "short_name": "Aethra", "version": "1.0.0", "description": "Companion extension for Aethra password manager. Auto-fill credentials, generate passwords, and manage your vault from any website.", "author": "Aethra", "homepage_url": "https://aethra.cc", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "clipboardWrite", "tabs", "http://127.0.0.1:11337/*", "http://localhost:11337/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Aethra"}, "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com", "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "support@aethra.cc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "MacCtrl+Shift+K"}, "description": "Open Aethra"}, "quick-fill": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Quick fill credentials on current page"}}}