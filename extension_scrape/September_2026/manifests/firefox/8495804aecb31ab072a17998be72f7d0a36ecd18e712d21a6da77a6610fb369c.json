{"manifest_version": 3, "name": "Trusty \u2014 Badge de confiance", "version": "1.0.0", "description": "Affiche le badge Trusty sur les sites v\u00e9rifi\u00e9s et vous alerte lorsqu'un site n'est pas v\u00e9rifi\u00e9.", "permissions": ["storage", "tabs"], "host_permissions": ["https://trusty.abdatytch.com/*", "http://localhost:8086/*"], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "trusty-extension@trusty.fr", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "src/popup.html", "default_title": "Trusty \u2014 V\u00e9rificateur de confiance", "default_icon": {"16": "icons/neutral-16.png", "32": "icons/neutral-32.png", "48": "icons/neutral-48.png", "128": "icons/neutral-128.png"}}, "icons": {"16": "icons/neutral-16.png", "32": "icons/neutral-32.png", "48": "icons/neutral-48.png", "128": "icons/neutral-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/config.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"]}]}