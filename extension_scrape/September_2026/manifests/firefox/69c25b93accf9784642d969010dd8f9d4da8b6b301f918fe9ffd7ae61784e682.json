{"manifest_version": 3, "name": "IG Sidebar Focus", "version": "1.0.0", "description": "A sidebar for Instagram with automatic UI focus improvements for chat usage.", "browser_specific_settings": {"gecko": {"id": "ig-focus-sidebar@nasif.naseef", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://www.instagram.com/*", "https://m.instagram.com/*"], "icons": {"512": "logo.png"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "IG Focus Chat", "default_icon": "logo.png"}, "content_scripts": [{"matches": ["https://www.instagram.com/direct/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}