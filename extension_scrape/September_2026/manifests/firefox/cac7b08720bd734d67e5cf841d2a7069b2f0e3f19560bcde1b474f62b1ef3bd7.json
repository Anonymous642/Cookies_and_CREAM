{"manifest_version": 3, "name": "Custom Admin Panel Theme", "version": "2.0.0", "description": "Ubah warna & tambahkan efek glow pada bagian tertentu di panel admin (sidebar, header panel, tombol, ticker, tabel, form, badge, dll) sesuai keinginan Anda.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Atur Tema Panel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true, "browser_style": false}, "content_scripts": [{"matches": ["*://*/*"], "js": ["theme-config.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "custom-admin-theme@local.ext", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}