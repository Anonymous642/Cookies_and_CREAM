{"manifest_version": 2, "name": "YouTube Ad Skipper", "version": "1.3", "description": "Mutes and skips YouTube ads automatically.", "permissions": ["tabs", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "ad-skipper-your-name@example.com"}}}