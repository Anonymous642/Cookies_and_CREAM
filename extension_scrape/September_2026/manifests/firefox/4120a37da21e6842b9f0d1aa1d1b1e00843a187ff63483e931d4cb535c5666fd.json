{"manifest_version": 3, "name": "Pas vu !", "version": "0.1.9", "description": "Pour un web apais\u00e9. Masque ou floute des r\u00e9sultats de moteurs de recherche selon une liste de domaines et/ou de mots-cl\u00e9s, et r\u00e9v\u00e8le au survol qui poss\u00e8de chaque m\u00e9dia. Supporte Google (FR/COM), DuckDuckGo, Bing, Qwant et Startpage (Web, News, Images, Vid\u00e9os, Shopping). Compteur sur l'ic\u00f4ne, import / export JSON.", "browser_specific_settings": {"gecko": {"id": "search-filter@local.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "contextMenus", "activeTab"], "host_permissions": ["*://www.google.com/*", "*://www.google.fr/*", "*://duckduckgo.com/*", "*://www.bing.com/*", "*://www.qwant.com/*", "*://www.startpage.com/*"], "background": {"scripts": ["lib/shared.js", "welcome/changelog.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_title": "Pas vu !", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://www.google.fr/search*"], "js": ["lib/shared.js", "content/common.js", "content/google.js"], "css": ["content/filter.css"], "run_at": "document_idle"}, {"matches": ["*://duckduckgo.com/*"], "js": ["lib/shared.js", "content/common.js", "content/ddg.js"], "css": ["content/filter.css"], "run_at": "document_idle"}, {"matches": ["*://www.bing.com/search*", "*://www.bing.com/news/search*", "*://www.bing.com/images/search*", "*://www.bing.com/videos/search*"], "js": ["lib/shared.js", "content/common.js", "content/bing.js"], "css": ["content/filter.css"], "run_at": "document_idle"}, {"matches": ["*://www.qwant.com/*"], "js": ["lib/shared.js", "content/common.js", "content/qwant.js"], "css": ["content/filter.css"], "run_at": "document_idle"}, {"matches": ["*://www.startpage.com/*"], "