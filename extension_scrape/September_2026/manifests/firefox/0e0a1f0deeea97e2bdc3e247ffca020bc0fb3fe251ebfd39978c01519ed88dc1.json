{"manifest_version": 3, "name": "ARCON EPM Browser Guard", "description": "Unified extension for browser and website security policy enforcement", "version": "1.0.8", "permissions": ["management", "tabs", "storage", "alarms", "notifications", "activeTab", "webNavigation", "nativeMessaging"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popups/popup.html", "default_title": "ARCON EPM Browser Guard"}, "icons": {"75": "icons/icon48.png"}, "web_accessible_resources": [{"resources": ["popups/url_restriction.html", "images/restricted-icon.svg"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "arcon-epm-guard-1@arcon.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}