{"manifest_version": 3, "name": "Marketplace Car Deal Finder", "version": "1.0.0", "description": "Ranks visible Facebook Marketplace vehicle listings by estimated value and deal quality.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://www.facebook.com/*"], "browser_specific_settings": {"gecko": {"id": "marketplace-car-deal-finder@local", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Car Deal Finder", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.facebook.com/marketplace/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}