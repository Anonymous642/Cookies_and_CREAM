{"manifest_version": 2, "name": "Tab Colorizer", "version": "2.0", "description": "Color the full tab header by website domain", "permissions": ["tabs", "storage", "theme", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Tab Colorizer", "default_icon": {"48": "icons/icon48.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "browser_specific_settings": {"gecko": {"id": "tab-colorizer@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}