{"manifest_version": 3, "name": "Seenify - Email Tracker", "short_name": "Seenify", "version": "3.2.2", "description": "Track email opens in real time, get read receipts, monitor recipients individually, and receive instant notifications.", "author": "codeguyakash", "homepage_url": "https://seenify.codeguyakash.in", "browser_specific_settings": {"gecko": {"id": "seenify@codeguyakash.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["https://mail.google.com/*", "https://seenify.codeguyakash.in/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "src/assets/icon-16x16.png", "24": "src/assets/icon-24x24.png", "32": "src/assets/icon-32x32.png", "48": "src/assets/icon-48x48.png", "128": "src/assets/icon-128x128.png"}}, "icons": {"16": "src/assets/icon-16x16.png", "24": "src/assets/icon-24x24.png", "32": "src/assets/icon-32x32.png", "48": "src/assets/icon-48x48.png", "128": "src/assets/icon-128x128.png"}, "background": {"scripts": ["src/utils/auth.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/assets/*"], "matches": ["https://mail.google.com/*"]}]}