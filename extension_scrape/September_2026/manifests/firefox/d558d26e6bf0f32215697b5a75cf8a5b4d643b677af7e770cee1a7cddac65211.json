{"manifest_version": 3, "name": "GeoGuesser Hacker Add-on", "version": "2.42", "description": "Get exact coordinates in GeoGuessr and OpenGuessr with Auto Place, Smart Zoom, and a free trial.", "permissions": ["storage", "scripting", "tabs", "windows"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["xhr_inject.js"], "matches": ["https://www.geoguessr.com/*", "https://openguessr.com/*", "https://www.openguessr.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; connect-src 'self' https://extensionpay.com https://us-central1-geoguesser-hacker-ext.cloudfunctions.net https://nominatim.openstreetmap.org; object-src 'self'"}, "action": {"default_icon": {"16": "images/geolocationbot16.png", "64": "images/geolocationbot64.png", "128": "images/geolocationbot128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://extensionpay.com/*"], "js": ["extpay.js"], "run_at": "document_start"}, {"matches": ["https://www.geoguessr.com/*", "https://openguessr.com/*", "https://www.openguessr.com/*"], "js": ["geoguessr-content.js"], "all_frames": true, "run_at": "document_end"}], "homepage_url": "https://geoguessrhack.com", "sidebar_action": {"default_title": "GeoGuesser Hacker Add-on", "default_panel": "sidepanel/sidepanel.html"}, "browser_specific_settings": {"gecko": {"id": "geoguessrhacker@geoguessrhack.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"]}}}}