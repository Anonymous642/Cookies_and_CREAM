{"manifest_version": 2, "name": "Free Game Notifier", "version": "1.0.0", "description": "Get notified when free games are available on various game stores", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["storage", "alarms", "notifications", "tabs", "https://store-site-backend-static-ipv4.ak.epicgames.com/*", "https://www.freetogame.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_title": "Free Game Notifier", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "free-game-notifier@example.com", "strict_min_version": "58.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["notification/notification.html", "notification/notification.css", "notification/notification.js", "icons/*"]}