{"manifest_version": 3, "name": "Simple Tab Refresher", "version": "1.0.1", "description": "Refresh the current tab automatically at a user-defined interval.", "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Simple Tab Refresher", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "panicrefresher@paniclooplabs.com", "data_collection_permissions": {"required": ["none"]}}}}