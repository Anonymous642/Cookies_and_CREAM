{"manifest_version": 3, "name": "Cleristical", "version": "0.3.0", "description": "Save bookmarks to Cleristical from your browser toolbar.", "action": {"default_popup": "popup.html", "default_title": "Save to Cleristical"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "identity", "storage"], "host_permissions": ["https://cleristical.com/*", "https://*.cleristical.com/*", "https://*.workers.dev/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@cleristical.com", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "bookmarksInfo"]}}}}