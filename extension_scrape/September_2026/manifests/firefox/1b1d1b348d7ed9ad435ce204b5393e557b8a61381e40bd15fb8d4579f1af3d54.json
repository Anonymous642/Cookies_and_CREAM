{"manifest_version": 2, "name": "Smart Redirect", "description": "Redirige automatiquement un site vers un autre selon vos r\u00e8gles personnalis\u00e9es.", "version": "1.0.0", "permissions": ["webRequest", "webRequestBlocking", "storage", "<all_urls>"], "background": {"scripts": ["background/background.js"], "persistent": true}, "browser_action": {"default_title": "Claude Redirect", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "claude-redirect@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}