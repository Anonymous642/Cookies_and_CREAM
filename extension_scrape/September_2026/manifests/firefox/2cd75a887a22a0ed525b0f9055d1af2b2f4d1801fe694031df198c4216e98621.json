{"manifest_version": 3, "name": "Free Local Rank Guru Tracker & Checker", "version": "1.3", "description": "Free GMB and local rank checker for Google Maps: run geo-grid scans, track keyword rankings, and save results to Local Rank Guru.", "permissions": ["scripting", "storage", "tabs", "alarms"], "host_permissions": ["https://www.google.com/maps*", "https://*.google.com/maps/*", "https://localrank.guru/*", "https://*.localrank.guru/*"], "background": {"scripts": ["background/service_worker.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png", "fonts/Nunito-latin.woff2"], "matches": ["https://*.google.com/*", "https://localrank.guru/*", "https://*.localrank.guru/*"]}], "browser_specific_settings": {"gecko": {"id": "firefox-extension@localrank.guru", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "locationInfo", "searchTerms", "websiteContent"]}}}}