{"manifest_version": 3, "name": "InsightHub", "version": "1.0.4", "description": "InsightHub is a creator toolkit with smart tools to analyze, optimize, and grow YouTube channels.", "icons": {"24": "icons/logo-24.png", "48": "icons/logo-48.png", "96": "icons/logo-96.png"}, "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"], "host_permissions": ["https://*.youtube.com/*", "https://generativelanguage.googleapis.com/*", "https://chatgpt.com/*"], "web_accessible_resources": [{"resources": ["icons/*", "Modules/thumbnail-tester/*", "Modules/ask-chat-gpt/*", "Modules/smart-reply-assistant/*", "Modules/channel-insights/*", "Modules/view-tags/*"], "matches": ["https://*.youtube.com/*", "https://chatgpt.com/*"]}], "side_panel": {"default_path": "Bootstrapper/popup.html"}, "action": {"default_title": "InsightHub"}, "background": {"type": "module", "scripts": ["Bootstrapper/background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["Modules/view-tags/content.js"], "css": ["Modules/view-tags/content.css"], "run_at": "document_idle"}, {"matches": ["https://studio.youtube.com/*", "https://www.youtube.com/*"], "js": ["Modules/smart-reply-assistant/content.js"], "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/*"], "js": ["Modules/channel-insights/content.js"], "css": ["Modules/channel-insights/content.css"], "run_at": "document_idle"}, {"matches": ["https://*.youtube.com/*"], "js": ["Modules/thumbnail-tester/content.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["Modules/ask-chat-gpt/content_script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "insighthub@addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}