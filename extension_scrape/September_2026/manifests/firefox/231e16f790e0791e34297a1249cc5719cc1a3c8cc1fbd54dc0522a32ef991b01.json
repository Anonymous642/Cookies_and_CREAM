{"manifest_version": 2, "name": "Perplexity Bridge", "version": "0.1.0", "description": "Bridge local jobs to a real Perplexity tab in regular Firefox.", "permissions": ["tabs", "http://127.0.0.1:8788/*", "https://www.perplexity.ai/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.perplexity.ai/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "perplexity-bridge@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "searchTerms"]}}}}