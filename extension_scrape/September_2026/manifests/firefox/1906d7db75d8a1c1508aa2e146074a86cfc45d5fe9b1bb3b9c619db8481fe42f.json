{"manifest_version": 3, "name": "GLPI Ticket Notifier", "version": "1.1.0", "description": "Receba notifica\u00e7\u00f5es de novos tickets do GLPI em tempo real", "permissions": ["notifications", "storage", "alarms"], "optional_permissions": ["offscreen"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "glpi-notifier@extension", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}