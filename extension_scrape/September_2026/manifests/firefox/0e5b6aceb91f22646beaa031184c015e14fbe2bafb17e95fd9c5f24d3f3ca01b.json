{"manifest_version": 3, "name": "Glimpse", "version": "1.1.15", "description": "Hover a citation in a PDF and preview the cited paper (PDF or abstract) in a floating in-tab panel.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "tabs", "webRequest", "webRequestBlocking", "webRequestFilterResponse"], "host_permissions": ["<all_urls>", "file:///*"], "action": {"default_title": "Glimpse \u2014 PDF Preview", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["panel.css", "pdf.worker.js", "pagefetch.js", "viewer.html", "viewer.js", "viewer.css", "tooltip.css", "pdf_viewer.css", "images/*", "icons/*"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "glimpse@merfanian.github.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}