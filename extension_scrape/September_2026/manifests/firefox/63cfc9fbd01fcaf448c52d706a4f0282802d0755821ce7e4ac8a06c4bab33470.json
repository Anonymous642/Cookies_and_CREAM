{"name": "ServiceNow Link Manager", "description": "This extension ensures that record urls opened in ServiceNow do not spawn multiple tabs, consolidating them into a single workspace.", "version": "1.1", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "nowlink-manager@example.com", "data_collection_permissions": {"required": ["locationInfo"]}}}, "action": {"default_popup": "hello.html", "default_icon": {"16": "now-extension.png", "48": "now-extension.png", "128": "now-extension.png"}}, "permissions": ["tabs", "management", "scripting", "storage", "webNavigation"], "icons": {"16": "now-extension.png", "48": "now-extension.png", "128": "now-extension.png"}, "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["service_worker.js"]}}