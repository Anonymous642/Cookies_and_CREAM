{"manifest_version": 3, "name": "No YouTube Shorts", "author": "Ayanami Kaine", "version": "1.0.1", "description": "Hides YouTube Shorts and opens Shorts links in the normal video player.", "browser_specific_settings": {"gecko": {"id": "no-youtube-shorts@ayanamikaine.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "css": ["shorts.css"], "js": ["shorts.js"], "run_at": "document_start"}]}