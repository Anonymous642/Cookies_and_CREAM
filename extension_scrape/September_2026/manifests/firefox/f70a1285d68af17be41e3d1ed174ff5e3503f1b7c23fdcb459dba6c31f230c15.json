{"manifest_version": 2, "name": "Jinglebeezer", "version": "1.0", "description": "Replaces NSFW words in the current web page with 'jinglebees'.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Jinglebeezer", "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "applications": {"gecko": {"id": "nsfw-replacer@example.com"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}