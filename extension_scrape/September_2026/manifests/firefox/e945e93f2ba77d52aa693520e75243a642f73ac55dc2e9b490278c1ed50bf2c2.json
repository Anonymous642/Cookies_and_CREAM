{"manifest_version": 2, "name": "Greader", "version": "1.0.3", "description": "Applies color gradients to text lines for readability", "permissions": ["activeTab", "<all_urls>", "storage"], "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Toggle Greader"}, "browser_specific_settings": {"gecko": {"id": "gradient-reader@github.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}