{"manifest_version": 3, "name": "Volume Booster (up to 500%)", "version": "1.2.0", "description": "Boost audio/video volume above 100% (up to 500%) on any website. Per-site on/off switch and per-site level are remembered. New sites default to 200%.", "permissions": ["storage", "activeTab", "tabs"], "action": {"default_title": "Volume Booster", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{680dd035-2e0b-406e-b0a3-a40f0acc614c}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}