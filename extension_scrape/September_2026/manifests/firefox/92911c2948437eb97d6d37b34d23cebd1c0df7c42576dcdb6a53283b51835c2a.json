{"manifest_version": 3, "name": "YouTube Clean URL", "short_name": "YT Clean URL", "description": "Copy clean YouTube URLs.", "version": "1.0.0", "permissions": ["tabs", "scripting", "clipboardWrite"], "host_permissions": ["https://youtube.com/*", "https://*.youtube.com/*", "https://youtu.be/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Copy clean YouTube URL", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"copy-clean-youtube-url": {"suggested_key": {"default": "Ctrl+Alt+Y"}, "description": "Copy clean YouTube URL"}, "copy-clean-youtube-url-with-timestamp": {"suggested_key": {"default": "Ctrl+Alt+U"}, "description": "Copy clean YouTube URL with timestamp"}}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "@youtube-clean-url", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}