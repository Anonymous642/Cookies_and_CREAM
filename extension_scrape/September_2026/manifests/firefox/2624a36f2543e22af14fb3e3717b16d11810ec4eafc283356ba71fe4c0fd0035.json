{"manifest_version": 2, "name": "Nationaal warmtefonds gegevens verzamelen.", "description": "Laat eenvoudig de gegevens ophalen die Warmtefonds nodig heeft voor de beoordeling van je aanvraag van een Energiebespaarlening. Daarvoor heb je deze extensie nodig. De gegevens die met de extensie worden opgehaald, komen in \u00e9\u00e9n overzichtelijk document. Dat kun je bekijken voor je het doorstuurt naar Warmtefonds.", "version": "3.1.0", "content_security_policy": "script-src 'self'; object-src 'self'", "homepage_url": "https://www.energiebespaarlening.nl/", "applications": {"gecko": {"id": "nwf-amo@iwize.nl", "strict_min_version": "60.0"}}, "icons": {"32": "resources/logo32X32.png", "48": "resources/logo48X48.png", "128": "resources/logo128X128.png"}, "content_scripts": [{"matches": ["https://iwize.nl/generic/*", "https://*.aqopi.com/*", "https://*.overheid.nl/*", "https://*.mijnpensioenoverzicht.nl/*", "https://*.uwv.nl/*", "https://*.belastingdienst.nl/*", "https://*.duo.nl/*", "https://*.digid.nl/*"], "run_at": "document_start", "js": ["content/content.js", "content/actions.js", "content/helpers/utils.js", "content/crypto.js", "content/templateMatching.js", "content/fetchBlob.js", "content/downloadPdfByClick.js", "content/fetchJson.js"]}, {"matches": ["https://mijn.duo.nl/*"], "run_at": "document_start", "js": ["content/fetchJsonWithAuthHeader.js"]}, {"all_frames": true, "matches": ["https://iwize.nl/*"], "run_at": "document_start", "js": ["content/requestor-content.js"]}], "permissions": ["tabs", "activeTab", "cookies", "webRequest", "webNavigation", "https://*.aqopi.com/*", "https://iwize.nl/*", "https://*.overheid.nl/*", "https://*.mijnpensioenoverzicht.nl/*", "https://*.uwv.nl/*", "https://*.belastingdienst.nl/*", "https://*.duo.nl/*", "https://*.digid.nl/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "resources/logo32X32.png", "default_title": "Nationaal Warmtefonds"}, "web_accessible_resources": ["resources/logo80X80.p