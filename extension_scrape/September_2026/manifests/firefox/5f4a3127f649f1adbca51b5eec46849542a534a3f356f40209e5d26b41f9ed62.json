{"manifest_version": 3, "name": "QuickGBP", "version": "1.0.0", "description": "Highlight any price anywhere on the web and instantly see its value in British Pounds. No popups, no tabs, no interruption.", "permissions": ["storage"], "host_permissions": ["https://open.er-api.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["parser.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "QuickGBP \u2013 Settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "quickgbp@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}