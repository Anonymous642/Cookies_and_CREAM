{"manifest_version": 3, "name": "Check My Links", "version": "8.1.5", "description": "Check My Links is a link checker that crawls through your webpage and looks for broken links.", "browser_specific_settings": {"gecko": {"id": "checkmylinks@selectorshub.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "logo/48.png", "96": "logo/96.png", "128": "logo/128.png"}, "background": {"scripts": ["/js/background.js"]}, "content_security_policy": {"extension_pages": "style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'self';"}, "action": {"default_title": "Check My Links"}, "permissions": ["scripting", "storage", "tabs", "webRequest"], "host_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Open Check My Links"}}, "web_accessible_resources": [{"resources": ["pages/linkreport.html"], "matches": ["<all_urls>"]}]}