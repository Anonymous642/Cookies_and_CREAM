{"manifest_version": 2, "name": "YT Spoiler Shield", "version": "1.1", "description": "Hide YouTube video duration, progress bar and timestamps to avoid spoilers.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_popup": "popup.html", "default_title": "YT Spoiler Shield"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "tabs", "*://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "yt-spoiler-shield@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}