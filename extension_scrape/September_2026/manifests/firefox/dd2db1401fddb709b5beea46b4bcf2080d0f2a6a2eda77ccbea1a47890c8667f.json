{"manifest_version": 2, "name": "FastHostInfo", "version": "1.6.3", "description": "Displays host information including the flag representing the geographic location of the server for the current tab. Requires access to web requests to detect server IP addresses and access to ip.guide for detailed location data.", "permissions": ["tabs", "webRequest", "storage", "alarms", "<all_urls>", "https://ip.guide/*", "https://cloudflare-dns.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Server location", "default_popup": "popup.html", "default_icon": {"16": "icon.svg", "32": "icon.svg"}}, "icons": {"48": "icon.svg", "128": "icon.svg"}, "web_accessible_resources": ["flags/1x1/*.svg", "flags/4x3/*.svg"], "browser_specific_settings": {"gecko": {"id": "yann.fahrni@pm.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}