{"manifest_version": 2, "name": "Lambda Env Extractor", "version": "1.0.2", "description": "Extract AWS Lambda environment variables to clipboard in JSON or .env format", "permissions": ["clipboardWrite", "activeTab", "https://*.console.aws.amazon.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "content_scripts": [{"matches": ["https://*.console.aws.amazon.com/lambda/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "lambda-env-extractor@yourname.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}