{"manifest_version": 3, "name": "Outreach", "version": "0.4.0", "description": "Draft project-aware Fastmail replies with Codex, then review and send them yourself.", "incognito": "spanning", "permissions": ["storage", "scripting", "clipboardWrite", "webRequest", "webRequestBlocking"], "optional_host_permissions": ["ws://*/*", "wss://*/*"], "host_permissions": ["https://app.fastmail.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws: wss:;"}, "icons": {"16": "public/icon-16.png", "32": "public/icon-32.png", "48": "public/icon-48.png", "96": "public/icon-96.png", "128": "public/icon-128.png"}, "action": {"default_title": "Open Outreach", "default_icon": {"16": "public/icon-16.png", "32": "public/icon-32.png"}}, "background": {"scripts": ["shared.js", "repository.js", "reply-context.js", "codex-client.js", "background.js"]}, "content_scripts": [{"matches": ["https://app.fastmail.com/*"], "js": ["shared.js", "fastmail-dom.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["public/icon-32.png"], "matches": ["https://app.fastmail.com/*"]}], "options_ui": {"page": "workspace.html#settings", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "outreach@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications", "authenticationInfo", "browsingActivity"]}}}}