{"manifest_version": 3, "name": "CineHighlight Pro", "description": "Automatically bookmark and instantly replay your favorite movie scenes across popular streaming platforms.", "version": "1.0.0", "author": "CineTools Lab", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.primevideo.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cinehighlightpro@cinetoolslab.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}