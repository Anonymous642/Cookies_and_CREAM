{"manifest_version": 3, "name": "PrivaTokGram", "version": "1.4.0", "description": "Redirige Instagram y TikTok a frontends alternativos sin inicio de sesi\u00f3n.", "permissions": ["storage", "webRequest", "webRequestBlocking", "webNavigation"], "host_permissions": ["*://*.instagram.com/*", "*://*.tiktok.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_icon": "icons/icon.svg"}, "icons": {"48": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "privatokgram@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}