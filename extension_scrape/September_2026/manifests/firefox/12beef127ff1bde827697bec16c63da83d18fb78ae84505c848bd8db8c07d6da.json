{"manifest_version": 3, "name": "YouTube Unwatched Filter", "version": "1.1.4", "description": "Adds a toggle on YouTube channel/video grids to hide videos you've already watched, using YouTube's own watch-progress data.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "YouTube Unwatched Filter"}, "browser_specific_settings": {"gecko": {"id": "youtube-unwatched-filter@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}}