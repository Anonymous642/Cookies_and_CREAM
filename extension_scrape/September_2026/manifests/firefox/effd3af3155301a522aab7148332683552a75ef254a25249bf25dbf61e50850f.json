{"manifest_version": 2, "name": "DealRadar \u2014 Price Drop & Coupon Finder", "version": "1.0.0", "description": "Instantly find coupons, track price drops, and compare prices across stores. Save money on every purchase.", "author": "DealRadar", "homepage_url": "https://github.com/theyngkeem/dealradar", "browser_specific_settings": {"gecko": {"id": "dealradar@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "DealRadar \u2014 Check Deals", "default_popup": "popup/popup.html"}, "background": {"scripts": ["utils/affiliates.js", "utils/priceHistory.js", "utils/coupons.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.walmart.com/*", "*://*.etsy.com/*", "*://*.aliexpress.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "permissions": ["activeTab", "storage", "tabs", "notifications"], "optional_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.ca/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.walmart.com/*", "*://*.etsy.com/*", "*://*.aliexpress.com/*"], "web_accessible_resources": ["icons/*"]}