{"name": "littledots", "description": "Send any URL, place, or selection to littledots in one tap.", "version": "0.1.4", "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://littledots.com/*"], "externally_connectable": {"matches": ["https://littledots.com/*"]}, "action": {"default_popup": "entrypoints/popup.html", "default_title": "Send to littledots"}, "icons": {"128": "assets/icon-128.png"}, "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "littledots@littledots.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}}, "background": {"scripts": ["service-worker-loader.js"], "type": "module"}}