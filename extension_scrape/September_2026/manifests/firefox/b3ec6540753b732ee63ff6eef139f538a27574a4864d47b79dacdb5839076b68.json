{"manifest_version": 3, "name": "YouTube Playback Speed", "version": "1.0.0", "description": "Changes the playback speed directly from the YouTube player controls.", "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "YouTube Playback Speed", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@youtube-playback-speed.dyzrol", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["speed-core.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}