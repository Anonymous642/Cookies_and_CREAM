{"manifest_version": 3, "name": "ReadFlow Read Later", "version": "1.1.0", "description": "Save pages and links to your ReadFlow read-later library.", "permissions": ["activeTab", "storage", "contextMenus", "alarms", "scripting", "notifications", "identity"], "host_permissions": ["https://readflow.org/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Save to ReadFlow", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background/service_worker.js"], "type": "module"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "read-later@readflow.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "commands": {"save-current-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current page to ReadFlow"}}}