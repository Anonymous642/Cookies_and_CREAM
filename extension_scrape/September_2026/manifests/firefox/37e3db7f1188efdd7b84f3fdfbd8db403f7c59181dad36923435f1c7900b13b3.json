{"manifest_version": 3, "name": "MuBrowse", "version": "1.2", "description": "Background music player for websites to make browsing the web fun.", "permissions": ["storage", "activeTab", "tabs", "webNavigation", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon128.png", "48": "icon128.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon128.png", "48": "icon128.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "mubrowse@yourdomain.com", "strict_min_version": "109.0"}}}