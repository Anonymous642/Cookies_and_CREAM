{"manifest_version": 2, "name": "Wishly - Add to Wishlist", "version": "1.0.0", "description": "Quickly add products from any website to your Wishly wishlist", "permissions": ["activeTab", "storage"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "wishly@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}