{"manifest_version": 3, "name": "Search Tab Remover", "version": "1.0", "description": "Remove \"Image\", \"Video\", \"Short Video\" tab from google, bing, baidu, sogou search result", "permissions": ["activeTab"], "content_scripts": [{"matches": ["https://www.google.com/*"], "js": ["google-rm.js"], "css": ["google-hide.css"], "run_at": "document_idle"}, {"matches": ["https://www.bing.com/*", "https://cn.bing.com/*"], "js": ["bing-rm.js"], "css": ["bing-hide.css"], "run_at": "document_idle"}, {"matches": ["https://www.baidu.com/*"], "js": ["baidu-rm.js"], "css": ["baidu-hide.css"], "run_at": "document_idle"}, {"matches": ["https://www.sogou.com/*", "https://pic.sogou.com/*"], "js": ["sogou-rm.js"], "css": ["sogou-hide.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "no_image_video_tab@dayac0000.github", "strict_min_version": "58.0"}}}