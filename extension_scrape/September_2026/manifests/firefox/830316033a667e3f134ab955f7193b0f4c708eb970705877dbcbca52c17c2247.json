{"manifest_version": 2, "name": "Green Privacy", "version": "1.0", "description": "Bewertet Datenschutz & Nachhaltigkeit von Websites \u2013 komplett lokal und ohne Tracking. Datenquellen: ToS;DR und The Green Web Foundation.", "browser_action": {"default_popup": "popup.html"}, "icons": {"32": "icons/privacygreen-32.png", "48": "icons/privacygreen-48.png", "96": "icons/privacygreen-96.png"}, "permissions": ["activeTab", "storage"], "web_accessible_resources": ["websites.json"], "browser_specific_settings": {"gecko": {"id": "@green-privacy.sandiegokun", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}