{"manifest_version": 2, "name": "MyMiniFactory Download Tool", "version": "5.1", "description": "Adds the ability to Bulk download files from your Library in MyMiniFactory", "browser_specific_settings": {"gecko": {"id": "MyMiniFactory-Download-Tool@extension", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "activeTab", "storage", "tabs", "*://*.myminifactory.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}, "default_title": "MMF Download Tool"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://www.myminifactory.com/library*", "*://myminifactory.com/library*"], "js": ["library.js"], "run_at": "document_idle"}]}