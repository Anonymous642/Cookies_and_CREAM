{"manifest_version": 3, "name": "fingerprint", "description": "A browser extension which summarises servers and resources loaded by a page", "version": "0.0.6", "browser_specific_settings": {"gecko": {"id": "fingerprint@example.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "images/fingerprint16.png", "48": "images/fingerprint48.png", "128": "images/fingerprint128.png"}, "action": {"default_icon": {"19": "images/fingerprint.png", "38": "images/fingerprint-hidpi.png"}, "default_popup": "html/popup.html"}, "background": {"scripts": ["js/background.js"], "type": "module"}, "permissions": ["webRequest", "webNavigation", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["data/*.bin", "data/*.json"], "matches": ["<all_urls>"]}]}