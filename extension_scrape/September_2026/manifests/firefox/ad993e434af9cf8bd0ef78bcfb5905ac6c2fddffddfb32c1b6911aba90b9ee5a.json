{"manifest_version": 3, "name": "X Focus Mode \u2013 Clean Home Feed", "version": "1.2.0", "description": "Take control of your X feed. Hides the \"For you\" tab that pushes engagement-driven content. Auto-switches to \"Following\".", "browser_specific_settings": {"gecko": {"id": "x-clean-home@dev.vakilie", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}