{"manifest_version": 2, "name": "Website Guard", "version": "1.0", "description": "Asks before visiting specific websites with a 10 second countdown to help avoid distractions.", "homepage_url": "https://github.com/yourusername/website-guard", "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "Website Guard", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": ["warning.html"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "website-guard@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "usage": false, "error": false, "personalization": false}}}}