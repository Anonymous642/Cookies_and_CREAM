{"manifest_version": 3, "name": "Rastreador de Pre\u00e7os \u2014 BR (MVP)", "version": "0.4.0", "description": "L\u00ea o pre\u00e7o da p\u00e1gina de produto que voc\u00ea est\u00e1 vendo (Terabyte, Kabum, Pichau) e avisa quando fica mais barato. N\u00e3o faz requisi\u00e7\u00e3o pra site nenhum.", "browser_specific_settings": {"gecko": {"id": "mnt-tracker@rastreador.br", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "notifications"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.terabyteshop.com.br/*", "*://*.kabum.com.br/*", "*://*.pichau.com.br/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Rastreador de Pre\u00e7os", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}}