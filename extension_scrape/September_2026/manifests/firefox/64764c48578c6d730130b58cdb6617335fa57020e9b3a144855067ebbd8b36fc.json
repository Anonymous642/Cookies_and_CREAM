{"manifest_version": 3, "name": "Habab-Discord-Quest-Extension", "version": "3.0.0", "description": "Automatically complete Discord quests in the browser without any manual work", "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon.png"}, "permissions": ["declarativeNetRequestWithHostAccess", "scripting", "activeTab"], "host_permissions": ["https://*.discord.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "habab-discord-quest@xloqia03", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://discord.com/*", "https://canary.discord.com/*"], "js": ["quest-home.js"], "run_at": "document_idle"}, {"matches": ["https://discord.com/*", "https://canary.discord.com/*"], "js": ["user-agent-override.js"], "run_at": "document_start", "world": "MAIN"}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}}