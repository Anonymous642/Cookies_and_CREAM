{"manifest_version": 2, "name": "Tab Jumper", "version": "1.0", "description": "Press J to jump between tabs as a stair-jumping reflex game. Time windows get shorter each level.", "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "Tab Jumper"}, "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "{8710901e-f385-49e8-a372-ba07dd29c877}"}}}