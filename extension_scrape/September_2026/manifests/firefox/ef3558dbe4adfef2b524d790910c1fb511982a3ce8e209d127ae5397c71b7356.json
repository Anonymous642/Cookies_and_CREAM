{"manifest_version": 3, "name": "Sofascore World Cup Banner Remover", "version": "1.1", "description": "Automatically removes the annoying World cup banner at the top of Sofascore.com. Click the icon to toggle on/off.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["https://www.sofascore.com/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "Sofascore World Cup Banner Remover"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "sofascore-WCbanner-remover@saucy.com", "data_collection_permissions": {"required": ["none"]}}}}