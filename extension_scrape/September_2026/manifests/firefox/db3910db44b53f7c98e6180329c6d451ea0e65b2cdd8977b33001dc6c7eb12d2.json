{"manifest_version": 3, "name": "RSHotkeysEcosystem", "version": "0.1.0", "description": "Turn your browser into a hotkey-driven workstation: clipboard tools, quick-launch workspaces, tab management, and dev utilities.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "tabs"], "commands": {"format-selection": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Format selected text: JSON pretty-print, CSS minify, Base64"}, "search-stackoverflow-github": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Search selection on Stack Overflow / GitHub Code Search"}, "search-docs": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Search selection on MDN"}, "quick-launch-gmail": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open/focus Gmail"}, "quick-launch-github-prs": {"description": "Open/focus GitHub Pull Requests dashboard"}, "quick-launch-media": {"description": "Open/focus YouTube or Spotify"}, "quick-launch-workspace": {"description": "Open/focus Calendar or Notion"}, "toggle-mute-tab": {"description": "Mute/unmute the active tab"}, "close-tabs-right": {"description": "Close all tabs to the right of the active tab"}, "toggle-pin-tab": {"description": "Pin/unpin the active tab"}, "dock-reference-window": {"description": "Open doc search result docked to the right half of the screen"}, "capture-screenshot": {"description": "Capture visible tab to clipboard/downloads"}, "copy-markdown-link": {"description": "Copy current page as a Markdown link"}, "toggle-localhost-theme": {"description": "Toggle dark mode on localhost/127.0.0.1"}, "switch-environment": {"description": "Swap host between configured localhost/staging/production"}, "hard-refresh-bypass-cache": {"description": "Reload the active tab bypassing cache"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "{da89ceff-5bd4-4f3e-b64b-719d3f90782f}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}