{"manifest_version": 3, "name": "Habr Blacklist: Hide Authors", "version": "1.5.0", "description": "\u0421\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u044c\u0438 \u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u0438\u0437 \u0447\u0451\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u043d\u0430 habr.com. \u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043a\u043d\u043e\u043f\u043a\u0438 \u2716/\u21ba \u0432\u043e\u0437\u043b\u0435 \u043d\u0438\u043a\u0430, popup \u0441\u043e \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u0438 \u043f\u043e\u0438\u0441\u043a\u043e\u043c.", "browser_specific_settings": {"gecko": {"id": "habr-blacklist@example.com", "strict_min_version": "109.0"}}, "permissions": ["storage"], "host_permissions": ["https://habr.com/*", "http://habr.com/*"], "action": {"default_title": "Habr Blacklist", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://habr.com/*", "http://habr.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["config.json"], "matches": ["<all_urls>"]}]}