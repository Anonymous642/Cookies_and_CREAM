{"manifest_version": 2, "name": "My Bookmarky", "version": "0.3.10", "description": "Sync and back up bookmarks across browsers, save articles to read later, and keep everything organized in My Bookmarky.", "permissions": ["storage", "alarms", "bookmarks", "identity", "tabs", "activeTab", "menus", "https://api.mybookmarky.com/*", "wss://api.mybookmarky.com/*", "https://api.dev.mybookmarky.com/*", "wss://api.dev.mybookmarky.com/*", "https://mybookmarky.com/*", "https://dev.mybookmarky.com/*", "wss://dev.mybookmarky.com/*", "https://accounts.google.com/*"], "browser_action": {"default_title": "My Bookmarky", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "we.care@mybookmarky.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["bookmarksInfo", "authenticationInfo", "browsingActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": "script-src 'self'; object-src 'self'", "commands": {"save-current-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to MyBookmarky"}}}