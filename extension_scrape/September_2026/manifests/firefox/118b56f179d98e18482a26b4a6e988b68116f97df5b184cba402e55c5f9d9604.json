{"manifest_version": 2, "name": "DE to FR Redirect", "version": "1.0", "description": "Redirects URLs ending with /de to use /fr instead", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Add /fr to URL", "default_icon": "icon.svg"}, "commands": {"add-fr": {"suggested_key": {"default": "F3"}, "description": "Add /fr to current URL"}}, "browser_specific_settings": {"gecko": {"id": "@addon-de-to-fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webNavigation", "tabs", "activeTab"]}