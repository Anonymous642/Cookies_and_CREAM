{"manifest_version": 3, "name": "SimpleTube", "version": "1.0.1", "description": "Remove distractions from YouTube - hide homepage suggestions, sidebar recommendations, and comments", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"32": "icons/32.png", "64": "icons/64.png", "96": "icons/96.png", "128": "icons/128.png"}}, "icons": {"32": "icons/32.png", "64": "icons/64.png", "96": "icons/96.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}, "browser_specific_settings": {"gecko": {"id": "simpletube-focus@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"optional": [], "required": ["websiteContent"]}}}}