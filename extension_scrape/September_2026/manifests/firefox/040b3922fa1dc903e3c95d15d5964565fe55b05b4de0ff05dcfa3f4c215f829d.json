{"manifest_version": 3, "name": "CrestApps Soft Phone", "version": "0.1.13", "description": "Floating, always-on soft phone that survives site navigation and rings even when closed.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "softphone@crestapps.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "notifications", "alarms", "scripting"], "host_permissions": [], "optional_host_permissions": ["https://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Open Soft Phone", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["collapsed.html", "ringtone.wav", "icons/*"], "matches": ["https://*/*"]}]}