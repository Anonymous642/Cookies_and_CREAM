{"manifest_version": 3, "name": "NISDRA Secure Browser", "short_name": "NISDRA", "version": "1.1.4", "description": "Anti-empreinte et blocage des traceurs. Contribue \u00e0 l'hygi\u00e8ne informatique NIS2 (art. 21.2.g). Aucune donn\u00e9e de navigation envoy\u00e9e.", "default_locale": "fr", "homepage_url": "https://nisdra.eu/secure-browser", "author": "NISDRA", "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "alarms"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "NISDRA Secure Browser", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}, {"matches": ["https://nisdra.eu/*"], "js": ["bridge.js"], "run_at": "document_idle", "all_frames": false, "world": "ISOLATED"}, {"matches": ["<all_urls>"], "js": ["relais.js"], "run_at": "document_start", "all_frames": true, "world": "ISOLATED"}], "declarative_net_request": {"rule_resources": [{"id": "tracker_rules", "enabled": true, "path": "rules/tracker-rules.json"}, {"id": "analytics_rules", "enabled": true, "path": "rules/analytics-rules.json"}, {"id": "privacy_rules", "enabled": true, "path": "rules/privacy-rules.json"}]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "secure-browser@nisdra.eu", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}}}