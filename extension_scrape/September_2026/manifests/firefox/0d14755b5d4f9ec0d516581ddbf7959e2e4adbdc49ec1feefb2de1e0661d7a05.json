{"manifest_version": 2, "name": "Stop Doom Scroll", "version": "1.3", "description": "Prevents scrolling in YouTube Shorts.", "icons": {"48": "icons/stopscroll-48.png"}, "browser_specific_settings": {"gecko": {"id": "stop-doom-scroll@local", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_sensitive_data": false, "collects_location_data": false, "collects_web_activity_data": false}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["stopscroller.js"], "run_at": "document_start"}]}