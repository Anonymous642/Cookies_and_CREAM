{"manifest_version": 2, "name": "CF Streak", "version": "1.0.0", "description": "Track your Codeforces daily solving streak like Duolingo. Stay consistent, build habits, dominate the leaderboard.", "author": "CF Streak", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "CF Streak"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://codeforces.com/*"], "js": ["content.js"], "css": ["content.css"]}], "permissions": ["storage", "alarms", "notifications", "*://codeforces.com/api/*", "*://codeforces.com/*"], "browser_specific_settings": {"gecko": {"id": "cfstreak@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}