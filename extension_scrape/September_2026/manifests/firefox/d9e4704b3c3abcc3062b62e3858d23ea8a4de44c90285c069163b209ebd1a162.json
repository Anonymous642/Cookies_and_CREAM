{"manifest_version": 3, "name": "What's Behind the Walls", "version": "1.0.0", "description": "Estimates the likely plumbing, sewer, water heater and HVAC condition of any US home listing from its year built and region. Runs entirely on your own machine.", "browser_specific_settings": {"gecko": {"id": "walls@coralplumbingandair.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["src/background/index.js"]}, "permissions": ["storage", "scripting"], "optional_host_permissions": ["*://*.zillow.com/*", "*://*.redfin.com/*", "*://*.realtor.com/*", "*://*.trulia.com/*", "*://*.homes.com/*"], "action": {"default_popup": "src/popup/index.html", "default_title": "What's Behind the Walls", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}}