{"manifest_version": 3, "name": "Selltop Marketplace Companion", "version": "0.1.2", "description": "Mostra a leitura inline da Selltop ao navegar em an\u00fancios do Mercado Livre.", "permissions": ["storage", "cookies"], "host_permissions": ["https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*", "https://selltop.com.br/*"], "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Selltop", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "extensao-sellora@selltop.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*"]}]}