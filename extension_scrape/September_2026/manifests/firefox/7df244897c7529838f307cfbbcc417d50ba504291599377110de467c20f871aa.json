{"action": {"default_popup": "popup.html", "default_icon": "images/icon.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "@thief-of-motivation-liberty-foxy-translate", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "description": "Translate pages and text with your own local LibreTranslate or LM Studio server. Connection presets, batch page translation with progress and ETA, page revert, persistent logs, custom UI languages.", "manifest_version": 3, "name": "Liberty Foxy Translate", "permissions": ["tabs", "storage"], "version": "0.1.0", "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["wasm/*", "content/*"]}], "icons": {"64": "images/icon.png"}, "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content_script.js", "content/loader.js"], "run_at": "document_idle", "all_frames": true}]}