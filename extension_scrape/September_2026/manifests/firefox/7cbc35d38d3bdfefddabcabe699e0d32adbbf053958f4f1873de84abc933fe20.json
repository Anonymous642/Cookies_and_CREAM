{"manifest_version": 3, "name": "Codeforces AI Assistant", "version": "1.0", "description": "AI problem explainer and coding companion for Codeforces.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://codeforces.com/*", "https://generativelanguage.googleapis.com/*"], "content_scripts": [{"matches": ["https://codeforces.com/problemset/problem/*", "https://codeforces.com/contest/*/problem/*"], "js": ["content.js"]}], "action": {"default_title": "Toggle Sidebar"}, "sidebar_action": {"default_title": "CF AI Assistant", "default_panel": "sidebar.html"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cf-ai-assistant@codeforces.com", "data_collection_permissions": {"required": ["none"]}}}}