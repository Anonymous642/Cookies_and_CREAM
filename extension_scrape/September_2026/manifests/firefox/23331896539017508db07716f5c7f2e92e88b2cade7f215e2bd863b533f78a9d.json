{"manifest_version": 3, "name": "Runway Quick Add", "description": "Add issues, rocks, to-dos and more to Runway from any page.", "version": "0.1.0", "browser_specific_settings": {"gecko": {"id": "quick-add@runwayos.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab"], "host_permissions": ["https://app.runwayos.io/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Runway Quick Add", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "sidebar_action": {"default_title": "Runway Quick Add", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "open_at_install": true}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/page-context.js"], "run_at": "document_idle"}]}