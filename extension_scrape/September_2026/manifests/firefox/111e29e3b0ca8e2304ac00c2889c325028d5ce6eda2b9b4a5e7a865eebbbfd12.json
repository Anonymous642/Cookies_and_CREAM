{"manifest_version": 3, "name": "SecureVault Autofill", "short_name": "SecureVault", "version": "1.0.0", "description": "Isi otomatis username & password dari aplikasi desktop SecureVault (offline).", "browser_specific_settings": {"gecko": {"id": "securevault-autofill-a0d88d01@securevault.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "SecureVault", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"scripts": ["lib/url.js", "background.js"]}, "permissions": ["storage", "activeTab"], "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/url.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"fill-login": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Isi login pertama yang cocok di halaman ini"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}