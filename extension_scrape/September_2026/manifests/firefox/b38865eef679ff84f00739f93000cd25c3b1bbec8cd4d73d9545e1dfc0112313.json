{"manifest_version": 3, "name": "Aliasto", "description": "Create personal short links to your favorite websites, stored locally in your browser.", "version": "0.3.2", "icons": {"128": "icon/128.png"}, "omnibox": {"keyword": "@"}, "permissions": ["declarativeNetRequestWithHostAccess", "activeTab"], "host_permissions": ["*://*.google.com/*", "*://*.bing.com/*", "*://duckduckgo.com/*"], "web_accessible_resources": [{"resources": ["/app.html"], "matches": ["*://*.google.com/*", "*://*.bing.com/*", "*://duckduckgo.com/*"]}], "browser_specific_settings": {"gecko": {"id": "production@aliasto.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}}