{"manifest_version": 3, "name": "Decloak Session Capture", "version": "0.1.0", "description": "Capture your logged-in session (cookies + storage) so Decloak can run an authenticated scan, including passkey/WebAuthn logins.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Capture session for Decloak", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["cookies", "activeTab", "scripting"], "optional_host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "session-capture@decloak.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}}}