{"manifest_version": 3, "name": "SecondChat", "version": "1.0.0", "description": "The real-time conversation layer for the web. Chat with anyone on the same page.", "homepage_url": "https://secondchat.app", "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["*://*.secondchat.app/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "SecondChat"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_title": "SecondChat", "default_panel": "panel.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "secondchat@secondchat.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personalCommunications"], "optional": ["technicalAndInteraction", "personallyIdentifyingInfo"]}}}}