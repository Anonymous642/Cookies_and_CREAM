{"manifest_version": 3, "name": "OpenPitch", "version": "1.0", "description": "Change the pitch of YouTube videos. Free, open source, no limits.", "icons": {"48": "assets/openpitch_extension_48.png", "128": "assets/openpitch_extension_128.png"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "OpenPitch", "default_icon": {"48": "assets/openpitch_extension_48.png", "128": "assets/openpitch_extension_128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["soundtouch-web-audio.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "openpitch@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}