{"manifest_version": 3, "name": "Prettify Plus", "version": "1.0.0", "description": "Auto-detect and beautifully format JSON, YAML, XML, TOML & CSV in your browser.", "permissions": ["storage", "clipboardWrite", "activeTab"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "web_accessible_resources": [{"resources": ["src/viewer/index.html", "assets/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "prettify-plus@prettify-plus", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}