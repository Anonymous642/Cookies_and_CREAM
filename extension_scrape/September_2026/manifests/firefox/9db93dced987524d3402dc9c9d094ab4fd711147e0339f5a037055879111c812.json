{"manifest_version": 3, "name": "One-Click Gmail PDF Signer", "version": "1.4", "description": "Sign PDF attachments in Gmail \u2014 no downloads, no third-party uploads. Draw or upload your signature, place it, and send in seconds.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "one-click-pdf-signer@easymuse", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"]}], "host_permissions": ["https://mail.google.com/*"], "web_accessible_resources": [{"resources": ["viewer.html", "dist/*", "icons/*"], "matches": ["https://mail.google.com/*"]}]}