{"manifest_version": 3, "name": "Accessibility Vision Simulator", "version": "1.0", "description": "Simulate color blindness and visual impairments on any webpage to help developers test accessibility.", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "abcdtest@test.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "commands": {"cycle-filter": {"suggested_key": {"default": "Alt+A"}, "description": "Cycle through vision filters"}, "reset-filter": {"suggested_key": {"default": "Alt+B"}, "description": "Reset to normal vision"}, "auto-preview": {"suggested_key": {"default": "Alt+C"}, "description": "Start/stop auto preview cycling"}}, "action": {"default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"128": "icons/icon128.png"}}