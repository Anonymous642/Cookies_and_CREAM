{"manifest_version": 2, "name": "NewTabCrafter", "version": "1.0.1", "description": "Lightweight, customizable new tab page and homepage replacement for Firefox", "permissions": ["tabs", "https://api.unsplash.com/*", "https://images.unsplash.com/*", "https://suggestqueries.google.com/*", "https://duckduckgo.com/*", "https://api.bing.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"homepage": "newtab.html"}, "web_accessible_resources": ["*.css", "*.js", "*.html", "*.woff2", "*.png", "*.svg"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "newtabcrafter@rivodani.com", "data_collection_permissions": {"required": ["searchTerms"]}}}}