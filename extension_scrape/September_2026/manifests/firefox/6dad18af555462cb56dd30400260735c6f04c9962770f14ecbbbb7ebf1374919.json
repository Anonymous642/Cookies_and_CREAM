{"manifest_version": 3, "name": "JobFlow - Job Application Tracker", "description": "Automatically track your LinkedIn job applications locally and receive follow-up alerts.", "version": "1.0.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"], "host_permissions": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/jobs/view/*", "https://*.indeed.com/*"], "action": {"default_title": "JobFlow Dashboard", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "jobflow-tracker@ravi.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.indeed.com/*", "https://indeed.com/*", "https://www.linkedin.com/jobs/*", "https://www.linkedin.com/jobs/view/*"], "run_at": "document_end", "js": ["content-scripts/content.js"]}]}