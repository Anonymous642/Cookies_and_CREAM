{"manifest_version": 3, "name": "AuraLock \u2014 Website Blocker & Focus", "version": "2.0.0", "description": "Block distracting websites, stay focused, and browse with intention. Choose what to block and protect your attention with AuraLock.", "browser_specific_settings": {"gecko": {"id": "auralock@extension", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/service-worker.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["pages/blocked.html", "styles/*", "lib/*"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content-script.js"], "run_at": "document_start"}], "declarative_net_request": {"rule_resources": [{"id": "aurablock_rules", "enabled": true, "path": "rules.json"}]}, "default_locale": "en"}