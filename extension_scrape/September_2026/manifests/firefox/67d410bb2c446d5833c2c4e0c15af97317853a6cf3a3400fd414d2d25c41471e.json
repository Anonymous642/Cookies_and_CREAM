{"manifest_version": 3, "name": "sees.ovh Shortlink Creator", "version": "1.0", "description": "Quickly create and manage shortlinks using the sees.ovh API.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://sees.ovh/"], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "shortener@sees.ovh", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}