{"manifest_version": 2, "name": "YTMusic Scrobbler \u2192 Last.FM", "version": "2.1.1", "description": "Erkennt Songs auf YouTube Music, matcht sie via Spotify und scrobbelt zu Last.FM. v2.1.0 \u2013 Spotify-Suche jetzt im Content-Script.", "browser_specific_settings": {"gecko": {"id": "ytmusic-scrobbler@addon", "strict_min_version": "109.0"}}, "permissions": ["storage", "https://music.youtube.com/*", "https://api.spotify.com/*", "https://accounts.spotify.com/*", "https://api.deezer.com/*", "https://ws.audioscrobbler.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}