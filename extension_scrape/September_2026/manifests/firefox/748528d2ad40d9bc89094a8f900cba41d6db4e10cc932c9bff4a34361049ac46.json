{"manifest_version": 3, "name": "Billun - Protection Anti-Phishing", "version": "1.0.0", "description": "Protection anti-phishing en temps r\u00e9el. V\u00e9rifiez la l\u00e9gitimit\u00e9 des sites web instantan\u00e9ment.", "author": "Billun", "homepage_url": "https://billun.com", "browser_specific_settings": {"gecko": {"id": "billun@billun.com", "strict_min_version": "109.0"}, "gecko_android": {"strict_min_version": "113.0"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Billun - Protection Anti-Phishing"}, "permissions": ["activeTab", "storage", "webNavigation"], "host_permissions": ["https://billun.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}]}