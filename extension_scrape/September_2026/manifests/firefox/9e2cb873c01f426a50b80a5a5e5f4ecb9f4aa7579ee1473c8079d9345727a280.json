{"manifest_version": 2, "name": "Tagada Extension", "version": "1.7", "description": "Tagada, l'extension qui personnalise votre Odoo.", "browser_specific_settings": {"gecko": {"id": "tagada-extension@tagada.fr", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_action": {"default_icon": "icons/icon.svg", "default_title": "Tagada", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://store.danfoss.com/*"], "js": ["tagada-net.js", "tagada-format.js", "tagada-prices.js", "tagada-bg.js", "tagada-odoo.js", "tagada-ui.js", "tagada-common.js", "scraper.js"]}], "background": {"scripts": ["tagada-metrics.js", "tagada-net.js", "tagada-format.js", "tagada-prices.js", "tagada-bg.js", "tagada-odoo.js", "tagada-ui.js", "tagada-common.js", "crypto-utils.js", "background.js"]}, "commands": {"tagada-update-danfoss-prices": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Mettre \u00e0 jour les prix des produits Danfoss sur la page Odoo courante"}}, "permissions": ["activeTab", "storage"], "optional_permissions": ["<all_urls>"]}