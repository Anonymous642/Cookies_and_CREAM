{"manifest_version": 2, "name": "EPUB Publisher", "version": "1.3", "description": "Convert any web page (or multi-chapter series) to a clean EPUB file for reading on eink readers.", "homepage_url": "https://github.com/your-username/epub-ff", "browser_specific_settings": {"gecko": {"id": "epub-publisher@local", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon-48.png", "default_title": "Convert to EPUB"}, "permissions": ["activeTab", "storage", "<all_urls>"], "optional_permissions": ["downloads"]}