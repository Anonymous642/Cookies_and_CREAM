{"manifest_version": 3, "name": "SecureWatch - Website Security Scanner", "version": "1.2.2", "description": "Scan websites for vulnerabilities, security headers, SSL issues, and more. 75+ security tests in one click.", "browser_specific_settings": {"gecko": {"id": "securewatch@securewatchonline.com", "strict_min_version": "109.0"}}, "permissions": ["activeTab", "storage", "notifications", "scripting", "alarms", "tabs"], "host_permissions": ["https://securewatch-backend-gbd3.onrender.com/*", "https://securewatchonline.com/*", "https://accounts.google.com/*", "https://*.google.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup.html", "default_title": "SecureWatch Security Scanner v1.2.2", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open SecureWatch Scanner"}, "quick-scan": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Quick Scan Current Website"}}, "web_accessible_resources": [{"resources": ["popup.html", "icon128.png"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"}}