{"manifest_version": 2, "name": "GrokBlock", "version": "1.0.0", "description": "Automatically hides and blocks users who mention @grok on Twitter/X.", "permissions": ["storage", "*://*.twitter.com/*", "*://*.x.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "grokblock@grokblock", "data_collection_permissions": {"required": ["none"]}}}}