{"manifest_version": 3, "name": "HiFi Streamer", "version": "1.164", "description": "A local & network audio player for Firefox.", "browser_specific_settings": {"gecko": {"id": "hifi-streamer@jamsonsteam.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://ws.audioscrobbler.com/*", "http://*/*", "https://*/*"], "optional_permissions": ["http://*/*", "https://*/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "commands": {"toggle-play": {"description": "Play / Pause Media"}, "next-track": {"description": "Next Track"}, "prev-track": {"description": "Previous Track"}, "stop": {"description": "Stop Playback & Clear Queue"}, "vol-up": {"description": "Volume Up"}, "vol-down": {"description": "Volume Down"}, "toggle-mute": {"description": "Toggle Mute"}, "seek-fwd": {"description": "Seek Forward (5s)"}, "seek-back": {"description": "Seek Backward (5s)"}, "cycle-mode": {"description": "Cycle Playback Mode"}, "cycle-eq": {"description": "Toggle Graphic Equalizer"}, "power-toggle": {"description": "Toggle System Power"}, "power-on": {"description": "Power On System"}, "power-off": {"description": "Power Off System"}}, "action": {"default_popup": "popup.html", "default_title": "HiFiStreamer", "default_icon": {"16": "icons/dark_16.png", "32": "icons/dark_32.png", "64": "icons/dark_64.png"}}, "background": {"page": "background.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["drop_overlay.js"], "run_at": "document_idle", "all_frames": false}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}}