{"manifest_version": 3, "name": "Aether Translate", "version": "1.0.0", "description": "A premium, Firefox-only translation extension utilizing a native sidebar and MyMemory API.", "icons": {"16": "dist/assets/icon.svg", "48": "dist/assets/icon.svg", "128": "dist/assets/icon.svg"}, "permissions": ["activeTab", "contextMenus", "storage"], "background": {"scripts": ["dist/background/background.js"], "type": "module"}, "sidebar_action": {"default_title": "Aether Translate", "default_panel": "dist/ui/sidebar.html", "default_icon": "dist/assets/icon.svg", "open_at_install": false}, "options_ui": {"page": "dist/ui/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content/selection.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["dist/content/bubble.css"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "aethertranslate@antigravity.local", "data_collection_permissions": {"required": ["none"]}}}}