{"manifest_version": 3, "name": "PaletteSpy", "version": "0.2.5.1", "description": "Detect themes, pick colors, and find gradients on any website.", "browser_specific_settings": {"gecko": {"id": "palettespy@palettespy-extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Open PaletteSpy"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["sidebar.css"], "matches": ["<all_urls>"]}]}