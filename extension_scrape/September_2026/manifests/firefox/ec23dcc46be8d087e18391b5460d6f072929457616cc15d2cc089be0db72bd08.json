{"manifest_version": 2, "name": "Emotion-Based Content Filter", "version": "1.3", "description": "Detect emotional tone of content and filter negative or stressful text.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js", "analyzer.js"], "run_at": "document_end"}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Emotion-Based-Content-Filter", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}