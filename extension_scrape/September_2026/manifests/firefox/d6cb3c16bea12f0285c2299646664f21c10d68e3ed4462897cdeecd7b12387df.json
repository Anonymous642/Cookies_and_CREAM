{"manifest_version": 3, "name": "Collapsed Test Files for GitHub", "version": "1.0.23", "description": "Automatically marks conventionally named test files as viewed when reviewing GitHub pull requests.", "host_permissions": ["https://github.com/*"], "browser_specific_settings": {"gecko": {"id": "collapsed-test-files-for-github@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}