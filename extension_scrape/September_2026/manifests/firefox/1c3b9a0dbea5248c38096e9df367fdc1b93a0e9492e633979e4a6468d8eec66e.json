{"manifest_version": 3, "name": "Touch Grass", "version": "3.4.2026", "description": "A lightweight Firefox extension that reminds you to take a break and touch grass.", "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}, "permissions": ["idle", "storage", "alarms", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Touch Grass", "default_popup": "popup/popup.html"}, "web_accessible_resources": [{"resources": ["assets/kit-placeholder.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "touch-grass@mozilla.com", "data_collection_permissions": {"required": ["none"]}}}}