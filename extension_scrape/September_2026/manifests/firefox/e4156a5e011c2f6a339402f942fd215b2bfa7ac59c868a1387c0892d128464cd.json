{"manifest_version": 2, "short_name": "Streameta", "name": "Streameta", "version": "1.3.13", "description": "Automatically split highlights on Twitch from timestamps generated by Streameta. Publish those highlights automatically on YouTube.", "homepage_url": "https://streameta.com", "icons": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png", "64": "icons/favicon-64.png", "128": "icons/favicon-128.png"}, "permissions": ["https://*.twitch.tv/", "https://*.youtube.com/", "https://*.streameta.com/", "clipboardWrite", "clipboardRead"], "content_scripts": [{"matches": ["https://*.twitch.tv/embed/*/chat*"], "all_frames": true, "js": ["content_scripts/twitch-prediction.js"]}, {"matches": ["https://*.streameta.com/controller/"], "js": ["content_scripts/streameta-controller.js"]}], "browser_action": {"default_icon": {"16": "icons/favicon-16.png", "32": "icons/favicon-32.png", "48": "icons/favicon-48.png", "64": "icons/favicon-64.png"}, "default_title": "Streameta", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "{3f82a6a2-8db9-4b74-9b5c-8f3e238dc870}"}}}