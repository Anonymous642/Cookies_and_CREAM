{"manifest_version": 2, "name": "Audio Equalizer (local-only)", "version": "1.0.0", "description": "A lightweight audio equalizer for audio/video elements on the page. Local-only, uses Web Audio API. No external servers, no icons.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Audio Equalizer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "audio-eq-local@example.com", "strict_min_version": "60.0"}}}