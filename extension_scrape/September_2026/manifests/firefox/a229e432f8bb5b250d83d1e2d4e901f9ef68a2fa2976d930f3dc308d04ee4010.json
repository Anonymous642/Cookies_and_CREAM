{"manifest_version": 2, "name": "PageCrawl - Website Change Monitor", "version": "1.6.0", "description": "Monitor any website for changes. Track prices, content updates, and visual changes directly from your browser.", "author": "PageCrawl.io", "homepage_url": "https://pagecrawl.io", "permissions": ["activeTab", "alarms", "contextMenus", "storage", "*://*.pagecrawl.io/*"], "background": {"scripts": ["lib/browser-polyfill.js", "src/background/background-firefox.js"], "persistent": false}, "browser_action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "web_accessible_resources": ["src/content/overlay.css", "src/content/content.js", "icons/*"], "browser_specific_settings": {"gecko": {"id": "extension@pagecrawl.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}}}, "content_scripts": [{"matches": ["https://pagecrawl.io/app/extension/auth/*"], "js": ["src/content/auth-bridge.js"], "run_at": "document_start"}]}