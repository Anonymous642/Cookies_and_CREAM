{"manifest_version": 2, "name": "satisfactory-calculator-recipes", "description": "An extention for Satisfactory Calculator that checks recipes you unlocked so you don't have to.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "satisfactory-calculator@wxt"}}, "permissions": ["storage", "activeTab", "scripting", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Satisfactory Calculator Recipes", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://satisfactory-calculator.com/en/interactive-map", "https://www.satisfactorytools.com/0.8/production", "https://www.satisfactorytools.com/1.0/production"], "js": ["content-scripts/content.js"]}]}