{"manifest_version": 2, "name": "Finditlater", "short_name": "Finditlater", "version": "0.1.1", "author": "Finditlater", "homepage_url": "https://finditlater.com", "description": "AI-powered bookmark manager. Save and organize bookmarks with one click, powered by semantic search and AI categorization.", "permissions": ["activeTab", "storage", "http://localhost/*", "http://127.0.0.1/*", "https://finditlater.com/*", "https://*.finditlater.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Save to Finditlater", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "options_ui": {"page": "options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "extension@finditlater.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}}