{"manifest_version": 2, "name": "Quick Meeting Link", "version": "1.2", "description": "Generate a new Google Meet or Zoom meeting link with one click and copy it to your clipboard.", "permissions": ["clipboardWrite", "tabs", "activeTab", "storage"], "browser_action": {"default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "default_popup": "popup/popup.html", "default_title": "Quick Meeting Link"}, "background": {"scripts": ["background/background.js"]}, "content_security_policy": "script-src 'self'; object-src 'self';", "content_scripts": [{"matches": ["https://meet.google.com/*", "https://*.zoom.us/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "quick-meeting-link@browser-extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}