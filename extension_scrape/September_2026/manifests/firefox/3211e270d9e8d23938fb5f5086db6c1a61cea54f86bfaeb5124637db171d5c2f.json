{"manifest_version": 2, "name": "YouTube Shorts Blocker", "version": "1.0.0", "description": "Remove YouTube Shorts from your feed with a toggle option", "browser_specific_settings": {"gecko": {"id": "youtube-shorts-blocker@example.com"}}, "permissions": ["activeTab", "storage", "tabs", "*://www.youtube.com/*", "*://youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Shorts Blocker", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "web_accessible_resources": ["icons/*", "debug.html"]}