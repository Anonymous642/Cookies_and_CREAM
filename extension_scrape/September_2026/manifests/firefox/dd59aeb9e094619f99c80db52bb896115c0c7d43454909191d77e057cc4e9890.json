{"manifest_version": 3, "name": "QuickRun", "version": "0.9.21", "description": "Run any git repository with one click, from the GitHub, GitLab, Bitbucket or Azure DevOps page you found it on.", "homepage_url": "https://quickrun.org", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "QuickRun", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://github.com/*", "https://gitlab.com/*", "https://bitbucket.org/*", "https://dev.azure.com/*", "https://*.visualstudio.com/*"], "js": ["targets.js", "placement.js", "content.js"], "css": ["quickrun.css"], "run_at": "document_idle"}], "permissions": ["storage", "scripting"], "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"], "browser_specific_settings": {"gecko": {"id": "quickrun@fgilde.org", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "optional_permissions": ["https://*/*", "http://*/*"]}