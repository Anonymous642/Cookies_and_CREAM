{"manifest_version": 3, "name": "IKEA Model URL Fetcher", "version": "1.0.0", "description": "Resolves the model URL from an IKEA item page.", "action": {"default_popup": "popup.html", "default_title": "Model URL Fetcher", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["declarativeNetRequest", "tabs", "storage"], "host_permissions": ["https://www.ikea.com/*", "https://web-api.ikea.com/*"], "declarative_net_request": {"rule_resources": [{"id": "cors_rules", "enabled": true, "path": "cors_rules.json"}]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ikea-model-url-fetcher@extension", "data_collection_permissions": {"required": ["none"], "optional": []}}}}