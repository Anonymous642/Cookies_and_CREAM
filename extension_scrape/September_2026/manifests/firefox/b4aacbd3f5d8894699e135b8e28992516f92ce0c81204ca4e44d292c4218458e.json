{"manifest_version": 2, "name": "YtTimeLock", "version": "1.0.1", "description": "Blocks all of youtube during the set time span.", "icons": {"48": "icons/youtube_locked_icon_48.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "boeeckeler@gmail.com", "strict_min_version": "58.0"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtu.be/*"], "js": ["checktime.js"]}], "browser_action": {"default_popup": "popup.html"}}