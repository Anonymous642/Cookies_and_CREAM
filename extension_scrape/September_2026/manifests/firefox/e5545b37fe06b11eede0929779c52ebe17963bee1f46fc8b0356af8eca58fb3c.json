{"manifest_version": 2, "name": "Just 5 Minutes", "version": "1.0.0", "description": "Gives you a short allowance on distracting feeds, then locks scrolling for the rest of the session.", "permissions": ["storage", "tabs", "notifications", "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "browser_action": {"default_title": "Just 5 Minutes", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon.svg"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "just-5-minutes@local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.reddit.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.youtube.com/*"], "js": ["content/block-wheel.js"], "run_at": "document_start"}]}