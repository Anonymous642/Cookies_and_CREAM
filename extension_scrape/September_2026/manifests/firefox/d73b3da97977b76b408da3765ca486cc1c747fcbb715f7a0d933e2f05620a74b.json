{"manifest_version": 2, "name": "YT Sorter", "version": "1.0.0", "description": "Sort your Watch Later playlist into custom playlists.", "icons": {"48": "icons/Module-Puzzle-2--Streamline-Ultimate.svg", "96": "icons/Module-Puzzle-2--Streamline-Ultimate.svg"}, "browser_action": {"default_icon": "icons/Module-Puzzle-2--Streamline-Ultimate.svg", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/playlist?list=WL*"], "js": ["scraper.js", "api.js", "cards.js", "ui.js", "content.js"], "css": ["styles/base.css", "styles/card-area.css", "styles/card-ui.css", "styles/status.css", "styles/actions.css", "styles/toast.css"], "run_at": "document_idle"}], "permissions": ["storage", "https://www.youtube.com/*"], "web_accessible_resources": ["overlay.html"], "browser_specific_settings": {"gecko": {"id": "yt-sorter@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}