{"manifest_version": 3, "name": "Multi-Task Conflict Detector", "version": "1.3", "description": "Detects multitasking conflicts, excessive tab switching, and competing workflows to improve browsing focus.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["conflictEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "action": {"default_popup": "popup.html", "default_title": "Multi-Task Conflict Detector"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Multi-Task-Conflict-Detector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}