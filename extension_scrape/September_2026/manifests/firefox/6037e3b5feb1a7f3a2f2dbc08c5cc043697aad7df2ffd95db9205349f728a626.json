{"manifest_version": 3, "name": "TinyChord Importer", "version": "0.1.0", "description": "Importe une chanson (accords + paroles) depuis CifraClub, Ultimate Guitar ou La Bo\u00eete \u00e0 Chansons vers le format TinyChord (.txt).", "action": {"default_title": "Importer dans TinyChord", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.cifraclub.com.br/*", "*://*.cifraclub.com/*", "*://*.ultimate-guitar.com/*", "*://*.boiteachansons.net/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{43a4b546-2d7d-4e0f-9f8d-8e5287323c8b}", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}