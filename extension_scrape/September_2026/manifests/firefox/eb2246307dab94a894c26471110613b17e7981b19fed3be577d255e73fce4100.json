{"manifest_version": 2, "name": "Rabbit Hole Breaker", "version": "2.0", "description": "Adds a mindful pause before each video or post \u2014 10 seconds for your first click, 20 seconds for every click after.", "permissions": ["activeTab", "storage", "tabs", "https://www.youtube.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://en.wikipedia.org/*", "https://twitter.com/*", "https://x.com/*", "https://www.tiktok.com/*", "https://news.ycombinator.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://en.wikipedia.org/*", "https://twitter.com/*", "https://x.com/*", "https://www.tiktok.com/*", "https://news.ycombinator.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "rabbithole@salter.studio", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}