{"manifest_version": 3, "name": "Domain Rating Checker: free site ratings", "version": "1.0.0", "description": "See any website's rating out of 100 in your toolbar. Free site authority and ranking checks, and we never log a domain.", "permissions": ["tabs", "storage"], "host_permissions": ["https://checkdomainrating.com/*"], "optional_host_permissions": ["http://localhost:3007/*"], "background": {"type": "module", "scripts": ["service_worker.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "CheckDomainRating.com", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@checkdomainrating.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}