{"manifest_version": 2, "name": "browsy", "version": "1.6", "description": "Browsy is a browser extension that generates summary of every tab. \n Currently: It supports Gmail, ... (Do suggest any tab that you would like)", "permissions": ["storage", "identity", "alarms", "https://api.anthropic.com/*", "https://api.telegram.org/*", "https://www.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "browsy@darzizalol.github.io", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["config.js", "email-categories.js", "durations.js", "languages.js", "telegram.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["durations.js", "languages.js", "content/pet.js", "content/gmail/gmail.js"], "css": ["content/pet.css", "content/gmail/gmail.css"]}], "browser_action": {"default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html"}, "web_accessible_resources": ["assets/sprites/*"]}