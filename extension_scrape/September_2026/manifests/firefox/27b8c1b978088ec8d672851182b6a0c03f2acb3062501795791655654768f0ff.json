{"manifest_version": 2, "name": "JunkBlock", "version": "1.0.2", "description": "Block distracting websites and content to stay focused", "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["src/utils/logger.js", "src/utils/analytics.js", "src/background/background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*.youtube.com/*", "https://*.youtube.com/*", "http://*.reddit.com/*", "https://*.reddit.com/*", "http://*.twitter.com/*", "https://*.twitter.com/*", "http://*.x.com/*", "https://*.x.com/*", "http://*.instagram.com/*", "https://*.instagram.com/*"], "js": ["src/utils/filters.data.js", "src/utils/filters.js", "src/content/common.js", "src/content/content-filter.js"], "run_at": "document_start"}], "web_accessible_resources": ["src/blocked/blocked.html", "src/blocked/blocked.js", "src/utils/filters.module.js", "src/utils/filters.data.js", "src/utils/filters.json"], "browser_action": {"default_popup": "src/popup/popup.html", "default_icon": "assets/icons/icon48.png"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "junkblock@example.com", "strict_min_version": "79.0"}}}