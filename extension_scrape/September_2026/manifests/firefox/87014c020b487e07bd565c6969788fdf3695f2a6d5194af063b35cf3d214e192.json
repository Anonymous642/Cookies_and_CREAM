{"manifest_version": 2, "name": "Bookee - Smart Bookmark Search", "description": "Replace your new tab with a powerful fuzzy search for bookmarks", "version": "1.0.0", "icons": {"48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png", "192": "icon-192.png", "256": "icon-256.png", "512": "icon-512.png"}, "permissions": ["bookmarks", "tabs"], "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "bookee@am2rican5.github.io", "strict_min_version": "58.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}