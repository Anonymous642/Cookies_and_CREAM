{"manifest_version": 3, "name": "Kirby Hordes.io Chat Translator", "version": "0.6", "description": "Automatically translates messages in in-game chat. Supports Spanish, French, German, Italian, Portuguese, Russian, Chinese, Japanese, Korean, Arabic, Polish, Turkish.", "permissions": ["webRequest", "webRequestBlocking", "storage"], "host_permissions": ["https://hordes.io/*", "https://libretranslate.de/*", "https://libretranslate.com/*", "https://api.mymemory.translated.net/*"], "content_scripts": [{"matches": ["https://hordes.io/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Chat Translator"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "kirbyhordeschattranslator@example.com"}}}