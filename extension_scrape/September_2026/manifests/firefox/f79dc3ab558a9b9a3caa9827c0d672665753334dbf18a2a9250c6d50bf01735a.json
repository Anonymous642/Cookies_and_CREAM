{"manifest_version": 2, "name": "Instate Link Shortener", "version": "1.1.0", "description": "Quickly shorten URLs using your Instate account with Personal Access Token authentication", "homepage_url": "https://instate.app", "browser_specific_settings": {"gecko": {"id": "link-shortener@instate.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "icons": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "permissions": ["activeTab", "clipboardWrite", "storage", "notifications", "contextMenus", "https://instate.app/*", "https://*.instate.app/*"], "browser_action": {"default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg"}, "default_title": "Shorten URL", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "browser_style": true}, "background": {"scripts": ["lib/api.js", "background/background.js"], "persistent": false}, "content_security_policy": "script-src 'self'; object-src 'self'"}