{"manifest_version": 3, "name": "Strategy Lab Connector", "version": "0.2.95", "description": "Connects Strategy Lab with ITradingBot in your browser.", "homepage_url": "https://strglb.com/", "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_title": "Strategy Lab Connector", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "permissions": ["tabs", "scripting"], "host_permissions": ["https://app.itradingbot.net/*", "https://itradingbot.net/*", "https://backtest.itradingbot.net/*", "https://strglb.com/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://strglb.com/*", "http://127.0.0.1/*", "http://localhost/*"], "js": ["content/strategy-lab.js"], "run_at": "document_idle"}, {"matches": ["https://app.itradingbot.net/*"], "js": ["content/itradingbot-session.js"], "run_at": "document_idle"}, {"matches": ["https://app.itradingbot.net/*"], "js": ["content/itradingbot-robot.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "strategy-lab-connector@strglb.com", "data_collection_permissions": {"required": ["websiteContent"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}