{"manifest_version": 3, "name": "Acuvity", "browser_specific_settings": {"gecko": {"id": "addon@acuvity.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}, "version": "2.1.9", "description": "Acuvity discovers AI services for your organization", "icons": {"128": "icons/icon-128.png"}, "permissions": ["alarms", "storage", "tabs", "proxy", "declarativeNetRequest", "webRequest", "webRequestAuthProvider"], "web_accessible_resources": [{"resources": ["authentication-required.html"], "matches": ["<all_urls>"]}], "host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Settings", "default_popup": "options.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://localhost/getusertoken*", "https://127.0.0.1/getusertoken*", "https://console.acuvity.dev/getusertoken*", "https://console.acuvity.us/getusertoken*", "https://console.acuvity.ai/getusertoken*"], "js": ["./libs/browser-polyfill.min.js", "./libs/toastify-js.js", "content.js"]}]}