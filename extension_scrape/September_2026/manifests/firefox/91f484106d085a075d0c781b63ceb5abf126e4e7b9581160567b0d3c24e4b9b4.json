{"manifest_version": 2, "name": "Browser Vault GUI - Extension", "version": "1.0.0", "description": "Alternative frontend for HashiCorp Vault - Browser Extension", "permissions": ["activeTab", "storage", "https://*/*", "http://*/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Browser Vault GUI", "default_icon": {"16": "vault-icon.svg", "32": "vault-icon.svg", "48": "vault-icon.svg", "128": "vault-icon.svg"}}, "icons": {"16": "vault-icon.svg", "32": "vault-icon.svg", "48": "vault-icon.svg", "128": "vault-icon.svg"}, "content_security_policy": "script-src 'self'; object-src 'self'", "web_accessible_resources": ["*.js", "*.css", "*.svg", "*.png", "*.jpg"], "browser_specific_settings": {"gecko": {"id": "@browser-vault-gui-extension", "data_collection_permissions": {"required": ["none"]}}}}