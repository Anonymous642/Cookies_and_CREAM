{"manifest_version": 3, "name": "Modern Web Checker", "short_name": "Modern Web", "version": "0.3.0", "description": "Shows IPv6, TLS 1.3, and HTTP/3 legacy status for the current website.", "browser_specific_settings": {"gecko": {"id": "legext@legext.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webRequest", "webRequestBlocking", "tabs", "storage", "scripting", "proxy"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_area": "navbar", "default_title": "Modern Web Checker \u2013 legacy protocol status", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": false}}