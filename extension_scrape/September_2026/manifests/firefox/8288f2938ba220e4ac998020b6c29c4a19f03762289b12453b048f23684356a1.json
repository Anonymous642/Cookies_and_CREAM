{"manifest_version": 3, "name": "FOK!Rust", "version": "1.2.0", "description": "Brengt rust op FOK! door reacties van opgegeven gebruikers volledig onzichtbaar te maken.", "permissions": ["storage"], "host_permissions": ["https://forum.fok.nl/*", "http://forum.fok.nl/*"], "content_scripts": [{"matches": ["https://forum.fok.nl/*", "http://forum.fok.nl/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle"}], "action": {"default_title": "FOK!Rust", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "fok-rust@local.codex", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}, "gecko_android": {"strict_min_version": "142.0"}}}