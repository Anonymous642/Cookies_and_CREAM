{"manifest_version": 3, "name": "Priority Flow Engine", "version": "1.3", "description": "Analyzes workflow priorities and recommends focus actions using local intelligence.", "permissions": ["tabs", "storage", "notifications", "activeTab", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["utils.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Priority Flow Engine"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Priority-Flow-Engine", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}