{"manifest_version": 2, "name": "DNS Integrity Checker", "version": "1.6", "description": "Checks DNS integrity, ASN consistency, reverse DNS and TLS usage for the current website.", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "notifications", "tabs"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "DNS Checker", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "dns-checker@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}