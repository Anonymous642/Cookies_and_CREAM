{"manifest_version": 2, "name": "AutoScroll Reels & Shorts", "version": "5.2", "description": "Auto-scrolls Instagram Reels, YouTube Shorts and TikTok when video ends. No data collected.", "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://www.youtube.com/*", "https://www.tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon48.png", "96": "icon128.png"}}, "icons": {"48": "icon48.png", "96": "icon128.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "autoscroll@extension", "strict_min_version": "113.0", "strict_min_version_android": "113.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}