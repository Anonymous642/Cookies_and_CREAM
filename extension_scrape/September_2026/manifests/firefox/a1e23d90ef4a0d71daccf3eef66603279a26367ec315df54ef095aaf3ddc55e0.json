{"manifest_version": 3, "name": "Pinboard Shelf", "version": "1.0.4", "description": "Save, browse, and edit your Pinboard bookmarks from Firefox.", "action": {"default_title": "Pinboard Shelf", "default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://api.pinboard.in/*"], "browser_specific_settings": {"gecko": {"id": "{e4efabf6-ec3d-4771-ab11-d4eb1484b611}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "websiteActivity"]}}}}