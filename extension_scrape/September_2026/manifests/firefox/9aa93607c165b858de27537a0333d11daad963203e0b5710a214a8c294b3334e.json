{"manifest_version": 3, "name": "MonkeyType Trainer", "version": "1.2.0", "description": "Adds a read-ahead masking practice mode (like readahead.vercel.app) and an n-gram chunking trainer (bigrams/trigrams/tetragrams/words, like ngram-type) on top of MonkeyType.", "author": "Hashmop", "homepage_url": "https://github.com/Hashmop/monkeytype-trainer", "browser_specific_settings": {"gecko": {"id": "monkeytype-trainer@local.ext", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://monkeytype.com/*", "https://www.monkeytype.com/*"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://monkeytype.com/*", "https://www.monkeytype.com/*"], "js": ["content/ngrams.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "MonkeyType Trainer", "default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "commands": {"toggle-read-ahead": {"suggested_key": {"default": "Ctrl+Alt+R"}, "description": "Toggle Read-Ahead masking"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Alt+M"}, "description": "Toggle the trainer panel on the page"}}}