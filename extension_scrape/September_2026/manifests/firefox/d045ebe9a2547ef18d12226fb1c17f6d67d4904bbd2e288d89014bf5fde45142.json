{"manifest_version": 3, "name": "Japanese Lookup", "version": "1.0.0", "description": "Select Japanese text, right-click, and read meanings, on/kun readings, and stroke order without leaving the page.", "browser_specific_settings": {"gecko": {"id": "jp-lookup@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}}, "permissions": ["contextMenus"], "host_permissions": ["https://jisho.org/*", "https://kanjiapi.dev/*", "https://cdn.jsdelivr.net/*", "https://raw.githubusercontent.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}