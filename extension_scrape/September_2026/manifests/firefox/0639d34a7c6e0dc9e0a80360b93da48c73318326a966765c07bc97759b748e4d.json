{"manifest_version": 3, "name": "NoteSnap AI", "version": "1.1.1", "description": "Highlight any text on the web and instantly convert it to AI flashcards, summaries, and quizzes with NoteSnap AI.", "author": "NoteSnap AI", "homepage_url": "https://notesnap.org", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "commands": {"quick-flashcards": {"suggested_key": {"default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F"}, "description": "Generate flashcards from selected text"}, "quick-summary": {"suggested_key": {"default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D"}, "description": "Summarize selected text"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Open NoteSnap AI"}}, "permissions": ["storage", "tabs", "activeTab", "contextMenus", "scripting"], "browser_specific_settings": {"gecko": {"id": "extension@notesnap.org", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "121.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "NoteSnap AI \u2014 Study Smarter"}, "host_permissions": ["<all_urls>", "*://notesnap.org/*"]}