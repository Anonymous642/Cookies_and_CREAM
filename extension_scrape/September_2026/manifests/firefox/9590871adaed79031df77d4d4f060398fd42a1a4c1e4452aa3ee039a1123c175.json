{"manifest_version": 3, "name": "DataWorkbench", "version": "1.2.1", "description": "Manage browser storage across all your sites.", "icons": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png", "48": "icons/icon-48x48.png", "128": "icons/icon-128x128.png"}, "permissions": ["storage", "cookies", "scripting", "tabs"], "optional_host_permissions": ["<all_urls>"], "action": {"default_title": "Open DataWorkbench", "default_icon": {"16": "icons/icon-16x16.png", "32": "icons/icon-32x32.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "dataworkbench@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["sw.js"]}}