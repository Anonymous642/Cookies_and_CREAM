{"manifest_version": 3, "name": "MiQR \u2014 Free QR Code Generator", "short_name": "MiQR", "version": "1.2.3", "description": "Generate QR codes instantly from any URL or text. Export as PNG, SVG, or JPEG in 256px, 512px, or 1024px.", "homepage_url": "https://miqr.mx/", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab", "storage", "contextMenus"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "miqr@technowerocorp.com", "strict_min_version": "109.0"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q", "mac": "Alt+Shift+Q"}, "description": "Open MiQR Generator"}}}