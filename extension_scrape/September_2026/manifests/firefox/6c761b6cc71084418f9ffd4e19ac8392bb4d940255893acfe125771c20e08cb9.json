{"manifest_version": 2, "name": "Groo Pass", "description": "Secure password manager with passkey support", "version": "1.0.16", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icon/96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "cookies", "https://pass.groo.dev/*", "<all_urls>"], "externally_connectable": {"matches": ["https://pass.groo.dev/*", "http://localhost:*/*"]}, "browser_specific_settings": {"gecko": {"id": "pass@groo.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Groo Pass", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}, {"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/passkey-interceptor.js"], "world": "MAIN"}]}