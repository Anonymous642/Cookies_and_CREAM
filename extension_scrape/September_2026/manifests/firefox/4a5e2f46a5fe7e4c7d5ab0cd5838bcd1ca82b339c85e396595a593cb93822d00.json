{"manifest_version": 3, "name": "Niconico Japanese Enforcer", "version": "1.2.1", "description": "Forces Niconico to use Japanese and automatically starts videos on watch pages.", "permissions": ["cookies", "webRequest", "webRequestBlocking"], "host_permissions": ["*://nicovideo.jp/*", "*://*.nicovideo.jp/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://nicovideo.jp/*", "*://*.nicovideo.jp/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "niconico-japanese-enforcer@iheon.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}