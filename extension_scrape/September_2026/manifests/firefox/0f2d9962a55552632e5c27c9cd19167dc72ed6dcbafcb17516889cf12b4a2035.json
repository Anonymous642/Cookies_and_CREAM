{"manifest_version": 3, "name": "ThreadTuck", "description": "Keep long ChatGPT conversations easier to use by folding older turns locally, with one-click restore and no chat text collection.", "version": "0.1.1", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ThreadTuck", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["storage"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["assets/content.js"], "css": ["assets/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "threadtuck@rina48.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}