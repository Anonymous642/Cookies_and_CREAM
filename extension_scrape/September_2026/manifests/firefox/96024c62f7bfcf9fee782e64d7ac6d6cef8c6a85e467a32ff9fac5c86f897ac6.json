{"manifest_version": 3, "name": "Easy Peasy QR", "version": "1.0.0", "author": "Martin Pressl", "description": "Erzeugt QR-Codes f\u00fcr die aktuelle Seite und per Kontextmen\u00fc. Offline, mit Custom-Farben, Gr\u00f6\u00dfe und Logo.", "permissions": ["activeTab", "contextMenus", "storage"], "browser_specific_settings": {"gecko": {"id": "easy-peasy-qr@waron-websolutions.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "QR f\u00fcr diesen Tab", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}