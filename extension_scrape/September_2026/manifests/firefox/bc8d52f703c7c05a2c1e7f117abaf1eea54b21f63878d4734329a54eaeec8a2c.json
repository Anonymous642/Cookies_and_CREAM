{"manifest_version": 3, "name": "Drift", "version": "1.0", "description": "Gentle scroll friction for infinite feeds \u2014 after N screen-heights, a soft checkpoint appears. Keep going, or step away.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Drift", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "drift@extensions", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}