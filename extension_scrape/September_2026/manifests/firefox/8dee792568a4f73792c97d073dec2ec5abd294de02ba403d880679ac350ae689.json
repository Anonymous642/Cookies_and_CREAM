{"manifest_version": 3, "name": "Web2MD Exporter - Web Page to Markdown", "version": "1.0.0", "description": "Convert any website or public Notion document into clean, LLM-optimized Markdown (.md) for ChatGPT, Claude, and Gemini.", "browser_specific_settings": {"gecko": {"id": "web2md-exporter@antigravity.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/turndown.js", "lib/readability.js", "lib/notion-adapter.js", "content/content_script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}