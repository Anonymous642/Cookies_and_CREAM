{"manifest_version": 3, "name": "lordneu-newtab-easy-bookmark", "version": "4.5", "description": "Quickly save pins to your lordn.eu dashboard.", "permissions": ["activeTab", "storage", "scripting", "theme", "geolocation", "unlimitedStorage", "bookmarks"], "host_permissions": ["*://lordn.eu/*", "*://www.lordn.eu/*", "http://localhost:3456/*", "*://*.pages.dev/*"], "action": {"default_popup": "popup.html"}, "icons": {"128": "icon.svg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}}}, "content_scripts": [{"matches": ["*://lordn.eu/*", "*://www.lordn.eu/*", "http://localhost:3456/*", "*://*.pages.dev/*"], "js": ["content.js"], "all_frames": true}], "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["extension-accent-theme.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "pinsaver@lordn.eu", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["locationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}