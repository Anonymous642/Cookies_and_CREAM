{"manifest_version": 3, "name": "X Follower Tracker", "version": "1.1.0", "description": "Track your X/Twitter followers and detect who unfollowed you.", "permissions": ["storage", "activeTab"], "action": {"default_popup": "popup.html", "default_title": "X Follower Tracker"}, "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "xfollower-tracker@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}