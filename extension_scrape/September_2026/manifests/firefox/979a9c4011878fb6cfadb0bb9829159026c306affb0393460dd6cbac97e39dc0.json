{"manifest_version": 3, "name": "TabMate", "short_name": "TabMate", "version": "1.0", "description": "I know you open a lot of tabs, I do too, there is so much info there, so here's a way to keep them organized.", "homepage_url": "https://x.com/ofcboogeyman", "permissions": ["tabs", "storage", "scripting", "bookmarks"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["getFavicon.js"], "run_at": "document_idle"}], "host_permissions": ["<all_urls>"], "background": {"scripts": ["popup.js"]}, "action": {"default_popup": "popup.html", "default_icon": "img/icon/dev/128x128.png"}, "web_accessible_resources": [{"resources": ["img/*"], "matches": ["<all_urls>"]}], "icons": {"128": "img/icon/dev/128x128.png"}, "browser_specific_settings": {"gecko": {"id": "tabmate@local"}}}