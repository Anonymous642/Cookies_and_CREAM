{"manifest_version": 3, "name": "Replai: AI Replies for YouTube Comments", "version": "1.1.1", "description": "Instantly generate context-aware AI replies for YouTube comments. Save hours, boost engagement, and grow your channel faster.", "permissions": ["storage", "alarms"], "host_permissions": ["https://*.youtube.com/*", "https://api.groq.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://replai.pro/*"], "browser_specific_settings": {"gecko": {"id": "replai-pro@replai.pro", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'"}, "background": {"scripts": ["utils.js", "background.js"]}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["utils.js", "content.js"], "css": ["styles.css"]}], "homepage_url": "https://replai.pro", "action": {"default_popup": "settings.html", "default_title": "Replai \u2014 AI Replies for YouTube", "default_icon": {"16": "icons/replai-logo-16.png", "32": "icons/replai-logo-32.png", "48": "icons/replai-logo-48.png", "128": "icons/replai-logo-128.png"}}, "icons": {"16": "icons/replai-logo-16.png", "32": "icons/replai-logo-32.png", "48": "icons/replai-logo-48.png", "128": "icons/replai-logo-128.png"}}