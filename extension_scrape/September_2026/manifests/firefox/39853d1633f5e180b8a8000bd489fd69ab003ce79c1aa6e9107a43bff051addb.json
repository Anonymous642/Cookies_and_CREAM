{"manifest_version": 3, "name": "GPT Response Downloader", "version": "1.1.1", "browser_specific_settings": {"gecko": {"id": "gpt-response-downloader@guruka.com"}}, "description": "Adds a download button to GPT Responses", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["content.js"], "css": ["styles.css"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"]}], "options_page": "popup.html"}