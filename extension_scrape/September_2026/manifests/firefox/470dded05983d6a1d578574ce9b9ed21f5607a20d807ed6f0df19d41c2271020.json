{"manifest_version": 3, "name": "NoDistractions", "version": "2.1.0", "description": "Block distracting websites on a schedule. Unlock with a 24-character passcode typed twice, or choose total lockdown for no unlocking at all.", "browser_specific_settings": {"gecko": {"id": "nodistractions@lovable.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "alarms"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "NoDistractions", "default_icon": {"48": "icon-48.png", "128": "icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icon-48.png", "128": "icon-128.png"}}