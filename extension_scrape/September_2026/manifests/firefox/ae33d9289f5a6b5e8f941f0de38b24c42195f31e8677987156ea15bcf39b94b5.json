{"manifest_version": 2, "name": "TimeClip Clipper", "description": "YouTube\u3092\u89b3\u306a\u304c\u3089\u3001\u305d\u306e\u533a\u9593\u3092TimeClip\u306e\u30af\u30ea\u30c3\u30d7\u306b\u3067\u304d\u308b\u62e1\u5f35\u6a5f\u80fd\u3002", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://www.youtube.com/*", "https://timeclip.app/*"], "browser_specific_settings": {"gecko": {"id": "clipper@timeclip.app", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "TimeClip Clipper", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}