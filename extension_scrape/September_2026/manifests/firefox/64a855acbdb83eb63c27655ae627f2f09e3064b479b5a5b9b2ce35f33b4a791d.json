{"manifest_version": 2, "name": "Volume Booster \u2014 Up to 600%", "version": "1.0.1", "description": "Boost the volume of any audio or video on any website up to 600% using the Web Audio API. Includes quick presets, a real-time level display, and persistent settings per browser session.", "author": "Your Name", "homepage_url": "https://github.com/yourusername/volume-booster", "browser_specific_settings": {"gecko": {"id": "saviosabu05@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_popup": "popup.html", "default_title": "Volume Booster"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "tabs"]}