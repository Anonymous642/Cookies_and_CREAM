{"manifest_version": 3, "name": "iQuscribe", "version": "1.1.1", "description": "Grab any article and post it to multiple blogs at once.", "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "iQuscribe", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "iquscribe@iqsoft.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}