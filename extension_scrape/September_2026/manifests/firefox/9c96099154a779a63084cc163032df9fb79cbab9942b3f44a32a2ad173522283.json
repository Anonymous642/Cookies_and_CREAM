{"manifest_version": 3, "name": "ThumbLess", "version": "1.1", "description": "Hides YouTube thumbnails and Shorts to eliminate clickbait.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "thumbless@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}