{"manifest_version": 2, "name": "TD Site Inspector", "version": "2.0.1", "description": "Il quadro completo di un sito: stack tecnico (CMS, server, template, plugin, framework, header di sicurezza), audit SEO con punteggio, e strumenti (WHOIS, what-the-font, color picker, evidenzia heading/immagini/link).", "browser_specific_settings": {"gecko": {"id": "site-inspector@tastieredigitali.it", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "storage", "webRequest", "<all_urls>"], "browser_action": {"default_title": "TD Site Inspector", "default_popup": "popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_security_policy": "script-src 'self'; object-src 'self'"}