{"manifest_version": 2, "name": "Rhythia Unranked Leaderboard", "version": "1.0.0", "description": "Shows leaderboards for unranked Rhythia maps using API data", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "@rhythia-unranked-leaderboard", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.rhythia.com/maps/*"], "js": ["content.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "storage", "https://production.rhythia.com/*"], "browser_action": {"default_icon": "icons/icon-48.svg", "default_title": "Rhythia Unranked Leaderboard", "default_popup": "popup.html"}}