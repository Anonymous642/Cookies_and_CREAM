{"manifest_version": 2, "name": "Example AMO Add-on (Manifest v2)", "version": "1.0.0", "description": "A minimal, AMO-friendly Firefox add-on example that demonstrates safe practices (no inline scripts, no remote code, minimal permissions).", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": "icons/icon48.png", "default_title": "Example AMO Add-on", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["storage", "activeTab"], "content_security_policy": "script-src 'self'; object-src 'self'", "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "example-addon@yourdomain.com", "strict_min_version": "68.0"}}}