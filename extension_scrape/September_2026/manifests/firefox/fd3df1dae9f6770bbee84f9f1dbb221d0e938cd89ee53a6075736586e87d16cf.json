{"manifest_version": 3, "name": "YouTube Tag Viewer", "version": "1.2.1", "description": "Displays YouTube video tags beneath the description.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png", "256": "icon-256.png", "512": "icon-512.png"}, "author": "NRFH", "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "permissions": ["storage"], "action": {"default_title": "YouTube Tag Viewer", "default_popup": "popup.html"}, "host_permissions": ["https://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-tag-viewer@nrfh", "data_collection_permissions": {"required": ["none"]}}}}