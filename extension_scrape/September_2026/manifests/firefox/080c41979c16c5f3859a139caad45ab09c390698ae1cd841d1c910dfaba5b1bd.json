{"manifest_version": 2, "name": "HTML Runner", "version": "1.0", "description": "Run HTML/CSS/JS instantly in a new tab", "browser_action": {"default_title": "HTML Runner"}, "background": {"scripts": ["background.js"]}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+H"}}}, "permissions": ["tabs"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "htmlrunner@mypwas.pages.dev", "data_collection_permissions": {"required": ["none"]}}}}