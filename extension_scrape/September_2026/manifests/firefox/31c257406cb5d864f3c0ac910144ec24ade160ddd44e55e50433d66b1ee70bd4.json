{"manifest_version": 3, "name": "Aviator", "description": "Show Aviator MergeQueue status on GitHub", "version": "2026.9.24.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "host_permissions": ["https://github.com/*"], "optional_host_permissions": ["*://*/*"], "permissions": ["alarms", "identity", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "firefox-extension-stable@aviator.co", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Aviator Extension", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "browser_style": false, "page": "options.html"}, "content_scripts": [{"matches": ["https://github.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}