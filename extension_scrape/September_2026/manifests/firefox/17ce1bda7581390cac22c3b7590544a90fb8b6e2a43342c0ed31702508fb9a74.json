{"manifest_version": 3, "name": "SodiburPortal Task Manager", "version": "1.0.0", "description": "Cr\u00e9er des t\u00e2ches SodiburPortal directement depuis Gmail", "permissions": ["storage", "activeTab"], "host_permissions": ["https://mail.google.com/*", "http://localhost:8000/*", "https://*.sodibur.com/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["scripts/content.js"], "css": ["styles/gmail.css"], "run_at": "document_end"}], "background": {"scripts": ["scripts/background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "web_accessible_resources": [{"resources": ["scripts/gmail-integration.js"], "matches": ["https://mail.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "sodibur-task-manager@sodibur.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}