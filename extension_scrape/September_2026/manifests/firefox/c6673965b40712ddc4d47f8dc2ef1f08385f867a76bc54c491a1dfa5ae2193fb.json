{"manifest_version": 3, "name": "FlagTube \u2014 YouTube Blocklist", "version": "1.0.0", "description": "Hide or blur YouTube videos and channels listed by FlagTube.", "permissions": ["storage", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://flagtube.lovable.app/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "flagtube@lovable.app", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "FlagTube settings", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}