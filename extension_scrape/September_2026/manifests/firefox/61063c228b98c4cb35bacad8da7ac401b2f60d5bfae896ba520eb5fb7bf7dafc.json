{"manifest_version": 3, "name": "Scanline Helper", "version": "1.0.4", "description": "Connects your game store accounts to Scanline automatically.", "permissions": ["tabs", "declarativeNetRequest"], "host_permissions": ["*://www.epicgames.com/id/api/redirect*", "*://embed.gog.com/on_login_success*", "*://*.account.sony.com/api/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.epicgames.com/id/api/redirect*"], "js": ["content/epic.js"], "run_at": "document_start"}, {"matches": ["*://embed.gog.com/on_login_success*"], "js": ["content/gog.js"], "run_at": "document_start"}, {"matches": ["*://*.account.sony.com/api/v1/ssocookie*"], "js": ["content/psn.js"], "run_at": "document_start"}, {"matches": ["https://*.scanline.gg/*"], "js": ["content/scanline.js"], "run_at": "document_idle"}], "externally_connectable": {"matches": ["https://*.scanline.gg/*"]}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "helper@scanline.gg", "strict_min_version": "140.0", "data_collection_permissions": {"data_collected": false, "required": ["none"]}}}}