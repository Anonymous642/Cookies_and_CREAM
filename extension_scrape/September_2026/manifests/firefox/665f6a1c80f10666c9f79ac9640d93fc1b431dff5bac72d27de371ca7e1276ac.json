{"manifest_version": 2, "name": "Email Makinator", "description": "A modern browser extension that helps anyone create a polished email.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "http://localhost/*", "http://127.0.0.1/*", "https://api.mkgpdev.xyz/*"], "browser_specific_settings": {"gecko": {"id": "email-makinator@mkgpdev.xyz", "data_collection_permissions": {"required": ["personalCommunications"], "optional": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Email Makinator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["content-scripts/content.js"]}]}