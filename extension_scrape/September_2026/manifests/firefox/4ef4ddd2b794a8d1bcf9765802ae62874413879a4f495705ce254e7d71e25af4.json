{"manifest_version": 3, "name": "Spaced URL", "version": "1.0.1", "description": "Remember your favorite web pages. Revisit your bookmarks at optimized intervals using spaced repetition.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Open Next Spaced URL"}, "background": {"scripts": ["src/background.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["bookmarks", "history", "storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "spacedurl@example.com", "strict_min_version": "109.0"}}}