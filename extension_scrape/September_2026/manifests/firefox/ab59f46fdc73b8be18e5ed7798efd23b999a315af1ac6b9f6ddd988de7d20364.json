{"manifest_version": 2, "name": "Tesseract: AI Fact Checker for YT & Reddit", "version": "1.2.4", "description": "AI fact-checker and video summarizer for YouTube, Reddit, Twitter & Facebook. Instant verdicts with sources.", "browser_specific_settings": {"gecko": {"id": "tesseract@tesseract-extension.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "storage", "tabs", "https://tesseract-extension-production.up.railway.app/*", "https://twitter.com/*", "https://x.com/*", "https://facebook.com/*", "https://www.youtube.com/*", "*://*.youtube.com/*", "https://www.reddit.com/*", "https://reddit.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com", "background": {"scripts": ["shared/browser-polyfill.js", "background/service-worker.js"], "persistent": false}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://x.com/*", "https://facebook.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "*://*.youtube.com/*", "https://www.reddit.com/*", "https://reddit.com/*", "https://old.reddit.com/*", "*://*.reddit.com/*"], "css": ["content/tesseract.css", "content/tesseract-platform.css"], "js": ["shared/browser-polyfill.js", "shared/config.js", "shared/storage.js", "shared/context-extractor.js", "shared/transcript-extractor.js", "content/utils.js", "content/components.js", "content/tesseract.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "web_accessible_resources": ["assets/logo.png", "content/tesseract-platform.css"], "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}