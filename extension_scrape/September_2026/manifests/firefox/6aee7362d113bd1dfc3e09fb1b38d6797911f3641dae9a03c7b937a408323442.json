{"manifest_version": 3, "name": "YouTube Pink Theme", "version": "5.6.0", "description": "YouTube Pink kawaii theme by kcandyarts with Firefox dark-mode and always-wide watch mode fixes.", "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*", "*://*.youtube.com/*"], "css": ["styles/youtube-pink.css", "styles/watch-dark-fix.css"], "js": ["scripts/apply-theme.js"], "run_at": "document_start"}], "icons": {"128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-pink-theme@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}