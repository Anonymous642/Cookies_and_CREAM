{"manifest_version": 3, "name": "Kinetic Margin", "version": "1.0.0", "description": "Compose gentle motion for chosen page elements. Preview, adjust and keep reusable page recipes.", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "kinetic-margin@page-poetry.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Kinetic Margin", "default_popup": "popup.html", "default_icon": {"48": "icons/48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}, "background": {"scripts": ["model.js", "background.js", "lifecycle.js"]}}