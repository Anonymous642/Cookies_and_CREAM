{"name": "Eat This Much Recipe Clipper", "author": "Eat This Much Inc.", "description": "Save recipes you find around the web to your personal Eat This Much collection for meal planning.", "version": "3.0.1", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "recipe-clipper@eatthismuch.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "incognito": "not_allowed", "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "clipper-favicon-16.png", "32": "clipper-favicon-32.png", "48": "clipper-favicon-48.png", "128": "clipper-favicon-128.png"}, "default_title": "Save Recipe to Eat This Much"}, "icons": {"16": "clipper-favicon-16.png", "32": "clipper-favicon-32.png", "48": "clipper-favicon-48.png", "128": "clipper-favicon-128.png"}, "content_scripts": [{"matches": ["https://www.eatthismuch.com/*"], "js": ["handoff.js"], "run_at": "document_start"}], "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "short_name": "ETM Clipper"}