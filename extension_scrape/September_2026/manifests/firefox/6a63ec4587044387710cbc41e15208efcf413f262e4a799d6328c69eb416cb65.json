{"manifest_version": 3, "name": "QuietBrowsing: Link & Tracker Cleaner", "version": "1.0.1", "description": "Auto-remove utm_, fbclid, gclid & tracking params from links. Reveal real URLs behind redirects. 100% local, nothing uploaded.", "browser_specific_settings": {"gecko": {"id": "quietbrowsing@verimedia.xyz", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["declarativeNetRequest", "contextMenus", "storage", "activeTab", "scripting", "clipboardRead"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "QuietBrowsing", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["activate.html"], "matches": ["https://verimedia.xyz/*"]}], "declarative_net_request": {"rule_resources": [{"id": "tracking_params", "enabled": true, "path": "rules/rules.json"}]}}