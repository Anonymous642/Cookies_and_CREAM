{"manifest_version": 3, "name": "Cookie Monsters", "version": "1.0", "description": "Name your cookie monster and let him eat all those pesky popups. Find it. Name it. Feed it cookies.", "permissions": ["storage", "declarativeNetRequest", "clipboardWrite"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "hello@kaleido.us", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": true}], "declarative_net_request": {"rule_resources": [{"id": "cmp_blocklist", "enabled": true, "path": "rules.json"}]}, "action": {"default_popup": "popup.html", "default_title": "Cookie Monsters"}, "icons": {"16": "icons/icon16.ico", "32": "icons/icon32.ico"}}