{"manifest_version": 3, "name": "Google Translate to Anki", "version": "1.0.0", "description": "Create Anki flashcards from Google Translate translations", "browser_specific_settings": {"gecko": {"id": "google-translate-anki@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "personal": false, "technical": false}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "activeTab"], "host_permissions": ["http://localhost:8765/*"], "content_scripts": [{"matches": ["*://translate.google.com/*"], "js": ["content/content.js"], "css": ["content/content.css"]}], "background": {"scripts": ["background/background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}}