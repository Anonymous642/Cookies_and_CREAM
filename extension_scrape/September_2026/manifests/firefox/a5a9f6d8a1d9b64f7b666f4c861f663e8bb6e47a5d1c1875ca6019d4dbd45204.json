{"manifest_version": 3, "name": "Daisee \u2014 Read on my phone", "description": "Send the page you're reading to your Daisee phone app, which reads it aloud. Pair once with the code your phone speaks.", "version": "1.3.1", "action": {"default_title": "Read this page on my phone (Alt+Shift+R)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["compat.js", "service_worker.js"]}, "permissions": ["scripting", "storage", "bookmarks"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://player.vimeo.com;"}, "host_permissions": ["https://api.hellodaisee.org/*", "http://*/*", "https://*/*"], "commands": {"read-page": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Read this page on my phone"}, "summarise-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Summarise this page on my phone"}, "open-and-read": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open the Daisee panel and read this page"}}, "browser_specific_settings": {"gecko": {"id": "daisee@hellodaisee.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "sidebar_action": {"default_panel": "popup/popup.html", "default_title": "Daisee \u2014 Read on my phone", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "open_at_install": false}}