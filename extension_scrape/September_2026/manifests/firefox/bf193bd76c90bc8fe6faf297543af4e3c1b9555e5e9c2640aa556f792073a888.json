{"$schema": "https://json.schemastore.org/chrome-manifest", "manifest_version": 3, "name": "Trunk for GitHub", "description": "Adds Trunk functionality to GitHub and GitHub-synced pull requests on Cursor Origin.", "version": "1.4.0", "icons": {"48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Trunk for GitHub", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png"}}, "permissions": ["storage", "cookies"], "options_ui": {"page": "options.html", "open_in_tab": true}, "host_permissions": ["https://github.com/*", "https://cursor.com/*", "https://gitlab.com/*", "https://trunk.io/*", "https://*.trunk.io/*", "https://app.trunk.io/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://github.com/*", "https://cursor.com/*", "https://gitlab.com/*"], "run_at": "document_start", "js": ["content-script.js"], "css": ["merge-status-colors.css", "styles.css"]}], "browser_specific_settings": {"gecko": {"id": "trunk-github@trunk.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}