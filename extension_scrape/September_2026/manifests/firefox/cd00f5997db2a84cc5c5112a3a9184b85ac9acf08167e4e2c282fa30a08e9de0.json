{"manifest_version": 3, "name": "FragHub Reviewer", "version": "0.2.0", "description": "Download and decompress FragHub Overwatch demos for review.", "permissions": ["downloads"], "host_permissions": ["*://*.fraghub.pro/*"], "content_scripts": [{"matches": ["*://*.fraghub.pro/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "background": {"scripts": ["service-worker.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "FragHub Reviewer"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "fraghub-reviewer@fraghub.pro", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}