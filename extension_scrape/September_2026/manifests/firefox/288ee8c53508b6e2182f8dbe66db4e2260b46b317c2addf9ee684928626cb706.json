{"manifest_version": 3, "name": "LoopHog", "version": "1.2.0", "description": "Loop and slow any part of a YouTube video.", "browser_specific_settings": {"gecko": {"id": "loophog@loophog.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "minimum_chrome_version": "111", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/state.js", "page/effects.js", "page/capture.js", "page/engine.js"], "world": "MAIN", "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.youtube.com/*"], "js": ["content/state.js", "content/hog.js", "content/waveform.js", "content/overlay.js", "content/content.js"], "css": ["content/overlay.css"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["page/recorder-worklet.js"], "matches": ["*://*.youtube.com/*"]}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "commands": {"set-a": {"suggested_key": {"default": "Ctrl+Alt+A"}, "description": "Set loop start"}, "set-b": {"suggested_key": {"default": "Ctrl+Alt+B"}, "description": "Set loop end"}, "toggle": {"suggested_key": {"default": "Ctrl+Alt+L"}, "description": "Toggle loop"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Alt+H"}, "description": "Show or hide the LoopHog panel"}}}