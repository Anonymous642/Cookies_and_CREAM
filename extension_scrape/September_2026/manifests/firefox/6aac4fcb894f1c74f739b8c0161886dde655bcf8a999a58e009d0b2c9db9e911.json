{"name": "simple-did-resolver", "version": "1.0.3", "description": "Extension to resolve simple DID methods (web, jwk, key, dns, ...)", "manifest_version": 3, "author": "Pierre Gronlier", "homepage_url": "https://gitlab.com/pierre.gronlier/extension-did-web-resolver/", "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["http://ext+simple-did-resolver/*"], "background": {"scripts": ["background.js"]}, "protocol_handlers": [{"protocol": "ext+did", "name": "Simple DID Resolver Extension", "uriTemplate": "http://ext+simple-did-resolver/%s"}], "browser_specific_settings": {"gecko": {"id": "simple-did-resolver2@gronlier.fr"}}}