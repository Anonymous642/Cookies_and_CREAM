{"manifest_version": 3, "name": "Vapai Screen: Full Page Capture", "version": "1.3", "description": "Full-page screenshot tool: saves to disk and copies to clipboard natively.", "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/logo-48.png", "96": "icons/logo-96.png"}}, "icons": {"48": "icons/logo-48.png", "96": "icons/logo-96.png"}, "browser_specific_settings": {"gecko": {"id": "fullpage-capture@local.poc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}