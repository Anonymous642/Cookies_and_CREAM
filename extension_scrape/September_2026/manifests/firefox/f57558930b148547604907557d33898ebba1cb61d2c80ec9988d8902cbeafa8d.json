{"manifest_version": 2, "name": "LinkedIn Job Feed Monitor", "version": "1.1.1", "description": "Monitors your LinkedIn feed for job posts and sends real-time notifications", "permissions": ["notifications", "storage", "https://www.linkedin.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "linkedin-job-monitor@kurtsextension.com", "strict_min_version": "109.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["icons/*.png"]}