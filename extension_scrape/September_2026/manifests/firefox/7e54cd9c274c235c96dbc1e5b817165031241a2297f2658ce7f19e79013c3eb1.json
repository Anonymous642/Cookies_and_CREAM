{"manifest_version": 3, "name": "NASA APOD Background", "version": "1.0", "description": "Ersetzt deinen neuen Tab mit dem NASA APOD-Hintergrund", "permissions": ["storage", "alarms", "topSites"], "host_permissions": ["https://api.nasa.gov/*"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "browser_specific_settings": {"gecko": {"id": "nasa-apod@localhost", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}