{"manifest_version": 2, "name": "Tab Deduper", "version": "1.2", "description": "Closes duplicate tabs, keeping the oldest. Clean up your tab chaos instantly.", "browser_specific_settings": {"gecko": {"id": "tab-deduper@extension", "strict_min_version": "149.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": false}}