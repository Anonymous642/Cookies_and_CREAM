{"manifest_version": 3, "name": "Reajusta telas do SAU para celular", "version": "1.0", "description": "Esta extens\u00e3o ser\u00e1 para melhorar o tamanho das p\u00e1ginas do SAU", "browser_specific_settings": {"gecko": {"id": "sau-mobile@egov.santos.sp.gov.br", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Ajusta SAU para celular", "default_popup": "index.html", "default_icon": {"19": "icon19.png", "38": "icon38.png"}}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://*.egov.santos.sp.gov.br/sau/*"], "content_scripts": [{"matches": ["https://*.egov.santos.sp.gov.br/sau/*"], "js": ["src/main.js"], "css": ["src/normalize.css", "src/style.css"], "run_at": "document_idle"}], "options_ui": {"page": "index.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["src/style.css", "src/normalize.css", "src/main.js"], "matches": ["https://*.egov.santos.sp.gov.br/*"]}]}