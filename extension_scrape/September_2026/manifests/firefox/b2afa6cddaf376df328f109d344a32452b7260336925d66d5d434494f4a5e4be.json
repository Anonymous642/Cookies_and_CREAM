{"manifest_version": 2, "name": "Lionova - Safe Search for Kids", "short_name": "Lionova", "version": "1.0.0", "description": "Kid-friendly search powered by AI. Safe, educational, and fun! Type 'lion' followed by your search in the address bar.", "author": "Lionova", "homepage_url": "https://lionova.me", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Lionova Search", "default_popup": "popup.html"}, "omnibox": {"keyword": "lion"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "lionova@lionova.me", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}