{"manifest_version": 2, "name": "Cloudflare Email Routing", "version": "1.0.0", "description": "Generate a Cloudflare Email Routing alias for the current site.", "permissions": ["storage", "tabs", "https://api.cloudflare.com/*"], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_action": {"default_popup": "popup.html", "default_title": "Cloudflare Email Routing", "default_icon": "icons/icon.svg"}, "background": {"scripts": ["words.js", "background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "cloudflare-email-routing@community", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "120.0"}}}