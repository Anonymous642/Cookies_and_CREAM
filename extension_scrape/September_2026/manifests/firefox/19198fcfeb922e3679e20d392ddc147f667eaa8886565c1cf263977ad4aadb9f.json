{"manifest_version": 3, "name": "Torch PitchFinder", "description": "Instantly detect the musical key and pitch of any audio playing in your browser tabs for musicians and DJs.", "version": "1.0.0", "author": "SoundWave Labs", "permissions": ["activeTab", "audioCapture", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "torchpitchfinder@soundwavelabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}