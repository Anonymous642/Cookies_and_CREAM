{"manifest_version": 3, "name": "Epic Free Games Claimer", "version": "1.0.2", "description": "Reminds you once a week when Epic's free games are up, and opens a single combined claim link. You finish checkout yourself.", "browser_specific_settings": {"gecko": {"id": "epic-free-claimer@luke.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "storage", "notifications", "cookies"], "host_permissions": ["https://store-site-backend-static-ipv4.ak.epicgames.com/*", "*://*.epicgames.com/*"], "background": {"scripts": ["lib/epic.js", "background.js"]}, "action": {"default_title": "Epic Free Games", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}