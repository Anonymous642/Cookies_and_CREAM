{"manifest_version": 2, "name": "Workspaces for Firefox", "version": "1.0.5", "description": "Floorp-style workspaces with Multi-Account Container support for Firefox 150+", "author": "Workspace Extension", "permissions": ["tabs", "tabHide", "contextualIdentities", "cookies", "storage", "sessions", "activeTab", "menus"], "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}, "default_title": "Workspaces", "default_popup": "popup/popup.html"}, "sidebar_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Workspaces", "default_panel": "sidebar/sidebar.html", "open_at_install": false}, "background": {"scripts": ["background/background.js"], "persistent": true}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+W"}, "description": "Toggle Workspaces sidebar"}, "next-workspace": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Switch to next workspace"}, "prev-workspace": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Switch to previous workspace"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "workspace@firefox-extension", "strict_min_version": "150.0", "data_collection_permissions": {"required": ["none"]}}}}