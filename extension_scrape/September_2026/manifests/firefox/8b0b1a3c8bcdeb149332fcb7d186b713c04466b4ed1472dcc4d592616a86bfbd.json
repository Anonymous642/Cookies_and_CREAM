{"manifest_version": 3, "name": "Wordnudge", "version": "0.1.0", "description": "Independent helper for today's Strands puzzle with step-by-step Wordnudge hints.", "browser_specific_settings": {"gecko": {"id": "wordnudge-firefox@wordnudge.org", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "192": "icons/icon192.png", "512": "icons/icon512.png"}, "permissions": ["storage"], "host_permissions": ["https://wordnudge.org/*"], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Wordnudge", "default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["fixtures/*"], "matches": ["<all_urls>"]}]}