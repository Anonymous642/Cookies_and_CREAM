{"manifest_version": 2, "name": "SMS Code Filler", "version": "1.1.9", "description": "Reads SMS phone-verification codes from the macOS Messages app and fills them into the right field in Firefox automatically.", "icons": {"32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "sms-code-filler@ye.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["nativeMessaging", "activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "SMS Code Filler", "default_popup": "popup/popup.html", "default_icon": {"32": "icons/icon.svg", "48": "icons/icon.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": true}]}