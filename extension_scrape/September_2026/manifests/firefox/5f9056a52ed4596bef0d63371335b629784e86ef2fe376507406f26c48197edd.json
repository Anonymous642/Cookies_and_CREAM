{"manifest_version": 3, "name": "wyper: AI Fact Check with Real Sources", "version": "1.9.3", "description": "Check any claim, page or video: a 1-10 truth score with real, linkable sources. Two AI models cross-check. Runs only when you ask.", "homepage_url": "https://wyper.io", "author": "wyper.io", "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://api.wyper.io/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "wyper.io \u2014 Fact-Check", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "factcheck@wyper.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}}