{"manifest_version": 3, "name": "Guitar Chords to Nextcloud", "version": "1.1.0", "description": "Extracts chords and lyrics from Ultimate Guitar chord pages and uploads them as a .txt file to your own Nextcloud instance.", "permissions": ["storage"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.ultimate-guitar.com/tab/*", "*://*.boiteachansons.net/*partitions/*"], "js": ["sources/ultimate-guitar.js", "sources/boiteachansons.js", "content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "guitar-chords-to-nextcloud@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}