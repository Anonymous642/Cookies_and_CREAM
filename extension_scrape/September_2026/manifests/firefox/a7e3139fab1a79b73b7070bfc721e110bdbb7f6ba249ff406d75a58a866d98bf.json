{"manifest_version": 2, "name": "Quote Extractor PMK", "version": "1.3", "description": "Extract and save meaningful quotes from any web page for personal use.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Quote Extractor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Quote-Extractor-PMK", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}