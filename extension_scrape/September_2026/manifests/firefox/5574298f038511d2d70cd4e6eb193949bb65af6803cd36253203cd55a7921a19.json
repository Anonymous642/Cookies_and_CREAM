{"manifest_version": 3, "name": "JNTO", "version": "1.0.1", "description": "JNTO Firefox Extension", "browser_specific_settings": {"gecko": {"id": "jnto@jnto.ai", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "JNTO", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_popup": "popup/index.html"}, "content_scripts": [{"matches": ["*://*.jnto.ai/*"], "js": ["content.js"], "run_at": "document_idle"}]}