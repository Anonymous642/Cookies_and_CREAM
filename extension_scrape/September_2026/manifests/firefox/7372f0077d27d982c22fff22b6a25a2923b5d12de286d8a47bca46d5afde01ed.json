{"manifest_version": 3, "name": "Linear Copy Task Name", "version": "1.0", "description": "One-click button on Linear issue pages that copies the task in Toggl-friendly format, e.g. \"TAP-1890 Task title\".", "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "linear-copy-task-name@egracens.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://linear.app/*"], "js": ["content.js"], "run_at": "document_idle"}]}