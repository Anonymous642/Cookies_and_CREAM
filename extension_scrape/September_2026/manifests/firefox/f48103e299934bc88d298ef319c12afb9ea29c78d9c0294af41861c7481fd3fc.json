{"manifest_version": 3, "name": "YouTube Local Subtitles", "version": "1.0.0", "description": "Load your own subtitle files on YouTube and customize their appearance.", "permissions": ["tabs", "scripting", "storage"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "YouTube Local Subtitles", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@youtube-local-subtitles.by-zoinkx", "data_collection_permissions": {"required": ["none"]}}}}