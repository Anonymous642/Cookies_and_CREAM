{"manifest_version": 3, "name": "CadysDict: Multi-Dictionary Lookup", "version": "1.0.1", "author": "Gediz", "description": "Double-click any word to instantly view definitions from Oxford, Merriam-Webster, and FreeDict in a gorgeous floating window.", "permissions": ["storage"], "host_permissions": ["https://www.oxfordlearnersdictionaries.com/*", "https://www.merriam-webster.com/*", "https://api.dictionaryapi.dev/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "cadysdict@gediz.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}