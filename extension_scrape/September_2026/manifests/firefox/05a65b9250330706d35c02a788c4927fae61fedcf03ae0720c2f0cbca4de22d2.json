{"manifest_version": 2, "name": "Impulse Purchase Blocker", "version": "1.3", "description": "Prevent impulse purchases by adding a delay, custom warning and spending cooldowns before purchase actions.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "activeTab", "tabs", "notifications"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Impulse Blocker", "default_popup": "popup.html", "default_icon": "icons/logo_32.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@Impulse-Purchase-Blocker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}