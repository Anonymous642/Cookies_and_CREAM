{"manifest_version": 2, "name": "Full Page Screenshot to Clipboard", "version": "1.0.0", "description": "Capture a full-page screenshot of the current tab and copy it to the clipboard.", "browser_specific_settings": {"gecko": {"id": "@copy-web", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "clipboardWrite", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_action": {"default_title": "Capture Full Page to Clipboard", "default_icon": "icons/icon-48.png"}, "icons": {"48": "icons/icon-48.png"}, "commands": {"capture_full_page": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture full page to clipboard"}}}