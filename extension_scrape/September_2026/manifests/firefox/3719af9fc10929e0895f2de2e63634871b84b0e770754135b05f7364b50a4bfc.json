{"manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "wellbookmarked@darinrandalfstudio.com"}}, "name": "Well Bookmarked \u2014 Tag, Search & Clean Up", "version": "2.7.0", "description": "A bookmark manager with tags: search by tag or keyword, find duplicates, and tidy your library from your new tab.", "icons": {"16": "img/logo-16.png", "32": "img/logo-32.png", "48": "img/logo-48.png", "128": "img/logo-128.png"}, "browser_action": {"default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["history", "bookmarks", "storage", "tabs"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+F", "windows": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F", "chromeos": "Ctrl+Shift+F", "linux": "Ctrl+Shift+F"}, "description": "Send a 'toggle-feature' event"}}}