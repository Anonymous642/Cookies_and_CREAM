{"manifest_version": 2, "name": "Web Link Tracker", "version": "1.0", "description": "Easily track and categorize web links with export functionality", "browser_specific_settings": {"gecko": {"id": "weblinktracker@shiwenhu", "strict_min_version": "78.0"}}, "permissions": ["tabs", "storage", "notifications", "activeTab"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Web Link Tracker", "default_popup": "popup/popup.html"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}}