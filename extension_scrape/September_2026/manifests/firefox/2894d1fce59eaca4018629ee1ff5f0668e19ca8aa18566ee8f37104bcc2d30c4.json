{"manifest_version": 2, "name": "Facet", "version": "1.0.0", "description": "A sleek sidebar for inspecting page styles, colors, fonts, and images. Scan any webpage for its design DNA \u2014 typography, color palette, element styles \u2014 and download assets, all from a single panel.", "browser_specific_settings": {"gecko": {"id": "facet@erictootalldan", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "downloads", "<all_urls>"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_action": {"default_title": "Facet", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg"}}, "sidebar_action": {"default_title": "Facet", "default_panel": "sidebar.html", "default_icon": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]}