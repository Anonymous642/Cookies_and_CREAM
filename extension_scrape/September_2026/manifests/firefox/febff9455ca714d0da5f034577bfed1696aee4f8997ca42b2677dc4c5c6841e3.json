{"manifest_version": 3, "name": "QR Code Generator & Scanner \u2013 NeoReader", "description": "Free QR code generator and QR code scanner. One-click QR for any page, scan codes on screen, links checked. Private by default.", "version": "0.1.5", "short_name": "NeoReader QR", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://neoreader.com/qr-code-extension", "permissions": ["activeTab", "scripting", "contextMenus", "storage"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_title": "NeoReader QR", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Open NeoReader QR"}, "scan-page": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Scan QR Codes on This Page"}}, "browser_specific_settings": {"gecko": {"id": "qr@neoreader.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}