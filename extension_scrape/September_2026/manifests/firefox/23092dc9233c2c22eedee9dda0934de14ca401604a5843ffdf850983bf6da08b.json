{"manifest_version": 2, "name": "Ask Them All", "description": "Send selected text to multiple AI chat services", "version": "0.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://www.google.com/*"], "browser_specific_settings": {"gecko": {"id": "ask-them-all@arstella.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "PrismChat", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://www.google.com/*", "https://www.perplexity.ai/*"], "js": ["content-scripts/injector.js"]}]}