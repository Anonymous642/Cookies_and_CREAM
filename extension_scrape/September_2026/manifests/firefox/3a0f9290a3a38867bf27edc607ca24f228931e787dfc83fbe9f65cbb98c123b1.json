{"manifest_version": 3, "name": "Be Mindful", "version": "1.3.13", "description": "Blocks sites that distract you from the important things", "author": "Sebastian Figueroa", "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": "logo.png"}, "icons": {"128": "logo.png"}, "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["welcome.html", "blocked.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "bemindful@example.com"}}}