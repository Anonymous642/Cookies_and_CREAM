{"manifest_version": 3, "name": "Simple YouTube", "description": "Simple YouTube is a lightweight extension that simplifies your YouTube experience by removing unnecessary clutter.", "version": "3.2.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "roman@lerchster.dev", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Simple YouTube", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "all_frames": false, "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}