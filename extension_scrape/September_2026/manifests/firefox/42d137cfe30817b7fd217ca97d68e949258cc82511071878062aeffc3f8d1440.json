{"manifest_version": 3, "name": "Pensaccio", "version": "1.0.0", "description": "Browser extension for Pensaccio reading list management", "author": "Your Name", "homepage_url": "https://pensaccio.com", "browser_specific_settings": {"gecko": {"id": "extension@pensaccio.com"}}, "permissions": ["activeTab", "storage", "scripting", "tabs", "contextMenus"], "host_permissions": ["https://pensaccio.fly.dev/*"], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "128": "icons/icon128.png"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Pensaccio"}}, "background": {"scripts": ["service-worker-loader.js"], "type": "module"}}