{"manifest_version": 3, "name": "Spotsavr \u2014 Coupons & Verified Promo Codes", "short_name": "Spotsavr", "version": "1.10.8", "description": "Automatically find and apply verified discount codes at checkout. Save money effortlessly on your favourite online stores.", "homepage_url": "https://spotsavr.com", "permissions": ["storage", "cookies", "activeTab", "scripting"], "host_permissions": ["*://*.spotsavr.com/*", "*://spotsavr.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Spotsavr", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/logo.png", "icons/icon48.png", "feed.html", "feed.css", "feed.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "hermes@spotsavr.com", "strict_min_version": "128.0"}}}