{"manifest_version": 3, "name": "Salesforce List View Auto Refresh", "version": "1.0", "description": "Automatically refresh Salesforce list views at custom intervals", "author": "Maninder Singh, https://www.sfdcproducthunt.com/", "homepage_url": "https://www.sfdcproducthunt.com/", "browser_specific_settings": {"gecko": {"id": "@sflistview-refresh.maninder-s", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["https://*.salesforce.com/*", "https://*.force.com/*", "https://*.lightning.force.com/*", "https://*.cloudforce.com/*"], "css": ["content.css"], "js": ["content.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Salesforce List View Auto Refresh"}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["welcome.html"], "matches": ["<all_urls>"]}]}