{"manifest_version": 3, "name": "MultiTab Print | Print All Tabs", "short_name": "MultiTab Print", "version": "1.2.2", "description": "Print all your open tabs together into one combined print preview \u2014 local, private, one native print dialog.", "permissions": ["tabs", "storage", "contextMenus", "scripting"], "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"], "background": {"scripts": ["platform-config.js", "background.js"]}, "action": {"default_title": "Print multiple tabs", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "multitab-print@thechriscross.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}