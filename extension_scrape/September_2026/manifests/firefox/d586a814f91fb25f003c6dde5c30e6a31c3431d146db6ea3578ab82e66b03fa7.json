{"manifest_version": 2, "name": "Best Homepage Ever: Home and New Tab Launcher", "author": "Justin Carver", "version": "2.0.0", "description": "Automatically sets Best Homepage Ever as your homepage and default new tab page.", "icons": {"16": "images/16x16.png", "48": "images/48x48.png", "128": "images/128x128.png"}, "permissions": ["storage", "contextMenus"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/16x16.png", "48": "images/48x48.png", "128": "images/128x128.png"}, "default_title": "BestHomepageEver"}, "chrome_settings_overrides": {"homepage": "https://besthomepageever.com"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["js/background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "@besthomepageever", "strict_min_version": "79.0"}}}