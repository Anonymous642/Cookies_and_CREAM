{"manifest_version": 3, "name": "R\u00e9sum\u00e9 YouTube par Gemini", "version": "3.7", "description": "R\u00e9sumez n'importe quelle vid\u00e9o YouTube en un clic. L'extension ajoute un bouton 'R\u00e9sumer' sur YouTube, ouvre Gemini et lui envoie le lien de la vid\u00e9o choisie avec un texte personnalisable.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["gemini_auto_submit.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-gemini-summarizer@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}