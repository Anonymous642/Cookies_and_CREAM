{"manifest_version": 3, "name": "Subtitle Mask", "version": "1.0.0", "description": "Cover subtitles or any part of a webpage with a movable, resizable mask.", "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Subtitle Mask", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "subtitle-mask@subtitle-mask", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}