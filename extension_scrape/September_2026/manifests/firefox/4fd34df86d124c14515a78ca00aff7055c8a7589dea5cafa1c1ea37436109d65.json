{"manifest_version": 2, "name": "Clipboard URL Normalizer", "version": "1.1", "description": "Normalizes URLs copied to clipboard: decodes percent-encoded characters and re-encodes spaces as %20.", "homepage_url": "https://github.com/Jefik37/clipboard-url-normalizer", "browser_specific_settings": {"gecko": {"id": "clipboard-url-normalizer@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["clipboardRead", "clipboardWrite"], "background": {"scripts": ["background.js"], "persistent": true}}