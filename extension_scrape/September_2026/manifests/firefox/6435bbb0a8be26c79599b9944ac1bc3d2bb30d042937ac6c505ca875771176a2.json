{"manifest_version": 3, "name": "YT Playlist Optimizer", "version": "0.1.0", "description": "Reordena\u00e7\u00e3o assistida de playlists do YouTube (MVP).", "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://music.youtube.com/*"], "action": {"default_title": "YT Playlist Optimizer"}, "browser_specific_settings": {"gecko": {"id": "yt-playlist-optimizer@local", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/playlist*", "*://music.youtube.com/playlist*"], "js": ["content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}]}