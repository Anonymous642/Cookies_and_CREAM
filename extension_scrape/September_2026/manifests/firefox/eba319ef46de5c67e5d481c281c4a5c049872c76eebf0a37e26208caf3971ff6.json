{"manifest_version": 2, "name": "tubeloops extension", "description": "Supercharges tubeloops.com: real audio waveform, HQ slow-down, gapless loops - plus a 'Create a loop' button on YouTube.", "version": "1.0.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "homepage_url": "https://tubeloops.com", "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "extension@tubeloops.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "tubeloops", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/embed/*"], "all_frames": true, "js": ["content-scripts/embed.js"]}, {"matches": ["*://tubeloops.com/*", "*://www.tubeloops.com/*"], "run_at": "document_start", "js": ["content-scripts/tubeloops.js"]}, {"matches": ["*://www.youtube.com/*"], "js": ["content-scripts/youtube.js"]}], "web_accessible_resources": ["peaks-worklet.js", "stretch-worklet.js", "pcm-worklet.js"]}