{"manifest_version": 3, "name": "Lookuber", "version": "1.0.0", "description": "Click words in YouTube subtitles\u2014or on any web page\u2014to look them up across multiple dictionaries, hear pronunciation, and save them to your own vocabulary book.", "author": "weiwei84530", "homepage_url": "https://github.com/weiwei84530/lookuber", "browser_specific_settings": {"gecko": {"id": "lookuber@weiwei84530", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.youtube.com/*", "https://api.dictionaryapi.dev/*", "https://translate.googleapis.com/*", "https://dictionary.cambridge.org/*", "https://cn.bing.com/*", "https://jisho.org/*", "https://www.moedict.tw/*", "https://freedictionaryapi.com/*"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["src/content/youtube/index.js"], "css": ["src/content/styles.css"], "run_at": "document_start", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["src/content/web-select/index.js"], "css": ["src/content/styles.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/content/*.js", "src/content/youtube/*.js", "src/content/web-select/*.js", "src/content/card/*.js", "src/shared/*.js", "src/shared/*.css", "src/pages/*"], "matches": ["<all_urls>"]}], "action": {"default_title": "Lookuber", "default_popup": "src/pages/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "src/pages/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}