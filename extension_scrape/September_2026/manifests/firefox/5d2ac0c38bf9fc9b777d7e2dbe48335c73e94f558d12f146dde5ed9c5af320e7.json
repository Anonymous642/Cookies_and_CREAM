{"manifest_version": 3, "name": "Proxtend", "version": "1.8", "author": "HanSS", "description": "Premium groups, tags, notes and fast search for Proxmox VE.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup/index.html", "default_title": "Proxtend"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/inject.js"], "css": ["content/style.css"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png"}, "web_accessible_resources": [{"resources": ["i18n/*.json"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "proxtend-1-5@cnhosted.com", "data_collection_permissions": {"required": ["none"]}}}}