{"manifest_version": 2, "name": "Tumblrator", "version": "0.1.2", "description": "Rewrite LinkedIn feed text into chaotic Tumblr-style voice using local heuristics only.", "permissions": ["activeTab", "storage", "https://linkedin.com/*", "https://*.linkedin.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://linkedin.com/*", "https://*.linkedin.com/*"], "js": ["tumblrator.js"]}], "icons": {"48": "icon.png", "96": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "tumblrator@eransblog.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}