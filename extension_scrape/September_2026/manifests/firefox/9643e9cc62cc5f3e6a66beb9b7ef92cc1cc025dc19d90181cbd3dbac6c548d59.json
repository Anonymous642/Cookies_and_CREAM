{"manifest_version": 2, "name": "InputStash", "description": "Never lose what you typed. Recover recent input from any page.", "version": "0.1.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "tabs", "unlimitedStorage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "inputstash@mekedron.dev", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "InputStash", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "js": ["content-scripts/content.js"], "match_origin_as_fallback": false}]}