{"manifest_version": 2, "name": "Auto Repost Scheduler", "version": "1.3", "description": "Schedule and automatically repost selected content at specific times.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["tabs", "activeTab", "storage", "alarms"], "browser_action": {"default_title": "Auto Repost Scheduler", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "@Auto-Repost-Scheduler", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}