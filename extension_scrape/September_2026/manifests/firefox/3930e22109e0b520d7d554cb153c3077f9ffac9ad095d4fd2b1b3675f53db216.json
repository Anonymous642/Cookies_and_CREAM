{"manifest_version": 3, "name": "Rust Player Track \u2014 Pair Helper", "version": "0.1.0", "description": "Bridges the Rust+ login flow on companion-rust.facepunch.com to rustplayertrack.app for server pairing.", "browser_specific_settings": {"gecko": {"id": "rpt-pair-helper@rustplayertrack.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["src/background.js"]}, "permissions": ["tabs"], "host_permissions": ["https://companion-rust.facepunch.com/*", "https://rustplayertrack.app/*", "https://*.rustplayertrack.app/*", "http://localhost:5173/*"], "content_scripts": [{"matches": ["https://companion-rust.facepunch.com/app*"], "js": ["src/facepunch-isolated.js"], "run_at": "document_start"}, {"matches": ["https://rustplayertrack.app/*", "https://*.rustplayertrack.app/*", "http://localhost:5173/*"], "js": ["src/rpt-content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["src/facepunch-main.js"], "matches": ["https://companion-rust.facepunch.com/*"]}]}