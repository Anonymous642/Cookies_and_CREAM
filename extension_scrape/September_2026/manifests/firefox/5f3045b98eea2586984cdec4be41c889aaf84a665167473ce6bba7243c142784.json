{"manifest_version": 3, "name": "Crunchyroll Auto Fullscreen", "version": "1.0", "description": "Firefox extension to automatically trigger window fullscreen on Crunchyroll with an Alt+C failsafe.", "permissions": ["tabs", "storage"], "host_permissions": ["*://*.crunchyroll.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "commands": {"toggle-autofs": {"suggested_key": {"default": "Alt+C"}, "description": "Toggle Auto Fullscreen Failsafe"}}, "browser_specific_settings": {"gecko": {"id": "autofs-crunchyroll-v1@firefox-extension", "data_collection_permissions": {"required": ["none"]}}}}