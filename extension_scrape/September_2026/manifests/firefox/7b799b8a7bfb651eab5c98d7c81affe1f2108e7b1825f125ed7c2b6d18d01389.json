{"manifest_version": 3, "name": "TabMend Workspace", "version": "1.2.9", "description": "Your browser's new command centre \u2014 tab management, focus timer, tasks, and sessions in one workspace.", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["tabs", "bookmarks", "storage", "alarms", "notifications", "history"], "host_permissions": ["https://api.web3forms.com/*", "https://api.lemonsqueezy.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"type": "module", "scripts": ["service-worker-loader.js"]}, "action": {"default_popup": "popup.html", "default_icon": "icon128.png"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "hello@tabmend.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}, "content_scripts": [{"matches": ["https://tabmend.com/*"], "js": ["content-bridge.js"], "run_at": "document_idle"}]}