{"manifest_version": 3, "name": "Twitter Blocker", "description": "Batch block Twitter/X users", "version": "0.3.27", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["cookies", "declarativeNetRequest", "alarms", "notifications", "storage"], "host_permissions": ["https://x.com/*"], "author": "rxliuli", "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "homepage_url": "https://store.rxliuli.com/extensions/twitter-blocker/", "browser_specific_settings": {"gecko": {"id": "twitter-blocker@rxliuli.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content-scripts/quick-block.js"]}]}