{"manifest_version": 2, "name": "Pigment", "description": "Your IDE theme, everywhere. Bring Monokai, Nord, Catppuccin and more to every website.", "version": "1.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["scripting", "storage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "pigment@getpigment.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Pigment", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}