{"manifest_version": 3, "name": "GitHub Repo Downloader", "version": "1.0.0", "description": "Adds a floating Download ZIP button to any GitHub repository page you visit.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://github.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "github-repo-downloader@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}