{"manifest_version": 3, "name": "Focus Guard \u2014 Study Mode", "version": "1.0.0", "description": "Blocks adult content sites and locks YouTube to an approved channel list, with Shorts disabled.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "tabs", "scripting", "webNavigation"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtu.be/*"], "optional_permissions": ["<all_urls>"], "optional_host_permissions": ["*://*.google.com/*", "*://*.google.co.uk/*", "*://*.google.ca/*", "*://*.google.com.au/*", "*://*.google.de/*", "*://*.google.fr/*", "*://*.google.co.in/*", "*://*.google.co.jp/*", "*://*.google.com.br/*", "*://*.google.es/*", "*://*.google.it/*", "*://*.google.nl/*", "*://*.bing.com/*", "*://*.search.yahoo.com/*", "*://*.duckduckgo.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "declarative_net_request": {"rule_resources": [{"id": "adult_static_1", "enabled": true, "path": "rules/adult-blocklist-0.json"}, {"id": "adult_static_2", "enabled": true, "path": "rules/adult-blocklist-1.json"}, {"id": "adult_tlds", "enabled": true, "path": "rules/adult-tlds.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-scripts/youtube.js"], "css": ["content-scripts/youtube.css"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "focus-guard@studytools.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}