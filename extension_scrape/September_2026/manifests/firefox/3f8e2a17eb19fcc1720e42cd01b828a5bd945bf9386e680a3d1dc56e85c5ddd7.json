{"manifest_version": 2, "name": "Job Clipper", "version": "1.0.0", "description": "Extract job postings from LinkedIn, Indeed, and other job sites into markdown format for career-agent", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-48.svg"}, "permissions": ["activeTab", "clipboardWrite"], "browser_action": {"default_icon": {"48": "icons/icon-48.svg"}, "default_title": "Job Clipper", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*", "*://*.indeed.com/*", "*://boards.greenhouse.io/*", "*://jobs.lever.co/*"], "js": ["content-scripts/extractors/base.js", "content-scripts/extractors/linkedin.js", "content-scripts/extractors/indeed.js", "content-scripts/extractors/greenhouse.js", "content-scripts/extractors/lever.js", "content-scripts/extractors/generic.js", "content-scripts/detector.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "job-clipper@career-agent", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}