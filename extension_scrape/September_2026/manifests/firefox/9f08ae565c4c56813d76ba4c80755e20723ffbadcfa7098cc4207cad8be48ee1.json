{"manifest_version": 3, "name": "Twigest \u2014 Twitter Monitor & Daily Digest", "short_name": "Twigest", "version": "1.0.0", "description": "Track X/Twitter accounts from your browser. AI-written daily digest of their posts, delivered to your inbox.", "homepage_url": "https://twigest.com", "author": "Twigest", "browser_specific_settings": {"gecko": {"id": "extension@twigest.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Twigest", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"]}