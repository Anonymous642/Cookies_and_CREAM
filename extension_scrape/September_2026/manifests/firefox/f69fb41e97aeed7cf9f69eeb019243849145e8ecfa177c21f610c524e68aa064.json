{"manifest_version": 3, "name": "AI Content Detector", "version": "0.1.0", "description": "Classifies whether the current page or media appears AI-related.", "action": {"default_title": "Analyze current page", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [], "permissions": ["activeTab", "scripting", "storage"], "optional_permissions": ["tabCapture"], "browser_specific_settings": {"gecko": {"id": "ai-content-detector@beav-hacks", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "host_permissions": ["http://localhost:8000/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}