{"manifest_version": 3, "name": "Kimai Time Tracker", "description": "Track time with Kimai directly from any web page", "version": "0.1.22", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "alarms"], "host_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "kimai-bp@lakedrops.com", "strict_min_version": "145.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Kimai Time Tracker", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}