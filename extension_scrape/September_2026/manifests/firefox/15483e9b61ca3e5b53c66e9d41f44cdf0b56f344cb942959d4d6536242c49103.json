{"manifest_version": 2, "name": "RockPaperSimmer Companion", "version": "1.0", "description": "Detects recipes on web pages and allows sending them to Rock Paper Simmer", "permissions": ["activeTab", "tabs", "webRequest", "webRequestBlocking", "webNavigation", "storage", "https://rockpapersimmer.com/*", "*://localhost:8443/*", "*://127.0.0.1:8443/*", "*://192.168.1.93:8443/*"], "browser_action": {"default_icon": "icons/rps-3.svg", "default_title": "RockPaperSimmer Companion", "default_popup": "popup.html", "browser_style": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": ["fonts/ShortStack-Regular.ttf", "fonts/Podkova-VariableFont_wght.ttf", "styles.css"], "browser_specific_settings": {"gecko": {"id": "rockpapersimmer-companion@rockpapersimmer.com"}}}