{"manifest_version": 3, "name": "slopfilter", "version": "0.1.0", "description": "Dims low-quality, content-farm search results. Local heuristics, always reversible in one click.", "permissions": ["storage", "alarms"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "slopfilter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.google.com/search*", "*://www.google.co.uk/search*", "*://www.google.ca/search*", "*://www.google.com.au/search*", "*://www.google.de/search*", "*://www.google.fr/search*", "*://www.google.es/search*", "*://www.google.it/search*", "*://www.google.nl/search*", "*://www.google.co.jp/search*", "*://www.google.co.kr/search*", "*://www.google.co.in/search*", "*://www.google.com.br/search*", "*://www.bing.com/search*", "*://duckduckgo.com/*"], "js": ["content/engines.js", "content/score.js", "content/treatment.js", "content/report.js", "content/inspect.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["data/*.json"], "matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.ca/*", "*://www.google.com.au/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.co.jp/*", "*://www.google.co.kr/*", "*://www.google.co.in/*", "*://www.google.com.br/*", "*://www.bing.com/*", "*://duckduckgo.com/*"]}], "browser_specific_settings": {"gecko": {"id": "slopfilter@slopfilter.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}