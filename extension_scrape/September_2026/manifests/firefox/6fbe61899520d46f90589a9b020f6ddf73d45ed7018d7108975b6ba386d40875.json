{"manifest_version": 3, "name": "Pixiv Exporter", "description": "Back up your pixiv works, bookmarks, following and more \u2014 local, private, one-time purchase.", "version": "0.0.7", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "notifications", "idle", "cookies"], "host_permissions": ["*://*.pixiv.net/*", "https://i.pximg.net/*", "https://store.rxliuli.com/*"], "author": "rxliuli", "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}, "homepage_url": "https://rxliuli.com/project/pixiv-exporter", "browser_specific_settings": {"gecko": {"id": "pixiv-exporter@rxliuli.com", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.pixiv.net/*"], "js": ["content-scripts/content.js"]}]}