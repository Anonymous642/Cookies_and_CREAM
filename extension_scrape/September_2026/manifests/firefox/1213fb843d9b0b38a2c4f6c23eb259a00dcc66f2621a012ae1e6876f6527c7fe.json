{"manifest_version": 3, "name": "FactRadar", "version": "2.0", "description": "Automatically check the reliability of web pages, news and emails with AI.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://truthcheck-ai-production.up.railway.app/*", "*://mail.google.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["translations.js", "content.js"]}], "browser_specific_settings": {"gecko": {"id": "factradar@factradar.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}