{"manifest_version": 2, "name": "Unacademy Reload Blocker (v1)", "version": "1.0", "description": "Blocks auto reloads on Unacademy and restores colour after network reconnect.", "browser_specific_settings": {"gecko": {"id": "unacademy-reload-blocker-v1@local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon48.png"}, "content_scripts": [{"matches": ["*://*.unacademy.com/*"], "js": ["content.js"], "run_at": "document_start"}]}