{"manifest_version": 2, "name": "Clipboard Protector", "version": "1.3", "description": "Protects users from malicious clipboard hijacking by monitoring and warning about suspicious clipboard changes.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["clipboardRead", "clipboardWrite", "notifications", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Clipboard Protector", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Clipboard-Protector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}