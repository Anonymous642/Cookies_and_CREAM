{"manifest_version": 3, "name": "PulseChain Site Checker", "version": "3.1.0", "description": "Verify PulseChain sites, spot lookalike impersonators, track IPFS deploys, and check any link or CID against the signed list.", "permissions": ["tabs", "storage", "notifications", "alarms"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open PulseChain Site Checker"}}, "action": {"default_popup": "popup.html", "default_icon": {"32": "images/icon_grey32.png", "48": "images/icon_grey48.png", "128": "images/icon_grey128.png"}}, "icons": {"32": "images/icon_green32.png", "48": "images/icon_green48.png", "128": "images/icon_green128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "poseidon@pulsechain", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}