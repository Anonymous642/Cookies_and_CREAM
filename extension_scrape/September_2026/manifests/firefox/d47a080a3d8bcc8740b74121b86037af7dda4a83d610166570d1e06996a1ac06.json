{"manifest_version": 3, "name": "GPTimizer", "version": "1.0.3", "browser_specific_settings": {"gecko": {"id": "ceo@arctic3d.xyz", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "description": "Optimizes ChatGPT long chats by collapsing old messages and lazy-loading heavy content.", "icons": {"32": "gptimizer_32.png", "48": "gptimizer_48.png", "128": "gptimizer_128.png", "256": "gptimizer_256.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "options_page": "options.html"}