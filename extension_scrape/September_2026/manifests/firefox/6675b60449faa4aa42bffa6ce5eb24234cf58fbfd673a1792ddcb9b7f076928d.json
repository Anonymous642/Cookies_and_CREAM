{"manifest_version": 2, "name": "Timodesk URL Tracker", "version": "1.0.0", "description": "Track active tab URL and send to a local Timodesk app.", "permissions": ["tabs", "storage", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Timodesk URL Tracker", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "timodesk-url-tracker@timodesk.com", "data_collection_permissions": {"required": ["browsingActivity"]}}}}