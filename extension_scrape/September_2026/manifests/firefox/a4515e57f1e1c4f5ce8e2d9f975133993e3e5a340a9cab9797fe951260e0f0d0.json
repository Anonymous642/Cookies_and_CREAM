{"manifest_version": 3, "name": "NewsRadar - Search and monitor real-time news", "version": "1.0.0", "description": "Search and monitor real-time news on any topic while you browse \u2014 select text, right-click, or click the toolbar icon.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "newsdata-news-search@newsdata.io", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "searchTerms"], "optional": ["websiteContent"]}}}, "action": {"default_title": "NewsRadar \u2014 Search news", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["polyfill.js", "src/background.js"]}, "permissions": ["storage", "notifications", "contextMenus", "alarms", "activeTab", "tabs", "scripting"], "host_permissions": ["*://newsdata.io/*"], "options_ui": {"page": "src/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["polyfill.js", "src/newsdata-data.js", "src/nd-shared.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/content.css", "icons/*", "assets/*"], "matches": ["<all_urls>"]}]}