{"manifest_version": 3, "name": "Twitch Tab Manager", "description": "Opens followed Twitch channels when live, avoids duplicates, and closes manager-opened tabs when streams end.", "version": "1.0.14.12", "action": {"default_popup": "popup.html", "default_title": "Twitch Tab Manager", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "192": "icons/icon192.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["config.json", "follows.txt", "bg/stability.js"], "matches": ["*://*/*"]}], "permissions": ["tabs", "storage", "alarms", "scripting", "downloads", "cookies", "notifications"], "host_permissions": ["*://www.twitch.tv/*", "*://twitch.tv/*", "*://api.twitch.tv/*", "*://id.twitch.tv/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "twitch-tab-manager@drache.uk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "homepage_url": "https://github.com/drachescript/Twitch-Tab-Manager", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "192": "icons/icon192.png"}}