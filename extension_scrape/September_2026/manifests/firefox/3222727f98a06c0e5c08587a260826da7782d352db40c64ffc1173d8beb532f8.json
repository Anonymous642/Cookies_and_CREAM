{"manifest_version": 2, "name": "BibClick \u2014 One-click paper citations", "description": "Add ready-to-paste citations (BibTeX, RIS, APA, MLA\u2026) to paper pages on Google Scholar, arXiv, Springer, Elsevier, IEEE & more.", "version": "2.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "<all_urls>", "https://api.crossref.org/*"], "browser_specific_settings": {"gecko": {"id": "bib-click@bib-click.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "BibClick settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}