{"manifest_version": 3, "name": "CodeSynapse", "version": "2.0", "description": "Track solved problems by rating and date, and automatically sync your accepted Codeforces solutions to a GitHub repository.", "permissions": ["storage"], "host_permissions": ["https://codeforces.com/*", "https://api.github.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon64.png", "128": "img/icon128.png"}, "content_scripts": [{"matches": ["https://codeforces.com/*"], "js": ["libs/chart.umd.min.js", "libs/chartjs-plugin-datalabels.min.js", "content.js"]}], "browser_specific_settings": {"gecko": {"id": "codesynapse@outlook.com"}}, "web_accessible_resources": [{"resources": ["icon.png"], "matches": ["<all_urls>"]}]}