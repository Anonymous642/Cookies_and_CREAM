{"manifest_version": 3, "name": "Ana's English Hub Helper", "version": "1.2.0", "description": "Save vocabulary and study materials (articles, videos) to Ana's English Hub directly from the web.", "permissions": ["contextMenus", "activeTab", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_title": "Ana's English Hub"}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "helper@anasenglishub.com.br", "strict_min_version": "115.0"}}, "icons": {"16": "logo-16.png", "48": "logo-48.png", "128": "logo-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}