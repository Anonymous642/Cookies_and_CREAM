{"manifest_version": 3, "name": "Serica AI Assistant", "version": "1.0", "description": "Your AI companion - text selection tools, work mode, ad blocking, and more.", "browser_specific_settings": {"gecko": {"id": "ournameai@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "description": "This extension processes user-selected text via SiliconFlow API to provide AI text analysis functionality. No data is stored locally or shared with third parties beyond the necessary API call."}}}, "permissions": ["activeTab", "storage", "contextMenus", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["https://api.siliconflow.cn/*", "<all_urls>"], "declarative_net_request": {"rule_resources": [{"id": "adblock_rules", "enabled": true, "path": "modules/adblock/rules/rules.json"}]}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "all_frames": false, "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "static/img/Q-Style.png", "48": "static/img/Q-Style.png", "128": "static/img/Q-Style.png", "256": "static/img/Q-Style.png"}}, "icons": {"16": "static/img/Q-Style.png", "48": "static/img/Q-Style.png", "128": "static/img/Q-Style.png", "256": "static/img/Q-Style.png"}, "web_accessible_resources": [{"resources": ["static/Animation/*", "static/img/*", "static/img/\u5510\u8bd7/\u5510\u8bd7/*", "modules/adblock/*"], "matches": ["<all_urls>"]}]}