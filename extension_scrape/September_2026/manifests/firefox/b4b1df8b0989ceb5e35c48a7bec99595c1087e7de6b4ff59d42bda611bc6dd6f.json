{"manifest_version": 2, "name": "Genius Spotify Now Playing", "version": "1.0.1", "description": "Spotify now playing widget for Genius.com to easily access the currently playing song's lyrics page", "icons": {"128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "{154d36bb-6f75-4a74-a58a-e086e2b946ec}", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "permissions": ["storage", "tabs", "alarms", "https://genius.com/*", "https://accounts.spotify.com/*", "https://api.spotify.com/*", "https://api.genius.com/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://genius.com/*", "https://www.genius.com/*"], "js": ["myscript.bundle.js"], "css": ["src/style.css"], "run_at": "document_end"}], "web_accessible_resources": ["icon.png", "src/style.css", "myscript.bundle.js"]}