{"manifest_version": 3, "name": "Tab Suspender", "version": "1.1.0", "description": "Auto-suspends inactive tabs to save RAM. Pairs well with Focus Berry's tab tracking.", "permissions": ["tabs", "storage", "alarms", "management", "idle"], "host_permissions": ["https://addons.mozilla.org/*"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon16.svg", "32": "icons/icon32.svg", "48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "default_title": "Tab Suspender", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.svg", "32": "icons/icon32.svg", "48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tab-suspender@devvyy.xyz", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}