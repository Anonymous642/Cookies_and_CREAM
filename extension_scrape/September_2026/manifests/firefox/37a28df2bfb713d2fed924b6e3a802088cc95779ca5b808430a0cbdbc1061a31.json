{"manifest_version": 3, "name": "Simpplr One Redirector", "version": "1.0.10", "description": "Redirects Simpplr Classic URLs to Simpplr One URLs automatically", "permissions": ["storage", "webNavigation"], "host_permissions": ["https://*.vf.force.com/*", "https://*.visualforce.com/*", "https://*/setup-simpplr-redirector*", "https://*.app.simpplr.com/*", "https://*.simpplr.dev/*"], "background": {"scripts": ["js/background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Simpplr One Redirector", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["https://*/*"]}], "content_scripts": [{"matches": ["https://*/setup-simpplr-redirector*", "https://*.app.simpplr.com/*", "https://*.simpplr.dev/*"], "js": ["js/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "simpplr-one-redirector@simpplr.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}