{"manifest_version": 2, "name": "Picture-in-Picture Anywhere", "version": "1.0.0", "description": "Xem video \u1edf ch\u1ebf \u0111\u1ed9 Picture-in-Picture tr\u00ean m\u1ecdi trang web (YouTube, Facebook, v.v.)", "permissions": ["activeTab", "tabs", "<all_urls>"], "browser_action": {"default_title": "B\u1eadt Picture-in-Picture (Alt+P)", "default_icon": "image.png"}, "icons": {"16": "image.png", "48": "image.png", "128": "image.png"}, "commands": {"toggle-pip": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "B\u1eadt/t\u1eaft Picture-in-Picture"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "pip-anywhere@your-domain.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}