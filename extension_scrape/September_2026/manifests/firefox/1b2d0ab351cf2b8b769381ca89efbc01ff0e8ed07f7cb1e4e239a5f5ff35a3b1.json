{"manifest_version": 3, "name": "Linkitab", "version": "0.6.0", "description": "A fast and private new tab page: link collections, tab sessions and search through the default Firefox engine. Also becomes your home page.", "author": "4541ae@gmail.com", "browser_specific_settings": {"gecko": {"id": "linkitab@4541ae.gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "activeTab", "menus"], "optional_permissions": ["tabs", "search"], "background": {"scripts": ["js/background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Linkitab", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"homepage": "newtab.html"}}