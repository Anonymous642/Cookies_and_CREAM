{"manifest_version": 2, "name": "OpenFray Importer", "description": "A browser extension that scrapes a D&D Beyond monster page and outputs OpenFray Creature JSON.", "version": "1.0.1", "icons": {"16": "icon/16.png", "19": "icon/19.png", "38": "icon/38.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "info@openfray.app", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "OpenFray Importer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.dndbeyond.com/*"], "js": ["content-scripts/content.js"]}]}