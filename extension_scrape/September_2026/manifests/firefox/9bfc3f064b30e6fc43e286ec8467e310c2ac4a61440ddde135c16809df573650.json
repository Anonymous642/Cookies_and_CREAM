{"manifest_version": 3, "name": "FormBhar Assistant", "version": "1.0.9", "description": "Auto fill government forms using your formbhar.com profile", "browser_specific_settings": {"gecko": {"id": "assistant@formbhar.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup/popup.html", "default_title": "FormBhar"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "externally_connectable": {"matches": ["https://formbhar.com/*", "http://localhost:4200/*"]}, "background": {"scripts": ["config.js", "utils/docKeyMapper.js", "background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/floating-button.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["config.js", "popup/popup.html", "popup/popup.js", "content/content.js", "content/floating-button.css"], "matches": ["<all_urls>"]}]}