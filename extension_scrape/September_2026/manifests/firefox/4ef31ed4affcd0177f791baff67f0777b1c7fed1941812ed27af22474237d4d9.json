{"manifest_version": 3, "name": "Reload Timer", "version": "1.0.0", "description": "Reload one selected Firefox tab on a user-set interval for a limited number of times.", "icons": {"64": "assets/icon.svg"}, "action": {"default_title": "Reload Timer", "default_popup": "popup/popup.html", "default_icon": "assets/icon.svg"}, "background": {"scripts": ["shared/timerModel.js", "background.js"]}, "permissions": ["alarms", "storage"], "browser_specific_settings": {"gecko": {"id": "reloadtimer@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}