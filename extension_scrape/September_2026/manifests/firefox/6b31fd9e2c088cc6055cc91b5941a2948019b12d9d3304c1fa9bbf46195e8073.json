{"manifest_version": 2, "name": "Dev Exporter \u2014 federicocalo.dev", "description": "Esporta le chat con ChatGPT, Claude e Gemini in Markdown, JSON o ZIP (ogni code-block come file). Offline, zero telemetria.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["activeTab", "scripting", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "browser_specific_settings": {"gecko": {"id": "dev-exporter@federicocalo.dev", "strict_min_version": "109.0"}}, "data_collection_permissions": {"required": ["none"]}, "browser_action": {"default_title": "Dev Exporter", "default_popup": "popup.html"}}