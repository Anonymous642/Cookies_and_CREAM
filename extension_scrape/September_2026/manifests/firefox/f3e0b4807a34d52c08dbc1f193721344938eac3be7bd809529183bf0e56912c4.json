{"manifest_version": 2, "name": "YouTube URL Cleaner", "version": "1.0", "description": "Remove unnecessary timestamps & user unfriendly codes from links within YouTube.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["cleanurl.js"]}], "browser_specific_settings": {"gecko": {"id": "@yt-URL-cleaner", "data_collection_permissions": {"required": ["none"]}}}}