{"manifest_version": 2, "name": "Ultimate QR Code", "version": "1.0.2.0", "description": "Generate a QR code from any text or the current page, with selectable error-correction levels and PNG download. Right-click selected text or the page to make a QR, or right-click an image to read one.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{8814dbff-b3ff-4117-b980-218b2bb3efbd}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "activeTab", "tabs", "notifications", "<all_urls>"], "background": {"scripts": ["src/qrcode.js", "src/background.js"]}, "browser_action": {"default_title": "Ultimate QR Code", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}