{"manifest_version": 2, "name": "Tab Grab", "description": "Copy URLs from multiple tabs at once", "version": "1.5.0", "icons": {"32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "tab-grab@thestoneroller.com"}}, "content_security_policy": "script-src 'self'; object-src 'self'", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "TabGrab", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}}