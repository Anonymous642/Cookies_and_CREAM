{"manifest_version": 2, "name": "x4doubt", "description": "Fact-check content and claims on any webpage", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "storage", "cookies", "contextMenus", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "x4doubt@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Fact Checker", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}