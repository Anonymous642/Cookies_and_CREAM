{"manifest_version": 2, "name": "Passages", "description": "Save articles to your Passages reading list", "version": "0.0.13", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "tabs", "https://www.passages.ink/*"], "browser_specific_settings": {"gecko": {"id": "passages@passages.ink", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Passages", "default_popup": "popup.html"}}