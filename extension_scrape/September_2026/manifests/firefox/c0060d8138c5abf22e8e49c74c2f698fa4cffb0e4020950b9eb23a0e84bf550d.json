{"manifest_version": 2, "name": "Proso", "description": "Text-to-speech for web pages with word-level highlighting", "version": "1.2.14", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "contextMenus", "scripting", "downloads"], "optional_permissions": ["http://*/*", "https://*/*"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';", "commands": {"playback-toggle": {"suggested_key": {"default": "Alt+P"}, "description": "Play/Pause"}, "playback-stop": {"suggested_key": {"default": "Alt+S"}, "description": "Stop"}, "playback-next": {"suggested_key": {"default": "Alt+Period"}, "description": "Next paragraph"}, "playback-previous": {"suggested_key": {"default": "Alt+Comma"}, "description": "Previous paragraph"}}, "browser_specific_settings": {"gecko": {"id": "{41eb66cb-b520-4047-9b6c-63fdce6fca11}", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["authenticationInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Proso", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}