{"manifest_version": 3, "name": "Link to Highlight", "version": "1.0.0", "description": "Select text, right-click, and copy a link that scrolls to and highlights that exact passage when opened.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["contextMenus", "activeTab", "scripting", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "link-to-highlight@example.local", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}