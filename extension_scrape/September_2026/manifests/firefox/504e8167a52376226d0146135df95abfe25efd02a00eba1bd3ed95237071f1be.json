{"manifest_version": 3, "name": "Vyzync", "description": "Watch video together with up to eight people. Keep play, pause, seeking, and speed in sync.", "version": "0.4.1", "short_name": "Vyzync", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"], "optional_host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Vyzync", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "vyzync@jubjub-cpu.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}