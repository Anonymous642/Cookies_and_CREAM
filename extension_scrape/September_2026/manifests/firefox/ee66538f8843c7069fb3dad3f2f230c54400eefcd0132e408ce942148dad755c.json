{"manifest_version": 3, "name": "Toolship: Browser Toolkit for DEV & QA", "short_name": "Toolship", "version": "0.11", "homepage_url": "https://utilsware.com/products/toolship", "author": "Shridhar TL", "description": "Dynamically manage HTTP/HTTPS requests, browser tabs, and storage using rule-based filters and actions.", "icons": {"24": "icons/icon_24.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "action": {"default_icon": {"24": "icons/icon_24.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "default_title": "Toolship", "default_popup": "popup.html"}, "sidebar_action": {"default_title": "Bug Recorder", "default_panel": "firefox-sidebar.html", "default_icon": {"24": "icons/icon_24.png", "48": "icons/icon_48.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "permissions": ["declarativeNetRequest", "webRequest", "tabs", "scripting", "alarms", "contextMenus", "downloads"], "host_permissions": ["<all_urls>"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture visible area screenshot"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Capture selected region screenshot"}, "extract-tables": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Extract tables from current page"}, "measure-ruler": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Activate measure/ruler tool"}}, "options_ui": {"page": "index.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "toolship@shridhar", "strict_min_version": "130.0", "data_collection_permissions": {"required": ["none"]}}}}