{"manifest_version": 3, "name": "Job Tracker - LinkedIn & Naukri Saver", "version": "1.0.0", "description": "Save jobs from LinkedIn & Naukri with one click. Track applications, export to CSV. Free job tracker for job seekers.", "author": "Sudanshu", "icons": {"16": "assets/icons/icon-16.svg", "48": "assets/icons/icon-48.svg", "96": "assets/icons/icon-96.svg"}, "permissions": ["activeTab", "storage", "notifications"], "host_permissions": ["*://*.linkedin.com/*", "*://*.naukri.com/*"], "background": {"scripts": ["src/background/background.js"]}, "action": {"default_icon": {"16": "assets/icons/icon-16.svg", "48": "assets/icons/icon-48.svg", "96": "assets/icons/icon-96.svg"}, "default_title": "Job Application Tracker", "default_popup": "src/popup/popup.html"}, "content_scripts": [{"matches": ["*://*.linkedin.com/jobs/*"], "js": ["src/content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["*://*.naukri.com/*job*"], "js": ["src/content/naukri.js"], "run_at": "document_idle"}], "options_ui": {"page": "src/settings/settings.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "job-tracker@Sudanshu.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["*://*.linkedin.com/*", "*://*.naukri.com/*"]}]}