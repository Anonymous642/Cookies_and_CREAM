{"manifest_version": 3, "name": "YouTube Force SBS (Raw 3D)", "version": "1.0", "description": "Adds a button to force 3D videos to play in raw Side-by-Side mode.", "permissions": ["scripting"], "host_permissions": ["*://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "yt-force-sbs@exxttender.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://www.youtube.com/*"]}]}