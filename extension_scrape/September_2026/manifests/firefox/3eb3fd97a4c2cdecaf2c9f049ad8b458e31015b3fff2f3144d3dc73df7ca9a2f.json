{"manifest_version": 3, "name": "Goal-Oriented Browser Mode", "version": "1.3", "description": "Helps users stay focused on browsing goals by monitoring browsing context and providing intelligent focus reminders.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["goalEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "action": {"default_popup": "popup.html", "default_title": "Goal-Oriented Browser Mode"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Goal-Oriented-Browser-Mode", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}