{"manifest_version": 3, "name": "WOT Recruiter", "version": "1.1.2", "description": "Automates sending clan invites on eu.wargaming.net for World of Tanks recruiters.", "permissions": ["cookies"], "host_permissions": ["https://*.wargaming.net/*", "https://wot-recruiter.site/*"], "content_scripts": [{"matches": ["https://wot-recruiter.site/*"], "js": ["content.js"], "run_at": "document_start"}], "icons": {"16": "icon16.png", "32": "icon32.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "128": "icon128.png"}}, "background": {"scripts": ["index.js"]}, "browser_specific_settings": {"gecko": {"id": "wot-recruiter@wot-recruiter.site", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}