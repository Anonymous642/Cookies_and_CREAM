{"manifest_version": 3, "name": "Reverb.ai", "version": "1.3", "description": "Summarise Echo360 lecture recordings and link them to your notes", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Reverb.ai", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "reverb-ai@reverb-ai3.vercel.app", "strict_min_version": "128.0"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://echo360.org.au/*", "https://echo360.org/*", "https://echo360.org.uk/*", "https://*.echo360.org.au/*", "https://*.echo360.org.uk/*"]}]}