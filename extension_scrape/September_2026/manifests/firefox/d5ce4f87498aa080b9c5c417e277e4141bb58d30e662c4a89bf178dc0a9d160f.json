{"manifest_version": 3, "name": "Maelsaurus Google Switcher", "version": "1.7", "description": "Easily switch, lock, and manage multiple Google accounts.", "permissions": ["tabs", "activeTab", "storage", "scripting", "cookies"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "google-account-switcher@antigravity.ai", "data_collection_permissions": {"required": ["none"]}}}}