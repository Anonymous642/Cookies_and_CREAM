{"manifest_version": 3, "name": "ZLR - Dual Subtitles", "version": "2.2.7", "description": "Ultra-fast dual subtitles and real-time translation for YouTube videos.", "author": "Mervan", "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://translate.googleapis.com/*", "*://api-free.deepl.com/*", "*://api.deepl.com/*"], "icons": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "96": "icons/icon.svg", "128": "icons/icon-128.svg"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/translation-cache.js", "content/spa-observer.js", "content/google-gtx-translator.js", "content/deepl-translator.js", "content/subtitle-renderer.js", "content/youtube-adapter.js", "content/content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "ZLR Settings", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg"}}, "browser_specific_settings": {"gecko": {"id": "zlr@mervan.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}