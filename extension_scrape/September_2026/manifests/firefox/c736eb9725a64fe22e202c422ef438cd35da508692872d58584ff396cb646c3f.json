{"manifest_version": 2, "name": "Auto Scroll", "version": "1.2.0", "description": "Rolagem autom\u00e1tica com atalhos, dire\u00e7\u00e3o, overlay e velocidade persistente.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-scroll": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Iniciar/Parar rolagem"}, "speed-up": {"suggested_key": {"default": "Alt+Shift+Up"}, "description": "Aumentar velocidade"}, "speed-down": {"suggested_key": {"default": "Alt+Shift+Down"}, "description": "Diminuir velocidade"}, "reverse-direction": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Inverter dire\u00e7\u00e3o (subir/descer)"}, "reset": {"suggested_key": {"default": "Alt+Shift+0"}, "description": "Resetar velocidade/dire\u00e7\u00e3o"}}, "browser_specific_settings": {"gecko": {"id": "auto-scroll-tunado@jessedorta", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}