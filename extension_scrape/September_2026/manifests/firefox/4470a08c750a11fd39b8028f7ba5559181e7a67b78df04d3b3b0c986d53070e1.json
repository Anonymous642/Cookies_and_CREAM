{"manifest_version": 2, "name": "Camaxli", "version": "1.0", "description": "Camaxli - Token manager with mass checker, instant validation, and account saver.", "icons": {"128": "logo.png"}, "permissions": ["storage", "tabs", "cookies", "<all_urls>", "https://discord.com/*"], "browser_specific_settings": {"gecko": {"id": "camaxli@localhost", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}, "browser_action": {"default_icon": "logo.png", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_start"}]}