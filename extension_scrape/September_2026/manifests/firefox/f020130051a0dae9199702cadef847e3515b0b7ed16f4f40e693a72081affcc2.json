{"manifest_version": 2, "name": "Markdown Viewer Pro", "version": "1.0.0", "description": "Full-featured markdown renderer. View .md files with syntax highlighting, dark/light themes, table of contents, and more. Works on local and web-hosted markdown files.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'", "permissions": ["file:///*", "storage", "activeTab", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "markdown-viewer-pro@extension", "strict_min_version": "149.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["file:///*", "*://*/*.md", "*://*/*.markdown", "*://*/*.mdown", "*://*/*.mkd", "*://*/*.mkdn"], "js": ["lib/marked.min.js", "lib/highlight.min.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_end", "all_frames": false}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}, "default_title": "Markdown Viewer Pro"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "web_accessible_resources": ["lib/*"]}