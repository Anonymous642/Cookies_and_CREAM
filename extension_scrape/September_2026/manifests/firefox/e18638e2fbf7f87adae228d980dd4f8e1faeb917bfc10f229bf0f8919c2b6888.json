{"manifest_version": 3, "name": "Twitter link VXER", "version": "1.1", "description": "Copy the current Twitter/X link and convert it to a VX link.", "permissions": ["contextMenus", "activeTab", "notifications", "clipboardWrite"], "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "twitterlinkvxer@example.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "content_scripts": [{"matches": ["https://twitter.com/*", "https://*.twitter.com/*", "https://x.com/*", "https://*.x.com/*", "https://bsky.app/*", "https://*.bsky.app/*"], "js": ["content.js"]}]}