{"manifest_version": 3, "name": "Deplexity", "version": "1.0.2", "description": "Bypass Perplexity's forced phone verification.", "permissions": ["declarativeNetRequest"], "host_permissions": ["*://www.perplexity.ai/*"], "action": {"default_icon": "icons/icon.svg"}, "web_accessible_resources": [{"resources": ["icons/icon.svg"], "matches": ["*://www.perplexity.ai/*"]}], "browser_specific_settings": {"gecko": {"id": "deplexity@aviqtl.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.perplexity.ai/*"], "js": ["content.js"], "run_at": "document_start"}]}