{"manifest_version": 3, "name": "Classroom Remote", "version": "0.1.1", "description": "Synchronizes one dedicated lesson tab across explicitly enrolled classroom computers.", "permissions": ["storage", "alarms"], "background": {"scripts": ["service-worker.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://classroom-remote-worker.kysliakov.workers.dev/*"], "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}, "browser_specific_settings": {"gecko": {"id": "classroom-remote@itnauka.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}