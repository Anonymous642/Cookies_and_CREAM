{"manifest_version": 2, "name": "Universal Video Downloader", "version": "1.0.5", "description": "Detects downloadable video sources across pages, frames, playlists, and dynamic players, then saves them to Firefox's download folder.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["<all_urls>", "activeTab", "downloads", "storage", "tabs", "webRequest"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Universal Video Downloader", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["lib/ebml.browser.js", "lib/mp4box.browser.js", "lib/fix-webm-duration.browser.js", "content-script.js"]}], "browser_specific_settings": {"gecko": {"id": "universal-video-downloader@example.local", "data_collection_permissions": {"required": ["none"]}}}}