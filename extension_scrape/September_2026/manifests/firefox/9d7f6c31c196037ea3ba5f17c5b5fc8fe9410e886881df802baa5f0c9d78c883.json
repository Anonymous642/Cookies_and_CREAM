{"manifest_version": 3, "name": "SocialKit for W", "short_name": "SocialKit", "version": "1.0.6", "version_name": "1.0.6", "description": "A privacy-first W toolkit for Firefox: circles, discovery, profile context, AT Protocol identity, saved posts and reading tools.", "permissions": ["storage", "alarms"], "optional_permissions": ["notifications"], "host_permissions": ["https://public.api.bsky.app/*", "https://plc.directory/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "SocialKit for W", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "content_scripts": [{"matches": ["https://wsocial.eu/*", "https://www.wsocial.eu/*"], "js": ["modules/circle/src/w-adapter.js", "modules/circle/src/content.js", "modules/translate/countries.js", "modules/translate/origin-utils.js", "modules/translate/content.js", "modules/lens/src/content.js"], "css": ["modules/circle/content.css", "modules/translate/content.css", "modules/lens/content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none';"}, "incognito": "not_allowed", "sidebar_action": {"default_title": "SocialKit for W", "default_panel": "sidepanel.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png"}, "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "socialkit-for-w@christophermccabe.ie", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo", "personalCommunications", "locationInfo", "searchTerms", "websiteContent"]}}}}