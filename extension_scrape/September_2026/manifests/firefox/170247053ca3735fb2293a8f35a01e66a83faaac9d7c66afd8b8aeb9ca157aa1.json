{"manifest_version": 2, "name": "Cevize", "description": "Save job postings and create tailored resumes with AI \u2014 right from your browser sidebar.", "version": "0.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@cevize.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["scripting", "storage", "cookies", "tabs", "<all_urls>"], "web_accessible_resources": ["icon/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Cevize", "default_popup": "popup.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Cevize"}, "content_scripts": [{"matches": ["http://localhost:3001/*", "https://cevize.com/*"], "run_at": "document_idle", "js": ["content-scripts/app-presence.js"]}]}