{"manifest_version": 2, "name": "RandomBookmark", "version": "1.0", "description": "Opens a random bookmark from bookmark folder.", "icons": {"48": "icons/rando_icon.png"}, "permissions": ["activeTab", "bookmarks", "tabs"], "browser_specific_settings": {"gecko": {"id": "randombookmark@local", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_icon": "icons/rando_icon.png", "default_title": "RandomBookmark", "default_popup": "popup.html"}}