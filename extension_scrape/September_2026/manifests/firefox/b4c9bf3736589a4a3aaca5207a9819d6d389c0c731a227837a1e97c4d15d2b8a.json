{"manifest_version": 3, "name": "URL Saver", "version": "1.0", "description": "Save your current tab's URL with a title into a list you can view and copy later.", "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "permissions": ["tabs", "storage"], "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "url-saver@example.com", "strict_min_version": "109.0"}}}