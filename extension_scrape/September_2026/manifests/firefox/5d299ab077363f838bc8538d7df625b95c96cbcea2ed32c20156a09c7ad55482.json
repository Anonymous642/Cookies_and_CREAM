{"manifest_version": 2, "name": "Tab Group Manager", "version": "1.1", "description": "Organize, save, and switch between tab groups with powerful management features", "permissions": ["tabs", "storage", "downloads", "tabHide"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tabgroupmanager@adrieng.ch"}}, "browser_action": {"default_title": "Tab Group Manager", "default_popup": "popup/popup.html"}, "commands": {"save-current-tabs": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Save current tabs as a new group"}, "quick-switch": {"suggested_key": {"default": "Ctrl+Shift+Q"}, "description": "Open quick switch panel"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": ["prompt-tab.html"]}