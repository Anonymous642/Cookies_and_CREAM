{"manifest_version": 2, "name": "Gloss \u2014 Your web, annotated & shared.", "description": "Your personal knowledge layer for the internet. Highlight, note, and draw on any page \u2014 then share your screen live.", "version": "1.4.2", "icons": {"16": "/icons/icon16.png", "32": "/icons/icon48.png", "48": "/icons/icon48.png", "128": "/icons/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "notifications", "downloads", "<all_urls>"], "options_ui": {"page": "/dashboard.html", "open_in_tab": true}, "web_accessible_resources": ["icons/*"], "commands": {"toggle-annotation-mode": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Toggle annotation mode on the current page"}, "quick-note": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Create a quick note on the current page"}, "open-dashboard": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Open the Gloss dashboard"}}, "browser_specific_settings": {"gecko": {"id": "gloss@web-annotation.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Gloss", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}