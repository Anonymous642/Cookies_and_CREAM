{"manifest_version": 3, "name": "MiniMood Movie Picker", "description": "Instantly discover films matching your current mood for a personalized and effortless streaming experience.", "version": "1.0.0", "author": "CineSolutions", "permissions": ["storage", "activeTab"], "host_permissions": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.primevideo.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "minimoodmoviepicker@cinesolutions.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}