{"manifest_version": 3, "name": "DayFlow", "version": "1.0.0", "description": "A minimal kanban to-do board on every new tab, synced across all your open tabs.", "icons": {"16": "favicon/favicon-16x16.png", "48": "favicon/favicon-48x48.png", "128": "favicon/favicon-128x128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage"], "host_permissions": ["https://ipwho.is/*", "https://get.geojs.io/*", "https://api.open-meteo.com/*"], "browser_specific_settings": {"gecko": {"id": "dayflow@todo", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo"]}}}}