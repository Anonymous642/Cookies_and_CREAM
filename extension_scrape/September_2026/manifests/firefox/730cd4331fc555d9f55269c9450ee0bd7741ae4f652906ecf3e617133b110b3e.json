{"manifest_version": 3, "name": "Tabber Browser Bridge", "version": "1.5.1", "description": "Connects your browser tabs to the Tabber Alt-Tab switcher.", "permissions": ["tabs", "nativeMessaging", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "tabber@spookyfish.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}