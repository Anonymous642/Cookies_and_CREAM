{"manifest_version": 3, "name": "ZitaVita - Earn from Your Browsing", "version": "1.0.1", "description": "Turn your browsing data into earnings. Control your data, get paid for sharing it.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png"}, "default_title": "ZitaVita Earnings"}, "background": {"scripts": ["background/background.js"]}, "permissions": ["storage", "tabs", "alarms"], "optional_permissions": ["history", "webNavigation"], "host_permissions": ["https://zitavita.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["assets/*"], "matches": []}], "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "extension@zitavita.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}}}}