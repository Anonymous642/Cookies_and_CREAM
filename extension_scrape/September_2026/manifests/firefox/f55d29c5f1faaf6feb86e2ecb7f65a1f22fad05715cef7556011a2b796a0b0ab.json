{"manifest_version": 2, "name": "Viva Auto-Refresh", "version": "1.0.0", "description": "Automatically refreshes Viva pages to maintain session with configurable timeout", "browser_specific_settings": {"gecko": {"id": "viva-auto-refresh@vivapayments.extension"}}, "permissions": ["activeTab", "storage", "*://*.vivapayments.com/*", "*://*.viva.com/*", "*://vivapayments.com/*", "*://viva.com/*"], "content_scripts": [{"matches": ["*://*.vivapayments.com/*", "*://*.viva.com/*", "*://vivapayments.com/*", "*://viva.com/*"], "js": ["scripts/remove-timeouts.js"], "run_at": "document_start"}], "background": {"scripts": ["background/background.js"], "persistent": false}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Viva Auto-Refresh Settings"}, "web_accessible_resources": ["scripts/remove-timeouts.js"], "content_security_policy": "script-src 'self'; object-src 'self'"}