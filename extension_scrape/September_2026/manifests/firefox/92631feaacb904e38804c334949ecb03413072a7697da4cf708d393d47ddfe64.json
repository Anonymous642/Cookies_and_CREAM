{"manifest_version": 3, "name": "GitKraken", "description": "The GitKraken Browser Extension bridges your hosted git repositories to GitKraken Desktop and with GitLens in VS Code.", "version": "2026.2.2312", "icons": {"16": "icons/gk-grey-16.png", "32": "icons/gk-grey-32.png", "48": "icons/gk-grey-48.png", "128": "icons/gk-grey-128.png"}, "permissions": ["cookies", "scripting", "storage", "webNavigation"], "host_permissions": ["*://*.github.com/*", "*://*.gitlab.com/*", "*://*.bitbucket.org/*", "*://*.dev.azure.com/*", "*://*.gitkraken.dev/*"], "action": {"default_popup": "static/popup.html"}, "background": {"scripts": ["dist/background.js"]}, "browser_specific_settings": {"gecko": {"id": "gitkraken-browser@gitkraken.com", "strict_min_version": "109.0"}}, "optional_permissions": ["*://*/*"]}