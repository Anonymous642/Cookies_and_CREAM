{"manifest_version": 3, "name": "Remove YouTube 'Ask' Button", "version": "1.0", "description": "Removes the AI 'Ask' button from YouTube video pages.", "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "youtube-ask-remover@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["style.css"], "js": ["content.js"], "run_at": "document_start"}]}