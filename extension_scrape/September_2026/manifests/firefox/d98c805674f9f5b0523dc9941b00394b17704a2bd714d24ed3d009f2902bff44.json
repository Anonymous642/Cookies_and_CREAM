{"manifest_version": 3, "name": "inClipMark \u2014 Video & Music Bookmarker", "version": "1.2.0", "description": "Bookmark precise moments and create clips on YouTube, YouTube Kids, SoundCloud & YouTube Music. Categories, tags, search & sync.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "contextMenus", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://www.youtubekids.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://i.ytimg.com/*", "https://api.lemonsqueezy.com/*"], "action": {"default_popup": "popup.html", "default_title": "inClipMark", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.youtubekids.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*"], "js": ["lib/browser-api.js", "lib/config.js", "lib/storage.js", "lib/license.js", "lib/limits.js", "lib/platforms.js", "content.js"], "css": ["content.css"], "run_at": "document_end"}], "background": {"scripts": ["lib/browser-api.js", "lib/config.js", "lib/storage.js", "lib/license.js", "lib/limits.js", "lib/sync.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "inclipmark@emiruckan.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}