{"manifest_version": 3, "name": "Swipe Seek", "version": "0.1.0", "description": "Swipe left/right on any HTML5 video to seek backward/forward. Works on all sites, including videos inside iframes.", "browser_specific_settings": {"gecko": {"id": "swipe-seek@prototype.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "121.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}]}