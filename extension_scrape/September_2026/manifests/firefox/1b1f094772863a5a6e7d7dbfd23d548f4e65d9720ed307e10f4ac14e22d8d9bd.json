{"manifest_version": 3, "name": "AccuKnox Prompt Firewall", "version": "1.0.7", "description": "Scans AI assistant prompts and responses through AccuKnox Prompt Firewall for security and compliance", "permissions": ["storage", "activeTab", "identity"], "storage": {"managed_schema": "schema.json"}, "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://github.com/*", "https://*.githubcopilot.com/*", "https://copilot.microsoft.com/*", "https://copilot.cloud.microsoft/*", "https://copilot.com/*", "https://m365.cloud.microsoft/*", "https://*.accuknox.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background/service-worker.js", "scripts": ["src/background/service-worker.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://github.com/*", "https://copilot.microsoft.com/*", "https://m365.cloud.microsoft/*", "https://copilot.cloud.microsoft/*", "https://copilot.com/*"], "js": ["src/shared/browser-polyfill.js", "src/content/content-script.js"], "run_at": "document_start", "all_frames": true, "world": "ISOLATED"}, {"matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://github.com/*", "https://copilot.microsoft.com/*", "https://m365.cloud.microsoft/*", "https://copilot.cloud.microsoft/*", "https://copilot.com/*"], "js": ["src/content/injector.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["src/content/injector.js"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://github.com/*", "https://copilot.microsoft.com/*", "https://m365.cloud.microsoft/*", "https://copilot.cloud.microsoft/*", "https://copilot.com/*"]}], "browser_specific_settings": {"gecko": {"id": "promptfirewall@accuknox.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "websiteContent"]}}}}