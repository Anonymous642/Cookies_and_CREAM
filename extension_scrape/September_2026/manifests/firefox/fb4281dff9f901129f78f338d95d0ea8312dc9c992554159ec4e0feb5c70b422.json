{"manifest_version": 2, "name": "OE IdP Auto-Login", "description": "Auto login to OE IdP with saved credentials.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "oe-idp-autologin@markgyoni.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "OE IdP Auto-Login", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.elearning.uni-obuda.hu/*", "*://elearning.uni-obuda.hu/*", "*://idp.uni-obuda.hu/saml2/module.php/consent/*", "*://idp.uni-obuda.hu/saml2/module.php/core/loginuserpass.php*", "*://kmooc.uni-obuda.hu/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}