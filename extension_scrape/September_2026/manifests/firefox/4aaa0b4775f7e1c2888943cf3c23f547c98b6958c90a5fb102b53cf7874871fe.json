{"manifest_version": 3, "name": "Shortcut Pattern Bookmark", "version": "0.3.0", "description": "This extension is used to create shortcut with pattern as bookmark for website (eg: Plone, Wordpress, ...)", "action": {"default_popup": "index.html"}, "permissions": ["activeTab", "storage", "tabs"], "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "icons": {"16": "icon_16.png", "32": "icon_32.png", "48": "icon_48.png", "128": "icon_128.png"}, "browser_specific_settings": {"gecko": {"id": "shortcut-pattern-bookmark@example.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}