{"manifest_version": 3, "name": "Notificaciones - Chat Anime", "version": "4.4.0", "author": "Ruben Ignacio", "description": "Notificaciones del chat de radio-anime.net. Manda notificaciones cuando un usuario te menciona en el chat.", "icons": {"16": "assets/images/icon.png", "128": "assets/images/Radio-anime-app-musica.png"}, "action": {"default_title": "Chat Anime - Notificaciones", "default_icon": "assets/images/icon.png", "default_popup": "popup/index.html"}, "commands": {"toggle-notification": {"suggested_key": {"default": "Alt+J"}, "description": "Activa o desactiva las notificaiones."}, "toggle-all-messages": {"suggested_key": {"default": "Alt+K"}, "description": "Activa o desactiva las notificaiones de todos los mensajes."}, "list-messages": {"suggested_key": {"default": "Alt+L"}, "description": "Abre la ventana de los mensajes donde te mencionan."}}, "permissions": ["alarms", "notifications", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"type": "module", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "notificaciones@radio-anime.net", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}}