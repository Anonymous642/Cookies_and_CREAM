{"manifest_version": 2, "name": "YouTube Time Restrictor", "version": "1.0", "description": "Restricts YouTube play time", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["storage", "tabs", "bookmarks", "alarms"], "browser_action": {"default_icon": "icon-48.png", "default_title": "YouTube Time Contrictor", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.netflix.com/*", "*://*.aether.mom/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "settings/settings.html"}, "browser_specific_settings": {"gecko": {"id": "@YouTubeTimeConstrictor", "data_collection_permissions": {"required": ["none"], "optional": []}}}}