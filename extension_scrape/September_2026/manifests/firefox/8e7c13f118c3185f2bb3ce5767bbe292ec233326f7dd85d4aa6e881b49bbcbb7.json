{"manifest_version": 3, "name": "Shop Ethical!", "version": "1.6.3", "description": "Add Shop Ethical! ratings to brand names on online shopping sites to help you shop ethically online.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shopethical-ratings.js"]}], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "options_ui": {"page": "settings.html"}, "permissions": ["storage"], "action": {"default_popup": "settings.html"}, "web_accessible_resources": [{"resources": ["style.css", "images/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "ratings@ethical.org.au"}}}