{"manifest_version": 2, "name": "DONX Tabs \u2013 Neon Sidebar", "version": "1.0.0", "description": "Zeigt alle Tabs in einer linken Neon-Sidebar, mit Pinnen, Favoriten, Suche und eigenen Namen.", "browser_specific_settings": {"gecko": {"id": "donx-tabs@donx.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": ["icons/burger.png", "icons/close.png", "icons/search.png", "icons/trash.png", "icons/edit.png", "icons/pin.png", "icons/star.png", "icons/pin_small.png", "icons/star_small.png"]}