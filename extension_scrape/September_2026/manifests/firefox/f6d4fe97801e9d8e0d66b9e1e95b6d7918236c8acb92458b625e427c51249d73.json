{"manifest_version": 2, "name": "Flickr New Tab", "version": "1.0.3", "description": "Replace new tab with a random photo from a Flickr user's public photostream.", "browser_specific_settings": {"gecko": {"id": "flickr-newtab@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://api.flickr.com/*"], "options_ui": {"page": "options.html", "browser_style": true}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}