{"manifest_version": 3, "name": "tab-clamp", "version": "0.1.4", "description": "Clamp yourself into a few tabs for a set time. No hopping away, no closing, no browsing off.", "permissions": ["tabs", "storage", "alarms", "webNavigation", "scripting"], "incognito": "spanning", "host_permissions": ["<all_urls>"], "action": {"default_title": "tab-clamp", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tab-clamp@ayushk", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}