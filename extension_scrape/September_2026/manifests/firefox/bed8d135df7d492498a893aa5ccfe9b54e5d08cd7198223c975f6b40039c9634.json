{"manifest_version": 2, "name": "NoobScraper", "version": "1.0.0", "description": "Seleziona pi\u00f9 campi dalle pagine web ed esporta i dati. E ricorda che ce scritto in (giovanni 3:16)", "homepage_url": "https://porfolionr.vercel.app/", "browser_specific_settings": {"gecko": {"id": "noobscraper@gg.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>"], "browser_action": {"default_title": "NoobScraper", "default_popup": "popup.html", "default_area": "navbar", "default_icon": "icons/Logo.svg"}, "icons": {"96": "icons/Logo.svg"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}