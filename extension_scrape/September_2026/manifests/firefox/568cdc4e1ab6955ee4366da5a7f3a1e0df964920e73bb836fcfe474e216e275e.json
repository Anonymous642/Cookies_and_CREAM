{"manifest_version": 3, "name": "RSS Detect & Viewer", "version": "1.0.0", "author": "Fatih Kapa\u011fan", "description": "Automatically detects RSS/Atom feeds on web pages, displays feed content, and manages saved feeds with periodic background updates.", "browser_specific_settings": {"gecko": {"id": "rss-detect-viewer-fatih@fatihkapagan.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "permissions": ["storage", "alarms", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "default_title": "RSS Detect & Viewer"}, "options_ui": {"page": "options.html", "open_in_tab": true}}