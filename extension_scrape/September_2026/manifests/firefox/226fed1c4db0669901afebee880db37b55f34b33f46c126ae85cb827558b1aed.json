{"version": "1.2.4", "manifest_version": 2, "name": "MyMemo web clipper", "description": "MyMemo Firefox Extension", "browser_action": {"default_icon": "logo.png", "default_title": "My Memo", "default_popup": "popup.html"}, "icons": {"16": "logo.png", "48": "logo.png", "128": "logo.png"}, "permissions": ["storage", "tabs", "notifications", "contextMenus", "identity", "activeTab", "<all_urls>"], "homepage_url": "https://app.mymemo.ai", "browser_specific_settings": {"gecko": {"id": "mymemo-web-clipper@mymemo.ai", "strict_min_version": "78.0"}}, "content_security_policy": "script-src 'self'; object-src 'self'", "web_accessible_resources": ["js/sdk.js", "images/*", "svg/*", "png/*", "css/*", "logo.png"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/content.js"], "css": ["css/window.css"], "run_at": "document_idle"}], "background": {"page": "background.html", "persistent": false}}