{"manifest_version": 2, "name": "Reddit Switcher", "version": "1.1", "description": "Toggle between old.reddit.com and new.reddit.com with one click.", "browser_specific_settings": {"gecko": {"id": "what@jesse.pizza", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_title": "Toggle Old/New Reddit", "default_popup": "popup/popup.html"}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+R"}, "description": "Toggle between old and new Reddit"}}}