{"manifest_version": 3, "name": "YouTube Language Filter", "version": "1.0", "description": "Filters YouTube videos based on language settings.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "YouTube Language Filter"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "myextension@mymail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}