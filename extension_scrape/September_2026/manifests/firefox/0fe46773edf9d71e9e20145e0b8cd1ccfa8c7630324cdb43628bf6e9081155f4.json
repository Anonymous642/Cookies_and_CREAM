{"manifest_version": 3, "name": "StockSilo", "version": "1.4.1", "description": "Routes stock footage comp downloads into per-site folders and keeps a running CSV log of every file, its source site, and page URL.", "permissions": ["downloads", "storage", "tabs", "scripting"], "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "StockSilo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "author": "RampantOctopus Softworks", "host_permissions": ["*://*.storyblocks.com/*", "*://*.artgrid.io/*", "*://*.artlist.io/*", "*://*.filmsupply.com/*", "*://*.pexels.com/*", "*://*.elements.envato.com/*", "*://*.motionarray.com/*", "*://*.videvo.net/*"], "optional_host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "stocksilo@rampantoctopus.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}