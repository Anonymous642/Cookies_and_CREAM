{"manifest_version": 2, "name": "Workvia", "version": "1.0.0", "description": "Tabs that fuel your workflow.", "browser_specific_settings": {"gecko": {"id": "workvia@example.com", "strict_min_version": "102.0"}}, "icons": {"48": "icons/workvia-48.png", "128": "icons/workvia-128.png"}, "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Workvia", "default_popup": "popup.html", "default_icon": {"48": "icons/workvia-48.png", "128": "icons/workvia-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"workvia-capture-now": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Capture the active tab to Now"}, "workvia-open-next": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open the next task from Now"}}, "content_security_policy": "script-src 'self'; object-src 'self'"}