{"manifest_version": 3, "name": "Shorts Blocker for YouTube", "version": "1.0.0", "description": "Hides YouTube Shorts across the site and redirects Shorts links to the normal player or the homepage. Also includes an experimental aggressive mode, off by default and still in testing.", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "{19e6071d-54dd-4997-a8ef-b7baf0c993a2}", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Shorts Blocker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}]}