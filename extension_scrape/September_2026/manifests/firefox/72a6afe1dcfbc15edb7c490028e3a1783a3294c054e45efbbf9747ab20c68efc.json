{"manifest_version": 3, "name": "Ecosia Search", "version": "2.0", "description": "Sets Ecosia as the default search engine \u2014 a privacy-friendly, tree-planting search engine.", "homepage_url": "https://github.com/yourusername/ecosia-for-firefox", "chrome_settings_overrides": {"search_provider": {"name": "Ecosia", "search_url": "https://www.ecosia.org/search?q={searchTerms}", "suggest_url": "https://ac.ecosia.org/?q={searchTerms}&type=list", "is_default": false}}, "content_security_policy": {"extension_pages": "default-src 'none'; img-src 'self';"}, "icons": {"48": "icons/ecosia-48.png"}, "browser_specific_settings": {"gecko": {"id": "{c2d4ac91-bd3c-48e8-8897-f0c6c3c3a19a}", "strict_min_version": "109.0"}}}