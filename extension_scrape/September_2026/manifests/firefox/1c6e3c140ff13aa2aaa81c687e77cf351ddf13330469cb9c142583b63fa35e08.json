{"manifest_version": 2, "name": "silenttrack Shorts Connector", "version": "0.1.0", "description": "Connector add-on for the local silenttrack Rust app. Tracks YouTube Shorts activity and sends it only to silenttrack on localhost.", "permissions": ["http://127.0.0.1/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "about.html", "open_in_tab": true}, "web_accessible_resources": ["chimesound.mp3"], "browser_specific_settings": {"gecko": {"id": "silenttrack-yt@localhost", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}