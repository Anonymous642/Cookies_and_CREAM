{"manifest_version": 2, "name": "TradeDesk \u2014 Risk Calculator & Trading Journal", "description": "Position sizing, R:R, and a trading journal \u2014 right inside TradingView. Local-first and private.", "version": "1.4.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "tradedesk@unifybrowse.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "contextMenus", "activeTab", "alarms", "notifications", "*://*.tradingview.com/*", "https://unifybrowse.com/*", "https://analytics.unifybrowse.com/*", "https://td.unifybrowse.com/*"], "web_accessible_resources": ["img/icon.png", "guide.html", "content-scripts/tradingview.css"], "commands": {"open-calculator": {"suggested_key": {"default": "Alt+C"}, "description": "Open the Risk Calculator"}, "open-journal": {"suggested_key": {"default": "Alt+J"}, "description": "Open the Journal"}, "open-stats": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open Statistics"}, "quick-add": {"suggested_key": {"default": "Alt+N"}, "description": "Quick Add a trade"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.tradingview.com/*"], "js": ["content-scripts/tradingview.js"]}], "browser_action": {"default_title": "Show / hide the trading panel"}}