{"manifest_version": 3, "name": "Media Bridge", "version": "0.3.3", "description": "Save media you own or are permitted to download\u2014without cloud uploads, intrusive ads, or artificial quotas.", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"], "background": {"scripts": ["service-worker.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:"}, "action": {"default_title": "Media Bridge", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "{d6c3a4cc-8b7b-4f97-a669-7f41c39a6ac8}", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}, "strict_min_version": "142.0"}}}