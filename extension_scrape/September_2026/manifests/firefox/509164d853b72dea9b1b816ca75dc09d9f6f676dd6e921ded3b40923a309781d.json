{"manifest_version": 3, "name": "Prayer Alarm", "version": "2.1.1", "author": "Raihan Khan", "description": "Beautiful, accurate, and minimal prayer times extension with Alarms.", "permissions": ["geolocation", "storage", "alarms", "notifications"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://api.aladhan.com/*", "http://ip-api.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "prayeralarm@raihan.khan", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}