{"manifest_version": 3, "name": "Air Alerts in Bookmarks", "version": "1.1.0", "description": "Shows Ukrainian air raid alerts on the bookmarks toolbar \u2014 one bookmark per region, refreshed in the background.", "homepage_url": "https://github.com/kvachikk/air-alerts-in-bookmarks", "browser_specific_settings": {"gecko": {"id": "air-alerts-in-bookmarks@kvachikk.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["bookmarks", "alarms", "storage"], "host_permissions": ["https://siren.pp.ua/*"], "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Air alerts \u2014 click to refresh now", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}