{"manifest_version": 2, "name": "TabAlert", "version": "1.0", "description": "Tells you how many tabs are open and in memory", "icons": {"48": "icons/red-48.png"}, "browser_action": {"default_icon": "icons/green-32.png", "default_title": "TabAlert", "default_popup": "popup/tabalert_details.html"}, "background": {"scripts": ["tabalert.js"], "persistent": false, "type": "module"}, "options_ui": {"page": "options.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "extension@tabalert.com"}}}