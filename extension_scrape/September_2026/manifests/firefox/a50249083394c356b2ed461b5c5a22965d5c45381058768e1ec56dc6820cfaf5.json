{"manifest_version": 3, "name": "My Fantasy Scores", "version": "1.19.0", "description": "Fantasy League Connector for My Fantasy Scores \u2014 securely links your leagues so scores and standings stay up to date.", "homepage_url": "https://www.myfantasyscores.com", "browser_specific_settings": {"gecko": {"id": "extension@myfantasyscores.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["cookies", "storage", "tabs", "alarms"], "host_permissions": ["https://*.espn.com/*", "https://*.fantrax.com/*", "https://*.cbssports.com/*", "https://*.underdogfantasy.com/*", "https://*.underdogsports.com/*", "https://play.fifa.com/*", "https://*.rtsports.com/*", "https://*.dataforceff.com/*", "https://app.leaguetycoon.com/*", "https://www.myfantasyscores.com/*"], "content_scripts": [{"matches": ["https://*.cbssports.com/*"], "js": ["content-cbs.js"], "run_at": "document_idle"}, {"matches": ["https://www.myfantasyscores.com/*"], "js": ["content-mfs-bridge.js"], "run_at": "document_idle"}, {"matches": ["https://*.underdogfantasy.com/*", "https://app.underdogsports.com/*"], "js": ["content-underdog-main.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["https://*.underdogfantasy.com/*", "https://app.underdogsports.com/*"], "js": ["content-underdog.js"], "run_at": "document_start"}, {"matches": ["https://play.fifa.com/*"], "js": ["content-fifa.js"], "run_at": "document_idle"}, {"matches": ["https://*.rtsports.com/*"], "js": ["content-rts.js"], "run_at": "document_idle"}, {"matches": ["https://app.leaguetycoon.com/*"], "js": ["content-leaguetycoon.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}