{"manifest_version": 2, "name": "Obsidian Web Clipper", "description": "Review and save the current page into Obsidian with a local title/snippet, optional OpenAI rewrite, and screenshot.", "version": "0.4.0", "browser_action": {"default_title": "Clip to Obsidian", "default_popup": "src/popup/popup.html"}, "commands": {"clip-current-page": {"suggested_key": {"default": "Command+Alt+X", "mac": "Command+Alt+X", "windows": "Ctrl+Alt+X", "linux": "Ctrl+Alt+X"}, "description": "Open the Obsidian Web Clipper review popup"}}, "background": {"page": "src/background.html"}, "permissions": ["activeTab", "downloads", "nativeMessaging", "storage", "tabs", "<all_urls>", "https://api.openai.com/*"], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "obsidian-web-clipper@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}}}