{"manifest_version": 3, "name": "Currencia", "version": "1.0.0", "description": "Select any price on a web page and instantly see it converted to your currency.", "author": "Minduos", "browser_specific_settings": {"gecko": {"id": "currencia@minduos.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://cdn.jsdelivr.net/*", "https://latest.currency-api.pages.dev/*"], "background": {"scripts": ["background/rates.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/parser.js", "content/popup.js", "content/detector.js"], "run_at": "document_idle", "all_frames": true}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "action": {"default_title": "Currencia \u2014 click for settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}}