{"manifest_version": 3, "name": "Blue Archive Cunny Checker", "version": "1.0", "description": "Shows a popup when a Blue Archive character is detected in your search", "icons": {"128": "assets/icon/icon-128.png"}, "host_permissions": ["https://www.google.com/*"], "permissions": ["scripting", "activeTab", "webNavigation", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["characters.json"], "matches": ["*://*/*"]}], "browser_specific_settings": {"gecko": {"id": "cunnychecker@helpme.com", "strict_min_version": "58.0"}}}