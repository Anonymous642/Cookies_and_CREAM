{"manifest_version": 2, "name": "SSVID Helper Button", "version": "1.0.2", "description": "Adds a quick access button on YouTube pages and a floating button on other sites to open the current URL in the SSVID web service.", "permissions": ["storage", "tabs", "*://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "SSVID"}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["supported_sites.json"], "browser_specific_settings": {"gecko": {"id": "{09dfda97-5a40-4a33-a449-e559de8c8051}"}}}