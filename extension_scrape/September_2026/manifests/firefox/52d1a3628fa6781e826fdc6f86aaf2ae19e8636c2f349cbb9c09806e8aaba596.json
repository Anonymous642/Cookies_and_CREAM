{"manifest_version": 2, "name": "Video Privacy", "version": "1.3", "description": "Copy YouTube URLs and open them on AdBlock.video \u2014 right-click any YouTube link to open it ad-free", "permissions": ["activeTab", "clipboardWrite", "contextMenus", "https://www.youtube.com/*", "https://m.youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Copy to Video Privacy"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-url-copier@videoprivacy.org", "strict_min_version": "79.0"}}}