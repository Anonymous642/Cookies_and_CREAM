{"manifest_version": 2, "name": "Content Difficulty Estimator", "version": "1.3", "description": "Estimate the difficulty of selected webpage content using linguistic complexity analysis.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Content Difficulty Estimator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Content-Difficulty-Estimator", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}