{"manifest_version": 3, "name": "Pulseous", "short_name": "Pulseous", "version": "1.0", "description": "Claude's service status in your toolbar: a checkmark when all is well, an X when it isn't.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Pulseous", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["lib.js", "colors.js", "background.js"]}, "permissions": ["storage", "alarms"], "browser_specific_settings": {"gecko": {"id": "pulseous@pulseous.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}