{"manifest_version": 2, "name": "Slow Bookmark Opener", "version": "1.0", "description": "Opens bookmarks in a specific folder slowly.", "permissions": ["bookmarks", "tabs"], "browser_action": {"default_title": "Open Folder Slowly", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "slow-bookmark-opener@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}