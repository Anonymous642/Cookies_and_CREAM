{"manifest_version": 3, "name": "Local Short URL", "description": "Create private short URLs stored as bookmarks. Navigate to http://s/{id} to redirect.", "version": "1.0.0", "author": "Kan-Ru Chen", "homepage_url": "https://codeberg.org/kanru/local-short-url", "developer": {"name": "Kan-Ru Chen", "url": "https://codeberg.org/kanru/local-short-url"}, "browser_specific_settings": {"gecko": {"id": "{70dd0d22-7d27-4226-ad7c-8db3ace23c17}", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "permissions": ["bookmarks", "tabs", "webRequest", "webRequestBlocking", "clipboardWrite"], "host_permissions": ["*://s/*"], "background": {"scripts": ["background/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Local Short URL", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}