{"manifest_version": 2, "name": "Pin Point \u2014 federicocalo.dev", "description": "Segnalibri dei messaggi e minimappa per saltare fra i punti chiave delle chat AI (ChatGPT, Claude, Gemini). Offline.", "version": "1.0.0", "icons": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "128": "/icon/128.png"}, "permissions": ["storage", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "browser_specific_settings": {"gecko": {"id": "pin-point@federicocalo.dev", "strict_min_version": "109.0"}}, "data_collection_permissions": {"required": ["none"]}, "browser_action": {"default_title": "Pin Point", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}