{"manifest_version": 3, "name": "Vigil - Keep Teams Awake Easily", "version": "1.0.0", "description": "Stops Microsoft Teams from flipping you to Away while you work elsewhere. Vigil sends a quiet synthetic pulse to the page, but only once you have genuinely gone idle.", "permissions": ["storage", "activeTab"], "action": {"default_title": "Vigil", "default_popup": "panel/panel.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png", "256": "icons/256.png", "512": "icons/512.png"}, "content_scripts": [{"matches": ["https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://*.teams.cloud.microsoft/*", "https://teams.live.com/*", "https://*.teams.live.com/*", "https://teams.microsoft.us/*", "https://*.teams.microsoft.us/*", "https://teams.21vianet.cn/*", "https://*.teams.21vianet.cn/*"], "js": ["lib/runtime.js", "lib/hosts.js", "lib/prefs.js", "content/pulse.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{6b1f0c7e-2d94-4a83-b5e7-3f9d81c4a260}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}