{"manifest_version": 3, "name": "Better Jump Controls for YouTube", "version": "1.0.0", "homepage_url": "https://github.com/Danielvandervelden/youtube-better-jump-controls", "description": "Configurable keyboard seek for YouTube. Define your own key combos (Ctrl/Option/Shift/Cmd) and how many milliseconds each one jumps, from a toolbar popup.", "browser_specific_settings": {"gecko": {"id": "youtube-better-jump-controls@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "action": {"default_title": "Better Jump Controls for YouTube", "default_popup": "popup.html", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "popup.html", "open_in_tab": true}}