{"manifest_version": 3, "name": "Digital Herd - Sitecore Content Hub", "version": "2.1.0", "description": "This extension provides a collection of shortcuts and tools for the Sitecore Content Hub.", "action": {"default_icon": {"16": "assets/icon_16.png", "48": "assets/icon_48.png", "128": "assets/icon_128.png"}, "default_title": "Content Hub Tools", "default_popup": "index.html"}, "permissions": ["activeTab", "tabs", "storage"], "content_scripts": [{"js": ["content-script.js"], "css": ["content-script.css"], "matches": ["http://*/*", "https://*/*"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "sitecore-contenthub@digitalherd.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo", "websiteActivity", "technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}