{"manifest_version": 3, "name": "BlueIn Repost ~Random Picker", "version": "1.6", "description": "Extract reposters from a LinkedIn post and pick ~random winners.", "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.linkedin.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "blueing@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}