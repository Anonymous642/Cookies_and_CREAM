{"manifest_version": 2, "name": "DOI Address", "version": "0.9", "description": "Show the DOI link of a webpage in the address bar", "homepage_url": "https://github.com/anthakki/firefox-doi-address/", "icons": {"48": "icons/logo.svg"}, "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content_script.js"]}], "page_action": {"browser_style": false, "default_icon": "icons/logo.svg", "default_title": "<doi>", "default_popup": "src/popup.html"}, "permissions": ["activeTab", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "firefox-doi-address@anthakki.github.com", "data_collection_permissions": {"required": ["none"]}}}}