{"manifest_version": 3, "name": "Anotum Kindle Sync", "short_name": "aks", "icons": {"32": "logo32.png", "64": "logo64.png", "192": "logo192.png", "512": "logo512.png"}, "version": "1.1.0", "browser_specific_settings": {"gecko": {"id": "kindle-sync-extension@anotum.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "description": "Extension for syncing Amazon Cloud highlights with Anotum.", "permissions": ["cookies", "storage"], "web_accessible_resources": [{"resources": ["index.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["browser-polyfill.js"]}], "host_permissions": ["*://*.anotum.com/*", "*://*.amazon.com/*"], "action": {"default_icon": {"32": "logo32.png", "64": "logo64.png", "192": "logo192.png", "512": "logo512.png"}, "default_popup": "index.html"}}