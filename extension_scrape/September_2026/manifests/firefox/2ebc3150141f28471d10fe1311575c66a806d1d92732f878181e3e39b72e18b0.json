{"manifest_version": 3, "name": "RequestFox - Network QA Monitor", "version": "2.1.4", "default_locale": "en", "description": "Captures API traffic during manual testing, flags duplicate calls, failed requests, and slow responses in real time, and can compose/send requests or import a Postman/OpenAPI collection.", "browser_specific_settings": {"gecko": {"id": "accessisight@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "scripting", "webRequest", "storage", "notifications", "downloads", "tabs", "unlimitedStorage", "declarativeNetRequest", "identity"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["lib/detection.js", "lib/session-store.js", "lib/security-scan.js", "lib/crypto-vault.js", "lib/i18n-runtime.js", "lib/browser-compat.js", "background.js"]}, "devtools_page": "devtools.html", "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "RequestFox", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-recording": {"suggested_key": {"default": "Ctrl+Shift+R", "mac": "Command+Shift+R"}, "description": "Stop recording, or open the panel to start it"}, "cycle-ui-mode": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Cycle Settings \u2192 Mode: Full \u2192 Background \u2192 Mini \u2192 Full"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["<all_urls>"]}]}