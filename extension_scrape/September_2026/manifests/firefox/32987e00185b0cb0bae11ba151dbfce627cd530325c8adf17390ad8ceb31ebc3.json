{"manifest_version": 3, "name": "ChannelFlow for YouTube", "version": "0.1.2", "description": "YouTube watch page: switch related videos to a list from the same channel.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "ChannelFlow", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "@channelflow.fjnce", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content-script.js"], "css": ["styles.css"], "run_at": "document_idle"}], "host_permissions": ["https://www.youtube.com/*"]}