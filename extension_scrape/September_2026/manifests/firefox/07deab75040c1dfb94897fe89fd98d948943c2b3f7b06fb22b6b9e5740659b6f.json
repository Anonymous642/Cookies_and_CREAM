{"manifest_version": 3, "name": "Aurebest", "version": "1.0.1", "description": "Transliterates English text into Aurebesh, the Star Wars alphabet. This is slop - be warned.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "web_accessible_resources": [{"resources": ["fonts/aurebesh.woff2"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "aurebest@extension", "strict_min_version": "109.0"}}}