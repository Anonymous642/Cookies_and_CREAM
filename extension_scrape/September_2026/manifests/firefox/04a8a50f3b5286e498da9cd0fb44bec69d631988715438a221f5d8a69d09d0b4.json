{"manifest_version": 3, "name": "Contador de Quest\u00f5es - Concursos Policiais", "version": "1.3.0", "description": "Conta em tempo real quantas quest\u00f5es voc\u00ea resolveu no tecconcursos.com.br, qlegislacao.com.br, qconcursos.com e questoes.grancursosonline.com.br, com card de treinamento di\u00e1rio, meta e modal de miss\u00e3o cumprida - tema carreira policial. O contador \u00e9 o mesmo em todos os sites suportados.", "permissions": ["storage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "qt-contador@questaodetempo.com", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://*.firebaseio.com/*"], "content_scripts": [{"matches": ["https://www.tecconcursos.com.br/*", "https://tecconcursos.com.br/*", "https://www.qlegislacao.com.br/*", "https://qlegislacao.com.br/*", "https://www.qconcursos.com/*", "https://qconcursos.com/*", "https://questoes.grancursosonline.com.br/*"], "js": ["cloud-sync.js", "content.js"], "css": ["overlay.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["revisao.html", "revisao.css", "revisao.js"], "matches": ["<all_urls>"]}]}