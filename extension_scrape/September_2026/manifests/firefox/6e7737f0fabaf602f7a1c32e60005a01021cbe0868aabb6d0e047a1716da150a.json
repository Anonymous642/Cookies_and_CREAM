{"manifest_version": 3, "name": "Alexandry", "version": "0.1.0", "description": "R\u00e9sum\u00e9 rapide et papiers citants en marge des pages arXiv, Google Scholar, PubMed et Semantic Scholar.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://arxiv.org/*", "https://api.semanticscholar.org/*", "https://api.anthropic.com/*", "https://alexandry-cache.alexandry.workers.dev/*"], "content_scripts": [{"matches": ["https://arxiv.org/abs/*"], "js": ["src/sidebar/sidebar.js", "src/content-script.js"], "css": ["src/sidebar/sidebar.css"]}, {"matches": ["https://scholar.google.com/scholar*"], "js": ["src/scholar/scholar-widget.js", "src/scholar-content-script.js"], "css": ["src/scholar/scholar.css"]}, {"matches": ["https://pubmed.ncbi.nlm.nih.gov/*"], "js": ["src/sidebar/sidebar.js", "src/pubmed-content-script.js"], "css": ["src/sidebar/sidebar.css"]}, {"matches": ["https://www.semanticscholar.org/paper/*"], "js": ["src/sidebar/sidebar.js", "src/semanticscholar-content-script.js"], "css": ["src/sidebar/sidebar.css"]}], "background": {"scripts": ["src/background.js"]}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "alexandry@github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}