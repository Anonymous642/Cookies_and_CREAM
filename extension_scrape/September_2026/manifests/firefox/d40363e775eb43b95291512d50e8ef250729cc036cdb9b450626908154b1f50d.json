{"manifest_version": 2, "name": "Plume \u2014 Micropub Client", "description": "Post to your Micropub-compatible blog from anywhere in the browser.", "version": "1.7.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "contextMenus", "identity", "notifications", "alarms"], "optional_permissions": ["<all_urls>"], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Open the Plume composer"}}, "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "plume@rmdes.net", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Plume", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://rmdes.github.io/plume/callback.html*"], "run_at": "document_end", "js": ["content-scripts/callback.js"]}]}