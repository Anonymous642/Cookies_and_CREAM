{"manifest_version": 3, "name": "FavLaunch", "version": "2.0.1", "description": "A sleek new tab page with quick-access favicon bookmarks.", "chrome_url_overrides": {"newtab": "index.html"}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "96": "icon96.png", "128": "icon128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "favlaunch@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}