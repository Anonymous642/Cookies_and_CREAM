{"manifest_version": 2, "name": "Smart Tab Manager", "version": "1.5.2", "description": "Organize and manage your tabs efficiently. Group, search, suspend, and navigate tabs with a clean modern interface.", "author": "AnalyticsCore Studio", "homepage_url": "https://smarttabmanager.io", "permissions": ["storage", "tabs", "tabHide", "activeTab", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Smart Tab Manager", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "firefox-tabmanager@analytics-tools.firefox", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}