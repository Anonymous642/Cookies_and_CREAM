{"manifest_version": 2, "name": "Tab Search", "version": "1.0.0", "description": "Quickly search and switch between open tabs with a keyboard shortcut.", "browser_specific_settings": {"gecko": {"id": "tab-search@navas.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs"], "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "browser_action": {"default_title": "Tab Search", "default_popup": "popup.html", "default_icon": {"16": "icon.svg", "32": "icon.svg"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open Tab Search"}}}