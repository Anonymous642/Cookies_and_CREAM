{"manifest_version": 3, "name": "aimlock.ai Browser Extension", "version": "1.0.0", "description": "Sends your active browser tab to aimlock.ai for distraction detection. Requires the aimlock.ai desktop app installed and running.", "permissions": ["tabs"], "host_permissions": ["http://127.0.0.1:24656/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@aimlock.ai", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}