{"manifest_version": 2, "name": "Adios Alexa for Shopping (formerly Rufus)", "version": "2.0.0", "description": "Amazon renamed Rufus to 'Alexa for Shopping' \u2014 same intrusive AI, same one-click goodbye. Shop without being 'assisted'.", "browser_specific_settings": {"gecko": {"id": "removerufus@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*", "*://*.amazon.com.mx/*"], "background": {"scripts": ["browser-polyfill.js", "background-firefox.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Adios Alexa for Shopping (formerly Rufus)", "default_icon": "adios-alexa-logo-boxed.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.com.au/*", "*://*.amazon.com.br/*", "*://*.amazon.com.mx/*"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_start"}]}