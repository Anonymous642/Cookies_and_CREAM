{"manifest_version": 3, "name": "Clickspaid Task Helper", "version": "1.0.0", "description": "Clicks the Clickspaid new-task button and pastes text into Google search.", "permissions": ["storage", "clipboardRead"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "Clickspaid Task Helper", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@clickspaid-task-helper", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}