{"manifest_version": 2, "name": "Gace AI", "description": "Connect your browser to Gace AI \u2014 let AI tools interact with web pages.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["alarms", "cookies", "storage", "activeTab", "scripting", "https://gace.dev/*"], "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "gace-ai@gace.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Gace AI", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}