{"manifest_version": 2, "name": "FireImage", "version": "1.1.0", "description": "Easily select and download multiple images from any webpage.", "permissions": ["downloads", "activeTab", "contextMenus"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "fireimage@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "FireImage"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}