{"manifest_version": 3, "name": "TabMigo \u2014 Visual Bookmark Manager & New Tab", "version": "1.0.1", "description": "Visual bookmark manager & custom new tab. Save any tab in one click; organize bookmarks, notes & to-dos on tiled workspace boards.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Save to TabMigo", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+B"}, "description": "Open the Save to TabMigo popup"}}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://tabmigo.com/*"], "optional_host_permissions": ["https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "tabmigo-bookmarker@tabmigo.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}