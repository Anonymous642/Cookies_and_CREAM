{"manifest_version": 2, "name": "Private Site Scrubber", "version": "1.0.7", "description": "Finds and removes browser traces for user-defined and known suspicious/adult domains across history, cookies, bookmarks, downloads, cache and site storage.", "permissions": ["bookmarks", "browsingData", "cookies", "downloads", "history", "storage", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"16": "scrubber.svg", "32": "scrubber.svg"}, "default_title": "Private Site Scrubber", "default_popup": "popup.html"}, "background": {"scripts": ["browser-polyfill-lite.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "private-site-scrubber@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"48": "scrubber.svg", "96": "scrubber.svg"}}