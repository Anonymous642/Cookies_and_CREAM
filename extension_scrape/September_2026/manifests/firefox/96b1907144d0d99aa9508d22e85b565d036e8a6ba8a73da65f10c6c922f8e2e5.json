{"name": "SearchPilot", "description": "Help develop and debug rules for SearchPilot enabled sites. Note: requires SearchPilot account", "version": "0.12.0", "manifest_version": 3, "background": {"scripts": ["browser-polyfill.js", "sp-debug-parse.js", "background.js"]}, "permissions": ["storage", "scripting", "tabs", "activeTab", "clipboardWrite", "cookies", "proxy", "webRequest", "webRequestAuthProvider", "webNavigation", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "alarms"], "host_permissions": ["https://app.searchpilot.com/*", "https://ptero.internal/*", "https://www.gravatar.com/*"], "optional_host_permissions": ["<all_urls>"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["SearchPilot_logo.png"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "action-icon16.png", "32": "action-icon32.png", "48": "action-icon48.png", "128": "action-icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "searchpilot-assistant@searchpilot.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "incognito": "spanning"}