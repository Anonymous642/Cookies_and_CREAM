{"manifest_version": 3, "name": "Canvas Helper - Etsy Assistant", "version": "2.11.2", "description": "Etsy integration for Canvas Helper: order management, discount helpers, and multi-store switching for print-on-demand sellers.", "browser_specific_settings": {"gecko": {"id": "canvas-helper-etsy@canvashelper.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "activeTab", "scripting", "notifications", "alarms"], "host_permissions": ["https://www.etsy.com/*", "https://app.canvashelper.com/*", "http://localhost:5000/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "sidebar_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Canvas Helper", "default_panel": "index.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.etsy.com/*"], "js": ["content/etsy-content-loader.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://www.etsy.com/your/*"], "js": ["content/shop-stats-content-loader.js"], "run_at": "document_idle"}, {"matches": ["https://app.canvashelper.com/*"], "js": ["content/auth-bridge-loader.js"], "run_at": "document_idle"}, {"matches": ["http://*/*", "https://*/*"], "js": ["content/image-import-loader.js"], "css": ["content/image-import.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["<all_urls>"]}]}