{"manifest_version": 3, "name": "Resemble AI Deepfake Detector", "version": "1.2.0", "description": "Know what's real. Scan any image, video, or audio on the web for AI-generated content \u2014 powered by Resemble AI's detection engine.", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["storage", "cookies", "activeTab", "scripting", "webRequest", "webNavigation", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "platform-resolvers.js", "content.js"], "css": ["styles/content.css"], "all_frames": true}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.reddit.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*", "*://*.linkedin.com/*", "*://*.vimeo.com/*", "*://*.twitch.tv/*"], "js": ["interceptor.js"], "world": "MAIN", "run_at": "document_start"}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Resemble AI Deepfake Detector"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Resemble AI Deepfake Detector", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity", "websiteContent"]}, "id": "deepfake-detector@resemble.ai", "strict_min_version": "142.0"}}}