{"manifest_version": 3, "name": "Contact Clipper", "description": "Extract email addresses, phone numbers, and social profile links from the current page.", "version": "0.7.17", "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "Contact Clipper", "default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://contactclipper.com/*"], "browser_specific_settings": {"gecko": {"id": "contact-clipper@contactclipper.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}