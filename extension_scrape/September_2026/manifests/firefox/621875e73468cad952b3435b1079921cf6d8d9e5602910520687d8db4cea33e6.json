{"manifest_version": 3, "name": "YouTube Video Hider", "version": "1.4", "description": "Hides the YouTube video element.", "browser_specific_settings": {"gecko": {"id": "youtube-video-hider-a15@roberth.es", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "host_permissions": ["https://*.youtube.com/*"], "action": {"default_popup": "settings.html", "default_icon": "icons/youtube.svg"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}