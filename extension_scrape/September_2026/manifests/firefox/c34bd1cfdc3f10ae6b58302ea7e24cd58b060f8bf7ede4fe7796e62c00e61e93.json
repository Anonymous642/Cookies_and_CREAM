{"manifest_version": 2, "name": "HLS Video Grabber", "version": "1.5.1", "description": "HLS Video Grabber makes downloading M3U8 HLS streams from the web simple and fast. This tool allows you to grab live video streams and embedded media without any limitations on domain access.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "*://*.cohost.org/*"], "web_accessible_resources": ["*.js", "*.json", "*.css", "*.svg", ".png"], "content_scripts": [{"matches": ["*://*.cohost.org/*"], "exclude_matches": ["*://*.cohost.org/rc/login"], "run_at": "document_end", "js": ["control/contentScript.js", "lib/jquery.min.js", "lib/marked.min.js", "lib/purify.min.js", "lib/luxon.min.js", "lib/prism.js", "lib/umd.js"], "css": ["scripts/utils/elements.css", "scripts/bookmarksDefault.css"]}], "background": {"scripts": ["control/background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "default_popup": "ui/menu.html?popup=true"}, "browser_specific_settings": {"gecko": {"id": "hls-video-grabber@addons.mozilla.org", "strict_min_version": "121.0"}}}