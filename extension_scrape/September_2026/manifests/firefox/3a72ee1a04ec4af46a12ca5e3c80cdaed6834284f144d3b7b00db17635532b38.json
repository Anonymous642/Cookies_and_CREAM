{"manifest_version": 3, "name": "ColorQuiz Tab Marker", "description": "Transform new tabs into interactive color-matching puzzles to boost your focus and visually categorize your active browsing sessions.", "version": "1.0.0", "author": "ChromaDev Lab", "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["https://*/*", "http://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "colorquiztabmarker@chromadevlab.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}