{"manifest_version": 2, "name": "Focus Highlighter (Ilana build)", "version": "0.4.3", "description": "Keyboard focus and hover visual ring with high-contrast resilience and configurable styles.", "permissions": ["menus", "storage", "tabs", "activeTab", "<all_urls>"], "browser_action": {"default_title": "Focus Highlighter"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "commands": {"fh-toggle": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Toggle Focus Highlighter"}, "fh-yellow": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "Set color: Yellow"}, "fh-red": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Set color: Red"}, "fh-turquoise": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Set color: Turquoise"}, "fh-blue": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Set color: Blue"}, "fh-system-focus": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Switch to System Focus mode"}, "fh-toggle-hover": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Toggle Hover Highlight"}}, "browser_specific_settings": {"gecko": {"id": "focus-highlighter@example.com", "strict_min_version": "109.0"}}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}