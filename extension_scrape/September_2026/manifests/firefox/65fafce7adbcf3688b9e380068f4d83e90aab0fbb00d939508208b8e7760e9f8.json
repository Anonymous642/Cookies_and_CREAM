{"manifest_version": 3, "name": "Moqups", "description": "Convert webpages and designs into fully editable layouts, grab screenshots and use them in Moqups", "version": "2.0.4", "icons": {"16": "images/m16.png", "32": "images/m32.png", "48": "images/m48.png", "128": "images/m128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://api.moqups.com/*", "https://app.moqups.com/*"], "optional_permissions": ["webNavigation"], "optional_host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "{d56c6b4a-bcf4-4122-8d6b-936e16af4c15}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://app.moqups.com/*"], "css": ["content-scripts/colorpicker.css"], "js": ["content-scripts/colorpicker.js", "content-scripts/use-result-in-app.js"]}]}