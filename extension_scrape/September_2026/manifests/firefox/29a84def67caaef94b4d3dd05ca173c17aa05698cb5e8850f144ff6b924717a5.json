{"manifest_version": 3, "name": "Treemap for heise Newsticker (inoffiziell)", "version": "2.2.0", "description": "Visualisiert den heise Newsticker als interaktive Treemap", "permissions": ["tabs", "storage"], "host_permissions": ["https://www.heise.de/*"], "action": {"default_title": "Treemap for heise Newsticker"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "browser_specific_settings": {"gecko": {"id": "treemap-for-heise-newsticker@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}