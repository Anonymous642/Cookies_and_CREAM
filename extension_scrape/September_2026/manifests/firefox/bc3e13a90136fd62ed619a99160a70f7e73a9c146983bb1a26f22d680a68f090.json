{"manifest_version": 2, "name": "Indic Transliterator", "version": "1.1", "author": "Writtik Bhattacharya", "homepage_url": "https://github.com/WrittikGithub/indic-transliterator.git", "description": "Transliterate between Indic scripts using client-side processing", "default_locale": "en", "icons": {"48": "icons/icon_48.png"}, "permissions": ["storage", "activeTab", "contextMenus", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_icon": "icons/icon_48.png", "default_popup": "popup/popup.html"}, "web_accessible_resources": ["icons/*", "popup/*"], "browser_specific_settings": {"gecko": {"id": "indic-transliterator@writtik.github.io"}}}