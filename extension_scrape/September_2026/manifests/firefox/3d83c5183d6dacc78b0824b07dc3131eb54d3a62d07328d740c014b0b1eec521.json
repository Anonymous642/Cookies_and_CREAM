{"manifest_version": 3, "name": "Bless Inventory Exporter (Marketplace)", "version": "1.0", "action": {"default_icon": {"16": "icon-16-gray.png", "32": "icon-32-gray.png", "48": "icon-48-gray.png", "64": "icon-64-gray.png", "128": "icon-128-gray.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "description": "Export inventory from Bless to The Marketplace.", "permissions": ["scripting"], "host_permissions": ["https://marketplace.ezfficient.com/*", "https://manage.lularoebless.com/Inventory*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bless-exporter@marketplace.ezfficient.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://manage.lularoebless.com/Inventory*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://manage.lularoebless.com/Inventory*"]}]}