{"manifest_version": 2, "name": "Multiplex YT Player", "version": "1.0.0", "description": "Unlimited playback adfree + downloads", "permissions": ["nativeMessaging", "webRequest", "webRequestBlocking", "https://www.youtube.com/*", "https://youtube.com/*", "*://*.googlevideo.com/*", "*://*.youtube.com/*", "*://*.ytimg.com/*", "*://127.0.0.1/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["assets/js/hls.min.js", "content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "youtube@multiplex.digital", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}