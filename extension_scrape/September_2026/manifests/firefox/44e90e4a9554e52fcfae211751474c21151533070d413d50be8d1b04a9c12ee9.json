{"manifest_version": 3, "name": "NCR Cookie Editor", "version": "1.6.0", "description": "Kisi bhi website ke cookies dekho, add karo, edit karo, delete karo, import/export karo (file ya paste dono se).", "permissions": ["cookies", "activeTab", "tabs", "storage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "ncr-cookie-editor@ncrworld.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "NCR Cookie Editor"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}