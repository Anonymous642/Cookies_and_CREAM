{"manifest_version": 3, "name": "TabCounter", "version": "1.0.0", "description": "Simple tab counter. See how many tabs you have open and manage them easily.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "TabCounter", "default_popup": "ui/counter.html"}, "permissions": ["tabs"], "browser_specific_settings": {"gecko": {"id": "tabcounter@tabs.simple", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}