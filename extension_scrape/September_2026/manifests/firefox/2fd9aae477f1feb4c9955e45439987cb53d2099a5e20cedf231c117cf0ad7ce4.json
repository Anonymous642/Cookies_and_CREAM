{"manifest_version": 3, "name": "Yotabyte Sidekick", "short_name": "Sidekick", "version": "1.0.58", "description": "Command palette, drawer, and quality-of-life tools for Maropost cPanel.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Yotabyte Sidekick", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "activeTab", "contextMenus", "scripting"], "optional_host_permissions": ["*://*/*"], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}], "commands": {"open-palette": {"suggested_key": {"default": "Ctrl+Space", "mac": "MacCtrl+Space"}, "description": "Open the Sidekick command palette"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "homepage_url": "https://yotabyte.io/tools", "author": "Yotabyte", "browser_specific_settings": {"gecko": {"id": "sidekick@yotabyte.io", "strict_min_version": "128.0"}}}