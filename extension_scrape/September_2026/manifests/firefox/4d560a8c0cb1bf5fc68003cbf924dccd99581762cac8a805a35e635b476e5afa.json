{"manifest_version": 2, "name": "IGNITE", "version": "1.0.0.1", "description": "Interactive chat class assistant that answers user questions. Users can download a text file of the chat history by clicking on the chat history button and upload files by clicking on the upload file button next to the search box. They can also choose a course using the dropdown menu on the top of the chat.", "background": {"scripts": ["Frontend/background.js"], "persistent": false}, "permissions": ["storage", "activeTab", "tabs", "scripting", "http://localhost:6060/*", "http://127.0.0.1:6060/*", "https://ignite-server-329437145374.us-west1.run.app/*", "https://piazza.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:6060/ http://127.0.0.1:6060/ https://ignite-server-329437145374.us-west1.run.app/;", "browser_action": {"default_icon": "Frontend/icons/icon_32.png", "default_title": "Open IGNITE Chat"}, "sidebar_action": {"default_panel": "Frontend/popup.html", "default_icon": {"16": "Frontend/icons/icon_16.png", "32": "Frontend/icons/icon_32.png"}, "default_title": "IGNITE"}, "icons": {"16": "Frontend/icons/icon_16.png", "32": "Frontend/icons/icon_32.png", "48": "Frontend/icons/icon_48.png", "128": "Frontend/icons/icon_128.png"}, "web_accessible_resources": ["Frontend/icons/*", "Frontend/*.css", "Frontend/*.js", "Frontend/css/*", "Frontend/webfonts/*"], "browser_specific_settings": {"gecko": {"id": "ignite.ref@gmail.com", "strict_min_version": "91.0"}}}