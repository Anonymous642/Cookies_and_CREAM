{"manifest_version": 3, "name": "PDF Fill & Sign - Locally", "short_name": "Fill & Sign", "version": "1.0.1", "description": "Fill in and sign any PDF entirely in your browser. Click anywhere to place text or a signature. No account, no upload, no cloud.", "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://extensionpay.com/*"], "background": {"service_worker": "background.js", "scripts": ["vendor/ExtPay.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "pdf-fill-sign@quoray.com", "data_collection_permissions": {"required": ["financialAndPaymentInfo"]}}}}