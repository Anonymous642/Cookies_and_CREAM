{"manifest_version": 3, "name": "WordCheck", "version": "0.1", "description": "Look up the definition of a word quickly.", "browser_specific_settings": {"gecko": {"id": "@wordcheck", "strict_min_version": "110.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "permissions": ["tabs", "storage"], "action": {"default_popup": "popup.html"}, "host_permissions": ["https://en.wiktionary.org/*"]}