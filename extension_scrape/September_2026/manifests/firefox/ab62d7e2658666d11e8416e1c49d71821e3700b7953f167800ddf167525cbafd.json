{"manifest_version": 3, "name": "SessionScribe", "version": "0.19.1", "description": "Turn the webinar you're watching into a transcribed, summarized Notion page.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "SessionScribe: send to Notion", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["tabs", "storage", "cookies", "alarms", "webRequest", "webNavigation", "scripting", "identity"], "host_permissions": ["<all_urls>", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "sessionscribe@birchhillequity.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}}