{"manifest_version": 3, "name": "CSS Inspector", "version": "1.5.3", "description": "Pick any element on a page and read, filter and live-edit its CSS.", "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "CSS Inspector (Alt+Shift+C)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"toggle-inspector": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Open or close the CSS Inspector"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "css-inspector@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}