{"manifest_version": 3, "name": "Password Manager", "version": "1.0.0", "description": "Gestionnaire de mots de passe zero-knowledge avec chiffrement AES-256-GCM c\u00f4t\u00e9 client", "browser_specific_settings": {"gecko": {"id": "password-manager@mewtit.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "permissions": ["activeTab", "storage", "tabs", "clipboardWrite"], "host_permissions": ["https://password-manager-api-o1st.onrender.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"autofill-credentials": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Remplir identifiant + mot de passe"}}, "web_accessible_resources": [{"resources": ["icons/icon-48.png"], "matches": ["<all_urls>"]}]}