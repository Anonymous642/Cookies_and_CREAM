{"manifest_version": 2, "name": "Twitch Pinned Streamers", "version": "1.9.4", "description": "Pin Twitch streamers on sidebar without being logged in.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["https://www.twitch.tv/*", "https://gql.twitch.tv/*", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.twitch.tv/*"], "js": ["content-base.js", "content-core.js", "content-runtime.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "twitch-pinned-streamers@addon.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}