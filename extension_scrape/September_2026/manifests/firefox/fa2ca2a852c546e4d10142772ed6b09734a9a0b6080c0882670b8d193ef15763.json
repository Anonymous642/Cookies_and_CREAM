{"manifest_version": 3, "name": "Yabrix Links", "description": "Create Yabrix short links from the current tab.", "version": "0.1.4", "action": {"default_title": "Create Yabrix short link", "default_popup": "popup.html", "default_icon": {"16": "icons/yabrix-16.png", "32": "icons/yabrix-32.png", "48": "icons/yabrix-48.png", "128": "icons/yabrix-128.png"}}, "icons": {"16": "icons/yabrix-16.png", "32": "icons/yabrix-32.png", "48": "icons/yabrix-48.png", "128": "icons/yabrix-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.yabrix.com/*"], "browser_specific_settings": {"gecko": {"id": "short-links@yabrix.com", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}, "strict_min_version": "121.0"}}}