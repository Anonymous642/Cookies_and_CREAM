{"manifest_version": 3, "name": "Carabid", "version": "1.0.0", "description": "Control which emails your AI agent can see.", "permissions": ["storage", "tabs"], "host_permissions": ["https://mail.google.com/*", "https://api.carabid.ai/*"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Carabid", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "carabid@carabid.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications"], "storage_synced": "exempt_non_user_facing", "persistently_stores_personal_data": true, "privacy_policy_url": "https://carabid.ai/privacy"}}}}