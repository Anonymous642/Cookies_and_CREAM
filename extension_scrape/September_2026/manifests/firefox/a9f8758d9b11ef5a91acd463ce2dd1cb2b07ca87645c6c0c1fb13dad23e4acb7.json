{"manifest_version": 2, "name": "Lights Out \u2014 Universal Dark Mode", "version": "4.2", "description": "Flip the lights out on the entire internet. This universal dark mode recolors every site into a comfortable night theme, with fine brightness and contrast tuning, per-site control, and scheduled auto-dark.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{104ed335-fa9a-4d6d-8104-dc6d8ea838f0}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/dm-core.js", "scripts/darkmode.js"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_title": "Lights Out \u2014 Dark Mode", "default_popup": "scripts/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}