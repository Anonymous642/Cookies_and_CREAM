{"manifest_version": 3, "name": "YouTube Query Cleaner", "short_name": "YT Cleaner", "version": "1.0.0", "description": "Remove unwanted query parameters like list from YouTube URLs.", "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "background": {"scripts": ["background.js", "lib/common.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"], "js": ["lib/common.js", "content.js"], "run_at": "document_start"}], "action": {"default_title": "YouTube Query Cleaner", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "@youtube-query-cleaner.NQxNQ", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}