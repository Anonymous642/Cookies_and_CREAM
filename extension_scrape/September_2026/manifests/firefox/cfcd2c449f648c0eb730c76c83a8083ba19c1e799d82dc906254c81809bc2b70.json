{"manifest_version": 2, "name": "CP Timer", "version": "1.0.0", "description": "Auto-start timer for competitive programming platforms. Tracks time spent on each problem with attempt counting. Supports Codeforces, LeetCode, AtCoder, and CodeChef.", "author": "Anurag", "homepage_url": "https://github.com/anurag", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://codeforces.com/contest/*/problem/*", "*://codeforces.com/problemset/problem/*/*", "*://codeforces.com/gym/*/problem/*", "*://leetcode.com/problems/*", "*://atcoder.jp/contests/*/tasks/*", "*://www.codechef.com/problems/*", "*://www.codechef.com/*/problems/*", "*://codechef.com/problems/*", "*://codechef.com/*/problems/*"], "js": ["content.js"], "css": ["timer.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "cp-timer@anurag", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}