{"manifest_version": 3, "name": "No Aliexpress Bundle Deals", "version": "1.0.0", "description": "Skips the AliExpress bundle-deal landing page ('/ssr/') and goes straight to the single product page.", "browser_specific_settings": {"gecko": {"id": "no-aliexpress-bundle-deals@tom.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "tabs"], "host_permissions": ["https://www.aliexpress.com/ssr/*"], "background": {"scripts": ["background.js"]}}