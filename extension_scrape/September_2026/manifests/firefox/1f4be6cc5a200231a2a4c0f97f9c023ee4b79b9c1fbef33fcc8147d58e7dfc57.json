{"manifest_version": 2, "name": "Alex Rakib Smart Upload Assistant for Firefox", "short_name": "AR Upload", "description": "Connect YouTube Studio to the Alex Rakib local companion app for queued metadata, thumbnails, and videos.", "author": "Alex Rakib", "version": "1.4.5", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "Alex Rakib Smart Upload Assistant", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"scripts": ["validation.js", "service-worker.js"], "persistent": false}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["validation.js", "content-script.js"], "run_at": "document_idle"}], "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "https://studio.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*", "file:///*"], "browser_specific_settings": {"gecko": {"id": "alex-rakib-smart-upload@firefox.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}