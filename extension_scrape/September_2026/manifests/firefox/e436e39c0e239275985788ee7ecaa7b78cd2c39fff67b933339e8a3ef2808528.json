{"manifest_version": 2, "name": "FEPWeb CMS Digital Signature Extension", "description": "This extension is used to digitally sign documents with digital certificates.", "version": "1.3.3", "browser_specific_settings": {"gecko": {"id": "fepweb-cms-digital-signature@fepweb.com.br", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_icon": "fepweb-120x120.png", "default_popup": "popup.html", "default_title": "Click to see FEPWeb extension information."}, "background": {"scripts": ["background.js"]}, "icons": {"48": "fepweb-48x48.png", "120": "fepweb-120x120.png"}, "permissions": ["nativeMessaging", "tabs", "activeTab", "http://*/", "https://*/", "file://*/"], "web_accessible_resources": ["logo_fepweb.png"], "content_scripts": [{"all_frames": true, "matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"]}]}