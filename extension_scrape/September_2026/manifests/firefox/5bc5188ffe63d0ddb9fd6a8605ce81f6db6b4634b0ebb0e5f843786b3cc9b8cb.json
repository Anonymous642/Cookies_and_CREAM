{"manifest_version": 2, "name": "Smart Image Renamer", "version": "1.1.4", "description": "Renames generic image filenames on download. Optional anonymized telemetry is available only with explicit user consent. Pilot version.", "browser_specific_settings": {"gecko": {"id": "smart-image-renamer@yourdomain.local", "data_collection_permissions": {"required": ["none"], "optional": ["websiteActivity"]}}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "128": "icon-128.png"}, "permissions": ["downloads", "menus", "contextMenus", "storage", "https://script.google.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}}