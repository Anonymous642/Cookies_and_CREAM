{"manifest_version": 3, "name": "Kortingscodeheld Code Check", "version": "1.0.0", "description": "Toont een knop in winkelwagen- en checkoutpagina's om actuele kortingscodes op kortingscodeheld.nl te controleren.", "homepage_url": "https://kortingscodeheld.nl/", "icons": {"32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "kortingscode-checker@kortingscodeheld.nl", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}