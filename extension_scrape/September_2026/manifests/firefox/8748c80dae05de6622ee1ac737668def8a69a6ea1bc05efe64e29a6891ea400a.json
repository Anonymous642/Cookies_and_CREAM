{"manifest_version": 3, "name": "Long Shorts", "version": "1.0.0", "description": "Opens YouTube Shorts in the regular video player instead of the endless Shorts feed.", "homepage_url": "https://github.com/Lireer/long-shorts", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["declarativeNetRequestWithHostAccess", "storage"], "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"], "declarative_net_request": {"rule_resources": [{"id": "shorts", "enabled": true, "path": "rules.json"}]}, "background": {"scripts": ["settings.js", "background.js"]}, "action": {"default_icon": "icon.svg", "default_title": "Long Shorts", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["settings.js", "content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "long-shorts@lireer.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}