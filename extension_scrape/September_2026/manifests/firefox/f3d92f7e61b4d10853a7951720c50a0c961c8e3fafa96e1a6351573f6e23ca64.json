{"manifest_version": 3, "name": "Rollplay", "version": "1.0.4", "description": "Play your RPG character right now. Solo RPG adventures with your D&D Beyond character.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["scripting", "tabs"], "host_permissions": ["https://www.dndbeyond.com/*", "http://localhost/*", "https://ai-gamemaster-web.vercel.app/*", "https://rollplay.app/*", "https://dungeonsma.sh/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.dndbeyond.com/characters/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED"}], "action": {"default_popup": "popup.html", "default_title": "Rollplay"}, "web_accessible_resources": [{"resources": ["web-bridge.js"], "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://ai-gamemaster-web.vercel.app/*", "https://rollplay.app/*", "https://dungeonsma.sh/*"]}], "externally_connectable": {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://ai-gamemaster-web.vercel.app/*", "https://rollplay.app/*", "https://dungeonsma.sh/*"]}, "browser_specific_settings": {"gecko": {"id": "rollplay@rollplay.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}