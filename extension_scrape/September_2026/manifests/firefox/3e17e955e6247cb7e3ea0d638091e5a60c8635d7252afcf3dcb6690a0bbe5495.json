{"manifest_version": 3, "name": "AdsSnap Capture", "short_name": "AdsSnap", "version": "2.1.0", "description": "Preview ad creatives on real websites. See how your image, HTML5, VAST, MRAID, or tag ads look across desktop, tablet and mobile.", "browser_specific_settings": {"gecko": {"id": "adsnap@enygma.ca", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "activeTab", "scripting", "storage", "notifications", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://adsnap.enygma.ca/*", "http://localhost:3000/adsnap/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "AdsSnap Capture", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}