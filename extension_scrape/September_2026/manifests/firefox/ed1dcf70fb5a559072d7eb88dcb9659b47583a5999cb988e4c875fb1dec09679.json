{"manifest_version": 3, "name": "Curyloop", "description": "Quickly save links to your Curyloop sessions while browsing.", "version": "1.0.12", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "contextMenus", "storage", "cookies"], "host_permissions": ["https://curyloop.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"scripts": ["lib/config.js", "lib/api.js", "background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "extension@curyloop.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}}