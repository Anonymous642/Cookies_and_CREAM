{"manifest_version": 3, "name": "PromptIT \u2014 Improve Your Prompts", "version": "1.2.0", "description": "Instantly upgrade weak prompts into structured, high-quality prompts inside ChatGPT.", "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"], "js": ["utils/promptFormatter.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "permissions": ["cookies", "storage"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://promptitin.com/*", "*://www.promptitin.com/*"], "web_accessible_resources": [{"resources": ["icons/icon128.png"], "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "promptit@promptitin.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["personalCommunications", "authenticationInfo", "personallyIdentifyingInfo"]}}}}