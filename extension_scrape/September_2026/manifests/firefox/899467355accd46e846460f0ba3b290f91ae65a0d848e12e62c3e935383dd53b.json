{"manifest_version": 3, "name": "Webpage Summarizer (Private)", "version": "1.1", "description": "Summarize the current webpage using your own OpenAI API key.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"48": "icon.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Summarize this page", "default_icon": "icon.png"}, "commands": {"summarize_page": {"suggested_key": {"default": "Alt+S"}, "description": "Summarize the current webpage"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "webpage-summarizer-private@localextensions.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}