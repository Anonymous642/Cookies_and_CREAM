{"manifest_version": 3, "name": "Clean New Tab by Entireweb", "description": "Replaces your new tab page with a clean and fast search experience. Uses Entireweb.com as the default search engine in Firefox.", "version": "2.3.0", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["search"], "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Clean New Tab by Entireweb"}, "chrome_settings_overrides": {"search_provider": {"name": "Entireweb", "keyword": "entireweb", "search_url": "https://www.entireweb.com/search?q={searchTerms}", "favicon_url": "/favicon.ico", "is_default": true}}, "browser_specific_settings": {"gecko": {"id": "clean-newtab-entireweb@example.com", "strict_min_version": "109.0"}}}