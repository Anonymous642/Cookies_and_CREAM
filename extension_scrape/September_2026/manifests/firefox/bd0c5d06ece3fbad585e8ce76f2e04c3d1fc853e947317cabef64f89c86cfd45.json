{"manifest_version": 3, "name": "Chess.com Elo Hider", "version": "1.1.1", "description": "Locally hides Chess.com Elo ratings and post-game rating changes in Firefox, Chrome, and Edge.", "permissions": ["storage"], "host_permissions": ["*://*.chess.com/*"], "browser_specific_settings": {"gecko": {"id": "chesscom-elo-hider@local", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Chess.com Elo Hider", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.chess.com/*"], "js": ["content.js"], "run_at": "document_start"}]}