{"description": "A Surfbank extension built with React 17, Webpack 5, and Webpack Dev Server 4", "version": "5.0.5", "manifest_version": 3, "name": "Surfbank extension", "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["browser-polyfill.js", "background.bundle.js"]}, "action": {"default_popup": "popup.html", "default_icon": "icon-34.png"}, "icons": {"128": "icon-128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "<all_urls>"], "js": ["contentScript.bundle.js"], "css": ["content.styles.css"]}], "web_accessible_resources": [{"resources": ["content.styles.css", "icon-128.png", "icon-34.png"], "matches": ["http://*/*"]}], "permissions": ["management", "tabs", "storage"], "host_permissions": ["https://cors-anywhere.herokuapp.com/https://stage-api.surfbank.org/", "https://stage.surfbank.org/*"], "browser_specific_settings": {"gecko": {"id": "support@surfbank.org"}}}