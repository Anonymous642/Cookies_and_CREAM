{"manifest_version": 2, "name": "Query Evolution Tracker", "version": "1.3", "description": "A Firefox extension to track, record, and map how your search queries evolve during deep web research sessions.", "browser_action": {"default_icon": "icons/logo_64.png", "default_title": "Query Evolution Tracker", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "permissions": ["activeTab", "storage", "notifications", "webNavigation", "contextMenus"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Query-Evolution-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}