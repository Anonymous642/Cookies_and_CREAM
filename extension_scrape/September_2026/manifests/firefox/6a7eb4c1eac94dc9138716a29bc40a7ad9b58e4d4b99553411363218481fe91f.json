{"manifest_version": 2, "name": "Itch.io Genre Filter", "version": "2.0.0", "description": "Persistent itch.io genre blacklist with censoring, quick-add controls, per-game whitelist, and saved settings.", "permissions": ["storage", "https://itch.io/*"], "browser_action": {"default_title": "Itch.io Genre Filter", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://itch.io/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "itch-genre-filter@spiralworld.ch", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "author": "Fentra Bishh", "homepage_url": "https://spiralworld.ch/"}