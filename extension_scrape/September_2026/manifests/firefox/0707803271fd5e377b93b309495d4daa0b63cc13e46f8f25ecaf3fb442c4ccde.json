{"manifest_version": 3, "name": "FactorCat - MFA Authenticator", "description": "Detects MFA fields, sends a push to approve, and auto-fills the code. TOTP secrets never touch the browser. Free to use.", "version": "1.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "extension@factorcat.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "externally_connectable": {"matches": ["https://app.factorcat.com/*", "http://localhost:9000/*"]}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "FactorCat", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}