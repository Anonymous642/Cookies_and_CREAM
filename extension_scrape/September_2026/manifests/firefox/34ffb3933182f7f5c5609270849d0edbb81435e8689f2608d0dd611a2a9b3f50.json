{"manifest_version": 3, "name": "Clean Link Copier", "version": "1.0.0", "description": "Copy a tracking-free version of the current page URL. Data stays local; no network requests.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "clipboardWrite"], "action": {"default_title": "Clean Link Copier", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "clean-link-copier@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}