{"manifest_version": 2, "name": "FB Marketplace Tracker", "version": "1.0.1", "description": "Track Facebook Marketplace listings for price changes and sold/removed events.", "browser_specific_settings": {"gecko": {"id": "marketplacewatcher@lennacodes", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "notifications", "tabs", "*://www.facebook.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://www.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "FB Marketplace Tracker"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "commands": {"track-current-listing": {"suggested_key": {"default": "Alt+T"}, "description": "Track the current Marketplace listing"}}}