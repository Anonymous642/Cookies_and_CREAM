{"manifest_version": 3, "name": "Pinpoint", "description": "Point at any element on your live site, comment, and hand off agent-ready tasks \u2014 nothing leaves your machine.", "author": "Tomer Danan", "homepage_url": "https://pinpoint.dananz.com", "browser_specific_settings": {"gecko": {"id": "pinpoint@dananz.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Pinpoint \u2014 off (click to enable)", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "theme_icons": [{"light": "assets/icons/icon-light-16.png", "dark": "assets/icons/icon-dark-16.png", "size": 16}, {"light": "assets/icons/icon-light-32.png", "dark": "assets/icons/icon-dark-32.png", "size": 32}]}, "background": {"scripts": ["src/background/service-worker.js"]}, "commands": {"toggle-widget": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle the Pinpoint widget"}}, "content_scripts": [{"matches": ["<all_urls>", "file:///*"], "js": ["src/content/index.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["<all_urls>", "file:///*"], "js": ["src/content/bridge.js"], "run_at": "document_start"}], "host_permissions": ["<all_urls>", "file:///*"], "permissions": ["activeTab", "scripting", "storage", "downloads"], "version": "0.7.22"}