{"manifest_version": 2, "name": "Qobuz Downloader", "version": "1.0", "description": "Adds a download button to Qobuz album pages, sending the URL to a running qobuz-dl-web instance.", "permissions": ["storage", "<all_urls>"], "content_scripts": [{"matches": ["https://play.qobuz.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Qobuz Downloader", "default_popup": "popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "qobuz-dl-web@extension", "data_collection_permissions": {"required": ["none"], "optional": []}}}}