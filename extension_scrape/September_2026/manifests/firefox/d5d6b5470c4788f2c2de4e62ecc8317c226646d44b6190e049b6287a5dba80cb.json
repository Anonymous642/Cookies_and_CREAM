{"manifest_version": 2, "name": "Daily Gratitude Prompt", "version": "1.3", "description": "Receive a daily prompt to write down things you're grateful for. Save, review, export, or clear your gratitude entries.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "alarms", "notifications"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Daily Gratitude Prompt", "default_popup": "popup.html"}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "@Daily-Gratitude-Prompt", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}