{"manifest_version": 3, "name": "SECFetcher", "short_name": "SECFetcher", "version": "1.3", "description": "Fast SEC EDGAR lookup for reports, events, proxies, insider, offering, ownership, and foreign issuer filings.", "homepage_url": "https://github.com/jishangiras/SECFetcher", "permissions": ["storage", "downloads"], "host_permissions": ["https://www.sec.gov/*", "https://data.sec.gov/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "SECFetcher"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "secfetcher@jishangiras.com", "data_collection_permissions": {"required": ["none"], "optional": []}, "strict_min_version": "140.0"}, "gecko_android": {"data_collection_permissions": {"required": ["none"], "optional": []}, "strict_min_version": "142.0"}}}