{"manifest_version": 2, "name": "Instagram Local Comment Picker", "version": "2.0.0", "description": "Scanne les commentaires d'une publication Instagram et tire un gagnant au sort.", "icons": {"48": "icons/icon-48.png"}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"32": "icons/icon-32.png"}, "default_title": "Insta Comment Scan", "default_popup": "popup.html"}, "permissions": ["storage", "downloads", "tabs"], "browser_specific_settings": {"gecko": {"id": "insta-comment-scan@wasuno", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.instagram.com/*"], "js": ["probe.js", "content.js"], "run_at": "document_idle"}]}