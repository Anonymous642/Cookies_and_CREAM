{"manifest_version": 3, "name": "Dmizy \u2014 X/Twitter Cold Outreach Tool", "description": "All-in-one X/Twitter outreach: lead finder, search, replies, community members, profile enrichment, and DM automation.", "version": "2.9.0", "browser_specific_settings": {"gecko": {"id": "dmizy@dmizy.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "icons/icon-128.png", "default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "webRequest", "cookies", "tabs", "unlimitedStorage", "alarms"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*", "https://my.dmizy.com/*", "https://my.talktry.com/*"], "background": {"scripts": ["billing/plans.js", "billing/license.js", "billing/quota.js", "background/background.js"]}, "content_scripts": [{"run_at": "document_end", "matches": ["https://*.twitter.com/*", "https://*.x.com/*"], "js": ["billing/plans.js", "billing/license.js", "billing/quota.js", "content/followers.js", "content/search.js", "content/replies.js", "content/community.js", "content/enrich.js", "content/dm-automation.js", "content/dm-scanner.js"], "css": ["content/followers.css", "content/search.css", "content/replies.css", "content/community.css"]}, {"run_at": "document_start", "matches": ["https://my.dmizy.com/*"], "js": ["content/bridge.js"]}], "web_accessible_resources": [{"resources": ["content/followers.css", "content/search.css", "content/replies.css", "content/community.css", "icons/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}