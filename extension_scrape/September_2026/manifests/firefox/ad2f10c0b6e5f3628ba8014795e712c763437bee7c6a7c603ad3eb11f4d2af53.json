{"manifest_version": 3, "name": "VOID MASTER: Twitch Edition", "description": "A universal override. Mutes ads and collects points.", "version": "2.5", "permissions": ["storage", "tabs", "notifications"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"500": "icon.png"}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "void-master-twitch@extension.local", "data_collection_permissions": {"required": ["none"]}}}}