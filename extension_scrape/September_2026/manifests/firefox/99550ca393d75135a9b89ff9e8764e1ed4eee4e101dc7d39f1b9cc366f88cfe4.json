{"manifest_version": 3, "name": "Aar318's Stream Notifier", "version": "3.42.0.9", "description": "Get desktop notifications for Kick and Twitch streamers.", "permissions": ["activeTab", "contextMenus", "notifications", "storage", "scripting"], "host_permissions": ["https://*.twitch.tv/*", "https://*.kick.com/*", "https://gql.twitch.tv/gql", "*://*/*"], "content_scripts": [{"matches": ["https://*.twitch.tv/*", "https://*.kick.com/*", "*://*/*"], "js": ["stream-notifier.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Open Aar318's Stream Notifier"}, "browser_specific_settings": {"gecko": {"id": "stream-notifier@aar318", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}