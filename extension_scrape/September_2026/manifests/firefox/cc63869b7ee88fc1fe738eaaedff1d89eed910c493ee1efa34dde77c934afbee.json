{"manifest_version": 2, "name": "Prezzoforte Extension", "version": "1.0", "description": "Aiuta i clienti a trovare prodotti e promozioni sul sito di Prezzoforte.", "icons": {"48": "images/icon.png", "96": "images/icon.png"}, "permissions": ["activeTab", "tabs", "*://*.prezzoforte.it/*"], "browser_action": {"default_popup": "popup.html", "default_icon": "images/icon.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.prezzoforte.it/*"], "js": ["content.js"]}], "web_accessible_resources": ["images/*"], "browser_specific_settings": {"gecko": {"id": "prezzofortefinder@example.com"}}}