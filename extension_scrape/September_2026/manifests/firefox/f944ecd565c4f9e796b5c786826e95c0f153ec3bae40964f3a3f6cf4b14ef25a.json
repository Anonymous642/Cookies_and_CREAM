{"manifest_version": 3, "name": "Fulcrum", "version": "1.0", "description": "Per-domain scroll speed. Too fast on Slack, too slow on docs \u2014 Fulcrum remembers each site's preference and applies it automatically.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Fulcrum", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "fulcrum1@extensions", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}