{"manifest_version": 3, "name": "X Ad Block", "version": "1.0.0", "description": "Blocks promoted, boosted, sponsored, and paid-partnership content on X.", "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["src/rules.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "action": {"default_title": "X Ad Block", "default_popup": "ui/popup.html"}, "options_ui": {"page": "ui/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "xadblock@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}