{"manifest_version": 2, "name": "Permaref", "version": "1.0.0", "description": "Zitiere die Quelle. Bewahre die Seite. \u2013 Ein Klick archiviert und generiert die fertige Zitation.", "author": "Permaref (hilfe@permaref.de)", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.svg"}, "default_title": "Permaref \u2013 Quelle archivieren & zitieren"}, "permissions": ["activeTab", "clipboardWrite", "storage", "tabs"], "background": {"scripts": ["background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "addon@permaref.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}