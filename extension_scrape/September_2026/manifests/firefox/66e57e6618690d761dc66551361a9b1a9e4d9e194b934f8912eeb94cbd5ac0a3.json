{"manifest_version": 3, "name": "Tabs Tray", "version": "0.2.4", "author": "Dylan Ulster", "homepage_url": "https://github.com/TabsTray", "description": "View current tabs with titles and thumbnails using a full window.", "permissions": ["tabs", "storage", "activeTab", "scripting", "sessions", "tabGroups", "menus"], "action": {"default_title": "Tabs Tray", "default_icon": "icons/icon.svg"}, "options_ui": {"page": "/pages/options.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+W"}, "description": "Open Tabs Tray"}}, "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "webext@com.github.du33169.TabsTray", "strict_min_version": "126.0"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}}