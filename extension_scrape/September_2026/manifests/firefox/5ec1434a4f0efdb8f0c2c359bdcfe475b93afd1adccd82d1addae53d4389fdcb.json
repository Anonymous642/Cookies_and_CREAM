{"manifest_version": 3, "name": "NoaNet CID Autofill", "version": "1.0.0", "description": "Autofills a ServiceNow incident from the Circuit ID (CID) entered in the Configuration item field.", "browser_specific_settings": {"gecko": {"id": "noanet-cid-autofill@snowy", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.service-now.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["*://*.service-now.com/*"]}]}