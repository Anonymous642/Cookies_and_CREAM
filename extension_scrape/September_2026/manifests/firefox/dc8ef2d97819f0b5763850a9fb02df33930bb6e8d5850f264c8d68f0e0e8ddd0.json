{"manifest_version": 3, "name": "Reddit Sign-In Popup Blocker", "short_name": "Reddit Popup Blocker", "version": "1.0.3", "description": "Removes Reddit's blocking sign-in popup while browsing logged out.", "browser_specific_settings": {"gecko": {"id": "reddit-sign-in-popup-blocker@ariorostami.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://reddit.com/*"], "js": ["src/blocker.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_start"}]}