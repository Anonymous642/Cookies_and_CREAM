{"manifest_version": 3, "name": "Supermarket Price Matcher", "version": "1.0", "description": "Compares live product prices across Woolworths, Coles, Aldi and Harris Farm and highlights the cheapest by unit price.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "compare.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "supermarket-price-matcher@supermaket-matcher", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://*.woolworths.com.au/*", "https://*.coles.com.au/*", "https://*.aldi.com.au/*", "https://*.harrisfarm.com.au/*"]}