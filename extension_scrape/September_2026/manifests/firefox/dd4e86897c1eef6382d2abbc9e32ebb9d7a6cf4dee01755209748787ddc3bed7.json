{"manifest_version": 2, "name": "UGY Vault - Auto-remplissage", "version": "1.0.0", "description": "Remplissage automatique des mots de passe depuis le coffre-fort UGY", "browser_specific_settings": {"gecko": {"id": "ugy-vault@briac", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "contextMenus", "webRequest", "*://*/*"], "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_popup": "popup/popup.html", "default_title": "UGY Vault"}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}