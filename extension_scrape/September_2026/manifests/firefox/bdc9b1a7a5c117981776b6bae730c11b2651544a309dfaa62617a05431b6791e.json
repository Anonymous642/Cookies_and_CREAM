{"manifest_version": 2, "name": "Instant Cast Link", "version": "1.0", "description": "Create a shareable link to the current video timestamp + small thumbnail; copy to clipboard.", "permissions": ["activeTab", "storage", "tabs", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Instant Cast Link", "default_popup": "popup.html"}, "icons": {"48": "icons/icon-48.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "instantcast@example.com", "data_collection_permissions": {"required": ["none"]}}}}