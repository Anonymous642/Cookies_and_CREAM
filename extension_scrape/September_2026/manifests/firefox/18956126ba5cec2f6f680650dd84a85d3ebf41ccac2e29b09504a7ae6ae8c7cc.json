{"manifest_version": 2, "name": "Focus Mode", "version": "1.0", "description": "\u1ea8n c\u00e1c th\u00e0nh ph\u1ea7n g\u00e2y xao nh\u00e3ng (header, footer, sidebar) \u0111\u1ec3 t\u1eadp trung \u0111\u1ecdc. Kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u.", "permissions": ["activeTab", "tabs"], "browser_action": {"default_title": "Focus Mode"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@focus-mode", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}