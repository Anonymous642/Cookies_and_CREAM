{"manifest_version": 2, "name": "Contextual Fact-Checker", "version": "2.3", "description": "V\u00e9rifie la v\u00e9racit\u00e9 des textes s\u00e9lectionn\u00e9s via Groq (gratuit, sans CB).", "permissions": ["contextMenus", "activeTab", "storage", "https://api.groq.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"]}], "icons": {"128": "icon.png"}, "browser_action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "FactChecker@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "privacy_policy_url": ""}}}}