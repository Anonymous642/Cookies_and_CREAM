{"manifest_version": 3, "name": "Tap26 \u2013 URL Shortener & Link Tracker", "short_name": "Tap26", "description": "Shorten, manage, protect, and track links directly from your browser.", "version": "0.1.1", "browser_specific_settings": {"gecko": {"id": "webextension@tap26.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "Tap26", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "alarms", "activeTab", "contextMenus", "notifications", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://tap26.com/*"], "content_scripts": [{"matches": ["https://tap26.com/*"], "js": ["auth-relay.js"], "run_at": "document_start"}]}