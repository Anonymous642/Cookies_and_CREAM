{"manifest_version": 2, "name": "Clasificador de Zonas RM", "version": "1.1.0", "description": "Herramienta interna de logistica: indica a que zona de reparto pertenece cada direccion de la Region Metropolitana y su distancia al punto de origen. Funciona sin conexion.", "browser_specific_settings": {"gecko": {"id": "clasificador-zonas-rm@logistica.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "115.0"}}, "permissions": ["https://login-microfrontend.ecomm.cencosud.com/*"], "content_scripts": [{"matches": ["https://login-microfrontend.ecomm.cencosud.com/*"], "js": ["zonas.js", "callejero.js", "zonas-firefox.js"], "run_at": "document_idle"}], "icons": {"48": "icon-48.png", "96": "icon-96.png"}}