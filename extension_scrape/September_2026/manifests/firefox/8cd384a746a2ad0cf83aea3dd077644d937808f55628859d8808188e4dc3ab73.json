{"manifest_version": 3, "name": "Shield: AI Privacy for ChatGPT & Claude", "short_name": "Shield", "version": "1.2.2", "description": "Stop sharing sensitive data with AI tools. Auto-masks API keys, passwords & personal info in ChatGPT, Claude & Gemini. Free.", "browser_specific_settings": {"gecko": {"id": "shield@infinium.tools", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "InfiniUm Shield \u2014 AI Privacy Firewall"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["src/anonymizer.js", "src/content.js"], "run_at": "document_idle"}], "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://infinium.tools/*"]}