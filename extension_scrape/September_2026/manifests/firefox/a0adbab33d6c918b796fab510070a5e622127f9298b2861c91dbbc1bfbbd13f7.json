{"manifest_version": 2, "name": "Cronometer Uploading Utility", "version": "0.1.0", "description": "Copy supported dining nutrition data and recipe payloads into Cronometer custom foods.", "browser_action": {"default_title": "Cronometer Uploading Utility", "default_popup": "popup/popup.html"}, "permissions": ["activeTab", "storage", "clipboardRead", "clipboardWrite", "https://dining.purdue.edu/*", "https://dining.ucla.edu/*", "https://cronometer.com/*"], "browser_specific_settings": {"gecko": {"id": "cronometer-uploading-utility@example.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://dining.purdue.edu/menus/item/*"], "css": ["styles/injected.css"], "js": ["content/purdueContent.js"]}, {"matches": ["https://dining.ucla.edu/menu-item/*"], "css": ["styles/injected.css"], "js": ["content/uclaContent.js"]}, {"matches": ["https://cronometer.com/*"], "css": ["styles/injected.css"], "js": ["content/cronometerContent.js"]}]}