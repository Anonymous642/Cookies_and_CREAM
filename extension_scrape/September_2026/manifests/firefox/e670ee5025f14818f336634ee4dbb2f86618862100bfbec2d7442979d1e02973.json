{"manifest_version": 3, "name": "ArchiveApp: Save articles", "version": "0.2.2", "description": "Save web articles and images to your hosted ArchiveApp reading library.", "permissions": ["storage", "clipboardWrite", "activeTab", "scripting", "identity", "notifications", "contextMenus", "bookmarks"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Save to ArchiveApp", "default_icon": {"16": "icons/unsaved-tile-16.png", "32": "icons/unsaved-tile-32.png", "64": "icons/unsaved-tile-64.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "commands": {"save-page": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Save the current page to ArchiveApp"}}, "icons": {"48": "icons/archiveapp-aa-48.png", "96": "icons/archiveapp-aa-96.png", "128": "icons/archiveapp-aa-128.png"}, "browser_specific_settings": {"gecko": {"id": "archiveapp@archiveapp.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}