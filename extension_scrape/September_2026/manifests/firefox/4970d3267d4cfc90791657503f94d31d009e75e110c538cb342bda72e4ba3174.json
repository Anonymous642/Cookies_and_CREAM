{"manifest_version": 3, "name": "Audiobookshelf on YouTube", "version": "1.2.2", "description": "Shows your Audiobookshelf library on YouTube \u2014 a shelf on the homepage and a Continue-listening panel on watch pages. Click a book to open and auto-play it.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "scripting", "webRequest", "webRequestBlocking"], "host_permissions": ["*://www.youtube.com/*"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Audiobookshelf on YouTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "{3be32dd3-3a9b-45cd-afd8-9dc134fa081d}", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}