{"manifest_version": 3, "name": "TBX Inventory Checker", "version": "1.0.0", "description": "Shows TBX inventory when viewing parts pages on Aircraft Spruce.", "permissions": ["storage"], "host_permissions": ["https://www.aircraftspruce.com/*", "https://aircraftspruce.com/*"], "background": {"scripts": ["papaparse.min.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.aircraftspruce.com/*", "https://aircraftspruce.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tbx-inventory-checker@yourshop.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}