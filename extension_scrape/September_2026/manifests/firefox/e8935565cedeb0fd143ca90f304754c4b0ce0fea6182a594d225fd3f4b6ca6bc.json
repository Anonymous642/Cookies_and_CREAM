{"manifest_version": 3, "name": "Timether", "version": "0.1.3", "description": "Track time from GitHub, Jira, Linear, Trello, and Notion with Timether.", "permissions": ["storage", "identity", "tabs"], "host_permissions": ["https://github.com/*", "https://*.github.com/*", "https://*.atlassian.net/*", "https://linear.app/*", "https://trello.com/*", "https://app.notion.com/*", "https://www.notion.so/*", "https://*.notion.site/*", "https://api.timether.com/*", "https://app.timether.com/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "action": {"default_title": "Timether", "default_popup": "popup.html"}, "options_page": "options.html", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://github.com/*", "https://*.github.com/*", "https://*.atlassian.net/*", "https://linear.app/*", "https://trello.com/*", "https://app.notion.com/*", "https://www.notion.so/*", "https://*.notion.site/*"], "js": ["src/adapters.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "timether-firefox@timether.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}