{"manifest_version": 3, "name": "Listing Gator", "version": "0.0.1", "description": "Download a summary of viewed Zillow data.", "icons": {"48": "gator_profile_48x48.png"}, "action": {"default_title": "Listing Gator", "default_icon": {"48": "gator_profile_48x48.png"}, "default_popup": "popup.html"}, "permissions": ["scripting", "activeTab"], "host_permissions": ["https://www.zillow.com/*", "https://zillow.com/*"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "listinggator@example.org"}}, "content_scripts": [{"matches": ["https://www.zillow.com/*", "https://zillow.com/*"], "js": ["contentRelay.js"], "run_at": "document_end"}]}