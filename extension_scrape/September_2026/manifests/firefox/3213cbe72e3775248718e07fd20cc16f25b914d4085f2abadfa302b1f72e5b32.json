{"manifest_version": 3, "name": "AudioTabs - Volume Booster & Manager", "version": "1.0.3", "description": "Boost volume up to 600% on any tab. Works on YouTube, Twitch, Spotify, and Web Games.", "permissions": ["tabs", "storage", "scripting", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "AudioTabs", "default_icon": "icon.svg"}, "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "volume-master-v2@owlsoftware.com", "data_collection_permissions": {"required": ["none"], "optional": []}, "strict_min_version": "115.0"}}}