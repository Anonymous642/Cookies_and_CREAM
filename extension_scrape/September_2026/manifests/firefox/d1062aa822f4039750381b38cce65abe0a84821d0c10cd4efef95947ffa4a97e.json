{"manifest_version": 3, "name": "Quick Bookmark + Tags", "version": "1.0.1", "description": "L\u01b0u bookmark nhanh v\u1edbi tag, t\u00ecm v\u00e0 m\u1edf t\u1eeb popup. Thi\u1ebft k\u1ebf \u0111\u1ec3 t\u01b0\u01a1ng th\u00edch v\u1edbi AMO (Firefox).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "quick-bookmark-tags@example.com", "strict_min_version": "91.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}