{"manifest_version": 3, "name": "LeetCode GitHub Sync", "version": "1.0.0", "description": "Automatically track accepted LeetCode submissions and sync solutions into your GitHub repository with deduplication, resumability, and rate-limiting.", "browser_specific_settings": {"gecko": {"id": "leetcode-github-sync@mkpg.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "identity", "notifications", "tabs"], "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*", "https://github.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://github.com/login/device*"], "js": ["github-auth-helper.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "LeetCode GitHub Sync", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}