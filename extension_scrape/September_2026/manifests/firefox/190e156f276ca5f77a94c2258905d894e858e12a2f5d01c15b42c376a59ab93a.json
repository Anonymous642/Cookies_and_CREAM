{"manifest_version": 2, "name": "Caido Extension", "description": "Browser extension to proxy to Caido", "version": "0.1.1", "icons": {"16": "/assets/images/icon_16x16.png", "32": "/assets/images/icon_32x32.png", "48": "/assets/images/icon_48x48.png", "128": "/assets/images/icon_128x128.png"}, "permissions": ["proxy", "storage"], "browser_specific_settings": {"gecko": {"id": "extension@caido.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Caido", "default_popup": "popup.html"}}