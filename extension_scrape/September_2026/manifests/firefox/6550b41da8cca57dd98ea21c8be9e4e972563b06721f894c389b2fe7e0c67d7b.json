{"manifest_version": 2, "name": "ChatGPT TurboRender", "description": "Keep long ChatGPT conversations responsive by parking cold history blocks and restoring them on demand.", "version": "1.0.0", "short_name": "TurboRender", "icons": {"16": "/favicon.png", "32": "/favicon.png", "48": "/favicon.png", "128": "/favicon_128x128.png"}, "permissions": ["storage", "scripting", "https://chatgpt.com/*", "https://chat.openai.com/*"], "web_accessible_resources": ["favicon.png", "favicon_128x128.png"], "browser_specific_settings": {"gecko": {"id": "chatgpt-turborender@mo2g.dev"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "ChatGPT TurboRender", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "run_at": "document_start", "js": ["content-scripts/chatgpt-bootstrap.js"], "world": "MAIN"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "run_at": "document_start", "js": ["content-scripts/chatgpt.js"]}]}