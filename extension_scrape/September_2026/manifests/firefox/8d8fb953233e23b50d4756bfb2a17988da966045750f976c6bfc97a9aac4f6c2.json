{"manifest_version": 3, "name": "EgideCyber Mail", "version": "0.4.3", "description": "Protection anti-phishing temps r\u00e9el dans Gmail, Outlook, Yahoo et tous les webmails. D\u00e9tection par IA en un clic.", "browser_specific_settings": {"gecko": {"id": "egide-mail@egidecyber.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "websiteContent"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "EgideCyber Mail", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content/gmail.js"], "run_at": "document_idle"}, {"matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content/outlook-web.js"], "run_at": "document_idle"}, {"matches": ["https://mail.yahoo.com/*"], "js": ["content/yahoo.js"], "run_at": "document_idle"}], "permissions": ["storage", "alarms"], "host_permissions": ["https://egidecyber.com/*"]}