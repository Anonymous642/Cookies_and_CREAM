{"manifest_version": 2, "name": "NoFeed - Foco Total", "version": "1.2", "description": "Remove o feed de not\u00edcias do Facebook, Instagram e YouTube para ajudar na concentra\u00e7\u00e3o, sem coletar dados.", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "nofeed@focototal.extension", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_title": "NoFeed - Foco Total", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}