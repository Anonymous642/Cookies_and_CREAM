{"manifest_version": 3, "name": "Lock-In", "description": "Bloqueie sites com limite de visitas di\u00e1rias para manter o foco", "version": "1.2.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "notifications", "alarms", "tabs", "webNavigation", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["browser-polyfill.js", "background.js"], "service_worker": "background.js", "preferred_environment": ["document"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "web_accessible_resources": [{"resources": ["blocked.html", "blocked.css", "blocked.js"], "matches": ["<all_urls>"]}], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "lock-in@extension", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}