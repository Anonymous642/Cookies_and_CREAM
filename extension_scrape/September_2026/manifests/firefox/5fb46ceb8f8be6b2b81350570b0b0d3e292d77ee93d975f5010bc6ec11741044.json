{"manifest_version": 3, "version": "0.0.3", "name": "Tonic for GitLab", "description": "Focused, configurable improvements for GitLab.", "homepage_url": "https://github.com/beeyev/tonic-for-gitlab", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "permissions": ["storage", "scripting"], "optional_host_permissions": ["http://*/*", "https://*/*"], "content_scripts": [{"matches": ["https://gitlab.com/*"], "js": ["content_scripts/content-0.js"], "css": ["content_scripts/content-0.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/scripts.js"]}, "action": {"default_icon": {"16": "icons/icon16.png", "19": "icons/icon19.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "38": "icons/icon38.png"}, "default_popup": "action/index.html", "default_title": "Tonic for GitLab"}, "browser_specific_settings": {"gecko": {"id": "tonic-for-gitlab@beeyev.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "web_accessible_resources": [{"resources": ["content_scripts/content-0.css"], "matches": ["https://gitlab.com/*"]}]}