{"manifest_version": 3, "name": "Letter Boxed Helper", "short_name": "Letter Boxed Helper", "version": "1.0.0", "description": "Helpful tools for Letter Boxed Puzzle on letterboxedpuzzle.com. Detects the puzzle board and provides quick links to the solver, hints, and game modes.", "author": "CodeUmabi", "homepage_url": "https://letterboxedpuzzle.com/", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg", "128": "icons/icon-128.svg"}, "browser_specific_settings": {"gecko": {"id": "letter-boxed-helper@codeumabi.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["https://letterboxedpuzzle.com/*", "https://www.letterboxedpuzzle.com/*"], "content_scripts": [{"matches": ["https://letterboxedpuzzle.com/*", "https://www.letterboxedpuzzle.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_title": "Letter Boxed Helper", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}}