{"manifest_version": 2, "name": "Nightify - Beautiful Dark Mode", "version": "2.5", "description": "\u2728 Transform any website with a stunning dark theme. Smart dark mode, blue light filter, and performance first.", "permissions": ["storage", "tabs", "<all_urls>"], "browser_action": {"default_title": "Nightify", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/dark-theme.js"], "css": ["content/dark-theme.css"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "web_accessible_resources": ["content/*.css"], "commands": {"toggle-dark-mode": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Toggle dark mode"}, "reset-filters": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Reset all filters"}}, "author": "Nightify", "browser_specific_settings": {"gecko": {"id": "nightify@nightify.extension", "strict_min_version": "58.0"}}}