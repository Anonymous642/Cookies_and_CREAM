{"manifest_version": 3, "name": "Sluice", "version": "1.0.3", "description": "Send cookies and detected video streams to the Sluice app.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["cookies", "webRequest", "tabs", "storage", "alarms"], "host_permissions": ["<all_urls>", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "sluice@sluice.download", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Sluice \u2014 cookies & streams", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}}