{"manifest_version": 2, "name": "DM Auto-Translator", "version": "1.3", "description": "Automatically detects and translates direct messages into your preferred language in real time, enabling smooth multilingual conversations across messaging platforms.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_title": "DM Auto-Translator", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@DM-Auto-Translator", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}