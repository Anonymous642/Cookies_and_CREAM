{"manifest_version": 3, "name": "Time Warden", "version": "1.1.5", "description": "Track time spent on specific websites and enforce limits with 15-minute extensions.", "browser_specific_settings": {"gecko": {"id": "timekeepertime@vibe", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"96": "logo.png"}, "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Time Warden"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}]}