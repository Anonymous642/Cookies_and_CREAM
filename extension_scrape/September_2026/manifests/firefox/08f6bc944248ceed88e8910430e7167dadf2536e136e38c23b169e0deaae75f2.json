{"manifest_version": 3, "name": "Simbrief Flightradar Integration", "description": "An extension to create Simbrief flightplans from Flightradar24 flights.", "version": "1.1", "icons": {"128": "icon-128.png"}, "permissions": ["contextMenus", "scripting", "webRequest", "storage", "tabs"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "fr24-simbrief@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}