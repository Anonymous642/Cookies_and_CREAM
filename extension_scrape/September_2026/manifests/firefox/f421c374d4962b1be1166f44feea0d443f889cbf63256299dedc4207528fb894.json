{"manifest_version": 2, "name": "Quick Save URLs", "version": "1.0.0", "description": "Save the current tab\u2019s URL and title to a local list you can review or export\u2014no remote servers, no tracking.", "browser_specific_settings": {"gecko": {"id": "quick-save-urls@example.com", "strict_min_version": "109.0"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Quick Save URLs", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": true}, "permissions": ["activeTab", "storage", "tabs", "clipboardWrite"]}