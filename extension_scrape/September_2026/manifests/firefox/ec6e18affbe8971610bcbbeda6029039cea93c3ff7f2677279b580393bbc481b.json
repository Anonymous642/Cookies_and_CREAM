{"manifest_version": 3, "name": "OrdoMark Connector", "version": "1.3.0", "description": "Sync your Etsy shop data (orders, products, reviews) to your OrdoMark account.", "homepage_url": "https://ordomark.com", "browser_specific_settings": {"gecko": {"id": "etsy-connector@ordomark.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "financialAndPaymentInfo", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["https://www.etsy.com/*", "https://api.ordomark.com/*", "https://*.ingest.sentry.io/*", "https://*.ingest.us.sentry.io/*"], "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.etsy.com/your/orders/*", "https://www.etsy.com/your/shops/me/listings*", "https://www.etsy.com/your/shops/me/reviews*", "https://www.etsy.com/your/shops/me/stats*", "https://www.etsy.com/your/shops/me*"], "js": ["src/content/interceptor.js"], "run_at": "document_start"}, {"matches": ["https://www.etsy.com/your/orders/*", "https://www.etsy.com/your/shops/me/listings*", "https://www.etsy.com/your/shops/me/reviews*", "https://www.etsy.com/your/shops/me/stats*", "https://www.etsy.com/your/shops/me*"], "js": ["src/content/extractor.js"], "run_at": "document_idle"}, {"matches": ["https://www.etsy.com/your/orders/sold*"], "js": ["src/content/complete-orders.js"], "run_at": "document_idle"}], "action": {"default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "default_popup": "src/popup/popup.html"}, "web_accessible_resources": [{"resources": ["src/content/page-interceptor.js"], "matches": ["https://www.etsy.com/*"]}], "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}