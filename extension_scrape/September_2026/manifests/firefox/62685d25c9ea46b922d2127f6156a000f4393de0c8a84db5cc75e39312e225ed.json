{"manifest_version": 3, "name": "IP-viewer", "version": "1.0.0", "description": "Click the icon to view your public IPv4 / IPv6 address, location, and ISP. Auto-refreshes on open; manual refresh available.", "browser_specific_settings": {"gecko": {"id": "ip-viewer@example.com", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["locationInfo"]}}}, "action": {"default_title": "View Public IP", "default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "host_permissions": ["https://api.ipify.org/*", "https://api6.ipify.org/*", "https://ipinfo.io/*", "https://ipapi.co/*"]}