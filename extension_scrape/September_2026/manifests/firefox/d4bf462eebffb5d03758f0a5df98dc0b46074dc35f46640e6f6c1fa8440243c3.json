{"manifest_version": 2, "name": "replacely", "description": "A extension to help you learning foreign languages as you browse the web", "version": "0.1.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "@replacely.almenon", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Replacely options", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}