{"manifest_version": 3, "name": "Read Aloud AI", "version": "1.0.2", "description": "Reads articles aloud using OpenAI's text-to-speech API, with local audio history.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"], "host_permissions": ["https://api.openai.com/*", "https://*/*", "http://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_title": "Read Aloud AI", "default_icon": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "read-aloud-tts@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}