{"manifest_version": 3, "name": "Rise", "version": "0.2.3", "description": "Sends YouTube Music and Spotify Web playback to the local Rise Minecraft client.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://music.youtube.com/*", "https://open.spotify.com/*", "http://127.0.0.1:17891/*"], "background": {"scripts": ["core.js", "background.js"]}, "content_scripts": [{"matches": ["https://music.youtube.com/*", "https://open.spotify.com/*"], "js": ["core.js", "content.js"], "run_at": "document_idle"}], "action": {"default_title": "Rise", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "rise-music-companion@riseclient.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}