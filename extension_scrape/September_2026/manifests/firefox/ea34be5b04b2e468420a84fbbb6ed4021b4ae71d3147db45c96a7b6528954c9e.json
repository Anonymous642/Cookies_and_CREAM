{"manifest_version": 3, "name": "ScrapeStudio", "version": "1.0.2", "description": "Turn Inspiration into Production-Ready Code in Seconds!, Extract HTML/CSS, build a personal component library. Try it now!", "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "ScrapeStudio"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "commands": {"activate-picker": {"suggested_key": {"default": "Alt+I"}, "description": "Activate color picker"}, "activate-capture": {"suggested_key": {"default": "Alt+C"}, "description": "Start capture mode"}, "open-settings": {"suggested_key": {"default": "Alt+S"}, "description": "Open settings panel"}}, "permissions": ["clipboardWrite", "storage", "activeTab", "notifications", "tabs", "alarms"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["http://localhost:3000/*", "https://app.www.scrapestudio.co/*", "<all_urls>"], "externally_connectable": {"matches": ["http://localhost:3000/*", "https://app.www.scrapestudio.co/*"]}, "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["icons/logo-icon.svg", "icons/eyedropper.svg", "icons/vue.svg", "icons/svelte.svg", "icons/react.svg", "icons/html.svg"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "scrape-studio-extension@scrapestudio.io", "strict_min_version": "109.0"}}}