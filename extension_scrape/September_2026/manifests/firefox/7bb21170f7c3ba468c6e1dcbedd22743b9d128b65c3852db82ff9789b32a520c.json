{"manifest_version": 3, "name": "LaserFocus", "version": "1.0", "description": "Replaces visual content on specified websites to keep you focused.", "permissions": ["storage", "activeTab", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "action": {"default_icon": "lightning.svg", "default_popup": "popup.html", "default_title": "LaserFocus Settings"}, "icons": {"48": "lightning.svg", "96": "lightning.svg"}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "laserfocus@laserfocus.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}