{"manifest_version": 3, "name": "OneClick CineTab", "description": "Transform your new tab into a cinematic dashboard for instant movie discovery and seamless streaming access across platforms.", "version": "1.0.0", "author": "CineStream Labs", "permissions": ["storage", "tabs", "bookmarks"], "host_permissions": ["*://*.imdb.com/*", "*://*.themoviedb.org/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "oneclickcinetab@cinestreamlabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}