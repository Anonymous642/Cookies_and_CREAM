{"manifest_version": 3, "name": "EchoShell", "version": "1.0.0", "description": "Encapsulate selected text plus paragraph context in a glowing bracket shell frame.", "permissions": ["contextMenus", "activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "EchoShell", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "echoshell@example.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}