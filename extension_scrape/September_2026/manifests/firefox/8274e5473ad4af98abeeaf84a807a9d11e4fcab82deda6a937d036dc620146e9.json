{"manifest_version": 2, "name": "Cuppalist", "description": "Add and tick off your Cuppalist todos, with a hotkey for a fast add.", "version": "0.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "https://www.cuppalist.com/*", "https://cuppalist.com/*"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Cuppalist quick add"}}, "browser_specific_settings": {"gecko": {"id": "cuppalist@cuppalist.com", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "browser_action": {"default_title": "Cuppalist", "default_popup": "popup.html"}}