{"manifest_version": 2, "name": "YouTube Audio Obtainer", "version": "1.0.0", "description": "Download YouTube videos as MP3", "permissions": ["nativeMessaging", "downloads", "downloads.open", "storage", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-audio-obtainer@example.com"}}}