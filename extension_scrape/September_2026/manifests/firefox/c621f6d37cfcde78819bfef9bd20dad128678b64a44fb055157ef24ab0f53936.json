{"manifest_version": 3, "name": "NoteClip", "short_name": "NoteClip", "version": "3.2.1", "author": "Local-first NoteClip", "description": "A local-first Clipboard + Notes application with notes, clipboard history, and scratchpads in one in-page workspace.", "permissions": ["storage", "unlimitedStorage", "clipboardRead", "clipboardWrite", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_title": "NoteClip", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["mini.html", "mini.js", "db.js", "utils.js", "styles.css"], "matches": ["<all_urls>"]}], "commands": {"open-vault": {"suggested_key": {"default": "Ctrl+Shift+E"}, "description": "Toggle NoteClip"}}, "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'none'"}, "browser_specific_settings": {"gecko": {"id": "noteclip@local-first.writer", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}