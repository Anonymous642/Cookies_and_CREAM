{"manifest_version": 3, "name": "Dave Dashboard", "version": "3.0.0", "description": "A customizable dashboard for your new tab page with themes, widgets, and quick links", "author": "Dave", "chrome_url_overrides": {"newtab": "index.html"}, "chrome_settings_overrides": {"homepage": "index.html"}, "icons": {"48": "icon-48.png", "96": "icons8-dashboard-layout-pulsar-gradient-96.png"}, "permissions": ["storage", "unlimitedStorage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "dave-dashboard@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}