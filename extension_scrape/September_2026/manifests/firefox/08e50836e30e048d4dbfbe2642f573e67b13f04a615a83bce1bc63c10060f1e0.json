{"manifest_version": 3, "name": "Asklepius Anywhere", "version": "1.0.2", "description": "Open Asklepius in a side panel with selected text in the prompt", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["contextMenus", "storage"], "action": {"default_title": "Open Asklepius", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://app.virtualhallway.ca/*"], "content_scripts": [{"matches": ["https://app.virtualhallway.ca/*"], "js": ["vhc-auth.js"], "run_at": "document_start", "all_frames": true}], "sidebar_action": {"default_panel": "panel.html", "default_title": "Asklepius", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "asklepius-anywhere@virtualhallway.ca", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo", "healthInfo"]}}}}