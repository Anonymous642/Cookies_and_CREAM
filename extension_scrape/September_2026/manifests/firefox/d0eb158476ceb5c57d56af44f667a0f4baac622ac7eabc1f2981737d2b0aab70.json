{"manifest_version": 3, "name": "Youtube Filter", "version": "0.1", "description": "Firefox Add-On for filtering out unwanted videos on your YouTube feed", "homepage_url": "https://github.com/john-kick/", "icons": {"48": "icons/icon-48.png"}, "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "yt-filter@john-kick", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_icon": "icons/icon-32.png", "default_title": "Youtube Filter", "default_popup": "popup/configure_filter.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content_scripts/filter.js"]}]}