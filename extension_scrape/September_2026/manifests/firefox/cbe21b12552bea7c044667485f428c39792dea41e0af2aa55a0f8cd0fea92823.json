{"manifest_version": 2, "name": "Surfing Stopper", "version": "1.3.1", "description": "Makes it harder to mindlessly browse Reddit, YouTube, and Substack, without blocking anything you deliberately went there for.", "browser_specific_settings": {"gecko": {"id": "550e8400@446655440001", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "tabs", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.substack.com/*", "*://substack.com/*"], "web_accessible_resources": ["blocked.html", "blocked.js"], "background": {"scripts": ["src/rules/nsfwSubredditList.js", "src/rules/reddit.js", "src/rules/youtube.js", "src/rules/substack.js", "src/rules/siteFamily.js", "src/rules/blockedResponse.js", "src/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.reddit.com/*", "*://*.youtube.com/*", "*://*.substack.com/*", "*://substack.com/*"], "js": ["src/content/toast.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.reddit.com/*"], "css": ["src/content/reddit.css"], "js": ["src/content/marker.js", "src/content/elementHider.js", "src/content/reddit.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.youtube.com/*"], "css": ["src/content/youtube.css"], "js": ["src/rules/youtube.js", "src/content/marker.js", "src/content/elementHider.js", "src/content/youtube.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["*://*.substack.com/*", "*://substack.com/*"], "css": ["src/content/substack.css"], "js": ["src/rules/substack.js", "src/content/marker.js", "src/content/elementHider.js", "src/content/substack.js"], "run_at": "document_start", "all_frames": false}]}