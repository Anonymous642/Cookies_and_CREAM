{"manifest_version": 2, "name": "Homnom Rezept-Importer", "description": "Speichere Rezepte aus dem Web direkt in deinen Homnom-Rezepten.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "homnom-importer1@homnom.de", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Homnom Importer", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}, {"matches": ["http://localhost/*", "https://homnom.de/*"], "run_at": "document_idle", "js": ["content-scripts/homnom-bridge.js"]}]}