{"manifest_version": 3, "name": "StreetView Tracker", "version": "1.4.3", "description": "Houdt lokaal bij welke Google Street View locaties je al bezocht hebt, met export/import naar bestand.", "permissions": ["storage", "downloads", "webNavigation", "scripting"], "host_permissions": ["https://*/maps/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/maps/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "StreetView Tracker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "streetview-tracker@osint-maps.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}