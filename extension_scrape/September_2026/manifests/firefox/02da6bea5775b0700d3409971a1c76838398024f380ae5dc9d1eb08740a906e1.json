{"manifest_version": 3, "name": "Valosan GMail Extension", "short_name": "valosan-gmail-extension", "version": "1.81.1028.1433", "author": "Ruslan Gainutdinov <ruslan@sanfrancisco.fi>", "description": "Easily pitch to your contacts from Valosan app.", "homepage_url": "https://valosan.com", "browser_specific_settings": {"gecko": {"id": "{1efa307b-25d5-46b7-ba47-ab782407d83b}", "strict_min_version": "130.0"}}, "action": {"default_icon": {"16": "images/valosan-icon-16x16-rounded-box.png", "32": "images/valosan-icon-32x32-rounded-box.png", "64": "images/valosan-icon-64x64-rounded-box.png", "128": "images/valosan-icon-128x128-rounded-box.png", "256": "images/valosan-icon-256x256-rounded-box.png"}, "default_title": "Valosan GMail Extension", "default_popup": "popup.html"}, "icons": {"16": "images/valosan-icon-16x16-rounded-box.png", "32": "images/valosan-icon-32x32-rounded-box.png", "64": "images/valosan-icon-64x64-rounded-box.png", "128": "images/valosan-icon-128x128-rounded-box.png", "256": "images/valosan-icon-256x256-rounded-box.png"}, "background": {"scripts": ["src/background.js"], "service_worker": "src/background.js"}, "content_scripts": [{"matches": ["*://mail.google.com/*"], "js": ["src/valosanExtension.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/*", "assets/*", "images/*"], "matches": ["*://*/*"], "use_dynamic_url": true}, {"resources": ["*.map"], "matches": ["https://mail.google.com/*"]}], "permissions": ["storage", "scripting", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["*://mail.google.com/*", "*://*.googleusercontent.com/proxy/*", "*://*.googleusercontent.com/meips/*", "*://p.valosan.com/*", "*://pdev.valosan.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset1", "enabled": true, "path": "rules.json"}]}}