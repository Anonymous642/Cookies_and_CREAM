{"manifest_version": 3, "name": "InstaAudio - Instagram Photo & Carousel Music", "version": "1.0.0", "description": "Ascolta la musica e l'audio di sottofondo dei post con foto e caroselli su Instagram da browser desktop.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.instagram.com/*"], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "InstaAudio", "default_popup": "src/popup.html"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["src/content.js"], "css": ["src/styles.css"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/injected.js"], "matches": ["*://*.instagram.com/*"]}], "browser_specific_settings": {"gecko": {"id": "instaaudio@custom.addon", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}