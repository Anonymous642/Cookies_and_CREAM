{"manifest_version": 2, "name": "Check Bibliotheek", "description": "Zie meteen of een boek beschikbaar is in de bibliotheek terwijl je online boekenwinkels bezoekt.", "version": "0.1.0", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "https://cataloguswebservices.bibliotheek.be/*", "https://webservices.bibliotheek.be/*", "https://bibliotheek.be/*"], "browser_specific_settings": {"gecko": {"id": "check-bibliotheek@zinnonym.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.com.be/*", "*://*.bol.com/*", "*://*.standaardboekhandel.be/*"], "js": ["content-scripts/bibcheck.js"]}], "web_accessible_resources": ["content-scripts/bibcheck.css"]}