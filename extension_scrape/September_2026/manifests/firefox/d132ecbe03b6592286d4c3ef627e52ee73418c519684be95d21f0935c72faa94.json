{"manifest_version": 3, "name": "Downloadium Interceptor", "version": "1.0", "description": "Intercepts browser downloads and hands them off to Downloadium Desktop App.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "storage", "cookies", "webRequest", "webRequestBlocking", "notifications"], "host_permissions": ["<all_urls>", "http://localhost:9669/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "interceptor_v2@downloadium-official.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}}