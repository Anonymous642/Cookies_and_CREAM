{"manifest_version": 2, "name": "Nitterify", "version": "1.1", "description": "Redirects x.com URLs to their nitter.net counterparts", "icons": {"32": "nitterify_logo_32x32.gif"}, "content_scripts": [{"matches": ["https://x.com/*"], "js": ["nitterify.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "@nitterify", "data_collection_permissions": {"required": ["none"]}}}}