{"manifest_version": 2, "name": "YouTube Channel Purge", "version": "1.4.0", "description": "Block YouTube channels from appearing in your recommendations. Track how often blocked channels appear. Easily manage blocked channels with import/export support.", "author": "Anonymous", "browser_specific_settings": {"gecko": {"id": "yt-channel-blocker@mozilla.z6ew9.dralias.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'", "icons": {"48": "icons/yt-blocker-icon-48.png", "96": "icons/yt-blocker-icon-96.png"}, "permissions": ["storage", "https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_icon": {"48": "icons/yt-blocker-icon-48.png", "96": "icons/yt-blocker-icon-96.png"}, "default_title": "YouTube Channel Blocker", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}}