{"manifest_version": 3, "name": "YT Thumbnail Viewer", "version": "1.0", "description": "hold right click and hover over a thumbnail to popup a zoomed and clearer version", "browser_specific_settings": {"gecko": {"id": "yt-thumbnail-viewer-lmao@example.com", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["thumbnail.png"], "matches": ["https://www.youtube.com/*"]}]}