{"manifest_version": 2, "name": "Darb", "description": "Turn long YouTube videos into structured, trackable daily courses.", "version": "0.1.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "homepage_url": "https://github.com/KhalidRouissi1/darb-youtube", "permissions": ["activeTab", "storage"], "optional_permissions": ["notifications"], "browser_specific_settings": {"gecko": {"id": "darb-youtube@khalidrouissi1.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Darb", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}