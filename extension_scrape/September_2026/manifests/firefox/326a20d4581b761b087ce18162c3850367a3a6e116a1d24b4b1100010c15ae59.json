{"manifest_version": 3, "name": "mz7 URL Shortener", "author": "Plamen Stoev", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "mz7-url-shortener@mz7.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "A beautiful, premium URL shortener extension. Shorten, copy, and manage links instantly with context menus and history.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "clipboardWrite", "menus", "notifications"], "host_permissions": ["https://go.mz7.org/*"], "action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon-128.png", "default_title": "Shorten Page URL"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}}