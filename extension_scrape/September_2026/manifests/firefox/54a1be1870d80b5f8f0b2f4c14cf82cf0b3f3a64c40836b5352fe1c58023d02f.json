{"manifest_version": 3, "name": "Anime Where-to-Watch", "version": "0.7.0", "description": "Shows where an anime is streaming, highlighted for your country, right on AniList and MyAnimeList pages.", "permissions": ["storage"], "host_permissions": ["https://graphql.anilist.co/", "https://extensionpay.com/*"], "browser_specific_settings": {"gecko": {"id": "anime-where-to-watch@vagosdem.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["ExtPay.js", "license.js", "background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://anilist.co/anime/*", "https://myanimelist.net/anime/*"], "js": ["regions.js", "content.js"], "css": ["content.css"]}], "action": {"default_popup": "popup.html", "default_title": "Anime Where-to-Watch", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}