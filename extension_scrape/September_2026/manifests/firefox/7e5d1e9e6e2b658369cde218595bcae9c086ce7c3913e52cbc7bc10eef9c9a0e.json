{"manifest_version": 2, "name": "Expire Tabs", "description": "Automatically closes tabs that haven't been focused for a while.", "version": "1.2.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "alarms"], "options_ui": {"open_in_tab": true, "page": "options.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Open the extension popup"}, "toggle-protection": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Toggle protection for the current tab"}, "open-history": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Open the history (options) page"}}, "browser_specific_settings": {"gecko": {"id": "expire-tabs@vict0rsch", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Expire Tabs Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}