{"manifest_version": 3, "name": "Webpage to PDF", "description": "Convert any web page or local HTML file into a PDF document that resembles as closely as possible what you see in the browser.", "version": "1.4.0", "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "webpagetopdf@grabz.it"}}, "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "host_permissions": ["*://grabz.it/*", "file:///*"], "permissions": ["activeTab", "storage", "scripting", "downloads"], "background": {"scripts": ["background.js"]}, "icons": {"48": "icon48.png", "64": "icon64.png", "96": "icon.png", "128": "icon128.png"}}