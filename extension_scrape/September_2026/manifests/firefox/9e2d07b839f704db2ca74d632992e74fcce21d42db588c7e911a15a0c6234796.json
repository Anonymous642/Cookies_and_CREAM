{"manifest_version": 2, "name": "BPM & Key Finder \u2014 Song Key & Tempo Detector", "description": "Find the BPM, key, scale & Camelot code of audio files. Free, instant, no upload\u2014runs locally in your browser. For DJs & producers.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "web_accessible_resources": ["models/**", "*.wasm"], "browser_specific_settings": {"gecko": {"id": "bpm-key-finder@lacuna.fm", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "BPM & Key Finder", "default_popup": "popup.html"}}