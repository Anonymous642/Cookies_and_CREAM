{"manifest_version": 2, "name": "LingLook", "author": "Phong Phan", "version": "1.2.4", "browser_specific_settings": {"gecko": {"id": "linglook@phongp.com", "strict_min_version": "113.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "description": "__MSG_extension_description__", "default_locale": "en", "minimum_chrome_version": "100", "icons": {"16": "images/linglook.svg", "32": "images/linglook.svg", "48": "images/linglook.svg", "96": "images/linglook.svg", "128": "images/linglook.svg"}, "permissions": ["storage"], "background": {"persistent": false, "scripts": ["linglook-background.js"]}, "browser_action": {"browser_style": false, "default_icon": "images/linglook-disabled.svg", "default_title": "__MSG_command_toggle_disabled__"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "match_about_blank": true, "js": ["linglook-content.js"], "all_frames": true, "run_at": "document_start"}, {"matches": ["https://docs.google.com/*"], "js": ["linglook-gdocs-bootstrap.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN"}], "web_accessible_resources": ["css/popup-fonts.css", "css/selection.css", "data/hanzi-writer-data/*.json", "fonts/*.woff2"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+O"}, "description": "__MSG_command_toggle_description__"}}}