{"manifest_version": 3, "name": "Drift \u2014 Gentle To-Dos", "version": "1.2.0", "description": "A calm to-do list that lets friendly reminder bubbles drift into view while you browse.", "browser_specific_settings": {"gecko": {"id": "drift-todos@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "alarms", "notifications"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Drift to-do list", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}