{"manifest_version": 3, "name": "Grocery Compare", "description": "Automatically compares prices on UK supermarket websites.", "version": "1.0.2", "browser_specific_settings": {"gecko": {"id": "grocery-compare@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "host_permissions": ["https://grocery-uk-api.vercel.app/*"], "content_scripts": [{"matches": ["*://*.sainsburys.co.uk/*", "*://*.waitrose.com/*", "*://*.tesco.com/*", "*://*.aldi.co.uk/*", "*://*.lidl.co.uk/*", "*://*.coop.co.uk/*", "*://groceries.morrisons.com/*", "*://*.marksandspencer.com/*"], "js": ["content.js"]}], "icons": {"128": "icons/icon-128.png"}}