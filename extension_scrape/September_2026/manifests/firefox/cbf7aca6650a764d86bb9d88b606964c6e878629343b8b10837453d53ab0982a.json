{"manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "real-debrid-link-copier@example.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "name": "Real-Debrid Link Copier", "version": "1.0.0", "description": "Adds a button to Real-Debrid download pages to copy all download links to clipboard.", "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.real-debrid.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}