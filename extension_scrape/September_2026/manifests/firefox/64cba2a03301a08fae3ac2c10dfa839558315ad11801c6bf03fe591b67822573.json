{"manifest_version": 3, "name": "VerifiedLink", "description": "Analyzes hyperlinks and highlights links where the visible text differs from the actual destination.", "version": "1.1.2", "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "verifiedlink@verifiedlink.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}