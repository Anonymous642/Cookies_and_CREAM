{"manifest_version": 3, "name": "Episteme Redirect", "description": "Automatically redirects Wikipedia articles to Episteme.", "version": "1.0.1", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "permissions": ["storage", "tabs", "webNavigation"], "host_permissions": ["*://*.wikipedia.org/*"], "background": {"scripts": ["src/config.js", "src/storage.js", "src/url.js", "src/background.js"]}, "action": {"default_title": "Episteme Redirect", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_ui": {"page": "options/options.html"}, "browser_specific_settings": {"gecko": {"id": "episteme-redirect@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}