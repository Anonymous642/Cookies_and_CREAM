{"manifest_version": 3, "name": "RAM Regulator for YouTube", "version": "1.0.0", "description": "Keeps long-lived YouTube tabs fresh by safely recycling them between videos or tracks.", "permissions": ["tabs", "storage"], "host_permissions": ["*://www.youtube.com/*", "*://music.youtube.com/*", "*://m.youtube.com/*"], "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/tab-rejuvenator.svg", "96": "icons/tab-rejuvenator.svg"}, "action": {"default_title": "Tab Rejuvenator", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://music.youtube.com/*", "*://m.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "tab-rejuvenator@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "128.0"}}}