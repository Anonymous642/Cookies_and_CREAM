{"manifest_version": 3, "name": "Facebook Who Shared?", "version": "1.4.58", "description": "Adds an inline sharers button to Facebook posts and returns the ability to show the posts shared by people who reshared them.", "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["pageBridge.js"], "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"]}], "action": {"default_title": "Facebook Who Shared?"}, "browser_specific_settings": {"gecko": {"id": "facebook-who-shared@extension.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}