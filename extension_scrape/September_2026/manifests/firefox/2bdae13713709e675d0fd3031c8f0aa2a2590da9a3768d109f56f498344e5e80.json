{"manifest_version": 3, "name": "Song Jam Queue Assistant", "version": "1.0.0", "description": "Easily queue songs from YouTube Music and paste them into your active Song Jam room with rate-limit protection and auto-clear.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://music.youtube.com/*", "*://songjam.app/*"], "action": {"default_popup": "src/popup/popup.html", "default_title": "Song Jam Queue Assistant", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/utils/storage.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["*://music.youtube.com/*"], "js": ["src/utils/storage.js", "src/content/ytmusic.js"], "css": ["src/content/ytmusic.css"], "run_at": "document_idle"}, {"matches": ["*://songjam.app/room/*"], "js": ["src/utils/storage.js", "src/content/songjam.js"], "css": ["src/content/songjam.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "songjam-extension@theunit.cloud", "data_collection_permissions": {"required": ["none"]}}}}