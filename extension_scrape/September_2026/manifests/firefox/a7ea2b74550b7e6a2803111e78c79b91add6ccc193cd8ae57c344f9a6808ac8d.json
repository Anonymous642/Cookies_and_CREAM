{"manifest_version": 3, "name": "Glassweather", "version": "1.0.0", "description": "A quiet layer of rain, snow or fireflies for your current page. Adjustable, local and click-through.", "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "glassweather@page-poetry.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "action": {"default_title": "Glassweather", "default_popup": "popup.html", "default_icon": {"48": "icons/48.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}, "background": {"scripts": ["lifecycle.js"]}}