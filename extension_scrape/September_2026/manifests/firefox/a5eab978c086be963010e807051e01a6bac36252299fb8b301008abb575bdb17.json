{"manifest_version": 2, "name": "AI Bing", "version": "1.1.0", "description": "Plays a notification chime when AI chatbots finish generating a response. Supports Claude, ChatGPT, and Gemini.", "permissions": ["tabs"], "browser_action": {"default_title": "AI Bing \u2014 Listening for AI responses"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "ai-bing@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}