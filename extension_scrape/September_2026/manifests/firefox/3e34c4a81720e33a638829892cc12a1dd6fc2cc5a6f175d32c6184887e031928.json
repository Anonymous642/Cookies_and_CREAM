{"manifest_version": 2, "name": "Humble Steam Tags and Links", "author": "PixelForge", "version": "1.4", "description": "Humble Steam Tags And Links adds links to Steam pages and displays \"Wishlist\" and \"Owned\" tags for games on humblebundle.com.", "background": {"scripts": ["src/background.js"]}, "browser_action": {"default_popup": "src/popup.html", "default_icon": {"128": "resources/logo.png"}}, "permissions": ["storage", "https://*.humblebundle.com/*", "https://store.steampowered.com/api/*", "https://api.steampowered.com/*", "https://cdnjs.cloudflare.com/"], "content_scripts": [{"matches": ["https://*.humblebundle.com/games/*", "https://*.humblebundle.com/membership/*", "https://*.humblebundle.com/store/*"], "js": ["src/content.js"], "css": ["src/style.css"]}], "icons": {"128": "resources/logo.png"}, "browser_specific_settings": {"gecko": {"id": "{62c505eb-642a-44e0-b3fa-94c824e4434e}", "data_collection_permissions": {"required": ["none"]}}}}