{"manifest_version": 3, "name": "Gemini Pinned Tab", "version": "1.0", "description": "Opens Google Gemini in a pinned tab or switches to it if already open.", "action": {"default_icon": "icon.png", "default_title": "Open Gemini"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "host_permissions": ["*://gemini.google.com/*"], "browser_specific_settings": {"gecko": {"id": "gemini-pinned-tab@geminitab.net", "data_collection_permissions": {"required": ["none"]}}}}