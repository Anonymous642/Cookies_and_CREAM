{"manifest_version": 3, "name": "Hover Note", "version": "0.1.0", "description": "A tiny floating reminder that stays visible on every page without getting in the way.", "permissions": ["storage"], "action": {"default_popup": "src/popup.html", "default_title": "Hover Note", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png", "256": "icons/icon256.png", "512": "icons/icon512.png"}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["src/content.css"], "js": ["src/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["src/background.js"]}, "commands": {"toggle-visibility": {"suggested_key": {"default": "Alt+Shift+H", "mac": "Alt+Shift+H"}, "description": "Toggle Hover Note visibility"}}, "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "hover-note@snraw", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}