{"manifest_version": 3, "name": "MonoUI", "version": "1.0.6", "description": "Customizable homepage with icons, fonts, and styles.", "browser_specific_settings": {"gecko": {"id": "stellar-tab@extension", "strict_min_version": "110.0"}}, "chrome_url_overrides": {"newtab": "popup.html"}, "chrome_settings_overrides": {"homepage": "popup.html"}, "action": {"default_popup": "Panel.html", "default_icon": {"48": "Icons/Icon48.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.music.youtube.com/*", "*://*.spotify.com/*", "*://*.music.apple.com/*", "*://*.soundcloud.com/*", "*://*.deezer.com/*", "*://*.tidal.com/*", "*://*.pandora.com/*", "*://*.amazon.com/music/*", "*://*.music.amazon.com/*", "*://*.twitch.tv/*"], "js": ["content.js"]}], "permissions": ["storage", "bookmarks", "tabs"], "host_permissions": ["https://geocoding-api.open-meteo.com*", "https://api.open-meteo.com*"], "icons": {"128": "Icons/Icon128.png"}}