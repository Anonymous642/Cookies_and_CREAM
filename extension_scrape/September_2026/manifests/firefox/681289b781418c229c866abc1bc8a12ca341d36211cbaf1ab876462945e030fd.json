{"manifest_version": 3, "name": "GLOBEL Evidence Stamp", "version": "1.0.0.0", "description": "Places a movable evidence stamp containing the page URL and local timestamps onto the current webpage for capture with screenshot tools.", "permissions": ["activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Add or remove GLOBEL Evidence Stamp", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["icons/logo-40.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "evidence-stamp@globel.uk", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}