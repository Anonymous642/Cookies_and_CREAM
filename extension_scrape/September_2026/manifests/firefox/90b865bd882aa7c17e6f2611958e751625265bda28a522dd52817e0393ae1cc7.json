{"manifest_version": 2, "name": "TabEcho", "version": "1.0.1", "description": "Echo any URL into multiple tabs. Set how many, add a delay, save presets \u2014 one click and TabEcho does the rest.", "homepage_url": "https://digitabuddy.online", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage"], "browser_action": {"default_title": "TabEcho \u2014 open a URL multiple times", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "tabecho@digitabuddy.online", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}