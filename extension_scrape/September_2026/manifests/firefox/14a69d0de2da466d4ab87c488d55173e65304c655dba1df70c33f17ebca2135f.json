{"manifest_version": 2, "name": "YouTube GIF Embedder", "version": "1.0.0", "description": "Converts GIF URLs in YouTube comments into embedded GIFs.", "browser_specific_settings": {"gecko": {"id": "youtube-gif-embeds@johnmogus.org", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["contentScript.js"], "css": ["styles.css"], "run_at": "document_idle"}]}