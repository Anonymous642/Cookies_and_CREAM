{"manifest_version": 2, "name": "Did You Mean?", "version": "1.3.0", "description": "Catches your personal atomic typos in Gmail \u2014 real words used in the wrong context that spell check misses. Add up to 8 trap words and get a gentle 'did you mean?' nudge before you send.", "author": "Jonathan Goldner", "homepage_url": "https://github.com/jtgoldner", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_icon": {"48": "icons/icon48.png"}, "default_title": "Did You Mean?", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "didyoumean@goldner", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}