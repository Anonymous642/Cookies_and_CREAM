{"manifest_version": 2, "name": "Laconic Hover for TV Tropes", "description": "Did you know that most tropes have thoughtfully written summaries? This extension lets you read them without leaving the page.", "version": "2.2.3", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "{c7a8881a-5be2-4f11-871b-9d5ea43c692c}", "strict_min_version": "61.0"}}, "permissions": ["storage"], "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://tvtropes.org/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}