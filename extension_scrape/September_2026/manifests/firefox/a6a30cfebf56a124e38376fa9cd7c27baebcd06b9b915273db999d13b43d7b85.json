{"manifest_version": 3, "name": "Toms Korallen Helper", "version": "1.0.0", "description": "Highlight coral products by name on Toms Korallen web shop with smart fuzzy matching and order import features", "author": "Alexander Peuschel", "homepage_url": "https://github.com/datalexum/toms-korallen-helper", "browser_specific_settings": {"gecko": {"id": "toms-korallen-helper@peuschel.one", "strict_min_version": "109.0"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.toms-korallen.de/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://toms-korallen.de/produkt-kategorie*"], "js": ["src/content.js"], "run_at": "document_idle"}, {"matches": ["https://toms-korallen.de/mein-konto/view-order/*"], "js": ["src/order-content.js"], "run_at": "document_idle"}], "background": {"scripts": ["src/background.js"]}}