{"manifest_version": 2, "name": "AI Text Summarizer Pro", "version": "2.0.1", "description": "Instantly summarize any text on the web with AI. Highlight text and get smart summaries using your Gemini API key.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "96": "icon.png", "128": "icon.png"}, "permissions": ["storage", "activeTab", "tabs", "http://*/*", "https://*/*"], "browser_action": {"default_popup": "popup.html", "default_title": "AI Summarizer Pro"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end", "all_frames": false}], "web_accessible_resources": ["icon.png"], "browser_specific_settings": {"gecko": {"id": "ai-summarizer-pro@extension.local", "strict_min_version": "58.0"}}}