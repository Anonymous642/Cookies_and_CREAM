{"manifest_version": 3, "name": "Boxy", "version": "1.1.0", "description": "Salve links, trechos, imagens e v\u00eddeos de qualquer p\u00e1gina. Organize em pastas, encontre depois e receba lembretes.", "permissions": ["storage", "unlimitedStorage", "notifications", "alarms", "tabs", "activeTab", "contextMenus"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Boxy", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "boxy@extensao.com.br", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Open Boxy"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}