{"manifest_version": 3, "name": "Voz IA para YouTube", "version": "1.0.0", "description": "Dobla los v\u00eddeos de YouTube con una voz neuronal realista que sigue los subt\u00edtulos del v\u00eddeo. T\u00fa eliges el idioma de los subt\u00edtulos y la voz.", "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*", "https://speech.platform.bing.com/*", "wss://speech.platform.bing.com/*", "https://translate.google.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "voz-ia-youtube@local", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}