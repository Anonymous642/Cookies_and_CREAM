{"manifest_version": 3, "name": "Quote of Moment", "description": "A fresh quote every time you open it, with an author byline and a color wheel to theme the popup.", "version": "1.0.2", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "quote-of-moment@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}