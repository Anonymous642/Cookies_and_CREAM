{"manifest_version": 2, "name": "Spotify Web Player Hotkeys (local-only)", "version": "1.0.0", "description": "Add customizable hotkeys to the Spotify Web Player (open.spotify.com). Local-only, no external servers.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Spotify Hotkeys", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://open.spotify.com/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "spotify-hotkeys-local@example.com", "strict_min_version": "60.0"}}}