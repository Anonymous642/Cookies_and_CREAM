{"manifest_version": 3, "name": "FX Timezones", "version": "1.0.1", "description": "Time zone converter with custom timestamps, dark mode, and clipboard integration. Perfect for remote teams, international meetings, and global coordination.", "developer": {"name": "Jason Hughes Sr", "url": "https://github.com/JasonHughesSr/fx-time-convert"}, "browser_specific_settings": {"gecko": {"id": "@fx-timezones.jason-hughes-sr"}}, "action": {"default_title": "FX Timezones - World Clock", "default_popup": "popup/popup.html", "default_icon": "icons/clock.svg"}, "icons": {"16": "icons/clock.svg", "32": "icons/clock.svg", "48": "icons/clock.svg", "128": "icons/clock.svg"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["storage", "tabs", "clipboardWrite"]}