{"manifest_version": 3, "name": "YT Homepage Cleaner", "version": "1.0.5", "description": "Automatically hides watched videos and repetitive recommendations on YouTube.", "permissions": ["storage"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_title": "YT Cleaner Settings", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "ytcleaner@bugmachine", "data_collection_permissions": {"required": ["none"]}}}}