{"manifest_version": 3, "name": "Address Generator", "version": "1.0.0", "description": "Generate random addresses for testing with copy and autofill features", "browser_specific_settings": {"gecko": {"id": "address-generator@example.com"}}, "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"], "host_permissions": ["https://bin-ip-checker.p.rapidapi.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["data/*.json"], "matches": ["<all_urls>"]}]}