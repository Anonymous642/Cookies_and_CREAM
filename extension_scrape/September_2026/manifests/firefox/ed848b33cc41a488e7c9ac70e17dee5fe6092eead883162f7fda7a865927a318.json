{"manifest_version": 2, "name": "InstaShot", "version": "1.3", "description": "Copy the image from an Instagram post without the need to screenshot and crop it.", "author": "Vitor Blanco", "icons": {"48": "icons/InstaShot-48.png"}, "browser_specific_settings": {"gecko": {"id": "{e3a3c70a-c1a5-4387-a2bf-ecc0d7f1c964}"}}, "permissions": ["activeTab", "contextMenus", "clipboardWrite", "https://*.fbcdn.net/*", "https://*.instagram.com/*", "https://*.cdninstagram.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": "icons/InstaShot-48.png", "default_title": "InstaShot"}}