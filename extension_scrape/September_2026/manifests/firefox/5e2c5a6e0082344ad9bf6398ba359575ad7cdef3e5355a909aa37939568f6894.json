{"manifest_version": 3, "name": "Stop Auto Mix", "version": "0.2.1", "description": "redirects videos youtube has automatically made mixes back to their originals", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "@stop-auto-mix.piesarentsquare", "strict_min_version": "109.0"}}, "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}}