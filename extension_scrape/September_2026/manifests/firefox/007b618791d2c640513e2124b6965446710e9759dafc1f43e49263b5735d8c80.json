{"manifest_version": 3, "name": "Prompt Injector", "version": "1.0.0", "description": "Inject multiple prompts into chat requests with configurable timing.", "permissions": ["storage", "downloads"], "host_permissions": ["https://chat.deepseek.com/*"], "content_scripts": [{"matches": ["https://chat.deepseek.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://chat.deepseek.com/*"]}], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "Prompt Injector", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}, "browser_specific_settings": {"gecko": {"id": "prompt-injector@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}}