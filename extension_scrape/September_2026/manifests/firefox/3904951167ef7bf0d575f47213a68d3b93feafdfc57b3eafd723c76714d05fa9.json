{"manifest_version": 2, "name": "Auto Crop to Subject", "version": "1.0.0", "description": "Press C while hovering an image to automatically detect the subject and produce a quick crop (AI-lite).", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "scripting", "downloads"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "commands": {"crop-subject": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Crop hovered image to detected subject"}}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"strict_min_version": "142.0", "id": "auto-crop-subject@example.com", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Auto Crop to Subject"}}