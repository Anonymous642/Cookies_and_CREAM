{"manifest_version": 2, "name": "ForgeData", "description": "Exporta y analiza datos de Forge of Empires. Genera Excel de eficiencia militar. Multilanguage support.", "version": "1.4.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "downloads", "storage", "*://*.forgeofempires.com/*"], "web_accessible_resources": ["lib/xlsx.mini.min.js", "lang/*.json"], "browser_specific_settings": {"gecko": {"id": "forgedata@onosenday", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "browser_action": {"default_title": "ForgeData", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.forgeofempires.com/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/interceptor.js"], "world": "MAIN"}]}