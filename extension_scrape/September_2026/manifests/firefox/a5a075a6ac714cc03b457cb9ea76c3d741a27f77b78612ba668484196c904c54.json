{"manifest_version": 3, "name": "InstaTrack", "description": "Track Instagram follower/following changes.", "browser_specific_settings": {"gecko": {"id": "instatrack@bambiguy.com"}}, "action": {"default_popup": "src/pages/popup/index.html", "default_icon": {"32": "icon-32.png"}}, "chrome_url_overrides": {}, "icons": {"128": "icon-128.png"}, "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["*://*.instagram.com/*"], "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "devtools_page": "src/pages/devtools/index.html", "web_accessible_resources": [{"matches": [], "resources": ["contentStyle.css", "icon-128.png", "icon-32.png"]}], "version": "1.4.0"}