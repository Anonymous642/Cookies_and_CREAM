{"manifest_version": 3, "name": "Fuzzy Tab & History Search", "version": "1.0.1", "description": "Fuzzy search across open tabs, tab group names, and browsing history.", "browser_specific_settings": {"gecko": {"id": "fuzzy-tab-search@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabGroups", "history", "sessions", "scripting"], "action": {"default_title": "Fuzzy tab search (Ctrl+F)"}, "commands": {"open-search": {"suggested_key": {"mac": "MacCtrl+F", "default": "Ctrl+Shift+F"}, "description": "Open fuzzy tab & history search"}, "rename-tab": {"suggested_key": {"mac": "MacCtrl+I", "default": "Ctrl+Shift+I"}, "description": "Rename the current tab"}}, "host_permissions": ["<all_urls>"], "background": {"scripts": ["label.js", "background.js"]}}