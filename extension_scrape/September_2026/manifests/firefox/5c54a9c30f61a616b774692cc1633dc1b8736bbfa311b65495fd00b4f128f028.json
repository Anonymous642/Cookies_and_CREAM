{"manifest_version": 2, "name": "YouTube Focus Mode", "version": "1.1.0", "description": "Hide comments and live chat on YouTube to stay focused on content.", "browser_specific_settings": {"gecko": {"id": "youtube-comments-disabler@firefox.addon", "strict_min_version": "79.0"}}, "permissions": ["*://www.youtube.com/*", "storage", "activeTab", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/watch*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "64": "images/icon64.png", "128": "images/icon128.png"}}}