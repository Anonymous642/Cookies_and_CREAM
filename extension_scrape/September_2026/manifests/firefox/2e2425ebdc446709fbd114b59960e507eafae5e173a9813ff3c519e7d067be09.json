{"manifest_version": 2, "name": "Midnight \u2014 Dark Mode for Every Site", "version": "3.4", "description": "Turn the whole web dark. Midnight applies a smart, eye-friendly dark theme to every website automatically, with brightness and contrast controls, a per-site on/off toggle, and an optional night schedule.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{4c4b4b91-7f8b-4d70-b43f-362540713aef}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/dm-core.js", "src/darkmode.js"], "run_at": "document_start", "all_frames": false}], "browser_action": {"default_title": "Midnight \u2014 Dark Mode", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}