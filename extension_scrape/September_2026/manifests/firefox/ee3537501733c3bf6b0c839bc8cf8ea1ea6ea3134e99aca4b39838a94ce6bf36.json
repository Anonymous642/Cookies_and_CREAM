{"manifest_version": 3, "name": "Copybook \u2014 Clipboard History Sidebar", "version": "1.0.0", "description": "Every copy you make, saved to a searchable sidebar that stays open. Export your history and move it to another browser.", "browser_specific_settings": {"gecko": {"id": "copybook@arephan.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["analytics.js", "background.js"]}, "sidebar_action": {"default_title": "Copybook", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "open_at_install": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}