{"manifest_version": 3, "name": "Google Maps for DuckDuckGo", "version": "1.0.3", "description": "Adds Google Maps alongside the default Maps option in the DuckDuckGo Toolbar.", "permissions": ["scripting"], "browser_specific_settings": {"gecko": {"id": "google-maps-duckduckgo@github.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://duckduckgo.com/*"], "js": ["ddg-google-maps.js"], "run_at": "document_idle"}], "icons": {"48": "icon-48.png", "96": "icon-96.png"}}