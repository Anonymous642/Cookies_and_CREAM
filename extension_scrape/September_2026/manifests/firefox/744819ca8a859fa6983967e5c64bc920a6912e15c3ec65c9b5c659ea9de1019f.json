{"manifest_version": 3, "name": "Keylock Bridge", "description": "Developer tools automation - stream console logs, network requests, and screenshots to your AI IDE.", "version": "0.1.5", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "storage", "notifications", "webRequest", "scripting", "identity"], "host_permissions": ["https://api.keylockbridge.dev/*", "https://auth.keylockbridge.dev/*", "https://cognito-idp.us-east-1.amazonaws.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "optional_permissions": ["nativeMessaging", "webRequestBlocking", "webRequestFilterResponse"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Keylock Bridge", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "devtools_page": "devtools.html", "options_page": "options.html", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "keylock-bridge@keylockbridge.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity"], "description": "This extension collects console logs and network requests from tabs you explicitly enable for streaming, to relay them to developer tools. Data is transmitted to your configured MCP server and is encrypted end-to-end. No data is collected without user action."}}}}