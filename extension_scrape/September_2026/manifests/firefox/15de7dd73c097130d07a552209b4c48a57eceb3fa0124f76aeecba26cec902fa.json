{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "readaloud-extension@addons.mozilla.org", "data_collection_permissions": {"required": ["none"]}}}, "name": "Read Selected Text Aloud", "version": "1.0", "description": "Read aloud highlighted text from any webpage using the right-click context menu.", "permissions": ["contextMenus"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["ContentScript.js"], "run_at": "document_idle"}], "commands": {"read-aloud": {"suggested_key": {"default": "Alt+K"}, "description": "Read selected text aloud"}, "stop-reading": {"suggested_key": {"default": "Alt+L"}, "description": "Stop reading text"}}}