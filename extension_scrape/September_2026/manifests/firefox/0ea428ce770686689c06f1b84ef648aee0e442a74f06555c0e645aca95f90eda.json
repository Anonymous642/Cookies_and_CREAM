{"manifest_version": 3, "name": "IDM Download Manager", "description": "Click once to download all images on a webpage with the Image Download Manager Extension.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "contact@idmdownloadmanager.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["jszip.min.js", "background.js"]}, "action": {"default_title": "IDM Download Manager", "default_popup": "popup.html", "default_icon": {"128": "icon128.png"}}, "icons": {"128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}