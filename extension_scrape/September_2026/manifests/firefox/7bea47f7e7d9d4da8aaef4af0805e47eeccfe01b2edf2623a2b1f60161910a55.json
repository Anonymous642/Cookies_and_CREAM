{"manifest_version": 3, "name": "Detour", "description": "Switch HTTP, HTTPS, or SOCKS proxy profiles from your toolbar, with auto-switch rules, health checks, failover, auth, and bypass.", "version": "1.7.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["proxy", "storage", "alarms", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Detour", "default_popup": "popup.html"}, "commands": {"toggle-detour": {"description": "Toggle Detour on or off"}, "next-profile": {"description": "Switch to the next named profile"}}, "browser_specific_settings": {"gecko": {"id": "detour@mafille.me", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}