{"manifest_version": 3, "name": "X Autoplay Blocker", "version": "1.0", "description": "Prevents video autoplay on X (Twitter) by requiring a user click to start playback.", "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"], "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "MAIN"}], "browser_specific_settings": {"gecko": {"id": "x-com-disable-autoplay@urcatness", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}}