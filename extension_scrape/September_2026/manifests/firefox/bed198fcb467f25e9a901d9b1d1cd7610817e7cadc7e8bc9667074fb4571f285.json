{"manifest_version": 3, "name": "Tab Scroll Navigator", "version": "1.0.1", "description": "Navigate tabs with Shift+Scroll wheel", "permissions": ["tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "commands": {"next-tab": {"suggested_key": {"default": "Ctrl+Shift+Period"}, "description": "Next tab"}, "prev-tab": {"suggested_key": {"default": "Ctrl+Shift+Comma"}, "description": "Previous tab"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "Tab Scroll Navigator"}, "options_page": "options.html", "icons": {"128": "./icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "tabscrollnavigator@plucafs", "data_collection_permissions": {"required": ["none"]}}}}