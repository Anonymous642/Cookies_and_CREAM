{"manifest_version": 3, "name": "Mindbloom", "version": "1.0.0", "description": "Removes YouTube Shorts from the YouTube web app. Let your mind bloom.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "mindbloom@sebastiansvensson", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["styles/shorts-hide.css"], "js": ["scripts/content.js"], "run_at": "document_start"}]}