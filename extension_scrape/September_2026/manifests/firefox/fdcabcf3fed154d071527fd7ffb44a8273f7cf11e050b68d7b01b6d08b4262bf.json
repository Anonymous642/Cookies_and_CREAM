{"manifest_version": 3, "name": "Stash", "version": "0.1.1", "description": "Save the current tab to Stash with Alt+S.", "permissions": ["activeTab", "scripting", "storage", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"save-tab": {"suggested_key": {"default": "Alt+S"}, "description": "Save current tab to Stash"}}, "browser_specific_settings": {"gecko": {"id": "stash@stash.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}