{"manifest_version": 3, "name": "A1 Color Picker", "short_name": "A1 Color", "version": "0.1.0", "description": "Pick on-screen colors, copy HEX/RGB/HSL values, and keep a local color history.", "homepage_url": "https://a1local.com.au/extensions/color-picker-tool/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "A1 Color Picker", "default_popup": "popup.html"}, "options_page": "options.html", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "color-picker-tool@a1local.com.au", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}