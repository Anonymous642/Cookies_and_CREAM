{"manifest_version": 3, "name": "LinkLater", "version": "1.0.0", "description": "Save now. Read later. Stay organized.", "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}, "default_title": "LinkLater"}, "background": {"scripts": ["background/index.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "contextMenus", "notifications", "alarms"], "commands": {"save-current-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save current page to LinkLater"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open LinkLater popup"}, "focus-search": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Focus search in LinkLater"}}, "browser_specific_settings": {"gecko": {"id": "linkvault@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"]}}}, "web_accessible_resources": [{"resources": ["assets/icons/*"], "matches": ["<all_urls>"]}]}