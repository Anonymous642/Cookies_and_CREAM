{"manifest_version": 3, "name": "K Copy Helper", "short_name": "K Copy", "version": "1.0.26", "description": "K Copy Helper connects Firefox with K Print and K Files, including ChatGPT and Claude attachment workflows.", "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "scripting", "storage"], "host_permissions": ["https://chatgpt.com/*", "https://kobadi.com/*", "https://claude.ai/*"], "action": {"default_title": "K Copy Helper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "background": {"scripts": ["browser-helper-common.js", "background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["server-ui-sanitizer.js", "site-inbox-core.js", "chatgpt-kprint.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["server-ui-sanitizer.js", "site-inbox-core.js", "claude-kprint.js"], "run_at": "document_idle"}, {"matches": ["https://kobadi.com/print*", "https://kobadi.com/print/*"], "js": ["kprint-page.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "k-copy-helper@kobadi.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}