{"manifest_version": 3, "name": "Mindful Focus - Buddhist Blocker", "version": "2.1", "description": "A minimalist, glassmorphic extension that encourages mindfulness before visiting distracting sites.", "permissions": ["tabs", "storage", "webNavigation", "unlimitedStorage"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "mindfulfocus@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}