{"manifest_version": 3, "name": "Eco Companion Lite", "version": "2.0.0", "description": "Compare automatiquement les prix neufs et d'occasion sur les principaux sites e-commerce.", "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.amazon.fr/*", "*://*.fnac.com/*", "*://*.darty.com/*", "*://*.boulanger.com/*"], "content_scripts": [{"matches": ["*://*.amazon.fr/*", "*://*.fnac.com/*", "*://*.darty.com/*", "*://*.boulanger.com/*"], "js": ["content/extractor.js", "content/marketplace.js", "content/widget.js", "content/content.js"], "css": ["content/styles.css"]}], "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "eco-companion@local.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "privacy_policy_url": ""}}}}