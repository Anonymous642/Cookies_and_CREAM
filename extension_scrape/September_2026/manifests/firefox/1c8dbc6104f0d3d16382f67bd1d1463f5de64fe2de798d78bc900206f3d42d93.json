{"manifest_version": 2, "name": "Markdown New Tab", "description": "A new tab page that acts as a markdown editor for notes.", "version": "1.0.5", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "chrome_url_overrides": {"newtab": "new_tab.html"}, "browser_specific_settings": {"gecko": {"id": "markdown-new-tab@extension.local", "strict_min_version": "109.0"}}, "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http:;", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Markdown New Tab", "default_popup": "popup.html"}}