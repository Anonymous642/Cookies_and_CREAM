{"manifest_version": 3, "name": "Woo Recorder", "version": "0.34.2", "description": "Records, intercepts, compares, analyzes, and edits WooCommerce HTTP workflows, then generates reusable PHP cURL automation with explicit provenance and safety blockers.", "browser_specific_settings": {"gecko": {"id": "woo-recorder@levnar", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "devtools_page": "devtools/devtools.html", "background": {"scripts": ["background/interceptor.js"], "type": "module"}, "permissions": ["storage", "unlimitedStorage", "scripting", "webNavigation", "webRequest", "webRequestBlocking", "webRequestFilterResponse"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "optional_host_permissions": ["<all_urls>"]}