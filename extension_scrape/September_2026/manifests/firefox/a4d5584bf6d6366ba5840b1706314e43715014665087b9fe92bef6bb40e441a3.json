{"name": "Veil", "description": "Selective Web Content Hider", "version": "1.5", "author": "Crafted with precision by Halbin", "manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "veil@halbin.extension", "strict_min_version": "58.0"}}, "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_title": "Veil - Selective Web Content Hider"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": []}