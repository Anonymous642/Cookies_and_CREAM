{"manifest_version": 3, "name": "event-bridge", "description": "Create, manage and transfer VRChat scene events across vrc.tl, vrcpop.com and rave.page as the logged-in user.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "permissions": ["storage", "scripting"], "host_permissions": ["https://vrc.tl/*", "https://vrcpop.com/*", "https://development.rave.page/*", "https://development.api.rave.page/*"], "optional_host_permissions": ["https://*/*"], "incognito": "not_allowed", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https:; img-src 'self' https: data: blob:;"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "event-bridge@dymattic", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"]}}}, "version": "0.2.17"}