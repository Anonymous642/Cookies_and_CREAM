{"manifest_version": 3, "name": "Prompt'Opt", "version": "1.1.4", "description": "Optimise vos prompts automatiquement \u2014 r\u00e9duit les tokens, les co\u00fbts API et l'empreinte CO\u2082.", "browser_specific_settings": {"gecko": {"id": "promptopt@example.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "storage", "alarms"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.mistral.ai/*", "https://mistral.ai/*", "https://chat.dinootoo.ai.orange/*", "https://llmproxy.ai.orange/*"], "background": {"scripts": ["intent-model-weights.js", "intent-classifier.js", "optimizer-prompts.js", "compression-judge.js", "judge-improvement-agent.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.mistral.ai/*", "https://mistral.ai/*", "https://chat.dinootoo.ai.orange/*"], "js": ["interceptor.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.mistral.ai/*", "https://mistral.ai/*", "https://chat.dinootoo.ai.orange/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}