{"manifest_version": 2, "name": "Lyric Quick-Align", "version": "1.0", "description": "Paste lyrics, quickly align lines to the page's media timeline and save .lrc per site.", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Lyric Quick-Align", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "icons": {"48": "icons/icon48.png"}, "browser_specific_settings": {"gecko": {"id": "lyricquickalign@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}