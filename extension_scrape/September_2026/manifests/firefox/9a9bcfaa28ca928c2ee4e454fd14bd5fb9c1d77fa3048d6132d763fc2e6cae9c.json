{"manifest_version": 2, "name": "Pixel Cursor Tracker", "version": "1.0", "description": "Hi\u1ec7u \u1ee9ng pixel theo chu\u1ed9t tr\u00ean trang web.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "pixel.cursor.tracker@addons.mozilla.org", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}