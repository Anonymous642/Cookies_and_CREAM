{"manifest_version": 2, "name": "X/Twitter \u2013 Open Posts in Background Tab", "version": "1.0", "description": "Clicking any post in the X/Twitter feed opens it in a new background tab instead of navigating away.", "browser_specific_settings": {"gecko": {"id": "x-background-tabs@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "*://*.twitter.com/*", "*://*.x.com/*"], "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}}