{"manifest_version": 2, "name": "Instagram Non-Mutual Finder", "version": "1.2", "description": "Find accounts you follow that don't follow you back using the Instagram web UI.", "author": "Randolph", "developer": {"name": "Randolph", "url": "https://randolph.red"}, "permissions": ["activeTab", "tabs", "storage"], "page_action": {"default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "IG Non-Mutuals", "default_popup": "popup.html"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "ig-non-mutuals@randolph.red", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}