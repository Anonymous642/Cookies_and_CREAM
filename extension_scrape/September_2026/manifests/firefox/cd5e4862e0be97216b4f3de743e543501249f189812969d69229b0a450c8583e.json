{"manifest_version": 2, "name": "Shopilot - AI Product Recommendations", "version": "1.0.0", "description": "Get AI-powered product recommendations for any need, right in your browser", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "tabs", "scripting", "contextMenus", "https://*/*", "http://*/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_title": "Shopilot - AI Product Recommendations"}, "web_accessible_resources": ["*"], "content_security_policy": "script-src 'self' https://shopilot.app; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "shopilot@shopilot.app", "strict_min_version": "91.0"}}}