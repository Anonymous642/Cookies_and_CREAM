{"manifest_version": 2, "name": "Smart Reply Suggestion", "version": "1.3", "description": "Suggests quick and relevant replies based on the text content on the page.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage"], "browser_action": {"default_title": "Smart Reply Suggestion", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Smart-Reply-Suggestion", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}