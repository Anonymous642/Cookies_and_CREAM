{"manifest_version": 3, "name": "SteamCMD Workshop Downloader", "version": "1.0", "description": "Automatically converts Steam Workshop URLs to SteamCMD download commands.", "permissions": ["clipboardRead", "clipboardWrite", "storage"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"]}], "host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "uniqueid@swc.com", "strict_min_version": "58.0"}}}