{"manifest_version": 3, "name": "Poly Cube \u2014 AI assistant everywhere", "version": "0.2.2", "description": "Dock the Poly Cube assistant into your browser and float it over any website. Connects to your existing Poly account.", "browser_specific_settings": {"gecko": {"id": "poly-cube@poly.inc", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "Poly", "default_icon": "icons/icon.svg"}, "sidebar_action": {"default_title": "Poly", "default_panel": "sidepanel.html", "default_icon": "icons/icon.svg", "open_at_install": false}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "128": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-assistant": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Toggle the Poly assistant on this page"}}, "permissions": ["storage", "contextMenus"], "host_permissions": ["https://*.poly.inc/*", "http://localhost:3004/*", "http://localhost:8000/*"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://*.poly.inc/*", "http://localhost:3004/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["https://*.poly.inc/*", "http://localhost:3004/*"], "js": ["polybridge.js"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*", "content.css"], "matches": ["<all_urls>"]}]}