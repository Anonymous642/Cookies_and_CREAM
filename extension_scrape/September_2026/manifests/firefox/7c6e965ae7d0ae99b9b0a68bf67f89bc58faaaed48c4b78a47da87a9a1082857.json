{"manifest_version": 3, "name": "Waypoint AI", "version": "1.4.1", "short_name": "Waypoint AI", "author": "Waypoint AI", "homepage_url": "https://mywaypoint.ai", "description": "Waypoint AI Firefox Extension", "browser_specific_settings": {"gecko": {"id": "waypoint-ai@mywaypoint.ai", "strict_min_version": "136.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "tabs", "alarms", "contextMenus"], "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Toggle the Waypoint AI sidebar"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": [{"resources": ["widget.js", "assets/widget.css", "assets/*"], "matches": ["<all_urls>"]}, {"resources": ["options.html"], "matches": ["<all_urls>"]}], "options_page": "options.html", "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Waypoint AI", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}