{"manifest_version": 3, "name": "IXTS \u2014 Importador Mercado Livre", "version": "1.2.3", "description": "Captura an\u00fancios do Mercado Livre e envia ao painel da sua loja IXTS para revis\u00e3o e publica\u00e7\u00e3o.", "permissions": ["storage", "activeTab"], "optional_host_permissions": ["http://*/*", "https://*/*"], "host_permissions": ["*://*.mercadolivre.com.br/*", "*://*.mercadolibre.com/*", "*://*.mercadolibre.com.ar/*"], "action": {"default_popup": "popup.html", "default_title": "IXTS \u2014 Importador ML"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.mercadolivre.com.br/*", "*://*.mercadolibre.com/*", "*://*.mercadolibre.com.ar/*"], "js": ["extractor.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "ixts-importador-ml@ixts.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}}}