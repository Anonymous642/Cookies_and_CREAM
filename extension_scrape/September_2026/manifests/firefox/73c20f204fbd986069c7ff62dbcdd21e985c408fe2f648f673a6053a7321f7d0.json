{"manifest_version": 3, "name": "Hocus Pocus Focus \u2013 A better browsing habit", "version": "1.0.1", "description": "Turn the reflex of checking the news into the habit of learning something. You pick the sites; you pick where you land instead.", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "hocuspocusfocus@vanmoose.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}