{"manifest_version": 3, "name": "FlowCut Pro", "description": "Optimize AI conversations: hide old messages, auto-save settings, keyboard shortcuts.", "version": "3.2.1", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://www.perplexity.ai/*"], "content_scripts": [{"matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://www.perplexity.ai/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "flowcut-pro@geodecroyer.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_title": "FlowCut Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "commands": {"toggle-extension": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle FlowCut Pro on/off"}, "reset-view": {"suggested_key": {"default": "Alt+R"}, "description": "Show all messages"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}