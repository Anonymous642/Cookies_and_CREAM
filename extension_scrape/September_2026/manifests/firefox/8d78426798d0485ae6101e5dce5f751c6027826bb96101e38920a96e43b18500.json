{"manifest_version": 3, "name": "IP Dashboard & System Monitor", "version": "3.1.1", "description": "View your public IP, network location, DNS lookup, speed test, and browser system information.", "permissions": ["storage", "activeTab", "tabs", "scripting"], "host_permissions": ["https://api.ipify.org/*", "https://ipwho.is/*", "https://cloudflare-dns.com/*", "https://www.google.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "ip-dashboard@macromodule", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}