{"manifest_version": 3, "name": "Drupal Toolbar Toggle", "version": "1.0.0", "description": "Skjul/vis Drupal toolbar (.toolbar) med et klik.", "permissions": ["tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Toggle Drupal toolbar"}, "commands": {"toggle-drupal-toolbar": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Toggle Drupal toolbar visibility"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "drupal-toolbar-toggle@example.local", "data_collection_permissions": {"required": ["none"]}}}}