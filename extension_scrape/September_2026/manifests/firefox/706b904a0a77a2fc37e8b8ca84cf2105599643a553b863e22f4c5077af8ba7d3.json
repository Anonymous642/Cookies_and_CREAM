{"manifest_version": 2, "name": "Soda PDF Online (unofficial)", "version": "1.0.0", "description": "Quick helper to open PDFs in Soda PDF Online (unofficial). This extension is NOT affiliated with Soda PDF.", "permissions": ["activeTab", "tabs", "storage"], "icons": {}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Open PDF with Soda Online", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content_script.js"], "css": ["inject.css"]}], "applications": {"gecko": {"id": "soda-pdf-online-unofficial@example", "strict_min_version": "60.0"}}}