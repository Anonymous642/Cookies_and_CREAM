{"manifest_version": 2, "name": "Hype Hands", "version": "2.1.5.0", "description": "Fires a bouncing hands-up animation with a matching beat over any page you are reading.", "browser_specific_settings": {"gecko": {"id": "{e76c7cad-a5cb-4148-b2ca-8d8b6b57a39b}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "images/icon32.png", "48": "images/icon48.png", "64": "images/icon64.png", "96": "images/icon96.png", "128": "images/icon128.png"}, "permissions": ["activeTab", "storage"], "background": {"scripts": ["core/background.js"], "persistent": false}, "browser_action": {"default_popup": "core/popup.html", "default_title": "Hype Hands", "default_icon": {"32": "images/icon32.png", "48": "images/icon48.png", "64": "images/icon64.png", "96": "images/icon96.png", "128": "images/icon128.png"}}, "commands": {"react-now": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Replay the last reaction"}}, "web_accessible_resources": ["core/core.js", "core/content.js"]}