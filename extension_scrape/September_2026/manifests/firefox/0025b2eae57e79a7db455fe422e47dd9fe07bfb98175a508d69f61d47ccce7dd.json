{"manifest_version": 3, "name": "Persian/English Text Remap", "short_name": "FA-EN Fixer", "version": "2.0.3", "description": "Quickly convert text typed with the wrong keyboard layout (Persian/English) with a custom shortcut key.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["keymap.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": [{"resources": ["fonts/*.woff2", "fonts/*.woff"], "matches": ["<all_urls>"]}], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "fa-en-fixer@mapnagroup.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}