{"manifest_version": 3, "name": "Shop-Alarm", "version": "3.4.2.5", "author": "Benjamin Wozniak", "description": "Shop-Alarm erkennt automatisch Partner-Shops, bei denen man mit einem Klick ohne Mehrkosten helfen kann.", "default_locale": "de", "icons": {"19": "data/img/icon19.png", "32": "data/img/icon32.png", "128": "data/img/icon128.png"}, "background": {"scripts": ["data/js/background.js"]}, "action": {"default_title": "Shop-Alarm", "default_icon": {"19": "data/img/icon19.png", "32": "data/img/icon32.png", "128": "data/img/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["data/css/style.css"], "js": ["data/js/jquery-3.3.1.min.js", "data/js/mustache.min.js", "data/js/popup.js", "data/js/settings.js", "data/js/google_search.js", "data/js/content_script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@Shop-Alarm", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "web_accessible_resources": [{"resources": ["data/img/*", "data/css/*", "data/html/*"], "matches": ["<all_urls>"]}], "permissions": ["storage"], "host_permissions": ["https://www.bildungsspender.org/shopalarm/*", "https://www.bildungsspender.org/images/organisation/logo/*", "https://www.bildungsspender.de/*", "https://www.wecanhelp.de/*"]}