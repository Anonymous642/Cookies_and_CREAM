{"manifest_version": 2, "name": "Vim Keys for Firefox", "version": "1.0.0", "description": "Vim-style keyboard navigation for Firefox", "author": "Your Name", "homepage_url": "https://github.com/yourusername/vim-firefox", "permissions": ["tabs", "activeTab", "<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": false}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icon.png"}, "default_title": "Vim Keys for Firefox"}, "icons": {"48": "icon.png"}, "commands": {"previous-tab": {"suggested_key": {"default": "Ctrl+Shift+J"}, "description": "Switch to previous tab"}, "next-tab": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Switch to next tab"}, "close-tab": {"suggested_key": {"default": "Ctrl+Shift+X"}, "description": "Close current tab"}, "new-tab": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Open new tab"}}, "browser_specific_settings": {"gecko": {"id": "vim-keys@firefox-extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}