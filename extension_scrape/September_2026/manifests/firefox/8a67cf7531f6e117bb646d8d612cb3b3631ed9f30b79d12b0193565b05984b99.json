{"manifest_version": 2, "name": "Velocity Text Expander", "description": "manifest.json description", "version": "1.9.2", "short_name": "Velocity", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "key": "", "permissions": ["storage", "activeTab", "identity"], "browser_specific_settings": {"gecko": {"id": "velocity@text-expander", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"page": "options.html"}, "content_scripts": [{"matches": ["*://*/*"], "all_frames": true, "match_about_blank": false, "js": ["content-scripts/content.js"]}]}