{"manifest_version": 3, "name": "Search Results Leads Extractor", "version": "1.0.3", "description": "Save business leads from search results to CSV and JSON.", "permissions": ["activeTab", "downloads", "storage", "tabs"], "host_permissions": ["https://www.google.com/*", "https://google.com/*", "https://www.google.co.za/*", "https://google.co.za/*", "https://api.quotelyfy.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.quotelyfy.com"}, "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Search Results Leads Extractor", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["https://www.google.com/*", "https://google.com/*", "https://www.google.co.za/*", "https://google.co.za/*"], "js": ["content.js"], "run_at": "document_idle"}], "sidebar_action": {"default_panel": "popup.html", "default_title": "Search Results Leads Extractor", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "search-results-leads-extractor@quotelyfy.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "websiteContent", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}