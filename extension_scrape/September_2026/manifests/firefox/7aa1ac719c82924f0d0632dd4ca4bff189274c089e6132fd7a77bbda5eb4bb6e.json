{"manifest_version": 3, "name": "H264 for YouTube", "version": "1.0.1", "description": "Forces YouTube to stream H.264 video instead of VP8, VP9 or AV1.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "H264 for YouTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.youtu.be/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "options_ui": {"page": "popup.html", "open_in_tab": true}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "H264forYouTube@local.addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}