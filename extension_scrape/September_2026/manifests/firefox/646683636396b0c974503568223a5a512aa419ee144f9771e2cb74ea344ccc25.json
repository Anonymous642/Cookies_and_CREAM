{"manifest_version": 3, "name": "Bookmark Rot", "version": "0.1.0", "description": "Bookmarks that expire if you don't use them. Bookmark normally with the star \u2014 unused ones quietly delete themselves; ones you keep opening earn longer and longer reprieves.", "author": "sunilv", "homepage_url": "https://gitlab.com/sunil.v/bookmark-rot", "browser_specific_settings": {"gecko": {"id": "bookmark-rot@sunilv", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["bookmarks", "history", "alarms", "storage"], "background": {"scripts": ["common.js", "background.js"]}, "action": {"default_title": "Bookmark Rot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "sidebar_action": {"default_title": "Bookmark Rot", "default_panel": "sidebar/sidebar.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "open_at_install": false}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}