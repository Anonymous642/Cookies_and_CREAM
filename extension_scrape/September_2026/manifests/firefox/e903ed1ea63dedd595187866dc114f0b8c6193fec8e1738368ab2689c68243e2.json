{"manifest_version": 3, "name": "Fantasy Index Connect for Firefox", "version": "1.0.1", "description": "Connect ESPN / CBS / Yahoo / Fantrax to Fantasy Index in one click. Clear step-by-step sync with session end support.", "permissions": ["cookies", "storage", "tabs", "scripting"], "host_permissions": ["https://*.espn.com/*", "http://*.espn.com/*", "https://*.cbssports.com/*", "http://*.cbssports.com/*", "https://*.yahoo.com/*", "http://*.yahoo.com/*", "https://*.fantasysports.yahoo.com/*", "http://*.fantasysports.yahoo.com/*", "https://*.fantrax.com/*", "http://*.fantrax.com/*", "https://fantasyindex.com/*", "https://www.fantasyindex.com/*", "http://localhost:3000/*", "http://localhost:3001/*", "http://127.0.0.1:3000/*", "http://127.0.0.1:3001/*"], "browser_specific_settings": {"gecko": {"id": "connect@fantasyindex.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "192": "icons/icon192.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://fantasyindex.com/sync_results/update*", "https://www.fantasyindex.com/sync_results/update*", "http://localhost:3000/sync_results/update*", "http://localhost:3001/sync_results/update*", "http://127.0.0.1:3000/sync_results/update*", "http://127.0.0.1:3001/sync_results/update*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.fantrax.com/*", "https://fantrax.com/*", "http://www.fantrax.com/*", "http://fantrax.com/*"], "js": ["fantrax_profile.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo.svg", "icons/icon192.png"], "matches": ["https://fantasyindex.com/*", "https://www.fantasyindex.com/*", "http://localhost:3000/*", "http://localhost:3001/*", "http://127.0.0.1:3000/*", "http://127.0.0.1:3001/*"]}], "action": {"default_title": "Fantasy Index Connect", "d