{"manifest_version": 3, "name": "Vulnetix", "description": "Inline VDB intelligence for every vulnerability identifier on the page.", "version": "0.2.1", "short_name": "Vulnetix", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://api.vdb.vulnetix.com/*", "https://www.vulnetix.com/*"], "web_accessible_resources": [], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_title": "Vulnetix", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}}, "commands": {"open-sidebar": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Open the Vulnetix sidebar"}}, "browser_specific_settings": {"gecko": {"id": "browser-extension@vulnetix.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Vulnetix"}, "background": {"type": "module", "scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": false, "exclude_matches": ["https://*.vulnetix.com/*", "https://vulnetix.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}