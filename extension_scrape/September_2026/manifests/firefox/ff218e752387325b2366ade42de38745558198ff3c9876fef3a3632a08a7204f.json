{"manifest_version": 3, "name": "DataAnonymiser", "version": "0.1.2", "description": "Anonymize selected text and get live PII warnings in AI chats and webmail \u2014 processed on-device by the DataAnonymiser app.", "browser_specific_settings": {"gecko": {"id": "extension@dataanonymiser.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "DataAnonymiser \u2014 anonymize selection", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_page": "options.html", "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["http://127.0.0.1:47653/*", "http://127.0.0.1:47654/*", "http://127.0.0.1:47655/*", "http://127.0.0.1:47656/*"], "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.live.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}