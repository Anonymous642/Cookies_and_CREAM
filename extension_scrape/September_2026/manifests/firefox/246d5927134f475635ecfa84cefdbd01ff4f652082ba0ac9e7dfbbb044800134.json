{"manifest_version": 2, "name": "Sever", "version": "0.2.1", "description": "Privacy-first blocker: ads, trackers, annoyances. Rust-powered WASM engine, fast and private.", "homepage_url": "https://getsever.vercel.app/", "developer": {"name": "Supun Hewagamage", "url": "https://github.com/supunhg/sever"}, "browser_specific_settings": {"gecko": {"id": "sever@supunhg.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "browser_action": {"default_title": "Sever", "default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["preload.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "web_accessible_resources": ["wasm/*", "content.js"], "permissions": ["alarms", "contextMenus", "storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "src/options/index.html", "open_in_tab": true}}