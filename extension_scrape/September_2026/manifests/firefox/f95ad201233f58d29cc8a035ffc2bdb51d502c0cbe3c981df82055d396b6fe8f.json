{"manifest_version": 3, "name": "Total Playtime WebExtension!", "version": "1.2", "description": "Adds a button to Steam profile pages to calculate that user's total playtime.", "homepage_url": "https://git.windoze98.dev/WinDOZE98/total-playtime-webextension", "browser_specific_settings": {"gecko": {"id": "total_playtime_webextension@windoze98.dev", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://steamcommunity.com/profiles/*", "*://steamcommunity.com/id/*"], "js": ["content-script.js"]}], "web_accessible_resources": [{"resources": ["total-playtime.js", "steam-api.js"], "matches": ["*://steamcommunity.com/profiles/*", "*://steamcommunity.com/id/*"]}]}