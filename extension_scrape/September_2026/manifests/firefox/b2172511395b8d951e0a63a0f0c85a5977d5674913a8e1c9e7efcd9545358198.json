{"manifest_version": 3, "name": "Vegan Mage", "description": "Elevate your online experience to the next level.", "version": "2.5.0", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://manawell.veganmage.com/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "Vegan Mage", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "veganmage@veganmage", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Vegan Mage"}}