{"manifest_version": 2, "name": "InstantSkip", "version": "1.8.4", "description": "Instantly skip intros, recaps & outros on Netflix, Prime, Disney+ & Crunchyroll. Features 300% Volume Boost, Auto Next, Custom Speed & Scene Return. High-speed detection & zero data collection. Ultimate binge-watcher tool!", "browser_specific_settings": {"gecko": {"id": "themeinsideamind2@web.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "tabs", "activeTab", "*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.jp/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazonvideo.com/*", "*://*.disneyplus.com/*", "*://*.disney.com/*", "*://*.crunchyroll.com/*"], "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon48.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*.netflix.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.jp/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazonvideo.com/*", "*://*.disneyplus.com/*", "*://*.disney.com/*", "*://*.crunchyroll.com/*"], "js": ["utils/config.js", "content_scripts/main.js"], "css": ["content_scripts/style.css"], "all_frames": true, "run_at": "document_end"}]}