{"manifest_version": 3, "name": "GrantGunner", "version": "1.0.0", "description": "Draft grant answers on funder portals with your GrantGunner profile. Detects fields, generates AI suggestions, and syncs edits.", "browser_specific_settings": {"gecko": {"id": "extension@grantgunner.org", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "personalCommunications", "websiteContent", "websiteActivity"], "optional": ["locationInfo", "technicalAndInteraction"]}}}, "permissions": ["storage", "tabs", "contextMenus", "scripting"], "host_permissions": ["https://www.grantgunner.org/*", "http://*/*", "https://*/*"], "sidebar_action": {"default_title": "GrantGunner", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*", "https://www.grantgunner.org/*", "http://www.grantgunner.org/*", "https://grantgunner.org/*", "http://grantgunner.org/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://www.grantgunner.org/*"], "js": ["grantgunner-bridge.js"], "run_at": "document_idle"}]}