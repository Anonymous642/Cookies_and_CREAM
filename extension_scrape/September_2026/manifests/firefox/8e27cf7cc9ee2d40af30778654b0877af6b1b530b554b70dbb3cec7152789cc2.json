{"manifest_version": 3, "name": "OneagencyOS OSCAR", "version": "1.2.51", "description": "Runs approved OneagencyOS carrier quote workflows in the signed-in agent's browser.", "permissions": ["activeTab", "alarms", "downloads", "scripting", "storage", "tabs"], "host_permissions": ["https://oneagencyos.com/*", "https://www.oneagencyos.com/*", "https://oneagencyos.netlify.app/*", "https://portal.windwardrisk.com/*", "https://u09.duckcreekondemand.com/*"], "optional_host_permissions": ["https://*/*"], "background": {"type": "module", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "oscar@oneagencyos.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "financialAndPaymentInfo", "authenticationInfo", "browsingActivity", "websiteContent", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "OneagencyOS OSCAR", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://oneagencyos.com/*", "https://www.oneagencyos.com/*", "https://oneagencyos.netlify.app/*"], "js": ["platform-bridge.js"], "run_at": "document_start"}]}