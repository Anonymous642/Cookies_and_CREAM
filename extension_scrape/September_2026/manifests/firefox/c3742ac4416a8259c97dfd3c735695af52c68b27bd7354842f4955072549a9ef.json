{"manifest_version": 3, "name": "SceneJump Video Skipper", "description": "Automatically skip intros, recaps, and outros on streaming platforms to streamline your binge-watching experience.", "version": "1.0.0", "author": "StreamEnhance Labs", "permissions": ["storage"], "host_permissions": ["https://*.netflix.com/*", "https://*.youtube.com/*", "https://*.primevideo.com/*", "https://*.hulu.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "scenejumpvideoskipper@streamenhancelabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}