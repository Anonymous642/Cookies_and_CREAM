{"manifest_version": 2, "name": "Recho Raccoon's Reaction Sync", "version": "1.0.0", "description": "Watch along with Recho Raccoon's reaction videos. Automatically syncs the source video.", "permissions": ["storage", "tabs", "*://www.youtube.com/*", "*://www.tiktok.com/*", "*://raw.githubusercontent.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": ["bg_tile.png", "videos/videos.json", "player.html", "player_content.js", "icons/icon32.png", "icons/icon48.png", "icons/kofi.png"], "browser_action": {"default_popup": "popup.html", "default_title": "Recho Raccoon's Reaction Sync", "default_icon": {"48": "icons/icon48.png"}}, "icons": {"48": "icons/icon48.png"}, "browser_specific_settings": {"gecko": {"id": "reaction-sync@rechoraccoon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}