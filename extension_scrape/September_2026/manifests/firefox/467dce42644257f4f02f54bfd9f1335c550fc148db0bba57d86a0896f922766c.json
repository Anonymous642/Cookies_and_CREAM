{"manifest_version": 3, "name": "AI Prompt Enhancer", "version": "1.0.0", "description": "Right-click text to optimize it into a high-quality prompt for LLMs using Gemini AI.", "permissions": ["contextMenus", "storage", "activeTab", "scripting"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*"], "commands": {"trigger_optimization": {"suggested_key": {"default": "Alt+A", "mac": "Alt+A"}, "description": "Optimize selected text"}}, "action": {"default_popup": "popup.html", "default_title": "AI Prompt Enhancer"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "osazak@outlook.de", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}