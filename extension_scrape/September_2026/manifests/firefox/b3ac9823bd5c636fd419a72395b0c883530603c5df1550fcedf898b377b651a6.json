{"manifest_version": 2, "name": "Multi-Viewer for IDN Live", "description": "Fan-Made multiple IDN livestreams watcher with ultra-low CPU usage. Lightweight, fast, and easy to use.", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["https://*.idn.app/*", "https://*.live-video.net/*"], "browser_specific_settings": {"gecko": {"id": "multiviewer@manekingidol", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "web_accessible_resources": ["icon/*", "logo-transparent.png"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Multi-Viewer for IDN Live", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.idn.app/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}