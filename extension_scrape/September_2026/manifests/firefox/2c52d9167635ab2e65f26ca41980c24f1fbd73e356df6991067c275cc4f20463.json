{"manifest_version": 2, "name": "Blur Remover", "version": "1.0", "description": "Entfernt alle Blur-Filter auf einer Webseite per Klick.", "icons": {"48": "icon48.png", "96": "icon96.png"}, "browser_action": {"default_icon": {"48": "icon48.png", "96": "icon96.png"}, "default_title": "Blur Remover"}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "tabs"], "browser_specific_settings": {"gecko": {"id": "blur-remover@addon", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}