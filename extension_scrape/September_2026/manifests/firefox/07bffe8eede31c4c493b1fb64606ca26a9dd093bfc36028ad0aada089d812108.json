{"manifest_version": 3, "name": "Find in Video \u2014 Search YouTube", "version": "1.0", "description": "Search any word or phrase inside YouTube videos and jump to the exact moment. Copy or export the full transcript with timestamps.", "browser_specific_settings": {"gecko": {"id": "find-in-video@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting"], "host_permissions": ["https://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://*.youtube.com/watch*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}