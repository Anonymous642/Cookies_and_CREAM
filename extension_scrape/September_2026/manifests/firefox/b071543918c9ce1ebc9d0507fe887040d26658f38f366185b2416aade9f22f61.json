{"manifest_version": 3, "name": "vods.space Companion", "version": "1.40", "description": "Adds map and round navigation to processed VODS replays on YouTube.", "permissions": ["storage", "cookies"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://vods.space/*", "https://clerk.vods.space/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtu.be/*"], "js": ["i18n.js", "content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "companion@vods.space", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}, "web_accessible_resources": [{"resources": ["branding/vods-logo.svg", "fonts/*.woff2"], "matches": ["https://www.youtube.com/*", "https://youtu.be/*"]}], "action": {"default_title": "vods.space Companion", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html"}}