{"manifest_version": 2, "version": "3.2.1", "name": "Prod \u2014 Block Distractions. Reach your Goals", "short_name": "Prod", "homepage_url": "https://prodtodolist.com/", "description": "Blocks distracting websites until you've finished your to-do list.", "permissions": ["webRequest", "http://*/*", "https://*/*", "webRequestBlocking", "storage"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup/index.html", "default_title": "__MSG_extName__", "default_icon": {"19": "icons/19.png", "38": "icons/38.png"}}, "chrome_url_overrides": {"newtab": "new-tab/index.html"}, "web_accessible_resources": ["new-tab/index.html", "popup/index.html"], "browser_specific_settings": {"gecko": {"id": "prodtodolist@gmail.com"}}}