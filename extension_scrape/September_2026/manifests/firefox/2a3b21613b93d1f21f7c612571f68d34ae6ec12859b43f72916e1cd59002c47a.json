{"manifest_version": 3, "name": "KeySlash", "version": "1.0.0", "description": "Press \\, say less. Type \\gen anywhere in your browser and have it expand into any saved text, with import/export.", "homepage_url": "https://github.com/aryanarin/keyslash", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "KeySlash", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "contact@davagni.eu.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "commands": {"open-manager": {"suggested_key": {"default": "Alt+Shift+E"}, "description": "Open the snippet manager"}, "toggle-expander": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Turn text expansion on / off"}}}