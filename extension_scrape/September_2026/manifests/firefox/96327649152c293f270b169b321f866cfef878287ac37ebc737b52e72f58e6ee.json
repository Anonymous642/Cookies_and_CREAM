{"manifest_version": 2, "name": "Focus Hub \u2014 Tabs, Planner & Notes", "version": "1.0.0", "description": "Save open tabs as one-click shortcuts, plan your day, track projects, and jot quick notes. Designed for AuDHD brains: low clutter, high contrast, frictionless capture, gentle nudges instead of guilt.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["tabs", "storage", "contextMenus"], "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "Focus Hub"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["common.js", "background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "focushub@local.extension", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}