{"manifest_version": 3, "name": "Formaster", "description": "Automatic form filling with mocked data, visual field mapping, and programmable per-site scripts", "version": "0.9.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "contextMenus"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "{528dc21e-5250-4eb5-9b02-5a63d49e9a1f}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Formaster", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}