{"manifest_version": 2, "name": "Alerte Vote pour Excalia", "description": "Cr\u00e9er une alerte lorsqu'un vote est disponible sur le site https://www.excalia.fr/vote.", "version": "1.0.4", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://www.excalia.fr/vote*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Excalia Alerte Vote", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "alertevote@excalia"}}}