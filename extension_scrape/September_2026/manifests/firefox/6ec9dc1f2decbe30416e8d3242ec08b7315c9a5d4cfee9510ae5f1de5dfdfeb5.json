{"manifest_version": 3, "name": "LeakRadar - Data Breach Checker", "version": "1.0.0", "description": "Instantly check if any website has been involved in data breaches. See leaked credential stats for every site you visit.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "tabs", "storage", "contextMenus"], "host_permissions": ["https://api.leakradar.io/*"], "browser_specific_settings": {"gecko": {"id": "contact@leakradar.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}