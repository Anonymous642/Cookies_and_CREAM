{"manifest_version": 2, "name": "URL Cleaner \u2013 Anti-Tracking", "version": "1.0.4", "description": "Supprime automatiquement les param\u00e8tres de tracking des liens (AliExpress, Amazon, Temu, Shein, eBay, r\u00e9seaux sociaux, Google/Facebook Ads, etc.) pour obtenir des URLs propres.", "author": "Mow", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["webNavigation", "tabs", "storage", "contextMenus", "clipboardWrite", "notifications", "<all_urls>", "https://raw.githubusercontent.com/*"], "background": {"scripts": ["rules.js", "background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "URL Cleaner"}, "browser_specific_settings": {"gecko": {"id": "{edc4bd3e-15c1-40cb-83f8-c0491991d625}", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}