{"manifest_version": 3, "name": "Paramount+ Hide Live Menu", "version": "0.1", "description": "Removes annoying live channel overlay menu", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon.png"}}, "content_scripts": [{"matches": ["https://www.paramountplus.com/live-tv/*"], "css": ["styles.css"]}], "browser_specific_settings": {"gecko": {"id": "@pplus-menu-remover", "data_collection_permissions": {"required": ["none"], "optional": []}}}}