{"manifest_version": 3, "name": "URLShortener", "version": "1.0.0", "description": "URL shortener tool. Create short aliases for long URLs locally.", "icons": {"48": "link-icons/icon-48.png", "96": "link-icons/icon-96.png", "128": "link-icons/icon-128.png"}, "action": {"default_icon": {"48": "link-icons/icon-48.png", "96": "link-icons/icon-96.png"}, "default_title": "URLShortener", "default_popup": "shortener-ui/shorten.html"}, "permissions": ["storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "urlshortener@url.short", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}