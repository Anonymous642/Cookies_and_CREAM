{"manifest_version": 3, "name": "TT Tracker", "description": "An unofficial plugin to make the WTT/ITTF websites friendlier for users", "version": "1.2.5", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png"}, "permissions": ["storage", "alarms", "notifications", "scripting", "tabs", "activeTab", "declarativeNetRequestWithHostAccess", "declarativeNetRequestFeedback"], "host_permissions": ["https://wttapigateway-new.azure-api.net/*", "https://wttcmsapigateway-new.azure-api.net/*", "*://*.worldtabletennis.com/*"], "browser_specific_settings": {"gecko": {"id": "tt-tracker@smoke"}}, "background": {"type": "module", "scripts": ["background.js"]}, "action": {"default_title": "Table Tennis Tracker", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://worldcupresults.ittf.com/eventInfo*", "*://xtresults.ittf.com/teamseventInfo*"], "run_at": "document_end", "css": ["content-scripts/ittf.css"], "js": ["content-scripts/ittf.js"]}, {"matches": ["*://*.worldtabletennis.com/*"], "run_at": "document_end", "css": ["content-scripts/wtt.css"], "js": ["content-scripts/wtt.js"]}]}