{"manifest_version": 3, "name": "Gemini to LibreOffice Writer", "version": "1.0", "description": "Copy content of Gemini Shared conversation to clipboard and then to LibreOffice Writer document.", "permissions": ["activeTab", "scripting", "clipboardWrite", "tabs"], "host_permissions": ["https://gemini.google.com/share/*"], "browser_specific_settings": {"gecko": {"id": "gwriter@tutamail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup.html", "default_icon": "icon_black.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["content.js"], "matches": ["https://gemini.google.com/share/*"]}]}