{"manifest_version": 2, "name": "Traducteur Fran\u00e7ais \u2194 Moor\u00e9", "version": "1.0.3", "description": "Traduction automatique des pages web entre le fran\u00e7ais et le moor\u00e9 avec support audio", "author": "CITADEL - Burkina Faso", "homepage_url": "https://citadel.bf", "permissions": ["activeTab", "storage", "contextMenus", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/dom-walker.js", "content/translator.js", "content/tts-handler.js", "content/auto-reader.js", "content/content.js"], "css": ["content/styles.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-translation": {"suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}, "description": "Activer/D\u00e9sactiver la traduction"}}, "web_accessible_resources": ["icons/*", "consent.html", "privacy.html"], "browser_specific_settings": {"gecko": {"id": "rodrique.kafando@citadel.bf", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"], "description": "Cette extension collecte uniquement des statistiques d\u2019utilisation anonymes \u00e0 des fins de recherche et d\u2019am\u00e9lioration du service. Aucune donn\u00e9e personnelle, aucun contenu des pages visit\u00e9es ni aucune information permettant d\u2019identifier un utilisateur n\u2019est collect\u00e9."}}}}