{"manifest_version": 3, "name": "Laterly \u2014 Save it. Read it. Find it.", "version": "1.0.7", "description": "Save any link with one click. Organize with collections and tags.", "permissions": ["activeTab", "storage", "contextMenus", "identity", "notifications", "alarms", "tabs"], "host_permissions": ["https://laterlylink.com/*", "https://accounts.google.com/*", "https://identitytoolkit.googleapis.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "commands": {"save-current-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Laterly"}, "quick-save": {"suggested_key": {"default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q"}, "description": "Quick save without opening popup"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "laterly@laterlylink.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["bookmarksInfo", "personallyIdentifyingInfo"]}}}}