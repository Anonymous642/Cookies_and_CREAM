{"manifest_version": 2, "name": "X Content Filter & Blocker", "version": "1.1", "description": "Blocks NSFW content, disables specific buttons, and prevents access to settings on X.com.", "permissions": ["webRequest", "webRequestBlocking", "tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://www.google.com/*", "https://www.bing.com/*", "https://www.yahoo.com/*", "https://www.reddit.com/*"], "js": ["content.js"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "x-filter@yourdomain.com"}}}