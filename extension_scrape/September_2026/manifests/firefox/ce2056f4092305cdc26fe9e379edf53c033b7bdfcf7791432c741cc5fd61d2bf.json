{"manifest_version": 3, "name": "ReadAlong", "version": "0.1.2", "description": "Extract text from webpages for a clean reading experience.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://api.elevenlabs.io/*", "https://texttospeech.googleapis.com/*", "https://speech.googleapis.com/*", "https://ccoreilly.github.io/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["styles.css", "audio-processor.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' data: https:;"}, "browser_specific_settings": {"gecko": {"id": "readalong@ccoreilly.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}