{"manifest_version": 3, "name": "CyberCheck360 Link Inspector", "short_name": "CyberCheck360 Link Inspector", "version": "1.0.10", "description": "A browser extension for inspecting links and providing security insights.", "action": {"default_popup": "popup.html", "default_icon": {"16": "CC360-Link-Insp-Logo-16x16.png", "48": "CC360-Link-Insp-Logo-48x48.png", "128": "CC360-Link-Insp-Logo-128x128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "CC360-Link-Insp-Logo-16x16.png", "48": "CC360-Link-Insp-Logo-48x48.png", "128": "CC360-Link-Insp-Logo-128x128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"]}], "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "webNavigation", "downloads", "contextMenus"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["warning.html", "phishing-warning.html", "protected.html", "loading.html", "Cybercheck360_Logo_Email.webp", "logofav.webp", "Cybercheck360-Icon-Blue-48x48.png", "Cybercheck360_Logo_White.png", "Cybercheck360_Logo-04_Square_32.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "link-inspector@cybercheck360.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}}