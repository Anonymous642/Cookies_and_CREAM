{"manifest_version": 3, "name": "Nexify", "description": "Adds Nexus GD icon to random YouTube videos", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "128": "icon/128.png", "256": "icon/256.png"}, "browser_specific_settings": {"gecko": {"id": "nexify@gducrash", "strict_min_version": "60.0"}}, "web_accessible_resources": [{"matches": ["*://*.youtube.com/*"], "resources": ["media/*"]}], "action": {"default_title": "Document", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*"], "js": ["content-scripts/content.js"]}]}