{"manifest_version": 3, "name": "Tab Later", "version": "1.0.0", "description": "Adds the current tab as a Microsoft To Do task to watch it later.", "author": "CubexsOne", "browser_specific_settings": {"gecko": {"id": "tabLater@cubexs.dev", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "data_collection_permissions": "", "permissions": ["identity", "storage", "tabs", "notifications"], "host_permissions": ["https://graph.microsoft.com/*", "https://login.microsoftonline.com/*"], "action": {"default_title": "Save to Microsoft To Do", "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}