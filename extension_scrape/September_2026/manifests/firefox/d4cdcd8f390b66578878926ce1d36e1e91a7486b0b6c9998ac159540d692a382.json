{"manifest_version": 3, "name": "Cookie Session Manager", "version": "1.2.0", "description": "Simpan, switch, salin, dan impor cookie session antar-profil browser dengan mudah dan utuh (Firefox Port).", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["cookies", "storage", "tabs", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cookie-session-manager@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}