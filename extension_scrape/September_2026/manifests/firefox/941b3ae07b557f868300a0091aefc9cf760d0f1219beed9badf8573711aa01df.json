{"manifest_version": 3, "name": "PicPuzzler Challenge", "description": "Transform images from any webpage into an interactive guessing game for a quick mental break.", "version": "1.0.0", "author": "PixelPlay Labs", "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "picpuzzlerchallenge@pixelplaylabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}