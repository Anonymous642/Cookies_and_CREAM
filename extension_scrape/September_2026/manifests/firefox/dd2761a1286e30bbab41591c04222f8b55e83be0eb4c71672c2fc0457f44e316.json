{"manifest_version": 3, "name": "Hide Watched YouTube Videos", "version": "1.0.0", "description": "Hides YouTube videos you've already watched (based on the red progress bar) from thumbnails grids, sidebars, and search results.", "icons": {"48": "icon.png"}, "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "hidewatchedyoutube@gmail.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Hide Watched Videos"}}