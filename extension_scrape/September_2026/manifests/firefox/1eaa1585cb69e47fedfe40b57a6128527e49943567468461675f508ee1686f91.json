{"description": "See what your browsing data is worth. Detects trackers in real time and shows how much corporations earn from your data.", "version": "1.0.3", "name": "DataReceipt", "manifest_version": 3, "action": {"default_icon": "icon-34.png", "default_title": "DataReceipt \u2014 click to toggle"}, "background": {"scripts": ["background.bundle.js"]}, "permissions": ["webRequest", "tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "datareceipt@datareceipt.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.bundle.js"], "css": []}], "icons": {"128": "icon-128.png"}, "web_accessible_resources": [{"resources": ["*.woff2", "*.woff"], "matches": ["<all_urls>"]}]}