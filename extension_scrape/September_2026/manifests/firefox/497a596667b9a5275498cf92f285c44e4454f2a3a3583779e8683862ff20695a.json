{"manifest_version": 3, "name": "GoRizzume Job Search Companion", "description": "Save jobs from Indeed, LinkedIn and career sites to your GoRizzume tracker. Autofill applications with your profile and CV.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://gorizzume.co.uk/*", "https://*.indeed.com/*", "https://www.linkedin.com/*", "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://apply.workable.com/*", "https://jobs.ashbyhq.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.indeed.com/*"], "js": ["content/indeed.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.linkedin.com/in/*"], "js": ["content/linkedin-profile.js"], "run_at": "document_idle"}, {"matches": ["https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*"], "js": ["content/greenhouse.js"], "run_at": "document_idle"}, {"matches": ["https://jobs.lever.co/*"], "js": ["content/lever.js"], "run_at": "document_idle"}, {"matches": ["https://apply.workable.com/*"], "js": ["content/workable.js"], "run_at": "document_idle"}, {"matches": ["https://jobs.ashbyhq.com/*"], "js": ["content/ashby.js"], "run_at": "document_idle"}], "version": "1.7.1", "sidebar_action": {"default_title": "GoRizzume", "default_icon": "icons/icon48.png", "default_panel": "popup/panel.html", "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "extension@gorizzume.co.uk", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}