{"manifest_version": 3, "name": "Dogear", "version": "2.1.0", "description": "Save pages to your own Dogear bookmark server, with previews, tags and notes. Works on desktop and Android.", "homepage_url": "https://github.com/Suman2023/dogear", "permissions": ["storage", "tabs", "activeTab", "scripting", "bookmarks", "contextMenus", "notifications"], "optional_host_permissions": ["*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"scripts": ["lib/dogear.js", "background.js"]}, "action": {"default_title": "Save to Dogear", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Open Dogear and save the current page"}, "quick-save": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current page without opening the popup"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{8c6040ad-f314-457a-914a-10755349e76d}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}