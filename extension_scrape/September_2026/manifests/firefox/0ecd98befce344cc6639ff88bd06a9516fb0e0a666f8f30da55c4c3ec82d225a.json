{"manifest_version": 3, "name": "AIncognito Saver", "version": "1.0.0", "description": "Sichert offene Claude-Chats (auch Incognito) als Markdown, Text, JSON oder HTML \u2013 inklusive Bildern, Dateien, Artefakten und Codebl\u00f6cken als ZIP.", "browser_specific_settings": {"gecko": {"id": "aincognito-saver@lennartwolf.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "storage", "scripting", "activeTab"], "host_permissions": ["*://claude.ai/*", "*://*.claude.ai/*"], "incognito": "spanning", "action": {"default_title": "AIncognito Saver \u2013 Chat sichern", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["src/lib/util.js", "src/lib/zip.js", "src/lib/format.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["*://claude.ai/*", "*://*.claude.ai/*"], "js": ["src/lib/util.js", "src/lib/selectors.js", "src/lib/html-to-md.js", "src/content/content.js", "src/content/assistant.js"], "run_at": "document_idle", "all_frames": false}]}