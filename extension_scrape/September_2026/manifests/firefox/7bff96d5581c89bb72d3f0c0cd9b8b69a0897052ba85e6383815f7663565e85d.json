{"manifest_version": 3, "name": "Cookie Vault", "version": "6.0.0", "description": "Server-authenticated cookie export/import with expiry, selective export, and tamper-proof limits.", "permissions": ["cookies", "tabs", "activeTab", "storage", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cookie-vault@atdb.uno", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"], "optional": ["technicalAndInteraction"]}}, "gecko_android": {}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}