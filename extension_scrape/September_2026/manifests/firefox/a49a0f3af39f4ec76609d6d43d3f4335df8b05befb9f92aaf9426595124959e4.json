{"manifest_version": 2, "name": "Vertical Sidebar", "short_name": "Vertical Sidebar", "description": "A Zen Browser style vertical tab sidebar for Waterfox and Firefox.", "version": "2.2.0", "browser_specific_settings": {"gecko": {"id": "vertical-sidebar@sathishram", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabHide", "sessions", "tabGroups", "storage", "alarms", "menus", "menus.overrideContext"], "optional_permissions": ["<all_urls>"], "options_ui": {"page": "options/options.html", "open_in_tab": false, "browser_style": false}, "sidebar_action": {"default_title": "Vertical Sidebar", "default_panel": "sidebar/panel.html", "default_icon": "icons/icon.svg", "browser_style": false, "open_at_install": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle the Vertical Sidebar"}, "space-next": {"suggested_key": {"default": "Alt+Shift+Period"}, "description": "Switch to the next space"}, "space-prev": {"suggested_key": {"default": "Alt+Shift+Comma"}, "description": "Switch to the previous space"}}, "background": {"scripts": ["background.js", "background-spaces.js", "background-unload.js", "background-mru.js", "background-glance.js"], "persistent": true}}