{"manifest_version": 2, "name": "Focus Mode URLs", "version": "1.0", "description": "T\u0103ng t\u1eadp trung b\u1eb1ng c\u00e1ch l\u00e0m m\u1edd giao di\u1ec7n v\u00e0 \u0111\u00f3ng tab kh\u00e1c khi v\u00e0o trang \u0111\u01b0\u1ee3c ch\u1ec9 \u0111\u1ecbnh.", "permissions": ["tabs", "<all_urls>", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Focus Mode URLs", "default_icon": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "focus-mode@example.com"}}}