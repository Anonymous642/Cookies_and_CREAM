{"manifest_version": 2, "name": "DNS Lookup by ClouDNS", "version": "1.0.0", "description": "Lookup DNS records (A, AAAA, CNAME, MX, NS, TXT, SOA) via DNS-over-HTTPS.", "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "https://www.cloudns.net/*", "https://dns.google/resolve*", "https://cloudflare-dns.com/*"], "background": {"scripts": ["background.mv2.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "support@cloudns.net", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["technicalAndInteraction"]}, "strict_min_version": "78.0"}}}