{"manifest_version": 2, "name": "Unofficial Sidebar for Z.ai", "version": "1.0.1", "description": "Opens chat.z.ai in a dedicated Firefox sidebar. Not affiliated with Z.ai.", "icons": {"32": "icon.svg", "48": "icon.svg", "96": "icon.svg"}, "permissions": ["webRequest", "webRequestBlocking", "https://chat.z.ai/*"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_icon": "icon.svg", "default_title": "Z.ai", "default_panel": "sidebar.html", "open_at_install": true}, "browser_specific_settings": {"gecko": {"id": "zai-sidebar@local.lucasrocha", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'; frame-src https://chat.z.ai"}