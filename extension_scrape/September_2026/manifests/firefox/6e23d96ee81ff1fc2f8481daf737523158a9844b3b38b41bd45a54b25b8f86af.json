{"manifest_version": 3, "name": "X Assistant \u2014 AI Otomasyon", "version": "1.4.6", "description": "X (Twitter) i\u00e7in Groq AI destekli otomasyon: bildirim yan\u0131tlama, otomatik be\u011feni, takip y\u00f6netimi, AI yorum ve tweet olu\u015fturma.", "author": "X Assistant", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_popup": "pages/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "X Assistant"}, "options_ui": {"page": "pages/options.html", "open_in_tab": true}, "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.groq.com/*"], "web_accessible_resources": [{"resources": ["pages/*", "icons/*", "background/*"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "browser_specific_settings": {"gecko": {"id": "x-assistant@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}