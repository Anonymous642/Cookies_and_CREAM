{"manifest_version": 3, "name": "FocusTab", "version": "1.1.0", "description": "A calm dashboard popup: clock, focus list, quote of the day \u2014 and drag a tab in to be reminded about it later.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "FocusTab", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["js/background.js"]}, "permissions": ["tabs", "alarms", "storage", "notifications"], "browser_specific_settings": {"gecko": {"id": "focustab@encryxed.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}