{"manifest_version": 2, "name": "Auto Capitalize", "version": "1.0.0", "description": "Automatically capitalizes text like a mobile phone \u2014 first letter of sentences and new fields.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_popup": "popup.html", "default_title": "Auto Capitalize"}, "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "auto-capitalize@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}