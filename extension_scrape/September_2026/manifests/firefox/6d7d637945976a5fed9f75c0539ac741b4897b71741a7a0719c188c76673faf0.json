{"manifest_version": 3, "name": "Facebook Helper", "version": "2.0.3", "description": "Modifies facebook to have a better user experience.", "icons": {"16": "images/icon/fb/png/icon-16.png", "48": "images/icon/fb/png/icon-48.png", "128": "images/icon/fb/png/icon-128.png"}, "action": {"default_icon": {"16": "images/icon/fb/png/icon-16.png", "48": "images/icon/fb/png/icon-48.png", "128": "images/icon/fb/png/icon-128.png"}, "default_title": "Facebook Helper", "default_popup": "popup.html"}, "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "activeTab", "tabs", "scripting", "webRequest", "webNavigation"], "host_permissions": ["https://www.facebook.com/"], "optional_host_permissions": ["https://www.facebook.com/"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "yash.m.bhayani@zohomail.in", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}