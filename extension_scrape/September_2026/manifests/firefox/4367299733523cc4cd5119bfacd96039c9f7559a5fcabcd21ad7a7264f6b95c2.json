{"manifest_version": 2, "name": "Save Tabs to the Right", "version": "1.8.3", "description": "Save images from the current tab and every tab to its right.", "permissions": ["tabs", "downloads", "notifications", "scripting", "cookies", "activeTab", "storage", "menus", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Save this tab and tabs to the right", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "save-tabs-right@local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}