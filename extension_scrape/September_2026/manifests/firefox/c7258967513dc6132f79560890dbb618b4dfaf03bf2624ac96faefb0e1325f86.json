{"manifest_version": 2, "name": "Uninterrupted", "description": "Skip YouTube ads automatically. Fast-forward unskippable ads, auto-mute, and auto-close overlays for an uninterrupted viewing experience.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "homepage_url": "https://github.com/AMR-M-ALSHAMEERI/uninterrupted", "permissions": ["storage", "activeTab", "tabs", "*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "uninterrupted@extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Uninterrupted", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/content-main.js"], "world": "MAIN"}, {"matches": ["*://*.youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}