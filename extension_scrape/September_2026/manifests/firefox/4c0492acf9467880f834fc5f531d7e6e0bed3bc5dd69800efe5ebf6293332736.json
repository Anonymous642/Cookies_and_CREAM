{"manifest_version": 2, "name": "Safe Kagi Search Plugin", "version": "1.0", "description": "Adds Kagi as a search engine in Firefox, no cookies, no storage access required. Feel safe.", "icons": {"16": "favicon-16x16.png"}, "browser_specific_settings": {"gecko": {"id": "claude-ext@safe-kagi-search", "data_collection_permissions": {"required": ["none"]}}}, "chrome_settings_overrides": {"search_provider": {"name": "Kagi", "search_url": "https://kagi.com/search?q={searchTerms}", "keyword": "@kagi", "favicon_url": "https://kagi.com/favicon-16x16.png", "suggest_url": "https://kagi.com/api/autosuggest?q={searchTerms}", "encoding": "UTF-8", "is_default": false}}}