{"manifest_version": 3, "name": "Proton WireGuard Exporter", "version": "4.0", "description": "Bulk-export WireGuard configuration files for ProtonVPN servers from your account.", "icons": {"128": "icon.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://account.proton.me/*", "https://account.protonvpn.com/*"], "browser_specific_settings": {"gecko": {"id": "harvester@proton.tool", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_icon": "icon.png", "default_title": "Open Proton WireGuard Exporter"}, "content_scripts": [{"matches": ["https://account.proton.me/*", "https://account.protonvpn.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}