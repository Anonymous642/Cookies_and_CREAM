{"manifest_version": 3, "name": "Fastmail Masked Email \u2014 Insert", "version": "1.1.2", "description": "Maak en plak Fastmail masked emails in het veld waar je typt.", "permissions": ["storage", "menus", "scripting", "activeTab", "notifications"], "host_permissions": ["https://api.fastmail.com/*"], "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Fastmail Masked Email", "default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"insert-masked-email": {"suggested_key": {"default": "Ctrl+Shift+M"}, "description": "Maak & plak een Fastmail masked email"}}, "browser_specific_settings": {"gecko": {"id": "fastmail-masked-email@gillesdhondt.github.io", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}