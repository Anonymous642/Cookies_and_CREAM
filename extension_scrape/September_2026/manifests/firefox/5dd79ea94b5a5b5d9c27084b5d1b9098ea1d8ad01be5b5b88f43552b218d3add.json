{"manifest_version": 3, "name": "Anti-Marazm", "version": "1.1", "description": "Replaces specific words in YouTube video titles.", "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-word-replacer@yourdomain.com", "strict_min_version": "109.0"}}}