{"manifest_version": 3, "name": "BackerKit Authenticator", "version": "1.0.0", "description": "Sends your signed-in Kickstarter session to BackerKit so imports keep working. Only reads kickstarter.com cookies.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["cookies", "storage", "scripting"], "host_permissions": ["https://*.kickstarter.com/*", "https://www.backerkit.com/*"], "action": {"default_popup": "popup.html", "default_title": "BackerKit Authenticator", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "optional_host_permissions": ["https://*.backerkit.com/*", "https://*.neighborhoodcuts.com/*", "https://*.backerkit.test/*", "http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://*.backerkit.com/*"], "js": ["marker.js"], "run_at": "document_start"}], "background": {"scripts": ["endpoint.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "backerkit-authenticator@backerkit.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}