{"name": "Roblox Unfriend Button", "description": "This extension adds up a '-' button near each friend in the friendslist. - Made By Ayoub", "version": "1.1", "manifest_version": 3, "icons": {"48": "icons/Icon.png"}, "browser_specific_settings": {"gecko": {"id": "UnfriendExtension@Main1.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["scripting", "storage", "activeTab"], "host_permissions": ["https://www.roblox.com/*", "https://friends.roblox.com/*"], "content_scripts": [{"matches": ["https://www.roblox.com/*", "https://friends.roblox.com/*"], "js": ["main_script.js"], "run_at": "document_idle"}]}