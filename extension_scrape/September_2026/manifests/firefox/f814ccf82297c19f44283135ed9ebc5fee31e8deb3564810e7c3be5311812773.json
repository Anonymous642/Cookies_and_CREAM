{"manifest_version": 3, "name": "SkinID \u2014 NFC Implant Authentication", "version": "1.0.20", "description": "Autofill passwords and FIDO2 passkeys with your SkinID NFC implant. Tap your hand to sign in to any website.", "permissions": ["storage"], "host_permissions": ["https://skinid.ch/*"], "browser_specific_settings": {"gecko": {"id": "skinid@skinid.ch", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}, {"matches": ["<all_urls>"], "js": ["fido.js"], "run_at": "document_start", "world": "MAIN"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "web_accessible_resources": [{"resources": ["fido.js", "icon48.png", "icon128.png"], "matches": ["<all_urls>"]}]}