{"manifest_version": 3, "name": "Duplicate Tab Detector", "version": "3.60.0", "description": "Automatically detects and closes duplicate tabs in your current window or across all windows for a cleaner browsing experience.", "permissions": ["tabs", "storage"], "optional_permissions": ["tabGroups"], "background": {"page": "background.html"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/dd-16.png", "48": "images/dd-48.png", "128": "images/dd-128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Alt+D"}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "images/dd-16.png", "48": "images/dd-48.png", "128": "images/dd-128.png"}, "browser_specific_settings": {"gecko": {"id": "duplicate-tab-detector@addons.mozilla.org", "data_collection_permissions": {"required": ["none"]}}}}