{"manifest_version": 3, "name": "YouTube Course Chunk Master", "version": "1.2", "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "permissions": ["activeTab", "storage", "tabs", "alarms", "notifications", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "web_accessible_resources": [{"resources": ["images/*"], "matches": ["*://*.youtube.com/*"]}], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["content.js"], "css": ["styles.css", "restrictions.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Course Chunk Master"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "course-chunk-master@omniarch.com", "strict_min_version": "109.0"}}}