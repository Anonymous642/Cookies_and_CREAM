{"manifest_version": 3, "name": "Analytics Ignore", "version": "1.0.0", "description": "Keep a browser-local list of domains where your own visits should be excluded from analytics.", "author": "Quiet Mind Creative", "homepage_url": "https://github.com/thequietmind/analytics-ignore", "browser_specific_settings": {"gecko": {"id": "analytics-ignore@quietmindcreative.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/reconcile-marker.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_title": "Analytics Ignore", "default_popup": "popup/popup.html", "theme_icons": [{"light": "icons/analytics-ignore-light.svg", "dark": "icons/analytics-ignore-dark.svg", "size": 16}, {"light": "icons/analytics-ignore-light.svg", "dark": "icons/analytics-ignore-dark.svg", "size": 32}]}, "icons": {"48": "icons/analytics-ignore-extension.svg", "96": "icons/analytics-ignore-extension.svg"}}