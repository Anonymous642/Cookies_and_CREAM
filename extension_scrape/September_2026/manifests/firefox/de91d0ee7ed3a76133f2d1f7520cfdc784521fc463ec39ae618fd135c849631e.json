{"manifest_version": 3, "name": "UNIHODL", "version": "2.4.3", "description": "Never lose your place again. Save your context, resume with continuity.", "permissions": ["storage", "tabs", "scripting", "activeTab", "contextMenus", "unlimitedStorage", "alarms", "idle", "notifications"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "action": {"default_title": "HODL this tab", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"hodl-current-tab": {"suggested_key": {"default": "Ctrl+Shift+H", "mac": "Command+Shift+H"}, "description": "HODL the current tab"}}, "omnibox": {"keyword": "hodl"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://mail.google.com/*"], "js": ["lib/gmail.js"], "run_at": "document_idle"}], "options_page": "options/options.html", "web_accessible_resources": [{"resources": ["dashboard/canvas.html", "dashboard/canvases.html", "dashboard/fork.html", "dashboard/teams.html", "dashboard/team-detail.html", "onboarding/index.html"], "matches": ["<all_urls>"]}], "protocol_handlers": [{"protocol": "web+unihodl", "name": "UNIHODL", "uriTemplate": "dashboard/fork.html?protocol=%s"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "unihodl@futureenterprises.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent", "websiteActivity", "personallyIdentifyingInfo", "technicalAndInteraction"]}}, "gecko_android": {"strict_min_version": "142.0"}}}