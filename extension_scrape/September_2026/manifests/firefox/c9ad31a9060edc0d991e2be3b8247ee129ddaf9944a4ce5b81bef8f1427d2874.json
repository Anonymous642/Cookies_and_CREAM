{"manifest_version": 2, "name": "Auto Login Helper", "version": "1.0", "description": "Automatically logs into AUT centra login portal when enabled.", "permissions": ["storage", "tabs", "*://*.aut.ac.ir/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_title": "Auto Login", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png"}}, "content_scripts": [{"matches": ["*://*.aut.ac.ir/*"], "js": ["login.js"]}], "browser_specific_settings": {"gecko": {"id": "AUToLogin@AUToLogin.com", "strict_min_version": "109.0", "data_collection_permissions": {"settings": "none", "required": ["none"]}}}}