{"manifest_version": 2, "name": "Depatternizer", "version": "1.0.0", "description": "What if plain HTTP request will be performed simultaneously with every HTTPS / TLS request? This extension is an answer.", "icons": {"128": "icon.png"}, "background": {"scripts": ["common.js", "background.js"]}, "options_ui": {"page": "options.html"}, "permissions": ["storage", "webRequest", "webRequestBlocking", "webRequestFilterResponse", "webRequestFilterResponse.serviceWorkerScript", "https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "Depatternizer@anon", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "62.0"}}}