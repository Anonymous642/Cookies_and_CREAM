{"manifest_version": 3, "name": "Mini Script Manager", "version": "1.2", "description": "Manage and execute small scripts on pages (popup + editor).", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "Script Manager"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "mini-script-manager@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "data_collection_permissions": {"collects_data": false, "description": "This extension does not collect or share any user data."}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}]}