{"manifest_version": 3, "name": "Donaid", "version": "1.2.0", "description": "Donaid reminds you when a shop can support donations through the Donaid partner link.", "action": {"default_popup": "popup/popup.html", "default_title": "Donaid"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["activeTab", "alarms", "storage"], "host_permissions": ["http://*/*", "https://*/*", "https://affiliate-connector.vercel.app/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["redirect/redirect.html", "icons/donaid_icon.png", "icons/donaid-logo.png"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "extension@donaid.aidpioneers.com", "data_collection_permissions": {"required": ["none"]}}}}