{"manifest_version": 3, "name": "Add to My COAs (CheckWeedNY)", "version": "1.0.0", "description": "Adds a \"CheckWeed COA\" button next to COA links so you can send them to CheckWeedNY.", "author": "FindWeedNY", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://checkweedny.com/*", "*://*.checkweedny.com/*", "*://localhost/*", "*://*.localhost/*", "*://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "add-to-my-coas@checkweedny.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}