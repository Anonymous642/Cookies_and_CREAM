{"manifest_version": 3, "name": "QuestionME", "author": "Kenji", "version": "1.0", "description": "Creates a summary and questions based on whatever webpage you're on. Length of summary and number of questions is customizable through the settings.", "browser_specific_settings": {"gecko": {"id": "@question-me"}}, "permissions": ["tabs", "scripting", "activeTab", "storage"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["libs/Readability.js"], "matches": ["<all_urls>"]}], "icons": {"32": "icons/32x32.jpg", "48": "icons/48x48.jpg", "64": "icons/64x64.jpg"}, "background": {"scripts": ["funcs/background.js"]}, "action": {"default_popup": "popup/popup.html"}}