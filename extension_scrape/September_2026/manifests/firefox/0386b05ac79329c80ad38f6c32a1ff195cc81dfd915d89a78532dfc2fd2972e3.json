{"manifest_version": 3, "name": "Reddit Image Saver - Original Quality", "version": "1.2.5", "description": "Save Reddit images in original format and full resolution. Stops WebP, fixes preview links", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "reddit-original-image-saver@salxlv", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "downloads", "storage"], "host_permissions": ["*://*.reddit.com/*", "*://i.redd.it/*", "*://preview.redd.it/*", "*://external-preview.redd.it/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Reddit Image Saver - Original Quality", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}