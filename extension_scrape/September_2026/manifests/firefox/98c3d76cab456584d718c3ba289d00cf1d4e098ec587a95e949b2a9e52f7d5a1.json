{"manifest_version": 3, "name": "ReList for YouTube", "version": "1.0.0", "author": "ahmetly_", "description": "Curate YouTube playlists and create new ones in seconds \u2014 select videos, adjust order, and publish.", "permissions": ["storage", "identity"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content.js"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "ReList for YouTube", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["*://*.youtube.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "relist@ahmetly.com", "strict_min_version": "112.0", "data_collection_permissions": {"on_install": {"url": "https://relist.ahmetly.com/privacy-policy"}, "required": ["none"]}}}}