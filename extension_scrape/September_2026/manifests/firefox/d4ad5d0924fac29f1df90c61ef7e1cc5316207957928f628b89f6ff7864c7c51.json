{"manifest_version": 2, "name": "Rumble RP Reply Watcher", "version": "0.3.5", "description": "Lightweight Rumble mention watcher with selective highlights and built-in AI reply tools.", "permissions": ["storage", "*://rumble.com/chat/popup/*", "*://www.rumble.com/chat/popup/*", "tabs", "tabHide"], "content_scripts": [{"matches": ["*://rumble.com/chat/popup/*", "*://www.rumble.com/chat/popup/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "Rumble RP Reply Watcher", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "rumble-rp-reply-watcher@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}