{"manifest_version": 3, "name": "Its the Same Stuff", "version": "1.2.0", "description": "Pool identical Amazon listings and get one alert when any of them drops below your target price. Optional sync across devices.", "permissions": ["storage", "alarms", "notifications"], "optional_host_permissions": ["*://*.amazon.com/*", "https://sync.itsthesamestuff.com/*"], "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.js", "storage.js", "sync.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.com/*/dp/*", "*://*.amazon.com/dp/*", "*://*.amazon.com/gp/product/*"], "js": ["browser-polyfill.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "itsthesamestuff@itsthesamestuff.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "browsingActivity", "websiteContent", "authenticationInfo"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}