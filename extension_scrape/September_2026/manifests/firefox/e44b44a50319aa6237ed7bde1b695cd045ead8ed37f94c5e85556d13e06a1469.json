{"manifest_version": 2, "name": "Drag to Search", "version": "2.0", "description": "Draw a rectangle on any page to search with Google Lens \u2014 like Circle to Search on Android.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs", "https://lens.google.com/*"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png"}, "default_title": "Drag to Search"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "drag-to-search@firefox-extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}