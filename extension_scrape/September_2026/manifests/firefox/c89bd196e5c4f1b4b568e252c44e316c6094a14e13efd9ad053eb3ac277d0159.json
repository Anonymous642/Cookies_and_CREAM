{"manifest_version": 3, "name": "Daily Workspace \u2014 New Tab Dashboard", "short_name": "Daily Workspace", "version": "0.0.1", "description": "Your daily essentials in a bento dashboard. Organize tasks, notes and shortcuts, check the weather, and stay focused.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "chrome_url_overrides": {"newtab": "index.html"}, "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "permissions": ["storage", "unlimitedStorage", "alarms"], "optional_permissions": ["notifications", "bookmarks", "tabs", "idle", "sessions", "topSites"], "optional_host_permissions": ["https://duckduckgo.com/*", "https://www.google.com/*", "https://www.bing.com/*", "https://search.brave.com/*", "https://type.fit/*"], "browser_specific_settings": {"gecko": {"id": "daily-workspace@adhikari-dikshant.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}