{"manifest_version": 3, "name": "JSK Shield - Ad Blocker & Privacy", "version": "0.1.2", "description": "Open-source ad & tracker blocker. Blocks on your device, shows exactly what it blocked, and collects no data.", "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "ui/popup.html", "default_title": "JSK Shield", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "ui/options.html", "permissions": ["storage", "unlimitedStorage", "scripting", "webNavigation", "webRequest", "tabs", "alarms", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "optional_host_permissions": ["http://*/*", "https://*/*"], "browser_specific_settings": {"gecko": {"id": "jsk-shield@jskapps.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}}, "web_accessible_resources": [{"resources": ["cosmetics/specific/*.json.gz"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}