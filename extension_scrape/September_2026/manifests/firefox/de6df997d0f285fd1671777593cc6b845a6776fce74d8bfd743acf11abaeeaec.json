{"manifest_version": 3, "name": "Word Shield Pro", "version": "4.0.1", "description": "Hide, blur, or cover webpage content containing words and phrases you choose. Private and processed locally.", "permissions": ["storage", "contextMenus", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Word Shield Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "word-shield-pro@alandari.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "short_name": "Word Shield", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"toggle-filtering": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Toggle Word Shield filtering"}}}