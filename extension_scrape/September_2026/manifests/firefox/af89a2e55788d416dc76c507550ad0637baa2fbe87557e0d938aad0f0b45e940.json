{"manifest_version": 2, "name": "Manga Tracker", "version": "1.0", "description": "Automatically tracks manga chapters.", "browser_action": {"default_title": "Manga Tracker", "default_popup": "popup.html"}, "permissions": ["tabs", "storage", "http://127.0.0.1:5000/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "manga-tracker-local@your-project", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}