{"manifest_version": 3, "name": "ClearView for Reddit", "description": "Simplify your Reddit browsing by auto-dismissing optional overlays and app promotion banners.", "version": "1.0.0", "permissions": ["storage"], "host_permissions": ["*://*.reddit.com/*"], "browser_specific_settings": {"gecko": {"id": "clearview-reddit@udav.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_title": "ClearView for Reddit", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}