{"manifest_version": 3, "name": "itch.io Game Opener", "version": "1.0.0", "description": "Open itch.io web games directly without the site wrapper \u2014 play fullscreen without ads or navigation.", "permissions": ["storage", "scripting"], "host_permissions": ["*://*.itch.io/*"], "content_scripts": [{"matches": ["*://*.itch.io/*"], "js": ["src/content/index.js"], "css": ["src/content/styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "src/popup/index.html", "default_title": "itch.io Game Opener", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "itch-game-opener@itch-game-opener.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}