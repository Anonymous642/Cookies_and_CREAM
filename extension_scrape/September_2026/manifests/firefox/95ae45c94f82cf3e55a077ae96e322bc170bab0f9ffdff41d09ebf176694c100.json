{"manifest_version": 2, "name": "Stellantis OAuth Catcher", "version": "1.0", "description": "Capture automatiquement le code OAuth lors d'une connexion manuelle a Stellantis (Peugeot/Citroen/Opel...) et l'affiche pour copie rapide.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["webRequest", "webNavigation", "tabs", "storage", "notifications", "*://*.peugeot.com/*", "*://*.citroen.com/*", "*://*.opel.com/*", "*://*.ds.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "success.html", "default_title": "Code OAuth Stellantis"}, "browser_specific_settings": {"gecko": {"id": "stellantis-oauth-catcher@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}