{"manifest_version": 2, "name": "Epic Games Library Extension", "description": "Show library of owned games in Epic Games Store.", "version": "0.1.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "64": "icon/64.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://*.epicgames.com/*"], "commands": {"toggleDialog": {"description": "Toggle the dialog", "suggested_key": {"default": "Alt+G", "mac": "Command+G"}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://*.epicgames.com/*"], "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "{f30e4532-872d-4f42-b491-4a3397a6d198}"}}}