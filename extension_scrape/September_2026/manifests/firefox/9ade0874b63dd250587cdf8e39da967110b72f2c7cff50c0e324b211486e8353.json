{"manifest_version": 3, "name": "Upscale Image - Media Helper", "version": "1.0.0", "description": "Open upscaleimg.org and save selected images locally using the context menu.", "homepage_url": "https://upscaleimg.org/", "action": {"default_title": "Upscale Image - Media Helper", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["contextMenus", "downloads"], "icons": {"48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "upscaleimg-org-media-helper@upscaleimg.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}