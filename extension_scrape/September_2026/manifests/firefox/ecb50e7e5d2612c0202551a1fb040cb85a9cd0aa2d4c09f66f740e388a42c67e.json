{"manifest_version": 3, "name": "Better Watchlists for Tradingview", "description": "Better Watchlists for Tradingview in a native sidebar/sidepanel. One-click charts, CSV import/export, Chartink screener import, and handy symbol shortcuts.", "version": "1.6", "browser_specific_settings": {"gecko": {"id": "better-watchlists-for-tradingview@tuning", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "declarativeNetRequest"], "host_permissions": ["https://*.tradingview.com/*", "https://tradingview.com/*", "https://chartink.com/*", "https://www.nseindia.com/*", "https://*.nseindia.com/*"], "background": {"scripts": ["background/background.js"], "type": "module"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Watchlists", "default_area": "navbar"}, "sidebar_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Watchlists", "default_panel": "sidebar/panel.html", "open_at_install": false}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Toggle Watchlists Sidebar"}, "_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Toggle Watchlists Action"}}, "content_scripts": [{"matches": ["https://*.tradingview.com/*", "https://tradingview.com/*"], "js": ["content/tradingview.js"], "run_at": "document_idle"}]}