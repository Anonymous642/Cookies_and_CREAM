{"manifest_version": 2, "name": "Time Capsule", "version": "2.1.0", "description": "Write a note or save a link to your future self and lock it until a date you choose. Sealed capsules stay hidden and show a countdown; when the day arrives they unlock with a notification.", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{de63fee9-de3a-42e8-a7e6-8b8be65e9915}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "notifications"], "background": {"scripts": ["src/background.js"]}, "browser_action": {"default_title": "Time Capsule", "default_popup": "src/popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}}