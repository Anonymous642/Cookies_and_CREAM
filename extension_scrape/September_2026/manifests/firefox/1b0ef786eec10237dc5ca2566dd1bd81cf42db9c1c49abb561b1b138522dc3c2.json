{"manifest_version": 2, "name": "OC Vault", "description": "Unlock once, fill anywhere, trust the origin. The browser companion to vault.ochk.io.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "alarms", "https://vault.ochk.io/*", "https://ochk.io/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "vault@ochk.io", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "financialAndPaymentInfo", "websiteContent", "websiteActivity"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "OC Vault", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}