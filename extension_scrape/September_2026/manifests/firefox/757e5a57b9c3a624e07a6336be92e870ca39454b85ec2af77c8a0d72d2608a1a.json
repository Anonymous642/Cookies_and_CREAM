{"manifest_version": 3, "name": "Shorts Intent Check", "version": "1.1.0", "description": "Pause before YouTube Shorts. Check your intent, then choose to continue or go back.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.instagram.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Shorts Intent Check"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.instagram.com/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_start", "all_frames": false}], "icons": {"48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "shorts-intent-check@janmaciejewski470.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}