{"manifest_version": 2, "name": "Utopia", "version": "1.0.15", "description": "Translate YouTube videos to your language in real-time. Just play any video and get instant voice translation!", "applications": {"gecko": {"id": "utopia.audio@extension.com", "strict_min_version": "109.0"}}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "sidebar_action": {"default_title": "Utopia.audio", "default_panel": "index.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "identity", "tabs", "activeTab", "tabHide", "<all_urls>", "desktopCapture", "tabCapture"], "web_accessible_resources": ["audio-processor.js", "permissions.html", "permissions.js"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.youtu.be/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}