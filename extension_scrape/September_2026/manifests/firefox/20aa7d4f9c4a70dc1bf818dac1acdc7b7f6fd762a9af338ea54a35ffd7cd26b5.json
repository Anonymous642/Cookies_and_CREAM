{"manifest_version": 2, "name": "Twitch Live (local-only)", "version": "1.0.0", "description": "Detect live status for Twitch channels from open tabs. Local-only: reads page DOM on twitch.tv pages, no external APIs.", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Twitch Live", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://www.twitch.tv/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "twitch-live-local@example.com", "strict_min_version": "60.0"}}}