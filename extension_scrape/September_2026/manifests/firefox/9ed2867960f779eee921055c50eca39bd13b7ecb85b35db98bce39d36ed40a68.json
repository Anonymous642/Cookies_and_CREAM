{"manifest_version": 3, "name": "Docs Dark", "version": "1.0.1", "description": "Dark mode for Google Docs, with theme variants, accent colour and page background controls.", "browser_specific_settings": {"gecko": {"id": "@docs-dark", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["*://docs.google.com/document/*"], "action": {"default_title": "Docs Dark settings", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://docs.google.com/document/*"], "run_at": "document_start", "all_frames": false, "css": ["css/docs-dark.css", "css/panel.css"], "js": ["src/theme.js", "src/panel.js", "src/content.js"]}], "commands": {"toggle-dark": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Turn dark mode on or off"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open or close the settings panel"}}}