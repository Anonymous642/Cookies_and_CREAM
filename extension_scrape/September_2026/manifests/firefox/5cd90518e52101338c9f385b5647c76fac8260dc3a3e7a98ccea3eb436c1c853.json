{"manifest_version": 3, "name": "LinkBook", "description": "Save links, tabs and personal notes \u2014 searchable, tagged and always one click away. By Tanvir Hossain, powered by Latonis Technologies.", "version": "2.0.1", "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "permissions": ["tabs", "storage", "scripting", "activeTab"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"save-current-tab": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Save the current tab to LinkBook"}}, "browser_specific_settings": {"gecko": {"id": "linkbook@latonis.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}