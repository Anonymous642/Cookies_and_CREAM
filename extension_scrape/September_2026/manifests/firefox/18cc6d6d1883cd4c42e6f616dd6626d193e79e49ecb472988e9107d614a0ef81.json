{"manifest_version": 2, "name": "Browser Lock", "version": "1.0.0", "description": "Lock your browser with a password. Secure your session before any tabs open.", "author": "Browser Lock", "browser_specific_settings": {"gecko": {"id": "browser-lock@local.dev", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "tabHide", "webNavigation", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Browser Lock"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "web_accessible_resources": ["lock/lock.html", "setup/setup.html"]}