{"manifest_version": 3, "name": "Arca", "version": "0.6.1", "description": "Save images to your Arca hoard at arca.graphics", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "storage", "alarms", "notifications", "webRequest"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://x.com/*", "*://twitter.com/*"], "js": ["content/x-extract.js", "content/x.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["*://x.com/*/likes", "*://twitter.com/*/likes"], "js": ["content/x-extract.js", "content/x-likes.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["*://*.pinterest.com/*", "*://*.pinterest.co.uk/*", "*://*.pinterest.ca/*"], "js": ["content/pinterest-extract.js", "content/pinterest.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "Arca", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "arca@dangercat.localhost", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}