{"manifest_version": 3, "name": "XSurfLog", "short_name": "XSurfLog", "description": "XSurfLog browser extension for web activity monitoring, policy enforcement, and security protection.", "version": "4.0.0", "icons": {"16": "images/X16.png", "48": "images/X48.png", "128": "images/X128.png"}, "action": {"default_icon": {"16": "images/X16.png", "48": "images/X48.png", "128": "images/X128.png"}, "default_popup": "src/popup.html"}, "options_page": "src/options.html", "permissions": ["storage", "downloads", "cookies", "alarms", "tabs", "webRequest", "webNavigation", "activeTab", "history", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/upload_script.js", "src/content/password_script.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["src/block.html", "images/*", "src/content/main_world_hook.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "support@xsurflog.com"}}, "background": {"scripts": ["src/background/main.js"], "type": "module"}}