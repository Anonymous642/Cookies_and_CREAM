{"manifest_version": 3, "name": "ProtonMail Auto-Scroller", "short_name": "PM Auto-Scroller", "version": "2.0.1", "description": "Speed-triage your ProtonMail inbox. Each unread mail loads in the preview pane for a few seconds \u2014 keep it, open its main link in a new tab, or auto-trash it. Keyboard-driven, recoverable, configurable.", "author": "Petr", "homepage_url": "https://github.com/your-username/protonmail-autoscroller", "browser_specific_settings": {"gecko": {"id": "protonmail-autoscroller@petr.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab"], "host_permissions": ["*://mail.proton.me/*"], "content_scripts": [{"matches": ["*://mail.proton.me/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "ProtonMail Auto-Scroller", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": false}, "commands": {"toggle-scroller": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Start / stop the auto-scroller"}, "trash-current": {"suggested_key": {"default": "Ctrl+Shift+D"}, "description": "Trash currently highlighted mail"}}}