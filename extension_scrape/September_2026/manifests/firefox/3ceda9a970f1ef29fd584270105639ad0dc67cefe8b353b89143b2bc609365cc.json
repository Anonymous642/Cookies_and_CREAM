{"manifest_version": 3, "name": "Discord and Roblox Login", "version": "6767", "description": "Discord/Roblox login with DisBlox account analytics.", "icons": {"16": "img/disblox_16x.png", "32": "img/disblox_32x.png", "48": "img/disblox_48x.png", "128": "img/disblox_128x.png"}, "permissions": ["activeTab", "scripting", "cookies", "tabs", "storage"], "host_permissions": ["*://*.discord.com/*", "*://*.roblox.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"js": ["content.js"], "matches": ["http://*.discord.com/*", "https://*.discord.com/*"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "img/disblox_16x.png", "32": "img/disblox_32x.png", "48": "img/disblox_48x.png", "128": "img/disblox_128x.png"}}, "browser_specific_settings": {"gecko": {"id": "addon@login-roblox-discord.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}