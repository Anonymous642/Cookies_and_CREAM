{"manifest_version": 3, "name": "Streminion", "version": "1.2", "description": "Adds a button to IMDb pages to open movies and shows directly in Stremio.", "host_permissions": ["*://*.imdb.com/*"], "content_scripts": [{"matches": ["*://*.imdb.com/*"], "js": ["content.js"], "css": ["button.css"]}], "browser_specific_settings": {"gecko": {"id": "streminion@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}