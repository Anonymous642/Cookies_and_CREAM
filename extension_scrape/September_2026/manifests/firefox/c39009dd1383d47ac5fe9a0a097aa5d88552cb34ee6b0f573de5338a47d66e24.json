{"manifest_version": 3, "name": "Vim Tab", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "vimtab@local", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "vim-tab-16.png", "32": "vim-tab-32.png", "48": "vim-tab-48.png", "64": "vim-tab-64.png", "128": "vim-tab-128.png"}, "commands": {"toggle-ui": {"suggested_key": {"default": "Alt+Q"}, "description": "Toggle UI"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "permissions": ["tabs", "notifications", "activeTab"]}