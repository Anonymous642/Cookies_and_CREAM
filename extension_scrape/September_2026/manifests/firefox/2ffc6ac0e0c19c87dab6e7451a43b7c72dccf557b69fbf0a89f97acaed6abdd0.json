{"manifest_version": 3, "name": "Codex Browser Bridge", "description": "Use Codex with a local browser automation bridge.", "version": "0.1.2", "action": {"default_popup": "popup.html", "default_title": "Codex"}, "background": {"service_worker": "firefox-extension/background.js", "type": "module", "scripts": ["firefox-extension/background-loader.js"]}, "permissions": ["nativeMessaging", "storage", "alarms", "scripting", "tabs", "history", "downloads", "bookmarks", "topSites", "tabGroups"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "codex-firefox@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["images/cursor-chat.png"]}]}