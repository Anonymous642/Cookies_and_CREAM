{"manifest_version": 3, "name": "T-Hunter Search Bridge", "version": "1.3", "description": "T-Hunter Search Bridge adds an icon next to titles on Google, IMDb, Trakt, Kinopoisk, and Rutracker. Click the icon to instantly search or stream the title in your local T-Hunter app.", "permissions": ["storage"], "host_permissions": ["http://localhost:14141/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/thunter_48.png", "96": "icons/thunter_96.png", "192": "icons/thunter.png"}}, "content_scripts": [{"matches": ["https://www.google.com/search*", "https://www.google.ru/search*", "https://*.imdb.com/title/*", "https://*.trakt.tv/*", "https://*.kinopoisk.ru/*", "*://lampa.mx/*", "*://*.lampa.mx/*", "*://rutracker.org/*", "*://*.rutracker.org/*", "*://rutracker.net/*", "*://*.rutracker.net/*", "*://rutracker.nl/*", "*://*.rutracker.nl/*"], "js": ["content.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/thunter_48.png", "96": "icons/thunter_96.png", "192": "icons/thunter.png"}, "web_accessible_resources": [{"resources": ["icons/thunter.png"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "t-hunter-bridge@zabeiua.dotfiles", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}}