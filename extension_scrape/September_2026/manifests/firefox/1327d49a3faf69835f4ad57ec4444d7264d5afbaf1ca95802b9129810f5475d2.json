{"manifest_version": 3, "name": "QR Code Generator & Scanner - QRCode Rabbit", "version": "1.1.0", "description": "Beautiful styled QR code generator and QR Code Scanner on just right click.", "permissions": ["tabs", "activeTab", "contextMenus", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "QR Code Generator", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["libs/*", "icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "qr-rabbit@qrcode-rabbit.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}