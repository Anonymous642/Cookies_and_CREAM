{"manifest_version": 2, "name": "Universal Music Stream Plugin", "version": "2.0.0", "description": "Capture la musique en cours sur toutes les plateformes (Deezer, Spotify, YouTube, etc.) pour l'affichage en stream", "permissions": ["activeTab", "storage", "background", "https://*/*", "http://*/*", "http://localhost:3001/*"], "content_scripts": [{"matches": ["https://www.deezer.com/*", "https://open.spotify.com/*", "https://music.youtube.com/*", "https://www.youtube.com/*", "https://soundcloud.com/*", "https://music.apple.com/*", "https://tidal.com/*", "https://music.amazon.com/*", "https://www.pandora.com/*", "https://www.last.fm/*"], "js": ["universal-music-detector.js"], "run_at": "document_end"}], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Universal Music Stream Plugin"}, "icons": {"16": "icons/icon16.svg", "48": "icons/icon48.svg", "128": "icons/icon128.svg"}, "web_accessible_resources": ["*.js", "*.css"], "browser_specific_settings": {"gecko": {"id": "{b05835f3-0e8d-4e20-a301-903ee3ad26bc}"}}}