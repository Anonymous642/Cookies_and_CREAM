{"manifest_version": 2, "name": "TraceGuard", "version": "1.1.0", "description": "TraceGuard reveals trackers and surveillance endpoints in real time, helps you inspect cookie activity, and offers quick guidance on locking down your browsing.", "browser_specific_settings": {"gecko": {"id": "traceguard@berus.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage", "tabs", "cookies"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon.png"}}