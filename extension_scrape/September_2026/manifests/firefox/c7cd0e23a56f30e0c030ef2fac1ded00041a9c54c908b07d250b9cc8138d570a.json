{"manifest_version": 3, "name": "YouTube Player Reset", "version": "1.1.0", "description": "Adds a reset button to the YouTube player (watch pages + Shorts) that reloads just the player, not the whole page. Also optionally auto-reloads on the \"Something went wrong\" error screen.", "browser_specific_settings": {"gecko": {"id": "youtube-player-reset@soydoft", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options/options.html", "open_in_tab": false}}