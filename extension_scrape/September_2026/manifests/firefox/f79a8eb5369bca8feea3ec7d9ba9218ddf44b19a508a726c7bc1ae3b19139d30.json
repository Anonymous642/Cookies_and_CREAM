{"manifest_version": 3, "name": "ReelBlock", "version": "0.1.0", "description": "Skjuler Reels i Instagram og Facebook i Firefox og Safari.", "browser_specific_settings": {"gecko": {"id": "reelblock@eiriknicholas.github.io", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "icons": {"48": "icons/reelblock-48.png", "96": "icons/reelblock-96.png"}, "host_permissions": ["https://*.instagram.com/*", "https://*.facebook.com/*", "https://reelblock.netlify.app/*"], "action": {"default_title": "ReelBlock", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.instagram.com/*", "https://*.facebook.com/*", "https://reelblock.netlify.app/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}