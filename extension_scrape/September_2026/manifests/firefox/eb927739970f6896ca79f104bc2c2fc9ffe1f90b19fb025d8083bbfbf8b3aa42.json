{"manifest_version": 2, "name": "__MSG_extName__", "description": "Fill web forms instantly with AI. Private, secure BYOK form filling free to install.", "version": "2.3.2", "short_name": "Form Filler", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "auto-form-filler@dracon.uk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "scripting"], "content_security_policy": "script-src 'self'; object-src 'self'; connect-src https://generativelanguage.googleapis.com;", "options_ui": {"open_in_tab": true, "page": "options.html"}, "commands": {"fill-form": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Fill the current form with AI"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Auto Form Filler", "default_popup": "popup.html"}, "content_scripts": []}