{"manifest_version": 2, "name": "Dark Reader - Dark Mode for Firefox", "description": "Switch on dark mode for every website. Take care of your eyes and use a dark theme for night and daily browsing.", "version": "1.0", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "darkreader@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon_black_16.png", "48": "icons/icon_black_48.png", "128": "icons/icon_black_128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon_black_16.png", "48": "icons/icon_black_48.png", "128": "icons/icon_black_128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}