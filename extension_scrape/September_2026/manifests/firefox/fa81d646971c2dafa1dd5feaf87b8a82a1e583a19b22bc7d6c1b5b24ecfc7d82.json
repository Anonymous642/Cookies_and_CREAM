{"manifest_version": 3, "name": "Control Output", "version": "0.9.9", "description": "Logs the posts, comments and replies you make, against your daily plan.", "permissions": ["storage"], "host_permissions": ["https://*.reddit.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*", "https://www.youtube.com/*", "https://controloutput.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "Control Output", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "content_scripts": [{"matches": ["https://*.reddit.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*", "https://www.youtube.com/*"], "js": ["content/handle-detect.js", "content/detector.js", "content/gamify-pill.js"], "run_at": "document_idle"}, {"matches": ["https://controloutput.com/extension/handoff*", "https://controloutput.com/dashboard*", "https://*.controloutput.com/extension/handoff*", "https://*.controloutput.com/dashboard*"], "all_frames": false, "js": ["content/handoff-relay.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon2.png", "fonts/Geist-Variable.woff2"], "matches": ["https://*.reddit.com/*", "https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*", "https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "extension@controloutput.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}}