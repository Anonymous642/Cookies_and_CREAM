{"manifest_version": 3, "name": "My Weather", "version": "1.0.0", "description": "A simple and private weather extension for checking current weather and a 5-day forecast.", "browser_specific_settings": {"gecko": {"id": "my-weather@example.com", "data_collection_permissions": {"required": ["locationInfo"]}}}, "host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"], "action": {"default_title": "My Weather", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}