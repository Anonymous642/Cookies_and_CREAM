{"manifest_version": 3, "name": "Reelbar", "version": "1.0.1", "author": "docme", "description": "Reelbar adds a seekable progress bar, saved volume, keyboard shortcuts and a vxinstagram link copy to videos and reels on Instagram.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "reelbar@docme.dev", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}