{"manifest_version": 2, "name": "Profesh", "version": "1.2", "description": "Limit the number of tabs you can have open to improve focus and performance.", "browser_specific_settings": {"gecko": {"id": "tab-manager-site-blocker@extension.local"}}, "permissions": ["tabs", "storage", "activeTab", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["src/background/main.js"], "persistent": false, "type": "module"}, "browser_action": {"default_popup": "src/popup/popup.html", "default_title": "Profesh", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["src/pages/blocked.html", "src/pages/blocked.css", "src/pages/blocked.js", "src/pages/homepage.html", "src/pages/homepage.css", "src/pages/homepage.js", "src/popup/popup.html", "icons/*.png"]}