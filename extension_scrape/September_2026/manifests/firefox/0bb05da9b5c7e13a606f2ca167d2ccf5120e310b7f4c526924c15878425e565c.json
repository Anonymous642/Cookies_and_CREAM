{"manifest_version": 3, "name": "Font Hijacker", "version": "1.1.0", "description": "Replace web fonts with local system fonts. Persist changes globally or per domain.", "permissions": ["storage", "activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "fonthijacker@firefox.ext", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icon.png"}}, "icons": {"48": "icon.png", "96": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]}