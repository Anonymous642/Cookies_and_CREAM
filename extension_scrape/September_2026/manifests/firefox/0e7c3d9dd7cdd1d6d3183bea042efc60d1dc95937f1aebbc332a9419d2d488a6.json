{"manifest_version": 2, "name": "LinkHUB", "version": "1.0.2", "description": "Replaces the Firefox New Tab page with LinkHUB, a personal visual start page, and adds an optional Top Visits panel based on Firefox top sites and history.", "icons": {"48": "icon-linkhub-48.png", "96": "icon-linkhub-96.png"}, "permissions": ["cookies", "https://linkhub.aschi.at/*", "storage", "topSites", "history"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": true}, "content_scripts": [{"matches": ["https://linkhub.aschi.at/*"], "js": ["overlay.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "linkhub@aschi.at", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}}