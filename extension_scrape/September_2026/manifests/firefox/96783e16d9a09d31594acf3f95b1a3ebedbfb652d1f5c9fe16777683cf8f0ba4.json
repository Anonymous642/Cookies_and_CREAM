{"manifest_version": 3, "name": "Write&Cite ZoExt", "short_name": "ZoExt", "description": "Save pages and papers to your Zotero web libraries, groups and collections. No Zotero app needed.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Save to Zotero", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://api.zotero.org/*", "http://127.0.0.1:23119/*", "https://api.crossref.org/*", "https://doi.org/*", "https://data.crossref.org/*", "https://data.datacite.org/*", "https://arxiv.org/*", "https://openlibrary.org/*", "https://itunes.apple.com/lookup*", "https://www.youtube.com/oembed*", "https://vimeo.com/api/oembed.json*", "https://soundcloud.com/oembed*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "zoext@alekhni.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "version": "0.2.0"}