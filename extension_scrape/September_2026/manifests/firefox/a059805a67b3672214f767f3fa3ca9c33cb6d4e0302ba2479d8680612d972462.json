{"manifest_version": 2, "name": "Auto Secure Notes", "version": "1.3", "description": "Automatically encrypt and securely store notes locally in your browser. No tracking, no cloud storage.", "author": "Your Name", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage"], "browser_action": {"default_title": "Auto Secure Notes", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "@Auto-Secure-Notes", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}