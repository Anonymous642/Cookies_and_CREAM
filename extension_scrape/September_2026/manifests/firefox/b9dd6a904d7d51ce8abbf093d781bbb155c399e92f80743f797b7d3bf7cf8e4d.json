{"manifest_version": 3, "name": "Calme Blocker", "version": "2.1.8", "description": "Extension for blocking access to certain websites", "permissions": ["webNavigation", "storage", "tabs", "alarms", "activeTab"], "icons": {"48": "icons/Icon-MD.png", "128": "icons/Icon-LG.png"}, "host_permissions": ["<all_urls>", "http://localhost:3000/*", "http://localhost:5173/*", "https://use.appcalme.com/*"], "background": {"scripts": ["config.js", "service_worker.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*", "http://0.0.0.0/*", "https://0.0.0.0/*"], "js": ["content_script.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["config.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "calme-blocker@appcalme.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}