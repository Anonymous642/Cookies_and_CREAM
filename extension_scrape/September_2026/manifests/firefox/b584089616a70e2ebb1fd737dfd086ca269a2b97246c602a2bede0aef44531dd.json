{"manifest_version": 2, "name": "Downloader for Reddit - RedditGrab", "description": "Download images and videos from Reddit posts (including Redgifs)", "version": "1.3.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["downloads", "activeTab", "storage", "tabs", "*://*.reddit.com/*", "*://*.redd.it/*", "*://*.redgifs.com/*", "*://api.redgifs.com/*"], "browser_specific_settings": {"gecko": {"id": "{d6ae963b-906b-4ebe-9d91-ef1cb6f770c9}"}}, "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';", "web_accessible_resources": ["ffmpeg/*", "content-scripts/download-button.css"], "browser_action": {}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "browser_style": false, "default_icon": {"16": "/icon/16.png", "32": "/icon/32.png", "48": "/icon/48.png", "96": "/icon/96.png", "128": "/icon/128.png"}, "default_title": "RedditGrab", "open_at_install": false}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "js": ["content-scripts/download-button.js"]}]}