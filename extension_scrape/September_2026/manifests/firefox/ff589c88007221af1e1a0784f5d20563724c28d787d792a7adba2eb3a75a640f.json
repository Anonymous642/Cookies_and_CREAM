{"manifest_version": 2, "name": "YouTube Ad Skipper", "version": "1.0", "description": "Automatically Skip Ad on YouTube videos.", "browser_specific_settings": {"gecko": {"id": "yt-ad-skipper@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}]}