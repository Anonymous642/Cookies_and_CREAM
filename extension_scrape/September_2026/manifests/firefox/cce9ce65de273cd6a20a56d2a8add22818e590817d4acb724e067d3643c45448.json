{"manifest_version": 3, "name": "Drupal Forge helper extension", "description": "This extension sets up a development environment for Drupal contributions.", "version": "2.0.1", "homepage_url": "https://www.drupalforge.org", "icons": {"128": "icons/drupalforge-128x128.png"}, "action": {"default_icon": "icons/drupalforge-128x128.png", "default_popup": "popup.html", "default_title": "Drupal Forge"}, "permissions": ["activeTab", "storage", "scripting", "tabs"], "host_permissions": ["https://www.drupal.org/*"], "background": {"scripts": ["scripts/background.js"], "service_worker": "scripts/background.js"}, "content_scripts": [{"matches": ["https://www.drupal.org/project/*/issues/*"], "js": ["scripts/contentScript.js"]}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "{40dd4537-58d8-46d2-8a32-8730c89f7bb5}", "strict_min_version": "109.0"}}}