{"manifest_version": 3, "name": "Grip Extend", "version": "2.85.1", "description": "Grip: Streamlining SaaS Identity Risk Management", "icons": {"16": "icons/grip16.png", "32": "icons/grip32.png", "48": "icons/grip48.png", "64": "icons/grip64.png", "128": "icons/grip128.png", "256": "icons/grip256.png"}, "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "webRequest", "declarativeNetRequest", "scripting", "identity", "notifications", "cookies", "management"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_title": "Grip Extend", "default_popup": "popup.html"}, "background": {"page": "background.html"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "web_accessible_resources": [{"resources": ["icons/Grip_logo_light.svg", "icons/grip128.png", "icons/grip_greyed.png", "icons/grip_blacked.png", "fonts/Montserrat-latin-ext.woff2", "fonts/Montserrat-latin.woff2", "images/ExtensionsGuide.png", "images/PinExtension-chrome.gif", "images/PinExtension-edge.gif", "blocked.html"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "extend@grip.security", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "authenticationInfo", "personallyIdentifyingInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}}