{"manifest_version": 2, "name": "denizlg24 Quick Save", "description": "Save the current tab as a note to your denizlg24 knowledge base.", "version": "0.1.2", "short_name": "QuickSave", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "storage", "scripting", "https://denizlg24.com/*"], "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "bookmark-quick-add-extension@denizlg24.com", "strict_min_version": "115.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Save to denizlg24", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}