{"manifest_version": 3, "name": "Google Meet Hand Raise Tracker", "version": "1.1.0", "description": "Capture who raised and did not raise their hands in Google Meet at any given time.", "permissions": ["activeTab", "scripting", "tabs"], "host_permissions": ["https://meet.google.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "google-meet-hand-tracker@rs-dot369", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}