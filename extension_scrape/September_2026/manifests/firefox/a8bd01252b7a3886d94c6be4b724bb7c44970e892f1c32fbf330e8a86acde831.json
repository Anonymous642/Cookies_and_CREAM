{"manifest_version": 3, "name": "Zapply", "short_name": "Zapply", "version": "2.4.1", "description": "Classify job listings as real companies or agencies. Launch AI with your resume prompt and job description in one keystroke.", "default_locale": "en", "permissions": ["scripting", "storage", "tabs", "clipboardWrite", "contextMenus", "alarms"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "zapply@zapply.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Zapply Dashboard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]}