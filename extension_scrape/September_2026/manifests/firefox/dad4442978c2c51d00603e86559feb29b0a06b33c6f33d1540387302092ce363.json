{"manifest_version": 3, "name": "HorizontalX", "version": "0.1.1", "description": "Turn the live X.com home and following timelines into a horizontal carousel.", "icons": {"48": "icons/hx-icon.svg", "96": "icons/hx-icon.svg"}, "browser_specific_settings": {"gecko": {"id": "horizontalx@addon.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*"]}