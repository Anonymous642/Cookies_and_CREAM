{"manifest_version": 2, "name": "Telegram Web Tracker", "version": "0.1.0", "description": "Collect Telegram Web chat metadata and send it to local core.", "permissions": ["https://web.telegram.org/*", "http://127.0.0.1/*", "http://localhost/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://web.telegram.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "telegram-web-tracker-metricon@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications", "websiteContent", "browsingActivity"]}}}}