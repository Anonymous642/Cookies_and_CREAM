{"manifest_version": 3, "name": "Fucking JPEG", "author": "Dwarf <dwarf@borg.social>", "version": "1.7.3", "description": "Only allows images to be sent from reddit, imgur and tumblr media URLs instead of a shitload of javascript.", "background": {"scripts": ["background.js"]}, "icons": {"32": "logo-32x32-v2.png", "64": "logo-64x64-v2.png", "720": "logo-720x720-v2.png"}, "browser_specific_settings": {"gecko": {"id": "{3f49b782-7f7b-4e27-93d4-d1d0704977e8}", "strict_min_version": "109.0"}, "gecko_android": {"strict_min_version": "113.0"}}, "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["*://i.imgur.com/*", "*://i.redd.it/*", "*://preview.redd.it/*", "*://*.media.tumblr.com/*"]}