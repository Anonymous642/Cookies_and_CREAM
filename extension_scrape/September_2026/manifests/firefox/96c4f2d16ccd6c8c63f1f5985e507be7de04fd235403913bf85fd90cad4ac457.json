{"manifest_version": 3, "name": "Lens - Advanced JSON Viewer", "version": "3.8.6", "description": "Automatically formats, analyzes, and enhances JSON directly in your browser. Features advanced search, multiple themes, data pinning, and robust handling of large files.", "permissions": ["storage", "webRequest", "scripting"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["styles.css", "icons/*"], "matches": ["<all_urls>"]}], "action": {"default_title": "Lens - Advanced JSON Viewer", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "lens-json-viewer@sumantasaha.dev"}}}