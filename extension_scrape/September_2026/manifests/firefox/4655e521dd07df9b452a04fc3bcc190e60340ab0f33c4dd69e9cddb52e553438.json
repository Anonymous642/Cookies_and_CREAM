{"manifest_version": 3, "name": "Vivak", "version": "1.0.1", "description": "Your AI Copilot for Web Navigation", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["icon16.png"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "Open Vivak", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "copilot@vivak.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}}