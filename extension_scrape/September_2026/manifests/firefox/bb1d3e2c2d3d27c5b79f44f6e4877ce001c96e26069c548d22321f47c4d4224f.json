{"manifest_version": 2, "name": "Recall: Web Clipper & Summarizer", "short_name": "Recall", "description": "Save, summarize, and auto-organize YouTube, articles, PDFs, and podcasts in an AI knowledge base you can chat with and learn from", "version": "1.134", "homepage_url": "https://www.recall.it", "icons": {"192": "assets/images/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["tabs", "activeTab", "storage", "bookmarks", "<all_urls>", "tabGroups"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "assets/images/icon-16.png", "32": "assets/images/icon-32.png", "48": "assets/images/icon-48.png", "128": "assets/images/icon-128.png"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Toggle Recall extension"}, "save-card": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Save card"}}, "browser_specific_settings": {"gecko": {"id": "info@recall-app.com"}}, "content_scripts": [{"matches": ["*://localhost/*", "https://*.recall.it/*", "https://*.recall-app.com/*", "https://*.recall.wiki/*", "https://*.getrecall.ai/*"], "js": ["renderExtensionInstalled.js"]}], "web_accessible_resources": ["fonts/*.ttf"]}