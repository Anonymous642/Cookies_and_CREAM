{"manifest_version": 2, "name": "Cal.com Companion", "description": "Your calendar companion for quick booking and scheduling", "version": "1.7.5", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "identity", "https://companion.cal.com/*", "https://api.cal.com/*", "https://app.cal.com/*", "https://mail.google.com/*", "https://calendar.google.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'; frame-src 'self' https://companion.cal.com", "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "companion@cal.com", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Cal.com Companion", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}}