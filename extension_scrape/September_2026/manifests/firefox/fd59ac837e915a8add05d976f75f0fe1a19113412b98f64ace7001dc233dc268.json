{"manifest_version": 3, "name": "TabCopy", "version": "1.0.0", "description": "Instantly copy the current tab's URL, title, or a Markdown link \u2014 clean, fast, and private.", "author": "TabCopy", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "TabCopy", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["activeTab"], "browser_specific_settings": {"gecko": {"id": "tabcopy@example-addon.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}