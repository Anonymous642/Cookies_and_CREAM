{"manifest_version": 3, "name": "Wiglr", "description": "Custom Search and analyze relevant content on webpages using Gemini AI", "version": "1.3", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": "icons/icon48.png", "default_title": "Wiglr", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "@wiglr", "strict_min_version": "112.0"}}}