{"manifest_version": 2, "name": "Real Time Insta", "version": "1.0.6", "description": "Instagram g\u00f6nderilerindeki ISO 8601 tarihleri kullan\u0131c\u0131 timezone'una g\u00f6re RFC 2822 format\u0131na d\u00f6n\u00fc\u015ft\u00fcr\u00fcr.", "icons": {"48": "icons/rtc_48.png", "96": "icons/rtc_96.png"}, "browser_specific_settings": {"gecko": {"id": "@af4dc9cb-baef-4928-a33f-0c4fdc2e7d42", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "browser_action": {"default_icon": {"48": "icons/rtc_48.png"}, "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://www.instagram.com/p/*"], "js": ["content_script.js"], "run_at": "document_idle"}]}