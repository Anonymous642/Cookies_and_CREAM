{"manifest_version": 3, "name": "Federal Grant Finder - Grant Grinder", "short_name": "GrantGrind", "version": "0.5.2", "description": "Search current U.S. federal grants in a movable browser widget, filter opportunities, and open official-source funding details.", "homepage_url": "https://labs.wiplash.ai/grants", "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["https://labs.wiplash.ai/grants/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Toggle Grant Grinder widget", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "web_accessible_resources": [{"resources": ["widget.html", "widget.css", "widget.js", "icons/radar-mark.svg"], "matches": ["<all_urls>"]}], "options_page": "options.html", "browser_specific_settings": {"gecko": {"id": "grant-grinder@wiplash.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms", "browsingActivity", "websiteContent"]}}}}