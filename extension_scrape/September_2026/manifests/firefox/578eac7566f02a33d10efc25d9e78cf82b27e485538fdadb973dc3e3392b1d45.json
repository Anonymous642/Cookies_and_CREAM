{"manifest_version": 2, "name": "Tab Cap", "version": "1.3.3", "description": "Cap how many tabs stay in memory. Always-loaded tabs don\u2019t count. Turn unloading on or off from the toolbar button.", "browser_specific_settings": {"gecko": {"id": "tab-cap@in-memory.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "sessions", "menus"], "background": {"scripts": ["shared/policy.js", "shared/settings.js", "background.js"], "persistent": true}, "browser_action": {"default_icon": {"16": "icons/tab-cap.svg", "32": "icons/tab-cap.svg", "48": "icons/tab-cap.svg", "96": "icons/tab-cap.svg"}, "default_title": "Tab Cap", "default_popup": "popup/popup.html", "default_area": "navbar"}, "page_action": {"default_icon": {"16": "icons/unload.svg", "32": "icons/unload.svg", "48": "icons/unload.svg"}, "default_title": "Unload this tab"}, "sidebar_action": {"default_icon": {"16": "icons/unload.svg", "32": "icons/unload.svg", "48": "icons/unload.svg"}, "default_title": "Unload this tab", "default_panel": "sidebar/unload.html", "open_at_install": false, "browser_style": false}, "options_ui": {"page": "options/options.html", "open_in_tab": true, "browser_style": false}, "commands": {"toggle-keep-loaded": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Always load this tab, or let it use a memory slot"}, "unload-current-tab": {"description": "Unload this tab"}}, "icons": {"16": "icons/tab-cap.svg", "32": "icons/tab-cap.svg", "48": "icons/tab-cap.svg", "96": "icons/tab-cap.svg"}}