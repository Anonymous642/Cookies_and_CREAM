{"manifest_version": 3, "name": "YT Shorts remover", "version": "1.0", "description": "Removes yt shorts as an option on youtube", "icons": {"16": "icons/lighticon.svg", "24": "icons/lighticon.svg", "48": "icons/lighticon.svg", "96": "icons/lighticon.svg"}, "action": {"default_icon": "icons/lighticon.svg", "theme_icons": [{"light": "icons/lighticon.svg", "dark": "icons/darkicon.svg", "size": 16}, {"light": "icons/lighticon.svg", "dark": "icons/darkicon.svg", "size": 32}]}, "browser_specific_settings": {"gecko": {"id": "yt-shorts-remover@casparniemeyer.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["shorts-delete.js"]}]}