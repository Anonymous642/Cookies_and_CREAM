{"description": "Suspend inactive tabs to free memory. Free for up to 10 tabs; Pro unlocks unlimited suspends, site whitelist, and settings backup.", "manifest_version": 2, "name": "Tab Nap", "version": "3.9", "homepage_url": "https://github.com/esvictorg/tab-nap", "author": "esvictorg", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["entitlement.js", "bg.js"]}, "permissions": ["tabs", "storage", "sessions", "menus", "downloads", "https://tab-nap.victorgmor-336.workers.dev/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"strict_min_version": "58.0", "id": "{63f63897-2055-4a99-ac51-11c78b770ae0}", "data_collection_permissions": {"required": ["none"], "optional": ["authenticationInfo"]}}}, "browser_action": {"browser_style": true, "default_title": "Tab Nap \u2014 click for settings", "default_popup": "popup.html", "default_area": "navbar", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "options_ui": {"page": "popup.html", "browser_style": true}, "commands": {"suspend-current": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Suspend current tab"}, "suspend-others": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Suspend all other tabs"}, "suspend-window": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Suspend all tabs in window"}, "suspend-all-windows": {"description": "Suspend all tabs in all windows"}, "toggle-suspender": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Toggle Tab Nap on/off"}}, "default_locale": "en"}