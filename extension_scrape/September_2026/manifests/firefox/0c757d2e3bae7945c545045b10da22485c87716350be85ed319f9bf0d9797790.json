{"manifest_version": 3, "name": "WatchSync", "version": "0.0.5", "description": "Sync video playback across different streaming platforms for watch parties", "browser_specific_settings": {"gecko": {"id": "watchsync@sepdev.online", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "websiteContent", "websiteActivity"]}}}, "permissions": ["activeTab", "storage", "scripting", "alarms", "tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/background.js", "scripts": ["src/background/background.js"], "type": "module"}, "content_scripts": [], "web_accessible_resources": [{"resources": ["src/content/*.js"], "matches": ["<all_urls>"]}]}