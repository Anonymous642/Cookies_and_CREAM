{"manifest_version": 2, "name": "Podcast Summarizer", "version": "1.3", "description": "Create and store short summaries of podcast episodes locally in your browser.", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Podcast Summarizer", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Podcast-Summarizer", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}