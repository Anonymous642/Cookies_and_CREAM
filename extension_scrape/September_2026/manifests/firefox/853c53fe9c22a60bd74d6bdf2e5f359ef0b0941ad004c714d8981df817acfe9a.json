{"manifest_version": 3, "name": "Index \u2014 Mes favoris", "version": "1.9.0", "description": "Tableau de bord personnel de favoris, affich\u00e9 \u00e0 chaque nouvel onglet. Toutes les donn\u00e9es restent stock\u00e9es localement dans Firefox (browser.storage.local) \u2014 aucune donn\u00e9e n'est envoy\u00e9e o\u00f9 que ce soit.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab"], "optional_host_permissions": ["https://*/*", "http://*/*"], "action": {"default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Ajouter aux favoris (Index)", "default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "index-favoris@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}